// What a program was handed.
//
// Nothing here is ambient. A function that was not given a capability cannot use it, and that is a
// fact about its type rather than a sandbox around it. **There is no singleton**: two `Sys` values
// are two different grants, a test hands a fake one, and code assuming there is only one would be
// wrong in a way that reads correct.
//
// ## Why this is grouped, which is measured rather than chosen
//
// The host exposes **62** capabilities. This count said 50 until 2026-09-04 and the twelve it was
// short are `Page`'s: it was taken over `Core` and `Cli`, which is where the command-line ones are,
// so the whole browser host was outside the derivation that produced the groups. `Page` is the ninth
// projection and it is below. Counting them by what they reach:
//
//     file    14   readFile writeFile stat linkStat readDir mkdir remove rename …
//     net      9   connect listen accept send recv bindDatagram sendTo …
//     process  8   spawn spawnSelf execWithIn load call unload validated exitCode
//     env      4   arg argCount env cwd
//     io       3   write writeErr readStdin
//     page    12   render setText setValue setStyle getValue on nextEvent title drawPixels …
//     other   12   the clock, randomBytes, log, child bookkeeping, askInterrupt
//
// 50 of 62 in six groups, and the sixth was found by re-running this count rather than by anybody
// wanting it. A flat `Sys` with sixty-two methods satisfies *authority arrives as one
// thing* and gives a caller no way to hand over less, which is the half of *no ambient
// capabilities* that `packages/box` shows going unused: 63 applets all take `(Core, Cli, Fs, Args)`
// and **ten never mention `fs`**, because a dispatcher calls them all through one shape.
//
// So the groups are values. `Sys` is the whole grant; `sys.files` is a narrower one that reaches
// files and nothing else. A projection has no way back — there is no field on `Files` that answers
// a `Sys` — so narrowing is structural rather than promised, and `echo(sys.out, args)` cannot open
// a socket however it is written.
//
// **Within one instance.** Across a spawn a capability is not a value at all — see
// `@/packages/sh/src/exec.wac`, where what crosses is a *description* of one.

// `Node` comes from `core` for the reason `core/jsx.wac` gives: the compiler emits the constructor
// calls, so *"a tree built in one repository and a renderer in another must name one type or nothing
// composes"*. `Page.render` is the first capability anywhere to take one.
import { Ticket, TicketBase, Continuation, Result, Queue, Bytes, Node, AsyncGenerator } from "core";

/** A capability the grant did not include. */
export struct NotGranted { string what; }

/**
 * Everything a *command-line* program was granted, and the only thing that can produce a narrower
 * one.
 *
 * **It said "everything this program was granted" until `Page` existed, and that was never quite
 * true.** There is no `page` field here and there should not be: the launcher hands `Page` to an
 * exported `page` and `Cli` to `main` — `export i32 page(Core core, Cli cli, Page page)` is the
 * shipped signature, three parameters — so an interactive program's authority arrives as two values
 * and a `Sys` is one of them. A CLI program's `Sys` cannot render, which is the right answer and is
 * not what a struct claiming to be the whole grant says.
 *
 * The alternative is `Page? page;`, and it is worse for a reason worth keeping: every consumer would
 * unwrap, the unwrap would be a runtime question where the entry point already answers it
 * statically, and a `Sys` with a null field is a grant that has to be tested rather than one that
 * cannot be held. `../QUESTIONS.md` has why *the whole grant* may not be a thing that exists.
 *
 * The fields are the projections. Reading one is free and hands over exactly that group; there is
 * no method here that answers a capability the caller could not already reach.
 *
 * ## One scheduler, and this is the hazard the split creates
 *
 * `pending` and `drain` stay on `Sys` and every projection must reference **that** queue rather
 * than owning one. Not a tidiness rule — `issues/lang/closed/0298c` is what happens otherwise:
 *
 *   > the native host builds a non-callback field by calling `<Type>.create` **per capability**, so
 *   > `Core.sched` and `Cli.sched` were different schedulers and every `Cli` continuation sat on the
 *   > one nobody drained
 *
 * That was **two** capabilities and it cost a compiler that could not rebuild itself. The commit
 * that fixed it says the host makes *one* scheduler and hands it to both, *"because two would put a
 * `Cli` ticket's continuation where `core.drain()` never looks."*
 *
 * Seven projections are seven chances at the same bug, and the failure is silent: work is
 * registered, nothing runs it, and `drain` returns having found nothing to do. **This is the cost of
 * the grouping and it was not visible from the grouping.**
 */
// **The pages do not use this shape.** All four vetted pages write `sys.readFile(…)`, `sys.log(…)`,
// `sys.listen(…)` — seventeen call sites — and this struct has seven fields and no flat methods, so
// none of those examples typechecks against it. The projections were invented here during the
// packages exercise and never propagated upward; `../QUESTIONS.md` has the three ways out and why
// the middle one is not the compromise it looks like.
export struct Sys {
  Files files;
  Net net;
  Proc proc;
  Env env;
  Out out;
  In in;
  Clock clock;
  Random random;

  /** Work nobody awaited, waiting for somebody to run it. */
  Queue<Continuation> pending;

  /**
   * Run everything nobody awaited, until there is none left.
   *
   * `schedule` first, so a machine that suspends again inside a resumed continuation lands back
   * here rather than in whatever target was in force where it was first called. Its own `await`
   * hands this machine's continuation to the target above it, and the target is back in force when
   * it is resumed — see `vision/TECHNICAL.md`.
   */
  async void drain(this) {
    schedule this.pending.push;

    while (this.pending.len() > 0) {
      Continuation c = this.pending.pop()!;
      await c.t;
      c.call();
    }
  }

  /** Run `f` when this domain ends, however it ends. Cleanup that must happen is a system's. */
  fn<void(fn<void()>)> atEnd;
}

/*
 * ── The projections are structs of funcrefs, and were structs of bodyless methods ───────────────
 *
 * **The old shape did not work.** Fourteen bodyless methods across the seven, subclassed by
 * `vision/packages/wactest` — `struct FakeFiles : Files` with `override … read(…)`. Dispatch in wac
 * is static, measured: a `Circle` in a `Shape` variable answers `Shape.name()`. So a `FakeFiles`
 * handed to a function taking `Files` ran `Files`'s empty `read`, and the fake never ran. That is
 * `wactest`'s headline claim — *"the seam is the parameter"* — resting on a question two files away.
 *
 * A funcref field needs no dispatch and no subtyping: a fake is the **same struct type** holding
 * different funcrefs. That is what the shipped capability world already is — fifty `fn[…]` fields —
 * and what `vision/packages/fs`'s `Mount` arrived at from the other end, because a tag makes every
 * operation know about every backing. Three independent routes to one shape.
 *
 * **Call sites do not change.** `sys.files.read(p)` reads the same either way, which is why this was
 * invisible for as long as it was.
 *
 * Three things it costs, worth having written down:
 *
 *   - **A word per capability per instance**, against one method table for all of them, and a call
 *     that is not inlined. `../bench/slicecost.wac` puts an indirection at nanoseconds and a
 *     `readFile` is microseconds, so this is the case where that trade is right — and `gzip`'s
 *     window is the case where it is not.
 *   - **`const` goes.** `Env`'s `arg(const this, i32 i)` becomes `fn<string(i32)> arg`, and a funcref
 *     type cannot say the call does not mutate. `issues/lang/open/0315a` is why that is not a small
 *     loss: constness is a flag on a *name* rather than part of a type, so there was never anywhere
 *     for it to go here.
 *   - **`Ticket<Result<T, E>>` is now written out fourteen times.** The nesting complaint in
 *     `../QUESTIONS.md` stops being about one struct in `fs` and becomes the shape of the whole
 *     capability surface.
 *
 * And it removes the only thing that wanted *a method with no body*, one of the three constructs the
 * grammar has and no vetted page mentions.
 */

/**
 * Paths. Fourteen of the fifty, and **six of the fourteen are here**.
 *
 * The first six were chosen from what the packages written before `fs` happened to need, which is
 * the failure mode a first real consumer exists to find: `rename` and `linkStat` are in the host's
 * set and in the shipped `packages/fs`, and were missing until `fs` asked. **A projection assembled
 * from its early callers is a projection sized by who came first** — and the eight here are still
 * that, one consumer later. Fourteen is what the host has.
 */
/*
 * ── `Bytes` here, `u8[]` elsewhere, and the seam is where that matters ──────────────────────────
 *
 * `read` and `write` speak `Bytes` because `@/packages/fs`'s `Mount` does, and `Mount.onHost` assigns
 * `files.write` straight into a slot typed `fn<…(string, Bytes)>`. That assignment could not have
 * typechecked while this said `u8[]`: `slice.wac`'s rule is that *"a `T[]` widens to a `Slice<T>`
 * implicitly … safe, unchecked, and one direction only"*, so `u8[]` → `Bytes` is free and the
 * direction this needed is the other one. Passing a `Bytes` where `u8[]` is wanted costs
 * `toArray()`, which is the copy the type exists to avoid.
 *
 * **The rest of this file still says `u8[]`** — `Out.write`, `In.read`, `Random.fill`,
 * `Socket.send`, `Read.Data` — and that is left alone on purpose, because *which byte type a
 * capability speaks* is a decision rather than a sweep. `../QUESTIONS.md` has it. What the seam
 * showed is that the decision is load-bearing: with a one-directional widening, the two types are
 * not interchangeable at an interface and every boundary picks a side.
 */
export struct Files {
  fn<Ticket<Result<Bytes,    NotGranted>>(string)>          read;
  fn<Ticket<Result<void,     NotGranted>>(string, Bytes)>   write;
  fn<Ticket<Result<Stat,     NotGranted>>(string)>          stat;
  fn<Ticket<Result<string[], NotGranted>>(string)>          readDir;
  fn<Ticket<Result<void,     NotGranted>>(string, bool)>    mkdir;
  fn<Ticket<Result<void,     NotGranted>>(string, bool)>    remove;
  fn<Ticket<Result<void,     NotGranted>>(string, string)>  rename;
  fn<Ticket<Result<Stat,     NotGranted>>(string)>          linkStat;

  /**
   * A file as a stream of chunks, and a stream that consumes them.
   *
   * **Added 2026-09-04, after every stream package had been written without one.**
   * `@/packages/stream`, `@/packages/gzip` and `@/packages/unicode` are all transformers taking an
   * `AsyncGenerator` and there was no producer for one anywhere: `scalars.wac`'s own comment says
   * *"`E` is whatever the source fails with — a socket's failure, a file's, a fake's"* and a file's
   * did not exist. Four packages about streaming, and the only thing that could start a stream was
   * `Socket.recv`.
   *
   * **A generator per path, where the host has a global cursor.** The shipped shape is
   * `openInput(path)` then `readChunk()` — no handle, so it selects *the* input for the whole
   * program and one source may be open at a time. That is a capability with hidden state, which is
   * the thing this projection exercise exists to remove, and it is why the answer here is not the
   * host's two members renamed. `open` answers the stream; two calls answer two streams; nothing is
   * *the* input.
   *
   * `readChunk`'s own type is worth keeping: it is `fn[Read()]` — the same `Data | End | Failed` sum
   * `Socket.recv` has — so the host already distinguishes end from a short read here. It is `In.read`
   * that is the odd one out, which `../QUESTIONS.md` records.
   */
  fn<Result<AsyncGenerator<Bytes, Result<void, NotGranted>>, NotGranted>(string)>  open;
  fn<Result<Sink,                                            NotGranted>(string)>  create;

  /**
   * Permissions. `chmod` and `setExecutable` are the host's, and they were in `Cli` rather than in
   * anything file-shaped, which is why a projection derived by resource missed them.
   *
   * Two capabilities for one thing, and the second is the first with a fixed argument —
   * `setExecutable(path, on)` is `chmod` with the three execute bits. Kept as two because the host
   * has two and a rewrite that merged them would be claiming credit the language is not owed; that
   * it is a bad pair is a note rather than a change.
   */
  fn<Ticket<Result<void, NotGranted>>(string, i32)>   chmod;
  fn<Ticket<Result<void, NotGranted>>(string, bool)>  setExecutable;
}

/**
 * Somewhere to put chunks — the write half of `open`, and the half the host models worst.
 *
 * `Cli` has `openOutput(path)`, `outputError()` and `closeFeed(i32)`: a global current output, a
 * failure read back by a *separate call* after the fact, and a close that takes an integer nothing
 * else in the pair mentions. Three capabilities and no value tying them together.
 */
export struct Sink {
  fn<Ticket<Result<void, NotGranted>>(Bytes)>  write;
  fn<Ticket<Result<void, NotGranted>>()>       close;
}

/**
 * Sockets. The child's own, never the parent's.
 *
 * **Two of the host's nine, and both are streams**, which `vision/packages/quic` found by being the
 * second consumer. The file this is a rewrite of says why that is the wrong two: *"Every field above
 * this is stream — `connect`, `listen`, `accept`, `recv`, `send` — and QUIC needs none of them. A
 * QUIC server answers many peers from one socket, and a connection is identified by its connection
 * id rather than by an address."* `design/system/0007`.
 *
 * `Files` was short by two methods; this is short by a **shape** — a datagram endpoint is not a
 * `Socket`, since every read answers a peer and there is no accept.
 */
export struct Net {
  fn<Ticket<Result<Listener, NotGranted>>(i32)>          listen;
  fn<Ticket<Result<Socket,   NotGranted>>(string, i32)>  connect;
}

/**
 * Starting things — which, until 2026-09-04, it could not do.
 *
 * **This had one method and it was `exitCode`.** The host has seven process capabilities and the
 * projection named for processes carried the one that starts nothing;
 * `@/packages/sh/src/exec.wac` had `spawn` as a *free function* taking a `Proc`, so the value proved
 * authority rather than exercising it.
 *
 * `exitCode` is not authority over processes either. It is a fact about *this* one, in the same
 * family as `Env`'s `arg` and `cwd`, and it is here because the host groups it there.
 */
export struct Proc {
  fn<Ticket<Result<Child, NotGranted>>(Bytes, Vec<Bytes>, Vec<Grant>)>  spawn;
  fn<i32()>                                                             exitCode;

  /**
   * Run something *in this instance* — the host's `pushChild`/`popChild`, as one call.
   *
   * The audit of all 62 host capabilities on 2026-09-04 found nine process capabilities behind these
   * two. This is the one that is a design change rather than an addition, and it is the **second
   * paired-call protocol over hidden state** the audit turned up:
   *
   *     pushChild(args, stdin, cwd, capture)   … run something …   popChild() -> Captured
   *
   * A stack in the host, with the caller responsible for pairing the calls, and a `popChild` with
   * nothing pushed answering *"two empty arrays rather than failing"* because there is no value that
   * could have said the pairing was wrong. The other two are `openInput`/`readChunk`/`closeFeed` and
   * `openOutput`/`outputError`/`closeFeed` — see `Files.open` above, which is the same rewrite.
   *
   * Handing the child context back as a value makes the nesting the language's — a `run` inside a
   * `run` nests because calls nest — and there is no unpaired state for a caller to leave behind.
   *
   * **This is not an invention and I wrote it as though it were.** `packages/platform/src/frame.wac`
   * already does it — *"A child's world as a value, instead of a frame the host holds … a local the
   * caller holds, rather than a stack inside the host that an unmatched `popChild` corrupts for the
   * rest of the session"* — and it is the live path, with `inside.wac` and `insideValue.wac` sitting
   * beside each other as the same program written both ways. What made it possible was closures,
   * `design/lang/0002`: *"until closures landed a substitute capability had nowhere to put what it
   * collected."* So the contribution here is only moving it from a package into the projection, and
   * the reason `openInput` and `openOutput` have no equivalent is that nobody has been annoyed
   * enough yet — which `@/packages/box/src/tee.wac` is.
   *
   * **It is not isolation and the shipped comment is clear that it is not:** the child is the same
   * instance with the same authority, and *"a real boundary is `spawn`, which is a separate worker
   * with its own grants"*. So the `Vec<Grant>` that `spawn` takes has no counterpart here, which is
   * the honest shape and reads as a hole in it. `../QUESTIONS.md` has why that is worth stating
   * rather than papering over.
   *
   * **And it answered a `Captured` until the first consumer was written, which was the same defect
   * one layer along.** Giving the paired protocol a value fixed the *pairing* and kept the
   * *buffering*: a `Captured` is the whole output in memory, which is exactly what the shipped
   * sequential pipeline's `u8[] carried` is, and the shipped `Captured` already carries a
   * `truncated` flag and an 8 MiB cap because somebody hit it. `packages/sh/src/exec.wac` records
   * what it cost — *"`seq 1 1500000 | wc -c` printed `0` with status 0"* — and a whole
   * `refusedStage` mechanism exists to notice the overflow.
   *
   * It was also inconsistent with this file's own other answer: `Files.open` gives a generator and
   * `Files.create` gives a `Sink`, both because a stream is what a caller wants. One audit, two
   * shapes. `@/packages/sh/src/pipeline.wac` is the case where the difference is a wrong answer
   * rather than a preference, so `run` takes a stream and answers one, and a pipeline is a fold.
   */
  fn<Result<AsyncGenerator<Bytes, Exit>, NotGranted>(Vec<Bytes>, AsyncGenerator<Bytes, Exit>, string)>  run;
}

/**
 * How something ended.
 *
 * The generator's *return* rather than a field beside its output, which is what makes the status
 * arrive after the last byte instead of before the first. `Captured`'s `out` and `err` are gone with
 * the buffer; standard error is `Out.writeErr` in the instance the stage shares.
 *
 * **`err` going is a real loss and not a tidy-up.** A captured child's standard error was separable
 * from its output, and a stage that shares `Out` writes into the same place the shell does. Getting
 * it back means `run` answering two generators, or one generator of a two-armed sum — and the second
 * is `Read`'s shape, which `../QUESTIONS.md` is already unsure about.
 */
export struct Exit { i32 status; }

/** Read-only, and the reason `arg` is not on `Sys`: argv is known before the program starts. */
export struct Env {
  fn<string(i32)>   arg;
  fn<i32()>         argCount;
  fn<string?(string)> get;
  fn<string()>      cwd;
}

/**
 * Standard output and error.
 *
 * The narrowest useful projection and the one `box` wants: of its 63 applets, the ten that never
 * touch a filesystem still write, so `Out` is what they should be handed.
 */
export struct Out {
  fn<void(u8[])>   write;
  fn<void(u8[])>   writeErr;
  fn<void(string)> log;
}

/**
 * Standard input, which had no projection at all.
 *
 * `readStdin` is a host capability — `packages/ssh/src/ssh.wac` and four `platform` files use it —
 * and none of the seven had it. `Out` is the one it would go on and `Out` is named for output, which
 * is the tell: **the seven do not group by the same thing.** `Files`, `Net` and `Proc` group by
 * *resource*; `Env` by *facts about how this program started*; `Out` by *direction*; `Clock` and
 * `Random` are single capabilities raised to types. Standard input falls exactly where direction
 * meets resource, and that is why it fell through.
 *
 * `In` beside `Out`, or rename `Out` to `Io` and put all three there? `../QUESTIONS.md` has it as a
 * question, because it is the grouping principle that needs settling and not this type.
 */
export struct In {
  /**
   * **A stream, since 2026-09-04, and the third answer to a question that had two.**
   *
   * This was `fn<Ticket<u8[]>()> read` — a sentinel drawn from the value's own range, since the only
   * way it could say *end* was an empty array, while `Socket.recv` twelve lines down answers a
   * `Read` sum. The obvious fix was to give this a `Read` too. What changed the answer was
   * `Files.open` arriving: once a file is an `AsyncGenerator<Bytes, …>` and standard input is a
   * ticket-and-a-sentinel, `@/packages/box`'s `cat` has **two loops for one behaviour**, and `cat -`
   * cannot be written as one loop at all.
   *
   * So the question was never how *end* is said. It was that `In` was not a stream in a system that
   * has them. As one, the sentinel does not get a better spelling — it stops existing, because a
   * generator ending is the loop ending.
   *
   * **What it costs, and this is the part worth keeping.** `Read` distinguishes `Failed(string why)`
   * from `End`; a generator's return type has to carry the same thing, and here it is
   * `Result<void, NotGranted>` — so a failure to *read* standard input has no shape at all, and a
   * refused grant and a broken pipe arrive as the same value. `Read`'s `string why` was wrong for a
   * different reason (every other failure here is a `NotGranted`), and neither of the two is right.
   * `../QUESTIONS.md`.
   *
   * `Socket.recv` is now the odd one out. Its `Read` sum is a generator step written by hand, and
   * `Listener.accepted` beside it already answers a generator; making it `recv()` → a stream is the
   * same move again and is not made here, because a socket is bidirectional and `send` has nowhere
   * to live on a generator.
   */
  fn<AsyncGenerator<Bytes, Result<void, NotGranted>>()> stream;
}

/** Time is a capability because reading it is a fact about the machine, not about the program. */
export struct Clock {
  fn<i64()> nowMillis;
  fn<i64()> monotonicNanos;
}

export struct Random {
  fn<void(u8[])> fill;
}

/**
 * The document, for a program whose entry point is `page` rather than `main`.
 *
 * **The ninth projection, added 2026-09-04, and the reason it was missing is the argument for it.**
 * The seven were derived by counting the host's capabilities and finding five groups; that count was
 * taken over `Core` and `Cli`, and `Page`'s twelve were not in it. So a vision program could not be
 * interactive at all, in a system whose own `design/system/0001` treats the browser as a host rather
 * than a demo, and nothing noticed for nine days because nineteen subjects were command-line
 * packages.
 *
 * Compared against the host rather than assembled from a consumer, which is the check
 * `../QUESTIONS.md` says the first four projections should have had: all twelve members are here.
 *
 * **`render` takes a `Node`, and that is the one deliberate difference.** The shipped
 * `fn[Pending<bool>(string)]` takes markup as text, so the single file in the repository that uses
 * JSX writes thirteen lines of string concatenation underneath it to turn its `Node` back into a
 * string — for a host that parses it into a tree again. `@/packages/page` has the case written out.
 */
export struct Page {
  fn<Ticket<bool>(Node)>                                 render;
  fn<Ticket<bool>(string, string)>                       setText;
  fn<Ticket<bool>(string, string)>                       setValue;
  fn<Ticket<bool>(string, string)>                       setStyle;
  fn<Ticket<string>(string)>                             getValue;
  fn<Ticket<bool>(string, string)>                       on;
  fn<Ticket<Event>()>                                    nextEvent;
  fn<Ticket<bool>(string)>                               title;
  fn<Ticket<bool>(string, i32, i32, Bytes)>              drawPixels;
  fn<Ticket<bool>(string, i32, i32, i32, i32, Bytes)>    drawPixelsIn;
  fn<Ticket<Result<Picked, NotGranted>>()>               nextFile;
  fn<Ticket<bool>(string, Bytes)>                        offerDownload;
}

/** A file the user chose. `Picked` is what came back; not choosing one is `Err`. */
export struct Picked { string name; Bytes bytes; }

/**
 * What the user did — a union where the shipped `Event` is a struct with a `kind` string.
 *
 * `Event.kind` is one of eight literals documented in a comment, and every consumer compares against
 * them: `e.kind == "input"`, then `e.id == "up"`. A misspelling in either place is a page that
 * compiles and does nothing. Arms cannot be misspelled, and a ninth kind makes every match
 * inexhaustive rather than silently unhandled.
 *
 * **The `id`s are still strings and this does not fix that.** They are written in the markup and
 * compared in the loop, and the only thing that could relate the two is a type derived from the
 * document. Out of scope, and named in `@/packages/page`'s README so it is not mistaken for solved.
 */
export struct Click   { string id; }
export struct Typed   { string id; string value; }
export struct Changed { string id; string value; }
export struct Key     { string id; Bytes bytes; }
export struct Pointer { string id; i32 x; i32 y; }
export struct Dropped { string id; string name; Bytes bytes; }
export struct Quit    { }

export union<Click, Typed, Changed, Key, Pointer, Dropped, Quit> Event;

export struct Stat { i64 size; bool isDir; i64 modified; }

/**
 * A port this program was granted.
 *
 * Iterating it is the accept loop: `try await for (Socket conn in l.accepted())` yields one
 * connection at a time and ends when the listener closes.
 */
export struct Listener {
  fn<AsyncGenerator<Socket, Result<void, NotGranted>>()> accepted;
}

/**
 * Funcrefs for the same reason the projections are: a test that fakes a connection is the most
 * ordinary thing a server test does, and a subclass of this would not have run.
 *
 * `accepted` above changes shape rather than just spelling — a bodyless `async gen` method declared
 * the *signature* of a generator, and a field has to name the generator type it answers. That is
 * `AsyncGenerator<Socket, …>`, which is `coroutine.wac`'s, and it is the first place outside that
 * file where the type is written rather than the `gen` sugar.
 */
export struct Socket {
  /** Bytes, end, or a failure, and the caller has to say which it is handling. */
  fn<Ticket<Read>()>                            recv;
  fn<Ticket<Result<void, NotGranted>>(u8[])>    send;
  fn<void()>                                    close;
}

export enum Read {
  Data(u8[] bytes),
  End,
  Failed(string why)
}
