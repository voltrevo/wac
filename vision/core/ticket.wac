// A ticket is a value. Something else will settle it; until then you may hold it, pass it on, put
// it in an array, or wait for it. Nothing about it is a scheduler's business, which is why there is
// no scheduler here.
//
// `wait` is ordinary code in this file rather than an intrinsic. That is the load-bearing claim:
// if it can be written here, a fake `Sys` can add a kind of ticket without `core` being edited.

import { Result } from "core/result.wac";
import { Queue } from "core/queue.wac";

/** Waiting on something that is waiting on you. */
export struct Circular { }

/** Nothing can advance it and nobody else is going to try. */
export struct Stuck { }

/**
 * A ticket with its value type rubbed out.
 *
 * What survives the erasure is *driving*: a continuation carries one of these and steps it without
 * knowing or caring what it will answer. Both methods are overridden per kind of ticket — a host
 * read, a coroutine, a fake — and neither has a body here.
 */
/*
 * ── Funcrefs, not subclasses, and that removes the dispatch question ───────────────────────────
 *
 * `settled` and `advance` were **bodyless methods** here, overridden by `AllOf`, `AnyOf` and every
 * kind of ticket a capability hands out. `../QUESTIONS.md`'s dynamic-dispatch entry called that a
 * dependency of the ticket design and offered one alternative — *"a closed enum of kinds would
 * not"* let a fake add a kind — and dispatch in wac is static, measured, so the overrides never ran.
 *
 * **The dichotomy was false.** A third option is funcref fields, which is open to any kind, needs no
 * dispatch, and is what `std/platform.wac`'s `Pending<T>` already is:
 *
 *     export struct Pending<T> {
 *       i32 id;  fn[T(i32)] resolve;  fn[bool(i32)] settled;  fn[void(i32)] drop;  Sched? sched;
 *     }
 *
 * So the design this file is a rewrite of had already answered the question this file asks. Three
 * places in `vision/` reached for subclassing — the capabilities, the mounts in
 * `@/packages/fs/src/mount.wac`, and here — and the shipped tree uses funcrefs in all three.
 *
 * **What it takes with it**, which is the part worth reading twice:
 *
 *   - the **dynamic dispatch** entry, which was vision's largest open language question and is now
 *     a dependency of nothing here;
 *   - **a method with no body**, which had nothing else wanting it.
 *
 * And it takes **two of the five uses of a generic parent** — `AllOf` and `AnyOf` — which is less
 * than it first looked. `GRAMMAR.md` lists five and calls the construct load-bearing for *"the whole
 * ticket and coroutine design"*; the other three are `Generator<Y, R> : Coroutine<never, Y, R>` and
 * `AsyncGenerator`, and those are not inheritance at all. They are **names for a partial
 * instantiation**, written as inheritance because vision's `typedef` — `export Slice<u8> Bytes;` —
 * takes no type parameters. So one construct is doing two jobs, and the half that is really a
 * parameterised type alias should be asked for as one. `../QUESTIONS.md`.
 *
 * What remains true either way: **two constructs vision proposes, and its biggest open question,
 * existed to support one design choice the shipped tree does not make.**
 */
export struct TicketBase {
  /** Whether the value is in. */
  fn<bool()> settled;

  /**
   * Do some work towards settling. `block` says whether to wait on the world rather than only poll
   * it. Answers whether anything moved, which is what lets a driver tell *not yet* from *never*.
   */
  fn<bool(bool)> advance;
}

/** A ticket for a `T`. */
export struct Ticket<T> : TicketBase {
  /**
   * A ticket over several, answering when every one of them has.
   *
   * A static — no `this` — so `Ticket.all(parts)` is the call, which is what `IDIOMS.md` writes and
   * what this was not until 2026-09-04. `T` is inferred from `parts`.
   */
  Ticket<T[]> all(Ticket<T>[] parts) {
    return Ticket<T[]>(
      () => allSettled(parts),
      (bool block) => anyAdvanced(parts, block),
      false,
      () => allValues(parts),
    );
  }

  /**
   * Answers with the first to settle.
   *
   * The losers are not cancelled, because there is no such thing — they carry on as ordinary
   * unawaited work and whoever holds their tickets can still drive them. `TECHNICAL.md` has the
   * entry, and it calls this `Ticket.any`.
   */
  Ticket<T> any(Ticket<T>[] parts) {
    return Ticket<T>(
      () => anySettled(parts),
      (bool block) => anyAdvanced(parts, block),
      false,
      () => firstValue(parts),
    );
  }

  /** Set while this ticket's own `wait` is on the stack, so re-entering it is detectable. */
  bool inWait;

  /** The value. Calling this before `settled()` traps. */
  fn<T()> value;

  /**
   * Drive it to completion here, on this stack, and answer the value.
   *
   * This is what a *sync* caller does. Under `await` the caller's own driver does the same job, so
   * `await` answers a `T` where this answers a `Result` — the difference is that here there is
   * nobody else left to ask.
   */
  /**
   * **Shipped, and as a trap rather than a `Result`.** `design/lang/0014` D7 landed in
   * `std/platform.wac`, and what a `wait` that cannot advance does today is
   *
   *     trap "this ticket is answered by a continuation, so waiting cannot advance it — call core.drain()";
   *
   * with the reason at the line: *"waiting is a mistake rather than a delay"*. So the `Err(Stuck)`
   * below is not a new capability, it is a **different answer to a settled question** — and the
   * shipped one has the better of the argument where the caller cannot act, because a program that
   * waits on a ticket only `drain` can answer has a bug rather than a condition.
   *
   * Where it is weaker is that a caller *can* act: the message says to call `drain`. That is the
   * `http`/`regex` distinction from the other direction — a `Result` earns its place when an arm is
   * something the caller does something about, and here it might be.
   */
  Result<T, union<Circular, Stuck>> wait(this) {
    if (this.inWait) { return Result.Err(Circular()); }
    this.inWait = true;
    defer { this.inWait = false; }

    while (!this.settled()) {
      if (this.advance(false)) { continue; }   // anything ready, without waiting on the world
      if (this.advance(true))  { continue; }   // ...then wait on the world
      return Result.Err(Stuck());              // twice, and nothing moved
    }
    return Result.Ok(this.value());
  }
}

/**
 * A machine that is not being awaited, and the ticket it is waiting on if it is waiting on one.
 *
 * `t` being null is the whole of the distinction that used to be two enum arms: a continuation
 * that can run now, and one that cannot yet. `await c.t` covers both, since a null ticket is one
 * step boundary and no waiting.
 *
 * Calling `call` before `t` has settled traps. It is not checked at the type level because the
 * check would have to be *this ticket, now*, which no type can say.
 */
export struct Continuation {
  TicketBase? t;
  fn<void()> call;
}

// **`AllOf` and `AnyOf` are gone** — two structs inheriting from a generic instantiation, which was
// the only thing in the tree wanting that construct. What replaced them is four helpers over a
// `Ticket<T>[]`, and `all`/`any` above build an ordinary `Ticket` from lambdas over them. The kind of
// a ticket is what its funcrefs do, which is how `std/platform.wac`'s `Pending<T>` has always worked.

bool allSettled<T>(Ticket<T>[] parts) {
  for (Ticket<T> p in parts) { if (!p.settled()) { return false; } }
  return true;
}

bool anySettled<T>(Ticket<T>[] parts) {
  for (Ticket<T> p in parts) { if (p.settled()) { return true; } }
  return false;
}

/** Shared by both: a step on any part is a step on the whole. */
bool anyAdvanced<T>(Ticket<T>[] parts, bool block) {
  for (Ticket<T> p in parts) { if (p.advance(block)) { return true; } }
  return false;
}

T[] allValues<T>(Ticket<T>[] parts) {
  T[] out = T[parts.len()](fill: parts[0].value());
  for (i32 i = 0; i < parts.len(); i++) { out[i] = parts[i].value(); }
  return out;
}

T firstValue<T>(Ticket<T>[] parts) {
  for (Ticket<T> p in parts) { if (p.settled()) { return p.value(); } }
  trap "any: value before settled";
}

/**
 * Answers when every one of them has.
 *
 * The losers of an `any` are not cancelled, because there is no such thing — they carry on as
 * ordinary unawaited work and whoever holds their tickets can still drive them.
 */
// **These were free functions — `all<T>(parts)` — and three pages call them `Ticket.all(parts)`.**
// A `this`-less method is a static in wac, so the page's spelling needs them inside `Ticket<T>`, and
// the reason they were not there was an assumption rather than a constraint: a static on a *generic*
// struct, called without naming the instantiation, looked uncertain. Measured on 2026-09-04 and it
// is not — `B.of(3)`, `B<i32>.of(3)` and a free `mk(3)` all compile today, and inference is
// argument-directed exactly as `generics.md` says.
//
// Second time the pages wrote a method and the code wrote a free function taking the type; the other
// was `Proc.spawn`. Both were found by comparing the two halves rather than by reading either.
//
// Moved into `Ticket<T>` above as `all` and `any`, matching the pages.

