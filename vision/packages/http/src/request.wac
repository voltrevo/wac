// Parsing an HTTP/1.1 request off the front of a buffer.
//
// The byte-level work is the original's and is not repeated here — the RFC does not change because
// the language did. What changed is the shape of the answer and where the shared helpers live.

import { Result, Bytes } from "core";
import { Headers } from "./headers.wac";
import { RequestFault, BadRequestLine, BadMethod, BadTarget, BadVersion, TooLarge }
  from "./fault.wac";
import { findCrlf, isDigit, isToken } from "./bytes.wac";

/**
 * Views into the buffer it was parsed from, not copies.
 *
 * A request is read while the connection buffer is in hand and is gone before the next one, so
 * every field can be a view and **parsing an HTTP request allocates nothing at all**. That is only
 * safe because a slice cannot dangle — the collector keeps the buffer alive for as long as any view
 * of it — and only sensible because the lifetime is a call. A `JsonValue` does the opposite for the
 * opposite reason; `core/slice.wac` has the rule.
 */
/**
 * A request — **one type for both halves of this package, since 2026-09-05.**
 *
 * It was the *server*'s parse of an inbound message, and a client's outbound request was built by
 * `./client.wac` as bytes and never existed as a value. `./incoming.wac` found what that cost: its
 * `read` takes an `Asked` enum because it must know whether a HEAD was sent, and
 * `./response.wac`'s `write` takes a `bool headOnly` for the same fact — **two functions in one
 * package taking a request they had no type for**, neither aware of the other.
 */
export struct Request {
  /** **A `Method`, not `Bytes`.** The shipped response parser compares `"HEAD"` and `"CONNECT"`
   *  byte by byte on every response; the only thing anything wants is which category. */
  Method method;
  Bytes target;
  i32 minor;                        // the `x` of HTTP/1.x
  Headers headers;
  Bytes body;
  /**
   * What is left of the input, not how much was taken.
   *
   * **`tail`, not `rest`** — the package spelled this concept three ways (`Request.rest`,
   * `Incoming.rest`, `ProxyReply.Established(Bytes tail)`) and `@/packages/server`'s `Ctx` already
   * used `rest` for something else: the path segments after a route's prefix. One word per concept,
   * and `tail` is the one that was already unambiguous.
   */
  Bytes tail;
}

/**
 * The methods, and **the second open registry in this package spelled as a closed enum.**
 *
 * `./response.wac`'s `Status` is the first, and it records the cost: *an open set spelled as a
 * closed one with an escape hatch has two spellings for every member the hatch can reach*. Methods
 * are worse in one way and better in another — the registry is smaller and moves less, so the
 * escape is rarer; and `Other` carries the token so a proxy can forward a method it does not know,
 * which `Status.Other(i32)` also has to do.
 *
 * Two of them in one package is what makes it a shape rather than a case. Both are *the wire has a
 * token, the code has a decision, and the set of tokens is somebody else's to extend.*
 */
export enum Method {
  Get,
  Head,
  Post,
  Put,
  Delete,
  Connect,
  Options,
  Trace,
  Patch,
  Other(Bytes token)

  /** Whether a response to this has no body whatever its headers say — RFC 9112 §6.3 rule 1. */
  bool bodyless(const this) { return this is Head; }
  /** Whether a 2xx to this opens a tunnel — rule 2. */
  bool tunnels(const this) { return this is Connect; }
}

/*
 * `Exchange { Request sent; Incoming got; }` wanted to be here and is in `./incoming.wac`, because
 * **a type that pairs two others cannot live with either without a cycle.** Putting it here made
 * `request.wac` import `incoming.wac` and `incoming.wac` import `request.wac`; putting it there
 * costs nothing, because the response half already had to know about the request and the request
 * half does not know about the response. The asymmetry is real and it decided the placement.
 */

/**
 * Complete, refused, or not yet — and it stays three named cases.
 *
 * The obvious collapse is `Result<Request?, RequestFault>` with a null meaning *keep reading*, and
 * it is exactly the cute encoding `vision/README.md` refuses: two of the three outcomes would share
 * a constructor and a caller could handle the failure, forget the null, and quietly treat a partial
 * request as a complete one. Only `Bad` changed — it carried an `i32` and now carries what was
 * wrong.
 */
export enum Parsed {
  Ok(Request request),
  Bad(RequestFault why),
  Incomplete
}

/**
 * Parse a request from the front of `input`.
 *
 * `maxBody` caps the body this will assemble; a longer one is refused rather than buffered, so a
 * `Content-Length: 999999999999` costs nothing.
 */
export Parsed parseRequest(Bytes input, i64 maxBody) {
  // RFC 9112 §2.2: a server should ignore at least one empty line before the request line. Old
  // clients emit a stray CRLF after a body, and a parser that treats it as a malformed request line
  // drops the connection on the message that follows it.
  Bytes rest = skipOneBlankLine(input);

  i32? eol = findCrlf(rest, 0);
  if (eol is null) { return Parsed.Incomplete; }

  match (requestLine(rest.slice(0, eol!))) {
    Ok(line):  { … }
    Err(why):  { return Parsed.Bad(why); }
  }
  …
}

/**
 * The request line, or which part of it was wrong.
 *
 * A helper answering a `Result` is what lets `parseRequest` keep one `Bad` arm instead of the
 * original's eleven `return Parsed.Bad(ERR_…())` sites, each of which had to pick the right number.
 *
 * It took `(input, lo, hi)` a revision ago. Handed a `Bytes` it takes **one** argument, and the
 * caller cannot pass the bounds of one buffer with another — which is the whole reason the type
 * exists rather than a tidiness argument for it.
 */
Result<RequestLine, union<BadRequestLine, BadMethod, BadTarget, BadVersion>>
requestLine(Bytes line) { … }

struct RequestLine {
  Bytes method;
  Bytes target;
  i32 minor;
}

/** Everything after at most one leading empty line. */
Bytes skipOneBlankLine(Bytes input) { … }
