// The package, as one name. Nothing resolves a directory today — see `core/core.wac`.
//
// `findCrlf` and `isToken` are **not** here, and that is the point of the barrel being a list. Both
// live in `bytes.wac` and are exported so that `request.wac` and `incoming.wac` can share them;
// neither belongs to anyone outside this directory. The original had no way to say that, so it
// duplicated them instead — its header says *"neither wanted to export a helper the other would
// then depend on"*, which is a duplicate chosen over a leak.

// `eqFold` is here and `isToken` is not, which is the judgement a barrel exists to record:
// comparing a field value case-insensitively is something a caller of this package does, and
// recognising a tchar is not.
export { Headers, Building, Field, eqFold } from "./headers.wac";
export {
  Incoming, Exchange, Received, Framing, NoBodyWhy, Limits, read,
  NoBody, Chunked, Length, UntilClose, HeadRequest, StatusHasNone, TunnelOpen,
} from "./incoming.wac";
export { Response, Status, write } from "./response.wac";
export { Request, Parsed, parseRequest, Method,
         Get, Head, Post, Put, Delete, Connect, Options, Trace, Patch, Other }
  from "./request.wac";
export { Draft, Owned, OutgoingFault, WriterOwns, HostRequired, write as writeRequest }
  from "./outgoing.wac";
export {
  ProxyAt, ProxyReply, ProxyFault, ProxyUrlFault, parseProxy, connectRequest, readReply,
  connectThrough,
  NeedMore, Established, Refused, NotHttp,
  NoAuthority, NoHost, NoPort, PortNotDigits, PortOutOfRange, ProxyRefused, ProxyNotHttp,
  // `NotGranted` is `std`'s and is an arm of `ProxyFault`, so a caller matching one needs it in
  // scope through this package. Found by the *an import is not an export* sweep — one hit in the
  // whole directory, which is the honest size of that finding.
  NotGranted,
} from "./proxy.wac";
// **All ten members, not just the two with payloads.** Until 2026-09-05 this line exported
// `RequestFault` and two of its members, so a caller outside the package could name the union and
// could not `match` it: `@/packages/server/src/refuse.wac` is the first file that tried and the
// import failed on eight names. A union's members are its interface — exporting the union without
// them is exporting a type nobody can take apart.
//
// Swept afterwards: **1 of 21** barrel-exported unions here had the hole, so it is a slip rather
// than a pattern, which matters because it rules out *the members were not reachable* as an
// explanation for the 137 unconsumed members in `../../../QUESTIONS.md`. They were reachable.
export {
  RequestFault, ResponseFault, BadStatus,
  BadMethod, BadTarget, BadVersion, BadRequestLine,
  BadHeaderName, BadHeaderValue, ObsFold, AmbiguousFraming, BadChunk, TooLarge
} from "./fault.wac";
// **The client half, added when `@/packages/ethrpc` asked for it and not before.** A package with a
// server and no client is a shape a barrel written without a consumer does not notice, because
// nothing in the package refers to the missing half.
export { post, get, HttpFault, NoConnection, SendFailed, ReadFailed, Incomplete, Unparseable }
  from "./client.wac";
