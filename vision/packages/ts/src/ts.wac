// The package, as one name.
//
// `strip` and the two types it is defined over. The lexer is not re-exported: a caller wanting
// tokens wants `@/packages/ts`'s job done, and the one consumer that genuinely wants tokens is the
// bundler, which is step 4 of `design/system/0009` and is not written in either tree.

export { Kind, Token } from "./token.wac";
export { Blanked } from "./blank.wac";
export { strip } from "./strip.wac";
export {
  StripFault, LexFault, At, EmitsRuntimeValue, NothingToLeave, ParameterProperty, Unterminated,
} from "./fault.wac";
