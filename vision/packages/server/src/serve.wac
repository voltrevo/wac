// One connection's worth of bytes, as a pure function.
//
// This stays pure, and it stays here, because the SHOWCASE entry that says so is right: a server
// written as a callback soup can only be tested by running it, and this can be tested by calling
// it. What changed is that the *loop around it* is now writable in wac too — see `main.wac`. The
// original's header opens "wac has no sockets, so the host owns the accept loop", and that sentence
// is what the capability model deletes.
//
// `consumed` is what makes keep-alive and pipelining work, and it comes straight from the parser. A
// server that answers correctly but is wrong about where the request ended will read the next
// request's first bytes as the tail of this one.

import { Bytes } from "core";
import {
  Parsed, Request, parseRequest, RequestFault, TooLarge,
  Response, Status, Sending, write, eqFold, BadRequest, PayloadTooLarge,
} from "@/packages/http";
import { route } from "./routes.wac";

/** The largest body this accepts. A larger one is refused with 413 rather than buffered. */
const i64 MAX_BODY = 1 << 20;

/**
 * Not enough bytes yet, or a response and what to do next.
 *
 * The original is a struct of `(bool ready, u8[] response, i32 consumed, bool keepAlive)` where
 * three of the four fields mean nothing when `ready` is false. Nothing stopped a host reading
 * `consumed` off a `Served` that had none — the value it would get is `0`, which is a legal answer
 * meaning something else entirely.
 */
export enum Served {
  Incomplete,
  Done(u8[] response, i32 consumed, bool keepAlive)
}

/**
 * Handle whatever is in `input`.
 *
 * `nowMillis` is passed in rather than read. wasm has no clock, and a handler that takes the time
 * as an argument is one that can be tested at a fixed instant.
 */
export Served serve(Bytes input, i64 nowMillis) {
  match (parseRequest(input, MAX_BODY)) {
    Incomplete: {
      return Served.Incomplete;
    }
    Bad(why): {
      // A malformed request means the byte stream can no longer be trusted to be a sequence of
      // messages, so the connection closes whatever the client asked for. Continuing on a stream
      // whose framing is in doubt is the smuggling condition itself.
      // **No invented method.** The original writes `"GET"` here — see §2.
      return Served.Done(bare(statusFor(why), Sending(true, false)), input.len(), false);
    }
    Ok(request): {
      bool keep = wantsKeepAlive(request);
      Response res = route(request, nowMillis);
      return Served.Done(
        write(res, Sending(!request.method.bodyless(), keep)), request.rest, keep);
    }
  }
}

/**
 * Which status a fault deserves.
 *
 * `code == ERR_TOO_LARGE()` in the original — an integer compared against a function returning a
 * literal, in a file that also has integers meaning statuses and integers meaning positions.
 */
Status statusFor(RequestFault why) {
  return match (why) {
    TooLarge: PayloadTooLarge,
    default:  BadRequest,
  };
}

/**
 * Whether to keep the connection open, from the request's version and its `Connection` field.
 *
 * HTTP/1.1 keeps by default and closes on `Connection: close`; 1.0 is the other way round and needs
 * an explicit `keep-alive`. Getting this backwards for 1.0 is how a client hangs waiting for a
 * response it has already been given.
 */
bool wantsKeepAlive(Request req) {
  Bytes conn = req.headers.first("Connection");
  if (eqFold(conn, "close".toBytes())) { return false; }
  if (req.minor == 0) { return eqFold(conn, "keep-alive".toBytes()); }
  return true;
}

/**
 * A bare status with no body, for the cases where there is nothing useful to say.
 *
 * **The original takes a method and this takes a `Sending`**, which is the whole of §2. The method
 * was only ever consulted for *is this a HEAD*, and on the path that calls this there is no request
 * to ask.
 */
Bytes bare(Status status, const Sending how) {
  return write(Response.of(status), how);
}

// ## 2. The writer never wanted the request, and the error path is what said so
//
// This file's error path is where three days of `@/packages/http` redesign broke. `write` went
// `bool headOnly` → `const Request sent`, on the argument that two functions in that package were
// taking a request it had no type for — and **here there is no request**, because parsing is what
// failed.
//
// The shipped code's answer is to invent one:
//
//     return Served(true, bare(status, "GET".toBytes(), false), input.len(), false);
//
// `"GET"` there means *not a HEAD*. It is a real method standing for *unknown*, which is
// `../../../QUESTIONS.md`'s *a sentinel drawn from the value's own range* at a new site — and the
// range it is drawn from is an **open registry**, so there is no spare value to use instead.
//
// So the writer wanted **two decisions the request happens to determine**, both known on the error
// path: may a body be sent, and does the connection survive. `Sending` names them, and the error
// path says `Sending(true, false)` — a body is allowed, the connection closes — with nothing
// invented.
//
// > **A unification is only right where every caller has the thing.** `read` genuinely holds the
// > request it sent; both writers hold its *consequences*. I unified on the value rather than on
// > what the value was consulted for, and the caller that could not supply it is the one that had
// > no request at all.
//
// ## 3. What nothing caught
//
// Every call in this file went stale when `@/packages/http` changed and **no checker said a word**:
// `write(res, request.method, keep)` against a two-argument `write`, `Response.create(status)`
// against `Response.of(Status)`, `request.consumed` against `rest`, and `statusFor` answering `i32`
// where `Status` exists. The names all still resolve, and `../../../README.md` says nothing here
// compiles.
//
// That is the directory's own rule working as intended and it has a cost worth stating once: **a
// redesign of a package leaves its consumers stale silently**, and the only reason these were found
// is that this file was read on purpose four days later. Four call sites in one file, from one
// change, in the package that change was for.
