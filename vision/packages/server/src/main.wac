// The accept loop, in wac.
//
// This file cannot exist today. `serve.wac`'s header opens "wac has no sockets, so the host owns
// the accept loop and the buffers", and everything below is what stops being true once a socket is
// a value the program was handed.
//
// The shape to notice is that there is no framework. Concurrency is `handle(conn);` without an
// `await` — the call runs to its first suspension and hands its continuation to whoever is
// scheduling, and the loop goes straight back to accepting. One slow client does not hold the door,
// and nothing here mentions a task, a pool or an executor.

import { Net, Out, Clock, Tasks, Socket, Listener, Read, NotGranted } from "std";
import { Buf } from "@/packages/bytes";
import { Served, serve } from "./serve.wac";

/**
 * Four projections rather than a `Sys`, which is what deleting the bundle looks like at the one
 * function that took one.
 *
 * It was `main(Sys sys)`, and measured on 2026-09-04 it was the **only** function in fifty-nine
 * files that needed the bundle — for `await sys.drain()`. So the signature says what this program
 * is: it listens, it writes, it reads a clock, and it has outstanding work. There is no filesystem
 * in scope and no way to reach one.
 *
 * **`Tasks` is the honest awkward one.** The other three are things this program *does*; a scheduler
 * is something it *has*, and it appears here because the queue has to be reachable from the one
 * place that drains it. `std/platform.wac` puts it on `Core` for the same reason and calls it *"a
 * value the host builds at start-up and hands over with the rest of the capabilities"*, so the
 * awkwardness is the design's rather than this line's.
 */
export async i32 main(Net net, Out out, Clock clock, Tasks tasks) {
  match (await net.listen(7000)) {
    Err(e): { out.log("no port: \{e.what}"); return 1; }
    Ok(l): {
      out.log("listening on 7000");
      try await for (Socket conn in l.accepted()) {
        handle(out, clock, conn);
      }
    }
  }

  // Every connection still in flight gets to finish. Without this the program would exit with
  // half-written responses, and *dangling work is an error* would have nothing to point at.
  await tasks.drain();
  return 0;
}

/**
 * One connection, until the client stops asking or the framing stops making sense.
 *
 * Nobody awaits this. It suspends at its first `recv` and its continuation goes to the scheduler in
 * force where it was called — `main`'s, which is `sys`'s — so `drain` is what eventually finishes
 * it.
 *
 * **It takes two projections rather than a `Sys`.** It writes and it reads the clock; it has no
 * business opening a file or a second port, and handing it `sys` would let it. That is the whole
 * point of the grouping and it costs one extra parameter here.
 */
async void handle(Out out, Clock clock, Socket conn) {
  // Four ways out of this function below — two `break`s and two `return`s — and the socket closes
  // on all of them. That is the whole argument for `defer` in one function.
  defer { conn.close(); }

  Buf pending = Buf.create();

  while (true) {
    match (await conn.recv()) {
      Data(bytes): { pending.pushAll(bytes); }
      End:         { break; }
      Failed(why): { out.log("connection lost: \{why}"); break; }
    }

    // Pipelining: one arrival can carry more than one request, so keep answering while the buffer
    // holds whole ones.
    while (true) {
      match (serve(pending.bytes(), clock.nowMillis())) {
        Incomplete: { break; }
        Done(response, consumed, keepAlive): {
          if ((await conn.send(response)).isErr()) { return; }
          pending.drop(consumed);
          if (!keepAlive) { return; }
        }
      }
    }
  }
}
