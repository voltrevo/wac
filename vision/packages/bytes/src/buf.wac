// A growable byte buffer.
//
// The shape is performance work and it stays: `len` is a public field rather than a method because
// it is read once per pushed byte in gzip's inner loops, and `reserve()` takes no argument and
// checks for exactly one byte so the common `push` path is a single comparison. Bulk appends use
// `reserveFor(n)`. None of that is language and none of it moved.
//
// **What moved is `bytes()`.** It answered `u8[]`, and `data` is over-allocated, so it had to copy
// the filled prefix out — every call, whatever the caller then did with it. `server`'s connection
// loop calls it once per pipelined request:
//
//     match (serve(pending.bytes(), sys.now())) { … }
//
// so a client sending three requests in one packet paid for three copies of the whole buffer, to
// read a prefix of it three times. Answering a `Bytes` is the same information with no copy, and it
// is exactly what `core/slice.wac` was written for.

import { Bytes, Slice } from "core";

// ## And `pushStr` copies, because a `Bytes` cannot view a `string`
//
// `this.pushAll(Slice.all(s.toBytes()))` allocates a `u8[]` per append. It is linear over the whole
// build where `out = out + s` is quadratic, so it is the better trade and it is not the free one, and
// the reason is in the emitter:
//
// > `string` and `u8[]` hold the same bytes and are *different types*, which is why this is a copy
// > and not the no-op it looks like. One function serves both directions, because the only difference
// > is which type index goes where.
//
// `packages/wacc/src/emit.wac`'s `emitBytesCopy` exists for exactly this. A `string` is an `i8[]` at
// the runtime and `Bytes` is `Slice<u8>`, so a view would need a `Slice<i8>` or a signed/unsigned
// reinterpretation of one array — and **the two arrays are the same bytes at two element types**,
// which is a wasm distinction that reaches all the way up into a `Buf`'s API.
//
// So the third thing in `../../../QUESTIONS.md`'s *string builder* line is not the builder: it is
// that appending text to bytes cannot avoid a copy however the builder is spelled.

export struct Buf {
  u8[] data;
  i32 len;

  Buf create() { return Buf(u8[16](), 0); }

  /**
   * Pre-sized, for when the final length is known up front — inflate reads it from the gzip
   * trailer. Skips the doubling reallocations, and lets `take` hand back the array without a copy.
   */
  Buf withCapacity(i32 capacity) {
    if (capacity < 16) { capacity = 16; }
    return Buf(u8[capacity](), 0);
  }

  u8 get(const this, i32 i) {
    // `trap;` in the original, which carries nothing. A bare trap in a buffer read is the least
    // helpful place in the stack to arrive with no message.
    if (i < 0 || i >= this.len) { trap "Buf.get out of range"; }
    return this.data[i];
  }

  /** Make room for at least one more byte. */
  void reserve(this) {
    if (this.len < this.data.len()) { return; }
    // Doubling zero is zero, so the floor is load-bearing rather than defensive: without it an
    // empty buffer grows to nothing and the store goes out of bounds. Unreachable while every
    // constructor started at 16, and reachable as soon as `take` began leaving the buffer empty.
    i32 cap = this.data.len() * 2;
    if (cap < 16) { cap = 16; }
    u8[] next = u8[cap](fill: 0);
    next.copyFrom(this.data, 0, 0, this.len);
    this.data = next;
  }

  /** `v` is a `u8` now. It was an `i32` that every call site truncated. */
  void push(this, u8 v) {
    this.reserve();
    this.data[this.len] = v;
    this.len += 1;
  }

  /**
   * What is in it, as a view. No copy.
   *
   * The view is invalidated by the next `push` that grows — `reserve` replaces `data`, and the
   * slice keeps pointing at the old array, which is stale rather than unsafe. That is a real hazard
   * and it is the one the type does not carry: nothing in the signature says *read this before you
   * write again*. It is why `take` still exists and still hands over an array.
   */
  Bytes bytes(const this) { return Slice(this.data, 0, this.len); }

  /** The array, with the buffer left empty. The caller owns it and may keep it. */
  u8[] take(this) { … }

  /** Forget the first `n` bytes, which is what a connection loop does after answering. */
  void dropFront(this, i32 n) { … }

  /**
   * Keep the first `n` bytes and forget the rest.
   *
   * **`packages/bytes` has no such thing, and a line discipline pays for it.** `dropFront` is this
   * operation from the other end and has been there all along; nothing shortens from the back, so
   * `packages/tty/src/line.wac`'s `dropLast` takes the whole buffer, copies all but one byte into a
   * new `Buf`, and replaces it. One full copy per backspace — and `^W` calls it once per byte of the
   * word, so erasing ten characters at the end of a 4,000-byte line copies about 40,000 bytes.
   *
   * The array does not move: `len` does. `@/packages/tty/src/line.wac` is the consumer that wanted
   * it, and the shipped gap is filed.
   */
  void truncate(this, i32 n) { … }

  void pushAll(this, Bytes more) { … }
  void reserveFor(this, i32 n) { … }

  /**
   * Append a `string`, and it is the method the shipped `Buf` never had.
   *
   * `packages/bytes/src/buf.wac` has `toStr()` — `return string.fromBytes(this.bytes());`, two lines
   * — and no way in. **Somebody wrote the convenience for getting a `string` out and not the one for
   * putting a `string` in**, and `issues/lang/0347a` counts what that cost: **257 string
   * accumulations inside a loop across every package's `src` and `tools/`, 142 of them in
   * `packages/wacc`**, each of them `out = out + …` where `"a" + "b"` is a call to the runtime's
   * ` str_concat` and allocates the combined length.
   *
   * This file lost `toStr` too, so vision's `Buf` had neither direction. Both are here now.
   *
   * *This paragraph broke the file twice while being written*, and the second way is the better
   * finding. `../../../core/order.wac` recorded an hour earlier that a glob ends a block comment,
   * because it contains a star and a slash in that order. Written here, it broke the file again —
   * and then the **sentence explaining it** broke the file, because it quoted the closing delimiter.
   *
   * So: **a doc comment cannot contain a path pattern, and it cannot describe the rule that says so.**
   * The first is a nuisance a checker could catch. The second is why the rule keeps being
   * rediscovered — the natural place to write it down is the one place it cannot be written.
   */
  void pushStr(this, string s) { this.pushAll(Slice.all(s.toBytes())); }

  /** What is in it, as a `string`, taking it to be UTF-8. */
  string str(const this) { … }
}
