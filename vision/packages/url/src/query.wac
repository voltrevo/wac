// A query string, as parameters.
//
// **This is the first place in the tree that needs `T??`, and it needs it for a real reason rather
// than to demonstrate that it exists.**
//
// A query has three states per name, not two:
//
//     ?a=1        the name is there, with a value
//     ?a=         the name is there, with an empty value
//     ?a          the name is there, with no value at all
//     (absent)    the name is not there
//
// `a=` and `a` are different — the first says the value is empty and the second says there is no
// value — and the standard keeps them apart because a server may treat them differently. So a
// parameter's value is `u8[]?`, and looking one up answers `u8[]??`: **the outer absence is *no
// such parameter*, the inner is *no value*.**
//
// Under a flattening `?` those two would arrive as one null and the API could not tell them apart.
// `packages/server`'s `queryToJson` is what that costs today: it emits `"a": ""` for both spellings,
// so a round trip through it loses the distinction the parser was careful to keep.

import { Vec, Bytes } from "core";
import { decode as pctDecode } from "./percent.wac";

/**
 * One `name=value`, as views into the query it was cut from.
 *
 * Undecoded, and that is the point of a slice being a view: parsing a query allocates nothing at
 * all, and a request with forty parameters of which a handler reads two pays for two.
 */
export struct Param {
  Bytes name;
  /** Null when the name appeared with no `=` at all. */
  Bytes? value;
}

export struct Query {
  Vec<Param> params;

  /**
   * The first parameter with this name.
   *
   * `null` — not there. `Ok` holding `null` — there, with no value. `Ok` holding bytes — there,
   * with that value, which may be empty.
   */
  u8[]?? get(const this, Bytes name) {
    for (Param p in this.params.items()) {
      if (eqDecoded(p.name, name)) {
        return p.value is null ? (null as u8[]?) : formDecode(p.value!);
      }
    }
    return null;
  }

  /** Whether the name appears at all, however it appears. */
  bool has(const this, Bytes name) { return this.get(name) is not null; }

  /**
   * Every value for a repeated name, in order.
   *
   * `?a=1&a&a=` answers three elements: `1`, null, and empty. A caller that only wants the ones
   * carrying a value filters, and the type makes it say so.
   */
  gen<u8[]?> void all(const this, Bytes name) {
    for (Param p in this.params.items()) {
      if (eqDecoded(p.name, name)) {
        yield p.value is null ? null : formDecode(p.value!);
      }
    }
  }
}

/**
 * Parse `a=1&b&c=` — percent-decoding, and `+` meaning space.
 *
 * Those are the form-encoding rules rather than the URL ones, which is why this is here and not in
 * the parser: `url.wac` parses a query, it does not interpret one. In the original this lived in
 * `packages/server`, three packages away from the thing it is about, because the type it wanted to
 * answer could not be written.
 */
export Query parseQuery(Bytes raw) {
  Vec<Param> out = Vec<Param>.create();
  i32 at = 0;

  while (at <= raw.len()) {
    i32 end = at;
    while (end < raw.len() && raw.get(end) != '&') { end += 1; }

    if (end > at) {
      i32 eq = at;
      while (eq < end && raw.get(eq) != '=') { eq += 1; }
      // No `=` in the pair means no value — which is the whole reason `value` is nullable.
      Bytes? value = eq < end ? raw.slice(eq + 1, end) : null;
      out.push(Param(raw.slice(at, eq), value));
    }

    if (end >= raw.len()) { break; }
    at = end + 1;
  }
  return Query(out);
}

/**
 * Percent-decoding plus `+` meaning space, which is what a query string uses.
 *
 * This is the one place that allocates, and it allocates because it has to: decoding changes the
 * bytes, so the answer cannot be a view of the input.
 */
u8[] formDecode(Bytes s) {
  u8[] plussed = u8[s.len()](fill: 0);
  for (i32 i = 0; i < s.len(); i++) { plussed[i] = s.get(i) == '+' ? ' ' : s.get(i); }
  return pctDecode(plussed);
}

/** Names are compared decoded, since `a b` and `a+b` are the same name. */
bool eqDecoded(Bytes a, Bytes b) { … }
