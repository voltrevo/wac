// JSON and JSON5, into a `JsonValue`.
//
// The original returns `JsonValue?` and leaves the reason on the parser — `p.err` is one of eleven
// exported `i32` functions and `p.errPos` is where. Every caller that wants to know why has to
// remember to look somewhere else, and one that forgets gets "not JSON" for a document that was
// three bytes too short. Here the reason *is* the answer.

import { Result, Vec, Bytes } from "core";
import { JsonValue, JsonObject, JsonMember } from "./value.wac";

/**
 * What was wrong, and **where in what** — one field, because the two were always one thing.
 *
 * `i32 at` until 2026-09-05, which is the shape `../../../QUESTIONS.md` counted 35 of: a fault
 * carrying a position and not the thing it indexes. The consequence was that
 * `Result<JsonValue, ParseError>` could not be turned into a message without the caller handing back
 * the document it had just passed in.
 *
 * `Bytes` is `Slice<u8>` — `{ of, from, len }` — so a zero-length slice positioned at the fault *is*
 * the pair: `at.of` is the document, `at.from` is the offset. Nothing new was added to `core` and no
 * field was added here; the `i32` became the type that already carried both halves.
 */
export struct ParseError {
  Bytes at;
  Reason why;
}

/**
 * Eleven `i32` constants became eleven cases.
 *
 * They were functions returning literals — `ERR_DEPTH()` is `7` — because that was the only way to
 * name a constant, and nothing stopped a caller comparing one against a position. As cases they
 * cannot be confused with anything, they cannot be added up, and a `match` over them is checked.
 */
export enum Reason {
  Unexpected,     // wrong byte for the position
  Eof,            // ran out of input mid-value
  BadNumber,
  BadEscape,
  RawControl,     // a raw control byte inside a string
  Trailing,       // non-whitespace after the value
  TooDeep,
  BadUtf8,        // malformed UTF-8 inside a string
  Unterminated,   // JSON5: `/*` with no `*/`
  Unsupported     // JSON5: valid, but this parser does not accept it
}

/** How deep nesting may go before the answer is `TooDeep` rather than a stack overflow. */
const i32 MAX_DEPTH = 512;

export struct Parser {
  const Bytes src;
  const bool json5;
  i32 at;
  i32 depth;

  Parser json(Bytes src)  { return Parser(src, false, 0, 0); }
  Parser json5(Bytes src) { return Parser(src, true, 0, 0); }

  /** A whole document: one value, then nothing but space. */
  Result<JsonValue, ParseError> document(this) {
    this.space();
    JsonValue v = try this.value();
    this.space();
    if (this.at < this.src.len()) { return this.fail<JsonValue>(Reason.Trailing); }
    return Result.Ok(v);
  }

  Result<JsonValue, ParseError> value(this) {
    if (this.depth >= MAX_DEPTH) { return this.fail<JsonValue>(Reason.TooDeep); }
    u8? b = this.peek();
    if (b is null) { return this.fail<JsonValue>(Reason.Eof); }

    // Each of these consumes what it recognised, or fails saying where.
    if (b! == '{')                    { return this.object(); }
    if (b! == '[')                    { return this.array(); }
    if (b! == '"')                    { return this.str(); }
    if (b! == '\'' && this.json5)     { return this.str(); }
    if (this.wordAhead("true"))       { return Result.Ok(JsonValue.Bool(true)); }
    if (this.wordAhead("false"))      { return Result.Ok(JsonValue.Bool(false)); }
    if (this.wordAhead("null"))       { return Result.Ok(JsonValue.Null); }
    return this.number();
  }

  Result<JsonValue, ParseError> array(this) {
    this.at += 1;                            // '['
    this.depth += 1;
    defer { this.depth -= 1; }

    Vec<JsonValue> items = Vec.create();
    this.space();
    if (this.eat(']')) { return Result.Ok(JsonValue.Array(items)); }

    while (true) {
      items.push(try this.value());
      this.space();
      if (this.eat(']')) { return Result.Ok(JsonValue.Array(items)); }
      if (!this.eat(',')) { return this.fail<JsonValue>(Reason.Unexpected); }
      this.space();
      // JSON5 allows the comma before the bracket; JSON does not, and `eat` already moved past it.
      if (this.json5 && this.eat(']')) { return Result.Ok(JsonValue.Array(items)); }
    }
  }

  Result<JsonValue, ParseError> object(this) {
    this.at += 1;                            // '{'
    this.depth += 1;
    defer { this.depth -= 1; }

    JsonObject members = JsonObject.create();
    this.space();
    if (this.eat('}')) { return Result.Ok(JsonValue.Object(members)); }

    while (true) {
      Bytes key = try this.key();
      this.space();
      if (!this.eat(':')) { return this.fail<JsonValue>(Reason.Unexpected); }
      this.space();
      members.push(key, try this.value());
      this.space();
      if (this.eat('}')) { return Result.Ok(JsonValue.Object(members)); }
      if (!this.eat(',')) { return this.fail<JsonValue>(Reason.Unexpected); }
      this.space();
      if (this.json5 && this.eat('}')) { return Result.Ok(JsonValue.Object(members)); }
    }
  }

  // Elided: the same byte-level work as the original, answering a `Result` instead of setting a
  // field. `{ … }` rather than no body, because a bodyless method is how `core` asks for an
  // override and these are not that.
  /** Whitespace, and in JSON5 comments too. */
  void space(this) { … }

  Result<Bytes, ParseError> key(this) { … }
  Result<JsonValue, ParseError> str(this) { … }
  Result<JsonValue, ParseError> number(this) { … }
  bool wordAhead(this, string word) { … }

  u8? peek(const this) { return this.at < this.src.len() ? this.src.get(this.at) : null; }

  bool eat(this, u8 b) {
    if ((this.peek() is null) || this.peek()! != b) { return false; }
    this.at += 1;
    return true;
  }

  /**
   * Every failure goes through here, so a position can never be forgotten.
   *
   * `T` appears in no argument, so inference cannot reach it and every call writes it:
   * `this.fail<JsonValue>(Reason.Eof)`. That is the spec's rule rather than a wart —
   * `generics.md` `[§wacc-written-type-args]` says a slot does not determine a call's type
   * parameters, and `Vec<T> empty<T>()` is called as `empty<i32>()`.
   */
  Result<T, ParseError> fail<T>(const this, Reason why) {
    // A zero-length view at the cursor. `this` already holds `src` — the producer always had both
    // halves and only ever wrote down one, which is the whole of the 35.
    return Result.Err(ParseError(this.src.slice(this.at, this.at), why));
  }
}

/**
 * The fault as a person reads it, **from the fault alone.**
 *
 * This is the test of the change above and the reason it was made. Before it, this function needed
 * `render(Bytes src, ParseError e)` — the document passed back alongside the error that came out of
 * parsing it — which is what every other diagnostic in this directory still does:
 *
 *     say(string path, FileFault f)              @/packages/box/src/cp.wac
 *     say(string name, ArgFault f)               @/packages/box/src/lib/args.wac
 *     say(const Rules rules, const Finding f)    @/packages/git/example/ignorelint.wac
 *     say(string what, Invalid why)              @/packages/tor/src/verdict.wac
 *
 * Five for five took the fault plus the thing it was about. This is the first that does not.
 */
export string render(const ParseError e) {
  i32 line = 1;
  i32 lineStart = 0;
  for (i32 i = 0; i < e.at.from; i++) {
    if (e.at.of[i] == 0x0A) { line = line + 1; lineStart = i + 1; }
  }
  i32 lineEnd = lineStart;
  while (lineEnd < e.at.of.len() && e.at.of[lineEnd] != 0x0A) { lineEnd = lineEnd + 1; }
  string text = string.fromBytes(Bytes(e.at.of, lineStart, lineEnd - lineStart));
  return "\{line}:\{e.at.from - lineStart + 1}: \{say(e.why)}\n\{text}\n"
    + spaces(e.at.from - lineStart) + "^\n";
}

/** `n` spaces, for the caret line. */
string spaces(i32 n) { … }

/** One `Reason`, as a sentence. Takes no subject, which is the point. */
string say(Reason why) { … }

// ## The change worked, and it cost one line in the producer
//
// `fail` gained `this.src.slice(this.at, this.at)` and `ParseError`'s `i32` became a `Bytes`. Nothing
// else in the parser changed, because `fail` is the only place a `ParseError` is constructed — which
// is why this package was the right one to try it on and is not a general result. A parser with
// twelve raise sites would have twelve edits, and a fault raised by a *caller* of the parser could
// not make one at all.
//
// **What it bought is `render(const ParseError e)`.** A signature with one parameter, where every
// other diagnostic function in this directory takes two. The caret comes out of the fault.
//
// ## And the cost the sweep predicted does not arise here, for a reason worth stating
//
// `../../../QUESTIONS.md` says a fault carrying a `Bytes` keeps the whole input alive for as long as
// the fault exists, and that this is a real objection for `Truncated` and not for `ParseError`. The
// difference it named was *how many of the fault get made*, and this parser makes at most one: `try`
// propagates the first failure out of `document` and there is no recovery, so there is never a second
// `ParseError` in existence.
//
// That is a property of the **parser**, not of the type, and nothing states it. A JSON parser that
// collected errors rather than stopping — which is what an editor wants and what
// `@/packages/wacc` does — would hold one `Bytes` per error, all of them views on the same array, so
// the retention is one document however many faults there are. So the objection is smaller than the
// sweep made it sound, and the case where it bites is the one the sweep did not name: a fault that
// **outlives** its input, which here would be a `ParseError` stored past the buffer it was parsed
// from, and nothing can stop that or notice it.
//
// ## What could not be written
//
// **`e.at` is a zero-length slice and nothing says so.** Every construction is
// `src.slice(at, at)` and every reader uses `from` and `of` and ignores `len`. A `Position` type —
// a slice constrained to be empty — is the honest shape, and the only difference from `Bytes` is a
// law nothing can state. Same absence as `@/packages/ssh/src/knownhosts.wac`'s *`combine` is
// associative and nothing says so*, third instance.
//
// **`render` walks from the start of the document to count lines.** O(n) per fault, which is right
// for one fault and wrong for an editor. The information that would fix it — a line table — belongs
// to whoever read the file, which is neither the parser nor the fault, and this is the third place
// in the directory where the answer is *the producer should have recorded it* and the producer is
// somebody else.
