// The public surface.
//
// **The types were missing until `@/packages/ethrpc` needed to name one.** Every signature below
// answers a `Result<JsonValue, ParseError>` and neither name was exported, so a caller could call
// `parse` and could not write down what it got. A barrel assembled from *what this package does*
// rather than from *what a caller says* omits exactly the types its own signatures mention.

import { Result, Bytes } from "core";
import { JsonValue } from "./value.wac";
import { Parser, ParseError } from "./parse.wac";
import { writeValue } from "./stringify.wac";
import { Buf } from "@/packages/bytes";

/** The tree, or where and why it is not JSON. */
export Result<JsonValue, ParseError> parse(Bytes src) {
  return Parser.json(src).document();
}

/**
 * The same for JSON5 — JSON with comments, unquoted keys, single quotes, trailing commas and
 * ECMAScript's numbers.
 *
 * Every JSON document is one, so this accepts strictly more. That is why it is a second entry
 * point rather than a replacement: a parser that quietly accepted a comment would let one into a
 * file the other end reads with `parse`.
 */
export Result<JsonValue, ParseError> parseJson5(Bytes src) {
  return Parser.json5(src).document();
}

/**
 * A document reduced to one spelling of itself: parse, then write back out as JSON.
 *
 * The original answers a `Canonical` struct of `(bool ok, i32 err, i32 errPos, u8[] text)` — a
 * `Result` assembled by hand, with three fields that mean nothing when `ok` and one that means
 * nothing when it is not. There is nothing left to declare.
 */
export Result<u8[], ParseError> canonicalize(Bytes src) {
  return Result.Ok(writeOut(try parse(src)));
}

export Result<u8[], ParseError> canonicalizeJson5(Bytes src) {
  return Result.Ok(writeOut(try parseJson5(src)));
}

u8[] writeOut(JsonValue v) {
  Buf out = Buf.create();
  writeValue(out, v);
  return out.take();
}

// The arms too, because the bare form is the idiom and a bare name must be in scope at the call
// site — `@/packages/rlp`'s barrel says the same thing about `Err(is LeadingZero):`. Second reason
// to widen a barrel found by one caller on one day.
export { JsonValue, JsonObject, JsonMember, numberOf,
         Null, Bool, Number, Str, Array, Object } from "./value.wac";
export { ParseError, Reason, render } from "./parse.wac";
// **Added 2026-09-05 because `@/packages/server/src/routes.wac` could not import it.** The barrel's
// header argues that a caller should not have to know which file a name lives in, and then omitted
// the only way to turn a tree back into bytes — so this package could parse and could not print,
// from outside. Found by the first caller, which is the third name this directory has had to add to
// a barrel for that reason after `@/packages/http`'s ten fault members.
export { writeValue } from "./stringify.wac";
