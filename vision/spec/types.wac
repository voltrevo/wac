// Structs: fields, construction, methods, inheritance, and what `const` reaches.
//
// Part of `vision/spec`, which is not vetted — see README.md.

/** A struct is a heap reference. A method takes `this` to have a receiver. */
export struct Point {
  i32 x = 0;
  i32 y = 0;

  i32 sum(const this) { return this.x + this.y; }
  void shift(this, i32 by) { this.x += by; }
}

/** Positional construction writes every field; braces write the ones without a default. */
export void construction() {
  Point a = Point(3, 4);
  a.x;                         // 3
  a.y;                         // 4

  Point b = Point { y: 4, x: 3 };   // order does not matter
  Point c = Point { };              // every field has a default

  b.x;                         // 3
  c.x;                         // 0

  // ERROR: positional construction must provide every field
  // Point d = Point(3);
}

/** A nullable field may be left out of a named construction, since its absence is its default. */
export struct Node {
  i32 val = 0;
  Node? next;
}

export void nullableField() {
  Node n = Node { val: 42 };
  n.val;                       // 42
  n.next is null;              // true
}

/** A non-null recursive reference has no default, because the construction would not finish. */
export struct Bad {
  // ERROR: `Bad` has no default — a recursive non-null reference
  // Bad next;
}

/** A field whose type is an array defaults to an empty one, whatever the element type. */
export struct Holder {
  Node[] data;
}

export void emptyByDefault() {
  Holder h;
  h.data.len();                // 0
}

/** Two names for one struct are one object. */
export void aliasing() {
  Point a = Point(1, 2);
  Point b = a;
  b.x = 99;
  a.x;                         // 99
}

/** A method reaches its fields through `this`, and a bare field name is not in scope. */
export struct Counter {
  const i32 id = 0;
  i32 count = 0;

  Counter create(i32 id) { return Counter { id: id }; }

  i32 inc(this) {
    this.count += 1;

    // ERROR: `id` is a const field
    // this.id = 5;

    // ERROR: a bare field name is not in scope inside a method
    // count += 1;

    return this.count;
  }

  i32 getCount(const this) { return this.count; }
}

export void counting() {
  Counter c = Counter.create(1);
  c.getCount();                // 0
  c.inc();
  c.getCount();                // 1
}

/** `const` on a reference is deep, and it travels with the reference. */
export void constness(const Point p, const i32[] xs, const Point[] ps) {
  p.sum();

  // ERROR: cannot assign through a const reference
  // p.x = 1;

  // ERROR: cannot call a method taking `this` on a const reference
  // p.shift(1);

  // ERROR: it reaches the elements
  // xs[0] = 9;

  // ERROR: and it travels, so an element of a const array is const too
  // ps[0].x = 1;
}

/**
 * A `const this` method hands back the real thing rather than a copy, so what it returns carries the
 * constness with it. Reading it is allowed; the write is where it is caught.
 */
export struct Server {
  Point[] routes;

  Point[] table(const this) { return this.routes; }
}

export i32 accessor(const Server s) {
  return s.table().len();      // reading through it is fine

  // ERROR: a non-const reference cannot be taken from a const one —
  // `set` writes, and `s.table()` is const
  // s.table()[0] = Point(1, 1);
}

/** A whole struct may be const, so no reference to one was ever writable. */
export const struct Frozen {
  i32 w = 0;
  i32 h = 0;
}

export void frozen(Frozen f) {
  f.w;

  // ERROR: `Frozen` is a const struct
  // f.w = 1;
}

/** A subtype adds fields, and positional construction takes the parent's first, in order. */
export struct Shape {
  i32 x = 0;
  i32 y = 0;

  i32 getX(const this) { return this.x; }
  virtual string name(const this) { return "shape"; }
}

export struct Rect : Shape {
  i32 w = 0;
  i32 h = 0;

  override string name(const this) { return "rect"; }
}

export struct Square : Shape {
  override string name(const this) { return "square"; }
}

export void inheritance() {
  Rect r = Rect(1, 2, 10, 20);      // x, y, then w, h
  Shape s = r;                      // a subtype widens

  r.getX();                         // 1 — inherited
  s.name();                         // "rect" — dispatch is on the runtime type

  // ERROR: an inherited static cannot be called on a subtype
  // Rect.create();
}

/** `override` is the child's half and `virtual` the parent's, and both are required. */
export struct Blob : Shape {
  // ERROR: a colliding method without `override`
  // string name(const this) { return "blob"; }

  // ERROR: nothing to override
  // override string missing(const this) { return ""; }
}

/** References compare by identity, and identity alone. */
export void identity() {
  Point a = Point(1, 2);
  Point b = Point(1, 2);
  Point c = a;

  a is b;                      // false — two objects
  a is c;                      // true

  // ERROR: `==` is not allowed on struct types
  // a == b;
}

/**
 * Identity comparison costs nothing, and identity *hashing* is not free, so the language does not
 * give it to every reference. A moving collector invalidates anything derived from an address and
 * wasm GC exposes no header to stash a lazy hash in, which leaves a field assigned at allocation as
 * the only portable implementation — a word on every object, half again the size of a `Point`.
 *
 * A type that wants to be a hash key carries the field itself.
 */
export struct Keyed {
  i32 x;
  i32 id;                      // assigned by whoever allocates it

  i32 hash(const this) { return this.id; }
}

export void hashing(Point p, Keyed k) {
  k.hash();

  // ERROR: `Point` has no `hash` — a reference is not hashable unless its type says how
  // p.hash();
}
