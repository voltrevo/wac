// Branching, looping, and binding a value while testing it.
//
// Part of `vision/spec`, which is not vetted — see README.md.

import { Rgb } from "./values.wac";

/** Blocks take braces. There is no statement form without them. */
export i32 branching(i32 n) {
  if (n < 0) {
    return -1;
  } else if (n == 0) {
    return 0;
  }
  return 1;
}

/** Four loop heads: three that exist and one over a thing rather than its indices. */
export i32 loops(i32[] xs) {
  i32 n = 0;

  for (i32 i = 0; i < xs.len(); i++) { n += xs[i]; }

  i32 j = 0;
  while (j < xs.len()) { n += xs[j]; j++; }

  do { n += 1; } while (false);

  for (i32 x in xs) { n += x; }

  return n;
}

/**
 * `switch` dispatches on a 32-bit integer — `i32` or `u32`, since an equality match has no
 * signedness — and there is no fallthrough: each case is its own block.
 *
 * At most one `default`, and two constant case values that are equal are an error at the second.
 * A repeated case is unreachable for the reason a second `default` is, and `match` refuses a
 * variant named twice for the same one. The three are one rule.
 */
export i32 dayType(i32 day) {
  switch (day) {
    case 0: { return 0; }
    case 6: { return 0; }
    default: { return 1; }
  }
}

export i32 noFallthrough() {
  i32 x = 0;
  switch (1) {
    case 0: { x = 10; }
    case 1: { x = 20; }
    case 2: { x = 30; }
  }
  return x;                    // 20 — only the matching case ran

  // ERROR: duplicate case value, reported at the second
  // switch (1) { case 0: { } case 0: { } }
}

/** A loop with no exit needs no trailing return, because the checker knows it cannot fall out. */
export i32 firstMultiple(i32 of, i32 from) {
  i32 n = from;
  while (true) {
    if (n % of == 0) { return n; }
    n += 1;
  }
}

/** A loop that can end does need one. */
export i32 bounded(i32 n) {
  for (i32 i = 0; i < n; i++) {
    if (i == 3) { return i; }
  }
  return n;                    // without this, the function does not return on every path
}

/** `break` leaves the loop, `continue` takes the next turn. */
export i32 leaving(i32[] xs) {
  i32 n = 0;
  for (i32 x in xs) {
    if (x < 0) { continue; }
    if (x > 99) { break; }
    n += x;
  }
  return n;
}

/** `continue` in a `while` takes the test, not the top of the body — the update is yours to run. */
export i32 whileContinue(i32[] xs) {
  i32 n = 0;
  i32 i = 0;
  while (i < xs.len()) {
    i++;                       // before the `continue`, or this loop does not end
    if (xs[i - 1] % 2 == 0) { continue; }
    n += xs[i - 1];
  }
  return n;
}

/** Both are refused outside a loop, and a `switch` is not one. */
export void outside(i32 n) {
  // ERROR: `break` outside a loop
  // break;

  // ERROR: `continue` outside a loop
  // continue;

  switch (n) {
    // ERROR: `continue` inside a switch that is not inside a loop
    // case 0: { continue; }
    default: { }
  }
}

/**
 * A ternary's type is the narrowest available containing both branches, except `anyref`: the greater
 * of the two nullability depths, over the nearest common ancestor of the non-nullable forms.
 *
 * `anyref` is excluded because it contains everything, so a rule allowed to reach it could never
 * refuse a pair. Branches that meet nowhere else are an error.
 */
export void ternary(bool c, Rgb s, Rgb? o) {
  i32  a = c ? 1 : 2;
  Rgb? b = c ? s : o;          // the greater depth of the two
  Rgb? d = c ? o : null;       // null is depth one over no type

  a; b; d;

  // ERROR: the two branches of a ternary have unrelated types
  // auto e = c ? s : "red";
}

/**
 * `matches` tests a pattern against a subject and binds a name for it. The name is scoped to the
 * statement, and readable only where the match is what let control reach it: the right operand of
 * `&&`, the then-arm of `?:`, the block of an `if` or `while`, and the body and update of a `for`.
 */
export i32 binding(Rgb? maybe) {
  if (Rgb p matches maybe) { return p.r; }

  // ERROR: undefined name
  // return p.r;

  return 0;
}

export i32 guarded(Rgb? maybe) {
  if (Rgb p matches maybe && p.r > 0) { return p.r; }
  return 0;
}

export i32 conditional(Rgb? maybe) {
  return Rgb p matches maybe ? p.g : 0;
}

/** A pattern whose answer is known is still a question, so it is not refused. */
export i32 alwaysTrue(Rgb certain) {
  if (Rgb p matches certain) { return p.b; }
  return 0;
}

/** `defer` runs when the block exits, however it exits. */
export i32 cleanup(i32 n) {
  defer release();

  if (n < 0) { return -1; }    // release() runs here
  return n;                    // and here
}

export void release() { }

/** Draining a queue is the loop the construct was wanted for: one test, one binding. */
export i32 drainLike(Queue<i32> q) {
  i32 n = 0;
  while (i32 v matches q.pop()) { n += v; }
  return n;
}
