// Enums, matching, and the error type built on both.
//
// Part of `vision/spec`, which is not vetted — see README.md.

/** A variant may carry a payload, or nothing, and two variants may reuse a payload name. */
export enum Shape {
  Circle(f64 r), Rect(f64 w, f64 h), Point

  // ERROR: duplicate payload name within one variant
  // Bad(i32 x, i32 x)
}

export enum Fault { NotFound, IsDir, Denied }

/** A variant is built through the enum, and that is the spelling a test uses too. */
export void building() {
  Shape a = Shape.Circle(1.0);
  Shape b = Shape.Point;

  a is Shape.Circle;           // true — a type test needs no payload
  a is Circle;                 // the same test, unqualified
  b is not Shape.Circle;       // true

  // ERROR: a payload in a type test — nothing is being constructed
  // a is Shape.Circle(1.0);
}

/** An arm is a shape and a consequence. A payload name binds; `_` ignores one. */
export f64 area(Shape s) {
  return match (s) {
    Circle(r):    3.14159 * r * r,
    Rect(w, h):   w * h,
    Point:        0.0,
  };
}

export bool isRound(Shape s) {
  return match (s) {
    Circle(_): true,
    default:   false,
  };
}

/** A payload list shorter or longer than the variant is refused rather than positioned. */
export void arity(Shape s) {
  // ERROR: `Rect` has two fields
  // match (s) { Rect(w): 0.0, default: 0.0 };

  // ERROR: `Point` has none
  // match (s) { Point(x): 0.0, default: 0.0 };
}

/** The arms cover the enum, or carry a `default` — and a `default` that covers nothing is refused. */
export f64 covering(Shape s) {
  // ERROR: match does not cover 'Rect'
  // return match (s) { Circle(r): r, Point: 0.0 };

  return match (s) {
    Circle(r):  r,
    Rect(w, _): w,
    Point:      0.0,

    // ERROR: this `default` is unreachable — every variant is already named
    // default:    0.0,
  };
}

/** Two arms for one variant is a compile error, not a first-match. */
export f64 duplicate(Shape s) {
  // ERROR: duplicate arm for 'Circle'
  // return match (s) { Circle(r): r, Circle(r2): r2, default: 0.0 };
  return 0.0;
}

/**
 * An arm narrows its subject where the subject is a name, so the arm can read the variant's fields
 * off it. The narrowed binding is `const`, and a payload name may not reuse the subject's name.
 */
export f64 narrowing(Shape s) {
  return match (s) {
    Circle:  s.r,              // narrowed: the arm's `s` is a Circle
    default: 0.0,

    // ERROR: cannot assign to `s` — a matched subject is const within its arm
    // Circle: { s = Shape.Point; 0.0 },

    // ERROR: duplicate binding — the payload name is the subject's
    // Circle(s): s,
  };
}

/** Where the subject is not a name there is nothing to narrow. */
export f64 noName(Shape[] shapes) {
  return match (shapes[0]) {
    Circle(r): r,              // the payload still binds
    default:   0.0,
  };
}

/** An arm that leaves gives no value, and is not asked to agree with the others. */
export i32 leaving(Shape[] shapes) {
  i32 n = 0;
  for (Shape s in shapes) {
    f64 a = match (s) {
      Circle(r): 3.14159 * r * r,
      Rect(w, h): w * h,
      Point:     continue,
    };
    n += a as~ i32;
  }
  return n;
}

/** A nullable subject names `null` alongside the variants, or carries a `default`. */
export f64 maybeArea(Shape? s) {
  return match (s) {
    Circle(r):  3.14159 * r * r,
    Rect(w, h): w * h,
    Point:      0.0,
    null:       0.0,
  };
}

/** An enum may hold itself, so a recursive shape folds. */
export enum Tree {
  Leaf(i32 v), Node(Tree left, Tree right)
}

export i32 sum(Tree t) {
  return match (t) {
    Leaf(v):        v,
    Node(l, r):     sum(l) + sum(r),
  };
}

/**
 * `Result<T, E = union>` is an ordinary generic with a default argument rather than a blessed form.
 * `is` inside a payload tests a variant there; a bare name binds it.
 */
export enum Result<T, E = union> {
  Ok(T v), Err(E e)
}

export string describe(Result<i32, Fault> r) {
  return match (r) {
    Ok(v):            "got it",
    Err(is NotFound): "no such thing",
    Err(e):           "some other fault",
  };
}

/** `try` hands the error upward, and the error has to be in the set rather than equal to it. */
export Result<i32, union<NotFound>> load(Result<i32, union<NotFound>> r) {
  i32 v = try r;
  return Result.Ok(v + 1);
}

/**
 * `union<…>` is an anonymous sum with no constructors: a member is returned as itself, and there is
 * nothing to build. An arm names a type rather than a variant, and inside it the value is that type.
 */
export union<f64, string, bool> parseCell(string text) {
  if (text == "true")  { return true; }
  if (text == "false") { return false; }

  if (f64 n matches parseNum(text)) { return n; }
  return text;
}

export f64? parseNum(string s) { trap; }
export string fmt(f64 x) { trap; }

export string render(union<f64, string, bool> cell) {
  return match (cell) {
    f64:    fmt(cell),
    string: cell,
    bool:   cell ? "true" : "false",
  };
}

/** Order and repetition do not make a different type, so a union is its set of members. */
export void unionIdentity(union<f64, string> a, union<string, f64> b) {
  a = b;                       // the same type

  // ERROR: a member is not in the union
  // union<f64> c = a;

  // ERROR: `union<f64, f64>` is `union<f64>`, which is `f64` — write the type
  // union<f64, f64> d;
}
