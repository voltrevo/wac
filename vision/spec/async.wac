// Asynchrony: tickets, the machine underneath, and the two ways to drive one.
//
// Part of `vision/spec`, which is not vetted — see README.md. Vision spells the ticket type
// `Ticket<T>` where today's spec says `Pending<T>`; the rename is not settled.

import { Sys, Grant } from "./program.wac";
import { Ticket, TicketBase, Continuation, Coroutine, Generator, AsyncGenerator } from "./coretypes.wac";
import { Vec } from "core/vec.wac";
import { Result } from "core/result.wac";

/**
 * An `async` function answers a ticket for what its body returns. The declared type is what the
 * body returns, and the caller derives the ticket — `async Ticket<i32>` means something else.
 *
 * `async` is written after any `export` and before the return type.
 */
export async i32 doubled(Ticket<i32> t) {
  return (await t) * 2;
}

export async void awaiting(Ticket<i32> t) {
  Ticket<i32> p = doubled(t);   // the call answers the ticket
  i32 v = await p;              // and awaiting it answers the value
  v;
}

/** An unawaited call runs to its first suspension and hands its continuation to the target. */
export void unawaited(Sys sys) {
  Vec<Continuation> pending;
  schedule pending.push;

  sleeper(sys);                 // runs until it suspends, then lands in `pending`
  pending.len();                // 1
}

export async void sleeper(Sys sys) {
  await sys.sleepMillis(1);
}

/**
 * A method may be `async`, written where it sits on a free function — after any `override`, before
 * the return type. The receiver crosses a suspension the way any other parameter does.
 */
export struct Reader {
  Sys sys;

  async i32 readByte(this) {
    await this.sys.sleepMillis(1);
    return 7;
  }
}

/** A ticket answered by an async function is not flattened: two awaits mean two different things. */
export async Ticket<i32> later(Ticket<i32> t) {
  return doubled(t);
}

export async i32 twoAwaits(Ticket<i32> t) {
  Ticket<i32> inner = await later(t);   // the call is under way
  return await inner;                   // and this is its answer

  // ERROR: expected i32, got Ticket<i32> — await it for the value, or declare the
  // function `async Ticket<i32>` to hand the ticket on. There is no cast between the two.
  // async i32 bad(Ticket<i32> t) { return doubled(t); }
}

/** `await` wants a ticket, and answers what that ticket answers. */
export async void awaitType(Ticket<i32> t, i32 n) {
  await t;                      // i32

  // ERROR: `await` requires a Ticket, got i32
  // await n;
}

/** `await` binds tighter than any binary operator and looser than postfix. */
export async i32 binding(Ticket<i32> t, Reader r) {
  await r.readByte();           // the call is awaited, not the receiver
  return await t + 1;           // (await t) + 1
}

/** `await` belongs to the function it is written in, so a plain lambda may not contain one. */
export async void lambdas(Ticket<i32> t) {
  fn<Ticket<i32>()> a = async () => await t;
  await a();

  // ERROR: `await` outside an async function — the lambda is a different function
  // fn<i32()> b = () => await t;
}

/**
 * A lambda writes no return type, so its slot is both the permission and the type: `async` is
 * allowed where the slot is `fn<Ticket<R>(…)>`, and `R` is what the body is checked against. A
 * lambda captures, and a captured name survives the suspensions — which is the reason to want one.
 */
export void slots(Ticket<i32> t) {
  i32 base = 10;
  fn<Ticket<i32>()> f = async () => base + await t;   // `base` is still there afterwards
  f;

  // ERROR: `async` on a slot that wants no ticket
  // fn<void()> g = async () => { await t; };
}

/**
 * `void` may be written as a type argument, and erases the parameter it stood in for:
 * `Ticket<void>`'s continuation takes nothing. A container of it remains an error.
 */
export void voidArgument(Sys sys) {
  Ticket<void> t = sys.drain();
  t;

  // ERROR: Vec<void> — nothing can hold a value of a type that has none
  // Vec<void> v;
}

/**
 * `coroutine` answers the machine and runs nothing. `Coroutine<W, Y, R>` is what it waits on, what
 * it yields, and what it returns — `W` is `never` where it cannot wait.
 */
export void machine(Ticket<i32> t) {
  Coroutine<TicketBase, never, i32> c = coroutine doubled(t);

  t.resolve(21);
  c.step();                     // Waiting
  c.step();                     // Done(42)
  c.step();                     // Done(42) — stepping a finished machine changes nothing
}

/** Three constructs, three called forms, and one operator to descend to the machine. */
export void taxonomy(Ticket<i32> t) {
  Generator<i32, void>      a = values();
  Ticket<i32>               b = doubled(t);
  AsyncGenerator<i32, void> c = counter(t);

  Coroutine<never, i32, void>       d = coroutine values();
  Coroutine<TicketBase, never, i32> e = coroutine doubled(t);
  Coroutine<TicketBase, i32, void>  f = coroutine counter(t);

  a; b; c; d; e; f;
}

export gen<i32> void values() {
  yield 1;
  yield 2;
}

export async gen<i32> void counter(Ticket<i32> t) {
  yield 1;
  yield await t;
}

/** Async is the same thing wrapped in a ticket, so `Waiting` only appears on the machine. */
export void stepping(Ticket<i32> t) {
  Generator<i32, void>      a = values();
  AsyncGenerator<i32, void> c = counter(t);

  a.step();                     // Yielded(1) | Done(void)
  c.step();                     // Ticket<Yielded(i32) | Done(void)>

  Coroutine<TicketBase, i32, void> f = coroutine counter(t);
  f.step();                     // Yielded(i32) | Done(void) | Waiting
}

/**
 * `await` with no operand suspends on a ticket that is already settled, so the machine pauses once
 * and its next step finishes. It is the smallest thing that can be paused, and it has no rival:
 * `await;` as an ordinary statement would be `await e;` with the `e` left out, and that shape names
 * no type for the slot to suspend into, so there is nothing for this spelling to collide with.
 */
export async void tick() {
  await;
}

export void settled() {
  Coroutine<TicketBase, never, void> c = coroutine tick();

  match (c.step()) {
    Waiting(t): { t.settled(); }   // true — there was never anything to wait for
    Done(_):    { }
  }
  c.step();                        // Done
}

/**
 * A pause deeper down is still one pause at the top: the caller's machine does not gain a state for
 * each frame beneath it, so its type is what its own body says.
 */
export void nested() {
  Coroutine<TicketBase, never, void> c = coroutine outer();

  c.step();                        // Waiting
  c.step();                        // Done
}

export async void outer() { await middle(); }
export async void middle() { await tick(); }

/**
 * `Ticket.all` answers a tuple, so two reads cost one wait and the results keep their own types.
 * It is variadic, and the tuple is as long as the call.
 */
export async i32 both(Sys sys) {
  auto got = await Ticket.all(sys.readFile("a.txt"), sys.readFile("b.txt"));
  return got.0.len() + got.1.len();
}

/**
 * `await;` is also how a loop gives other work a turn, since a suspension is where the scheduler
 * gets to run something else. Two of these interleave rather than running one after the other.
 *
 *     a
 *     b
 *     a
 *     b
 */
export async void interleaving(Sys sys) {
  ticking(sys, "a");
  ticking(sys, "b");
  await sys.drain();
}

export async void ticking(Sys sys, string name) {
  for (i32 i = 0; i < 2; i++) {
    sys.log(name);
    await;
  }
}

/**
 * `Ticket.any` answers the first to settle, and the losers are not cancelled — nothing here
 * cancels. They are still the program's work and still run, which is what `drain` then finishes.
 */
export struct Slot { i32 n = 0; }

export async void racing(Sys sys, Ticket<i32> a, Ticket<i32> b) {
  Slot s = Slot();

  Ticket<i32> win = Ticket.any(add(s, a), add(s, b));

  a.resolve(1);
  await win;
  s.n;                             // 1

  b.resolve(10);
  await sys.drain();
  s.n;                             // 11 — the loser ran too
}

export async i32 add(Slot s, Ticket<i32> t) {
  s.n += await t;
  return s.n;
}

/** `await` is illegal in a generator, `yield` in an async function, and both belong to the pair. */
export gen<i32> void keywords(Ticket<i32> t) {
  yield 1;

  // ERROR: `await` in a generator
  // await t;
}

/** Iterating an async generator needs the await written, because a boundary is written. */
export async i32 iterate(Ticket<i32> t) {
  i32 n = 0;
  for await (i32 x in counter(t)) { n += x; }

  // ERROR: iterating an async generator needs `for await`
  // for (i32 x in counter(t)) { }

  return n;
}

/**
 * `wait` resolves, in turn, each thing the ticket awaited, and each resolution needs the `sys` that
 * produced that ticket to permit synchronous resolution. It answers the value or refuses.
 *
 * Replacing `await x` with `x.wait()!` never changes the value. It changes what else got to run.
 */
export Result<i32> driving(Ticket<i32> t) {
  return t.wait();
}

/** However it is driven, a body runs once: a `wait` takes back a registered continuation first. */
export void once(Sys sys) {
  Vec<Continuation> pending;
  schedule pending.push;

  Ticket<void> t = alsoSleeps(sys);
  t.wait();                     // the continuation is taken back, not run twice
  sys.drain().wait();           // nothing left to dispatch
}

export async void alsoSleeps(Sys sys) {
  await sys.sleepMillis(1);
}

export Sys fakeSys() { trap; }

export void refusals(Sys real) {
  Ticket<i32> dead;
  dead.wait();                  // Err — nothing behind it and nobody to ask

  Sys fake = fakeSys();
  fake.run(async (Sys sys) => {
    real.sleepMillis(10);       // unawaited — its continuation lands in fake's queue
    return sys.drain().wait();  // Err — the ticket is real's, and fake cannot advance it
  }, Grant[]());
}

/** `drain` runs the work nobody awaited, and the two ways to finish it are the same program. */
export async void drainAsync(Sys sys) {
  sleeper(sys);
  await sys.drain();
}

export Result<void> drainSync(Sys sys) {
  sleeper(sys);
  return sys.drain().wait();
}
