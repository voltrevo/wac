// A document for tests: a host answering `wac.page` (`line.wac`) into a tree of records.
//
// Every change the program sends lands in `nodes`, and an event is fired the way a browser fires one — at a
// target, heard by every listener from the target up, nearest first — as the answer to the program's request for
// its next event. `ops` counts the element operations, which is what says how much a render sent; `said` is
// every request the program made that a reader would check, one line each.
//
// **The host's other answers are the test's to give**: the clock stands still until `advance` moves it, a frame
// comes when `paint` says, an element's value when `answerValue` does, a file when `hand` does, a new location
// when `go` does. So every order in which things can arrive is one a test can write down.
//
// **Part of the package, for an application's tests**: `doc.page()` is a page over this document, and events
// fired at what the view drew run the program on and render, as a browser's would. `template/test` does.

import { Map, Vec, hashString, stringEq } from "core";
import { Answer, FAULT_UNSUPPORTED, HOST_CANNOT_WAIT, Host, OP_CAPABILITY, OP_MONOTONIC_NANOS, OP_SLEEP_MILLIS, Sys,
         answered } from "std";
import { Elements } from "./element.wac";
import { Page, Size } from "./page.wac";
import { ORIGIN_CAPABILITY, ORIGIN_COUNT, ORIGIN_VERSION, ORIGIN_FETCH, ORIGIN_OPEN, ORIGIN_SEND, ORIGIN_NEXT, ORIGIN_CLOSE,
         MESSAGE_TEXT, MESSAGE_CLOSED, Reply, requestParts, RequestParts } from "./origin.wac";
import { Change, Happened, PAGE_AUDIO, PAGE_BATCH, PAGE_CAPABILITY, batchOf, PAGE_COUNT, PAGE_EVENT, PAGE_ONE_AT_A_TIME, PAGE_FILE, PAGE_FRAME, PAGE_GAIN, PAGE_GO, PAGE_LOCATION, PAGE_VISIBLE, PAGE_ZONE, PAGE_BACK, PAGE_ZONE_NAME, PAGE_STORED, PAGE_STORE, PAGE_PATH, PAGE_NAVIGATE, PAGE_LINKS, PAGE_DESCRIBE, PAGE_SURFACE, PAGE_FULLSCREEN, PAGE_PLAY, PAGE_SOUND, PAGE_STOP, PAGE_TYPE_TEXT,
         PAGE_VALUE, PAGE_VERSION, PageLine, eventAnswer, highOf, lowOf, quadAt, getF64 } from "./line.wac";

/** Where this document's `wac.page` numbers start, as a host would choose them. */
static i32 BASE = 4096;
/** And `wac.origin`'s, when the test serves one (`TestDoc.serving`). */
static i32 ORIGIN_BASE = 4096 + 120;

/** A WebSocket the program opened on the served origin: what it sent, and what is waiting to be read. */
export struct TestSocket {
  string path;
  /** Every message the program sent on it, in order. */
  Vec<string> sent;
  Vec<string> queue;
  Vec<i32> asks;
  bool closed;
  i32 code;
  string reason;
}

/** One node of the document: an element or, with an empty `tag`, a text node. */
export struct TestNode {
  i32 id;
  string tag;
  string text;
  Vec<string> names;
  Vec<string> values;
  Vec<i32> kids;
  i32 parent;
  Vec<string> listens;
  Vec<string> prevents;
  /** The number of the last event typed into it; a `prop("value")` the program sent before seeing it is dropped. */
  i32 typed;
  /** Its caret, for an `input` or a `textarea`: the selection's two ends, equal when nothing is selected; -1 elsewhere. */
  i32 selStart;
  i32 selEnd;
}

/** A file handed over before anything asked for one. */
struct Kept {
  bool ok;
  string name;
  u8[] bytes;
}

export struct TestDoc {
  Vec<TestNode?> nodes;
  i32 ops;
  i32 seq;
  /** The host the program's requests go to, and the `Sys` over it, once made. */
  Host? host;
  Sys? sys;
  /** How deep in the program's requests this is: an answer given inside one is that request's, and runs nothing on. */
  i32 asking;
  /** The handles' owner, once the elements exist. */
  Elements? es;
  /** The page they belong to, when there is one: an answer then runs it on, and its views render. */
  Page? owner;
  /** The last scroll asked for, as `"<handle> <name>"` — the name empty when it was the element itself. */
  string scrolled;
  /**
   * Fields `typeText` typed into, whose `input` events are still to fire: a browser fires them after the operation,
   * not inside the handler that sent it, so they are fired once the event being handled is done — or, for text typed
   * outside any event, with the next one.
   */
  Vec<i32> typedInto;
  /** Every request a reader would check, one line each: `make 1 button`, `sleep 250`, `title Notes`… */
  string said;
  /** The clock, in milliseconds: still until `advance` moves it. */
  f64 now;
  /** The requests waiting for an answer, each by its number: the next event, sleeps, frames, values, files, locations. */
  Vec<i32> eventAsks;
  Vec<i32> sleepAsks;
  Vec<f64> sleepDue;
  Vec<i32> frameAsks;
  /** Every value read, in the order asked — `answerValue(k, …)` answers the `k`th — and whether it has been. */
  Vec<i32> valueAsks;
  Vec<i32> fileAsks;
  Vec<Kept> kept;
  Vec<i32> locationAsks;
  /** The location, without its `#`. */
  string location;
  /** Whether the program is told to hold its changes and send them together, as a browser's host tells it. */
  bool batching;
  /** The locations the program went on from, adding to the history: what `back` returns to, latest last. */
  Vec<string> visited;
  /** Whether the page is seen — `"1"` or `"0"`, as `PAGE_VISIBLE` says it — and the requests waiting to hear it change. */
  string seen;
  Vec<i32> seenAsks;
  /** How many minutes the reader's local time is ahead of UTC, at any moment: 0, UTC, until a test says otherwise. */
  i32 zone;
  /**
   * The origin this document was served from, when a test serves one (`serving`): each request the program makes of
   * it answered by `server`, at once — method, path, the fields one a line, the body — and each socket it opens kept in
   * `sockets`, its handle its index. `onSend` hears each message the program sends on one, to answer it if it likes.
   */
  fn<Reply(string, string, string, u8[])>? server;
  Vec<TestSocket> sockets;
  fn<void(i32, string)>? onSend;
  /**
   * The origin's answers given while the program was asking, to give once it has finished: the server answers as a
   * browser's would, in a turn of its own, so each answer runs the program on and renders — which an answer given
   * inside the request asking would not.
   */
  Vec<i32> laterIds;
  Vec<Answer> laterAnswers;
  /** The reader's zone by name, as `PAGE_ZONE_NAME` answers it: UTC until a test says otherwise. */
  string zoneName;
  /** The page's store (`PAGE_STORE`), which a test may fill before the program reads it. */
  Map<string, string> storage;
  /** The page's audio, as `PAGE_AUDIO` answers it: suspended until the program resumes it, as a browser's is. */
  string audio;
  /**
   * Told after each batch the program sends has landed (`PAGE_BATCH`): what a reader of the document as the program
   * left it at the end of a turn waits for — `Prerender` keeps the first.
   */
  fn<void()>? onBatch;
  /** The window the page opened in, as the host says when the program finds `wac.page`: 0 by 0, unsaid, unless a test sets it. */
  Size size;
  /** The page's path on its site (`PAGE_PATH`), `/` unless a test sets it, and the requests waiting to hear it change. */
  string path;
  Vec<i32> pathAsks;
  /** The page's title and description, as the program last said them: what a first frame drawn at build time carries. */
  string title;
  string description;
  /** Whether the program asked for links to the site's pages to be followed in the page (`PAGE_LINKS`). */
  bool links;

  TestDoc create() {
    Vec<TestNode?> nodes = Vec.create();
    TestDoc d = TestDoc(nodes, 0, 0, null, null, 0, null, null, "", Vec.create(), "", 0.0, Vec.create(), Vec.create(),
                        Vec.create(), Vec.create(), Vec.create(), Vec.create(), Vec.create(), Vec.create(), "", false, Vec.create(), "1", Vec.create(), 0, null, Vec.create(), null, Vec.create(), Vec.create(), "UTC", Map.create(hashString, stringEq), "suspended", null, Size(0, 0),
                        "/", Vec.create(), "", "", false);
    d.put(0, "div", 0 - 1);
    Host h = Host.of(
      (i32 op, i32 id, i64 a, i64 b, string text, u8[] bytes) => {
        d.asking++;
        d.request(op, id, a, b, text, bytes);
        d.asking--;
        if (d.asking == 0) { d.giveLater(); }
      },
      // Nothing is ever waiting to be collected — every answer is given as it is — so a wait that would block cannot.
      (i32[] ids, i32 millis) => millis == 0 ? 0 - 1 : HOST_CANNOT_WAIT(),
      (i32 code) => { },
      () => false);
    d.host = h;
    d.sys = Sys.__wacOn(h);
    return d;
  }

  /**
   * A document whose program holds its changes and sends them together (`PAGE_BATCH`), as a browser's host has it
   * do: nothing lands here until the program's turn ends, or until it asks something.
   */
  TestDoc batched() {
    TestDoc d = TestDoc.create();
    d.batching = true;
    return d;
  }

  /** The program's end of this document: the host, and where `wac.page` starts on it. */
  PageLine line(this) { return PageLine.of(this.host!, BASE, this.batching ? 0 : PAGE_ONE_AT_A_TIME); }

  /** The window's size as the host's answer to finding `wac.page` carries it: `"390x844"`, or nothing when unsaid. */
  u8[] sizeBytes(this) {
    return this.size.width == 0 && this.size.height == 0 ? u8[]() : "\{this.size.width}x\{this.size.height}".toBytes();
  }

  /** A page over this document, whose answers run it on and render its views. */
  Page page(this) {
    Page p = Page.over(this.line(), this.sys!);
    p.opened = this.size;
    this.owner = p;
    this.es = p.es;
    return p;
  }

  /** Handles over this document with no page around them — a view's test, which renders by hand. */
  Elements elements(this) {
    Elements es = Elements.create(this.line());
    this.es = es;
    return es;
  }

  // ── Answering ──────────────────────────────────────────────────────────────

  /**
   * Answer request `id`. **From outside the program's requests it runs the page on**, under the page as its schedule
   * target, as a host's turn would: what the answer settled runs, then every view renders. Inside one it only settles:
   * the request that asked is still running.
   */
  void answer(this, i32 id, Answer a) {
    if (this.owner is null || this.asking > 0) {
      answered(this.host!, id, a.fault, a.text, a.bytes, a.n, a.m, a.flags);
      return;
    }
    Page p = this.owner!;
    schedule p.take;
    answered(this.host!, id, a.fault, a.text, a.bytes, a.n, a.m, a.flags);
    p.drain();
    p.turn();
  }

  void answerWith(this, i32 id, string text, u8[] bytes, i64 n, i64 m, i32 flags) {
    this.answer(id, Answer(0, text, bytes, n, m, flags));
  }

  /** An event, as the document would say it: the oldest request for one hears it. None waiting, and it is lost. */
  void event(this, i32 seq, string kind, i32 target, i32 listener, string value, i32 x, i32 y, i32 mods,
             i32 selStart, i32 selEnd) {
    this.told(Happened(seq, kind, target, listener, value, x, y, mods, selStart, selEnd, this.now, 0 - 1));
  }

  /** A pointer event, as the document would say it: pointer `pointer` — one finger of several — at (`x`, `y`). */
  void pointerEvent(this, i32 seq, string kind, i32 target, i32 listener, i32 x, i32 y, i32 pointer) {
    this.told(Happened(seq, kind, target, listener, "", x, y, 0, 0 - 1, 0 - 1, this.now, pointer));
  }

  void told(this, Happened h) {
    if (this.eventAsks.len() == 0) { return; }
    i32 id = this.eventAsks.remove(0);
    this.answer(id, eventAnswer(h));
  }

  /** Move the clock on by `ms`, waking each sleep that falls due, earliest first. */
  void advance(this, i32 ms) {
    f64 until = this.now + (ms as f64);
    while (true) {
      i32 best = 0 - 1;
      for (i32 i = 0; i < this.sleepDue.len(); i++) {
        if (this.sleepDue.get(i) <= until && (best < 0 || this.sleepDue.get(i) < this.sleepDue.get(best))) { best = i; }
      }
      if (best < 0) { break; }
      this.now = this.sleepDue.remove(best);
      i32 id = this.sleepAsks.remove(best);
      this.answerWith(id, "", u8[](), this.nanos(), 0 as i64, 0);
    }
    this.now = until;
  }

  i64 nanos(this) { return (this.now * 1000000.0) as~ i64; }

  /** The browser paints: every frame asked for is answered. */
  void paint(this) {
    Vec<i32> asked = this.frameAsks;
    this.frameAsks = Vec.create();
    for (i32 i = 0; i < asked.len(); i++) { this.answerWith(asked.get(i), "", u8[](), 0 as i64, 0 as i64, 0); }
  }

  /** The `k`th value read, in the order they were asked, answers `value`. A read answered already ignores it. */
  void answerValue(this, i32 k, string value) { this.answerWith(this.valueAsks.get(k), value, u8[](), 0 as i64, 0 as i64, 0); }

  /** **The reader is at `path` now** — a link followed, Back, Forward — and the program, if it is waiting to hear, hears. */
  void goPath(this, string path) {
    this.path = path;
    Vec<i32> asked = this.pathAsks;
    this.pathAsks = Vec.create();
    for (i32 i = 0; i < asked.len(); i++) { this.answerWith(asked.get(i), path, u8[](), 0 as i64, 0 as i64, 0); }
  }

  /** The user hands over a file — or one that could not be read, saying why. */
  void hand(this, bool ok, string name, u8[] bytes) {
    if (this.fileAsks.len() == 0) {
      this.kept.push(Kept(ok, name, bytes));
      return;
    }
    this.answerWith(this.fileAsks.remove(0), name, bytes, 0 as i64, 0 as i64, ok ? 0 : 1);
  }

  /** The location becomes `hash`; everything asking for a location other than it hears it. */
  void go(this, string hash) {
    this.location = hash.len() > 0 && hash[0] == "#" ? hash.slice(1, hash.len()) : hash;
    Vec<i32> asked = this.locationAsks;
    this.locationAsks = Vec.create();
    for (i32 i = 0; i < asked.len(); i++) { this.answerWith(asked.get(i), this.location, u8[](), 0 as i64, 0 as i64, 0); }
  }

  /** The page is put out of sight — a tab in the background — or back in it; the program hears it (`Page.onVisible`). */
  void see(this, bool on) {
    this.seen = on ? "1" : "0";
    Vec<i32> asked = this.seenAsks;
    this.seenAsks = Vec.create();
    for (i32 i = 0; i < asked.len(); i++) { this.answerWith(asked.get(i), this.seen, u8[](), 0 as i64, 0 as i64, 0); }
  }

  /** The browser's Back: the location before the last the program added to the history, if there is one. */
  void back(this) {
    if (this.visited.len() == 0) { return; }
    this.go(this.visited.remove(this.visited.len() - 1));
  }

  // ── The origin ─────────────────────────────────────────────────────────────

  /** An answer of the origin's, given as soon as the program is not in the middle of asking. */
  void later(this, i32 id, Answer a) {
    if (this.asking == 0) { this.answer(id, a); return; }
    this.laterIds.push(id);
    this.laterAnswers.push(a);
  }

  void giveLater(this) {
    while (this.asking == 0 && this.laterIds.len() > 0) {
      i32 id = this.laterIds.remove(0);
      this.answer(id, this.laterAnswers.remove(0));
    }
  }

  /** Serves the program's `wac.origin`: `server` answers each request — method, path, fields one a line, body. */
  void serving(this, fn<Reply(string, string, string, u8[])> server) { this.server = server; }

  /** A message from the server on socket `id`: the oldest `next` waiting hears it, or it waits for one. */
  void socketSay(this, i32 id, string text) {
    TestSocket s = this.sockets.get(id);
    if (s.closed) { return; }
    s.queue.push(text);
    this.pumpSocket(s);
  }

  /** The server closes socket `id`: once what it said is read, every `next` answers this. */
  void socketClose(this, i32 id, i32 code, string reason) {
    TestSocket s = this.sockets.get(id);
    if (s.closed) { return; }
    s.closed = true;
    s.code = code;
    s.reason = reason;
    this.pumpSocket(s);
  }

  void pumpSocket(this, TestSocket s) {
    while (s.asks.len() > 0 && s.queue.len() > 0) {
      i32 ask = s.asks.remove(0);
      this.later(ask, Answer(0, "", s.queue.remove(0).toBytes(), 0 as i64, 0 as i64, MESSAGE_TEXT));
    }
    if (s.closed && s.queue.len() == 0) {
      while (s.asks.len() > 0) { this.later(s.asks.remove(0), Answer(0, s.reason, u8[](), s.code as i64, 0 as i64, MESSAGE_CLOSED)); }
    }
  }

  void origin(this, i32 k, i32 id, i64 a, i64 b, string text, u8[] bytes) {
    if (k == ORIGIN_FETCH) {
      i32 sp = text.indexOf(" ");
      string method = sp < 0 ? text : text.slice(0, sp);
      string path = sp < 0 ? "" : text.slice(sp + 1, text.len());
      RequestParts parts = requestParts(bytes);
      this.said = this.said + "fetch " + text + "\n";
      Reply r = this.server!(method, path, parts.headers, parts.body);
      this.later(id, Answer(0, r.headers, r.body, r.status as i64, 0 as i64, 0));
      return;
    }
    if (k == ORIGIN_OPEN) {
      this.said = this.said + "socket " + text + "\n";
      this.sockets.push(TestSocket(text, Vec.create(), Vec.create(), Vec.create(), false, 0, ""));
      this.later(id, Answer(0, "", u8[](), (this.sockets.len() - 1) as i64, 0 as i64, 0));
      return;
    }
    i32 n = a as~ i32;
    if (n < 0 || n >= this.sockets.len()) {
      this.later(id, Answer(5, "no such socket", u8[](), 0 as i64, 0 as i64, 0));
      return;
    }
    TestSocket s = this.sockets.get(n);
    if (k == ORIGIN_SEND) {
      if (s.closed) { this.later(id, Answer(5, "the socket is closed", u8[](), 0 as i64, 0 as i64, 0)); return; }
      string msg = string.fromBytes(bytes);
      s.sent.push(msg);
      this.later(id, Answer(0, "", u8[](), 0 as i64, 0 as i64, 0));
      if (this.onSend is not null) { this.onSend!(n, msg); }
      return;
    }
    if (k == ORIGIN_NEXT) {
      s.asks.push(id);
      this.pumpSocket(s);
      return;
    }
    if (k == ORIGIN_CLOSE) {
      this.said = this.said + "close socket \{n}\n";
      this.later(id, Answer(0, "", u8[](), 0 as i64, 0 as i64, 0));
      this.socketClose(n, b as~ i32, text);
      return;
    }
    this.later(id, Answer(FAULT_UNSUPPORTED(), "wac.origin has no request \{k}", u8[](), 0 as i64, 0 as i64, 0));
  }

  // ── The requests ───────────────────────────────────────────────────────────

  void request(this, i32 op, i32 id, i64 a, i64 b, string text, u8[] bytes) {
    if (op == OP_CAPABILITY()) {
      if (text == ORIGIN_CAPABILITY() && this.server is not null) {
        this.answerWith(id, ORIGIN_VERSION(), "http://test.example".toBytes(), ORIGIN_BASE as i64, ORIGIN_COUNT as i64, 0);
        return;
      }
      if (text != PAGE_CAPABILITY()) {
        this.answer(id, Answer(FAULT_UNSUPPORTED(), "no capability " + text + " in a test document", u8[](), 0 as i64, 0 as i64, 0));
        return;
      }
      // Each change as it is made, so a test reads the document straight after the call that changed it.
      this.answerWith(id, PAGE_VERSION(), this.sizeBytes(), BASE as i64, PAGE_COUNT as i64, this.batching ? 0 : PAGE_ONE_AT_A_TIME);
      return;
    }
    if (op == OP_MONOTONIC_NANOS()) {
      this.answerWith(id, "", u8[](), this.nanos(), 0 as i64, 0);
      return;
    }
    if (op == OP_SLEEP_MILLIS()) {
      this.said = this.said + "sleep \{a}\n";
      this.sleepAsks.push(id);
      this.sleepDue.push(this.now + (a as~ f64));
      return;
    }
    if (this.server is not null && op >= ORIGIN_BASE && op < ORIGIN_BASE + ORIGIN_COUNT) {
      this.origin(op - ORIGIN_BASE, id, a, b, text, bytes);
      return;
    }
    i32 k = op - BASE;
    if (k < 0 || k >= PAGE_COUNT) {
      if (id != 0) { this.answer(id, Answer(FAULT_UNSUPPORTED(), "a test document does not serve request \{op}", u8[](), 0 as i64, 0 as i64, 0)); }
      return;
    }
    if (k <= PAGE_TYPE_TEXT) {
      this.ops++;
      this.element(k, id, a, b, text, bytes);
      return;
    }
    if (k == 15) { this.said = this.said + "title " + text + "\n"; this.title = text; return; }
    if (k == PAGE_DESCRIBE) { this.said = this.said + "describe " + text + "\n"; this.description = text; return; }
    if (k == PAGE_LINKS) { this.said = this.said + "links \{a}\n"; this.links = a != (0 as i64); return; }
    if (k == PAGE_NAVIGATE) {
      this.said = this.said + "navigate " + text + (a != (0 as i64) ? " push" : "") + "\n";
      this.goPath(text);
      return;
    }
    if (k == PAGE_PATH) {
      if (text != this.path) { this.answerWith(id, this.path, u8[](), 0 as i64, 0 as i64, 0); return; }
      this.pathAsks.push(id);
      return;
    }
    if (k == 16) { this.said = this.said + "log " + text + "\n"; return; }
    if (k == 17) { this.said = this.said + "download " + text + "\n"; return; }
    if (k == PAGE_SURFACE) {
      this.said = this.said + "surface \{a} for \{highOf(b)} as \{lowOf(b)}\n";
      return;
    }
    if (k == PAGE_FULLSCREEN) {
      this.said = this.said + "fullscreen \{a}" + (b != (0 as i64) ? " on" : " off") + "\n";
      return;
    }
    if (k == PAGE_GO) {
      this.said = this.said + "go " + text + (a != (0 as i64) ? " push" : "") + "\n";
      if (a != (0 as i64)) { this.visited.push(this.location); }
      this.go(text);
      return;
    }
    if (k == PAGE_SOUND) {
      if (b == (0 as i64)) { this.said = this.said + "forget \{a}\n"; return; }
      bool two = text == "2";
      this.said = this.said + "sound \{a} \{b} \{bytes.len() / (two ? 4 : 2)}" + (two ? " stereo" : "") + "\n";
      return;
    }
    if (k == PAGE_PLAY) {
      string when = bytes.len() >= 24 ? " after \{getF64(bytes, 16) as~ i32}"
                  : bytes.len() >= 16 ? " at \{getF64(bytes, 0)} from \{getF64(bytes, 8)}" : "";
      this.said = this.said + "play \{highOf(a)} \{lowOf(a)} \{highOf(b)}" + (lowOf(b) != 0 ? " loop" : "") + when + "\n";
      return;
    }
    if (k == PAGE_STOP) { this.said = this.said + "stop \{a}\n"; return; }
    if (k == PAGE_GAIN) { this.said = this.said + "gain \{a} \{highOf(b)} \{lowOf(b)}\n"; return; }
    if (k == PAGE_EVENT) { this.eventAsks.push(id); return; }
    if (k == PAGE_BATCH) {
      Change[] changes = batchOf(bytes);
      this.said = this.said + "batch \{changes.len()}\n";
      for (i32 i = 0; i < changes.len(); i++) {
        Change c = changes[i];
        this.request(BASE + c.op, 0, c.a, c.b, c.text, c.bytes);
      }
      if (this.onBatch is not null) { this.onBatch!(); }
      this.answerWith(id, "", u8[](), 0 as i64, 0 as i64, 0);
      return;
    }
    if (k == PAGE_FRAME) {
      this.said = this.said + "frame\n";
      this.frameAsks.push(id);
      return;
    }
    if (k == PAGE_FILE) {
      if (this.kept.len() == 0) { this.fileAsks.push(id); return; }
      Kept f = this.kept.remove(0);
      this.answerWith(id, f.name, f.bytes, 0 as i64, 0 as i64, f.ok ? 0 : 1);
      return;
    }
    if (k == PAGE_LOCATION) {
      if (text != this.location) { this.answerWith(id, this.location, u8[](), 0 as i64, 0 as i64, 0); return; }
      this.locationAsks.push(id);
      return;
    }
    if (k == PAGE_BACK) {
      this.said = this.said + "back\n";
      this.back();
      return;
    }
    if (k == PAGE_ZONE_NAME) {
      this.answerWith(id, this.zoneName, u8[](), 0 as i64, 0 as i64, 0);
      return;
    }
    // A resume is recorded, so a test can say the program asked; it runs at once, as an allowed one does.
    if (k == PAGE_AUDIO) {
      if (a != (0 as i64)) {
        this.said = this.said + "audio resume\n";
        if (this.audio != "closed") { this.audio = "running"; }
      }
      this.answerWith(id, this.audio, u8[](), 0 as i64, 0 as i64, 0);
      return;
    }
    if (k == PAGE_STORED) {
      string? v = this.storage.get(text);
      this.later(id, Answer(0, v ?? "", u8[](), 0 as i64, 0 as i64, v is null ? 1 : 0));
      return;
    }
    if (k == PAGE_STORE) {
      if (a != (0 as i64)) {
        this.said = this.said + "unstore " + text + "\n";
        this.storage.remove(text);
      } else {
        this.said = this.said + "store " + text + " " + string.fromBytes(bytes) + "\n";
        this.storage.set(text, string.fromBytes(bytes));
      }
      return;
    }
    if (k == PAGE_ZONE) {
      this.answerWith(id, "", u8[](), this.zone as i64, 0 as i64, 0);
      return;
    }
    if (k == PAGE_VISIBLE) {
      if (text != this.seen) { this.answerWith(id, this.seen, u8[](), 0 as i64, 0 as i64, 0); return; }
      this.seenAsks.push(id);
    }
  }

  /** An element operation, done to the records. */
  void element(this, i32 k, i32 id, i64 a, i64 b, string text, u8[] bytes) {
    i32 h = lowOf(a);
    i32 seen = highOf(a);
    if (k == 0 || k == 1) {
      i32 parent = highOf(b);
      i32 before = lowOf(b);
      this.said = this.said + (k == 0 ? "make \{h} " : "makeText \{h} ") + text + "\n";
      this.put(h, k == 0 ? text : "", parent);
      if (k == 1) {
        TestNode made = this.at(h);
        made.text = text;
      }
      this.place(h, parent, before);
      return;
    }
    if (k == 2) {
      this.said = this.said + "text \{h} " + text + "\n";
      TestNode n = this.at(h);
      if (n.tag != "") {
        for (i32 i = 0; i < n.kids.len(); i++) { this.forget(n.kids.get(i)); }
        n.kids.clear();
      }
      n.text = text;
      return;
    }
    if (k == 3) {
      this.setAttr(this.at(h), text, string.fromBytes(bytes), b != 0 as i64);
      return;
    }
    if (k == 4) {
      TestNode n = this.at(h);
      string value = string.fromBytes(bytes);
      if (text == "value" && n.typed > seen) { return; }
      this.setAttr(n, "." + text, value, true);
      // A value set by a program puts the caret at its end, as a browser does.
      if (text == "value" && n.selStart >= 0) { n.selStart = value.len(); n.selEnd = value.len(); }
      return;
    }
    if (k == 5) {
      TestNode n = this.at(h);
      this.unplace(h);
      this.place(h, n.parent, b as~ i32);
      return;
    }
    if (k == 6) {
      this.unplace(h);
      this.forget(h);
      return;
    }
    if (k == 7) {
      this.said = this.said + "listen \{h} " + text + "\n";
      this.at(h).listens.push(text);
      this.at(h).prevents.push(string.fromBytes(bytes));
      return;
    }
    if (k == PAGE_VALUE) {
      this.said = this.said + "value \{h}\n";
      this.valueAsks.push(id);
      return;
    }
    // A canvas's picture as its text: its size and its first byte, which is what a test can tell apart.
    if (k == 10) {
      TestNode c = this.at(h);
      c.text = "pixels \{highOf(b)}x\{lowOf(b)} \{bytes.len() > 0 ? bytes[0] as i32 : 0 - 1}";
      return;
    }
    if (k == 11) {
      TestNode c = this.at(h);
      c.text = "pixelsIn \{quadAt(b, 0)},\{quadAt(b, 1)} \{quadAt(b, 2)}x\{quadAt(b, 3)} \{bytes.len() > 0 ? bytes[0] as i32 : 0 - 1}";
      return;
    }
    if (k == 12) {
      this.scrolled = "\{h} " + text;
      return;
    }
    if (k == 13) {
      TestNode n = this.at(h);
      if (n.selStart < 0 || n.typed > seen) { return; }
      this.caret(h, highOf(b), lowOf(b));
      return;
    }
    if (k == 14) {
      TestNode n = this.at(h);
      if (n.selStart < 0 || n.typed > seen) { return; }
      string v = this.valueOf(h);
      this.setAttr(n, ".value", v.slice(0, n.selStart) + text + v.slice(n.selEnd, v.len()), true);
      n.selStart = n.selStart + text.len();
      n.selEnd = n.selStart;
      this.typedInto.push(h);
    }
  }

  void put(this, i32 id, string tag, i32 parent) {
    while (this.nodes.len() <= id) { this.nodes.push(null); }
    Vec<string> names = Vec.create();
    Vec<string> values = Vec.create();
    Vec<i32> kids = Vec.create();
    Vec<string> listens = Vec.create();
    Vec<string> prevents = Vec.create();
    i32 caret = tag == "input" || tag == "textarea" ? 0 : 0 - 1;
    this.nodes.set(id, TestNode(id, tag, "", names, values, kids, parent, listens, prevents, 0, caret, caret));
  }

  TestNode at(this, i32 id) { return this.nodes.get(id)!; }

  void place(this, i32 id, i32 parent, i32 before) {
    TestNode p = this.at(parent);
    if (before < 0) { p.kids.push(id); return; }
    for (i32 i = 0; i < p.kids.len(); i++) {
      if (p.kids.get(i) == before) { p.kids.insert(i, id); return; }
    }
    p.kids.push(id);
  }

  void unplace(this, i32 id) {
    TestNode n = this.at(id);
    if (n.parent < 0) { return; }
    TestNode p = this.at(n.parent);
    for (i32 i = 0; i < p.kids.len(); i++) {
      if (p.kids.get(i) == id) { p.kids.remove(i); return; }
    }
  }

  void forget(this, i32 id) {
    TestNode n = this.at(id);
    for (i32 i = 0; i < n.kids.len(); i++) { this.forget(n.kids.get(i)); }
    this.nodes.set(id, null);
  }

  void setAttr(this, TestNode n, string name, string value, bool present) {
    for (i32 i = 0; i < n.names.len(); i++) {
      if (n.names.get(i) == name) {
        if (present) { n.values.set(i, value); } else { n.names.remove(i); n.values.remove(i); }
        return;
      }
    }
    if (present) { n.names.push(name); n.values.push(value); }
  }

  string? attr(this, i32 id, string name) {
    TestNode n = this.at(id);
    for (i32 i = 0; i < n.names.len(); i++) { if (n.names.get(i) == name) { return n.values.get(i); } }
    return null;
  }

  /** The first live node, in document order, whose attribute `name` is `value`, or -1. */
  i32 find(this, string name, string value) { return this.findFrom(0, name, value); }

  i32 findFrom(this, i32 id, string name, string value) {
    string? v = this.attr(id, name);
    if (v is not null && v! == value) { return id; }
    TestNode n = this.at(id);
    for (i32 i = 0; i < n.kids.len(); i++) {
      i32 f = this.findFrom(n.kids.get(i), name, value);
      if (f >= 0) { return f; }
    }
    return 0 - 1;
  }

  /** The first element called `tag`, or -1. */
  i32 findTag(this, string tag) { return this.findTagFrom(0, tag); }

  i32 findTagFrom(this, i32 id, string tag) {
    TestNode n = this.at(id);
    if (n.tag == tag && id != 0) { return id; }
    for (i32 i = 0; i < n.kids.len(); i++) {
      i32 f = this.findTagFrom(n.kids.get(i), tag);
      if (f >= 0) { return f; }
    }
    return 0 - 1;
  }

  /** A text field's value: what the program set or the user typed, or `""`. */
  string valueOf(this, i32 id) { return this.attr(id, ".value") ?? ""; }

  /**
   * Put text field `id`'s caret at `start`..`end`, clamped to its value — a user's click or drag, so no event:
   * the next one carries it. Counted in bytes here; a browser counts UTF-16 code units, which agree for ASCII.
   */
  void caret(this, i32 id, i32 start, i32 end) {
    TestNode n = this.at(id);
    i32 len = this.valueOf(id).len();
    n.selStart = start < 0 ? 0 : (start > len ? len : start);
    n.selEnd = end < n.selStart ? n.selStart : (end > len ? len : end);
  }

  /** The text under a node, all of it, in order. */
  string shown(this, i32 id) {
    TestNode n = this.at(id);
    if (n.tag == "") { return n.text; }
    string s = n.kids.len() == 0 ? n.text : "";
    for (i32 i = 0; i < n.kids.len(); i++) { s = s + this.shown(n.kids.get(i)); }
    return s;
  }

  /** How many children a node has in the document. */
  i32 kidCount(this, i32 id) { return this.at(id).kids.len(); }

  /**
   * `kind` happens at `target`, carrying `value`: every listener from the target up hears it, nearest
   * first, as in a browser, with the target's caret. An `input` is typing: the field holds `value` after it,
   * the caret at its end, and it is marked as typed into with this event's number. What `typeText` typed while
   * it was handled fires its own `input` after.
   */
  void fire(this, i32 target, string kind, string value) {
    this.seq = this.seq + 1;
    TestNode hit = this.at(target);
    if (kind == "input") {
      hit.typed = this.seq;
      if (hit.selStart >= 0 && this.valueOf(target) != value) {
        this.setAttr(hit, ".value", value, true);
        hit.selStart = value.len();
        hit.selEnd = value.len();
      }
    }
    i32 selStart = hit.selStart;
    i32 selEnd = hit.selEnd;
    i32 at = target;
    while (at >= 0) {
      TestNode n = this.at(at);
      for (i32 i = 0; i < n.listens.len(); i++) {
        if (n.listens.get(i) != kind) { continue; }
        this.event(this.seq, kind, target, at, value, 0, 0, 0, selStart, selEnd);
      }
      if (this.nodes.get(at) is null) { break; }
      at = n.parent;
    }
    while (this.typedInto.len() > 0) {
      i32 field = this.typedInto.remove(0);
      if (this.nodes.get(field) is null) { continue; }
      this.fire(field, "input", this.valueOf(field));
    }
  }
}
