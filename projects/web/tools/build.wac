          },
          stored: (req, key) => {
            let v = null;
            try { v = localStorage.getItem(key); } catch {}
            queueMicrotask(() => emit(["stored", req, v]));
          },
          store: (key, value, remove) => {
            try { if (remove) localStorage.removeItem(key); else localStorage.setItem(key, value); } catch {}
          },
          download: (name, bytes) => {
            const a = document.createElement("a");
            a.href = URL.createObjectURL(new Blob([bytes]));
            a.download = name;
            a.click();
            setTimeout(() => URL.revokeObjectURL(a.href), 1000);
          },
        };
        // Files arrive whether or not the program has asked yet; the page keeps them until it does.
        // A file's name is its path below what the user handed over — `photos/2024/a.jpg` for a file
        // in a folder, picked with `webkitdirectory` or dropped, and `a.jpg` for a file on its own.
        const send = (f, path) => f.arrayBuffer().then(
          (buf) => emit(["file", true, path, new Uint8Array(buf), ""], [buf]),
          (e) => emit(["file", false, path, new Uint8Array(0), String(e?.message ?? e)]));
        const take = (files) => { for (const f of files ?? []) send(f, f.webkitRelativePath || f.name); };
        // A dropped folder is a directory entry rather than a file — reading it as one fails — so it is
        // walked. `readEntries` answers in batches, and an empty batch is the end of the directory.
        const rel = (p) => p.startsWith("/") ? p.slice(1) : p;
        const failed = (path, e) => emit(["file", false, path, new Uint8Array(0), String(e?.message ?? e)]);
        const walk = (entry) => {
          if (entry.isFile) {
            entry.file((f) => send(f, rel(entry.fullPath)), (e) => failed(rel(entry.fullPath), e));
          } else if (entry.isDirectory) {
            // Some browsers refuse to list a dropped folder on a page opened from a `file://` URL: the
            // error says it was a folder, so a program can say what to do instead.
            const reader = entry.createReader();
            const more = () => reader.readEntries(
              (batch) => { if (batch.length > 0) { batch.forEach(walk); more(); } },
              (e) => failed(rel(entry.fullPath), `a dropped folder could not be listed here (${e?.name}: ${e?.message})`));
            more();
          }
        };
        // **A handle where the browser has one** (Chrome, Edge): the entry API's `readEntries` fails with
        // an EncodingError on a page opened from a `file://` URL, and a built page is often opened that way.
        const walkHandle = async (h, path) => {
          if (h.kind === "file") {
            try { send(await h.getFile(), path); } catch (e) { failed(path, e); }
            return;
          }
          try { for await (const kid of h.values()) await walkHandle(kid, path + "/" + kid.name); }
          catch (e) { failed(path, e); }
        };
        // **Only a folder is walked.** A dropped file is read as the file it is: through an entry, some
        // browsers cannot read even a lone file on a page opened from a `file://` URL. Entries and handles
        // are taken during the event, because a drop's items are unreadable once it returns; a handle the
        // browser then refuses — as it may in a sandboxed frame — falls back to the entry. A browser with
        // no entries at all cannot tell a folder from a file, and is given `files` as it always was.
        const dropped = (dt) => {
          const items = [...(dt?.items ?? [])].filter((it) => it.kind === "file");
          const files = [...(dt?.files ?? [])];
          const entries = items.map((it) => it.webkitGetAsEntry?.() ?? null);
          if (items.length === 0 || files.length !== items.length || entries.some((x) => x === null)) {
            take(dt?.files);
            return;
          }
          const handles = items.map((it, i) =>
            entries[i].isDirectory && it.getAsFileSystemHandle ? it.getAsFileSystemHandle() : null);
          items.forEach((it, i) => {
            if (!entries[i].isDirectory) take([files[i]]);
            else if (handles[i]) handles[i].then((h) => h ? walkHandle(h, h.name) : walk(entries[i]), () => walk(entries[i]));
            else walk(entries[i]);
          });
        };
        const changed = (ev) => { const t = origin(ev); if (t?.files) take(t.files); };
        root.addEventListener("change", changed);
        // A link to `#/somewhere`, and the browser's back and forward, move the location; the program follows.
        addEventListener("hashchange", () => emit(["where", location.hash]));
        // Back and Forward between the site's pages, which the program navigated to: where the reader is now.
        addEventListener("popstate", () => emit(["path", wacRouteOf(location.pathname)]));
        // **A link to a page of this site, followed here** once the program has asked (`PAGE_LINKS`): the history moved
        // and the program told, rather than the page loaded again. Not a link a handler has prevented, one opened in a
        // new tab or window — a modifier held, a target — nor one to download, elsewhere, or within this page.
        let linksOn = false;
        root.addEventListener("click", (ev) => {
          if (!linksOn || ev.defaultPrevented || ev.button !== 0 || ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
          if (location.protocol === "file:") return;
          const a = ev.target instanceof Element ? ev.target.closest("a[href]") : null;
          if (!a || !root.contains(a) || (a.target && a.target !== "_self") || a.hasAttribute("download")) return;
          const u = new URL(a.href, location.href);
          if (u.origin !== location.origin || !(u.pathname + "/").startsWith(wacSiteBase + "/")) return;
          if (u.pathname === location.pathname && u.search === location.search && u.hash) return;
          ev.preventDefault();
          history.pushState(null, "", u.pathname + u.search + u.hash);
          emit(["path", wacRouteOf(u.pathname)]);
        });
        // **Whether the page is seen**: said once now and at each change. `pagehide` as well as `visibilitychange`,
        // because a page being left is not always hidden first, and what it has not saved by then is lost.
        // The first after this returns: whoever made this document starts the program only then, and a message before
        // the program exists would be taken for the one that starts it.
        const seeing = (on) => emit(["seen", on ? "1" : "0"]);
        queueMicrotask(() => seeing(document.visibilityState !== "hidden"));
        document.addEventListener("visibilitychange", () => seeing(document.visibilityState !== "hidden"));
        addEventListener("pagehide", () => seeing(false));
        addEventListener("pageshow", () => seeing(document.visibilityState !== "hidden"));
        // Without preventing dragover a dropped file replaces the page.
        document.addEventListener("dragover", (ev) => ev.preventDefault());
        document.addEventListener("drop", (ev) => { ev.preventDefault(); dropped(ev.dataTransfer); });
        const apply = (m) => ops[m[0]](...m.slice(1));
        return (m) => {
          batchNow = performance.timeOrigin + performance.now();
          try {
            if (m[0] !== "ops") apply(m);
            else if (!hydrating) { for (const x of m[1]) apply(x); }
            else {
              // **The first batch, over the first frame drawn ahead of time.** A field the reader has already typed into or
              // ticked keeps what they did; the events that did it are handed over once the listeners are in place.
              const early = window.wacEarly ?? [];
              window.wacEarly = null;
              for (const ev of early) if (ev.type === "input" || ev.type === "change") { const t = origin(ev); if (t) t.__wacEarly = true; }
              for (const x of m[1]) apply(x);
              sweep();
              replay(early);
            }
          } finally { batchNow = null; batchAudio = null; }
        };
      };
      """;
}

/**
 * **The page's thread starts every program** (design/system/0015 decision 3), for every worker that asks: the
 * page's own program, a copy of the page it started, a module, and anything those start in turn. It makes a
 * `MessageChannel` and hands one end to the worker that asked and the other to the new one, so the two talk
 * directly; the page's thread hears from them only to start a child and to stop one.
 *
 * **Why the page's thread**: a page opened from a file has an opaque origin, and a worker there may not start a
 * worker — while the page's own thread may. One route for `http://` and `file://` alike, so the tests over `http://`
 * exercise what a page from a file depends on. And only the thread that started a worker can end it, which is
 * what `^C` needs: asked to stop a child, it stops it and everything it started, as ending a worker that had
 * started its own used to.
 *
 * `broker(from, message)` answers whether the message was the broker's: `["broker", n, "start", kind, init]`, answered
 * `["brokered", n, id, port]` (or `null` and why), or `["broker", 0, "stop", id]`. A child that dies without exiting —
 * a trap the browser reports — is told to its parent as `["childFailed", id, why]`.
 */
export string brokerSide() {
  return """
      const wacBroker = (script) => {
        const kids = new Map();
        let next = 0;
        const stop = (id) => {
          const k = kids.get(id);
          if (k === undefined) return;
          kids.delete(id);
          k.worker.terminate();
          for (const [other, o] of kids) if (o.parent === k.worker) stop(other);
        };
        const broker = (from, m) => {
          if (Array.isArray(m) && m[0] === "surfaceSize") {
            const s = wacSurfaceEls.get(m[1])?.__wacSurface;
            if (s) { s.w = m[2]; s.h = m[3]; }
            return true;
          }
          if (!Array.isArray(m) || m[0] !== "broker") return false;
          const [, n, op, ...rest] = m;
          if (op === "stop") { stop(rest[0]); return true; }
          const [kind, init] = rest;
          let worker;
          try { worker = new Worker(script); }
          catch (e) { from.postMessage(["brokered", n, -1, null, String(e?.message ?? e)]); return true; }
          const id = ++next;
          kids.set(id, { worker, parent: from });
          worker.onmessage = (e) => { broker(worker, e.data); };
          worker.onerror = (e) => {
            e.preventDefault();
            if (kids.has(id)) from.postMessage(["childFailed", id, e.message || "the program stopped"]);
          };
          const channel = new MessageChannel();
          worker.postMessage([kind, init, channel.port2], [channel.port2, ...(init.wasm ? [init.wasm.buffer] : [])]);
          from.postMessage(["brokered", n, id, channel.port1], [channel.port1]);
          return true;
        };
        return broker;
      };
      """;
}

/**
 * A worker's side of `brokerSide`: `wacAskPage` asks the page's thread to start a child and answers its id and this
 * worker's end of the channel; `wacTellPage` asks it to stop one; `wacFromPage` takes the answers, and says whether a
 * message was one. `wacFromParent` is what a child's parent sends down the channel.
 */
export string brokerClient() {
  return """
      const wacAsked = new Map();
      let wacAskedNext = 0;
      const wacChildFailed = new Map();
      const wacAskPage = (m, transfer) => new Promise((done) => {
        const n = ++wacAskedNext;
        wacAsked.set(n, done);
        postMessage(["broker", n, ...m], transfer ?? []);
      });
      const wacTellPage = (m) => postMessage(["broker", 0, ...m]);
      // ── Surfaces: canvases this worker draws itself (web's `HOST_SURFACE_*`, `PAGE_SURFACE`) ──
      // Each by its key: the canvas once it has arrived, and what to draw when it does. A key forwarded is a child's,
      // by the handle its program spawned it as; the children so known. `wacSurfaceById`, by the document's number for
      // each, is for a test to read back what was drawn — the document cannot, once a canvas is handed over.
      const wacSurfaces = new Map(), wacSurfaceForward = new Map(), wacChildren = new Map();
      let wacSurfaceNext = 0;
      self.wacSurfaceById = new Map();
      const wacSurfaceOf = (key) => {
        let s = wacSurfaces.get(key);
        if (s === undefined) { s = { canvas: null, ctx: null, docId: 0, pending: null }; wacSurfaces.set(key, s); }
        return s;
      };
      const wacSurfaceCame = (key, canvas, docId) => {
        const f = wacSurfaceForward.get(key);
        if (f !== undefined) {
          wacSurfaceForward.delete(key);
          wacChildren.get(f.child)?.send(["surface", f.key, canvas, docId], [canvas]);
          return;
        }
        const s = wacSurfaceOf(key);
        s.canvas = canvas;
        s.ctx = canvas.getContext("2d");
        s.docId = docId;
        self.wacSurfaceById.set(docId, canvas);
        const p = s.pending;
        s.pending = null;
        if (p !== null) wacSurfaceDraw(key, 0, 0, p.w, p.h, true, p.data);
      };
      // Drawn — or, before the canvas has arrived, kept to draw when it does, and false: the program sends it the
      // usual way meanwhile. Resized, the document is told, which places the pointer in the canvas's pixels by it.
      const wacSurfaceDraw = (key, x, y, w, h, whole, rgba) => {
        const s = wacSurfaces.get(key);
        if (s === undefined) return false;
        if (s.ctx === null) {
          if (whole) s.pending = { w, h, data: new Uint8ClampedArray(rgba) };
          else if (s.pending !== null) {
            const p = s.pending, cols = Math.min(w, p.w - x) * 4;
            for (let r = 0; r < h && y + r < p.h && cols > 0; r++) p.data.set(rgba.subarray(r * w * 4, r * w * 4 + cols), ((y + r) * p.w + x) * 4);
          }
          return false;
        }
        if (whole && (s.canvas.width !== w || s.canvas.height !== h)) {
          s.canvas.width = w;
          s.canvas.height = h;
          postMessage(["surfaceSize", s.docId, w, h]);
        }
        if (w > 0 && h > 0) s.ctx.putImageData(new ImageData(new Uint8ClampedArray(rgba.buffer, rgba.byteOffset, w * h * 4), w, h), x, y);
        return true;
      };
      const wacFromPage = (m) => {
        if (!Array.isArray(m)) return false;
        if (m[0] === "surface") { wacSurfaceCame(m[1], m[2], m[3]); return true; }
        if (m[0] === "brokered") {
          const done = wacAsked.get(m[1]);
          wacAsked.delete(m[1]);
          if (done) done([m[2], m[3], m[4] ?? ""]);
          return true;
        }
        if (m[0] === "childFailed") { wacChildFailed.get(m[1])?.(m[2]); return true; }
        return false;
      };
      const wacFromParent = (m, stdin, fsIn) => {
        if (m[0] === "stdin") stdin.push(m[1]);
        else if (m[0] === "stdinEnd") stdin.end();
        else if (m[0] === "fs") fsIn.push(m[1]);
        else if (m[0] === "surface") wacSurfaceCame(m[1], m[2], m[3]);
      };
      """;
}

/**
 * The page, with the program in a worker: the program's half in a script the browser does not run, the module as
 * base64 in an element it does not run either, and the document's half starting a worker from that script's text
 * and handing it the module. A blob rather than a second file, so the page stays one file that also works from a
 * `file://` URL — and a **classic** worker: a module worker made from a blob is refused on a `file://` page, and a
 * `data:` one would lose the page's origin and the storage that goes with it.
 */
export string workerIndexFor(PageHead h, string first, string wasm, i32 grants, string moduleUrl) {
  return head(h, first) + (moduleUrl == "" ? moduleElement(wasm) : "")
       + "<script type=\"text/plain\" id=\"wac-program\">\n" + systemSide() + programSide() + moduleSide()
       // The first message says who this worker is: the page's program, or a module a program started.
       + brokerClient()
       + "let receive = null;\n"
       + "onmessage = (e) => {\n"
       + "  if (wacFromPage(e.data)) return;\n"
       + "  if (receive !== null) return receive(e.data);\n"
       + "  if (e.data[0] === \"module\") { receive = () => {}; return wacModule(e.data[1], e.data[2]); }\n"
       + "  receive = wacPage(e.data[2], \{grants}, (m, transfer) => postMessage(m, transfer ?? []), e.data[1], e.data[3], e.data[4], e.data[5]);\n"
       + "};\n</script>\n"
       + documentScript(documentSide() + brokerSide() + moduleBytes(moduleUrl)
       + """
         const source = document.getElementById("wac-program").textContent;
         const script = URL.createObjectURL(new Blob([source], { type: "text/javascript" }));
         const worker = new Worker(script);
         const broker = wacBroker(script);
         // **Held until the program is started**: the worker takes its first message for the one that starts it, and
         // the document speaks first — whether it is seen — while the module may still be on its way.
         let started = false;
         const held = [];
         const toProgram = (m, transfer) => { if (started) worker.postMessage(m, transfer ?? []); else held.push([m, transfer]); };
         const apply = wacDocument(document.getElementById("app"), toProgram);
         worker.onmessage = (e) => { if (!broker(worker, e.data)) apply(e.data); };
         worker.onerror = (e) => console.error(e.message);
         // The window's size as the document chose its frame by, now, whenever the module arrives.
         const size = `${innerWidth}x${innerHeight}`;
         wacModuleBytes().then((wasm) => {
           worker.postMessage(["page", location.hash, wasm, location.protocol === "file:" ? null : location.href, size, wacRouteOf(location.pathname)], [wasm.buffer]);
           started = true;
           for (const [m, transfer] of held) worker.postMessage(m, transfer ?? []);
         }, (e) => console.error("wac: the page's module could not be loaded: " + e.message));
         """)
       + "</body>\n</html>\n";
}

/** The page, with the program on the page's own thread: the two halves joined directly. */
export string inPageIndexFor(PageHead h, string first, string wasm, i32 grants, string moduleUrl) {
  return head(h, first) + (moduleUrl == "" ? moduleElement(wasm) : "")
       + documentScript(systemSide() + moduleSide() + programSide() + documentSide() + moduleBytes(moduleUrl)
       + "let receive = null;\n"
       // What the document says before the program is started is held for it, as the worker's page does.
       + "const held = [];\n"
       + "const apply = wacDocument(document.getElementById(\"app\"), (m) => { if (receive !== null) receive(m); else held.push(m); });\n"
       + "const size = `${innerWidth}x${innerHeight}`;\n"
       + "wacModuleBytes().then((wasm) => {\n"
       + "  receive = wacPage(wasm, \{grants}, (m) => apply(m), location.hash, location.protocol === \"file:\" ? null : location.href, size, wacRouteOf(location.pathname));\n"
       + "  for (const m of held) receive(m);\n"
       + "}, (e) => console.error(\"wac: the page's module could not be loaded: \" + e.message));\n")
       + "</body>\n</html>\n";
}

/** The page's module, as base64 in an element the browser does not run. */
string moduleElement(string wasm) {
  return "<script type=\"text/plain\" id=\"wac-module\">" + wasm + "</script>\n";
}

/**
 * `wacModuleBytes()`: the page's module, as bytes, when they are here — from the element that holds it, or, built with
 * `--module-file`, fetched from `url`, beside the page.
 */
string moduleBytes(string url) {
  if (url != "") {
    return "      const wacModuleBytes = () => fetch(new URL(\"" + url + "\", location.href)).then((r) => {\n"
         + """
        if (!r.ok) throw new Error(`${r.url}: ${r.status} ${r.statusText}`);
        return r.arrayBuffer();
      }).then((b) => new Uint8Array(b));
      """;
  }
  return """
      const wacModuleBytes = () => {
        const text = atob(document.getElementById("wac-module").textContent.trim());
        const bytes = new Uint8Array(text.length);
        for (let i = 0; i < text.length; i++) bytes[i] = text.charCodeAt(i);
        return Promise.resolve(bytes);
      };
      """;
}

/**
 * **Which module a page was built with**, for its URL — `page.wasm?v=<this>` — so a browser that has an older
 * `page.wasm` cached fetches the one this page's first frames and host were made for. FNV-1a, 32 bits, in hex: a name
 * for a version, not a check of its bytes.
 */
export string versionOf(u8[] bytes) {
  i64 h = 2166136261 as i64;
  i64 prime = 16777619 as i64;
  i64 mask = 4294967295 as i64;
  for (u8 c in bytes) { h = ((h ^ (c as i64)) * prime) & mask; }
  string digits = "0123456789abcdef";
  string out = "";
  for (i32 i = 0; i < 8; i++) {
    i32 d = ((h >> ((28 - 4 * i) as i64)) & (15 as i64)) as! i32;
    out = out + digits.slice(d, d + 1);
  }
  return out;
}

/**
 * The document's script, held as text, and the one script the page runs as written: `loaderScript`,
 * which runs it from a `blob:` URL.
 *
 * **So that the Content Security Policy can name what runs** (`design/system/0012`, "Policy is in wac;
 * the browser enforces it again"). A policy allows inline script by hash, and the document's script
 * holds the program in the in-page build — a different hash for every program, and a SHA-256 this
 * program would have to carry a copy of. The loader is the same few lines for every page, so its hash
 * is a constant (`loaderHash`, checked by `tools/wac/webpolicy_test.wac`), and the policy allows that
 * and `blob:`, which only a script already running can make.
 */
string documentScript(string body) {
  return "<script type=\"text/plain\" id=\"wac-document\">\n\"use strict\";\n" + body + "</script>\n"
       + "<script>" + loaderScript() + "</script>\n";
}

/** The script that runs `#wac-document`. Change it and `loaderHash` changes with it. */
export string loaderScript() {
  return "const s = document.createElement(\"script\"); "
       + "s.src = URL.createObjectURL(new Blob([document.getElementById(\"wac-document\").textContent], { type: \"text/javascript\" })); "
       + "document.body.appendChild(s);";
}

/** `loaderScript`'s SHA-256, base64 — what the policy allows it by. */
export string loaderHash() { return "xLE7i4agIkrLt+lCU03oQkaXG/ugC3kfxyQdZETBPVM="; }

/**
 * The page's Content Security Policy: its loader, scripts it made itself, its own wasm, and nothing
 * fetched from anywhere — not an image, not a style sheet, not a frame. A program has no network grant,
 * so a document it draws cannot be one either: `<img src="https://elsewhere/?secret">` is refused here
 * as well as by the handle layer's policy, and an injected `<script>` or `onerror` does not run.
 *
 * **Except its own origin, to read** (`connect-src 'self'`): `wac.site`'s GETs, which the host makes for a program
 * and keeps under the page's folder. A program runs no script of its own, so the host is all that can.
 */
export string policy() {
  return "default-src 'none'; connect-src 'self'; script-src 'sha256-" + loaderHash() + "' 'sha256-" + earlyHash()
       + "' blob: 'wasm-unsafe-eval'; "
       + "worker-src blob:; style-src 'unsafe-inline'; img-src data: blob:; font-src data:; "
       + "media-src data: blob:; base-uri 'none'; form-action 'none'";
}

/**
 * **The viewport**: as wide as the device, and — `interactive-widget` — made smaller by an on-screen keyboard, rather
 * than covered by it, where the browser offers the choice: what is typed into stays in view.
 */
static string VIEWPORT = "width=device-width, initial-scale=1, interactive-widget=resizes-content";

/** `page` drawn to the screen's edges (`Asked.edge`). */
export string edgeToEdge(string page) {
  string from = "content=\"" + VIEWPORT + "\"";
  i32 at = page.indexOf(from);
  if (at < 0) { return page; }
  return page.slice(0, at) + "content=\"" + VIEWPORT + ", viewport-fit=cover\"" + page.slice(at + from.len(), page.len());
}

// ── an app to install ───────────────────────────────────────────────────────

/** `s` with its first `from` made `to` — or as it is, without one. */
string swap(string s, string from, string to) {
  i32 at = s.indexOf(from);
  return at < 0 ? s : s.slice(0, at) + to + s.slice(at + from.len(), s.len());
}

static string APP_ICON = "icon.png";
static string APP_WORKER = "sw.js";

/**
 * **What an installed app may load besides**: its manifest, its icon, and its service worker — each one of its own
 * files (`'self'`), and nothing from anywhere else.
 */
export string appPolicy() {
  return swap(swap(policy(), "worker-src blob:", "worker-src blob: 'self'"), "img-src data: blob:", "img-src data: blob: 'self'")
       + "; manifest-src 'self'";
}

/**
 * `page` as an app to install: its manifest and icon named in its head — the icon for a phone's home screen too —
 * its policy allowing them, and its document registering the service worker, from a site (a page opened from a file
 * has no origin to install from). Edge to edge, a phone's status bar is drawn over the page, which keeps clear of it.
 */
export string asApp(string page, string color, bool edge, string prefix) {
  string tags = "<link rel=\"manifest\" href=\"" + prefix + "manifest.webmanifest\">\n"
              + "<link rel=\"icon\" href=\"" + prefix + APP_ICON + "\">\n<link rel=\"apple-touch-icon\" href=\"" + prefix + APP_ICON + "\">\n"
              + "<meta name=\"theme-color\" content=\"" + color + "\">\n"
              + "<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n"
              + (edge ? "<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n" : "");
  string register = "if (\"serviceWorker\" in navigator && location.protocol !== \"file:\") {\n"
                  + "  navigator.serviceWorker.register(\"" + prefix + APP_WORKER + "\").catch((e) => console.warn(\"no copy to open without the network: \" + e.message));\n}\n";
  string script = "<script type=\"text/plain\" id=\"wac-document\">\n\"use strict\";\n";
  return swap(swap(swap(page, policy(), appPolicy()), "<title>", tags + "<title>"), script, script + register);
}

/** The manifest: the page's title as the app's name, standing alone on a phone's screen, `color` its bar's colour. */
export string manifestOf(string title, string color) {
  Vec<u8> out = Vec.create();
  u8[] b = title.toBytes();
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] == '"' || b[i] == '\\') { out.push('\\'); }
    out.push(b[i]);
  }
  string name = string.fromBytes(out.toArray());
  return "{\n  \"name\": \"" + name + "\",\n  \"short_name\": \"" + name + "\",\n  \"start_url\": \"./\",\n  \"scope\": \"./\",\n"
       + "  \"display\": \"standalone\",\n  \"background_color\": \"" + color + "\",\n  \"theme_color\": \"" + color + "\",\n"
       + "  \"icons\": [\n"
       + "    { \"src\": \"" + APP_ICON + "\", \"sizes\": \"192x192 512x512\", \"type\": \"image/png\", \"purpose\": \"any\" },\n"
       + "    { \"src\": \"" + APP_ICON + "\", \"sizes\": \"512x512\", \"type\": \"image/png\", \"purpose\": \"maskable\" }\n  ]\n}\n";
}

/**
 * **The service worker: the network first, its copy when there is none.** Every file of the site the page fetches is
 * kept as it arrives, and a request the network cannot answer is answered from what was kept — so an installed app
 * opens, and what it has opened before works, offline; online it never shows anything older than the site.
 */
export string serviceWorker() {
  return """
    "use strict";
    const KEPT = "wac-page";
    self.addEventListener("install", () => self.skipWaiting());
    self.addEventListener("activate", (e) => e.waitUntil(self.clients.claim()));
    self.addEventListener("fetch", (e) => {
      const req = e.request;
      if (req.method !== "GET" || new URL(req.url).origin !== location.origin) return;
      e.respondWith(fetch(req).then((res) => {
        if (res.ok) {
          const copy = res.clone();
          e.waitUntil(caches.open(KEPT).then((c) => c.put(req, copy)));
        }
        return res;
      }, () => caches.match(req, { ignoreSearch: true }).then((kept) => kept ?? Response.error())));
    });
  """;
}

/** What a page's head says about it: its title, its description, its path on its site, its canonical address. */
export struct PageHead {
  string title;
  string description;
  string route;
  string canonical;

  /** A page with a title and nothing else to say: the site's root. */
  PageHead titled(string title) { return PageHead(title, "", "/", ""); }
}

/** Everything before the script: the document the program draws into. */
string head(PageHead h, string first) {
  return "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n"
       + "<meta http-equiv=\"Content-Security-Policy\" content=\"" + policy() + "\">\n"
       + "<meta name=\"viewport\" content=\"" + VIEWPORT + "\">\n"
       + "<title>" + textSafe(h.title) + "</title>\n"
       + (h.description == "" ? "" : "<meta name=\"description\" content=\"" + attrSafe(h.description) + "\">\n")
       + (h.canonical == "" ? "" : "<link rel=\"canonical\" href=\"" + attrSafe(h.canonical) + "\">\n")
       + "</head>\n<body>\n"
       // **The first frame comes before the module**, which is most of the file: the browser paints what it has parsed,
       // so the reader sees the page while the rest arrives. A page at a route says which (`wacSiteBase`).
       + "<div id=\"app\"" + (h.route == "/" ? "" : " data-wac-route=\"" + attrSafe(h.route) + "\"")
       + (first == "" ? "></div>\n" : " data-wac-pre>" + first + "</div>\n<script>" + earlyScript() + "</script>\n");
}

/** Text as it may sit in an element: nothing in it read as markup. */
string textSafe(string s) {
  string out = "";
  u8[] b = s.toBytes();
  i32 from = 0;
  for (i32 i = 0; i < b.len(); i++) {
    string esc = b[i] == '&' ? "&amp;" : (b[i] == '<' ? "&lt;" : (b[i] == '>' ? "&gt;" : ""));
    if (esc != "") { out = out + string.fromBytes(bytesIn(b, from, i)) + esc; from = i + 1; }
  }
  return out + string.fromBytes(bytesIn(b, from, b.len()));
}

/**
 * **What the reader does before the program is listening** — on a first frame drawn ahead of time, which looks ready
 * while its module is still on the way: each click, key and edit on it kept, for the host to hand the program once its
 * first batch has put its listeners in place (`documentSide`'s `replay`). The page's second inline script, allowed by
 * its hash as the loader is (`earlyHash`); change it and the hash changes with it.
 */
export string earlyScript() {
  return "window.wacEarly = []; "
       + "for (const k of [\"click\", \"dblclick\", \"keydown\", \"keyup\", \"input\", \"change\", \"submit\"]) "
       + "document.getElementById(\"app\").addEventListener(k, (e) => { if (window.wacEarly) window.wacEarly.push(e); }, true);";
}

/** `earlyScript`'s SHA-256, base64 — what the policy allows it by. */
export string earlyHash() { return "GtRCwmcBFFLpZHUUCg6p7zDxfxAyVr6T1pO6dEBweSU="; }

/**
 * **A page in three steps, and the two that spawn nothing are steps of their own** — for a builder that may not start
 * a process (a sealed machine, as reckon's): `writePageModule` writes `<out>/page.wac`; `wac build <out>/page.wac -o
 * <out>/page` is run by whoever builds, as its own sealed step; and `wrapBuiltPage` wraps `<out>/page.wasm` into
 * `index.html` (and the app's files, with `--app`). On the command line they are `--module-only` and `--wrap`, with
 * the same arguments as the whole build; `buildPage` is all three, which is what it always was.
 */
export i32 writePageModule(string[] argv, Output err, Output out, Files fs) {
  Asked a = askedOf(argv);
  if (a.entry == "" || a.out == "") { return usage(err); }
  // **The page's module is a module of this project**, so it is written inside it: from anywhere else its
  // imports would cross a project boundary, and the build would fail naming an import rather than this.
  if (leavesHere(a.out)) {
    err.write("build.wac: \{a.out}: the output directory must be inside this directory, since the page's module is written there and imports the program\n".toBytes());
    return 2;
  }
  string made = madeDir(fs, a.out);
  if (made != "") { err.line("build.wac: \{made}"); return 1; }
  // A path names the file from here, and the module sits in `out`; anything else is a mapped name.
  bool pagePath = a.pageSpec.len() > 0 && (a.pageSpec.slice(0, 1) == "." || a.pageSpec.slice(0, 1) == "/");
  string pageSpec = pagePath ? relativeTo(a.out, a.pageSpec) : a.pageSpec;
  string entrySpec = relativeTo(a.out, a.entry);
  string wrote = written(fs, a.out + "/page.wac", moduleFor(entrySpec, pageSpec, a.spawn, a.dev, framesOf(fs, a.entry)).toBytes());
  if (wrote != "") { err.line("build.wac: \{wrote}"); return 1; }
  return 0;
}

/** Whether `entry` declares its first frames (`declaresFrames`); an entry that cannot be read declares none. */
bool framesOf(Files fs, string entry) {
  u8[]? source = flatten(fs.readFile(entry).wait()).ok();
  return source is not null && declaresFrames(string.fromBytes(source!));
}

/**
 * **The first frames drawn**, by the module built at `<out>/page.wasm` run with no page: how many it has, then each,
 * in a run of its own so nothing one leaves behind reaches the next — and what goes in `#app` written to
 * `<out>/first.html` (`framesHtml`). It starts processes, so a builder in steps runs it as a step of its own (`--draw`).
 */
export i32 drawPageFrames(string[] argv, Output err, Output out, Files fs, Procs procs) {
  Asked a = askedOf(argv);
  if (a.entry == "" || a.out == "") { return usage(err); }
  if (!framesOf(fs, a.entry)) { return 0; }
  string wasm = a.out + "/page.wasm";
  auto counted = ran(procs, a.wac, [wasm, "--frames"], err);
  if (counted is null) { return 1; }
  string listed = string.fromBytes(counted!);
  i32 n = numberOf(lineOf(listed, 0));
  if (n <= 0) { err.line("build.wac: \{a.entry} declares no frames: prerendered() is empty"); return 1; }
  // **The frames by page**: each path, in the order the program first names it, and the frames drawn for it.
  Vec<string> paths = Vec.create();
  string[] pathOf = string[].filled(n, "/");
  for (i32 k = 0; k < n; k++) {
    pathOf[k] = lineOf(listed, k + 1);
    bool seen = false;
    for (i32 i = 0; i < paths.len(); i++) { if (paths.get(i) == pathOf[k]) { seen = true; } }
    if (!seen) { paths.push(pathOf[k]); }
  }
  Vec<Routed> routes = Vec.create();
  for (i32 p = 0; p < paths.len(); p++) {
    Vec<string> media = Vec.create();
    Vec<string> markup = Vec.create();
    string title = "";
    string description = "";
    for (i32 k = 0; k < n; k++) {
      if (pathOf[k] != paths.get(p)) { continue; }
      auto drawn = ran(procs, a.wac, [wasm, "--frame", "\{k}"], err);
      if (drawn is null) { return 1; }
      string text = string.fromBytes(drawn!);
      media.push(lineOf(text, 0));
      // A page's title and description are its first frame's: what a reader whose window matches no query sees is
      // the same page, in another layout.
      if (media.len() == 1) { title = lineOf(text, 1); description = lineOf(text, 2); }
      markup.push(afterLines(text, 3));
    }
    routes.push(Routed(paths.get(p), title, description, framesHtml(media.toArray(), markup.toArray())));
  }
  string wrote = written(fs, a.out + "/frames.txt", framesFileOf(routes.toArray()));
  if (wrote != "") { err.line("build.wac: \{wrote}"); return 1; }
  return 0;
}

/** **One page of a site, drawn**: its path, its title and description, and what goes in its `#app` (`framesHtml`). */
export struct Routed {
  string path;
  string title;
  string description;
  string html;
}

/**
 * `<out>/frames.txt`: what `drawPageFrames` drew, for `--wrap` to read — a first line naming the format, then each page:
 * its path, title and description a line each, its HTML's length in bytes on a line, then that HTML.
 */
export u8[] framesFileOf(Routed[] routes) {
  Buf out = Buf.create();
  out.pushStr("wac-frames 1\n");
  for (Routed r in routes) {
    u8[] html = r.html.toBytes();
    out.pushStr(r.path + "\n" + r.title + "\n" + r.description + "\n" + "\{html.len()}\n");
    out.pushAll(html);
  }
  return out.bytes();
}

/** What `framesFileOf` wrote, read back; null if it is not that. */
export Routed[]? routesOf(u8[] file) {
  Vec<Routed> out = Vec.create();
  i32 at = 0;
  string first = byteLine(file, at);
  if (first != "wac-frames 1") { return null; }
  at = at + first.toBytes().len() + 1;
  while (at < file.len()) {
    string[] fields = string[].filled(4, "");
    for (i32 i = 0; i < 4; i++) {
      fields[i] = byteLine(file, at);
      at = at + fields[i].toBytes().len() + 1;
      if (at > file.len()) { return null; }
    }
    i32 length = numberOf(fields[3]);
    if (length < 0 || at + length > file.len()) { return null; }
    out.push(Routed(fields[0], fields[1], fields[2], string.fromBytes(bytesIn(file, at, at + length))));
    at = at + length;
  }
  return out.toArray();
}

/** `bytes` from `from` up to `to`. */
u8[] bytesIn(u8[] bytes, i32 from, i32 to) {
  u8[] out = u8[].filled(to - from, 0 as u8);
  for (i32 i = from; i < to; i++) { out[i - from] = bytes[i]; }
  return out;
}

/** A run of decimal digits as a number; -1 for anything else. */
i32 numberOf(string s) {
  u8[] b = s.toBytes();
  if (b.len() == 0 || b.len() > 9) { return 0 - 1; }
  i32 n = 0;
  for (u8 c in b) {
    if (c < '0' || c > '9') { return 0 - 1; }
    n = n * 10 + ((c - '0') as i32);
  }
  return n;
}

/** The line of `bytes` starting at `at`, without its line break. */
string byteLine(u8[] bytes, i32 at) {
  i32 end = at;
  while (end < bytes.len() && bytes[end] != '\n') { end++; }
  return string.fromBytes(bytesIn(bytes, at, end));
}

/** The `k`th line of `text`, from 0, without its line break: `""` past the last. */
string lineOf(string text, i32 k) {
  string rest = text;
  for (i32 i = 0; i < k; i++) {
    i32 nl = rest.indexOf("\n");
    if (nl < 0) { return ""; }
    rest = rest.slice(nl + 1, rest.len());
  }
  i32 nl = rest.indexOf("\n");
  return nl < 0 ? rest : rest.slice(0, nl);
}

/** What follows `text`'s first `k` lines. */
string afterLines(string text, i32 k) {
  string rest = text;
  for (i32 i = 0; i < k; i++) {
    i32 nl = rest.indexOf("\n");
    if (nl < 0) { return ""; }
    rest = rest.slice(nl + 1, rest.len());
  }
  return rest;
}

/** The way from a page at `path` back to its site's root: `../` for each folder, `""` at the root. */
export string upFrom(string path) {
  string out = "";
  string rest = path;
  while (rest.len() > 0) {
    i32 cut = rest.indexOf("/");
    string part = cut < 0 ? rest : rest.slice(0, cut);
    if (part != "") { out = out + "../"; }
    rest = cut < 0 ? "" : rest.slice(cut + 1, rest.len());
  }
  return out;
}

/** The sitemap naming every page, each at `site` (`--site-url`) and its path. */
export string sitemapOf(string site, Routed[] routes) {
  string out = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n";
  for (Routed r in routes) { out = out + "  <url><loc>" + textSafe(siteRoot(site) + r.path) + "</loc></url>\n"; }
  return out + "</urlset>\n";
}

/** `--site-url` without the `/` it may end in, so a path can follow it. */
string siteRoot(string site) {
  return site.len() > 0 && site.slice(site.len() - 1, site.len()) == "/" ? site.slice(0, site.len() - 1) : site;
}

/** What `wac <args>` wrote, or null — having said why — when it failed. */
u8[]? ran(Procs procs, string wac, string[] args, Output err) {
  auto r = flatten(procs.exec(wac, args, u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? e = r.ok();
  if (e is not null && e!.ok()) { return e!.stdout; }
  if (e is not null) {
    err.write(e!.stderr);
    err.write(e!.stdout);
  }
  err.line("build.wac: drawing the first frames: \{wac} \{args[0]} \{args[1]}" + (r.isErr() ? ": \{r.err()!}" : ""));
  return null;
}

/** The page around a module already built at `<out>/page.wasm`: `index.html`, and with `--app` the app's files. */
export i32 wrapBuiltPage(string[] argv, Output err, Output out, Files fs) {
  Asked a = askedOf(argv);
  if (a.entry == "" || a.out == "") { return usage(err); }
  string wasmPath = a.out + "/page.wasm";
  auto wasmRead = flatten(fs.readFile(wasmPath).wait());
  u8[]? wasm = wasmRead.ok();
  if ((wasm is null)) {
    err.write("build.wac: \{wasmPath}: \{wasmRead.isErr() ? "\{wasmRead.err()!}" : ""}\n".toBytes());
    return 1;
  }
  // **The pages, when the entry declares its first frames**: what `drawPageFrames` wrote to `<out>/frames.txt` — in
  // `buildPage`, or in its own step (`--draw`) for a builder in steps, between building the module and `--wrap`. One
  // page otherwise, at the site's root, with nothing drawn ahead of time.
  Routed[] routes = [Routed("/", "", "", "")];
  if (framesOf(fs, a.entry)) {
    string framesPath = a.out + "/frames.txt";
    auto framesRead = flatten(fs.readFile(framesPath).wait());
    if (framesRead.isErr()) {
      err.write("build.wac: \{framesPath}: \{framesRead.err()!} — \{a.entry} declares its first frames, which --draw writes there\n".toBytes());
      return 1;
    }
    Routed[]? read = routesOf(framesRead.ok()!);
    if (read is null) { err.line("build.wac: \{framesPath} is not what --draw writes"); return 1; }
    routes = read!;
  }
  // Built with `--module-file`, the module is the one `page.wasm` at the site's root, named by its version, which
  // every page fetches: one download however many pages a reader opens.
  string version = a.moduleFile ? versionOf(wasm!) : "";
  string encoded = a.moduleFile ? "" : base64(wasm!);
  if (a.appIcon != "") {
    auto icon = flatten(fs.readFile(a.appIcon).wait());
    if (icon.isErr()) {
      err.write("build.wac: \{a.appIcon}: \{icon.err()!}\n".toBytes());
      return 1;
    }
    string[] names = [a.out + "/" + APP_ICON, a.out + "/manifest.webmanifest", a.out + "/" + APP_WORKER];
    u8[][] bodies = [icon.ok()!, manifestOf(a.title, a.appColor).toBytes(), serviceWorker().toBytes()];
    for (i32 i = 0; i < names.len(); i++) {
      string wrote = written(fs, names[i], bodies[i]);
      if (wrote != "") { err.line("build.wac: \{wrote}"); return 1; }
    }
  }
  for (Routed r in routes) {
    string up = upFrom(r.path);
    string url = a.moduleFile ? up + "page.wasm?v=" + version : "";
    // The program's own title for its page, if it gave one in its first turn; the build's otherwise.
    PageHead h = PageHead(r.title != "" ? r.title : a.title, r.description, r.path, a.siteUrl == "" ? "" : siteRoot(a.siteUrl) + r.path);
    string page = a.inPage ? inPageIndexFor(h, r.html, encoded, a.grants, url) : workerIndexFor(h, r.html, encoded, a.grants, url);
    if (a.edge) { page = edgeToEdge(page); }
    if (a.appIcon != "") { page = asApp(page, a.appColor, a.edge, up); }
    string dir = a.out + (r.path == "/" ? "" : r.path);
    if (r.path != "/") {
      string made = madeDir(fs, dir);
      if (made != "") { err.line("build.wac: \{made}"); return 1; }
    }
    // **Said only once it is so.** This ignored what the write answered and printed the line below either way, so a
    // builder whose disk refused `index.html` was told it had one — 100 KB lost to a line that said otherwise.
    string index = (r.path == "/" ? a.out + "/" : dir) + "index.html";
    string wrote = written(fs, index, page.toBytes());
    if (wrote != "") { err.line("build.wac: \{wrote}"); return 1; }
  }
  if (a.siteUrl != "") {
    string wrote = written(fs, a.out + "/sitemap.xml", sitemapOf(a.siteUrl, routes).toBytes());
    if (wrote != "") { err.line("build.wac: \{wrote}"); return 1; }
  }
  out.line("\{a.out}/index.html" + (routes.len() > 1 ? " and \{routes.len() - 1} page(s) more" : "") + ": \{wasm!.len()} bytes of module"
           + (a.moduleFile ? ", in page.wasm beside it" : ""));
  return 0;
}

/** `bytes` written to `path`: `""` once it is, or the path and the host's reason when it is not. */
string written(Files fs, string path, u8[] bytes) {
  auto w = flatten(fs.writeFile(path, bytes).wait());
  return w.isErr() ? "\{path}: \{w.err()!}" : "";
}

/** `dir` made, with what it is under: `""` once it is there, or why not. */
string madeDir(Files fs, string dir) {
  auto m = flatten(fs.mkdir(dir, true).wait());
  return m.isErr() ? "\{dir}: \{m.err()!}" : "";
}

i32 usage(Output err) {
  err.write("usage: build.wac <entry.wac> <out-dir> [--module-only | --draw | --wrap] [--in-page] [--dev] [--edge] [--module-file] [--site-url <url>] [--app <icon.png> [--app-color <#rgb>]] [--grant read,write] [--spawn <export>] [--title <t>] [--wac <binary>] [--page <spec>]\n".toBytes());
  return 2;
}

export i32 buildPage(string[] argv, Output err, Output out, Files fs, Procs procs) {
  bool moduleOnly = false;
  bool wrapOnly = false;
  bool drawOnly = false;
  for (string w in argv) {
    if (w == "--module-only") { moduleOnly = true; }
    if (w == "--wrap") { wrapOnly = true; }
    if (w == "--draw") { drawOnly = true; }
  }
  i32 steps = 0;
  if (moduleOnly) { steps++; }
  if (wrapOnly) { steps++; }
  if (drawOnly) { steps++; }
  if (steps > 1) {
    err.write("build.wac: --module-only, --draw and --wrap are steps of a build; ask for one\n".toBytes());
    return 2;
  }
  if (wrapOnly) { return wrapBuiltPage(argv, err, out, fs); }
  if (drawOnly) { return drawPageFrames(argv, err, out, fs, procs); }
  i32 wrote = writePageModule(argv, err, out, fs);
  if (wrote != 0 || moduleOnly) { return wrote; }
  Asked a = askedOf(argv);
  string source = a.out + "/page.wac";
  auto builtRan = flatten(procs.exec(a.wac, ["build", source, "-o", a.out + "/page"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? built = builtRan.ok();
  if (built is null || !built!.ok()) {
    if (built is not null) {
      err.write(built!.stderr);
      err.write(built!.stdout);
    }
    if (builtRan.isErr()) { flatten(err.write("build.wac: \{a.wac}: \{builtRan.err()!}\n".toBytes()).wait()).isOk(); }
    return 1;
  }
  i32 drew = drawPageFrames(argv, err, out, fs, procs);
  if (drew != 0) { return drew; }
  return wrapBuiltPage(argv, err, out, fs);
}

export i32 main(Sys sys) { return buildPage(sys.args(), sys.stderr(), sys.stdout(), sys.files(), sys.procs()); }
