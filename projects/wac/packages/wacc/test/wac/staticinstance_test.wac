// A reference-typed `static` in a generic struct's method is one value for every instance of the struct.
//
//     wac test --allow-read --allow-write --allow-run --allow-env packages/wacc/test/wac/staticinstance_test.wac
//
// `issues/lang/0374a`, its first half: `Box<T>.shared()` uses none of its owner's letters, so the emitter makes it the
// instance `Box.shared`, and its `static Cell c` is hoisted to the module as every such static is. The instance's
// verdict was taken before `assignGlobals` gave the hoisted static its global, so it read as a constant with no storage
// and the instance — and with it `main` — was declined. The second half, a static in a method with letters of its own
// (`mine<U>`), is a static per instantiation, needs a global per instance, and is still open in the issue.

import { T } from "../../../wactest/src/assert.wac";
import { Sys } from "std";
import { Ran, runEmittedOne, scratchDir } from "./artifacts_probe.wac";

static string CELL = "struct Cell { i32 n; }\n";

Ran ran(Sys sys, string src, string name) {
  return runEmittedOne(sys.env(), sys.files(), sys.procs(), "/t/s.wac", src, scratchDir(sys.env(), sys.files()), name);
}

export string test_a_static_in_a_generic_structs_method_is_one_value(Sys sys) {
  T t = T.create();
  string src = CELL + "struct Box<T> {\n  T v;\n  const Cell shared() { static Cell c = Cell(0); return c; }\n}\n"
    + "export i32 main() { return Box<i32>.shared() is Box<string>.shared() ? 42 : 43; }\n";
  Ran r = ran(sys, src, "staticinstance.wasm");
  t.isTrue(r.ok, "built and ran — " + r.error + r.stderr);
  // 42 and 43 rather than 1 and 0: a module whose `main` was declined also exits 1.
  t.eqI32(r.status, 42, "`Box<i32>.shared()` and `Box<string>.shared()` answer the one object");
  return t.report();
}

export string test_the_same_static_in_a_plain_struct_is_unchanged(Sys sys) {
  T t = T.create();
  string src = CELL + "struct Plain {\n  i32 v;\n  const Cell shared() { static Cell c = Cell(0); return c; }\n}\n"
    + "export i32 main() { return Plain.shared() is Plain.shared() ? 42 : 43; }\n";
  Ran r = ran(sys, src, "staticplain.wasm");
  t.isTrue(r.ok, "built and ran — " + r.error + r.stderr);
  t.eqI32(r.status, 42, "one object");
  return t.report();
}

export string test_a_static_in_a_method_with_letters_of_its_own_is_one_value_per_instantiation(Sys sys) {
  T t = T.create();
  string src = CELL + "struct Box<T> {\n  T v;\n  const Cell mine<U>(this, U x) { static Cell c = Cell(0); return c; }\n}\n"
    + "export i32 main() {\n  Box<i32> b = Box(1);\n"
    + "  bool same = b.mine(1 as i32) is b.mine(2 as i32);\n"
    + "  bool apart = b.mine(1 as i32) is b.mine(\"x\");\n"
    + "  return 40 + (same ? 1 : 0) + (apart ? 10 : 0);\n}\n";
  Ran r = ran(sys, src, "staticmine.wasm");
  t.isTrue(r.ok, "built and ran — " + r.error + r.stderr);
  t.eqI32(r.status, 41, "one object for `mine<i32>` however often it runs, and another for `mine<string>`");
  return t.report();
}

export string test_an_instance_static_whose_initialiser_names_the_instances_letters(Sys sys) {
  T t = T.create();
  // `U[]()` is a different array type per instantiation, so its initialiser is written with the instance's letters in
  // force and its type registered while the instances are discovered.
  string src = "struct Box<T> {\n  T v;\n"
    + "  i32 count<U>(this, U x) { static U[] all = U[](); return all.len(); }\n}\n"
    + "export i32 main() { Box<i32> b = Box(1); return b.count(5 as i32) + b.count(\"x\") + 40; }\n";
  Ran r = ran(sys, src, "staticletters.wasm");
  t.isTrue(r.ok, "built and ran — " + r.error + r.stderr);
  t.eqI32(r.status, 40, "both instances' arrays exist, and are empty");
  return t.report();
}
