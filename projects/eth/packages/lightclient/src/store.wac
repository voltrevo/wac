// The Altair light client sync protocol: a store, and the rules for advancing it.
//
// A light client follows the beacon chain without downloading it. It holds a sync committee it
// trusts, and each update carries a header, a signature from that committee, and Merkle branches
// proving the header's state contains the *next* committee and a finalized checkpoint. Believing an
// update means checking the signature and the branches; believing a *chain* of them means the period
// rules below, which are what stop a client being walked onto a fork.
//
// Structured as the spec is, function for function, because the spec is the specification of a
// consensus protocol and a paraphrase of it is a different protocol. Where this departs — storing
// serialized objects rather than parsed ones — it is noted.
//
// ## Objects are kept serialized
//
// `Store` holds SSZ bytes and reads fields out of them with `packages/ssz` when needed. wac has no
// generic containers, so the alternative is a struct per beacon type and a parser per struct, which
// is the thing `packages/ssz`'s descriptor table exists to avoid. The cost is re-parsing on access;
// the benefit is that there is exactly one definition of every layout, and it is checked against
// Ethereum's vectors.
//
// ## Configuration
//
// Minimal, because Ethereum's sync-protocol vectors exist only for it. `SLOTS_PER_EPOCH` 8 and
// `EPOCHS_PER_SYNC_COMMITTEE_PERIOD` 8 give a 64-slot period, and `UPDATE_TIMEOUT` is the same 64.
// Mainnet is 32 and 256, so a period is 8192 slots — the arithmetic is identical and only these
// three numbers move.

import { TY_LIGHT_CLIENT_UPDATE, TY_LIGHT_CLIENT_BOOTSTRAP, TY_LIGHT_CLIENT_FINALITY_UPDATE, TY_LIGHT_CLIENT_OPTIMISTIC_UPDATE, TY_SYNC_COMMITTEE, TY_SYNC_AGGREGATE,
         SYNC_COMMITTEE_SIZE_MINIMAL } from "../../ssz/src/beacon.wac";
import { lightClientTypes, lightClientFields, ALTAIR, CAPELLA, DENEB, ELECTRA, FULU, GLOAS, finalizedRootGindex,
         currentSyncCommitteeGindex, nextSyncCommitteeGindex, FT_BEACON_BLOCK_HEADER, syncCommitteeBranchDepth,
         finalityBranchDepth } from "../../ssz/src/forks.wac";
import { fieldBytes, fieldRoot, hashTreeRoot } from "../../ssz/src/container.wac";
import { isEmptyHeader } from "./header.wac";
import { Schedule } from "./schedule.wac";
import { isValidHeaderAt, upgradeHeader, upgradeUpdate, upgradeBootstrap, fieldsOfN, serializeN } from "./upgrade.wac";
import { isValidNormalizedMerkleBranch } from "../../ssz/src/merkle.wac";
import { CommitteeKeys, committeeKeys, keysAre, verifyParticipants } from "./keys.wac";
import { syncCommitteeSigningRoot } from "./domain.wac";

/** Slots per sync committee period, minimal config: SLOTS_PER_EPOCH 8 x EPOCHS_PER_PERIOD 8. */
export static i64 SLOTS_PER_SYNC_COMMITTEE_PERIOD = 64;
/** `Slot(SLOTS_PER_EPOCH * EPOCHS_PER_SYNC_COMMITTEE_PERIOD)`. */
export static i64 UPDATE_TIMEOUT = 64;
export static i32 MIN_SYNC_COMMITTEE_PARTICIPANTS = 1;

// Generalized indices move by fork (Electra, then Gloas): `finalizedRootGindex` and its siblings in
// `ssz/src/forks.wac`. The type indices below are the same in every fork's table, which is why the Altair
// `TY_*` names still serve.

// Field indices, from `packages/ssz`'s `beaconFields`.
static i32 UPDATE_ATTESTED_HEADER = 0;
static i32 UPDATE_NEXT_SYNC_COMMITTEE = 1;
static i32 UPDATE_NEXT_SYNC_COMMITTEE_BRANCH = 2;
static i32 UPDATE_FINALIZED_HEADER = 3;
static i32 UPDATE_FINALITY_BRANCH = 4;
static i32 UPDATE_SYNC_AGGREGATE = 5;
static i32 UPDATE_SIGNATURE_SLOT = 6;
static i32 BOOTSTRAP_HEADER = 0;
static i32 BOOTSTRAP_CURRENT_SYNC_COMMITTEE = 1;
static i32 BOOTSTRAP_CURRENT_SYNC_COMMITTEE_BRANCH = 2;
static i32 HEADER_BEACON = 0;
static i32 BEACON_SLOT = 0;
static i32 BEACON_STATE_ROOT = 3;
static i32 AGGREGATE_BITS = 0;
static i32 AGGREGATE_SIGNATURE = 1;
static i32 COMMITTEE_PUBKEYS = 0;

/**
 * The client's whole state.
 *
 * `nextSyncCommittee` and `bestValidUpdate` are empty when absent — the spec's `SyncCommittee()` and
 * `None`. An empty array and an all-zero one are different things here and the distinction matters:
 * an update legitimately carries an all-zero `next_sync_committee` to mean "none supplied", which is
 * why `isZero` exists rather than a length check.
 */
export struct Store {
  u8[] finalizedHeader;
  u8[] currentSyncCommittee;
  u8[] nextSyncCommittee;
  u8[] bestValidUpdate;
  u8[] optimisticHeader;
  i32 previousMaxActiveParticipants;
  i32 currentMaxActiveParticipants;
  /**
   * The fork every header and update this store reads is laid out in. One per store: a store does not
   * cross a fork boundary yet (`upgrade_lc_store_to_*` is not written), so the `*_store_with_legacy_data`
   * vectors are not run.
   */
  i32 fork;
  /** When each fork begins: what a header's own epoch, a branch's gindex and a signature's version go by. */
  Schedule schedule;
  /**
   * The keys of the committees this store has checked signatures with, decompressed and checked once (`keys.wac`):
   * at most the two most recent, which are the current and the next committee. Not part of what the store believes,
   * only a cache of work: a store made without it (an empty list) checks the same signatures the same way.
   */
  CommitteeKeys[] keys;
}

u8[] field(i32 fork, i32 n, i32 ty, u8[] data, i32 f) {
  return fieldBytes(lightClientTypes(fork, n), lightClientFields(fork), ty, data, f);
}

u8[] rootOf(i32 fork, i32 n, i32 ty, u8[] data, i32 f) {
  u8[]? r = fieldRoot(lightClientTypes(fork, n), lightClientFields(fork), ty, data, f);
  return (r is null) ? u8[]() : r!;
}

/** Whether every byte is zero — how the spec's `== SyncCommittee()` and `== FinalityBranch()` read. */
export bool isZero(u8[] b) {
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] != 0) { return false; }
  }
  return true;
}

/** A little-endian uint64 field as a slot. −1 when the field is not eight bytes. */
i64 readSlot(u8[] b) {
  if (b.len() != 8) { return -1; }
  i64 v = 0;
  for (i32 i = 7; i >= 0; i--) { v = (v << 8) | (b[i] as i64); }
  return v;
}

/** `compute_sync_committee_period_at_slot`. */
export i64 syncCommitteePeriodAtSlot(i64 slot) { return slot / SLOTS_PER_SYNC_COMMITTEE_PERIOD; }

i64 periodIn(i64 slotsPerPeriod, i64 slot) { return slot / slotsPerPeriod; }

// ── Reading the pieces of an update ───────────────────────────────────────────

// Each in the fork's layout (`…At`), and as Altair's under the original names.
export u8[] updateAttestedHeaderAt(i32 k, i32 n, u8[] u) { return field(k, n, TY_LIGHT_CLIENT_UPDATE(), u, UPDATE_ATTESTED_HEADER); }
export u8[] updateFinalizedHeaderAt(i32 k, i32 n, u8[] u) { return field(k, n, TY_LIGHT_CLIENT_UPDATE(), u, UPDATE_FINALIZED_HEADER); }
export u8[] updateNextSyncCommitteeAt(i32 k, i32 n, u8[] u) { return field(k, n, TY_LIGHT_CLIENT_UPDATE(), u, UPDATE_NEXT_SYNC_COMMITTEE); }
export u8[] updateNextSyncCommitteeBranchAt(i32 k, i32 n, u8[] u) { return field(k, n, TY_LIGHT_CLIENT_UPDATE(), u, UPDATE_NEXT_SYNC_COMMITTEE_BRANCH); }
export u8[] updateFinalityBranchAt(i32 k, i32 n, u8[] u) { return field(k, n, TY_LIGHT_CLIENT_UPDATE(), u, UPDATE_FINALITY_BRANCH); }
export u8[] updateSyncAggregateAt(i32 k, i32 n, u8[] u) { return field(k, n, TY_LIGHT_CLIENT_UPDATE(), u, UPDATE_SYNC_AGGREGATE); }
export i64 updateSignatureSlotAt(i32 k, i32 n, u8[] u) { return readSlot(field(k, n, TY_LIGHT_CLIENT_UPDATE(), u, UPDATE_SIGNATURE_SLOT)); }
export u8[] updateAttestedHeader(u8[] u) { return updateAttestedHeaderAt(ALTAIR(), SYNC_COMMITTEE_SIZE_MINIMAL, u); }
export u8[] updateFinalizedHeader(u8[] u) { return updateFinalizedHeaderAt(ALTAIR(), SYNC_COMMITTEE_SIZE_MINIMAL, u); }
export u8[] updateNextSyncCommittee(u8[] u) { return updateNextSyncCommitteeAt(ALTAIR(), SYNC_COMMITTEE_SIZE_MINIMAL, u); }
export u8[] updateNextSyncCommitteeBranch(u8[] u) { return updateNextSyncCommitteeBranchAt(ALTAIR(), SYNC_COMMITTEE_SIZE_MINIMAL, u); }
export u8[] updateFinalityBranch(u8[] u) { return updateFinalityBranchAt(ALTAIR(), SYNC_COMMITTEE_SIZE_MINIMAL, u); }
export u8[] updateSyncAggregate(u8[] u) { return updateSyncAggregateAt(ALTAIR(), SYNC_COMMITTEE_SIZE_MINIMAL, u); }
export i64 updateSignatureSlot(u8[] u) { return updateSignatureSlotAt(ALTAIR(), SYNC_COMMITTEE_SIZE_MINIMAL, u); }

/**
 * The `BeaconBlockHeader` a `LightClientHeader` starts with. It is the first field in every fork and fixed-size
 * (112 bytes), so it sits at the front whatever follows; empty when there are not 112 bytes.
 */
u8[] beaconOf(u8[] header) {
  if (header.len() < 112) { return u8[](); }
  u8[] b = u8[].filled(112, 0);
  b.copyFrom(header, 0, 0, 112);
  return b;
}

/** The beacon slot inside a `LightClientHeader`. */
export i64 headerSlot(u8[] header) {
  u8[] beacon = beaconOf(header);
  if (beacon.len() == 0) { return -1; }
  return readSlot(field(ALTAIR(), SYNC_COMMITTEE_SIZE_MINIMAL, FT_BEACON_BLOCK_HEADER(), beacon, BEACON_SLOT));
}

/** `hash_tree_root(header.beacon)` — what a finality branch proves and what a signature covers. */
export u8[] headerBeaconRoot(u8[] header) {
  u8[] beacon = beaconOf(header);
  if (beacon.len() == 0) { return u8[](); }
  u8[]? r = hashTreeRoot(lightClientTypes(ALTAIR(), SYNC_COMMITTEE_SIZE_MINIMAL), lightClientFields(ALTAIR()),
                         FT_BEACON_BLOCK_HEADER(), beacon);
  return r is null ? u8[]() : r!;
}

/** `header.beacon.state_root` — the root the update's branches are verified against. */
export u8[] headerStateRoot(u8[] header) {
  u8[] beacon = beaconOf(header);
  if (beacon.len() == 0) { return u8[](); }
  return field(ALTAIR(), SYNC_COMMITTEE_SIZE_MINIMAL, FT_BEACON_BLOCK_HEADER(), beacon, BEACON_STATE_ROOT);
}

/** `1 << k` as an i32. `1 << (k as@ u32)` is a u32 and will not meet a `u8[]` element. */
i32 maskFor(i32 k) {
  i32 m = 1;
  for (i32 i = 0; i < k; i++) { m = m * 2; }
  return m;
}

/** How many committee members signed. */
export i32 countBits(u8[] bits) {
  i32 n = 0;
  for (i32 i = 0; i < bits.len() * 8; i++) {
    if ((bits[i >> 3] as i32 & maskFor(i & 7)) != 0) { n = n + 1; }
  }
  return n;
}

/** `is_sync_committee_update` / `is_finality_update`: the branch is present rather than all zeros. */
export bool isSyncCommitteeUpdateAt(i32 k, i32 n, u8[] u) { return !isZero(updateNextSyncCommitteeBranchAt(k, n, u)); }
export bool isFinalityUpdateAt(i32 k, i32 n, u8[] u) { return !isZero(updateFinalityBranchAt(k, n, u)); }
export bool isSyncCommitteeUpdate(u8[] u) { return isSyncCommitteeUpdateAt(ALTAIR(), SYNC_COMMITTEE_SIZE_MINIMAL, u); }
export bool isFinalityUpdate(u8[] u) { return isFinalityUpdateAt(ALTAIR(), SYNC_COMMITTEE_SIZE_MINIMAL, u); }
export bool isNextSyncCommitteeKnown(Store s) {
  return s.nextSyncCommittee.len() > 0 && !isZero(s.nextSyncCommittee);
}

/**
 * Two thirds of the committee — what finality requires, as opposed to what the optimistic header
 * requires.
 *
 * Named rather than written inline at its two use sites because the two thresholds in this file are
 * the security boundary of the whole protocol, and weakening either one is invisible against
 * Ethereum's sync vectors: every update in them is signed by nearly the whole committee, so `>= 2/3`
 * and `>= 1/3` accept exactly the same set. `test/sync_wac.test.ts` pins them directly for that
 * reason.
 */
export bool hasSupermajority(u8[] bits, i32 active) { return active * 3 >= bits.len() * 8 * 2; }

/** `get_safety_threshold` — half the best participation seen in this period or the last. */
export i32 safetyThreshold(Store s) {
  i32 m = (s.previousMaxActiveParticipants > s.currentMaxActiveParticipants)
    ? s.previousMaxActiveParticipants : s.currentMaxActiveParticipants;
  return m / 2;
}

// ── Initialisation ────────────────────────────────────────────────────────────

/**
 * `initialize_light_client_store` — trust one block root, and derive a committee from it.
 *
 * Everything the client later believes rests on this: the caller supplies a block root it trusts out
 * of band, and the bootstrap must both hash to it and prove that its committee is the one in that
 * block's state. Null if either fails, because a store built from an unproven committee would verify
 * signatures from whoever supplied it.
 */
export Store? initializeStore(u8[] trustedBlockRoot, u8[] bootstrap) { return initializeStoreAt(ALTAIR(), trustedBlockRoot, bootstrap); }

/** `initialize_light_client_store` for a bootstrap of `fork`, whose header must also be valid for it. */
export Store? initializeStoreAt(i32 fork, u8[] trustedBlockRoot, u8[] bootstrap) {
  return initializeStoreWith(Schedule.genesisTo(fork), fork, trustedBlockRoot, bootstrap);
}

/**
 * A store from a bootstrap in `layout`, under a chain's `schedule`. Upgrade it with `upgradeStore` to follow the chain
 * into a later fork.
 */
export Store? initializeStoreWith(Schedule schedule, i32 fork, u8[] trustedBlockRoot, u8[] bootstrap) {
  u8[] header = field(fork, schedule.size, TY_LIGHT_CLIENT_BOOTSTRAP(), bootstrap, BOOTSTRAP_HEADER);
  if (header.len() == 0) { return null; }
  if (!isValidHeaderAt(schedule, fork, header)) { return null; }
  u8[] beaconRoot = headerBeaconRoot(header);
  if (beaconRoot.len() != 32 || trustedBlockRoot.len() != 32) { return null; }
  for (i32 i = 0; i < 32; i++) {
    if (beaconRoot[i] != trustedBlockRoot[i]) { return null; }
  }
  u8[] committee = field(fork, schedule.size, TY_LIGHT_CLIENT_BOOTSTRAP(), bootstrap, BOOTSTRAP_CURRENT_SYNC_COMMITTEE);
  u8[] branch = field(fork, schedule.size, TY_LIGHT_CLIENT_BOOTSTRAP(), bootstrap, BOOTSTRAP_CURRENT_SYNC_COMMITTEE_BRANCH);
  u8[] leaf = rootOf(fork, schedule.size, TY_LIGHT_CLIENT_BOOTSTRAP(), bootstrap, BOOTSTRAP_CURRENT_SYNC_COMMITTEE);
  if (leaf.len() != 32) { return null; }
  i32 at = schedule.layoutAtSlot(headerSlot(header));
  if (!isValidNormalizedMerkleBranch(leaf, branch, currentSyncCommitteeGindex(at), headerStateRoot(header))) {
    return null;
  }
  return Store(header, committee, u8[](), u8[](), header, 0, 0, fork, schedule, CommitteeKeys[]());
}

/**
 * `upgrade_lc_store_to_*`, as far as `to`: the headers and the best update rewritten in the later layout. A store must
 * be upgraded before it can take the later fork's data; it may be upgraded early, and still takes older data, which
 * `processUpdateFrom` upgrades as it arrives.
 */
export void upgradeStore(Store store, i32 to) {
  if (to <= store.fork) { return; }
  store.finalizedHeader = upgradeHeader(store.fork, to, store.finalizedHeader);
  store.optimisticHeader = upgradeHeader(store.fork, to, store.optimisticHeader);
  if (store.bestValidUpdate.len() > 0) { store.bestValidUpdate = upgradeUpdate(store.fork, to, store.schedule.size, store.bestValidUpdate); }
  store.fork = to;
}

/** `process_light_client_update` for an update in `layout`: refused if newer than the store, upgraded if older. */
export bool processUpdateFrom(Store store, u8[] update, i32 layout, i64 currentSlot, u8[] genesisValidatorsRoot) {
  if (layout < 0 || layout > store.fork) { return false; }
  u8[] u = upgradeUpdate(layout, store.fork, store.schedule.size, update);
  if (u.len() == 0) { return false; }
  return processUpdate(store, u, currentSlot, genesisValidatorsRoot);
}

// ── Validation ────────────────────────────────────────────────────────────────

/**
 * `validate_light_client_update`. True if the update may be applied to this store.
 *
 * The order is the spec's, and the ordering is load-bearing in one place worth naming: participation
 * and the slot relations are checked *before* any signature, so a malformed update is rejected
 * without paying for a pairing. Everything here is supplied by an untrusted peer.
 *
 * ## Three of these checks cannot be observed from outside
 *
 * Deleting any one of them changes no verdict on any input, and `test/sync_wac.test.ts` says so
 * rather than pretending otherwise — each is subsumed by a later cryptographic check:
 *
 *   - `attested_slot >= finalized_slot` — a finalized header later than the attested one cannot be
 *     proven, because its branch is verified against the attested header's state root.
 *   - the signature-period window — a signature period outside it selects the wrong committee below,
 *     or an absent one, and the signature then fails.
 *   - `MIN_SYNC_COMMITTEE_PARTICIPANTS` — at 1 this rejects only an empty participant set, and
 *     `fastAggregateVerify` refuses an empty key list rather than verifying vacuously.
 *
 * They stay because each rejects for a few hundred nanoseconds what would otherwise cost a pairing,
 * and because the checks they lean on are in other packages: making this function's correctness
 * depend on `packages/bls` refusing an empty list is a coupling worth not having. But an unobservable
 * check is exactly the kind that rots unnoticed, so it is named here as one.
 */

export bool validateUpdate(Store store, u8[] update, i64 currentSlot, u8[] genesisValidatorsRoot) {
  i32 k = store.fork;
  i32 n = store.schedule.size;
  u8[] aggregate = updateSyncAggregateAt(k, n, update);
  u8[] bits = field(k, n, TY_SYNC_AGGREGATE(), aggregate, AGGREGATE_BITS);
  if (bits.len() == 0) { return false; }
  if (countBits(bits) < MIN_SYNC_COMMITTEE_PARTICIPANTS) { return false; }

  u8[] attested = updateAttestedHeaderAt(k, n, update);
  u8[] finalized = updateFinalizedHeaderAt(k, n, update);
  if (attested.len() == 0 || finalized.len() == 0) { return false; }
  if (!isValidHeaderAt(store.schedule, k, attested)) { return false; }
  i64 attestedSlot = headerSlot(attested);
  i64 finalizedSlot = headerSlot(finalized);
  i64 signatureSlot = updateSignatureSlotAt(k, n, update);
  if (attestedSlot < 0 || finalizedSlot < 0 || signatureSlot < 0) { return false; }

  // current_slot >= signature_slot > attested_slot >= finalized_slot, all four at once.
  if (!(currentSlot >= signatureSlot)) { return false; }
  if (!(signatureSlot > attestedSlot)) { return false; }
  if (!(attestedSlot >= finalizedSlot)) { return false; }

  i64 storeSlot = headerSlot(store.finalizedHeader);
  if (storeSlot < 0) { return false; }
  i64 storePeriod = store.schedule.periodAt(storeSlot);
  i64 signaturePeriod = store.schedule.periodAt(signatureSlot);
  bool nextKnown = isNextSyncCommitteeKnown(store);
  if (nextKnown) {
    if (signaturePeriod != storePeriod && signaturePeriod != storePeriod + 1) { return false; }
  } else {
    if (signaturePeriod != storePeriod) { return false; }
  }

  // Relevance: it must advance the finalized header, or supply the committee the store lacks.
  i64 attestedPeriod = store.schedule.periodAt(attestedSlot);
  bool hasNextCommittee = !nextKnown && isSyncCommitteeUpdateAt(k, n, update) && attestedPeriod == storePeriod;
  if (!(attestedSlot > storeSlot || hasNextCommittee)) { return false; }

  // The finality branch, when present, proves the finalized header against the attested state.
  if (!isFinalityUpdateAt(k, n, update)) {
    if (!isEmptyHeader(k, finalized)) { return false; }
  } else {
    u8[] finalizedRoot = u8[].filled(32, 0);          // the genesis checkpoint root is the zero hash
    if (finalizedSlot != 0) {
      if (!isValidHeaderAt(store.schedule, k, finalized)) { return false; }
      finalizedRoot = headerBeaconRoot(finalized);
      if (finalizedRoot.len() != 32) { return false; }
    } else {
      if (!isEmptyHeader(k, finalized)) { return false; }
    }
    if (!isValidNormalizedMerkleBranch(finalizedRoot, updateFinalityBranchAt(k, n, update),
                                       finalizedRootGindex(store.schedule.layoutAtSlot(attestedSlot)),
                                       headerStateRoot(attested))) {
      return false;
    }
  }

  // The next sync committee, when present, must match what the store already knows and be proven.
  u8[] nextCommittee = updateNextSyncCommitteeAt(k, n, update);
  if (!isSyncCommitteeUpdateAt(k, n, update)) {
    if (!isZero(nextCommittee)) { return false; }
  } else {
    if (attestedPeriod == storePeriod && nextKnown) {
      if (nextCommittee.len() != store.nextSyncCommittee.len()) { return false; }
      for (i32 i = 0; i < nextCommittee.len(); i++) {
        if (nextCommittee[i] != store.nextSyncCommittee[i]) { return false; }
      }
    }
    u8[] leaf = rootOf(k, n, TY_LIGHT_CLIENT_UPDATE(), update, UPDATE_NEXT_SYNC_COMMITTEE);
    if (leaf.len() != 32) { return false; }
    if (!isValidNormalizedMerkleBranch(leaf, updateNextSyncCommitteeBranchAt(k, n, update),
                                       nextSyncCommitteeGindex(store.schedule.layoutAtSlot(attestedSlot)),
                                       headerStateRoot(attested))) {
      return false;
    }
  }

  // Only now the signature, by whichever committee owns the signature period.
  u8[] committee = (signaturePeriod == storePeriod) ? store.currentSyncCommittee
                                                    : store.nextSyncCommittee;
  if (committee.len() == 0) { return false; }
  u8[] flat = field(k, n, TY_SYNC_COMMITTEE(), committee, COMMITTEE_PUBKEYS);
  if (flat.len() != n * 48) { return false; }

  u8[]? signingRoot = syncCommitteeSigningRoot(headerBeaconRoot(attested),
                                               signatureVersion(store, signatureSlot), genesisValidatorsRoot);
  if (signingRoot is null) { return false; }
  // FastAggregateVerify over every member whose bit is set, out of all `n` (with fewer than all signing, bounding a
  // loop by the participant count instead skips the last members: found on mainnet, at 511 of 512), from the
  // committee's keys decompressed once (`keys.wac`).
  return verifyParticipants(keysIn(store, flat, n), bits, n, signingRoot!,
                            field(k, n, TY_SYNC_AGGREGATE(), aggregate, AGGREGATE_SIGNATURE));
}

/** The keys of the committee `flat` is, from the store's cache, or decompressed now and kept (the two most recent). */
CommitteeKeys keysIn(Store store, u8[] flat, i32 n) {
  for (i32 i = 0; i < store.keys.len(); i++) { if (keysAre(store.keys[i], flat)) { return store.keys[i]; } }
  CommitteeKeys made = committeeKeys(flat, n);
  CommitteeKeys[] next = CommitteeKeys[].filled(store.keys.len() > 0 ? 2 : 1, made);
  if (store.keys.len() > 0) { next[1] = store.keys[0]; }
  store.keys = next;
  return made;
}

/** `compute_fork_version(compute_epoch_at_slot(max(signature_slot, 1) - 1))`: the fork the signed block's parent is in. */
u8[] signatureVersion(Store store, i64 signatureSlot) {
  i64 slot = signatureSlot > (1 as i64) ? signatureSlot - (1 as i64) : 0 as i64;
  return store.schedule.versionAt(slot / store.schedule.slotsPerEpoch);
}

// ── Choosing between updates ──────────────────────────────────────────────────

/**
 * `is_better_update` — the ordering the client uses to keep the best update it has seen.
 *
 * Six criteria in a fixed order, and the order is the whole content: supermajority participation
 * first, then a relevant sync committee, then any finality, then sync-committee finality, then raw
 * participation, then *older* data. Reordering them is a different protocol, so this reads as a
 * sequence of early returns matching the spec line for line rather than as a score.
 *
 * The last two tiebreakers prefer the *earlier* update, which is not an accident: it minimises how
 * often the best changes, and therefore how often a forced update moves the client.
 */
export bool isBetterUpdate(u8[] newUpdate, u8[] oldUpdate) {
  return isBetterUpdateAt(ALTAIR(), SYNC_COMMITTEE_SIZE_MINIMAL, SLOTS_PER_SYNC_COMMITTEE_PERIOD, newUpdate, oldUpdate);
}

/** `is_better_update` for two updates of `k`. */
export bool isBetterUpdateAt(i32 k, i32 n, i64 pp, u8[] newUpdate, u8[] oldUpdate) {
  u8[] newBits = field(k, n, TY_SYNC_AGGREGATE(), updateSyncAggregateAt(k, n, newUpdate), AGGREGATE_BITS);
  u8[] oldBits = field(k, n, TY_SYNC_AGGREGATE(), updateSyncAggregateAt(k, n, oldUpdate), AGGREGATE_BITS);
  i32 maxActive = newBits.len() * 8;
  i32 newActive = countBits(newBits);
  i32 oldActive = countBits(oldBits);
  bool newSuper = hasSupermajority(newBits, newActive);
  bool oldSuper = hasSupermajority(oldBits, oldActive);
  if (newSuper != oldSuper) { return newSuper; }
  if (!newSuper && newActive != oldActive) { return newActive > oldActive; }

  bool newRelevant = isSyncCommitteeUpdateAt(k, n, newUpdate) &&
    periodIn(pp, headerSlot(updateAttestedHeaderAt(k, n, newUpdate))) ==
    periodIn(pp, updateSignatureSlotAt(k, n, newUpdate));
  bool oldRelevant = isSyncCommitteeUpdateAt(k, n, oldUpdate) &&
    periodIn(pp, headerSlot(updateAttestedHeaderAt(k, n, oldUpdate))) ==
    periodIn(pp, updateSignatureSlotAt(k, n, oldUpdate));
  if (newRelevant != oldRelevant) { return newRelevant; }

  bool newFinality = isFinalityUpdateAt(k, n, newUpdate);
  bool oldFinality = isFinalityUpdateAt(k, n, oldUpdate);
  if (newFinality != oldFinality) { return newFinality; }

  if (newFinality) {
    bool newCommitteeFinality =
      periodIn(pp, headerSlot(updateFinalizedHeaderAt(k, n, newUpdate))) ==
      periodIn(pp, headerSlot(updateAttestedHeaderAt(k, n, newUpdate)));
    bool oldCommitteeFinality =
      periodIn(pp, headerSlot(updateFinalizedHeaderAt(k, n, oldUpdate))) ==
      periodIn(pp, headerSlot(updateAttestedHeaderAt(k, n, oldUpdate)));
    if (newCommitteeFinality != oldCommitteeFinality) { return newCommitteeFinality; }
  }

  if (newActive != oldActive) { return newActive > oldActive; }
  i64 newAttested = headerSlot(updateAttestedHeaderAt(k, n, newUpdate));
  i64 oldAttested = headerSlot(updateAttestedHeaderAt(k, n, oldUpdate));
  if (newAttested != oldAttested) { return newAttested < oldAttested; }
  return updateSignatureSlotAt(k, n, newUpdate) < updateSignatureSlotAt(k, n, oldUpdate);
}

// ── Advancing the store ───────────────────────────────────────────────────────

/**
 * `apply_light_client_update` — adopt an update that has already been validated.
 *
 * The committee rotation is the delicate part. A store learns `next` once, and thereafter only
 * *rotates* when finality crosses into the following period: `current` becomes what `next` was, and
 * `next` becomes the update's. Rotating on any other trigger would let a client be moved to a
 * committee a period ahead of its own finality, which is the position from which it can be fed
 * anything.
 */
export void applyUpdate(Store store, u8[] update) {
  i64 storePeriod = store.schedule.periodAt(headerSlot(store.finalizedHeader));
  u8[] finalized = updateFinalizedHeaderAt(store.fork, store.schedule.size, update);
  i64 finalizedPeriod = store.schedule.periodAt(headerSlot(finalized));

  if (!isNextSyncCommitteeKnown(store)) {
    if (finalizedPeriod != storePeriod) { return; }     // the spec asserts; a client refuses
    store.nextSyncCommittee = updateNextSyncCommitteeAt(store.fork, store.schedule.size, update);
  } else {
    if (finalizedPeriod == storePeriod + 1) {
      store.currentSyncCommittee = store.nextSyncCommittee;
      store.nextSyncCommittee = updateNextSyncCommitteeAt(store.fork, store.schedule.size, update);
      store.previousMaxActiveParticipants = store.currentMaxActiveParticipants;
      store.currentMaxActiveParticipants = 0;
    }
  }
  if (headerSlot(finalized) > headerSlot(store.finalizedHeader)) {
    store.finalizedHeader = finalized;
    if (headerSlot(store.finalizedHeader) > headerSlot(store.optimisticHeader)) {
      store.optimisticHeader = store.finalizedHeader;
    }
  }
}

/**
 * `process_light_client_update` — validate, then advance as far as the update justifies.
 *
 * Three separate advances, and they need different amounts of evidence, which is the point of the
 * function:
 *
 *   - the **best valid update** is kept unconditionally, as the fallback a timeout can force;
 *   - the **optimistic header** moves on more than the safety threshold — a majority of the best
 *     participation lately, so it tracks the chain quickly and is explicitly not final;
 *   - the **finalized header** moves only on a supermajority, two thirds of the committee.
 *
 * Returns false when the update is invalid; a valid update that advances nothing still returns true,
 * because "believed and not useful" is not an error.
 */
export bool processUpdate(Store store, u8[] update, i64 currentSlot, u8[] genesisValidatorsRoot) {
  if (!validateUpdate(store, update, currentSlot, genesisValidatorsRoot)) { return false; }

  u8[] bits = field(store.fork, store.schedule.size, TY_SYNC_AGGREGATE(), updateSyncAggregateAt(store.fork, store.schedule.size, update), AGGREGATE_BITS);
  i32 active = countBits(bits);

  if (store.bestValidUpdate.len() == 0 || isBetterUpdateAt(store.fork, store.schedule.size, store.schedule.slotsPerPeriod, update, store.bestValidUpdate)) {
    store.bestValidUpdate = update;
  }
  if (active > store.currentMaxActiveParticipants) { store.currentMaxActiveParticipants = active; }

  u8[] attested = updateAttestedHeaderAt(store.fork, store.schedule.size, update);
  if (active > safetyThreshold(store) && headerSlot(attested) > headerSlot(store.optimisticHeader)) {
    store.optimisticHeader = attested;
  }

  bool hasFinalizedNextCommittee = !isNextSyncCommitteeKnown(store)
    && isSyncCommitteeUpdateAt(store.fork, store.schedule.size, update) && isFinalityUpdateAt(store.fork, store.schedule.size, update)
    && store.schedule.periodAt(headerSlot(updateFinalizedHeaderAt(store.fork, store.schedule.size, update)))
       == store.schedule.periodAt(headerSlot(attested));

  if (hasSupermajority(bits, active)
      && (headerSlot(updateFinalizedHeaderAt(store.fork, store.schedule.size, update)) > headerSlot(store.finalizedHeader)
          || hasFinalizedNextCommittee)) {
    applyUpdate(store, update);
    store.bestValidUpdate = u8[]();
  }
  return true;
}

/**
 * `process_light_client_store_force_update` — accept the best update once the timeout has elapsed.
 *
 * The escape from extended non-finality. If nothing has finalized for a whole period, the client
 * promotes its best update anyway, treating that update's *attested* header as finalized so it can
 * still progress into later committee periods.
 *
 * That is a deliberate weakening and it is bounded by `is_better_update` having chosen the candidate:
 * a client that never forced would stall for ever, and one that forced eagerly would follow whoever
 * spoke last.
 */
export void forceUpdate(Store store, i64 currentSlot) {
  if (store.bestValidUpdate.len() == 0) { return; }
  if (!(currentSlot > headerSlot(store.finalizedHeader) + store.schedule.slotsPerPeriod)) { return; }

  u8[] best = store.bestValidUpdate;
  if (headerSlot(updateFinalizedHeaderAt(store.fork, store.schedule.size, best)) <= headerSlot(store.finalizedHeader)) {
    // Treat the attested header as finalized, which is what the spec does by rewriting the update.
    // Done by applying the pieces rather than by editing the serialized update, because these bytes
    // came from a peer and rewriting them would make the store's provenance harder to reason about.
    applyAsFinalized(store, best);
  } else {
    applyUpdate(store, best);
  }
  store.bestValidUpdate = u8[]();
}

/** `applyUpdate`, with the update's attested header standing in for its finalized one. */
void applyAsFinalized(Store store, u8[] update) {
  u8[] attested = updateAttestedHeaderAt(store.fork, store.schedule.size, update);
  i64 storePeriod = store.schedule.periodAt(headerSlot(store.finalizedHeader));
  i64 finalizedPeriod = store.schedule.periodAt(headerSlot(attested));

  if (!isNextSyncCommitteeKnown(store)) {
    if (finalizedPeriod != storePeriod) { return; }
    store.nextSyncCommittee = updateNextSyncCommitteeAt(store.fork, store.schedule.size, update);
  } else {
    if (finalizedPeriod == storePeriod + 1) {
      store.currentSyncCommittee = store.nextSyncCommittee;
      store.nextSyncCommittee = updateNextSyncCommitteeAt(store.fork, store.schedule.size, update);
      store.previousMaxActiveParticipants = store.currentMaxActiveParticipants;
      store.currentMaxActiveParticipants = 0;
    }
  }
  if (headerSlot(attested) > headerSlot(store.finalizedHeader)) {
    store.finalizedHeader = attested;
    if (headerSlot(store.finalizedHeader) > headerSlot(store.optimisticHeader)) {
      store.optimisticHeader = store.finalizedHeader;
    }
  }
}

// ── The two smaller updates a node serves ────────────────────────────────────────────────────────────────

/**
 * `process_light_client_finality_update`: a `LightClientFinalityUpdate` of the store's layout, processed as the
 * `LightClientUpdate` the spec builds from it — no next committee, a zero committee branch.
 */
export bool processFinalityUpdate(Store store, u8[] fu, i64 currentSlot, u8[] genesisValidatorsRoot) {
  i32 n = store.schedule.size;
  u8[][] p = fieldsOfN(store.fork, n, TY_LIGHT_CLIENT_FINALITY_UPDATE(), fu);
  if (p.len() != 5) { return false; }
  u8[] u = serializeN(store.fork, n, TY_LIGHT_CLIENT_UPDATE(),
                      [p[0], u8[].filled(n * 48 + 48, 0), u8[].filled(syncCommitteeBranchDepth(store.fork) * 32, 0),
                       p[1], p[2], p[3], p[4]]);
  return processUpdate(store, u, currentSlot, genesisValidatorsRoot);
}

/** `process_light_client_optimistic_update`: no committee, and an empty finalized header and branch. */
export bool processOptimisticUpdate(Store store, u8[] ou, i64 currentSlot, u8[] genesisValidatorsRoot) {
  i32 n = store.schedule.size;
  u8[][] p = fieldsOfN(store.fork, n, TY_LIGHT_CLIENT_OPTIMISTIC_UPDATE(), ou);
  if (p.len() != 3) { return false; }
  u8[] u = serializeN(store.fork, n, TY_LIGHT_CLIENT_UPDATE(),
                      [p[0], u8[].filled(n * 48 + 48, 0), u8[].filled(syncCommitteeBranchDepth(store.fork) * 32, 0),
                       upgradeHeader(ALTAIR(), store.fork, u8[].filled(112, 0)),
                       u8[].filled(finalityBranchDepth(store.fork) * 32, 0), p[1], p[2]]);
  return processUpdate(store, u, currentSlot, genesisValidatorsRoot);
}
