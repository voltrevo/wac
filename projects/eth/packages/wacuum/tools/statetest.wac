// Run execution-spec-tests' state tests: every case for one fork, checked against the state root and the
// logs hash the fixture expects.
//
//     wac build --allow-read tools/statetest.wac -o statetest
//     find fixtures/state_tests -name '*.json' | xargs ./statetest --fork Cancun
//
// A case is one entry in a test's `post[fork]`: the pre-state, the transaction built from that entry's
// `indexes`, and the root it must produce. A case expecting an exception passes when the transaction is
// refused as invalid and the state is untouched — the root is still checked, since it is the pre-state's.
//
// Prints each failure with the test's name and why, then one line of totals. `--verbose` also prints, for
// a failure, which accounts differ from the fixture's `state`, which is what makes a wrong root findable.

import { Map } from "core";
import { Sys } from "std";
import { json.parse, json.JsonValue, json.JsonObject, json.JsonArray } from "wac";
import { U256 } from "../src/u256.wac";
import { hexToBytes, bytesToHex } from "../src/hex.wac";
import { num, bytes, worldFrom, diffState, blockFrom, txFrom } from "./fixture.wac";
import { World, Account, Log, hashU256, eqU256 } from "../src/state/world.wac";
import { stateRoot, logsHash } from "../src/state/root.wac";
import { BlockEnv } from "../src/evm/evm.wac";
import { Spec } from "../src/evm/spec.wac";
import { Store } from "../src/store/tree.wac";
import { MemDisk } from "../src/store/disk.wac";
import { StateDb, rootOf } from "../src/store/state.wac";
import { Transaction, AccessEntry, Authorization, Processed, processTransaction, blobGasPrice } from "../src/tx/process.wac";
import { DecodedTx, decodeTransaction } from "../src/tx/decode.wac";
import { txItem } from "../src/engine/engine.wac";
import { rlp.Item } from "@/lib.wac";

struct Tally {
  i32 passed;
  i32 failed;
  i32 skipped;
  bool verbose;
  bool trace;
  string fork;
  string filter;
  /** Every account and slot read from a store rather than held: see `coldCase`. */
  bool cold;
  /** Rounds the cold runs took, for the summary. */
  i32 rounds;
  World? pre;
}

/**
 * The case again with its pre-state in a store (on a disk in memory) and nothing held: a world backed by
 * the store, run until a run reads nothing it had not read before, its changes committed, and the root
 * computed from what the store then holds. `pre` is the world `worldFrom` built, before the transaction
 * ran on it — the transaction above ran on a copy, so this takes the state before it from the fixture's
 * pre-state through `changesOf`. What the plain run checks, this checks through the store's reads and
 * writes. Awaited from `main` rather than driven with `wait()`, which keeps every call alive (wac 0473w).
 */
async (Processed, string) coldCase(Tally tally, World ran, Spec spec, BlockEnv block, Transaction tx, i64 gl) {
  World pre = tally.pre!;
  MemDisk md = MemDisk.create();
  Store s = (await Store.open(md.disk())).unwrap();
  StateDb db = StateDb.over(s);
  string[] why = [""];
  u8[]? seeded = (await db.seed(pre, u8[].filled(0, 0), why));
  if (seeded is null) { return (processTransaction(spec, World.create(), block, tx, gl, spec.maxBlobGasPerBlock, null), "the pre-state did not commit: \{why[0]}"); }
  World w = World.create();
  Processed? p = null;
  for (i32 round = 0; round < 1000; round++) {
    w = World.create();
    w.backBy(db.source());
    w.record();
    db.misses = 0;
    p = processTransaction(spec, w, block, tx, gl, spec.maxBlobGasPerBlock, null);
    tally.rounds++;
    if (db.misses == 0) { break; }
    (await db.fetch());
  }
  u8[]? root = (await db.flush(w.seal(), u8[].filled(0, 0), why));
  if (root is null) { return (p!, "the flush failed: \{why[0]}"); }
  // The tries the store keeps against the flat entries alone.
  string scratch = bytesToHex(await rootOf(s));
  if (scratch != bytesToHex(root!)) { return (p!, "the stored tries say \{bytesToHex(root!)}, the entries \{scratch}"); }
  return (p!, bytesToHex(root!));
}

/** One case: true when it matches the fixture. */
async bool runCase(Sys sys, Tally tally, string name, JsonValue test, JsonValue post, i32 idx) {
  World w = worldFrom(test.member("pre")!);
  if (tally.cold) { tally.pre = worldFrom(test.member("pre")!); }
  JsonValue? config = test.member("config");
  U256 chainId = config is null ? U256.one() : num(config!.member("chainid"));
  if (chainId.isZero()) { chainId = U256.one(); }
  Spec spec = specFor(tally.fork, num(test.member("env")!.member("currentTimestamp")))!;
  BlockEnv block = blockFrom(spec, test.member("env")!, chainId);
  Transaction tx = txFrom(test.member("transaction")!, post.member("indexes")!);
  bool expectInvalid = post.member("expectException") is not null;
  // The signed transaction, when the fixture gives it, decoded as a block's would be: its signature checked and
  // its sender recovered under this chain's id. The JSON form names the sender outright, so a bad signature
  // or another chain's transaction would otherwise run (tests@v21.0.1's bad_v_r_s, invalid_chain_id).
  JsonValue? raw = post.member("txbytes");
  if (raw is not null) {
    Item? it = txItem(hexToBytes(raw!.text()!)!);
    DecodedTx d = it is null ? DecodedTx(tx, u8[].filled(0, 0), "not RLP", U256.zero()) : decodeTransaction(it!, chainId);
    if (d.error != "") {
      if (expectInvalid) { return true; }
      sys.log("FAIL \{name} [\{idx}]: its txbytes do not decode: \{d.error}");
      return false;
    }
    if (!d.tx.sender.eq(tx.sender)) {
      sys.log("FAIL \{name} [\{idx}]: txbytes recover sender \{bytesToHex(d.tx.sender.toBytes())}, the fixture names another");
      return false;
    }
  }
  i64 gl = block.gasLimit.fitsU64() ? block.gasLimit.low() as@ i64 : 0x7FFFFFFFFFFFFFFF;
  fn<void(string)>? tracer = null;
  if (tally.trace) { tracer = (string line) => { sys.log(line); }; }
  Processed p = processTransaction(spec, w, block, tx, gl, spec.maxBlobGasPerBlock, tracer);
  string coldRoot = "";
  if (tally.cold) {
    (Processed cp, string r) = await coldCase(tally, w, spec, block, tx, gl);
    p = cp;
    coldRoot = r;
  }
  string why = "";
  if (expectInvalid && p.invalid == "") { why = "accepted a transaction the fixture expects to be refused"; }
  if (!expectInvalid && p.invalid != "") { why = "refused it: \{p.invalid}"; }
  string root = tally.cold ? coldRoot : bytesToHex(stateRoot(w));
  string wantRoot = post.member("hash")!.text()!;
  if (why == "" && root != wantRoot) { why = "state root \{root}, want \{wantRoot}"; }
  string logs = bytesToHex(logsHash(p.logs));
  string wantLogs = post.member("logs")!.text()!;
  if (why == "" && logs != wantLogs) { why = "logs hash \{logs}, want \{wantLogs}"; }
  if (why == "") { return true; }
  sys.log("FAIL \{name} [\{idx}]: \{why} (gas used \{p.gasUsed})");
  if (tally.verbose) { diffState(sys, w, post.member("state")); }
  return false;
}


export async i32 main(Sys sys) {
  string[] args = sys.args();
  Tally tally = Tally(0, 0, 0, false, false, "Cancun", "", false, 0, null);
  for (i32 a = 0; a < args.len(); a++) {
    string arg = args[a];
    if (arg == "--verbose") { tally.verbose = true; continue; }
    if (arg == "--trace") { tally.trace = true; continue; }
    if (arg == "--cold") { tally.cold = true; continue; }
    if (arg == "--fork") {
      a++;
      tally.fork = args[a];
      if (specFor(tally.fork, U256.zero()) is null) { sys.log("unknown fork \{tally.fork}: Cancun and Prague are what this runs"); return 2; }
      continue;
    }
    if (arg == "--filter") { a++; tally.filter = args[a]; continue; }
    match (await sys.readFile(arg)) {
      Err(e): { sys.log("FAIL \{arg}: \{e}"); tally.failed++; }
      Ok(src): {
        match (parse(src)) {
          Err(e): { sys.log("FAIL \{arg}: not JSON"); tally.failed++; }
          Ok(doc): { await runFile(sys, tally, doc); }
        }
      }
    }
  }
  sys.log("\{tally.passed} passed, \{tally.failed} failed" + (tally.cold ? ", cold, in \{tally.rounds} runs" : ""));
  return tally.failed == 0 ? 0 : 1;
}

async void runFile(Sys sys, Tally tally, JsonValue doc) {
  JsonObject tests = doc.object()!;
  for (i32 i = 0; i < tests.len(); i++) {
    string name = tests.at(i).keyStr();
    if (tally.filter != "" && name.indexOf(tally.filter) < 0) { continue; }
    JsonValue test = tests.at(i).value;
    JsonValue? posts = test.member("post")!.member(tally.fork);
    if (posts is null) { continue; }
    JsonArray cases = posts!.array()!;
    for (i32 c = 0; c < cases.len(); c++) {
      if (await runCase(sys, tally, name, test, cases.get(c), c)) { tally.passed++; } else { tally.failed++; }
    }
  }
}

/**
 * The fork a case runs under: the one named, or for a transition `XToYAtTime15k` X before timestamp 15,000 and Y
 * from it — the case's own timestamp decides.
 */
Spec? specFor(string fork, U256 timestamp) {
  i32 to = fork.indexOf("To");
  i32 at = fork.indexOf("AtTime15k");
  if (to < 0 || at < 0) { return Spec.byName(fork); }
  Spec? before = Spec.byName(fork.slice(0, to));
  Spec? after = Spec.byName(fork.slice(to + 2, at));
  if (before is null || after is null) { return null; }
  return timestamp.lt(U256.ofU64(15000)) ? before : after;
}
