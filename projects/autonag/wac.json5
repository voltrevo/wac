{
  // What another project gets from `import { … } from "autonag"`.
  exports: './src/lib.wac',
  imports: {
    // The rest of wac, as one dependency: `import { json.parse } from "wac"`.
    wac: { git: 'https://github.com/voltrevo/wac.git', ref: 'master' },
    // SQLite in wac: the server keeps autonag's own schema and database file.
    sqlite: { git: 'https://github.com/voltrevo/wac.git', ref: 'master', subdir: './projects/sqlite' },
    // The web client's page — `import { Page, Ui } from "web"` — and the builder that makes it one index.html.
    web: { git: 'https://github.com/voltrevo/wac.git', ref: 'master', subdir: './projects/web' },
    webbuild: { git: 'https://github.com/voltrevo/wac.git', ref: 'master', subdir: './projects/web/tools' },
  },
}
