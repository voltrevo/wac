// The client's styles: autonag's index.css and its styled-components, as one stylesheet of plain classes.
//
// **The theme is on the app's own root** (`.app`), not on `<html>`, which a page's program does not hold: its
// variables are set there, overridden by a `scheme-light` or `scheme-dark` class on it, and inherited below. **Urgency colours are
// chosen by the stylesheet**: autonag picked the light or dark one in script from the colour scheme, which a page
// in a worker cannot ask, so an element carries both (`--u-l`, `--u-d`) and `.urg` shows the one the scheme wants.

export static string CSS = """
*, *::before, *::after { box-sizing: border-box; }
body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; -webkit-font-smoothing: antialiased; }
button { font-family: inherit; color: inherit; }
input, textarea, select { font-family: inherit; color: inherit; }

.app {
  --bg: #e6e6e6; --bg-page: #ffffff; --bg-card: #f5f5f5; --bg-input: #ffffff; --bg-elevated: #ffffff;
  --bg-accent: #f0f4ff; --bg-accent-border: #c7d9ff; --bg-segment: #c8e6c9; --bg-btn: #cccccc;
  --text: #000000; --text-muted: #888888; --text-label: #555555;
  --border: #dddddd; --border-strong: rgba(0,0,0,0.5); --border-medium: rgba(0,0,0,0.45);
  --on-urg-text: rgba(0,0,0,0.85); --on-urg-muted: rgba(0,0,0,0.5); --on-urg-overlay: rgba(255,255,255,0.3);
  --on-urg-overlay-strong: rgba(255,255,255,0.4); --on-urg-border: rgba(0,0,0,0.2); --on-urg-border-strong: rgba(0,0,0,0.45);
  --on-urg-input: rgba(255,255,255,0.5);
  --u: var(--u-l);
  background: var(--bg-page); color: var(--text); min-height: 100vh;
}
@media (prefers-color-scheme: dark) {
  .app:not(.scheme-light) {
    --bg: #1a1a1a; --bg-page: #111111; --bg-card: #2a2a2a; --bg-input: #1f2937; --bg-elevated: #222222;
    --bg-accent: #1a2040; --bg-accent-border: #2d3f6e; --bg-segment: #1a2e1a; --bg-btn: #333333;
    --text: #f0f0f0; --text-muted: #9ca3af; --text-label: #9ca3af;
    --border: #374151; --border-strong: rgba(255,255,255,0.2); --border-medium: rgba(255,255,255,0.2);
    --on-urg-text: rgba(255,255,255,0.9); --on-urg-muted: rgba(255,255,255,0.5); --on-urg-overlay: rgba(255,255,255,0.08);
    --on-urg-overlay-strong: rgba(255,255,255,0.12); --on-urg-border: rgba(255,255,255,0.15); --on-urg-border-strong: rgba(255,255,255,0.2);
    --on-urg-input: rgba(255,255,255,0.1);
  }
  .app:not(.scheme-light) .urg { background: var(--u-d); }
  .login:not(.light) { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); }
  .login:not(.light) .login-title { color: #ffffff; }
  .login:not(.light) .login-subtitle { color: #a0aec0; }
  .login:not(.light) .login-input { border-color: #374151; background: #1f2937; color: #ffffff; }
  .login:not(.light) .login-input:focus { background: #111827; }
  .login:not(.light) .login-input::placeholder { color: #6b7280; }
  .login:not(.light) .login-error { color: #f87171; }
  .login:not(.light) .login-note { color: #6b7280; }
}
.app.scheme-dark {
  --bg: #1a1a1a; --bg-page: #111111; --bg-card: #2a2a2a; --bg-input: #1f2937; --bg-elevated: #222222;
  --bg-accent: #1a2040; --bg-accent-border: #2d3f6e; --bg-segment: #1a2e1a; --bg-btn: #333333;
  --text: #f0f0f0; --text-muted: #9ca3af; --text-label: #9ca3af;
  --border: #374151; --border-strong: rgba(255,255,255,0.2); --border-medium: rgba(255,255,255,0.2);
  --on-urg-text: rgba(255,255,255,0.9); --on-urg-muted: rgba(255,255,255,0.5); --on-urg-overlay: rgba(255,255,255,0.08);
  --on-urg-overlay-strong: rgba(255,255,255,0.12); --on-urg-border: rgba(255,255,255,0.15); --on-urg-border-strong: rgba(255,255,255,0.2);
  --on-urg-input: rgba(255,255,255,0.1);
}
.urg { background: var(--u-l); }
.app.scheme-dark .urg { background: var(--u-d); }

.centered { display: flex; align-items: center; justify-content: center; height: 100vh; color: var(--text-muted); }
.pending { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; padding: 2rem; gap: 1rem; text-align: center; }

/* Login */
.login { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 2rem;
  background: linear-gradient(135deg, #f0f4ff 0%, #e8f0fe 50%, #dce8ff 100%); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
.login-card { max-width: 400px; width: 100%; display: flex; flex-direction: column; align-items: center; gap: 0; }
.login-logo { width: 130px; height: 130px; object-fit: contain; margin-bottom: 16px; }
.login-title { margin: 0 0 8px 0; font-size: 2.5rem; font-weight: 700; color: #1a1a2e; text-align: center; }
.login-subtitle { margin: 0 0 2.5rem 0; font-size: 1.1rem; color: #4a5568; text-align: center; font-style: italic; line-height: 1.6; }
.login-form { width: 100%; display: flex; flex-direction: column; gap: 0.75rem; }
.login-input { width: 100%; padding: 0.75rem 1rem; border: 2px solid #cbd5e0; border-radius: 8px; font-size: 1rem; background: #ffffff; color: #1a1a2e; box-sizing: border-box; }
.login-input:focus { outline: none; border-color: #4f46e5; background: #f8f9ff; }
.login-input::placeholder { color: #a0aec0; }
.login-button { width: 100%; padding: 0.75rem; background: #4f46e5; color: white; border: none; border-radius: 8px; font-size: 1rem; cursor: pointer; font-weight: 600; }
.login-button:hover { background: #4338ca; }
.login-button:disabled { opacity: 0.5; cursor: not-allowed; }
.login-error { color: #c53030; font-size: 0.875rem; margin: 0; }
.login-note { color: #718096; font-size: 0.8rem; text-align: center; margin: 1.25rem 0 0; line-height: 1.5; }

/* Instances */
.instances { display: flex; flex-direction: column; padding: 2rem; gap: 1.5rem; max-width: 480px; margin: 0 auto; min-height: 100vh; background: var(--bg-page); }
.instances-title { font-size: 1.5rem; font-weight: bold; margin: 0; }
.instance-list { display: flex; flex-direction: column; gap: 0.75rem; }
.instance-card { padding: 1rem 1.25rem; background: var(--bg-card); border: 2px solid transparent; border-radius: 8px; cursor: pointer; text-align: left; font-size: 1rem; transition: border-color 0.15s; }
.instance-card:hover { border-color: #4a9eff; }
.instance-name { font-weight: 600; }
.instance-status { font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem; }
.divider { border-top: 1px solid var(--border); margin: 0.5rem 0; }
.request-row { display: flex; gap: 0.75rem; }
.request-input { flex: 1; padding: 0.6rem 0.75rem; border: 2px solid var(--border); border-radius: 8px; font-size: 0.9rem; background: var(--bg-input); }
.request-input:focus { outline: none; border-color: #4a9eff; }
.blue-button { padding: 0.6rem 1rem; background: #4a9eff; color: white; border: none; border-radius: 8px; font-size: 0.9rem; cursor: pointer; white-space: nowrap; }
.blue-button:hover { background: #2d7dd2; }
.blue-button:disabled { opacity: 0.5; }
.pending-note { color: var(--text-muted); font-size: 0.85rem; margin: 0; }
.logout { background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 0.8rem; align-self: flex-end; padding: 0; }
.logout:hover { color: var(--text); }

/* The timer list */
.list-page { display: flex; flex-direction: column; height: 100dvh; background: var(--bg); }
.list-page.desktop { height: 100%; }
.big-buttons { display: flex; border-bottom: 1px solid var(--border-strong); flex-shrink: 0; }
.big-btn { flex: 1; font-size: 1.25rem; padding: 0.85rem 0.5rem; border: none; border-radius: 0; background: var(--bg-btn); color: var(--text); cursor: pointer;
  display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.2; gap: 2px; }
.big-btn:not(:last-child) { border-right: 1px solid var(--border-strong); }
.big-btn:active { filter: brightness(0.85); }
.menu-btn { flex: 2; font-size: 0.9rem; font-weight: 600; gap: 3px; }
.shh-btn { user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
.shh-btn.active { background: #222; color: white; }
.add-btn { background: #007bff; color: white; font-size: 2.5rem; font-weight: bold; }
.add-btn:not(:last-child) { border-right: 1px solid rgba(0,0,0,0.5); }
.status-dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; background: #dc3545; }
.status-dot.connected { background: #28a745; }
.status-dot.connecting { background: #ffc107; }
.search-bar { width: 100%; padding: 0.6rem 1rem; border: none; border-bottom: 1px solid var(--border-strong); font-size: 1rem; background: var(--bg); box-sizing: border-box; }
.search-bar:focus { outline: none; background: var(--bg-card); }
.list { flex: 1; overflow-y: auto; }
.empty-msg { display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 1.5rem; text-align: center; padding: 3rem 2rem; height: 100%; }
.segment-header { position: sticky; top: 0; background: var(--bg-segment); color: var(--text); z-index: 1; padding: 0.5em 0.5em 0.5em; padding-top: 1.5em;
  border-bottom: 1px solid var(--border-strong); font-weight: bold; display: flex; justify-content: center; align-items: center; gap: 12px; }
.count-badge { display: inline-flex; align-items: center; justify-content: center; min-width: 24px; height: 24px; padding: 0 8px; background: rgba(255,255,255,0.2);
  border-radius: 12px; font-size: 0.85em; font-weight: 600; }

/* A timer's row */
.timer-row { display: flex; align-items: center; padding: 1.25rem 2.5rem; border-bottom: 1px solid var(--border-strong); cursor: pointer; gap: 0.75rem;
  transition: background 1s linear; font-size: 1.2rem; }
.timer-row:active { filter: brightness(0.9); }
.name-col { flex: 1; min-width: 0; }
.timer-name { font-weight: 500; font-size: 1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.delay-label { font-size: 0.72rem; color: #c53030; margin-top: 2px; }
.timer-description { font-size: 0.75rem; color: var(--text-muted); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.time-col { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
.time-left { font-size: 0.8rem; color: var(--text-muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
.recur-badge { font-size: 0.65rem; color: #2b6cb0; }

/* Sheets */
.overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: flex-end; z-index: 100; }
.sheet { background: var(--bg-elevated); color: var(--text); width: 100%; padding: 1.5rem; border-radius: 16px 16px 0 0; display: flex; flex-direction: column; gap: 0.75rem; }
.sheet-title { font-weight: 600; font-size: 1rem; margin-bottom: 0.25rem; }
.sheet-subtitle { font-weight: 500; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.25rem; }
.sheet-btn { padding: 0.75rem 1rem; border: 2px solid var(--border); border-radius: 8px; background: var(--bg-elevated); color: var(--text); font-size: 0.95rem; cursor: pointer; text-align: left; }
.sheet-btn:hover { border-color: #4a9eff; background: var(--bg-card); }
.sheet-btn.danger { border-color: #e53e3e; color: #e53e3e; }
.sheet-btn.muted { color: #888; }
.sheet-btn.choice { flex: 1; text-align: center; }
.sheet-btn.chosen { background: var(--bg-accent); border-color: #4a9eff; }
.sheet-rule { border-top: 1px solid var(--border); margin: 0.25rem 0; }
.reason-btn { padding: 0.75rem 1rem; border: 2px solid var(--border); border-radius: 8px; background: var(--bg-elevated); font-size: 0.95rem; cursor: pointer; text-align: left; }
.reason-btn:hover { border-color: #4a9eff; background: var(--bg-card); }
.custom-input { padding: 0.6rem 0.75rem; border: 2px solid var(--border); border-radius: 8px; font-size: 0.9rem; width: 100%; box-sizing: border-box; background: var(--bg-input); }
.custom-input:focus { outline: none; border-color: #4a9eff; }
.cancel-btn { padding: 0.6rem; background: none; border: none; color: #888; cursor: pointer; font-size: 0.9rem; }
.close-btn { padding: 0.6rem 1rem; background: #4a9eff; color: white; border: none; border-radius: 8px; cursor: pointer; }
.delete-btn { background: none; border: none; cursor: pointer; padding: 4px; font-size: 0.85rem; color: #e53e3e; text-align: left; }
.time-input { padding: 0.5rem 0.75rem; font-size: 0.9rem; font-family: inherit; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-input); color: var(--text); width: 100%; }

/* Forms (adding a timer) */
.form-page { display: flex; flex-direction: column; height: 100vh; padding: 1.5rem; gap: 1rem; max-width: 480px; margin: 0 auto; box-sizing: border-box; background: var(--bg-page); }
.form { display: flex; flex-direction: column; gap: 1rem; flex: 1; }
.header { display: flex; align-items: center; gap: 0.75rem; }
.back-btn { background: none; border: none; font-size: 1.3rem; cursor: pointer; padding: 4px; }
.page-title { margin: 0; font-size: 1.25rem; }
.label { font-size: 0.85rem; font-weight: 600; color: var(--text-label); }
.input { padding: 0.75rem 1rem; border: 2px solid var(--border); border-radius: 8px; font-size: 1rem; width: 100%; box-sizing: border-box; background: var(--bg-input); }
.input:focus { outline: none; border-color: #4a9eff; }
.textarea { padding: 0.75rem 1rem; border: 2px solid var(--border); border-radius: 8px; font-size: 1rem; width: 100%; box-sizing: border-box; resize: vertical; min-height: 80px; font-family: inherit; background: var(--bg-input); }
.textarea:focus { outline: none; border-color: #4a9eff; }
.parse-preview { font-size: 0.8rem; margin-top: 0.3rem; color: var(--text-muted); min-height: 1.2em; }
.parse-preview.valid { color: #4caf50; }
.submit-btn { padding: 0.85rem; background: #4a9eff; color: white; border: none; border-radius: 8px; font-size: 1rem; cursor: pointer; margin-top: auto; }
.submit-btn:hover { background: #2d7dd2; }
.submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }
.error-msg { color: #e53e3e; font-size: 0.875rem; margin: 0; }
.toggle-row { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; }
.recurrence-box { display: flex; flex-direction: column; gap: 0.75rem; padding: 0.75rem; background: var(--bg-accent); border-radius: 8px; border: 1px solid var(--bg-accent-border); margin-top: 0.5rem; }
.row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
.check-row { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; cursor: pointer; }
.chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.5rem; }
.chip { padding: 0.3rem 0.6rem; border: 1px solid var(--border); border-radius: 16px; background: var(--bg-input); color: var(--text); cursor: pointer; font-size: 0.8rem; }
.chip.on { background: #4a9eff; color: white; }

/* The alarm */
@keyframes flash { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
.alarm { display: flex; flex-direction: column; height: 100vh; color: var(--on-urg-text); transition: background 2s linear; user-select: none; }
.alarm.plain { background: var(--bg); }
.alarm.flashing { animation: flash 1s ease-in-out infinite; }
.top-bar { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.25rem; }
.alarm-back { background: none; border: none; font-size: 1.2rem; cursor: pointer; padding: 4px; opacity: 0.6; }
.alarm-back:hover { opacity: 1; }
.alarm-dot { width: 8px; height: 8px; border-radius: 50%; background: #e53e3e; }
.alarm-dot.connected { background: rgba(0,0,0,0.3); }
.center { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem; padding: 2rem; }
.urgent-name { font-size: 1.5rem; font-weight: 700; text-align: center; opacity: 0.85; }
.countdown { font-size: 4rem; font-weight: bold; font-variant-numeric: tabular-nums; opacity: 0.9; }
.hint { font-size: 0.9rem; opacity: 0.55; margin-top: 0.5rem; }
.hint.big { font-size: 1.2rem; opacity: 0.4; }
.bottom-bar { display: flex; justify-content: center; padding: 1.5rem; gap: 1rem; }
.shush-btn { padding: 0.75rem 2rem; border-radius: 2rem; border: 2px solid var(--on-urg-border); background: var(--on-urg-input); font-size: 1rem; font-weight: 600; cursor: pointer; backdrop-filter: blur(4px); }
.shush-btn.active { background: var(--on-urg-overlay); }
.shush-btn:hover { background: var(--on-urg-overlay-strong); }
.unlock-overlay { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.6); z-index: 200; }
.unlock-btn { padding: 1.25rem 2.5rem; background: white; border: none; border-radius: 12px; font-size: 1.1rem; font-weight: 600; cursor: pointer; }

/* Desktop: the list beside whatever is open */
.desktop-shell { display: flex; height: 100vh; overflow: hidden; background: var(--bg); max-width: 1100px; margin: 0 auto;
  border-left: 2px solid var(--border-strong); border-right: 2px solid var(--border-strong); }
.left-panel { width: 360px; flex-shrink: 0; border-right: 2px solid var(--border-strong); overflow: hidden; display: flex; flex-direction: column; }
.right-panel { flex: 1; overflow-y: auto; display: flex; flex-direction: column; }
.right-placeholder { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--text-muted); gap: 0.5rem; font-size: 1.1rem; height: 100vh; }
/* A timer, open */
.vt { min-height: 100vh; color: var(--on-urg-text); transition: background 1s linear; display: flex; flex-direction: column; }
.vt-top { display: flex; align-items: center; padding: 0.75rem 1rem 0.5rem; gap: 0.5rem; }
.vt-back { background: none; border: none; font-size: 1.4rem; cursor: pointer; padding: 4px 8px 4px 0; flex-shrink: 0; line-height: 1; }
.vt-back:active { opacity: 0.6; }
.vt-name { flex: 1; font-size: 1.8rem; font-weight: bold; text-align: center; background: transparent; border: none; border-bottom: 2px solid transparent;
  font-family: inherit; min-width: 0; overflow: hidden; text-overflow: ellipsis; color: inherit; }
.vt-name:focus { outline: none; border-bottom-color: rgba(0,0,0,0.3); text-overflow: clip; }
.vt-progress { width: calc(100% - 2rem); margin: 0.5rem 1rem 0; height: 60px; background: rgba(255,255,255,0.5); border-radius: 5px; overflow: hidden;
  position: relative; border: 1px solid var(--on-urg-border); }
.vt-fill { height: 100%; border-radius: 5px; transition: width 1s linear, background 1s linear; }
.vt-progress-text { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; font-weight: bold; pointer-events: none; }
.vt-content { flex: 1; min-height: 0; padding: 1rem; display: flex; flex-direction: column; gap: 0.9rem; overflow-y: auto; }
.vt-content > * { flex-shrink: 0; }
.btn-row { display: flex; border: 1px solid var(--on-urg-border-strong); border-radius: 3px; overflow: hidden; flex-shrink: 0; }
.flat { flex: 1; padding: 0.65rem 0.5rem; border: none; border-right: 1px solid var(--on-urg-border-strong); border-radius: 0; background: var(--bg-btn);
  color: var(--text); font-size: 0.95rem; font-family: inherit; cursor: pointer; }
.flat:last-child { border-right: none; }
.flat:active { filter: brightness(0.85); }
.flat:disabled { opacity: 0.5; cursor: default; }
.flat.primary { background: #007bff; color: white; }
.flat.danger { background: #dc3545; color: white; }
.flat.success { background: #28a745; color: white; }
.flat.boxed { border-radius: 3px; border: 1px solid rgba(0,0,0,0.45); }
.vt-label { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--on-urg-muted); margin-bottom: 0.2rem; }
.vt-value { font-size: 0.95rem; }
.vt-editable { font-size: 0.95rem; cursor: pointer; display: flex; align-items: center; gap: 0.4rem; }
.vt-editable:hover { opacity: 0.75; }
.vt-closed { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.7rem 0.9rem; border-radius: 5px;
  background: var(--on-urg-overlay-strong); border: 1px solid var(--on-urg-border); font-size: 0.9rem; }
.vt-info { background: var(--on-urg-overlay); border-radius: 5px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.65rem; }
.vt-badge { display: inline-block; padding: 0.2rem 0.5rem; background: rgba(0,0,0,0.12); border-radius: 10px; font-size: 0.8rem; font-weight: 600; }
.vt-link { background: none; border: none; cursor: pointer; font-size: 0.85rem; color: var(--on-urg-muted); text-decoration: underline; }
.vt-pencil { background: none; border: none; cursor: pointer; font-size: 0.85rem; color: var(--on-urg-muted); padding: 0 0.25rem; line-height: 1; }
.vt-recur-edit { display: flex; flex-direction: column; gap: 0.75rem; padding: 0.75rem; background: var(--on-urg-overlay-strong); border-radius: 5px; border: 1px solid var(--on-urg-border); }
.vt-input { padding: 0.5rem 0.75rem; border: 1px solid var(--on-urg-border); border-radius: 3px; font-size: 0.9rem; background: var(--on-urg-input); color: var(--on-urg-text); }
.vt-input:focus { outline: none; }
.vt-hint { font-size: 0.75rem; margin-top: 0.25rem; min-height: 1.1em; color: var(--on-urg-muted); }
.vt-hint.valid { color: var(--on-urg-text); }
.vt-small-label { font-size: 0.75rem; color: var(--on-urg-muted); margin-bottom: 0.2rem; }
.vt-desc-input { width: 100%; box-sizing: border-box; resize: vertical; background: var(--on-urg-input); color: var(--on-urg-text);
  border: 1px solid var(--on-urg-border-strong); border-radius: 4px; padding: 0.4rem; font-family: monospace; font-size: 0.85rem; }
.chip.small { padding: 0.25rem 0.55rem; font-size: 0.78rem; }
.markdown { font-size: 0.9rem; line-height: 1.5; }
.markdown p { margin: 0 0 0.4rem; }
.markdown p:last-child { margin-bottom: 0; }
.markdown h1, .markdown h2, .markdown h3 { margin: 0.5rem 0 0.25rem; font-size: 1em; font-weight: 700; }
.markdown ul, .markdown ol { margin: 0.25rem 0; padding-left: 1.25rem; }
.markdown li { margin: 0.1rem 0; }
.markdown code { font-family: monospace; font-size: 0.85em; background: var(--on-urg-overlay); padding: 0.1em 0.3em; border-radius: 3px; }
.markdown pre { background: var(--on-urg-overlay); padding: 0.5rem; border-radius: 4px; overflow-x: auto; }
.markdown pre code { background: none; padding: 0; }
.markdown a { color: inherit; opacity: 0.8; }
.markdown strong { font-weight: 700; }
.markdown em { font-style: italic; }
.cal-toggle { background: none; border: none; cursor: pointer; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
  color: var(--on-urg-muted); padding: 0; text-align: left; }
.cal-toggle:hover { color: var(--on-urg-text); }
.cal-nav { display: flex; justify-content: space-between; align-items: center; }
.cal-nav-btn { background: var(--on-urg-overlay); border: 1px solid var(--on-urg-border); border-radius: 3px; cursor: pointer; font-size: 1.2rem; padding: 2px 8px; }
.cal-nav-btn:hover { background: var(--on-urg-overlay-strong); }
.cal-title { font-weight: 600; font-size: 0.9rem; }
.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
.cal-day-header { text-align: center; font-size: 0.65rem; font-weight: 600; color: var(--on-urg-muted); padding: 2px 0; }
.cal-day { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; border-radius: 3px; font-size: 0.8rem; color: var(--on-urg-text); font-weight: 400; }
.cal-day.colored { color: white; font-weight: 600; }
.cal-day.other { opacity: 0.4; filter: grayscale(0.5); font-weight: 400; }
.cal-note { font-size: 0.85rem; color: var(--on-urg-muted); padding: 0.5rem 0; }
.cal-key { display: flex; align-items: center; gap: 0.25rem; }
.cal-swatch { width: 10px; height: 10px; border-radius: 2px; display: inline-block; }
.vt-comments { display: flex; flex-direction: column; gap: 0.5rem; }
.vt-comment { background: var(--on-urg-overlay-strong); border-radius: 4px; padding: 0.5rem 0.6rem; }
.vt-comment-text { font-size: 0.9rem; white-space: pre-wrap; word-break: break-word; }
.vt-comment-meta { font-size: 0.7rem; color: var(--on-urg-muted); margin-top: 0.2rem; }
.vt-comment-row { display: flex; gap: 0.4rem; }
.vt-comment-input { flex: 1; padding: 0.5rem 0.75rem; border: 1px solid var(--on-urg-border); border-radius: 3px; font-size: 0.9rem; font-family: inherit;
  background: var(--on-urg-input); color: var(--on-urg-text); resize: none; }
.vt-comment-input:focus { outline: none; }
/* Event history, daily results */
.ev-page { display: flex; flex-direction: column; height: 100vh; }
.ev-header { display: flex; align-items: center; padding: 1rem; gap: 0.75rem; background: var(--bg-card); border-bottom: 1px solid var(--border); }
.ev-title { margin: 0; font-size: 1.1rem; flex: 1; }
.ev-scroll { flex: 1; overflow-y: auto; }
.ev-row { padding: 0.75rem 1rem; margin: 0.375rem 0.75rem; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 8px;
  display: flex; align-items: flex-start; gap: 0.75rem; box-sizing: border-box; }
.ev-row.skipped { background: var(--bg-card); opacity: 0.5; }
.ev-info { flex: 1; }
.ev-type { font-weight: 600; font-size: 0.9rem; }
.ev-meta { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem; }
.ev-seq { font-size: 0.7rem; color: var(--text-muted); min-width: 2rem; text-align: right; }
.ev-note { text-align: center; padding: 2rem; color: var(--text-muted); }
.ev-more { text-align: center; padding: 0.5rem; color: var(--text-muted); font-size: 0.85rem; }
.skip-btn { padding: 0.3rem 0.6rem; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-elevated); color: var(--text-muted);
  font-size: 0.75rem; cursor: pointer; white-space: nowrap; }
.skip-btn:hover { border-color: #4a9eff; }
.skip-btn.skipped { border-color: #4a9eff; background: var(--bg-accent); color: #4a9eff; }
.nav-btn { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 6px; cursor: pointer; font-size: 1.1rem; padding: 2px 10px; }
.nav-btn:hover { background: var(--bg-accent); }
.title-block { flex: 1; text-align: center; display: flex; flex-direction: column; align-items: center; }
.dr-title { margin: 0; font-size: 1.05rem; }
.today-btn { background: none; border: none; font-size: 0.75rem; color: var(--text-muted); text-decoration: underline; cursor: pointer; padding: 0; }

/* Joining by invite */
.join { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 2rem;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
.join-card { max-width: 400px; width: 100%; display: flex; flex-direction: column; gap: 1rem; }
.join-logo { width: 80px; height: 80px; object-fit: contain; align-self: center; margin-bottom: 0.5rem; }
.join-title { margin: 0; font-size: 1.5rem; font-weight: 700; color: #fff; text-align: center; }
.join-box { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); border-radius: 10px; padding: 1rem 1.25rem; text-align: center; }
.join-id { font-size: 0.9rem; font-family: monospace; color: #a0aec0; word-break: break-all; }
.join-note { font-size: 0.82rem; color: #a0aec0; margin: 0; text-align: center; }
.join-input { width: 100%; padding: 0.75rem 1rem; border: 2px solid #374151; border-radius: 8px; font-size: 1rem; background: #1f2937; color: #fff; box-sizing: border-box; }
.join-input:focus { outline: none; border-color: #4f46e5; }
.join-input::placeholder { color: #6b7280; }
.join-button { width: 100%; padding: 0.75rem; background: #4f46e5; color: white; border: none; border-radius: 8px; font-size: 1rem; cursor: pointer; font-weight: 600; }
.join-button:hover { background: #4338ca; }
.join-button:disabled { opacity: 0.5; cursor: not-allowed; }
.join-error { color: #f87171; font-size: 0.875rem; margin: 0; text-align: center; }
.join-success { color: #6ee7b7; font-size: 0.95rem; text-align: center; padding: 0.5rem 0; }
""";
