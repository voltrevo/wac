// The web client as a page: wac-web's builder, run from this project so that `web` resolves through its wac.json5.
//
//     wac run --allow-read --allow-write --allow-run tools/build_client.wac client/app.wac dist/client --title "Autonag 2"
import { Sys } from "std";
import { buildPage } from "webbuild";

export i32 main(Sys sys) { return buildPage(sys.args(), sys.stderr(), sys.stdout(), sys.files(), sys.procs()); }
