struct RecurOpts {
  string? anchor;
  string? tz;
  bool skipWeekends;
}

void cmdTimersRecurrenceSet(Cli c, string id, f64 days, RecurOpts opts) {
  if (!ready(c)) { return; }
  string? timerId = resolveTimerId(c, id);
  if (timerId is null) { return; }
  RecurrenceSpec r = RecurrenceSpec(days, opts.anchor ?? DEFAULT_ANCHOR_TIME, opts.tz ?? c.zoneName, opts.skipWeekends);
  if (batch(c, Obj.create().put("type", str("updateRecurrence")).put("timerId", str(timerId!)).put("recurrence", r.toJson()).done()) is null) { return; }
  if (c.json) { c.jsonOut(Obj.create().put("timerId", str(timerId!)).put("recurrence", r.toJson()).done()); return; }
  c.log("Timer \{shortId(timerId!)}… recurrence set to every \{jsNumber(days)}d at \{r.anchorTime} (\{r.timezone})");
}

void cmdTimersAnchor(Cli c, string id, string? anchorTime) {
  if (!ready(c)) { return; }
  JsonValue? state = getState(c);
  if (state is null) { return; }
  string? timerId = resolveTimerId(c, id);
  if (timerId is null) { return; }
  JsonValue? timer = timerById(state!, timerId!);
  if (timer is null) { c.fail("Timer not found: \{id}"); return; }
  bool recurring = truthy(timer!.member("recurrence"));
  if (anchorTime is null) {
    AnchorSpec effective = anchorFor(c, wireTimer(timer!), defaultAnchorOf(state!));
    string source = recurring ? "recurrence" : (truthy(timer!.member("anchorTime")) ? "timer" : "instance default");
    if (c.json) {
      c.jsonOut(Obj.create().put("timerId", str(timerId!)).put("anchorTime", orNull(timer!.member("anchorTime")))
        .put("effective", str(effective.anchorTime)).put("timezone", str(effective.timezone)).put("source", str(source)).done());
      return;
    }
    c.log("Anchor: \{effective.anchorTime} (\{source}, \{effective.timezone})");
    return;
  }
  if (recurring) { c.fail("Timer is recurring — set its anchor with \"timers recurrence set\" instead"); return; }
  bool clear = anchorTime! == "none" || anchorTime! == "default";
  if (!clear) {
    string? e = anchorTimeError(anchorTime!);
    if (e is not null) { c.fail("Invalid anchor: \{e!}"); return; }
  }
  JsonValue value = clear ? JsonValue.Null : str(anchorTime!);
  if (batch(c, Obj.create().put("type", str("setTimerAnchor")).put("timerId", str(timerId!)).put("anchorTime", value).done()) is null) { return; }
  if (c.json) { c.jsonOut(Obj.create().put("timerId", str(timerId!)).put("anchorTime", value).done()); return; }
  c.log(clear ? "Timer \{shortId(timerId!)}… anchor cleared (using the instance default)"
              : "Timer \{shortId(timerId!)}… anchor set to \{anchorTime!}");
}

void cmdTimersRecurrenceRemove(Cli c, string id) {
  if (!ready(c)) { return; }
  string? timerId = resolveTimerId(c, id);
  if (timerId is null) { return; }
  if (batch(c, Obj.create().put("type", str("removeRecurrence")).put("timerId", str(timerId!)).done()) is null) { return; }
  if (c.json) { c.jsonOut(Obj.create().put("timerId", str(timerId!)).done()); return; }
  c.log("Timer \{shortId(timerId!)}… recurrence removed");
}

void cmdTimersHistory(Cli c, string id) {
  if (!ready(c)) { return; }
  string? timerId = resolveTimerId(c, id);
  if (timerId is null) { return; }
  JsonArray entries = JsonArray.create();
  f64? cursor = 0.0;
  while (cursor is not null) {
    JsonValue? page = api(c, "GET", "/instances/\{c.cfgShow("instanceId")}/timers/\{timerId!}/history?after=\{jsNumber(cursor!)}", null, true);
    if (page is null) { return; }
    JsonArray evs = page!.member("events")?.array() ?? JsonArray.create();
    for (i32 i = 0; i < evs.len(); i++) {
      JsonValue ev = evs.get(i);
      string type = ev.member("type")?.text() ?? "";
      JsonValue p = orNull(ev.member("payload"));
      JsonValue date = orNull(ev.member("timestamp"));
      if (type == "TimerRecurred" || type == "TimerCompletionLogged") {
        JsonValue? o = p.member("occurredAt");
        if (o is not null && !o!.isNull()) { date = o!; }
      }
      Obj e = Obj.create().put("date", date);
      JsonValue? reason = p.member("closeReason");
      if (reason is not null) { e.put("closeReason", reason!); }
      entries.push(e.put("type", orNull(ev.member("type"))).done());
    }
    cursor = page!.member("nextCursor")?.number();
  }
  if (c.json) { c.jsonOut(JsonValue.Array(entries)); return; }
  if (entries.len() == 0) { c.log("No history yet."); return; }
  c.log("\{padEnd("Date", 22)}  \{padEnd("Reason", 16)}  Type");
  c.log(repeat("-", 56));
  for (i32 i = 0; i < entries.len(); i++) {
    JsonValue e = entries.get(i);
    string type = tpl(e.member("type"));
    string label = type == "TimerCompletionLogged" ? "logged" : (type == "TimerRecurred" ? "recurred" : "completed");
    JsonValue? reason = e.member("closeReason");
    if (reason is null || reason!.text() is null) { c.crash("Cannot read properties of undefined (reading 'slice')"); return; }
    c.log("\{col(c.fmtDate(e.member("date")?.number() ?? 0.0 / 0.0), 22, false)}  \{col(reason!.text()!, 16, false)}  \{label}");
  }
}

void cmdTimersLog(Cli c, string id, string reason, f64 at) {
  if (!ready(c)) { return; }
  JsonValue? state = getState(c);
  if (state is null) { return; }
  string? timerId = resolveTimerId(c, id);
  if (timerId is null) { return; }
  JsonValue? timer = timerById(state!, timerId!);
  if (timer is null) { c.fail("Timer not found: \{id}"); return; }
  if (batch(c, Obj.create().put("type", str("logCompletion")).put("timerId", str(timerId!)).put("closeReason", str(reason))
                 .put("occurredAt", num(at)).done()) is null) { return; }
  if (c.json) { c.jsonOut(Obj.create().put("timerId", str(timerId!)).put("closeReason", str(reason)).put("occurredAt", num(at)).done()); return; }
  c.log("Logged \"\{reason}\" for \"\{tpl(timer!.member("name"))}\" at \{c.fmtDate(at)}");
}

void cmdShush(Cli c, string? duration) {
  if (!ready(c)) { return; }
  f64 expiry = 0.0;
  if (duration is not null && duration!.len() > 0) {
    expiry = parseExactExpiry(c, duration!);
    if (c.halted) { return; }
  } else {
    expiry = (c.now() + 30 * 60 * 1000) as~ f64;
  }
  if (api(c, "POST", "/instances/\{c.cfgShow("instanceId")}/shush", Obj.create().put("expiry", num(expiry)).done(), true) is null) { return; }
  if (c.json) { c.jsonOut(Obj.create().put("expiry", num(expiry)).done()); return; }
  c.log("Alarm silenced until \{c.fmtDate(expiry)}");
}

void cmdUnshush(Cli c) {
  if (!ready(c)) { return; }
  if (api(c, "DELETE", "/instances/\{c.cfgShow("instanceId")}/shush", null, true) is null) { return; }
  if (c.json) { c.jsonOut(Obj.create().put("ok", JsonValue.Bool(true)).done()); return; }
  c.log("Shush cleared");
}

void cmdEventsList(Cli c, f64 from) {
  if (!ready(c)) { return; }
  JsonValue? r = api(c, "GET", "/instances/\{c.cfgShow("instanceId")}/events?from=\{jsNumber(from)}&limit=200", null, true);
  if (r is null) { return; }
  JsonValue events = orNull(r!.member("events"));
  if (c.json) { c.jsonOut(events); return; }
  JsonArray evs = events.array() ?? JsonArray.create();
  if (evs.len() == 0) { c.log("No events."); return; }
  c.log("\{padEnd("seq", 6)}  \{padEnd("ID", 10)}  \{padEnd("Type", 28)}  \{padEnd("Time", 20)}  Skipped");
  c.log(repeat("-", 78));
  for (i32 i = 0; i < evs.len(); i++) {
    JsonValue e = evs.get(i);
    string skipped = truthy(e.member("skipped")) ? "yes" : "";
    c.log("\{padEnd(tpl(e.member("seq")), 6)}  \{col(shortId(idOf(e)) + "…", 10, false)}  \{col(tpl(e.member("type")), 28, false)}  \{col(c.fmtDate(e.member("timestamp")?.number() ?? 0.0 / 0.0), 20, false)}  \{skipped}");
  }
}

void cmdEventsSkip(Cli c, string id, bool skip) {
  if (!ready(c)) { return; }
  string? eventId = resolveEventId(c, id);
  if (eventId is null) { return; }
  if (api(c, skip ? "POST" : "DELETE", "/instances/\{c.cfgShow("instanceId")}/events/\{eventId!}/skip", null, true) is null) { return; }
  if (c.json) { c.jsonOut(Obj.create().put("eventId", str(eventId!)).done()); return; }
  c.log("Event \{shortId(eventId!)}… \{skip ? "skipped" : "unskipped"}");
}

void cmdTimersView(Cli c, string id) {
  if (!ready(c)) { return; }
  string? timerId = resolveTimerId(c, id);
  if (timerId is null) { return; }
  JsonValue? state = getState(c);
  if (state is null) { return; }
  JsonValue? timer = timerById(state!, timerId!);
  if (timer is null) { c.fail("Timer not found: \{timerId!}"); return; }
  JsonValue? r = api(c, "GET", "/instances/\{c.cfgShow("instanceId")}/threads/\{timerId!}/comments", null, true);
  if (r is null) { return; }
  JsonValue comments = orNull(r!.member("comments"));
  if (c.json) {
    Obj o = Obj.create();
    JsonObject t = timer!.object()!;
    bool replaced = false;
    for (i32 i = 0; i < t.len(); i++) {
      if (t.at(i).keyStr() == "comments") { o.put("comments", comments); replaced = true; }
      else { o.putBytes(t.at(i).key, t.at(i).value); }
    }
    if (!replaced) { o.put("comments", comments); }
    c.jsonOut(o.done());
    return;
  }
  f64 now = c.now() as~ f64;
  f64 expiry = timer!.member("currentExpiry")?.number() ?? 0.0;
  f64 remaining = expiry - now;
  c.log("ID:          \{tpl(timer!.member("id"))}");
  c.log("Name:        \{tpl(timer!.member("name"))}");
  JsonValue? d = timer!.member("description");
  if (truthy(d)) {
    string desc = tpl(d);
    if (jsLength(desc) > 500) {
      c.log("Description: \{jsSlice(desc, 0, 497)}...");
      c.log("             (\{jsLength(desc)} chars total — run 'timers description \{shortId(timerId!)}' for full text)");
    } else {
      c.log("Description: \{desc}");
    }
  }
  c.log("Expires:     \{c.fmtDate(expiry)}  (\{remaining >= 0.0 ? "in " : ""}\{fmtCountdown(remaining)})");
  c.log("Created:     \{c.fmtDate(timer!.member("created")?.number() ?? 0.0 / 0.0)}");
  JsonValue? rec = timer!.member("recurrence");
  if (truthy(rec)) {
    string wknd = truthy(rec!.member("skipWeekends")) ? ", skip weekends" : "";
    c.log("Recurrence:  every \{tpl(rec!.member("periodDays"))}d at \{tpl(rec!.member("anchorTime"))} \{tpl(rec!.member("timezone"))}\{wknd}");
  }
  JsonArray cs = comments.array() ?? JsonArray.create();
  if (cs.len() > 0) {
    i32 start = cs.len() > 5 ? cs.len() - 5 : 0;
    string more = start > 0 ? "  (\{start} older — run 'comments list \{shortId(timerId!)}' to see all)" : "";
    c.log("\nComments:\{more}");
    for (i32 i = start; i < cs.len(); i++) {
      string text = tpl(cs.get(i).member("text"));
      if (jsLength(text) > 80) { text = jsSlice(text, 0, 77) + "..."; }
      c.log("  \{c.fmtDate(cs.get(i).member("createdAt")?.number() ?? 0.0 / 0.0)}  \{text}");
    }
  }
}

// comments.slice(-limit), with slice's handling of 0 and of a negative limit.
i32 sliceStart(i32 len, f64? limit) {
  if (limit is null) { return 0; }
  f64 s = -limit!;
  if (s == 0.0) { return 0; }
  if (s < 0.0) { f64 a = (len as f64) + s; return a < 0.0 ? 0 : a as~ i32; }
  return s > (len as f64) ? len : s as~ i32;
}

void cmdCommentsList(Cli c, string id, f64? limit) {
  if (!ready(c)) { return; }
  string? timerId = resolveTimerId(c, id);
  if (timerId is null) { return; }
  JsonValue? r = api(c, "GET", "/instances/\{c.cfgShow("instanceId")}/threads/\{timerId!}/comments", null, true);
  if (r is null) { return; }
  JsonArray cs = r!.member("comments")?.array() ?? JsonArray.create();
  i32 start = sliceStart(cs.len(), limit);
  if (c.json) {
    JsonArray shown = JsonArray.create();
    for (i32 i = start; i < cs.len(); i++) { shown.push(cs.get(i)); }
    c.jsonOut(JsonValue.Array(shown));
    return;
  }
  if (cs.len() == 0) { c.log("No comments."); return; }
  if (start > 0) { c.log("(\{start} older comments not shown)"); }
  for (i32 i = start; i < cs.len(); i++) {
    c.log("[\{c.fmtDate(cs.get(i).member("createdAt")?.number() ?? 0.0 / 0.0)}] \{tpl(cs.get(i).member("text"))}");
  }
}

void cmdCommentsAdd(Cli c, string id, string text) {
  if (!ready(c)) { return; }
  string? timerId = resolveTimerId(c, id);
  if (timerId is null) { return; }
  if (api(c, "POST", "/instances/\{c.cfgShow("instanceId")}/threads/\{timerId!}/comments", Obj.create().put("text", str(text)).done(), true) is null) { return; }
  if (c.json) { c.jsonOut(Obj.create().put("timerId", str(timerId!)).done()); return; }
  c.log("Comment added");
}

void printCompletions(Cli c, string title, JsonArray entries) {
  if (entries.len() == 0) { return; }
  c.log("\n\{title} (\{entries.len()})");
  for (i32 i = 0; i < entries.len(); i++) {
    JsonValue e = entries.get(i);
    JsonValue? n = e.member("name");
    string name = n is null || n!.isNull() ? "timer \{shortId(tpl(e.member("timerId")))}" : tpl(n);
    c.log("  \{col(name, 26, false)}  \{col(tpl(e.member("closeReason")), 10, false)}  \{c.fmtDate(e.member("occurredAt")?.number() ?? 0.0 / 0.0)}");
  }
}

void cmdResults(Cli c, string? date) {
  if (!ready(c)) { return; }
  f64 from = localDayStart(c, date);
  if (c.halted) { return; }
  f64 to = from + 86400000.0;
  JsonValue? r = api(c, "GET", "/instances/\{c.cfgShow("instanceId")}/daily-results?from=\{jsNumber(from)}&to=\{jsNumber(to)}", null, true);
  if (r is null) { return; }
  if (c.json) { c.jsonOut(r!); return; }
  JsonArray passed = r!.member("passed")?.array() ?? JsonArray.create();
  JsonArray failed = r!.member("failed")?.array() ?? JsonArray.create();
  JsonArray other = r!.member("other")?.array() ?? JsonArray.create();
  JsonArray deferred = r!.member("deferred")?.array() ?? JsonArray.create();
  string day = c.fmtDate(from);
  i32 comma = day.indexOf(",");
  c.log(comma < 0 ? day : day.slice(0, comma));
  if (passed.len() + failed.len() + other.len() + deferred.len() == 0) { c.log("Nothing happened this day."); return; }
  printCompletions(c, "Passed", passed);
  printCompletions(c, "Failed", failed);
  printCompletions(c, "Other", other);
  if (deferred.len() > 0) {
    c.log("\nDeferred (\{deferred.len()})");
    for (i32 i = 0; i < deferred.len(); i++) {
      JsonValue d = deferred.get(i);
      JsonValue? n = d.member("name");
      string name = n is null || n!.isNull() ? "timer \{shortId(tpl(d.member("timerId")))}" : tpl(n);
      c.log("  \{col(name, 26, false)}  → \{c.fmtDate(d.member("newExpiry")?.number() ?? 0.0 / 0.0)}");
    }
  }
}

// ── flags ──

struct Flags {
  Vec<string> positional;
  Map<string, string> values;
  Map<string, f64> numbers;
  Map<string, bool> set;

  string? text(this, string k) { return this.values.get(k); }
  f64? number(this, string k) { return this.numbers.get(k); }
  bool on(this, string k) { return this.set.has(k); }
}

// parseFlags: `schema` is "name:type" for each flag; null with the run halted on a bad one.
Flags? parseFlags(Cli c, Vec<string> args, string[] schema) {
  Flags f = Flags(Vec<string>.create(), Map.create(hashString, stringEq), Map.create(hashString, stringEq), Map.create(hashString, stringEq));
  for (i32 i = 0; i < args.len(); i++) {
    string a = args.get(i);
    if (!startsWith(a, "--")) { f.positional.push(a); continue; }
    string key = a.slice(2, a.len());
    string type = "";
    for (string s in schema) {
      i32 colon = s.indexOf(":");
      if (s.slice(0, colon) == key) { type = s.slice(colon + 1, s.len()); }
    }
    if (type == "") { c.fail("Unknown flag: --\{key}"); return null; }
    if (type == "boolean") { f.set.set(key, true); continue; }
    string? next = i + 1 < args.len() ? args.get(i + 1) : null;
    if (next is null || next!.len() == 0 || startsWith(next!, "--")) { c.fail("Flag --\{key} requires a value"); return null; }
    if (type == "int") {
      f64 n = jsToNumber(next!);
      if (!isInteger(n)) { c.fail("Flag --\{key} must be an integer, got: \"\{next!}\""); return null; }
      f.numbers.set(key, n);
    } else {
      f.values.set(key, next!);
    }
    f.set.set(key, true);
    i++;
  }
  return f;
}

string? at(Vec<string> xs, i32 i) { return i < xs.len() && xs.get(i).len() > 0 ? xs.get(i) : null; }

Vec<string> tail(Vec<string> xs, i32 from) {
  Vec<string> out = Vec<string>.create();
  for (i32 i = from; i < xs.len(); i++) { out.push(xs.get(i)); }
  return out;
}

// The json5 package's message for a parse failure: the character it stopped at, or the end, by line and
// column (counted in characters, from 1).
string json5Error(const u8[] src, string fault, i32 pos) {
  bool end = fault == "end of input" || pos >= src.len();
  i32 stop = end ? src.len() : pos;
  i32 line = 1;
  i32 col = 1;
  for (i32 i = 0; i < stop; i++) {
    if (src[i] == '\n') { line++; col = 1; }
    else if ((src[i] & 0xC0) != 0x80) { col++; }
  }
  if (end) { return "JSON5: invalid end of input at \{line}:\{col}"; }
  i32 w = 1;
  while (pos + w < src.len() && (src[pos + w] & 0xC0) == 0x80) { w++; }
  u8[] ch = u8[].filled(w, 0);
  ch.copyFrom(src, pos, 0, w);
  string c = string.fromBytes(ch);
  if (c == "'") { c = "\\'"; } else if (c == "\"") { c = "\\\""; } else if (c == "\\") { c = "\\\\"; }
  else if (c == "\n") { c = "\\n"; } else if (c == "\r") { c = "\\r"; } else if (c == "\t") { c = "\\t"; }
  else if (ch[0] < 0x20) {
    string hex = "0123456789abcdef";
    c = "\\x" + hex.slice((ch[0] >> 4) as i32, ((ch[0] >> 4) as i32) + 1) + hex.slice((ch[0] & 15) as i32, ((ch[0] & 15) as i32) + 1);
  }
  return "JSON5: invalid character '\{c}' at \{line}:\{col}";
}

// ── dispatch ──

// One run of `autonag <args>`.
export CliResult runCli(CliHost h, string[] rawArgs) {
  string configPath = h.home + "/.config/autonag/client.json5";
  Vec<string> top = Vec<string>.create();
  string? serverOverride = null;
  string? instanceOverride = null;
  bool json = false;
  Buf out = Buf.create();
  Buf err = Buf.create();
  for (i32 i = 0; i < rawArgs.len(); i++) {
    string a = rawArgs[i];
    bool valueNext = i + 1 < rawArgs.len() && rawArgs[i + 1].len() > 0 && !startsWith(rawArgs[i + 1], "-");
    if (a == "-h" || a == "--help") { return CliResult(HELP + "\n", "", 0); }
    else if (a == "-s" || a == "--server") {
      if (!valueNext) { return CliResult("", "Flag -s/--server requires a URL\n", 1); }
      i++;
      serverOverride = rawArgs[i];
    } else if (a == "-i" || a == "--instance") {
      if (!valueNext) { return CliResult("", "Flag -i/--instance requires an ID\n", 1); }
      i++;
      instanceOverride = rawArgs[i];
    } else if (a == "-c" || a == "--config") {
      if (!valueNext) { return CliResult("", "Flag -c/--config requires a path\n", 1); }
      i++;
      configPath = rawArgs[i];
    } else if (a == "--json") {
      json = true;
    } else {
      top.push(a);
    }
  }

  JsonObject cfg = JsonObject.create();
  u8[]? raw = h.readFile(configPath);
  if (raw is null) {
    cfg.push("server".toBytes(), str("http://localhost:3000"));
  } else {
    match (parseJson5(raw!)) {
      Ok(v): { if (v.object() is not null) { cfg = v.object()!; } }
      Err(e): { return CliResult("", "Config file \{configPath} is not valid JSON5: SyntaxError: \{json5Error(raw!, e.fault.name(), e.pos)}\n", 1); }
    }
  }
  string zoneName = canonicalZone(h.zones, h.tz);
  TimeZone? zone = h.zones.zone(zoneName);
  if (zone is null) { zone = TimeZone("UTC", i64[](), i32[](), [0 as i64], null); }
  Cli c = Cli(h, cfg, configPath, json, zoneName, zone!, out, err, 0, false);
  if (serverOverride is not null) { c.cfgSet("server", str(serverOverride!)); }
  if (instanceOverride is not null) { c.cfgSet("instanceId", str(instanceOverride!)); }
  dispatch(c, top);
  return CliResult(out.toStr(), err.toStr(), c.code);
}

void dispatch(Cli c, Vec<string> top) {
  string? cmd = at(top, 0);
  string? sub = at(top, 1);
  Vec<string> rest = tail(top, 2);
  // `!cmd` and `!sub`: an empty argument is as good as none.
  if (cmd is null || cmd! == "help") {
    if (parseFlags(c, rest, string[]()) is null) { return; }
    c.log(HELP);
  } else if (cmd! == "version") {
    if (c.json) { c.jsonOut(Obj.create().put("version", str(VERSION)).done()); } else { c.log(VERSION); }
  } else if (cmd! == "tutorial") {
    if (parseFlags(c, rest, string[]()) is null) { return; }
    c.log(TUTORIAL);
  } else if (cmd! == "register") {
    if (parseFlags(c, rest, string[]()) is null) { return; }
    if (sub is null) { c.fail("Usage: autonag register <nickname>"); return; }
    cmdRegister(c, sub!);
  } else if (cmd! == "status") {
    if (parseFlags(c, rest, string[]()) is null) { return; }
    cmdStatus(c);
  } else if (cmd! == "instances") {
    instances(c, sub, rest);
  } else if (cmd! == "timers") {
    timers(c, sub, rest);
  } else if (cmd! == "alarm") {
    if (sub is null || sub! != "show") { c.fail("Usage: autonag alarm show"); return; }
    if (parseFlags(c, rest, string[]()) is null) { return; }
    cmdAlarm(c);
  } else if (cmd! == "shush") {
    if (parseFlags(c, rest, string[]()) is null) { return; }
    cmdShush(c, top.len() > 1 ? top.get(1) : null);
  } else if (cmd! == "unshush") {
    if (parseFlags(c, rest, string[]()) is null) { return; }
    cmdUnshush(c);
  } else if (cmd! == "events") {
    if (sub is null || sub! == "list") {
      Flags? f = parseFlags(c, rest, ["from:int"]);
      if (f is null) { return; }
      cmdEventsList(c, f!.number("from") ?? 1.0);
    } else if (sub! == "skip" || sub! == "unskip") {
      Flags? f = parseFlags(c, rest, string[]());
      if (f is null) { return; }
      string? id = at(f!.positional, 0);
      if (id is null) { c.fail("Usage: autonag events \{sub!} <id>"); return; }
      cmdEventsSkip(c, id!, sub! == "skip");
    } else {
      c.fail("Unknown subcommand: events \{sub!}");
    }
  } else if (cmd! == "comments") {
    if (sub is null || sub! == "list") {
      Flags? f = parseFlags(c, rest, ["limit:int"]);
      if (f is null) { return; }
      string? id = at(f!.positional, 0);
      if (id is null) { c.fail("Usage: autonag comments list <timerId> [--limit N]"); return; }
      cmdCommentsList(c, id!, f!.number("limit"));
    } else if (sub! == "add") {
      Flags? f = parseFlags(c, rest, string[]());
      if (f is null) { return; }
      string? id = at(f!.positional, 0);
      string? text = at(f!.positional, 1);
      if (id is null || text is null) { c.fail("Usage: autonag comments add <timerId> <text>"); return; }
      cmdCommentsAdd(c, id!, text!);
    } else {
      c.fail("Unknown subcommand: comments \{sub!}");
    }
  } else if (cmd! == "results") {
    if (parseFlags(c, rest, string[]()) is null) { return; }
    cmdResults(c, sub);
  } else {
    c.err.pushStr("Unknown command: \{cmd!}\nRun \"autonag --help\" for usage.\n");
    c.code = 1;
    c.halted = true;
  }
}

void instances(Cli c, string? sub, Vec<string> rest) {
  if (sub is null || sub! == "list") {
    if (parseFlags(c, rest, string[]()) is null) { return; }
    cmdInstancesList(c);
    return;
  }
  string s = sub!;
  if (s != "request" && s != "join" && s != "select" && s != "anchor") { c.fail("Unknown subcommand: instances \{s}"); return; }
  Flags? f = parseFlags(c, rest, string[]());
  if (f is null) { return; }
  if (s == "anchor") { cmdInstancesAnchor(c, f!.positional.len() > 0 ? f!.positional.get(0) : null); return; }
  string? p = at(f!.positional, 0);
  if (p is null) {
    string usage = s == "request" ? "<nickname>" : (s == "join" ? "<instance-id>" : "<id>");
    c.fail("Usage: autonag instances \{s} \{usage}");
    return;
  }
  if (s == "request") { cmdInstancesRequest(c, p!); }
  else if (s == "join") { cmdInstancesJoin(c, p!); }
  else { cmdInstancesSelect(c, p!); }
}

f64? atFlag(Cli c, Flags f) {
  string? a = f.text("at");
  if (a is null) { return null; }
  return parseExactExpiry(c, a!);
}

void timers(Cli c, string? sub, Vec<string> rest) {
  if (sub is null || sub! == "list") {
    if (parseFlags(c, rest, string[]()) is null) { return; }
    cmdTimersList(c);
    return;
  }
  string s = sub!;
  if (s == "add") {
    Flags? f = parseFlags(c, rest, ["desc:string", "days:int", "anchor:string", "tz:string", "skip-weekends:boolean"]);
    if (f is null) { return; }
    string? name = at(f!.positional, 0);
    string? expiry = at(f!.positional, 1);
    if (name is null || expiry is null) {
      c.fail("Usage: autonag timers add <name> <expiry> [--desc <text>] [--days <n>] [--anchor <HH:MM>] [--tz <tz>] [--skip-weekends]");
      return;
    }
    cmdTimersAdd(c, name!, expiry!, AddOpts(f!.text("desc"), f!.number("days"), f!.text("anchor"), f!.text("tz"), f!.on("skip-weekends")));
  } else if (s == "rename" || s == "reschedule" || s == "snooze" || s == "describe") {
    Flags? f = parseFlags(c, rest, string[]());
    if (f is null) { return; }
    string? a = at(f!.positional, 0);
    string? b = at(f!.positional, 1);
    if (a is null || b is null) {
      string usage = s == "rename" ? "rename <id> <name>" : (s == "describe" ? "describe <id> <text>" : "reschedule <id> <expiry>");
      c.fail("Usage: autonag timers \{usage}");
      return;
    }
    if (s == "rename") { cmdTimersRename(c, a!, b!); }
    else if (s == "describe") { cmdTimersDescribe(c, a!, b!); }
    else { cmdTimersReschedule(c, a!, b!); }
  } else if (s == "pass" || s == "fail") {
    Flags? f = parseFlags(c, rest, ["at:string"]);
    if (f is null) { return; }
    string? id = at(f!.positional, 0);
    if (id is null) { c.fail("Usage: autonag timers \{s} <id> [--at <datetime>]"); return; }
    f64? when = atFlag(c, f!);
    if (c.halted) { return; }
    cmdTimersComplete(c, id!, s, when);
  } else if (s == "complete") {
    Flags? f = parseFlags(c, rest, ["at:string"]);
    if (f is null) { return; }
    string? id = at(f!.positional, 0);
    string? reason = at(f!.positional, 1);
    if (id is null || reason is null) { c.fail("Usage: autonag timers complete <id> <reason> [--at <datetime>]"); return; }
    f64? when = atFlag(c, f!);
    if (c.halted) { return; }
    cmdTimersComplete(c, id!, reason!, when);
  } else if (s == "remove" || s == "description" || s == "view" || s == "history") {
    Flags? f = parseFlags(c, rest, string[]());
    if (f is null) { return; }
    string? id = at(f!.positional, 0);
    if (id is null) { c.fail("Usage: autonag timers \{s} <id>"); return; }
    if (s == "remove") { cmdTimersRemove(c, id!); }
    else if (s == "description") { cmdTimersGetDescription(c, id!); }
    else if (s == "view") { cmdTimersView(c, id!); }
    else { cmdTimersHistory(c, id!); }
  } else if (s == "anchor") {
    Flags? f = parseFlags(c, rest, string[]());
    if (f is null) { return; }
    string? id = at(f!.positional, 0);
    if (id is null) { c.fail("Usage: autonag timers anchor <id> [<HH:MM>|none]"); return; }
    cmdTimersAnchor(c, id!, f!.positional.len() > 1 ? f!.positional.get(1) : null);
  } else if (s == "recurrence") {
    string? recSub = rest.len() > 0 ? rest.get(0) : null;
    if (recSub is not null && recSub! == "set") {
      Flags? f = parseFlags(c, rest, ["anchor:string", "tz:string", "skip-weekends:boolean"]);
      if (f is null) { return; }
      string? id = at(f!.positional, 1);
      string? daysText = at(f!.positional, 2);
      if (id is null || daysText is null) {
        c.fail("Usage: autonag timers recurrence set <id> <days> [--anchor <HH:MM>] [--tz <tz>] [--skip-weekends]");
        return;
      }
      f64 days = jsToNumber(daysText!);
      if (!isInteger(days) || days <= 0.0) { c.fail("<days> must be a positive integer, got: \"\{daysText!}\""); return; }
      cmdTimersRecurrenceSet(c, id!, days, RecurOpts(f!.text("anchor"), f!.text("tz"), f!.on("skip-weekends")));
    } else if (recSub is not null && recSub! == "remove") {
      Flags? f = parseFlags(c, rest, string[]());
      if (f is null) { return; }
      string? id = at(f!.positional, 1);
      if (id is null) { c.fail("Usage: autonag timers recurrence remove <id>"); return; }
      cmdTimersRecurrenceRemove(c, id!);
    } else {
      c.fail("Usage: autonag timers recurrence set|remove ...");
    }
  } else if (s == "log") {
    Flags? f = parseFlags(c, rest, ["at:string"]);
    if (f is null) { return; }
    string? id = at(f!.positional, 0);
    string? reason = at(f!.positional, 1);
    if (id is null || reason is null) { c.fail("Usage: autonag timers log <id> <reason> --at <datetime>"); return; }
    string? a = f!.text("at");
    if (a is null) { c.fail("--at <datetime> is required for timers log"); return; }
    f64 when = parseExactExpiry(c, a!);
    if (c.halted) { return; }
    cmdTimersLog(c, id!, reason!, when);
  } else {
    c.fail("Unknown subcommand: timers \{s}");
  }
}
