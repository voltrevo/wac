// autonag's command-line client: a port of shared/cli.ts and shared/apiClient.ts, printing what they print.
//
// The CLI is a function of its arguments and a `CliHost` — the clock, HTTP, the config file, the zones —
// rather than a program, so the same code runs as cmd/cli.wac over the network and in test/cli_test.wac
// against the API in-process, with the clock fixed.
//
// autonag's CLI leaves through `process.exit` from wherever it is; here a command stops by setting `halted`
// and every caller returns when a call it made has halted. A failed API call is autonag's ApiError,
// reported as "Error: <message>"; a failure JavaScript would throw past the CLI's handler (an unreachable
// server, a time zone Intl refuses) is reported as "error: <what>" with exit code 1, where Bun would print a
// stack trace.

import { Buf, Result, Vec, Map, hashString, stringEq } from "core";
import { json.JsonValue, json.JsonObject, json.JsonArray, json.JsonMember, json.parse, json.parseJson5, json.stringify } from "wac";
import { TimeZone, Zones } from "../time/tz.wac";
import { LocalDate, localDateParts, localToUtc, DEFAULT_ANCHOR_TIME, anchorTimeError } from "../time/anchor.wac";
import { AnchorSpec, ParsedDuration, parseDuration, resolveDuration, resolveAnchor, nextRecurrenceExpiry } from "../time/duration.wac";
import { RecurrenceSpec, Timer, timerFrom, recurrenceFrom } from "../model/events.wac";
import { Obj, num, str } from "../model/jsonkit.wac";
import { jsNumber } from "../model/jsstring.wac";
import { jsToNumber, isInteger, jsLength, jsSlice, jsSliceEnd, padEnd, repeat, localeString, isIsoShape, parseIsoShape,
         canonicalZone, prettyJson, json5Stringify } from "./jsfmt.wac";
import { HELP, TUTORIAL } from "./texts.wac";

export static string VERSION = "0.4.1";

export struct Reply {
  i32 status;
  u8[] body;
}

// What the CLI needs from where it runs.
export struct CliHost {
  fn<i64()> now;
  // method, absolute URL, header lines, body: the response, or why there is none.
  fn<Result<Reply, string>(string, string, string[], u8[])> http;
  Zones zones;
  string tz;                               // the TZ setting, as given
  string home;                             // os.homedir()
  fn<u8[]?(string)> readFile;              // null when the file does not exist
  fn<string?(string, u8[])> writeFile;     // creates the directories; an error, or null
}

// What a run printed and how it ended.
export struct CliResult {
  string stdout;
  string stderr;
  i32 code;
}

struct Cli {
  CliHost h;
  JsonObject cfg;
  string configPath;
  bool json;
  string zoneName;      // Intl.DateTimeFormat().resolvedOptions().timeZone
  TimeZone zone;
  Buf out;
  Buf err;
  i32 code;
  bool halted;

  void log(this, string s) { this.out.pushStr(s + "\n"); }

  // console.error and process.exit(1).
  void fail(this, string s) {
    this.err.pushStr(s + "\n");
    this.code = 1;
    this.halted = true;
  }

  // What JavaScript would throw past the CLI's handler.
  void crash(this, string s) { this.fail("error: " + s); }

  void jsonOut(this, JsonValue v) { this.log(prettyJson(v)); }

  string? cfgText(this, string key) {
    JsonValue? v = this.cfg.getStr(key);
    return v is null ? null : v!.text();
  }

  // A config value as a template literal writes it.
  string cfgShow(this, string key) { return tpl(this.cfg.getStr(key)); }

  void cfgSet(this, string key, JsonValue v) {
    for (i32 i = 0; i < this.cfg.len(); i++) {
      if (this.cfg.at(i).keyStr() == key) { JsonMember m = this.cfg.at(i); m.value = v; return; }
    }
    this.cfg.push(key.toBytes(), v);
  }

  i64 now(this) { return this.h.now(); }

  string fmtDate(this, f64 ms) { return localeString(ms, this.zone); }

  TimeZone? zoneNamed(this, string name) {
    TimeZone? z = this.h.zones.zone(name);
    if (z is null) { this.crash("Invalid time zone specified: \{name}"); }
    return z;
  }
}

// A value as `${v}` writes it.
string tpl(JsonValue? v) {
  if (v is null) { return "undefined"; }
  match (v!) {
    Null: { return "null"; }
    Bool(b): { return b ? "true" : "false"; }
    Number(x, raw): { return jsNumber(x); }
    Str(bytes): { return string.fromBytes(bytes); }
    Array(items): { return "[array]"; }
    Object(m): { return "[object Object]"; }
  }
}

// JavaScript truthiness of a JSON value (absent is falsy).
bool truthy(JsonValue? v) {
  if (v is null) { return false; }
  match (v!) {
    Null: { return false; }
    Bool(b): { return b; }
    Number(x, raw): { return x == x && x != 0.0; }
    Str(bytes): { return bytes.len() > 0; }
    default: { return true; }
  }
}

JsonValue orNull(JsonValue? v) { return v is null ? JsonValue.Null : v!; }

string shortId(string id) { return jsSlice(id, 0, 8); }

string col(string s, i32 w, bool ellipsis) {
  if (ellipsis && jsLength(s) > w) { return jsSlice(s, 0, w - 1) + "…"; }
  return padEnd(jsSlice(s, 0, w), w);
}

bool startsWith(string s, string p) { return s.len() >= p.len() && s.slice(0, p.len()) == p; }

bool uuidShaped(string s) {
  u8[] b = s.toBytes();
  if (b.len() != 36) { return false; }
  for (u8 c in b) { if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || c == '-')) { return false; } }
  return true;
}

string fmtCountdown(f64 ms) {
  string sign = ms < 0.0 ? "-" : "";
  f64 abs = ms < 0.0 ? -ms : ms;
  i64 totalSec = (abs / 1000.0).floor() as~ i64;
  i64 d = totalSec / 86400;
  i64 h = (totalSec % 86400) / 3600;
  i64 m = (totalSec % 3600) / 60;
  i64 s = totalSec % 60;
  if (d > 0) { return "\{sign}\{d}d \{h}h"; }
  if (h > 0) { return "\{sign}\{h}h \{m}m"; }
  if (m > 0) { return "\{sign}\{m}m \{s}s"; }
  return "\{sign}\{s}s";
}

// ── the API ──

// apiFetch: the response's JSON, or null with the run halted.
JsonValue? api(Cli c, string method, string path, JsonValue? body, bool withToken) {
  string[] headers = ["Content-Type: application/json"];
  string? tok = withToken ? c.cfgText("token") : null;
  if (tok is not null && tok!.len() > 0) { headers = ["Content-Type: application/json", "Authorization: Bearer \{tok!}"]; }
  u8[] payload = body is null ? u8[]() : stringify(body!);
  match (c.h.http(method, c.cfgShow("server") + path, headers, payload)) {
    Err(e): { c.crash("fetch failed: \{e}"); return null; }
    Ok(res): {
      JsonValue? parsed = parse(res.body).ok();
      if (res.status < 200 || res.status > 299) {
        string message = "HTTP \{res.status}";
        if (parsed is not null && parsed!.object() is not null) {
          JsonValue? e = parsed!.member("error");
          if (truthy(e)) { message = tpl(e); }
        }
        c.fail("Error: \{message}");
        return null;
      }
      if (parsed is null) { c.crash("the response from \{path} is not JSON"); }
      return parsed;
    }
  }
}

JsonValue? getState(Cli c) { return api(c, "GET", "/instances/\{c.cfgShow("instanceId")}/state", null, true); }

JsonValue? batch(Cli c, JsonValue action) {
  JsonArray a = JsonArray.create();
  a.push(action);
  return api(c, "POST", "/instances/\{c.cfgShow("instanceId")}/actions", Obj.create().put("actions", JsonValue.Array(a)).done(), true);
}

JsonArray timersOf(JsonValue state) { return state.member("timers")?.array() ?? JsonArray.create(); }

string idOf(JsonValue v) { return v.member("id")?.text() ?? ""; }

JsonValue? timerById(JsonValue state, string id) {
  JsonArray ts = timersOf(state);
  for (i32 i = 0; i < ts.len(); i++) { if (idOf(ts.get(i)) == id) { return ts.get(i); } }
  return null;
}

// ── ids ──

string? ambiguous(Cli c, string prefix, Vec<string> shown) {
  string list = "";
  for (i32 i = 0; i < shown.len(); i++) { list += (i > 0 ? ", " : "") + shown.get(i); }
  c.fail("Ambiguous prefix \"\{prefix}\" matches: \{list}");
  return null;
}

string? resolveTimerId(Cli c, string prefix) {
  if (uuidShaped(prefix)) { return prefix; }
  JsonValue? state = getState(c);
  if (state is null) { return null; }
  JsonArray ts = timersOf(state!);
  Vec<string> ids = Vec<string>.create();
  for (i32 i = 0; i < ts.len(); i++) { if (startsWith(idOf(ts.get(i)), prefix)) { ids.push(idOf(ts.get(i))); } }
  if (ids.len() == 0) { c.fail("Timer not found: \{prefix}"); return null; }
  if (ids.len() > 1) {
    Vec<string> shown = Vec<string>.create();
    for (i32 k = 0; k < ids.len(); k++) { shown.push(shortId(ids.get(k)) + "…"); }
    return ambiguous(c, prefix, shown);
  }
  return ids.get(0);
}

string? resolveEventId(Cli c, string prefix) {
  if (uuidShaped(prefix)) { return prefix; }
  Vec<string> all = Vec<string>.create();
  f64 from = 1.0;
  while (true) {
    JsonValue? page = api(c, "GET", "/instances/\{c.cfgShow("instanceId")}/events?from=\{jsNumber(from)}&limit=200", null, true);
    if (page is null) { return null; }
    JsonArray evs = page!.member("events")?.array() ?? JsonArray.create();
    for (i32 i = 0; i < evs.len(); i++) { all.push(idOf(evs.get(i))); }
    if (evs.len() < 200) { break; }
    f64 lastSeq = evs.get(evs.len() - 1).member("seq")?.number() ?? 0.0;
    if (lastSeq >= (page!.member("latestSeq")?.number() ?? 0.0)) { break; }
    from = lastSeq + 1.0;
  }
  Vec<string> ids = Vec<string>.create();
  for (i32 k = 0; k < all.len(); k++) { if (startsWith(all.get(k), prefix)) { ids.push(all.get(k)); } }
  if (ids.len() == 0) { c.fail("Event not found: \{prefix}"); return null; }
  if (ids.len() > 1) {
    Vec<string> shown = Vec<string>.create();
    for (i32 k = 0; k < ids.len(); k++) { shown.push(shortId(ids.get(k)) + "…"); }
    return ambiguous(c, prefix, shown);
  }
  return ids.get(0);
}

string? resolveInstanceId(Cli c, string prefix) {
  if (uuidShaped(prefix)) { return prefix; }
  JsonValue? r = api(c, "GET", "/instances", null, true);
  if (r is null) { return null; }
  JsonArray insts = r!.member("instances")?.array() ?? JsonArray.create();
  Vec<JsonValue> hits = Vec<JsonValue>.create();
  for (i32 i = 0; i < insts.len(); i++) { if (startsWith(idOf(insts.get(i)), prefix)) { hits.push(insts.get(i)); } }
  if (hits.len() == 0) { c.fail("Instance not found: \{prefix}"); return null; }
  if (hits.len() > 1) {
    Vec<string> shown = Vec<string>.create();
    for (i32 k = 0; k < hits.len(); k++) { shown.push("\"\{tpl(hits.get(k).member("nickname"))}\" (\{shortId(idOf(hits.get(k)))}…)"); }
    return ambiguous(c, prefix, shown);
  }
  return idOf(hits.get(0));
}

// ── guards ──

bool requireToken(Cli c) {
  if (!truthy(c.cfg.getStr("token"))) { c.fail("Not registered. Run: autonag register <nickname>"); return false; }
  return true;
}

bool requireInstance(Cli c) {
  if (!truthy(c.cfg.getStr("instanceId"))) { c.fail("No instance selected. Run: autonag instances select <id>"); return false; }
  return true;
}

bool ready(Cli c) { return requireToken(c) && requireInstance(c); }

// ── expiries ──

static string EXPIRY_SYNTAX = "Use: 1d, 1w, 1mo, 30m, 2h, 90s (relative duration, combinable as 1w2d or 1d12h), 2026-05-01T09:00:00Z (ISO 8601 with timezone), or unix-ms:<n>";

struct ExpirySpec {
  bool absolute;
  f64 ms;
  ParsedDuration? parsed;
}

ExpirySpec? parseExpirySpec(Cli c, string input) {
  if (startsWith(input, "unix-ms:")) {
    f64 n = jsToNumber(input.slice(8, input.len()));
    if (!isInteger(n) || n <= 0.0) { c.fail("Invalid expiry \"\{input}\". Use unix-ms:<positive-integer>"); return null; }
    return ExpirySpec(true, n, null);
  }
  if (isIsoShape(input)) {
    f64 ms = parseIsoShape(input);
    if (ms != ms) { c.fail("Invalid datetime \"\{input}\""); return null; }
    return ExpirySpec(true, ms, null);
  }
  ParsedDuration? p = parseDuration(input);
  if (p is not null) { return ExpirySpec(false, 0.0, p); }
  c.fail("Cannot parse expiry \"\{input}\". \{EXPIRY_SYNTAX}");
  return null;
}

// The instant; NaN when the run halted (a zone Intl would refuse).
f64 resolveExpirySpec(Cli c, ExpirySpec spec, AnchorSpec? anchor) {
  if (spec.absolute) { return spec.ms; }
  f64 base = c.now() as~ f64;
  if (anchor is null) { return base + spec.parsed!.ms; }
  if (spec.parsed!.hasSubDayUnit) { return base + spec.parsed!.ms; }
  TimeZone? z = c.zoneNamed(anchor!.timezone);
  if (z is null) { return 0.0 / 0.0; }
  return resolveDuration(spec.parsed!, base, anchor!, z!);
}

f64 parseExactExpiry(Cli c, string input) {
  ExpirySpec? s = parseExpirySpec(c, input);
  if (s is null) { return 0.0 / 0.0; }
  return resolveExpirySpec(c, s!, null);
}

AnchorSpec anchorFor(Cli c, Timer? timer, string? instanceDefault) {
  return resolveAnchor(timer, instanceDefault, c.cfgText("timezone") ?? c.zoneName);
}

// A timer on the wire as the anchor rules read it.
Timer? wireTimer(JsonValue t) { return timerFrom(t).ok(); }

string? defaultAnchorOf(JsonValue state) { return state.member("defaultAnchorTime")?.text(); }

i64 digits(const u8[] b, i32 at, i32 n) {
  i64 v = 0;
  for (i32 i = at; i < at + n; i++) { v = v * 10 + (b[i] - '0') as i64; }
  return v;
}

// Local midnight of "today", "yesterday" or YYYY-MM-DD; NaN when the run halted.
f64 localDayStart(Cli c, string? input) {
  i64 now = c.now();
  if (input is null || input! == "today" || input! == "yesterday") {
    i64 at = input is not null && input! == "yesterday" ? now - 86400000 : now;
    LocalDate d = localDateParts(at, c.zone);
    return localToUtc(d.year, d.month, d.day, 0, 0, c.zone) as~ f64;
  }
  u8[] b = input!.toBytes();
  bool ok = b.len() == 10 && b[4] == '-' && b[7] == '-';
  for (i32 i = 0; i < b.len() && ok; i++) { if (i != 4 && i != 7 && (b[i] < '0' || b[i] > '9')) { ok = false; } }
  if (!ok) { c.fail("Cannot parse date \"\{input!}\". Use: today, yesterday, or YYYY-MM-DD"); return 0.0 / 0.0; }
  i64 y = digits(b, 0, 4);
  i64 m = digits(b, 5, 2);
  i64 d = digits(b, 8, 2);
  return localToUtc(y, m, d, 0, 0, c.zone) as~ f64;
}

// ── commands ──

void saveConfig(Cli c) {
  string? e = c.h.writeFile(c.configPath, json5Stringify(JsonValue.Object(c.cfg)).toBytes());
  if (e is not null) { c.crash(e!); }
}

void cmdRegister(Cli c, string nickname) {
  JsonValue? r = api(c, "POST", "/devices/request", Obj.create().put("nickname", str(nickname)).done(), false);
  if (r is null) { return; }
  JsonValue device = orNull(r!.member("device"));
  c.cfgSet("token", orNull(r!.member("token")));
  c.cfgSet("deviceId", orNull(device.member("id")));
  saveConfig(c);
  if (c.halted) { return; }
  if (c.json) {
    c.jsonOut(Obj.create().put("deviceId", orNull(device.member("id"))).put("nickname", str(nickname))
      .put("token", orNull(r!.member("token"))).put("configPath", str(c.configPath)).done());
    return;
  }
  c.log("Registered as \"\{nickname}\" (\{shortId(tpl(device.member("id")))}…)");
  c.log("Token saved to \{c.configPath}");
  c.log("Waiting for admin approval — run \"autonag status\" to check.");
}

void cmdStatus(Cli c) {
  if (c.json) {
    Obj result = Obj.create();
    JsonValue? server = c.cfg.getStr("server");
    if (server is not null) { result.put("server", server!); }
    result.put("configPath", str(c.configPath)).put("instanceId", orNull(c.cfg.getStr("instanceId")));
    if (!truthy(c.cfg.getStr("token"))) { result.put("auth", JsonValue.Null); c.jsonOut(result.done()); return; }
    JsonValue? me = meOrInvalid(c);
    if (c.halted) { return; }
    if (me is null) {
      result.put("auth", Obj.create().put("error", str("invalid_token")).done());
    } else {
      JsonValue d = orNull(me!.member("device"));
      JsonValue? at = d.member("approvedAt");
      result.put("auth", Obj.create().put("nickname", orNull(d.member("nickname"))).put("deviceId", orNull(d.member("id")))
        .put("approved", JsonValue.Bool(truthy(at))).put("approvedAt", orNull(at)).done());
    }
    c.jsonOut(result.done());
    return;
  }
  c.log("Server:   \{c.cfgShow("server")}");
  c.log("Config:   \{c.configPath}");
  if (!truthy(c.cfg.getStr("token"))) {
    c.log("Auth:     not registered (run: autonag register <nickname>)");
    return;
  }
  JsonValue? me = meOrInvalid(c);
  if (c.halted) { return; }
  if (me is null) {
    c.log("Auth:     token invalid or expired");
  } else {
    JsonValue d = orNull(me!.member("device"));
    JsonValue? at = d.member("approvedAt");
    string status = truthy(at) ? "approved \{c.fmtDate(at!.number() ?? 0.0)}" : "PENDING APPROVAL";
    c.log("Auth:     \{tpl(d.member("nickname"))} (\{shortId(tpl(d.member("id")))}…) [\{status}]");
  }
  JsonValue? inst = c.cfg.getStr("instanceId");
  c.log("Instance: \{inst is null || inst!.isNull() ? "none selected (run: autonag instances select <id>)" : tpl(inst)}");
}

// GET /devices/me, with a 401 answered as null rather than as an error.
JsonValue? meOrInvalid(Cli c) {
  string[] headers = ["Content-Type: application/json", "Authorization: Bearer \{c.cfgText("token") ?? ""}"];
  match (c.h.http("GET", c.cfgShow("server") + "/devices/me", headers, u8[]())) {
    Err(e): { c.crash("fetch failed: \{e}"); return null; }
    Ok(res): {
      if (res.status == 401) { return null; }
      if (res.status < 200 || res.status > 299) {
        JsonValue? parsed = parse(res.body).ok();
        string message = "HTTP \{res.status}";
        if (parsed is not null && parsed!.object() is not null && truthy(parsed!.member("error"))) { message = tpl(parsed!.member("error")); }
        c.fail("Error: \{message}");
        return null;
      }
      return parse(res.body).ok();
    }
  }
}

void cmdInstancesList(Cli c) {
  if (!requireToken(c)) { return; }
  JsonValue? r = api(c, "GET", "/instances", null, true);
  if (r is null) { return; }
  JsonArray insts = r!.member("instances")?.array() ?? JsonArray.create();
  string? selected = c.cfgText("instanceId");
  if (c.json) {
    JsonArray out = JsonArray.create();
    for (i32 i = 0; i < insts.len(); i++) {
      JsonValue x = insts.get(i);
      out.push(Obj.create().put("id", orNull(x.member("id"))).put("nickname", orNull(x.member("nickname")))
        .put("approved", JsonValue.Bool(truthy(x.member("approvedAt")))).put("approvedAt", orNull(x.member("approvedAt")))
        .put("selected", JsonValue.Bool(selected is not null && idOf(x) == selected!)).done());
    }
    c.jsonOut(JsonValue.Array(out));
    return;
  }
  if (insts.len() == 0) { c.log("No accessible instances."); return; }
  for (i32 i = 0; i < insts.len(); i++) {
    JsonValue x = insts.get(i);
    string status = truthy(x.member("approvedAt")) ? "active" : "PENDING";
    string marker = selected is not null && idOf(x) == selected! ? " *" : "  ";
    c.log("\{marker} \{shortId(idOf(x))}…  \"\{tpl(x.member("nickname"))}\"  [\{status}]");
  }
  c.log("\n* = current default");
}

void cmdInstancesRequest(Cli c, string nickname) {
  if (!requireToken(c)) { return; }
  JsonValue? r = api(c, "POST", "/instances/request", Obj.create().put("nickname", str(nickname)).done(), true);
  if (r is null) { return; }
  JsonValue inst = orNull(r!.member("instance"));
  if (c.json) { c.jsonOut(Obj.create().put("instanceId", orNull(inst.member("id"))).put("nickname", orNull(inst.member("nickname"))).done()); return; }
  c.log("Requested instance \"\{tpl(inst.member("nickname"))}\" (\{shortId(tpl(inst.member("id")))}…)");
  c.log("Waiting for admin approval.");
}

void cmdInstancesSelect(Cli c, string id) {
  if (!requireToken(c)) { return; }
  string? instanceId = resolveInstanceId(c, id);
  if (instanceId is null) { return; }
  c.cfgSet("instanceId", str(instanceId!));
  saveConfig(c);
  if (c.halted) { return; }
  if (c.json) { c.jsonOut(Obj.create().put("instanceId", str(instanceId!)).done()); return; }
  c.log("Default instance set to \{instanceId!}");
}

void cmdInstancesAnchor(Cli c, string? anchorTime) {
  if (!ready(c)) { return; }
  if (anchorTime is null) {
    JsonValue? state = getState(c);
    if (state is null) { return; }
    string? def = defaultAnchorOf(state!);
    string effective = def ?? DEFAULT_ANCHOR_TIME;
    string tz = anchorFor(c, null, def).timezone;
    if (c.json) {
      c.jsonOut(Obj.create().put("defaultAnchorTime", def is null ? JsonValue.Null : str(def!)).put("effective", str(effective))
        .put("timezone", str(tz)).done());
      return;
    }
    c.log("Default anchor: \{effective}\{def is not null && def!.len() > 0 ? "" : " (unset — built-in default)"}");
    c.log("Interpreted in: \{tz}");
    return;
  }
  string? e = anchorTimeError(anchorTime!);
  if (e is not null) { c.fail("Invalid anchor: \{e!}"); return; }
  if (batch(c, Obj.create().put("type", str("setDefaultAnchor")).put("anchorTime", str(anchorTime!)).done()) is null) { return; }
  if (c.json) { c.jsonOut(Obj.create().put("defaultAnchorTime", str(anchorTime!)).done()); return; }
  c.log("Default anchor set to \{anchorTime!}");
}

void cmdInstancesJoin(Cli c, string instanceId) {
  if (!requireToken(c)) { return; }
  if (api(c, "POST", "/instances/\{instanceId}/access/request", Obj.create().done(), true) is null) { return; }
  if (c.json) { c.jsonOut(Obj.create().put("instanceId", str(instanceId)).done()); return; }
  c.log("Access requested for instance \{shortId(instanceId)}…");
  c.log("An admin will need to approve your request.");
  c.log("Once approved, run: autonag instances select \{instanceId}");
}

void cmdTimersList(Cli c) {
  if (!ready(c)) { return; }
  JsonValue? state = getState(c);
  if (state is null) { return; }
  if (c.json) {
    c.jsonOut(Obj.create().put("timers", orNull(state!.member("timers"))).put("alarm", orNull(state!.member("alarm")))
      .put("shush", orNull(state!.member("shush"))).done());
    return;
  }
  f64 now = c.now() as~ f64;
  JsonArray ts = timersOf(state!);
  // A stable sort by expiry, as Array.prototype.sort insts.
  JsonValue[] sorted = JsonValue[].filled(ts.len(), JsonValue.Null);
  for (i32 i = 0; i < ts.len(); i++) {
    JsonValue t = ts.get(i);
    f64 e = t.member("currentExpiry")?.number() ?? 0.0;
    i32 k = i;
    while (k > 0 && (sorted[k - 1].member("currentExpiry")?.number() ?? 0.0) > e) { sorted[k] = sorted[k - 1]; k--; }
    sorted[k] = t;
  }
  if (sorted.len() == 0) {
    c.log("No active timers.");
  } else {
    c.log("\{padEnd("ID", 10)}  \{padEnd("Name", 24)}  \{padEnd("Remaining", 16)}  Recur");
    c.log(repeat("-", 60));
    for (JsonValue t in sorted) {
      f64 remaining = (t.member("currentExpiry")?.number() ?? 0.0) - now;
      string label = remaining < 0.0 ? "OVERDUE \{fmtCountdown(remaining)}" : "in \{fmtCountdown(remaining)}";
      string recur = truthy(t.member("recurrence")) ? "↻" : "";
      c.log("\{col(shortId(idOf(t)) + "…", 10, false)}  \{col(tpl(t.member("name")), 24, true)}  \{col(label, 16, false)}  \{recur}");
    }
  }
  c.log("");
  printAlarmStatus(c, state!, now);
}

void printAlarmStatus(Cli c, JsonValue state, f64 now) {
  JsonValue alarm = orNull(state.member("alarm"));
  JsonValue? shush = state.member("shush");
  f64? shushExpiry = shush is null ? null : shush!.member("expiry")?.number();
  bool shushed = shushExpiry is not null && shushExpiry! > now;
  f64? startsAt = alarm.member("startsAt")?.number();
  string urgent = tpl(alarm.member("urgentName"));
  if (startsAt is not null) {
    f64 diff = startsAt! - now;
    string color = alarm.member("color")?.text() ?? tpl(alarm.member("color"));
    string label = color;
    if (color == "blue") { label = "off"; }
    else if (color == "flashing") { label = "FLASHING"; }
    string timeStr = diff <= 0.0 ? "overdue \{fmtCountdown(diff)}" : "in \{fmtCountdown(diff)}";
    c.log("[\{label}] \"\{urgent}\" — \{timeStr}");
  }
  if (alarm.member("on")?.boolean() ?? false) {
    c.log("Alarm: ringing.");
  } else if (shushed) {
    bool overdue = startsAt is not null && startsAt! <= now;
    bool endsAfter = startsAt is not null && shushExpiry! >= startsAt!;
    if (overdue || endsAfter) {
      c.log("Alarm: off. Will ring in \{fmtCountdown(shushExpiry! - now)}: Shush expires: \{urgent}.");
    } else if (startsAt is not null) {
      c.log("Alarm: off. Will ring in \{fmtCountdown(startsAt! - now)}: \{urgent}. (Shushed unnecessarily for \{fmtCountdown(shushExpiry! - now)}.)");
    } else {
      c.log("Alarm: off. Shushed (unnecessarily) for \{fmtCountdown(shushExpiry! - now)}.");
    }
  } else if (startsAt is not null) {
    c.log("Alarm: off. Will ring in \{fmtCountdown(startsAt! - now)}: \{urgent}.");
  } else {
    c.log("Alarm: off.");
  }
}

void cmdAlarm(Cli c) {
  if (!ready(c)) { return; }
  JsonValue? state = getState(c);
  if (state is null) { return; }
  if (c.json) { c.jsonOut(Obj.create().put("alarm", orNull(state!.member("alarm"))).put("shush", orNull(state!.member("shush"))).done()); return; }
  printAlarmStatus(c, state!, c.now() as~ f64);
}

struct AddOpts {
  string? desc;
  f64? days;
  string? anchor;
  string? tz;
  bool skipWeekends;
}

void cmdTimersAdd(Cli c, string name, string expiryStr, AddOpts opts) {
  if (!ready(c)) { return; }
  ExpirySpec? spec = parseExpirySpec(c, expiryStr);
  if (spec is null) { return; }
  RecurrenceSpec? recurrence = null;
  if (opts.days is not null) {
    recurrence = RecurrenceSpec(opts.days!, opts.anchor ?? DEFAULT_ANCHOR_TIME, opts.tz ?? c.cfgText("timezone") ?? c.zoneName,
                                opts.skipWeekends);
  }
  bool needsDefault = !spec!.absolute && !spec!.parsed!.hasSubDayUnit && recurrence is null;
  string? defaultAnchor = null;
  if (needsDefault) {
    JsonValue? state = getState(c);
    if (state is null) { return; }
    defaultAnchor = defaultAnchorOf(state!);
  }
  Timer? holder = recurrence is null ? null : Timer("", "", null, 0.0, 0.0, recurrence, null, "");
  f64 expiry = resolveExpirySpec(c, spec!, anchorFor(c, holder, defaultAnchor));
  if (c.halted) { return; }
  Obj body = Obj.create().put("name", str(name)).put("expiry", num(expiry));
  if (opts.desc is not null && opts.desc!.len() > 0) { body.put("description", str(opts.desc!)); }
  if (recurrence is not null) { body.put("recurrence", recurrence!.toJson()); }
  JsonValue? r = api(c, "POST", "/instances/\{c.cfgShow("instanceId")}/timers", body.done(), true);
  if (r is null) { return; }
  if (c.json) { c.jsonOut(r!); return; }
  string note = recurrence is not null ? " (recurs every \{jsNumber(opts.days!)}d)" : "";
  c.log("Timer \"\{name}\" added, expires \{c.fmtDate(expiry)}\{note}");
}

void cmdTimersRename(Cli c, string id, string name) {
  if (!ready(c)) { return; }
  string? timerId = resolveTimerId(c, id);
  if (timerId is null) { return; }
  if (api(c, "PATCH", "/instances/\{c.cfgShow("instanceId")}/timers/\{timerId!}/name", Obj.create().put("name", str(name)).done(), true) is null) { return; }
  if (c.json) { c.jsonOut(Obj.create().put("timerId", str(timerId!)).put("name", str(name)).done()); return; }
  c.log("Timer \{shortId(timerId!)}… renamed to \"\{name}\"");
}

void cmdTimersReschedule(Cli c, string id, string expiryStr) {
  if (!ready(c)) { return; }
  ExpirySpec? spec = parseExpirySpec(c, expiryStr);
  if (spec is null) { return; }
  JsonValue? state = getState(c);
  if (state is null) { return; }
  JsonArray ts = timersOf(state!);
  Vec<JsonValue> hits = Vec<JsonValue>.create();
  for (i32 i = 0; i < ts.len(); i++) {
    string tid = idOf(ts.get(i));
    if (tid == id || startsWith(tid, id)) { hits.push(ts.get(i)); }
  }
  if (hits.len() == 0) { c.fail("Timer not found: \{id}"); return; }
  if (hits.len() > 1) {
    Vec<string> shown = Vec<string>.create();
    for (i32 k = 0; k < hits.len(); k++) { shown.push(shortId(idOf(hits.get(k))) + "…"); }
    ambiguous(c, id, shown);
    return;
  }
  string timerId = idOf(hits.get(0));
  f64 expiry = resolveExpirySpec(c, spec!, anchorFor(c, wireTimer(hits.get(0)), defaultAnchorOf(state!)));
  if (c.halted) { return; }
  if (api(c, "PATCH", "/instances/\{c.cfgShow("instanceId")}/timers/\{timerId}/expiry", Obj.create().put("expiry", num(expiry)).done(), true) is null) { return; }
  if (c.json) { c.jsonOut(Obj.create().put("timerId", str(timerId)).put("expiry", num(expiry)).done()); return; }
  c.log("Timer \{shortId(timerId)}… rescheduled to \{c.fmtDate(expiry)}");
}

void cmdTimersComplete(Cli c, string id, string reason, f64? at) {
  if (!ready(c)) { return; }
  JsonValue? state = getState(c);
  if (state is null) { return; }
  string? timerId = resolveTimerId(c, id);
  if (timerId is null) { return; }
  JsonValue? timer = timerById(state!, timerId!);
  JsonValue? rec = timer is null ? null : timer!.member("recurrence");
  if (truthy(rec)) {
    RecurrenceSpec? spec = recurrenceFrom(rec!).ok();
    if (spec is null) { c.crash("the timer's recurrence is not one"); return; }
    TimeZone? z = c.zoneNamed(spec!.timezone);
    if (z is null) { return; }
    i64 when = at is null ? c.now() : at!.floor() as~ i64;
    f64 next = nextRecurrenceExpiry(spec!, when, z!) as~ f64;
    Obj action = Obj.create().put("type", str("recurTimer")).put("timerId", str(timerId!)).put("closeReason", str(reason))
      .put("newExpiry", num(next));
    if (at is not null) { action.put("occurredAt", num(at!)); }
    if (batch(c, action.done()) is null) { return; }
    JsonValue? after = getState(c);
    if (after is null) { return; }
    JsonValue? updated = timerById(after!, timerId!);
    if (c.json) {
      c.jsonOut(Obj.create().put("timerId", str(timerId!)).put("name", orNull(timer!.member("name"))).put("action", str("recurred"))
        .put("closeReason", str(reason)).put("nextExpiry", updated is null ? JsonValue.Null : orNull(updated!.member("currentExpiry"))).done());
      return;
    }
    if (updated is not null) {
      c.log("Timer \"\{tpl(timer!.member("name"))}\" recurred — next: \{c.fmtDate(updated!.member("currentExpiry")?.number() ?? 0.0)}");
    } else {
      c.log("Timer \{shortId(timerId!)}… recurred");
    }
    return;
  }
  Obj action = Obj.create().put("type", str("completeTimer")).put("timerId", str(timerId!)).put("closeReason", str(reason));
  if (at is not null) { action.put("occurredAt", num(at!)); }
  if (batch(c, action.done()) is null) { return; }
  JsonValue? name = timer is null ? null : timer!.member("name");
  if (c.json) {
    c.jsonOut(Obj.create().put("timerId", str(timerId!)).put("name", orNull(name)).put("action", str("completed"))
      .put("closeReason", str(reason)).done());
    return;
  }
  c.log("Timer \"\{name is null || name!.isNull() ? shortId(timerId!) : tpl(name)}\" completed (\{reason})");
}

void cmdTimersRemove(Cli c, string id) {
