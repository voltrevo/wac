  string name = n is null || n!.isNull() ? shortId(timerId!) : tpl(n);
  if (c.json) { c.jsonOut(Obj.create().put("timerId", str(timerId!)).put("name", n is null || n!.isNull() ? str(name) : n!).done()); return; }
  c.log("Timer \"\{name}\" removed");
}

