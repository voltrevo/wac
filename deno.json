{
  "$comment": [
    "`site/` is excluded from Deno's walk: it is the website — React, .tsx, npm imports and the",
    "extensionless specifiers vite resolves — and neither `deno test` nor `deno check` can read it.",
    "It has its own `tsc -b` and its own test, run by `site/package.json` and the Pages workflow:",
    "  deno test -A site/tools/site.test.ts",
    "It came inside this walk when the language and package repositories merged."
  ],
  "imports": {
    "wac/": "./compiler/"
  },
  "tasks": {
    "bench": "deno run -A tools/bench.ts",
    "bench:hash": "deno run -A packages/crypto/bench/hash.ts",
    "bench:compile": "deno run -A tools/benchCompile.ts",
    "bench:zstd": "deno run -A packages/zstd/bench/ratio.ts",
    "bench:zstd-speed": "deno run -A packages/zstd/bench/speed.ts",
    "bench:json": "deno run -A packages/json/bench/throughput.ts",
    "bench:json-lookup": "deno run -A packages/json/bench/lookup.ts",
    "bindgen": "deno run -A tools/emitgen.ts",
    "corpus:through": "deno run -A tools/corpusThrough.ts",
    "corpus:hosts": "deno run -A tools/corpusHosts.ts",
    "corpus:backings": "deno run -A tools/corpusBackings.ts",
    "corpus:routes": "deno run -A tools/corpusRoutes.ts",
    "corpus:stderr": "deno run -A tools/corpusStderr.ts",
    "flags:ignored": "deno run -A tools/ignoredFlags.ts",
    "coverage": "deno run -A tools/coverage.ts",
    "coverage:all": "deno run -A tools/coverageAll.ts",
    "size": "deno run -A tools/size.ts",
    "coverage:bls": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run --allow-env packages/bls/test/cov_ledger.wac",
    "coverage:abi": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run --allow-env packages/abi/test/cov_ledger.wac",
    "coverage:bignum": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/bignum/test/cov_ledger.wac",
    "coverage:bytes": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/bytes/test/cov_ledger.wac",
    "coverage:codec": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/codec/test/cov_ledger.wac",
    "coverage:core": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run core/test/cov_ledger.wac",
    "coverage:crypto": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/crypto/test/cov_ledger.wac",
    "coverage:datetime": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/datetime/test/cov_ledger.wac",
    "coverage:fmt": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run --allow-env packages/fmt/test/cov_ledger.wac",
    "coverage:fs": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/fs/test/cov_ledger.wac",
    "coverage:gzip": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/gzip/test/cov_ledger.wac",
    "coverage:http": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run --allow-env packages/http/test/cov_ledger.wac",
    "coverage:json": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run --allow-env packages/json/test/cov_ledger.wac",
    "coverage:regex": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run --allow-env packages/regex/test/cov_ledger.wac",
    "coverage:mpt": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run --allow-env packages/mpt/test/cov_ledger.wac",
    "coverage:raster": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/raster/test/cov_ledger.wac",
    "coverage:rlp": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run --allow-env packages/rlp/test/cov_ledger.wac",
    "coverage:server": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/server/test/cov_ledger.wac",
    "coverage:ssz": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run --allow-env packages/ssz/test/cov_ledger.wac",
    "coverage:stream": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/stream/test/cov_ledger.wac",
    "coverage:zstd": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/zstd/test/cov_ledger.wac",
    "coverage:ssh": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/ssh/test/cov_ledger.wac",
    "coverage:sh": "deno run -A packages/sh/cov.ts",
    "coverage:tty": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run --allow-env packages/tty/test/cov_ledger.wac",
    "coverage:tls": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run --allow-env --allow-net packages/tls/test/cov_ledger.wac",
    "coverage:unicode": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/unicode/test/cov_ledger.wac",
    "coverage:url": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run --allow-env packages/url/test/cov_ledger.wac",
    "coverage:wacpkg": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/wacpkg/test/cov_ledger.wac",
    "gen:core": "deno run -A tools/genCore.ts",
    "gen:unicode": "deno run -A packages/unicode/tools/gentables.ts",
    "gen:bls-fpkernel": "python3 packages/bls/tools/genfpkernel.py",
    "dead": "deno run -A tools/deadexports.ts",
    "mutate": "deno run -A tools/mutate.ts",
    "mutate:diff": "deno run -A tools/mutate.ts --diff --operators",
    "mutate:operators": "deno run -A tools/mutate.ts --operators",
    "serve": "deno run -A packages/server/host/serve.ts",
    "app:build": "deno run --allow-read --allow-write --allow-run --allow-env packages/platform/build.ts",
    "seed": "bash tools/seed.sh",
    "seed:bootstrap": "bash tools/seed.sh --bootstrap",
    "seed:native": "bash tools/seed.sh --native-only",
    "wac:install": "deno run --allow-read --allow-write --allow-run --allow-env tools/install.ts install",
    "wac:uninstall": "deno run --allow-read --allow-write --allow-run --allow-env tools/install.ts uninstall",
    "wac:build": "deno run --allow-read --allow-write --allow-run --allow-env tools/install.ts build",
    "check": "deno run -A tools/checkTypes.ts",
    "test": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run --allow-env --allow-net tools/runTests.wac --",
    "test:changed": "deno run -A tools/testChanged.ts",
    "test:heavy": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run --allow-env --allow-net tools/runTests.wac -- --heavy",
    "validate": "deno run -A tools/validate.ts",
    "verify:fmt": "deno run -A packages/fmt/tools/sweep.ts",
    "docs": "./native/v8/target/release/wac test --allow-read --allow-write --allow-run tools/ && WAC_DOCS_STRICT=1 deno test -A --no-check tools/designClaims.test.ts tools/docSignatures.test.ts",
    "map": "./native/v8/target/release/wac run --allow-read --allow-write tools/wac/map.wac",
    "site:map": "deno run --allow-read --allow-write site/tools/syncMap.ts",
    "shell:fuzz": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run tools/wac/shfuzz.wac"
  },
  "exclude": [
    ".cache",
    "site/src",
    "site/node_modules",
    "site/dist",
    "native/target"
  ]
}
