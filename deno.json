{
  "$comment": [
    "`site/` is excluded from Deno's walk: it is the website — React, .tsx, npm imports and the",
    "extensionless specifiers vite resolves — and neither `deno test` nor `deno check` can read it.",
    "It has its own `tsc -b` and its own test, run by `site/package.json` and the Pages workflow:",
    "  deno test -A site/tools/site.test.ts",
    "It came inside this walk when the language and package repositories merged."
  ],
  "imports": {
    "wac/": "./compiler/"
  },
  "tasks": {
    "bench": "deno run -A tools/bench.ts",
    "bench:hash": "deno run -A packages/crypto/bench/hash.ts",
    "bench:compile": "deno run -A tools/benchCompile.ts",
    "bench:zstd": "deno run -A packages/zstd/bench/ratio.ts",
    "bench:zstd-speed": "deno run -A packages/zstd/bench/speed.ts",
    "bench:json": "deno run -A packages/json/bench/throughput.ts",
    "bench:json-lookup": "deno run -A packages/json/bench/lookup.ts",
    "bindgen": "deno run -A tools/emitgen.ts",
    "corpus:through": "deno run -A tools/corpusThrough.ts",
    "corpus:hosts": "deno run -A tools/corpusHosts.ts",
    "corpus:backings": "deno run -A tools/corpusBackings.ts",
    "corpus:routes": "deno run -A tools/corpusRoutes.ts",
    "corpus:stderr": "deno run -A tools/corpusStderr.ts",
    "flags:ignored": "deno run -A tools/ignoredFlags.ts",
    "coverage": "deno run -A tools/coverage.ts",
    "coverage:all": "deno run -A tools/coverageAll.ts",
    "size": "deno run -A tools/size.ts",
    "coverage:bignum": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run tools/wac/covreport.wac -- packages/bignum/test/cov_exercise.wac packages/bignum/ --allow-run trap_divide_by_zero trap_divide_zero_by_zero trap_remainder_by_zero_small trap_add_malformed_empty trap_add_malformed_decimal trap_add_malformed_sign trap_from_hex_malformed",
    "coverage:bytes": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run tools/wac/covreport.wac -- packages/bytes/test/cov_exercise.wac packages/bytes/ trap_getting_past_the_end trap_getting_a_negative_index trap_getting_at_capacity_not_length trap_pushing_repeat_before_the_start trap_pushing_repeat_past_the_end trap_pushing_a_negative_repeat_count trap_slicing_past_the_end trap_slicing_from_a_negative trap_slicing_backwards trap_repeating_from_beyond_what_is_written trap_repeating_a_negative_count trap_repeating_from_a_negative_index",
    "coverage:codec": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run tools/wac/covreport.wac -- packages/codec/test/cov_exercise.wac packages/codec/",
    "coverage:core": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run tools/wac/covreport.wac -- core/test/cov_exercise.wac core/ trapCase:11",
    "coverage:crypto": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/crypto/test/cov_ledger.wac",
    "coverage:datetime": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run tools/wac/covreport.wac -- packages/datetime/test/cov_exercise.wac packages/datetime/",
    "coverage:fmt": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run tools/wac/covreport.wac -- packages/fmt/test/cov_exercise.wac packages/fmt/",
    "coverage:fs": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/fs/test/cov_ledger.wac",
    "coverage:gzip": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/gzip/test/cov_ledger.wac",
    "coverage:http": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run tools/wac/covreport.wac -- packages/http/test/cov_exercise.wac packages/http/",
    "coverage:json": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run tools/wac/covreport.wac -- packages/json/test/cov_exercise.wac packages/json/ --allow-read trap_when_an_array_index_is_past_the_end trap_when_an_array_index_is_negative trap_when_an_object_index_is_past_the_end trap_when_an_object_index_is_negative",
    "coverage:regex": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run tools/wac/covreport.wac -- packages/regex/test/cov_exercise.wac packages/regex/",
    "coverage:raster": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run tools/wac/covreport.wac -- packages/raster/test/cov_exercise.wac packages/raster/",
    "coverage:server": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run tools/wac/covreport.wac -- packages/server/test/cov_exercise.wac packages/server/",
    "coverage:stream": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run tools/wac/covreport.wac -- packages/stream/test/cov_exercise.wac packages/stream/",
    "coverage:zstd": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/zstd/test/cov_ledger.wac",
    "coverage:ssh": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run packages/ssh/test/cov_ledger.wac",
    "coverage:sh": "deno run -A packages/sh/cov.ts",
    "coverage:unicode": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run tools/wac/covreport.wac -- packages/unicode/test/cov_exercise.wac packages/unicode/",
    "coverage:url": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run tools/wac/covreport.wac -- packages/url/test/cov_exercise.wac packages/url/",
    "coverage:wacpkg": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run tools/wac/covreport.wac -- packages/wacpkg/test/cov_exercise.wac packages/wacpkg/ --allow-read",
    "gen:core": "deno run -A tools/genCore.ts",
    "gen:unicode": "deno run -A packages/unicode/tools/gentables.ts",
    "gen:bls-fpkernel": "python3 packages/bls/tools/genfpkernel.py",
    "dead": "deno run -A tools/deadexports.ts",
    "mutate": "deno run -A tools/mutate.ts",
    "mutate:diff": "deno run -A tools/mutate.ts --diff --operators",
    "mutate:operators": "deno run -A tools/mutate.ts --operators",
    "serve": "deno run -A packages/server/host/serve.ts",
    "app:build": "deno run --allow-read --allow-write --allow-run --allow-env packages/platform/build.ts",
    "seed": "bash tools/seed.sh",
    "seed:bootstrap": "bash tools/seed.sh --bootstrap",
    "wac:install": "deno run --allow-read --allow-write --allow-run --allow-env tools/install.ts install",
    "wac:uninstall": "deno run --allow-read --allow-write --allow-run --allow-env tools/install.ts uninstall",
    "wac:build": "deno run --allow-read --allow-write --allow-run --allow-env tools/install.ts build",
    "check": "deno run -A tools/checkTypes.ts",
    "test": "deno run --allow-read --allow-write --allow-env --allow-run tools/runTests.ts",
    "test:changed": "deno run -A tools/testChanged.ts",
    "test:heavy": "deno run --allow-read --allow-write --allow-env --allow-run tools/runTests.ts --heavy",
    "validate": "deno run -A tools/validate.ts",
    "verify:fmt": "deno run -A packages/fmt/tools/sweep.ts",
    "docs": "./native/v8/target/release/wac test --allow-read --allow-write --allow-run tools/ && WAC_DOCS_STRICT=1 deno test -A --no-check tools/designClaims.test.ts tools/docSignatures.test.ts",
    "map": "./native/v8/target/release/wac run --allow-read --allow-write tools/wac/map.wac",
    "site:map": "deno run --allow-read --allow-write site/tools/syncMap.ts",
    "shell:fuzz": "./native/v8/target/release/wac run --allow-read --allow-write --allow-run tools/wac/shfuzz.wac"
  },
  "exclude": [
    ".cache",
    "site/src",
    "site/node_modules",
    "site/dist",
    "native/target"
  ]
}
