// An AST as a recursive enum, and an evaluator over it — which is the shape wac's own compiler is
// written in, and the reason `match` is the feature worth having.
enum Expr {
  Num(i32 v);
  Add(Expr a, Expr b);
  Mul(Expr a, Expr b);
  Neg(Expr a);
}

i32 eval(Expr e) {
  match (e) {
    case Num(v): { return v; }
    case Add(a, b): { return eval(a) + eval(b); }
    case Mul(a, b): { return eval(a) * eval(b); }
    case Neg(a): { return 0 - eval(a); }
  }
  return 0;
}

i32 depth(Expr e) {
  match (e) {
    case Num(v): { return 1; }
    case Add(a, b): { i32 da = depth(a); i32 db = depth(b); if (da > db) { return da + 1; } return db + 1; }
    case Mul(a, b): { i32 da = depth(a); i32 db = depth(b); if (da > db) { return da + 1; } return db + 1; }
    case Neg(a): { return depth(a) + 1; }
  }
  return 0;
}

i32 main() {
  // (2 + 3) * -(4) = -20, at depth 4
  Expr e = Mul(Add(Num(2), Num(3)), Neg(Num(4)));
  return eval(e) * 10 + depth(e);
}
