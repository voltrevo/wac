struct Point {
  i32 x;
  i32 y;

  i32 sum(const this) { return this.x + this.y; }
}

enum Shape {
  Circle(i32 r), Rect(i32 w, i32 h), Empty
}

i32 area(Shape s) {
  match (s) {
    case Circle(r): { return 3 * r * r; }
    case Rect(w, h): { return w * h; }
    case Empty: { return 0; }
  }
  return -1;
}

export i32 main() {
  Point p = Point(3, 4);
  i32[] xs = i32[4]();
  xs[0] = 10;
  xs[2] = 5;
  return p.sum() * 10000 + area(Rect(3, 4)) * 100 + xs[0] + xs[2] + xs.len();
}
