; A named label, a loop, a conditional branch — the sum of 1..10, which is 55.
memory 1
func $main -> i32
  local i32 $i
  local i32 $sum
  i32.const 10
  local.set $i
  block $done ->
    loop $again ->
      local.get $i
      i32.eqz
      br_if $done
      local.get $sum
      local.get $i
      i32.add
      local.set $sum
      local.get $i
      i32.const 1
      i32.sub
      local.set $i
      br $again
    end
  end
  local.get $sum
end
export "main" func $main
export "memory" memory
