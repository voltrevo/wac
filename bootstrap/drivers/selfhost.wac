// **A module rather than a splice.** `bootstrap/drivers/spec_cases.wac` is concatenated onto wacc's
// flattened graph, so it can reach anything declared anywhere in it — which is exactly what a
// file being *compiled by wacc* cannot do. This one imports what it uses and nothing else, and is
// the only driver that can be part of a program wacc links.
//
// The boundary is the same: bytes in and bytes out one at a time, because a wasm GC array cannot
// cross into JavaScript and a wac program has no way to reach linear memory.

import { emit, emitFiles, blocked } from "./api.wac";

u8[] inbuf;
u8[] built;
u8[] namebuf;
u8[] declined;
string[] paths;
string[] sources;
i32 nfile = 0;

export i32 drv_alloc(i32 n) {
  inbuf = u8[n]();
  return n;
}

export i32 drv_setByte(i32 i, i32 b) {
  inbuf[i] = b;
  return 0;
}

export i32 drv_build() {
  built = emit(inbuf);
  return built.len();
}

export i32 drv_byteAt(i32 i) {
  return built[i];
}

export i32 drv_decline() {
  declined = blocked(inbuf).toBytes();
  return declined.len();
}

export i32 drv_declineByte(i32 i) {
  return declined[i];
}

export i32 drv_files(i32 n) {
  paths = string[n](fill: "");
  sources = string[n](fill: "");
  nfile = 0;
  return 0;
}

export i32 drv_allocName(i32 n) {
  namebuf = u8[n]();
  return n;
}

export i32 drv_setNameByte(i32 i, i32 b) {
  namebuf[i] = b;
  return 0;
}

export i32 drv_pushFile() {
  paths[nfile] = string.fromBytes(namebuf);
  sources[nfile] = string.fromBytes(inbuf);
  nfile = nfile + 1;
  return 0;
}

export i32 drv_buildFiles() {
  built = emitFiles(paths, sources, string.fromBytes(namebuf));
  return built.len();
}
