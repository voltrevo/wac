// wac-L5 — a compiler for wac itself, written in wac-L4. See spec/l5.md.
//
// This is the rung that is *handed* its language: it has to accept whatever `packages/wacc/src`
// happens to be written in, rather than whatever we chose. Stage 1 is the shape of real wac — its
// declarations, its statements, its full precedence chain — over the i32 subset, so that the parts
// that are only breadth (integer widths, casts, strings) and the one part that is depth (generics)
// can each be added to something that already parses the language.
//
// It is written in wac-L4, so it has structs, arrays, `enum`/`match`, methods and GC. The tables
// below are GC arrays rather than fixed addresses, which is the first thing on this ladder that has
// been true of a compiler here.

struct Tok { i32 kind; i32 start; i32 len; i32 val; }

Tok[] toks;
i32 ntok = 0;
i32 tp = 0;
i32 src = 0;
i32 dst = 0;
i32 dp = 0;
i32 labn = 0;

// Token kinds.
i32 K_EOF = 0;
i32 K_INT = 1;
i32 K_NAME = 2;
i32 K_PUNCT = 3;
i32 K_STR = 4;

// ---------------------------------------------------------------- emitting

i32 emit1(i32 b) { store8(dst + dp, b); dp = dp + 1; return 0; }

i32 emits(i32 s) {
  i32 n = load(s);
  i32 i = 0;
  while (i < n) { emit1(load8(s + 4 + i)); i = i + 1; }
  return 0;
}

i32 emitd(i32 n) {
  if (n > 9) { emitd(n / 10); }
  emit1(48 + n % 10);
  return 0;
}

i32 emitn(i32 n) {
  if (n < 0) { emit1(45); emitd(0 - n); } else { emitd(n); }
  return 0;
}

i32 sp() { return emit1(32); }
i32 nl() { return emit1(10); }
i32 word(i32 s) { emits(s); return sp(); }
i32 line(i32 s) { emits(s); return nl(); }
i32 konst(i32 n) { word("i32.const"); emitn(n); return nl(); }
i32 label(i32 n) { emits("$b"); return emitn(n); }
i32 newlabel() { labn = labn + 1; return labn; }

i32 emitname(i32 p, i32 n) {
  i32 i = 0;
  while (i < n) { emit1(load8(src + p + i)); i = i + 1; }
  return 0;
}

// ---------------------------------------------------------------- source

i32 at(i32 i) { return load8(src + i); }
i32 isspace(i32 c) { return c == 32 | c == 10 | c == 13 | c == 9; }
i32 isdigit(i32 c) { return c >= 48 & c <= 57; }
i32 isalpha(i32 c) { return c == 95 | (c >= 97 & c <= 122) | (c >= 65 & c <= 90); }
i32 isalnum(i32 c) { return isalpha(c) | isdigit(c); }

i32 texteq(i32 p, i32 n, i32 s) {
  i32 r = 1;
  if (n != load(s)) { r = 0; } else {
    i32 i = 0;
    while (i < n) {
      if (at(p + i) != load8(s + 4 + i)) { r = 0; }
      i = i + 1;
    }
  }
  return r;
}

i32 samebytes(i32 a, i32 n, i32 b) {
  i32 r = 1;
  i32 i = 0;
  while (i < n) {
    if (at(a + i) != at(b + i)) { r = 0; }
    i = i + 1;
  }
  return r;
}

// ---------------------------------------------------------------- the lexer
//
// Punctuation packs its bytes into one word, so `<=` is 60 + 61*256 and a two-byte operator is one
// integer compare. wac's three-byte operators are `<<=` and `>>=`, which nothing in `wacc/src`
// uses, so they are not here yet — and the lexer says so rather than mis-reading them.

i32 srclen = 0;

i32 pack2(i32 a, i32 b) { return a + b * 256; }

i32 lex() {
  toks = Tok[srclen + 4]();
  ntok = 0;
  i32 p = 0;
  while (at(p) != 0) {
    i32 c = at(p);
    if (isspace(c)) { p = p + 1; } else {
      if (c == 47 & at(p + 1) == 47) {
        while (at(p) != 0 & at(p) != 10) { p = p + 1; }
      } else {
        // A `/* … */` comment, which wac uses for every doc comment in the tree.
        if (c == 47 & at(p + 1) == 42) {
          p = p + 2;
          while (at(p) != 0 & (at(p) != 42 | at(p + 1) != 47)) { p = p + 1; }
          if (at(p) != 0) { p = p + 2; }
        } else {
          if (isdigit(c)) {
            i32 v = 0;
            i32 s0 = p;
            while (isdigit(at(p))) { v = v * 10 + at(p) - 48; p = p + 1; }
            toks[ntok] = Tok(K_INT, s0, p - s0, v);
            ntok = ntok + 1;
          } else {
            if (c == 34) {
              p = p + 1;
              i32 s1 = p;
              while (at(p) != 0 & at(p) != 34) {
                if (at(p) == 92) { p = p + 1; }
                p = p + 1;
              }
              toks[ntok] = Tok(K_STR, s1, p - s1, 0);
              ntok = ntok + 1;
              p = p + 1;
            } else {
              if (isalpha(c)) {
                i32 s2 = p;
                while (isalnum(at(p))) { p = p + 1; }
                toks[ntok] = Tok(K_NAME, s2, p - s2, 0);
                ntok = ntok + 1;
              } else {
                i32 d = at(p + 1);
                i32 v2 = c;
                i32 w = 1;
                // The two-byte operators wac has: comparison, the logicals, the increments, and
                // compound assignment.
                if (d == 61 & (c == 61 | c == 33 | c == 60 | c == 62
                             | c == 43 | c == 45 | c == 42 | c == 47 | c == 37)) {
                  v2 = pack2(c, d);
                  w = 2;
                }
                if (c == 38 & d == 38) { v2 = pack2(c, d); w = 2; }
                if (c == 124 & d == 124) { v2 = pack2(c, d); w = 2; }
                if (c == 43 & d == 43) { v2 = pack2(c, d); w = 2; }
                if (c == 45 & d == 45) { v2 = pack2(c, d); w = 2; }
                if (c == 60 & d == 60) { v2 = pack2(c, d); w = 2; }
                if (c == 62 & d == 62) { v2 = pack2(c, d); w = 2; }
                toks[ntok] = Tok(K_PUNCT, p, w, v2);
                ntok = ntok + 1;
                p = p + w;
              }
            }
          }
        }
      }
    }
  }
  toks[ntok] = Tok(K_EOF, p, 0, 0);
  return 0;
}

// ---------------------------------------------------------------- the cursor

i32 kind() { return toks[tp].kind; }
i32 val() { return toks[tp].val; }
i32 tstart() { return toks[tp].start; }
i32 tlen() { return toks[tp].len; }
i32 next() { tp = tp + 1; return 0; }
i32 ispunct(i32 v) { return (toks[tp].kind == K_PUNCT) & (toks[tp].val == v); }
i32 aheadIs(i32 k, i32 v) { return (toks[tp + k].kind == K_PUNCT) & (toks[tp + k].val == v); }
i32 isword(i32 s) { return (toks[tp].kind == K_NAME) & texteq(toks[tp].start, toks[tp].len, s); }
i32 eat(i32 v) { if (ispunct(v)) { next(); return 1; } return 0; }
i32 oops() { nl(); line("!! wac-L5: unexpected token"); return 0; }
i32 want(i32 v) { if (eat(v)) { return 0; } return oops(); }
i32 eatword(i32 s) { if (isword(s)) { next(); return 1; } return 0; }

// ---------------------------------------------------------------- locals
//
// As in wac-L4: a declaration always takes a fresh slot and only the *name* is popped when a block
// ends, so shadowing costs a slot and no renaming.

struct Local { i32 nameptr; i32 namelen; i32 slot; i32 ty; }
Local[] locs;
i32 nloc = 0;
i32 nslot = 0;
i32[] slotty;

i32 loc_add(i32 p, i32 n, i32 t) {
  locs[nloc] = Local(p, n, nslot, t);
  // Slots are never popped and names are, and the function header — written after the body, because
  // wasm wants locals declared before it — needs the types the name table has by then thrown away.
  slotty[nslot] = t;
  nloc = nloc + 1;
  nslot = nslot + 1;
  return nslot - 1;
}

i32 loc_at = -1;

i32 loc_find(i32 p, i32 n) {
  i32 i = nloc;
  i32 found = 0 - 1;
  loc_at = 0 - 1;
  while (i > 0) {
    i = i - 1;
    if (found == 0 - 1) {
      if (locs[i].namelen == n & samebytes(p, n, locs[i].nameptr)) {
        found = locs[i].slot;
        loc_at = i;
      }
    }
  }
  return found;
}

i32 loc_type(i32 slot) { return slotty[slot]; }

i32 slotname(i32 s) { emits("$v"); return emitn(s); }

// ---------------------------------------------------------------- globals

struct Glo { i32 nameptr; i32 namelen; i32 ty; }
Glo[] glos;
i32 nglo = 0;

i32 glo_find(i32 p, i32 n) {
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < nglo) {
    if (glos[i].namelen == n & samebytes(p, n, glos[i].nameptr)) { found = i; }
    i = i + 1;
  }
  return found;
}

i32 gloname(i32 i) { emits("$g"); return emitn(i); }

// ---------------------------------------------------------------- string literals

struct Str { i32 off; i32 ptr; i32 len; }
Str[] strs;
i32 nstr = 0;
i32 strnext = 1024;

// wac's escapes, as bytes. Only the ones `wacc/src` uses; an unknown one is left as written, which
// is wrong in a way the assembler will not catch and is therefore listed in the spec as a gap.
i32 unescape(i32 c) {
  if (c == 110) { return 10; }
  if (c == 116) { return 9; }
  if (c == 114) { return 13; }
  if (c == 48) { return 0; }
  return c;
}

i32 str_add(i32 p, i32 n) {
  strs[nstr] = Str(strnext, p, n);
  nstr = nstr + 1;
  strnext = strnext + 4 * ((4 + n + 3) / 4);
  return strs[nstr - 1].off;
}

i32 hexd(i32 d) { if (d < 10) { return 48 + d; } return 87 + d; }
i32 emithex(i32 b) {
  emit1(92); emit1(120); emit1(hexd(b / 16)); return emit1(hexd(b % 16));
}

i32 emit_strdata() {
  i32 i = 0;
  while (i < nstr) {
    i32 p = strs[i].ptr;
    i32 n = strs[i].len;
    word("data"); emitn(strs[i].off); sp(); emit1(34);
    emithex(n % 256); emithex(n / 256 % 256); emithex(n / 65536 % 256); emithex(n / 16777216);
    i32 j = 0;
    while (j < n) { emithex(at(p + j)); j = j + 1; }
    emit1(34); nl();
    i = i + 1;
  }
  return 0;
}

// ---------------------------------------------------------------- functions

struct Fn { i32 nameptr; i32 namelen; i32 ret; }
Fn[] fns;
i32 nfn = 0;

i32 glo_type(i32 i) { return glos[i].ty; }

i32 fn_find(i32 p, i32 n) {
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < nfn) {
    if (fns[i].namelen == n & samebytes(p, n, fns[i].nameptr)) { found = i; }
    i = i + 1;
  }
  return found;
}

// ---------------------------------------------------------------- types
//
// Index 0 is `i32` and index 1 is `u8`, both reserved rather than assumed — the first struct to be
// registered would otherwise take index 0, and every local of that type would emit as `i32`. That
// was a real bug at wac-L4 and is written down here so it is not a second one.

struct Ty { i32 kind; i32 nameptr; i32 namelen; i32 elem; i32 fstart; i32 nfields; }
Ty[] types;
i32 ntype = 0;

struct Field { i32 nameptr; i32 namelen; i32 ty; }
Field[] fields;
i32 nfield = 0;

// **The numeric lattice.** wasm has two integer value types and wac has eight names for them, which
// differ in width and in signedness — and those two facts decide which instruction every operator
// emits. `u32 / u32` is `i32.div_u` and `i32 / i32` is `i32.div_s`, and nothing else in the
// compiler can tell them apart.
i32 T_NUM = 0;
i32 T_STRUCT = 2;
i32 T_ARRAY = 3;
i32 T_ENUM = 4;

// Reserved indices, in this order, so that `valtype(0)` is `i32` and the first struct cannot take
// the slot.
i32 TY_I32 = 0;
i32 TY_U8 = 1;
i32 TY_I64 = 2;
i32 TY_U32 = 3;
i32 TY_BOOL = 4;
i32 TY_I8 = 5;
i32 TY_U16 = 6;
i32 TY_I16 = 7;
i32 TY_U64 = 8;
i32 NUMTYPES = 9;

// Is it held in an i64? Everything else this rung has fits an i32.
i32 ty_wide(i32 t) { return t == TY_I64 | t == TY_U64; }
i32 ty_signed(i32 t) { return (t == TY_U32 | t == TY_U8 | t == TY_U16 | t == TY_U64) == 0; }
i32 ty_isnum(i32 t) { return t < NUMTYPES; }

// The width a value is *stored* in when it is an array element or a struct field. wasm has i8 and
// i16 as storage types and no others.
i32 ty_packed(i32 t) {
  if (t == TY_U8 | t == TY_I8) { return 8; }
  if (t == TY_U16 | t == TY_I16) { return 16; }
  return 0;
}

i32 ty_new(i32 kind, i32 p, i32 n, i32 elem) {
  types[ntype] = Ty(kind, p, n, elem, nfield, 0);
  ntype = ntype + 1;
  return ntype - 1;
}

i32 ty_named(i32 p, i32 n) {
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < ntype) {
    if (types[i].namelen == n & n > 0 & samebytes(p, n, types[i].nameptr)) {
      if (types[i].kind == T_STRUCT | types[i].kind == T_ENUM) { found = i; }
    }
    i = i + 1;
  }
  return found;
}

i32 ty_array(i32 elem) {
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < ntype) {
    if (types[i].kind == T_ARRAY & types[i].elem == elem) { found = i; }
    i = i + 1;
  }
  if (found == 0 - 1) { found = ty_new(T_ARRAY, 0, 0, elem); }
  return found;
}

i32 tyname(i32 t) {
  if (types[t].kind == T_ARRAY) { emits("$a"); } else {
    if (types[t].kind == T_ENUM) { emits("$e"); } else { emits("$s"); }
  }
  return emitn(t);
}

i32 valtype(i32 t) {
  if (ty_isnum(t) == 0) { word("refnull"); tyname(t); return 0; }
  if (ty_wide(t)) { emits("i64"); return 0; }
  i32 pk = ty_packed(t);
  if (pk == 8) { emits("i8"); return 0; }
  if (pk == 16) { emits("i16"); return 0; }
  emits("i32");
  return 0;
}

// The value type a local or a parameter of this type takes. A packed type has none — wasm has no i8
// *value* — so it widens to i32, which is what reading one answers anyway.
i32 slotvaltype(i32 t) {
  if (ty_isnum(t) == 0) { word("refnull"); tyname(t); return 0; }
  if (ty_wide(t)) { emits("i64"); return 0; }
  emits("i32");
  return 0;
}

// `i32.` or `i64.`, which is the prefix on every arithmetic instruction.
i32 opprefix(i32 t) { if (ty_wide(t)) { emits("i64."); } else { emits("i32."); } return 0; }

// The signed or unsigned form of an instruction that has both.
i32 signedsuffix(i32 t) { if (ty_signed(t)) { emits("_s"); } else { emits("_u"); } return 0; }

i32 binop(i32 t, i32 name) { opprefix(t); emits(name); return nl(); }

i32 binop_signed(i32 t, i32 name) { opprefix(t); emits(name); signedsuffix(t); return nl(); }

// A type, read in full. `T?` is the same wasm type as `T`: every reference this emitter writes is
// already nullable, and a nullable *primitive* is boxed in wac and is not — which is a gap, and the
// spec says so rather than this pretending otherwise.
// The primitive named at the cursor, or -1. One list, consulted by `parse_type` and by the
// expression grammar, so that a type name means the same thing in both.
i32 prim_type() {
  if (isword("i32")) { return TY_I32; }
  if (isword("bool")) { return TY_BOOL; }
  if (isword("i64")) { return TY_I64; }
  if (isword("u32")) { return TY_U32; }
  if (isword("u64")) { return TY_U64; }
  if (isword("i8")) { return TY_I8; }
  if (isword("u8")) { return TY_U8; }
  if (isword("u16")) { return TY_U16; }
  if (isword("i16")) { return TY_I16; }
  return 0 - 1;
}

i32 parse_type() {
  i32 t = 0;
  i32 pr = prim_type();
  if (pr != 0 - 1) { t = pr; next(); } else {
    i32 p = tstart();
    i32 n = tlen();
    next();
    t = ty_named(p, n);
    if (t == 0 - 1) { t = ty_new(T_STRUCT, p, n, 0); }
  }
  while (ispunct(91) & aheadIs(1, 93)) { next(); next(); t = ty_array(t); }
  if (ispunct(63)) { next(); }
  return t;
}

// A type, then a name, then `(` — which is how a *member function* begins inside a struct or an
// enum body, and nothing else there does. Without this, the last variant before the first method
// reads as that method's return type: `None` followed by `bool isSome(` is a name followed by a
// name, and so is `bool isSome`.
i32 looks_like_member() {
  i32 i = tp;
  if (toks[i].kind != K_NAME) { return 0; }
  if (texteq(toks[i].start, toks[i].len, "const")) { return 1; }
  if (texteq(toks[i].start, toks[i].len, "export")) { return 1; }
  i = i + 1;
  if (toks[i].kind == K_PUNCT & toks[i].val == 60) {
    while ((toks[i].kind == K_PUNCT & toks[i].val == 62) == 0) { i = i + 1; }
    i = i + 1;
  }
  while (toks[i].kind == K_PUNCT & toks[i].val == 91) {
    if ((toks[i + 1].kind == K_PUNCT & toks[i + 1].val == 93) == 0) { return 0; }
    i = i + 2;
  }
  if (toks[i].kind == K_PUNCT & toks[i].val == 63) { i = i + 1; }
  if (toks[i].kind != K_NAME) { return 0; }
  return toks[i + 1].kind == K_PUNCT & toks[i + 1].val == 40;
}

// A type followed by a name, which is how a declaration begins and nothing else does.
i32 looks_like_decl() {
  i32 i = tp;
  if (toks[i].kind != K_NAME) { return 0; }
  i = i + 1;
  while (toks[i].kind == K_PUNCT & toks[i].val == 91) { i = i + 2; }
  if (toks[i].kind == K_PUNCT & toks[i].val == 63) { i = i + 1; }
  return toks[i].kind == K_NAME;
}

// ---------------------------------------------------------------- variants and methods

struct Var { i32 nameptr; i32 namelen; i32 payload; i32 owner; }
Var[] vars;
i32 nvar = 0;

struct Meth { i32 owner; i32 nameptr; i32 namelen; i32 ret; }
Meth[] meths;
i32 nmeth = 0;

i32 var_find(i32 p, i32 n) {
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < nvar) {
    if (vars[i].namelen == n & samebytes(p, n, vars[i].nameptr)) { found = i; }
    i = i + 1;
  }
  return found;
}

i32 var_tag(i32 v) { return v - types[vars[v].owner].fstart; }

i32 meth_find(i32 owner, i32 p, i32 n) {
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < nmeth) {
    if (meths[i].owner == owner & meths[i].namelen == n & samebytes(p, n, meths[i].nameptr)) {
      found = i;
    }
    i = i + 1;
  }
  return found;
}

// `Vec_push`, written from two source names because wac-L4 has no way to build one.
i32 mangled(i32 owner, i32 p, i32 n) {
  emit1(36);
  emitname(types[owner].nameptr, types[owner].namelen);
  emit1(95);
  return emitname(p, n);
}

// ---------------------------------------------------------------- expressions
//
// wac's precedence, loosest first: ternary, `||`, `&&`, `|`, `^`, `&`, equality, comparison,
// shifts, additive, multiplicative, unary, postfix. Each level parses the one below and loops.

i32 args() {
  i32 n = 0;
  while (ispunct(41) == 0) {
    // `fill: x` — a named argument, which wac has and which carries no meaning to the emitter
    // beyond the value: the name is a readability device the callee's signature already fixes.
    if (kind() == K_NAME & aheadIs(1, 58)) { next(); next(); }
    expr();
    n = n + 1;
    if (ispunct(44)) { next(); }
  }
  want(41);
  return n;
}

// `Point(a, b)`, and `T[n]()` / `T[](a, b)` for an array. wac writes a construction as a call, so
// one token of lookahead past the name is what tells them apart.
i32 construct(i32 t) {
  if (ispunct(91)) {
    next();
    i32 sized = 0;
    if (ispunct(93) == 0) { expr(); sized = 1; }
    want(93);
    i32 at = ty_array(t);
    want(40);
    if (sized) {
      // `T[n](fill: v)` — the fill is evaluated and dropped, because `array.new_default` zeroes and
      // stage 2 does not carry a value into it. A gap, and the spec says so.
      i32 nf = args();
      i32 k = 0;
      while (k < nf) { line("drop"); k = k + 1; }
      word("array.new_default"); tyname(at); nl();
    } else {
      // `T[](a, b, c)` — a literal, whose length is how many arguments it has.
      i32 n2 = args();
      word("array.new_fixed"); tyname(at); sp(); emitn(n2); nl();
    }
    return at;
  }
  want(40);
  args();
  word("struct.new"); tyname(t); nl();
  return t;
}

// `.field`, `.len()`, `.method()`, and `[i]`.
i32 postfix(i32 t) {
  while (ispunct(46) | ispunct(91) | ispunct(33)) {
    if (ispunct(33)) {
      // `x!` — an assertion that a nullable is not null. Every reference here is already nullable,
      // so this is a no-op on the value and a promise the engine will not check.
      next();
    } else {
      if (ispunct(46)) {
        next();
        i32 p = tstart();
        i32 n = tlen();
        next();
        if (types[t].kind == T_ARRAY & texteq(p, n, "len")) {
          want(40); want(41);
          line("array.len");
          t = 0;
        } else {
          i32 mi = meth_find(t, p, n);
          if (mi != 0 - 1 & ispunct(40)) {
            next();
            args();
            word("call"); mangled(t, p, n); nl();
            t = meths[mi].ret;
          } else {
            i32 fi = field_index(t, p, n);
            if (fi == 0 - 1) { oops(); } else {
              i32 ft = fields[types[t].fstart + fi].ty;
              if (ty_packed(ft) != 0) {
                emits("struct.get"); signedsuffix(ft); sp(); tyname(t); sp(); emitn(fi); nl();
              } else {
                word("struct.get"); tyname(t); sp(); emitn(fi); nl();
              }
              t = ft;
            }
          }
        }
      } else {
        next();
        expr();
        want(93);
        if (types[t].kind != T_ARRAY) { oops(); }
        i32 et = types[t].elem;
        if (ty_packed(et) != 0) {
          emits("array.get"); signedsuffix(et); sp(); tyname(t); nl();
        } else {
          word("array.get"); tyname(t); nl();
        }
        t = et;
      }
    }
  }
  return t;
}

i32 field_index(i32 t, i32 p, i32 n) {
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < types[t].nfields) {
    i32 f = types[t].fstart + i;
    if (fields[f].namelen == n & samebytes(p, n, fields[f].nameptr)) { found = i; }
    i = i + 1;
  }
  return found;
}

i32 primary() {
  if (kind() == K_STR) { konst(str_add(tstart(), tlen())); next(); return postfix(0); }
  if (kind() == K_INT) { konst(val()); next(); return TY_I32; }
  if (ispunct(40)) { next(); i32 t0 = expr(); want(41); return postfix(t0); }
  if (ispunct(45)) {
    // Negation, at whatever width its operand turns out to be — so the zero has to be emitted
    // after the operand's type is known, which means holding the operand in a slot.
    next();
    i32 nt2 = primary();
    i32 held = slot_new(nt2);
    word("local.set"); slotname(held); nl();
    if (ty_wide(nt2)) { word("i64.const"); emitn(0); nl(); } else { konst(0); }
    word("local.get"); slotname(held); nl();
    binop(nt2, "sub");
    return nt2;
  }
  if (ispunct(33)) { next(); i32 nt3 = primary(); opprefix(nt3); emits("eqz"); nl(); return TY_BOOL; }
  if (ispunct(126)) {
    next();
    i32 nt4 = primary();
    if (ty_wide(nt4)) { word("i64.const"); emitn(-1); nl(); } else { konst(-1); }
    binop(nt4, "xor");
    return nt4;
  }
  if (isword("true")) { next(); konst(1); return TY_BOOL; }
  if (isword("false")) { next(); konst(0); return TY_BOOL; }
  if (isword("null")) { next(); line("ref.null none"); return 0; }
  if (isword("match")) { return match_expr(); }
  // `i32[3]()`, `u8[](…)`, `i16[n]()` — any primitive type can start a construction, and nothing
  // else that begins an expression does.
  i32 pt = prim_type();
  if (pt != 0 - 1) { next(); return construct(pt); }
  if (kind() == K_NAME) {
    i32 p = tstart();
    i32 n = tlen();
    next();
    i32 st = ty_named(p, n);
    if (st != 0 - 1 & (ispunct(40) | ispunct(91))) { return postfix(construct(st)); }
    i32 vi = var_find(p, n);
    if (vi != 0 - 1) { return postfix(construct_variant(vi)); }
    if (ispunct(40)) {
      next();
      args();
      word("call"); emit1(36); emitname(p, n); nl();
      i32 fi2 = fn_find(p, n);
      i32 rt = 0;
      if (fi2 != 0 - 1) { rt = fns[fi2].ret; }
      return postfix(rt);
    }
    i32 li = loc_find(p, n);
    if (li != 0 - 1) { word("local.get"); slotname(li); nl(); return postfix(loc_type(li)); }
    i32 gi = glo_find(p, n);
    if (gi != 0 - 1) { word("global.get"); gloname(gi); nl(); return postfix(glo_type(gi)); }
    // A bare `Type.staticMethod(...)` reaches here as a name with no local: wac writes a static
    // call that way, and stage 2 resolves it as `$Type_name`.
    if (ispunct(46)) {
      i32 ot = ty_named(p, n);
      if (ot != 0 - 1) { return postfix(ot); }
    }
    oops();
    return 0;
  }
  oops();
  return 0;
}

// `x as i64`, `n as u32`. `as!` is a *checked* cast in wac and traps on overflow; stage 3 emits the
// same conversion and does not check, which is a gap the spec names.
i32 cast() {
  i32 t = primary();
  while (isword("as")) {
    next();
    eat(33);
    i32 to = parse_type();
    if (ty_isnum(t) & ty_isnum(to)) {
      if (ty_wide(to) & ty_wide(t) == 0) {
        // `word` puts a space after what it writes, and an instruction's suffix is part of its
        // name — so this is `emits` and not `word`, which is a one-character mistake that reads as
        // an unknown instruction three rungs down.
        emits("i64.extend_i32");
        if (ty_signed(t)) { emits("_s"); } else { emits("_u"); }
        nl();
      }
      if (ty_wide(to) == 0 & ty_wide(t)) { line("i32.wrap_i64"); }
      // Everything else is a reinterpretation: `i32` and `u32` are one wasm type, and narrowing to
      // `u8` is what the store does.
    }
    t = to;
  }
  return t;
}

i32 mul() {
  i32 t = cast();
  while (ispunct(42) | ispunct(47) | ispunct(37)) {
    i32 op = val();
    next();
    cast();
    if (op == 42) { binop(t, "mul"); } else {
      if (op == 47) { binop_signed(t, "div"); } else { binop_signed(t, "rem"); }
    }
  }
  return t;
}

i32 add() {
  i32 t = mul();
  while (ispunct(43) | ispunct(45)) {
    i32 op = val();
    next();
    mul();
    if (op == 43) { binop(t, "add"); } else { binop(t, "sub"); }
  }
  return t;
}

i32 shift() {
  i32 t = add();
  while (ispunct(15420) | ispunct(15934)) {
    i32 op = val();
    next();
    add();
    if (op == 15420) { binop(t, "shl"); } else { binop_signed(t, "shr"); }
  }
  return t;
}

i32 rel() {
  i32 t = shift();
  while (ispunct(60) | ispunct(62) | ispunct(15676) | ispunct(15678)) {
    i32 op = val();
    next();
    shift();
    if (op == 60) { binop_signed(t, "lt"); } else {
      if (op == 62) { binop_signed(t, "gt"); } else {
        if (op == 15676) { binop_signed(t, "le"); } else { binop_signed(t, "ge"); }
      }
    }
    // A comparison answers a bool however wide its operands were.
    t = TY_BOOL;
  }
  return t;
}

i32 equality() {
  i32 t = rel();
  while (ispunct(15677) | ispunct(15649)) {
    i32 op = val();
    next();
    rel();
    if (op == 15677) { binop(t, "eq"); } else { binop(t, "ne"); }
    t = TY_BOOL;
  }
  return t;
}

i32 bitand() {
  i32 t = equality();
  while (ispunct(38)) { next(); equality(); binop(t, "and"); }
  return t;
}

i32 bitxor() {
  i32 t = bitand();
  while (ispunct(94)) { next(); bitand(); binop(t, "xor"); }
  return t;
}

i32 bitor() {
  i32 t = bitxor();
  while (ispunct(124)) { next(); bitxor(); binop(t, "or"); }
  return t;
}

// **Short-circuit, so an `if` and not an `and`.** `a && b` must not evaluate `b` when `a` is false,
// and wac programs rely on it — a guard followed by a dereference is the usual shape.
i32 logand() {
  i32 t = bitor();
  while (ispunct(9766)) {
    next();
    i32 l = newlabel();
    word("if"); label(l); sp(); word("->"); line("i32");
    bitor();
    line("i32.eqz");
    line("i32.eqz");
    line("else");
    konst(0);
    line("end");
    t = 0;
  }
  return t;
}

i32 logor() {
  i32 t = logand();
  while (ispunct(31868)) {
    next();
    i32 l = newlabel();
    word("if"); label(l); sp(); word("->"); line("i32");
    konst(1);
    line("else");
    logand();
    line("i32.eqz");
    line("i32.eqz");
    line("end");
    t = 0;
  }
  return t;
}

// A variant: the tag, then the payload struct, then the enum struct — in field order, because wasm
// takes a struct's fields in the order they are declared.
i32 construct_variant(i32 vi) {
  i32 owner = vars[vi].owner;
  konst(var_tag(vi));
  if (vars[vi].payload == 0 - 1) {
    line("ref.null none");
    if (ispunct(40)) { next(); want(41); }
  } else {
    want(40);
    args();
    word("struct.new"); tyname(vars[vi].payload); nl();
  }
  word("struct.new"); tyname(owner); nl();
  return owner;
}

// **`match` is both an expression and a statement in wac**, and they differ by one token: an arm's
// body is followed by `,` in the expression form and by `;` in the statement form. Both compile to
// the same shape — the scrutinee in a slot, one block per arm, a tag compare and a branch — so the
// only difference here is whether the arms leave a value.
i32 match_body(i32 wantValue) {
  want(40);
  i32 et = expr();
  want(41);
  i32 slot = slot_new(et);
  word("local.set"); slotname(slot); nl();
  i32 done = newlabel();
  word("block"); label(done); sp(); word("->");
  if (wantValue) { line("i32"); } else { nl(); }
  want(123);
  while (ispunct(125) == 0) {
    eatword("case");
    i32 vp = tstart();
    i32 vn = tlen();
    next();
    i32 vi = var_find(vp, vn);
    // Loudly: a `case` naming no variant would index the variant table at -1, and a GC array says
    // so at runtime rather than reading whatever is next in memory — which is the one place this
    // ladder's newest rung is better off than its oldest.
    if (vi == 0 - 1) { oops(); return 0; }
    i32 skip = newlabel();
    word("block"); label(skip); sp(); line("->");
    word("local.get"); slotname(slot); nl();
    word("struct.get"); tyname(et); sp(); line("0");
    konst(var_tag(vi));
    line("i32.ne");
    word("br_if"); label(skip); nl();

    i32 mark = nloc;
    if (ispunct(40)) {
      next();
      i32 pay = vars[vi].payload;
      i32 k = 0;
      while (ispunct(41) == 0) {
        // `_` binds nothing, which wac uses whenever the payload is not read.
        if (isword("_") == 0) {
          i32 ft = fields[types[pay].fstart + k].ty;
          word("local.get"); slotname(slot); nl();
          word("struct.get"); tyname(et); sp(); line("1");
          word("ref.cast"); word("ref"); tyname(pay); nl();
          word("struct.get"); tyname(pay); sp(); emitn(k); nl();
          word("local.set"); slotname(loc_add(tstart(), tlen(), ft)); nl();
        }
        k = k + 1;
        next();
        if (ispunct(44)) { next(); }
      }
      want(41);
    }
    want(58);
    if (wantValue) {
      expr();
      if (ispunct(44)) { next(); }
    } else {
      if (ispunct(123)) { block(); } else { statement(); }
    }
    nloc = mark;
    word("br"); label(done); nl();
    line("end");
  }
  want(125);
  // A tag matching no arm falls out. wac's `match` is exhaustive and this rung does not check it,
  // so the expression form has to leave *something* — and an unreachable zero is the honest one.
  if (wantValue) { konst(0); }
  line("end");
  return 0;
}

i32 match_expr() {
  next();
  match_body(1);
  return 0;
}

i32 ternary() {
  i32 t = logor();
  if (ispunct(63)) {
    next();
    i32 l = newlabel();
    word("if"); label(l); sp(); word("->"); line("i32");
    expr();
    line("else");
    want(58);
    i32 t2 = ternary();
    line("end");
    t = t2;
  }
  return t;
}

i32 expr() { return ternary(); }

// ---------------------------------------------------------------- statements

i32 block() {
  want(123);
  i32 mark = nloc;
  while (ispunct(125) == 0) { statement(); }
  want(125);
  nloc = mark;
  return 0;
}

i32 declaration() {
  eatword("const");
  i32 t = parse_type();
  i32 p = tstart();
  i32 n = tlen();
  next();
  if (ispunct(61)) { next(); expr(); } else {
    if (ty_isnum(t)) {
      if (ty_wide(t)) { word("i64.const"); emitn(0); nl(); } else { konst(0); }
    } else { line("ref.null none"); }
  }
  want(59);
  word("local.set"); slotname(loc_add(p, n, t)); nl();
  return 0;
}

// Does the `.field` or `[i]` chain starting here end in `=`? Without knowing, there is no way to
// decide whether to emit the base as a value or as the target of a store.
i32 chain_is_store() {
  i32 i = tp + 1;
  i32 ans = 0;
  i32 going = 1;
  while (going) {
    if (toks[i].kind == K_PUNCT & toks[i].val == 46) { i = i + 2; } else {
      if (toks[i].kind == K_PUNCT & toks[i].val == 91) {
        i32 depth = 1;
        i = i + 1;
        while (depth > 0) {
          if (toks[i].kind == K_PUNCT & toks[i].val == 91) { depth = depth + 1; }
          if (toks[i].kind == K_PUNCT & toks[i].val == 93) { depth = depth - 1; }
          i = i + 1;
        }
      } else {
        if (toks[i].kind == K_PUNCT & toks[i].val == 61) { ans = 1; }
        going = 0;
      }
    }
  }
  return ans;
}

// The base, then the value, then the store — so the walk stops one step short of the end and
// remembers what it was about to do.
i32 store_through() {
  i32 t = primary_base();
  while (1) {
    if (ispunct(46)) {
      next();
      i32 fp = tstart();
      i32 fn2 = tlen();
      next();
      i32 fi = field_index(t, fp, fn2);
      if (fi == 0 - 1) { oops(); return 0; }
      i32 ft = fields[types[t].fstart + fi].ty;
      if (ispunct(61)) {
        next();
        expr();
        want(59);
        word("struct.set"); tyname(t); sp(); emitn(fi); nl();
        return 0;
      }
      word("struct.get"); tyname(t); sp(); emitn(fi); nl();
      t = ft;
    } else {
      next();
      expr();
      want(93);
      i32 et = types[t].elem;
      if (ispunct(61)) {
        next();
        expr();
        want(59);
        word("array.set"); tyname(t); nl();
        return 0;
      }
      if (ty_packed(et) != 0) {
        emits("array.get"); signedsuffix(et); sp(); tyname(t); nl();
      } else {
        word("array.get"); tyname(t); nl();
      }
      t = et;
    }
  }
  return 0;
}

// A bare name, emitted without following its postfix — which is what a store target needs.
i32 primary_base() {
  i32 p = tstart();
  i32 n = tlen();
  next();
  i32 li = loc_find(p, n);
  if (li != 0 - 1) { word("local.get"); slotname(li); nl(); return loc_type(li); }
  i32 gi = glo_find(p, n);
  if (gi != 0 - 1) { word("global.get"); gloname(gi); nl(); return glo_type(gi); }
  oops();
  return 0;
}

// `x = e`, `x += e`, `x++`. The compound forms read the target first, which is why they are here
// rather than in the expression grammar: wac has no assignment expression.
i32 assign_or_expr() {
  i32 p = tstart();
  i32 n = tlen();
  if (kind() == K_NAME) {
    i32 compound = 0;
    if (aheadIs(1, 15659)) { compound = 43; }
    if (aheadIs(1, 15661)) { compound = 45; }
    if (aheadIs(1, 15658)) { compound = 42; }
    if (aheadIs(1, 15663)) { compound = 47; }
    i32 incr = 0;
    if (aheadIs(1, 11051)) { incr = 43; }
    if (aheadIs(1, 11565)) { incr = 45; }

    if (aheadIs(1, 61) | compound != 0 | incr != 0) {
      i32 li = loc_find(p, n);
      i32 gi = glo_find(p, n);
      next();
      next();
      if (incr != 0) {
        if (li != 0 - 1) { word("local.get"); slotname(li); nl(); } else {
          word("global.get"); gloname(gi); nl();
        }
        konst(1);
        if (incr == 43) { line("i32.add"); } else { line("i32.sub"); }
      } else {
        if (compound != 0) {
          if (li != 0 - 1) { word("local.get"); slotname(li); nl(); } else {
            word("global.get"); gloname(gi); nl();
          }
          expr();
          if (compound == 43) { line("i32.add"); } else {
            if (compound == 45) { line("i32.sub"); } else {
              if (compound == 42) { line("i32.mul"); } else { line("i32.div_s"); }
            }
          }
        } else {
          expr();
        }
      }
      want(59);
      if (li != 0 - 1) { word("local.set"); slotname(li); nl(); } else {
        if (gi != 0 - 1) { word("global.set"); gloname(gi); nl(); } else { oops(); }
      }
      return 0;
    }
  }
  if (kind() == K_NAME & (aheadIs(1, 46) | aheadIs(1, 91))) {
    if (chain_is_store()) { return store_through(); }
  }
  i32 dt = expr();
  want(59);
  // A call whose result is a value has to be dropped; one that answers nothing must not be. Stage 2
  // has no void, so everything answers something and everything is dropped.
  line("drop");
  return 0;
}

i32 if_statement() {
  next();
  want(40);
  expr();
  want(41);
  i32 l = newlabel();
  word("if"); label(l); sp(); line("->");
  if (ispunct(123)) { block(); } else { statement(); }
  if (isword("else")) {
    next();
    line("else");
    if (ispunct(123)) { block(); } else { statement(); }
  }
  line("end");
  return 0;
}

i32 while_statement() {
  next();
  i32 lo = newlabel();
  i32 li = newlabel();
  word("block"); label(lo); sp(); line("->");
  word("loop"); label(li); sp(); line("->");
  want(40);
  expr();
  want(41);
  line("i32.eqz");
  word("br_if"); label(lo); nl();
  if (ispunct(123)) { block(); } else { statement(); }
  word("br"); label(li); nl();
  line("end");
  line("end");
  return 0;
}

// `for (init; cond; step) body` is a block holding a `while`, which is what it means. The init's
// declaration is scoped to the loop, so the name table is marked and restored around the whole
// thing rather than around the body.
i32 for_statement() {
  next();
  want(40);
  i32 mark = nloc;
  if (ispunct(59)) { next(); } else {
    if (looks_like_decl()) { declaration(); } else { assign_or_expr(); }
  }
  i32 lo = newlabel();
  i32 li = newlabel();
  word("block"); label(lo); sp(); line("->");
  word("loop"); label(li); sp(); line("->");
  if (ispunct(59)) { konst(1); } else { expr(); }
  want(59);
  line("i32.eqz");
  word("br_if"); label(lo); nl();

  // The step is read before the body and emitted after it, so the token cursor has to go back —
  // which is free here, because the parser's whole state is one integer into the token array.
  i32 stepAt = tp;
  while (ispunct(41) == 0) { next(); }
  want(41);
  if (ispunct(123)) { block(); } else { statement(); }
  i32 afterBody = tp;
  tp = stepAt;
  if (ispunct(41) == 0) { assign_or_expr_nosemi(); }
  tp = afterBody;

  word("br"); label(li); nl();
  line("end");
  line("end");
  nloc = mark;
  return 0;
}

// The step of a `for`, which is an assignment without its semicolon.
i32 assign_or_expr_nosemi() {
  i32 p = tstart();
  i32 n = tlen();
  i32 li = loc_find(p, n);
  i32 gi = glo_find(p, n);
  if (aheadIs(1, 11051) | aheadIs(1, 11565)) {
    i32 up = 43;
    if (aheadIs(1, 11565)) { up = 45; }
    next(); next();
    if (li != 0 - 1) { word("local.get"); slotname(li); nl(); } else {
      word("global.get"); gloname(gi); nl();
    }
    konst(1);
    if (up == 43) { line("i32.add"); } else { line("i32.sub"); }
  } else {
    i32 compound = 0;
    if (aheadIs(1, 15659)) { compound = 43; }
    if (aheadIs(1, 15661)) { compound = 45; }
    next(); next();
    if (compound != 0) {
      if (li != 0 - 1) { word("local.get"); slotname(li); nl(); } else {
        word("global.get"); gloname(gi); nl();
      }
      expr();
      if (compound == 43) { line("i32.add"); } else { line("i32.sub"); }
    } else {
      expr();
    }
  }
  if (li != 0 - 1) { word("local.set"); slotname(li); nl(); } else {
    word("global.set"); gloname(gi); nl();
  }
  return 0;
}

i32 statement() {
  if (isword("return")) {
    next();
    if (ispunct(59)) { konst(0); } else { expr(); }
    want(59);
    line("return");
    return 0;
  }
  if (isword("trap")) { next(); want(59); line("unreachable"); return 0; }
  if (isword("match")) { next(); match_body(0); return 0; }
  if (isword("if")) { return if_statement(); }
  if (isword("while")) { return while_statement(); }
  if (isword("for")) { return for_statement(); }
  if (ispunct(123)) { return block(); }
  if (looks_like_decl()) { return declaration(); }
  return assign_or_expr();
}

// ---------------------------------------------------------------- declarations

// 64 pages is 4,194,304 bytes, so the last valid address is one below that — a scratch buffer
// placed *at* the limit is out of bounds on its first byte.
i32 BODY = 3145728;

i32 mowner = -1;

i32 slot_new(i32 t) {
  slotty[nslot] = t;
  nslot = nslot + 1;
  return nslot - 1;
}

i32 function(i32 out, i32 ret, i32 np, i32 nn) {
  want(40);
  nloc = 0;
  nslot = 0;
  while (ispunct(41) == 0) {
    eatword("const");
    if (isword("this")) { loc_add(tstart(), tlen(), mowner); next(); } else {
      i32 pt = parse_type();
      loc_add(tstart(), tlen(), pt);
      next();
    }
    if (ispunct(44)) { next(); }
  }
  want(41);
  i32 nparams = nslot;

  i32 outp = dp;
  dst = BODY;
  dp = 0;
  block();
  i32 blen = dp;

  dst = out;
  dp = outp;
  word("func");
  if (mowner == 0 - 1) { emit1(36); emitname(np, nn); } else { mangled(mowner, np, nn); }
  sp(); word("->"); slotvaltype(ret); nl();
  i32 i = 0;
  while (i < nparams) {
    word("param"); slotvaltype(slotty[i]); sp(); slotname(i); nl();
    i = i + 1;
  }
  i32 j = nparams;
  while (j < nslot) {
    word("local"); slotvaltype(slotty[j]); sp(); slotname(j); nl();
    j = j + 1;
  }
  i32 k = 0;
  while (k < blen) { emit1(load8(BODY + k)); k = k + 1; }
  if (ty_isnum(ret)) {
    if (ty_wide(ret)) { word("i64.const"); emitn(0); nl(); } else { konst(0); }
  } else { line("ref.null none"); }
  line("end");
  if (mowner == 0 - 1) {
    word("export"); emit1(34); emitname(np, nn); emit1(34); sp();
    word("func"); emit1(36); emitname(np, nn); nl();
  }
  nl();
  return 0;
}

// The `type` directives, into their own buffer and appended at the end — wac-L0 takes directives in
// any order, so an array type first named inside the last function needs no pre-pass.
i32 TYPEBUF = 3670016;
i32 typep = 0;

i32 emit_typedecls() {
  i32 saved = dst;
  i32 savedp = dp;
  dst = TYPEBUF;
  dp = typep;
  i32 i = 0;
  while (i < ntype) {
    if (types[i].kind == T_STRUCT) {
      word("type"); tyname(i); sp(); word("struct");
      i32 j = 0;
      while (j < types[i].nfields) {
        valtype(fields[types[i].fstart + j].ty);
        sp();
        j = j + 1;
      }
      nl();
    }
    if (types[i].kind == T_ARRAY) {
      word("type"); tyname(i); sp(); word("array"); valtype(types[i].elem); nl();
    }
    if (types[i].kind == T_ENUM) {
      word("type"); tyname(i); sp(); word("struct"); word("i32"); line("anyref");
    }
    i = i + 1;
  }
  typep = dp;
  dst = saved;
  dp = savedp;
  return 0;
}

// `struct Name { T f; … methods }` — a field is a type and a name and a `;`, a method is a type and
// a name and a `(`.
i32 struct_decl(i32 emitting, i32 out) {
  next();
  i32 p = tstart();
  i32 n = tlen();
  next();
  // A generic header — `struct Vec<T>` — is read and dropped. Stage 2 has no monomorphisation, so a
  // generic declaration compiles as if its letters were one unknown struct. That is stage 4's job.
  if (ispunct(60)) { while (ispunct(62) == 0) { next(); } next(); }
  i32 t = ty_named(p, n);
  if (t == 0 - 1) { t = ty_new(T_STRUCT, p, n, 0); }
  if (emitting == 0) { types[t] = Ty(T_STRUCT, p, n, 0, nfield, 0); }
  want(123);
  i32 count = 0;
  while (ispunct(125) == 0) {
    eatword("const");
    eatword("export");
    i32 ft = parse_type();
    i32 mp = tstart();
    i32 mn = tlen();
    next();
    if (ispunct(40)) {
      if (emitting) {
        mowner = t;
        function(out, ft, mp, mn);
        mowner = 0 - 1;
      } else {
        meths[nmeth] = Meth(t, mp, mn, ft);
        nmeth = nmeth + 1;
        while (ispunct(123) == 0) { next(); }
        i32 depth = 1;
        next();
        while (depth > 0) {
          if (ispunct(123)) { depth = depth + 1; }
          if (ispunct(125)) { depth = depth - 1; }
          next();
        }
      }
    } else {
      if (emitting == 0) {
        fields[nfield] = Field(mp, mn, ft);
        nfield = nfield + 1;
        count = count + 1;
      }
      want(59);
    }
  }
  want(125);
  if (emitting == 0) { types[t] = Ty(T_STRUCT, p, n, 0, types[t].fstart, count); }
  return 0;
}

// `enum Name { A(T v), B, … methods }` — variants first, comma-separated, then methods.
i32 enum_decl(i32 emitting, i32 out) {
  next();
  i32 p = tstart();
  i32 n = tlen();
  next();
  if (ispunct(60)) { while (ispunct(62) == 0) { next(); } next(); }
  i32 t = ty_named(p, n);
  if (t == 0 - 1) { t = ty_new(T_ENUM, p, n, 0); }
  if (emitting == 0) { types[t] = Ty(T_ENUM, p, n, 0, nvar, 0); }
  want(123);
  i32 count = 0;
  // A variant is a name; a method is a type *then* a name then `(`. One token of lookahead tells
  // them apart, because a variant's name is either followed by `(`, `,` or `}`.
  while (ispunct(125) == 0) {
    if (looks_like_member() == 0) {
      i32 vp = tstart();
      i32 vn = tlen();
      next();
      i32 payload = 0 - 1;
      if (ispunct(40)) {
        next();
        if (emitting == 0) {
          payload = ty_new(T_STRUCT, 0, 0, 0);
          types[payload] = Ty(T_STRUCT, 0, 0, 0, nfield, 0);
        }
        i32 nf = 0;
        while (ispunct(41) == 0) {
          i32 ft2 = parse_type();
          if (emitting == 0) {
            fields[nfield] = Field(tstart(), tlen(), ft2);
            nfield = nfield + 1;
          }
          nf = nf + 1;
          next();
          if (ispunct(44)) { next(); }
        }
        want(41);
        if (emitting == 0) {
          types[payload] = Ty(T_STRUCT, 0, 0, 0, types[payload].fstart, nf);
        }
      }
      if (emitting == 0) {
        vars[nvar] = Var(vp, vn, payload, t);
        nvar = nvar + 1;
        count = count + 1;
      }
      if (ispunct(44)) { next(); }
    } else {
      eatword("const");
      eatword("export");
      i32 mt = parse_type();
      i32 mp2 = tstart();
      i32 mn2 = tlen();
      next();
      if (emitting) {
        mowner = t;
        function(out, mt, mp2, mn2);
        mowner = 0 - 1;
      } else {
        meths[nmeth] = Meth(t, mp2, mn2, mt);
        nmeth = nmeth + 1;
        while (ispunct(123) == 0) { next(); }
        i32 depth2 = 1;
        next();
        while (depth2 > 0) {
          if (ispunct(123)) { depth2 = depth2 + 1; }
          if (ispunct(125)) { depth2 = depth2 - 1; }
          next();
        }
      }
    }
  }
  want(125);
  if (emitting == 0) { types[t] = Ty(T_ENUM, p, n, 0, types[t].fstart, count); }
  return 0;
}

// One scan for every top-level name, so a call to something declared later resolves.
i32 collect() {
  tp = 0;
  while (kind() != K_EOF) {
    eatword("export");
    if (isword("import")) { while (ispunct(59) == 0) { next(); } next(); } else {
    if (isword("struct")) { struct_decl(0, 0); } else {
    if (isword("enum")) { enum_decl(0, 0); } else {
    i32 ret = parse_type();
    i32 p = tstart();
    i32 n = tlen();
    next();
    if (ispunct(40)) {
      fns[nfn] = Fn(p, n, ret);
      nfn = nfn + 1;
      while (ispunct(123) == 0) { next(); }
      i32 depth = 1;
      next();
      while (depth > 0) {
        if (ispunct(123)) { depth = depth + 1; }
        if (ispunct(125)) { depth = depth - 1; }
        next();
      }
    } else {
      glos[nglo] = Glo(p, n, ret);
      nglo = nglo + 1;
      while (ispunct(59) == 0) { next(); }
      next();
    }}}}
  }
  return 0;
}

i32 compile(i32 s, i32 out) {
  src = s;
  srclen = 0;
  while (load8(src + srclen) != 0) { srclen = srclen + 1; }

  types = Ty[2048]();
  fields = Field[8192]();
  vars = Var[2048]();
  meths = Meth[2048]();
  ntype = 0;
  nfield = 0;
  nvar = 0;
  nmeth = 0;
  typep = 0;
  mowner = 0 - 1;
  // Reserved, not assumed: the first struct registered would otherwise be index 0, and `valtype`
  // reads a 0 as the number type.
  i32 nt = 0;
  while (nt < NUMTYPES) { ty_new(T_NUM, 0, 0, 0); nt = nt + 1; }
  locs = Local[4096]();
  slotty = i32[4096]();
  glos = Glo[1024]();
  strs = Str[4096]();
  fns = Fn[4096]();
  nloc = 0;
  nslot = 0;
  nglo = 0;
  nstr = 0;
  nfn = 0;
  strnext = 1024;
  labn = 0;

  lex();
  collect();

  tp = 0;
  dst = out;
  dp = 0;
  line("memory 64");
  word("export"); emit1(34); emits("memory"); emit1(34); sp(); line("memory");
  nl();

  i32 gi = 0;
  while (gi < nglo) {
    word("global"); gloname(gi); sp(); slotvaltype(glos[gi].ty); sp(); word("mut"); word("=");
    emitn(0); nl();
    gi = gi + 1;
  }
  nl();

  while (kind() != K_EOF) {
    eatword("export");
    if (isword("import")) { while (ispunct(59) == 0) { next(); } next(); } else {
    if (isword("struct")) { struct_decl(1, out); } else {
    if (isword("enum")) { enum_decl(1, out); } else {
    i32 ret = parse_type();
    i32 p = tstart();
    i32 n = tlen();
    next();
    if (ispunct(40)) {
      mowner = 0 - 1;
      function(out, ret, p, n);
    } else {
      // A global's initialiser is not run: wac's may be any expression and wasm's may not, so the
      // global emits as zero and the program is expected to set it.
      while (ispunct(59) == 0) { next(); }
      next();
    }}}}
  }
  emit_strdata();
  emit_typedecls();
  i32 ti = 0;
  while (ti < typep) { emit1(load8(TYPEBUF + ti)); ti = ti + 1; }
  return dp;
}
