// wac-L5 — a compiler for wac itself, written in wac-L4. See spec/l5.md.
//
// This is the rung that is *handed* its language: it has to accept whatever `packages/wacc/src`
// happens to be written in, rather than whatever we chose. Stage 1 is the shape of real wac — its
// declarations, its statements, its full precedence chain — over the i32 subset, so that the parts
// that are only breadth (integer widths, casts, strings) and the one part that is depth (generics)
// can each be added to something that already parses the language.
//
// It is written in wac-L4, so it has structs, arrays, `enum`/`match`, methods and GC. The tables
// below are GC arrays rather than fixed addresses, which is the first thing on this ladder that has
// been true of a compiler here.

struct Tok { i32 kind; i32 start; i32 len; i32 val; }

Tok[] toks;
i32 ntok = 0;
i32 tp = 0;
i32 src = 0;
i32 dst = 0;
i32 dp = 0;
i32 outbuf = 0;
i32 labn = 0;

// Token kinds.
i32 K_EOF = 0;
i32 K_INT = 1;
i32 K_NAME = 2;
i32 K_PUNCT = 3;
i32 K_STR = 4;

// ---------------------------------------------------------------- emitting

// **Every buffer has an end, and running past it should say so.** A parser that loses its place
// emits until it falls out of memory, and what arrives is `memory access out of bounds` from an
// address unrelated to the mistake — which has cost more of this project's debugging than any
// actual bug. Refusing at the boundary turns that into a marker the assembler will name.
i32 overflowed = 0;

// The room left in whichever buffer `dst` names. It cannot be asked of `outbuf`, which is the
// *destination a nested emit should return to* and is set to the body scratch while a body is being
// written — so the first version of this allowed twelve megabytes into a buffer holding one.
i32 realout = 0;

i32 emit_room() {
  if (dst == realout) { return 12000000; }
  if (dst == TYPEBUF) { return 3000000; }
  return 1000000;
}

i32 emit1(i32 b) {
  if (dp >= emit_room()) { overflowed = 1; return 0; }
  store8(dst + dp, b);
  dp = dp + 1;
  return 0;
}

i32 emits(i32 s) {
  i32 n = load(s);
  i32 i = 0;
  while (i < n) { emit1(load8(s + 4 + i)); i = i + 1; }
  return 0;
}

i32 emitd(i32 n) {
  if (n > 9) { emitd(n / 10); }
  emit1(48 + n % 10);
  return 0;
}

i32 emitn(i32 n) {
  if (n < 0) { emit1(45); emitd(0 - n); } else { emitd(n); }
  return 0;
}

i32 sp() { return emit1(32); }
i32 nl() { return emit1(10); }
i32 word(i32 s) { emits(s); return sp(); }
i32 line(i32 s) { emits(s); return nl(); }
i32 konst(i32 n) { word("i32.const"); emitn(n); return nl(); }
i32 label(i32 n) { emits("$b"); return emitn(n); }
i32 newlabel() { labn = labn + 1; return labn; }

i32 emitname(i32 p, i32 n) {
  i32 i = 0;
  while (i < n) { emit1(load8(src + p + i)); i = i + 1; }
  return 0;
}

// ---------------------------------------------------------------- source

i32 at(i32 i) { return load8(src + i); }
i32 isspace(i32 c) { return c == 32 | c == 10 | c == 13 | c == 9; }
i32 isdigit(i32 c) { return c >= 48 & c <= 57; }
i32 isalpha(i32 c) { return c == 95 | (c >= 97 & c <= 122) | (c >= 65 & c <= 90); }
i32 isalnum(i32 c) { return isalpha(c) | isdigit(c); }
i32 isxdigit(i32 c) {
  return (c >= 48 & c <= 57) | (c >= 97 & c <= 102) | (c >= 65 & c <= 70);
}
i32 hexval(i32 c) {
  if (c <= 57) { return c - 48; }
  if (c >= 97) { return c - 87; }
  return c - 55;
}

i32 texteq(i32 p, i32 n, i32 s) {
  i32 r = 1;
  if (n != load(s)) { r = 0; } else {
    i32 i = 0;
    while (i < n) {
      if (at(p + i) != load8(s + 4 + i)) { r = 0; }
      i = i + 1;
    }
  }
  return r;
}

i32 samebytes(i32 a, i32 n, i32 b) {
  i32 r = 1;
  i32 i = 0;
  while (i < n) {
    if (at(a + i) != at(b + i)) { r = 0; }
    i = i + 1;
  }
  return r;
}

// ---------------------------------------------------------------- the lexer
//
// Punctuation packs its bytes into one word, so `<=` is 60 + 61*256 and a two-byte operator is one
// integer compare. wac's three-byte operators are `<<=` and `>>=`, which nothing in `wacc/src`
// uses, so they are not here yet — and the lexer says so rather than mis-reading them.

i32 srclen = 0;

i32 pack2(i32 a, i32 b) { return a + b * 256; }

i32 lex() {
  toks = Tok[srclen + 4]();
  ntok = 0;
  i32 p = 0;
  while (at(p) != 0) {
    i32 c = at(p);
    if (isspace(c)) { p = p + 1; } else {
      if (c == 47 & at(p + 1) == 47) {
        while (at(p) != 0 & at(p) != 10) { p = p + 1; }
      } else {
        // A `/* … */` comment, which wac uses for every doc comment in the tree.
        if (c == 47 & at(p + 1) == 42) {
          p = p + 2;
          while (at(p) != 0 & (at(p) != 42 | at(p + 1) != 47)) { p = p + 1; }
          if (at(p) != 0) { p = p + 2; }
        } else {
          if (isdigit(c)) {
            i32 v = 0;
            i32 s0 = p;
            // `0x80` — a byte range, a mask, a UTF-8 lead. A lexer written in wac is full of them
            // and there is no other way to write one. `_` separates digits in wac and means nothing.
            if (c == 48 & (at(p + 1) == 120 | at(p + 1) == 88)) {
              p = p + 2;
              while (isxdigit(at(p)) | at(p) == 95) {
                if (at(p) != 95) { v = v * 16 + hexval(at(p)); }
                p = p + 1;
              }
            } else {
              while (isdigit(at(p)) | at(p) == 95) {
                if (at(p) != 95) { v = v * 10 + at(p) - 48; }
                p = p + 1;
              }
            }
            toks[ntok] = Tok(K_INT, s0, p - s0, v);
            ntok = ntok + 1;
          } else {
            // **A character literal is a number.** `'0'` and `'\n'` are how a lexer written in wac
            // spells a byte; there is no character type, so this makes an INT and nothing
            // downstream needs to know it was written with quotes.
            if (c == 39) {
              p = p + 1;
              i32 cv = at(p);
              if (cv == 92) {
                p = p + 1;
                i32 e = at(p);
                cv = e;
                if (e == 110) { cv = 10; }
                if (e == 116) { cv = 9; }
                if (e == 114) { cv = 13; }
                if (e == 48) { cv = 0; }
              }
              p = p + 1;
              i32 cs = p;
              if (at(p) == 39) { p = p + 1; }
              toks[ntok] = Tok(K_INT, cs, 1, cv);
              ntok = ntok + 1;
            } else {
            if (c == 34) {
              p = p + 1;
              i32 s1 = p;
              while (at(p) != 0 & at(p) != 34) {
                if (at(p) == 92) { p = p + 1; }
                p = p + 1;
              }
              toks[ntok] = Tok(K_STR, s1, p - s1, 0);
              ntok = ntok + 1;
              p = p + 1;
            } else {
              if (isalpha(c)) {
                i32 s2 = p;
                while (isalnum(at(p))) { p = p + 1; }
                toks[ntok] = Tok(K_NAME, s2, p - s2, 0);
                ntok = ntok + 1;
              } else {
                i32 d = at(p + 1);
                i32 v2 = c;
                i32 w = 1;
                // The two-byte operators wac has: comparison, the logicals, the increments, and
                // compound assignment.
                if (d == 61 & (c == 61 | c == 33 | c == 60 | c == 62
                             | c == 43 | c == 45 | c == 42 | c == 47 | c == 37)) {
                  v2 = pack2(c, d);
                  w = 2;
                }
                if (c == 38 & d == 38) { v2 = pack2(c, d); w = 2; }
                if (c == 124 & d == 124) { v2 = pack2(c, d); w = 2; }
                if (c == 43 & d == 43) { v2 = pack2(c, d); w = 2; }
                if (c == 45 & d == 45) { v2 = pack2(c, d); w = 2; }
                if (c == 60 & d == 60) { v2 = pack2(c, d); w = 2; }
                if (c == 62 & d == 62) { v2 = pack2(c, d); w = 2; }
                toks[ntok] = Tok(K_PUNCT, p, w, v2);
                ntok = ntok + 1;
                p = p + w;
              }
            }
          }}
        }
      }
    }
  }
  toks[ntok] = Tok(K_EOF, p, 0, 0);
  return 0;
}

// ---------------------------------------------------------------- the cursor

i32 kind() { return toks[tp].kind; }
i32 val() { return toks[tp].val; }
i32 tstart() { return toks[tp].start; }
i32 tlen() { return toks[tp].len; }
i32 next() { tp = tp + 1; return 0; }
i32 ispunct(i32 v) { return (toks[tp].kind == K_PUNCT) & (toks[tp].val == v); }
i32 aheadIs(i32 k, i32 v) { return (toks[tp + k].kind == K_PUNCT) & (toks[tp + k].val == v); }
i32 isword(i32 s) { return (toks[tp].kind == K_NAME) & texteq(toks[tp].start, toks[tp].len, s); }
i32 eat(i32 v) { if (ispunct(v)) { next(); return 1; } return 0; }
i32 oops() { nl(); line("!! wac-L5: unexpected token"); return 0; }
i32 want(i32 v) { if (eat(v)) { return 0; } return oops(); }
i32 eatword(i32 s) { if (isword(s)) { next(); return 1; } return 0; }

// **`>>` closes two type-argument lists**, and `Vec<Vec<i32>>` ends with one token that has to be
// consumed twice. The lexer is right to pack it — it is a shift everywhere else — so the token is
// rewritten in place as the *second* `>` and left where it is. The next closer finds a plain one.
i32 at_gt() { return ispunct(62) | ispunct(15934); }

i32 eat_gt() {
  if (ispunct(62)) { next(); return 1; }
  if (ispunct(15934)) {
    toks[tp] = Tok(K_PUNCT, toks[tp].start + 1, 1, 62);
    return 1;
  }
  return 0;
}

// ---------------------------------------------------------------- locals
//
// As in wac-L4: a declaration always takes a fresh slot and only the *name* is popped when a block
// ends, so shadowing costs a slot and no renaming.

struct Local { i32 nameptr; i32 namelen; i32 slot; i32 ty; }
Local[] locs;
i32 nloc = 0;
i32 nslot = 0;
i32[] slotty;

i32 loc_add(i32 p, i32 n, i32 t) {
  locs[nloc] = Local(p, n, nslot, t);
  // Slots are never popped and names are, and the function header — written after the body, because
  // wasm wants locals declared before it — needs the types the name table has by then thrown away.
  slotty[nslot] = t;
  nloc = nloc + 1;
  nslot = nslot + 1;
  return nslot - 1;
}

i32 loc_at = -1;

i32 loc_find(i32 p, i32 n) {
  i32 i = nloc;
  i32 found = 0 - 1;
  loc_at = 0 - 1;
  while (i > 0) {
    i = i - 1;
    if (found == 0 - 1) {
      if (locs[i].namelen == n & samebytes(p, n, locs[i].nameptr)) {
        found = locs[i].slot;
        loc_at = i;
      }
    }
  }
  return found;
}

i32 loc_type(i32 slot) { return slotty[slot]; }

i32 slotname(i32 s) { emits("$v"); return emitn(s); }

// ---------------------------------------------------------------- globals

struct Glo { i32 nameptr; i32 namelen; i32 ty; }
Glo[] glos;
i32 nglo = 0;

i32 glo_find(i32 p, i32 n) {
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < nglo) {
    if (glos[i].namelen == n & samebytes(p, n, glos[i].nameptr)) { found = i; }
    i = i + 1;
  }
  return found;
}

i32 gloname(i32 i) { emits("$g"); return emitn(i); }

// ---------------------------------------------------------------- string literals

struct Str { i32 off; i32 ptr; i32 len; }
Str[] strs;
i32 nstr = 0;
i32 strnext = 1024;

// wac's escapes, as bytes. Only the ones `wacc/src` uses; an unknown one is left as written, which
// is wrong in a way the assembler will not catch and is therefore listed in the spec as a gap.
i32 unescape(i32 c) {
  if (c == 110) { return 10; }
  if (c == 116) { return 9; }
  if (c == 114) { return 13; }
  if (c == 48) { return 0; }
  return c;
}

i32 str_add(i32 p, i32 n) {
  strs[nstr] = Str(strnext, p, n);
  nstr = nstr + 1;
  strnext = strnext + 4 * ((4 + n + 3) / 4);
  return strs[nstr - 1].off;
}

i32 hexd(i32 d) { if (d < 10) { return 48 + d; } return 87 + d; }
i32 emithex(i32 b) {
  emit1(92); emit1(120); emit1(hexd(b / 16)); return emit1(hexd(b % 16));
}

i32 emit_strdata() {
  i32 i = 0;
  while (i < nstr) {
    i32 p = strs[i].ptr;
    i32 n = strs[i].len;
    word("data"); emitn(strs[i].off); sp(); emit1(34);
    emithex(n % 256); emithex(n / 256 % 256); emithex(n / 65536 % 256); emithex(n / 16777216);
    i32 j = 0;
    while (j < n) { emithex(at(p + j)); j = j + 1; }
    emit1(34); nl();
    i = i + 1;
  }
  return 0;
}

// ---------------------------------------------------------------- functions

struct Fn { i32 nameptr; i32 namelen; i32 ret; }
Fn[] fns;
i32 nfn = 0;

// **A generic free function.** `Option<U> mapOption<T, U>(Option<T> o, fn[U(T)] f)` — its letters
// appear in its *return type*, before anything has bound them, so the whole declaration has to be
// recognised before its return type is parsed or `U` is read as a struct nobody declared and an
// `Option<U>` is instantiated over it.
//
// Recorded and skipped. Instantiating one means monomorphising a *function*, with the arguments
// inferred rather than written, and that is not built — so calling one is refused by name rather
// than compiled into something plausible.
struct GFn { i32 nameptr; i32 namelen; }
GFn[] gfns;
i32 ngfn = 0;

i32 gfn_find(i32 p, i32 n) {
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < ngfn) {
    if (gfns[i].namelen == n & samebytes(p, n, gfns[i].nameptr)) { found = i; }
    i = i + 1;
  }
  return found;
}

i32 glo_type(i32 i) { return glos[i].ty; }

i32 fn_find(i32 p, i32 n) {
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < nfn) {
    if (fns[i].namelen == n & samebytes(p, n, fns[i].nameptr)) { found = i; }
    i = i + 1;
  }
  return found;
}

// ---------------------------------------------------------------- types
//
// Index 0 is `i32` and index 1 is `u8`, both reserved rather than assumed — the first struct to be
// registered would otherwise take index 0, and every local of that type would emit as `i32`. That
// was a real bug at wac-L4 and is written down here so it is not a second one.

struct Ty { i32 kind; i32 nameptr; i32 namelen; i32 elem; i32 fstart; i32 nfields; }
Ty[] types;
i32 ntype = 0;

struct Field { i32 nameptr; i32 namelen; i32 ty; }
Field[] fields;
i32 nfield = 0;

// **A funcref's parameters get their own table.** They used to share the struct field table, and a
// funcref written *inside* a struct's field list appends to it while the struct is halfway through
// filling it — so `struct Op { fn[i32(i32)] f; }` took the funcref's parameter as its own field 0.
// Two producers, one array, one of them nested inside the other's range.
i32[] fparams;
i32 nfparam = 0;

// **The numeric lattice.** wasm has two integer value types and wac has eight names for them, which
// differ in width and in signedness — and those two facts decide which instruction every operator
// emits. `u32 / u32` is `i32.div_u` and `i32 / i32` is `i32.div_s`, and nothing else in the
// compiler can tell them apart.
i32 T_NUM = 0;
i32 T_STRUCT = 2;
i32 T_ARRAY = 3;
i32 T_ENUM = 4;
// A funcref: `fn[R(A, B)]`. Its parameters live in the field table and its result in `elem`, so it
// reuses the two things a struct already needed.
i32 T_FUNC = 5;

// Reserved indices, in this order, so that `valtype(0)` is `i32` and the first struct cannot take
// the slot.
i32 TY_I32 = 0;
i32 TY_U8 = 1;
i32 TY_I64 = 2;
i32 TY_U32 = 3;
i32 TY_BOOL = 4;
i32 TY_I8 = 5;
i32 TY_U16 = 6;
i32 TY_I16 = 7;
i32 TY_U64 = 8;
// **`void` is a type here**, so that a function's result is one thing the whole compiler agrees on
// rather than a flag beside it. It is the only one that emits no value type at all.
i32 TY_VOID = 9;
i32 NUMTYPES = 10;

// Is it held in an i64? Everything else this rung has fits an i32.
i32 ty_wide(i32 t) { return t == TY_I64 | t == TY_U64; }
i32 ty_signed(i32 t) { return (t == TY_U32 | t == TY_U8 | t == TY_U16 | t == TY_U64) == 0; }
i32 ty_isnum(i32 t) { return t < NUMTYPES; }

// The width a value is *stored* in when it is an array element or a struct field. wasm has i8 and
// i16 as storage types and no others.
i32 ty_packed(i32 t) {
  if (t == TY_U8 | t == TY_I8) { return 8; }
  if (t == TY_U16 | t == TY_I16) { return 16; }
  return 0;
}

i32 ty_new(i32 kind, i32 p, i32 n, i32 elem) {
  types[ntype] = Ty(kind, p, n, elem, nfield, 0);
  ntype = ntype + 1;
  return ntype - 1;
}

i32 ty_named(i32 p, i32 n) {
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < ntype) {
    if (types[i].namelen == n & n > 0 & samebytes(p, n, types[i].nameptr)) {
      if (types[i].kind == T_STRUCT | types[i].kind == T_ENUM) { found = i; }
    }
    i = i + 1;
  }
  return found;
}

i32 ty_array(i32 elem) {
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < ntype) {
    if (types[i].kind == T_ARRAY & types[i].elem == elem) { found = i; }
    i = i + 1;
  }
  if (found == 0 - 1) { found = ty_new(T_ARRAY, 0, 0, elem); }
  return found;
}

i32 tyname(i32 t) {
  if (types[t].kind == T_ARRAY) { emits("$a"); } else {
    if (types[t].kind == T_ENUM) { emits("$e"); } else {
      if (types[t].kind == T_FUNC) { emits("$f"); } else { emits("$s"); }
    }
  }
  return emitn(t);
}

i32 valtype(i32 t) {
  if (ty_isnum(t) == 0) { word("refnull"); tyname(t); return 0; }
  if (ty_wide(t)) { emits("i64"); return 0; }
  i32 pk = ty_packed(t);
  if (pk == 8) { emits("i8"); return 0; }
  if (pk == 16) { emits("i16"); return 0; }
  emits("i32");
  return 0;
}

// The value type a local or a parameter of this type takes. A packed type has none — wasm has no i8
// *value* — so it widens to i32, which is what reading one answers anyway.
i32 slotvaltype(i32 t) {
  if (t == TY_VOID) { return 0; }
  if (ty_isnum(t) == 0) { word("refnull"); tyname(t); return 0; }
  if (ty_wide(t)) { emits("i64"); return 0; }
  emits("i32");
  return 0;
}

// `i32.` or `i64.`, which is the prefix on every arithmetic instruction.
i32 opprefix(i32 t) { if (ty_wide(t)) { emits("i64."); } else { emits("i32."); } return 0; }

// The signed or unsigned form of an instruction that has both.
i32 signedsuffix(i32 t) { if (ty_signed(t)) { emits("_s"); } else { emits("_u"); } return 0; }

i32 binop(i32 t, i32 name) { opprefix(t); emits(name); return nl(); }

// **The right operand, widened to the left's width.** `h >> 33` on a `u64` writes the shift amount
// as a plain integer, and wasm wants both operands the same width — but the value is already on the
// stack, so the conversion goes after it and applies to the top. wac's own rule is that a literal
// takes the type of what it is used with, and this is that rule where it lands.
i32 coerce(i32 t, i32 rt) {
  if (ty_wide(t) & ty_wide(rt) == 0) {
    emits("i64.extend_i32");
    if (ty_signed(rt)) { emits("_s"); } else { emits("_u"); }
    nl();
  }
  return 0;
}

// The zero of a type. `none` and `nofunc` are two different bottoms — wasm's reference types are two
// hierarchies that never meet — so a funcref's null is not the one everything else uses.
i32 zero_of(i32 t) {
  if (t == TY_VOID) { return 0; }
  if (ty_isnum(t)) {
    if (ty_wide(t)) { word("i64.const"); emitn(0); return nl(); }
    return konst(0);
  }
  if (types[t].kind == T_FUNC) { return line("ref.null nofunc"); }
  return line("ref.null none");
}

i32 binop_signed(i32 t, i32 name) { opprefix(t); emits(name); signedsuffix(t); return nl(); }

// A type, read in full. `T?` is the same wasm type as `T`: every reference this emitter writes is
// already nullable, and a nullable *primitive* is boxed in wac and is not — which is a gap, and the
// spec says so rather than this pretending otherwise.
// The primitive named at the cursor, or -1. One list, consulted by `parse_type` and by the
// expression grammar, so that a type name means the same thing in both.
// **`string` is a GC array of bytes**, and the same array type a `u8[]` is — so `.len()` and `[i]`
// work on it without a second implementation, and a literal and a built string are one kind of
// value. wac's `string` is immutable and this is not, which is a gap and not a difference anything
// here can observe.
i32 strty = -1;

i32 string_type() {
  if (strty == 0 - 1) { strty = ty_array(TY_U8); }
  return strty;
}

i32 usedstr = 0;
i32 usedcat = 0;
i32 usedeq = 0;

i32 prim_type() {
  if (isword("void")) { return TY_VOID; }
  if (isword("i32")) { return TY_I32; }
  if (isword("bool")) { return TY_BOOL; }
  if (isword("i64")) { return TY_I64; }
  if (isword("u32")) { return TY_U32; }
  if (isword("u64")) { return TY_U64; }
  if (isword("i8")) { return TY_I8; }
  if (isword("u8")) { return TY_U8; }
  if (isword("u16")) { return TY_U16; }
  if (isword("i16")) { return TY_I16; }
  return 0 - 1;
}

// `string` is a type name but not a primitive: it answers an array type, so it cannot come from the
// same list as the ones that answer themselves.
i32 is_string_word() { return isword("string"); }

// `Vec<i32>` — or `Vec` with no arguments inside its own body, which means the instantiation being
// expanded. A fresh type index is handed out per distinct argument list and the expansion happens
// later, in rounds.
i32 instantiate(i32 tm) {
  if (ispunct(60) == 0) {
    // A bare template name: inside its own expansion it means *this* instantiation, and at a
    // declaration it means whatever the slot said.
    if (cur_inst_ty != 0 - 1) { return cur_inst_ty; }
    if (expect_ty != 0 - 1) { return expect_ty; }
    return ty_new(T_STRUCT, tmpls[tm].nameptr, tmpls[tm].namelen, 0);
  }
  next();
  i32 astart = niarg;
  i32 na = 0;
  while (at_gt() == 0) {
    iargs[niarg] = parse_type();
    niarg = niarg + 1;
    na = na + 1;
    if (ispunct(44)) { next(); }
  }
  eat_gt();
  i32 have = inst_find(tm, astart, na);
  if (have != 0 - 1) {
    niarg = astart;
    return insts[have].ty;
  }
  i32 ty = ty_new(tmpls[tm].kind, tmpls[tm].nameptr, tmpls[tm].namelen, 0);
  insts[ninst] = Inst(tm, ty, astart, na, 0, 0);
  ninst = ninst + 1;
  expand_one(ninst - 1);
  return ty;
}

// `fn[R(A, B)]`. The result comes first in wac and last in wasm, which is the only thing to get
// right here. Deduplicated by shape, so two parameters of the same funcref type are one wasm type.
i32 parse_functype() {
  next();
  want(91);
  i32 ret = parse_type();
  want(40);
  i32 fstart = nfparam;
  i32 np = 0;
  while (ispunct(41) == 0) {
    i32 pt2 = parse_type();
    fparams[nfparam] = pt2;
    nfparam = nfparam + 1;
    np = np + 1;
    if (ispunct(44)) { next(); }
  }
  want(41);
  want(93);
  // Same shape, same type — a funcref is structural, unlike a struct.
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < ntype) {
    if (types[i].kind == T_FUNC & types[i].elem == ret & types[i].nfields == np) {
      i32 k = 0;
      i32 same = 1;
      while (k < np) {
        if (fparams[types[i].fstart + k] != fparams[fstart + k]) { same = 0; }
        k = k + 1;
      }
      if (same) { found = i; }
    }
    i = i + 1;
  }
  if (found != 0 - 1) { nfparam = fstart; return found; }
  i32 ft = ty_new(T_FUNC, 0, 0, ret);
  types[ft] = Ty(T_FUNC, 0, 0, ret, fstart, np);
  return ft;
}

i32 parse_type() {
  i32 t = 0;
  i32 pr = prim_type();
  if (isword("fn")) { t = parse_functype(); } else {
  if (is_string_word()) { next(); t = string_type(); } else {
  if (pr != 0 - 1) { t = pr; next(); } else {
    i32 p = tstart();
    i32 n = tlen();
    next();
    i32 sv = sub_find(p, n);
    if (sv != 0 - 1) { t = sv; } else {
      i32 tm = tmpl_find(p, n);
      if (tm != 0 - 1) { t = instantiate(tm); } else {
        t = ty_named(p, n);
        if (t == 0 - 1) { t = ty_new(T_STRUCT, p, n, 0); }
      }
    }
  }}}
  while (ispunct(91) & aheadIs(1, 93)) { next(); next(); t = ty_array(t); }
  if (ispunct(63)) { next(); }
  return t;
}

// A type, then a name, then `(` — which is how a *member function* begins inside a struct or an
// enum body, and nothing else there does. Without this, the last variant before the first method
// reads as that method's return type: `None` followed by `bool isSome(` is a name followed by a
// name, and so is `bool isSome`.
i32 looks_like_member() {
  i32 i = tp;
  if (toks[i].kind != K_NAME) { return 0; }
  if (texteq(toks[i].start, toks[i].len, "const")) { return 1; }
  if (texteq(toks[i].start, toks[i].len, "export")) { return 1; }
  i32 e = skip_type(i);
  if (e == 0 - 1) { return 0; }
  if (toks[e].kind != K_NAME) { return 0; }
  return toks[e + 1].kind == K_PUNCT & toks[e + 1].val == 40;
}

// Steps over `<…>`, counting `>>` as two closers — which is what `Vec<Vec<i32>>` ends with, because
// the lexer packs it into a shift and is right to everywhere else.
i32 skip_targs(i32 i) {
  if ((toks[i].kind == K_PUNCT & toks[i].val == 60) == 0) { return i; }
  i32 depth = 0;
  while (1) {
    if (toks[i].kind == K_EOF) { return i; }
    if (toks[i].kind == K_PUNCT) {
      if (toks[i].val == 60) { depth = depth + 1; }
      if (toks[i].val == 62) { depth = depth - 1; }
      if (toks[i].val == 15934) { depth = depth - 2; }
    }
    i = i + 1;
    if (depth <= 0) { return i; }
  }
  return i;
}

// Steps over a whole type, whatever shape it has, and answers where it ends — or -1 if what is
// there is not one. **One skipper, consulted by every lookahead**, because a type that `parse_type`
// reads and a lookahead does not is a declaration that silently becomes an expression: `fn[i32(i32)]
// g = add;` was exactly that until this existed.
i32 skip_type(i32 i) {
  if (toks[i].kind != K_NAME) { return 0 - 1; }
  if (texteq(toks[i].start, toks[i].len, "fn")) {
    i = i + 1;
    if ((toks[i].kind == K_PUNCT & toks[i].val == 91) == 0) { return 0 - 1; }
    i32 depth = 0;
    while (1) {
      if (toks[i].kind == K_EOF) { return 0 - 1; }
      if (toks[i].kind == K_PUNCT) {
        if (toks[i].val == 91) { depth = depth + 1; }
        if (toks[i].val == 93) { depth = depth - 1; }
      }
      i = i + 1;
      if (depth <= 0) { return i; }
    }
  }
  i = i + 1;
  i = skip_targs(i);
  while (toks[i].kind == K_PUNCT & toks[i].val == 91) {
    if ((toks[i + 1].kind == K_PUNCT & toks[i + 1].val == 93) == 0) { return i; }
    i = i + 2;
  }
  if (toks[i].kind == K_PUNCT & toks[i].val == 63) { i = i + 1; }
  return i;
}

// A type, a name, and then `<` — which is a generic function and nothing else.
i32 looks_like_generic_fn() {
  i32 e = skip_type(tp);
  if (e == 0 - 1) { return 0; }
  if (toks[e].kind != K_NAME) { return 0; }
  return toks[e + 1].kind == K_PUNCT & toks[e + 1].val == 60;
}

// Reads past a whole declaration, body and all, without parsing any of it.
i32 skip_decl() {
  while (ispunct(123) == 0) { next(); }
  i32 depth = 1;
  next();
  while (depth > 0) {
    if (ispunct(123)) { depth = depth + 1; }
    if (ispunct(125)) { depth = depth - 1; }
    next();
  }
  return 0;
}

// A type followed by a name, which is how a declaration begins and nothing else does.
i32 looks_like_decl() {
  i32 e = skip_type(tp);
  if (e == 0 - 1) { return 0; }
  return toks[e].kind == K_NAME;
}

// ---------------------------------------------------------------- generics
//
// **Monomorphisation, by rewinding.** A generic declaration is not compiled where it is written; its
// token index is recorded and its body is re-parsed once per instantiation, with the letters bound.
// That is cheap here for a reason peculiar to this compiler: the parser's entire state is one
// integer into the token array, so "read this declaration again, in another world" is an assignment.
//
// The rounds are a fixpoint, because expanding `Vec<i32>` can name `Option<i32>`, which did not
// exist when the round started.

struct Tmpl { i32 nameptr; i32 namelen; i32 kind; i32 tokAt; i32 pstart; i32 nparams; }
Tmpl[] tmpls;
i32 ntmpl = 0;

struct TParam { i32 nameptr; i32 namelen; }
TParam[] tparams;
i32 ntparam = 0;

struct Inst { i32 tmpl; i32 ty; i32 astart; i32 nargs; i32 expanded; i32 emitted; }
Inst[] insts;
i32 ninst = 0;

i32[] iargs;
i32 niarg = 0;

struct Sub { i32 nameptr; i32 namelen; i32 ty; }
Sub[] subs;
i32 nsub = 0;

// The instantiation being expanded, so that `Vec(…)` inside `Vec<T>`'s own body means this one.
i32 cur_inst_ty = -1;
// **The slot supplies the type argument.** `Box<i32> a = Box(7);` writes the arguments once, and
// wac reads the second `Box` as `Box<i32>` from the declaration it is initialising. Without this a
// bare template name has nothing to instantiate it with.
i32 expect_ty = -1;
// The enclosing function's return type, so `return Option.None;` knows which `Option` it means.
i32 cur_ret = -1;
// The enclosing loop's two labels, so `break` and `continue` know where to go. Saved and restored
// around each loop rather than kept in a stack, because that is what nesting needs and no more.
i32 loop_out = -1;
i32 loop_in = -1;
// When set, a declaration fills this type index instead of looking one up by name.
i32 forced_ty = -1;

// Innermost binding wins, which matters when a generic's body names another generic's letter.
i32 sub_find(i32 p, i32 n) {
  i32 i = nsub;
  i32 found = 0 - 1;
  while (i > 0) {
    i = i - 1;
    if (found == 0 - 1) {
      if (subs[i].namelen == n & samebytes(p, n, subs[i].nameptr)) { found = subs[i].ty; }
    }
  }
  return found;
}

i32 tmpl_find(i32 p, i32 n) {
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < ntmpl) {
    if (tmpls[i].namelen == n & samebytes(p, n, tmpls[i].nameptr)) { found = i; }
    i = i + 1;
  }
  return found;
}

i32 inst_find(i32 tm, i32 astart, i32 na) {
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < ninst) {
    if (insts[i].tmpl == tm & insts[i].nargs == na) {
      i32 k = 0;
      i32 same = 1;
      while (k < na) {
        if (iargs[insts[i].astart + k] != iargs[astart + k]) { same = 0; }
        k = k + 1;
      }
      if (same) { found = i; }
    }
    i = i + 1;
  }
  return found;
}

// ---------------------------------------------------------------- variants and methods

struct Var { i32 nameptr; i32 namelen; i32 payload; i32 owner; }
Var[] vars;
i32 nvar = 0;

struct Meth { i32 owner; i32 nameptr; i32 namelen; i32 ret; }
Meth[] meths;
i32 nmeth = 0;

i32 var_find(i32 p, i32 n) {
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < nvar) {
    if (vars[i].namelen == n & samebytes(p, n, vars[i].nameptr)) { found = i; }
    i = i + 1;
  }
  return found;
}

i32 var_tag(i32 v) { return v - types[vars[v].owner].fstart; }

// A variant of *this* type, by name — which is what a qualified `Option.Some` asks for, and what
// two enums sharing a variant name would otherwise get wrong.
i32 var_owned(i32 owner, i32 p, i32 n) {
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < nvar) {
    if (vars[i].owner == owner & vars[i].namelen == n & samebytes(p, n, vars[i].nameptr)) {
      found = i;
    }
    i = i + 1;
  }
  return found;
}

i32 meth_find(i32 owner, i32 p, i32 n) {
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < nmeth) {
    if (meths[i].owner == owner & meths[i].namelen == n & samebytes(p, n, meths[i].nameptr)) {
      found = i;
    }
    i = i + 1;
  }
  return found;
}

// `Vec_push`, written from two source names because wac-L4 has no way to build one.
i32 mangled(i32 owner, i32 p, i32 n) {
  emit1(36);
  emitname(types[owner].nameptr, types[owner].namelen);
  emit1(95);
  // The owner's *type index*, so `Vec<i32>.push` and `Vec<string>.push` are two functions with two
  // names. A template's own name is shared by every instantiation of it and cannot do this alone.
  emitn(owner);
  emit1(95);
  return emitname(p, n);
}

// ---------------------------------------------------------------- expressions
//
// wac's precedence, loosest first: ternary, `||`, `&&`, `|`, `^`, `&`, equality, comparison,
// shifts, additive, multiplicative, unary, postfix. Each level parses the one below and loops.

i32 args() {
  i32 n = 0;
  while (ispunct(41) == 0) {
    // `fill: x` — a named argument, which wac has and which carries no meaning to the emitter
    // beyond the value: the name is a readability device the callee's signature already fixes.
    if (kind() == K_NAME & aheadIs(1, 58)) { next(); next(); }
    expr();
    n = n + 1;
    if (ispunct(44)) { next(); }
  }
  want(41);
  return n;
}

// `Point(a, b)`, and `T[n]()` / `T[](a, b)` for an array. wac writes a construction as a call, so
// one token of lookahead past the name is what tells them apart.
i32 construct(i32 t) {
  if (ispunct(91)) {
    next();
    i32 sized = 0;
    if (ispunct(93) == 0) { expr(); sized = 1; }
    want(93);
    i32 at = ty_array(t);
    want(40);
    if (sized) {
      // `T[n](fill: v)` — the fill is evaluated and dropped, because `array.new_default` zeroes and
      // stage 2 does not carry a value into it. A gap, and the spec says so.
      i32 nf = args();
      i32 k = 0;
      while (k < nf) { line("drop"); k = k + 1; }
      word("array.new_default"); tyname(at); nl();
    } else {
      // `T[](a, b, c)` — a literal, whose length is how many arguments it has.
      i32 n2 = args();
      word("array.new_fixed"); tyname(at); sp(); emitn(n2); nl();
    }
    return at;
  }
  want(40);
  args();
  word("struct.new"); tyname(t); nl();
  return t;
}

// `.field`, `.len()`, `.method()`, and `[i]`.
i32 postfix(i32 t) {
  while (ispunct(46) | ispunct(91) | ispunct(33) | (ispunct(40) & types[t].kind == T_FUNC)) {
    // **A funcref that arrived as a value, now being called.** It is already on the stack and
    // `call_ref` wants it *after* the arguments, so it is parked in a slot while they are emitted.
    if (ispunct(40) & types[t].kind == T_FUNC) {
      i32 held = slot_new(t);
      word("local.set"); slotname(held); nl();
      next();
      args();
      word("local.get"); slotname(held); nl();
      word("call_ref"); tyname(t); nl();
      t = types[t].elem;
    } else {
    if (ispunct(33)) {
      // `x!` — an assertion that a nullable is not null. Every reference here is already nullable,
      // so this is a no-op on the value and a promise the engine will not check.
      next();
    } else {
      if (ispunct(46)) {
        next();
        i32 p = tstart();
        i32 n = tlen();
        next();
        if (types[t].kind == T_ARRAY & texteq(p, n, "len")) {
          want(40); want(41);
          line("array.len");
          t = TY_I32;
        } else {
        // `s.toBytes()` is the identity: a `string` here *is* a `u8[]`, which is the whole reason
        // one array type serves both.
        if (t == strty & texteq(p, n, "toBytes")) {
          want(40); want(41);
        } else {
          i32 mi = meth_find(t, p, n);
          if (mi != 0 - 1 & ispunct(40)) {
            next();
            args();
            word("call"); mangled(t, p, n); nl();
            t = meths[mi].ret;
          } else {
            i32 fi = field_index(t, p, n);
            if (fi == 0 - 1) { oops(); } else {
              i32 ft = fields[types[t].fstart + fi].ty;
              if (ty_packed(ft) != 0) {
                emits("struct.get"); signedsuffix(ft); sp(); tyname(t); sp(); emitn(fi); nl();
              } else {
                word("struct.get"); tyname(t); sp(); emitn(fi); nl();
              }
              t = ft;
            }
          }
        }}
      } else {
        next();
        expr();
        want(93);
        if (types[t].kind != T_ARRAY) { oops(); }
        i32 et = types[t].elem;
        if (ty_packed(et) != 0) {
          emits("array.get"); signedsuffix(et); sp(); tyname(t); nl();
        } else {
          word("array.get"); tyname(t); nl();
        }
        t = et;
      }
    }}
  }
  return t;
}

i32 field_index(i32 t, i32 p, i32 n) {
  i32 i = 0;
  i32 found = 0 - 1;
  while (i < types[t].nfields) {
    i32 f = types[t].fstart + i;
    if (fields[f].namelen == n & samebytes(p, n, fields[f].nameptr)) { found = i; }
    i = i + 1;
  }
  return found;
}

i32 primary() {
  if (kind() == K_STR) {
    konst(str_add(tstart(), tlen()));
    usedstr = 1;
    line("call $__strlit");
    next();
    return postfix(string_type());
  }
  if (kind() == K_INT) { konst(val()); next(); return TY_I32; }
  if (ispunct(40)) { next(); i32 t0 = expr(); want(41); return postfix(t0); }
  if (ispunct(45)) {
    // Negation, at whatever width its operand turns out to be — so the zero has to be emitted
    // after the operand's type is known, which means holding the operand in a slot.
    next();
    i32 nt2 = primary();
    i32 held = slot_new(nt2);
    word("local.set"); slotname(held); nl();
    if (ty_wide(nt2)) { word("i64.const"); emitn(0); nl(); } else { konst(0); }
    word("local.get"); slotname(held); nl();
    binop(nt2, "sub");
    return nt2;
  }
  if (ispunct(33)) { next(); i32 nt3 = primary(); opprefix(nt3); emits("eqz"); nl(); return TY_BOOL; }
  if (ispunct(126)) {
    next();
    i32 nt4 = primary();
    if (ty_wide(nt4)) { word("i64.const"); emitn(-1); nl(); } else { konst(-1); }
    binop(nt4, "xor");
    return nt4;
  }
  if (isword("true")) { next(); konst(1); return TY_BOOL; }
  if (isword("false")) { next(); konst(0); return TY_BOOL; }
  if (isword("null")) { next(); line("ref.null none"); return 0; }
  if (isword("match")) { return match_expr(outbuf); }
  // `i32[3]()`, `u8[](…)`, `i16[n]()` — any primitive type can start a construction, and nothing
  // else that begins an expression does.
  i32 pt = prim_type();
  if (pt != 0 - 1) { next(); return construct(pt); }
  if (is_string_word()) { next(); return construct(string_type()); }
  if (kind() == K_NAME) {
    i32 p = tstart();
    i32 n = tlen();
    next();
    // **A bound letter, used as a type in an expression.** `T[0]()` inside `Vec<T>` is a
    // construction of whatever `T` is — and only `parse_type` consulted the substitution, so the
    // expression grammar read `T` as a name nobody had declared.
    i32 sb = sub_find(p, n);
    if (sb != 0 - 1 & (ispunct(40) | ispunct(91))) { return postfix(construct(sb)); }
    i32 st = ty_named(p, n);
    if (st != 0 - 1 & (ispunct(40) | ispunct(91))) { return postfix(construct(st)); }
    i32 tmc = tmpl_find(p, n);
    if (tmc != 0 - 1) {
      // `Option.Some(v)` — the enum names the variant. Which *instantiation* comes from the slot,
      // which for a `return` is the function's declared return type.
      if (ispunct(46)) {
        i32 owner = expect_ty;
        if (owner == 0 - 1) { owner = cur_inst_ty; }
        next();
        i32 vp2 = tstart();
        i32 vn2 = tlen();
        next();
        i32 gm = meth_find(owner, vp2, vn2);
        if (gm != 0 - 1 & ispunct(40)) {
          next();
          args();
          word("call"); mangled(owner, vp2, vn2); nl();
          return postfix(meths[gm].ret);
        }
        i32 qv = var_owned(owner, vp2, vn2);
        if (qv == 0 - 1) { oops(); return 0; }
        return postfix(construct_variant(qv));
      }
      i32 ity = instantiate(tmc);
      return postfix(construct(ity));
    }
    // `Type.name(...)` — a static method or a qualified variant, told apart by which table has it.
    // A static method is one the source never gave a `this`, so nothing special happens at the call
    // beyond not having a receiver to push.
    if (st != 0 - 1 & ispunct(46)) {
      next();
      i32 vp3 = tstart();
      i32 vn3 = tlen();
      next();
      i32 sm = meth_find(st, vp3, vn3);
      if (sm != 0 - 1 & ispunct(40)) {
        next();
        args();
        word("call"); mangled(st, vp3, vn3); nl();
        return postfix(meths[sm].ret);
      }
      i32 qv2 = var_owned(st, vp3, vn3);
      if (qv2 == 0 - 1) { oops(); return 0; }
      return postfix(construct_variant(qv2));
    }
    i32 vi = var_find(p, n);
    if (vi != 0 - 1) { return postfix(construct_variant(vi)); }
    // **The locals first.** A parameter of funcref type called as `f(x)` is not a call to a
    // function named `f`, and checking the call shape before the name is bound emits one anyway.
    i32 li = loc_find(p, n);
    if (li != 0 - 1) {
      // A call *through* a value: the arguments go first and the function last, which is what
      // `call_ref` takes — and it names the signature rather than the function.
      if (types[loc_type(li)].kind == T_FUNC & ispunct(40)) {
        next();
        args();
        word("local.get"); slotname(li); nl();
        word("call_ref"); tyname(loc_type(li)); nl();
        return postfix(types[loc_type(li)].elem);
      }
      word("local.get"); slotname(li); nl();
      return postfix(loc_type(li));
    }
    i32 gi = glo_find(p, n);
    if (gi != 0 - 1) {
      if (types[glo_type(gi)].kind == T_FUNC & ispunct(40)) {
        next();
        args();
        word("global.get"); gloname(gi); nl();
        word("call_ref"); tyname(glo_type(gi)); nl();
        return postfix(types[glo_type(gi)].elem);
      }
      word("global.get"); gloname(gi); nl();
      return postfix(glo_type(gi));
    }
    // A function's *name*, with no call after it, is the function as a value. Which funcref type it
    // has comes from the slot, the same way a bare template name gets its arguments.
    i32 fnv = fn_find(p, n);
    if (fnv != 0 - 1 & ispunct(40) == 0) {
      word("ref.func"); emit1(36); emitname(p, n); nl();
      if (expect_ty != 0 - 1) { return postfix(expect_ty); }
      return postfix(0);
    }
    if (ispunct(40)) {
      // Refused rather than compiled into something plausible: a generic function's instantiation
      // is not built, and a `call` to a name that was never emitted would be caught by the
      // assembler with a worse message than this one.
      if (gfn_find(p, n) != 0 - 1) { oops(); return 0; }
      next();
      args();
      word("call"); emit1(36); emitname(p, n); nl();
      i32 fi2 = fn_find(p, n);
      i32 rt = 0;
      if (fi2 != 0 - 1) { rt = fns[fi2].ret; }
      return postfix(rt);
    }
    // A bare `Type.staticMethod(...)` reaches here as a name with no local: wac writes a static
    // call that way, and stage 2 resolves it as `$Type_name`.
    if (ispunct(46)) {
      i32 ot = ty_named(p, n);
      if (ot != 0 - 1) { return postfix(ot); }
    }
    oops();
    return 0;
  }
  oops();
  return 0;
}

// `x as i64`, `n as u32`. `as!` is a *checked* cast in wac and traps on overflow; stage 3 emits the
// same conversion and does not check, which is a gap the spec names.
i32 cast() {
  i32 t = primary();
  while (isword("as")) {
    next();
    // `as!` is checked and `as@` reinterprets; both emit the same conversion here, and only `as!`
    // is a gap — it should trap on overflow and does not.
    eat(33);
    eat(64);
    i32 to = parse_type();
    if (ty_isnum(t) & ty_isnum(to)) {
      if (ty_wide(to) & ty_wide(t) == 0) {
        // `word` puts a space after what it writes, and an instruction's suffix is part of its
        // name — so this is `emits` and not `word`, which is a one-character mistake that reads as
        // an unknown instruction three rungs down.
        emits("i64.extend_i32");
        if (ty_signed(t)) { emits("_s"); } else { emits("_u"); }
        nl();
      }
      if (ty_wide(to) == 0 & ty_wide(t)) { line("i32.wrap_i64"); }
      // Everything else is a reinterpretation: `i32` and `u32` are one wasm type, and narrowing to
      // `u8` is what the store does.
    }
    t = to;
  }
  return t;
}

i32 mul() {
  i32 t = cast();
  while (ispunct(42) | ispunct(47) | ispunct(37)) {
    i32 op = val();
    next();
    coerce(t, cast());
    if (op == 42) { binop(t, "mul"); } else {
      if (op == 47) { binop_signed(t, "div"); } else { binop_signed(t, "rem"); }
    }
  }
  return t;
}

i32 add() {
  i32 t = mul();
  while (ispunct(43) | ispunct(45)) {
    i32 op = val();
    next();
    coerce(t, mul());
    if (op == 43) {
      if (t == strty & strty != 0 - 1) { usedcat = 1; line("call $__concat"); } else {
        binop(t, "add");
      }
    } else { binop(t, "sub"); }
  }
  return t;
}

i32 shift() {
  i32 t = add();
  while (ispunct(15420) | ispunct(15934)) {
    i32 op = val();
    next();
    coerce(t, add());
    if (op == 15420) { binop(t, "shl"); } else { binop_signed(t, "shr"); }
  }
  return t;
}

i32 rel() {
  i32 t = shift();
  while (ispunct(60) | ispunct(62) | ispunct(15676) | ispunct(15678)) {
    i32 op = val();
    next();
    coerce(t, shift());
    if (op == 60) { binop_signed(t, "lt"); } else {
      if (op == 62) { binop_signed(t, "gt"); } else {
        if (op == 15676) { binop_signed(t, "le"); } else { binop_signed(t, "ge"); }
      }
    }
    // A comparison answers a bool however wide its operands were.
    t = TY_BOOL;
  }
  return t;
}

i32 equality() {
  i32 t = rel();
  while (ispunct(15677) | ispunct(15649)) {
    i32 op = val();
    next();
    coerce(t, rel());
    if (t == strty & strty != 0 - 1) {
      // **Two strings compare by content.** `i32.eq` on two references answers whether they are the
      // same object, which for a literal built fresh at every use is always false.
      usedeq = 1;
      line("call $__streq");
      if (op == 15649) { line("i32.eqz"); }
    } else {
      if (op == 15677) { binop(t, "eq"); } else { binop(t, "ne"); }
    }
    t = TY_BOOL;
  }
  return t;
}

i32 bitand() {
  i32 t = equality();
  while (ispunct(38)) { next(); coerce(t, equality()); binop(t, "and"); }
  return t;
}

i32 bitxor() {
  i32 t = bitand();
  while (ispunct(94)) { next(); coerce(t, bitand()); binop(t, "xor"); }
  return t;
}

i32 bitor() {
  i32 t = bitxor();
  while (ispunct(124)) { next(); coerce(t, bitxor()); binop(t, "or"); }
  return t;
}

// **Short-circuit, so an `if` and not an `and`.** `a && b` must not evaluate `b` when `a` is false,
// and wac programs rely on it — a guard followed by a dereference is the usual shape.
i32 logand() {
  i32 t = bitor();
  while (ispunct(9766)) {
    next();
    i32 l = newlabel();
    word("if"); label(l); sp(); word("->"); line("i32");
    bitor();
    line("i32.eqz");
    line("i32.eqz");
    line("else");
    konst(0);
    line("end");
    t = 0;
  }
  return t;
}

i32 logor() {
  i32 t = logand();
  while (ispunct(31868)) {
    next();
    i32 l = newlabel();
    word("if"); label(l); sp(); word("->"); line("i32");
    konst(1);
    line("else");
    logand();
    line("i32.eqz");
    line("i32.eqz");
    line("end");
    t = 0;
  }
  return t;
}

// A variant: the tag, then the payload struct, then the enum struct — in field order, because wasm
// takes a struct's fields in the order they are declared.
i32 construct_variant(i32 vi) {
  i32 owner = vars[vi].owner;
  konst(var_tag(vi));
  if (vars[vi].payload == 0 - 1) {
    line("ref.null none");
    if (ispunct(40)) { next(); want(41); }
  } else {
    want(40);
    args();
    word("struct.new"); tyname(vars[vi].payload); nl();
  }
  word("struct.new"); tyname(owner); nl();
  return owner;
}

// **`match` is both an expression and a statement in wac**, and they differ by one token: an arm's
// body is followed by `,` in the expression form and by `;` in the statement form. Both compile to
// the same shape — the scrutinee in a slot, one block per arm, a tag compare and a branch — so the
// only difference here is whether the arms leave a value.
i32 match_body(i32 wantValue, i32 out) {
  want(40);
  i32 et = expr();
  want(41);
  i32 slot = slot_new(et);
  word("local.set"); slotname(slot); nl();
  i32 done = newlabel();
  // The arms go to scratch, because the block's result type is one of theirs and none of them has
  // been read yet.
  i32 level = scrdepth;
  i32 saved = scratch_begin();
  i32 armty = TY_I32;
  want(123);
  while (ispunct(125) == 0) {
    // **`else:` is an arm with no tag test.** It reads like a variant named `else` otherwise, and a
    // `match` with a default is what wac writes whenever the interesting cases are a minority —
    // which in a compiler over an AST is most of them.
    if (isword("else")) {
      next();
      want(58);
      i32 emark = nloc;
      if (wantValue) {
        armty = expr();
        if (ispunct(44)) { next(); }
      } else {
        if (ispunct(123)) { block(); } else { statement(); }
      }
      nloc = emark;
      word("br"); label(done); nl();
    } else {
    eatword("case");
    i32 vp = tstart();
    i32 vn = tlen();
    next();
    i32 vi = var_find(vp, vn);
    // Loudly: a `case` naming no variant would index the variant table at -1, and a GC array says
    // so at runtime rather than reading whatever is next in memory — which is the one place this
    // ladder's newest rung is better off than its oldest.
    if (vi == 0 - 1) { oops(); return 0; }
    i32 skip = newlabel();
    word("block"); label(skip); sp(); line("->");
    word("local.get"); slotname(slot); nl();
    word("struct.get"); tyname(et); sp(); line("0");
    konst(var_tag(vi));
    line("i32.ne");
    word("br_if"); label(skip); nl();

    i32 mark = nloc;
    if (ispunct(40)) {
      next();
      i32 pay = vars[vi].payload;
      i32 k = 0;
      while (ispunct(41) == 0) {
        // `_` binds nothing, which wac uses whenever the payload is not read.
        if (isword("_") == 0) {
          i32 ft = fields[types[pay].fstart + k].ty;
          word("local.get"); slotname(slot); nl();
          word("struct.get"); tyname(et); sp(); line("1");
          word("ref.cast"); word("ref"); tyname(pay); nl();
          word("struct.get"); tyname(pay); sp(); emitn(k); nl();
          word("local.set"); slotname(loc_add(tstart(), tlen(), ft)); nl();
        }
        k = k + 1;
        next();
        if (ispunct(44)) { next(); }
      }
      want(41);
    }
    want(58);
    if (wantValue) {
      armty = expr();
      if (ispunct(44)) { next(); }
    } else {
      if (ispunct(123)) { block(); } else { statement(); }
    }
    nloc = mark;
    word("br"); label(done); nl();
    line("end");
    }
  }
  want(125);
  i32 armlen = scratch_end(out, saved);

  word("block"); label(done); sp(); word("->");
  if (wantValue) { slotvaltype(armty); nl(); } else { nl(); }
  scratch_copy(level, armlen);
  // A tag matching no arm falls out. wac's `match` is exhaustive and this rung does not check it,
  // so the expression form has to leave *something* — and an unreachable default is the honest one.
  if (wantValue) { zero_of(armty); }
  line("end");
  return armty;
}

i32 match_expr(i32 out) {
  next();
  return match_body(1, out);
}

i32 ternary() {
  i32 t = logor();
  if (ispunct(63)) {
    next();
    i32 l = newlabel();
    word("if"); label(l); sp(); word("->"); line("i32");
    expr();
    line("else");
    want(58);
    i32 t2 = ternary();
    line("end");
    t = t2;
  }
  return t;
}

i32 expr() { return ternary(); }

// ---------------------------------------------------------------- statements

i32 block() {
  want(123);
  i32 mark = nloc;
  while (ispunct(125) == 0) { statement(); }
  want(125);
  nloc = mark;
  return 0;
}

i32 declaration() {
  eatword("const");
  i32 t = parse_type();
  i32 p = tstart();
  i32 n = tlen();
  next();
  i32 savedExpect = expect_ty;
  expect_ty = t;
  if (ispunct(61)) { next(); expr(); expect_ty = savedExpect; } else {
    expect_ty = savedExpect;
    zero_of(t);
  }
  want(59);
  word("local.set"); slotname(loc_add(p, n, t)); nl();
  return 0;
}

// Does the `.field` or `[i]` chain starting here end in `=`? Without knowing, there is no way to
// decide whether to emit the base as a value or as the target of a store.
i32 chain_is_store() {
  i32 i = tp + 1;
  i32 ans = 0;
  i32 going = 1;
  while (going) {
    if (toks[i].kind == K_PUNCT & toks[i].val == 46) { i = i + 2; } else {
      if (toks[i].kind == K_PUNCT & toks[i].val == 91) {
        i32 depth = 1;
        i = i + 1;
        while (depth > 0) {
          if (toks[i].kind == K_PUNCT & toks[i].val == 91) { depth = depth + 1; }
          if (toks[i].kind == K_PUNCT & toks[i].val == 93) { depth = depth - 1; }
          i = i + 1;
        }
      } else {
        if (toks[i].kind == K_PUNCT) {
          i32 v = toks[i].val;
          // Everything that writes: plain, compound, and the two increments.
          if (v == 61 | v == 15659 | v == 15661 | v == 15658 | v == 15663
              | v == 11051 | v == 11565) { ans = 1; }
        }
        going = 0;
      }
    }
  }
  return ans;
}

// Which write is at the cursor: 0 for none, 61 for `=`, the operator's byte for a compound, and
// 11051/11565 for the increments.
i32 write_op() {
  if (ispunct(61)) { return 61; }
  if (ispunct(15659)) { return 43; }
  if (ispunct(15661)) { return 45; }
  if (ispunct(15658)) { return 42; }
  if (ispunct(15663)) { return 47; }
  if (ispunct(11051)) { return 11051; }
  if (ispunct(11565)) { return 11565; }
  return 0;
}

// The new value, given the old one is already on the stack. `++` is `+= 1` with the 1 implied.
i32 write_value(i32 op, i32 t) {
  next();
  if (op == 11051) { konst(1); binop(t, "add"); return 0; }
  if (op == 11565) { konst(1); binop(t, "sub"); return 0; }
  if (op == 61) { return 0; }
  coerce(t, expr());
  if (op == 43) { binop(t, "add"); }
  if (op == 45) { binop(t, "sub"); }
  if (op == 42) { binop(t, "mul"); }
  if (op == 47) { binop_signed(t, "div"); }
  return 0;
}

// The base, then the value, then the store — so the walk stops one step short of the end and
// remembers what it was about to do.
//
// **A compound write reads before it writes**, and wasm's `struct.set` wants the reference *before*
// the value — so the base is parked in a slot, read through, combined, and pushed again. `this.pos++`
// is three temporaries and no other shape works.
i32 store_through() {
  i32 t = primary_base();
  while (1) {
    if (ispunct(46)) {
      next();
      i32 fp = tstart();
      i32 fn2 = tlen();
      next();
      i32 fi = field_index(t, fp, fn2);
      if (fi == 0 - 1) { oops(); return 0; }
      i32 ft = fields[types[t].fstart + fi].ty;
      i32 wop = write_op();
      if (wop != 0) {
        if (wop == 61) {
          next();
          expr();
          want(59);
          word("struct.set"); tyname(t); sp(); emitn(fi); nl();
          return 0;
        }
        // A compound: the base is on the stack once and is needed twice.
        i32 base = slot_new(t);
        i32 val = slot_new(ft);
        word("local.tee"); slotname(base); nl();
        word("struct.get"); tyname(t); sp(); emitn(fi); nl();
        write_value(wop, ft);
        want(59);
        word("local.set"); slotname(val); nl();
        word("local.get"); slotname(base); nl();
        word("local.get"); slotname(val); nl();
        word("struct.set"); tyname(t); sp(); emitn(fi); nl();
        return 0;
      }
      word("struct.get"); tyname(t); sp(); emitn(fi); nl();
      t = ft;
    } else {
      i32 arr = slot_new(t);
      word("local.set"); slotname(arr); nl();
      next();
      i32 idx = slot_new(TY_I32);
      expr();
      word("local.set"); slotname(idx); nl();
      want(93);
      i32 et = types[t].elem;
      i32 wop2 = write_op();
      if (wop2 != 0) {
        word("local.get"); slotname(arr); nl();
        word("local.get"); slotname(idx); nl();
        if (wop2 == 61) {
          next();
          expr();
          want(59);
          word("array.set"); tyname(t); nl();
          return 0;
        }
        i32 val2 = slot_new(et);
        word("local.get"); slotname(arr); nl();
        word("local.get"); slotname(idx); nl();
        word("array.get"); tyname(t); nl();
        write_value(wop2, et);
        want(59);
        word("local.set"); slotname(val2); nl();
        word("local.get"); slotname(val2); nl();
        word("array.set"); tyname(t); nl();
        return 0;
      }
      word("local.get"); slotname(arr); nl();
      word("local.get"); slotname(idx); nl();
      if (ty_packed(et) != 0) {
        emits("array.get"); signedsuffix(et); sp(); tyname(t); nl();
      } else {
        word("array.get"); tyname(t); nl();
      }
      t = et;
    }
  }
  return 0;
}

// A bare name, emitted without following its postfix — which is what a store target needs.
i32 primary_base() {
  i32 p = tstart();
  i32 n = tlen();
  next();
  i32 li = loc_find(p, n);
  if (li != 0 - 1) { word("local.get"); slotname(li); nl(); return loc_type(li); }
  i32 gi = glo_find(p, n);
  if (gi != 0 - 1) { word("global.get"); gloname(gi); nl(); return glo_type(gi); }
  oops();
  return 0;
}

// `x = e`, `x += e`, `x++`. The compound forms read the target first, which is why they are here
// rather than in the expression grammar: wac has no assignment expression.
i32 assign_or_expr() {
  i32 p = tstart();
  i32 n = tlen();
  if (kind() == K_NAME) {
    i32 compound = 0;
    if (aheadIs(1, 15659)) { compound = 43; }
    if (aheadIs(1, 15661)) { compound = 45; }
    if (aheadIs(1, 15658)) { compound = 42; }
    if (aheadIs(1, 15663)) { compound = 47; }
    i32 incr = 0;
    if (aheadIs(1, 11051)) { incr = 43; }
    if (aheadIs(1, 11565)) { incr = 45; }

    if (aheadIs(1, 61) | compound != 0 | incr != 0) {
      i32 li = loc_find(p, n);
      i32 gi = glo_find(p, n);
      next();
      next();
      if (incr != 0) {
        if (li != 0 - 1) { word("local.get"); slotname(li); nl(); } else {
          word("global.get"); gloname(gi); nl();
        }
        konst(1);
        if (incr == 43) { line("i32.add"); } else { line("i32.sub"); }
      } else {
        if (compound != 0) {
          if (li != 0 - 1) { word("local.get"); slotname(li); nl(); } else {
            word("global.get"); gloname(gi); nl();
          }
          expr();
          if (compound == 43) { line("i32.add"); } else {
            if (compound == 45) { line("i32.sub"); } else {
              if (compound == 42) { line("i32.mul"); } else { line("i32.div_s"); }
            }
          }
        } else {
          expr();
        }
      }
      want(59);
      if (li != 0 - 1) { word("local.set"); slotname(li); nl(); } else {
        if (gi != 0 - 1) { word("global.set"); gloname(gi); nl(); } else { oops(); }
      }
      return 0;
    }
  }
  if (kind() == K_NAME & (aheadIs(1, 46) | aheadIs(1, 91))) {
    if (chain_is_store()) { return store_through(); }
  }
  i32 dt = expr();
  want(59);
  // A call whose result is a value has to be dropped; one that answers nothing must not be, and
  // wasm counts the stack exactly enough to notice either mistake.
  if (dt != TY_VOID) { line("drop"); }
  return 0;
}

i32 if_statement() {
  next();
  want(40);
  expr();
  want(41);
  i32 l = newlabel();
  word("if"); label(l); sp(); line("->");
  if (ispunct(123)) { block(); } else { statement(); }
  if (isword("else")) {
    next();
    line("else");
    if (ispunct(123)) { block(); } else { statement(); }
  }
  line("end");
  return 0;
}

i32 while_statement() {
  next();
  i32 lo = newlabel();
  i32 li = newlabel();
  i32 so = loop_out;
  i32 si = loop_in;
  loop_out = lo;
  loop_in = li;
  word("block"); label(lo); sp(); line("->");
  word("loop"); label(li); sp(); line("->");
  want(40);
  expr();
  want(41);
  line("i32.eqz");
  word("br_if"); label(lo); nl();
  if (ispunct(123)) { block(); } else { statement(); }
  word("br"); label(li); nl();
  line("end");
  line("end");
  loop_out = so;
  loop_in = si;
  return 0;
}

// `for (init; cond; step) body` is a block holding a `while`, which is what it means. The init's
// declaration is scoped to the loop, so the name table is marked and restored around the whole
// thing rather than around the body.
i32 for_statement() {
  next();
  want(40);
  i32 mark = nloc;
  if (ispunct(59)) { next(); } else {
    if (looks_like_decl()) { declaration(); } else { assign_or_expr(); }
  }
  i32 lo = newlabel();
  i32 li = newlabel();
  word("block"); label(lo); sp(); line("->");
  word("loop"); label(li); sp(); line("->");
  if (ispunct(59)) { konst(1); } else { expr(); }
  want(59);
  line("i32.eqz");
  word("br_if"); label(lo); nl();

  // The step is read before the body and emitted after it, so the token cursor has to go back —
  // which is free here, because the parser's whole state is one integer into the token array.
  i32 stepAt = tp;
  while (ispunct(41) == 0) { next(); }
  want(41);
  // **`continue` must run the step.** So the body sits inside a block of its own and `continue`
  // branches to *its* end, which falls through to the step — branching to the loop directly would
  // skip it and spin.
  i32 lc = newlabel();
  i32 so2 = loop_out;
  i32 si2 = loop_in;
  loop_out = lo;
  loop_in = lc;
  word("block"); label(lc); sp(); line("->");
  if (ispunct(123)) { block(); } else { statement(); }
  line("end");
  loop_out = so2;
  loop_in = si2;
  i32 afterBody = tp;
  tp = stepAt;
  if (ispunct(41) == 0) { assign_or_expr_nosemi(); }
  tp = afterBody;

  word("br"); label(li); nl();
  line("end");
  line("end");
  nloc = mark;
  return 0;
}

// The step of a `for`, which is an assignment without its semicolon.
i32 assign_or_expr_nosemi() {
  i32 p = tstart();
  i32 n = tlen();
  i32 li = loc_find(p, n);
  i32 gi = glo_find(p, n);
  if (aheadIs(1, 11051) | aheadIs(1, 11565)) {
    i32 up = 43;
    if (aheadIs(1, 11565)) { up = 45; }
    next(); next();
    if (li != 0 - 1) { word("local.get"); slotname(li); nl(); } else {
      word("global.get"); gloname(gi); nl();
    }
    konst(1);
    if (up == 43) { line("i32.add"); } else { line("i32.sub"); }
  } else {
    i32 compound = 0;
    if (aheadIs(1, 15659)) { compound = 43; }
    if (aheadIs(1, 15661)) { compound = 45; }
    next(); next();
    if (compound != 0) {
      if (li != 0 - 1) { word("local.get"); slotname(li); nl(); } else {
        word("global.get"); gloname(gi); nl();
      }
      expr();
      if (compound == 43) { line("i32.add"); } else { line("i32.sub"); }
    } else {
      expr();
    }
  }
  if (li != 0 - 1) { word("local.set"); slotname(li); nl(); } else {
    word("global.set"); gloname(gi); nl();
  }
  return 0;
}

i32 statement() {
  if (isword("return")) {
    next();
    i32 savedE = expect_ty;
    expect_ty = cur_ret;
    if (ispunct(59)) { zero_of(cur_ret); } else { expr(); }
    expect_ty = savedE;
    want(59);
    line("return");
    return 0;
  }
  if (isword("trap")) { next(); want(59); line("unreachable"); return 0; }
  if (isword("break")) {
    next(); want(59);
    if (loop_out == 0 - 1) { oops(); } else { word("br"); label(loop_out); nl(); }
    return 0;
  }
  if (isword("continue")) {
    next(); want(59);
    if (loop_in == 0 - 1) { oops(); } else { word("br"); label(loop_in); nl(); }
    return 0;
  }
  if (isword("match")) { next(); match_body(0, outbuf); return 0; }
  if (isword("if")) { return if_statement(); }
  if (isword("while")) { return while_statement(); }
  if (isword("for")) { return for_statement(); }
  if (ispunct(123)) { return block(); }
  if (looks_like_decl()) { return declaration(); }
  return assign_or_expr();
}

// ---------------------------------------------------------------- declarations

// 64 pages is 4,194,304 bytes, so the last valid address is one below that — a scratch buffer
// placed *at* the limit is out of bounds on its first byte.
// With 512 pages there is room to stop crowding: a function body, the block scratch and the type
// directives each get a megabyte, well above the source and the output the host places below.
i32 BODY = 25165824;

// **A scratch stack**, because a block's result type is written before its arms are parsed and only
// the arms know it. Emit them here, learn the type, then write the header in front — the same trick
// a function body already needed for its locals, one level down and nestable.
i32 SCR = 26214400;
i32 scrdepth = 0;
i32 scrsaved = 0;

i32 scratch_begin() {
  scrsaved = dp;
  scrdepth = scrdepth + 1;
  dst = SCR + (scrdepth - 1) * 1048576;
  dp = 0;
  return scrsaved;
}

// Answers the length written; the caller copies it after emitting whatever had to come first.
i32 scratch_end(i32 out, i32 saved) {
  i32 n = dp;
  scrdepth = scrdepth - 1;
  if (scrdepth > 0) { dst = SCR + (scrdepth - 1) * 1048576; } else { dst = out; }
  dp = saved;
  return n;
}

i32 scratch_copy(i32 level, i32 n) {
  i32 k = 0;
  while (k < n) { emit1(load8(SCR + level * 1048576 + k)); k = k + 1; }
  return 0;
}

i32 mowner = -1;

i32 slot_new(i32 t) {
  slotty[nslot] = t;
  nslot = nslot + 1;
  return nslot - 1;
}

i32 function(i32 out, i32 ret, i32 np, i32 nn) {
  want(40);
  nloc = 0;
  nslot = 0;
  while (ispunct(41) == 0) {
    eatword("const");
    if (isword("this")) { loc_add(tstart(), tlen(), mowner); next(); } else {
      i32 pt = parse_type();
      loc_add(tstart(), tlen(), pt);
      next();
    }
    if (ispunct(44)) { next(); }
  }
  want(41);
  i32 nparams = nslot;
  i32 savedRet = cur_ret;
  cur_ret = ret;

  i32 outp = dp;
  i32 savedout = outbuf;
  outbuf = BODY;
  dst = BODY;
  dp = 0;
  block();
  i32 blen = dp;
  outbuf = savedout;

  dst = out;
  dp = outp;
  word("func");
  if (mowner == 0 - 1) { emit1(36); emitname(np, nn); } else { mangled(mowner, np, nn); }
  sp(); word("->"); slotvaltype(ret); nl();
  i32 i = 0;
  while (i < nparams) {
    word("param"); slotvaltype(slotty[i]); sp(); slotname(i); nl();
    i = i + 1;
  }
  i32 j = nparams;
  while (j < nslot) {
    word("local"); slotvaltype(slotty[j]); sp(); slotname(j); nl();
    j = j + 1;
  }
  i32 k = 0;
  while (k < blen) { emit1(load8(BODY + k)); k = k + 1; }
  zero_of(ret);
  line("end");
  if (mowner == 0 - 1) {
    word("export"); emit1(34); emitname(np, nn); emit1(34); sp();
    word("func"); emit1(36); emitname(np, nn); nl();
  }
  nl();
  return 0;
}

// The `type` directives, into their own buffer and appended at the end — wac-L0 takes directives in
// any order, so an array type first named inside the last function needs no pre-pass.
i32 TYPEBUF = 29360128;
i32 typep = 0;

i32 emit_typedecls() {
  i32 saved = dst;
  i32 savedp = dp;
  dst = TYPEBUF;
  dp = typep;
  i32 i = 0;
  while (i < ntype) {
    if (types[i].kind == T_STRUCT) {
      word("type"); tyname(i); sp(); word("struct");
      i32 j = 0;
      while (j < types[i].nfields) {
        valtype(fields[types[i].fstart + j].ty);
        sp();
        j = j + 1;
      }
      nl();
    }
    if (types[i].kind == T_ARRAY) {
      word("type"); tyname(i); sp(); word("array"); valtype(types[i].elem); nl();
    }
    if (types[i].kind == T_ENUM) {
      word("type"); tyname(i); sp(); word("struct"); word("i32"); line("anyref");
    }
    if (types[i].kind == T_FUNC) {
      word("type"); tyname(i); sp(); word("func");
      i32 fp = 0;
      while (fp < types[i].nfields) {
        slotvaltype(fparams[types[i].fstart + fp]);
        sp();
        fp = fp + 1;
      }
      word("->");
      slotvaltype(types[i].elem);
      nl();
    }
    i = i + 1;
  }
  typep = dp;
  dst = saved;
  dp = savedp;
  return 0;
}

// `struct Name { T f; … methods }` — a field is a type and a name and a `;`, a method is a type and
// a name and a `(`.
// Records a generic declaration and answers 1, or answers 0 and leaves the cursor where it was.
// The token index it keeps is of the `struct` or `enum` keyword, because that is where re-reading
// has to start.
i32 record_template(i32 kind) {
  i32 at = tp;
  next();
  i32 p = tstart();
  i32 n = tlen();
  next();
  if (ispunct(60) == 0) { tp = at; return 0; }
  next();
  i32 pstart = ntparam;
  i32 np = 0;
  while (at_gt() == 0) {
    tparams[ntparam] = TParam(tstart(), tlen());
    ntparam = ntparam + 1;
    np = np + 1;
    next();
    if (ispunct(44)) { next(); }
  }
  eat_gt();
  // **Recorded once.** Both passes walk the declarations, and a template added twice gets two
  // indices — after which `inst_find` matches on the wrong one and a program ends up with two
  // `Option<i32>` types, one returned and the other expected, which the engine reports as a
  // mismatch between two structs that look identical. The parameters just read are dropped again,
  // because the first recording already has them.
  if (tmpl_find(p, n) != 0 - 1) {
    ntparam = pstart;
  } else {
    tmpls[ntmpl] = Tmpl(p, n, kind, at, pstart, np);
    ntmpl = ntmpl + 1;
  }
  // Skip the body: it is read again, once per instantiation.
  while (ispunct(123) == 0) { next(); }
  i32 depth = 1;
  next();
  while (depth > 0) {
    if (ispunct(123)) { depth = depth + 1; }
    if (ispunct(125)) { depth = depth - 1; }
    next();
  }
  return 1;
}

i32 struct_decl(i32 emitting, i32 out) {
  next();
  i32 p = tstart();
  i32 n = tlen();
  next();
  if (ispunct(60)) { next(); while (at_gt() == 0) { next(); } eat_gt(); }
  i32 t = forced_ty;
  if (t == 0 - 1) {
    t = ty_named(p, n);
    if (t == 0 - 1) { t = ty_new(T_STRUCT, p, n, 0); }
  }
  if (emitting == 0) { types[t] = Ty(T_STRUCT, p, n, 0, nfield, 0); }
  want(123);
  i32 count = 0;
  while (ispunct(125) == 0) {
    eatword("const");
    eatword("export");
    i32 ft = parse_type();
    i32 mp = tstart();
    i32 mn = tlen();
    next();
    if (ispunct(40)) {
      if (emitting) {
        mowner = t;
        function(out, ft, mp, mn);
        mowner = 0 - 1;
      } else {
        meths[nmeth] = Meth(t, mp, mn, ft);
        nmeth = nmeth + 1;
        while (ispunct(123) == 0) { next(); }
        i32 depth = 1;
        next();
        while (depth > 0) {
          if (ispunct(123)) { depth = depth + 1; }
          if (ispunct(125)) { depth = depth - 1; }
          next();
        }
      }
    } else {
      if (emitting == 0) {
        fields[nfield] = Field(mp, mn, ft);
        nfield = nfield + 1;
        count = count + 1;
      }
      want(59);
    }
  }
  want(125);
  if (emitting == 0) { types[t] = Ty(T_STRUCT, p, n, 0, types[t].fstart, count); }
  return 0;
}

// `enum Name { A(T v), B, … methods }` — variants first, comma-separated, then methods.
i32 enum_decl(i32 emitting, i32 out) {
  next();
  i32 p = tstart();
  i32 n = tlen();
  next();
  if (ispunct(60)) { next(); while (at_gt() == 0) { next(); } eat_gt(); }
  i32 t = forced_ty;
  if (t == 0 - 1) {
    t = ty_named(p, n);
    if (t == 0 - 1) { t = ty_new(T_ENUM, p, n, 0); }
  }
  if (emitting == 0) { types[t] = Ty(T_ENUM, p, n, 0, nvar, 0); }
  want(123);
  i32 count = 0;
  // A variant is a name; a method is a type *then* a name then `(`. One token of lookahead tells
  // them apart, because a variant's name is either followed by `(`, `,` or `}`.
  while (ispunct(125) == 0) {
    if (looks_like_member() == 0) {
      i32 vp = tstart();
      i32 vn = tlen();
      next();
      i32 payload = 0 - 1;
      if (ispunct(40)) {
        next();
        if (emitting == 0) {
          payload = ty_new(T_STRUCT, 0, 0, 0);
          types[payload] = Ty(T_STRUCT, 0, 0, 0, nfield, 0);
        }
        i32 nf = 0;
        while (ispunct(41) == 0) {
          i32 ft2 = parse_type();
          if (emitting == 0) {
            fields[nfield] = Field(tstart(), tlen(), ft2);
            nfield = nfield + 1;
          }
          nf = nf + 1;
          next();
          if (ispunct(44)) { next(); }
        }
        want(41);
        if (emitting == 0) {
          types[payload] = Ty(T_STRUCT, 0, 0, 0, types[payload].fstart, nf);
        }
      }
      if (emitting == 0) {
        vars[nvar] = Var(vp, vn, payload, t);
        nvar = nvar + 1;
        count = count + 1;
      }
      if (ispunct(44)) { next(); }
    } else {
      eatword("const");
      eatword("export");
      i32 mt = parse_type();
      i32 mp2 = tstart();
      i32 mn2 = tlen();
      next();
      if (emitting) {
        mowner = t;
        function(out, mt, mp2, mn2);
        mowner = 0 - 1;
      } else {
        meths[nmeth] = Meth(t, mp2, mn2, mt);
        nmeth = nmeth + 1;
        while (ispunct(123) == 0) { next(); }
        i32 depth2 = 1;
        next();
        while (depth2 > 0) {
          if (ispunct(123)) { depth2 = depth2 + 1; }
          if (ispunct(125)) { depth2 = depth2 - 1; }
          next();
        }
      }
    }
  }
  want(125);
  if (emitting == 0) { types[t] = Ty(T_ENUM, p, n, 0, types[t].fstart, count); }
  return 0;
}

// One scan for every top-level name, so a call to something declared later resolves.
i32 collect() {
  tp = 0;
  while (kind() != K_EOF) {
    eatword("export");
    if (isword("import")) { while (ispunct(59) == 0) { next(); } next(); } else {
    if (isword("struct")) {
      if (record_template(T_STRUCT) == 0) { struct_decl(0, 0); }
    } else {
    if (isword("enum")) {
      if (record_template(T_ENUM) == 0) { enum_decl(0, 0); }
    } else {
    if (looks_like_generic_fn()) {
      i32 ge = skip_type(tp);
      gfns[ngfn] = GFn(toks[ge].start, toks[ge].len);
      ngfn = ngfn + 1;
      skip_decl();
    } else {
    i32 ret = parse_type();
    i32 p = tstart();
    i32 n = tlen();
    next();
    if (ispunct(40)) {
      fns[nfn] = Fn(p, n, ret);
      nfn = nfn + 1;
      while (ispunct(123) == 0) { next(); }
      i32 depth = 1;
      next();
      while (depth > 0) {
        if (ispunct(123)) { depth = depth + 1; }
        if (ispunct(125)) { depth = depth - 1; }
        next();
      }
    } else {
      glos[nglo] = Glo(p, n, ret);
      nglo = nglo + 1;
      while (ispunct(59) == 0) { next(); }
      next();
    }}}}}
  }
  return 0;
}

// The two functions a string needs, emitted as text because they are the same every time. A literal
// lives in linear memory as a length and its bytes — which is how every rung below writes one — and
// this is what lifts it into a GC array.
i32 emit_runtime() {
  i32 at2 = string_type();
  if (usedstr) {
    word("func"); line("$__strlit -> refnull"); dp = dp - 1; sp(); tyname(at2); nl();
    line("param i32 $off");
    word("local"); word("refnull"); tyname(at2); sp(); line("$s");
    line("local i32 $i");
    line("local i32 $n");
    line("local.get $off");
    line("i32.load 4 0");
    line("local.set $n");
    line("local.get $n");
    word("array.new_default"); tyname(at2); nl();
    line("local.set $s");
    line("block $d ->");
    line("loop $l ->");
    line("local.get $i");
    line("local.get $n");
    line("i32.ge_u");
    line("br_if $d");
    line("local.get $s");
    line("local.get $i");
    line("local.get $off");
    line("local.get $i");
    line("i32.add");
    line("i32.load8_u 1 4");
    word("array.set"); tyname(at2); nl();
    line("local.get $i");
    line("i32.const 1");
    line("i32.add");
    line("local.set $i");
    line("br $l");
    line("end");
    line("end");
    line("local.get $s");
    line("end");
    nl();
  }
  if (usedeq) {
    line("func $__streq -> i32");
    word("param"); word("refnull"); tyname(at2); sp(); line("$a");
    word("param"); word("refnull"); tyname(at2); sp(); line("$b");
    line("local i32 $i");
    line("local.get $a");
    line("array.len");
    line("local.get $b");
    line("array.len");
    line("i32.ne");
    line("if $q ->");
    line("i32.const 0");
    line("return");
    line("else");
    line("nop");
    line("end");
    line("block $qd ->");
    line("loop $ql ->");
    line("local.get $i");
    line("local.get $a");
    line("array.len");
    line("i32.ge_u");
    line("br_if $qd");
    line("local.get $a");
    line("local.get $i");
    word("array.get_u"); tyname(at2); nl();
    line("local.get $b");
    line("local.get $i");
    word("array.get_u"); tyname(at2); nl();
    line("i32.ne");
    line("if $qn ->");
    line("i32.const 0");
    line("return");
    line("else");
    line("nop");
    line("end");
    line("local.get $i");
    line("i32.const 1");
    line("i32.add");
    line("local.set $i");
    line("br $ql");
    line("end");
    line("end");
    line("i32.const 1");
    line("end");
    nl();
  }
  if (usedcat) {
    word("func"); line("$__concat -> refnull"); dp = dp - 1; sp(); tyname(at2); nl();
    word("param"); word("refnull"); tyname(at2); sp(); line("$a");
    word("param"); word("refnull"); tyname(at2); sp(); line("$b");
    word("local"); word("refnull"); tyname(at2); sp(); line("$r");
    line("local i32 $i");
    line("local i32 $an");
    line("local.get $a");
    line("array.len");
    line("local.set $an");
    line("local.get $an");
    line("local.get $b");
    line("array.len");
    line("i32.add");
    word("array.new_default"); tyname(at2); nl();
    line("local.set $r");
    line("block $d1 ->");
    line("loop $l1 ->");
    line("local.get $i");
    line("local.get $an");
    line("i32.ge_u");
    line("br_if $d1");
    line("local.get $r");
    line("local.get $i");
    line("local.get $a");
    line("local.get $i");
    word("array.get_u"); tyname(at2); nl();
    word("array.set"); tyname(at2); nl();
    line("local.get $i");
    line("i32.const 1");
    line("i32.add");
    line("local.set $i");
    line("br $l1");
    line("end");
    line("end");
    line("i32.const 0");
    line("local.set $i");
    line("block $d2 ->");
    line("loop $l2 ->");
    line("local.get $i");
    line("local.get $b");
    line("array.len");
    line("i32.ge_u");
    line("br_if $d2");
    line("local.get $r");
    line("local.get $an");
    line("local.get $i");
    line("i32.add");
    line("local.get $b");
    line("local.get $i");
    word("array.get_u"); tyname(at2); nl();
    word("array.set"); tyname(at2); nl();
    line("local.get $i");
    line("i32.const 1");
    line("i32.add");
    line("local.set $i");
    line("br $l2");
    line("end");
    line("end");
    line("local.get $r");
    line("end");
    nl();
  }
  return 0;
}

// Bind a template's letters to an instantiation's arguments, and answer how many were pushed.
i32 push_subs(i32 ii) {
  i32 tm = insts[ii].tmpl;
  i32 k = 0;
  while (k < tmpls[tm].nparams) {
    subs[nsub] = Sub(tparams[tmpls[tm].pstart + k].nameptr,
                     tparams[tmpls[tm].pstart + k].namelen,
                     iargs[insts[ii].astart + k]);
    nsub = nsub + 1;
    k = k + 1;
  }
  return tmpls[tm].nparams;
}

// **Expanded where it is created, not in a later pass.** An instantiation is first named inside a
// function body, which is long after any pass over the declarations could have run — so the moment
// `Vec<i32>` is written down, its fields and its methods are read out of the template with `T`
// bound, and the parser rewinds to do it.
//
// The entry is marked expanded *before* the body is read, so `Vec<T>` holding a `Vec<T>` finds the
// entry that is already there rather than making a second one. That is what terminates it.
i32 expand_one(i32 i) {
  if (insts[i].expanded) { return 0; }
  insts[i] = Inst(insts[i].tmpl, insts[i].ty, insts[i].astart, insts[i].nargs, 1, 0);
  i32 pushed = push_subs(i);
  i32 saved = tp;
  i32 savedcur = cur_inst_ty;
  i32 savedforced = forced_ty;
  i32 savedexpect = expect_ty;
  cur_inst_ty = insts[i].ty;
  forced_ty = insts[i].ty;
  expect_ty = 0 - 1;
  tp = tmpls[insts[i].tmpl].tokAt;
  if (tmpls[insts[i].tmpl].kind == T_ENUM) { enum_decl(0, 0); } else { struct_decl(0, 0); }
  forced_ty = savedforced;
  cur_inst_ty = savedcur;
  expect_ty = savedexpect;
  tp = saved;
  nsub = nsub - pushed;
  return 0;
}

i32 expand_types() {
  i32 going = 1;
  while (going) {
    going = 0;
    i32 i = 0;
    while (i < ninst) {
      if (insts[i].expanded == 0) { expand_one(i); going = 1; }
      i = i + 1;
    }
  }
  return 0;
}

// One specialised copy of every generic's methods, per instantiation. Runs after the types have
// settled, because a method body can name an instantiation and its *type* has to exist by then.
i32 emit_generic_methods(i32 out) {
  i32 i = 0;
  while (i < ninst) {
    i32 pushed = push_subs(i);
    i32 saved = tp;
    i32 savedcur = cur_inst_ty;
    cur_inst_ty = insts[i].ty;
    forced_ty = insts[i].ty;
    tp = tmpls[insts[i].tmpl].tokAt;
    if (tmpls[insts[i].tmpl].kind == T_ENUM) { enum_decl(1, out); } else { struct_decl(1, out); }
    forced_ty = 0 - 1;
    cur_inst_ty = savedcur;
    tp = saved;
    nsub = nsub - pushed;
    i = i + 1;
  }
  return 0;
}

i32 compile(i32 s, i32 out) {
  src = s;
  srclen = 0;
  while (load8(src + srclen) != 0) { srclen = srclen + 1; }

  types = Ty[16384]();
  fields = Field[65536]();
  fparams = i32[16384]();
  nfparam = 0;
  vars = Var[8192]();
  meths = Meth[16384]();
  ntype = 0;
  nfield = 0;
  nvar = 0;
  nmeth = 0;
  typep = 0;
  mowner = 0 - 1;
  // Reserved, not assumed: the first struct registered would otherwise be index 0, and `valtype`
  // reads a 0 as the number type.
  i32 nt = 0;
  while (nt < NUMTYPES) { ty_new(T_NUM, 0, 0, 0); nt = nt + 1; }
  locs = Local[16384]();
  slotty = i32[16384]();
  glos = Glo[8192]();
  strs = Str[65536]();
  fns = Fn[16384]();
  gfns = GFn[4096]();
  ngfn = 0;
  nloc = 0;
  nslot = 0;
  nglo = 0;
  nstr = 0;
  nfn = 0;
  strnext = 1024;
  labn = 0;
  strty = 0 - 1;
  usedstr = 0;
  usedcat = 0;
  usedeq = 0;
  tmpls = Tmpl[4096]();
  tparams = TParam[8192]();
  insts = Inst[16384]();
  iargs = i32[65536]();
  subs = Sub[2048]();
  ntmpl = 0;
  ntparam = 0;
  ninst = 0;
  niarg = 0;
  nsub = 0;
  cur_inst_ty = 0 - 1;
  forced_ty = 0 - 1;
  expect_ty = 0 - 1;
  cur_ret = 0 - 1;
  overflowed = 0;
  loop_out = 0 - 1;
  loop_in = 0 - 1;

  lex();
  collect();
  // Every instantiation named anywhere in the program now has a type index; this fills them in.
  expand_types();

  tp = 0;
  realout = out;
  outbuf = out;
  dst = out;
  dp = 0;
  line("memory 64");
  word("export"); emit1(34); emits("memory"); emit1(34); sp(); line("memory");
  nl();

  i32 gi = 0;
  while (gi < nglo) {
    word("global"); gloname(gi); sp(); slotvaltype(glos[gi].ty); sp(); word("mut"); word("=");
    emitn(0); nl();
    gi = gi + 1;
  }
  nl();

  while (kind() != K_EOF) {
    eatword("export");
    if (isword("import")) { while (ispunct(59) == 0) { next(); } next(); } else {
    if (isword("struct")) {
      if (record_template(T_STRUCT) == 0) { struct_decl(1, out); }
    } else {
    if (isword("enum")) {
      if (record_template(T_ENUM) == 0) { enum_decl(1, out); }
    } else {
    if (looks_like_generic_fn()) { skip_decl(); } else {
    i32 ret = parse_type();
    i32 p = tstart();
    i32 n = tlen();
    next();
    if (ispunct(40)) {
      mowner = 0 - 1;
      function(out, ret, p, n);
    } else {
      // A global's initialiser is not run: wac's may be any expression and wasm's may not, so the
      // global emits as zero and the program is expected to set it.
      while (ispunct(59) == 0) { next(); }
      next();
    }}}}}
  }
  emit_generic_methods(out);
  // A method body can name an instantiation that nothing else did, so the types settle once more.
  expand_types();
  if (overflowed) {
    // The output is truncated and the marker cannot be trusted to be in the right place, so it says
    // what happened rather than where.
    dst = out;
    if (dp > 11000000) { dp = 11000000; }
    nl();
    line("!! wac-L5: emitted more than the buffer holds — the parser lost its place");
  }
  emit_runtime();
  emit_strdata();
  emit_typedecls();
  i32 ti = 0;
  while (ti < typep) { emit1(load8(TYPEBUF + ti)); ti = ti + 1; }
  return dp;
}
