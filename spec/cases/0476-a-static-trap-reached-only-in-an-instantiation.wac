// expect: refused
// spec: §wac-static-trap-37c96dy
// why: the definition reaches no arm, and `width<f64>` reaches the one that traps
// from: spec ch31
i32 width<T>() {
  return static_match (T) {
    u32:     4,
    default: static_trap "width is defined for u32",
  };
}
export i32 widthF64() { return width<f64>(); }
