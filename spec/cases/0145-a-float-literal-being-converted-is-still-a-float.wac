// expect: answers run = 0
// only:   wacc
// why: a literal takes its type from the slot, and a cast's slot is its own target
// from: issues/lang/0117

export i32 run() {
  // **Every one of these was a module that would not load.** A literal has no type of its own, so it
  // takes the slot's — and for a cast the slot is the cast's *target*, which made `1.5 as~ i32` emit
  // the literal as an `i32` and then convert `i32` to `i32`: no instructions, and an `f64` left
  // where an `i32` was promised. The spec documents all four of these answers (`spec/spec/casts.md`)
  // and none of them could run.
  if (1.5 as~ i32 != 2) { return 1; }              // `as~` rounds
  if (1.5 as@ i32 != 1) { return 2; }              // `as@` truncates
  if (-2.3 as@ i32 != -2) { return 3; }            // toward zero
  if (1.0e300 as@ i32 != 2147483647) { return 4; } // saturates, never traps
  if (3.7 as@ u32 != 3) { return 5; }

  // `§wac-raw-truncf-nan-w9fk2xq`: NaN converts to zero and never traps. Two literals in an
  // arithmetic expression have no type between them either, so this took `i32` from the cast and
  // divided two `f64` constants with `i32.div_s`.
  if ((0.0 / 0.0) as@ i32 != 0) { return 6; }
  if ((1.5 + 2.0) as~ i32 != 4) { return 7; }

  // **The slot still chooses the width inside the family.** A float target keeps its own type, which
  // is the half that stops this rule making every float literal an `f64`.
  f32 narrow = 1.5 as~ f32;
  if (narrow != 1.5) { return 8; }
  f64 wide = 1.5 as~ f64;
  if (wide != 1.5) { return 9; }
  f32 doubled = 1.5 * 2.0;
  if (doubled != 3.0) { return 10; }

  // And an integer literal is unaffected: it has no family to preserve and the slot is all there is.
  if (1000000000000 as@ i32 != -727379968) { return 11; }
  if (6 * 7 != 42) { return 12; }
  f64 sum = 1 + 2;
  if (sum != 3.0) { return 13; }

  return 0;
}
