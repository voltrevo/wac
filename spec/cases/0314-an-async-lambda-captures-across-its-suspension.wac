// expect: answers answer = 30
// why: a captured name and a parameter both survive a suspension, which is why a lambda is wanted
// from: issues/lang/0294c
// spec: §wac-async-lambda-captures-5mtj28r
import { Ticket } from "core";

/** A ticket that is already answered: made directly, and settled with `resolve` (spec ch35). */
Ticket<i32> ready(i32 v) {
  Ticket<i32> t;
  t.resolve(v);
  return t;
}

export i32 answer() {
  i32[] base = i32[].filled(1, 10);

  // Two things cross the suspension here, and they are stored differently underneath: `base` is
  // **captured** from the enclosing function, and `n` is the lambda's own **parameter**. A top-level
  // `async` function could take `n` but would have to be handed `base`; being able to write the
  // machine where the values already are is the whole point of the feature.
  fn<Ticket<i32>(i32)> plus = async (i32 n) => {
    i32 v = await ready(n);
    return v + base[0] + n;
  };
  return plus(10).wait()!;
}
