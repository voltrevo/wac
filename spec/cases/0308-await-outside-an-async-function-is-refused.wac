// expect: refused
// why: await is only a thing inside an async function, and the fix is on the declaration
// spec: §wac-await-inside-3nq7wbe
import { Ticket } from "core";

/** A ticket that is already answered: made directly, and settled with `resolve` (spec/next ch35). */
Ticket<i32> ready(i32 v) {
  Ticket<i32> t;
  t.resolve(v);
  return t;
}
export i32 answer() { return await ready(1); }
