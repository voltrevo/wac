// expect: answers f = 8
// why: `for (T x in xs)` binds each element in turn; `continue` goes on to the next and `break` leaves
// from: spec ch25 §wac-for-in-qkcbmxf
export i32 f() {
  i32 s = 0;
  for (i32 x in [1, 2, 3, 4, 5]) {
    if (x == 2) { continue; }
    if (x == 5) { break; }
    s += x;
  }
  return s;
}
