// expect: emits
// why: some cases are about a program being accepted at all, with no single value to ask for
struct Shape { i32 tag;
  i32 area(const this) { return 0; }
}
struct Square : Shape { i32 side;
  override i32 area(const this) { return this.side * this.side; }
}
export i32 f() { Square s = Square(1, 4); return s.area(); }
