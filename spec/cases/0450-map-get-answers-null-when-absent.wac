// expect: answers run = 2 true 7
// why: `get(k)` answers the value under `k`, or `null`; `getOr(k, d)` answers `d` instead
// from: spec/next ch39 §wac-map-get-nww5rzz
import { Map, hashString, stringEq } from "core";

export string run() {
  Map<string, i32> m = Map.create(hashString, stringEq);
  m.set("a", 2);
  return "\{m.get("a")!} \{m.get("z") is null} \{m.getOr("z", 7)}";
}
