// expect: refused
// why: a member of an inline namespace declared without `export` is visible only inside the namespace's block
// from: spec ch03 §wac-namespace-member-private-q5zj9wx
namespace helpers {
  i32 base() { return 3; }
  export i32 good() { return base() + 4; }
}
export i32 f() { return helpers.base(); }
