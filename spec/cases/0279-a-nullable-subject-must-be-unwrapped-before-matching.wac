// expect: refused
// spec:  §enum-match-nullable
// why: `match requires a non-null value` — extending match to handle null as a case is deferred
// from: spec/spec/enums.md, whose only checker was the reference's suite
enum Shape {
  Point,
  Circle(f64 radius),
  Rect(f64 width, f64 height),
}

export f64 f(Shape? s) {
  match (s) {
    Point: { return 0.0; }
    Circle(r): { return r; }
    Rect(w, h): { return w * h; }
  }
}
