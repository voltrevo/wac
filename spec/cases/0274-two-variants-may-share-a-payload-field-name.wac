// expect: answers f = 5
// spec:  §enum-dup-payload-field
// why: `enum E { A(i32 x), B(i32 x) }` is fine — they are different structs
// from: spec/spec/enums.md, whose only checker was the reference's suite
enum E { A(i32 x), B(i32 x) }
i32 got(E e) { return match (e) { case A(x): x, case B(x): x * 2 }; }
export i32 f() { return got(E.A(1)) + got(E.B(2)); }
