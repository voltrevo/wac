// expect: f() = 1
// why: the bare name is gone but `Slot.Empty` is how you write one, and that has to keep working
// from: spec/tour.wac and std's tests, which removing the bare name too eagerly refused
enum Slot<T> { Full(T v), Empty }
export i32 f() {
  Slot<i32> a = Slot.Full(1);
  Slot<i32> b = Slot.Empty;
  return match (a) { Full(v): v, Empty: 0 };
}
