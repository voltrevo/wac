// expect: answers run = 56 66
// why: `a++` calls `postIncrement` and `++a` calls `preIncrement`, each answering what its method returns
// from: spec/next ch22
import { operators } from "core";
struct Counter {
  i32 value;
  Counter [operators.postIncrement](this) { Counter old = Counter(this.value); this.value += 1; return old; }
  Counter [operators.preIncrement](this) { this.value += 1; return this; }
}
export i32 post() { Counter a = Counter(5); Counter old = a++; return old.value * 10 + a.value; }
export i32 pre() { Counter a = Counter(5); Counter now = ++a; return now.value * 10 + a.value; }

export string run() { return "\{post()} \{pre()}"; }
