// expect: refused
// why: once every variant is named, the else is a branch nothing can take
enum Shape { Point, Circle(f64 radius), Rect(f64 width, f64 height) }
export f64 f(Shape s) {
  match (s) {
    Point: { return 0.0; }
    Circle(r): { return r; }
    Rect(w, h): { return w; }
    default: { return 0.0; }
  }
}
