// expect: answers rebound = 3
// spec: §wac-const-rebindable-ri3wpfz, §wac-const-param-2vhk7dq
// why: `const P p` may not be reassigned; `(const P) p` may, and is still never written through
// from: spec ch17
struct P { i32 v; P? next; }
i32 last((const P) p) {
  while (p.next is not null) { p = p.next!; }
  return p.v;
}
export i32 rebound() { return last(P(1, P(2, P(3, null)))); }
