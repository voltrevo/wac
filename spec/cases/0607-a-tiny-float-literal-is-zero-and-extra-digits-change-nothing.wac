// expect: f() = true
// why: a float literal's value is its decimal value rounded to nearest: an exponent too large for any
//      integer is infinity, one far below the smallest subnormal is zero, and leading or excess digits
//      change nothing
// from: spec/2-types/09-numeric-literals.md
export bool f() {
  f64 big = 1e4294967297;
  f64 tiny = 1e-330;
  f64 under = 2.4703282292062327e-324;
  f64 half = 2.4703282292062328e-324;
  f64 one = 0000001.000e0;
  f64 lots = -800;
  return big == 1.0 / 0.0 && tiny == 0.0 && under == 0.0 && half > 0.0 && one == 1.0 && lots == 1.0;
}
