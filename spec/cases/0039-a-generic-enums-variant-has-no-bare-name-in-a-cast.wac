// expect: refused
// why: and again as a cast target, which is the third place a type name can be written
// from: specSingle's generic cluster
enum Slot<T> {
  Full(T v), Empty
  bool isFull(const this) { return match (this) { Full(_): true, Empty: false }; }
}
export i32 f() { Slot<i32> a = Slot.Full(1); return (a as! Full).v; }
