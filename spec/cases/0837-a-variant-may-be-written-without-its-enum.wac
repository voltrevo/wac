// expect: f() = 12
// spec:  §enum-construct-unqualified-r8vn2kd
// why: a variant may be written without its enum when it is the variant of one visible enum, and the
//      slot gives a generic one its instance — `Ok(x)`, `Err(e)`, a payload-free `Dot`
// from: spec/2-types/13-enums.md
import { Result } from "core";
enum Shape { Circle(i32 r), Dot }
Result<i32, string> half(i32 n) {
  if (n % 2 != 0) { return Err("odd"); }
  return Ok(n / 2);
}
i32 size(Shape s) { return match (s) { Circle(r): r, Dot: 1 }; }
export i32 f() {
  Shape a = Circle(3);
  Shape d = Dot;
  Shape pick = true ? Dot : Circle(9);
  Result<i32, string> r = half(10);
  i32 got = match (r) { Ok(v): v, Err(e): -1 };
  i32 odd = match (half(3)) { Ok(v): v, Err(e): e.len() };   // "odd" is 3
  return size(a) + size(d) + size(pick) + got + odd - 1;
}
