// expect: f() = 2
// why: `if (Circle(r) matches s)` binds the payload when it tests, so a later write to the variable
//      through a lambda does not change what the block reads
// from: spec/2-types/13-enums.md
enum S { Circle(i32 r), Sq(i32 side) }
export i32 f() {
  S s = S.Circle(2);
  fn<void()> flip = () => { s = S.Sq(9); };
  if (Circle(r) matches s) { flip(); return r; }
  return -1;
}
