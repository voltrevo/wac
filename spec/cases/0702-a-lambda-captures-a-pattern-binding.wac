// expect: f() = 15
// why: a lambda captures the locals it uses, and a match arm's or a `matches` pattern's binding is one
// from: spec/2-types/20-functions-and-funcrefs.md
enum E { A(i32 x), B }
i32 call(fn<i32()> g) { return g(); }
i32 arms(E e) {
  match (e) {
    A(x): { fn<i32()> g = () => x; return g(); }
    B: { }
  }
  return 0;
}
export i32 f() {
  E e = E.A(4);
  i32 a = match (e) { A(x): call(() => x), B: 0 };
  i32 b = 0;
  if (A(y) matches e) { b = call(() => y + 1); }
  return a + b + arms(E.A(6));
}
