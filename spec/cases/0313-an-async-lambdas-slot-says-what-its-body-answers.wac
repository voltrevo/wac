// expect: answers answer = 42
// why: a lambda writes no return type, so `fn<Ticket<R>(…)>` is what permits `async` and names `R`
// from: issues/lang/0294c
// spec: §wac-async-lambda-slot-9wq4nkz
import { Ticket } from "core";

/** A ticket that is already answered: made directly, and settled with `resolve` (spec ch35). */
Ticket<i32> ready(i32 v) {
  Ticket<i32> t;
  t.resolve(v);
  return t;
}

export i32 answer() {
  // The slot says `Ticket<i32>`, so `async` is allowed and the body is checked against `i32` —
  // `return v + v;` answers with the value, not with a ticket. The two readings are the same rule
  // a function states in the other direction.
  fn<Ticket<i32>(i32)> twice = async (i32 n) => {
    i32 v = await ready(n);
    return v + v;
  };
  return twice(21).wait()!;
}
