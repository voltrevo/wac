// expect: answers run = true 3 40
// why: `pop()`, `first()` and `last()` answer `T?` — `null` where there is no element, rather than a trap or an `Option`
// from: spec/next ch38 §wac-vec-pop-yszir66, §wac-vec-at-3dehker
import { Vec } from "core";

export string run() {
  Vec<i32> empty;
  Vec<i32> v = Vec.fromArray([1, 3]);
  i32 last = v.pop()!;
  Vec<i32> w = Vec.fromArray([10, 20, 30]);
  return "\{empty.pop() is null} \{v.len() == 1 ? last : 0} \{w.first()! + w.last()!}";
}
