// expect: answers paragraph = true
// why: core.html holds a function per element, building Node.Element with one Attr per attribute written
// from: spec ch43 §wac-html-tag-functions-sb9cij9
import { Node, html.p } from "core";

export bool paragraph() {
  Node n = <p class="hi">Hello</p>;
  return match (n) {
    Element(tag, attrs, kids): tag == "p" && attrs.len() == 1 && kids.len() == 1,
    default: false,
  };
}
