// expect: answers f = 5
// why: a variant's payload is a slot like any other, so a bare constructor can take its arguments from it
// from: the non-generic half of the last known false alarm — the generic half is still open
struct Box<T> { T v; }
enum Wrap { W(Box<i32> b) }
export i32 f() {
  Wrap w = Wrap.W(Box(5));
  return match (w) { case W(b): b.v };
}
