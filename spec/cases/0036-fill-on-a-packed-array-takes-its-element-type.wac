// expect: answers f = 7
// why: `fill` takes the element type, so an i32 fills a u8[] through a cast that says what to keep
// from: packages/zstd/src/block.wac, which an over-strict element check refused
export i32 f() {
  u8[] bytes = u8[].filled(4, 0);
  i32 v = 7;
  bytes.fill(v as@ u8, 0, 4);
  return bytes[3] as i32;
}
