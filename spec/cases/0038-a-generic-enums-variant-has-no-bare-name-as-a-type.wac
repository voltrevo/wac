// expect: refused
// why: the same name in a declaration — an instance's variant is not a type of its own
// from: specSingle's generic cluster
enum Slot<T> {
  Full(T v), Empty
  bool isFull(const this) { return match (this) { Full(_): true, Empty: false }; }
}
export i32 f() { Slot<i32> a = Slot.Full(1); Full s = a; return s.v; }
