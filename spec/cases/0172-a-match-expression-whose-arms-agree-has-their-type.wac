// expect: refused
// why: every arm answers i32, so the match does, and a string cannot hold it — the rule a ternary already follows
// from: the mutation sweep, packages/std/test/wac/option_test.wac
enum Opt { None, Some(i32 v) }
export i32 f(Opt o, i32 n) {
  string got = match (o) { None: n, Some(v): n };
  return 0;
}
