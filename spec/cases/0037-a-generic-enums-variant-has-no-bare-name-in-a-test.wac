// expect: refused
// why: a generic enum's variants belong to its instances, so `Some` alone names no type
// from: specSingle's generic cluster
enum Option<T> {
  Some(T v), None
  bool isSome(const this) { return match (this) { Some(_): true, None: false }; }
}
export i32 f() { Option<i32> a = Option.Some(1); return a is Some ? 1 : 0; }
