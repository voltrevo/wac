// expect: refused
// why: a generic enum's variants belong to its instances, so `Full` alone names no type
// from: specSingle's generic cluster
enum Slot<T> {
  Full(T v), Empty
  bool isFull(const this) { return match (this) { Full(_): true, Empty: false }; }
}
export i32 f() { Slot<i32> a = Slot.Full(1); return a is Full ? 1 : 0; }
