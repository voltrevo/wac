// expect: answers run = 0
// only:   wacc
// why: text between tags is a child, and whitespace between elements is not
// from: design/lang/0004
import { Attr, Node } from core;

/** Every text node, in order — which is what says the runs were split where they should be. */
string textOf(Node n) {
  match (n) {
    case Text(t): return t;
    case Element(tag, attrs, kids): {
      string out = "";
      for (i32 i = 0; i < kids.len(); i++) { out = out + textOf(kids[i]); }
      return out;
    }
  }
}

i32 kidsOf(Node n) {
  match (n) {
    case Element(tag, attrs, ks): return ks.len();
    case Text(t): return -1;
  }
}

export i32 run() {
  Node greeting = Node.Text("world");
  // Three kinds of child in one element: text, a nested element, and a spliced expression.
  Node p = <p>hello <b>brave</b> {greeting}</p>;
  if (textOf(p) != "hello braveworld") { return 1; }
  // text, <b> and the spliced node. The space between `</b>` and `{` is between two tokens and
  // belongs to neither, so it is not a child of its own.
  if (kidsOf(p) != 3) { return 2; }

  // **Spacing on one line is in the sentence**, so it is kept — including at the ends. It is a line
  // *break* that means layout, and `broken` below is where trimming happens.
  Node spaced = <p>  hello  world  </p>;
  if (textOf(spaced) != "  hello  world  ") { return 3; }

  // Written over several lines, the indentation goes.
  Node broken = <p>
    hello
  </p>;
  if (textOf(broken) != "hello") { return 5; }

  // Two elements with only whitespace between them: two children, whether on one line or several.
  Node between = <p><b>a</b> <b>b</b></p>;
  if (kidsOf(between) != 2) { return 4; }
  Node stacked = <p>
    <b>a</b>
    <b>b</b>
  </p>;
  if (kidsOf(stacked) != 2) { return 6; }
  return 0;
}
