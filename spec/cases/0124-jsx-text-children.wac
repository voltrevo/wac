// expect: answers run = 0
// only:   wacc
// why: text between tags is a child, and a line break between elements is layout
// from: design/lang/0004
// spec:  §jsx-text-is-a-child §jsx-whitespace-breaks-are-layout §jsx-empty-run-is-not-a-child
import { Attr, Node } from "core";

/** Every text node, in order — which is what says the runs were split where they should be. */
string textOf(Node n) {
  match (n) {
    case Text(t): return t;
    case Fragment(kids): {
      string out = "";
      for (i32 i = 0; i < kids.len(); i++) { out = out + textOf(kids[i]); }
      return out;
    }
    case Element(tag, attrs, kids): {
      string out = "";
      for (i32 i = 0; i < kids.len(); i++) { out = out + textOf(kids[i]); }
      return out;
    }
  }
}

i32 kidsOf(Node n) {
  match (n) {
    case Element(tag, attrs, ks): return ks.len();
    case Text(t): return -1;
    case Fragment(ks): return ks.len();
  }
}

export i32 run() {
  Node greeting = Node.Text("world");
  // Three kinds of child in one element: text, a nested element, and a spliced expression.
  Node p = <p>hello <b>brave</b> {greeting}</p>;
  if (textOf(p) != "hello brave world") { return 1; }
  // text, <b>, the space after it, and the spliced node. The space is a run of its own: a run of
  // text is everything between the tags that is not `{expr}` or an element, so whitespace on one
  // line is content like any other.
  if (kidsOf(p) != 4) { return 2; }

  // **Spacing on one line is in the sentence**, so it is kept — including at the ends. It is a line
  // *break* that means layout, and `broken` below is where trimming happens.
  Node spaced = <p>  hello  world  </p>;
  if (textOf(spaced) != "  hello  world  ") { return 3; }

  // Written over several lines, the indentation goes.
  Node broken = <p>
    hello
  </p>;
  if (textOf(broken) != "hello") { return 5; }

  // Two elements with a space between them, on one line: the space is a child, so `<b>a</b> <b>b</b>`
  // renders "a b" rather than "ab". Written over two lines it is a line break, which is layout, and
  // the run trims to nothing and is not a child at all.
  Node between = <p><b>a</b> <b>b</b></p>;
  if (kidsOf(between) != 3) { return 4; }
  if (textOf(between) != "a b") { return 7; }
  Node stacked = <p>
    <b>a</b>
    <b>b</b>
  </p>;
  if (kidsOf(stacked) != 2) { return 6; }
  return 0;
}
