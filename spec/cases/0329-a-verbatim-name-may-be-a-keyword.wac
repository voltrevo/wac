// expect: answers f = 20
// why: `@"…"` is a name whose spelling is the quoted text — a keyword, a hyphen, or an ordinary name, which it then is
// from: verbatim names (design/lang/0016), spec/next ch01 §wac-verbatim-name-jzwznre
i32 pick(i32 @"for", i32 @"data-size") { return @"for" + @"data-size"; }
i32 twice(i32 @"n") { return n * 2; }

export i32 f() { return pick(1, 3) + twice(@"match"()); }

i32 @"match"() { return 8; }
