// ---- rect.wac ----
export i32 perimeter(i32 w, i32 h) { return 2 * (w + h); }
// ---- shapes.wac ----
import { perimeter } from "./rect.wac";
i32 area(i32 w, i32 h) { return w * h; }
export { area, area as size, perimeter };
// ---- lib.wac ----
export { size, perimeter } from "./shapes.wac";
// ---- main.wac ----
import { area } from "./shapes.wac";
import { size, perimeter } from "./lib.wac";

export i32 f() { return area(3, 4) + size(1, 0) * 0 + perimeter(3, 4) - 0; }
