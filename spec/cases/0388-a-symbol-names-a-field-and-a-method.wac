// expect: answers f = 13
// why: a field or method may be named by a symbol, written `[s]` and selected as `x.[s]`; otherwise it is an ordinary member
// from: spec/next ch21 §wac-symbol-member-4z5ndyy
symbol metadata;
symbol describe;
struct Point {
  i32 x;
  i32 [metadata];
  i32 [describe](const this) { return this.x * 2; }
}
export i32 f() {
  Point p = Point(3, 0);
  p.[metadata] = 7;
  return p.[metadata] + p.[describe]();
}
