// expect: refused
// why: a parameter no attribute fills must be `kids` or nullable — `count` is neither
// from: spec ch23 §wac-markup-tag-is-function-vv4pvhq
import { markup } from "core";

// A tree of the program's own: markup names no type (design/lang/0017).
struct Attr {
  string name;
  string value;
}

enum Node {
  Element(string tag, Attr[] attrs, Node[] kids),
  Text(string text),
  Fragment(Node[] kids),

  Node [markup.text](string text) { return Node.Text(text); }
  Node [markup.fragment](Node[] kids) { return Node.Fragment(kids); }
  Node [markup.element](string tag, string[] names, string[] values, Node[] kids) {
    Attr[] attrs = Attr[].filled(names.len(), Attr("", ""));
    for (i32 i = 0; i < names.len(); i++) { attrs[i] = Attr(names[i], values[i]); }
    return Node.Element(tag, attrs, kids);
  }
}

Node card(string title, i32 count, Node[] kids) { return <"p">{title}</"p">; }

export i32 run() {
  Node n = <card title="x"/>;
  return 0;
}
