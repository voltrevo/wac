// expect: run() = my-widget label label caption
// why: a quoted tag is built by the child type's `[markup.element]` with that name; a bare or verbatim tag calls the function in scope
// from: spec ch23 §wac-markup-quoted-tag-builds-vn2k8xr, §wac-markup-verbatim-tag-ca3myup
import { markup } from "core";

// A tree of the program's own: markup names no type (design/lang/0017).
struct Attr {
  string name;
  string value;
}

enum Node {
  Element(string tag, Attr[] attrs, Node[] kids),
  Text(string text),
  Fragment(Node[] kids),

  Node [markup.text](string text) { return Node.Text(text); }
  Node [markup.fragment](Node[] kids) { return Node.Fragment(kids); }
  Node [markup.element](string tag, string[] names, string[] values, Node[] kids) {
    Attr[] attrs = Attr[].filled(names.len(), Attr("", ""));
    for (i32 i = 0; i < names.len(); i++) { attrs[i] = Attr(names[i], values[i]); }
    return Node.Element(tag, attrs, kids);
  }
}

string tagOf(Node n) {
  return match (n) {
    Element(tag, attrs, kids): tag,
    default: "",
  };
}

Node caption(Node[] kids) { return Node.Element("label", [], kids); }

export string icon()  { return tagOf(<"my-widget" data-size="8" />); }
export string one()   { return tagOf(<caption>Name</caption>); }
export string two()   { return tagOf(<@"caption">Name</@"caption">); }
export string three() { return tagOf(<"caption">Name</"caption">); }

export string run() { return icon() + " " + one() + " " + two() + " " + three(); }
