// expect: refused
// why: a field may be left out of braces only when it has a default, and a number has none — zero is a number somebody might have meant
// from: design/lang/0007

struct Opts {
  i32 width;
  string? title;
}

export i32 run() {
  // `title` may be left out; `width` may not, and this leaves out `width`.
  Opts a = Opts { title: "t" };
  return 0;
}
