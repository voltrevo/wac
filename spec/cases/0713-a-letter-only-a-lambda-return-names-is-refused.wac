// expect: refused
// why: a lambda has no type of its own to contribute, so nothing determines `U`
// from: spec/2-types/19-generics.md
U[] map<T, U>(T[] xs, fn<U(T)> g) { U[] out = U[].filled(xs.len(), g(xs[0])); return out; }
export i32 f() { i32[] xs = [1, 3, 5]; return map(xs, (i32 x) => x * 2).len(); }
