// expect: f() = 5
// spec: §wac-async-decl-h3vq81m
// why: the same binding over an awaited subject — `match (await e)` keeps `e`'s answer in a temporary whose type a pre-pass cannot compute yet, so the arm's variant was guessed by its name in the file, and with two files exporting an `Opened` the guess declined the module for good
// ---- pack.wac ----
export enum Opened {
  Ready(i32 n),
  Refused(string why)
}
export Opened openPack(i32 n) { return n > 0 ? Opened.Ready(n) : Opened.Refused("no"); }
// ---- repo.wac ----
export struct Repo { i32 n; }
export enum RepoAt {
  Opened(Repo repo),
  NoRepo(string why)
}
export async RepoAt openRepo(i32 n) { return RepoAt.Opened(Repo(n)); }
export async i32 use(Repo r) { return r.n; }
// ---- main.wac ----
import { RepoAt, openRepo, use } from "./repo.wac";
import { openPack } from "./pack.wac";
async i32 g() {
  match (openPack(1)) { Ready(n): { } Refused(w): { return 9; } }
  match (await openRepo(5)) {
    NoRepo(why): { return 0; }
    Opened(repo): {
      i32 k = await use(repo);
      return k;
    }
  }
  return 0;
}
export i32 f() { return g().wait()!; }
