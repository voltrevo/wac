// expect: answers run = true true 4
// why: `match` takes a `T?` when a `null` arm or a `default` covers the absent case; the other arms see it non-null
// from: spec/next ch25 §wac-match-nullable-subject-zcnasbp
enum Shape { Circle(f64 r), Square(f64 side) }

export f64? area(Shape? s) {
  return match (s) {
    Circle(r):  3.0 * r * r,
    Square(sd): sd * sd,
    null:       null,
  };
}

export f64? round(Shape? s) {
  return match (s) {
    Circle(r): 3.0 * r * r,
    default:   null,
  };
}

export f64? squareArea() { return area(Shape.Square(2.0)); }

export string run() { return "\{area(null) is null} \{round(null) is null} \{squareArea()!}"; }
