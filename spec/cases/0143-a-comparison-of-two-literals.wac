// expect: refused
// why: two literals compared have no type between them, so there is no width to compare at — and no fallback to pick one
// from: issues/lang/0117, which compared them at the literals' own family; spec ch09 §wac-literal-no-fallback-9pffhd9 refuses instead
export i32 run() {
  if (1.0 == 1.0) { return 1; }
  return 0;
}
