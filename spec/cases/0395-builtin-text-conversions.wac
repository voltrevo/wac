// expect: answers f = 42 -7 false 0.5 -0 -9223372036854775808 1e+21
// why: bool, every integer and every float have a built-in conversion: decimal, the shortest round-tripping decimal, true or false — and negative zero is "-0"
// from: spec ch23 §wac-tostring-builtin-4t3buvz
export string f() {
  i32 n = 42;
  i32 m = -7;
  bool flag = false;
  f64 half = 0.5;
  f64 negZero = -0.0;
  i64 least = -9223372036854775807 - 1;
  f64 big = 1.0e21;
  return "\{n} \{m} \{flag} \{half} \{negZero} \{least} \{big}";
}
