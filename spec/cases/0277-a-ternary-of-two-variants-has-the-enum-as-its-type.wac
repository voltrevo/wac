// expect: answers f = 20
// spec:  §enum-ternary-variants
// why: the base struct is the closest common ancestor of every variant
// from: spec/spec/enums.md, whose only checker was the reference's suite
enum E { A(i32 x), B }
i32 got(E e) { return match (e) { case A(x): x, case B: 1 }; }
export i32 f() {
  bool cond = true;
  E one = cond ? E.A(9) : E.B;              // two different variants
  E two = cond ? E.A(2) : E.A(3);           // both the same variant
  E enumTyped = E.B;
  E three = cond ? enumTyped : E.A(4);      // one branch already enum-typed
  return got(one) + got(two) * 5 + got(three);
}
