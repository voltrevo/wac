// expect: refused
// why: implementing `add` does not supply `addAssign`: `a += b` is its own operation, never `a = a + b`
// from: spec/next ch22 §wac-operator-independent-4ssj2cv, §wac-operator-compound-own-u7m6y7c
import { operators } from "core";
struct Counter {
  i32 value;
  Counter [operators.add](const this, i32 amount) { return Counter(this.value + amount); }
}
export i32 f() { Counter a = Counter(1); a += 2; return a.value; }
