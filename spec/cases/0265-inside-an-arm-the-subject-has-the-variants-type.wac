// expect: answers f = 3
// spec:  §enum-narrow
// why: `widthOf(Shape.Rect(3.0, 4.0))` returns 3.0 — the arm shadows the subject at the variant type
// from: spec/spec/enums.md, whose only checker was the reference's suite
enum Shape {
  Point,
  Circle(f64 radius),
  Rect(f64 width, f64 height),
}

f64 widthOf(Shape s) {
  match (s) {
    case Rect:   return s.width;
    case Circle: return s.radius * 2.0;
    case Point:  return 0.0;
  }
}
export i32 f() { return widthOf(Shape.Rect(3.0, 4.0)) as~ i32; }
