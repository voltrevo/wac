// expect: run() = name 8
// why: an attribute whose name is a keyword or has a hyphen fills the parameter whose verbatim name is that text
// from: spec ch23 §wac-markup-attr-verbatim-param-yd3farv
import { markup } from "core";

// A tree of the program's own: markup names no type (design/lang/0017).
struct Attr {
  string name;
  string value;
}

enum Node {
  Element(string tag, Attr[] attrs, Node[] kids),
  Text(string text),
  Fragment(Node[] kids),

  Node [markup.text](string text) { return Node.Text(text); }
  Node [markup.fragment](Node[] kids) { return Node.Fragment(kids); }
  Node [markup.element](string tag, string[] names, string[] values, Node[] kids) {
    Attr[] attrs = Attr[].filled(names.len(), Attr("", ""));
    for (i32 i = 0; i < names.len(); i++) { attrs[i] = Attr(names[i], values[i]); }
    return Node.Element(tag, attrs, kids);
  }
}

Node label(string id, string @"for", Node[] kids) {
  return Node.Element("label", [Attr("id", id), Attr("for", @"for")], kids);
}

Node widget(string @"data-size", Node[] kids) {
  return <"my-widget" data-size={@"data-size"} />;
}

string attr(Node n, string name) {
  match (n) {
    Element(tag, attrs, kids): {
      for (Attr a in attrs) {
        if (a.name == name) { return a.value; }
      }
    }
    default: { }
  }
  return "";
}

export string labelFor() { return attr(<label id="who" for="name">Name</label>, "for"); }
export string widgetSize() { return attr(<widget data-size="8" />, "data-size"); }

export string run() { return labelFor() + " " + widgetSize(); }
