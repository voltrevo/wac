// expect: refused
// spec:  §enum-narrow-const
// why: `cannot assign to 's' — a matched subject is const within its arm`
// from: spec/spec/enums.md, whose only checker was the reference's suite
enum Shape {
  Point,
  Circle(f64 radius),
  Rect(f64 width, f64 height),
}

export f64 reassign(Shape s) {
  match (s) {
    case Circle: { s = Shape.Point; return 0.0; }
    else:        return 0.0;
  }
}
