// expect: refused
// why: the front of the compiler takes an async method; the lowering does not know one yet
// spec: §wac-async-method-declined-7kq2vnm
import { Core, Cli, FileResult } from "std/platform.wac";

/**
 * `async` on a **method**, which parses and checks and does not yet emit.
 *
 * Three of the four places that had to know were taught it on 2026-08-30 — the parser accepts
 * `async` where it sits on a free function, the checker sets its async context around the body so an
 * `await` inside is right rather than reported as *outside an `async` function*, and a caller sees
 * `Pending<T>` of what the body answers. The fourth is `asynclower.wac`, which works on free-function
 * declarations and has no notion of a receiver, so this arrives at the emitter and is **declined by
 * name**:
 *
 *     a method Holder.sizeOf, declined: `await`, which the emitter does not lower yet
 *
 * That is the whole point of the case. Before those three changes the same source said *expected a
 * type … found 'async'* — a diagnostic about where the parser had got to, whose help line offered to
 * accept a type, which is advice that cannot be followed. `issues/lang/0301b`.
 *
 * **Why a connection is the example rather than something smaller.** This shape is why it matters:
 * a struct that owns a socket and reads through a method on itself is what `packages/ssh`'s `Conn`,
 * `packages/tor`'s `Link` and `packages/fs`'s `Chan` all are, and those methods are exactly the ones
 * that want to suspend. `issues/system/0294c`'s migration stops here.
 */
struct Holder {
  Cli cli;
  async i32 sizeOf(this, string path) {
    FileResult f = await this.cli.readFile(path);
    return f.ok ? f.bytes.len() : 0 - 1;
  }
}

export i32 main(Core core, Cli cli) {
  Holder h = Holder(cli);
  return h.sizeOf("README.md").wait();
}
