// expect: answers f = 1
// only: wacc
// spec:  §wacc-type-args-commit
// why: `0236` written the way the rule asks for. **One pair, on the first comparison** — once
//      `(a < b)` is a parenthesised expression the `c > e` after it has nothing to attach to and is
//      arithmetic again, so the second comparison needs nothing. That asymmetry is worth a case
//      because a reader told to "use parentheses" would reasonably write four of them.
// from: design/lang/0011
i32 g(bool x, bool y) { return x && y ? 1 : 0; }
export i32 f() { i32 a = 1; i32 b = 2; i32 c = 4; i32 e = 3; return g((a < b), c > e); }
