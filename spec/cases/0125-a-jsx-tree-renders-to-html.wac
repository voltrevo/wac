// expect: run() = 0
// why: the tree exists to be walked, and a renderer is the smallest thing that walks all of it
// from: design/lang/0004
import { markup } from "core";

// A tree of the program's own: markup names no type (design/lang/0017).
struct Attr {
  string name;
  string value;
}

enum Node {
  Element(string tag, Attr[] attrs, Node[] kids),
  Text(string text),
  Fragment(Node[] kids),

  Node [markup.text](string text) { return Node.Text(text); }
  Node [markup.fragment](Node[] kids) { return Node.Fragment(kids); }
  Node [markup.element](string tag, string[] names, string[] values, Node[] kids) {
    Attr[] attrs = Attr[].filled(names.len(), Attr("", ""));
    for (i32 i = 0; i < names.len(); i++) { attrs[i] = Attr(names[i], values[i]); }
    return Node.Element(tag, attrs, kids);
  }
}

/** `<"p" class="a">hi<"br"/></"p">` — every part of the tree reached exactly once. */
string render(Node n) {
  match (n) {
    Text(t): { return t; }
    Fragment(kids): {
      string out = "";
      for (i32 i = 0; i < kids.len(); i++) { out = out + render(kids[i]); }
      return out;
    }
    Element(tag, attrs, kids): {
      string out = "<" + tag;
      for (i32 i = 0; i < attrs.len(); i++) {
        out = out + " " + attrs[i].name + "=\"" + attrs[i].value + "\"";
      }
      // A childless element closes itself, which is the one place the two shapes differ.
      if (kids.len() == 0) { return out + "/>"; }
      out = out + ">";
      for (i32 i = 0; i < kids.len(); i++) { out = out + render(kids[i]); }
      return out + "</" + tag + ">";
    }
  }
}

export i32 run() {
  string who = "world";
  Node page = <"div" class="page" id={"top"}>
    <"h1">hello {Node.Text(who)}</"h1">
    <"br"/>
  </"div">;
  string html = render(page);
  string want = "<div class=\"page\" id=\"top\"><h1>hello world</h1><br/></div>";
  return html == want ? 0 : html.len();
}
