// expect: f() = 118
// why: `Vec<fn<…>?>.at` answers a box, as `Vec<P?>.at` does for a struct, so a present `null` and an
//      index past the end are told apart; `get` answers the nullable function itself
// from: issues/lang/0387a
import { Vec } from "core";
export i32 f() {
  Vec<fn<i32()>?> v = Vec.create();
  fn<i32()> g = () => 7;
  v.push(g);
  v.push(null);
  fn<i32()>? h = v.get(0);
  i32 n = 0;
  if (h is not null) { n = h!(); }
  if (v.get(1) is null) { n = n + 1; }
  fn<i32()>?? a = v.at(1);
  if (a is not null && a! is null) { n = n + 10; }
  if (v.at(5) is null) { n = n + 100; }
  return n;
}
