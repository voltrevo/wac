// expect: f() = 7
// why: a generic enum's methods work on its instances, including one with two parameters
// from: specSingle's known false alarms
enum Slot<T> {
  Full(T v), Empty
  T orElse(const this, T d) { return match (this) { Full(v): v, Empty: d }; }
}
enum Result<T, E> {
  Ok(T v), Err(E e)
  bool isOk(const this) { return match (this) { Ok(_): true, Err(_): false }; }
}
export i32 f() {
  Slot<i32> a = Slot.Full(3);
  Result<i32, i32> r = Result.Ok(4);
  return a.orElse(0) + (r.isOk() ? 4 : 0);
}
