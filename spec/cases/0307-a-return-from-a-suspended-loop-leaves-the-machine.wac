// expect: answers answer = 7
// why: a return inside a flattened loop leaves the function, not the loop
// from: design/lang/0014
import { Ticket } from "core";

/** A ticket that is already answered: made directly, and settled with `resolve` (spec/next ch35). */
Ticket<i32> ready(i32 v) {
  Ticket<i32> t;
  t.resolve(v);
  return t;
}
async i32 firstSeven(i32 n) {
  for (i32 i = 0; i < n; i++) {
    i32 v = await ready(7);
    return v;
  }
  return 0;
}
export i32 answer() { return firstSeven(5).wait()!; }
