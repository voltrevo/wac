// expect: answers f = 1
// why: `x is null` on a type that is never null is allowed and false — a generic has to instantiate it at a number as at a reference
// from: spec ch10 §wac-nonnull-isnull-k8fn3wp
struct Slot<T> {
  T v;
  bool empty(const this) { return this.v is null; }
}
export i32 f() {
  Slot<i32> a = Slot<i32>(3);
  Slot<string?> b = Slot<string?>(null);
  return (a.empty() ? 10 : 0) + (b.empty() ? 1 : 0);
}
