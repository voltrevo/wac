// expect: answers answer = 6
// why: a local that outlives a suspension survives it, including a loop's induction variable
// from: design/lang/0014
import { Ticket } from "core";

/** A ticket that is already answered: made directly, and settled with `resolve` (spec/next ch35). */
Ticket<i32> ready(i32 v) {
  Ticket<i32> t;
  t.resolve(v);
  return t;
}
async i32 sum(i32 n) {
  i32 total = 0;
  for (i32 i = 1; i <= n; i++) {
    i32 v = await ready(i);
    total = total + v;
  }
  return total;
}
export i32 answer() { return sum(3).wait()!; }
