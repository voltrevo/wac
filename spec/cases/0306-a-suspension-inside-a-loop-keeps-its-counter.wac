// expect: answers answer = 6
// why: a local that outlives a suspension survives it, including a loop's induction variable
// from: design/lang/0014
struct Sch { bool detach(this, i32 id) { return false; } }
struct Pending<T> {
  i32 id;
  fn[T(i32)] resolve;
  fn[bool(i32)] settled;
  fn[void(i32)] drop;
  Sch? sched;
  T wait(const this) { return this.resolve(this.id); }
  void then(this, fn[void(T)] f) { }
}
Pending<i32> ready(i32 v) {
  i32[] cell = i32[1](fill: v);
  fn[i32(i32)] r = (i32 id) => cell[0];
  fn[bool(i32)] s = (i32 id) => true;
  fn[void(i32)] d = (i32 id) => { };
  return Pending<i32>(0, r, s, d, null);
}
async i32 sum(i32 n) {
  i32 total = 0;
  for (i32 i = 1; i <= n; i++) {
    i32 v = await ready(i);
    total = total + v;
  }
  return total;
}
export i32 answer() { return sum(3).wait(); }
