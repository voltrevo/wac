// expect: answers f = 15
// spec:  §enum-match-else
// why: `radiusOr(Shape.Point, 1.5)` returns 1.5 — with an `else` no variant is required
// from: spec/spec/enums.md, whose only checker was the reference's suite
enum Shape {
  Point,
  Circle(f64 radius),
  Rect(f64 width, f64 height),
}

f64 radiusOr(Shape s, f64 fallback) {
  match (s) {
    case Circle(r): return r;
    else:           return fallback;
  }
}
export i32 f() { return (radiusOr(Shape.Point, 1.5) * 10.0) as~ i32; }
