// expect: f() = 11
// spec:  §wac-interp-union-member-m3vq8ke
// why: a union converts to text when every member does, through the member it holds — so a fault union reaches a
//      message without a match per member
// from: spec/3-expressions/23-interpolation-and-markup.md
import { toString } from "core";

struct Gone { string why; string [toString](const this) { return "gone: " + this.why; } }
struct Late { i32 ms; string [toString](const this) { return "late"; } }

string say(union<Gone, Late> e) { return "\{e}"; }

export i32 f() { return say(Gone("x")).len() + say(Late(5)).len(); }
