// expect: answers realParts = 5
// spec: §wac-fromnumber-literal-jqssasj, §wac-fromnumber-static-ah2ihmk
// why: a literal whose target implements `[fromNumber]` is that method's answer, computed statically
// from: spec ch09
import { NumberLiteral, fromNumber, Result } from "core";
struct Complex {
  f64 real;
  f64 imaginary;
  Result<Complex> [fromNumber](NumberLiteral value) {
    f64 real = try f64.[fromNumber](value);
    return Result.Ok(Complex(real, 0.0));
  }
}
export f64 realParts() {
  Complex x = 3;
  Complex y = 2;
  return x.real + y.real;
}
