// expect: answers run = 0
// only:   wacc
// why: ten MVP instructions had no spelling, and the loop that stood in for one is in a hot path
// from: issues/lang/0069
// spec:  §wacc-int-bit-methods

/** What `highBit` is written as today, in two packages, to stand in for one instruction. */
u32 highBitByLoop(u32 v) {
  u32 n = 0;
  u32 x = v;
  while (x > 1) { n = n + 1; x = x >> 1; }
  return n;
}

export i32 run() {
  // **Written through typed locals**, not `(0 as u32)`: a literal takes the integer type expected of
  // it, so a `u32` local *is* how you say "this value is a u32" — and `as` between two integer types
  // of the same width is a reinterpretation the language spells `as!`, which the reference refuses
  // in the plain form. The first draft of this case used `(0 as u32)` throughout and only compiled
  // because this compiler was not checking casts on literals at all. `issues/lang/0119`.
  u32 zero = 0;
  u32 one = 1;
  u32 low8 = 255;
  u32 eight = 8;
  u32 high = 0x80000000;
  u32 seven = 7;

  // `leadingZeros` of zero is the full width — wasm says so, and C's `__builtin_clz(0)` is
  // undefined, which is the reason to say it out loud.
  if (zero.leadingZeros() != 32) { return 1; }
  if (one.leadingZeros() != 31) { return 2; }
  if (low8.leadingZeros() != 24) { return 3; }

  if (zero.trailingZeros() != 32) { return 4; }
  if (eight.trailingZeros() != 3) { return 5; }

  if (zero.onesCount() != 0) { return 6; }
  if (low8.onesCount() != 8) { return 7; }

  // Rotation, which five crypto primitives each write as a function of their own.
  if (one.rotateLeft(1) != 2) { return 8; }
  if (high.rotateLeft(1) != 1) { return 9; }
  if (one.rotateRight(1) != high) { return 10; }
  // The count is taken mod the width, as the shift operators already do.
  if (seven.rotateLeft(32) != 7) { return 11; }

  // The width comes from the receiver: an i64 answers in i64.
  u64 zero64 = 0;
  u64 one64 = 1;
  if (zero64.leadingZeros() != 64) { return 12; }
  if (one64.onesCount() != 1) { return 13; }

  // And the loop it replaces agrees with it over a thousand values, which is the whole point: the
  // instruction is not a new answer, it is the same answer without the loop.
  u32 width = 31;
  for (u32 i = 1; i < 1000; i = i + 1) {
    if (highBitByLoop(i) != width - i.leadingZeros()) { return 14; }
  }
  return 0;
}
