// expect: answers run = 0
// only:   wacc
// why: ten MVP instructions had no spelling, and the loop that stood in for one is in a hot path
// from: issues/lang/0069
// spec:  §wacc-int-bit-methods

/** What `highBit` is written as today, in two packages, to stand in for one instruction. */
u32 highBitByLoop(u32 v) {
  u32 n = 0;
  u32 x = v;
  while (x > 1) { n = n + 1; x = x >> 1; }
  return n;
}

export i32 run() {
  // `leadingZeros` of zero is the full width — wasm says so, and C's `__builtin_clz(0)` is
  // undefined, which is the reason to say it out loud.
  if ((0 as u32).leadingZeros() != 32) { return 1; }
  if ((1 as u32).leadingZeros() != 31) { return 2; }
  if ((255 as u32).leadingZeros() != 24) { return 3; }

  if ((0 as u32).trailingZeros() != 32) { return 4; }
  if ((8 as u32).trailingZeros() != 3) { return 5; }

  if ((0 as u32).onesCount() != 0) { return 6; }
  if ((255 as u32).onesCount() != 8) { return 7; }

  // Rotation, which five crypto primitives each write as a function of their own.
  if ((1 as u32).rotateLeft(1) != 2) { return 8; }
  if ((0x80000000 as u32).rotateLeft(1) != 1) { return 9; }
  if ((1 as u32).rotateRight(1) != 0x80000000 as u32) { return 10; }
  // The count is taken mod the width, as the shift operators already do.
  if ((7 as u32).rotateLeft(32) != 7) { return 11; }

  // The width comes from the receiver: an i64 answers in i64.
  if ((0 as u64).leadingZeros() != 64 as u64) { return 12; }
  if ((1 as u64).onesCount() != 1 as u64) { return 13; }

  // And the loop it replaces agrees with it over a thousand values, which is the whole point: the
  // instruction is not a new answer, it is the same answer without the loop.
  u32 width = 31;
  for (u32 i = 1; i < 1000; i = i + 1) {
    if (highBitByLoop(i) != width - i.leadingZeros()) { return 14; }
  }
  return 0;
}
