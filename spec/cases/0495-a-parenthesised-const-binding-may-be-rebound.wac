// expect: answers walked = 2
// spec: §wac-const-rebindable-ri3wpfz
// why: `(const Node)? cur` is a cursor over const data: rebinding it walks the list, and the type is
//      `const Node?`, so `cur = cur!.next` reads through a const reference into a const binding
// from: spec ch17
struct Node { i32 v; Node? next; }
i32 length(const Node head) {
  i32 n = 0;
  (const Node)? cur = head;
  while (cur is not null) {
    n++;
    cur = cur!.next;
  }
  return n;
}
export i32 walked() { return length(Node(1, Node(2, null))); }
