// expect: answers f = 12
// why: a void type argument makes a payload-free variant, so Ok() takes nothing and a Ticket<void> can be waited on
// spec: §wac-ticket-value-9iqsfzw

/**
 * `Result<void, string>` is what a `Ticket<void>`'s `wait` answers, and what `Result.Ok()` builds with
 * no argument (spec ch11: `R = void` gives a payload-free variant; ch44 writes `Result.Ok()`).
 *
 * The slot is still in the enum's layout, holding a placeholder, so `match` and `unwrap` work at
 * `void` exactly as at any other type.
 */
import { Result, Ticket } from "core";

Result<void, string> ok(bool b) {
  if (b) { return Result.Ok(); }
  return Result.Err("no");
}

export i32 f() {
  Ticket<void> t;
  t.settleWith(() => { });
  t.wait()!;
  i32 n = match (ok(true)) { Ok(_): 1, Err(_): 2 };
  i32 m = match (ok(false)) { Ok(_): 1, Err(_): 2 };
  return n * 10 + m;
}
