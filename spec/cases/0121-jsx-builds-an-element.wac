// expect: run() = 3
// why: a quoted tag is the child type's `[markup.element]` with that name, its attributes and its children
// from: design/lang/0004
// spec: §wac-markup-quoted-tag-builds-vn2k8xr
import { markup } from "core";

// A tree of the program's own: markup names no type (design/lang/0017).
struct Attr {
  string name;
  string value;
}

enum Node {
  Element(string tag, Attr[] attrs, Node[] kids),
  Text(string text),
  Fragment(Node[] kids),

  Node [markup.text](string text) { return Node.Text(text); }
  Node [markup.fragment](Node[] kids) { return Node.Fragment(kids); }
  Node [markup.element](string tag, string[] names, string[] values, Node[] kids) {
    Attr[] attrs = Attr[].filled(names.len(), Attr("", ""));
    for (i32 i = 0; i < names.len(); i++) { attrs[i] = Attr(names[i], values[i]); }
    return Node.Element(tag, attrs, kids);
  }
}

/** Every node in the tree, which needs the children to have actually been put there. */
i32 count(Node n) {
  match (n) {
    Text(t): { return 1; }
    Fragment(kids): { return 2; }
    Element(tag, attrs, kids): {
      i32 total = 1;
      for (i32 i = 0; i < kids.len(); i++) { total = total + count(kids[i]); }
      return total;
    }
  }
}

export i32 run() {
  Node kid = Node.Text("hi");
  // A tag, two attributes — one a literal and one an expression — a nested element, and a spliced
  // child. Each is a different path through the lowering.
  Node tree = <"div" class="a" id={"b"}><"br"/>{kid}</"div">;
  match (tree) {
    Element(tag, attrs, kids): {
      if (tag != "div") { return -1; }
      if (attrs.len() != 2) { return -2; }
      if (attrs[0].name != "class" || attrs[0].value != "a") { return -3; }
      if (attrs[1].name != "id" || attrs[1].value != "b") { return -4; }
      return count(tree);
    }
    Text(t): { return -5; }
    Fragment(kids): { return -6; }
  }
}
