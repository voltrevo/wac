// expect: answers answer = 5
// why: awaiting the outer ticket yields the inner one, and neither await is redundant
// spec: §wac-async-nested-6bqt3jf
import { Ticket } from "core";

/** A ticket that is already answered: made directly, and settled with `resolve` (spec/next ch35). */
Ticket<i32> ready(i32 v) {
  Ticket<i32> t;
  t.resolve(v);
  return t;
}
async Ticket<i32> handOn(i32 v) {
  i32 first = await ready(0);
  return ready(v);
}
export i32 answer() {
  Ticket<Ticket<i32>> outer = handOn(5);
  Ticket<i32> inner = outer.wait()!;
  return inner.wait()!;
}
