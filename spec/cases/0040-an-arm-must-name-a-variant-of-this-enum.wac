// expect: refused
// why: belonging to some enum is not the question — the arm has to belong to the subject's
// from: specSingle's generic cluster
enum Slot<T> {
  Full(T v), Empty
  bool isFull(const this) { return match (this) { Full(_): true, Empty: false }; }
}
export i32 f() { Slot<i32> a = Slot.Full(1); return match (a) { Nope(v): v, Empty: 0 }; }
