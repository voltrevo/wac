// expect: answers f = 1
// why: `anyref?` is a slot like any other, and `null` goes into it
// from: packages/sh/src/exec.wac's `Shell.interruptCtx`, which declined the whole file
struct Holder { anyref? ctx; i32 n; }
export i32 f() {
  Holder h = Holder(null, 1);
  return h.ctx is null ? h.n : 0;
}
