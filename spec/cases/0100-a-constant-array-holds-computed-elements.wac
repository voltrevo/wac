// expect: answers f = 29
// why: a constant array's elements are values, and where they came from is the compiler's business —
// why: folded before emission or computed once at instantiation, the program cannot tell
// from: the `constant folding` row of packages/wacc/README.md's tooling table
const i32[] T = i32[](1 + 2, 4 * 5, 100 - 90);
const i32 N = 3 * 4;
export i32 f() { return T[0] + T[1] + T[2] - N + 8; }
