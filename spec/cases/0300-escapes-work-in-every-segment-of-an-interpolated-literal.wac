// expect: answers f = 4
// why: a segment is an ordinary literal, so `\t` before the interpolation and `\u{41}` after it
//      resolve exactly as they would without one — the second segment is the one that regressed
//      when only `stringLiteralBytes` learned the new bounds and `knownEscapes` did not
// from: design/lang/0013 D7
string id(string s) { return s; }
export i32 f() { string s = "\t\{id("x")}\u{41}\n"; return s.len(); }
