// expect: answers f = 14
// why: when the left operand is an unresolved numeric literal and the right is a struct, `2 * v` calls `v.[multiplyFromLeft](2)` and the parameter types the literal
// from: spec/next ch22 §wac-operator-reverse-sw6qk57
import { operators.multiplyFromLeft } from "core";
struct Vec2 {
  i32 x;
  i32 y;
  Vec2 [multiplyFromLeft](const this, const i32 lhs) { return Vec2(lhs * this.x, lhs * this.y); }
}
export i32 f() { Vec2 v = 2 * Vec2(3, 4); return v.x + v.y; }
