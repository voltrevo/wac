// **Keep new text in this file ASCII, until `issues/lang/0253a` is fixed.** One non-ASCII character
// in a *comment* here is enough to turn `test_rung_5_wacc_compiled_by_wacc_compiles_wacc_to_the_same_bytes`
// red: this file's text is embedded in `packages/wacc/src/coretext.wac`, so a comment reaches what
// the compiler is built from, and the reference and wacc then disagree about the bytes. `wac task
// seed`'s own fixpoint check does *not* catch it, so the first sign is a red suite some minutes
// later with no obvious connection to the sentence that was typed. An em dash is the usual way in,
// because the rest of this repository writes them freely.
//
// The platform world: everything an application may do, and nothing else.
//
// wac has no ambient access -- no imports a program can name, no globals reaching outside -- so an
// application can only touch what it is handed: a `Sys`, and the handles it gives out.
//
// **Under them is one host call** (design/system/0013 step 6). A host serves numbered requests whose
// arguments are ints, a string and bytes -- the `OP_*` table at the end of this file -- and answers
// each in one shape, `Answer`, through `answered`. Everything a handle does is std code over that, so
// a host builds no wac value and a host that answers one module can answer another. The program
// adapter hands the host's four calls to `__WacHost.of` and builds the `Sys` over what it answers.
//
// Requests are coarse on purpose. Behind each may be a thread parking on a `SharedArrayBuffer`,
// which is nothing per file read and ruinous per byte: `readFile`, never `readByte`.

// The one type this world does not define itself. `Read` is in `core` — the compiler's own module —
// because the streaming transforms in `gzip` and `stream` must name it too and have no business
// depending on a capability world, and because **nominal typing** means a second copy of it could
// never be converted into this one. See wac's `design/0001`. (That reason was written as "with no
// closures in the language", which is both out of date and never the reason: two declarations of a
// shape are two types whatever a funcref can capture.)
import { Buf, Continuation, Map, Queue, Read, Result, Stuck, Ticket, TicketBase, Vec, flatten, hashI32, hashString, i32Eq, stringEq, toString, __wacScheduleTarget,
         __wacSetScheduleTarget } from "core";


/**
 * Milliseconds as nanoseconds, because a budget is given in the first and the clock answers in the
 * second. Named rather than written out at each use: `drainUntil` compares a difference of nanoseconds
 * against a number of milliseconds, and getting that by a factor of a million is a bug that looks like
 * a scheduler that never waits.
 */
i64 millisToNanos(i32 millis) { return (millis as i64) * (1000000 as i64); }

/**
 * What a host's `waitAny` answers when it **cannot wait** — a page, which may not block until an answer
 * arrives. Distinct from `-1`, "nothing answered in time": this one means "return to me, and I will call
 * you again when something has". Design `system/0015`, decision 4.
 */
export i32 HOST_CANNOT_WAIT() { return 0 - 2; }


/** What a path is, if it is anything. Everything is zero or false when `exists` is false. */
/**
 * Why a filesystem change did not happen, in a form a program can act on.
 *
 * **Integers rather than an enum**, which is the opposite of `Read` above and for a reason that
 * survives asking: a fault is *compared* (`rm -f` wants to know whether it was merely absent), and a
 * wac enum is a reference type with no `==` — payload-less variants allocate, so even `is` would be
 * false between two `NotFound`s. `ERR_*` in `packages/http` and `GRANT_*` below are the same shape
 * for the same reason. If enums ever compare by value, this becomes one.
 *
 * A category *and* the host's message, because neither replaces the other: the category is what a
 * program branches on, and the message is what a person reads. Matching the message's words to
 * recover the category — which is what an applet had to do before this existed — is a guess about
 * three operating systems.
 */
export i32 FAULT_NONE() { return 0; }
export i32 FAULT_NOT_FOUND() { return 1; }
export i32 FAULT_DENIED() { return 2; }
export i32 FAULT_EXISTS() { return 3; }
export i32 FAULT_NOT_EMPTY() { return 4; }
/** The host said something this world has no category for; the message is all there is. */
export i32 FAULT_OTHER() { return 5; }
/**
 * The host cannot express this name, so the operation was never attempted.
 *
 * Not the same as absent, and the difference is visible from a shell: `ls` in a directory holding a file
 * whose name is not valid UTF-8 lists `bad-\ufffd-name`, and every attempt to open *that* answers "no such
 * file or directory" — a file you can see and cannot touch, with the blame on whoever typed it.
 *
 * Measured on Deno, which is where this world mostly runs: `Deno.readDir` replaces the invalid bytes with
 * U+FFFD, and `Deno.stat` of the name it just handed you fails `NotFound`. There is no byte-oriented path
 * in that API, so the file is genuinely unnameable from here — this is not a conversion this repository can fix by
 * changing a signature, which is what wac-mono 0065 assumed at first. Node's `fs` takes a `Buffer` and
 * could do it; the Deno host cannot, and says so.
 */
export i32 FAULT_NOT_REPRESENTABLE() { return 6; }

/**
 * The program was not given this capability.
 *
 * Not an operating-system failure, which is why it is not `FAULT_DENIED`: that one is the file saying no,
 * and this one is the program never having been handed the file. A caller wants to say different things
 * about them, and until this existed it could not tell them apart — a withheld filesystem and a
 * `chmod 000` were the same category with different sentences.
 *
 * **`faultWords` has a phrase for it, and used not to.** The argument for having none was that the host's
 * own sentence — "filesystem read not granted to this application" — says what no errno phrase can, and a
 * caller falling back to the message would print exactly the right thing. That holds only where there *is*
 * a message: a failed read or change carries one, and **`Stat` does not**. So `stat: cannot tell — ` was
 * what a program printed for the answer this category exists to give, with nothing after the dash.
 */
export i32 FAULT_NOT_GRANTED() { return 7; }

/**
 * A directory where a file was wanted.
 *
 * The eighth, and the argument against it was that this taxonomy is not errno granularity. What
 * overruled it: a program *branches* on this. `cat` on a directory and `cat` on a missing file are
 * different mistakes and every real tool says so, and wac-mono 0067 recorded the question when
 * `Fs.readFile` had to answer `FAULT_OTHER` for it. Without a category the host's own sentence was the
 * only information, so a read of a directory reached the output as "Is a directory (os error 21)" — an
 * errno, no filename, and a different sentence per runtime.
 */
export i32 FAULT_IS_DIR() { return 8; }

/**
 * **We have not written this.** Not the file's fault, not the build's, and not the host's.
 *
 * The ninth, and it exists because the closest available word was reaching users as a lie. `Fs.chmod`
 * on a host mount is not implemented and said so in its *message* — while answering `FAULT_DENIED`,
 * because that was the nearest category. `packages/sh` renders a fault as `faultWords` gives it, so
 * "we have not written this" arrived as `chmod: cannot access 'o': Permission denied`, which blames
 * the file for something the file did not do. GNU succeeds there: `chmod` wants ownership, not read.
 *
 * `faultWords` deliberately has **no phrase** for it, which is not an oversight but the mechanism:
 * every caller already spells the empty case as `words == "" ? f.error : words`, so the *message* is
 * what reaches the user — and the message is the only thing that can say **what** is unimplemented.
 * A category with fixed words would say less than the sentence it replaced.
 *
 * So why a category at all, if it prints the message either way? Because a caller can **branch** on
 * it, which is the same argument `FAULT_IS_DIR` won on. `FAULT_OTHER` means "the host said something
 * no category covers" — a real failure, out there. This one means the request never reached a host.
 * A program deciding whether to try another route needs to tell those apart, and until now could not.
 *
 * wac-mono 0117.
 */
export i32 FAULT_UNSUPPORTED() { return 9; }

/**
 * A file where a directory was wanted — `ENOTDIR`, the other half of `FAULT_IS_DIR`.
 *
 * The tenth, and it is the one the taxonomy could least afford to be without, because **every operation
 * can hit it**: any path with a `/` in it walks components, and a component that turns out to be a file
 * fails this way. `FAULT_IS_DIR` is one operation on one path; this is `f/g` for every `f` that is not a
 * directory, and it had no category at all — so `cat f/g` said `Not a directory (os error 20)` and
 * `mkdir f/g` said `Not a directory (os error 20): mkdir '/abs/path/f/g'`, an errno and the *host's*
 * absolute path, in a world whose first claim is that a session cannot see the host it runs on.
 *
 * It is a genuinely different answer from absence, which is what it was arriving as. GNU distinguishes
 * them everywhere — `cat: f/g: Not a directory` against `cat: f/g: No such file or directory` — and a
 * person needs to: one means fix the name, the other means `f` is not what you thought it was.
 *
 * **`stat` is the exception, and deliberately.** `test -e f/g` is *false* in bash rather than an error,
 * so a stat that hit this still answers "nothing there". It now carries the category alongside — see
 * `statFault` in `host/faults.ts` — so `ls` and `cd` can say which absence it was without `test`
 * changing its mind.
 */
export i32 FAULT_NOT_A_DIR() { return 10; }

/**
 * The filesystem will not take a write at all — `EROFS`.
 *
 * The eleventh, and it was found the same way `FAULT_NOT_A_DIR` was, one layer down: `packages/fs`'s
 * synthesised backing answers this for `/dev` and `/proc` and had to say it in its *message*, as
 * `FAULT_DENIED` with the words "read-only file system". That worked only for as long as callers
 * printed the message — the moment `reasonOf` started preferring the category's phrase, which is the
 * whole point of having categories, a write to `/dev/zero` began saying `Permission denied` and the
 * one useful fact was gone.
 *
 * It is a different answer from `FAULT_DENIED` in the way that matters to whoever reads it: nothing
 * about this file or this user refused, and no `chmod` will help. `strerror(EROFS)` is "Read-only file
 * system" and that is what `faultWords` says, because it is what bash prints when a redirection lands
 * on a read-only mount.
 */
export i32 FAULT_READ_ONLY() { return 11; }

/**
 * The name is longer than the host will take — `ENAMETOOLONG`.
 *
 * Found by hand, not by a differential: no corpus script has a three-hundred-character filename, so
 * every two-host comparison agreed, and what they agreed on was `File name too long (os error 36)` —
 * the operating system's sentence with its errno still attached, where GNU prints the same words and
 * nothing else. The two hosts matching each other is exactly why this survived; they were both wrong
 * in the same way, which is the failure a two-host differential cannot see and a real tool can.
 */
export i32 FAULT_NAME_TOO_LONG() { return 12; }

/**
 * A symbolic link that leads back to itself — `ELOOP`.
 *
 * The other half of the same find, and the same shape: `cat loop` said "Too many levels of symbolic
 * links (os error 40)" on both hosts where GNU says it without the errno. A filesystem that can make
 * links can make this one, and `packages/fs` grew `linkStat` this week, so it is reachable now in a
 * way it was not when the fault table was written.
 */
export i32 FAULT_LOOP() { return 13; }

/**
 * The filesystem will not take any more — `ENOSPC`.
 *
 * The one of the three that is **not** the same on both hosts, and the reason is the runtime rather
 * than the code: Deno refuses `/dev/full` at `open` for want of `--allow-all`, so a JavaScript host
 * answers `FAULT_NOT_GRANTED` and never reaches the write; the wasmtime host opens it and the write
 * fails, which is the only place in this repository where `outputError` carries a real reason. Both
 * answers are true about their own runtime, and the category is what lets a program tell them apart
 * from each other and from a full disk.
 */
export i32 FAULT_NO_SPACE() { return 14; }

/**
 * The three a *socket* needs, and the reason they are here rather than folded into `FAULT_OTHER`.
 *
 * Every code above this line is about a filesystem, and so is `fault_of` in both native hosts: it
 * maps `NotFound`, `PermissionDenied`, `IsADirectory` and seven more, and everything else falls to
 * `FAULT_OTHER`. The network capability inherited that vocabulary, so `Socket.fault` could say "you
 * were not granted this" and otherwise only "something went wrong" -- a refused connection, a host
 * with no route to it and one that never answered were one category.
 *
 * **They are three answers a person acts on differently**, which is the argument
 * `packages/tor/src/socks5.wac` already makes for the SOCKS reply codes it maps: "Connection refused"
 * and "not allowed by ruleset" send someone to look in different places, and collapsing both to a
 * general failure sends them nowhere. `issues/system/0255c` is the consumer.
 */
export i32 FAULT_REFUSED() { return 15; }
/** Nothing at that address, or no route to it -- `EHOSTUNREACH` and `ENETUNREACH`. */
export i32 FAULT_UNREACHABLE() { return 16; }
/** It never answered. Distinct from refused: a refusal is an answer. */
export i32 FAULT_TIMED_OUT() { return 17; }

/**
 * A fault in the words the real tools use, or `""` where the category has none to give.
 *
 * One table, because there were four: `sh` had one for a change and another for a read, `box`
 * had a third, and a fourth was about to be written for `Stat`. Four copies of a phrase list drift, and
 * the drift is invisible — each one is only read when something has already gone wrong. The `sh` and `box`
 * copies had already diverged: one of them had no phrase for `FAULT_NOT_REPRESENTABLE` and said the host's
 * English instead, which is the exact failure the category was added to prevent.
 *
 * The words are GNU's, deliberately, because that is what our differential tests compare against and what
 * a person reading a shell's output expects: `No such file or directory`, not `os error 2`. The
 * capability layer is the right home for them — a fault number is meaningless without them, and every
 * struct that carries one is declared here.
 *
 * `""` for `FAULT_OTHER` and `FAULT_NONE`: the first means the host had something to say that no category
 * covers, so the caller should print *its* message rather than a category's, and the second is not a
 * failure at all. Callers spell that as `words == "" ? f.error : words`, which is the shape all four
 * copies already had.
 */
export string faultWords(i32 fault) {
  if (fault == FAULT_NOT_FOUND()) { return "No such file or directory"; }
  if (fault == FAULT_DENIED()) { return "Permission denied"; }
  if (fault == FAULT_EXISTS()) { return "File exists"; }
  if (fault == FAULT_NOT_EMPTY()) { return "Directory not empty"; }
  // Not GNU's words, because GNU has none for this: a filesystem it can name every file in has no reason
  // to. Saying the host cannot express the name is the true sentence, and it beats "No such file or
  // directory" for a file the caller has just seen in `ls`. wac-mono 0065.
  if (fault == FAULT_NOT_REPRESENTABLE()) { return "cannot be named on this host"; }
  // Also not GNU's, for the same reason: a program the operating system runs was granted everything the
  // operating system has, so GNU never had to say this. It is the sentence a caller most needs, because it
  // is the one failure that is nothing to do with the file.
  if (fault == FAULT_NOT_GRANTED()) { return "Not granted to this application"; }
  // Capitalised, like the rest here and like `strerror`, which is where GNU's wording comes from.
  if (fault == FAULT_IS_DIR()) { return "Is a directory"; }
  // `strerror(ENOTDIR)`, and GNU prints exactly this and nothing else — no errno, no path beyond the one
  // the user typed. Compared against `/bin/cat`, `/bin/mkdir` and the rest in `box/test/notdir.test.ts`.
  if (fault == FAULT_NOT_A_DIR()) { return "Not a directory"; }
  // `strerror(EROFS)`, which is what bash prints for a redirection onto a read-only mount.
  if (fault == FAULT_READ_ONLY()) { return "Read-only file system"; }
  // The next three are `strerror` too, and each is what GNU prints with no errno after it: compared
  // against `cat`, `wc` and a redirection in `native_hostfs`, on both hosts.
  if (fault == FAULT_NAME_TOO_LONG()) { return "File name too long"; }
  if (fault == FAULT_LOOP()) { return "Too many levels of symbolic links"; }
  if (fault == FAULT_NO_SPACE()) { return "No space left on device"; }
  // `strerror`'s words for ECONNREFUSED, EHOSTUNREACH and ETIMEDOUT, so a program that prints a
  // socket failure says what `nc` and `curl` say.
  if (fault == FAULT_REFUSED()) { return "Connection refused"; }
  if (fault == FAULT_UNREACHABLE()) { return "No route to host"; }
  if (fault == FAULT_TIMED_OUT()) { return "Connection timed out"; }
  // `FAULT_UNSUPPORTED` falls through to `""` on purpose — see its own comment. The message says what
  // is unimplemented, and no fixed phrase could.
  return "";
}



/**
 * The same, for a program that did not do what was asked — and the **killed** case is why it exists.
 *
 * Every caller writes the same phrase by hand: `e.error + string.fromBytes(e.stderr)`. It is right for
 * the two ordinary outcomes and renders the third as nothing at all. `error` is empty whenever the
 * program started, and a child killed by a signal writes no `stderr` before it dies — so an
 * out-of-memory kill prints as a sentence that stops after the dash. A reason with no cause in it is
 * what `issues/system/0142` is a page of.
 *
 * Takes no status, because `std` has no integer formatter and the caller has the number anyway.
 */
export string execReason(Exec r) {
  if (!r.ran()) { return r.error; }
  if (r.signalled()) {
    return "killed by a signal, having written nothing — on a shared machine the usual cause is memory";
  }
  string said = string.fromBytes(r.stderr);
  return said.len() > 0 ? said : "exited non-zero and said nothing";
}

/**
 * What a host program did: `Procs.exec`'s answer.
 *
 * **`status` is an exit code, not a fault.** A program that ran and exited non-zero is a different
 * fact from a program that could not be started, and every differential oracle in this repository
 * asserts on the first constantly — the interesting case for `openssl`, `python3` or `git` is
 * usually the input the reference implementation *rejects*. So a refusal to start is reported in
 * `error`, which is empty whenever the program ran at all, whatever it then did.
 *
 * `stdout` and `stderr` are bytes and stay separate. Bytes because a compressor's output is not
 * text and a lossy decode would corrupt exactly the differential it was fetched for; separate
 * because merging them makes a warning indistinguishable from an answer.
 *
 * `issues/system/0165`.
 */
export struct Exec {
  /**
   * The exit code, when the program ran. Meaningless when `error` is non-empty.
   *
   * **`-1` means the child died by a signal rather than exiting**, and it is a real value rather than
   * an absence: a signalled process has no exit code at all, so all four hosts write `code ?? -1`.
   * It is safe as a sentinel because a POSIX status is eight bits — no child that *exited* can
   * produce it — which is the one thing that saves it from being a sentinel drawn from the value's own
   * range. Read it through `signalled()` rather than by comparing, so the convention has a name.
   *
   * `ran()` is still true for such a child: it started, and a signal is how it ended.
   */
  i32 status;
  u8[] stdout;
  u8[] stderr;
  /**
   * Why it could not be started, and **empty when it was** — including when it then failed.
   *
   * `FAULT_NOT_GRANTED`'s message appears here too: a build without `--allow-run` is told it was
   * not granted, rather than being handed a plausible-looking empty answer.
   */
  string error;

  Exec of(i32 status, u8[] stdout, u8[] stderr, string error) {
    return Exec(status, stdout, stderr, error);
  }

  /** Whether the program started. Says nothing about whether it succeeded — read `status` for that. */
  bool ran(const this) { return this.error.len() == 0; }

  /** Whether it ran **and** exited zero, which is what most callers mean by "it worked". */
  bool ok(const this) { return this.ran() && this.status == 0; }

  /**
   * Whether it started and was **killed** rather than exiting — see `status`.
   *
   * Worth a name because the alternative is every caller writing `status == 0 - 1`, and because the
   * two facts a caller usually wants to separate are "it failed" and "it was killed": an out-of-memory
   * kill and a program that exited non-zero are the same `!ok()` and very different problems. The
   * signal *number* is not carried — the hosts do not report it — so this says that it happened and
   * not which one.
   */
  bool signalled(const this) { return this.ran() && this.status == 0 - 1; }
}


export struct Stat {
  bool exists;
  bool isFile;
  bool isDir;
  i64 size;
  /** Milliseconds since the epoch, or 0 where the host does not say. */
  i64 modifiedMillis;
  /**
   * Whether the path itself is a symbolic link.
   *
   * **Always false from `stat`**, which follows links and therefore describes what one leads to.
   * `linkStat` is the one that answers this. Both exist because both questions are real: `find`
   * wants to know whether to descend into what a name leads to, and `tar` wants to know whether the
   * name is a link before it stores anything.
   */
  bool isSymlink;

  /**
   * Whether the owner-execute bit is set.
   *
   * **One bit, not a mode**, for the reason `Files.setExecutable` gives. It is what distinguishes git's
   * `100644` from its `100755`, and building a tree from a working tree cannot tell them apart without it
   * — every blob was recorded as `100644`, which made a commit of an executable record a mode change
   * nobody asked for. issues/system/0132.
   *
   * **False where the host has no mode bits**, which is a true answer rather than a stand-in: a browser's
   * OPFS does not have them, so nothing there is executable and saying so is correct.
   */
  bool isExecutable;

  /**
   * Why this is not an answer, or `FAULT_NONE` when it is.
   *
   * **Absence is an answer, not a fault.** A path that is simply not there gives `exists = false` with
   * `FAULT_NONE`, because "there is nothing here" is what `stat` was asked. A fault means the question
   * could not be *reached*: `FAULT_NOT_GRANTED` when the world has no read capability, `FAULT_DENIED`
   * when it has one and the operating system refused anyway, and
   * `FAULT_NOT_REPRESENTABLE` for a name this host cannot express — a file `ls` has just listed, whose
   * name came back from `readDir` with an invalid byte replaced, so every path built from it fails.
   *
   * Before this field, both of those arrived as `exists = false`: `test -e` said no about a file that is
   * there, and a program with no read grant could not tell "absent" from "not allowed to look". wac-mono
   * 0065 left this open on the grounds that giving `Stat` a fault changes every caller. It does, and the
   * callers are better for it — a caller that only wants existence still reads `exists`, and one that
   * reports to a person now has something true to say.
   *
   * So: **check `fault` before trusting `exists`.**
   *
   * ## The exception, which is `FAULT_NOT_A_DIR`
   *
   * There is one fault here that does *not* mean the question went unreached: `f/g` where `f` is a
   * file. The host is certain, `exists = false` is exactly right, and the extra thing to say is which
   * kind of nothing it is. Every real tool distinguishes them — `cat: f/g: Not a directory` against
   * `cat: f/g: No such file or directory` — and bash's `test -e f/g` is nonetheless plain *false*
   * rather than an error, so a caller that only wanted existence must not start failing.
   *
   * So this one rides along with the facts intact, and `answered` is what draws the line. `statFault`
   * in `host/faults.ts` decides which faults reach a `Stat` at all, and `faults_agree.test.ts` holds
   * the two ends together.
   */
  i32 fault;

  /** The permission bits, `0644` and the like, with set-id and sticky above them — 0 where the host has none. */
  i32 mode;

  /**
   * Who owns it, by name, in a store that keeps owners (`MemoryStore`) — and `""` from the host, which does not
   * track owners for a program: its owners are numbers in somebody else's user table.
   */
  string owner;

  /** A host's answer, which carries no owner. */
  Stat of(bool exists, bool isFile, bool isDir, i64 size, i64 modifiedMillis, bool isSymlink,
          bool isExecutable, i32 fault, i32 mode) {
    return Stat(exists, isFile, isDir, size, modifiedMillis, isSymlink, isExecutable, fault, mode, "");
  }

  /**
   * Whether `exists`, `isFile` and `isDir` can be trusted.
   *
   * Not `fault == FAULT_NONE()`, which is what it was: `FAULT_NOT_A_DIR` is a fault whose facts are
   * *sound* — see the field above — and every caller here treats a false answer as "the question could
   * not be reached", which for that one would be untrue. `test -e f/g` would have begun exiting 2 with
   * a diagnostic where bash says false.
   *
   * The list is short and belongs in one place rather than spelled out at each of the five call sites,
   * which is the whole reason this method exists.
   */
  bool answered(this) {
    return this.fault == FAULT_NONE() || this.fault == FAULT_NOT_A_DIR();
  }

  /**
   * This `Stat`'s fault in a real tool's words, or `otherwise` where the category has none.
   *
   * The fallback is the caller's because it depends on what the caller already knows, and there were
   * **four** of these written out separately — the shell's `ls` said `"Permission denied"` for a
   * directory it could not list, the `ls` applet said the same thing a different way, `cd` and the
   * `stat` applet hard-coded `"No such file or directory"` and `"not found"`, and `packages/sh` had a
   * `statReason` saying `"cannot be examined"`. Four spellings of `words == "" ? something : words`,
   * which is how the `ls` builtin came to say GNU's sentence for an absence and the `ls` applet an
   * invented one, for the same fault, in the same binary.
   *
   * Three of those fallbacks were right for their call site; the fourth (`"not found"`) was a phrase no
   * real tool prints. Passing it in keeps that judgement where it belongs and the lookup in one place.
   */
  string words(this, string otherwise) {
    string found = faultWords(this.fault);
    return found == "" ? otherwise : found;
  }
}


/**
 * One datagram, **and who sent it**, in a single answer.
 *
 * The pairing is the whole reason this is a struct rather than two calls. A datagram socket serves
 * many peers at once, so bytes and sender only mean something together: with `receiveFrom` answering
 * the payload and a separate `senderOf` answering the address, two datagrams arriving between the two
 * calls would hand a program one datagram's bytes with another's sender. That is not a race it could
 * detect — both halves are well-formed, and for QUIC the connection id inside the packet would be the
 * only clue that the address is wrong. Answering both at once makes the mistake unspellable.
 *
 * `peer` is the address alone, as `Socket.peer` is, and `port` is the peer's — *unlike* `Socket.port`,
 * which is this end's. A reply goes back to exactly this pair, which is why the sender's port is kept
 * here when a stream socket had no use for it.
 */
export struct Datagram {
  u8[] bytes;
  /** The sender's address: `127.0.0.1`, or an IPv6 address without brackets. */
  string peer;
  /** The sender's port. `sendTo(handle, peer, port, …)` is the reply. */
  i32 port;
  /** Why there is no datagram. Empty on success, and `bytes` is then the payload — which may be empty. */
  string error;

  /** Declared rather than generated, for the reason `Socket.of` gives: the host builds these. */
  Datagram of(u8[] bytes, string peer, i32 port, string error) {
    return Datagram(bytes, peer, port, error);
  }
}

/**
 * A spawned worker, or why there isn't one.
 *
 * The handle goes to `recv`, `send`, `waitAny` and `closeSocket` exactly as a socket's does.
 * That is the point of the design: a child is not a new kind of thing, so a shell running
 * `a | b` reads one handle and writes another, and watching a child beside a socket is
 * `waitAny` over two handles that happen to have different origins.
 */
/**
 * What a spawned child may do: `Authority.grants()`, which `OP_SPAWN` carries.
 *
 * Bit flags, combined with `|`. The host intersects them with its own grants, so these are a
 * request rather than an instruction and a parent can never widen what it was given.
 *
 * There is deliberately no flag for standard input and output: a child always has those, they
 * are how a parent talks to it at all, and they reach nothing the parent did not hand over.
 */
export static i32 GRANT_NONE = 0;
/** `readFile`, `stat`, `readDir`, `openRead` on a path. */
export static i32 GRANT_READ = 1;
/** `writeFile`, `mkdir`, `remove`, `rename`, `openWrite` to a path. */
export static i32 GRANT_WRITE = 2;
/** `connect`, `listen`, `accept` — the child's own sockets, not the parent's. */
export static i32 GRANT_NET = 4;
/** `env`, which answers `NotGranted` without it. */
export static i32 GRANT_ENV = 8;

/**
 * Running a host program — `Procs.exec`.
 *
 * **Bit 16, and added late on purpose.** `spawn`'s note used to say there was no bit for this and that a
 * loaded module which could `exec` would hold the one authority the narrowing exists for. That was
 * right while the *host* decided grants: nothing could pass it on, so `load_module` hard-coded
 * `run: false`. With the built-in program holding every capability and deciding what it hands on, the
 * bit is how it hands this one on — a test runner granting its own oracle the right to spawn, and
 * nothing else getting it by default. `issues/system/0264c`.
 */
export static i32 GRANT_RUN = 16;
/**
 * Every grant there is: "narrow nothing", which is not the same as "everything".
 *
 * A `spawn` or a `load` asking for this gets the intersection with what the caller holds, so a program
 * built with no grants hands over none of them whatever it asks. It is the honest spelling for a
 * caller that means "as much as I have": `GRANT_NONE` is the other honest one, and a hand-written
 * `GRANT_READ | GRANT_WRITE | GRANT_NET | GRANT_ENV` is a fourth thing to keep in step every time a
 * bit is added.
 */
export i32 GRANT_ALL() { return GRANT_READ | GRANT_WRITE | GRANT_NET | GRANT_ENV | GRANT_RUN; }

/**
 * Which of a child's standard streams are its parent's own, rather than queues the parent reads.
 *
 * **Flags in one `i32` rather than a bool each**, which is what `grants` two arguments earlier
 * already does. Two reasons beyond consistency: they are one question — *which of this child's
 * streams am I standing in for* — and a capability may not have seven parameters,
 * `issues/lang/0291c`.
 */
export static i32 INHERIT_NONE = 0;
/** `OP_OPEN_FILE`'s `a`: read it. */
static i32 OPEN_READ = 0;
/** `OP_OPEN_FILE`'s `a`: write it, created if absent and emptied if not. */
static i32 OPEN_WRITE = 1;
/** `OP_OPEN_FILE`'s `a`: write after what is there, created if absent. */
static i32 OPEN_APPEND = 2;
/**
 * The child reads this program's own standard input instead of the queue `send` fills.
 *
 * It *streams*, so `yes | sh -c 'head -1'` does not buffer without bound, and it is *shared*, so
 * `cat; cat` prints one line as it does in every real shell — a parent cannot know how much a child
 * read, and with this it does not have to.
 */
export static i32 INHERIT_IN = 1;
/**
 * The child writes this program's own output streams instead of queues the parent relays.
 *
 * **Without it the order between the two streams is lost**, because two queues record nothing about
 * which write came first: a diagnostic written between two lines of output arrives after both, so
 * `echo one; nope; echo two` gave `one two` and then the complaint. `issues/system/0282c`, and it was
 * a race rather than a fixed reordering — 11 runs in 20.
 *
 * **For a launcher, not for a shell.** A parent that wants the bytes — a pipeline, a redirection, a
 * capture — has to be the one holding them; with this they go straight past it, and `seq 1 3 | wc -l`
 * printed `1 2 3` and counted `0`. Pass it when the program's whole job is to *be* the thing it
 * started, which is what `wac <prog.wasm>` is.
 */
export static i32 INHERIT_OUT = 2;
/**
 * **Not a stream: the child outlives its ticket.** A child's ticket owns the child — dropping it
 * uncollected stops the child, as `closeSocket` on the handle does — so a child nobody can reach is not
 * something a program makes by accident. This flag asks for exactly that: fire-and-forget, a child that
 * runs on with no one holding it. Shares the `inherit` mask because it is a choice about the child made
 * at the same moment, and a capability may not grow a seventh parameter. `issues/system/0312b`.
 */
export static i32 DETACHED = 4;

/**
 * How many host calls one worker may have outstanding at once.
 *
 * Every request in flight holds one call slot until it is collected or cancelled, so this is the
 * ceiling on how many handles a program can watch: watching N sockets means N outstanding `recv`s, plus
 * one for an `accept` and one for whatever it writes with. Exceeding it does not degrade into slowness —
 * the extra submission parks, and the calls holding the slots cannot complete, so it deadlocks.
 *
 * Stated here rather than transcribed into each program, because it has already changed twice (four,
 * sixteen, 128) and every copy of the old number becomes a limit nobody can explain.
 * `test/wac/slots_test.wac` fails if this and `host/layout.ts` disagree.
 */
export static i32 CALL_SLOTS = 128;

/**
 * Standard input's handle, so that `waitAny` can watch it beside a socket and a child.
 *
 * Reserved rather than allocated: a host's handle counter starts past the reserved ones, so this
 * can never name anything else. `test/wac/handles_test.wac` is what holds the hosts to that.
 */
export static i32 STDIN = 0;

/**
 * The handle a **child** reads and writes to reach its parent's filesystem — the other end of
 * `Child.fsHandle`, seen from inside the child.
 *
 * Reserved in the same way and for the same reason as `STDIN`, and it has to be a fixed number
 * because there is nothing to tell a child what its own number would be: a program that starts and
 * wants its parent's filesystem asks on this handle or does not ask at all. `Fs.overParent` is the
 * only caller, and `recv(PARENT_FS)` on a program that was not spawned answers nothing — which is
 * how a program can tell the difference without a capability to ask with.
 */
export static i32 PARENT_FS = 1;



/**
 * What one call to a loaded module's export answered.
 *
 * **A trap is a value here, and that is the point.** 389 of this repository's 2553 test exports are
 * `test_traps_*` — a test that passes *by* trapping — and no wac program can catch one. Without a
 * status for it, a caller learns about such a test by dying with it.
 *
 * The signatures a call accepts are a **closed set**: `void f()`, `i32 f()`, `i32 f(i32)`, and
 * `i32`- or `string`-returning `f(__WacHost)`. That is every shape the four commands need. Anything
 * else answers `status == 3` rather than being marshalled — widening the set is a decision about the
 * boundary, and answering plainly is what stops it being made by accident.
 */
export struct CallResult {
  /**
   * 0 returned, 1 **trapped**, 2 no such export, 3 a signature this cannot call.
   *
   * Distinct rather than merged because the remedies differ: 2 is a typo or a module built without
   * the export, and 3 is a request to widen the boundary.
   */
  i32 status;
  /**
   * A `string`-returning export's answer, or, when `status` is 1, what the trap said.
   *
   * **Empty when it said nothing**, which is an engine trap: a bounds check, a null dereference, a
   * bare `trap;`. Only `trap "..."` writes a sentence. This field is the answer to "did it say why",
   * and `status` is already the answer to "did it trap" -- so the engine's own word for the
   * instruction does not go here. It used to, and one host had to invent that word to match another.
   */
  string text;
  /** An `i32`-returning export's answer, and 0 for every other shape. */
  i32 value;

  /** It returned. Says nothing about *what*: a failing test returns a report. */
  bool ok(const this) { return this.status == 0; }
  /** It trapped, which for a `test_traps_*` export is the pass. */
  bool trapped(const this) { return this.status == 1; }

  CallResult of(i32 status, string text, i32 value) { return CallResult(status, text, value); }
}



// ── Sys ─────────────────────────────────────────────────────────────────────────────────────────

/**
 * The authority a program is handed on its `main` (spec ch07, ch44): every effect on the world is a method reached
 * through one, or a handle one hands out.
 *
 * **Built over the host's flat calls** (design/system/0013 step 6): the program adapter hands it the `__WacHost`
 * the host holds, and every handle is std over that — so nothing here is a value the host built.
 */
export struct Sys {
  __WacHost host;
  /** The line to this program's parent, which `files` asks once whether the parent serves it files. */
  ParentLine parent;
  /**
   * A line to the output (`false`) or the diagnostic output: what `log` and `warn` call. A function rather than a
   * request made here, so a `const` holder can log -- every request changes the host's bookkeeping, and calling a
   * function a field holds does not change the holder.
   */
  fn<void(bool, string)> say;

  /** The `Sys` a program's `main` is handed — by the program adapter (`wacc/src/program.wac`). */
  Sys __wacOn(__WacHost host) {
    return Sys(host, ParentLine.on(host), (bool toErr, string line) => { hostWrite(host, toErr, (line + "\n").toBytes()); });
  }

  /** The program's arguments, in order, without its own name. Needs no grant. */
  string[] args(const this) {
    i32 n = flatten(hostAsk(this.host, OP_ARG_COUNT(), 0 as i64, 0 as i64, "", u8[](), countOf).wait()).orElse(0);
    string[] out = string[].defaulted(n);
    for (i32 i = 0; i < n; i++) {
      out[i] = string.fromBytes(flatten(hostAsk(this.host, OP_ARG(), i as i64, 0 as i64, "", u8[](), argOf).wait()).orElse(u8[]()));
    }
    return out;
  }

  /** A line on the program's output. */
  void log(const this, string line) { this.say(false, line); }

  /** A line on the program's diagnostic output. */
  void warn(const this, string line) { this.say(true, line); }

  /** Nanoseconds from an arbitrary origin, never decreasing within a run; 0 where the host has no clock. */
  async i64 monotonicNanos(this) { return (await this.clock().monotonicNanos()).orElse(0 as i64); }

  /** Settles after at least `ms` milliseconds. */
  async void sleepMillis(this, i32 ms) { await this.clock().sleepMillis(ms); }

  /** A file's bytes. A missing file, a directory or a missing grant is an `Err`, in the host's words. */
  async Result<u8[], string> readFile(this, string path) {
    match (await this.files().readFile(path)) {
      Ok(b): { return Result.Ok(b); }
      Err(e): { return Result.Err("\{e}"); }
    }
  }

  /** Write `bytes` to a file, replacing it. A missing grant is an `Err`, in the host's words. */
  async Result<void, string> writeFile(this, string path, u8[] bytes) {
    match (await this.files().writeFile(path, bytes)) {
      Ok(v): { return Result.Ok(); }
      Err(e): { return Result.Err("\{e}"); }
    }
  }

  /** This program's output (spec ch44). Needs no grant. */
  Output stdout(this) {
    __WacHost host = this.host;
    return Output((u8[] b) => hostWrite(host, false, b),
                  () => hostAsk(host, OP_CLOSE_OUTPUT(), 0 as i64, 0 as i64, "", u8[](), outputClosedOf));
  }

  /** This program's diagnostic output. Needs no grant. */
  Output stderr(this) {
    __WacHost host = this.host;
    return Output((u8[] b) => hostWrite(host, true, b),
                  () => hostAsk(host, OP_CLOSE_OUTPUT(), 1 as i64, 0 as i64, "", u8[](), outputClosedOf));
  }

  /** This program's input. Needs no grant. */
  Input stdin(this) {
    __WacHost host = this.host;
    return Input(() => hostChunk(host), () => hostReadAll(host), nothingToClose);
  }

  /** The clocks. Needs no grant. */
  Clock clock(this) { return Clock(this.host); }

  /** Random bytes. Needs no grant. */
  Random random(this) { return Random(this.host); }

  /**
   * Whether the user has asked to interrupt (`^C`) since the last time this asked — answered by whoever owns the
   * keyboard, so only a page says yes; Deno, Node and the native hosts own none and always say no. Needs no grant.
   * A long loop asks once per block of work and stops with 130, as a shell reports a program `^C` ended.
   */
  bool interrupted(const this) { return this.host.interrupted(); }

  /** The environment. Each operation answers `NotGranted` when the host withheld it. */
  Env env(this) { return Env(this.host); }

  /**
   * The files this program was given: what its parent serves when it was spawned with a composed `Files` (spec ch44
   * `§wac-std-files-served-t5h2mzr`), and otherwise the host's, where each operation answers `NotGranted` when the host
   * withheld it.
   */
  Files files(this) {
    if (this.parent.serves()) { return parentFiles(this.parent); }
    return Files.host(this.host);
  }

  /** The network. Each operation answers `NotGranted` when the host withheld it. */
  Net net(this) { return Net(this.host); }

  /** Starting other programs, this one included. Each operation answers `NotGranted` when the host withheld it. */
  Procs procs(this) { return Procs(this.host); }

  /** Loading wasm modules into this instance. */
  Modules modules(this) { return Modules(this.host); }

  /** End the program now with status `code`, abandoning whatever is left. */
  never exit(const this, i32 code) {
    this.host.exitWith(code);
    trap;
  }

  /**
   * `drain` for at most `millis`, answering how many waits answered — none is how a server tells it was idle. What
   * is left over stays outstanding.
   */
  i32 drainFor(this, i32 millis) { return this.host.drainUntil(millis, null); }

  /**
   * Run the continuations nobody awaited. Work that can never run — a continuation waiting on a ticket nothing will
   * settle — leaves this waiting too, and a program waiting on nothing that can move is hung.
   */
  async void drain(this) {
    this.host.drainUntil(0 - 1, null);
    if (this.host.outstanding() > 0) {
      Ticket<void> stuck;
      await stuck;
    }
  }

  /**
   * Run the program until `t` settles, with the work it left unawaited alongside — the program adapter's wait on an
   * `async` main. False, having said so, when nothing can move it.
   */
  bool __wacSettle(this, TicketBase t) {
    this.host.yielded = false;
    this.host.drainUntil(0 - 1, t);
    // **A host that cannot wait is yielded to, not reported as a hang**: the program is still running, and the host
    // settles again once an answer has arrived (`__wacYielded`, design `system/0015`).
    if (!t.done && !this.host.yielded) {
      this.warn("main cannot finish: nothing that can run will settle what it waits on");
    }
    return t.done;
  }

  /**
   * Learn, without waiting, whether this program's parent serves it files — the program adapter's first step for an
   * `async` `main` (`ParentLine.greet`).
   */
  async void __wacGreet(this) { await this.parent.greet(); }

  /** Whether the last `__wacSettle` stopped because the host cannot wait, rather than because nothing could run. */
  bool __wacYielded(const this) { return this.host.yielded; }

  /** `main` answered an `Err`: say why, and exit 1. */
  i32 __wacFailed(this, string why) {
    this.warn(why == "" ? "main answered an error" : "error: " + why);
    return 1;
  }
}

Result<i32, HostFault> countOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(hostFaultOf(a.fault, a.text)); }
  return Result.Ok(a.n as~ i32);
}

Result<u8[], HostFault> argOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(hostFaultOf(a.fault, a.text)); }
  return Result.Ok(a.bytes);
}


// ── Faults (design/system/0013, spec ch44) ───────────────────────────────────────────────────────
//
// Each way a capability can fail is a type of its own, and a capability's error is the union of the ones
// it can raise, so the signature says what can go wrong and a `match` on it must cover it. Every fault
// carries the host's own sentence. The aliases below name the sets the handles share.

/** No such file, directory or host. */
export struct NotFound {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}
/** The world refused: permissions, ownership. */
export struct Denied {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}
export struct Exists {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}
export struct NotEmpty {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}
export struct IsDir {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}
export struct NotADir {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}
export struct ReadOnly {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}
export struct NameTooLong {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}
/** Too many symbolic links. */
export struct Loop {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}
export struct NoSpace {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}
/** A name this host cannot spell. */
export struct NotRepresentable {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}
/** Nothing is listening there. */
export struct Refused {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}
export struct Unreachable {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}
export struct TimedOut {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}
/** The reader of this program's output or diagnostic output has gone — `yes | head`. */
export struct OutputClosed {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}
/** The other end of a socket has gone. */
export struct PeerClosed {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}
/** This program was not given that authority. */
export struct NotGranted {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}
/** This host does not provide the capability. A capability it lacks answers this, and never traps. */
export struct Unsupported {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}
/** A failure no category above names, with whatever the host said. */
export struct Other {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}

/** Reading a file or opening it to read. */
export type ReadFault = union<NotFound, Denied, IsDir, NotADir, NameTooLong, Loop, NotRepresentable, NotGranted,
                              Unsupported, Other>;
/** Writing a file or opening it to write. */
export type WriteFault = union<NotFound, Denied, IsDir, NotADir, NameTooLong, Loop, NotRepresentable, NoSpace,
                               ReadOnly, NotGranted, Unsupported, Other>;
/** Looking at a path without changing it: `stat`, `readDir`. */
export type LookFault = union<NotFound, Denied, NotADir, NameTooLong, Loop, NotRepresentable, NotGranted,
                              Unsupported, Other>;
/** Making a directory. */
export type MkdirFault = union<Exists, NotFound, Denied, NotADir, NameTooLong, Loop, NotRepresentable, NoSpace,
                               ReadOnly, NotGranted, Unsupported, Other>;
/** Removing or renaming. */
export type MoveFault = union<NotFound, Denied, IsDir, NotADir, NotEmpty, Exists, NameTooLong, Loop,
                              NotRepresentable, NoSpace, ReadOnly, NotGranted, Unsupported, Other>;
/** Changing a file's mode. */
export type ModeFault = union<NotFound, Denied, NotADir, NameTooLong, Loop, NotRepresentable, ReadOnly,
                              NotGranted, Unsupported, Other>;
/** Writing to this program's output or diagnostic output. */
export type OutputFault = union<OutputClosed, NoSpace, Unsupported, Other>;
/** What any capability with no category of its own can answer. */
export type HostFault = union<Unsupported, Other>;
/** Asking the host something that needs a grant and nothing else can go wrong with. */
export type GrantedFault = union<NotGranted, Unsupported, Other>;

ReadFault readFault(i32 code, string m) {
  if (code == FAULT_NOT_FOUND()) { return NotFound(m); }
  if (code == FAULT_DENIED()) { return Denied(m); }
  if (code == FAULT_IS_DIR()) { return IsDir(m); }
  if (code == FAULT_NOT_A_DIR()) { return NotADir(m); }
  if (code == FAULT_NAME_TOO_LONG()) { return NameTooLong(m); }
  if (code == FAULT_LOOP()) { return Loop(m); }
  if (code == FAULT_NOT_REPRESENTABLE()) { return NotRepresentable(m); }
  if (code == FAULT_NOT_GRANTED()) { return NotGranted(m); }
  if (code == FAULT_UNSUPPORTED()) { return Unsupported(m); }
  return Other(m);
}

WriteFault writeFault(i32 code, string m) {
  if (code == FAULT_NO_SPACE()) { return NoSpace(m); }
  if (code == FAULT_READ_ONLY()) { return ReadOnly(m); }
  return readFault(code, m);
}

LookFault lookFault(i32 code, string m) {
  if (code == FAULT_NOT_FOUND()) { return NotFound(m); }
  if (code == FAULT_DENIED()) { return Denied(m); }
  if (code == FAULT_NOT_A_DIR()) { return NotADir(m); }
  if (code == FAULT_NAME_TOO_LONG()) { return NameTooLong(m); }
  if (code == FAULT_LOOP()) { return Loop(m); }
  if (code == FAULT_NOT_REPRESENTABLE()) { return NotRepresentable(m); }
  if (code == FAULT_NOT_GRANTED()) { return NotGranted(m); }
  if (code == FAULT_UNSUPPORTED()) { return Unsupported(m); }
  return Other(m);
}

MkdirFault mkdirFault(i32 code, string m) {
  if (code == FAULT_EXISTS()) { return Exists(m); }
  if (code == FAULT_NO_SPACE()) { return NoSpace(m); }
  if (code == FAULT_READ_ONLY()) { return ReadOnly(m); }
  return lookFault(code, m);
}

MoveFault moveFault(i32 code, string m) {
  if (code == FAULT_IS_DIR()) { return IsDir(m); }
  if (code == FAULT_NOT_EMPTY()) { return NotEmpty(m); }
  return mkdirFault(code, m);
}

ModeFault modeFault(i32 code, string m) {
  if (code == FAULT_READ_ONLY()) { return ReadOnly(m); }
  return lookFault(code, m);
}

HostFault hostFault(string m) { return Other(m); }

// ── The standard streams ─────────────────────────────────────────────────────────────────────────

/**
 * Somewhere this program writes: its output, its diagnostic output, a file opened to write, or a child's input.
 *
 * A write whose reader has gone answers `OutputClosed`, and an `OutputClosed` that reaches `main` unhandled ends
 * the program quietly with status 0 — `yes | head` (spec ch44 `§wac-std-output-closed-c9dspr3`).
 */
export struct Output {
  fn<Ticket<Result<void, OutputFault>>(u8[])> write;
  /**
   * No more (`§wac-std-close-r4v8ndq`): whoever reads it sees the end, and a file holds what was written once this
   * answers — a browser commits a file only here.
   */
  fn<Ticket<Result<void, OutputFault>>()> close;

  /** `text` and a newline. */
  Ticket<Result<void, OutputFault>> line(const this, string text) { return this.write((text + "\n").toBytes()); }
}

/** Somewhere this program reads: its input, a file opened to read, or a child's output. */
export struct Input {
  /** The next bytes, or the end (`§wac-std-input-u7m2rjd`). Never `Read.Failed`: a failure is the `Err`. */
  fn<Ticket<Result<Read, HostFault>>()> chunk;
  /** Everything up to the end. */
  fn<Ticket<Result<u8[], HostFault>>()> readAll;
  /** Done reading: a file's handle goes back to the host. This program's input and a child's output need nothing. */
  fn<Ticket<Result<void, HostFault>>()> close;
}

/**
 * A write to one of this program's two streams. **The host answers it before `request` returns** — the reason a
 * write failed comes back in the same call (design/system/0013, settled before step 5) — so the ticket is
 * settled when this returns, which is what lets a program ignore a write to stderr.
 */
Ticket<Result<void, OutputFault>> hostWrite(__WacHost host, bool toErr, u8[] bytes) {
  return hostAsk(host, toErr ? OP_WRITE_STDERR() : OP_WRITE_STDOUT(), 0 as i64, 0 as i64, "", bytes,
                  toErr ? wroteErrOf : wroteOutOf);
}

Result<void, OutputFault> wroteOutOf(Answer a) { return wroteOf(a, "the output's reader has gone"); }
Result<void, OutputFault> wroteErrOf(Answer a) { return wroteOf(a, "the diagnostic output's reader has gone"); }

Result<void, OutputFault> wroteOf(Answer a, string gone) {
  if (a.fault == FAULT_NONE()) { return Result.Ok(); }
  // A reader that has gone is the host's empty sentence; anything else is its own words.
  if (a.fault == WIRE_OUTPUT_CLOSED || a.text == "") { return Result.Err(OutputClosed(a.text == "" ? gone : a.text)); }
  return Result.Err(outputFault(a.fault, a.text));
}

/** A chunk of a stream: `flags` 1 is its end. */
Result<Read, HostFault> readOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(hostFaultOf(a.fault, a.text)); }
  if (a.flags == 1) { return Result.Ok(Read.End); }
  return Result.Ok(Read.Data(a.bytes));
}

Ticket<Result<Read, HostFault>> hostChunk(__WacHost host) {
  return hostAsk(host, OP_READ_CHUNK(), 0 as i64, 0 as i64, "", u8[](), readOf);
}

Result<u8[], HostFault> allOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(hostFaultOf(a.fault, a.text)); }
  return Result.Ok(a.bytes);
}

Ticket<Result<u8[], HostFault>> hostReadAll(__WacHost host) {
  return hostAsk(host, OP_READ_STDIN(), 0 as i64, 0 as i64, "", u8[](), allOf);
}

async Result<void, HostFault> nothingToClose() { return Result.Ok(); }

Result<void, OutputFault> outputClosedOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(outputFault(a.fault, a.text)); }
  return Result.Ok();
}

// ── Time, randomness, the environment ────────────────────────────────────────────────────────────

/** The clocks (spec ch44 `§wac-std-time-mzn6gvc`). Needs no grant. */
export struct Clock {
  __WacHost host;

  /** Wall-clock time, in milliseconds since the epoch. */
  Ticket<Result<i64, union<Unsupported>>> nowMillis(const this) { return hostAsk(this.host, OP_NOW_MILLIS(), 0 as i64, 0 as i64, "", u8[](), timeOf); }
  /** Nanoseconds from an arbitrary origin, never decreasing within a run. */
  Ticket<Result<i64, union<Unsupported>>> monotonicNanos(const this) {
    return hostAsk(this.host, OP_MONOTONIC_NANOS(), 0 as i64, 0 as i64, "", u8[](), timeOf);
  }
  /** Settles after at least `ms` milliseconds. */
  Ticket<Result<void, union<Unsupported>>> sleepMillis(const this, i32 ms) {
    return hostAsk(this.host, OP_SLEEP_MILLIS(), ms as i64, 0 as i64, "", u8[](), sleptOf);
  }

  /**
   * What `t` answers, or `TimedOut` when it has not answered within `millis` (spec ch44
   * `§wac-std-within-8mdio9r`) — a negative `millis` sets no deadline. Whichever loses is cancelled here, so a
   * deadline never leaves the host holding a slot. `Unsupported` is a capability's already, so the error is
   * `t`'s with `TimedOut` beside it.
   */
  Ticket<Result<A, union<E, TimedOut, Unsupported>>> within<A, E>(this, Ticket<Result<A, E>> t, i32 millis) {
    // **Driven, not `async`**, as `Ticket.any` is: settled from `Ticket.first` over `t` and the timer, so it
    // builds no machine — and `parts` lets a `wait` find the host work beneath it, so a `within` inside a
    // `Ticket.any` is waited on together with the rest.
    Ticket<Result<A, union<E, TimedOut, Unsupported>>> out;
    Ticket<Result<void, union<Unsupported>>>? timer = null;
    TicketBase[] racing = [t];
    if (millis >= 0) {
      timer = this.sleepMillis(millis);
      racing = [t, timer!];
    }
    Ticket<i32> w = Ticket.first(racing);
    fn<void()> settle = () => {
      if (out.done || !w.done) { return; }
      if (w.value() == 1) {
        t.cancel();
        if (timer!.value().isErr()) { out.resolve(Result.Err(Unsupported("this host has no timer to bound a wait by"))); }
        else { out.resolve(Result.Err(TimedOut("no answer within \{millis}ms"))); }
        return;
      }
      if (timer is not null) { timer!.cancel(); }
      Result<A, union<E, TimedOut, Unsupported>> r = match (t.value()) { Ok(a): Result.Ok(a), Err(e): Result.Err(e) };
      out.resolve(r);
    };
    w.whenSettled(settle);
    TicketBase[] under = [w];
    out.parts = under;
    out.drive = () => {
      bool moved = w.advance();
      settle();
      return moved;
    };
    settle();
    return out;
  }

}

Result<i64, union<Unsupported>> timeOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(Unsupported(a.text)); }
  return Result.Ok(a.n);
}
Result<void, union<Unsupported>> sleptOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(Unsupported(a.text)); }
  return Result.Ok();
}

/** Random bytes. Needs no grant. */
export struct Random {
  __WacHost host;

  Ticket<Result<u8[], union<Unsupported>>> bytes(const this, i32 n) { return hostAsk(this.host, OP_RANDOM_BYTES(), n as i64, 0 as i64, "", u8[](), bytesOk); }
}

Result<u8[], union<Unsupported>> bytesOk(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(Unsupported(a.text)); }
  return Result.Ok(a.bytes);
}

/** The environment's variables and the directory relative paths resolve from. */
export struct Env {
  __WacHost host;

  /**
   * A variable's value, `Ok(null)` when it is not set (`§wac-std-env-unset-r4c8tqb`).
   *
   * **Not yet able to say `NotGranted`**: the hosts answer a withheld environment as an unset variable, and
   * which it was is `issues/system/0261c`, which the host half of design/system/0013 settles.
   */
  Ticket<Result<u8[]?, GrantedFault>> get(const this, string name) { return hostAsk(this.host, OP_ENV(), 0 as i64, 0 as i64, name, u8[](), envOf); }

  /** Where relative paths resolve from. */
  Ticket<Result<string, HostFault>> cwd(const this) { return hostAsk(this.host, OP_CWD(), 0 as i64, 0 as i64, "", u8[](), cwdOf); }
}

Result<u8[]?, GrantedFault> envOf(Answer a) {
  if (a.fault == FAULT_NOT_GRANTED()) { return Result.Err(NotGranted(a.text)); }
  if (a.fault != FAULT_NONE()) { return Result.Err(Other(a.text)); }
  if (a.flags == 0) { return Result.Ok(null); }
  return Result.Ok(a.bytes);
}
Result<string, HostFault> cwdOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(hostFaultOf(a.fault, a.text)); }
  return Result.Ok(a.text);
}

// ── Files ────────────────────────────────────────────────────────────────────────────────────────

/**
 * A filesystem, as a value built from functions (spec ch44 `§wac-std-files-compose-h6vq3ne`).
 *
 * A backing is a constructor: the host's own, `readOnly` over any `Files`, `mounted` routing each path to the
 * mount that owns it — and, outside std, `packages/fs`'s trees held in memory, generated `/proc` and `/dev`,
 * and images. Each operation is a field, so a backing supplies exactly the functions and nothing branches on
 * which backing it is.
 */
export struct Files {
  fn<Ticket<Result<u8[], ReadFault>>(string)> readFile;
  fn<Ticket<Result<void, WriteFault>>(string, u8[])> writeFile;
  /** The file to read a piece at a time; `close` it when done. */
  fn<Ticket<Result<Input, ReadFault>>(string)> openRead;
  /** The file, created or emptied, to write a piece at a time; what was written is there once `close` answers. */
  fn<Ticket<Result<Output, WriteFault>>(string)> openWrite;
  /** The same, writing after what is there — created if it is not. */
  fn<Ticket<Result<Output, WriteFault>>(string)> openAppend;
  fn<Ticket<Result<Stat, LookFault>>(string)> stat;
  /** `stat` of a symbolic link itself rather than what it names. */
  fn<Ticket<Result<Stat, LookFault>>(string)> linkStat;
  fn<Ticket<Result<string[], LookFault>>(string)> readDir;
  fn<Ticket<Result<void, MkdirFault>>(string, bool)> mkdir;
  fn<Ticket<Result<void, MoveFault>>(string, bool)> remove;
  fn<Ticket<Result<void, MoveFault>>(string, string)> rename;
  fn<Ticket<Result<void, ModeFault>>(string, i32)> chmod;
  fn<Ticket<Result<void, ModeFault>>(string, bool)> setExecutable;
  /** Give a file to another owner, which is root's to do — `Unsupported` on the host, whose owners are not names. */
  fn<Ticket<Result<void, ModeFault>>(string, string)> chown;
  /**
   * The `GRANT_*` bits a spawned child can be handed instead of these files: `GRANT_READ | GRANT_WRITE` for the
   * host's own, `GRANT_READ` read-only, and 0 for anything composed, which the parent has to serve.
   */
  i32 hostGrants;
  /**
   * Who these files act as: the owner of what they create and the name each permission check is against. `""` for
   * the host's, whose owners are not names; the name for `store.asUser(name)`; and the parent's for files a parent
   * serves, which is how a spawned `whoami` knows the session it runs in.
   */
  string user;

  /** The host's filesystem, under whatever grants the host gave this program. */
  Files host(__WacHost host) {
    i64 z = 0 as i64;
    return Files(
      (string p) => hostAsk(host, OP_READ_FILE(), z, z, p, u8[](), readOfFile),
      (string p, u8[] b) => hostAsk(host, OP_WRITE_FILE(), z, z, p, b, writtenOf),
      (string p) => hostAsk(host, OP_OPEN_FILE(), OPEN_READ as i64, z, p, u8[](), (Answer o) => openedToRead(host, p, o)),
      (string p) => hostAsk(host, OP_OPEN_FILE(), OPEN_WRITE as i64, z, p, u8[](), (Answer o) => openedToWrite(host, p, o)),
      (string p) => hostAsk(host, OP_OPEN_FILE(), OPEN_APPEND as i64, z, p, u8[](), (Answer o) => openedToWrite(host, p, o)),
      (string p) => hostAsk(host, OP_STAT(), z, z, p, u8[](), (Answer o) => statOf(o, p)),
      (string p) => hostAsk(host, OP_LINK_STAT(), z, z, p, u8[](), (Answer o) => statOf(o, p)),
      (string p) => hostAsk(host, OP_READ_DIR(), z, z, p, u8[](), (Answer o) => listedOf(o, p)),
      (string p, bool parents) => hostAsk(host, OP_MKDIR(), parents ? 1 as i64 : z, z, p, u8[](), madeOf),
      (string p, bool recursive) => hostAsk(host, OP_REMOVE(), recursive ? 1 as i64 : z, z, p, u8[](), movedOf),
      (string from, string to) => hostAsk(host, OP_RENAME(), z, z, from, to.toBytes(), movedOf),
      (string p, i32 mode) => hostAsk(host, OP_CHMOD(), mode as i64, z, p, u8[](), modeOf),
      (string p, bool on) => hostAsk(host, OP_SET_EXECUTABLE(), on ? 1 as i64 : z, z, p, u8[](), modeOf),
      (string p, string owner) => hostChown(p),
      GRANT_READ | GRANT_WRITE, "");
  }

  /** The same files, every change answering `NotGranted`. */
  Files readOnly(this) {
    return Files(this.readFile, (string p, u8[] b) => refusedWrite(p), this.openRead,
                 (string p) => refusedOpen(p), (string p) => refusedOpen(p), this.stat, this.linkStat, this.readDir,
                 (string p, bool parents) => refusedMkdir(p), (string p, bool r) => refusedMove(p),
                 (string from, string to) => refusedMove(from), (string p, i32 mode) => refusedMode(p),
                 (string p, bool on) => refusedMode(p), (string p, string owner) => refusedMode(p),
                 this.hostGrants & GRANT_READ, this.user);
  }

  /**
   * The same files, every read answering `NotGranted` — what `--allow-write` without `--allow-read` holds. A
   * change still lands; what is there cannot be looked at, its existence included.
   */
  Files writeOnly(this) {
    return Files((string p) => refusedRead(p), this.writeFile, (string p) => refusedOpenRead(p), this.openWrite,
                 this.openAppend, (string p) => refusedLook(p), (string p) => refusedLook(p),
                 (string p) => refusedList(p), this.mkdir, this.remove, this.rename, this.chmod, this.setExecutable,
                 this.chown, this.hostGrants & GRANT_WRITE, this.user);
  }

  /**
   * The same files, a relative path starting at `dir` — a shell's current directory. `.` and `..` are taken out
   * before the path goes on, and an absolute path goes on as it is. A child handed this is told `dir` when it is
   * spawned, so the host's grants carry over.
   */
  Files relativeTo(this, string dir) {
    Files f = this;
    return Files(
      (string p) => f.readFile(pathFrom(dir, p)),
      (string p, u8[] b) => f.writeFile(pathFrom(dir, p), b),
      (string p) => f.openRead(pathFrom(dir, p)),
      (string p) => f.openWrite(pathFrom(dir, p)),
      (string p) => f.openAppend(pathFrom(dir, p)),
      (string p) => f.stat(pathFrom(dir, p)),
      (string p) => f.linkStat(pathFrom(dir, p)),
      (string p) => f.readDir(pathFrom(dir, p)),
      (string p, bool parents) => f.mkdir(pathFrom(dir, p), parents),
      (string p, bool r) => f.remove(pathFrom(dir, p), r),
      (string from, string to) => f.rename(pathFrom(dir, from), pathFrom(dir, to)),
      (string p, i32 mode) => f.chmod(pathFrom(dir, p), mode),
      (string p, bool on) => f.setExecutable(pathFrom(dir, p), on),
      (string p, string owner) => f.chown(pathFrom(dir, p), owner),
      f.hostGrants, f.user);
  }

  /**
   * Each path to the mount whose `at` is its longest prefix, with that prefix taken off — `/` mounted last is
   * everything else. A rename across two mounts is `Other`, as a rename across two devices is. A listing has the
   * mount points directly under it among its names, as a directory holding a mount point does. The user is the
   * root mount's, `""` when nothing is mounted at `/`.
   */
  Files mounted(Mount[] mounts) {
    return Files(
      (string p) => mountOf(mounts, p).files.readFile(innerOf(mounts, p)),
      (string p, u8[] b) => mountOf(mounts, p).files.writeFile(innerOf(mounts, p), b),
      (string p) => mountOf(mounts, p).files.openRead(innerOf(mounts, p)),
      (string p) => mountOf(mounts, p).files.openWrite(innerOf(mounts, p)),
      (string p) => mountOf(mounts, p).files.openAppend(innerOf(mounts, p)),
      (string p) => mountOf(mounts, p).files.stat(innerOf(mounts, p)),
      (string p) => mountOf(mounts, p).files.linkStat(innerOf(mounts, p)),
      (string p) => mountedReadDir(mounts, p),
      (string p, bool parents) => mountOf(mounts, p).files.mkdir(innerOf(mounts, p), parents),
      (string p, bool r) => mountOf(mounts, p).files.remove(innerOf(mounts, p), r),
      (string from, string to) => mountedRename(mounts, from, to),
      (string p, i32 mode) => mountOf(mounts, p).files.chmod(innerOf(mounts, p), mode),
      (string p, bool on) => mountOf(mounts, p).files.setExecutable(innerOf(mounts, p), on),
      (string p, string owner) => mountOf(mounts, p).files.chown(innerOf(mounts, p), owner),
      0, rootUser(mounts));
  }
}

/** One mount of `Files.mounted`: `files` answers every path under `at`. */
export struct Mount {
  string at;
  Files files;
}

/** The user of the mount at `/`, or `""`. */
string rootUser(Mount[] mounts) {
  for (i32 i = 0; i < mounts.len(); i++) {
    if (mounts[i].at == "/" || mounts[i].at == "") { return mounts[i].files.user; }
  }
  return "";
}

/** `p` from `dir`: as it is when absolute, else after `dir`, with `.` and `..` taken out either way. */
string pathFrom(string dir, string p) {
  if (p.len() > 0 && p.slice(0, 1) == "/") { return normalPath(p); }
  if (p == "") { return normalPath(dir); }
  return normalPath(dir + "/" + p);
}

/**
 * `p` without `.`, `..` or repeated slashes. An absolute path stays absolute and `..` stops at its root; a relative
 * one keeps the `..`s it starts with, so the view beneath can resolve them.
 */
string normalPath(string p) {
  bool absolute = p.len() > 0 && p.slice(0, 1) == "/";
  string[] parts = pathParts(p);
  string[] kept = string[].filled(parts.len(), "");
  i32 n = 0;
  for (i32 i = 0; i < parts.len(); i++) {
    string part = parts[i];
    if (part == ".") { continue; }
    if (part == "..") {
      if (n > 0 && kept[n - 1] != "..") { n = n - 1; continue; }
      if (absolute) { continue; }
    }
    kept[n] = part;
    n = n + 1;
  }
  string out = absolute ? "/" : "";
  for (i32 i = 0; i < n; i++) { out = out + (i > 0 ? "/" : "") + kept[i]; }
  return out == "" ? "." : out;
}

/** The non-empty components of a path. */
string[] pathParts(string p) {
  i32 count = 0;
  i32 from = 0;
  for (i32 i = 0; i <= p.len(); i++) {
    if (i < p.len() && p.slice(i, i + 1) != "/") { continue; }
    if (i > from) { count = count + 1; }
    from = i + 1;
  }
  string[] out = string[].filled(count, "");
  i32 k = 0;
  from = 0;
  for (i32 i = 0; i <= p.len(); i++) {
    if (i < p.len() && p.slice(i, i + 1) != "/") { continue; }
    if (i > from) {
      out[k] = p.slice(from, i);
      k = k + 1;
    }
    from = i + 1;
  }
  return out;
}

// ── A store in memory ────────────────────────────────────────────────────────────────────────────

/**
 * One file or directory in a `MemoryStore`, as `entries` lists it and `restore` takes it back — a directory's
 * entry comes before anything in it.
 */
export struct StoreEntry {
  /** Absolute; the root is `/`. */
  string path;
  bool isDir;
  /** A file's bytes; empty for a directory. */
  u8[] data;
  i32 mode;
  string owner;
  i64 modifiedMillis;
}

/** A node of the store: a directory's names, or a file's bytes, and who may do what to it. */
struct StoreNode {
  bool isDir;
  Map<string, i32> names;
  Buf data;
  i32 mode;
  string owner;
  i64 mtime;

  void setMode(this, i32 mode) { this.mode = mode; }
  void setOwner(this, string owner) { this.owner = owner; }
  void replace(this, u8[] b, i64 now) {
    this.data = Buf.create();
    this.data.pushAll(b);
    this.mtime = now;
  }
  void append(this, u8[] b, i64 now) {
    this.data.pushAll(b);
    this.mtime = now;
  }
  void touch(this, i64 now) { this.mtime = now; }
}

/**
 * **Files that live in this program's memory, with owners** (spec ch44 `§wac-std-memory-store-p4k7wzn`).
 *
 * One tree, and `asUser` a `Files` acting as one person on it: what that view creates is theirs, and every
 * operation is checked against the mode for them — owner bits for the owner, the last three for everybody
 * else, and no groups, because there is no group table. `"root"` is exempt. What is checked is the file or
 * directory touched, not the directories on the way to it.
 *
 * The clock stamps each change, and a host with no clock stamps 0.
 */
export struct MemoryStore {
  /** Every node ever made, the root first; a removed one is left unreachable rather than moved. */
  Vec<StoreNode> nodes;
  Clock clock;

  /** An empty store: a root directory, `0755`, owned by root. */
  MemoryStore create(Clock clock) {
    Vec<StoreNode> nodes = Vec.create();
    nodes.push(storeDir("root", 0 as i64));
    return MemoryStore(nodes, clock);
  }

  /**
   * A store holding `entries` — what `entries` gave, or the same shape from an image. `Err` when an entry's
   * directory is not before it, when a path comes twice, or when the first entry is not the root directory.
   */
  Result<MemoryStore, Other> restore(Clock clock, StoreEntry[] entries) {
    if (entries.len() == 0 || normalPath(entries[0].path) != "/" || !entries[0].isDir) {
      return Result.Err(Other("the first entry must be the root directory"));
    }
    Vec<StoreNode> nodes = Vec.create();
    MemoryStore store = MemoryStore(nodes, clock);
    nodes.push(StoreNode(true, Map.create(hashString, stringEq), Buf.create(), entries[0].mode, entries[0].owner,
                         entries[0].modifiedMillis));
    for (i32 i = 1; i < entries.len(); i++) {
      StoreEntry e = entries[i];
      string p = normalPath(e.path);
      i32 parent = store.find(storeParent(p));
      if (parent < 0 || !nodes.get(parent).isDir) {
        return Result.Err(Other(p + ": its directory is not before it"));
      }
      if (nodes.get(parent).names.has(storeBase(p))) { return Result.Err(Other(p + ": listed twice")); }
      Buf held = Buf.create();
      if (!e.isDir) { held.pushAll(e.data); }
      nodes.push(StoreNode(e.isDir, Map.create(hashString, stringEq), held, e.mode, e.owner, e.modifiedMillis));
      nodes.get(parent).names.set(storeBase(p), nodes.len() - 1);
    }
    return Result.Ok(store);
  }

  /** Every file and directory, each directory before what is in it and names in byte order — what `restore` takes. */
  StoreEntry[] entries(this) {
    Vec<StoreEntry> out = Vec.create();
    this.listInto(out, 0, "/");
    StoreEntry[] all = StoreEntry[].filled(out.len(), StoreEntry("", false, u8[](), 0, "", 0 as i64));
    for (i32 i = 0; i < out.len(); i++) { all[i] = out.get(i); }
    return all;
  }

  void listInto(this, Vec<StoreEntry> out, i32 node, string path) {
    StoreNode n = this.nodes.get(node);
    out.push(StoreEntry(path, n.isDir, n.isDir ? u8[]() : n.data.bytes(), n.mode, n.owner, n.mtime));
    if (!n.isDir) { return; }
    string[] names = sortedNames(n.names.keys());
    for (i32 i = 0; i < names.len(); i++) {
      this.listInto(out, n.names.getOr(names[i], 0), (path == "/" ? "/" : path + "/") + names[i]);
    }
  }

  /** This store as `user` sees it. A relative path is from the root; `relativeTo` gives it somewhere else to start. */
  Files asUser(this, string user) {
    MemoryStore st = this;
    return Files(
      (string p) => memRead(st, user, p),
      (string p, u8[] b) => memWrite(st, user, p, b),
      (string p) => memOpenRead(st, user, p),
      (string p) => memOpenWrite(st, user, p, true),
      (string p) => memOpenWrite(st, user, p, false),
      (string p) => memStat(st, p),
      (string p) => memStat(st, p),
      (string p) => memReadDir(st, user, p),
      (string p, bool parents) => memMkdir(st, user, p, parents),
      (string p, bool r) => memRemove(st, user, p, r),
      (string from, string to) => memRename(st, user, from, to),
      (string p, i32 mode) => memChmod(st, user, p, mode),
      (string p, bool on) => memSetExecutable(st, user, p, on),
      (string p, string owner) => memChown(st, user, p, owner),
      0, user);
  }

  /** The node at an absolute normal path, or `STORE_NONE` / `STORE_NOT_A_DIR`. */
  i32 find(const this, string p) {
    string[] parts = pathParts(p);
    i32 at = 0;
    for (i32 i = 0; i < parts.len(); i++) {
      if (!this.nodes.get(at).isDir) { return STORE_NOT_A_DIR; }
      i32 next = this.nodes.get(at).names.getOr(parts[i], 0 - 1);
      if (next < 0) { return STORE_NONE; }
      at = next;
    }
    return at;
  }

  /** Whether `user` may do `want` — 4 read, 2 write, 1 execute — to a node. */
  bool may(const this, string user, i32 node, i32 want) {
    if (user == "root") { return true; }
    const StoreNode n = this.nodes.get(node);
    i32 bits = n.owner == user ? (n.mode >> 6) & 7 : n.mode & 7;
    return (bits & want) == want;
  }
}

static i32 STORE_NONE = 0 - 1;
static i32 STORE_NOT_A_DIR = 0 - 2;

StoreNode storeDir(string owner, i64 now) {
  return StoreNode(true, Map.create(hashString, stringEq), Buf.create(), 493, owner, now);   // 0755
}

StoreNode storeFile(string owner, i64 now) {
  return StoreNode(false, Map.create(hashString, stringEq), Buf.create(), 420, owner, now);  // 0644
}

/** The directory above an absolute normal path: `/a/b` gives `/a`, and `/a` gives `/`. */
string storeParent(string p) {
  i32 cut = 0;
  for (i32 i = 0; i < p.len(); i++) { if (p.slice(i, i + 1) == "/") { cut = i; } }
  return cut == 0 ? "/" : p.slice(0, cut);
}

/** The last component: `/a/b` gives `b`, and `/` gives `""`. */
string storeBase(string p) {
  i32 cut = 0;
  for (i32 i = 0; i < p.len(); i++) { if (p.slice(i, i + 1) == "/") { cut = i; } }
  return p.slice(cut + 1, p.len());
}

/** The names, sorted by their bytes. */
string[] sortedNames(string[] names) {
  for (i32 i = 1; i < names.len(); i++) {
    string v = names[i];
    i32 j = i - 1;
    while (j >= 0 && bytesAfter(names[j], v)) {
      names[j + 1] = names[j];
      j = j - 1;
    }
    names[j + 1] = v;
  }
  return names;
}

bool bytesAfter(string a, string b) {
  u8[] x = a.toBytes();
  u8[] y = b.toBytes();
  i32 n = x.len() < y.len() ? x.len() : y.len();
  for (i32 i = 0; i < n; i++) {
    if (x[i] != y[i]) { return x[i] > y[i]; }
  }
  return x.len() > y.len();
}

async i64 storeNow(Clock clock) {
  match (await clock.nowMillis()) {
    Ok(t): { return t; }
    Err(e): { return 0 as i64; }
  }
}

string noSuchFile(string p) { return p + ": No such file or directory"; }
string notADirectory(string p) { return p + ": Not a directory"; }
string permissionDenied(string p) { return p + ": Permission denied"; }
string notPermitted(string p) { return p + ": Operation not permitted"; }

async Result<u8[], ReadFault> memRead(MemoryStore st, string user, string path) {
  string p = normalPath("/" + path);
  i32 node = st.find(p);
  if (node == STORE_NOT_A_DIR) { return Result.Err(NotADir(notADirectory(p))); }
  if (node < 0) { return Result.Err(NotFound(noSuchFile(p))); }
  if (st.nodes.get(node).isDir) { return Result.Err(IsDir(p + ": Is a directory")); }
  if (!st.may(user, node, 4)) { return Result.Err(Denied(permissionDenied(p))); }
  return Result.Ok(st.nodes.get(node).data.bytes());
}

/**
 * The file a write goes to — made, owned by `user`, when it is not there — or why not. `empty` truncates an
 * existing one, as `writeFile` and `openWrite` do and `openAppend` does not.
 */
async Result<i32, WriteFault> memFileToWrite(MemoryStore st, string user, string p, bool empty) {
  i32 parent = st.find(storeParent(p));
  if (parent == STORE_NOT_A_DIR) { return Result.Err(NotADir(notADirectory(p))); }
  if (parent < 0) { return Result.Err(NotFound(noSuchFile(p))); }
  if (!st.nodes.get(parent).isDir) { return Result.Err(NotADir(notADirectory(p))); }
  i64 now = await storeNow(st.clock);
  i32 existing = p == "/" ? 0 : st.nodes.get(parent).names.getOr(storeBase(p), 0 - 1);
  if (existing >= 0) {
    if (st.nodes.get(existing).isDir) { return Result.Err(IsDir(p + ": Is a directory")); }
    if (!st.may(user, existing, 2)) { return Result.Err(Denied(permissionDenied(p))); }
    if (empty) { st.nodes.get(existing).replace(u8[](), now); }
    return Result.Ok(existing);
  }
  if (!st.may(user, parent, 2)) { return Result.Err(Denied(permissionDenied(p))); }
  st.nodes.push(storeFile(user, now));
  st.nodes.get(parent).names.set(storeBase(p), st.nodes.len() - 1);
  st.nodes.get(parent).touch(now);
  return Result.Ok(st.nodes.len() - 1);
}

async Result<void, WriteFault> memWrite(MemoryStore st, string user, string path, u8[] b) {
  string p = normalPath("/" + path);
  match (await memFileToWrite(st, user, p, true)) {
    Ok(node): {
      st.nodes.get(node).append(b, st.nodes.get(node).mtime);
      return Result.Ok();
    }
    Err(e): { return Result.Err(e); }
  }
}

async Result<Output, WriteFault> memOpenWrite(MemoryStore st, string user, string path, bool empty) {
  string p = normalPath("/" + path);
  match (await memFileToWrite(st, user, p, empty)) {
    Ok(node): {
      bool[] shut = bool[].filled(1, false);
      return Result.Ok(Output((u8[] b) => memAppend(st, node, p, shut, b), () => memShut(shut)));
    }
    Err(e): { return Result.Err(e); }
  }
}

/** A write through an open file goes to the node it opened, wherever its name has gone since, as on a host. */
async Result<void, OutputFault> memAppend(MemoryStore st, i32 node, string p, bool[] shut, u8[] b) {
  if (shut[0]) { return Result.Err(OutputClosed(p + ": closed")); }
  i64 now = await storeNow(st.clock);
  st.nodes.get(node).append(b, now);
  return Result.Ok();
}

async Result<void, OutputFault> memShut(bool[] shut) {
  shut[0] = true;
  return Result.Ok();
}

async Result<Input, ReadFault> memOpenRead(MemoryStore st, string user, string path) {
  match (await memRead(st, user, path)) {
    Ok(b): {
      bool[] state = bool[].filled(2, false);
      return Result.Ok(Input(() => memChunk(b, state), () => memRest(b, state), () => memShutRead(state)));
    }
    Err(e): { return Result.Err(e); }
  }
}

/**
 * What was in the file when it was opened, in one piece and then the end. `state` is whether that piece has gone
 * and whether the file was closed.
 */
async Result<Read, HostFault> memChunk(u8[] b, bool[] state) {
  if (state[1]) { return Result.Err(Other("read after close")); }
  if (state[0] || b.len() == 0) { return Result.Ok(Read.End); }
  state[0] = true;
  return Result.Ok(Read.Data(b));
}

async Result<u8[], HostFault> memRest(u8[] b, bool[] state) {
  if (state[1]) { return Result.Err(Other("read after close")); }
  bool gone = state[0];
  state[0] = true;
  return Result.Ok(gone ? u8[]() : b);
}

async Result<void, HostFault> memShutRead(bool[] state) {
  state[1] = true;
  return Result.Ok();
}

async Result<Stat, LookFault> memStat(MemoryStore st, string path) {
  string p = normalPath("/" + path);
  i32 node = st.find(p);
  if (node == STORE_NOT_A_DIR) { return Result.Err(NotADir(notADirectory(p))); }
  if (node < 0) { return Result.Err(NotFound(noSuchFile(p))); }
  StoreNode n = st.nodes.get(node);
  return Result.Ok(Stat(true, !n.isDir, n.isDir, n.data.len as i64, n.mtime, false, (n.mode & 64) != 0, FAULT_NONE(),
                        n.mode, n.owner));
}

async Result<string[], LookFault> memReadDir(MemoryStore st, string user, string path) {
  string p = normalPath("/" + path);
  i32 node = st.find(p);
  if (node == STORE_NOT_A_DIR) { return Result.Err(NotADir(notADirectory(p))); }
  if (node < 0) { return Result.Err(NotFound(noSuchFile(p))); }
  if (!st.nodes.get(node).isDir) { return Result.Err(NotADir(notADirectory(p))); }
  if (!st.may(user, node, 4)) { return Result.Err(Denied(permissionDenied(p))); }
  return Result.Ok(sortedNames(st.nodes.get(node).names.keys()));
}

async Result<void, MkdirFault> memMkdir(MemoryStore st, string user, string path, bool parents) {
  string p = normalPath("/" + path);
  i64 now = await storeNow(st.clock);
  string[] parts = pathParts(p);
  i32 at = 0;
  for (i32 i = 0; i < parts.len(); i++) {
    bool last = i == parts.len() - 1;
    i32 next = st.nodes.get(at).names.getOr(parts[i], 0 - 1);
    if (next >= 0) {
      if (!st.nodes.get(next).isDir) {
        if (last) { return Result.Err(Exists(p + ": File exists")); }
        return Result.Err(NotADir(notADirectory(p)));
      }
      if (last && !parents) { return Result.Err(Exists(p + ": File exists")); }
      at = next;
      continue;
    }
    if (!last && !parents) { return Result.Err(NotFound(noSuchFile(p))); }
    if (!st.may(user, at, 2)) { return Result.Err(Denied(permissionDenied(p))); }
    st.nodes.push(storeDir(user, now));
    st.nodes.get(at).names.set(parts[i], st.nodes.len() - 1);
    st.nodes.get(at).touch(now);
    at = st.nodes.len() - 1;
  }
  if (parts.len() == 0 && !parents) { return Result.Err(Exists("/: File exists")); }
  return Result.Ok();
}

async Result<void, MoveFault> memRemove(MemoryStore st, string user, string path, bool recursive) {
  string p = normalPath("/" + path);
  if (p == "/") { return Result.Err(Denied("/: the root cannot be removed")); }
  i32 parent = st.find(storeParent(p));
  if (parent == STORE_NOT_A_DIR) { return Result.Err(NotADir(notADirectory(p))); }
  if (parent < 0) { return Result.Err(NotFound(noSuchFile(p))); }
  if (!st.nodes.get(parent).isDir) { return Result.Err(NotADir(notADirectory(p))); }
  i32 node = st.nodes.get(parent).names.getOr(storeBase(p), 0 - 1);
  if (node < 0) { return Result.Err(NotFound(noSuchFile(p))); }
  if (st.nodes.get(node).isDir && st.nodes.get(node).names.len() > 0 && !recursive) {
    return Result.Err(NotEmpty(p + ": Directory not empty"));
  }
  if (!st.may(user, parent, 2)) { return Result.Err(Denied(permissionDenied(p))); }
  i64 now = await storeNow(st.clock);
  st.nodes.get(parent).names.remove(storeBase(p));
  st.nodes.get(parent).touch(now);
  return Result.Ok();
}

async Result<void, MoveFault> memRename(MemoryStore st, string user, string fromPath, string toPath) {
  string from = normalPath("/" + fromPath);
  string to = normalPath("/" + toPath);
  if (from == "/" || to == "/") { return Result.Err(Denied("/: the root cannot be moved")); }
  i32 fromParent = st.find(storeParent(from));
  if (fromParent < 0 || !st.nodes.get(fromParent).isDir) {
    return fromParent == STORE_NONE ? Result.Err(NotFound(noSuchFile(from))) : Result.Err(NotADir(notADirectory(from)));
  }
  i32 node = st.nodes.get(fromParent).names.getOr(storeBase(from), 0 - 1);
  if (node < 0) { return Result.Err(NotFound(noSuchFile(from))); }
  i32 toParent = st.find(storeParent(to));
  if (toParent < 0 || !st.nodes.get(toParent).isDir) {
    return toParent == STORE_NONE ? Result.Err(NotFound(noSuchFile(to))) : Result.Err(NotADir(notADirectory(to)));
  }
  if (to.len() > from.len() && to.slice(0, from.len() + 1) == from + "/") {
    return Result.Err(Other(to + ": a directory cannot move inside itself"));
  }
  i32 existing = st.nodes.get(toParent).names.getOr(storeBase(to), 0 - 1);
  if (existing >= 0 && existing != node) {
    bool fromDir = st.nodes.get(node).isDir;
    bool toDir = st.nodes.get(existing).isDir;
    if (!fromDir && toDir) { return Result.Err(IsDir(to + ": Is a directory")); }
    if (fromDir && !toDir) { return Result.Err(NotADir(notADirectory(to))); }
    if (toDir && st.nodes.get(existing).names.len() > 0) { return Result.Err(NotEmpty(to + ": Directory not empty")); }
  }
  if (!st.may(user, fromParent, 2) || !st.may(user, toParent, 2)) { return Result.Err(Denied(permissionDenied(from))); }
  i64 now = await storeNow(st.clock);
  st.nodes.get(fromParent).names.remove(storeBase(from));
  st.nodes.get(toParent).names.set(storeBase(to), node);
  st.nodes.get(fromParent).touch(now);
  st.nodes.get(toParent).touch(now);
  return Result.Ok();
}

/** The node whose mode or owner is changing, when `user` may change it: its owner, or root. */
Result<i32, ModeFault> memOwned(MemoryStore st, string user, string p) {
  i32 node = st.find(p);
  if (node == STORE_NOT_A_DIR) { return Result.Err(NotADir(notADirectory(p))); }
  if (node < 0) { return Result.Err(NotFound(noSuchFile(p))); }
  if (user != "root" && st.nodes.get(node).owner != user) { return Result.Err(Denied(notPermitted(p))); }
  return Result.Ok(node);
}

async Result<void, ModeFault> memChmod(MemoryStore st, string user, string path, i32 mode) {
  match (memOwned(st, user, normalPath("/" + path))) {
    Ok(node): {
      st.nodes.get(node).setMode(mode & 4095);
      return Result.Ok();
    }
    Err(e): { return Result.Err(e); }
  }
}

/** The three execute bits move together, following read as `chmod +x` does: `0640` becomes `0750`. */
async Result<void, ModeFault> memSetExecutable(MemoryStore st, string user, string path, bool on) {
  match (memOwned(st, user, normalPath("/" + path))) {
    Ok(node): {
      i32 mode = st.nodes.get(node).mode;
      st.nodes.get(node).setMode(on ? mode | ((mode & 292) >> 2) : mode & ~73);
      return Result.Ok();
    }
    Err(e): { return Result.Err(e); }
  }
}

/** Root's alone: a user who could give files away could hide one behind somebody else's name. */
async Result<void, ModeFault> memChown(MemoryStore st, string user, string path, string owner) {
  string p = normalPath("/" + path);
  if (user != "root") { return Result.Err(Denied(notPermitted(p))); }
  match (memOwned(st, user, p)) {
    Ok(node): {
      st.nodes.get(node).setOwner(owner);
      return Result.Ok();
    }
    Err(e): { return Result.Err(e); }
  }
}

/** The mount owning `p`: the longest `at` that prefixes it at a path boundary. A table with no `/` and no match traps. */
Mount mountOf(Mount[] mounts, string p) {
  i32 best = 0 - 1;
  for (i32 i = 0; i < mounts.len(); i++) {
    string at = mounts[i].at;
    bool under = at == "/" || p == at || (p.len() > at.len() && p.slice(0, at.len()) == at && p.slice(at.len(), at.len() + 1) == "/");
    if (under && (best < 0 || at.len() > mounts[best].at.len())) { best = i; }
  }
  if (best < 0) { trap "no mount answers " + p; }
  return mounts[best];
}

/** `p` as the mount owning it sees it. */
string innerOf(Mount[] mounts, string p) {
  string at = mountOf(mounts, p).at;
  if (at == "/") { return p; }
  string rest = p.slice(at.len(), p.len());
  return rest == "" ? "/" : rest;
}

/** What the mount owning `p` lists there, with the mounts directly under `p` added — sorted, each name once. */
async Result<string[], LookFault> mountedReadDir(Mount[] mounts, string p) {
  string dir = p != "/" && p.len() > 1 && p.slice(p.len() - 1, p.len()) == "/" ? p.slice(0, p.len() - 1) : p;
  string prefix = dir == "/" ? "/" : dir + "/";
  Vec<string> extra = Vec.create();
  for (Mount m in mounts) {
    string at = m.at;
    if (at == "/" || at.len() <= prefix.len() || at.slice(0, prefix.len()) != prefix) { continue; }
    string rest = at.slice(prefix.len(), at.len());
    if (rest.indexOf("/") < 0) { extra.push(rest); }
  }
  string[] own = string[]();
  match (await mountOf(mounts, dir).files.readDir(innerOf(mounts, dir))) {
    Ok(names): { own = names; }
    // A directory that exists only because something is mounted under it lists its mount points.
    Err(e): { if (extra.len() == 0) { return Result.Err(e); } }
  }
  Vec<string> all = Vec.fromArray(own);
  for (i32 i = 0; i < extra.len(); i++) {
    bool seen = false;
    for (i32 k = 0; k < own.len(); k++) { if (own[k] == extra.get(i)) { seen = true; } }
    if (!seen) { all.push(extra.get(i)); }
  }
  return Result.Ok(sortedNames(all.toArray()));
}

async Result<void, MoveFault> mountedRename(Mount[] mounts, string from, string to) {
  if (mountOf(mounts, from).at != mountOf(mounts, to).at) {
    return Result.Err(Other("cannot rename " + from + " to " + to + ": they are on different mounts"));
  }
  return await mountOf(mounts, from).files.rename(innerOf(mounts, from), innerOf(mounts, to));
}

async Result<u8[], ReadFault> refusedRead(string p) { return Result.Err(NotGranted(p + ": write-only")); }
async Result<Input, ReadFault> refusedOpenRead(string p) { return Result.Err(NotGranted(p + ": write-only")); }
async Result<Stat, LookFault> refusedLook(string p) { return Result.Err(NotGranted(p + ": write-only")); }
async Result<string[], LookFault> refusedList(string p) { return Result.Err(NotGranted(p + ": write-only")); }
async Result<void, WriteFault> refusedWrite(string p) { return Result.Err(NotGranted(p + ": read-only")); }
async Result<Output, WriteFault> refusedOpen(string p) { return Result.Err(NotGranted(p + ": read-only")); }
async Result<void, MkdirFault> refusedMkdir(string p) { return Result.Err(NotGranted(p + ": read-only")); }
async Result<void, MoveFault> refusedMove(string p) { return Result.Err(NotGranted(p + ": read-only")); }
async Result<void, ModeFault> refusedMode(string p) { return Result.Err(NotGranted(p + ": read-only")); }
async Result<void, ModeFault> hostChown(string p) {
  return Result.Err(Unsupported(p + ": the host's owners are not names, so a file cannot be given to one"));
}

Result<u8[], ReadFault> readOfFile(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(readFault(a.fault, a.text)); }
  return Result.Ok(a.bytes);
}

/** A stream on a handle the host opened: chunks by `OP_RECV`, all of it by reading to the end. */
Input handleInput(__WacHost host, i32 h, fn<Ticket<Result<void, HostFault>>()> close) {
  return Input(() => hostAsk(host, OP_RECV(), h as i64, 0 as i64, "", u8[](), readOf), () => streamAll(host, h), close);
}

Result<Input, ReadFault> openedToRead(__WacHost host, string p, Answer o) {
  if (o.fault != FAULT_NONE()) { return Result.Err(readFault(o.fault, o.text)); }
  i32 h = o.n as~ i32;
  bool[] shut = bool[].filled(1, false);
  return Result.Ok(handleInput(host, h, () => closeReadOnce(host, h, p, shut)));
}

/** Closing twice is not an error (`§wac-std-close-r4v8ndq`), so the second asks the host nothing. */
Ticket<Result<void, HostFault>> closeReadOnce(__WacHost host, i32 h, string p, bool[] shut) {
  if (shut[0]) { return nothingToClose(); }
  shut[0] = true;
  return hostAsk(host, OP_CLOSE_FILE(), h as i64, 0 as i64, "", u8[](), (Answer o) => readClosedOf(o, p));
}

Result<void, HostFault> readClosedOf(Answer o, string p) {
  if (o.fault != FAULT_NONE()) { return Result.Err(Other(o.text == "" ? p + ": was not open" : o.text)); }
  return Result.Ok();
}

/** A write to a file the host opened, which answers its reason in the same call. */
Result<Output, WriteFault> openedToWrite(__WacHost host, string p, Answer o) {
  if (o.fault != FAULT_NONE()) { return Result.Err(writeFault(o.fault, o.text)); }
  i32 h = o.n as~ i32;
  bool[] shut = bool[].filled(1, false);
  return Result.Ok(Output((u8[] b) => writeUnlessClosed(host, h, p, shut, b), () => closeWriteOnce(host, h, p, shut)));
}

Ticket<Result<void, OutputFault>> writeUnlessClosed(__WacHost host, i32 h, string p, bool[] shut, u8[] b) {
  if (shut[0]) { return writeAfterClose(p); }
  return hostAsk(host, OP_SEND(), h as i64, 0 as i64, "", b, (Answer o) => fileWrittenOf(o, p));
}

/** A write after `close` is `OutputClosed` (`§wac-std-close-r4v8ndq`): the handle is the host's again. */
async Result<void, OutputFault> writeAfterClose(string p) { return Result.Err(OutputClosed(p + ": closed")); }

async Result<void, OutputFault> closedAlready() { return Result.Ok(); }

Ticket<Result<void, OutputFault>> closeWriteOnce(__WacHost host, i32 h, string p, bool[] shut) {
  if (shut[0]) { return closedAlready(); }
  shut[0] = true;
  return hostAsk(host, OP_CLOSE_FILE(), h as i64, 0 as i64, "", u8[](), (Answer o) => fileClosedOf(o, p));
}

Result<void, OutputFault> fileWrittenOf(Answer o, string p) {
  if (o.fault != FAULT_NONE()) { return Result.Err(outputFault(o.fault, o.text == "" ? p + ": the write failed" : o.text)); }
  return Result.Ok();
}

Result<void, OutputFault> fileClosedOf(Answer o, string p) {
  if (o.fault != FAULT_NONE()) { return Result.Err(Other(o.text == "" ? p + ": what was written could not be kept" : o.text)); }
  return Result.Ok();
}

Result<void, WriteFault> writtenOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(writeFault(a.fault, a.text)); }
  return Result.Ok();
}

/** `OP_STAT`'s `flags`: which of these the path is, with its mode bits in the high 16. */
export static i32 STAT_EXISTS = 1;
export static i32 STAT_FILE = 2;
export static i32 STAT_DIR = 4;
export static i32 STAT_LINK = 8;
export static i32 STAT_EXEC = 16;

Result<Stat, LookFault> statOf(Answer a, string p) {
  if (a.fault != FAULT_NONE()) { return Result.Err(lookFault(a.fault, a.text == "" ? p : a.text)); }
  if ((a.flags & STAT_EXISTS) == 0) { return Result.Err(NotFound(p + ": No such file or directory")); }
  return Result.Ok(Stat((a.flags & STAT_EXISTS) != 0, (a.flags & STAT_FILE) != 0, (a.flags & STAT_DIR) != 0, a.n, a.m,
                        (a.flags & STAT_LINK) != 0, (a.flags & STAT_EXEC) != 0, FAULT_NONE(), (a.flags >> 16) & 65535,
                        a.text));
}

/**
 * A directory's names, NUL-terminated in `bytes`. **The host says why a listing failed** — not a directory, not
 * there, not allowed — so this needs no second question, which the old `readDir` did (it answered null for every
 * failure and `stat` said which).
 */
Result<string[], LookFault> listedOf(Answer a, string p) {
  if (a.fault != FAULT_NONE()) { return Result.Err(lookFault(a.fault, a.text == "" ? p : a.text)); }
  return Result.Ok(nulSplit(a.bytes));
}

/** Names each followed by a NUL, as a list. */
string[] nulSplit(u8[] b) {
  i32 n = 0;
  for (i32 i = 0; i < b.len(); i++) { if (b[i] == 0) { n = n + 1; } }
  string[] out = string[].defaulted(n);
  i32 at = 0;
  i32 from = 0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] != 0) { continue; }
    u8[] name = u8[].filled(i - from, 0);
    name.copyFrom(b, from, 0, i - from);
    out[at] = string.fromBytes(name);
    at = at + 1;
    from = i + 1;
  }
  return out;
}

Result<void, MkdirFault> madeOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(mkdirFault(a.fault, a.text)); }
  return Result.Ok();
}

Result<void, MoveFault> movedOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(moveFault(a.fault, a.text)); }
  return Result.Ok();
}

Result<void, ModeFault> modeOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(modeFault(a.fault, a.text)); }
  return Result.Ok();
}

// ── Files served to a child ──────────────────────────────────────────────────────────────────────

/*
 * A child handed a composed `Files` asks its parent for each operation on the parent channel, and the parent answers out
 * of the one `Files` there is (spec ch44 `§wac-std-files-served-t5h2mzr`), so a child's writes are its parent's and
 * what it may do is what that `Files` allows. Both ends are here because both are std: a frame is a u32 length and
 * that many bytes, a question is an opcode and its arguments, and an answer is a result — 0 and the value, or 1, a
 * `FAULT_*` code and the message. The parent answers one question at a time, in the order asked, so a child's
 * questions take turns and each answer is the oldest question's.
 */

static i32 ASK_HELLO = 32;
static i32 ASK_READ_FILE = 33;
static i32 ASK_WRITE_FILE = 34;
static i32 ASK_OPEN_READ = 35;
static i32 ASK_OPEN_WRITE = 36;
static i32 ASK_OPEN_APPEND = 37;
static i32 ASK_STAT = 38;
static i32 ASK_LINK_STAT = 39;
static i32 ASK_READ_DIR = 40;
static i32 ASK_MKDIR = 41;
static i32 ASK_REMOVE = 42;
static i32 ASK_RENAME = 43;
static i32 ASK_CHMOD = 44;
static i32 ASK_SET_EXECUTABLE = 45;
static i32 ASK_CHOWN = 46;
static i32 ASK_CHUNK = 47;
static i32 ASK_READ_ALL = 48;
static i32 ASK_CLOSE_READ = 49;
static i32 ASK_WRITE = 50;
static i32 ASK_CLOSE_WRITE = 51;

/** What the parent answers `ASK_HELLO` with, so a channel speaking anything else is not mistaken for this one. */
string servedHello() { return "wac files 1"; }

/** `OutputClosed` on the wire; it has no `FAULT_*` code because no host operation answers it. */
static i32 WIRE_OUTPUT_CLOSED = 100;

/** Every fault a `Files` operation answers. */
type FilesFault = union<NotFound, Denied, Exists, NotEmpty, IsDir, NotADir, ReadOnly, NameTooLong, Loop, NoSpace,
                        NotRepresentable, NotGranted, Unsupported, OutputClosed, Other>;

i32 wireCode(FilesFault e) {
  if (e is NotFound) { return FAULT_NOT_FOUND(); }
  if (e is Denied) { return FAULT_DENIED(); }
  if (e is Exists) { return FAULT_EXISTS(); }
  if (e is NotEmpty) { return FAULT_NOT_EMPTY(); }
  if (e is IsDir) { return FAULT_IS_DIR(); }
  if (e is NotADir) { return FAULT_NOT_A_DIR(); }
  if (e is ReadOnly) { return FAULT_READ_ONLY(); }
  if (e is NameTooLong) { return FAULT_NAME_TOO_LONG(); }
  if (e is Loop) { return FAULT_LOOP(); }
  if (e is NoSpace) { return FAULT_NO_SPACE(); }
  if (e is NotRepresentable) { return FAULT_NOT_REPRESENTABLE(); }
  if (e is NotGranted) { return FAULT_NOT_GRANTED(); }
  if (e is Unsupported) { return FAULT_UNSUPPORTED(); }
  if (e is OutputClosed) { return WIRE_OUTPUT_CLOSED; }
  return FAULT_OTHER();
}

OutputFault outputFault(i32 code, string m) {
  if (code == WIRE_OUTPUT_CLOSED) { return OutputClosed(m); }
  if (code == FAULT_NO_SPACE()) { return NoSpace(m); }
  if (code == FAULT_UNSUPPORTED()) { return Unsupported(m); }
  return Other(m);
}

HostFault hostFaultOf(i32 code, string m) {
  if (code == FAULT_UNSUPPORTED()) { return Unsupported(m); }
  return Other(m);
}

void putWireString(Buf out, string s) {
  u8[] b = s.toBytes();
  out.pushU32(b.len() as@ u32);
  out.pushAll(b);
}

void putWireBytes(Buf out, u8[] b) {
  out.pushU32(b.len() as@ u32);
  out.pushAll(b);
}

void putWireI64(Buf out, i64 v) {
  for (i32 i = 0; i < 8; i++) { out.push((((v >> (i * 8)) & 255 as i64) as! i32) as@ u8); }
}

void putFault(Buf out, FilesFault e) {
  out.push(1);
  out.pushU32(wireCode(e) as@ u32);
  putWireString(out, "\{e}");
}

void putStat(Buf out, Stat s) {
  out.push(s.exists ? 1 : 0);
  out.push(s.isFile ? 1 : 0);
  out.push(s.isDir ? 1 : 0);
  putWireI64(out, s.size);
  putWireI64(out, s.modifiedMillis);
  out.push(s.isSymlink ? 1 : 0);
  out.push(s.isExecutable ? 1 : 0);
  out.pushU32(s.fault as@ u32);
  out.pushU32(s.mode as@ u32);
  putWireString(out, s.owner);
}

/** A frame's body, read from the front; running off the end marks it `bad` rather than trapping. */
struct WireReader {
  u8[] data;
  i32 at;
  bool bad;
  string why;

  i32 byte(this) {
    if (this.bad || this.at >= this.data.len()) { this.bad = true; return 0; }
    i32 v = this.data[this.at] as i32;
    this.at++;
    return v;
  }

  i32 u32(this) {
    i32 a = this.byte();
    i32 b = this.byte();
    i32 c = this.byte();
    i32 d = this.byte();
    return a | (b << 8) | (c << 16) | (d << 24);
  }

  i64 i64(this) {
    i64 v = 0 as i64;
    for (i32 i = 0; i < 8; i++) { v = v | ((this.byte() as i64) << (i * 8)); }
    return v;
  }

  u8[] bytes(this) {
    i32 n = this.u32();
    if (this.bad || n < 0 || this.at + n > this.data.len()) { this.bad = true; return u8[](); }
    u8[] b = u8[].filled(n, 0);
    b.copyFrom(this.data, this.at, 0, n);
    this.at = this.at + n;
    return b;
  }

  string text(this) { return string.fromBytes(this.bytes()); }

  bool flag(this) { return this.byte() == 1; }

  Stat stat(this) {
    bool exists = this.flag();
    bool isFile = this.flag();
    bool isDir = this.flag();
    i64 size = this.i64();
    i64 mtime = this.i64();
    bool isSymlink = this.flag();
    bool isExecutable = this.flag();
    i32 fault = this.u32();
    i32 mode = this.u32();
    string owner = this.text();
    return Stat(exists, isFile, isDir, size, mtime, isSymlink, isExecutable, fault, mode, owner);
  }

  /** Whether the answer is an `Err`; `code` and `message` read the fault after it. */
  bool failed(this) { return this.byte() != 0; }
}

WireReader brokenReader(string why) { return WireReader(u8[](), 0, true, why); }

/** One end of a framed conversation on a handle. */
struct WireLine {
  __WacHost host;
  i32 handle;
  /** Bytes received and not yet a whole frame. */
  Buf held;
  bool broken;

  WireLine on(__WacHost host, i32 handle) { return WireLine(host, handle, Buf.create(), false); }

  /** Send `body` as one frame. */
  async bool put(this, Buf body) {
    if (this.broken) { return false; }
    Buf framed = Buf.create();
    framed.pushU32(body.len as@ u32);
    framed.pushAll(body.bytes());
    bool went = await lineSend(this.host, this.handle, framed.bytes());
    if (!went) { this.broken = true; }
    return went;
  }

  /** The next whole frame, reading as many chunks as it takes; `bad` when the line ended first. */
  async WireReader next(this) {
    while (!this.broken) {
      WireReader whole = this.take();
      if (!whole.bad) { return whole; }
      Read c = await lineRecv(this.host, this.handle);
      match (c) {
        Data(bytes): { this.held.pushAll(bytes); }
        End: { this.broken = true; }
        Failed(why): { this.broken = true; }
      }
    }
    return brokenReader("the parent channel has ended");
  }

  /**
   * `next`, giving up when `stop` settles first: the read in flight is withdrawn and the line is broken. What a
   * parent serving a child's files waits on, so that stopping the child also ends the serving rather than
   * leaving a read of a dead channel registered.
   */
  async WireReader nextUnless(this, TicketBase stop) {
    while (!this.broken) {
      WireReader whole = this.take();
      if (!whole.bad) { return whole; }
      Ticket<Read> got = lineRecv(this.host, this.handle);
      i32 won = await Ticket.first([got, stop]);
      if (won != 0) {
        got.cancel();
        this.broken = true;
      } else {
        match (got.value()) {
          Data(bytes): { this.held.pushAll(bytes); }
          End: { this.broken = true; }
          Failed(why): { this.broken = true; }
        }
      }
    }
    return brokenReader("the parent channel has ended");
  }

  /** The same, waiting synchronously — for the one question a program asks before it can have a scheduler running. */
  WireReader nextNow(this) {
    while (!this.broken) {
      WireReader whole = this.take();
      if (!whole.bad) { return whole; }
      Read c = lineRecv(this.host, this.handle).wait().orElse(Read.Failed("the line could not be read"));
      match (c) {
        Data(bytes): { this.held.pushAll(bytes); }
        End: { this.broken = true; }
        Failed(why): { this.broken = true; }
      }
    }
    return brokenReader("the parent channel has ended");
  }

  /** A whole frame off the front of `held`, or a `bad` reader when there is not one yet. */
  WireReader take(this) {
    if (this.held.len < 4) { return brokenReader("short"); }
    i32 n = this.held.get(0) as i32 | (this.held.get(1) as i32 << 8) | (this.held.get(2) as i32 << 16)
          | (this.held.get(3) as i32 << 24);
    if (n < 0) {
      this.broken = true;
      return brokenReader("a frame longer than two gigabytes");
    }
    if (this.held.len < 4 + n) { return brokenReader("short"); }
    u8[] body = u8[].filled(n, 0);
    u8[] all = this.held.bytes();
    body.copyFrom(all, 4, 0, n);
    this.held.dropFront(4 + n);
    return WireReader(body, 0, false, "");
  }
}

Buf wireAsk(i32 op) {
  Buf b = Buf.create();
  b.push(op as@ u8);
  return b;
}

// ── The child's end ──

/**
 * A child's line to its parent: one question in flight at a time, the next waiting on `turn`. `served` is 0 until
 * `Sys.files` has asked, then 1 when the parent answers files and 2 when it does not.
 */
struct ParentLine {
  WireLine line;
  Ticket<bool> turn;
  i32 served;
  /** Who the parent's files act as, from its answer to the hello. */
  string user;

  ParentLine on(__WacHost host) {
    Ticket<bool> open;
    open.resolve(true);
    return ParentLine(WireLine.on(host, PARENT_FS), open, 0, "");
  }

  /**
   * Ask the parent whether it serves files, **without waiting** — what the program adapter does before an `async`
   * `main`, so that `serves` already knows by the time a program asks. A page cannot wait for the parent's
   * answer, and asking it the first time `files()` was called waited: every spawned applet in the browser
   * terminal trapped there.
   */
  async void greet(this) {
    if (this.served != 0) { return; }
    if (!(await this.line.put(wireAsk(ASK_HELLO)))) {
      this.served = 2;
      return;
    }
    WireReader r = await this.line.next();
    string said = r.text();
    this.served = !r.bad && said == servedHello() ? 1 : 2;
    if (this.served == 1) { this.user = r.text(); }
  }

  /**
   * Whether the parent serves files — asked once, the first time, and remembered. An `async` program has already
   * asked (`greet`); a synchronous one asks here, waiting for the answer.
   */
  bool serves(this) {
    if (this.served == 0) {
      Buf hello = wireAsk(ASK_HELLO);
      Buf framed = Buf.create();
      framed.pushU32(hello.len as@ u32);
      framed.pushAll(hello.bytes());
      bool asked = lineSend(this.line.host, PARENT_FS, framed.bytes()).wait().orElse(false);
      WireReader r = asked ? this.line.nextNow() : brokenReader("not spawned");
      string said = r.text();
      this.served = !r.bad && said == servedHello() ? 1 : 2;
      if (this.served == 1) { this.user = r.text(); }
    }
    return this.served == 1;
  }

  /** Ask `question` when the questions before it have their answers, and answer what the parent says. */
  async WireReader ask(this, Buf question) {
    Ticket<bool> before = this.turn;
    Ticket<bool> mine;
    this.turn = mine;
    await before;
    WireReader r = brokenReader("the parent channel has ended");
    if (await this.line.put(question)) { r = await this.line.next(); }
    mine.resolve(true);
    return r;
  }
}

/** The `Files` a child's parent serves. Composed in the parent, so a grandchild is served it in turn. */
Files parentFiles(ParentLine l) {
  return Files(
    (string p) => askRead(l, p),
    (string p, u8[] b) => askWrite(l, p, b),
    (string p) => askOpenRead(l, p),
    (string p) => askOpenWrite(l, ASK_OPEN_WRITE, p),
    (string p) => askOpenWrite(l, ASK_OPEN_APPEND, p),
    (string p) => askStat(l, ASK_STAT, p),
    (string p) => askStat(l, ASK_LINK_STAT, p),
    (string p) => askReadDir(l, p),
    (string p, bool parents) => askMkdir(l, p, parents),
    (string p, bool r) => askMove(l, ASK_REMOVE, p, "", r),
    (string from, string to) => askMove(l, ASK_RENAME, from, to, false),
    (string p, i32 mode) => askMode(l, ASK_CHMOD, p, mode, false, ""),
    (string p, bool on) => askMode(l, ASK_SET_EXECUTABLE, p, 0, on, ""),
    (string p, string owner) => askMode(l, ASK_CHOWN, p, 0, false, owner),
    0, l.user);
}

string lineGone(WireReader r) { return "the parent did not answer: " + r.why; }

async Result<u8[], ReadFault> askRead(ParentLine l, string p) {
  Buf q = wireAsk(ASK_READ_FILE);
  putWireString(q, p);
  WireReader r = await l.ask(q);
  if (r.failed()) { return Result.Err(readFault(r.u32(), r.text())); }
  u8[] b = r.bytes();
  if (r.bad) { return Result.Err(Other(lineGone(r))); }
  return Result.Ok(b);
}

async Result<void, WriteFault> askWrite(ParentLine l, string p, u8[] b) {
  Buf q = wireAsk(ASK_WRITE_FILE);
  putWireString(q, p);
  putWireBytes(q, b);
  WireReader r = await l.ask(q);
  if (r.failed()) { return Result.Err(writeFault(r.u32(), r.text())); }
  if (r.bad) { return Result.Err(Other(lineGone(r))); }
  return Result.Ok();
}

async Result<Input, ReadFault> askOpenRead(ParentLine l, string p) {
  Buf q = wireAsk(ASK_OPEN_READ);
  putWireString(q, p);
  WireReader r = await l.ask(q);
  if (r.failed()) { return Result.Err(readFault(r.u32(), r.text())); }
  i32 id = r.u32();
  if (r.bad) { return Result.Err(Other(lineGone(r))); }
  return Result.Ok(Input(() => askChunk(l, id), () => askReadAll(l, id), () => askCloseRead(l, id)));
}

async Result<Read, HostFault> askChunk(ParentLine l, i32 id) {
  Buf q = wireAsk(ASK_CHUNK);
  q.pushU32(id as@ u32);
  WireReader r = await l.ask(q);
  if (r.failed()) { return Result.Err(hostFaultOf(r.u32(), r.text())); }
  bool more = r.flag();
  u8[] b = more ? r.bytes() : u8[]();
  if (r.bad) { return Result.Err(Other(lineGone(r))); }
  if (!more) { return Result.Ok(Read.End); }
  return Result.Ok(Read.Data(b));
}

async Result<u8[], HostFault> askReadAll(ParentLine l, i32 id) {
  Buf q = wireAsk(ASK_READ_ALL);
  q.pushU32(id as@ u32);
  WireReader r = await l.ask(q);
  if (r.failed()) { return Result.Err(hostFaultOf(r.u32(), r.text())); }
  u8[] b = r.bytes();
  if (r.bad) { return Result.Err(Other(lineGone(r))); }
  return Result.Ok(b);
}

async Result<void, HostFault> askCloseRead(ParentLine l, i32 id) {
  Buf q = wireAsk(ASK_CLOSE_READ);
  q.pushU32(id as@ u32);
  WireReader r = await l.ask(q);
  if (r.failed()) { return Result.Err(hostFaultOf(r.u32(), r.text())); }
  if (r.bad) { return Result.Err(Other(lineGone(r))); }
  return Result.Ok();
}

async Result<Output, WriteFault> askOpenWrite(ParentLine l, i32 op, string p) {
  Buf q = wireAsk(op);
  putWireString(q, p);
  WireReader r = await l.ask(q);
  if (r.failed()) { return Result.Err(writeFault(r.u32(), r.text())); }
  i32 id = r.u32();
  if (r.bad) { return Result.Err(Other(lineGone(r))); }
  return Result.Ok(Output((u8[] b) => askOutput(l, ASK_WRITE, id, b), () => askOutput(l, ASK_CLOSE_WRITE, id, u8[]())));
}

async Result<void, OutputFault> askOutput(ParentLine l, i32 op, i32 id, u8[] b) {
  Buf q = wireAsk(op);
  q.pushU32(id as@ u32);
  if (op == ASK_WRITE) { putWireBytes(q, b); }
  WireReader r = await l.ask(q);
  if (r.failed()) { return Result.Err(outputFault(r.u32(), r.text())); }
  if (r.bad) { return Result.Err(Other(lineGone(r))); }
  return Result.Ok();
}

async Result<Stat, LookFault> askStat(ParentLine l, i32 op, string p) {
  Buf q = wireAsk(op);
  putWireString(q, p);
  WireReader r = await l.ask(q);
  if (r.failed()) { return Result.Err(lookFault(r.u32(), r.text())); }
  Stat s = r.stat();
  if (r.bad) { return Result.Err(Other(lineGone(r))); }
  return Result.Ok(s);
}

async Result<string[], LookFault> askReadDir(ParentLine l, string p) {
  Buf q = wireAsk(ASK_READ_DIR);
  putWireString(q, p);
  WireReader r = await l.ask(q);
  if (r.failed()) { return Result.Err(lookFault(r.u32(), r.text())); }
  i32 n = r.u32();
  if (r.bad || n < 0) { return Result.Err(Other(lineGone(r))); }
  string[] names = string[].filled(n, "");
  for (i32 i = 0; i < n; i++) { names[i] = r.text(); }
  if (r.bad) { return Result.Err(Other(lineGone(r))); }
  return Result.Ok(names);
}

async Result<void, MkdirFault> askMkdir(ParentLine l, string p, bool parents) {
  Buf q = wireAsk(ASK_MKDIR);
  putWireString(q, p);
  q.push(parents ? 1 : 0);
  WireReader r = await l.ask(q);
  if (r.failed()) { return Result.Err(mkdirFault(r.u32(), r.text())); }
  if (r.bad) { return Result.Err(Other(lineGone(r))); }
  return Result.Ok();
}

/** `remove` (`p`, `recursive`) and `rename` (`p` to `to`). */
async Result<void, MoveFault> askMove(ParentLine l, i32 op, string p, string to, bool recursive) {
  Buf q = wireAsk(op);
  putWireString(q, p);
  if (op == ASK_RENAME) { putWireString(q, to); } else { q.push(recursive ? 1 : 0); }
  WireReader r = await l.ask(q);
  if (r.failed()) { return Result.Err(moveFault(r.u32(), r.text())); }
  if (r.bad) { return Result.Err(Other(lineGone(r))); }
  return Result.Ok();
}

/** `chmod` (`mode`), `setExecutable` (`on`) and `chown` (`owner`). */
async Result<void, ModeFault> askMode(ParentLine l, i32 op, string p, i32 mode, bool on, string owner) {
  Buf q = wireAsk(op);
  putWireString(q, p);
  if (op == ASK_CHMOD) { q.pushU32(mode as@ u32); }
  if (op == ASK_SET_EXECUTABLE) { q.push(on ? 1 : 0); }
  if (op == ASK_CHOWN) { putWireString(q, owner); }
  WireReader r = await l.ask(q);
  if (r.failed()) { return Result.Err(modeFault(r.u32(), r.text())); }
  if (r.bad) { return Result.Err(Other(lineGone(r))); }
  return Result.Ok();
}

// ── The parent's end ──

/** A read of `handle` as a ticket the host answers — one that `cancel` withdraws. */
/** A send on a channel handle: whether it went. */
Ticket<bool> lineSend(__WacHost host, i32 handle, u8[] bytes) {
  return hostAsk(host, OP_SEND(), handle as i64, 0 as i64, "", bytes, lineSentOf);
}

bool lineSentOf(Answer a) { return a.fault == FAULT_NONE(); }

/** A chunk of a channel handle, its end, or why it stopped — as the `Read` a line takes apart. */
Ticket<Read> lineRecv(__WacHost host, i32 handle) {
  return hostAsk(host, OP_RECV(), handle as i64, 0 as i64, "", u8[](), lineRecvOf);
}

Read lineRecvOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Read.Failed(a.text); }
  if (a.flags == 1) { return Read.End; }
  return Read.Data(a.bytes);
}


/** The streams a served child has open, by the number it was given; a closed one keeps its number. */
struct ServedStreams {
  Vec<Input> reads;
  Vec<bool> readOpen;
  Vec<Output> writes;
  Vec<bool> writeOpen;
}

/**
 * Answer a child's questions out of `files` until its channel ends — which is the child exiting — or `stop` settles,
 * which is the child being stopped; then close what it left open. Runs as this program's scheduler does: nothing else
 * has to drive it.
 */
async void serveFiles(__WacHost host, i32 handle, Files files, Ticket<bool> stop) {
  WireLine line = WireLine.on(host, handle);
  ServedStreams open = ServedStreams(Vec.create(), Vec.create(), Vec.create(), Vec.create());
  bool going = true;
  while (going) {
    WireReader q = await line.nextUnless(stop);
    if (q.bad) {
      going = false;
    } else {
      Buf a = await answerQuestion(files, open, q);
      going = await line.put(a);
    }
  }
  for (i32 i = 0; i < open.reads.len(); i++) {
    if (open.readOpen.get(i)) { await open.reads.get(i).close(); }
  }
  for (i32 i = 0; i < open.writes.len(); i++) {
    if (open.writeOpen.get(i)) { await open.writes.get(i).close(); }
  }
}

async Buf answerQuestion(Files files, ServedStreams open, WireReader q) {
  i32 op = q.byte();
  Buf a = Buf.create();
  if (op == ASK_HELLO) {
    putWireString(a, servedHello());
    putWireString(a, files.user);
  } else if (op == ASK_READ_FILE) {
    match (await files.readFile(q.text())) {
      Ok(b): { a.push(0); putWireBytes(a, b); }
      Err(e): { putFault(a, e); }
    }
  } else if (op == ASK_WRITE_FILE) {
    string p = q.text();
    putDone(a, (await files.writeFile(p, q.bytes())).err());
  } else if (op == ASK_OPEN_READ) {
    match (await files.openRead(q.text())) {
      Ok(in): {
        open.reads.push(in);
        open.readOpen.push(true);
        a.push(0);
        a.pushU32((open.reads.len() - 1) as@ u32);
      }
      Err(e): { putFault(a, e); }
    }
  } else if (op == ASK_OPEN_WRITE || op == ASK_OPEN_APPEND) {
    string p = q.text();
    Result<Output, WriteFault> opened = op == ASK_OPEN_WRITE ? await files.openWrite(p) : await files.openAppend(p);
    match (opened) {
      Ok(out): {
        open.writes.push(out);
        open.writeOpen.push(true);
        a.push(0);
        a.pushU32((open.writes.len() - 1) as@ u32);
      }
      Err(e): { putFault(a, e); }
    }
  } else if (op == ASK_STAT || op == ASK_LINK_STAT) {
    string p = q.text();
    Result<Stat, LookFault> s = op == ASK_STAT ? await files.stat(p) : await files.linkStat(p);
    match (s) {
      Ok(st): { a.push(0); putStat(a, st); }
      Err(e): { putFault(a, e); }
    }
  } else if (op == ASK_READ_DIR) {
    match (await files.readDir(q.text())) {
      Ok(names): {
        a.push(0);
        a.pushU32(names.len() as@ u32);
        for (i32 i = 0; i < names.len(); i++) { putWireString(a, names[i]); }
      }
      Err(e): { putFault(a, e); }
    }
  } else if (op == ASK_MKDIR) {
    string p = q.text();
    putDone(a, (await files.mkdir(p, q.flag())).err());
  } else if (op == ASK_REMOVE) {
    string p = q.text();
    putDone(a, (await files.remove(p, q.flag())).err());
  } else if (op == ASK_RENAME) {
    string from = q.text();
    putDone(a, (await files.rename(from, q.text())).err());
  } else if (op == ASK_CHMOD) {
    string p = q.text();
    putDone(a, (await files.chmod(p, q.u32())).err());
  } else if (op == ASK_SET_EXECUTABLE) {
    string p = q.text();
    putDone(a, (await files.setExecutable(p, q.flag())).err());
  } else if (op == ASK_CHOWN) {
    string p = q.text();
    putDone(a, (await files.chown(p, q.text())).err());
  } else if (op == ASK_CHUNK || op == ASK_READ_ALL || op == ASK_CLOSE_READ) {
    await answerRead(open, op, q.u32(), a);
  } else if (op == ASK_WRITE || op == ASK_CLOSE_WRITE) {
    i32 id = q.u32();
    await answerWrite(open, op, id, op == ASK_WRITE ? q.bytes() : u8[](), a);
  } else {
    putFault(a, Unsupported("this parent does not know question \{op}"));
  }
  return a;
}

/** The answer to a question with nothing to answer but whether it worked: `e` is its fault, or null. */
void putDone(Buf a, FilesFault? e) {
  if (e is null) { a.push(0); } else { putFault(a, e!); }
}

async void answerRead(ServedStreams open, i32 op, i32 id, Buf a) {
  if (id < 0 || id >= open.reads.len() || !open.readOpen.get(id)) {
    putFault(a, Other("no stream \{id} is open to read"));
    return;
  }
  Input in = open.reads.get(id);
  if (op == ASK_CHUNK) {
    match (await in.chunk()) {
      Ok(c): {
        a.push(0);
        match (c) {
          Data(b): { a.push(1); putWireBytes(a, b); }
          default: { a.push(0); }
        }
      }
      Err(e): { putFault(a, e); }
    }
  } else if (op == ASK_READ_ALL) {
    match (await in.readAll()) {
      Ok(b): { a.push(0); putWireBytes(a, b); }
      Err(e): { putFault(a, e); }
    }
  } else {
    open.readOpen.set(id, false);
    putDone(a, (await in.close()).err());
  }
}

async void answerWrite(ServedStreams open, i32 op, i32 id, u8[] b, Buf a) {
  if (id < 0 || id >= open.writes.len() || !open.writeOpen.get(id)) {
    putFault(a, OutputClosed("no stream \{id} is open to write"));
    return;
  }
  Output out = open.writes.get(id);
  if (op == ASK_WRITE) {
    putDone(a, (await out.write(b)).err());
  } else {
    open.writeOpen.set(id, false);
    putDone(a, (await out.close()).err());
  }
}

// ── Sockets ──────────────────────────────────────────────────────────────────────────────────────

/** Opening a connection. */
export type ConnectFault = union<Refused, Unreachable, TimedOut, NotFound, NotGranted, Unsupported, Other>;
/** Listening on a port or binding a datagram socket. */
export type BindFault = union<Denied, Exists, NotGranted, Unsupported, Other>;
/** Reading or writing a connection. */
export type SocketFault = union<PeerClosed, TimedOut, Unsupported, Other>;

ConnectFault connectFault(i32 code, string m) {
  if (code == FAULT_REFUSED()) { return Refused(m); }
  if (code == FAULT_UNREACHABLE()) { return Unreachable(m); }
  if (code == FAULT_TIMED_OUT()) { return TimedOut(m); }
  if (code == FAULT_NOT_FOUND()) { return NotFound(m); }
  if (code == FAULT_NOT_GRANTED()) { return NotGranted(m); }
  if (code == FAULT_UNSUPPORTED()) { return Unsupported(m); }
  return Other(m);
}

BindFault bindFault(i32 code, string m) {
  if (code == FAULT_DENIED()) { return Denied(m); }
  if (code == FAULT_EXISTS()) { return Exists(m); }
  if (code == FAULT_NOT_GRANTED()) { return NotGranted(m); }
  if (code == FAULT_UNSUPPORTED()) { return Unsupported(m); }
  return Other(m);
}

/** The network (spec ch44). Each operation answers `NotGranted` when the host withheld it. */
export struct Net {
  __WacHost host;

  /** A connection to `host:port`. */
  Ticket<Result<Socket, ConnectFault>> connect(this, string to, i32 port) {
    __WacHost h = this.host;
    return hostAsk(h, OP_CONNECT(), port as i64, 0 as i64, to, u8[](), (Answer a) => connectedOf(h, a));
  }

  /**
   * Listen on `addr:port` — `"127.0.0.1"` for loopback, `"0.0.0.0"` for every interface; the address is not
   * optional, so the surprising one is something somebody typed. Port 0 asks the host for any free one.
   */
  Ticket<Result<Listener, BindFault>> listen(this, string addr, i32 port) {
    __WacHost h = this.host;
    return hostAsk(h, OP_LISTEN(), port as i64, 0 as i64, addr, u8[](), (Answer a) => listeningOf(h, addr, a));
  }

  /** A datagram socket on `addr:port`, which one socket uses to talk to many peers. */
  Ticket<Result<Datagrams, BindFault>> bindDatagram(this, string addr, i32 port) {
    __WacHost h = this.host;
    return hostAsk(h, OP_BIND_DATAGRAM(), port as i64, 0 as i64, addr, u8[](), (Answer a) => boundOf(h, a));
  }
}

Result<Socket, ConnectFault> connectedOf(__WacHost h, Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(connectFault(a.fault, a.text)); }
  return Result.Ok(Socket(h, a.n as~ i32, a.text, a.m as~ i32));
}

Result<Listener, BindFault> listeningOf(__WacHost h, string addr, Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(bindFault(a.fault, a.text)); }
  i32 port = a.m as~ i32;
  return Result.Ok(Listener(h, a.n as~ i32, addr + ":" + "\{port}", port));
}

Result<Datagrams, BindFault> boundOf(__WacHost h, Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(bindFault(a.fault, a.text)); }
  return Result.Ok(Datagrams(h, a.n as~ i32, a.m as~ i32));
}

Result<Socket, HostFault> acceptedOf(__WacHost h, Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(Other(a.text)); }
  return Result.Ok(Socket(h, a.n as~ i32, a.text, a.m as~ i32));
}

Result<Read, SocketFault> recvOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(Other(a.text)); }
  if (a.flags == 1) { return Result.Ok(Read.End); }
  return Result.Ok(Read.Data(a.bytes));
}

/** A listening socket. */
export struct Listener {
  __WacHost host;
  i32 handle;
  /** `"0.0.0.0:8080"`. */
  string addr;
  /** The port bound — what the host chose when 0 was asked for. */
  i32 port;

  /**
   * The next connection. `Err` only when the listener itself cannot go on (spec ch44 `§wac-std-accept-tkafecv`):
   * a connection that ends before it is accepted is never reported.
   */
  Ticket<Result<Socket, HostFault>> accept(this) {
    __WacHost h = this.host;
    return hostAsk(h, OP_ACCEPT(), this.handle as i64, 0 as i64, "", u8[](), (Answer a) => acceptedOf(h, a));
  }

  void close(this) { this.host.tell(OP_CLOSE_SOCKET(), this.handle as i64, 0 as i64, "", u8[]()); }
}

/** One connection (spec ch44 `§wac-std-socket-gs9parx`). */
export struct Socket {
  __WacHost host;
  i32 handle;
  /** The other end's address, and its port. */
  string peer;
  i32 port;

  /** The next bytes, or the end. */
  Ticket<Result<Read, SocketFault>> recv(this) {
    return hostAsk(this.host, OP_RECV(), this.handle as i64, 0 as i64, "", u8[](), recvOf);
  }

  /** Send `bytes`; a peer that has gone is `PeerClosed`, an ordinary fault a server handles. */
  Ticket<Result<void, SocketFault>> send(this, u8[] bytes) {
    string peer = this.peer;
    return hostAsk(this.host, OP_SEND(), this.handle as i64, 0 as i64, "", bytes, (Answer a) => sentOf(a, peer));
  }

  /** No more from this side; reading goes on. */
  void closeSend(this) { this.host.tell(OP_CLOSE_SEND(), this.handle as i64, 0 as i64, "", u8[]()); }

  void close(this) { this.host.tell(OP_CLOSE_SOCKET(), this.handle as i64, 0 as i64, "", u8[]()); }

  /** Whether the other end is this machine. */
  bool fromLoopback(const this) { return this.peer == "127.0.0.1" || this.peer == "::1" || this.peer == "localhost"; }
}

Result<void, SocketFault> sentOf(Answer a, string peer) {
  if (a.fault != FAULT_NONE()) { return Result.Err(PeerClosed(a.text == "" ? peer + ": the connection has closed" : a.text)); }
  return Result.Ok();
}

/** A datagram socket: no connection, the peer named on every send and arriving with every receive. */
export struct Datagrams {
  __WacHost host;
  i32 handle;
  i32 port;

  Ticket<Result<Datagram, HostFault>> receive(this) {
    return hostAsk(this.host, OP_RECEIVE_FROM(), this.handle as i64, 0 as i64, "", u8[](), datagramOf);
  }

  Ticket<Result<void, union<Unreachable, Unsupported, Other>>> sendTo(this, string to, i32 port, u8[] bytes) {
    return hostAsk(this.host, OP_SEND_TO(), this.handle as i64, port as i64, to, bytes,
                   (Answer a) => sentToOf(a, to, port));
  }

  void close(this) { this.host.tell(OP_CLOSE_SOCKET(), this.handle as i64, 0 as i64, "", u8[]()); }
}

Result<Datagram, HostFault> datagramOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(Other(a.text)); }
  return Result.Ok(Datagram(a.bytes, a.text, a.n as~ i32, ""));
}

Result<void, union<Unreachable, Unsupported, Other>> sentToOf(Answer a, string to, i32 port) {
  if (a.fault != FAULT_NONE()) { return Result.Err(Unreachable(a.text == "" ? to + ":" + "\{port}: the datagram was not sent" : a.text)); }
  return Result.Ok();
}

// ── Processes and modules ────────────────────────────────────────────────────────────────────────

/** Starting a program. */
export type SpawnFault = union<NotGranted, Unsupported, Other>;

SpawnFault spawnFault(i32 handle, string m) {
  if (handle == 0 - 2) { return Unsupported(m); }
  if (m == faultWords(FAULT_NOT_GRANTED())) { return NotGranted(m); }
  return Other(m);
}

/**
 * What a spawned child or a loaded module is handed (spec ch44 `§wac-std-spawn-grants-ykmq5tw`): each handle the
 * parent's own or narrowed from it, so a child never holds more than its parent.
 */
export struct Authority {
  Files? files;
  Net? net;
  Env? env;
  Procs? procs;

  /** Nothing at all. */
  Authority none() { return Authority(null, null, null, null); }

  /** The `GRANT_*` bits this is, for the host — and whether `files` is composed and must be served instead. */
  i32 grants(const this) {
    i32 g = 0;
    if (this.files is not null) { g = g | this.files!.hostGrants; }
    if (this.net is not null) { g = g | GRANT_NET; }
    if (this.env is not null) { g = g | GRANT_ENV; }
    if (this.procs is not null) { g = g | GRANT_RUN; }
    return g;
  }

  bool composedFiles(const this) { return this.files is not null && this.files!.hostGrants == 0; }
}

/** How a child is started. */
export struct Launch {
  /** Where its relative paths resolve; `""` for this program's own. */
  string cwd;
  /** It reads this program's input rather than a queue this program writes. */
  bool inheritIn;
  /** It writes this program's output and diagnostic output rather than queues this program reads. */
  bool inheritOut;
  /** Dropping its `Child` does not stop it (spec ch44 `§wac-std-child-drop-n2r5vxe`). */
  bool detached;

  /** Here, its streams queues, stopped when dropped. */
  Launch plain() { return Launch("", false, false, false); }

  i32 flags(const this) {
    return (this.inheritIn ? INHERIT_IN : 0) | (this.inheritOut ? INHERIT_OUT : 0) | (this.detached ? DETACHED : 0);
  }
}

/**
 * The environment a host program gets from `Procs.exec`: a base — this program's own, or none — with variables set over
 * it (spec ch44 `§wac-std-child-env-k3w8tqa`).
 */
export struct ChildEnv {
  /** The base is empty rather than this program's own environment. */
  bool clean;
  /** `NAME=value`, each name once. */
  string[] pairs;

  /** This program's own environment, unchanged. */
  ChildEnv inherited() { return ChildEnv(false, string[]()); }
  /** No variables at all. */
  ChildEnv empty() { return ChildEnv(true, string[]()); }

  /** This environment with `name` set to `value`, replacing any value it had. */
  ChildEnv set(const this, string name, string value) {
    string prefix = name + "=";
    i32 kept = 0;
    for (i32 i = 0; i < this.pairs.len(); i++) {
      if (!namedBy(this.pairs[i], prefix)) { kept++; }
    }
    string[] next = string[].filled(kept + 1, "");
    i32 at = 0;
    for (i32 i = 0; i < this.pairs.len(); i++) {
      if (!namedBy(this.pairs[i], prefix)) { next[at] = this.pairs[i]; at++; }
    }
    next[kept] = prefix + value;
    return ChildEnv(this.clean, next);
  }
}

/** Whether `pair` is `NAME=…` for the `NAME=` that is `prefix`. */
bool namedBy(string pair, string prefix) {
  return pair.len() >= prefix.len() && pair.slice(0, prefix.len()) == prefix;
}

/** Starting other programs (spec ch44). */
export struct Procs {
  __WacHost host;

  /** Start the compiled module `wasm` with `args`, holding `given`. */
  Ticket<Result<Child, SpawnFault>> spawn(this, u8[] wasm, string[] args, Authority given, Launch how) {
    __WacHost h = this.host;
    Files? served = given.composedFiles() ? given.files : null;
    return hostAsk(h, OP_SPAWN(), given.grants() as i64, spawnFlags(how, served is not null) as i64, how.cwd,
                   spawnBytes(wasm, args), (Answer a) => childOf(h, a, served));
  }

  /** Start another instance of this program — its `main`, with `args` — holding `given`. Needs the grant as `spawn` does. */
  Ticket<Result<Child, SpawnFault>> spawnSelf(this, string[] args, Authority given, Launch how) {
    __WacHost h = this.host;
    Files? served = given.composedFiles() ? given.files : null;
    return hostAsk(h, OP_SPAWN_SELF(), given.grants() as i64, spawnFlags(how, served is not null) as i64, how.cwd,
                   spawnBytes(u8[](), args), (Answer a) => childOf(h, a, served));
  }

  /**
   * Run a program of the host's — `program` found on its path — to the end, with `input` as its standard input.
   * Its output comes back whole unless `how.inheritOut`, when it went to this program's own.
   */
  Ticket<Result<Exec, SpawnFault>> exec(this, string program, string[] args, u8[] input, ChildEnv env, Launch how) {
    i64 flags = ((env.clean ? 1 : 0) | (how.inheritOut ? 2 : 0)) as i64;
    return hostAsk(this.host, OP_EXEC(), flags, 0 as i64, how.cwd, execBytes(program, args, input, env.pairs), ranOf);
  }
}

/** `OP_SPAWN`'s and `OP_SPAWN_SELF`'s `b`: the launch flags, and whether this program serves the child files. */
export static i32 SPAWN_SERVES = 256;

i32 spawnFlags(Launch how, bool serves) { return how.flags() | (serves ? SPAWN_SERVES : 0); }

/** A u32 length and that many bytes — how a payload of several parts is laid out in a request's `bytes`. */
void putPart(Buf out, u8[] b) {
  out.pushU32(b.len() as@ u32);
  out.pushAll(b);
}

/** `OP_SPAWN`'s and `OP_SPAWN_SELF`'s `bytes`: the module (empty for this program), then each argument. */
u8[] spawnBytes(u8[] wasm, string[] args) {
  Buf out = Buf.create();
  putPart(out, wasm);
  out.pushU32(args.len() as@ u32);
  for (i32 i = 0; i < args.len(); i++) { putPart(out, args[i].toBytes()); }
  return out.take();
}

/** `OP_EXEC`'s `bytes`: the program, its arguments, its input, and the `NAME=value` pairs set over its environment. */
u8[] execBytes(string program, string[] args, u8[] input, string[] pairs) {
  Buf out = Buf.create();
  putPart(out, program.toBytes());
  out.pushU32(args.len() as@ u32);
  for (i32 i = 0; i < args.len(); i++) { putPart(out, args[i].toBytes()); }
  putPart(out, input);
  out.pushU32(pairs.len() as@ u32);
  for (i32 i = 0; i < pairs.len(); i++) { putPart(out, pairs[i].toBytes()); }
  return out.take();
}

/**
 * The started child — and, when it was handed a composed `Files`, this program serving it from now until it ends.
 * `m` packs the error stream's handle (low 32) and the served-files channel's (high 32).
 */
Result<Child, SpawnFault> childOf(__WacHost h, Answer a, Files? served) {
  if (a.fault != FAULT_NONE()) { return Result.Err(spawnFaultOf(a.fault, a.text)); }
  i32 handle = a.n as~ i32;
  i32 errHandle = (a.m & (4294967295 as i64)) as~ i32;
  i32 fsHandle = (a.m >> 32) as~ i32;
  if (served is null) { return Result.Ok(Child(h, handle, errHandle, null, null)); }
  Ticket<bool> stopping;
  return Result.Ok(Child(h, handle, errHandle, serveFiles(h, fsHandle, served!, stopping), stopping));
}

SpawnFault spawnFaultOf(i32 code, string m) {
  if (code == FAULT_NOT_GRANTED()) { return NotGranted(m); }
  if (code == FAULT_UNSUPPORTED()) { return Unsupported(m); }
  return Other(m);
}

/** A run of a host program: `n` its status, `bytes` its output then its diagnostic output, split at `m`. */
Result<Exec, SpawnFault> ranOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(spawnFaultOf(a.fault, a.text)); }
  i32 split = a.m as~ i32;
  if (split < 0 || split > a.bytes.len()) { split = a.bytes.len(); }
  u8[] out = u8[].filled(split, 0);
  out.copyFrom(a.bytes, 0, 0, split);
  u8[] err = u8[].filled(a.bytes.len() - split, 0);
  err.copyFrom(a.bytes, split, 0, a.bytes.len() - split);
  return Result.Ok(Exec(a.n as~ i32, out, err, ""));
}

/**
 * Why a composed `Files` cannot be handed to a loaded module: it runs on this thread, so a question it asked could
 * only be answered after it returned.
 */
Unsupported composedRefused() {
  return Unsupported("a Files built in this program cannot be handed to a module, which runs on this program's own "
                     + "thread and so cannot be served; spawn it instead");
}

/** A running child (spec ch44). */
export struct Child {
  __WacHost host;
  i32 handle;
  i32 errHandle;
  /** This program answering the child's file questions, when it was handed a composed `Files`; done once the child is. */
  Ticket<void>? serving;
  /** Settled by `stop`, which ends the serving as well as the child. */
  Ticket<bool>? stopServing;

  /** What it writes to its output, unless that was inherited. */
  Input output(this) { return handleInput(this.host, this.handle, nothingToClose); }

  /** What it writes to its diagnostic output, unless that was inherited. */
  Input errors(this) { return handleInput(this.host, this.errHandle, nothingToClose); }

  /** Its input, unless inherited. Closing it ends the child's input without stopping the child. */
  Output input(this) {
    __WacHost h = this.host;
    i32 handle = this.handle;
    return Output((u8[] b) => hostAsk(h, OP_SEND(), handle as i64, 0 as i64, "", b, fedOf), () => endFeed(h, handle));
  }

  /** Its status when it ends — and, when this program serves it files, once the serving has ended too. */
  Ticket<Result<i32, HostFault>> exit(this) {
    Ticket<Result<i32, HostFault>> code = hostAsk(this.host, OP_EXIT_CODE(), this.handle as i64, 0 as i64, "", u8[](),
                                                  exitedOf);
    if (this.serving is null) { return code; }
    return exitAfterServing(code, this.serving!);
  }

  /**
   * Stop it now — and the serving of its files with it. The serving is driven to its end here rather than left to
   * the scheduler: a program that stops a child and then finishes would otherwise finish with that serving's read
   * of the dead channel still registered, which the JavaScript hosts refuse (`stoppedserved_probe.wac`).
   */
  void stop(this) {
    this.host.tell(OP_CLOSE_SOCKET(), this.handle as i64, 0 as i64, "", u8[]());
    Ticket<bool>? s = this.stopServing;
    if (s is null || s!.settled()) { return; }
    s!.resolve(true);
    Ticket<void>? serving = this.serving;
    if (serving is not null) { serving!.wait(); }
  }
}

async Result<i32, HostFault> exitAfterServing(Ticket<Result<i32, HostFault>> code, Ticket<void> serving) {
  Result<i32, HostFault> status = await code;
  await serving;
  return status;
}

Result<i32, HostFault> exitedOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(hostFaultOf(a.fault, a.text)); }
  if (a.n < 0 as i64) { return Result.Err(Other("the child did not run to an end")); }
  return Result.Ok(a.n as~ i32);
}

async Result<u8[], HostFault> streamAll(__WacHost host, i32 h) {
  Buf all = Buf.create();
  while (true) {
    Result<Read, HostFault> c = await hostAsk(host, OP_RECV(), h as i64, 0 as i64, "", u8[](), readOf);
    if (c.isErr()) { return Result.Err(c.err()!); }
    match (c.unwrap()) {
      Data(bytes): { all.pushAll(bytes); }
      default: { return Result.Ok(all.take()); }
    }
  }
}

async Result<void, OutputFault> endFeed(__WacHost host, i32 h) {
  host.tell(OP_CLOSE_FEED(), h as i64, 0 as i64, "", u8[]());
  return Result.Ok();
}

Result<void, OutputFault> fedOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(OutputClosed(a.text == "" ? "the child's input has closed" : a.text)); }
  return Result.Ok();
}

/** Loading wasm modules into this instance (spec ch44 `§wac-std-module-same-thread-q8d2kzm`). */
export struct Modules {
  __WacHost host;

  /** Load `wasm`, holding `given`. It runs on this thread when called. */
  Result<Module, union<Unsupported, Other>> load(this, u8[] wasm, Authority given) {
    if (given.composedFiles()) { return Result.Err(composedRefused()); }
    __WacHost h = this.host;
    fn<Result<Module, union<Unsupported, Other>>(Answer)> decode = (Answer a) => loadedOf(h, a);
    Ticket<Result<Module, union<Unsupported, Other>>> t = hostAsk(h, OP_LOAD(), given.grants() as i64, 0 as i64, "", wasm, decode);
    Result<Result<Module, union<Unsupported, Other>>, Stuck> r = t.wait();
    if (r.isErr()) { return Result.Err(Other("this host answers a load later, and a load is answered at once")); }
    return r.unwrap();
  }

  /** Whether `wasm` is a module this engine accepts; the engine's sentence when not. */
  Result<void, union<Unsupported, Other>> validate(this, u8[] wasm) {
    Result<Result<void, union<Unsupported, Other>>, Stuck> r =
      hostAsk(this.host, OP_VALIDATE(), 0 as i64, 0 as i64, "", wasm, validatedOf).wait();
    if (r.isErr()) { return Result.Err(Other("this host answers a validation later, and one is answered at once")); }
    return r.unwrap();
  }
}

Result<Module, union<Unsupported, Other>> loadedOf(__WacHost h, Answer a) {
  if (a.fault == FAULT_UNSUPPORTED()) { return Result.Err(Unsupported(a.text)); }
  if (a.fault != FAULT_NONE()) { return Result.Err(Other(a.text)); }
  return Result.Ok(Module(h, a.n as~ i32));
}

Result<void, union<Unsupported, Other>> validatedOf(Answer a) {
  if (a.fault == FAULT_UNSUPPORTED()) { return Result.Err(Unsupported(a.text)); }
  if (a.fault != FAULT_NONE()) { return Result.Err(Other(a.text)); }
  return Result.Ok();
}

/** A loaded module. */
export struct Module {
  __WacHost host;
  i32 handle;

  /**
   * Call the export `name` with `arg`. A trap is an answer (`CallResult.trapped`), not a fault: `flags` the status,
   * `n` the value, `text` the message.
   */
  Result<CallResult, HostFault> call(this, string name, i32 arg) {
    Result<Result<CallResult, HostFault>, Stuck> r =
      hostAsk(this.host, OP_CALL(), this.handle as i64, arg as i64, name, u8[](), calledOf).wait();
    if (r.isErr()) { return Result.Err(Other("this host answers a call later, and a call is answered at once")); }
    return r.unwrap();
  }

  void unload(this) { this.host.tell(OP_UNLOAD(), this.handle as i64, 0 as i64, "", u8[]()); }
}

Result<CallResult, HostFault> calledOf(Answer a) {
  if (a.fault != FAULT_NONE()) { return Result.Err(hostFaultOf(a.fault, a.text)); }
  return Result.Ok(CallResult(a.flags, a.text, a.n as~ i32));
}


/** What a host answers a request with: one shape for every request. `fault` is a `FAULT_*` category, 0 for none. */
export struct Answer {
  i32 fault;
  string text;
  u8[] bytes;
  i64 n;
  i64 m;
  i32 flags;
}

/**
 * The host's calls, and this program's requests in flight — what `__wacHost` hands the host to hold.
 *
 * **It holds no handle**, and must not: an exported type is kept whole, so a `Sys` here would carry every
 * handle into every program. The handles are built over it inside `main`.
 */
export struct __WacHost {
  /** Ask: `request(op, id, a, b, text, bytes)`. `id` is 0 for a request nobody answers. */
  fn<void(i32, i32, i64, i64, string, u8[])> request;
  /** Block until one of `ids` is answered — having delivered it through `answered` — and say which; -1 for none. */
  fn<i32(i32[], i32)> waitAny;
  fn<void(i32)> exitWith;
  fn<bool()> interrupted;
  /** Each request in flight, and what settles its ticket. */
  Map<i32, fn<void(Answer)>> pending;
  i32 last;
  /** Whether the last wait stopped because the host cannot wait rather than because nothing answered. */
  bool yielded;
  /** The continuations nobody awaited — the program's schedule target (spec ch35), run by `drain`. */
  Queue<Continuation> queued;

  /**
   * The host's four calls, as the program adapter's `__wacHost` is handed them — and the schedule target, set
   * here once, so a machine that suspends with nobody awaiting it is queued rather than dropped.
   */
  __WacHost of(fn<void(i32, i32, i64, i64, string, u8[])> request, fn<i32(i32[], i32)> waitAny, fn<void(i32)> exitWith,
               fn<bool()> interrupted) {
    Queue<Continuation> queued;
    __WacHost h = __WacHost(request, waitAny, exitWith, interrupted, Map.create(hashI32, i32Eq), 0, false, queued);
    if (__wacScheduleTarget() is null) { __wacSetScheduleTarget(h.queued.push); }
    return h;
  }

  /**
   * Run continuations until none are outstanding, stopping early once `until` has settled (null: no such stop)
   * or `millis` has passed (below zero: no bound). Ready continuations first; when none could run, one wait over
   * every request in flight, which delivers what has arrived through `answered`. Answers how many waits answered.
   */
  i32 drainUntil(this, i32 millis, TicketBase? until) {
    bool bounded = millis >= 0;
    i64 deadline = 0 as i64;
    if (bounded) { deadline = this.nanos() + millisToNanos(millis); }
    i32 ran = 0;
    while (true) {
      if (until is not null && until!.done) { return ran; }
      Queue<Continuation> later;
      bool moved = false;
      while (true) {
        Continuation? c = this.queued.pop();
        if (c is null) { break; }
        // One a `wait` already ran past does nothing when called, and is not work left.
        if (!c!.current()) { continue; }
        TicketBase? on = c!.t;
        if (on is null || on!.done) {
          c!.call();
          moved = true;
        } else {
          later.push(c!);
        }
      }
      while (true) {
        Continuation? back = later.pop();
        if (back is null) { break; }
        this.queued.push(back!);
      }
      if (moved) { continue; }
      if (this.pending.len() == 0) { return ran; }
      i32 budget = 0 - 1;
      if (bounded) {
        i64 left = deadline - this.nanos();
        if (left <= 0 as i64) { return ran; }
        budget = (left / (1000000 as i64)) as! i32;
      }
      if (this.waitFor(this.inFlight(), budget) < 0) { return ran; }
      ran = ran + 1;
    }
    return ran;
  }

  /** The monotonic clock, for a drain's deadline; 0 where the host has none. */
  i64 nanos(this) {
    Result<Result<i64, union<Unsupported>>, Stuck> r = hostAsk(this, OP_MONOTONIC_NANOS(), 0 as i64, 0 as i64, "", u8[](), timeOf).wait();
    if (r.isErr()) { return 0 as i64; }
    return r.unwrap().orElse(0 as i64);
  }

  /** How many queued continuations are still current, dropping the ones a `wait` ran past. */
  i32 liveQueued(this) {
    Queue<Continuation> kept;
    i32 live = 0;
    while (true) {
      Continuation? c = this.queued.pop();
      if (c is null) { break; }
      if (!c!.current()) { continue; }
      kept.push(c!);
      live = live + 1;
    }
    while (true) {
      Continuation? c = kept.pop();
      if (c is null) { break; }
      this.queued.push(c!);
    }
    return live;
  }

  /** How much work is outstanding — what the program adapter asks when `main` returns. */
  i32 outstanding(this) { return this.pending.len() + this.liveQueued(); }



  /** A request nobody answers — a write to a stream, a close. */
  void tell(this, i32 op, i64 a, i64 b, string text, u8[] bytes) { this.request(op, 0, a, b, text, bytes); }

  /** `waitAny`, noting a host that cannot wait. */
  i32 waitFor(this, i32[] ids, i32 millis) {
    i32 which = this.waitAny(ids, millis);
    if (which == HOST_CANNOT_WAIT()) { this.yielded = true; }
    return which;
  }

  /** The ids in flight, for a wait over all of them. */
  i32[] inFlight(const this) { return this.pending.keys(); }
}

/**
 * Ask the host, and answer a ticket of what `decode` makes of the answer. A host that can answer at once
 * does so from inside `request`, so the ticket can be settled before this returns.
 */
Ticket<U> hostAsk<U>(__WacHost host, i32 op, i64 a, i64 b, string text, u8[] bytes, fn<U(Answer)> decode) {
  host.last = host.last + 1;
  i32 id = host.last;
  Ticket<U> t;
  __WacHost h = host;
  host.pending.set(id, (Answer x) => { if (!t.done) { t.resolve(decode(x)); } });
  t.hostId = id;
  t.waitHost = (i32[] ids, i32 millis) => h.waitFor(ids, millis);
  // **An answer nobody has read is still the host's** (operator, 2026-10-28): dropping a request the host
  // has answered closes what it answered — the socket, the child — rather than leaving it to leak.
  t.release = () => {
    h.pending.remove(id);
    h.request(OP_DROP(), id, 0 as i64, 0 as i64, "", u8[]());
  };
  t.drive = () => {
    while (!t.done) {
      if (h.waitFor([id], 0 - 1) < 0) { return false; }
    }
    return true;
  };
  host.request(op, id, a, b, text, bytes);
  return t;
}
/** The host answered request `id`. Called by the host, only from inside `request` or `waitAny`. */
export void answered(__WacHost h, i32 id, i32 fault, string text, u8[] bytes, i64 n, i64 m, i32 flags) {
  fn<void(Answer)>? settle = h.pending.get(id);
  // A request dropped since it was asked: the host closed what it answered, and nothing waits for it.
  if (settle is null) { return; }
  h.pending.remove(id);
  settle!(Answer(fault, text, bytes, n, m, flags));
}

/** Withdraw request `id`: the host closes what it answered if the program has not read it. */
export i32 OP_DROP() { return 0; }

// The requests, numbered as the JavaScript hosts' bridge has always numbered them (`host/ops.ts`), with what each
// takes in `a`, `b`, `text` and `bytes` and what its answer carries. A host implements exactly this table.
// Every answer may instead carry a `fault` with the host's words in `text`.

/** → `n`: wall-clock milliseconds since the epoch. */
export i32 OP_NOW_MILLIS() { return 1; }
/** → `n`: nanoseconds from an arbitrary origin, never decreasing. */
export i32 OP_MONOTONIC_NANOS() { return 2; }
/** `a` count → `bytes`: that many random bytes. */
export i32 OP_RANDOM_BYTES() { return 3; }
/** → `n`: how many arguments. */
export i32 OP_ARG_COUNT() { return 6; }
/** `a` index → `bytes`: that argument, exactly as given. */
export i32 OP_ARG() { return 7; }
/** `text` name → `bytes` its value, `flags` 1 when set. */
export i32 OP_ENV() { return 8; }
/** `text` path → `bytes`: the file. */
export i32 OP_READ_FILE() { return 9; }
/** `text` path, `bytes` contents. */
export i32 OP_WRITE_FILE() { return 10; }
/** → `bytes`: standard input, to its end. */
export i32 OP_READ_STDIN() { return 11; }
/** `bytes`: written to standard output. → nothing, or a `fault` when it could not be. */
export i32 OP_WRITE_STDOUT() { return 12; }
/** `text` path → `n` size, `m` modified ms, `flags` kind bits (`STAT_*`) with the mode in the high 16, `text` owner. */
export i32 OP_STAT() { return 13; }
/** `text` path → `bytes`: the names, each followed by a NUL. */
export i32 OP_READ_DIR() { return 14; }
/** `text` path, `a` 1 for every missing parent too. */
export i32 OP_MKDIR() { return 15; }
/** `text` path, `a` 1 for a whole tree. */
export i32 OP_REMOVE() { return 16; }
/** `text` from, `bytes` to. */
export i32 OP_RENAME() { return 17; }
/** → `bytes` the next chunk of standard input, `flags` 1 at its end. */
export i32 OP_READ_CHUNK() { return 19; }
/** `text` host, `a` port → `n` handle, `m` port, `text` peer. */
export i32 OP_CONNECT() { return 21; }
/** `text` address, `a` port → `n` handle, `m` the port bound. */
export i32 OP_LISTEN() { return 22; }
/** `a` listener → `n` handle, `m` port, `text` peer. */
export i32 OP_ACCEPT() { return 23; }
/** `a` handle → `bytes` the next chunk, `flags` 1 at its end. */
export i32 OP_RECV() { return 24; }
/** `a` handle, `bytes` → nothing, or `PeerClosed`. */
export i32 OP_SEND() { return 25; }
/** `a` handle. Nobody answers. */
export i32 OP_CLOSE_SOCKET() { return 26; }
/** `bytes` the module then the arguments (`spawnBytes`), `text` cwd, `a` grants, `b` flags → as `OP_SPAWN_SELF`. */
export i32 OP_SPAWN() { return 27; }
/** `a` child → `n`: its exit status. */
export i32 OP_EXIT_CODE() { return 28; }
/** `a` child: its input ends. Nobody answers. */
export i32 OP_CLOSE_FEED() { return 29; }
/** `a` milliseconds → `n`: the monotonic clock when it woke. */
export i32 OP_SLEEP_MILLIS() { return 30; }
/** → `text`: the directory relative paths resolve from. */
export i32 OP_CWD() { return 41; }
/** `text` path → as `OP_STAT`, of a link itself rather than what it names. */
export i32 OP_LINK_STAT() { return 47; }
/** `bytes`: written to standard error. → nothing, or a `fault`. */
export i32 OP_WRITE_STDERR() { return 48; }
/** `bytes` the arguments (`spawnBytes`), `text` cwd, `a` grants, `b` flags → `n` handle, `m` the error stream's handle and the served-files channel's, packed. */
export i32 OP_SPAWN_SELF() { return 49; }
/** `text` path, `a` 1 to set. */
export i32 OP_SET_EXECUTABLE() { return 52; }
/** `text` address, `a` port → `n` handle, `m` the port bound. */
export i32 OP_BIND_DATAGRAM() { return 53; }
/** `a` handle → `bytes`, `text` peer, `n` its port. */
export i32 OP_RECEIVE_FROM() { return 54; }
/** `a` handle, `b` port, `text` host, `bytes`. */
export i32 OP_SEND_TO() { return 55; }
/** `a` handle: this side sends no more. Nobody answers. */
export i32 OP_CLOSE_SEND() { return 57; }
/** `bytes` program, arguments, input and environment (`execBytes`), `text` cwd, `a` flags → `n` status, `bytes` stdout then stderr, `m` where stderr starts. */
export i32 OP_EXEC() { return 59; }
/** `text` path, `a` mode bits. */
export i32 OP_CHMOD() { return 60; }
/** `text` path, `a` how (0 read, 1 write, 2 append) → `n` handle. */
export i32 OP_OPEN_FILE() { return 61; }
/** `a` handle. */
export i32 OP_CLOSE_FILE() { return 62; }
/** `a` 1 for standard error: that stream ends while the program runs on. */
export i32 OP_CLOSE_OUTPUT() { return 63; }
/** `bytes` a module, `a` grants → `n` its handle. Answered at once. */
export i32 OP_LOAD() { return 64; }
/** `a` handle, `b` the argument, `text` the export → `flags` status, `n` value, `text` message. Answered at once. */
export i32 OP_CALL() { return 65; }
/** `a` handle. Nobody answers. */
export i32 OP_UNLOAD() { return 66; }
/** `bytes` a module → nothing, or the engine's sentence as a fault. Answered at once. */
export i32 OP_VALIDATE() { return 67; }
