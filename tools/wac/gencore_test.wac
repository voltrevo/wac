// `core`'s embedding is the one `core/` generates.
//
// `packages/wacc/src/coretext.wac` is written by `wac task gen:core` from `core/read.wac`,
// `core/text.wac`, its siblings and `std/platform.wac`, and which declarations wacc gets is
// said by which file they are in. `core/README.md` is the argument.
//
// **This is here because nothing else runs the check.** `wac task gen:core --check` answers it,
// and `wac task docs` is not the gate — `tools/push.sh` runs the suite. A generated file whose
// generator nobody runs is two files drifting apart with a comment claiming they cannot, which is
// the state this replaced: two hand-maintained embeddings of the same declarations.
//
// It spawns the generator rather than recomputing the answer, because recomputing it here would be
// a second implementation of it and the two could then disagree about what "in step" means.

import { binaryPath } from "../../packages/wactest/src/host.wac";
import { T } from "../../packages/wactest/src/assert.wac";
import { contains } from "../../packages/wactest/src/strings.wac";
import { coreFileNames } from "../../packages/wacc/src/coretext.wac";
import { Core, Cli, Exec, FileResult } from "std";

export string test_the_embeddings_are_in_step_with_the_core_tree(Core core, Cli cli) {
  T t = T.create();
  Exec r = cli.exec(binaryPath(cli), ["task", "gen:core", "--check"], u8[]()).wait();
  t.isTrue(r.ran(), "the generator ran — " + r.error);
  if (!r.ran()) { return t.report(); }
  string said = string.fromBytes(r.stdout) + string.fromBytes(r.stderr);
  t.eqI32(r.status, 0,
          "`wac task gen:core --check` — run `wac task gen:core`:\n" + said);
  // The message on success, so a check that started answering nothing at all is not read as a pass.
  if (r.status == 0) {
    t.isTrue(contains(said, "in step"), "and it says so — got \"" + said + "\"");
  }
  return t.report();
}

export string test_the_tree_is_there_and_says_who_gets_what(Core core, Cli cli) {
  T t = T.create();
  // The canary for the test above: `--check` compares two files it generates from `core/`, and if
  // `core/` were empty it would compare two empty embeddings and agree. So the inputs are asserted
  // to exist and to hold the declarations they are the source of.
  // **`std/` is in this list for exactly the same reason.** It became the second embedded tree on
  // 2026-08-19 (`design/lang/0009` D4) and it is generated into the same file, so `--check` above
  // covers it — but this canary is what stops that check being vacuous, and a canary that names only
  // one of the two trees goes quiet about the other on the day somebody empties it.
  string[] files = [
                            "core/read.wac", "core/text.wac", "core/README.md",
                            "std/platform.wac", "std/README.md"
  ];
  string[] holds = [
                            "export enum Read", "export symbol @\"markup.text\"", "| `hash.wac` |",
                            "export struct Cli", "A capability, or the type of one"
  ];
  for (i32 i = 0; i < files.len(); i++) {
    FileResult f = cli.readFile(files[i]).wait();
    t.isTrue(f.ok, files[i] + " is there");
    if (f.ok) {
      t.isTrue(contains(string.fromBytes(f.bytes), holds[i]),
               files[i] + " holds " + holds[i]);
    }
  }

  FileResult wacc = cli.readFile("packages/wacc/src/coretext.wac").wait();
  t.isTrue(wacc.ok, "wacc's embedding is there");
  if (wacc.ok) {
    string text = string.fromBytes(wacc.bytes);
    t.isTrue(contains(text, "export enum Read"), "and it carries Read");
    t.isTrue(contains(text, "markup.text"), "and the markup symbols as well");
  }
  return t.report();
}

/**
 * `core`'s files pass `wac check`.
 *
 * Nothing else asks. A program that imports `core` is checked and `core` is not, so `core/ticket.wac`
 * read four nullable values without `!` — which the tour says narrowing does not excuse — and built
 * fine, because the emitter does not ask either. `std/platform.wac` is checked through the import it
 * makes of `"core"`, which is the same text.
 */
export string test_core_passes_the_checker(Core core, Cli cli) {
  T t = T.create();
  string[] files = coreFileNames();
  string[] args = string[].filled(files.len() + 2, "check");
  args.copyFrom(files, 0, 1, files.len());
  args[files.len() + 1] = "std/platform.wac";
  Exec r = cli.exec(binaryPath(cli), args, u8[]()).wait();
  t.isTrue(r.ran(), "wac check ran — " + r.error);
  if (!r.ran()) { return t.report(); }
  string said = string.fromBytes(r.stdout) + string.fromBytes(r.stderr);
  t.eqI32(r.status, 0, "`wac check` on core:\n" + said);
  // So a check that read nothing is not a pass: it names how many files it took.
  t.isTrue(contains(said, "no diagnostics"), "and it says so — got \"" + said + "\"");
  return t.report();
}
