// `MAP.md` is current, and so is the copy the website reads.
//
// Generated files with no guard are hand-written files that lie about where they came from. Both of
// these say "Generated — do not edit" at the top; this is what makes that true.
//
// It was tools/map.test.ts. The map half runs the generator's own `--check`, which is wac now
// (`tools/wac/map.wac`). The site half still shells out to Deno, and deliberately: `site/` is a vite
// subtree with npm resolution of its own, `site/src/data/built.ts` is a TypeScript artefact, and the
// script that writes it reads the root import map. That is the one place in this repository where
// Deno is the right tool rather than the incumbent one.
//
// The guard lives here rather than under `site/` because `site/` is excluded from the suite's walks
// — so a check placed there would be one nothing runs. `issues/system/0146` is what that cost.

import { T } from "../../packages/wactest/src/assert.wac";
import { Core, Cli, Exec, Stat, FileResult } from "std/platform.wac";
import { itoa } from "../../packages/fmt/src/itoa.wac";
import { contains } from "../../packages/wactest/src/strings.wac";

string binary(Cli cli) { return cli.cwd().wait() + "/native/v8/target/release/wac"; }

export string test_map_md_is_current(Core core, Cli cli) {
  T t = T.create();
  Stat bin = cli.stat(binary(cli)).wait();
  t.isTrue(bin.exists, "the binary that runs the generator is where the seed task writes it");
  if (!bin.exists) { return t.report(); }

  Exec r = cli.exec(binary(cli),
                    string[]("run", "--allow-read", "tools/wac/map.wac", "--check"), u8[0]()).wait();
  t.isTrue(r.ran(), "the generator starts: " + r.error);
  if (!r.ran()) { return t.report(); }
  t.eqI32(r.status, 0,
          "MAP.md is out of date — run `wac task map`. The generator said: " +
          string.fromBytes(r.stderr));
  return t.report();
}

/**
 * And the copy of it the website reads, which had the same bargain and none of the enforcement.
 *
 * `site/src/data/built.ts` says "Generated — do not edit by hand" at the top and nothing checked it,
 * so `raster` was in `MAP.md` and missing from the site for as long as nobody happened to regenerate.
 */
export string test_the_sites_generated_copy_is_current(Core core, Cli cli) {
  T t = T.create();
  Exec r = cli.exec("deno",
                    string[]("run", "--allow-read", "site/tools/syncMap.ts", "--check"),
                    u8[0]()).wait();
  // No Deno is a reason to say so, not a reason to pass: the site's generated file is either checked
  // or it is not, and a silent skip reads as coverage that was never there.
  t.isTrue(r.ran(), "deno runs the site's generator: " + r.error);
  if (!r.ran()) { return t.report(); }
  t.eqI32(r.status, 0,
          "site/src/data/built.ts is out of date — run `wac task site:map`. It said: " +
          string.fromBytes(r.stderr));
  return t.report();
}

/**
 * **The two lists of test-registering spellings say the same thing.**
 *
 * `harness/testRegistrars.ts` calls itself "every spelling that registers a Deno test, in one place"
 * and `tools/wac/map.wac` has its own copy of three of them, because there is no way for a wac file
 * and a TypeScript file to share a list of strings. So "one place" is a wish, and this is what makes
 * it true in the only way available: read both, compare.
 *
 * The incident is the reason. `testBounded` was added to the TypeScript and not to the counter, five
 * files in `ssh` and `tor` stopped having a literal `Deno.test(` in them, and **28 tests became
 * invisible** — MAP said the suite was smaller and nothing was wrong with the suite. Both files record
 * that, and neither could have caught it.
 *
 * `wacTestRun` is the fourth registrar and is deliberately *not* in the counter: it registers one test
 * per `export string test*` in a wac file, and those are counted from the wac. So the comparison is
 * over the ones marked `countsHere: true`, and the fourth being absent from `map.wac` is asserted too
 * — otherwise adding it there would double-count every wac test and this would say nothing.
 */
export string test_the_two_lists_of_test_registrars_agree(Core core, Cli cli) {
  T t = T.create();
  FileResult ts = cli.readFile("harness/testRegistrars.ts").wait();
  FileResult wac = cli.readFile("tools/wac/map.wac").wait();
  t.isTrue(ts.ok && wac.ok, "could not read both lists");
  if (!ts.ok || !wac.ok) { return t.report(); }
  string tsText = string.fromBytes(ts.bytes);
  string wacText = string.fromBytes(wac.bytes);

  string[] here = countsHere(tsText);
  // A floor, because a parser that found nothing would make every assertion below vacuous — which is
  // the shape of failure this file is about one level up.
  t.isTrue(here.len() >= 3,
           "only " + itoa(here.len()) + " `countsHere: true` registrar(s) parsed out of " +
           "harness/testRegistrars.ts — the shape of that file has changed");
  if (here.len() < 3) { return t.report(); }

  for (i32 i = 0; i < here.len(); i++) {
    t.isTrue(contains(wacText, "occurrences(src, \"" + here[i] + "\")"),
             "harness/testRegistrars.ts counts `" + here[i] + "` here and tools/wac/map.wac does " +
             "not — add it to `countTestsDeclaredHere`, or MAP will undercount every file that uses " +
             "it");
  }
  // And the delegate must stay out, or every wac test is counted twice.
  t.isTrue(!contains(wacText, "occurrences(src, \"wacTestRun(\")"),
           "tools/wac/map.wac counts `wacTestRun(` here, which double-counts every wac test: those " +
           "are counted from the wac file itself");
  return t.report();
}

/**
 * The `call:` strings in `testRegistrars.ts` whose entry says `countsHere: true`.
 *
 * A scan rather than `indexOf` from an offset, which wac's `string.indexOf` does not take. Each entry
 * is one line of the form `{ call: "…", countsHere: … },`, so the line is the unit and the parse is
 * two slices — and a shape change makes the floor in the caller fire rather than making this lie.
 */
string[] countsHere(string text) {
  string[] out = string[16](fill: "");
  i32 n = 0;
  i32 from = 0;
  for (i32 i = 0; i <= text.len(); i++) {
    if (i < text.len() && text.slice(i, i + 1) != "\n") { continue; }
    string line = text.slice(from, i);
    from = i + 1;
    if (!contains(line, "{ call: \"") || !contains(line, "countsHere: true")) { continue; }
    i32 open = line.indexOf("{ call: \"");
    i32 start = open + 9;
    i32 close = -1;
    for (i32 k = start; k < line.len() && close < 0; k++) {
      if (line.slice(k, k + 1) == "\"") { close = k; }
    }
    if (close > start && n < out.len()) { out[n] = line.slice(start, close); n = n + 1; }
  }
  string[] exact = string[n](fill: "");
  for (i32 i = 0; i < n; i++) { exact[i] = out[i]; }
  return exact;
}
