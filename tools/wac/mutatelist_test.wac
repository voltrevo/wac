// The list mode, end to end, against a fixture of two files.
//
// This is the first ported piece that is a *program* rather than a module, so the test drives it the
// way a person would — through the binary, with arguments — rather than calling into it. What that
// buys is the composition: gather, filter, generate and report are separately tested already, and
// this is the only thing that says they fit together. `issues/system/0161` step 6.

import { T } from "../../packages/wactest/src/assert.wac";
import { Change, Core, Cli, Exec } from "std/platform.wac";
import { itoa } from "../../packages/fmt/src/itoa.wac";
import { parseFlags } from "./mutatefiles.wac";

string ROOT() { return ".cache/mutatelist-fixture"; }

string write(Cli cli, string path, string text) {
  i32 cut = -1;
  for (i32 i = 0; i < path.len(); i++) {
    if (path.slice(i, i + 1) == "/") { cut = i; }
  }
  if (cut > 0) { cli.mkdir(path.slice(0, cut), true).wait(); }
  Change c = cli.writeFile(path, text.toBytes()).wait();
  return c.ok() ? "" : c.message;
}

bool holds(string haystack, string needle) {
  for (i32 i = 0; i + needle.len() <= haystack.len(); i++) {
    if (haystack.slice(i, i + needle.len()) == needle) { return true; }
  }
  return false;
}

/**
 * A source file with something to mutate, and a test file that must be left alone.
 *
 * The test file carries a comparison and a literal of its own, so "it was skipped" cannot be
 * confused with "there was nothing in it to find".
 */
string makeFixture(Cli cli) {
  cli.exec("bash", string[]("-c", "rm -rf '" + ROOT() + "'"), u8[0]()).wait();
  string why = write(cli, ROOT() + "/src/a.wac",
                     "export bool small(i32 n) {\n"
                     + "  if (n < 10) { return true; }\n"
                     + "  return false;\n"
                     + "}\n");
  if (why != "") { return why; }
  return write(cli, ROOT() + "/test/wac/a_test.wac",
               "export bool alsoSmall(i32 n) {\n"
               + "  if (n < 99) { return true; }\n"
               + "  return false;\n"
               + "}\n");
}

export string test_the_list_names_the_mutants_of_the_source_and_not_the_tests(Core core, Cli cli) {
  T t = T.create();
  string why = makeFixture(cli);
  t.eqStr(why, "", "the fixture was written");
  if (why != "") { return t.report(); }

  Exec r = cli.exec(cli.cwd().wait() + "/native/v8/target/release/wac",
                    string[]("run", "--allow-read", "tools/wac/mutatelist.wac", ROOT()),
                    u8[0]()).wait();
  string said = string.fromBytes(r.stdout) + string.fromBytes(r.stderr);
  t.isTrue(r.ran(), "the program ran");
  if (!r.ran()) { return t.report(); }
  t.eqI32(r.status, 0, "and answered success — " + said);

  // One file, because the test file is not code under test. That is the whole of the filter, and it
  // is visible in the count rather than only in the list.
  t.isTrue(holds(said, "over 1 file(s)"),
           "one file was mutated, not two: " + said);
  t.isTrue(holds(said, "relational/"), "a comparison was found: " + said);
  t.isTrue(holds(said, "extreme/"), "and the function body was gutted: " + said);
  t.isTrue(!holds(said, "a_test"),
           "and nothing from the test file, which has a comparison of its own: " + said);

  // The sampling line is printed whether or not it sampled anything, so a reader never has to wonder
  // whether the count is the whole population.
  t.isTrue(holds(said, "literal:"), "and it says what sampling left out: " + said);

  cli.exec("bash", string[]("-c", "rm -rf '" + ROOT() + "'"), u8[0]()).wait();
  return t.report();
}

export string test_it_says_what_it_wants_when_given_nothing(Core core, Cli cli) {
  T t = T.create();
  Exec r = cli.exec(cli.cwd().wait() + "/native/v8/target/release/wac",
                    string[]("run", "--allow-read", "tools/wac/mutatelist.wac"), u8[0]()).wait();
  string said = string.fromBytes(r.stdout) + string.fromBytes(r.stderr);
  t.isTrue(r.ran() && r.status != 0, "no argument is a failure rather than an empty report");
  t.isTrue(holds(said, "usage:"), "and it says what it wanted: " + said);
  return t.report();
}

string ops(string[] xs) {
  string out = "";
  for (i32 i = 0; i < xs.len(); i++) { out = out + (i == 0 ? "" : ",") + xs[i]; }
  return out;
}

/** The flags, apart from the program, which is why they are parsed apart from it. */
export string test_the_flags_are_the_references_spellings() {
  T t = T.create();
  t.eqStr(parseFlags(string[]("--package", "rlp")).dir, "packages/rlp",
          "--package names a package, not a path");
  t.eqStr(parseFlags(string[]("packages/rlp")).dir, "packages/rlp", "and a bare path is taken as given");
  t.eqStr(ops(parseFlags(string[]("d", "--operators=guard,extreme")).operators), "guard,extreme",
          "--operators= narrows the set");
  t.eqI32(parseFlags(string[]("d")).perShape, 3, "three literals per shape by default");
  t.isTrue(parseFlags(string[]("d", "--no-sample")).perShape > 1000000,
           "and --no-sample means every one, which is the flag for a survivor sampling might hide");

  // A flag that wants a value and does not get one is refused rather than ignored.
  t.isTrue(parseFlags(string[]("--package")).problem != "", "--package with nothing after it");
  t.isTrue(parseFlags(string[]("--nonsense", "d")).problem != "",
           "an unknown flag is refused rather than read as a directory");
  t.isTrue(parseFlags(string[]("a", "b")).problem != "",
           "and two directories is a mistake worth naming, not a silent choice of one");
  t.eqStr(parseFlags(string[0](fill: "")).dir, "", "no arguments names no directory");
  return t.report();
}

/** `--operators=` really narrows what is generated, not just what is parsed. */
export string test_narrowing_the_operators_narrows_the_output(Core core, Cli cli) {
  T t = T.create();
  string bin = cli.cwd().wait() + "/native/v8/target/release/wac";
  Exec all = cli.exec(bin, string[]("run", "--allow-read", "tools/wac/mutatelist.wac",
                                    "--package", "rlp"), u8[0]()).wait();
  Exec guard = cli.exec(bin, string[]("run", "--allow-read", "tools/wac/mutatelist.wac",
                                      "--package", "rlp", "--operators=guard"), u8[0]()).wait();
  t.isTrue(all.ran() && guard.ran(), "both runs happened");
  if (!all.ran() || !guard.ran()) { return t.report(); }
  string a = string.fromBytes(all.stdout);
  string g = string.fromBytes(guard.stdout);
  t.isTrue(holds(a, "relational/"), "the full set has comparisons");
  t.isTrue(!holds(g, "relational/"), "and the narrowed one does not: " + g.slice(0, 80));
  t.isTrue(holds(a, "over 1 file(s)") && holds(g, "over 1 file(s)"),
           "both looked at the same file, so the difference is the operator set and not the walk");
  return t.report();
}

/**
 * `--triage` compiles each mutant and says how many are worth running.
 *
 * **A count of zero equivalents is the honest answer here, not a broken comparison.** TCE finds a
 * mutant equivalent when the emitter folds the difference away and wacc does not fold, so almost
 * nothing is. That the comparison *can* report equality is proved in `mutatetriage_test.wac`, where a
 * whitespace-only change hashes identically; what this asserts is that every mutant was accounted
 * for, which is the property a miscount would break.
 */
export string test_triage_accounts_for_every_mutant(Core core, Cli cli) {
  T t = T.create();
  string why = makeFixture(cli);
  t.eqStr(why, "", "the fixture was written");
  if (why != "") { return t.report(); }

  Exec r = cli.exec(cli.cwd().wait() + "/native/v8/target/release/wac",
                    string[]("run", "--allow-read", "tools/wac/mutatelist.wac", ROOT(), "--triage"),
                    u8[0]()).wait();
  string said = string.fromBytes(r.stdout) + string.fromBytes(r.stderr);
  t.isTrue(r.ran() && r.status == 0, "the triage pass ran — " + said);
  if (!r.ran()) { return t.report(); }
  t.isTrue(holds(said, " to run, "), "it reports how many are worth running: " + said);
  t.isTrue(holds(said, "provably equivalent"), "and how many are not, by name: " + said);
  t.isTrue(holds(said, "not counted as killed"),
           "and says why excluding them keeps a score honest: " + said);

  cli.exec("bash", string[]("-c", "rm -rf '" + ROOT() + "'"), u8[0]()).wait();
  return t.report();
}
