// Running a wac test through `wac`, for the mutation runner — the wac side of `tools/mutate/native.ts`.
//
// `issues/system/0161` step 2. Once the `.test.ts` wrappers are deleted (step 3) there is no Deno
// path to those tests at all, so `mutate` has to be able to run them itself.
//
// ## The exit codes, which are the whole point
//
// A mutation runner reads an exit code as a verdict, so conflating two of them corrupts a score
// silently. `wac test` distinguishes them and this is where that contract is written down:
//
//   0  the selected tests ran and passed                   -> the mutant SURVIVED
//   3  the selected tests ran and one failed               -> the mutant was KILLED
//   1  nothing matched the filter, or a file did not run   -> ABORT, score nothing
//   4  every test needs a host oracle this cannot supply   -> nothing ran here
//
// **1 is the dangerous one and it is dangerous in the unobvious direction.** A filter that matches
// nothing is a *tooling* failure — the name was misspelled, or the profile and the runner disagree
// about which spelling a test has. It exits non-zero, so a runner that treats "non-zero means killed"
// records a kill for a mutant nothing ran, and the mutation score goes *up*. The Deno path has the
// mirror-image hazard: `deno test --filter nonsense` exits **0** with "0 filtered out", and the same
// mutant is recorded as having survived. Both are wrong and neither is visible in a score, which is
// why `classify` returns a verdict rather than a boolean.

import { itoa } from "../../packages/fmt/src/itoa.wac";

export string WAC_BIN() { return "native/v8/target/release/wac"; }

/** What an exit code from `wac test` means to a mutation run. */
export enum Verdict {
  Survived, Killed, NoTestsHere,
  /** Nothing ran, and that is a fault in the run rather than a fact about the mutant. */
  Abort(string why)

  bool isKilled(const this) {
    return match (this) {
      case Killed: true, case Survived: false, case NoTestsHere: false, case Abort(_): false
    };
  }

  bool isAbort(const this) {
    return match (this) {
      case Abort(_): true, case Killed: false, case Survived: false, case NoTestsHere: false
    };
  }

  bool isSurvived(const this) {
    return match (this) {
      case Survived: true, case Killed: false, case NoTestsHere: false, case Abort(_): false
    };
  }

  /** The word a report prints, and what `mergeRuns`'s decision table is written against. */
  string word(const this) {
    return match (this) {
      case Survived: "survived",
      case Killed: "killed",
      case NoTestsHere: "no-tests-here",
      case Abort(_): "abort"
    };
  }
}

/**
 * The argv for running some or all of a wac test file's tests.
 *
 * `entry` is the `.wac` test file or a directory of them; `filter` is a native export name such as
 * `test_basics`, and `""` means run everything in `entry`.
 *
 * `--filter` matches by **substring**, as Deno's plain filter does.
 */
export string[] wacTestArgs(string entry, string filter) {
  return filter == "" ? string[]("test", entry) : string[]("test", "--filter", filter, entry);
}

export Verdict classify(i32 code) {
  if (code == 0) { return Verdict.Survived; }
  if (code == 3) { return Verdict.Killed; }
  if (code == 4) { return Verdict.NoTestsHere; }
  if (code == 1) {
    return Verdict.Abort(
      "nothing matched the filter, or a file did not run — the selected test could not be "
      + "run at all, so this mutant has no verdict. Scoring it either way is a made-up number.");
  }
  return Verdict.Abort("unexpected exit " + itoa(code) + " from `wac test`");
}

bool holds(string[] xs, string want) {
  for (i32 i = 0; i < xs.len(); i++) {
    if (xs[i] == want) { return true; }
  }
  return false;
}

/** The second path segment: `packages/fs/test/wac` is `fs`, and `""` when there is not one. */
string packageOf(string dir) {
  i32 first = dir.indexOf("/");
  if (first < 0) { return ""; }
  string rest = dir.slice(first + 1, dir.len());
  i32 second = rest.indexOf("/");
  return second < 0 ? rest : rest.slice(0, second);
}

/**
 * Whether these directories are run by the binary rather than by Deno.
 *
 * Two ways to qualify, and the second is the one `issues/system/0161` step 2 needed.
 *
 * **By package**, the original rule: every directory belongs to a package holding no `.test.ts` at
 * all. **By directory**, the new one: every directory is one the profile proved runnable. The package
 * question disqualifies `packages/wacc/test/wac` — ninety wac files and no TypeScript — on the
 * strength of three `.test.ts` a level above it that the runner is never handed.
 *
 * The directory rule needs the profile's evidence and not just the absent `.test.ts`, because a
 * directory can hold a wac test that wants a host oracle. The binary skips such a test, the others
 * pass, the run exits 0, and the mutant is recorded **survived** by a suite that never ran the test
 * that would have killed it. False survivals are the one direction that cannot be spot-checked.
 *
 * An empty list is not a native run: `wac test` with no directories has nothing to select from.
 */
export bool isWacRun(string[] dirs, string[] hostlessPackages, string[] nativeRunnableDirs) {
  if (dirs.len() == 0) { return false; }
  bool allHostless = true;
  for (i32 i = 0; i < dirs.len(); i++) {
    if (!holds(hostlessPackages, packageOf(dirs[i]))) { allHostless = false; break; }
  }
  if (allHostless) { return true; }
  for (i32 i = 0; i < dirs.len(); i++) {
    if (!holds(nativeRunnableDirs, dirs[i])) { return false; }
  }
  return true;
}

/**
 * The scope split into the halves `mergeRuns` merges — *"split here, merge below"*.
 *
 * A mixed scope is **two runs, not one**: a set holding both a directory the binary runs and one Deno
 * runs would go to Deno entire. That is correct only while the wrappers exist; after step 3 of
 * `issues/system/0161` deletes them the wac half cannot run under Deno at all, so it silently does
 * not run and the mutant reads as **survived**.
 *
 * **One half, not two, when the scope is uniform**, and the whole `runDirs` is returned rather than
 * the half that happens to be non-empty. They are the same list, and returning the original keeps the
 * caller's single-run path taking exactly the argument it took before there was a split.
 */
export string[][] splitHalves(string[] runDirs, string[] hostlessPackages,
                              string[] nativeRunnableDirs) {
  i32 wacs = 0;
  for (i32 i = 0; i < runDirs.len(); i++) {
    if (isWacRun(string[](runDirs[i]), hostlessPackages, nativeRunnableDirs)) { wacs = wacs + 1; }
  }
  i32 denos = runDirs.len() - wacs;
  if (wacs == 0 || denos == 0) { return string[][](runDirs); }

  string[] wac = string[wacs](fill: "");
  string[] deno = string[denos](fill: "");
  i32 w = 0;
  i32 d = 0;
  for (i32 i = 0; i < runDirs.len(); i++) {
    if (isWacRun(string[](runDirs[i]), hostlessPackages, nativeRunnableDirs)) {
      wac[w] = runDirs[i];
      w = w + 1;
    } else {
      deno[d] = runDirs[i];
      d = d + 1;
    }
  }
  return string[][](wac, deno);
}

/**
 * One verdict from the halves of a **mixed** scope — some directories run by the binary, the rest by
 * Deno.
 *
 * The order of the rules is the whole content:
 *
 * - **`killed` wins outright.** A half that caught the mutant caught it; that the other half could
 *   not run does not make the catch less true.
 * - **`abort` beats `survived`.** A half that could not run might have been the half that killed it,
 *   so "everything I managed to run passed" is not a statement that the mutant survived. This is the
 *   direction that matters: the made-up number here flatters the suite.
 * - **`no-tests-here` is an absence, not a verdict**, and defers to whatever the other half saw. Two
 *   absences are still an absence.
 */
export Verdict mergeRuns(Verdict[] parts) {
  if (parts.len() == 0) { return Verdict.NoTestsHere; }
  for (i32 i = 0; i < parts.len(); i++) {
    if (parts[i].isKilled()) { return parts[i]; }
  }
  for (i32 i = 0; i < parts.len(); i++) {
    if (parts[i].isAbort()) { return parts[i]; }
  }
  for (i32 i = 0; i < parts.len(); i++) {
    if (parts[i].isSurvived()) { return parts[i]; }
  }
  return Verdict.NoTestsHere;
}

bool isWordChar(string c) {
  return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "_";
}

/** `\b<word>\b` in `source` — the word, not the letters inside a longer identifier. */
bool namesWord(string source, string word) {
  for (i32 i = 0; i + word.len() <= source.len(); i++) {
    if (source.slice(i, i + word.len()) != word) { continue; }
    bool leftOk = i == 0 || !isWordChar(source.slice(i - 1, i));
    i32 after = i + word.len();
    bool rightOk = after >= source.len() || !isWordChar(source.slice(after, after + 1));
    if (leftOk && rightOk) { return true; }
  }
  return false;
}

/**
 * Whether a test file spawns processes of its own, decided by what it names.
 *
 * **`--jobs` counts mutant runs, not processes, and that is the trap.** Several test files here are
 * themselves swarms: `packages/box/test/box.test.ts` spawns about three hundred built binaries, each
 * a process plus a worker. Four such jobs is not four processes, it is hundreds — and the machine is
 * shared, so a fifty-second suite next door took over half an hour — `issues/system/0031`, the one
 * titled "a mutation sweep starves every other agent on this machine" rather than the box one that
 * shares its number.
 *
 * **Read from what the file names rather than from a list of packages**, because a hand-kept list is
 * wrong the first time somebody writes a spawning test in a package that is not on it — and wrong
 * *silently*, which is the direction that matters. `buildApp` and `appRunner` are the two doors to a
 * built program; `spawnChild` is the third, for tests that drive the worker protocol themselves.
 */
export bool spawnsProcesses(string source) {
  return namesWord(source, "buildApp") || namesWord(source, "appRunner")
      || namesWord(source, "spawnChild") || namesWord(source, "workerSource");
}

/**
 * How many mutants to run at once for a scope, given what its tests do.
 *
 * An explicit `--jobs` wins: the caller asked. Otherwise one spawning file in the scope drops the
 * whole scope to one, because the cost is the processes rather than the files.
 *
 * A file that could not be read is not evidence of anything and the others still decide — passing `""`
 * for it says so.
 */
export i32 jobsFor(string[] sources, i32 explicitJobs, i32 defaultJobs) {
  if (explicitJobs > 0) { return explicitJobs; }
  for (i32 i = 0; i < sources.len(); i++) {
    if (spawnsProcesses(sources[i])) { return 1; }
  }
  return defaultJobs;
}


/** What a mutant's run came to, once both halves have answered. */
export struct Outcome {
  bool killed;
  /** The profile said nothing reaches this line, *and* the run bore that out. */
  bool notCovered;
  /** Non-empty when the run answered neither pass nor failure, so this mutant has no verdict. */
  string noVerdict;
}

/**
 * The result of running one mutant.
 *
 * **A timeout counts as killed**, because an infinite loop is a detected defect rather than a silent
 * one — a mutation that makes the program not terminate is exactly the kind a suite should catch, and
 * the deadline is generous enough (`mutatedeadline.wac`) that reaching it is not "a bit slow".
 *
 * **`notCovered` only survives if the mutant did.** The profile saying no test reaches a line is a
 * claim about coverage; a mutant that *died* on that line was reachable after all, whatever its own
 * line's counter says — a constant-returning function is inlined into its call sites, so the counter
 * stays at zero while the value reaches every caller. Reporting "nothing executes this" about a
 * mutation something just caught is the contradiction this rule prevents. `issues/system/0005`.
 *
 * **An abort is not a verdict and neither is an absence.** Both leave `noVerdict` set, so the caller
 * scores nothing rather than guessing — which is the whole reason `classify` returns a verdict rather
 * than a boolean.
 */
export Outcome outcomeOf(bool timedOut, Verdict[] verdicts, bool notCovered) {
  if (timedOut) { return Outcome(true, false, ""); }
  Verdict v = mergeRuns(verdicts);
  bool killed = v.isKilled();
  string why = "";
  if (!killed && !v.isSurvived()) {
    why = match (v) {
      case NoTestsHere: "nothing in that scope ran",
      case Abort(reason): reason,
      case Killed: "",
      case Survived: ""
    };
  }
  return Outcome(killed, notCovered && !killed, why);
}
