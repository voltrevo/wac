// Every runnable program in this repository, found the way `MAP.md` finds them.
//
// **One definition of "a program"**, so the map and the check that compiles them all cannot disagree.
// Two copies of this rule would drift, and the drift would be invisible in the direction that
// matters: a program the check does not know about is a program nothing compiles, which is
// `issues/system/0079`.
//
// A program is a `.wac` file outside a `test/` directory exporting `main` or `page`. That is the
// whole rule — `packages/platform`'s entry point dispatches on exactly those two names, so anything
// else is a library however it is written. A `main` taking a `Page` is a page too: `packages/web`'s.
//
// This was `harness/programs.ts`, and it is the reason the map generator could not be ported on its
// own: seven tools files read that one definition, and moving the map without moving this would have
// made an eighth copy of the rule. Not a test file and not discovered as one: `wac test` walks
// `*_test.wac`. `issues/system/0161`.

import { Cli, FileResult, Stat } from "std";
import { isSpace } from "../../packages/wactest/src/strings.wac";

/** A `main` — something with a command line. */
export static i32 KIND_CLI = 0;
/** A `page`, or a `main(Page page)` — something a browser opens. */
export static i32 KIND_PAGE = 1;

export struct Program {
  /** Repository-relative, as `MAP.md` prints it. */
  string path;
  i32 kind;
  /** The package it belongs to, which is the first path segment under `packages/`. */
  string pkg;
  /** The opening comment line, which every entry point here has. */
  string blurb;
}

/** The first line of a program's opening comment, trimmed of its slashes. */
export string blurbOf(string src) {
  i32 nl = src.indexOf("\n");
  string first = nl < 0 ? src : src.slice(0, nl);
  if (first.len() < 2 || first.slice(0, 2) != "//") { return ""; }
  return trim(first.slice(2, first.len()));
}

string trim(string s) {
  i32 from = 0;
  while (from < s.len() && isSpace(s.slice(from, from + 1))) { from = from + 1; }
  i32 to = s.len();
  while (to > from && isSpace(s.slice(to - 1, to))) { to = to - 1; }
  return s.slice(from, to);
}

/** Whether `src` has `export i32 <name>(` at the start of a line. */
bool exportsEntry(string src, string name) { return entryLine(src, name) != ""; }

/**
 * The line exporting `name` as an entry — `export <type> name(`, at the start of a line, with or
 * without `async` — from the parameters on, or "" when there is none. **Any return type**: a `main`
 * answers `i32`, `Result<i32, string>` (`packages/ethrpc/example`) or, `async`, a page's `i32` — and
 * matching only `export i32 main(` had dropped both of the others from this list, and from everything
 * that compiles what it finds.
 */
string entryLine(string src, string name) {
  string needle = " " + name + "(";
  i32 from = 0;
  while (from < src.len()) {
    i32 nl = src.slice(from, src.len()).indexOf("\n");
    string line = nl < 0 ? src.slice(from, src.len()) : src.slice(from, from + nl);
    if (line.len() > 7 && line.slice(0, 7) == "export ") {
      i32 at = line.indexOf(needle);
      // The name comes after a type and before its parameters; `export { … }` and a field never match.
      if (at > 7 && line.slice(0, at).indexOf("(") < 0 && line.slice(0, at).indexOf("=") < 0) {
        return line.slice(at + needle.len(), line.len());
      }
    }
    if (nl < 0) { break; }
    from = from + nl + 1;
  }
  return "";
}

/** Whether `main` takes a `Page` — a `packages/web` page, which a browser opens. */
bool isWebPage(string src) {
  string params = entryLine(src, "main");
  return params.len() >= 5 && params.slice(0, 5) == "Page ";
}

bool hasSuffix(string s, string suffix) {
  return s.len() >= suffix.len() && s.slice(s.len() - suffix.len(), s.len()) == suffix;
}

/**
 * Every program, sorted by path.
 *
 * Excludes `test/` deliberately: a wac test file exports `test_*` functions and is run by the
 * harness, not by anybody's command line.
 *
 * Excludes `size/` for the same kind of reason. A `size/` directory under a package exists to be
 * **weighed** — `tools/wac/size.wac` compiles those to compare layers. A size fixture that measures a
 * *capability boundary* has to export `main`, because the boundary only exists for `main`'s
 * parameters, and counting those as programs would put seven weights in the repository's tally of
 * things a person can run.
 */
export Program[] findPrograms(Cli cli) {
  Program[] out = Program[].filled(512, Program("", 0, "", ""));
  i32 n = 0;
  string[]? pkgs = cli.readDir("packages").wait();
  if (pkgs is null) { trap; }
  string[] names = sorted(pkgs!);
  for (i32 i = 0; i < names.len(); i++) {
    string pkg = names[i];
    Stat st = cli.stat("packages/" + pkg).wait();
    if (!st.exists || !st.isDir) { continue; }
    string[] files = walk(cli, "packages/" + pkg);
    for (i32 k = 0; k < files.len() && n + 1 < out.len(); k++) {
      string rel = files[k];
      if (!hasSuffix(rel, ".wac")) { continue; }
      if (rel.indexOf("/test/") >= 0 || rel.indexOf("/size/") >= 0) { continue; }
      FileResult r = cli.readFile(rel).wait();
      if (!r.ok) { continue; }
      string src = string.fromBytes(r.bytes);
      string blurb = blurbOf(src);
      if (exportsEntry(src, "main")) {
        out[n] = Program(rel, isWebPage(src) ? KIND_PAGE : KIND_CLI, pkg, blurb);
        n = n + 1;
      }
      if (exportsEntry(src, "page")) {
        out[n] = Program(rel, KIND_PAGE, pkg, blurb);
        n = n + 1;
      }
    }
  }
  Program[] exact = Program[].filled(n, Program("", 0, "", ""));
  for (i32 i = 0; i < n; i++) { exact[i] = out[i]; }
  return byPath(exact);
}

/** Every file under `dir`, recursively, repository-relative. */
string[] walk(Cli cli, string dir) {
  string[] out = string[].filled(4096, "");
  i32 n = 0;
  string[] stack = string[].filled(1024, "");
  i32 top = 0;
  stack[top] = dir;
  top = 1;
  while (top > 0 && n < out.len()) {
    top = top - 1;
    string at = stack[top];
    string[]? entries = cli.readDir(at).wait();
    if (entries is null) { continue; }
    string[] es = entries!;
    for (i32 i = 0; i < es.len(); i++) {
      string path = at + "/" + es[i];
      Stat st = cli.stat(path).wait();
      if (st.isDir) {
        if (top < stack.len()) { stack[top] = path; top = top + 1; }
        continue;
      }
      if (n < out.len()) { out[n] = path; n = n + 1; }
    }
  }
  string[] exact = string[].filled(n, "");
  for (i32 i = 0; i < n; i++) { exact[i] = out[i]; }
  return exact;
}

/** Insertion sort by name — the corpus is a few dozen, and a stable order keeps output diffable. */
string[] sorted(string[] names) {
  string[] out = string[].filled(names.len(), "");
  for (i32 i = 0; i < names.len(); i++) { out[i] = names[i]; }
  for (i32 i = 1; i < out.len(); i++) {
    string v = out[i];
    i32 j = i - 1;
    while (j >= 0 && out[j] > v) { out[j + 1] = out[j]; j = j - 1; }
    out[j + 1] = v;
  }
  return out;
}

/** The same, by path, so the map does not shuffle between runs. */
export Program[] byPath(Program[] ps) {
  Program[] out = Program[].filled(ps.len(), Program("", 0, "", ""));
  for (i32 i = 0; i < ps.len(); i++) { out[i] = ps[i]; }
  for (i32 i = 1; i < out.len(); i++) {
    Program v = out[i];
    i32 j = i - 1;
    while (j >= 0 && out[j].path > v.path) { out[j + 1] = out[j]; j = j - 1; }
    out[j + 1] = v;
  }
  return out;
}
