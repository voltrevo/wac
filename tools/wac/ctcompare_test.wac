// `wac build --trace` and `wac ctcompare` — the pair that makes a constant-time question answerable.
//
// A traced build records an *ordered journal* of `(site, value)`: every branch taken and every array
// index, in the order they happened. Two runs that differ only in a secret must produce the same
// journal, and where they do not is where the secret was observed. That is the question
// `packages/crypto`'s constant-time tests ask, and until these two commands existed it could only be
// asked from JavaScript — a TypeScript harness instantiated the module and walked the journal in
// process.
//
// **The comparison is the command, and that is the whole design.** `covdump` can already print a
// traced module's counter array, because a trace reuses the same three exports and only changes what
// the array means. Printing it is the wrong wire for it: `p256PublicKey` produces about three million
// events, so a caller would parse tens of megabytes twice to learn one number. `ctcompare` walks both
// journals where the modules are and answers in one line, in about half a second.
//
// The hash in each name is the spec claim it checks — `[§wac-cli-ctcompare-6knq4wp]` in
// `spec/cli/wac.md`. A wac export cannot hold the bracketed spelling, so the suffix carries it.
//
// **The two programs must differ only in their data.** Both drivers here are the same source with one
// constant changed, because `main`'s own points are in the journal too: a pair written with different
// *shapes* — a loop in one and two assignments in the other — parts at event 1, which is the driver
// and not the routine. That cost a measurement before it was noticed.

import { T } from "../../packages/wactest/src/assert.wac";
import { binaryPath, freshDir, scratch } from "../../packages/wactest/src/host.wac";
import { contains, startsWith, trimmed, splitLines } from "../../packages/wactest/src/strings.wac";
import { itoa } from "../../packages/fmt/src/itoa.wac";
import { Core, Cli, Exec, Change, FileResult, execReason} from "std/platform.wac";

/**
 * A program whose secret decides an array index and nothing else.
 *
 * One branch point per run either way, so counting branches calls it uniform — which is the whole
 * reason indices are recorded.
 */
string indexed(i32 secret) {
  return "const u8[] SBOX = u8[](3, 1, 4, 1, 5, 9, 2, 6);\n" +
         "export i32 main() {\n" +
         "  i32 secret = " + itoa(secret) + ";\n" +
         "  return SBOX[secret & 7];\n" +
         "}\n";
}

/** A program that reads its secret and cannot leak it: the work is the same either way. */
string uniform(i32 secret) {
  return "export i32 main() {\n" +
         "  i32 secret = " + itoa(secret) + ";\n" +
         "  i32 acc = 0;\n" +
         "  for (i32 i = 0; i < 8; i++) { acc = acc + (secret & 1); }\n" +
         "  return acc;\n" +
         "}\n";
}

/** A program whose secret decides a branch. */
string branching(i32 secret) {
  return "export i32 main() {\n" +
         "  i32 secret = " + itoa(secret) + ";\n" +
         "  if (secret > 10) { return 1; }\n" +
         "  return 0;\n" +
         "}\n";
}

/** Build one traced module, answering the stem or the empty string. */
string built(T t, Cli cli, string dir, string name, string src) {
  string entry = dir + "/" + name + ".wac";
  Change wrote = cli.writeFile(entry, src.toBytes()).wait();
  t.isTrue(wrote.ok(), name + ": writing the source — " + wrote.message);
  if (!wrote.ok()) { return ""; }
  Exec r = cli.exec(binaryPath(cli),
                    string[]("build", entry, "--trace", "-o", dir + "/" + name, "--quiet"),
                    u8[0]()).wait();
  t.isTrue(r.ran() && r.status == 0,
           name + ": the traced build — " + execReason(r));
  return (r.ran() && r.status == 0) ? dir + "/" + name : "";
}

/** `ctcompare`, with its whole answer trimmed. */
string compared(T t, Cli cli, string a, string b, bool all) {
  string[] argv = all ? string[]("ctcompare", "--all", a + ".wasm", b + ".wasm")
                      : string[]("ctcompare", a + ".wasm", b + ".wasm");
  Exec r = cli.exec(binaryPath(cli), argv, u8[0]()).wait();
  t.isTrue(r.ran() && r.status == 0,
           "ctcompare ran — " + execReason(r));
  return (r.ran() && r.status == 0) ? trimmed(string.fromBytes(r.stdout)) : "<did not run>";
}

/** The `kind` and `line` of one site, out of the table the build wrote beside the module. */
string siteAt(Cli cli, string stem, i32 site) {
  FileResult f = cli.readFile(stem + ".trace").wait();
  if (!f.ok) { return "<no table: " + f.error + ">"; }
  string[] rows = splitLines(string.fromBytes(f.bytes));
  string want = itoa(site) + "\t";
  for (i32 i = 0; i < rows.len(); i++) {
    if (startsWith(rows[i], want)) {
      // index, line, col, kind, file
      string[] parts = string[5](fill: "");
      i32 n = 0;
      string cur = "";
      for (i32 k = 0; k < rows[i].len(); k++) {
        if (rows[i].slice(k, k + 1) == "\t") {
          if (n < 5) { parts[n] = cur; n = n + 1; }
          cur = "";
        } else {
          cur = cur + rows[i].slice(k, k + 1);
        }
      }
      if (n < 5) { parts[n] = cur; n = n + 1; }
      return n >= 4 ? parts[3] + "@" + parts[1] : "<short row>";
    }
  }
  return "<no such site>";
}

export string test_a_secret_dependent_index_is_found_where_no_branch_differs_6knq4wp(
    Core core, Cli cli) {
  T t = T.create();
  string dir = scratch(cli, "ctcompare-index");
  string whyDir = freshDir(cli, dir);
  t.isTrue(whyDir == "", whyDir);
  string a = built(t, cli, dir, "a", indexed(1));
  string b = built(t, cli, dir, "b", indexed(2));
  if (a == "" || b == "") { cli.remove(dir, true).wait(); return t.report(); }

  string said = compared(t, cli, a, b, false);
  t.isTrue(startsWith(said, "differs "), "the index leak was not found: " + said);

  // Both runs stand at the *same* point with different values, which is what an index leak is and
  // what a branch counter cannot see. `--all` names the site, and the table says it is an index.
  string all = compared(t, cli, a, b, true);
  t.isTrue(startsWith(all, "site "), "--all did not name a site: " + all);
  if (startsWith(all, "site ")) {
    // `site <i> <site> <va> <vb>`
    string[] f = splitLines(all);
    string row = f.len() > 0 ? f[0] : "";
    i32 sp = 0;
    string[] parts = string[5](fill: "");
    i32 n = 0;
    string cur = "";
    for (i32 k = 0; k <= row.len(); k++) {
      string c = k < row.len() ? row.slice(k, k + 1) : " ";
      if (c == " ") { if (cur.len() > 0 && n < 5) { parts[n] = cur; n = n + 1; } cur = ""; }
      else { cur = cur + c; }
    }
    t.eqI32(n, 5, "a site line has five fields: " + row);
    if (n == 5) {
      t.eqStr(siteAt(cli, a, atoiOf(parts[2])), "index@4", "the site the table names");
    }
  }
  cli.remove(dir, true).wait();
  return t.report();
}

/** The `n`th whitespace-separated word of a line. */
string word(string line, i32 n) {
  i32 at = 0;
  string cur = "";
  for (i32 i = 0; i <= line.len(); i++) {
    string c = i < line.len() ? line.slice(i, i + 1) : " ";
    if (c == " " || c == "\n" || c == "\t") {
      if (cur.len() > 0) { if (at == n) { return cur; } at = at + 1; }
      cur = "";
    } else { cur = cur + c; }
  }
  return "";
}

/** Digits to an integer; -1 when it is not one. */
i32 atoiOf(string s) {
  u8[] b = s.toBytes();
  if (b.len() == 0) { return -1; }
  i32 v = 0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] < 48 || b[i] > 57) { return -1; }
    v = v * 10 + (b[i] - 48);
  }
  return v;
}

export string test_a_routine_that_does_not_look_at_its_secret_says_same_6knq4wp(Core core, Cli cli) {
  // **The canary for every other case here.** A comparison that finds a divergence everywhere is not
  // a check, and both of the leaks in this file are one line away from this program.
  T t = T.create();
  string dir = scratch(cli, "ctcompare-uniform");
  string whyDir = freshDir(cli, dir);
  t.isTrue(whyDir == "", whyDir);
  string a = built(t, cli, dir, "a", uniform(0));
  string b = built(t, cli, dir, "b", uniform(255));
  if (a == "" || b == "") { cli.remove(dir, true).wait(); return t.report(); }
  // **`same 24`, not `same`.** The count is the difference between agreement and a comparison of two
  // empty journals — a mistyped export calls nothing, records nothing, and matches perfectly. Both
  // forms are asserted, and the number is asserted to be a number greater than nothing.
  string said = compared(t, cli, a, b, false);
  t.isTrue(startsWith(said, "same "), "two runs that observe nothing: " + said);
  t.isTrue(atoiOf(said.slice(5, said.len())) > 0,
           "`same` over no events at all is not agreement: " + said);
  // And `--all` says so out loud rather than printing nothing, which is what a command that never ran
  // also prints.
  t.isTrue(startsWith(compared(t, cli, a, b, true), "same "), "--all on an identical pair");
  cli.remove(dir, true).wait();
  return t.report();
}

export string test_a_secret_dependent_branch_parts_the_two_runs_6knq4wp(Core core, Cli cli) {
  T t = T.create();
  string dir = scratch(cli, "ctcompare-branch");
  string whyDir = freshDir(cli, dir);
  t.isTrue(whyDir == "", whyDir);
  string a = built(t, cli, dir, "a", branching(1));
  string b = built(t, cli, dir, "b", branching(100));
  if (a == "" || b == "") { cli.remove(dir, true).wait(); return t.report(); }

  t.isTrue(startsWith(compared(t, cli, a, b, false), "differs "),
           "the branch leak was not found");
  // A branch leak is a *split*: the two runs are at different points, not at one point with different
  // values. `--all` stops there, because past it the journals are not aligned.
  string all = compared(t, cli, a, b, true);
  t.isTrue(startsWith(all, "split "), "a branch leak should be a split, got: " + all);
  cli.remove(dir, true).wait();
  return t.report();
}

export string test_a_module_with_no_journal_is_an_error_not_an_empty_comparison_6knq4wp(
    Core core, Cli cli) {
  // An uninstrumented module has no counters, and answering `same` for a pair of them would report
  // every routine in the repository as constant-time.
  T t = T.create();
  string dir = scratch(cli, "ctcompare-plain");
  string whyDir = freshDir(cli, dir);
  t.isTrue(whyDir == "", whyDir);
  string entry = dir + "/p.wac";
  cli.writeFile(entry, "export i32 main() { return 0; }\n".toBytes()).wait();
  Exec b = cli.exec(binaryPath(cli),
                    string[]("build", entry, "-o", dir + "/p", "--quiet"), u8[0]()).wait();
  t.isTrue(b.ran() && b.status == 0, "the plain build — " + string.fromBytes(b.stderr));
  if (!b.ran() || b.status != 0) { cli.remove(dir, true).wait(); return t.report(); }

  Exec r = cli.exec(binaryPath(cli),
                    string[]("ctcompare", dir + "/p.wasm", dir + "/p.wasm"), u8[0]()).wait();
  t.isTrue(r.ran(), "ctcompare ran — " + r.error);
  if (r.ran()) {
    t.eqI32(r.status, 1, "an uninstrumented module compared as though it had a journal");
    t.isTrue(contains(string.fromBytes(r.stderr), "no counters"),
             "the message names the cause: " + string.fromBytes(r.stderr));
  }

  Exec usage = cli.exec(binaryPath(cli), string[]("ctcompare"), u8[0]()).wait();
  t.isTrue(usage.ran() && usage.status == 2, "no arguments is a usage error");
  cli.remove(dir, true).wait();
  return t.report();
}

export string test_tracestat_reports_what_a_run_wanted_so_the_next_one_can_fit_6knq4wp(
    Core core, Cli cli) {
  // **The overflow has to be reported as a number, not as a flag.** A journal that filled up is the
  // normal case for anything expensive, and "it did not fit" leaves a caller doubling and retrying;
  // `wanted` says exactly how large the next attempt has to be. `--trace-slots` is the other half.
  T t = T.create();
  string dir = scratch(cli, "ctcompare-slots");
  string whyDir = freshDir(cli, dir);
  t.isTrue(whyDir == "", whyDir);

  // 40 iterations is more than eight slots can hold and far less than the default.
  const string SRC = "export i32 main() {\n" +
    "  i32 acc = 0;\n" +
    "  for (i32 i = 0; i < 40; i++) { acc = acc + i; }\n" +
    "  return acc;\n" +
    "}\n";
  string entry = dir + "/p.wac";
  cli.writeFile(entry, SRC.toBytes()).wait();

  Exec small = cli.exec(binaryPath(cli),
    string[]("build", entry, "--trace", "--trace-slots", "8", "-o", dir + "/small", "--quiet"),
    u8[0]()).wait();
  t.isTrue(small.ran() && small.status == 0,
           "the small build — " + string.fromBytes(small.stderr));
  if (!small.ran() || small.status != 0) { cli.remove(dir, true).wait(); return t.report(); }

  Exec r = cli.exec(binaryPath(cli), string[]("tracestat", dir + "/small.wasm"), u8[0]()).wait();
  t.isTrue(r.ran() && r.status == 0, "tracestat ran — " + string.fromBytes(r.stderr));
  if (!r.ran() || r.status != 0) { cli.remove(dir, true).wait(); return t.report(); }
  string said = trimmed(string.fromBytes(r.stdout));
  i32 events = atoiOf(word(said, 1));
  i32 wanted = atoiOf(word(said, 3));
  i32 slots = atoiOf(word(said, 5));
  t.eqI32(slots, 8, "the size is the caller's: " + said);
  t.isTrue(wanted > events, "it should have overflowed: " + said);
  t.isTrue(wanted > 40, "one point per iteration at least: " + said);

  // Sized from what the first run reported, the second fits — and `events` and `wanted` agree, which
  // is the whole claim.
  Exec big = cli.exec(binaryPath(cli),
    string[]("build", entry, "--trace", "--trace-slots", itoa(2 * wanted + 8),
             "-o", dir + "/big", "--quiet"), u8[0]()).wait();
  t.isTrue(big.ran() && big.status == 0, "the resized build — " + string.fromBytes(big.stderr));
  if (big.ran() && big.status == 0) {
    Exec r2 = cli.exec(binaryPath(cli), string[]("tracestat", dir + "/big.wasm"), u8[0]()).wait();
    string said2 = trimmed(string.fromBytes(r2.stdout));
    t.eqI32(atoiOf(word(said2, 1)), atoiOf(word(said2, 3)),
            "the resized journal did not fit what the first run asked for: " + said2);
    t.eqI32(atoiOf(word(said2, 3)), wanted, "the two runs counted different events: " + said2);
  }

  Exec usage = cli.exec(binaryPath(cli), string[]("tracestat"), u8[0]()).wait();
  t.isTrue(usage.ran() && usage.status == 2, "no arguments is a usage error");
  cli.remove(dir, true).wait();
  return t.report();
}

export string test_coverage_and_trace_cannot_be_asked_for_together_6knq4wp(Core core, Cli cli) {
  // They are one counter array meaning two things, so a build that tried to be both would answer
  // whichever question was asked last — silently, and only when someone read the numbers.
  T t = T.create();
  string dir = scratch(cli, "ctcompare-both");
  string whyDir = freshDir(cli, dir);
  t.isTrue(whyDir == "", whyDir);
  string entry = dir + "/p.wac";
  cli.writeFile(entry, "export i32 main() { return 0; }\n".toBytes()).wait();
  Exec r = cli.exec(binaryPath(cli),
                    string[]("build", entry, "--coverage", "--trace", "-o", dir + "/p", "--quiet"),
                    u8[0]()).wait();
  t.isTrue(r.ran(), "the build was attempted — " + r.error);
  if (r.ran()) {
    t.isTrue(r.status != 0, "it built both ways, which it must not");
    t.isTrue(contains(string.fromBytes(r.stderr), "one counter array"),
             "the refusal says why: " + string.fromBytes(r.stderr));
  }
  cli.remove(dir, true).wait();
  return t.report();
}
