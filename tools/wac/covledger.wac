// The exemption ratchet: which uncovered points are accounted for, and whether the account still holds.
//
// A coverage report that sits at 99.6% for ever teaches everyone to ignore the last line, and then a
// genuinely new gap arrives and looks like the one that was always there. So a package with unreachable
// code names each point and says why, and this checks the naming — in **both** directions, which is the
// contract `packages/gzip/test/cov_ledger.wac` carries and the one generalised here — stated first in
// that package's `cov.ts`, which this replaced:
//
//   > Anything not listed here is expected to be covered and the run fails if it is not — and anything
//   > listed that *does* get covered fails too, since the reason has stopped holding.
//
// Three ways a ledger can be wrong, and all three are failures:
//
//   1. **the pin drifted** — the line no longer holds the snippet it was pinned by. Keying an exclusion
//      on a line number alone is fragile in the obvious way: adding a comment above it silently moves
//      the exclusion onto whatever now sits at that line. gzip's list started out pointing at line 306
//      and the comment explaining why moved the code to 322;
//   2. **the reason stopped holding** — the point is pinned and is now covered, so the argument for
//      excluding it is wrong and the entry has to go;
//   3. **something new is uncovered** — a point nothing reaches with nothing said about it.
//
// ## The phrasing is an API — `issues/system/0222`
//
// `tools/coverageAll.ts` repeats each failing task's own explanation, and selects the lines to repeat by
// matching `no longer holds`, `is listed as unreach`, `branch point(s) uncovered` and a leading `error`.
// Those exact strings are what this emits. They are not decoration: gzip's `cov.ts` said
// "unreachable" where crypto's said "unreached", and a stale gzip entry therefore exited
// 1 with its only explanation filtered out of the summary — a reason with its subject removed.
//
// ## A line, not a point
//
// A pin names a `file:line`, and a line is *uncovered* when **any** point on it never ran. That is
// coarser than the counters and deliberately so: a reader writing down why something is unreachable is
// reasoning about a statement, not about which of the three branch points the emitter put on it. The
// cost is that a line carrying both a covered and an uncovered point reads as uncovered, which is the
// safe direction — it asks for an entry rather than hiding one.

import { Core, Cli, Exec, Change, FileResult } from "std/platform.wac";
import { itoa } from "../../packages/fmt/src/itoa.wac";
import { contains, startsWith, endsWith, trimmed } from "../../packages/wactest/src/strings.wac";
import { sourceFiles } from "../../packages/wactest/src/repo.wac";

/** One instrumented point: where it is and what kind. */
export struct Point {
  i32 index;
  string file;
  i32 line;
  i32 col;
  string kind;
}

/**
 * One accounted-for point, and the argument for it.
 *
 * `snippet` is checked against the source at `line` — see failure 1 above. `why` is printed on a good
 * run as well as a bad one, because a ledger nobody reads is a ledger nobody maintains.
 */
export struct Pin {
  string file;
  i32 line;
  string snippet;
  /**
   * **Whether no input can reach it, or whether we merely failed to build one.**
   *
   * Two different claims, and zstd's `cov.ts` is where the distinction was written down — it lives
   * in `packages/zstd/test/cov_ledger.wac` now:
   *
   *   - `true` — no input reaches it. A guard that cannot fire is still worth keeping when what it
   *     guards is worse than a wrong answer, but counting it as covered would make the number
   *     meaningless;
   *   - `false` — reachable, and nobody has constructed the input. That is a *gap*, not an exemption,
   *     and saying so is the whole point of the distinction. Reading a list of "unreachable" branches
   *     that quietly includes merely-difficult ones is how a coverage number stops meaning anything.
   *
   * Both are held to the same two-way contract: if a `proven: false` entry becomes covered, somebody
   * built the input and the entry has to go — which is the one failure here that is good news.
   */
  bool proven;
  string why;
}

/**
 * A **class** of accounted-for points, matched by a pattern rather than named one at a time.
 *
 * `packages/fs` is why this exists. Its ledger speaks for 127 uncovered points, and 94 of them are
 * one fact repeated: an arm that needs a `Cli` only a built program has, or a peer only a real parent
 * process can be. Ninety-four pins would each carry the same sentence, and the sentence is what
 * matters — so a rule states it once and says which points it covers.
 *
 * `scope` decides what `holds` is matched against:
 *
 *   - `"line"` — the uncovered point's own line;
 *   - `"decl"` — its enclosing declaration, the nearest line at or above it that opens a block at the
 *     top level *or one level in*. That is what a channel needs: the points are inside
 *     `remoteReadFile` and its fifteen siblings rather than on a line that says `Chan`, and naming the
 *     signature is both more accurate and harder to leave behind, since renaming the parameter breaks
 *     the rule;
 *   - `"struct"` — its enclosing `struct`, for a type whose *methods* are the unreachable thing, where
 *     each signature differs and only the type they hang off is shared.
 *
 * **A rule that matches nothing fails the run**, exactly as a moved pin does: it explains something
 * that is no longer there. That is what keeps a rule from being a blanket.
 */
export struct Rule {
  string file;
  string holds;
  string scope;
  bool proven;
  string why;
}

/**
 * `s` cut at every newline, **keeping the empty ones**.
 *
 * Not `splitLines` from `packages/wactest/src/strings.wac`, which drops them — that is right for a
 * test reading a program's output and wrong here, where the index into this array *is* a line number.
 * A file with one blank line in it would report every pin after that line as drifted, and the drift
 * message would name the line above the real one, which is the most confusing available answer.
 */
export string[] linesOf(string s) {
  i32 n = 1;
  for (i32 i = 0; i < s.len(); i++) { if (s.slice(i, i + 1) == "\n") { n = n + 1; } }
  string[] out = string[n](fill: "");
  i32 at = 0;
  string cur = "";
  for (i32 i = 0; i < s.len(); i++) {
    if (s.slice(i, i + 1) == "\n") { out[at] = cur; at = at + 1; cur = ""; }
    else { cur = cur + s.slice(i, i + 1); }
  }
  out[at] = cur;
  return out;
}

/** `harness/wacCoverage.ts`'s rule, kept exactly: a test's own branches are not the package's. */
export bool isTest(string file) {
  return contains(file, "/test/") || endsWith(file, "_test.wac");
}

export void sortStrings(string[] a, i32 n) {
  for (i32 i = 1; i < n; i++) {
    string v = a[i];
    i32 j = i - 1;
    while (j >= 0 && a[j] > v) { a[j + 1] = a[j]; j = j - 1; }
    a[j + 1] = v;
  }
}

// ## Measuring — build, run, join
//
// Everything from here down was inside `covreport.wac`'s `main`, which made it reachable only by
// spawning that program and reading its table back as text. A ledger wants the same numbers and a
// different verdict over them, so it is a function.

export string binary(Cli cli) { return cli.cwd().wait() + "/native/v8/target/release/wac"; }

/** The tab-separated fields of a row, padded to `want`. */
export string[] fields(string row, i32 want) {
  string[] out = string[want](fill: "");
  i32 n = 0;
  string cur = "";
  for (i32 i = 0; i <= row.len(); i++) {
    string c = i < row.len() ? row.slice(i, i + 1) : "\t";
    if (c == "\t") { if (n < want) { out[n] = cur; n = n + 1; } cur = ""; }
    else { cur = cur + c; }
  }
  return out;
}

export i32 numberOf(string s) {
  u8[] b = s.toBytes();
  if (b.len() == 0) { return -1; }
  i32 v = 0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] < 48 || b[i] > 57) { return -1; }
    v = v * 10 + (b[i] - 48);
  }
  return v;
}

/**
 * Whether every byte is a digit, so a row can be told from a heading.
 *
 * Separate from the value because a *count* may legitimately be negative and 0 is a meaningful
 * answer — "never reached" — so a parser that returned 0 for "not a number" would report a covered
 * branch as dead.
 */
bool isDigits(string s) {
  u8[] b = s.toBytes();
  if (b.len() == 0) { return false; }
  for (i32 i = 0; i < b.len(); i++) { if (b[i] < 48 || b[i] > 57) { return false; } }
  return true;
}

/** Whether `s` is a counter: digits, or a `-` and then digits. */
bool isCount(string s) {
  return s.len() > 1 && s.slice(0, 1) == "-" ? isDigits(s.slice(1, s.len())) : isDigits(s);
}

/**
 * A counter, **which may be negative**.
 *
 * The counters are `i32` and an exercise that runs one branch two billion times wraps it. `fmt`'s
 * does — 44 of its 518 — and `numberOf` above is written for *indices*, so it refuses a sign and a
 * wrapped count read as an unparseable row. The walk then stopped at the first one and the dump "had"
 * 474 counters against a 518-row table, reported as the two files not describing the same module: a
 * message about the artefacts rather than about arithmetic, and the wrong place to look entirely.
 *
 * Only zero-or-not is ever asked of a counter, so a wrapped one is as good as any other non-zero.
 * **The exception cannot be fixed here**: a counter that wraps to *exactly* zero reads as never
 * reached, and no parser can tell that from a branch nothing ran. That needs a saturating counter in
 * the instrumentation.
 */
i32 signedOf(string s) {
  if (s.len() > 1 && s.slice(0, 1) == "-") { return -numberOf(s.slice(1, s.len())); }
  return numberOf(s);
}

/** A path as one directory name: everything that is not a letter, a digit or `-` becomes `-`. */
export string slug(string path) {
  string out = "";
  for (i32 i = 0; i < path.len(); i++) {
    string c = path.slice(i, i + 1);
    bool plain = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") ||
                 c == "-";
    out = out + (plain ? c : "-");
  }
  return out;
}

/**
 * One coverage measurement: the table and the counters, agreed to describe the same module.
 *
 * `nPoints` is 0 when the measurement failed, and `measure` has already said why.
 */
export struct Measured {
  Point[] points;
  i32 nPoints;
  i32[] counts;
}

/**
 * Build `entry` with coverage, run it, and join the counters against the table.
 *
 * `grants` are what the *exercise* is compiled with — not a widening of what the caller may do, so an
 * exercise that reads a corpus says so and one that does not cannot. `exports` are called after `main`
 * with a trap caught around each, which is how a package's trapping branches are reached at all
 * (`issues/system/0221`).
 *
 * **An export named `name:<n>` is a sweep**: `covdump` calls `name(0)` through `name(n-1)`, each trap
 * caught. One name holds one trapping case, so a driver that damages a real frame at every byte needs
 * this rather than a name per byte — `spec/cli/wac.md`, `[§wac-cli-covdump-sweep-4tn8mr6]`.
 */
export Measured measure(Core core, Cli cli, string entry, string[] grants, string[] exports) {
  Measured none = Measured(Point[1](fill: Point(0, "", 0, 0, "")), 0, i32[1]());

  // **A directory per exercise, because `deno task coverage:all` runs four of these at once.**
  //
  // This was `.cache/covreport` for everyone, wiped on the way in. That was invisible while codec was
  // the only caller and became a failure the moment there was a second: one run deletes the directory
  // another is building into, and the loser reports *no coverage table beside the module* — a message
  // about its own output, naming nothing about the race. Named from the entry rather than a pid, so a
  // re-run of one package reuses its own directory and two packages can never share one.
  string dir = cli.cwd().wait() + "/.cache/covreport/" + slug(entry);
  cli.remove(dir, true).wait();
  cli.mkdir(dir, true).wait();
  string stem = dir + "/prog";

  string[] build = string[6 + grants.len()](fill: "");
  build[0] = "build";
  build[1] = entry;
  build[2] = "--coverage";
  for (i32 i = 0; i < grants.len(); i++) { build[3 + i] = grants[i]; }
  build[3 + grants.len()] = "-o";
  build[4 + grants.len()] = stem;
  build[5 + grants.len()] = "--quiet";
  Exec built = cli.exec(binary(cli), build, u8[0]()).wait();
  if (!built.ran() || built.status != 0) {
    core.warn("error: " + entry + " did not build — " + built.error +
              string.fromBytes(built.stderr));
    cli.remove(dir, true).wait();
    return none;
  }

  FileResult table = cli.readFile(stem + ".cov").wait();
  if (!table.ok) {
    core.warn("error: no coverage table beside the module — " + table.error);
    cli.remove(dir, true).wait();
    return none;
  }
  string[] dump = string[2 + exports.len()](fill: "");
  dump[0] = "covdump";
  dump[1] = stem + ".wasm";
  for (i32 i = 0; i < exports.len(); i++) { dump[2 + i] = exports[i]; }
  Exec dumped = cli.exec(binary(cli), dump, u8[0]()).wait();
  if (!dumped.ran() || dumped.status != 0) {
    core.warn("error: covdump — " + dumped.error + string.fromBytes(dumped.stderr));
    cli.remove(dir, true).wait();
    return none;
  }
  // **What covdump said even when it succeeded**, because the thing it says on a *good* run is that
  // one of the export names is not an export — and that reads from the outside as a package whose
  // trapping branches simply are not covered, which is the same number a real gap gives. A mistyped
  // name was silent until this line: `zzz_not_an_export` produced a clean report four branches short.
  string said = string.fromBytes(dumped.stderr);
  if (said.len() > 0) { core.warn(said); }

  // `<index>\t<count>` per counter, then a line saying how many. Anything else is not a dump.
  string[] dumpRows = linesOf(string.fromBytes(dumped.stdout));
  i32 nCounts = 0;
  for (i32 i = 0; i < dumpRows.len(); i++) {
    string[] f = fields(dumpRows[i], 2);
    if (numberOf(f[0]) == nCounts && isCount(f[1])) { nCounts = nCounts + 1; }
  }
  i32[] counts = i32[nCounts > 0 ? nCounts : 1]();
  i32 at = 0;
  for (i32 i = 0; i < dumpRows.len() && at < nCounts; i++) {
    string[] f = fields(dumpRows[i], 2);
    if (numberOf(f[0]) == at) { counts[at] = signedOf(f[1]); at = at + 1; }
  }

  // `index\tline\tcol\tkind\tfile` per counter, in counter order.
  string[] rows = linesOf(string.fromBytes(table.bytes));
  Point[] points = Point[rows.len()](fill: Point(0, "", 0, 0, ""));
  i32 nPoints = 0;
  for (i32 i = 0; i < rows.len(); i++) {
    if (rows[i].len() == 0) { continue; }
    string[] f = fields(rows[i], 5);
    i32 idx = numberOf(f[0]);
    if (idx < 0) { continue; }
    points[nPoints] = Point(idx, f[4], numberOf(f[1]), numberOf(f[2]), f[3]);
    nPoints = nPoints + 1;
  }
  cli.remove(dir, true).wait();

  // **Asserted, not assumed.** A table and a dump of different lengths is a module and a table that do
  // not describe each other, and every count read past the end would be a point reported as missed.
  if (nPoints != nCounts) {
    core.warn("error: the table has " + itoa(nPoints) + " points and the dump " + itoa(nCounts) +
              " counters; they do not describe the same module");
    return none;
  }
  if (nPoints == 0) {
    core.warn("error: no instrumented points at all — was " + entry + " built with coverage?");
    return none;
  }
  return Measured(points, nPoints, counts);
}

// ## Reporting — the table, and what was missed
//
// Twelve packages call this through `covreport.wac` and want nothing else. A *ledger* wants the same
// table printed and then a verdict over the same measurement, which is why this is a function and not
// a second program: two measurements of one package are two runs that can disagree.

/** A one-decimal percentage, since the table has always printed one. */
string pct(i32 c, i32 n) {
  if (n == 0) { return "100.0"; }
  i32 tenths = (c * 1000 + n / 2) / n;
  return itoa(tenths / 10) + "." + itoa(tenths % 10);
}

/** A missed row's sort key: the file and the line, and nothing after them. */
string fileAndLine(string row) {
  i32 tabs = 0;
  for (i32 i = 0; i < row.len(); i++) {
    if (row.slice(i, i + 1) == "\t") {
      tabs = tabs + 1;
      if (tabs == 2) { return row.slice(0, i); }
    }
  }
  return row;
}

/**
 * By file then line, and **stable**, which is not decoration.
 *
 * Two points can share a file, a line and a column — `hex.wac:75:3` is a `then` and an `else` — and
 * their order is then whichever the emitter numbered first. Sorting the whole row instead puts `else`
 * before `then` alphabetically, which is a different answer to the same question and a needless
 * difference from the report this replaces. `>` rather than `>=` is what keeps equal keys in place.
 */
void sortMissed(string[] a, i32 n) {
  for (i32 i = 1; i < n; i++) {
    string v = a[i];
    string k = fileAndLine(v);
    i32 j = i - 1;
    while (j >= 0 && fileAndLine(a[j]) > k) { a[j + 1] = a[j]; j = j - 1; }
    a[j + 1] = v;
  }
}

/**
 * The per-file table, the test files not counted, and the points nothing reached.
 *
 * `verbose` prints every missed point rather than the first twenty.
 */
export void report(Core core, Point[] points, i32 nPoints, i32[] counts, string prefix, bool verbose) {
  // **Merged by source position, so a generic's instantiations are one line each.** See `Merged`.
  Merged[] merged = mergeRoom(nPoints);
  i32 nMerged = mergePoints(points, nPoints, counts, prefix, merged);

  // Per file, and the skipped ones named. The skip list walks the raw points, because a test file that
  // contributes nothing but duplicates still has to be named.
  string[] files = string[nMerged > 0 ? nMerged : 1](fill: "");
  i32[] fileN = i32[nMerged > 0 ? nMerged : 1]();
  i32[] fileC = i32[nMerged > 0 ? nMerged : 1]();
  i32 nFiles = 0;
  string[] skipped = string[nPoints > 0 ? nPoints : 1](fill: "");
  i32 nSkipped = 0;
  i32 total = 0;
  i32 covered = 0;
  for (i32 i = 0; i < nPoints; i++) {
    Point p = points[i];
    if (!startsWith(p.file, prefix) || !isTest(p.file)) { continue; }
    bool seen = false;
    for (i32 k = 0; k < nSkipped; k++) { if (skipped[k] == p.file) { seen = true; } }
    if (!seen) { skipped[nSkipped] = p.file; nSkipped = nSkipped + 1; }
  }
  for (i32 i = 0; i < nMerged; i++) {
    Merged p = merged[i];
    i32 slot = -1;
    for (i32 k = 0; k < nFiles && slot < 0; k++) { if (files[k] == p.file) { slot = k; } }
    if (slot < 0) { slot = nFiles; files[slot] = p.file; nFiles = nFiles + 1; }
    fileN[slot] = fileN[slot] + 1;
    total = total + 1;
    if (p.hit) { fileC[slot] = fileC[slot] + 1; covered = covered + 1; }
  }

  core.log("| file | points | covered | % |");
  core.log("|---|---:|---:|---:|");
  string[] order = string[nFiles](fill: "");
  for (i32 i = 0; i < nFiles; i++) { order[i] = files[i]; }
  sortStrings(order, nFiles);
  for (i32 i = 0; i < nFiles; i++) {
    for (i32 k = 0; k < nFiles; k++) {
      if (files[k] != order[i]) { continue; }
      core.log("| " + files[k] + " | " + itoa(fileN[k]) + " | " + itoa(fileC[k]) + " | " +
               pct(fileC[k], fileN[k]) + " |");
    }
  }
  core.log("| **" + prefix + "** | **" + itoa(total) + "** | **" + itoa(covered) + "** | **" +
           pct(covered, total) + "** |");

  if (nSkipped > 0) {
    sortStrings(skipped, nSkipped);
    string names = "";
    for (i32 i = 0; i < nSkipped; i++) { names = names + (i > 0 ? ", " : "") + skipped[i]; }
    core.log("");
    core.log(itoa(nSkipped) + " test file(s) not counted: " + names);
  }

  i32 nMissed = total - covered;
  if (nMissed > 0) {
    // Sorted by file then line, which is the order somebody reads them in.
    string[] missed = string[nMissed](fill: "");
    i32 m = 0;
    for (i32 i = 0; i < nMerged; i++) {
      Merged p = merged[i];
      if (p.hit) { continue; }
      // Padded so the sort is by line *number* rather than by its spelling — `:9:` after `:10:` is
      // what an unpadded string sort gives, and a reader takes that for a missing entry.
      string ln = itoa(p.line);
      while (ln.len() < 6) { ln = "0" + ln; }
      missed[m] = p.file + "\t" + ln + "\t" + itoa(p.col) + "\t" + p.kind;
      m = m + 1;
    }
    sortMissed(missed, m);
    core.log("");
    core.log(itoa(m) + " branch points never executed:");
    i32 show = verbose ? m : (m < 20 ? m : 20);
    for (i32 i = 0; i < show; i++) {
      string[] f = fields(missed[i], 4);
      core.log("  " + f[0] + ":" + itoa(numberOf(f[1])) + ":" + f[2] + "  " + f[3]);
    }
    if (show < m) {
      core.log("  ... and " + itoa(m - show) + " more (--verbose for all)");
    }
  }
}

/**
 * One source position, and whether **any** instantiation of it ran.
 *
 * A generic emits a copy of every point in its body per instantiation, so `Option<T>` used seven ways
 * is seven copies of the same lines with seven counters. What a reader wants to know about
 * `option.wac:20` is whether that branch was taken, not whether it was taken in all seven — so the
 * copies merge and the coverage is a union.
 *
 * **This was got wrong from the day `covreport.wac` was written**, and `core/` is where it showed:
 * `core/test/cov_exercise.wac` emits 848 points under `core/` at 159 distinct positions, and counting
 * them raw read 35.3% where `harness/wacCoverage.ts` — which keyed on `(file, line, col, kind)` and
 * unioned — read 100%. Every package converted before then was measured raw; the ones with no repeated
 * instantiation are unaffected, which is why nothing caught it until a tree that is nothing but
 * generics arrived.
 */
export struct Merged {
  string file;
  i32 line;
  i32 col;
  string kind;
  bool hit;
}

/**
 * The points under `prefix` that are not in tests, merged by source position.
 *
 * `out` is filled and the count returned, since wac has no growable array here and the caller wants
 * both.
 *
 * **Bucketed by line, which is not a premature optimisation.** The first version scanned the whole
 * merged list per point, and `deno task coverage:all` went from 44s to 75s on 21 packages — a cost paid
 * on every push. Two points can only merge if they are on the same line, so a chain per line turns the
 * scan into a walk over the handful of distinct positions on that one line. No hash and nothing to get
 * wrong: the bucket key *is* the line number.
 */
export i32 mergePoints(Point[] points, i32 nPoints, i32[] counts, string prefix, Merged[] out) {
  i32 maxLine = 0;
  for (i32 i = 0; i < nPoints; i++) {
    if (points[i].line > maxLine) { maxLine = points[i].line; }
  }
  i32[] head = i32[maxLine + 2]();
  for (i32 i = 0; i < head.len(); i++) { head[i] = -1; }
  i32[] next = i32[nPoints > 0 ? nPoints : 1]();

  i32 n = 0;
  for (i32 i = 0; i < nPoints; i++) {
    Point p = points[i];
    if (!startsWith(p.file, prefix) || isTest(p.file)) { continue; }
    // `!= 0`, not `> 0`: a counter that wrapped past two billion is negative and was very much
    // reached. See `signedOf`.
    bool ran = p.index < counts.len() && counts[p.index] != 0;
    i32 at = -1;
    i32 line = p.line >= 0 && p.line <= maxLine ? p.line : 0;
    for (i32 k = head[line]; k >= 0 && at < 0; k = next[k]) {
      Merged m = out[k];
      if (m.col == p.col && m.line == p.line && m.file == p.file && m.kind == p.kind) { at = k; }
    }
    if (at >= 0) {
      if (ran) { out[at].hit = true; }
      continue;
    }
    if (n < out.len()) {
      out[n] = Merged(p.file, p.line, p.col, p.kind, ran);
      next[n] = head[line];
      head[line] = n;
      n = n + 1;
    }
  }
  return n;
}

/** Room for a merge of `nPoints`, which cannot need more entries than there are points. */
export Merged[] mergeRoom(i32 nPoints) {
  return Merged[nPoints > 0 ? nPoints : 1](fill: Merged("", 0, 0, "", false));
}

/**
 * Every `file:line` under `prefix` with at least one point that never ran, as a sorted list.
 *
 * `n` is how many entries of the returned array are real, since wac has no growable array here and the
 * caller wants both.
 */
export i32 uncoveredLines(Point[] points, i32 nPoints, i32[] counts, string prefix, string[] out) {
  Merged[] merged = mergeRoom(nPoints);
  i32 nMerged = mergePoints(points, nPoints, counts, prefix, merged);
  i32 n = 0;
  for (i32 i = 0; i < nMerged; i++) {
    Merged p = merged[i];
    if (p.hit) { continue; }
    string where = p.file + ":" + itoa(p.line);
    bool have = false;
    for (i32 k = 0; k < n; k++) { if (out[k] == where) { have = true; } }
    if (!have && n < out.len()) { out[n] = where; n = n + 1; }
  }
  sortStrings(out, n);
  return n;
}

/** Whether the first non-space is at column 0, 1 or 2 — "top level, or one level in". */
bool startsShallow(string l) {
  for (i32 i = 0; i < 3 && i < l.len(); i++) {
    string c = l.slice(i, i + 1);
    if (c != " ") { return c != "\t"; }
  }
  return false;
}

/**
 * Whether `l` opens a declaration: shallow, brace-bearing, and not a control-flow keyword.
 *
 * **Crude on purpose.** A wac file nests exactly one deep — `struct` then its methods — and anything
 * cleverer would need the parser this tool deliberately does not carry.
 *
 * **One level in, not column 0**, which is the part that was got wrong once: every constructor
 * `Fs.overChan` and every method of `Chan` is indented inside its `struct`, so a column-0 rule walked
 * past all of them to the `struct` line and reported four points as unaccounted that the rule above
 * them already spoke for.
 */
bool opensDecl(string l) {
  if (!startsShallow(l)) { return false; }
  string t = trimmed(l);
  string[] keywords = string[]("if", "for", "while", "match", "else", "case", "}", "/", "*");
  for (i32 i = 0; i < keywords.len(); i++) {
    if (startsWith(t, keywords[i])) { return false; }
  }
  return endsWith(t, "{") || (contains(t, "{") && endsWith(t, "}"));
}

/** The enclosing declaration of `line`, 1-based, or "". */
string declOf(string[] ls, i32 line) {
  for (i32 i = line - 1; i >= 0; i--) {
    if (i < ls.len() && opensDecl(ls[i])) { return ls[i]; }
  }
  return "";
}

/** The enclosing `struct`: the nearest line at or above that starts in column 0 and opens a block. */
string structOf(string[] ls, i32 line) {
  for (i32 i = line - 1; i >= 0; i--) {
    if (i >= ls.len()) { continue; }
    string l = ls[i];
    if (l.len() > 0 && l.slice(0, 1) != " " && l.slice(0, 1) != "\t" && endsWith(trimmed(l), "{")) {
      return l;
    }
  }
  return "";
}

/** Whether `rule` speaks for a point at `file:line`, given that file's lines. */
bool rulePicks(Rule rule, string[] ls, string file, i32 line) {
  if (rule.file != file) { return false; }
  if (rule.scope == "decl") { return contains(declOf(ls, line), rule.holds); }
  if (rule.scope == "struct") { return contains(structOf(ls, line), rule.holds); }
  return line >= 1 && line <= ls.len() && contains(ls[line - 1], rule.holds);
}

/**
 * Check a ledger against a measurement and say what is wrong. `true` when the run should fail.
 *
 * Everything printed here is read by a person and by `tools/coverageAll.ts`, in that order.
 */
/** The file part of a `file:line` key — everything before the last colon. */
string fileOf(string where) {
  i32 at = -1;
  for (i32 i = 0; i < where.len(); i++) { if (where.slice(i, i + 1) == ":") { at = i; } }
  return at < 0 ? where : where.slice(0, at);
}

/** The line part of a `file:line` key, or 0. */
i32 lineOfKey(string where) {
  i32 at = -1;
  for (i32 i = 0; i < where.len(); i++) { if (where.slice(i, i + 1) == ":") { at = i; } }
  if (at < 0) { return 0; }
  u8[] b = where.slice(at + 1, where.len()).toBytes();
  if (b.len() == 0) { return 0; }
  i32 v = 0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] < 48 || b[i] > 57) { return 0; }
    v = v * 10 + (b[i] - 48);
  }
  return v;
}


/**
 * Source files under `prefix` that contributed **no branch points at all**, named on the report.
 *
 * A file with one uncovered point appears in the table reading 0%. A file with none does not appear
 * at all — the report is built from the points the exercise produced, so a file nothing imports is
 * not low, it is *absent*, and a reader scanning the table has no way to notice it is missing.
 *
 * **`packages/tor` is why this exists.** A third of that package is programs — eleven files and 5,334
 * of its 15,913 lines — and its tests build them into binaries and spawn them rather than importing
 * them. Ten of the eleven contribute nothing, so the first reading of that package showed a table of
 * forty files and silently omitted `network.wac`, `socks.wac`, `gendesc.wac`, `hsconnect.wac` and six
 * more. `relayd.wac` is only visible because one constant of its 1,890 lines happens to be reachable
 * from elsewhere.
 *
 * **Reported and not failed, deliberately.** Making it fail would turn every ledger red at once for a
 * question none of them has answered yet — whether a program should be measured, and how — and that
 * is a decision rather than a bug. `issues/system/0241b`. What it costs to say nothing is that ten
 * files disappeared from a report somebody was reading closely, and nobody noticed for a day.
 *
 * ## Declaration-only files are not a gap, and the first version said they were
 *
 * `core/read.wac` is one `enum` and `core/jsx.wac` is two `struct`s. Neither holds a line that can
 * execute, so neither contributes a point *however thoroughly it is used* — and the first version of
 * this named both, under a `core` ledger reading 100%, as though something were missing.
 *
 * The discriminator is that **a function with no branches still produces an entry point.** So a file
 * with zero points and at least one function declaration was not compiled; a file with zero points
 * and no function declaration has nothing to compile. `") {"` is what tells them apart: a function
 * signature has a parameter list and a `struct`, `enum` or `const` does not.
 */
/** Whether a path is in a directory that holds programs rather than library code. */
bool isProgramDir(string path) {
  return contains(path, "/example/") || contains(path, "/bench/")
      || contains(path, "/size/") || contains(path, "/audit/");
}

void nameFilesWithNoPoints(Core core, Cli cli, Point[] points, i32 nPoints, string prefix) {
  string[] all = sourceFiles(core, cli, string[](".wac"), string[0](fill: ""));
  string[] missing = string[all.len() > 0 ? all.len() : 1](fill: "");
  i32 nMissing = 0;
  i32 seen = 0;
  for (i32 i = 0; i < all.len(); i++) {
    string f = all[i];
    if (!startsWith(f, prefix) || isTest(f)) { continue; }
    seen = seen + 1;
    bool has = false;
    for (i32 k = 0; k < nPoints && !has; k++) { if (points[k].file == f) { has = true; } }
    if (has) { continue; }
    // Nothing to compile is not the same as not compiled — see the note above.
    FileResult src = cli.readFile(f).wait();
    if (!src.ok) { continue; }
    if (!contains(string.fromBytes(src.bytes), ") {")) { continue; }
    missing[nMissing] = f;
    nMissing = nMissing + 1;
  }
  if (nMissing == 0) { return; }
  // **`example/`, `bench/`, `size/` and `audit/` hold programs by convention, and naming them every
  // run is noise.** `packages/platform` has two files in `src/` and thirty-nine examples; a list that
  // led with the examples would bury the one thing worth reading. They are counted rather than listed
  // — the count still moves if one appears or goes, and the reader is not asked to skim past it.
  i32 library = 0;
  for (i32 i = 0; i < nMissing; i++) {
    if (!isProgramDir(missing[i])) { library = library + 1; }
  }
  core.log("");
  if (library > 0) {
    core.log(itoa(library) + " of " + itoa(seen) + " source file(s) under " + prefix +
             " contributed no branch points — nothing the exercise compiled imports them, so they are "
             + "absent from the table above rather than reading zero:");
    for (i32 i = 0; i < nMissing; i++) {
      if (isProgramDir(missing[i])) { continue; }
      core.log("  " + missing[i]);
    }
    core.log("  A program that a test builds and spawns lands here. Reported, not failed — see "
             + "`issues/system/0241b`.");
  }
  if (nMissing > library) {
    core.log("  ...and " + itoa(nMissing - library) + " under example/, bench/, size/ or audit/, "
             + "which hold programs by convention and are counted rather than listed.");
  }
}

export bool ratchet(Core core, Cli cli, Point[] points, i32 nPoints, i32[] counts, string prefix,
                    Pin[] pins, Rule[] rules) {
  bool failed = false;
  nameFilesWithNoPoints(core, cli, points, nPoints, prefix);
  string[] uncovered = string[nPoints > 0 ? nPoints : 1](fill: "");
  i32 nUncovered = uncoveredLines(points, nPoints, counts, prefix, uncovered);
  // **Which points have been spoken for, as a set.** A point named by a pin *and* matched by a rule was
  // counted twice in the driver this generalises, so its ratchet reported fewer unaccounted points than
  // it then listed — 8 against 22 — and would have gone green with fourteen branches nobody had spoken
  // for. Counting what is spoken for rather than how many times it was spoken for is the same
  // distinction the report itself draws between points and mentions.
  bool[] spoken = bool[nUncovered > 0 ? nUncovered : 1](fill: false);

  for (i32 i = 0; i < pins.len(); i++) {
    Pin u = pins[i];
    string where = u.file + ":" + itoa(u.line);
    FileResult src = cli.readFile(u.file).wait();
    string at = "";
    if (src.ok) {
      string[] ls = linesOf(string.fromBytes(src.bytes));
      if (u.line >= 1 && u.line <= ls.len()) { at = ls[u.line - 1]; }
    } else {
      core.log("");
      core.log("error: " + u.file + " cannot be read — " + src.error);
      failed = true;
      continue;
    }

    bool listed = false;
    for (i32 k = 0; k < nUncovered; k++) { if (uncovered[k] == where) { listed = true; } }

    if (!contains(at, u.snippet)) {
      core.log("");
      core.log(where + " no longer holds \"" + u.snippet + "\" — it holds:");
      core.log("  " + trimmed(at));
      core.log("  The entry has drifted onto the wrong line; fix the line number.");
      failed = true;
    } else if (!listed) {
      core.log("");
      core.log(where + " is listed as unreached but was covered. The reason given was:");
      core.log("  " + u.why);
      // **A failure either way, and only one of them is bad news.** A proven entry that is covered was
      // wrong about the code; an unproven one that is covered means somebody built the input nobody
      // had, which is the outcome the entry was recording the absence of. Both have to go, so both
      // fail — a ledger that quietly dropped the second kind would stop being a record of what is
      // still missing.
      core.log(u.proven
        ? "  That reason no longer holds — drop the entry."
        : "  The gap has been closed — drop the entry, and say so.");
      failed = true;
    } else {
      core.log("");
      core.log((u.proven ? "excluded as unreachable: " : "reachable, NOT COVERED: ") + where +
               "  " + u.snippet);
      core.log("  " + u.why);
    }
  }

  for (i32 i = 0; i < nUncovered; i++) {
    for (i32 k = 0; k < pins.len(); k++) {
      if (pins[k].file + ":" + itoa(pins[k].line) == uncovered[i]) { spoken[i] = true; }
    }
  }

  // Rules, applied to the points that are actually uncovered.
  for (i32 r = 0; r < rules.len(); r++) {
    Rule rule = rules[r];
    FileResult src = cli.readFile(rule.file).wait();
    if (!src.ok) {
      core.log("");
      core.log("error: " + rule.file + " cannot be read — " + src.error);
      failed = true;
      continue;
    }
    string[] ls = linesOf(string.fromBytes(src.bytes));
    i32 hits = 0;
    for (i32 i = 0; i < nUncovered; i++) {
      if (rulePicks(rule, ls, fileOf(uncovered[i]), lineOfKey(uncovered[i]))) {
        spoken[i] = true;
        hits = hits + 1;
      }
    }
    if (hits == 0) {
      core.log("");
      core.log(rule.file + " no longer holds any uncovered point matching \"" + rule.holds +
               "\" — the rule explains something that is gone; delete it or fix it.");
      failed = true;
      continue;
    }
    core.log("");
    core.log(itoa(hits) + "x " + (rule.proven ? "unreachable" : "reachable, NOT COVERED") + ": " +
             rule.file + " — " + rule.holds);
    core.log("  " + rule.why);
  }

  // What is uncovered and unspoken for. Named rather than counted, because a count is a number
  // somebody learns to ignore and a list is a thing to go and look at.
  string[] unexpected = string[nUncovered > 0 ? nUncovered : 1](fill: "");
  i32 nUnexpected = 0;
  for (i32 i = 0; i < nUncovered; i++) {
    if (!spoken[i]) { unexpected[nUnexpected] = uncovered[i]; nUnexpected = nUnexpected + 1; }
  }
  if (nUnexpected > 0) {
    core.log("");
    core.log(itoa(nUnexpected) + " reachable branch point(s) uncovered:");
    for (i32 i = 0; i < nUnexpected; i++) { core.log("  " + unexpected[i]); }
    failed = true;
  }
  return failed;
}
