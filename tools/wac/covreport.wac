// Branch coverage for one package: which points nothing reached.
//
//   wac run --allow-read --allow-write --allow-run tools/wac/covreport.wac \
//       -- packages/codec/test/cov_exercise.wac packages/codec/ [--verbose]
//
// **This is the shared half of twenty drivers.** Each package's `cov.ts` was exercises plus its own
// copy of the reporting, through `harness/wacCoverage.ts`; what is left per package is the exercises
// alone — a wac program whose `main` runs the shapes the tests run — and this reads the counters and
// says what was missed. `issues/system/0161`.
//
// ## Why this needs no new command, which was not the first answer
//
// A *trace* had to be compared inside the binary: `p256PublicKey` is three million events and shipping
// two journals out as text to be walked would be tens of megabytes for one number, which is what
// `wac ctcompare` exists for. A coverage journal is one count per *point* — hundreds of numbers for a
// whole package — so it can be shipped out and joined here. `wac build --coverage` writes `stem.cov`
// keyed by counter index, `wac covdump` prints `<index>\t<count>`, and naming the zeros is a loop.
//
// ## What is counted, which is the part with a decision in it
//
// A point is counted when its file starts with `prefix` and is **not** a test file — `/test/` in the
// path, or a `_test.wac` name. That is `harness/wacCoverage.ts`'s rule kept exactly: a test's
// uncovered branches are its *assertions that did not fire*, which is the outcome you want and not a
// gap in the package. `packages/url` read 95.7% with fifteen passing checks reported as gaps before
// that rule existed. The count of skipped files is printed, so this cannot quietly drop a real one.
//
// It is also what places the exercises: `packages/<pkg>/test/cov_exercise.wac` is skipped by the same
// rule that skips the probe, so a driver's own branches never appear in the package's number.

// ## The measuring is in `tools/wac/covledger.wac` — 2026-08-20
//
// Build, run, join, and the parsing of both artefacts were in `main` here, so the only way to have
// the numbers was to spawn this program and read its table back as text. `issues/system/0222` wants
// per-package *ledgers* over the same measurement, so `measure` is a function and this is the file
// that reports it. The six string helpers went the same way, and four of them turned out to be the
// third copy of what `packages/wactest/src/strings.wac` already exported.

import { Core, Cli } from "std/platform.wac";
import { Measured, measure, report } from "./covledger.wac";

export i32 main(Core core, Cli cli) {
  i32 argc = cli.argCount().wait();
  if (argc < 2) {
    core.warn("usage: covreport <exercise.wac> <prefix/> [--verbose] [--allow-…] " +
              "[export|export:<cases>…]");
    return 2;
  }
  string entry = string.fromBytes(cli.arg(0).wait());
  string prefix = string.fromBytes(cli.arg(1).wait());
  bool verbose = false;
  // **Grants go to the build and export names go to the run**, and both are new on 2026-08-20 with
  // `issues/system/0221`: `covdump` used to instantiate with no imports and call only `main`, so an
  // exercise could hold no capabilities and at most one trapping case. It runs the ordinary program
  // path now — the world from the manifest, the grants baked into it — and calls each named export
  // with its trap caught.
  //
  // A grant here is not a widening of what the *report* may do: it is what the exercise is compiled
  // with, so an exercise that reads a corpus says so and one that does not cannot.
  string[] grants = string[8](fill: "");
  i32 nGrants = 0;
  string[] exports = string[64](fill: "");
  i32 nExports = 0;
  for (i32 i = 2; i < argc; i++) {
    string a = string.fromBytes(cli.arg(i).wait());
    if (a == "--verbose") {
      verbose = true;
    } else if (a.len() > 8 && a.slice(0, 8) == "--allow-") {
      if (nGrants >= 8) { core.warn("covreport: too many grants"); return 2; }
      grants[nGrants] = a;
      nGrants = nGrants + 1;
    } else if (a.len() > 0 && a.slice(0, 2) != "--") {
      if (nExports >= 64) { core.warn("covreport: too many export names"); return 2; }
      exports[nExports] = a;
      nExports = nExports + 1;
    } else {
      core.warn("covreport: " + a + " is not --verbose, a --allow-… grant, or an export name");
      return 2;
    }
  }

  string[] g = string[nGrants](fill: "");
  for (i32 i = 0; i < nGrants; i++) { g[i] = grants[i]; }
  string[] e = string[nExports](fill: "");
  for (i32 i = 0; i < nExports; i++) { e[i] = exports[i]; }
  Measured m = measure(core, cli, entry, g, e);
  if (m.nPoints == 0) { return 1; }

  report(core, m.points, m.nPoints, m.counts, prefix, verbose);
  return 0;
}
