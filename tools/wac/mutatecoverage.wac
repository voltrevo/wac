// Profiling one `*_test.wac` with the binary — `wacShare` from `tools/mutate/profile.ts`.
//
// `wac test --coverage` writes a JSON document per entry naming which tests reached which points.
// That is what `tools/wac/mutateplan.wac` selects against, and this is where it comes from.
//
// **A partial profile is refused rather than used.** If the run skipped anything — a test wanting a
// grant it did not get, or a host oracle this cannot supply — then the lines that test reaches look
// unreached, and a mutant in them is scored against tests that never ran. Declining costs a scope
// that widens to everything; using it costs a number nobody can tell is wrong.
//
// **The names are the exports' own.** A package whose tests are wac files has no `.test.ts` wrapper,
// so no translation is wanted — translating them is how a filter comes to match nothing and a mutant
// is scored against a run of zero tests. `issues/system/0183`, `issues/system/0161` step 6.

import { Cli, Core, Exec, FileResult } from "std/platform.wac";
import { JsonArray, JsonObject, JsonValue } from "../../packages/json/src/value.wac";
import { parse } from "../../packages/json/src/json.wac";
import { Map } from "core/map.wac";
import { hashString, stringEq } from "core/hash.wac";
import { Vec } from "core/vec.wac";
import { Profile } from "./mutateplan.wac";
import { refuseIfNested } from "./suitegate.wac";
import { itoa } from "../../packages/fmt/src/itoa.wac";

/**
 * The grants the suite's own wac lane passes.
 *
 * **One list, because two lists is how the first one aged.** A test skipped for want of a grant
 * contributes no coverage, and code only that test reaches then looks unreached — so this has to be
 * what the lane passes, not a plausible subset. `tools/mutate/grants.test.ts` fails if the two stop
 * agreeing. `issues/system/0176`.
 */
export string[] WAC_LANE_GRANTS() {
  return string[]("--allow-read", "--allow-write", "--allow-run", "--allow-env", "--allow-net");
}

/** What one entry's coverage came to. `ok` is false when the profile is partial or absent. */
export struct Share {
  bool ok;
  string why;
  /** Every point the entry has, whether or not a test reached it. */
  string[] all;
  /** Test names, and the points each reached, space-separated and parallel. */
  string[] tests;
  string[] points;
}

Share none(string why) {
  return Share(false, why, string[0](fill: ""), string[0](fill: ""), string[0](fill: ""));
}

/**
 * Run `wac test --coverage` over `entry` in `work`, writing profiles to `profileDir`.
 *
 * The caller supplies the directory rather than this making one, for the reason `issues/system/0161`
 * records about temp directories: no capability is needed for a path the caller can name, and a
 * directory that survives the run is the one you can look at afterwards.
 *
 * **No nesting guard here, and that is deliberate.** `tools/runTests.wac` sets `WAC_SUITE_RUNNING=1`
 * for every test it spawns, and the reference refuses a *whole profile* pass when it sees that —
 * `refuseIfNested` in `buildProfile`, because a suite invoked from inside the suite recurses without
 * bound. Profiling one entry does not: the inner run is over the entry it was handed, not over the
 * suite, and `mutatecoverage_test.wac` proves it by doing exactly that from inside a suite run.
 *
 * So the guard belongs on whatever ports `buildProfile`, which walks *every* test file and would
 * re-enter the suite. Written down here because the natural place to look for it is the function that
 * spawns, and that is the wrong place: put it there and profiling from a test stops working, leave it
 * out of `buildProfile` and a sweep started from inside the suite never terminates.
 */
export Share shareOf(Core core, Cli cli, string binary, string work, string entry,
                     string profileDir) {
  cli.mkdir(profileDir, true).wait();
  string[] grants = WAC_LANE_GRANTS();
  string[] args = string[3 + grants.len()](fill: "");
  args[0] = "test";
  args[1] = "--coverage";
  for (i32 i = 0; i < grants.len(); i++) { args[2 + i] = grants[i]; }
  args[2 + grants.len()] = entry;

  Exec r = cli.execWithIn(binary, args, u8[0](),
                          string[]("WAC_PROFILE=" + profileDir), false, false, work).wait();
  if (!r.ran()) { return none("the binary did not run"); }

  string[]? listed = cli.readDir(profileDir).wait();
  if (listed is null) { return none("no profile directory after the run"); }
  string[] names = listed!;
  for (i32 i = 0; i < names.len(); i++) {
    string name = names[i];
    if (name.len() < 6 || name.slice(name.len() - 5, name.len()) != ".json") { continue; }
    FileResult f = cli.readFile(profileDir + "/" + name).wait();
    if (!f.ok) { continue; }
    Share got = shareFrom(string.fromBytes(f.bytes), entry);
    // The directory can hold profiles from other entries; the one that names this entry is ours.
    if (got.ok || got.why != "not this entry") { return got; }
  }
  return none("no profile named " + entry);
}

/**
 * One coverage document, as a `Share`. Exported so the parsing can be tested without a run.
 *
 * `entry` matches either exactly or as a suffix, because the document records the path the binary was
 * given and the caller may have named it relative to a staged root.
 */
export Share shareFrom(string text, string entry) {
  JsonValue? root = parse(text.toBytes());
  if (root is null) { return none("not JSON"); }
  JsonObject doc = match (root!) { case Object(o): o, else: JsonObject.create() };
  if (doc.len() == 0) { return none("not a profile"); }

  string named = stringAt(doc, "entry");
  if (named != entry && !endsWithSlash(named, entry)) { return none("not this entry"); }

  // **`skipped` missing is not the same as empty.** A document without the key is one this cannot
  // reason about, and treating it as "nothing was skipped" is exactly the assumption that turns a
  // partial profile into a confident wrong answer.
  JsonValue? skipped = doc.get("skipped".toBytes());
  if (skipped is null) { return none("the profile does not say what it skipped"); }
  JsonArray skips = asArray(skipped!);
  if (skips.len() > 0) {
    return none("the run skipped " + itoa(skips.len()) + " test(s), so this profile is partial");
  }

  JsonValue? testsVal = doc.get("tests".toBytes());
  JsonObject tests = testsVal is null
    ? JsonObject.create()
    : match (testsVal!) { case Object(o): o, else: JsonObject.create() };
  if (tests.len() == 0) { return none("the run reached no test"); }

  string[] names = string[tests.len()](fill: "");
  string[] points = string[tests.len()](fill: "");
  for (i32 i = 0; i < tests.len(); i++) {
    names[i] = keyAt(tests, i);
    points[i] = joinArray(asArray(valueAt(tests, i)));
  }
  JsonValue? allVal = doc.get("all".toBytes());
  JsonArray all = allVal is null ? JsonArray.create() : asArray(allVal!);
  string[] allPts = string[all.len()](fill: "");
  for (i32 i = 0; i < all.len(); i++) { allPts[i] = textOf(all.get(i)); }
  return Share(true, "", allPts, names, points);
}

/** Whether `named` is `entry` with a directory prefix — `a/b/c.wac` for `b/c.wac`. */
bool endsWithSlash(string named, string entry) {
  string want = "/" + entry;
  return named.len() > want.len() && named.slice(named.len() - want.len(), named.len()) == want;
}

string stringAt(JsonObject o, string key) {
  JsonValue? v = o.get(key.toBytes());
  return v is null ? "" : textOf(v!);
}

JsonArray asArray(JsonValue v) {
  return match (v) { case Array(a): a, else: JsonArray.create() };
}

string textOf(JsonValue v) {
  return match (v) { case Str(b): string.fromBytes(b), else: "" };
}

string joinArray(JsonArray a) {
  string out = "";
  for (i32 i = 0; i < a.len(); i++) { out = out + (i == 0 ? "" : " ") + textOf(a.get(i)); }
  return out;
}

string keyAt(JsonObject o, i32 i) { return string.fromBytes(o.at(i).key); }

JsonValue valueAt(JsonObject o, i32 i) { return o.at(i).value; }

/** A profile and whether it can be trusted — `ok` false means run everything rather than narrow. */
export struct Profiled {
  bool ok;
  string why;
  Profile p;
  /**
   * Which file each test lives in, parallel arrays — what `runPlanFor` needs to turn a set of test
   * names back into a set of entries to run.
   *
   * Not on `Profile` because `Profile` is what the reference's cache encodes, and adding a field to
   * it would change the on-disk format for something the plan can be handed separately.
   */
  string[] homeNames;
  string[] homeFiles;
}

Profile emptyProfile() {
  return Profile(string[0](fill: ""), string[0](fill: ""), string[0](fill: ""), i32[0]());
}

/**
 * Whether a coverage point is in the shape `selectTests` looks up — `file:line`.
 *
 * **Checked rather than assumed, because a mismatch is silent and comfortable.** `Profile.known` is
 * keyed by `file:line` and `planFor` answers `widen` for any location it cannot find. So if the
 * points arrived in some other spelling, every mutant would widen to its whole scope: slower, never
 * wrong, and indistinguishable in the output from a profile that simply had nothing to say. The run
 * would look like it was narrowing and never narrow once.
 */
export bool looksLikeAPoint(string point) {
  i32 colon = -1;
  for (i32 i = point.len() - 1; i >= 0; i--) {
    if (point.slice(i, i + 1) == ":") { colon = i; break; }
  }
  if (colon <= 0 || colon + 1 >= point.len()) { return false; }
  for (i32 i = colon + 1; i < point.len(); i++) {
    string c = point.slice(i, i + 1);
    if (c < "0" || c > "9") { return false; }
  }
  return true;
}

string[] splitSpaces(string s) {
  Vec<string> out = Vec.create();
  i32 from = 0;
  for (i32 i = 0; i <= s.len(); i++) {
    if (i < s.len() && s.slice(i, i + 1) != " ") { continue; }
    if (i > from) { out.push(s.slice(from, i)); }
    from = i + 1;
  }
  return out.toArray();
}

/**
 * Profile every test file in `testFiles`, and assemble what `mutateplan.wac` selects against.
 *
 * **This is where the nesting guard belongs**, and `shareOf` above says why it is not in the function
 * that spawns: profiling *one* entry from inside the suite is bounded and legitimate — the inner run
 * is over the entry it was handed — while this walks every test file and would re-enter the suite
 * without bound. `wac-mono 0077`'s shape. Put the guard in `shareOf` and profiling from a test stops
 * working; leave it out of here and a sweep started from inside the suite never terminates.
 *
 * **A file that could not be profiled costs its own coverage and nothing else.** Its lines stay
 * unknown, so `selectTests` finds no entry for them and `planFor` answers `widen` — the whole scope
 * runs, which is slow and cannot be wrong. That is the right direction to fail in: the opposite,
 * treating an unprofiled file as reaching nothing, would narrow every mutant in it to no tests at all
 * and score the lot as survivors.
 *
 * `cost` is wall-clock milliseconds per file, and `-1` for a file whose profile was refused — the
 * value `byCost` already reads as unmeasured.
 */
export Profiled buildProfile(Core core, Cli cli, string binary, string work, string[] testFiles,
                             string profileDir) {
  if (refuseIfNested(core, cli, "mutate: building a coverage profile") != 0) {
    return Profiled(false,
                    "refused: a profile pass runs every test file, so it must not start from inside"
                    + " the suite — see wac-mono 0077",
                    emptyProfile(), string[0](fill: ""), string[0](fill: ""));
  }

  Map<string, i32> at = Map.create(hashString, stringEq);
  Vec<string> known = Vec.create();
  Vec<string> reaching = Vec.create();
  Vec<string> files = Vec.create();
  Vec<i32> cost = Vec.create();
  Vec<string> homeNames = Vec.create();
  Vec<string> homeFiles = Vec.create();
  i32 profiled = 0;
  i32 malformed = 0;

  for (i32 f = 0; f < testFiles.len(); f++) {
    i64 started = core.monotonicNanos().wait() / (1000000 as i64);
    Share s = shareOf(core, cli, binary, work, testFiles[f], profileDir);
    i32 took = (core.monotonicNanos().wait() / (1000000 as i64) - started) as! i32;

    files.push(testFiles[f]);
    if (!s.ok) {
      core.warn("  no profile for " + testFiles[f] + ": " + s.why
                + " — its mutants will run the whole scope");
      cost.push(-1);
      continue;
    }
    cost.push(took);
    profiled = profiled + 1;

    for (i32 t = 0; t < s.tests.len(); t++) {
      homeNames.push(s.tests[t]);
      homeFiles.push(testFiles[f]);
      string[] points = splitSpaces(s.points[t]);
      for (i32 p = 0; p < points.len(); p++) {
        if (!looksLikeAPoint(points[p])) { malformed = malformed + 1; continue; }
        i32 idx = at.getOr(points[p], -1);
        if (idx < 0) {
          idx = known.len();
          known.push(points[p]);
          reaching.push("");
          at.set(points[p], idx);
        }
        string have = reaching.get(idx);
        reaching.set(idx, have == "" ? s.tests[t] : have + " " + s.tests[t]);
      }
    }
  }

  Profile p = Profile(known.toArray(), reaching.toArray(), files.toArray(), cost.toArray());

  // **A profile that named nothing is refused rather than returned.** Handed on, it makes every
  // location unknown, so every mutant widens and the run is exactly as slow as no profile at all —
  // while the report says it profiled. Saying so is the difference between a slow run and a silent
  // one.
  if (known.len() == 0) {
    return Profiled(false,
                    profiled == 0
                      ? "no test file could be profiled, so there is nothing to narrow against"
                      : "the profiles named no coverage points at all",
                    p, homeNames.toArray(), homeFiles.toArray());
  }
  if (malformed > 0) {
    // Not fatal: some points landed, and those narrow. But a spelling `selectTests` cannot look up
    // is a profile that silently stops narrowing, which is the one failure worth naming out loud.
    core.warn("  " + itoa(malformed) + " coverage point(s) were not in the file:line shape "
              + "`selectTests` looks up, and were dropped");
  }
  return Profiled(true, "", p, homeNames.toArray(), homeFiles.toArray());
}
