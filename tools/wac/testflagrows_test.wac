// Every flag `wac test` accepts is passed by some row of the differential.
//
// **`--verbose` was accepted and implemented by nobody on three of the four hosts.** It was in
// `unknownTestFlag`'s list, so it was not refused as a typo; it was spelled correctly, changed
// nothing, and no document said what it should do. `packages/sh/test/gaps.test.ts` ranks the three
// outcomes and `tools/ignoredFlags.ts` asks this question of every box applet against the real tool:
// doing something plausible is worst, refusing is better, saying which side is incomplete is best. A
// flag accepted and ignored is the first of those, handed to a caller who asked for it by name.
//
// What let it last was not the flag. `test` is one of the two subcommands implemented **twice** — in
// `native/v8/src/main.rs` and again in `packages/wac/example/wac.wac` — and
// `packages/wacc/test/wac/commandparity_test.wac` is the instrument that holds the two together. No
// row passed `--verbose`, so the instrument never looked at it. This checks that every flag the wac
// side accepts is one some row supplies.
//
// **Both doubled commands, each against its own rows.** `build`, `check` and `bindgen` have a single
// implementation — the native binary hands them to the wac program rather than answering them itself
// — so a flag of theirs cannot be ignored by one host and honoured by another. `test` and `run` are
// the two that are written twice, and they get one question each.
//
// **Per row, not per table**, which is the difference between this and a check that looks the same.
// Matching a flag against the whole table would let `--allow-read` in a `test` row read as covering
// `run` too — and `run` granted nothing in any row until this file said so, while `--allow-read` sat
// in six `test` rows. A flag is only covered by a row of *its own* subcommand.

import { T } from "../../packages/wactest/src/assert.wac";
import { Cli, Core, FileResult } from "std/platform.wac";
import { Vec } from "core/vec.wac";

/**
 * Where the flag lists live — **both, concatenated**, because they are moving.
 *
 * `unknownTestFlag` was in the compiler's example until `issues/system/0257c` began taking the
 * command out of it, and `unknownFlagBefore` is next. A guard that names one file goes quiet the day
 * its subject moves: this one did, on the extraction that moved the test runner, and said "found the
 * flags `test` accepts — got 0" rather than passing. That assertion is why this file names two paths
 * instead of chasing one.
 */
const string CLI = "packages/wac/example/wac.wac";
const string CMD_DIR = "packages/wac/src";
const string PARITY = "packages/wacc/test/wac/commandparity_test.wac";

/**
 * Flags `wac test` accepts but no row supplies, with the reason each is out of scope.
 *
 * **A list with reasons rather than a shorter question.** An exception nobody can read is how a guard
 * stops meaning anything, so anything here has to say why a row would not earn its cost.
 */
bool excused(string cmd, string flag) {
  // `--allow-run` lets the program start another program. `packages/platform/test/wac/spawn_test.wac`
  // holds `exec` and `spawn` across all four hosts already, and a row here would pay a process per
  // host to ask the same question somewhere whose subject is the command rather than the capability.
  if (flag == "--allow-run") { return true; }
  // **`run --allow-env` waits on `issues/system/0256c`**, which is that a *denied* `env` answers null
  // on the native hosts and traps on the JavaScript ones. A row that does not grant it therefore
  // disagrees by host, and a row that does grant it asks what the `test --allow-env` row already
  // asks one layer in. Delete this arm when that issue closes; the row it wants is a `caps` fixture
  // reporting the environment beside the two capabilities it already reports.
  if (cmd == "run" && flag == "--allow-env") { return true; }
  return false;
}

/**
 * Every `.wac` file under `dir`, concatenated.
 *
 * **A directory rather than a list of files, because the list was wrong twice in one day.** This named
 * one file, then two, and each time a function it reads moved out of the compiler's example under
 * `issues/system/0257c` the guard went red saying it had found nothing — correct, and twice the work.
 * A directory keeps up with a split in progress.
 */
string sourcesIn(Cli cli, string dir) {
  string[]? entries = cli.readDir(dir).wait();
  if (entries is null) { return ""; }
  string[] names = entries!;
  string out = "";
  for (i32 i = 0; i < names.len(); i++) {
    if (names[i].len() > 4 && names[i].slice(names[i].len() - 4, names[i].len()) == ".wac") {
      out = out + textOf(cli, dir + "/" + names[i]) + "\n";
    }
  }
  return out;
}

/** The text of `path`, or "" — a file this cannot read is reported by the caller, not guessed at. */
string textOf(Cli cli, string path) {
  FileResult f = cli.readFile(path).wait();
  return f.ok ? string.fromBytes(f.bytes) : "";
}

/** The body of the first declaration beginning `head`, up to the line that closes it at column 0. */
string bodyAfter(string src, string head) {
  i32 at = src.indexOf(head);
  if (at < 0) { return ""; }
  // `indexOf` has no from-offset, so the tail is sliced first and the offset added back.
  string tail = src.slice(at, src.len());
  i32 rel = tail.indexOf("\n}");
  if (rel < 0) { return ""; }
  return tail.slice(0, rel);
}

/** Every `"--flag"` literal in `region`, in the order it appears, without repeats. */
string[] flagsIn(string region) {
  Vec<string> out = Vec.create();
  i32 i = 0;
  while (i + 3 < region.len()) {
    if (region.slice(i, i + 3) != "\"--") { i = i + 1; continue; }
    i32 j = i + 3;
    while (j < region.len() && region.slice(j, j + 1) != "\"") { j = j + 1; }
    if (j >= region.len()) { return out.toArray(); }
    string flag = region.slice(i + 1, j);
    // `"--"` on its own is the end-of-flags marker a `run` row passes, not a flag.
    bool seen = false;
    string[] have = out.toArray();
    for (i32 k = 0; k < have.len(); k++) { if (have[k] == flag) { seen = true; } }
    if (flag != "--" && !seen) { out.push(flag); }
    i = j + 1;
  }
  return out.toArray();
}

bool holds(string[] xs, string x) {
  for (i32 i = 0; i < xs.len(); i++) { if (xs[i] == x) { return true; } }
  return false;
}

/**
 * The flags every `string[](...)` row whose first element is `cmd` supplies.
 *
 * A row is flat — `string[]("test", "--allow-read", "src/one_test.wac")` — so its end is the next
 * `)`, and its subcommand is the first quoted element. Anything after a bare `"--"` is an argument to
 * the program rather than a flag to the command, which is what one `run` row exists to check, so the
 * scan of a row stops there.
 */
string[] flagsFor(string table, string cmd) {
  Vec<string> out = Vec.create();
  string open = "string[](";
  i32 i = 0;
  while (i < table.len()) {
    string rest = table.slice(i, table.len());
    i32 at = rest.indexOf(open);
    if (at < 0) { return out.toArray(); }
    i32 from = i + at + open.len();
    string tail = table.slice(from, table.len());
    i32 close = tail.indexOf(")");
    if (close < 0) { return out.toArray(); }
    string row = tail.slice(0, close);
    i = from + close;
    // The subcommand is the first quoted element; a row for another one is skipped whole.
    i32 q = row.indexOf("\"");
    if (q < 0) { continue; }
    string afterQ = row.slice(q + 1, row.len());
    i32 q2 = afterQ.indexOf("\"");
    if (q2 < 0) { continue; }
    if (afterQ.slice(0, q2) != cmd) { continue; }
    i32 stop = row.indexOf("\"--\"");
    string scanned = stop < 0 ? row : row.slice(0, stop);
    string[] found = flagsIn(scanned);
    for (i32 k = 0; k < found.len(); k++) {
      if (!holds(out.toArray(), found[k])) { out.push(found[k]); }
    }
  }
  return out.toArray();
}

/** Every accepted flag `cmd` has no row for, as one line, or "". */
string uncovered(string cmd, string[] accepted, string[] rowed) {
  string missing = "";
  for (i32 i = 0; i < accepted.len(); i++) {
    if (excused(cmd, accepted[i]) || holds(rowed, accepted[i])) { continue; }
    missing = missing + (missing == "" ? "" : ", ") + accepted[i];
  }
  return missing;
}

export string test_every_flag_wac_test_accepts_is_passed_by_some_row(Core core, Cli cli) {
  T t = T.create();
  string cliSrc = textOf(cli, CLI) + "\n" + sourcesIn(cli, CMD_DIR);
  string paritySrc = textOf(cli, PARITY);
  t.isTrue(cliSrc.len() > 0, "read " + CLI + " and " + CMD_DIR);
  t.isTrue(paritySrc.len() > 0, "read " + PARITY);
  if (cliSrc.len() == 0 || paritySrc.len() == 0) { return t.report(); }

  string table = bodyAfter(paritySrc, "string[][] cases() {");
  string[] accepted = flagsIn(bodyAfter(cliSrc, "string unknownTestFlag("));
  string[] rowed = flagsFor(table, "test");
  string[] acceptedRun = flagsIn(bodyAfter(cliSrc, "string unknownFlagBefore("));
  string[] rowedRun = flagsFor(table, "run");

  // **Both halves are read, and both are asserted to be non-empty.** A parser that found nothing
  // would report perfect coverage — the shape this file exists to refuse, arriving in the file that
  // refuses it. `issues/lang/0158`.
  t.isTrue(accepted.len() >= 5, "found the flags `test` accepts — got " + itoa(accepted.len()));
  t.isTrue(rowed.len() >= 5, "found the flags the rows pass — got " + itoa(rowed.len()));

  t.isTrue(acceptedRun.len() >= 5, "found the flags `run` accepts — got " + itoa(acceptedRun.len()));
  t.isTrue(rowedRun.len() >= 1, "found the flags the `run` rows pass — got " + itoa(rowedRun.len()));

  t.eqStr(uncovered("test", accepted, rowed), "",
          "`wac test` accepts these and no `test` row in commandparity_test.wac passes them, so the "
          + "two implementations of `test` are not compared for them — add a row, or excuse it with "
          + "a reason in `excused`");
  t.eqStr(uncovered("run", acceptedRun, rowedRun), "",
          "`wac run` accepts these and no `run` row passes them — same question, the other command "
          + "that is implemented twice");
  return t.report();
}

/** `itoa` for the counts above, kept local so this file imports one thing fewer. */
string itoa(i32 n) {
  if (n == 0) { return "0"; }
  string out = "";
  i32 v = n;
  while (v > 0) {
    out = "0123456789".slice(v % 10, v % 10 + 1) + out;
    v = v / 10;
  }
  return out;
}
