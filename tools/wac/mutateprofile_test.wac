// Which cached profiles are dead, and which file in that directory is a profile at all.
//
// `issues/system/0161` step 6.

import { T } from "../../packages/wactest/src/assert.wac";
import { Decoded, KEEP, cachePath, decodeProfile, encodeProfile, isProfileFile, keyedFile,
         skipsDir, toEvict, treeKeyOf }
       from "./mutateprofile.wac";

string joined(string[] xs) {
  string out = "";
  for (i32 i = 0; i < xs.len(); i++) { out = out + (i == 0 ? "" : " ") + xs[i]; }
  return out;
}

/**
 * Everything but the newest `keep`.
 *
 * Only the current tree's key can ever hit, so every older file is dead the moment a byte changes.
 * Keeping a few rather than one buys the case that actually happens while working: edit, look, undo,
 * look again.
 */
export string test_the_oldest_profiles_are_the_ones_removed() {
  T t = T.create();
  string[] paths = string[]("a.json", "b.json", "c.json", "d.json", "e.json");
  i64[] times = i64[](10 as i64, 50 as i64, 30 as i64, 20 as i64, 40 as i64);

  // Newest first: b(50) e(40) c(30) d(20) a(10). Keeping three leaves d and a.
  t.eqStr(joined(toEvict(paths, times, 3)), "d.json a.json",
          "the two oldest go, and in oldest-last order");
  t.eqStr(joined(toEvict(paths, times, 1)), "e.json c.json d.json a.json",
          "keeping one leaves everything else");
  t.eqI32(toEvict(paths, times, 5).len(), 0, "keeping as many as there are removes nothing");
  t.eqI32(toEvict(paths, times, 9).len(), 0, "and so does keeping more than there are");
  t.eqI32(toEvict(string[0](fill: ""), i64[0](fill: 0 as i64), 3).len(), 0,
          "an empty directory has nothing to evict");
  return t.report();
}

/** A tie is not a reason to prefer one: both are equally current. */
export string test_profiles_written_together_are_equally_current() {
  T t = T.create();
  string[] paths = string[]("a.json", "b.json", "c.json");
  i64[] same = i64[](7 as i64, 7 as i64, 7 as i64);
  t.eqI32(toEvict(paths, same, 2).len(), 1, "one of three still goes when only two are kept");
  return t.report();
}

export string test_what_counts_as_a_profile_file() {
  T t = T.create();
  t.isTrue(isProfileFile("abc123.json"), "a profile is a .json");
  t.isTrue(!isProfileFile("notes.txt"), "something else that landed there is not");
  t.isTrue(!isProfileFile(".json"), "and a bare extension names no key");
  t.eqStr(cachePath(".cache/mutate-profile", "deadbeef"),
          ".cache/mutate-profile/deadbeef.json", "one file per tree state");
  t.eqI32(KEEP(), 3, "three of them");
  return t.report();
}

string show(string[] xs) {
  string out = "";
  for (i32 i = 0; i < xs.len(); i++) { out = out + (i == 0 ? "" : "|") + xs[i]; }
  return out;
}

/**
 * A profile survives being written and read back.
 *
 * **The name table is where a silent loss would be.** `lines` holds indices into `names`, so an
 * off-by-one or a table built in a different order does not fail — it names *different tests* for a
 * line, and the run then selects tests that cannot reach the mutation. That is the under-selection
 * this whole tool treats as a wrong answer, arriving through the cache rather than through the
 * selection rule.
 */
export string test_a_profile_survives_the_round_trip() {
  T t = T.create();
  string[] known = string[]("a.wac:10", "a.wac:11", "b.wac:3");
  string[] tests = string[]("test_one test_two", "", "test_two test_three");
  string[] files = string[]("x_test.wac", "y_test.wac");
  i32[] cost = i32[](50, -1);

  string[] homeNames = string[]("test_one", "test_two", "test_three");
  string[] homeFiles = string[]("x_test.wac", "x_test.wac", "y_test.wac");

  Decoded got = decodeProfile(encodeProfile(known, tests, files, cost, homeNames, homeFiles));
  t.isTrue(got.ok, "it decoded");
  t.eqStr(show(got.known), show(known), "every line came back");
  t.eqStr(show(got.tests), show(tests),
          "with the same tests against each, which is what the name table has to preserve");
  t.eqStr(show(got.files), show(files), "and the test files");
  t.eqI32(got.cost[0], 50, "with their measured cost");
  t.eqI32(got.cost[1], -1, "and the unmeasured one still unmeasured, rather than zero");

  // **The home map, which the encoding did not carry until 2026-09-02.** `runPlanFor` turns the
  // names `selectTests` picked back into entries to run, and a hit that lost this hands it names it
  // cannot place — so it narrows nothing, and the run costs what no profile costs while reporting
  // that it profiled. A cache that silently stops caching the useful half.
  t.eqStr(show(got.homeNames), show(homeNames), "every test's name came back");
  t.eqStr(show(got.homeFiles), show(homeFiles), "paired with the file it lives in");
  return t.report();
}

/** A line no test reaches is not the same as a line the profile does not know. */
export string test_an_unhit_line_round_trips_as_unhit_rather_than_absent() {
  T t = T.create();
  Decoded got = decodeProfile(encodeProfile(string[]("a.wac:11"), string[](""),
                                            string[0](fill: ""), i32[0](fill: 0),
                                            string[0](fill: ""), string[0](fill: "")));
  t.isTrue(got.ok, "it decoded");
  t.eqI32(got.known.len(), 1, "the line is still known");
  t.eqStr(got.tests[0], "", "and still reached by nothing — which is not the same as unknown");
  return t.report();
}

/** Anything that is not a profile decodes to nothing rather than to a plausible empty one. */
export string test_text_that_is_not_a_profile_is_refused() {
  T t = T.create();
  t.isTrue(!decodeProfile("").ok, "empty text is not a profile");
  t.isTrue(!decodeProfile("{").ok, "nor is truncated JSON");
  t.isTrue(!decodeProfile("[1,2,3]").ok, "nor a JSON value of the wrong shape");
  return t.report();
}

/**
 * The key is a function of the tree's *content*, and of nothing else.
 *
 * Four properties, and each one is a way a cache goes wrong rather than a way it fails:
 *
 * - **Stable**: the same tree twice is the same key, or nothing ever hits and the cache is a
 *   nine-second tax that never pays.
 * - **Order-independent**: a caller that gathered the files another way gets the same key. The
 *   reference sorts inside its own walk, so this property is the caller's there and the function's
 *   here — a property that cannot be got wrong by a caller is worth more than matching an order.
 * - **Content-sensitive**: one byte changes the key, or a stale profile is served for an edited tree
 *   and every mutant is selected against the wrong tests.
 * - **Path-sensitive**: two files that swapped contents are a different tree. A key over contents
 *   alone would call them the same one.
 */
export string test_the_tree_key_is_the_content_and_nothing_else() {
  T t = T.create();
  string[] entries = string[]("a_test.wac");
  string[] paths = string[]("a.wac", "b.wac");
  string[] texts = string[]("one", "two");

  string k = treeKeyOf(entries, paths, texts);
  t.eqStr(treeKeyOf(entries, paths, texts), k, "the same tree twice is the same key");

  t.eqStr(treeKeyOf(entries, string[]("b.wac", "a.wac"), string[]("two", "one")), k,
          "and so is the same tree gathered in another order");

  t.isTrue(treeKeyOf(entries, paths, string[]("one!", "two")) != k,
           "one byte of one file changes it");
  t.isTrue(treeKeyOf(entries, paths, string[]("two", "one")) != k,
           "and two files that swapped contents are a different tree, which a key over contents "
             + "alone would miss");
  t.isTrue(treeKeyOf(string[]("b_test.wac"), paths, texts) != k,
           "asking about different test files is a different question");
  return t.report();
}

/** What the walk does not descend into, and what it does not read. */
export string test_what_the_key_walk_leaves_out() {
  T t = T.create();
  t.isTrue(skipsDir(".git") && skipsDir("node_modules") && skipsDir(".cache"),
           "the three that are not source");
  t.isTrue(skipsDir("target"),
           "and target — build output changes constantly and decides no coverage, so including it "
             + "would invalidate every profile on every cargo build");
  t.isTrue(!skipsDir("packages") && !skipsDir("tools"), "the source trees are walked");

  t.isTrue(keyedFile("a.wac") && keyedFile("b.ts") && keyedFile("deno.json"),
           "the three kinds that decide what a test reaches");
  t.isTrue(!keyedFile("README.md"), "prose does not");
  t.isTrue(!keyedFile(".wac"), "and a bare extension names no file");
  return t.report();
}
