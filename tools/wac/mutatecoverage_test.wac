// Reading one coverage document, and the four ways it declines.
//
// **Declining is the whole content.** A partial profile does not fail; it says some lines are
// unreached when they are merely unmeasured, and a mutant in them is then scored against tests that
// never ran. Every refusal below is cheaper than the number it prevents.
// `issues/system/0161` step 6.

import { T } from "../../packages/wactest/src/assert.wac";
import { Core, Cli } from "std/platform.wac";
import { Profiled, Share, WAC_LANE_GRANTS, buildProfile, looksLikeAPoint, shareFrom, shareOf }
  from "./mutatecoverage.wac";
import { envOf, marker } from "./suitegate.wac";
import { itoa } from "../../packages/fmt/src/itoa.wac";

string good() {
  return "{\"entry\":\"packages/x/test/wac/a_test.wac\","
       + "\"skipped\":[],"
       + "\"all\":[\"a.wac:1\",\"a.wac:2\"],"
       + "\"tests\":{\"test_one\":[\"a.wac:1\"],\"test_two\":[\"a.wac:1\",\"a.wac:2\"]}}";
}

export string test_a_complete_profile_names_which_tests_reached_which_points() {
  T t = T.create();
  Share s = shareFrom(good(), "packages/x/test/wac/a_test.wac");
  t.isTrue(s.ok, "it read — " + s.why);
  t.eqI32(s.tests.len(), 2, "two tests");
  t.eqStr(s.tests[0] + "=" + s.points[0], "test_one=a.wac:1", "each with the points it reached");
  t.eqStr(s.tests[1] + "=" + s.points[1], "test_two=a.wac:1 a.wac:2", "and the second with two");
  t.eqI32(s.all.len(), 2, "and every point the entry has, reached or not");
  return t.report();
}

/** The entry may be named relative to a staged root, so a suffix match counts. */
export string test_the_entry_matches_by_suffix_too() {
  T t = T.create();
  t.isTrue(shareFrom(good(), "test/wac/a_test.wac").ok, "a suffix on a path boundary is this entry");
  t.isTrue(!shareFrom(good(), "other/a_test.wac").ok, "but a different path is not");
  t.isTrue(!shareFrom(good(), "wac/a_test.wa").ok, "and a partial segment is not a suffix");
  return t.report();
}

/**
 * **A partial profile is refused, and a missing `skipped` is refused too.**
 *
 * A document without the key is one this cannot reason about, and reading it as "nothing was skipped"
 * is exactly the assumption that turns a partial profile into a confident wrong answer.
 */
export string test_a_partial_profile_is_refused() {
  T t = T.create();
  string skipped = "{\"entry\":\"a_test.wac\",\"skipped\":[\"test_three\"],"
                 + "\"tests\":{\"test_one\":[\"a.wac:1\"]}}";
  Share s = shareFrom(skipped, "a_test.wac");
  t.isTrue(!s.ok, "one skipped test makes the profile partial");
  t.isTrue(s.why.indexOf("partial") >= 0, "and it says so: " + s.why);

  string silent = "{\"entry\":\"a_test.wac\",\"tests\":{\"test_one\":[\"a.wac:1\"]}}";
  Share q = shareFrom(silent, "a_test.wac");
  t.isTrue(!q.ok, "a document that does not say what it skipped is refused rather than assumed");
  t.isTrue(q.why.indexOf("does not say") >= 0, "and says which: " + q.why);

  string empty = "{\"entry\":\"a_test.wac\",\"skipped\":[],\"tests\":{}}";
  t.isTrue(!shareFrom(empty, "a_test.wac").ok, "and a run that reached no test is not a profile");
  t.isTrue(!shareFrom("not json at all", "a_test.wac").ok, "nor is text that is not JSON");
  return t.report();
}

/**
 * The grants are the lane's, not a plausible subset.
 *
 * A test skipped for want of a grant contributes no coverage, and code only that test reaches then
 * looks unreached. `issues/system/0176` is the day two lists disagreed.
 */
export string test_the_grants_are_the_lanes() {
  T t = T.create();
  string[] g = WAC_LANE_GRANTS();
  t.eqI32(g.len(), 5, "five of them");
  string all = "";
  for (i32 i = 0; i < g.len(); i++) { all = all + g[i] + " "; }
  t.isTrue(all.indexOf("--allow-read") >= 0 && all.indexOf("--allow-write") >= 0
           && all.indexOf("--allow-run") >= 0 && all.indexOf("--allow-env") >= 0
           && all.indexOf("--allow-net") >= 0,
           "read, write, run, env and net — the set the wac lane passes: " + all);
  return t.report();
}

/**
 * A real coverage run, against a fixture of one test.
 *
 * The parsing above is the half that can be tested from a string; this is the half that says the
 * binary is asked the right question and writes what this expects to read.
 */
export string test_a_real_run_produces_a_profile_this_can_read(Core core, Cli cli) {
  T t = T.create();
  string root = ".cache/mutatecoverage-fixture";
  cli.exec("bash", string[]("-c", "rm -rf '" + root + "'"), u8[0]()).wait();
  cli.mkdir(root + "/test/wac", true).wait();
  cli.writeFile(root + "/src.wac",
                "export bool small(i32 n) {\n  if (n < 10) { return true; }\n  return false;\n}\n"
                  .toBytes()).wait();
  cli.writeFile(root + "/test/wac/a_test.wac",
                ("import { T } from \"../../../../packages/wactest/src/assert.wac\";\n"
                 + "import { small } from \"../../src.wac\";\n"
                 + "export string test_small_is_small() {\n"
                 + "  T t = T.create();\n"
                 + "  t.isTrue(small(1), \"one is small\");\n"
                 + "  return t.report();\n"
                 + "}\n").toBytes()).wait();

  Share s = shareOf(core, cli, cli.cwd().wait() + "/native/v8/target/release/wac",
                    cli.cwd().wait(), root + "/test/wac/a_test.wac",
                    cli.cwd().wait() + "/" + root + "-prof");
  t.isTrue(s.ok, "the run produced a complete profile — " + s.why);
  if (!s.ok) { return t.report(); }
  t.eqI32(s.tests.len(), 1, "one test");
  t.eqStr(s.tests[0], "test_small_is_small", "named as the export is, with no translation");
  t.isTrue(s.points[0] != "", "and it reached something: " + s.points[0]);

  cli.exec("bash", string[]("-c", "rm -rf '" + root + "' '" + root + "-prof'"), u8[0]()).wait();
  return t.report();
}

/**
 * A coverage point is `file:line`, and the check exists because a mismatch is comfortable.
 *
 * `Profile.known` is keyed by `file:line` and `planFor` answers `widen` for any location it cannot
 * find. So a profile whose points arrived in some other spelling makes every mutant widen to its
 * whole scope — slower, never wrong, and indistinguishable in the output from a profile that had
 * nothing to say. The run would look like it was narrowing and never narrow once, which is why
 * `buildProfile` counts what it drops and says so rather than quietly keying on it.
 */
export string test_a_coverage_point_is_a_file_and_a_line() {
  T t = T.create();
  t.isTrue(looksLikeAPoint("packages/rlp/src/rlp.wac:134"), "the shape the profile writes");
  t.isTrue(looksLikeAPoint("a.wac:1"), "one digit is a line");
  // The last colon wins: a path may hold one, and the line is what follows the final separator.
  t.isTrue(looksLikeAPoint("a:b/c.wac:12"), "a colon earlier in the path is not the separator");

  t.isFalse(looksLikeAPoint("packages/rlp/src/rlp.wac"), "a path with no line is not a point");
  t.isFalse(looksLikeAPoint("packages/rlp/src/rlp.wac:"), "nor one with an empty line");
  t.isFalse(looksLikeAPoint(":12"), "nor a line with no file");
  t.isFalse(looksLikeAPoint("a.wac:12a"), "nor a line that is not a number");
  t.isFalse(looksLikeAPoint(""), "nor nothing at all");
  return t.report();
}

/**
 * A profile pass that has nothing to profile refuses rather than answering an empty profile.
 *
 * **An empty profile is worse than no profile**, and that is the whole of this case: handed on, every
 * location is unknown, so every mutant widens and the run costs exactly what it would have cost
 * without profiling — while the report says it profiled. `ok: false` is the difference between a run
 * that is slow and a run that is slow *and* silent about why.
 *
 * The nesting refusal is the other way this returns `ok: false`, and which one fires here depends on
 * whether the runner set the marker — so this asserts against that rather than against one of them.
 * `suitegate_test.wac` checks both arms of the decision itself, which is the part a test can pin.
 */
export string test_a_pass_with_nothing_to_profile_refuses(Core core, Cli cli) {
  T t = T.create();
  Profiled got = buildProfile(core, cli, "native/v8/target/release/wac", cli.cwd().wait(),
                              string[0](fill: ""), ".cache/mutatebuild-empty-prof", "", "");
  t.isFalse(got.ok, "an empty pass has nothing to narrow against");
  t.isTrue(got.why != "", "and says so rather than answering an empty profile silently");
  t.eqI32(got.p.known.len(), 0, "the profile it carries knows no points");

  bool nested = envOf(cli, marker()) != "";
  if (nested) {
    t.isTrue(got.why.indexOf("inside") >= 0,
             "running under the suite, the nesting guard is what refused: " + got.why);
  } else {
    t.isTrue(got.why.indexOf("no test file") >= 0,
             "not running under the suite, so it refused for want of anything to profile: "
               + got.why);
  }
  return t.report();
}

/**
 * A real pass over a real test file, assembled into what `selectTests` looks up.
 *
 * **The refusals above are only half a guard.** Every other case here asserts that `buildProfile`
 * declines something; a module that declined *everything* would pass all of them. This is the arm
 * that says it can also succeed — one fixture test, profiled, and the point it reaches keyed to the
 * name of the test that reached it.
 *
 * Under a runner that sets the marker there is no such arm to check, so that case asserts the
 * refusal instead. Both paths assert; neither skips.
 */
export string test_a_pass_assembles_a_profile_selectTests_can_look_up(Core core, Cli cli) {
  T t = T.create();
  string root = ".cache/mutatebuild-fixture";
  cli.exec("bash", string[]("-c", "rm -rf '" + root + "'"), u8[0]()).wait();
  cli.mkdir(root + "/test/wac", true).wait();
  cli.writeFile(root + "/src.wac",
                "export bool small(i32 n) {\n  if (n < 10) { return true; }\n  return false;\n}\n"
                  .toBytes()).wait();
  cli.writeFile(root + "/test/wac/a_test.wac",
                ("import { T } from \"../../../../packages/wactest/src/assert.wac\";\n"
                 + "import { small } from \"../../src.wac\";\n"
                 + "export string test_small_is_small() {\n"
                 + "  T t = T.create();\n"
                 + "  t.isTrue(small(1), \"one is small\");\n"
                 + "  return t.report();\n"
                 + "}\n").toBytes()).wait();

  string cwd = cli.cwd().wait();
  Profiled got = buildProfile(core, cli, cwd + "/native/v8/target/release/wac", cwd,
                              string[](root + "/test/wac/a_test.wac"), cwd + "/" + root + "-prof",
                              "", "");

  if (envOf(cli, marker()) != "") {
    t.isFalse(got.ok, "under the suite this refuses rather than re-entering it");
    t.isTrue(got.why.indexOf("inside") >= 0, "and says which guard: " + got.why);
  } else {
    t.isTrue(got.ok, "the pass produced a profile — " + got.why);
    if (got.ok) {
      t.isTrue(got.p.known.len() > 0,
               "and it knows some points, which is what makes it worth more than no profile");
      t.eqI32(got.p.files.len(), 1, "one test file");
      t.isTrue(got.p.cost[0] >= 0, "with a measured cost rather than the unmeasured -1");
      // Every point it knows is reached by the only test there is, so the mapping is checkable
      // without depending on which line the compiler assigns anything.
      bool named = true;
      for (i32 i = 0; i < got.p.known.len(); i++) {
        if (got.p.tests[i].indexOf("test_small_is_small") < 0) { named = false; }
      }
      t.isTrue(named,
               "and every point is keyed to the test that reached it, by the export's own name — a "
                 + "translated name is how a filter comes to match nothing");
    }
  }

  cli.exec("bash", string[]("-c", "rm -rf '" + root + "' '" + root + "-prof'"), u8[0]()).wait();
  return t.report();
}

/**
 * A second pass with the same key returns the profile the first one built, home map included.
 *
 * **The field worth asserting is `homeNames`.** `runPlanFor` turns the test names `selectTests` picked
 * back into entries to run, and a hit that lost that map hands it names it cannot place — so it
 * narrows nothing, and the run costs exactly what no profile costs while reporting that it profiled.
 * The encoding did not carry it until this test existed, and no round-trip test would have caught
 * that: an encoder and a test written against the encoder share the same blind spot.
 *
 * The second pass is given a binary that does not exist. A miss would try to spawn it and come back
 * refused, so `ok` being true is proof the answer came from the cache rather than from a run —
 * cheaper and far more direct than timing it.
 */
export string test_a_second_pass_with_the_same_key_comes_from_the_cache(Core core, Cli cli) {
  T t = T.create();
  if (envOf(cli, marker()) != "") {
    // Under the suite a profile pass refuses outright, so there is no cache behaviour to observe.
    // Asserting the refusal is the honest thing to check here rather than skipping.
    Profiled nested = buildProfile(core, cli, "x", ".", string[0](fill: ""), ".", ".", "k");
    t.isFalse(nested.ok, "under the suite this refuses before it reaches the cache at all");
    return t.report();
  }

  string root = ".cache/mutatecache-fixture";
  string cacheDir = root + "-cache";
  cli.exec("bash", string[]("-c", "rm -rf '" + root + "' '" + cacheDir + "' '" + root + "-prof'"),
           u8[0]()).wait();
  cli.mkdir(root + "/test/wac", true).wait();
  cli.writeFile(root + "/src.wac",
                "export bool small(i32 n) {\n  if (n < 10) { return true; }\n  return false;\n}\n"
                  .toBytes()).wait();
  cli.writeFile(root + "/test/wac/a_test.wac",
                ("import { T } from \"../../../../packages/wactest/src/assert.wac\";\n"
                 + "import { small } from \"../../src.wac\";\n"
                 + "export string test_small_is_small() {\n"
                 + "  T t = T.create();\n"
                 + "  t.isTrue(small(1), \"one is small\");\n"
                 + "  return t.report();\n"
                 + "}\n").toBytes()).wait();

  string cwd = cli.cwd().wait();
  string[] entries = string[](root + "/test/wac/a_test.wac");
  Profiled first = buildProfile(core, cli, cwd + "/native/v8/target/release/wac", cwd, entries,
                                cwd + "/" + root + "-prof", cwd + "/" + cacheDir, "akey");
  t.isTrue(first.ok, "the first pass profiled — " + first.why);

  // No such binary: only the cache can answer this one.
  Profiled second = buildProfile(core, cli, cwd + "/no/such/binary", cwd, entries,
                                 cwd + "/" + root + "-prof", cwd + "/" + cacheDir, "akey");
  t.isTrue(second.ok,
           "the second pass answered without running anything, which it can only do from the cache");
  if (first.ok && second.ok) {
    t.eqI32(second.p.known.len(), first.p.known.len(), "the same points came back");
    t.isTrue(second.homeNames.len() > 0,
             "and the home map survived the round trip — the field a hit would otherwise lose, "
               + "turning every later mutant back into a whole-scope run");
    t.eqStr(second.homeNames[0], first.homeNames[0], "naming the same test");
    t.eqStr(second.homeFiles[0], first.homeFiles[0], "in the same file");
  }

  // A different key is a different tree, and must not hit.
  Profiled other = buildProfile(core, cli, cwd + "/no/such/binary", cwd, entries,
                                cwd + "/" + root + "-prof", cwd + "/" + cacheDir, "bkey");
  t.isFalse(other.ok,
            "a key the cache has never seen misses, and the missing binary then fails the run — "
              + "which is the canary that the two hits above were hits");

  cli.exec("bash", string[]("-c", "rm -rf '" + root + "' '" + cacheDir + "' '" + root + "-prof'"),
           u8[0]()).wait();
  return t.report();
}
