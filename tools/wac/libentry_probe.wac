// A program that depends on the repository through its root entry, as a project outside it would:
// two names, from two packages, through `lib.wac`. `libentry_test.wac` builds it and counts what the
// build read.
import { json.parse, zstd.decompress } from "@/lib.wac";

export i32 main() {
  if (parse("[1, 2]".toBytes()).ok() is null) { return 1; }
  u8[] none = u8[]();
  return decompress(none).len() == 0 ? 0 : 2;
}
