// `packages/web`'s policy, from outside: each way a page could write script into its document traps,
// with a message saying which call refused what — through the handle layer and through `htmlOf`, which
// is what `Page.render` writes with `innerHTML` (`design/system/0012`, "Policy is in wac").
//
// Here rather than in the package because a trap ends the program that hit it, so each case is a run
// of its own, and the package's own tests cannot assume a `wac` binary to run one with.

import { T } from "../../packages/wactest/src/assert.wac";
import { Core, Cli, Exec } from "std";
import { binaryPath } from "../../packages/wactest/src/host.wac";

string FIXTURE() { return "tools/wac/webpolicy.wac"; }

/** What a run of the fixture on `which` wrote to stderr, or why it did not run. */
Exec ran(Cli cli, string which) {
  return cli.exec(binaryPath(cli), ["run", FIXTURE(), which], u8[]()).wait();
}

void refuses(T t, Cli cli, string which, string says) {
  Exec r = ran(cli, which);
  string err = string.fromBytes(r.stderr);
  t.isTrue(r.ran() && r.status != 0 && r.status != 3, which + " was not refused — status \{r.status}: " + err);
  t.isTrue(err.indexOf(says) >= 0, which + " should say `" + says + "`: " + err);
}

export string test_the_policy_holds_through_both_layers(Core core, Cli cli) {
  T t = T.create();
  // The canary: the fixture builds and runs, and allows what it should — else every refusal below
  // could be a build failure.
  Exec ok = ran(cli, "ok");
  t.isTrue(ok.ran() && ok.status == 0, "the allowed case ran — status \{ok.status}: " + string.fromBytes(ok.stderr));
  refuses(t, cli, "element-handler", "Element.attr: onerror — a handler is listened for");
  refuses(t, cli, "element-name", "Element.append: img src=x is not an element name");
  refuses(t, cli, "element-url", "Element.attr: href is a javascript: URL");
  refuses(t, cli, "element-script", "Element.append: a page cannot make a script element");
  refuses(t, cli, "html-handler", "htmlOf: onerror — a handler is listened for");
  refuses(t, cli, "html-name", "htmlOf: img src=x onerror=alert(1) x is not an element name");
  refuses(t, cli, "html-url", "htmlOf: href is a javascript: URL");
  refuses(t, cli, "html-script", "htmlOf: a page cannot make a script element");
  refuses(t, cli, "html-attr-name", "htmlOf: src=x onerror is not an attribute name");
  return t.report();
}

