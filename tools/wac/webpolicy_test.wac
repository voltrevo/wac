// `packages/web`'s policy, from outside: each way a page could write script into its document traps,
// with a message saying which call refused what — through the handle layer and through `htmlOf`, which
// writes a tree out as HTML (`design/system/0012`, "Policy is in wac").
//
// Here rather than in the package because a trap ends the program that hit it, so each case is a run
// of its own, and the package's own tests cannot assume a `wac` binary to run one with.

import { T } from "../../packages/wactest/src/assert.wac";
import { Exec, ChildEnv, Env, Launch, Procs, Sys } from "std";
import { binaryPath } from "../../packages/wactest/src/host.wac";
import { flatten } from "core";

string FIXTURE() { return "tools/wac/webpolicy.wac"; }

/** What a run of the fixture on `which` wrote to stderr, or why it did not run. */
Exec ran(Env env, Procs procs, string which) {
  return flatten(procs.exec(binaryPath(env), ["run", FIXTURE(), which], u8[](), ChildEnv.inherited(), Launch.plain()).wait()).unwrap();
}

void refuses(T t, Env env, Procs procs, string which, string says) {
  Exec r = ran(env, procs, which);
  string err = string.fromBytes(r.stderr);
  t.isTrue(r.ran() && r.status != 0 && r.status != 3, which + " was not refused — status \{r.status}: " + err);
  t.isTrue(err.indexOf(says) >= 0, which + " should say `" + says + "`: " + err);
}

export string test_the_policy_holds_through_both_layers(Sys sys) {
  Env env = sys.env();
  Procs procs = sys.procs();
  T t = T.create();
  // The canary: the fixture builds and runs, and allows what it should — else every refusal below
  // could be a build failure.
  Exec ok = ran(env, procs, "ok");
  t.isTrue(ok.ran() && ok.status == 0, "the allowed case ran — status \{ok.status}: " + string.fromBytes(ok.stderr));
  refuses(t, env, procs, "element-handler", "Element.attr: onerror — a handler is listened for");
  refuses(t, env, procs, "element-name", "Element.append: img src=x is not an element name");
  refuses(t, env, procs, "element-url", "Element.attr: href is a javascript: URL");
  refuses(t, env, procs, "element-script", "Element.append: a page cannot make a script element");
  refuses(t, env, procs, "html-handler", "htmlOf: onerror — a handler is listened for");
  refuses(t, env, procs, "html-name", "htmlOf: img src=x onerror=alert(1) x is not an element name");
  refuses(t, env, procs, "html-url", "htmlOf: href is a javascript: URL");
  refuses(t, env, procs, "html-script", "htmlOf: a page cannot make a script element");
  refuses(t, env, procs, "html-attr-name", "htmlOf: src=x onerror is not an attribute name");
  return t.report();
}

