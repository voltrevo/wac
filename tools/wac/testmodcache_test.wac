// The `wac test` build cache covers a directory whose graph reaches the embedded trees.
//
//     wac test --allow-read --allow-write --allow-run --allow-env tools/wac/testmodcache_test.wac
//
// `issues/system/0204` gave `wac test` a content-keyed cache for the aggregate module it compiles per
// directory, so that an agent running one package's tests over and over pays for the compile once.
// The invariant this file holds is that the cache *engages* for a directory whose graph reaches the
// embedded `core/` and `std/` trees, which is nearly all of them.
//
// It has been asked of two different caches. The first was the native binary's, in Rust, keyed by
// `closure_of` — a graph walk that marked a closure **incomplete** when an import named a `.wac` it
// could not read, which is right, because a key standing for less than it claims is a stale hit
// waiting to happen. The embedded trees have no files to read, so they are skipped instead: their
// content is inside the seed and the key already hashes the seed. Only `std/` was skipped, so a file
// importing `core/option.wac` sent the scan looking for `packages/<pkg>/src/core/option.wac`, the
// closure went incomplete, and the directory recompiled on every run — silently, because a cache
// that is never consulted looks exactly like one that always misses.
//
// **The second is the one this asks now**, and it is the wac program's: `wac test` is
// `packages/wac/src/wac.wac` since 2026-08-26, so the host's cache went with the host's command
// surface and `buildCachePath` answers for both `build` and `test`. The failure mode it can have is
// not `closure_of`'s but its neighbour — the key must not carry the *aggregate's* path, which has the
// clock in it, or every run misses and nothing says so. That is what the second half below checks.
//
// Measured on `packages/box/test/wac` when it was wired up: **18s cold, 2s warm**, and 19s again
// after one character changed in `packages/box/src/box.wac`.
//
// **Why this points the cache at a directory of its own.** Its only observable is an entry appearing,
// and the shared default — `$HOME/.wac/cache/build` — holds every agent's builds and is swept as it
// grows. Asserting "an entry appeared" there would be asserting something about other agents' runs as
// much as about this one, and would go flaky the moment the sweep fired. A private `$WAC_HOME` makes
// the claim exact: *this* run wrote *this* entry.

import { T } from "../../packages/wactest/src/assert.wac";
import { Core, Cli, Exec } from "std/platform.wac";
import { itoa } from "../../packages/fmt/src/itoa.wac";
import { wacBinary } from "../../packages/wactest/src/built.wac";
import { freshDir } from "../../packages/wactest/src/host.wac";

/**
 * A directory that **does** reach `core/`, which is the whole point of the subject choice.
 *
 * `packages/bytes` was the first pick and could not fail: measured on both binaries with a private
 * cache directory, it writes an entry either way, because nothing in its graph names a `core/…`
 * specifier. `packages/json` and `packages/url` write **no entry** without the fix and one with it.
 * A subject that is cacheable regardless makes this test green whatever `closure_of` does.
 */
const string SUBJECT = "packages/json/test/wac";

i32 entriesIn(Cli cli, string dir) {
  string[]? names = cli.readDir(dir).wait();
  if (names is null) { return 0; }
  i32 n = 0;
  for (i32 i = 0; i < names!.len(); i++) {
    if (names![i].indexOf(".wasm") > 0) { n = n + 1; }
  }
  return n;
}

/**
 * One `wac test` of the subject directory, with the cache pointed at `dir`.
 *
 * `WAC_HOME` rather than a cache path: the program derives `<home>/cache/build` from it, and there is
 * no separate variable for the directory itself. `false` for `clearEnv`, so the child keeps `PATH`
 * and whatever else it needs and gains this one.
 */
i32 runWith(Cli cli, string dir) {
  Exec r = cli.execWith(wacBinary(cli),
      string[]("test", "--allow-read", "--allow-write", "--allow-run", "--allow-env", "--allow-net",
               SUBJECT),
      u8[0](), string[]("WAC_HOME=" + dir), false, false).wait();
  return r.ran() ? r.status : 0 - 1;
}

export string test_a_directory_that_imports_core_is_cached(Core core, Cli cli) {
  T t = T.create();
  string dir = cli.cwd().wait() + "/.cache/testmod-probe";
  string whyDir = freshDir(cli, dir);
  t.isTrue(whyDir == "", whyDir);

  // First run: an empty cache, so this compiles and remembers.
  i32 first = runWith(cli, dir);
  t.eqI32(first, 0, "the subject directory did not pass, so the cache claim is about a broken run");
  i32 cold = entriesIn(cli, dir + "/cache/build");
  t.isTrue(cold > 0,
      "no entry was written, so `wac test` compiled " + SUBJECT + " and remembered nothing — either "
      + "`buildCachePath` is refusing this command line or `rememberBuild` is not reached on the "
      + "test path");

  // Second run: the same sources, so the same key, so no *additional* entry.
  i32 second = runWith(cli, dir);
  t.eqI32(second, 0, "the subject directory did not pass on the second run");
  t.eqI32(entriesIn(cli, dir + "/cache/build"), cold,
      "a second run of unchanged sources wrote another entry, so the key is not stable — the most "
      + "likely thing to have got into it is the generated aggregate's own path, which carries the "
      + "clock so that two runs never collide, and so makes every key a miss");

  cli.remove(dir, true).wait();
  return t.report();
}
