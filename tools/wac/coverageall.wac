// Every package's coverage task, in one run, with the failures named.
//
//   wac task coverage:all
//   wac task coverage:all --verbose    # each failing task's output, in full
//
// ## Why this exists
//
// There were eighteen `coverage:*` tasks and, until this file, no way to run them but by hand, one at
// a time. So nobody did — and three of them had been exiting 1 for days without anyone noticing:
//
//   - `zstd`, four exemptions pinned to lines the code had moved off;
//   - `gzip`, two of the same;
//   - `crypto`, one of the same, plus `sha1.wac` compiled into the run and never once called — 41
//     branch points reading 0%, which is a hole in the driver rather than in the tests.
//
// Each of those tasks was working exactly as designed. The check that catches a moved exemption is
// good, and it fired, and it printed the right thing every time. It just printed it where nothing was
// looking. **How long it took to notice is the number that matters**: `fs` exited 1 for three days,
// on every run nobody made, while the package's README stated a figure from before the file it was
// missing existed.
//
// `tools/push.sh` runs this before the push now.
//
// **A green ratchet does not defend a percentage.** What it fails on is a point that is neither
// driven nor recorded — so code can arrive with its exemptions written down and the number falls
// while the task stays green, which is how four package READMEs came to state a figure that was years
// of ticks old in repository time. A figure quoted in prose is dated for that reason.
//
// **In wac since 2026-08-30**, from tools/coverageAll.ts — `issues/system/0289b`. Two things the port
// improves rather than preserves, both of which the TypeScript's own comments asked for:
//
//   - **The task registry is parsed by the parser that dispatches it.** That file hand-rolled a strip
//     of comments and trailing commas and fed the result to `JSON.parse`, with a comment saying
//     `packages/json`'s real parser was "reachable from wac, which this file is not yet". It is now:
//     `packages/wac/src/tasks.wac`'s `tasksIn` is what `wac task` itself reads the registry with, so
//     this cannot disagree with the dispatcher about what a task is. The hand-rolled version had
//     already cost one gate: it read `deno.json` and got `Object.keys(undefined)` the day the tasks
//     moved to `tasks.json5`.
//   - **tools/coverageOrder.ts comes with it.** It was a separate module because coverageAll.ts
//     spawns its drivers at the top level and so could not be imported without running — nine lines of
//     ordering with a two-minute sweep as their only test. A wac function is testable where it is, so
//     `dispatchOrder` is below and `coverageall_test.wac` covers it directly.
//
// The times file changed format with the language. It was `.cache/coverage-times.json`; it is
// `.cache/coverage-times` and one `name<tab>millis` per line, which is what the suite's own times file
// has used since it moved. One run after this lands dispatches alphabetically, which is what a fresh
// checkout has always done, and the stale `.json` is removed rather than left looking live.

import { ChildEnv, Exec, Launch, SpawnFault, Stat, Sys, Clock, Env, Files, Output, Procs, Unsupported } from "std";
import { itoa, itoa64, atoi } from "../../packages/fmt/src/itoa.wac";
import { contains, startsWith, endsWith, joined, splitLines }
       from "../../packages/wactest/src/strings.wac";
import { Task, tasksFile, tasksIn } from "../../packages/wac/src/tasks.wac";
import { sortStrings } from "./covledger.wac";
import { wacBinary } from "../../packages/wactest/src/built.wac";
import { announce, unannounce } from "./suitegate.wac";
import { Result, Ticket, TicketBase, flatten } from "core";

/**
 * Four at a time, because nineteen packages one after another is 38s of every push.
 *
 * `tools/push.sh` runs this after the suite and before the push, so nothing else is on the machine —
 * and each of these is one driver over one package's probes, not the gigabyte-scale builds the heavy
 * lane holds back. Four is the width measured for the suite's own passes; the same number here needs
 * no separate argument.
 */
static i32 WORKERS = 4;

string timesPath() { return ".cache/coverage-times"; }
string staleTimesPath() { return ".cache/coverage-times.json"; }

/** How long a wait sleeps before re-checking. Short enough that a missed edge costs nothing. */
i32 pollMs() { return 250; }

/**
 * How long the sweep may make **no progress at all** before it gives up and says so.
 *
 * This is a detector, not a margin. The slowest single driver measured here is `platform` at 130s
 * alone and `tor` at 217s with another agent's gate on the machine, so this is about four times the
 * worst seen — `issues/system/0289b` has the numbers.
 *
 * **It exists because a run of this held the suite lock for five minutes and had to be killed.** The
 * cause was `isSweep` below — a thirty-eighth job that was itself a whole sweep — and the reason it
 * cost so much to find is that the sweep had no way to say what it was waiting for. It printed `ok`
 * thirty-seven times and then nothing, which reads as a hang whatever is actually happening.
 *
 * So the bound is not really about that bug, which is fixed: it is about the shape. An unbounded wait
 * here is an unbounded hold on a lock every agent needs, and any future driver that wedges would cost
 * the same again. Bounded, it names the packages it was still waiting on and exits, which is a
 * failure somebody can read.
 */
i64 stallMs() { return 900000 as i64; }

/** What one package's driver did. */
struct Run {
  string pkg;
  i32 status;
  i64 ms;
  string output;
  string kind;
}

/**
 * Every `coverage:*` package there is, read from `tasks.json5` rather than listed here.
 *
 * **It was a literal, and it had drifted.** Nineteen names against twenty-one tasks: `raster` and
 * `wacpkg` existed, were never swept, and so had ratchets that nothing enforced — a sweep that
 * silently covers less than it claims reads exactly like one that covers everything, until the
 * package it skipped regresses. Both passed when this was found, which is the only reason it cost
 * nothing. Deriving it means adding a task is the whole of adding it to the sweep.
 */
export string[] packagesOf(Task[] tasks) {
  i32 n = 0;
  for (i32 pass = 0; pass < 2; pass++) {
    string[] out = pass == 1 ? string[].filled(n, "") : string[].filled(0, "");
    i32 at = 0;
    for (i32 i = 0; i < tasks.len(); i++) {
      if (!startsWith(tasks[i].name, "coverage:") || isSweep(tasks[i].name)) { continue; }
      if (pass == 1) { out[at] = tasks[i].name.slice(9, tasks[i].name.len()); }
      at = at + 1;
    }
    if (pass == 1) { sortStrings(out, out.len()); return out; }
    n = at;
  }
  return string[].filled(0, "");
}

/**
 * The `coverage:` tasks that are **sweeps rather than packages**, and must never be dispatched as one.
 *
 * `coverage:all` was the only exclusion, because it was the only sweep. Adding `coverage:union` on
 * 2026-08-30 made a second one, and this function dispatched it: the sweep ran 37 drivers plus a
 * *nested whole-union run*, which is another 37 drivers one at a time. The visible symptom is not a
 * crash — it is a run that prints `ok` for all 37 real packages and then appears to hang, holding the
 * suite lock, because a thirty-eighth job nobody counted is still going. It took a `ps` showing a
 * `wac task coverage:union` child to see it; the arithmetic never showed, because 37 distinct `ok`
 * lines is exactly what 38 dispatched jobs with one outstanding looks like.
 *
 * Named here rather than derived. The tempting rule — "a package is a `coverage:` task whose name is
 * a directory under `packages/`" — is wrong for `core`, whose tree is at the repository root and
 * which is why `driverOf` reads the command instead of assuming the path.
 */
export bool isSweep(string task) {
  return task == "coverage:all" || task == "coverage:union";
}

/** The command for `coverage:<pkg>`, or `""`. */
export string commandFor(Task[] tasks, string pkg) {
  for (i32 i = 0; i < tasks.len(); i++) {
    if (tasks[i].name == "coverage:" + pkg) { return tasks[i].command; }
  }
  return "";
}

/**
 * Where a package's driver actually is, read out of the *command* rather than assumed.
 *
 * `packages/<pkg>/cov.ts` is wrong for `core`, whose tree is at the repository root — and the version
 * of this that assumed it reported `core` as having no driver at all while a `cov.ts` sat there. The
 * same assumption would be wrong for the next tree that moves. The command names its own file, so
 * that is what is read.
 *
 * `covreport.wac` is skipped because it is the shared *reporter* several wac drivers are run through,
 * not any one package's driver — the first `.ts` or `.wac` that is not it is the answer.
 */
export string driverOf(string command) {
  string[] words = splitOn(command, " ");
  for (i32 i = 0; i < words.len(); i++) {
    string w = words[i];
    if (!endsWith(w, ".ts") && !endsWith(w, ".wac")) { continue; }
    if (endsWith(w, "covreport.wac")) { continue; }
    return w;
  }
  return "";
}

/** `s` cut at every `sep`, keeping nothing empty — the words of a command line. */
export string[] splitOn(string s, string sep) {
  i32 n = 0;
  for (i32 pass = 0; pass < 2; pass++) {
    string[] out = pass == 1 ? string[].filled(n, "") : string[].filled(0, "");
    i32 at = 0;
    i32 from = 0;
    for (i32 i = 0; i <= s.len(); i++) {
      if (i < s.len() && s.slice(i, i + 1) != sep) { continue; }
      if (i > from) {
        if (pass == 1) { out[at] = s.slice(from, i); }
        at = at + 1;
      }
      from = i + 1;
    }
    if (pass == 1) { return out; }
    n = at;
  }
  return string[].filled(0, "");
}

/**
 * The packages this sweep does **not** know about, which is a different thing from "no driver".
 *
 * `packagesOf` is derived from the `coverage:` tasks, and the comment there says why. True, and it has
 * one consequence nobody had written down — a package with **no task at all** is not reported as
 * having no driver. It is not reported. It does not exist to this file.
 *
 * So the summary line said "17 hold a coverage floor" over 21 packages while 18 more sat on disk with
 * no measurement of any kind, and the number read like a near-complete answer. `issues/system/0205`
 * is about floors; this is about the set they are floors over, and it is the same shape as
 * `packages/http`'s `proxy.wac`, which was absent from that package's report rather than uncovered.
 * The denominator is the one number that cannot warn you it is wrong, so it is printed.
 *
 * **Counted, not failed.** A package acquiring a driver is work, and a sweep that went red the moment
 * this was noticed would have gone red for everyone, on somebody else's push, over a fact that has
 * been true all along. It is a line of output and a name list.
 */
string[] unmeasured(Files fs, string[] known) {
  string[]? names = flatten(fs.readDir("packages").wait()).ok();
  if (names is null) { return string[].filled(0, ""); }
  string[] here = names!;
  i32 n = 0;
  for (i32 pass = 0; pass < 2; pass++) {
    string[] out = pass == 1 ? string[].filled(n, "") : string[].filled(0, "");
    i32 at = 0;
    for (i32 i = 0; i < here.len(); i++) {
      bool isKnown = false;
      for (i32 k = 0; k < known.len(); k++) { if (known[k] == here[i]) { isKnown = true; } }
      if (isKnown) { continue; }
      // No `src/` — a package of fixtures or docs, not code this could measure.
      if (!flatten(fs.stat("packages/" + here[i] + "/src").wait()).orElse(Stat.of(false, false, false, 0, 0, false, false, 0, 0)).isDir) { continue; }
      if (pass == 1) { out[at] = here[i]; }
      at = at + 1;
    }
    if (pass == 1) { sortStrings(out, out.len()); return out; }
    n = at;
  }
  return string[].filled(0, "");
}

/**
 * The packages to run, longest-first, from the previous run's measurements.
 *
 * **The tail is the whole wall time, and alphabetical order put the tail last.** A run's best possible
 * wall is `max(longest driver, work / workers)`; measured on 2026-08-29, back to back:
 *
 *     alphabetical    696s of work, longest 94s  ->  ideal 174s, actual 204s   (17% over)
 *     longest-first   471s of work, longest 89s  ->  ideal 118s, actual 119s   ( 1% over)
 *
 * Compare the two ratios and not the two walls. The second run had a third less work in it — these
 * share a machine with two other agents and with each other's warm caches — so 204s against 119s
 * flatters this considerably. What the change bought is the distance from each run's own bound, and
 * that went from 30s to 1s.
 *
 * `packages` arrives alphabetical and is left that way by the caller: it is what the report is sorted
 * back into, and a reader scanning for a red should not have the rows move because a machine was busy.
 *
 * **A package with no recorded time goes first**, which is the safe end. An unknown is usually a new
 * package and short, so putting it first costs nothing; putting it last risks re-creating the exact
 * problem this fixes, for a package nobody has timed yet. With no file at all every package is
 * unknown, they all compare equal, and the result is the alphabetical order that arrived — which is
 * what a fresh checkout did before any of this existed. A stable sort is what makes that true, so this
 * is an insertion sort rather than anything cleverer.
 */
export string[] dispatchOrder(string[] packages, string[] names, i64[] millis) {
  string[] out = string[].filled(packages.len(), "");
  i64[] key = i64[].filled(packages.len(), 0);
  for (i32 i = 0; i < packages.len(); i++) {
    i64 t = recordedMs(packages[i], names, millis);
    // Unknown sorts before every timed one, and equal to every other unknown.
    i64 k = t < (0 as i64) ? 9000000000000000 : t;
    i32 at = i;
    while (at > 0 && key[at - 1] < k) {
      key[at] = key[at - 1];
      out[at] = out[at - 1];
      at = at - 1;
    }
    key[at] = k;
    out[at] = packages[i];
  }
  return out;
}

/** What `name` took last time, or -1. */
i64 recordedMs(string name, string[] names, i64[] millis) {
  for (i32 i = 0; i < names.len(); i++) { if (names[i] == name) { return millis[i]; } }
  return -1 as i64;
}

/** The times file's text. Missing or unreadable is not an error — it is the first run. */
string readTimes(Files fs) {
  u8[]? f = flatten(fs.readFile(timesPath()).wait()).ok();
  return (f is not null) ? string.fromBytes(f!) : "";
}

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Clock clock = sys.clock();
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  bool verbose = false;
  i32 argc = argv.len();
  for (i32 i = 0; i < argc; i++) {
    if (argv[i] == "--verbose") { verbose = true; }
  }

  // Announced so another agent's suite gate can see this: it builds programs and runs them, and
  // nothing else made it visible. `issues/system/0142`.
  string heavy = announce(clock, env, fs, "coverage:all");

  u8[]? reg = flatten(fs.readFile(tasksFile()).wait()).ok();
  if ((reg is null)) {
    err.line("coverage:all: cannot read " + tasksFile());
    unannounce(fs, heavy);
    return 1;
  }
  Task[] tasks = tasksIn(reg!);
  string[] packages = packagesOf(tasks);
  if (packages.len() == 0) {
    err.line("coverage:all: no `coverage:` tasks in " + tasksFile() + " — did the registry move?");
    unannounce(fs, heavy);
    return 1;
  }

  string[] rows = splitLines(readTimes(fs));
  string[] tNames = string[].filled(rows.len(), "");
  i64[] tMillis = i64[].filled(rows.len(), 0);
  i32 tN = 0;
  for (i32 i = 0; i < rows.len(); i++) {
    i32 tab = rows[i].indexOf("\t");
    if (tab < 0) { continue; }
    tNames[tN] = rows[i].slice(0, tab);
    tMillis[tN] = atoi(rows[i].slice(tab + 1, rows[i].len())) as i64;
    tN = tN + 1;
  }

  string[] dispatch = dispatchOrder(packages, tNames, tMillis);

  i64 startedAll = nowMs(clock);
  Run[] results = Run[].filled(dispatch.len(), Run("", 0, 0 as i64, "", ""));
  i32 done = 0;

  // The queue. Each slot holds one ticket; when any of them answers, its line is printed and the slot
  // takes the next package. `waitAny` answers the *index* in the list it was handed, so the list is
  // rebuilt each turn from the slots that are still busy.
  //
  // **Each line is printed when its package finishes, so they arrive out of order.** That is why the
  // package name is on every line: the order was never what identified them. The summary and the
  // failure reports below read `results`, which is filled in `packages` order, so what a reader scans
  // for a red is stable even though the log is not.
  i32 workers = WORKERS < dispatch.len() ? WORKERS : dispatch.len();
  Ticket<Result<Exec, SpawnFault>>[] live = Ticket<Result<Exec, SpawnFault>>[].defaulted(workers);
  i32[] slotItem = i32[].filled(workers, 0);
  i64[] slotStart = i64[].filled(workers, 0);
  bool[] busy = bool[].filled(workers, false);
  i32 next = 0;
  // Only a completion counts as progress; a poll that timed out is the ordinary case while a long
  // driver runs, and must not keep the stall bound alive.
  i64 lastProgress = nowMs(clock);

  for (i32 s = 0; s < workers && next < dispatch.len(); s++) {
    live[s] = procs.exec(wacBinary(env), ["task", "coverage:" + dispatch[next]], u8[](), ChildEnv.inherited(),
                         Launch.plain());
    slotItem[s] = next;
    slotStart[s] = nowMs(clock);
    busy[s] = true;
    next = next + 1;
  }

  while (true) {
    i32 nBusy = 0;
    for (i32 s = 0; s < workers; s++) { if (busy[s]) { nBusy = nBusy + 1; } }
    if (nBusy == 0) { break; }
    TicketBase[] racing = TicketBase[].defaulted(nBusy + 1);
    i32[] slotOf = i32[].filled(nBusy, 0);
    i32 at = 0;
    for (i32 s = 0; s < workers; s++) {
      if (!busy[s]) { continue; }
      racing[at] = live[s];
      slotOf[at] = s;
      at = at + 1;
    }
    // **A deadline rather than for ever.** The old `waitAny` waited on the completion counter the
    // host bumps, so it answered an *edge*; a driver that settled between the bookkeeping below and
    // the next call had already bumped the counter, and an unbounded wait then slept for a transition
    // that had been and gone. Tickets keep their outcome, so that race is gone, but the deadline
    // stays: it is what lets the stall bound below fire at all.
    //
    // It hung exactly once, in the gate, and the ordering is why it did not hang before: dispatched
    // alphabetically the last two drivers were `platform` and `tor`, thirteen seconds apart, and
    // nothing raced. Longest-first puts those two first, so the *tail* is a dozen short packages
    // finishing within a second of each other — the ordering this file added is what made its own
    // race reachable. 37 of 37 printed `ok`, then the process sat in a futex at zero CPU.
    Ticket<Result<void, union<Unsupported>>> timer = clock.sleepMillis(pollMs());
    racing[nBusy] = timer;
    i32 which = Ticket.first(racing).wait().orElse(nBusy);
    if (which == nBusy) { which = -1; } else { timer.cancel(); }
    if (which < 0) {
      if (nowMs(clock) - lastProgress <= stallMs()) { continue; }
      string stuck = "";
      for (i32 i = 0; i < nBusy; i++) {
        i32 s = slotOf[i];
        stuck = stuck + (stuck == "" ? "" : ", ") + dispatch[slotItem[s]]
              + " (" + seconds(nowMs(clock) - slotStart[s]) + ")";
      }
      err.line("coverage:all: no driver has finished in " + wholeSeconds(stallMs())
                + "s — giving up rather than holding the suite lock.");
      err.line("   " + itoa(done) + " of " + itoa(dispatch.len())
                + " finished; still waiting on: " + stuck);
      err.line("   Run those by hand — `wac task coverage:<pkg>` — and see issues/system/0289b.");
      unannounce(fs, heavy);
      return 1;
    }

    i32 slot = slotOf[which];
    auto ran = flatten(live[slot].wait());
    Exec? r = ran.ok();
    string pkg = dispatch[slotItem[slot]];
    i64 ms = nowMs(clock) - slotStart[slot];
    string output = (r is not null) ? string.fromBytes(r!.stdout) + string.fromBytes(r!.stderr) : "";
    // A driver that could not be started is a failure, and its fault is the only thing that says so.
    i32 status = (r is not null) ? r!.status : 1;
    if (r is null) { output = output + "error: \{ran.isErr() ? "\{ran.err()!}" : ""}\n"; }
    results[indexIn(packages, pkg)] = Run(pkg, status, ms, output, "");
    done = done + 1;
    lastProgress = nowMs(clock);
    // **`n of m` on every line**, because the alternative is what happened on 2026-08-30: a run
    // dispatched 38 jobs, printed 37 and appeared to hang, and nothing on screen distinguished
    // "finished" from "one job left". A count is one field and it makes a stuck run legible at a
    // glance rather than after a `ps`.
    out.line((status == 0 ? "ok  " : "FAIL") + "  coverage:" + pkg + "  " + seconds(ms)
             + "  (" + itoa(done) + " of " + itoa(dispatch.len()) + ")");

    busy[slot] = false;
    if (next < dispatch.len()) {
      live[slot] = procs.exec(wacBinary(env), ["task", "coverage:" + dispatch[next]], u8[](), ChildEnv.inherited(),
                         Launch.plain());
      slotItem[slot] = next;
      slotStart[slot] = nowMs(clock);
      busy[slot] = true;
      next = next + 1;
    }
  }

  for (i32 i = 0; i < results.len(); i++) {
    results[i] = Run(results[i].pkg, results[i].status, results[i].ms, results[i].output,
                        kindOf(fs, driverOf(commandFor(tasks, results[i].pkg))));
  }

  writeTimes(fs, packages, results, tNames, tMillis);

  i32 failed = 0;
  i64 work = 0 as i64;
  for (i32 i = 0; i < results.len(); i++) {
    if (results[i].status != 0) { failed = failed + 1; }
    work = work + results[i].ms;
  }
  i64 elapsed = nowMs(clock) - startedAll;

  out.line("\n" + itoa(results.len() - failed) + "/" + itoa(results.len()) + " ran in "
           + wholeSeconds(elapsed) + "s (" + wholeSeconds(work) + "s of work at " + itoa(workers)
           + " workers) — " + itoa(countKind(results, "floor")) + " hold a coverage floor, "
           + itoa(countKind(results, "entries")) + " only check their own exemptions have not drifted, "
           + itoa(countKind(results, "reports")) + " report and cannot fail"
           + (countKind(results, "no driver") > 0
              ? ", " + itoa(countKind(results, "no driver")) + " have no driver at all" : ""));

  // **And which drivers cannot fail**, because the line above counts them and a count does not name.
  // `1 report and cannot fail` sat in every gate's output; one is a number that reads as a rounding
  // rather than as a package, and the sweep is the only thing that knows which. `issues/system/0288b`
  // is what that one turned out to be. Everything that is not a floor, not only the `reports` ones: an
  // `entries` driver can fail, but only when an exemption it already carries has drifted, so coverage
  // falling past it is as silent there.
  string weak = "";
  for (i32 i = 0; i < results.len(); i++) {
    if (results[i].kind == "floor" || results[i].pkg == "") { continue; }
    weak = weak + (weak == "" ? "" : ", ") + results[i].pkg + " (" + results[i].kind + ")";
  }
  if (weak != "") { out.line("   no coverage floor: " + weak); }

  // And what it is a sweep *of*, which the line above cannot say because it counts only what it ran.
  string[] unswept = unmeasured(fs, packages);
  if (unswept.len() > 0) {
    out.line("   " + itoa(unswept.len())
             + " package(s) have no coverage task and are not in the numbers above: "
             + joined(unswept, ", "));
  }

  for (i32 i = 0; i < results.len(); i++) {
    if (results[i].status == 0) { continue; }
    out.line("\n── coverage:" + results[i].pkg + " (exit " + itoa(results[i].status) + ")");
    string[] lines = splitLines(results[i].output);
    i32 shown = 0;
    for (i32 k = 0; k < lines.len(); k++) {
      if (!verbose && !isFailureLine(lines[k])) { continue; }
      out.line("   " + stripAnsi(lines[k]));
      shown = shown + 1;
    }
    if (!verbose && shown == 0) {
      out.line("   (nothing matched the known failure shapes — re-run with --verbose)");
    }
  }

  unannounce(fs, heavy);
  return failed > 0 ? 1 : 0;
}

/** Where `pkg` goes in the report, which is `packages` order and not dispatch order. */
i32 indexIn(string[] packages, string pkg) {
  for (i32 i = 0; i < packages.len(); i++) { if (packages[i] == pkg) { return i; } }
  return 0;
}

/**
 * The lines worth repeating from a failing driver's output.
 *
 * **`is listed as unreach` and not the whole sentence**, because the whole sentence was one word too
 * specific. `packages/crypto`'s driver said "is listed as unreached but was covered" and gzip's
 * `cov.ts` said "unreachable" — so a stale gzip entry of that kind exited 1 and had its only
 * explanation filtered out here. What reached the screen was the *continuation* line, "That reason no
 * longer holds — drop the entry.", which matched on `no longer holds` by accident: a reason with its
 * subject removed, naming no file and no line.
 */
export bool isFailureLine(string line) {
  return contains(line, "no longer holds")
      || contains(line, "is listed as unreach")
      || contains(line, "branch point(s) uncovered")
      || startsWith(line, "error");
}

/** `line` without its colour escapes, which a log file should not carry. */
export string stripAnsi(string line) {
  string out = "";
  i32 i = 0;
  while (i < line.len()) {
    if (line.slice(i, i + 1) != "\u{1b}") { out = out + line.slice(i, i + 1); i = i + 1; continue; }
    // `ESC [ … m` — skip to the terminator rather than guessing its length.
    i32 k = i + 1;
    if (k < line.len() && line.slice(k, k + 1) == "[") {
      while (k < line.len() && line.slice(k, k + 1) != "m") { k = k + 1; }
      i = k + 1;
      continue;
    }
    i = i + 1;
  }
  return out;
}

/**
 * How many of these can actually fail — and it is five of twenty-one.
 *
 * **The summary used to read `19/19 passed`, which is not what happened.** Only `crypto`, `fs`,
 * `gzip`, `ssh` and `zstd` end their driver with a failure path; the others finish with `report(...)`
 * and exit 0 whatever they measured. So a run where a package lost half its coverage says `passed`
 * about it, and the paragraph `tools/push.sh` prints underneath — "a package above is below its
 * recorded coverage" — is true of five of them.
 *
 * Read from each driver rather than hardcoded, so the number follows the drivers instead of aging into
 * another wrong figure. Whether the other sixteen *should* assert a floor is a decision about each
 * package, not something to infer here; naming the count is what stops the summary claiming it either
 * way.
 *
 * **Either driver, and "no driver" is its own answer.** A package's driver is `cov.ts` until it moves
 * to `test/cov_exercise.wac`, and reading only the first meant a converted package fell through into
 * "reports" — right for one with no failure path, and a silent wrong answer for one that has it.
 *
 * **A wac driver is exercises and nothing else *unless it ratchets*.** The marker is the call to
 * `tools/wac/covledger.wac`'s shared two-way ratchet — not a `return 1;` somewhere in the file, which
 * would be a classification pretending to be a measurement. "floor" rather than "entries", and that is
 * the stronger of the two: the shared ratchet fails when a point nothing reaches has no entry *and*
 * when an entry it carries has been covered or has drifted.
 */
string kindOf(Files fs, string path) {
  if (path == "") { return "no driver"; }
  u8[]? f = flatten(fs.readFile(path).wait()).ok();
  if ((f is null)) { return "no driver"; }
  string src = string.fromBytes(f!);
  if (endsWith(path, ".wac")) { return callsRatchet(src) ? "floor" : "reports"; }
  if (!contains(src, "Deno.exit(1)")) { return "reports"; }
  // The two shapes differ in what they hold you to. One fails when a point nothing reaches has no
  // entry — a coverage floor. The other fails only when an entry it already carries has drifted onto
  // the wrong line, which is rot-proofing for the ledger and says nothing about whether coverage fell.
  return contains(src, "branch point(s) uncovered") ? "floor" : "entries";
}

/**
 * A call to the shared ratchet, and not a name that merely ends in one.
 *
 * The TypeScript wrote `/\bratchet\(/`, and the boundary is the whole of it: `myRatchet(` or
 * `subratchet(` would classify a driver as holding a coverage floor when it holds nothing of the
 * kind, and the summary would over-count the checks that can actually fail. No driver has such a name
 * today — checked — so this is written out rather than left to a substring that happens to agree.
 * `packages/regex` refuses lookbehind, which is the right call and is why the predicate is by hand.
 */
export bool callsRatchet(string src) {
  for (i32 i = 0; i + 8 <= src.len(); i++) {
    if (src.slice(i, i + 8) != "ratchet(") { continue; }
    if (i == 0) { return true; }
    if (!isWordByte(src.slice(i - 1, i))) { return true; }
  }
  return false;
}

/** A byte `\b` would refuse to break on: a letter, a digit or `_`. */
bool isWordByte(string c) {
  return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "_";
}

i32 countKind(Run[] results, string kind) {
  i32 n = 0;
  for (i32 i = 0; i < results.len(); i++) { if (results[i].kind == kind) { n = n + 1; } }
  return n;
}

/**
 * The times file, written whatever happened.
 *
 * A red package still took its time, and a run that fails is exactly the one somebody repeats — so the
 * ordering it leaves behind should be the measured one rather than the one from before the package
 * grew. Unwritable is not worth a word: the only cost is that the next run dispatches alphabetically.
 *
 * Seeded from the packages that exist *now*, not from the whole of last run's file: a package that
 * loses its task would otherwise keep a time in here forever, and a stale key is the kind of thing
 * that reads as a measurement later. A package that did not run this time keeps its old number, which
 * is the point of the file.
 *
 * `tools/wac/suitehouse.wac`'s `mergedTimes` keeps stale keys instead, and the difference is not an
 * inconsistency: this can drop them because the live set is a directory listing it already has. The
 * set of suite chunks is not — it is whatever the queue built for the directories that run was asked
 * about, which for a narrowed run is almost none of them.
 */
void writeTimes(Files fs, string[] packages, Run[] results, string[] names, i64[] millis) {
  string out = "";
  for (i32 i = 0; i < packages.len(); i++) {
    i64 fresh = -1 as i64;
    for (i32 k = 0; k < results.len(); k++) {
      if (results[k].pkg == packages[i]) { fresh = results[k].ms; }
    }
    i64 t = fresh >= (0 as i64) ? fresh : recordedMs(packages[i], names, millis);
    if (t < (0 as i64)) { continue; }
    out = out + packages[i] + "\t" + itoa64(t) + "\n";
  }
  fs.mkdir(".cache", true).wait();
  fs.writeFile(timesPath(), out.toBytes()).wait();
  // The file this replaced, so an orphan does not sit there looking like a live cache — which is the
  // "reads as a measurement later" problem this function is already careful about.
  fs.remove(staleTimesPath(), false).wait();
}

i64 nowMs(Clock clock) { return flatten(clock.nowMillis().wait()).unwrap(); }

/** `12.3s`, as each package's line reports it. */
string seconds(i64 ms) {
  i64 tenths = (ms + (50 as i64)) / (100 as i64);
  return itoa64(tenths / (10 as i64)) + "." + itoa64(tenths % (10 as i64)) + "s";
}

/**
 * Whole seconds, for the two figures in the summary.
 *
 * **Summed, not elapsed, for the second one, and it says so.** These overlap now, so the sum is the
 * work done rather than the time taken — reporting it as elapsed would make a 4x speedup look like no
 * change at all.
 */
string wholeSeconds(i64 ms) { return itoa64((ms + (500 as i64)) / (1000 as i64)); }
