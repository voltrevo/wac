// Which tests a mutant runs, at the three decisions that were each wrong once.
//
// The asymmetry this whole module is written around: **under-selection is a wrong answer and
// over-selection is only slow.** Every case below is a mutant that was mis-selected, and in two of
// them the mis-selection produced a *verdict* rather than a delay. `issues/system/0161` step 6.

import { T } from "../../packages/wactest/src/assert.wac";
import { Profile, RunPlan, Selection, byCost, filterFor, isDenoFilter, linesOf, planFor,
         runPlanFor, selectTests }
       from "./mutateplan.wac";
import { itoa } from "../../packages/fmt/src/itoa.wac";

string joined(string[] xs) {
  string out = "";
  for (i32 i = 0; i < xs.len(); i++) { out = out + (i == 0 ? "" : " ") + xs[i]; }
  return out;
}

/** A profile knowing three lines of `a.wac`, where only two are reached by a test. */
Profile sample() {
  return Profile(
    string[]("a.wac:10", "a.wac:11", "a.wac:12"),
    string[]("test_one test_two", "", "test_two"),
    string[]("x_test.wac", "y_test.wac", "z_test.wac"),
    i32[](50, 10, -1));
}

/**
 * **Any known line, not every one.**
 *
 * A mutation spans a whole construct and most interior lines are statements the coverage build does
 * not model. Requiring every line to be known meant one unmodelled statement discarded the whole
 * selection — 83 of 235 mutants ran the full scope for no reason.
 */
export string test_one_unknown_line_does_not_discard_the_selection() {
  T t = T.create();
  Selection got = selectTests(sample(), string[]("a.wac:10", "a.wac:99"));
  t.isTrue(got.narrowed, "a span with one unmodelled line still narrows");
  t.eqStr(joined(got.tests), "test_one test_two", "to the tests the known line names");
  return t.report();
}

/**
 * **But an empty answer is only trusted when every line is accounted for.**
 *
 * An edit span need not contain the line its coverage point sits on — a function whose signature
 * wraps has its entry above where the span begins — so a span can hold known-but-uncovered interior
 * lines while the covered entry is outside it. Read literally that says no test reaches the function,
 * and `extreme/tls/client/tlsClientInit` was reported exactly that way for a function every client
 * test calls.
 */
export string test_an_empty_answer_needs_every_line_accounted_for() {
  T t = T.create();
  // Line 11 is known and unhit; line 99 is unknown. Empty *and* incomplete — fall back.
  Selection mixed = selectTests(sample(), string[]("a.wac:11", "a.wac:99"));
  t.isTrue(!mixed.narrowed,
           "a span that is known-but-unhit and also incomplete falls back rather than claiming unhit");

  // Every line known, and none hit: that empty answer is the real one.
  Selection all = selectTests(sample(), string[]("a.wac:11"));
  t.isTrue(all.narrowed, "a fully accounted span does narrow");
  t.eqI32(all.tests.len(), 0, "and its empty answer means no test reaches it");
  return t.report();
}

export string test_a_span_the_profile_does_not_know_widens() {
  T t = T.create();
  Selection got = selectTests(sample(), string[]("b.wac:1", "b.wac:2"));
  t.isTrue(!got.narrowed, "no known line at all is `cannot narrow`");
  t.eqStr(planFor(sample(), string[]("b.wac:1")), "widen", "which the plan calls widen");
  return t.report();
}

/**
 * The three plans, and `unhit` is not `skip`.
 *
 * It used to be: such a mutant was recorded unmeasurable and left out of the score. That is wrong for
 * anything the compiler folds — a function returning a constant is inlined, so its own line's counter
 * stays at zero while the constant reaches every caller, and gutting it fails two tests.
 * `issues/system/0005`.
 */
export string test_the_three_plans() {
  T t = T.create();
  t.eqStr(planFor(sample(), string[]("a.wac:10")), "narrow", "a line with tests narrows to them");
  t.eqStr(planFor(sample(), string[]("a.wac:11")), "unhit", "a known line no test reaches is unhit");
  t.eqStr(planFor(sample(), string[]("zz.wac:1")), "widen", "and an unknown line widens");
  return t.report();
}

/**
 * Cheapest first, then by name — and an unmeasured file last.
 *
 * With `--fail-fast` the order decides how much of a scope a killed mutant pays for, and alphabetical
 * is not the cheap one: in `packages/ssh` it puts the one in-process suite behind two that spawn.
 */
export string test_the_cheap_files_run_first_and_the_unmeasured_one_last() {
  T t = T.create();
  t.eqStr(joined(byCost(string[]("x_test.wac", "y_test.wac", "z_test.wac"), sample())),
          "y_test.wac x_test.wac z_test.wac",
          "10ms, then 50ms, then the one the profile never ran");
  // Equal costs keep their alphabetical order rather than depending on the sort's internals.
  Profile flat = Profile(string[0](fill: ""), string[0](fill: ""),
                         string[]("b.wac", "a.wac"), i32[](7, 7));
  t.eqStr(joined(byCost(string[]("b.wac", "a.wac"), flat)), "a.wac b.wac",
          "and equal costs fall back to the name");
  return t.report();
}

/**
 * The filter is anchored, so a name that is a prefix of another cannot drag it in.
 *
 * That is the whole reason it is a regex rather than a substring: `--filter` matches by substring, so
 * `test_read` selects `test_read_after_close` too — and a mutant scored against tests it was not
 * selected for is a wrong number in the flattering direction.
 */
export string test_the_filter_is_anchored_and_escaped() {
  T t = T.create();
  t.eqStr(filterFor(string[]("test_a", "test_b")), "/^(?:test_a|test_b)$/",
          "alternation, anchored at both ends");
  t.eqStr(filterFor(string[0](fill: "")), "", "and nothing to filter on is the empty answer");
  t.eqStr(filterFor(string[]("test_a.b")), "/^(?:test_a\\.b)$/",
          "a metacharacter in a name is escaped, or it would match more than the name");
  t.eqStr(filterFor(string[]("a+b(c)")), "/^(?:a\\+b\\(c\\))$/",
          "and so are the rest of them");
  return t.report();
}

/**
 * A span's lines, including the multi-line case that is the reason for the union rule.
 *
 * A curated mutation can cover a whole `if`, and an `extreme` mutant an entire function body — so a
 * span of one line is the easy case and not the interesting one.
 */
export string test_a_span_names_every_line_it_touches() {
  T t = T.create();
  string src = "one\ntwo\nthree\nfour\n";      // lines start at 0, 4, 8, 14
  t.eqStr(joined(linesOf("a.wac", src, 0, 3)), "a.wac:1", "a span inside one line is that line");
  t.eqStr(joined(linesOf("a.wac", src, 4, 7)), "a.wac:2", "and the count is of newlines before it");
  t.eqStr(joined(linesOf("a.wac", src, 4, 13)), "a.wac:2 a.wac:3",
          "a span crossing one newline names both lines");
  t.eqStr(joined(linesOf("a.wac", src, 0, 15)), "a.wac:1 a.wac:2 a.wac:3 a.wac:4",
          "and one crossing three names four");
  t.eqStr(joined(linesOf("a.wac", src, 5, 5)), "a.wac:2",
          "an empty span still starts somewhere, and that line carries the coverage point");
  return t.report();
}

/**
 * A narrowed run is given a filter and the files those tests live in, cheapest first.
 *
 * Cheapest first because `--fail-fast` only pays when the killer runs early.
 */
export string test_a_narrowed_run_gets_a_filter_and_the_right_files() {
  T t = T.create();
  string[] names = string[]("test_one", "test_two");
  string[] homes = string[]("x_test.wac", "y_test.wac");

  RunPlan r = runPlanFor(sample(), string[]("a.wac:10"), names, homes,
                         string[]("packages/whole"));
  t.isTrue(r.narrowed, "the profile named the tests, so the scope narrows");
  t.eqStr(r.filter, "/^(?:test_one|test_two)$/", "and the filter is anchored to exactly those");
  t.eqStr(joined(r.dirs), "y_test.wac x_test.wac",
          "the files they live in, cheapest first — y is 10ms and x is 50ms");
  t.isTrue(!r.notCovered, "and it is covered");
  return t.report();
}

/**
 * **Narrowing needs every selected test's home**, and this is the case that says so.
 *
 * A filter names tests; a run needs the files to point it at. With one home unknown the filter would
 * be aimed at a set of directories that does not contain it, and a filter matching nothing exits
 * non-zero on the binary and zero under Deno — a false kill on one path and a false survival on the
 * other. Widening costs time and cannot be wrong.
 */
export string test_one_unknown_home_widens_the_whole_run() {
  T t = T.create();
  string[] names = string[]("test_one");          // test_two's home is missing
  string[] homes = string[]("x_test.wac");

  RunPlan r = runPlanFor(sample(), string[]("a.wac:10"), names, homes,
                         string[]("packages/whole"));
  t.isTrue(!r.narrowed, "one test whose file is unknown sends the whole run wide");
  t.eqStr(r.filter, "", "with no filter, because a filter it cannot aim is worse than none");
  t.eqStr(joined(r.dirs), "packages/whole", "and the original scope");
  return t.report();
}

/** An unhit span runs everything and says so; an unknown one just runs everything. */
export string test_the_two_kinds_of_widening_are_told_apart() {
  T t = T.create();
  string[] names = string[]("test_one");
  string[] homes = string[]("x_test.wac");

  RunPlan unhit = runPlanFor(sample(), string[]("a.wac:11"), names, homes, string[]("scope"));
  t.isTrue(!unhit.narrowed, "a line no test reaches does not narrow");
  t.isTrue(unhit.notCovered,
           "but it is marked, so a survivor can be reported as executing nothing rather than as "
             + "untested behaviour");

  RunPlan unknown = runPlanFor(sample(), string[]("zz.wac:1"), names, homes, string[]("scope"));
  t.isTrue(!unknown.narrowed, "a line the profile does not know does not narrow either");
  t.isTrue(!unknown.notCovered,
           "and is not marked — the profile cannot say nothing reaches it, only that it cannot say");
  return t.report();
}

/**
 * **The two `--filter` flags are not the same flag**, and this is where the two ported halves are
 * kept apart.
 *
 * `filterFor` builds Deno's anchored regex; `wacTestArgs` takes a bare export name because
 * `wac test --filter` matches a substring. Handing the first to the second looks for a test whose
 * name contains a slash and a caret, finds none, and the mutant is scored against a run of zero
 * tests — a survivor, silently. `issues/system/0183`.
 *
 * The reference's answer is not to translate but to *not pass it*: on that path the scope has already
 * been narrowed to the files holding the covering tests, which is most of the win.
 */
export string test_denos_filter_spelling_is_not_the_binarys() {
  T t = T.create();
  string deno = filterFor(string[]("test_one", "test_two"));
  t.isTrue(isDenoFilter(deno), "what filterFor builds is the regex spelling: " + deno);
  t.isTrue(!isDenoFilter("test_one"),
           "and a bare export name, which is what `wac test --filter` wants, is not");
  t.isTrue(!isDenoFilter(""), "nor is no filter at all");
  t.isTrue(!isDenoFilter("/"), "and a lone slash is not a delimited pattern");

  // The narrowed run is what makes not passing it affordable: the scope is already the files.
  RunPlan r = runPlanFor(sample(), string[]("a.wac:10"), string[]("test_one", "test_two"),
                         string[]("x_test.wac", "y_test.wac"), string[]("packages/whole"));
  t.isTrue(isDenoFilter(r.filter), "a run plan carries the Deno spelling");
  t.eqI32(r.dirs.len(), 2,
          "and the files, which is how the binary path selects — by entry, not by filter");
  return t.report();
}
