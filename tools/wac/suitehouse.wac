// What the suite reclaims on its way in: Deno's code cache, stale temp directories, and transpiles
// of sources that no longer exist.
//
// The housekeeping half of tools/runTests.ts, in wac. The reasons are recorded there and in
// `wac-mono 0068` and `0136` — a 28 GB code cache, 2,300 leaked temp entries, 17 GB of mirrored
// staging directories across three agents on a disk at 95%. This file is the same work; what follows
// is only what differs about doing it here.
//
// **`chmod` is the one thing wac cannot spell.** A test that fixtures a permission failure leaves a
// directory it cannot itself delete — `packages/box`'s `rm -rf` cases make `dr-x------` on purpose —
// and the TypeScript widens the mode on the way down with `Deno.chmodSync`. `Cli` has
// `setExecutable`, which is one bit, deliberately: `issues/system` records that a general `chmod`
// would be unanswerable on a browser's OPFS rather than merely unsupported. So the widening pass
// asks `/bin/chmod` for it, through the capability that runs a host program, and says so where it
// happens. That is a real gap rather than a translation: three of these entries exist per week.

import { Cli, Core, Exec, FileResult, Stat } from "std/platform.wac";
import { itoa, itoa64 } from "../../packages/fmt/src/itoa.wac";
import { startsWith, endsWith, splitLines } from "../../packages/wactest/src/strings.wac";
import { envOf } from "./suitegate.wac";

/** Deno's cache directory, wherever this environment puts it. */
export string denoDir(Cli cli) {
  string dir = envOf(cli, "DENO_DIR");
  if (dir != "") { return dir; }
  string home = envOf(cli, "HOME");
  return (home == "" ? "/root" : home) + "/.cache/deno";
}

/** 4 GiB — the cache keys on content and never evicts, and this repo runs a lot of unique scripts. */
i64 cacheLimitBytes() { return 4 as i64 * (1024 as i64) * (1024 as i64) * (1024 as i64); }

/** A day, which is far longer than any suite: nothing another agent is using can be this old. */
i64 dayMs() { return 24 as i64 * (3600000 as i64); }

i64 mb(i64 bytes) { return bytes / (1024 as i64) / (1024 as i64); }

/** Whether anything is at this path, following no links — `existsSync`'s question. */
bool present(Cli cli, string path) { return cli.linkStat(path).wait().exists; }

/** Every byte under `path`, counting a file as itself and a directory as its contents. */
i64 sizeOf(Cli cli, string path) {
  Stat s = cli.linkStat(path).wait();
  if (!s.exists) { return 0 as i64; }
  if (!s.isDir) { return s.size; }
  string[]? entries = cli.readDir(path).wait();
  if (entries is null) { return 0 as i64; }
  string[] names = entries!;
  i64 total = 0 as i64;
  for (i32 i = 0; i < names.len(); i++) { total = total + sizeOf(cli, path + "/" + names[i]); }
  return total;
}

/**
 * Remove a path, making it removable first if it is not.
 *
 * The widening pass is `/bin/chmod -R u+rwX`, for the reason in this file's header: wac has no
 * `chmod` capability and the directories this exists for are made unreadable on purpose. Answers
 * whether the path is gone, so the caller can name what it could not sweep rather than swallowing it
 * — a cleanup that fails quietly is how 2,300 temp entries accumulated in the first place.
 */
export bool removeWidening(Cli cli, string path) {
  cli.remove(path, true).wait();
  if (!present(cli, path)) { return true; }
  cli.execWith("/bin/chmod", string[]("-R", "u+rwX", path), u8[0](), string[0](fill: ""),
               false, false).wait();
  cli.remove(path, true).wait();
  return !present(cli, path);
}

/**
 * Deno's code cache, cleared when it is over the limit.
 *
 * One implementation, because `tools/push.sh` calls this too — through the runner's `guard`
 * subcommand rather than by knowing where the cache is.
 */
export void guardCodeCache(Core core, Cli cli) {
  string db = denoDir(cli) + "/v8_code_cache_v2";
  Stat s = cli.stat(db).wait();
  if (!s.exists) { return; }                       // no cache yet, nothing to bound
  if (s.size <= cacheLimitBytes()) { return; }
  core.log("clearing Deno's code cache: " + itoa64(mb(s.size)) + " MB, over the " +
           itoa64(mb(cacheLimitBytes())) + " MB limit");
  cli.remove(db, false).wait();
  cli.remove(db + "-wal", false).wait();
  cli.remove(db + "-shm", false).wait();
}

/** Everything Deno caches, for when the disk is actually full. `push.sh free` calls this. */
export void freeCaches(Cli cli) {
  string dir = denoDir(cli);
  cli.remove(dir + "/v8_code_cache_v2", false).wait();
  cli.remove(dir + "/v8_code_cache_v2-wal", false).wait();
  cli.remove(dir + "/v8_code_cache_v2-shm", false).wait();
  cli.remove(dir + "/gen", true).wait();
}

/**
 * Remove `/tmp/wac-*` left by runs that were **killed**, which is where the disk went.
 *
 * The shape almost every test file uses is a module-level temp directory and an unload listener, and
 * that survives a failing test; what it does not survive is the process being *killed*, because no
 * listener runs. On a machine three agents share that is an ordinary event, so it is swept here, at
 * the start of the run that would otherwise create more.
 *
 * Three names are spared explicitly rather than left to the age test: the doc-warning tally, the
 * lock, and the per-agent cooldown stamps. The age test would spare all three anyway — a sweep that
 * *could* delete a lock held by a live run is not something to leave resting on an arithmetic
 * argument.
 */
export void sweepStaleTemp(Core core, Cli cli) {
  i64 now = core.nowMillis().wait();
  string[]? entries = cli.readDir("/tmp").wait();
  if (entries is null) { return; }
  string[] names = entries!;
  i32 gone = 0;
  i64 bytes = 0 as i64;
  i32 stuck = 0;
  string first = "";
  for (i32 i = 0; i < names.len(); i++) {
    string name = names[i];
    // **`push-suite-` as well as `wac-`.** `tools/push.sh` opens a `mktemp -t push-suite-XXXXXX.log`
    // per run and keeps `.docs`, `.site` and `.seed` beside it; the failing paths cite those files in
    // their output, so they are deliberately not removed there — and nothing removed them here
    // either, because they do not begin with `wac-`. Measured on 2026-08-29: **967 files, 7.6 MB**,
    // growing by two or three a run since the gate was written. A day old is well past any reader.
    if (!startsWith(name, "wac-") && !startsWith(name, "push-suite-")) { continue; }
    if (name == "wac-suite.lock") { continue; }
    if (startsWith(name, "wac-suite-last-")) { continue; }
    string path = "/tmp/" + name;
    Stat s = cli.linkStat(path).wait();
    if (!s.exists) { continue; }
    if (now - s.modifiedMillis < dayMs()) { continue; }
    i64 was = s.isDir ? 0 as i64 : s.size;
    if (removeWidening(cli, path)) {
      gone = gone + 1;
      bytes = bytes + was;
    } else {
      stuck = stuck + 1;
      if (first == "") { first = path; }
    }
  }
  if (gone > 0) {
    core.log("swept " + itoa(gone) + (gone == 1 ? " temp entry" : " temp entries") +
             " older than a day (0136)");
  }
  if (stuck > 0) {
    core.log("could not sweep " + itoa(stuck) + " (0136): " + first +
             (stuck > 1 ? " — and " + itoa(stuck - 1) + " more" : ""));
  }
}

/** How many entries a walk dropped, and how many bytes they held. */
struct Dropped {
  i32 gone;
  i64 bytes;
}

/**
 * One mirror directory against the sources it mirrors, recursively.
 *
 * The cache mirrors an absolute source path under `gen/file/` and appends `.js` to files, so the
 * source of `gen/file/home/x/y.ts.js` is `/home/x/y.ts`. An entry whose source is gone can never be
 * hit again by anybody, which is what makes removing it free rather than a cache eviction.
 *
 * Recursive from the root, which is the whole point: an earlier version of the TypeScript walked two
 * levels and so only ever saw `gen/file/tmp/*` — "the failure mode where a cleanup tool reports
 * success and does nothing". Other agents' entries included, deliberately: an entry is removed only
 * when the path it was built from is gone, so a surviving entry can still be hit and a removed one
 * never could.
 */
Dropped dropOrphaned(Cli cli, string mirror, string source) {
  string[]? entries = cli.readDir(mirror).wait();
  if (entries is null) { return Dropped(0, 0 as i64); }  // no such mirror, the normal state
  string[] names = entries!;
  i32 gone = 0;
  i64 bytes = 0 as i64;
  for (i32 i = 0; i < names.len(); i++) {
    string name = names[i];
    string stem = endsWith(name, ".js") ? name.slice(0, name.len() - 3) : name;
    string path = mirror + "/" + name;
    if (present(cli, source + "/" + stem) || present(cli, source + "/" + name)) {
      if (cli.linkStat(path).wait().isDir) {
        Dropped r = dropOrphaned(cli, path, source + "/" + name);
        gone = gone + r.gone;
        bytes = bytes + r.bytes;
      }
      continue;
    }
    i64 was = sizeOf(cli, path);
    if (removeWidening(cli, path)) {
      gone = gone + 1;
      bytes = bytes + was;
    }
  }
  return Dropped(gone, bytes);
}

/**
 * Deno's transpile cache for sources that no longer exist, which can never be hit again.
 *
 * `guardCodeCache` bounds `v8_code_cache_v2`; its sibling `gen/` has no bound and held 6.8 GB on one
 * agent, 5.7 GB of it mirroring staging directories that had already been deleted. This is the mop,
 * and `wac-mono 0068` still asks for reuse rather than sweeping.
 */
export void dropUnreachableTranspiles(Core core, Cli cli) {
  // The whole mirror, from the root: an empty source root makes the first level `/home`, `/tmp` and
  // their siblings, which is why this takes one call rather than a list somebody has to keep current.
  Dropped r = dropOrphaned(cli, denoDir(cli) + "/gen/file", "");
  if (r.gone > 0) {
    core.log("dropped " + itoa(r.gone) + " transpile(s) of sources that no longer exist, " +
             itoa64(mb(r.bytes)) + " MB (0068)");
  }
}

/**
 * The queue's stopwatch file after a run that measured `fresh`, each entry already `key<TAB>ms`.
 *
 * **A measurement is a fact about a chunk, not about the run that took it.** This used to be written
 * from the current run alone, which is right for the gate — it measures every chunk — and wrong for
 * every narrower one. `wac task test packages/fmt` measures a single chunk, and the file went from 59
 * lines to 1: the next full suite then had nothing to order by and fell back to the file-count proxy,
 * which `issues/system/0274b` measured at about 150s of idle workers. Nothing reported it, because the
 * file was written and merely shorter.
 *
 * **Whole keys, not prefixes.** `packages/b/test/wac` and `packages/b/test/wac#0` are different chunks
 * whose names share a start — the first is a directory small enough to run in one piece, the second is
 * part of one that was split. A directory crossing that threshold has both in the file at different
 * times, and a prefix match would drop the wrong one.
 *
 * Stale keys are left alone. A chunk that no longer exists is never looked up, `recordedMs` answers -1
 * for it, and a line costs about thirty bytes; a sweep that decided which keys are still real would
 * need this file to know how the queue is chunked today, which is the second implementation that goes
 * wrong.
 *
 * **The ratchets' equivalent answers the other way, and is also right.** `tools/wac/coverageall.wac` seeds
 * its merge from the packages that exist *now*, so a package that loses its coverage task loses its
 * row — it can, because the set of packages is a directory listing it already has. The set of chunks
 * is not: it is whatever `chunksOf` produced this run, for the directories this run was asked about,
 * and a narrowed run knows about almost none of them. Dropping what it cannot see is how a narrowed
 * run would erase the file all over again.
 */
export string mergedTimes(string existing, string[] fresh) {
  string out = "";
  for (i32 i = 0; i < fresh.len(); i++) { out = out + fresh[i] + "\n"; }

  string[] lines = splitLines(existing);
  for (i32 i = 0; i < lines.len(); i++) {
    i32 tab = lines[i].indexOf("\t");
    if (tab < 0) { continue; }
    string key = lines[i].slice(0, tab);
    bool replaced = false;
    for (i32 k = 0; k < fresh.len(); k++) {
      i32 t2 = fresh[k].indexOf("\t");
      if (t2 >= 0 && fresh[k].slice(0, t2) == key) { replaced = true; }
    }
    if (!replaced) { out = out + lines[i] + "\n"; }
  }
  return out;
}

/**
 * Test daemons this workspace left running, which no sweep over `/tmp` can see.
 *
 * `issues/system/0136` is about files and its sweeps work — 30 `wac-` entries where it once counted
 * 2,300. What it cannot reach is a *process*: on 2026-08-31 nine servers from this workspace's own
 * `.cache` were still up after 33 and 45 hours — `echod`, `udppeer`, a `greet-node` — because the
 * tests that started them died before `stop()` ran. Killing them freed 3 GB on a box whose gate
 * refuses to run below 4,000 MB, so this is memory rather than disk, and memory is the one that
 * stops everybody's pushes.
 *
 * ## The two conditions, and why the first is the safety property
 *
 * **Its command line mentions this workspace's own `.cache`.** Three agents share the machine and
 * their workspace paths differ, so `agent-b`'s sweep cannot reach `agent-a`'s processes even in
 * principle. That is what makes a kill safe to do unattended, and it is not a refinement of the age
 * test — it is load-bearing. `ps` says PID 1 is fourteen days old; an age rule alone would reap
 * `init`.
 *
 * **And it is older than `STALE_MS`** — two hours, six times the longest declared test (1204s, in
 * `packages/wacc/test/wac/corpusemit_test.wac`). `sweepStaleTemp` uses a day for files and this is
 * deliberately shorter: a leaked file costs disk, which is plentiful, and a leaked server costs
 * memory continuously, which is what the gate refuses on.
 *
 * Reports only when it acted, like the sweeps above.
 */
const i64 STALE_MS = 7200000 as i64;

export void reapStaleDaemons(Core core, Cli cli) { reapOlderThan(core, cli, STALE_MS); }

/** The rule, with its bound named, so a test can ask what it does at both ends of it. */
export void reapOlderThan(Core core, Cli cli, i64 staleMs) {
  string mine = cli.cwd().wait() + "/.cache/";
  Exec listed = cli.execWith("/bin/ps", string[]("-eo", "pid,etimes,args", "--no-headers"),
                             u8[0](), string[0](fill: ""), false, false).wait();
  if (!listed.ran()) { return; }

  string[] lines = splitLines(string.fromBytes(listed.stdout));
  i32 reaped = 0;
  string first = "";
  for (i32 i = 0; i < lines.len(); i++) {
    string line = lines[i];
    if (line.indexOf(mine) < 0) { continue; }
    // Scanned as bytes: a `string` is not indexable, which `packages/fmt/src/itoa.wac` also does.
    u8[] b = line.toBytes();
    // `pid etimes args`, so the first two fields are what this needs and the rest is the command.
    i32 at = 0;
    while (at < b.len() && b[at] == 32) { at = at + 1; }
    i32 pidFrom = at;
    while (at < b.len() && b[at] != 32) { at = at + 1; }
    // Offsets come from the byte scan; `slice` is a string method and `ps` output is ASCII.
    string pid = line.slice(pidFrom, at);
    while (at < b.len() && b[at] == 32) { at = at + 1; }
    i32 ageFrom = at;
    while (at < b.len() && b[at] != 32) { at = at + 1; }
    i64 seconds = 0 as i64;
    for (i32 d = ageFrom; d < at; d++) {
      if (b[d] < 48 || b[d] > 57) { seconds = 0 as i64; break; }
      seconds = seconds * (10 as i64) + ((b[d] - 48) as i64);
    }
    if (seconds * (1000 as i64) < staleMs) { continue; }
    cli.execWith("/bin/kill", string[]("-9", pid), u8[0](), string[0](fill: ""), false, false).wait();
    if (first == "") { first = pid; }
    reaped = reaped + 1;
  }
  if (reaped > 0) {
    core.log("reaped " + itoa(reaped) + (reaped == 1 ? " stale daemon" : " stale daemons") +
             " of this workspace's own, first pid " + first +
             " — a test that died before stop() (0136)");
  }
}
