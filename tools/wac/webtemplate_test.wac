// `templates/webapp` works outside this repository: copied somewhere else, it builds a page and its
// tests pass, through the `wac` command and nothing else.
//
// **The dependency is this checkout's `packages/web`, put where `wac update` would put it.** The
// template maps `web` and `webbuild` to this repository on GitHub, and fetching is HTTPS — so instead
// of fetching, the test writes the cache a fetch leaves behind (`$WAC_HOME/cache/git/<repo>/<commit>`,
// a plain checkout) from the working tree, and a `wac.lock` naming that commit, with `wacpkg`'s own
// `cachePath` and `writeLock`. What is under test is everything after the fetch: resolving the two
// packages through the manifest and the lock, the builder run from the project, and the page's
// program compiled from a cache rather than from this tree. A change to `packages/web` or to the
// template that breaks a project outside the repository breaks this test.

import { T } from "../../packages/wactest/src/assert.wac";
import { binaryPath, freshDir, scratch } from "../../packages/wactest/src/host.wac";
import { contains } from "../../packages/wactest/src/strings.wac";
import { cachePath } from "../../packages/wacpkg/src/cache.wac";
import { LockEntry, writeLock } from "../../packages/wacpkg/src/lock.wac";
import { Exec, ChildEnv, Env, Files, Launch, Procs, Sys } from "std";
import { sha256 } from "../../packages/crypto/src/sha256.wac";
import { encode, ALPHABET_STANDARD } from "../../packages/codec/src/base64.wac";
import { flatten } from "core";

static string GIT = "https://github.com/voltrevo/wac";
/** A commit no fetch made: the cache entry is the test's own, so it cannot collide with a real one. */
static string COMMIT = "0000000000000000000000000000000000000001";

/** `cp -R from to`, through the shell the suite already has. */
Exec copyTree(Procs procs, string from, string to) {
  return flatten(procs.exec("/bin/sh", ["-c", "mkdir -p '" + to + "' && cp -R '" + from + "/.' '" + to + "/'"], u8[](), ChildEnv.inherited(), Launch.plain()).wait()).unwrap();
}

/** `wac <args>` in `dir`, with `WAC_HOME` set to `home`. */
Exec wacIn(Env env, Procs procs, string dir, string home, string args) {
  string line = "cd '" + dir + "' && export WAC_HOME='" + home + "' && exec '" + binaryPath(env) + "' " + args;
  return flatten(procs.exec("/bin/sh", ["-c", line], u8[](), ChildEnv.inherited(), Launch.plain()).wait()).unwrap();
}

string said(Exec r) { return string.fromBytes(r.stdout) + string.fromBytes(r.stderr); }

export string test_the_template_builds_and_tests_outside_the_repository(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string root = flatten(env.cwd().wait()).unwrap();
  string base = scratch(env, "webtemplate");
  t.eqStr(freshDir(fs, base), "", "a fresh directory");
  string home = base + "/home";
  string project = base + "/myapp";

  // The fetch's result, from this checkout.
  string checkout = cachePath(home, GIT, COMMIT);
  Exec copied = copyTree(procs, root + "/packages/web", checkout + "/packages/web");
  t.isTrue(copied.ok(), "the package is in the cache — " + said(copied));
  Exec tpl = copyTree(procs, root + "/templates/webapp", project);
  t.isTrue(tpl.ok(), "the template is copied — " + said(tpl));
  LockEntry[] locked = [LockEntry("web", GIT, "master", "./packages/web", COMMIT),
                        LockEntry("webbuild", GIT, "master", "./packages/web/tools", COMMIT)];
  t.isTrue(flatten(fs.writeFile(project + "/wac.lock", writeLock(locked)).wait()).isOk(), "and locked to it");

  // The template's build task, spelled out so the binary under test is the one that runs the builder too.
  Exec built = wacIn(env, procs, project, home, "run --allow-read --allow-write --allow-run build.wac src/app.wac dist --wac '" + binaryPath(env) + "'");
  t.eqI32(built.status, 0, "the page builds — " + said(built));
  u8[]? page = flatten(fs.readFile(project + "/dist/index.html").wait()).ok();
  t.isTrue((page is not null), "dist/index.html exists");
  string html = (page is not null) ? string.fromBytes(page!) : "";
  t.isTrue(contains(html, "host.start()"), "that starts the program");
  // **The one script the page runs as written is the one its policy allows.** The build states the
  // loader's hash rather than computing it — it is a project of its own and has no SHA-256 to import
  // (`documentScript` in `packages/web/tools/build.wac`) — so a loader edited without its hash is a
  // page that runs nothing, and only a browser would say so. This says so without one.
  string loader = between(html, "<script>", "</script>");
  string allowed = between(html, "script-src 'sha256-", "'");
  string hash = string.fromBytes(encode(sha256(loader.toBytes()), ALPHABET_STANDARD(), true));
  t.isTrue(loader != "" && allowed != "", "a policy and a loader in the page");
  t.eqStr(allowed, hash, "the policy allows the loader the page runs — loaderHash() in build.wac should be the right-hand value");

  // And its test task.
  Exec tested = wacIn(env, procs, project, home, "test test");
  t.eqI32(tested.status, 0, "the template's tests pass — " + said(tested));
  t.isTrue(contains(said(tested), "2 passed"), "both of them — " + said(tested));
  return t.report();
}

/** The text between the first `open` and the `close` after it, or "". */
string between(string s, string open, string close) {
  i32 at = s.indexOf(open);
  if (at < 0) { return ""; }
  string rest = s.slice(at + open.len(), s.len());
  i32 end = rest.indexOf(close);
  return end < 0 ? "" : rest.slice(0, end);
}
