// What a mutation run *would* mutate, without mutating anything.
//
// The first of `tools/mutate.ts`'s modes to move: gather the files, generate the mutants, say what
// they are. It runs nothing, stages nothing and compiles nothing, so it answers in a second where a
// sweep is minutes — and the question it answers is the one worth asking before a sweep, which is
// whether the operators are pointed at the code you think they are.
//
// **A selection nobody can look at is the failure this tool exists to detect, in the tool.** That is
// `issues/system/0161`'s own account of `--explain-selection`: a mutant narrowed to tests that cannot
// reach it is recorded as surviving if they pass and killed if they do not, and either way the number
// moves without anything going red. Seeing the set is the cheap half of looking.
//
// This composes the ported modules and adds nothing of its own — `tools/wac/mutateoperators.wac`
// generates, `isMutationTarget` decides what is code under test, and `short` names them.
// `issues/system/0161` step 6.

import { Core, Cli, FileResult } from "std/platform.wac";
import { Fs } from "../../packages/fs/src/fs.wac";
import { Sources, gather } from "../../packages/wac/src/sources.wac";
import { Flags, parseFlags, targetsUnder } from "./mutatefiles.wac";
import { fileCount, sampleMutants } from "./mutatesample.wac";
import { Vec } from "core/vec.wac";
import { GenStats, Mutant, generate } from "./mutateoperators.wac";
import { Applied, applyEdits } from "./mutatescope.wac";
import { Triage, signatureOf, triageOf, wasmHashOf } from "./mutatetriage.wac";
import { itoa } from "../../packages/fmt/src/itoa.wac";

/**
 * The same list, with each mutant compiled and classified — trivial compiler equivalence.
 *
 * **This is the expensive half and it is opt-in**, because it compiles the mutant's whole import
 * graph once per mutant. The reference measures that at 66 ms each, so a package of a hundred and
 * fifty is ten seconds and a sweep of the repository is minutes. What it buys is the number that
 * decides whether a sweep is worth starting: a set where most mutants are equivalent or duplicate is
 * one where the sweep will spend its time proving things twice.
 *
 * Baseline first, then each mutant against it, which is the order `triageOf` expects — a mutant whose
 * wasm equals the baseline's is equivalent, and one whose wasm equals an earlier mutant's is that
 * mutant asked again.
 *
 * **Expect the equivalent count to be low here, and that is the compiler rather than the check.**
 * `packages/rlp` reports 159 to run and none equivalent. TCE finds a mutant equivalent when the
 * emitter folds the difference away, and wacc does not fold: an unused local bumped from 5 to 6 still
 * changes the bytes. The check itself distinguishes — `mutatetriage_test.wac` has a whitespace-only
 * change hashing identically to prove equality is reachable at all, which is the assertion that stops
 * a count of zero being read as a comparison that never fires.
 */
i32 report(Core core, Cli cli, string dir, string[] files, string[] names, i32 total,
           GenStats stats) {
  Fs fs = Fs.onHost(cli, 0);
  i32 equivalent = 0;
  i32 duplicate = 0;
  i32 invalid = 0;
  i32 runnable = 0;

  // Signatures claimed so far, so the second mutant with one is a duplicate of the first.
  string[] seenSig = string[total + 1](fill: "");
  string[] seenName = string[total + 1](fill: "");
  i32 seen = 0;

  i32 emitted = 0;
  for (i32 fi = 0; fi < files.len(); fi++) {
    Sources src = gather(fs, cli, files[fi]);
    if (src.why != "") {
      core.warn("  cannot gather " + files[fi] + ": " + src.why);
      continue;
    }
    string baseline = wasmHashOf(src.paths, src.texts, files[fi]);

    FileResult r = cli.readFile(files[fi]).wait();
    if (!r.ok) { continue; }
    GenStats each = GenStats(0, 0, 0);
    Mutant[] got = generate(files[fi], string.fromBytes(r.bytes),
                            string[]("relational", "literal", "guard", "extreme"), each, 3);
    for (i32 m = 0; m < got.len(); m++) {
      Applied a = applyEdits(src.paths, src.texts, got[m]);
      string sig = a.ok ? wasmHashOf(a.paths, a.texts, files[fi]) : "";
      Triage t = triageOf(false, sig == "" ? files[fi] : "", false,
                          signatureOf(string[](files[fi]), string[](sig)),
                          signatureOf(string[](files[fi]), string[](baseline)),
                          seenSig, seenName);
      if (t.verdict == "equivalent") { equivalent = equivalent + 1; }
      else if (t.verdict == "duplicate") { duplicate = duplicate + 1; }
      else if (t.verdict == "invalid") { invalid = invalid + 1; }
      else { runnable = runnable + 1; }
      if (t.record && seen < seenSig.len()) {
        seenSig[seen] = signatureOf(string[](files[fi]), string[](sig));
        seenName[seen] = got[m].name;
        seen = seen + 1;
      }
      emitted = emitted + 1;
    }
  }

  core.log(itoa(emitted) + " mutant(s) over " + itoa(files.len()) + " file(s) under " + dir);
  core.log("  " + itoa(runnable) + " to run, " + itoa(equivalent) + " provably equivalent, "
           + itoa(duplicate) + " duplicate, " + itoa(invalid) + " did not compile");
  // **Said rather than counted as killed.** Excluding these is what keeps a score honest: a duplicate
  // is the same experiment twice and an equivalent mutant is one no test could ever kill.
  core.log("  equivalent and duplicate mutants are excluded from a score, not counted as killed");
  return 0;
}

/**
 * `mutatelist [--package <name>|<dir>] [--operators=a,b] [--no-sample]` — the mutants that would be
 * generated.
 *
 * The counts come before the names because the counts are what a reader checks first: a package with
 * three mutants where you expected three hundred is pointing at the wrong tree, and that is visible
 * without reading a line of the list.
 */
export i32 main(Core core, Cli cli) {
  i32 argc = cli.argCount().wait();
  string[] args = string[argc](fill: "");
  for (i32 i = 0; i < argc; i++) { args[i] = string.fromBytes(cli.arg(i).wait()); }
  Flags f = parseFlags(args);
  if (f.problem != "") {
    core.log(f.problem);
    return 1;
  }
  string dir = f.dir;
  if (dir == "") {
    core.log("usage: mutatelist [--package <name>|<dir>] [--operators=a,b] [--no-sample]"
             + " [--sample=N] [--seed=S] [--triage]");
    return 1;
  }

  string[] files = targetsUnder(cli, dir);
  if (files.len() == 0) {
    core.log("no .wac files under " + dir + " that are code under test");
    return 1;
  }

  Flags f2 = f;
  GenStats stats = GenStats(0, 0, 0);
  Vec<Mutant> population = Vec.create();
  for (i32 f = 0; f < files.len(); f++) {
    FileResult r = cli.readFile(files[f]).wait();
    if (!r.ok) { continue; }
    Mutant[] got = generate(files[f], string.fromBytes(r.bytes), f2.operators, stats, f2.perShape);
    for (i32 i = 0; i < got.len(); i++) { population.push(got[i]); }
  }

  // **`--sample` here draws the same subset `mutaterun` would**, which is the whole point of the two
  // sharing `parseFlags` and `sampleMutants`: a listing that showed a different set from the one the
  // run measures would be worse than no listing. Given a seed, this *is* `--explain-selection`.
  Mutant[] chosen = population.toArray();
  if (f2.sample > 0 && f2.sample < chosen.len()) {
    i32 before = chosen.len();
    i32 seed = f2.seed != 0 ? f2.seed : (core.nowMillis().wait() as! i32);
    chosen = sampleMutants(chosen, f2.sample, seed);
    core.log("sampling " + itoa(chosen.len()) + " of " + itoa(before) + " mutant(s) across "
             + itoa(fileCount(chosen)) + " file(s), seed " + itoa(seed));
  }

  i32 total = chosen.len();
  string[] names = string[total](fill: "");
  for (i32 i = 0; i < total; i++) { names[i] = chosen[i].name; }

  if (f2.triage) { return report(core, cli, dir, files, names, total, stats); }

  core.log(itoa(total) + " mutant(s) over " + itoa(files.len()) + " file(s) under " + dir);
  // **What sampling left out, said rather than hidden.** The literal operator emits three per repeated
  // statement shape; a reader who does not know that reads the count as the whole population.
  core.log("  literal: " + itoa(stats.literalSampled) + " sampled, "
           + itoa(stats.literalSkipped) + " skipped across " + itoa(stats.shapes) + " shape(s)");
  for (i32 i = 0; i < total && i < names.len(); i++) { core.log("  " + names[i]); }
  return 0;
}
