// Tickets, and the scheduling they need — spec ch35.
//
// A `Ticket<T>` is a value that will answer a `T`. An `async` function hands its caller one, and the
// lowering of its body is the only other thing that writes these fields: it parks a `Continuation`
// on the ticket each time the body suspends, and resolves the ticket when the body returns.
//
// **Driving is by waiting.** Nothing here runs on its own. A ticket advances when somebody waits on
// it — `wait` follows what the ticket's machine is parked on, and steps the machine once that has
// settled — or when the continuation handed to the schedule target is called. Both routes reach the
// same `call`, and a machine resumes once however many copies of its continuation are lying about:
// `call` steps the machine only if that continuation is still the one parked, so a copy a `wait`
// already took back does nothing (`§wac-async-once-3jhw8qk`).
//
// **The schedule target is the compiler's.** `scheduleTarget` and `setScheduleTarget` are bodies the
// emitter replaces with a read and a write of one hidden global, because wac has no mutable module
// state and the target is scoped dynamically: a `schedule` statement sets it to the end of its block,
// and an `async` body restores the one it suspended under each time it resumes. Nothing else may
// call them; the names begin `__wac` so no program does by accident.

import { hypothetical } from "./hypothetical.wac";
import { Result } from "./result.wac";
import { toString } from "./text.wac";
import { Vec } from "./vec.wac";

/** What a suspended machine is waiting on — `null` for a bare `await;` — and the call that resumes it. */
export struct Continuation {
  TicketBase? t;
  fn<void()> call;
  /**
   * Whether this is still the suspension its machine is at. **A `wait` can run a machine itself**, past a
   * continuation already handed to a queue, and that one then does nothing when called — so a scheduler
   * asking what is left counts only the current ones.
   */
  fn<bool()> current;
}

/**
 * Everything about a ticket that does not depend on what it answers — which is everything a `wait`
 * or a scheduler needs, so neither has to know `T`.
 */
export struct TicketBase {
  bool done = false;
  /** The machine's continuation while it is suspended, which a `wait` drives rather than the queue. */
  Continuation? parked = null;
  /** For a ticket the host answers: block until it has, answering false when it cannot. */
  fn<bool()>? drive = null;
  /** Set while this ticket's own `advance` is following what it is parked on. */
  bool following = false;
  /**
   * Called once when the ticket settles, in the order added. **A list, not a closure around the one before**:
   * a long-lived read raced on every poll gains a watcher each time, and nesting them made settling it a
   * recursion as deep as the polls (`ticket_test.wac`).
   */
  Vec<fn<void()>>? watchers = null;

  /**
   * **For a ticket the host answers**, the host's id for the work, or -1 for any other ticket. Set beside
   * `waitHost` and `release` by whoever made the ticket from the host's answer — std — so core needs no way
   * to reach the host of its own: the functions arrive as values (design/system/0013).
   */
  i32 hostId = -1;
  /**
   * Block until one of `ids` has an answer, for at most `millis` (-1: as long as it takes), and answer its
   * index, -1 when none did. How a `wait` on `Ticket.any` of several host tickets blocks on all of them at
   * once rather than on the first.
   */
  fn<i32(i32[], i32)>? waitHost = null;
  /** Tell the host its answer is no longer wanted, releasing what holds it. What `cancel` calls. */
  fn<void()>? release = null;
  /** For `Ticket.all` and `Ticket.any`, what they wait on — so a `wait` can find the host work beneath. */
  TicketBase[]? parts = null;

  /**
   * Have `f` called when this ticket settles, beside whatever else is watching it. How `Ticket.any`
   * knows which of its tickets settled first, which driving them later cannot tell.
   */
  void whenSettled(this, fn<void()> f) {
    if (this.watchers is null) { this.watchers = Vec<fn<void()>>.create(); }
    this.watchers!.push(f);
  }

  bool settled(const this) { return this.done; }

  /**
   * Whether this ticket has settled, **asking the host without waiting** when the answer is the host's — and
   * settling it then, since the answer is in hand. One question per call, for a poll between steps of other
   * work; `settled` alone never asks, and racing a zero timer asks three times.
   */
  bool settledNow(this) {
    if (this.done) { return true; }
    fn<i32(i32[], i32)>? ask = this.waitHost;
    if (ask is null || this.hostId < 0) { return false; }
    if (ask!([this.hostId], 0) < 0) { return false; }
    // Answered, so driving it does not block.
    this.advance();
    return this.done;
  }

  /**
   * Stop caring about the answer. **On a ticket the host answers** it releases the host's slot and the
   * answer is discarded: the ticket never settles, and a `wait` on it answers `Stuck`. On any other ticket
   * it does nothing — wac cannot stop a machine part-way through its body, and a ticket made directly is
   * settled by whoever holds it.
   */
  void cancel(this) {
    if (this.done || this.hostId < 0) { return; }
    fn<void()>? r = this.release;
    this.hostId = -1;
    this.waitHost = null;
    this.release = null;
    this.drive = null;
    if (r is not null) { r!(); }
  }

  /**
   * Advance this ticket — `Ticket.all` or `Ticket.any` of `parts` — as soon as `parts` allow: every one
   * of them settled, or with `every` false any one. Not only when something drives it
   * (`§wac-ticket-any-v8nr3r9` says it *settles with* the first).
   *
   * **A scheduler that resumes on settling never drives.** A page resumes a machine when the ticket it
   * waits on settles (`whenSettled`), and nothing on a page calls `advance`; driven only, `await
   * Ticket.any(click, frame)` there waited for ever. `advance` runs the ticket's own `drive`, which by
   * then has nothing left to step: the parts it needs are settled.
   */
  void settleWhenParts(this, TicketBase[] parts, bool every) {
    this.parts = parts;
    for (i32 k = 0; k < parts.len(); k++) { this.advanceOnSettle(parts, parts[k], every); }
    if (canSettle(parts, every)) { this.advance(); }
  }

  /** When `t` settles, advance this ticket if `parts` now allow it. */
  void advanceOnSettle(this, TicketBase[] parts, TicketBase t, bool every) {
    t.whenSettled(() => {
      if (!this.done && canSettle(parts, every)) { this.advance(); }
    });
  }

  /**
   * One step towards settling. False when nothing a `wait` may drive can advance this ticket — it was
   * made directly and nobody has resolved it, or what it is parked on is in that state.
   *
   * **A ticket that depends on itself answers true**, so the `wait` asking loops rather than refusing:
   * nothing refused, and the program is running rather than idle (ch35, "A `wait` that depends on
   * itself loops").
   */
  bool advance(this) {
    if (this.done) { return true; }
    if (this.following) { return true; }
    Continuation? p = this.parked;
    if (p is not null) {
      TicketBase? up = p!.t;
      if (up is not null && !up!.done) {
        this.following = true;
        bool moved = up!.advance();
        this.following = false;
        return moved;
      }
      p!.call();
      return true;
    }
    fn<bool()>? d = this.drive;
    if (d is not null) { return d!(); }
    return false;
  }
}

/**
 * Why a `wait` was refused: nothing it may drive can settle the ticket (`§wac-wait-refuses-jj8u2ie`). A bug in
 * the program rather than a fault in the world, which is why it is its own type and not one of a capability's.
 */
export struct Stuck {
  string message;
  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */
  string [toString](const this) { return this.message; }
}

/** A value that will answer a `T`. Settled once, by `resolve` or by the body of the `async` call that made it. */
export struct Ticket<T> : TicketBase {
  /**
   * Null until settled, and then a function answering it. A function rather than the value, so `T`
   * needs no default and `Ticket<void>` is a ticket like any other: its answer is a function
   * answering nothing.
   */
  fn<T()>? answer = null;

  /** Settle this ticket with `v`. Traps if it is already settled: a ticket answers once. */
  void resolve(this, T v) { this.settleWith(() => v); }

  /** Settle this ticket with what `f` answers — how an `async void` body settles, having no value. */
  void settleWith(this, fn<T()> f) {
    if (this.done) { trap; }
    this.answer = f;
    this.done = true;
    Vec<fn<void()>>? watching = this.watchers;
    if (watching is not null) {
      for (i32 i = 0; i < watching!.len(); i++) { watching!.get(i)(); }
    }
  }

  /** The answer. Traps if the ticket has not settled. */
  T value(const this) {
    if (!this.done) { trap; }
    return this.answer!();
  }

  /**
   * Drive the work this ticket awaited until it answers, without suspending the caller
   * (`§wac-async-wait-5tqm2wh`). `Err` when nothing it may drive can advance it
   * (`§wac-wait-refuses-jj8u2ie`).
   *
   * `wait` stops between continuations, never inside one, so everything up to a refusal ran and is
   * settled, and `await` on the same ticket afterwards picks up from the link that refused.
   */
  Result<T, Stuck> wait(this) {
    while (!this.done) {
      if (!this.advance()) { return Result.Err(Stuck("nothing this wait may drive can settle the ticket")); }
    }
    return Result.Ok(this.answer!());
  }

  /**
   * A ticket of the tuple of what each of `tickets` answers, settled when every one is (spec ch35
   * `§wac-ticket-all-2h6iwfr`). It writes no `T`, so it is called on the bare template —
   * `Ticket.all(a, b)` — and is one function however `Ticket` is spelled (ch19).
   *
   * **Driven, not `async`.** The answer is a ticket whose `drive` steps every ticket not yet settled,
   * so whoever drives it — a `wait`, or a scheduler asking `advance` — drives them, and a `wait` that
   * nothing can help refuses (`§wac-wait-refuses-jj8u2ie`) rather than parking on one of them.
   */
  Ticket<Values<Ts>> all<Ts>(Ts ...tickets) {
    TicketBase[] parts = TicketBase[].defaulted(typeref(Ts).tupleMembers().len());
    static_for (i32 i = 0; i < typeref(Ts).tupleMembers().len(); i++) { parts[i] = tickets.[i]; }
    Ticket<Values<Ts>> out;
    out.drive = () => {
      i32 s = stepEvery(parts);
      if (s < 0) { return false; }
      // A part settling while it was stepped runs its watchers, and one of them is this ticket's own
      // `settleWhenParts` — which may already have settled it. It answers once.
      if (s == 0 || out.done) { return true; }
      Values<Ts> v;
      static_for (i32 i = 0; i < typeref(Ts).tupleMembers().len(); i++) { v.[i] = tickets.[i].value(); }
      out.resolve(v);
      return true;
    };
    out.settleWhenParts(parts, true);
    return out;
  }

  /**
   * A ticket of what the first of `tickets` to settle answers, as the union of what they answer (spec
   * ch35 `§wac-ticket-any-v8nr3r9`): `Ticket.any(a, b)` over two `Ticket<i32>`s answers an `i32`. The
   * others are not cancelled. Driven as `all` is.
   */
  Ticket<AnyValue<Ts>> any<Ts>(Ts ...tickets) {
    TicketBase[] parts = TicketBase[].defaulted(typeref(Ts).tupleMembers().len());
    static_for (i32 i = 0; i < typeref(Ts).tupleMembers().len(); i++) { parts[i] = tickets.[i]; }
    i32[] first = watchFirst(parts);
    Ticket<AnyValue<Ts>> out;
    out.drive = () => {
      i32 k = stepFirst(parts, first);
      if (k == -2) { return false; }
      if (k == -1 || out.done) { return true; }
      static_for (i32 i = 0; i < typeref(Ts).tupleMembers().len(); i++) {
        if (i == k) {
          AnyValue<Ts> v = tickets.[i].value();
          out.resolve(v);
        }
      }
      return true;
    };
    out.settleWhenParts(parts, false);
    return out;
  }

  /**
   * Which of `parts` settles first, by its index — `any` for a set that is only known at run time, as
   * `TicketBase`s whose answers the caller reads for itself. A program watching what is still open of
   * several streams has a different set each time round, and a tuple cannot say that. Driven as `any`
   * is; an empty set never settles.
   */
  Ticket<i32> first(TicketBase[] parts) {
    i32[] firstAt = watchFirst(parts);
    Ticket<i32> out;
    out.drive = () => {
      i32 k = stepFirst(parts, firstAt);
      if (k == -2) { return false; }
      if (k == -1 || out.done) { return true; }
      out.resolve(k);
      return true;
    };
    out.settleWhenParts(parts, false);
    return out;
  }

  /**
   * `any`, with the winner's index beside its value (spec ch35 `§wac-ticket-any-with-index-q2v7hcn`) —
   * what says which one won when two of them answer the same type.
   */
  Ticket<(i32, AnyValue<Ts>)> anyWithIndex<Ts>(Ts ...tickets) {
    TicketBase[] parts = TicketBase[].defaulted(typeref(Ts).tupleMembers().len());
    static_for (i32 i = 0; i < typeref(Ts).tupleMembers().len(); i++) { parts[i] = tickets.[i]; }
    i32[] first = watchFirst(parts);
    Ticket<(i32, AnyValue<Ts>)> out;
    out.drive = () => {
      i32 k = stepFirst(parts, first);
      if (k == -2) { return false; }
      if (k == -1 || out.done) { return true; }
      static_for (i32 i = 0; i < typeref(Ts).tupleMembers().len(); i++) {
        if (i == k) {
          AnyValue<Ts> v = tickets.[i].value();
          out.resolve((k, v));
        }
      }
      return true;
    };
    out.settleWhenParts(parts, false);
    return out;
  }
}

/**
 * The tuple of what each of a tuple of tickets answers: `Values<(Ticket<A>, Ticket<B>)>` is `(A, B)` —
 * what `Ticket.all` returns (spec ch30, ch35). Read from each ticket's `value()` through `typeof`, so it
 * follows the type and not how the type was spelled.
 */
export type Values<Ts> {
  typeref[] ts = typeref(Ts).tupleMembers();
  typeref[] out = typeref[].filled(ts.len(), typeref(void));
  for (i32 i = 0; i < ts.len(); i++) {
    out[i] = typeref(typeof(hypothetical<type(ts[i])>().value()));
  }
  return typeref.tuple(out);
}

/**
 * The union of what each of a tuple of tickets answers: `AnyValue<(Ticket<A>, Ticket<B>)>` is
 * `union<A, B>` — what `Ticket.any` answers (spec ch35), normalised as any union is, so two tickets of
 * one type answer that type.
 */
export type AnyValue<Ts> {
  return typeref.union(typeref(Values<Ts>).tupleMembers());
}

/** Whether every one of `parts` has settled, or with `every` false any one. */
bool canSettle(TicketBase[] parts, bool every) {
  for (i32 k = 0; k < parts.len(); k++) {
    if (parts[k].done != every) { return !every; }
  }
  return every;
}

/**
 * One step towards every one of `parts` settling: 1 when all have, 0 when one not yet settled moved, -1
 * when none of them could — which is when a `wait` on `Ticket.all` refuses.
 */
i32 stepEvery(TicketBase[] parts) {
  bool moved = false;
  bool every = true;
  for (i32 k = 0; k < parts.len(); k++) {
    if (parts[k].done) { continue; }
    if (parts[k].advance()) { moved = true; }
    if (!parts[k].done) { every = false; }
  }
  if (every) { return 1; }
  return moved ? 0 : -1;
}

/**
 * Which of `parts` settles first, as a cell `Ticket.any` reads: one already settled when it is called —
 * the first of those in argument order — or else whichever's `whenSettled` fires first. -1 until then.
 */
i32[] watchFirst(TicketBase[] parts) {
  i32[] first = [-1];
  for (i32 k = 0; k < parts.len(); k++) {
    if (parts[k].done && first[0] < 0) { first[0] = k; }
  }
  for (i32 k = 0; k < parts.len(); k++) { watchOne(parts[k], first, k); }
  return first;
}

/** Record `k` in `first` when `t` settles, unless another settled before it. */
void watchOne(TicketBase t, i32[] first, i32 k) {
  t.whenSettled(() => {
    if (first[0] < 0) { first[0] = k; }
  });
}

/**
 * The index of the first of `parts` to settle, after driving each one step if none has; -1 when none
 * has settled but one moved, -2 when none could move.
 */
i32 stepFirst(TicketBase[] parts, i32[] first) {
  if (first[0] >= 0) { return first[0]; }
  // **Driving a host ticket blocks until the host answers it**, so stepping the parts in turn would sit
  // on the first one's host work while the second's had long answered. So step only the parts that can
  // move without the host, and when every part left is waiting on host work, ask the host once which of
  // all of it answers first.
  bool moved = false;
  Vec<TicketBase> leaves = Vec<TicketBase>.create();
  for (i32 k = 0; k < parts.len(); k++) {
    if (parts[k].done) { continue; }
    i32 before = leaves.len();
    hostLeaves(parts[k], leaves);
    if (leaves.len() > before) { continue; }
    if (parts[k].advance()) { moved = true; }
    if (first[0] >= 0) { return first[0]; }
  }
  if (moved) { return -1; }
  if (leaves.len() == 0) { return -2; }
  TicketBase answered = leaves.get(0);
  fn<i32(i32[], i32)>? ask = answered.waitHost;
  if (leaves.len() > 1 && ask is not null) {
    i32[] ids = i32[].filled(leaves.len(), 0);
    for (i32 i = 0; i < leaves.len(); i++) { ids[i] = leaves.get(i).hostId; }
    i32 w = ask!(ids, -1);
    if (w < 0) { return -2; }
    answered = leaves.get(w);
  }
  if (!answered.advance()) { return -2; }
  return first[0] >= 0 ? first[0] : -1;
}

/**
 * The host tickets `t` is waiting on, added to `out`: `t` itself, what its machine is parked on, or the parts
 * of a `Ticket.all` or `Ticket.any` — none when `t` can move without the host.
 */
void hostLeaves(TicketBase t, Vec<TicketBase> out) {
  // `following` is set on a ticket already being followed — an `advance` further up this chain, or this
  // walk itself — which is a ticket that depends on itself: it moves by looping (`advance`), not by the host.
  if (t.done || t.following) { return; }
  if (t.hostId >= 0) {
    out.push(t);
    return;
  }
  t.following = true;
  Continuation? p = t.parked;
  TicketBase[]? ps = t.parts;
  if (p is not null) {
    TicketBase? up = p!.t;
    if (up is not null) { hostLeaves(up!, out); }
  } else if (ps is not null) {
    for (i32 k = 0; k < ps!.len(); k++) { hostLeaves(ps![k], out); }
  }
  t.following = false;
}

/** First in, first out — what a program's pending continuations are kept in. */
export struct Queue<T> {
  Vec<T> items;
  i32 head = 0;

  void push(this, T v) { this.items.push(v); }

  /** The oldest item, or `null` when there is none. */
  T? pop(this) {
    if (this.head >= this.items.len()) { return null; }
    T v = this.items.get(this.head);
    this.head++;
    // Start afresh once everything has been taken, so a queue that is drained now and then does not
    // grow forever.
    if (this.head == this.items.len()) {
      this.items = Vec<T>.create();
      this.head = 0;
    }
    return v;
  }

  i32 len(const this) { return this.items.len() - this.head; }

  bool isEmpty(const this) { return this.len() == 0; }
}

/**
 * What one step of a coroutine came to (spec ch36): it is waiting on a ticket, it yielded a
 * value, or it is done with its result. `W` is `never` for a machine that cannot wait and `Y` for one
 * that cannot yield.
 */
export enum Step<W, Y, R> {
  Waiting(W ticket),
  Yielded(Y value),
  Done(R result)

  /** Whether this step is `Waiting`. For the lowering and the machines below. */
  bool __wacIsWaiting(const this) {
    return match (this) { Waiting(_): true, default: false };
  }

  /** The ticket a `Waiting` step waits on. */
  W __wacWaitingOn(const this) {
    match (this) {
      Waiting(w): { return w; }
      default: { trap; }
    }
  }

  /** The result of a `Done` step. */
  R __wacDoneOf(const this) {
    match (this) {
      Done(r): { return r; }
      default: { trap; }
    }
  }

  /** Whether this step is `Done`. */
  bool __wacIsDone(const this) {
    return match (this) { Done(_): true, default: false };
  }

  /** The value of a `Yielded` step. */
  Y __wacYieldedOf(const this) {
    match (this) {
      Yielded(y): { return y; }
      default: { trap; }
    }
  }
}

/**
 * The machine under `async` and `gen`: each `step()` runs the body to its next suspension or its end.
 * `coroutine f(…)` answers one without running anything (`§wac-coroutine-runs-nothing-zumpwje`), and
 * a step after `Done` answers `Done` again (`§wac-step-finished-noop-2tenu9x`).
 */
export struct Coroutine<W, Y, R> {
  fn<Step<W, Y, R>()> resume;
  /**
   * The schedule target its body runs under: the one in force where it was made, or whatever a
   * `schedule` in it set since — restored on every resume, whoever resumes it
   * (`§wac-schedule-restored-b9qsydd`).
   */
  fn<void(Continuation)>? inner;

  Step<W, Y, R> step(this) {
    fn<void(Continuation)>? outer = __wacScheduleTarget();
    __wacSetScheduleTarget(this.inner);
    Step<W, Y, R> s = this.resume();
    this.inner = __wacScheduleTarget();
    __wacSetScheduleTarget(outer);
    return s;
  }
}

/** What calling a `gen<Y> R` function answers: a coroutine whose steps never wait. */
export struct Generator<Y, R> {
  Coroutine<never, Y, R> co;
  /** The last step `__wacNext` took, which `__wacCurrent` reads — how `for … in` walks one. */
  Step<never, Y, R>? last = null;

  Step<never, Y, R> step(this) { return this.co.step(); }

  /** Step, and answer whether it yielded. For `for … in`. */
  bool __wacNext(this) {
    Step<never, Y, R> s = this.co.step();
    this.last = s;
    return !s.__wacIsDone();
  }

  /** What the last step yielded. */
  Y __wacCurrent(this) { return this.last!.__wacYieldedOf(); }
}

/** What calling an `async gen<Y> R` function answers: its step is a ticket that does the waiting itself. */
export struct AsyncGenerator<Y, R> {
  Coroutine<TicketBase, Y, R> co;

  async Step<never, Y, R> step(this) {
    Step<TicketBase, Y, R> s = this.co.step();
    while (s.__wacIsWaiting()) {
      await s.__wacWaitingOn();
      s = this.co.step();
    }
    if (s.__wacIsDone()) { return Step.Done(s.__wacDoneOf()); }
    return Step.Yielded(s.__wacYieldedOf());
  }
}

/** The ticket a bare `await;` waits on: settled already, and a continuation parks on `null` for it. */
struct __wacReadyTicket : TicketBase { }

/** What `await t` waits on: `t`, or for a `null` — or a bare `await;` — a ticket already settled. */
export TicketBase __wacOrReady(TicketBase? t) {
  if (t is not null) { return t!; }
  __wacReadyTicket r;
  r.done = true;
  return r;
}

/**
 * The runtime half of a lowered `async` body: its ticket and its coroutine. Nothing but the lowering
 * names it.
 *
 * `run` steps the coroutine — which runs the body under its own schedule target — and hands the
 * continuation of a suspension to the target in force *outside*, which is where the suspended call
 * was made (`§wac-schedule-target-fri2qzd`). `Done` settles the ticket.
 */
export struct __wacMachine<R> {
  Ticket<R> ticket;
  Coroutine<TicketBase, never, R> co;
  /** Which suspension is current, so a continuation from an earlier one does nothing when called. */
  i32 seq;

  /**
   * An `async` call: its coroutine run at once to its first suspension, wrapped in a ticket. A static
   * rather than a generic function, which another module could not call (`issues/lang/0304c`).
   */
  Ticket<R> start(Coroutine<TicketBase, never, R> co) {
    Ticket<R> t;
    __wacMachine<R> m = __wacMachine<R>(t, co, 0);
    m.run();
    return t;
  }

  void run(this) {
    // The continuation goes to the target in force *here*, where the suspended call was made; the
    // coroutine's step runs the body under its own.
    fn<void(Continuation)>? outer = __wacScheduleTarget();
    Step<TicketBase, never, R> s = this.co.step();
    if (!s.__wacIsWaiting()) {
      this.ticket.settleWith(() => s.__wacDoneOf());
      return;
    }
    this.park(s.__wacWaitingOn());
    Continuation? k = this.ticket.parked;
    if (outer is not null && k is not null) { outer!(k!); }
  }

  /** Park on `on` — a bare `await;`'s ready ticket parks as `null` (ch35). */
  void park(this, TicketBase on) {
    this.seq++;
    __wacResumer<R> r = __wacResumer<R>(this, this.seq);
    TicketBase? t = on;
    if (on is __wacReadyTicket) { t = null; }
    this.ticket.parked = Continuation(t, r.call, r.current);
  }
}

/** One suspension's `call`: resumes the machine if that suspension is still the current one. */
struct __wacResumer<R> {
  __wacMachine<R> m;
  i32 seq;

  /** Whether the machine is still parked at this suspension. */
  bool current(const this) { return this.m.seq == this.seq && this.m.ticket.parked is not null; }

  void call(this) {
    if (this.m.seq != this.seq) { return; }
    Continuation? k = this.m.ticket.parked;
    if (k is null) { return; }
    TicketBase? on = k!.t;
    // `§wac-continuation-early-trap-rg9d475`: the ticket it waits on has to have settled.
    if (on is not null && !on!.done) { trap; }
    this.m.ticket.parked = null;
    this.m.run();
  }
}

/** The schedule target in force. The emitter replaces this body with a read of its hidden global. */
export fn<void(Continuation)>? __wacScheduleTarget() { return null; }

/** Make `f` the schedule target. The emitter replaces this body with a write of its hidden global. */
export void __wacSetScheduleTarget(fn<void(Continuation)>? f) { }
