// The HTML tag functions — spec/next ch43 `§wac-html-tag-functions-sb9cij9`.
//
// `core.html` holds a function per HTML element, each answering `Node.Element` with its own name, one
// `Attr` per attribute written and its children as `kids`. A tag is a call (ch23), so `<p class="hi">`
// is `html.p(class: "hi", kids: [])` once `html.p` is imported, and an attribute left out is `null`
// here and absent from the element.
//
// **Declared under their namespaced names directly** — `@"html.div"` — as `operators.wac` declares its
// symbols: a dotted export name is a namespace member, and core needs no namespace syntax for it.
//
// ch43 leaves the element and attribute set open. Every element here takes the same attributes, the
// common ones; one written by hand per element would be a list nobody has decided yet, and a
// uniform one is easy to widen when somebody does.
//
// Generated once from two lists; edit the lists in the commit that changes them, not one function.

import { Attr, Node } from "./jsx.wac";

/**
 * An element named `tag`, with an `Attr` for each attribute given — what every `html` function builds.
 * A namespace member like them, so a module that names no tag carries none of it (`reach.wac`).
 */
Node @"html.element"(string tag, Node[] kids, string?[] values) {
  string[] names = ["class", "id", "style", "title", "lang", "role", "href", "src", "alt", "type", "name", "value", "for", "placeholder", "rel", "target", "width", "height", "action", "method", "content", "charset", "disabled", "checked"];
  i32 n = 0;
  for (i32 i = 0; i < values.len(); i++) { if (!(values[i] is null)) { n++; } }
  Attr[] attrs = Attr[].filled(n, Attr("", ""));
  i32 at = 0;
  for (i32 i = 0; i < values.len(); i++) {
    if (values[i] is null) { continue; }
    attrs[at] = Attr(names[i], values[i]!);
    at++;
  }
  return Node.Element(tag, attrs, kids);
}

export Node @"html.a"(Node[] kids, string? class, string? id, string? style, string? title, string? lang, string? role, string? href, string? src, string? alt, string? @"type", string? name, string? value, string? @"for", string? placeholder, string? rel, string? target, string? width, string? height, string? action, string? method, string? content, string? charset, string? disabled, string? checked) {
  return @"html.element"("a", kids, [class, id, style, title, lang, role, href, src, alt, @"type", name, value, @"for", placeholder, rel, target, width, height, action, method, content, charset, disabled, checked]);
}

