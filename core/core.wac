// `core`'s entry: what `import { … } from "core"` reaches — spec ch37.
//
// **Every file of `core` is a module of its own**, with its own imports and its own scope, as any project's
// files are; this one says which of their names are `core`'s. The compiler carries each file under a key
// no path can spell (`" core/vec.wac"`) and this one under `" core"`, and from there they are read as any
// other files are: lowered, checked, reached and emitted by the same code (`packages/wacc/src/carried.wac`).
//
// A name a file exports and this one does not re-export is shared between `core`'s files and nobody else.
// Everything below was all of `core`'s exports when the files were one concatenated module, which is why
// the lists are as long as they are.

export { Read } from "./read.wac";
export { Result, flatten } from "./result.wac";
export { hashBytes, bytesEq, hashString, stringEq, hashI32, i32Eq, hashI64, i64Eq } from "./hash.wac";
export { Map } from "./map.wac";
export { Vec } from "./vec.wac";
export { Buf } from "./buf.wac";
export { toString } from "./text.wac";
export { Continuation, TicketBase, Stuck, Ticket, Values, AnyValue, Queue, Step, Coroutine, Generator,
  AsyncGenerator, __wacOrReady, __wacMachine, __wacScheduleTarget, __wacSetScheduleTarget } from "./ticket.wac";
export { NumberLiteral, fromNumber, NotANumber, NotAnInteger, OutOfRange, numberLiteralToF64,
  numberLiteralToF32, numberLiteralToI64, numberLiteralToI32, literalValue } from "./number.wac";
export { hypothetical } from "./hypothetical.wac";

// **The namespaces, each a module** (spec ch03): the operator symbols (ch22), the markup symbols (ch23), and the
// mathematical functions (ch43).
export * as operators from "./operators.wac";
export * as markup from "./markup.wac";
export * as math from "./math.wac";
