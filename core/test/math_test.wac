// `core`'s `math` against the true values — `core/math.wac`.
//
// **Measured, not sampled by eye.** For each function a thousand inputs, from the same xorshift sequence
// `genmath.py` runs, are answered here and compared with the correctly rounded answer it worked out at 400
// digits (`mathvectors.wac`). The claim the file makes is *within one unit in the last place*, so that is the
// assertion. Within that, how often each function is exactly right is fdlibm's own character — `exp` is right
// 939 times in these thousand, `log2` 998 — and a floor a little below each count is what notices a port that
// has drifted while staying inside the ulp: a constant a bit off, a head split in the wrong place.
//
// **And the port is fdlibm's, bit for bit, where that can be checked.** V8's `Math.log`, `log2`, `log1p`, `exp`
// and `expm1` are ports of the same fdlibm, and on these inputs they answer exactly what `core/math.wac` does,
// all 5,000 (2026-11-02). `log10` and `pow` differ in 68 and 44: V8's `log10` is fdlibm's older algorithm,
// further from the truth in 65 of the 68, and its `pow` a variant that is closer in 24 of 44 and further in 20.
//
// The special values are written out below the measurement: they are what the C99 annex specifies, and a
// thousand random inputs would never land on one.
import { T } from "../../packages/wactest/src/assert.wac";
import { math } from "core";
import { expExpected, expm1Expected, log10Expected, log1pExpected, log2Expected, logExpected,
         powExpected } from "./mathvectors.wac";

static i32 N = 1000;

/** genmath.py's `Rng`: a 64-bit xorshift. */
struct Rng {
  u64 s;

  u64 next(this) {
    u64 x = this.s;
    x = x ^ (x << (13 as u64));
    x = x ^ (x >> (7 as u64));
    x = x ^ (x << (17 as u64));
    this.s = x;
    return x;
  }

  /** A double in [0, 1), from the top 53 bits. */
  f64 unit(this) { return (this.next() >> (11 as u64)) as~ f64 / 9007199254740992.0; }
}

Rng rngFor(u64 seed) { return Rng(0x9E3779B97F4A7C15 ^ seed); }

f64 positive(Rng r, i32 i) {
  if (i % 4 == 0) { return f64.fromBits(0x3FE0000000000000 + r.next() % ((1 as u64) << (53 as u64))); }
  u64 e = r.next() % (2046 as u64);
  u64 m = r.next() & (((1 as u64) << (52 as u64)) - (1 as u64));
  return f64.fromBits((e << (52 as u64)) | m);
}

f64 small(Rng r) {
  u64 e = (900 as u64) + r.next() % (122 as u64);
  u64 m = r.next() & (((1 as u64) << (52 as u64)) - (1 as u64));
  u64 sign = (r.next() & (1 as u64)) << (63 as u64);
  return f64.fromBits(sign | (e << (52 as u64)) | m);
}

/** The `i`th of 16-hex-digit values in `hex`. */
u64 hexAt(u8[] hex, i32 i) {
  u64 v = 0 as u64;
  for (i32 k = i * 16; k < i * 16 + 16; k++) {
    i32 c = hex[k] as i32;
    i32 d = c >= 97 ? c - 87 : c - 48;
    v = (v << (4 as u64)) | ((d as i64) as@ u64);
  }
  return v;
}

/** A double's bits mapped so that their order as integers is the order of the values. */
u64 ordered(f64 x) {
  u64 b = f64.toBits(x);
  return (b >> (63 as u64)) == (1 as u64) ? ~b : b | ((1 as u64) << (63 as u64));
}

/** How many doubles apart `a` and `b` are. */
u64 ulps(f64 a, f64 b) {
  u64 x = ordered(a);
  u64 y = ordered(b);
  return x > y ? x - y : y - x;
}

/** Counts: `[0]` within an ulp and not exact, `[1]` exact, `[2]` further off; and the first far one, said. */
struct Tally {
  i32[] counts;
  string first;

  Tally create() { return Tally(i32[].filled(3, 0), ""); }

  void add(this, string what, f64 got, u64 wantBits) {
    f64 want = f64.fromBits(wantBits);
    u64 d = ulps(got, want);
    if (d == (0 as u64)) { this.counts[1] = this.counts[1] + 1; return; }
    if (d == (1 as u64)) { this.counts[0] = this.counts[0] + 1; return; }
    this.counts[2] = this.counts[2] + 1;
    if (this.first == "") { this.first = "\{what}: \{got}, wanted \{want} (\{d} ulps)"; }
  }

  void judge(this, T t, string name, i32 floor) {
    t.eqI32(this.counts[2], 0, name + " is more than an ulp off — first " + this.first);
    t.isTrue(this.counts[1] >= floor, name + " is exact for only \{this.counts[1]} of \{N}, below \{floor}");
  }
}

/** One function of one argument against its vectors, the inputs drawn by `draw`. */
string measured(string name, u64 seed, string expected, fn<f64(Rng, i32)> draw, fn<f64(f64)> f, i32 floor) {
  T t = T.create();
  Rng r = rngFor(seed);
  u8[] want = expected.toBytes();
  Tally tally = Tally.create();
  for (i32 i = 0; i < N; i++) {
    f64 x = draw(r, i);
    tally.add(name + "(\{x})", f(x), hexAt(want, i));
  }
  tally.judge(t, name, floor);
  return t.report();
}

f64 drawPositive(Rng r, i32 i) { return positive(r, i); }

f64 drawLog1p(Rng r, i32 i) {
  if (i % 3 == 0) { return small(r); }
  if (i % 3 == 1) { return r.unit() * 1.99 - 0.99; }
  return positive(r, i);
}

f64 drawExp(Rng r, i32 i) { return i % 4 == 0 ? small(r) : (0.0 - 745.0) + r.unit() * 1454.7; }
f64 drawExpm1(Rng r, i32 i) { return i % 4 == 0 ? small(r) : (0.0 - 40.0) + r.unit() * 749.7; }

f64 doLog(f64 x) { return math.log(x); }
f64 doLog2(f64 x) { return math.log2(x); }
f64 doLog10(f64 x) { return math.log10(x); }
f64 doLog1p(f64 x) { return math.log1p(x); }
f64 doExp(f64 x) { return math.exp(x); }
f64 doExpm1(f64 x) { return math.expm1(x); }

// The floors: each count as measured, less about one and a half per cent.
export string test_log_is_within_an_ulp() { return measured("log", 1 as u64, logExpected(), drawPositive, doLog, 970); }
export string test_log2_is_within_an_ulp() { return measured("log2", 2 as u64, log2Expected(), drawPositive, doLog2, 985); }
export string test_log10_is_within_an_ulp() { return measured("log10", 3 as u64, log10Expected(), drawPositive, doLog10, 985); }
export string test_log1p_is_within_an_ulp() { return measured("log1p", 4 as u64, log1pExpected(), drawLog1p, doLog1p, 950); }
export string test_exp_is_within_an_ulp() { return measured("exp", 5 as u64, expExpected(), drawExp, doExp, 925); }
export string test_expm1_is_within_an_ulp() { return measured("expm1", 6 as u64, expm1Expected(), drawExpm1, doExpm1, 910); }

export string test_pow_is_within_an_ulp() {
  T t = T.create();
  Rng r = rngFor(7 as u64);
  u8[] want = powExpected().toBytes();
  Tally tally = Tally.create();
  for (i32 i = 0; i < N; i++) {
    u64 e = (1003 as u64) + r.next() % (41 as u64);
    f64 x = f64.fromBits((e << (52 as u64)) | (r.next() & (((1 as u64) << (52 as u64)) - (1 as u64))));
    f64 y = 0.0;
    if (i % 5 == 0) {
      y = (r.next() % (41 as u64)) as~ f64 - 20.0;
      x = 0.0 - x;
    } else {
      y = (0.0 - 50.0) + r.unit() * 100.0;
    }
    tally.add("pow(\{x}, \{y})", math.pow(x, y), hexAt(want, i));
  }
  tally.judge(t, "pow", 875);
  return t.report();
}

/** `a` and `b` are the same value, a NaN being the same as any NaN and −0 different from +0. */
bool same(f64 a, f64 b) {
  if (a != a) { return b != b; }
  return f64.toBits(a) == f64.toBits(b);
}

export string test_the_special_values() {
  T t = T.create();
  f64 inf = 1.0 / 0.0;
  f64 nan = 0.0 / 0.0;
  f64 negZero = f64.fromBits(0x8000000000000000);
  f64 ninf = 0.0 - inf;
  // Logarithms: of zero, of a negative, of infinity, of one, and exactly at the powers.
  t.isTrue(same(math.log(0.0), ninf) && same(math.log(negZero), ninf), "log(±0) = -inf");
  t.isTrue(same(math.log(0.0 - 1.0), nan) && same(math.log(inf), inf) && same(math.log(nan), nan), "log of -1, inf, NaN");
  t.isTrue(same(math.log(1.0), 0.0), "log(1) = +0");
  t.isTrue(same(math.log2(8.0), 3.0) && same(math.log2(0.5), 0.0 - 1.0) && same(math.log2(1.0), 0.0), "log2 of powers");
  t.isTrue(same(math.log2(5.0e-324), 0.0 - 1074.0), "log2 of the least subnormal");
  t.isTrue(same(math.log10(1000.0), 3.0) && same(math.log10(1.0), 0.0) && same(math.log10(0.0), ninf), "log10");
  t.isTrue(same(math.log1p(0.0 - 1.0), ninf) && same(math.log1p(0.0 - 2.0), nan) && same(math.log1p(negZero), negZero),
           "log1p of -1, -2, -0");
  // Exponentials.
  t.isTrue(same(math.exp(0.0), 1.0) && same(math.exp(negZero), 1.0), "exp(±0) = 1");
  t.isTrue(same(math.exp(inf), inf) && same(math.exp(ninf), 0.0) && same(math.exp(nan), nan), "exp of ±inf, NaN");
  t.isTrue(same(math.exp(710.0), inf) && same(math.exp(0.0 - 746.0), 0.0), "exp overflows and underflows");
  t.isTrue(same(math.expm1(negZero), negZero) && same(math.expm1(ninf), 0.0 - 1.0) && same(math.expm1(inf), inf),
           "expm1 of -0 and ±inf");
  // pow: C99 F.9.4.4, case by case.
  t.isTrue(same(math.pow(nan, 0.0), 1.0) && same(math.pow(1.0, nan), 1.0), "pow(NaN, 0) = pow(1, NaN) = 1");
  t.isTrue(same(math.pow(0.0 - 1.0, inf), 1.0) && same(math.pow(0.0 - 1.0, ninf), 1.0), "pow(-1, ±inf) = 1");
  t.isTrue(same(math.pow(negZero, 3.0), negZero) && same(math.pow(negZero, 2.0), 0.0), "pow(-0, odd) keeps the sign");
  t.isTrue(same(math.pow(negZero, 0.0 - 3.0), ninf) && same(math.pow(0.0, 0.0 - 2.0), inf), "pow(±0, negative)");
  t.isTrue(same(math.pow(0.0 - 8.0, 1.0 / 3.0), nan), "a negative to a non-integer is NaN");
  t.isTrue(same(math.pow(0.0 - 2.0, 3.0), 0.0 - 8.0) && same(math.pow(0.0 - 2.0, 2.0), 4.0), "a negative to an integer");
  t.isTrue(same(math.pow(0.5, inf), 0.0) && same(math.pow(2.0, inf), inf) && same(math.pow(2.0, ninf), 0.0), "pow to ±inf");
  t.isTrue(same(math.pow(ninf, 0.0 - 1.0), negZero) && same(math.pow(ninf, 3.0), ninf) && same(math.pow(ninf, 2.0), inf),
           "pow(-inf, …)");
  t.isTrue(same(math.pow(2.0, 1024.0), inf) && same(math.pow(2.0, 0.0 - 1075.0), 0.0), "pow overflows and underflows");
  t.isTrue(same(math.pow(2.0, 0.0 - 1074.0), 5.0e-324), "pow reaches the least subnormal exactly");
  t.isTrue(same(math.pow(9.0, 0.5), 3.0) && same(math.pow(10.0, 15.0), 1.0e15), "pow on exact cases");
  return t.report();
}
