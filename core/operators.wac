// The operator symbols — spec ch22. `a + b` on a type that is not built in calls `a.[operators.add](b)`.
//
// Core exports this file as the namespace `operators` (ch37): `export * as operators from
// "./operators.wac"` in its entry. So `import { operators } from "core"`, `import { operators.add } from
// "core"` and `[operators.add]` all reach the declarations below, and the compiler names each as
// `operators.add` wherever it calls one. `not` is a keyword, so its symbol is written as a verbatim name.
//
// Until 2026-11-02 each was declared as `@"operators.add"`, the name a namespace member has once lowered,
// because the compiler read `core` without lowering it.

export symbol add;
export symbol subtract;
export symbol multiply;
export symbol divide;
export symbol remainder;
export symbol negate;
export symbol equal;
export symbol notEqual;
export symbol lessThan;
export symbol lessThanOrEqual;
export symbol greaterThan;
export symbol greaterThanOrEqual;
export symbol @"not";
export symbol bitwiseNot;
export symbol bitwiseAnd;
export symbol bitwiseOr;
export symbol bitwiseXor;
export symbol shiftLeft;
export symbol shiftRight;
export symbol unsignedShiftRight;
export symbol addAssign;
export symbol subtractAssign;
export symbol multiplyAssign;
export symbol divideAssign;
export symbol remainderAssign;
export symbol bitwiseAndAssign;
export symbol bitwiseOrAssign;
export symbol bitwiseXorAssign;
export symbol shiftLeftAssign;
export symbol shiftRightAssign;
export symbol unsignedShiftRightAssign;
export symbol preIncrement;
export symbol postIncrement;
export symbol preDecrement;
export symbol postDecrement;

// The reverses: `2.0 * v` on a `v` that is not a number calls `v.[operators.multiplyFromLeft](2.0)`.
export symbol addFromLeft;
export symbol subtractFromLeft;
export symbol multiplyFromLeft;
export symbol divideFromLeft;
export symbol remainderFromLeft;
export symbol equalFromLeft;
export symbol notEqualFromLeft;
export symbol lessThanFromLeft;
export symbol lessThanOrEqualFromLeft;
export symbol greaterThanFromLeft;
export symbol greaterThanOrEqualFromLeft;
export symbol bitwiseAndFromLeft;
export symbol bitwiseOrFromLeft;
export symbol bitwiseXorFromLeft;
export symbol shiftLeftFromLeft;
export symbol shiftRightFromLeft;
export symbol unsignedShiftRightFromLeft;
