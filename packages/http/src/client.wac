// One HTTP/1.1 request over a socket, read to the end, parsed.
//
// The request/read/parse loop existed twice before this file: `packages/box/src/lib/fetch.wac`, which is
// GET-only and writes the body to standard output, and the beginning of a third copy in a JSON-RPC client.
// The differences between them were the method, the body, and what to do with the answer — none of which
// is a reason to write the socket loop again.
//
// **`Connection: close` and read to EOF.** That is the framing this supports, and it is a deliberate
// restriction rather than an oversight: with the connection closing, the body's end *is* the socket's end,
// so a truncated read is indistinguishable from a complete one unless the parser is told. `parseResponse`
// is called once with `eof` set, which is what makes "the socket ended" mean "the body is complete" —
// and a connection that *failed* half way is reported as a failure rather than parsed as a short body.
//
// Keep-alive, chunked request bodies and pipelining are **not implemented**. A caller that needs them
// wants a connection object with state, which is a different shape from this function.

import { Cli, HostSocket } from "std";
import { Incoming, ParsedResponse, parseResponse } from "./incoming.wac";
import { Result } from "core";

/**
 * `method` `path` to `host:port`, with `body` if there is one, and the whole response back.
 *
 * The response, or why there is none: a socket failure, or how the parse refused.
 *
 * `contentType` is ignored when `body` is empty — a GET carries no `Content-Type`, and sending one is the
 * kind of detail a server is entitled to reject.
 */
export Result<Incoming, string> request(Cli cli, u8[] method, string host, i32 port, string path,
                                         u8[] body, string contentType) {
  HostSocket s = cli.connect(host, port).wait();
  if (s.handle < 0) { return Result.Err("\{host}: \{s.error}"); }

  string head = "\{string.fromBytes(method)} \{path} HTTP/1.1\r\n"
    + "Host: \{host}\r\n"
    + "User-Agent: wac\r\n"
    + "Connection: close\r\n";
  if (body.len() > 0) {
    head = head + "Content-Type: \{contentType}\r\n"
         + "Content-Length: \{body.len()}\r\n";
  }
  head = head + "\r\n";

  u8[] out = u8[].filled(head.toBytes().len() + body.len(), 0);
  u8[] headBytes = head.toBytes();
  out.copyFrom(headBytes, 0, 0, headBytes.len());
  out.copyFrom(body, 0, headBytes.len(), body.len());

  if (!cli.send(s.handle, out).wait()) {
    cli.closeSocket(s.handle);
    return Result.Err("\{host}: cannot send the request");
  }

  u8[] all = u8[]();
  bool reading = true;
  string why = "";
  while (reading) {
    match (cli.recv(s.handle).wait()) {
      Data(bytes): { all = append(all, bytes); }
      End: { reading = false; }
      Failed(reason): { why = reason; reading = false; }
    }
  }
  cli.closeSocket(s.handle);
  // A connection that failed halfway is not a short body. With `Connection: close` the body's end is the
  // socket's end, so this is exactly the case that would otherwise parse as a whole small page.
  if (why != "") { return Result.Err("\{host}: \{why}"); }

  match (parseResponse(all, method, true, 1 << 26)) {
    Incomplete: { return Result.Err("the response ended mid-message"); }
    Bad(code): { return Result.Err("unparseable response (\{code})"); }
    Ok(res): { return Result.Ok(res); }
  }
}

/** A GET, which is what most callers want. */
export Result<Incoming, string> get(Cli cli, string host, i32 port, string path) {
  return request(cli, "GET".toBytes(), host, port, path, u8[](), "");
}

/** A POST with a body — `packages/ethrpc` is the caller this exists for. */
export Result<Incoming, string> post(Cli cli, string host, i32 port, string path, u8[] body, string contentType) {
  return request(cli, "POST".toBytes(), host, port, path, body, contentType);
}

u8[] append(u8[] a, u8[] b) {
  u8[] out = u8[].filled(a.len() + b.len(), 0);
  out.copyFrom(a, 0, 0, a.len());
  out.copyFrom(b, 0, a.len(), b.len());
  return out;
}
