// Build a page: `<entry.wac>` exporting `async i32 main(Page page)` becomes one `index.html` that runs it.
//
//     wac run --allow-read --allow-write --allow-run packages/web/tools/build.wac src/app.wac dist
//
// **Three steps, all of them visible in the output directory.** A wrapper module, `page.wac`, gives the
// host the calls it makes — make a page, start the program, deliver an event, a timer, a file or a
// value — and imports the program's `main`. `wac bindgen --script` turns the wrapper into `page.js`,
// the glue with the program inside it. `index.html` is that module and the host — the browser's side,
// written below — so the page is a single file any static server, or none, can serve.
//
// **The program runs in a worker unless `--in-page` says otherwise.** A worker is the default because
// a page's program is a program: a loop that computes for a second, or forever, should cost the
// program its own responsiveness and not the tab's — scrolling, selecting and closing the tab keep
// working whatever it does. The worker is made from the page's own text, so there is still one file
// and nothing the server has to send. `--in-page` runs the same program on the page's own thread, for
// a page small enough that a worker is only overhead; nothing in the program changes either way,
// because the host is two halves that talk by messages, and in a page they are joined directly.
//
// **A program, not a script in someone else's language**, so a project outside this repository builds
// a page with the `wac` it already has and this package as a dependency (`templates/webapp/`). It
// runs `wac bindgen` as a command, which is why it needs `--allow-run`; `--wac <path>` names a binary
// other than the one on `PATH`, and `--page <spec>` the module the wrapper imports `Page` from when the
// project does not map this package as `web`.

import { Core, Cli, Exec, FileResult, Sys } from "std";
import { Vec } from "core";

/** What a build was asked for. */
struct Asked {
  string entry;
  string out;
  string wac;
  string pageSpec;
  string title;
  /** Run the program on the page's own thread rather than in a worker. */
  bool inPage;
  /** What `page.sys` holds, as `GRANT_*` bits: none unless `--grant read,write` asks. */
  i32 grants;
  /**
   * The export a copy of this page started by `spawnSelf` runs — `async i32 <name>(Sys sys)` — or "" for
   * a page that starts nothing. A copy has no document, so it cannot run `main(Page …)`.
   */
  string spawn;
}

/** The arguments, or a usage line in `title` and empty `entry` when they do not make sense. */
Asked askedOf(Cli cli) {
  Asked a = Asked("", "", "wac", "web", "wac", false, 0, "");
  i32 argc = cli.argCount().wait();
  string[] args = string[].filled(argc, "");
  for (i32 k = 0; k < argc; k++) { args[k] = string.fromBytes(cli.arg(k).wait()); }
  i32 i = 0;
  i32 positional = 0;
  while (i < argc) {
    string w = args[i];
    if ((w == "--wac" || w == "--page" || w == "--title") && i + 1 < argc) {
      string v = args[i + 1];
      if (w == "--wac") { a.wac = v; } else if (w == "--page") { a.pageSpec = v; } else { a.title = v; }
      i += 2;
      continue;
    }
    if (w == "--spawn" && i + 1 < argc) {
      a.spawn = args[i + 1];
      i += 2;
      continue;
    }
    if (w == "--in-page") {
      a.inPage = true;
      i++;
      continue;
    }
    // `--grant read,write` rather than `--allow-read`: after the entry, `wac run` takes `--allow-…` as
    // a grant spelled in the wrong place and refuses it, which is right — those are the builder's own.
    if (w == "--grant" && i + 1 < argc) {
      string[] names = partsOfList(args[i + 1]);
      for (string g in names) {
        if (g == "read") { a.grants = a.grants | 1; }
        else if (g == "write") { a.grants = a.grants | 2; }
        else { a.title = "unknown grant: " + g; a.entry = ""; }
      }
      i += 2;
      continue;
    }
    if (positional == 0) { a.entry = w; } else if (positional == 1) { a.out = w; }
    positional++;
    i++;
  }
  return a;
}

/** `read,write` as its names. */
string[] partsOfList(string s) {
  Vec<string> out = Vec.create();
  string rest = s;
  while (rest.len() > 0) {
    i32 cut = rest.indexOf(",");
    string p = cut < 0 ? rest : rest.slice(0, cut);
    if (p != "") { out.push(p); }
    rest = cut < 0 ? "" : rest.slice(cut + 1, rest.len());
  }
  string[] parts = string[].filled(out.len(), "");
  for (i32 i = 0; i < out.len(); i++) { parts[i] = out.get(i); }
  return parts;
}

/** The parts of a relative path, with `.` dropped and `..` taken against what comes before it. */
string[] partsOf(string path) {
  Vec<string> out = Vec.create();
  string rest = path;
  while (true) {
    i32 cut = rest.indexOf("/");
    string p = cut < 0 ? rest : rest.slice(0, cut);
    if (p == "..") {
      if (out.len() > 0 && out.get(out.len() - 1) != "..") { out.pop(); } else { out.push(p); }
    } else if (p != "" && p != ".") {
      out.push(p);
    }
    if (cut < 0) { break; }
    rest = rest.slice(cut + 1, rest.len());
  }
  string[] parts = string[].filled(out.len(), "");
  for (i32 i = 0; i < out.len(); i++) { parts[i] = out.get(i); }
  return parts;
}

/** Whether `path` is absolute or climbs above this directory. */
bool leavesHere(string path) {
  if (path.len() > 0 && path.slice(0, 1) == "/") { return true; }
  string[] parts = partsOf(path);
  return parts.len() > 0 && parts[0] == "..";
}

/** How a file in directory `from` names the file `to` — both relative to where the build runs. */
export string relativeTo(string from, string to) {
  string[] a = partsOf(from);
  string[] b = partsOf(to);
  i32 common = 0;
  while (common < a.len() && common + 1 < b.len() && a[common] == b[common]) { common++; }
  string out = "";
  for (i32 i = common; i < a.len(); i++) { out = out + "../"; }
  for (i32 i = common; i < b.len(); i++) { out = out + b[i] + (i + 1 < b.len() ? "/" : ""); }
  return out.len() >= 3 && out.slice(0, 3) == "../" ? out : "./" + out;
}

/**
 * The wrapper: the program's `main`, and `PageHost`, the one thing the browser's side holds.
 *
 * **Not `Host`**, which `packages/fs` and `packages/url` both declare: in a page whose program reaches
 * them, the wrapper's struct was keyed apart from theirs and the glue's class by that name did not
 * exist — "Host is not defined" on load.
 *
 * **`PageHost` is opaque on purpose.** Its page is a private field, so the glue `wac bindgen` writes for
 * it has no members to bind but these five methods — and none of the page's queues, tickets and
 * vectors cross into JavaScript, where nothing could use them. Handing over the `Page` itself did:
 * 24 classes and 71 KB of glue for a counter.
 */
export string wrapperFor(string entrySpec, string pageSpec, i32 grants, string spawn) {
  string w = "// Written by packages/web/tools/build.wac — the calls the host makes, and the program they run.\n"
           + "import { main" + (spawn != "" ? ", " + spawn : "") + " } from \"\{entrySpec}\";\n"
           + "import { Dom, Page, System, World, answered, deliver, elementEvent, fileArrived, timerFired, valueArrived"
           + (spawn != "" ? ", Process, processAnswered" : "")
           + " } from \"\{pageSpec}\";\n\n"
           + "export struct PageHost {\n"
           + "  private Page page;\n";
  // **The page's world is made inside the page's schedule**, so the scheduler it builds does not become
  // the program's default target: everything that resumes the program comes through the host, and the
  // host resumes it under the page. Its `Sys` is `page.sys`, holding what the build granted.
  w = w + "  private World world;\n\n"
        + "  PageHost create(Dom dom, System system) {\n"
        + "    Page page = Page.create(dom);\n"
        + "    schedule page.take;\n"
        + "    World world = World.create(system, \{grants});\n"
        + "    page.sys = world.sys;\n"
        + "    return PageHost(page, world);\n"
        + "  }\n\n"
        + "  void answer(this, i32 req, i32 fault, string text, u8[] bytes, i64 n, i64 m, i32 flags) {\n"
        + "    answered(this.page, this.world, req, fault, text, bytes, n, m, flags);\n"
        + "  }\n";
  w = w + "\n  /** Run the program, with the page as its schedule target, until it first waits. */\n"
        + "  void start(this) {\n"
        + "    schedule this.page.take;\n"
        + "    main(this.page);\n"
        + "    this.page.drain();\n"
        + "    this.page.turn();\n"
        + "  }\n";
  // **A copy of the page started by `spawnSelf` is a process, not a page**: no document, a `Sys` holding
  // what its parent gave it, and `spawn`'s export as its program. Opaque for the reason `PageHost` is.
  string spawned = spawn == "" ? "" : "\nexport struct Spawned {\n"
    + "  private Process p;\n\n"
    + "  Spawned create(System system, i32 grants) { return Spawned(Process.create(system, grants)); }\n\n"
    + "  void start(this) {\n"
    + "    schedule this.p.runner.take;\n"
    + "    this.p.started(\{spawn}(this.p.world.sys));\n"
    + "  }\n\n"
    + "  void answer(this, i32 req, i32 fault, string text, u8[] bytes, i64 n, i64 m, i32 flags) {\n"
    + "    processAnswered(this.p, req, fault, text, bytes, n, m, flags);\n"
    + "  }\n"
    + "}\n";
  return w + """

           void event(this, string kind, string id, string value, i32 x, i32 y, i32 mods) {
             deliver(this.page, kind, id, value, x, y, mods);
           }

           void element(this, i32 seq, string kind, i32 target, i32 listener, string value, i32 x, i32 y,
                        i32 mods) {
             elementEvent(this.page, seq, kind, target, listener, value, x, y, mods);
           }

           void timer(this, i32 id) { timerFired(this.page, id); }

           void file(this, bool ok, string name, u8[] bytes, string error) {
             fileArrived(this.page, ok, name, bytes, error);
           }

           void value(this, i32 req, string value) { valueArrived(this.page, req, value); }
         }
         """ + spawned;
}

/**
 * The program's half of the host: a `Dom` that turns each change into a message for the document,
 * and `receive`, which turns each message back into a call on the `PageHost`. It runs wherever the
 * program does — in a worker, or on the page — and touches nothing of the document itself. Timers
 * and the clock are here because a worker has both; a frame is the document's to give.
 *
 * `wacProgram(post)` starts the program and answers `receive`. A buffer is handed over rather than
 * copied when it is the whole of its own memory, which is what `wac bindgen` gives a `u8[]`.
 */
export string programSide() {
  // Every page has a system: what it was not granted, its `Cli` refuses (`page.sys`).
  string make = "const makeHost = (dom) => PageHost.create(dom, wacSystem((...a) => host.answer(...a), "
              + "{ child: false, args: [], cwd: \"/\", post: null }));\n";
  return """
      const wacProgram = (post) => {
        let host = null;
      """ + make + """
      
        const own = (bytes) => bytes.byteOffset === 0 && bytes.byteLength === bytes.buffer.byteLength ? [bytes.buffer] : [];
        // **One message a turn.** The program runs until it waits; what it asked of the document meanwhile
        // goes as one batch, in order, when it does — so a diff that makes five hundred changes costs one
        // message, and an element made in a turn exists before a later call in that turn draws into it.
        let batch = null, moving = [];
        const send = (m, transfer) => {
          if (batch === null) {
            batch = [];
            queueMicrotask(() => { const b = batch, t = moving; batch = null; moving = []; post(["ops", b], t); });
          }
          batch.push(m);
          if (transfer) moving.push(...transfer);
        };
        const elements = ElementOps.of(
          (id, parent, tag, before) => send(["make", id, parent, tag, before]),
          (id, parent, text, before) => send(["makeText", id, parent, text, before]),
          (id, text) => send(["text", id, text]),
          (id, name, value, present) => send(["attr", id, name, value, present]),
          (id, name, value, seen) => send(["prop", id, name, value, seen]),
          (id, before) => send(["move", id, before]),
          (id) => send(["remove", id]),
          (id, kind, prevent) => send(["listenOn", id, kind, prevent]),
          (id) => send(["focus", id]),
          (req, id) => send(["valueOf", req, id]),
        );
        const dom = Dom.of(
          elements,
          (html) => send(["render", html]),
          (id, html) => send(["renderInto", id, html]),
          (id, text) => send(["setText", id, text]),
          (id, value) => send(["setValue", id, value]),
          (id, style) => send(["setStyle", id, style]),
          (req, id) => send(["getValue", req, id]),
          (selector, kind) => send(["listen", selector, kind]),
          (title) => send(["title", title]),
          (line) => { console.log(line); },
          () => performance.now(),
          (id, ms) => { setTimeout(() => host.timer(id), ms); },
          (id) => send(["frame", id]),
          (id, w, h, rgba) => send(["drawPixels", id, w, h, rgba], own(rgba)),
          (id, x, y, w, h, rgba) => send(["drawPixelsIn", id, x, y, w, h, rgba], own(rgba)),
          (name, bytes) => send(["download", name, bytes], own(bytes)),
        );
        host = makeHost(dom);
        host.start();
        return (m) => {
          switch (m[0]) {
            case "event": host.event(m[1], m[2], m[3], m[4], m[5], m[6]); break;
            case "timer": host.timer(m[1]); break;
            case "file": host.file(m[1], m[2], m[3], m[4]); break;
            case "value": host.value(m[1], m[2]); break;
            case "el": host.element(m[1], m[2], m[3], m[4], m[5], m[6], m[7], m[8]); break;
          }
        };
      };
      """;
}

/**
 * The system's half: `System`'s calls on the Origin Private File System,
 * each answered later through `answer(req, fault, text, bytes, n, m, flags)` — `system.wac` says what
 * each call's answer holds. It runs where the program does: a worker has the file system too.
 *
 * **A fault is a number from `std`'s table**, chosen here from the error the browser threw, and the
 * browser's own message rides along for a fault the table has no words for. Paths are relative to the
 * file system's root, which is also where a page's working directory is: `.` and empty parts are
 * dropped, `..` climbs and stops at the root.
 */
export string systemSide() {
  return """
      // A queue of byte chunks with one reader at a time: what a child's streams arrive on.
      const wacQueue = () => {
        const items = [], waiters = [];
        let ended = false;
        return {
          push(b) { if (waiters.length) waiters.shift()({ bytes: b }); else items.push(b); },
          end() { ended = true; while (waiters.length) waiters.shift()({ end: true }); },
          next() {
            if (items.length) return Promise.resolve({ bytes: items.shift() });
            if (ended) return Promise.resolve({ end: true });
            return new Promise((r) => waiters.push(r));
          },
        };
      };
      const wacOwn = (b) => b.byteOffset === 0 && b.byteLength === b.buffer.byteLength ? [b.buffer] : [];
      // `me` is who this program is: a page (no arguments, no input, its output on the console), or a
      // copy of one started by `spawnSelf`, whose arguments, directory and streams its parent supplied.
      const wacSystem = (answer, me) => {
        const enc = new TextEncoder();
        const NONE = new Uint8Array(0);
        let rootP = null;
        // The file `openInput` selected, served a chunk at a time by `readChunk`; null is standard input.
        let input = null;
        const chunkOf = (req) => {
          if (input.at >= input.bytes.length) return answer(req, 0, "", NONE, 0n, 0n, 1);
          const end = Math.min(input.at + 65536, input.bytes.length);
          const bytes = input.bytes.slice(input.at, end);
          input.at = end;
          answer(req, 0, "", bytes, 0n, 0n, 0);
        };
        const root = () => (rootP ??= navigator.storage.getDirectory());
        // Handles below 2 are reserved, as on every host: 0 is standard input, 1 the parent's files.
        const handles = new Map();
        let nextHandle = 2;
        const parts = (path) => {
          const out = [];
          const whole = String(path).startsWith("/") ? String(path) : me.cwd + "/" + String(path);
          for (const p of whole.split("/")) {
            if (p === "" || p === ".") continue;
            if (p === "..") out.pop(); else out.push(p);
          }
          return out;
        };
        const dirAt = async (ps, create) => {
          let d = await root();
          for (const p of ps) d = await d.getDirectoryHandle(p, { create });
          return d;
        };
        // The directory holding a path's last part, and that part — or a refusal for the root itself.
        const parentOf = async (path, create) => {
          const ps = parts(path);
          if (ps.length === 0) throw Object.assign(new Error("the root"), { name: "TypeMismatchError" });
          return [await dirAt(ps.slice(0, -1), create), ps[ps.length - 1]];
        };
        const faultOf = (e, isDir) => {
          switch (e?.name) {
            case "NotFoundError": return 1;
            case "NotAllowedError": case "NoModificationAllowedError": case "SecurityError": return 2;
            case "InvalidModificationError": return 4;
            case "TypeMismatchError": return isDir ? 8 : 10;
            case "QuotaExceededError": return 14;
            default: return 5;
          }
        };
        const fail = (req, e, isDir) =>
          answer(req, faultOf(e, isDir), String(e?.message ?? e), NONE, 0n, 0n, 0);
        const ok = (req, bytes = NONE, n = 0n, m = 0n, flags = 0) => answer(req, 0, "", bytes, n, m, flags);
        const run = (req, isDir, work) => { work().then((a) => a, (e) => fail(req, e, isDir)); };
        const writeTo = async (dir, name, bytes) => {
          const w = await (await dir.getFileHandle(name, { create: true })).createWritable();
          await w.write(bytes);
          await w.close();
        };
        const fileOf = async (path) => {
          const [dir, name] = await parentOf(path, false);
          return await (await dir.getFileHandle(name)).getFile();
        };
        return System.of(
          (req, path) => run(req, true, async () => ok(req, new Uint8Array(await (await fileOf(path)).arrayBuffer()))),
          (req, path, bytes) => run(req, true, async () => {
            const [dir, name] = await parentOf(path, false);
            await writeTo(dir, name, bytes);
            ok(req);
          }),
          (req, path) => run(req, false, async () => {
            try {
              const f = await fileOf(path);
              return ok(req, NONE, BigInt(f.size), BigInt(f.lastModified), 1 | 2);
            } catch (e) {
              if (e?.name !== "TypeMismatchError" && e?.name !== "NotFoundError") throw e;
            }
            try {
              await dirAt(parts(path), false);
              return ok(req, NONE, 0n, 0n, 1 | 4);
            } catch (e) {
              if (e?.name !== "TypeMismatchError" && e?.name !== "NotFoundError") throw e;
            }
            ok(req);
          }),
          (req, path) => run(req, false, async () => {
            const d = await dirAt(parts(path), false);
            const names = [];
            for await (const k of d.keys()) names.push(k);
            ok(req, enc.encode(names.sort().map((n) => n + String.fromCharCode(0)).join("")));
          }),
          (req, path, parentsToo) => run(req, false, async () => {
            const [dir, name] = await parentOf(path, parentsToo);
            if (!parentsToo) {
              let there = true;
              try { await dir.getDirectoryHandle(name); } catch { there = false; }
              if (there) return answer(req, 3, "", NONE, 0n, 0n, 0);
            }
            await dir.getDirectoryHandle(name, { create: true });
            ok(req);
          }),
          (req, path, recursive) => run(req, false, async () => {
            const [dir, name] = await parentOf(path, false);
            await dir.removeEntry(name, { recursive });
            ok(req);
          }),
          // No rename in the Origin Private File System: a copy and a delete, which is not atomic.
          (req, from, to) => run(req, true, async () => {
            const bytes = new Uint8Array(await (await fileOf(from)).arrayBuffer());
            const [dir, name] = await parentOf(to, false);
            await writeTo(dir, name, bytes);
            const [fdir, fname] = await parentOf(from, false);
            await fdir.removeEntry(fname);
            ok(req);
          }),
          (req, ms) => { setTimeout(() => ok(req, NONE, BigInt(Math.round(performance.now() * 1e6))), ms); },
          () => BigInt(Date.now()),
          () => BigInt(Math.round(performance.now() * 1e6)),
          (n) => crypto.getRandomValues(new Uint8Array(n)),
          (line) => { if (me.child) me.post(["out", enc.encode(line + "\\n")]); else console.log(line); },
          (line) => { if (me.child) me.post(["err", enc.encode(line + "\\n")]); else console.warn(line); },
          (bytes) => { if (me.child) me.post(["out", bytes], wacOwn(bytes)); else console.log(new TextDecoder().decode(bytes)); },
          (bytes) => { if (me.child) me.post(["err", bytes], wacOwn(bytes)); else console.warn(new TextDecoder().decode(bytes)); },
          (code) => {
            if (!me.child) throw new Error("the program exited with " + code);
            me.post(["exit", code]);
            close();
          },
          () => me.args.length,
          (i) => me.args[i] ?? NONE,
          () => me.cwd,
          (req) => input === null ? read(req, me.stdin) : chunkOf(req),
          (req, argBytes, grants, cwd, serveFs) => spawn(req, argBytes, grants, cwd, serveFs),
          (req, h) => read(req, h === 1 && me.child ? me.fsIn : handles.get(h)?.q),
          (req, h, bytes) => {
            const to = handles.get(h);
            if (h === 1 && me.child) me.post(["fs", bytes], wacOwn(bytes));
            else if (to === undefined || to.child.gone) return answer(req, 0, "", NONE, 0n, 0n, 0);
            else if (to.kind === "out") to.child.worker.postMessage(["stdin", bytes], wacOwn(bytes));
            else if (to.kind === "fs") to.child.worker.postMessage(["fs", bytes], wacOwn(bytes));
            answer(req, 0, "", NONE, 0n, 0n, 1);
          },
          (h) => { const c = handles.get(h)?.child; if (c && !c.gone) c.worker.postMessage(["stdinEnd"]); },
          (h) => { const to = handles.get(h); if (to && to.kind === "out") stop(to.child, 143); },
          (req, h) => {
            const c = handles.get(h)?.child;
            if (c === undefined) return answer(req, 1, "not a child", NONE, 0n, 0n, 0);
            c.exit.then((code) => ok(req, NONE, BigInt(code)));
          },
          (req, path) => {
            if (path === "") { input = null; return ok(req); }
            run(req, false, async () => {
              input = { bytes: new Uint8Array(await (await fileOf(path)).arrayBuffer()), at: 0 };
              ok(req);
            });
          },
        );

        // ── Programs started from this one ───────────────────────────────────────────────────────
        // A child is a worker on this very script, told who it is by its first message. Its output,
        // its errors and its questions about files arrive as messages and wait in queues until read;
        // its input and the answers to its questions go back the same way.
        function read(req, q) {
          if (q === undefined) return answer(req, 0, "", NONE, 0n, 0n, 1);
          q.next().then((r) => r.end ? answer(req, 0, "", NONE, 0n, 0n, 1) : answer(req, 0, "", r.bytes, 0n, 0n, 0));
        }
        function stop(c, code) {
          if (c.gone) return;
          c.gone = true;
          c.worker.terminate();
          c.out.end(); c.err.end(); c.fs.end();
          c.settle(code);
        }
        function spawn(req, argBytes, grants, cwd, serveFs) {
          if (typeof WorkerGlobalScope === "undefined") {
            return answer(req, 9, "a page built --in-page cannot start programs", NONE, 0n, 0n, 0);
          }
          const args = [];
          for (let at = 0; at < argBytes.length;) {
            const end = argBytes.indexOf(0, at);
            args.push(argBytes.slice(at, end));
            at = end + 1;
          }
          const worker = new Worker(self.location.href);
          let settle;
          const c = { worker, out: wacQueue(), err: wacQueue(), fs: wacQueue(), gone: false,
                      exit: new Promise((r) => { settle = r; }) };
          c.settle = settle;
          const h = nextHandle++, eh = nextHandle++, fh = serveFs ? nextHandle++ : -1;
          handles.set(h, { kind: "out", child: c, q: c.out });
          handles.set(eh, { kind: "err", child: c, q: c.err });
          if (fh >= 0) handles.set(fh, { kind: "fs", child: c, q: c.fs });
          worker.onmessage = (e) => {
            const [k, v] = e.data;
            if (k === "out") c.out.push(v);
            else if (k === "err") c.err.push(v);
            else if (k === "fs") c.fs.push(v);
            else if (k === "exit") stop(c, v);
          };
          worker.onerror = (e) => {
            e.preventDefault();
            c.err.push(enc.encode((e.message || "the program stopped") + "\\n"));
            stop(c, 134);
          };
          worker.postMessage(["init", { args, grants, cwd, serveFs }]);
          ok(req, NONE, BigInt(h), BigInt(eh), fh);
        }
      };
      """;
}

/**
 * A copy of the page started by `spawnSelf`, as the worker it is: its input and the answers to its
 * questions arrive as messages from the parent, and everything else is the system half as a child.
 */
export string childSide() {
  return """
      const wacChild = (init) => {
        const stdin = wacQueue(), fsIn = wacQueue();
        const me = { child: true, args: init.args, cwd: init.cwd || "/", stdin, fsIn,
                     post: (m, transfer) => postMessage(m, transfer ?? []) };
        let p = null;
        p = Spawned.create(wacSystem((...a) => p.answer(...a), me), init.grants);
        p.start();
        return (m) => {
          if (m[0] === "stdin") stdin.push(m[1]);
          else if (m[0] === "stdinEnd") stdin.end();
          else if (m[0] === "fs") fsIn.push(m[1]);
        };
      };
      """;
}

/**
 * The document's half: each message from the program applied to the document, and each event, frame
 * and file sent back with `emit`. No decisions are made here — everything a page does is in
 * `src/page.wac`, where it is tested without a browser.
 *
 * **Every answer is sent later, never during the call that asked.** On the page the two halves are
 * joined directly, so an answer sent at once would run the program inside its own `getValue` call.
 */
export string documentSide() {
  return """
      const wacDocument = (root, emit) => {
        const listening = new Set();
        const byId = (id) => document.getElementById(id);
        // **The handles**: each number the program chose, and the node it named. 0 is the root.
        const nodes = new Map([[0, root]]);
        const handleOf = new WeakMap([[root, 0]]);
        // Events are numbered, and an input remembers the number of the last one typed into it — a value
        // the program sends without having seen that event is older than what the user typed, and dropped.
        let seq = 0;
        const numbered = (ev) => (ev.__wacSeq ??= ++seq);
        root.addEventListener("input", (ev) => { ev.target.__wacTyped = numbered(ev); }, true);
        const place = (parent, n, before) => {
          const p = nodes.get(parent);
          if (p) p.insertBefore(n, before < 0 ? null : (nodes.get(before) ?? null));
        };
        const forget = (n) => {
          if (handleOf.has(n)) nodes.delete(handleOf.get(n));
          for (const k of n.childNodes ?? []) forget(k);
        };
        const canvas = (id, what) => {
          const el = byId(id);
          const ctx = el && el.getContext ? el.getContext("2d") : null;
          if (!ctx) throw new Error(what + ": no canvas with id " + JSON.stringify(id));
          return [el, ctx];
        };
        const blit = (ctx, w, h, rgba, x, y) => {
          const img = ctx.createImageData(w, h);
          img.data.set(rgba);
          ctx.putImageData(img, x, y);
        };
        // Where in the element the pointer is, in the element's own pixels: a canvas's backing store
        // rather than its size on screen, so a scaled canvas still answers in the units it is drawn in.
        const within = (el, ev) => {
          if (ev.clientX === undefined) return [0, 0];
          const r = el.getBoundingClientRect();
          const sx = el.width !== undefined && r.width > 0 ? el.width / r.width : 1;
          const sy = el.height !== undefined && r.height > 0 ? el.height / r.height : 1;
          return [Math.round((ev.clientX - r.left) * sx), Math.round((ev.clientY - r.top) * sy)];
        };
        const ops = {
          make: (id, parent, tag, before) => {
            const el = document.createElement(tag);
            nodes.set(id, el); handleOf.set(el, id); place(parent, el, before);
          },
          makeText: (id, parent, text, before) => {
            const t = document.createTextNode(text);
            nodes.set(id, t); handleOf.set(t, id); place(parent, t, before);
          },
          text: (id, text) => {
            const n = nodes.get(id);
            if (!n) return;
            if (n.nodeType === 3) { n.data = text; return; }
            for (const k of n.childNodes) forget(k);
            n.textContent = text;
          },
          attr: (id, name, value, present) => {
            const n = nodes.get(id);
            if (n) { if (present) n.setAttribute(name, value); else n.removeAttribute(name); }
          },
          prop: (id, name, value, seen) => {
            const n = nodes.get(id);
            if (!n) return;
            if (name === "value") {
              if ((n.__wacTyped ?? 0) > seen) return;
              if (n.value !== value) n.value = value;
            } else n[name] = value === "true";
          },
          move: (id, before) => {
            const n = nodes.get(id);
            if (n && n.parentNode) n.parentNode.insertBefore(n, before < 0 ? null : (nodes.get(before) ?? null));
          },
          remove: (id) => {
            const n = nodes.get(id);
            if (!n) return;
            forget(n);
            n.remove();
          },
          listenOn: (id, kind, prevent) => {
            const n = nodes.get(id);
            if (!n) return;
            const keys = prevent === "" || prevent === "*" ? [] : prevent.split(" ");
            n.addEventListener(kind, (ev) => {
              let t = ev.target;
              while (t && t !== n && !handleOf.has(t)) t = t.parentNode;
              if (!t || !handleOf.has(t)) return;
              const keyed = kind === "keydown" || kind === "keyup";
              if (prevent === "*" || kind === "submit" || (keyed && keys.includes(ev.key))) ev.preventDefault();
              const el = ev.target;
              const value = keyed ? ev.key : (el && "value" in el ? String(el.value) : "");
              const [x, y] = within(t.nodeType === 1 ? t : n, ev);
              const mods = (ev.shiftKey ? 1 : 0) | (ev.ctrlKey ? 2 : 0) | (ev.altKey ? 4 : 0) | (ev.metaKey ? 8 : 0);
              emit(["el", numbered(ev), kind, handleOf.get(t), id, value, x, y, mods]);
            });
          },
          focus: (id) => { const n = nodes.get(id); if (n && n.focus) n.focus(); },
          valueOf: (req, id) => {
            const n = nodes.get(id);
            const value = n && "value" in n ? String(n.value) : "";
            queueMicrotask(() => emit(["value", req, value]));
          },
          render: (html) => { root.innerHTML = html; },
          renderInto: (id, html) => { const el = byId(id); if (el) el.innerHTML = html; },
          setText: (id, text) => { const el = byId(id); if (el) el.textContent = text; },
          setValue: (id, value) => { const el = byId(id); if (el) el.value = value; },
          setStyle: (id, style) => { const el = byId(id); if (el) el.setAttribute("style", style); },
          getValue: (req, id) => {
            const el = byId(id);
            const value = el && "value" in el ? String(el.value) : "";
            queueMicrotask(() => emit(["value", req, value]));
          },
          listen: (selector, kind) => {
            const key = selector + " " + kind;
            if (listening.has(key)) return;
            listening.add(key);
            root.addEventListener(kind, (ev) => {
              const el = ev.target instanceof Element ? ev.target.closest(selector) : null;
              if (!el || !root.contains(el)) return;
              if (kind === "submit") ev.preventDefault();
              const value = kind === "keydown" ? ev.key : ("value" in el ? String(el.value) : "");
              const [x, y] = within(el, ev);
              const mods = (ev.shiftKey ? 1 : 0) | (ev.ctrlKey ? 2 : 0) | (ev.altKey ? 4 : 0) | (ev.metaKey ? 8 : 0);
              emit(["event", kind, el.id || "", value, x, y, mods]);
            });
          },
          title: (title) => { document.title = title; },
          frame: (id) => { requestAnimationFrame(() => emit(["timer", id])); },
          drawPixels: (id, w, h, rgba) => {
            const [el, ctx] = canvas(id, "drawPixels");
            // Resizing clears a canvas, so only when the size changes.
            if (el.width !== w) el.width = w;
            if (el.height !== h) el.height = h;
            blit(ctx, w, h, rgba, 0, 0);
          },
          drawPixelsIn: (id, x, y, w, h, rgba) => { blit(canvas(id, "drawPixelsIn")[1], w, h, rgba, x, y); },
          download: (name, bytes) => {
            const a = document.createElement("a");
            a.href = URL.createObjectURL(new Blob([bytes]));
            a.download = name;
            a.click();
            setTimeout(() => URL.revokeObjectURL(a.href), 1000);
          },
        };
        // Files arrive whether or not the program has asked yet; the page keeps them until it does.
        const take = (files) => {
          for (const f of files ?? []) {
            f.arrayBuffer().then(
              (buf) => emit(["file", true, f.name, new Uint8Array(buf), ""], [buf]),
              (e) => emit(["file", false, f.name, new Uint8Array(0), String(e?.message ?? e)]));
          }
        };
        root.addEventListener("change", (ev) => { if (ev.target?.files) take(ev.target.files); });
        // Without preventing dragover a dropped file replaces the page.
        document.addEventListener("dragover", (ev) => ev.preventDefault());
        document.addEventListener("drop", (ev) => { ev.preventDefault(); take(ev.dataTransfer?.files); });
        const apply = (m) => ops[m[0]](...m.slice(1));
        return (m) => { if (m[0] === "ops") { for (const x of m[1]) apply(x); } else apply(m); };
      };
      """;
}

/**
 * The page, with the program in a worker: the glue and the program's half in a script the browser
 * does not run, and the document's half starting a worker from that script's text. A blob rather than
 * a second file, so the page stays one file that also works from a `file://` URL — and a **classic**
 * worker, which is why the glue is `wac bindgen --script`: a module worker made from a blob is refused
 * on a `file://` page, and a `data:` one would lose the page's origin and the storage that goes with it.
 */
export string workerIndexFor(string title, string module, bool spawn) {
  return head(title)
       + "<script type=\"text/plain\" id=\"wac-program\">\n" + module + "\n" + systemSide()
       + programSide()
       + (spawn ? childSide() : "")
       // The first message says who this worker is: the page's program, or a copy started by one.
       + "let receive = null;\n"
       + "onmessage = (e) => {\n"
       + "  if (receive !== null) return receive(e.data);\n"
       + "  receive = e.data[0] === \"init\" ? wacChild(e.data[1])\n"
       + "    : wacProgram((m, transfer) => postMessage(m, transfer ?? []));\n"
       + "};\n</script>\n"
       + documentScript(documentSide()
       + """
         const source = document.getElementById("wac-program").textContent;
         const worker = new Worker(URL.createObjectURL(new Blob([source], { type: "text/javascript" })));
         const apply = wacDocument(document.getElementById("app"), (m, transfer) => worker.postMessage(m, transfer ?? []));
         worker.onmessage = (e) => apply(e.data);
         worker.onerror = (e) => console.error(e.message);
         worker.postMessage(["page"]);
         """)
       + "</body>\n</html>\n";
}

/** The page, with the program on the page's own thread: the two halves joined directly. */
export string inPageIndexFor(string title, string module) {
  return head(title)
       + documentScript(module + "\n" + systemSide() + programSide() + documentSide()
       + """
         let receive = null;
         const apply = wacDocument(document.getElementById("app"), (m) => receive(m));
         receive = wacProgram((m) => apply(m));
         """)
       + "</body>\n</html>\n";
}

/**
 * The document's script, held as text, and the one script the page runs as written: `loaderScript`,
 * which runs it from a `blob:` URL.
 *
 * **So that the Content Security Policy can name what runs** (`design/system/0012`, "Policy is in wac;
 * the browser enforces it again"). A policy allows inline script by hash, and the document's script
 * holds the program in the in-page build — a different hash for every program, and a SHA-256 this
 * program would have to carry a copy of. The loader is the same few lines for every page, so its hash
 * is a constant (`loaderHash`, checked by `tools/wac/webpolicy_test.wac`), and the policy allows that
 * and `blob:`, which only a script already running can make.
 */
string documentScript(string body) {
  return "<script type=\"text/plain\" id=\"wac-document\">\n\"use strict\";\n" + body + "</script>\n"
       + "<script>" + loaderScript() + "</script>\n";
}

/** The script that runs `#wac-document`. Change it and `loaderHash` changes with it. */
export string loaderScript() {
  return "const s = document.createElement(\"script\"); "
       + "s.src = URL.createObjectURL(new Blob([document.getElementById(\"wac-document\").textContent], { type: \"text/javascript\" })); "
       + "document.body.appendChild(s);";
}

/** `loaderScript`'s SHA-256, base64 — what the policy allows it by. */
export string loaderHash() { return "xLE7i4agIkrLt+lCU03oQkaXG/ugC3kfxyQdZETBPVM="; }

/**
 * The page's Content Security Policy: its loader, scripts it made itself, its own wasm, and nothing
 * fetched from anywhere — not an image, not a style sheet, not a frame. A program has no network grant,
 * so a document it draws cannot be one either: `<img src="https://elsewhere/?secret">` is refused here
 * as well as by the handle layer's policy, and an injected `<script>` or `onerror` does not run.
 */
export string policy() {
  return "default-src 'none'; script-src 'sha256-" + loaderHash() + "' blob: 'wasm-unsafe-eval'; "
       + "worker-src blob:; style-src 'unsafe-inline'; img-src data: blob:; font-src data:; "
       + "media-src data: blob:; base-uri 'none'; form-action 'none'";
}

/** Everything before the script: the document the program draws into. */
string head(string title) {
  return "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n"
       + "<meta http-equiv=\"Content-Security-Policy\" content=\"" + policy() + "\">\n"
       + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
       + "<title>" + title + "</title>\n</head>\n<body>\n<div id=\"app\"></div>\n";
}

export i32 buildPage(Core core, Cli cli) {
  Asked a = askedOf(cli);
  if (a.entry == "" || a.out == "") {
    cli.writeErr("usage: build.wac <entry.wac> <out-dir> [--in-page] [--grant read,write] [--spawn <export>] [--title <t>] [--wac <binary>] [--page <spec>]\n".toBytes());
    return 2;
  }
  // **The wrapper is a module of this project**, so it is written inside it: from anywhere else its
  // imports would cross a project boundary, and the build would fail naming an import rather than this.
  if (leavesHere(a.out)) {
    cli.writeErr("build.wac: \{a.out}: the output directory must be inside this directory, since the page's wrapper is written there and imports the program\n".toBytes());
    return 2;
  }
  cli.mkdir(a.out, true).wait();
  string wrapper = a.out + "/page.wac";
  // A path names the file from here, and the wrapper sits in `out`; anything else is a mapped name.
  bool pagePath = a.pageSpec.len() > 0 && (a.pageSpec.slice(0, 1) == "." || a.pageSpec.slice(0, 1) == "/");
  string pageSpec = pagePath ? relativeTo(a.out, a.pageSpec) : a.pageSpec;
  string entrySpec = relativeTo(a.out, a.entry);
  cli.writeFile(wrapper, wrapperFor(entrySpec, pageSpec, a.grants, a.spawn).toBytes()).wait();
  string js = a.out + "/page.js";
  Exec made = cli.exec(a.wac, ["bindgen", wrapper, js, "--script"], u8[]()).wait();
  if (!made.ok()) {
    cli.writeErr(made.stderr);
    cli.writeErr(made.stdout);
    if (made.error != "") { cli.writeErr("build.wac: \{a.wac}: \{made.error}\n".toBytes()); }
    return 1;
  }
  FileResult module = cli.readFile(js).wait();
  if (!module.ok) {
    cli.writeErr("build.wac: \{js}: \{module.error}\n".toBytes());
    return 1;
  }
  string index = a.out + "/index.html";
  string page = a.inPage ? inPageIndexFor(a.title, string.fromBytes(module.bytes))
                          : workerIndexFor(a.title, string.fromBytes(module.bytes), a.spawn != "");
  cli.writeFile(index, page.toBytes()).wait();
  core.log("\{index}: \{module.bytes.len()} bytes of module");
  return 0;
}

export i32 main(Sys sys) { return buildPage(sys.core, sys.cli); }
