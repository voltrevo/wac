// Build a page: `<entry.wac>` exporting `async i32 main(Page page)` becomes one `index.html` that runs it.
//
//     wac run --allow-read --allow-write --allow-run packages/web/tools/build.wac src/app.wac dist
//
// **Three steps, all of them visible in the output directory.** A wrapper module, `page.wac`, gives the
// host the calls it makes — make a page, start the program, deliver an element's event, a timer, a file
// or a value — and imports the program's `main`. `wac bindgen --script` turns the wrapper into `page.js`,
// the glue with the program inside it. `index.html` is that module and the host — the browser's side,
// written below — so the page is a single file any static server, or none, can serve.
//
// **The program runs in a worker unless `--in-page` says otherwise.** A worker is the default because
// a page's program is a program: a loop that computes for a second, or forever, should cost the
// program its own responsiveness and not the tab's — scrolling, selecting and closing the tab keep
// working whatever it does. The worker is made from the page's own text, so there is still one file
// and nothing the server has to send. `--in-page` runs the same program on the page's own thread, for
// a page small enough that a worker is only overhead; nothing in the program changes either way,
// because the host is two halves that talk by messages, and in a page they are joined directly.
//
// **A program, not a script in someone else's language**, so a project outside this repository builds
// a page with the `wac` it already has and this package as a dependency (`templates/webapp/`). It
// runs `wac bindgen` as a command, which is why it needs `--allow-run`; `--wac <path>` names a binary
// other than the one on `PATH`, and `--page <spec>` the module the wrapper imports `Page` from when the
// project does not map this package as `web`.

import { Exec, Sys, ChildEnv, Files, Launch, Output, Procs } from "std";
import { Vec, flatten } from "core";

/** What a build was asked for. */
struct Asked {
  string entry;
  string out;
  string wac;
  string pageSpec;
  string title;
  /** Run the program on the page's own thread rather than in a worker. */
  bool inPage;
  /** What `page.sys` holds, as `GRANT_*` bits: none unless `--grant read,write` asks. */
  i32 grants;
  /**
   * The export a copy of this page started by `spawnSelf` runs — `async i32 <name>(Sys sys)` — or "" for
   * a page that starts nothing. A copy has no document, so it cannot run `main(Page …)`.
   */
  string spawn;
  /** A development build: the page checks its views after every turn (`Page.checking`). */
  bool dev;
}

/** The arguments, or a usage line in `title` and empty `entry` when they do not make sense. */
Asked askedOf(string[] argv) {
  Asked a = Asked("", "", "wac", "web", "wac", false, 0, "", false);
  i32 argc = argv.len();
  string[] args = string[].filled(argc, "");
  for (i32 k = 0; k < argc; k++) { args[k] = argv[k]; }
  i32 i = 0;
  i32 positional = 0;
  while (i < argc) {
    string w = args[i];
    if ((w == "--wac" || w == "--page" || w == "--title") && i + 1 < argc) {
      string v = args[i + 1];
      if (w == "--wac") { a.wac = v; } else if (w == "--page") { a.pageSpec = v; } else { a.title = v; }
      i += 2;
      continue;
    }
    if (w == "--spawn" && i + 1 < argc) {
      a.spawn = args[i + 1];
      i += 2;
      continue;
    }
    if (w == "--in-page") {
      a.inPage = true;
      i++;
      continue;
    }
    if (w == "--dev") {
      a.dev = true;
      i++;
      continue;
    }
    // `--grant read,write` rather than `--allow-read`: after the entry, `wac run` takes `--allow-…` as
    // a grant spelled in the wrong place and refuses it, which is right — those are the builder's own.
    if (w == "--grant" && i + 1 < argc) {
      string[] names = partsOfList(args[i + 1]);
      for (string g in names) {
        if (g == "read") { a.grants = a.grants | 1; }
        else if (g == "write") { a.grants = a.grants | 2; }
        else { a.title = "unknown grant: " + g; a.entry = ""; }
      }
      i += 2;
      continue;
    }
    if (positional == 0) { a.entry = w; } else if (positional == 1) { a.out = w; }
    positional++;
    i++;
  }
  return a;
}

/** `read,write` as its names. */
string[] partsOfList(string s) {
  Vec<string> out = Vec.create();
  string rest = s;
  while (rest.len() > 0) {
    i32 cut = rest.indexOf(",");
    string p = cut < 0 ? rest : rest.slice(0, cut);
    if (p != "") { out.push(p); }
    rest = cut < 0 ? "" : rest.slice(cut + 1, rest.len());
  }
  string[] parts = string[].filled(out.len(), "");
  for (i32 i = 0; i < out.len(); i++) { parts[i] = out.get(i); }
  return parts;
}

/** The parts of a relative path, with `.` dropped and `..` taken against what comes before it. */
string[] partsOf(string path) {
  Vec<string> out = Vec.create();
  string rest = path;
  while (true) {
    i32 cut = rest.indexOf("/");
    string p = cut < 0 ? rest : rest.slice(0, cut);
    if (p == "..") {
      if (out.len() > 0 && out.get(out.len() - 1) != "..") { out.pop(); } else { out.push(p); }
    } else if (p != "" && p != ".") {
      out.push(p);
    }
    if (cut < 0) { break; }
    rest = rest.slice(cut + 1, rest.len());
  }
  string[] parts = string[].filled(out.len(), "");
  for (i32 i = 0; i < out.len(); i++) { parts[i] = out.get(i); }
  return parts;
}

/** Whether `path` is absolute or climbs above this directory. */
bool leavesHere(string path) {
  if (path.len() > 0 && path.slice(0, 1) == "/") { return true; }
  string[] parts = partsOf(path);
  return parts.len() > 0 && parts[0] == "..";
}

/** How a file in directory `from` names the file `to` — both relative to where the build runs. */
export string relativeTo(string from, string to) {
  string[] a = partsOf(from);
  string[] b = partsOf(to);
  i32 common = 0;
  while (common < a.len() && common + 1 < b.len() && a[common] == b[common]) { common++; }
  string out = "";
  for (i32 i = common; i < a.len(); i++) { out = out + "../"; }
  for (i32 i = common; i < b.len(); i++) { out = out + b[i] + (i + 1 < b.len() ? "/" : ""); }
  return out.len() >= 3 && out.slice(0, 3) == "../" ? out : "./" + out;
}

/**
 * The wrapper: the program's `main`, and `PageHost`, the one thing the browser's side holds.
 *
 * **Not `Host`**, which `packages/fs` and `packages/url` both declare: in a page whose program reaches
 * them, the wrapper's struct was keyed apart from theirs and the glue's class by that name did not
 * exist — "Host is not defined" on load.
 *
 * **`PageHost` is opaque on purpose.** Its page is a private field, so the glue `wac bindgen` writes for
 * it has no members to bind but its methods — and none of the page's queues, tickets and
 * vectors cross into JavaScript, where nothing could use them. Handing over the `Page` itself did:
 * 24 classes and 71 KB of glue for a counter.
 */
export string wrapperFor(string entrySpec, string pageSpec, i32 grants, string spawn, bool dev) {
  string w = "// Written by packages/web/tools/build.wac — the calls the host makes, and the program they run.\n"
           + "import { main" + (spawn != "" ? ", " + spawn : "") + " } from \"\{entrySpec}\";\n"
           + "import { Dom, Page, System, World, answered, elementEvent, fileArrived, located, timerFired, valueArrived"
           + (spawn != "" ? ", Process, processAnswered" : "")
           + " } from \"\{pageSpec}\";\n"
           + (spawn != "" ? "import { Sys } from \"std\";\n" : "") + "\n"
           + "export struct PageHost {\n"
           + "  private Page page;\n";
  // **The page's world is made inside the page's schedule**, so the scheduler it builds does not become
  // the program's default target: everything that resumes the program comes through the host, and the
  // host resumes it under the page. Its `Sys` is `page.sys`, holding what the build granted.
  w = w + "  private World world;\n\n"
        + "  PageHost create(Dom dom, System system) {\n"
        + "    Page page = Page.create(dom);\n"
        + "    schedule page.take;\n"
        + "    World world = World.create(system, \{grants});\n"
        + "    page.sys = world.sys;\n"
        + (dev ? "    page.checking = true;\n" : "")
        + "    return PageHost(page, world);\n"
        + "  }\n\n"
        + "  void answer(this, i32 req, i32 fault, string text, u8[] bytes, i64 n, i64 m, i32 flags) {\n"
        + "    answered(this.page, this.world, req, fault, text, bytes, n, m, flags);\n"
        + "  }\n";
  w = w + "\n  /** Run the program, with the page as its schedule target, until it first waits. */\n"
        + "  void start(this) {\n"
        + "    schedule this.page.take;\n"
        + "    main(this.page);\n"
        + "    this.page.drain();\n"
        + "    this.page.turn();\n"
        + "  }\n";
  // **A copy of the page started by `spawnSelf` is a process, not a page**: no document, a `Sys` holding
  // what its parent gave it, and `spawn`'s export as its program. Opaque for the reason `PageHost` is.
  //
  // **Greeted before the program runs**, as the program adapter greets before an `async` `main`: a spawned process
  // learns whether its parent serves it files without waiting, which a page cannot do. Asked on the program's first
  // `files()` instead, every applet the browser terminal spawned trapped there.
  string spawned = spawn == "" ? "" : "\nasync i32 __wacSpawned(Sys sys) {\n"
    + "  await sys.__wacGreet();\n"
    + "  return await \{spawn}(sys);\n"
    + "}\n"
    + "\nexport struct Spawned {\n"
    + "  private Process p;\n\n"
    + "  Spawned create(System system, i32 grants) { return Spawned(Process.create(system, grants)); }\n\n"
    + "  void start(this) {\n"
    + "    schedule this.p.runner.take;\n"
    + "    this.p.started(__wacSpawned(this.p.world.sys));\n"
    + "  }\n\n"
    + "  void answer(this, i32 req, i32 fault, string text, u8[] bytes, i64 n, i64 m, i32 flags) {\n"
    + "    processAnswered(this.p, req, fault, text, bytes, n, m, flags);\n"
    + "  }\n"
    + "}\n";
  return w + """

           void element(this, i32 seq, string kind, i32 target, i32 listener, string value, i32 x, i32 y,
                        i32 mods) {
             elementEvent(this.page, seq, kind, target, listener, value, x, y, mods);
           }

           void timer(this, i32 id) { timerFired(this.page, id); }

           void file(this, bool ok, string name, u8[] bytes, string error) {
             fileArrived(this.page, ok, name, bytes, error);
           }

           void value(this, i32 req, string value) { valueArrived(this.page, req, value); }

           void located(this, string hash) { located(this.page, hash); }
         }
         """ + spawned;
}

/**
 * The program's half of the host: a `Dom` that turns each change into a message for the document,
 * and `receive`, which turns each message back into a call on the `PageHost`. It runs wherever the
 * program does — in a worker, or on the page — and touches nothing of the document itself. Timers
 * and the clock are here because a worker has both; a frame is the document's to give.
 *
 * `wacProgram(post, hash)` starts the program at location `hash` and answers `receive`. A buffer is handed over rather than
 * copied when it is the whole of its own memory, which is what `wac bindgen` gives a `u8[]`.
 */
export string programSide() {
  // Every page has a system: what it was not granted, its `Cli` refuses (`page.sys`).
  string make = "const makeHost = (dom) => PageHost.create(dom, wacSystem((...a) => host.answer(...a), "
              + "{ child: false, args: [], cwd: \"/\", post: null }));\n";
  return """
      const wacProgram = (post, where) => {
        let host = null;
      """ + make + """
      
        const own = (bytes) => bytes.byteOffset === 0 && bytes.byteLength === bytes.buffer.byteLength ? [bytes.buffer] : [];
        // **One message a turn.** The program runs until it waits; what it asked of the document meanwhile
        // goes as one batch, in order, when it does — so a diff that makes five hundred changes costs one
        // message, and an element made in a turn exists before a later call in that turn draws into it.
        let batch = null, moving = [];
        const send = (m, transfer) => {
          if (batch === null) {
            batch = [];
            queueMicrotask(() => { const b = batch, t = moving; batch = null; moving = []; post(["ops", b], t); });
          }
          batch.push(m);
          if (transfer) moving.push(...transfer);
        };
        const elements = ElementOps.of(
          (id, parent, tag, before) => send(["make", id, parent, tag, before]),
          (id, parent, text, before) => send(["makeText", id, parent, text, before]),
          (id, text) => send(["text", id, text]),
          (id, name, value, present) => send(["attr", id, name, value, present]),
          (id, name, value, seen) => send(["prop", id, name, value, seen]),
          (id, before) => send(["move", id, before]),
          (id) => send(["remove", id]),
          (id, kind, prevent) => send(["listenOn", id, kind, prevent]),
          (id) => send(["focus", id]),
          (req, id) => send(["valueOf", req, id]),
          (id, w, h, rgba) => send(["pixels", id, w, h, rgba], own(rgba)),
          (id, x, y, w, h, rgba) => send(["pixelsIn", id, x, y, w, h, rgba], own(rgba)),
          (id, named) => send(["scroll", id, named]),
        );
        const dom = Dom.of(
          elements,
          (title) => send(["title", title]),
          (line) => { console.log(line); },
          () => performance.now(),
          (id, ms) => { setTimeout(() => host.timer(id), ms); },
          (id) => send(["frame", id]),
          (name, bytes) => send(["download", name, bytes], own(bytes)),
        );
        host = makeHost(dom);
        host.located(where);
        host.start();
        return (m) => {
          switch (m[0]) {
            case "timer": host.timer(m[1]); break;
            case "file": host.file(m[1], m[2], m[3], m[4]); break;
            case "value": host.value(m[1], m[2]); break;
            case "el": host.element(m[1], m[2], m[3], m[4], m[5], m[6], m[7], m[8]); break;
            case "where": host.located(m[1]); break;
          }
        };
      };
      """;
}

/**
 * The system's half: `System`'s calls on the Origin Private File System,
 * each answered later through `answer(req, fault, text, bytes, n, m, flags)` — `system.wac` says what
 * each call's answer holds. It runs where the program does: a worker has the file system too.
 *
 * **A fault is a number from `std`'s table**, chosen here from the error the browser threw, and the
 * browser's own message rides along for a fault the table has no words for. Paths are relative to the
 * file system's root, which is also where a page's working directory is: `.` and empty parts are
 * dropped, `..` climbs and stops at the root.
 */
export string systemSide() {
  return """
      // A queue of byte chunks with one reader at a time: what a child's streams arrive on.
      const wacQueue = () => {
        const items = [], waiters = [];
        let ended = false;
        return {
          push(b) { if (waiters.length) waiters.shift()({ bytes: b }); else items.push(b); },
          end() { ended = true; while (waiters.length) waiters.shift()({ end: true }); },
          next() {
            if (items.length) return Promise.resolve({ bytes: items.shift() });
            if (ended) return Promise.resolve({ end: true });
            return new Promise((r) => waiters.push(r));
          },
        };
      };
      // Why `bytes` cannot be started as a program, or "": a wasm module carrying the manifest that describes it.
      const wacNotRunnable = (bytes) => {
        if (!WebAssembly.validate(bytes)) {
          return bytes.length >= 4 && bytes[0] === 0 && bytes[1] === 97 && bytes[2] === 115 && bytes[3] === 109
            ? "that is not a valid wasm module" : "a page starts wasm modules, and that is not one";
        }
        return WebAssembly.Module.customSections(new WebAssembly.Module(bytes), "wac.manifest").length > 0 ? ""
          : "that module carries no wac.manifest section, so a page cannot describe it";
      };
      const wacOwn = (b) => b.byteOffset === 0 && b.byteLength === b.buffer.byteLength ? [b.buffer] : [];
      // `me` is who this program is: a page (no arguments, no input, its output on the console), or a
      // copy of one started by `spawnSelf`, or a module started by `spawn`, whose arguments, directory and
      // streams its parent supplied.
      //
      // `wacServer` is the requests as plain JavaScript, `request` and `exit`: what a module the page was
      // handed is driven with (`wacModule`), and what `wacSystem` wraps as the page's own `System`.
      const wacSystem = (answer, me) => {
        const s = wacServer(answer, me);
        return System.of(s.request, s.exit);
      };
      const wacServer = (answer, me) => {
        const enc = new TextEncoder();
        const NONE = new Uint8Array(0);
        let rootP = null;
        // Requests withdrawn before they were answered (`OP_DROP`): what their answer would have held is closed
        // instead of handed to a program that no longer wants it.
        const dropped = new Set();
        const root = () => (rootP ??= navigator.storage.getDirectory());
        // Handles below 2 are reserved, as on every host: 0 is standard input, 1 the parent's files.
        const handles = new Map();
        let nextHandle = 2;
        const parts = (path) => {
          const out = [];
          const whole = String(path).startsWith("/") ? String(path) : me.cwd + "/" + String(path);
          for (const p of whole.split("/")) {
            if (p === "" || p === ".") continue;
            if (p === "..") out.pop(); else out.push(p);
          }
          return out;
        };
        const dirAt = async (ps, create) => {
          let d = await root();
          for (const p of ps) d = await d.getDirectoryHandle(p, { create });
          return d;
        };
        // The directory holding a path's last part, and that part — or a refusal for the root itself.
        const parentOf = async (path, create) => {
          const ps = parts(path);
          if (ps.length === 0) throw Object.assign(new Error("the root"), { name: "TypeMismatchError" });
          return [await dirAt(ps.slice(0, -1), create), ps[ps.length - 1]];
        };
        const faultOf = (e, isDir) => {
          switch (e?.name) {
            case "NotFoundError": return 1;
            case "NotAllowedError": case "NoModificationAllowedError": case "SecurityError": return 2;
            case "InvalidModificationError": return 4;
            case "TypeMismatchError": return isDir ? 8 : 10;
            case "QuotaExceededError": return 14;
            default: return 5;
          }
        };
        const fail = (req, e, isDir) =>
          answer(req, faultOf(e, isDir), String(e?.message ?? e), NONE, 0n, 0n, 0);
        const ok = (req, bytes = NONE, n = 0n, m = 0n, flags = 0) => answer(req, 0, "", bytes, n, m, flags);
        const run = (req, isDir, work) => { work().then((a) => a, (e) => fail(req, e, isDir)); };
        const writeTo = async (dir, name, bytes) => {
          const w = await (await dir.getFileHandle(name, { create: true })).createWritable();
          await w.write(bytes);
          await w.close();
        };
        const fileOf = async (path) => {
          const [dir, name] = await parentOf(path, false);
          return await (await dir.getFileHandle(name)).getFile();
        };
        // Standard output and error: the console for a page, the parent for a child.
        const emit = (toErr, bytes) => {
          if (me.child) me.post([toErr ? "err" : "out", bytes], wacOwn(bytes));
          else if (toErr) console.warn(new TextDecoder().decode(bytes));
          else console.log(new TextDecoder().decode(bytes));
        };
        // `OP_SPAWN`'s and `OP_SPAWN_SELF`'s bytes: the module (empty: this program), then the arguments, each
        // length-prefixed. `moduleOf` is the first part, `partsOf` the rest.
        const moduleOf = (b) => {
          const v = new DataView(b.buffer, b.byteOffset, b.byteLength);
          return b.slice(4, 4 + v.getUint32(0, true));
        };
        const partsOf = (b) => {
          const v = new DataView(b.buffer, b.byteOffset, b.byteLength);
          let at = 4 + v.getUint32(0, true);
          const n = v.getUint32(at, true);
          at += 4;
          const out = [];
          for (let i = 0; i < n; i++) {
            const len = v.getUint32(at, true);
            out.push(b.slice(at + 4, at + 4 + len));
            at += 4 + len;
          }
          return out;
        };
        // **One request at a time, by number** — design/system/0013 step 6's table, the same one every host serves.
        // What a page refuses, and in which words, `system.wac` has already decided; what reaches here is done.
        const request = (op, id, a, b, text, bytes) => {
          const n = Number(a);
          switch (op) {
            case 0: dropped.add(id); return;
            case 1: return ok(id, NONE, BigInt(Date.now()));
            case 2: return ok(id, NONE, BigInt(Math.round(performance.now() * 1e6)));
            case 3: return ok(id, crypto.getRandomValues(new Uint8Array(n)));
            case 6: return ok(id, NONE, BigInt(me.args.length));
            case 7: return ok(id, me.args[n] ?? NONE);
            case 41: return answer(id, 0, me.cwd, NONE, 0n, 0n, 0);
            case 9: return run(id, true, async () => ok(id, new Uint8Array(await (await fileOf(text)).arrayBuffer())));
            case 10: return run(id, true, async () => {
              const [dir, name] = await parentOf(text, false);
              await writeTo(dir, name, bytes);
              ok(id);
            });
            // No links in the Origin Private File System, so a stat and a link stat are one question.
            case 13: case 47: return run(id, false, async () => {
              try {
                const f = await fileOf(text);
                return ok(id, NONE, BigInt(f.size), BigInt(f.lastModified), 1 | 2);
              } catch (e) {
                if (e?.name !== "TypeMismatchError" && e?.name !== "NotFoundError") throw e;
              }
              try {
                await dirAt(parts(text), false);
                return ok(id, NONE, 0n, 0n, 1 | 4);
              } catch (e) {
                if (e?.name !== "TypeMismatchError" && e?.name !== "NotFoundError") throw e;
              }
              ok(id);
            });
            case 14: return run(id, false, async () => {
              const d = await dirAt(parts(text), false);
              const names = [];
              for await (const k of d.keys()) names.push(k);
              ok(id, enc.encode(names.sort().map((x) => x + String.fromCharCode(0)).join("")), 0n, 0n, 1);
            });
            case 15: return run(id, false, async () => {
              const parentsToo = n !== 0;
              const [dir, name] = await parentOf(text, parentsToo);
              if (!parentsToo) {
                let there = true;
                try { await dir.getDirectoryHandle(name); } catch { there = false; }
                if (there) return answer(id, 3, "", NONE, 0n, 0n, 0);
              }
              await dir.getDirectoryHandle(name, { create: true });
              ok(id);
            });
            case 16: return run(id, false, async () => {
              const [dir, name] = await parentOf(text, false);
              await dir.removeEntry(name, { recursive: n !== 0 });
              ok(id);
            });
            // No rename in the Origin Private File System: a copy and a delete, which is not atomic.
            case 17: return run(id, true, async () => {
              const to = new TextDecoder().decode(bytes);
              const content = new Uint8Array(await (await fileOf(text)).arrayBuffer());
              const [dir, name] = await parentOf(to, false);
              await writeTo(dir, name, content);
              const [fdir, fname] = await parentOf(text, false);
              await fdir.removeEntry(fname);
              ok(id);
            });
            case 12: case 48: emit(op === 48, bytes); return ok(id, NONE, 0n, 0n, 1);
            case 19: return read(id, me.stdin);
            case 30: setTimeout(() => ok(id, NONE, BigInt(Math.round(performance.now() * 1e6))), n); return;
            case 27: return spawn(id, partsOf(bytes), n, text, (Number(b) & 256) !== 0, moduleOf(bytes));
            case 49: return spawn(id, partsOf(bytes), n, text, (Number(b) & 256) !== 0, null);
            case 24: return read(id, n === 1 && me.served ? me.fsIn : handles.get(n)?.q);
            case 25: {
              const to = handles.get(n);
              // The line to a parent exists only when the parent serves this child files: anything else is a
              // send that did not go, as on every other host, so a child that asks is told at once.
              if (n === 1 && me.served) me.post(["fs", bytes], wacOwn(bytes));
              else if (to !== undefined && to.kind === "write") {
                return to.w.write(bytes).then(() => ok(id, NONE, 0n, 0n, 1), () => answer(id, 5, "", NONE, 0n, 0n, 0));
              }
              else if (to === undefined || to.child === undefined || to.child.gone) return answer(id, 5, "", NONE, 0n, 0n, 0);
              else if (to.kind === "out") to.child.worker.postMessage(["stdin", bytes], wacOwn(bytes));
              else if (to.kind === "fs") to.child.worker.postMessage(["fs", bytes], wacOwn(bytes));
              return ok(id, NONE, 0n, 0n, 1);
            }
            case 29: { const c = handles.get(n)?.child; if (c && !c.gone) c.worker.postMessage(["stdinEnd"]); return; }
            case 26: { const to = handles.get(n); if (to && to.kind === "out") stop(to.child, 143); return; }
            case 28: {
              const c = handles.get(n)?.child;
              if (c === undefined) return answer(id, 5, "not a child", NONE, 0n, 0n, 0);
              c.exit.then((code) => ok(id, NONE, BigInt(code)));
              return;
            }
            // A file as a handle of its own. A read takes the whole file at once and queues it in pieces, so
            // `recv` serves it as it serves a child; a write goes to the browser's writable stream, which keeps
            // nothing until it is closed — so a file half-written by a program that stopped is not left behind.
            case 61: return run(id, true, async () => {
              let held;
              if (n === 0) {
                const content = new Uint8Array(await (await fileOf(text)).arrayBuffer());
                const q = wacQueue();
                for (let at = 0; at < content.length; at += 65536) q.push(content.slice(at, at + 65536));
                q.end();
                held = { kind: "file", q };
              } else {
                const [dir, name] = await parentOf(text, false);
                const fh = await dir.getFileHandle(name, { create: true });
                const w = await fh.createWritable({ keepExistingData: n === 2 });
                if (n === 2) await w.seek((await fh.getFile()).size);
                held = { kind: "write", w };
              }
              if (dropped.delete(id)) { if (held.kind === "write") await held.w.abort(); return; }
              const h = nextHandle++;
              handles.set(h, held);
              ok(id, NONE, BigInt(h));
            });
            case 62: {
              const f = handles.get(n);
              if (f === undefined || (f.kind !== "file" && f.kind !== "write")) return answer(id, 5, "", NONE, 0n, 0n, 0);
              handles.delete(n);
              if (f.kind === "file") return ok(id, NONE, 0n, 0n, 1);
              f.w.close().then(() => ok(id, NONE, 0n, 0n, 1), (e) => fail(id, e, true));
              return;
            }
            default: return answer(id, 9, "a page does not serve request " + op, NONE, 0n, 0n, 0);
          }
        };
        return { request, exit: (code) => {
          if (!me.child) throw new Error("the program exited with " + code);
          me.post(["exit", code]);
          close();
        } };

        // ── Programs started from this one ───────────────────────────────────────────────────────
        // A child is a worker on this very script, told who it is by its first message. Its output,
        // its errors and its questions about files arrive as messages and wait in queues until read;
        // its input and the answers to its questions go back the same way.
        function read(req, q) {
          if (q === undefined) return answer(req, 0, "", NONE, 0n, 0n, 1);
          q.next().then((r) => r.end ? answer(req, 0, "", NONE, 0n, 0n, 1) : answer(req, 0, "", r.bytes, 0n, 0n, 0));
        }
        function stop(c, code) {
          if (c.gone) return;
          c.gone = true;
          c.worker.terminate();
          c.out.end(); c.err.end(); c.fs.end();
          c.settle(code);
        }
        // `wasm` is a module to run (`OP_SPAWN`), or null for another copy of this page (`OP_SPAWN_SELF`). Either
        // way the child is a worker on this very script; its first message says which it is.
        function spawn(req, args, grants, cwd, serveFs, wasm) {
          if (typeof WorkerGlobalScope === "undefined") {
            return answer(req, 9, "a page built --in-page cannot start programs", NONE, 0n, 0n, 0);
          }
          // **A module is checked before anything starts**, as the other hosts check one: a file that is not a wac
          // program is refused here, at `spawn`, rather than started in a worker that then fails to compile it.
          if (wasm !== null) {
            const why = wacNotRunnable(wasm);
            if (why !== "") return answer(req, 5, why, NONE, 0n, 0n, 0);
          }
          const worker = new Worker(self.location.href);
          let settle;
          const c = { worker, out: wacQueue(), err: wacQueue(), fs: wacQueue(), gone: false,
                      exit: new Promise((r) => { settle = r; }) };
          c.settle = settle;
          const h = nextHandle++, eh = nextHandle++, fh = serveFs ? nextHandle++ : -1;
          handles.set(h, { kind: "out", child: c, q: c.out });
          handles.set(eh, { kind: "err", child: c, q: c.err });
          if (fh >= 0) handles.set(fh, { kind: "fs", child: c, q: c.fs });
          worker.onmessage = (e) => {
            const [k, v] = e.data;
            if (k === "out") c.out.push(v);
            else if (k === "err") c.err.push(v);
            else if (k === "fs") c.fs.push(v);
            else if (k === "exit") stop(c, v);
          };
          worker.onerror = (e) => {
            e.preventDefault();
            c.err.push(enc.encode((e.message || "the program stopped") + "\\n"));
            stop(c, 134);
          };
          if (wasm === null) worker.postMessage(["init", { args, grants, cwd, serveFs }]);
          else worker.postMessage(["module", { wasm, args, grants, cwd, serveFs }], wacOwn(wasm));
          if (dropped.delete(req)) return stop(c, 143);
          // `m` packs the error stream's handle (low 32 bits) and the served-files channel's (high 32).
          ok(req, NONE, BigInt(h), (BigInt(eh) & 0xffffffffn) | (BigInt(fh) << 32n));
        }
      };
      """;
}

/**
 * A copy of the page started by `spawnSelf`, as the worker it is: its input and the answers to its
 * questions arrive as messages from the parent, and everything else is the system half as a child.
 */
export string childSide() {
  return """
      const wacChild = (init) => {
        const stdin = wacQueue(), fsIn = wacQueue();
        const me = { child: true, served: !!init.serveFs, args: init.args, cwd: init.cwd || "/", stdin, fsIn,
                     post: (m, transfer) => postMessage(m, transfer ?? []) };
        let p = null;
        p = Spawned.create(wacSystem((...a) => p.answer(...a), me), init.grants);
        p.start();
        return (m) => {
          if (m[0] === "stdin") stdin.push(m[1]);
          else if (m[0] === "stdinEnd") stdin.end();
          else if (m[0] === "fs") fsIn.push(m[1]);
        };
      };
      """;
}

/**
 * A module the page was handed, run in a worker of its own (design/system/0015): `OP_SPAWN`'s other half.
 *
 * **Driven from its manifest**, as `packages/platform/host/driver.ts` drives one on Deno and Node: the module
 * describes its own boundary in a `wac.manifest` section, and since design/system/0013 step 6 that boundary is a
 * handful of plain values — `__wacHost` takes the host's four calls, `__wacAnswered` takes an answer, and the rest
 * are opaque references handed straight back. So the conversions are strings, arrays and functions, and they are
 * `marshal.ts`'s, written again here because a page carries no TypeScript.
 *
 * **Its requests are served by `wacServer`**, the same switch that serves the page's own program and a copy of the
 * page — one implementation of what a request means in a browser.
 *
 * **It never blocks.** Its `waitAny` answers `HOST_CANNOT_WAIT` (-2); an `async` program then hands control back,
 * and is run on with `__wacAdvance` once an answer has arrived. An answer the browser has at once — the clock, an
 * argument, a write to a stream — is delivered inside the request that asked, as on every host; anything else is
 * delivered between turns, when the module is running nothing. A program whose `main` is not `async` blocks on its
 * first wait for the browser, and stops saying so.
 */
export string moduleSide() {
  return """
      const wacModule = (init) => {
        const stdin = wacQueue(), fsIn = wacQueue();
        const me = { child: true, served: !!init.serveFs, args: init.args, cwd: init.cwd || "/", stdin, fsIn,
                     post: (m, transfer) => postMessage(m, transfer ?? []) };
        const mod = new WebAssembly.Module(init.wasm);
        const section = WebAssembly.Module.customSections(mod, "wac.manifest");
        const manifest = section.length === 0 ? null : JSON.parse(new TextDecoder().decode(section[0]));
        const said = (text) => postMessage(["err", new TextEncoder().encode(text + String.fromCharCode(10))]);
        if (manifest === null) {
          said("this is not a wac program: it carries no wac.manifest section");
          postMessage(["exit", 126]);
          close();
          return () => {};
        }
        // ── The conversions: `marshal.ts`, by the shape of a type string. ──────────────────────────────
        let ex = null;
        const call = (name, ...a) => {
          if (typeof ex[name] !== "function") throw new Error("the module exports no " + name);
          return ex[name](...a);
        };
        const mem = () => new Uint8Array(ex["$bind$mem"].buffer);
        const SCALARS = new Set(["i8", "u8", "i16", "u16", "i32", "u32", "i64", "u64", "f32", "f64", "bool"]);
        const bindName = (n) => n.replace(/[^A-Za-z0-9_]+/g, "$").replace(/^[$]+|[$]+$/g, "");
        const shapeOf = (type) => {
          const t = type.trim();
          if (t.endsWith("?")) return shapeOf(t.slice(0, -1));
          if (t === "void" || t === "") return { kind: "void" };
          if (t === "string") return { kind: "string" };
          if (SCALARS.has(t)) return { kind: "scalar", name: t };
          if (t.endsWith("[]")) {
            const elem = shapeOf(t.slice(0, -2));
            const suffix = elem.kind === "scalar" ? elem.name : elem.kind === "string" ? "string"
              : elem.kind === "array" ? elem.suffix + "Arr" : bindName(elem.name ?? "void");
            return { kind: "array", elem, suffix };
          }
          return { kind: "ref", name: t };
        };
        const give = (make, data) => {
          call("$bind$mem_ensure", data.length);
          mem().set(data, 0);
          return call(make, data.length);
        };
        const fromWasm = (sh, w) => {
          if (w === null || w === undefined) return null;
          switch (sh.kind) {
            case "void": return undefined;
            case "scalar": return sh.name === "bool" ? w !== 0 : w;
            case "ref": return w;
            case "string": {
              const n = call("$bind$str_len", w);
              call("$bind$mem_ensure", n);
              call("$bind$str_to_mem", w);
              return new TextDecoder().decode(mem().slice(0, n));
            }
            case "array": {
              if (sh.elem.kind === "scalar" && sh.elem.name === "u8") {
                const n = call("$bind$arr_u8_len", w);
                call("$bind$mem_ensure", n);
                call("$bind$arr_u8_to_mem", w);
                return mem().slice(0, n);
              }
              const n = call("$bind$arr_" + sh.suffix + "_len", w);
              const out = [];
              for (let i = 0; i < n; i++) out.push(fromWasm(sh.elem, call("$bind$arr_" + sh.suffix + "_get", w, i)));
              return out;
            }
          }
        };
        // A function becomes a funcref, made by the module from a slot — the one conversion a host cannot do.
        const slots = manifest.callbacks.map(() => []);
        const toWasm = (type, v) => {
          const base = type.endsWith("?") ? type.slice(0, -1) : type;
          if (base.startsWith("fn[") && typeof v === "function") {
            const j = manifest.callbacks.findIndex((c) => c.type === base);
            if (j < 0) throw new Error(base + " has no dispatcher in this module");
            let slot = slots[j].indexOf(v);
            if (slot < 0) { slot = slots[j].length; slots[j].push(v); }
            return call(manifest.callbacks[j].helper, slot);
          }
          const sh = shapeOf(base);
          if (v === null || v === undefined) return sh.kind === "void" ? undefined : null;
          switch (sh.kind) {
            case "void": return undefined;
            case "scalar": return sh.name === "bool" ? (v ? 1 : 0) : v;
            case "ref": return v;
            case "string": return give("$bind$str_from_mem", new TextEncoder().encode(String(v)));
            case "array": {
              if (sh.elem.kind === "scalar" && sh.elem.name === "u8") return give("$bind$arr_u8_from_mem", Uint8Array.from(v));
              const filled = typeof ex["$bind$arr_" + sh.suffix + "_new0"] === "function";
              if (filled && v.length === 0) return call("$bind$arr_" + sh.suffix + "_new0");
              const arr = filled ? call("$bind$arr_" + sh.suffix + "_new", v.length, toWasm(elemType(base), v[0]))
                                 : call("$bind$arr_" + sh.suffix + "_new", v.length);
              for (let i = filled ? 1 : 0; i < v.length; i++) call("$bind$arr_" + sh.suffix + "_set", arr, i, toWasm(elemType(base), v[i]));
              return arr;
            }
          }
        };
        const elemType = (t) => t.slice(0, -2);
        const wac = {};
        manifest.callbacks.forEach((cb, j) => {
          wac[cb.field] = (slot, ...rest) => {
            const f = slots[j][slot];
            if (f === undefined) throw new Error("no function in slot " + slot + " of " + cb.type);
            const out = f(...(cb.params ?? []).map((t, i) => fromWasm(shapeOf(t), rest[i])));
            return cb.ret === "void" ? undefined : toWasm(cb.ret, out);
          };
        });
        ex = new WebAssembly.Instance(mod, { wac }).exports;
        const app = {};
        for (const sig of manifest.exports) {
          if (typeof ex[sig.name] !== "function") continue;
          app[sig.name] = (...a) => {
            const out = ex[sig.name](...sig.params.map((t, i) => toWasm(t, a[i])));
            return sig.ret === "" || sig.ret === "void" ? undefined : fromWasm(shapeOf(sig.ret), out);
          };
        }
        // ── Serving it. ───────────────────────────────────────────────────────────────────────────────
        // Answers the browser has at once, delivered inside the request: the clock, randomness, an argument,
        // the directory, a write to standard output or error.
        const AT_ONCE = new Set([1, 2, 3, 6, 7, 41, 12, 48]);
        let host = null, run = null, asking = -1, finished = false, turning = false;
        const arrived = [];
        const deliver = (a) => app.__wacAnswered(host, ...a);
        const turn = () => {
          turning = false;
          if (finished) return;
          while (arrived.length > 0) deliver(arrived.shift());
          if (run === null) return;
          run = app.__wacAdvance(run);
          settle();
        };
        const answer = (...a) => {
          if (finished) return;
          if (asking >= 0 && AT_ONCE.has(asking)) return deliver(a);
          arrived.push(a);
          if (!turning) { turning = true; setTimeout(turn, 0); }
        };
        const server = wacServer(answer, me);
        const settle = () => {
          if (finished || run === null || !app.__wacDone(run)) return;
          finished = true;
          server.exit(app.__wacStatus(run));
        };
        const request = (op, id, a, b, text, bytes) => {
          const was = asking;
          asking = op;
          try { server.request(op, id, a, b, text, bytes); } finally { asking = was; }
        };
        // A page cannot wait: `HOST_CANNOT_WAIT`, and an `async` program yields.
        const waitAny = (ids, millis) => -2;
        const exitWith = (code) => {
          finished = true;
          server.exit(code);
          throw new Error("exited");
        };
        const interrupted = () => false;
        try {
          host = app.__wacHost(request, waitAny, exitWith, interrupted);
          if (typeof app.__wacStart === "function") {
            run = app.__wacStart(host);
            settle();
          } else {
            const sig = manifest.exports.find((e) => e.name === "main");
            if (sig === undefined) throw new Error("the module has no main");
            const code = app.main(...(sig.params.length > 0 ? [host] : []));
            finished = true;
            server.exit(code ?? 0);
          }
        } catch (e) {
          if (!finished) {
            said(String(e?.message ?? e));
            finished = true;
            server.exit(134);
          }
        }
        return (m) => {
          if (m[0] === "stdin") stdin.push(m[1]);
          else if (m[0] === "stdinEnd") stdin.end();
          else if (m[0] === "fs") fsIn.push(m[1]);
        };
      };
      """;
}

/**
 * The document's half: each message from the program applied to the document, and each event, frame
 * and file sent back with `emit`. No decisions are made here — everything a page does is in
 * `src/page.wac`, where it is tested without a browser.
 *
 * **Every answer is sent later, never during the call that asked.** On the page the two halves are
 * joined directly, so an answer sent at once would run the program inside the call that asked.
 */
export string documentSide() {
  return """
      const wacDocument = (root, emit) => {
        // **The handles**: each number the program chose, and the node it named. 0 is the root.
        const nodes = new Map([[0, root]]);
        const handleOf = new WeakMap([[root, 0]]);
        // Events are numbered, and an input remembers the number of the last one typed into it — a value
        // the program sends without having seen that event is older than what the user typed, and dropped.
        let seq = 0;
        const numbered = (ev) => (ev.__wacSeq ??= ++seq);
        root.addEventListener("input", (ev) => { ev.target.__wacTyped = numbered(ev); }, true);
        const place = (parent, n, before) => {
          const p = nodes.get(parent);
          if (p) p.insertBefore(n, before < 0 ? null : (nodes.get(before) ?? null));
        };
        const forget = (n) => {
          if (handleOf.has(n)) nodes.delete(handleOf.get(n));
          for (const k of n.childNodes ?? []) forget(k);
        };
        const blit = (ctx, w, h, rgba, x, y) => {
          const img = ctx.createImageData(w, h);
          img.data.set(rgba);
          ctx.putImageData(img, x, y);
        };
        // Where in the element the pointer is, in the element's own pixels: a canvas's backing store
        // rather than its size on screen, so a scaled canvas still answers in the units it is drawn in.
        const within = (el, ev) => {
          if (ev.clientX === undefined) return [0, 0];
          const r = el.getBoundingClientRect();
          const sx = el.width !== undefined && r.width > 0 ? el.width / r.width : 1;
          const sy = el.height !== undefined && r.height > 0 ? el.height / r.height : 1;
          return [Math.round((ev.clientX - r.left) * sx), Math.round((ev.clientY - r.top) * sy)];
        };
        const ops = {
          make: (id, parent, tag, before) => {
            const el = document.createElement(tag);
            nodes.set(id, el); handleOf.set(el, id); place(parent, el, before);
          },
          makeText: (id, parent, text, before) => {
            const t = document.createTextNode(text);
            nodes.set(id, t); handleOf.set(t, id); place(parent, t, before);
          },
          text: (id, text) => {
            const n = nodes.get(id);
            if (!n) return;
            if (n.nodeType === 3) { n.data = text; return; }
            for (const k of n.childNodes) forget(k);
            n.textContent = text;
          },
          attr: (id, name, value, present) => {
            const n = nodes.get(id);
            if (n) { if (present) n.setAttribute(name, value); else n.removeAttribute(name); }
          },
          prop: (id, name, value, seen) => {
            const n = nodes.get(id);
            if (!n) return;
            if (name === "value") {
              if ((n.__wacTyped ?? 0) > seen) return;
              if (n.value !== value) n.value = value;
            } else n[name] = value === "true";
          },
          move: (id, before) => {
            const n = nodes.get(id);
            if (n && n.parentNode) n.parentNode.insertBefore(n, before < 0 ? null : (nodes.get(before) ?? null));
          },
          remove: (id) => {
            const n = nodes.get(id);
            if (!n) return;
            forget(n);
            n.remove();
          },
          listenOn: (id, kind, prevent) => {
            const n = nodes.get(id);
            if (!n) return;
            // `prevent` names keys: `Tab` matches with any modifiers held, and `Ctrl+s` only with exactly
            // Ctrl (of Ctrl, Alt, Shift and Meta) — so a page can take Ctrl+S without taking every `s`. A
            // single letter matches either case, since Shift turns `s` into `S`.
            const keys = prevent === "" || prevent === "*" ? [] : prevent.split(" ").filter((k) => k !== "").map((k) => {
              const parts = k.split("+");
              if (parts.length === 1 || k === "+") return { key: k, mods: -1 };
              const bit = { Shift: 1, Ctrl: 2, Alt: 4, Meta: 8 };
              let mods = 0;
              for (const p of parts.slice(0, -1)) mods |= bit[p] ?? 0;
              return { key: parts[parts.length - 1], mods };
            });
            const keyMatches = (ev) => keys.some((k) => {
              const held = (ev.shiftKey ? 1 : 0) | (ev.ctrlKey ? 2 : 0) | (ev.altKey ? 4 : 0) | (ev.metaKey ? 8 : 0);
              if (k.mods >= 0 && k.mods !== held) return false;
              return k.key.length === 1 ? k.key.toLowerCase() === ev.key.toLowerCase() : k.key === ev.key;
            });
            n.addEventListener(kind, (ev) => {
              let t = ev.target;
              while (t && t !== n && !handleOf.has(t)) t = t.parentNode;
              if (!t || !handleOf.has(t)) return;
              const keyed = kind === "keydown" || kind === "keyup";
              if (prevent === "*" || kind === "submit" || (keyed && keyMatches(ev))) ev.preventDefault();
              const el = ev.target;
              const value = keyed ? ev.key : (el && "value" in el ? String(el.value) : "");
              // In the listening element's own pixels, whatever is under the pointer inside it: a bar's
              // handler gets the bar's coordinates over its title, and a desktop's the desktop's over a window.
              const [x, y] = within(n, ev);
              const mods = (ev.shiftKey ? 1 : 0) | (ev.ctrlKey ? 2 : 0) | (ev.altKey ? 4 : 0) | (ev.metaKey ? 8 : 0);
              emit(["el", numbered(ev), kind, handleOf.get(t), id, value, x, y, mods]);
            });
          },
          focus: (id) => { const n = nodes.get(id); if (n && n.focus) n.focus(); },
          // A handle's canvas, which `Element.pixels` has already checked is one.
          pixels: (id, w, h, rgba) => {
            const el = nodes.get(id);
            if (!el) return;
            // Resizing clears a canvas, so only when the size changes.
            if (el.width !== w) el.width = w;
            if (el.height !== h) el.height = h;
            blit(el.getContext("2d"), w, h, rgba, 0, 0);
          },
          pixelsIn: (id, x, y, w, h, rgba) => { const el = nodes.get(id); if (el) blit(el.getContext("2d"), w, h, rgba, x, y); },
          // Under the handle's own element only: a name reaches no further than the handle does.
          scroll: (id, named) => {
            const n = nodes.get(id);
            const el = !n || named === "" ? n : [...n.querySelectorAll("[id]")].find((e) => e.id === named);
            if (el && el.scrollIntoView) el.scrollIntoView({ block: "start" });
          },
          valueOf: (req, id) => {
            const n = nodes.get(id);
            const value = n && "value" in n ? String(n.value) : "";
            queueMicrotask(() => emit(["value", req, value]));
          },
          title: (title) => { document.title = title; },
          frame: (id) => { requestAnimationFrame(() => emit(["timer", id])); },
          download: (name, bytes) => {
            const a = document.createElement("a");
            a.href = URL.createObjectURL(new Blob([bytes]));
            a.download = name;
            a.click();
            setTimeout(() => URL.revokeObjectURL(a.href), 1000);
          },
        };
        // Files arrive whether or not the program has asked yet; the page keeps them until it does.
        // A file's name is its path below what the user handed over — `photos/2024/a.jpg` for a file
        // in a folder, picked with `webkitdirectory` or dropped, and `a.jpg` for a file on its own.
        const send = (f, path) => f.arrayBuffer().then(
          (buf) => emit(["file", true, path, new Uint8Array(buf), ""], [buf]),
          (e) => emit(["file", false, path, new Uint8Array(0), String(e?.message ?? e)]));
        const take = (files) => { for (const f of files ?? []) send(f, f.webkitRelativePath || f.name); };
        // A dropped folder is a directory entry rather than a file — reading it as one fails — so it is
        // walked. `readEntries` answers in batches, and an empty batch is the end of the directory.
        const rel = (p) => p.startsWith("/") ? p.slice(1) : p;
        const failed = (path, e) => emit(["file", false, path, new Uint8Array(0), String(e?.message ?? e)]);
        const walk = (entry) => {
          if (entry.isFile) {
            entry.file((f) => send(f, rel(entry.fullPath)), (e) => failed(rel(entry.fullPath), e));
          } else if (entry.isDirectory) {
            // Some browsers refuse to list a dropped folder on a page opened from a `file://` URL: the
            // error says it was a folder, so a program can say what to do instead.
            const reader = entry.createReader();
            const more = () => reader.readEntries(
              (batch) => { if (batch.length > 0) { batch.forEach(walk); more(); } },
              (e) => failed(rel(entry.fullPath), `a dropped folder could not be listed here (${e?.name}: ${e?.message})`));
            more();
          }
        };
        // **A handle where the browser has one** (Chrome, Edge): the entry API's `readEntries` fails with
        // an EncodingError on a page opened from a `file://` URL, and a built page is often opened that way.
        const walkHandle = async (h, path) => {
          if (h.kind === "file") {
            try { send(await h.getFile(), path); } catch (e) { failed(path, e); }
            return;
          }
          try { for await (const kid of h.values()) await walkHandle(kid, path + "/" + kid.name); }
          catch (e) { failed(path, e); }
        };
        // **Only a folder is walked.** A dropped file is read as the file it is: through an entry, some
        // browsers cannot read even a lone file on a page opened from a `file://` URL. Entries and handles
        // are taken during the event, because a drop's items are unreadable once it returns; a handle the
        // browser then refuses — as it may in a sandboxed frame — falls back to the entry. A browser with
        // no entries at all cannot tell a folder from a file, and is given `files` as it always was.
        const dropped = (dt) => {
          const items = [...(dt?.items ?? [])].filter((it) => it.kind === "file");
          const files = [...(dt?.files ?? [])];
          const entries = items.map((it) => it.webkitGetAsEntry?.() ?? null);
          if (items.length === 0 || files.length !== items.length || entries.some((x) => x === null)) {
            take(dt?.files);
            return;
          }
          const handles = items.map((it, i) =>
            entries[i].isDirectory && it.getAsFileSystemHandle ? it.getAsFileSystemHandle() : null);
          items.forEach((it, i) => {
            if (!entries[i].isDirectory) take([files[i]]);
            else if (handles[i]) handles[i].then((h) => h ? walkHandle(h, h.name) : walk(entries[i]), () => walk(entries[i]));
            else walk(entries[i]);
          });
        };
        root.addEventListener("change", (ev) => { if (ev.target?.files) take(ev.target.files); });
        // A link to `#/somewhere`, and the browser's back and forward, move the location; the program follows.
        addEventListener("hashchange", () => emit(["where", location.hash]));
        // Without preventing dragover a dropped file replaces the page.
        document.addEventListener("dragover", (ev) => ev.preventDefault());
        document.addEventListener("drop", (ev) => { ev.preventDefault(); dropped(ev.dataTransfer); });
        const apply = (m) => ops[m[0]](...m.slice(1));
        return (m) => { if (m[0] === "ops") { for (const x of m[1]) apply(x); } else apply(m); };
      };
      """;
}

/**
 * The page, with the program in a worker: the glue and the program's half in a script the browser
 * does not run, and the document's half starting a worker from that script's text. A blob rather than
 * a second file, so the page stays one file that also works from a `file://` URL — and a **classic**
 * worker, which is why the glue is `wac bindgen --script`: a module worker made from a blob is refused
 * on a `file://` page, and a `data:` one would lose the page's origin and the storage that goes with it.
 */
export string workerIndexFor(string title, string module, bool spawn) {
  return head(title)
       + "<script type=\"text/plain\" id=\"wac-program\">\n" + module + "\n" + systemSide()
       + programSide()
       + (spawn ? childSide() : "") + moduleSide()
       // The first message says who this worker is: the page's program, a copy started by one, or a module one
       // was handed.
       + "let receive = null;\n"
       + "onmessage = (e) => {\n"
       + "  if (receive !== null) return receive(e.data);\n"
       + "  receive = e.data[0] === \"init\" ? wacChild(e.data[1])\n"
       + "    : e.data[0] === \"module\" ? wacModule(e.data[1])\n"
       + "    : wacProgram((m, transfer) => postMessage(m, transfer ?? []), e.data[1]);\n"
       + "};\n</script>\n"
       + documentScript(documentSide()
       + """
         const source = document.getElementById("wac-program").textContent;
         const worker = new Worker(URL.createObjectURL(new Blob([source], { type: "text/javascript" })));
         const apply = wacDocument(document.getElementById("app"), (m, transfer) => worker.postMessage(m, transfer ?? []));
         worker.onmessage = (e) => apply(e.data);
         worker.onerror = (e) => console.error(e.message);
         worker.postMessage(["page", location.hash]);
         """)
       + "</body>\n</html>\n";
}

/** The page, with the program on the page's own thread: the two halves joined directly. */
export string inPageIndexFor(string title, string module) {
  return head(title)
       + documentScript(module + "\n" + systemSide() + programSide() + documentSide()
       + """
         let receive = null;
         const apply = wacDocument(document.getElementById("app"), (m) => receive(m));
         receive = wacProgram((m) => apply(m), location.hash);
         """)
       + "</body>\n</html>\n";
}

/**
 * The document's script, held as text, and the one script the page runs as written: `loaderScript`,
 * which runs it from a `blob:` URL.
 *
 * **So that the Content Security Policy can name what runs** (`design/system/0012`, "Policy is in wac;
 * the browser enforces it again"). A policy allows inline script by hash, and the document's script
 * holds the program in the in-page build — a different hash for every program, and a SHA-256 this
 * program would have to carry a copy of. The loader is the same few lines for every page, so its hash
 * is a constant (`loaderHash`, checked by `tools/wac/webpolicy_test.wac`), and the policy allows that
 * and `blob:`, which only a script already running can make.
 */
string documentScript(string body) {
  return "<script type=\"text/plain\" id=\"wac-document\">\n\"use strict\";\n" + body + "</script>\n"
       + "<script>" + loaderScript() + "</script>\n";
}

/** The script that runs `#wac-document`. Change it and `loaderHash` changes with it. */
export string loaderScript() {
  return "const s = document.createElement(\"script\"); "
       + "s.src = URL.createObjectURL(new Blob([document.getElementById(\"wac-document\").textContent], { type: \"text/javascript\" })); "
       + "document.body.appendChild(s);";
}

/** `loaderScript`'s SHA-256, base64 — what the policy allows it by. */
export string loaderHash() { return "xLE7i4agIkrLt+lCU03oQkaXG/ugC3kfxyQdZETBPVM="; }

/**
 * The page's Content Security Policy: its loader, scripts it made itself, its own wasm, and nothing
 * fetched from anywhere — not an image, not a style sheet, not a frame. A program has no network grant,
 * so a document it draws cannot be one either: `<img src="https://elsewhere/?secret">` is refused here
 * as well as by the handle layer's policy, and an injected `<script>` or `onerror` does not run.
 */
export string policy() {
  return "default-src 'none'; script-src 'sha256-" + loaderHash() + "' blob: 'wasm-unsafe-eval'; "
       + "worker-src blob:; style-src 'unsafe-inline'; img-src data: blob:; font-src data:; "
       + "media-src data: blob:; base-uri 'none'; form-action 'none'";
}

/** Everything before the script: the document the program draws into. */
string head(string title) {
  return "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n"
       + "<meta http-equiv=\"Content-Security-Policy\" content=\"" + policy() + "\">\n"
       + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
       + "<title>" + title + "</title>\n</head>\n<body>\n<div id=\"app\"></div>\n";
}

export i32 buildPage(string[] argv, Output err, Output out, Files fs, Procs procs) {
  Asked a = askedOf(argv);
  if (a.entry == "" || a.out == "") {
    err.write("usage: build.wac <entry.wac> <out-dir> [--in-page] [--dev] [--grant read,write] [--spawn <export>] [--title <t>] [--wac <binary>] [--page <spec>]\n".toBytes());
    return 2;
  }
  // **The wrapper is a module of this project**, so it is written inside it: from anywhere else its
  // imports would cross a project boundary, and the build would fail naming an import rather than this.
  if (leavesHere(a.out)) {
    err.write("build.wac: \{a.out}: the output directory must be inside this directory, since the page's wrapper is written there and imports the program\n".toBytes());
    return 2;
  }
  fs.mkdir(a.out, true).wait();
  string wrapper = a.out + "/page.wac";
  // A path names the file from here, and the wrapper sits in `out`; anything else is a mapped name.
  bool pagePath = a.pageSpec.len() > 0 && (a.pageSpec.slice(0, 1) == "." || a.pageSpec.slice(0, 1) == "/");
  string pageSpec = pagePath ? relativeTo(a.out, a.pageSpec) : a.pageSpec;
  string entrySpec = relativeTo(a.out, a.entry);
  fs.writeFile(wrapper, wrapperFor(entrySpec, pageSpec, a.grants, a.spawn, a.dev).toBytes()).wait();
  string js = a.out + "/page.js";
  auto madeRan = flatten(procs.exec(a.wac, ["bindgen", wrapper, js, "--script"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? made = madeRan.ok();
  if (!made!.ok()) {
    err.write(made!.stderr);
    err.write(made!.stdout);
    if ("\{madeRan.isErr() ? "\{madeRan.err()!}" : ""}" != "") { flatten(err.write("build.wac: \{a.wac}: \{madeRan.isErr() ? "\{madeRan.err()!}" : ""}\n".toBytes()).wait()).isOk(); }
    return 1;
  }
  auto moduleRead = flatten(fs.readFile(js).wait());
  u8[]? module = moduleRead.ok();
  if ((module is null)) {
    err.write("build.wac: \{js}: \{moduleRead.isErr() ? "\{moduleRead.err()!}" : ""}\n".toBytes());
    return 1;
  }
  string index = a.out + "/index.html";
  string page = a.inPage ? inPageIndexFor(a.title, string.fromBytes(module!))
                          : workerIndexFor(a.title, string.fromBytes(module!), a.spawn != "");
  fs.writeFile(index, page.toBytes()).wait();
  out.line("\{index}: \{module!.len()} bytes of module");
  return 0;
}

export i32 main(Sys sys) { return buildPage(sys.args(), sys.stderr(), sys.stdout(), sys.files(), sys.procs()); }
