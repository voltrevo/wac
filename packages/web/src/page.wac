// A web page, as a wac program sees it: `export async i32 main(Page page)`.
//
// **The program is an `async` function.** It changes the document with plain calls — `render`,
// `setText`, `drawPixels` — and it waits for what happens later — the next event, a timer, a file, an
// input's value — with `await`. Each `await` hands control back, and the host calls back in when
// something arrives. Nothing blocks and no memory is shared, so a built page needs nothing from the
// server that serves it.
//
// **Where it runs is the build's choice, not the program's.** In a worker by default, so a program
// that computes for a long time costs its own responsiveness and not the tab's; on the page's own
// thread with `--in-page`. Nothing here can tell: every change goes out through the `Dom` and nothing
// the program asks for is answered during the call that asked, which is why `getValue` is waited for.
//
// **The host is small and has no decisions in it.** It supplies a `Dom` — a struct of functions that
// send changes to the document — and forwards each event, timer, file and value to `deliver`,
// `timerFired`, `fileArrived` and `valueArrived`. Everything else, including the waiting, is here.
//
// **Waiting resumes at once.** The program runs with this page as its schedule target (spec ch35) —
// when it starts and each time the host calls in — so each machine that suspends hands its
// continuation to `take`, which attaches it to the ticket it waits on. When the host delivers an
// event, settling the ticket runs the program on, right there, until it waits again.
//
// **Several things at once is `Ticket.any`.** An animation waits for whichever comes first, the next
// frame or the next click — `await Ticket.any(frame, click);` — and then asks each ticket whether it
// has settled. Each ticket is the program's until it settles, so asking for the next event while one
// is still outstanding queues a second waiter rather than replacing the first.

import { Continuation, Queue, Ticket, TicketBase, Vec } from "core";
import { Sys } from "std";
import { Answer, System, World } from "./system.wac";
import { Node, htmlOf } from "./html.wac";
import { Element, ElementOps, Elements } from "./element.wac";
import { Ui, View } from "./view.wac";

// The tree, its tags, the handles and the view are this package's too, so a page imports everything from
// `"web"` (`design/system/0012`).
export { Attr, Node, On, htmlOf, isVoidElement } from "./html.wac";
export * as html from "./tags.wac";
export { Element, ElementEvent, ElementOps, Listen } from "./element.wac";
export { Mounted, Ref, State, Ui, View } from "./view.wac";
export { TestDoc, TestNode } from "./testdoc.wac";

// A page's system — `page.sys` — is `system.wac`, exported from here because a package is one module.
export { Answer, Answers, Process, READ_DATA, READ_END, READ_FAILED, STAT_DIR, STAT_EXISTS, STAT_FILE, System, World,
         processAnswered } from "./system.wac";

/** Something that happened on the page. */
export struct Event {
  /** What was listened for: `"click"`, `"input"`, `"keydown"`, `"pointerdown"`, `"pointermove"`… */
  string kind;
  /** The `id` of the element it happened to, or `""` when it has none. */
  string id;
  /** The element's value for `input` and `change`; the key for `keydown`, as the browser names it. */
  string value;
  /**
   * Where in the element it happened, for a pointer: in the element's own pixels — a canvas's are its
   * backing store, so a `<canvas width="480">` shown at any size answers 0 to 479. 0 otherwise.
   */
  i32 x;
  i32 y;
  /**
   * The modifier keys held when it happened, as `MOD_*` bits — `(e.mods & MOD_CTRL) != 0` is `^C`
   * when `value` is `"c"`. 0 for an event no key or pointer caused.
   */
  i32 mods;
}

/** `Event.mods`: which modifier keys were held. */
export static i32 MOD_SHIFT = 1;
export static i32 MOD_CTRL = 2;
export static i32 MOD_ALT = 4;
export static i32 MOD_META = 8;

/** A file the user handed over — chosen with an `<input type="file">`, or dropped on the page. */
export struct Picked {
  bool ok;
  string name;
  u8[] bytes;
  /** Why it could not be read, when `ok` is false. */
  string error;
}

/**
 * What the browser does for a page, supplied by the host. Every one happens at once and answers at
 * once; nothing here waits.
 */
export struct Dom {
  /** The handles' operations: make, change and remove elements, and listen to them (`element.wac`). */
  ElementOps elements;
  /** Replace the application's markup with this HTML. Only `Page.render` calls it, with escaped text. */
  fn<void(string)> render;
  /** Replace one element's content with this HTML, by id. Only `Page.renderInto` calls it. */
  fn<void(string, string)> renderInto;
  /** Set an element's text, by id — text, not markup. */
  fn<void(string, string)> setText;
  /** Set an input's value, by id. */
  fn<void(string, string)> setValue;
  /** Replace an element's inline style, by id. */
  fn<void(string, string)> setStyle;
  /**
   * Ask for an input's value, by id, and answer with `valueArrived(req, value)` — `""` when there is no
   * such element. Asked rather than read, because a program in a worker cannot read the document.
   */
  fn<void(i32, string)> getValue;
  /** Deliver events of a kind on elements matching a selector — delegated, so they survive `render`. */
  fn<void(string, string)> listen;
  /** The document's title. */
  fn<void(string)> title;
  /** A line for the console. */
  fn<void(string)> log;
  /** Milliseconds, from a clock that only goes forward. */
  fn<f64()> now;
  /** Call `timerFired(id)` after `ms` milliseconds. */
  fn<void(i32, i32)> timer;
  /** Call `timerFired(id)` before the browser next paints. */
  fn<void(i32)> frame;
  /** Size the canvas `id` to `w` by `h` and fill it with `w * h * 4` bytes of RGBA. */
  fn<void(string, i32, i32, u8[])> drawPixels;
  /** Write a `w` by `h` block of RGBA into the canvas `id` at `x`, `y`, leaving its size alone. */
  fn<void(string, i32, i32, i32, i32, u8[])> drawPixelsIn;
  /** Offer bytes to the user as a file to save, under a name. */
  fn<void(string, u8[])> download;

  /**
   * A document that does nothing: every change is dropped, every read answers empty, and no timer
   * ever fires. For a test, which replaces the functions it wants to watch —
   * `Dom d = Dom.inert(); d.setText = (string id, string t) => { … };` — rather than writing all of them.
   */
  Dom inert() {
    return Dom(
      ElementOps.inert(),
      (string html) => { }, (string id, string html) => { }, (string id, string text) => { },
      (string id, string value) => { }, (string id, string style) => { }, (i32 req, string id) => { },
      (string selector, string kind) => { }, (string t) => { }, (string line) => { }, () => 0.0,
      (i32 id, i32 ms) => { }, (i32 id) => { }, (string id, i32 w, i32 h, u8[] rgba) => { },
      (string id, i32 x, i32 y, i32 w, i32 h, u8[] rgba) => { }, (string name, u8[] bytes) => { }
    );
  }
}

/** A page: what the program is handed. */
export struct Page {
  Dom dom;
  /** Events that arrived while nothing was waiting, oldest first. */
  Queue<Event> arrived;
  /** Tickets `nextEvent` handed out and no event has settled yet, oldest first. */
  Queue<Ticket<Event>> waiting;
  /** Files handed over while nothing was waiting, and the tickets waiting for one. */
  Queue<Picked> files;
  Queue<Ticket<Picked>> wantsFile;
  /** Each timer's ticket, by id, until it fires. */
  Slots<f64> timers;
  /** Each `getValue`'s ticket, by request, until its answer arrives. */
  Slots<string> asked;
  /** Where the program's suspended machines wait, and how they are run on. */
  Runner runner;
  /** Every handle the program holds, the root among them. */
  Elements es;
  /** The views mounted, rendered at the end of every call into the program. */
  Vec<View> views;
  /**
   * **What the build granted** (`design/system/0012`): the files, clock, randomness and output a page's
   * program has, as a `Sys` like the one a command-line program is handed. `main` is always
   * `main(Page page)`; what this `Sys`'s `Cli` was not granted it refuses, naming the `--grant` that
   * would allow it. A page made in a test holds one that answers nothing, until the test sets its own.
   */
  Sys sys;

  Page create(Dom dom) {
    Queue<Event> arrived;
    Queue<Ticket<Event>> waiting;
    Queue<Picked> files;
    Queue<Ticket<Picked>> wantsFile;
    Vec<View> views = Vec.create();
    return Page(dom, arrived, waiting, files, wantsFile, Slots<f64>(Ticket<f64>?[]()), Slots<string>(Ticket<string>?[]()),
                Runner.create(), Elements.create(dom.elements), views, World.create(System.inert(), 0).sys);
  }

  /**
   * The page's root element: the authority over everything the program shows. Children made through it
   * come back as handles, and holding one is the right to change that element and hear its events.
   */
  Element root(this) { return this.es.root(); }

  /**
   * Render `draw` into the root and keep it rendered: a component of no attributes, whose state and whose
   * children's state the view watches (`view.wac`). The view owns the root's children from here on.
   */
  View mount(this, fn<Node(Ui)> draw) { return this.mountIn(this.root(), draw); }

  /** The same, into one element the program holds — a widget's own corner of the page. */
  View mountIn(this, Element host, fn<Node(Ui)> draw) {
    Page page = this;
    View v = View.create(host, (i32 ms, fn<void()> f) => { page.sleep(ms).whenSettled(f); });
    this.views.push(v);
    v.mount(draw);
    return v;
  }

  /** The end of a call into the program: every view renders what changed. */
  void turn(this) {
    for (i32 i = 0; i < this.views.len(); i++) { this.views.get(i).turn(); }
  }

  /** Replace what the page shows with `n`, escaped. */
  void render(this, Node n) { this.dom.render(htmlOf(n)); }

  /**
   * Replace what the element `id` holds with `n`, escaped — the rest of the page, an input being typed
   * into included, is left as it is.
   */
  void renderInto(this, string id, Node n) { this.dom.renderInto(id, htmlOf(n)); }

  void setText(this, string id, string text) { this.dom.setText(id, text); }
  void setValue(this, string id, string value) { this.dom.setValue(id, value); }
  void setStyle(this, string id, string style) { this.dom.setStyle(id, style); }
  /** An input's value, by id, waited for: `string v = await page.getValue("name");`. */
  Ticket<string> getValue(this, string id) {
    Ticket<string> t;
    this.dom.getValue(this.asked.add(t), id);
    return t;
  }
  void title(this, string t) { this.dom.title(t); }
  void log(this, string line) { this.dom.log(line); }
  f64 now(this) { return this.dom.now(); }

  /**
   * Fill the canvas `id` with a `w` by `h` picture, four bytes a pixel, sizing the canvas to match.
   * One call rather than a drawing API: anything a drawing API would do is a loop over bytes here.
   */
  void drawPixels(this, string id, i32 w, i32 h, u8[] rgba) {
    if (rgba.len() != w * h * 4) { trap "drawPixels: the buffer is not w * h * 4 bytes"; }
    this.dom.drawPixels(id, w, h, rgba);
  }

  /**
   * Write a `w` by `h` block into the canvas `id` at `x`, `y` — for a frame where little changed.
   * Leaves the canvas's size alone, since resizing a canvas clears it; `drawPixels` sets the size.
   */
  void drawPixelsIn(this, string id, i32 x, i32 y, i32 w, i32 h, u8[] rgba) {
    if (rgba.len() != w * h * 4) { trap "drawPixelsIn: the buffer is not w * h * 4 bytes"; }
    this.dom.drawPixelsIn(id, x, y, w, h, rgba);
  }

  /** Offer `bytes` to the user as a file called `name`. */
  void download(this, string name, u8[] bytes) { this.dom.download(name, bytes); }

  /** Deliver `kind` events on elements matching `selector` — `on("button", "click")`. */
  void on(this, string selector, string kind) { this.dom.listen(selector, kind); }

  /** The next event, waited for: `Event e = await page.nextEvent();`. */
  Ticket<Event> nextEvent(this) {
    Ticket<Event> t;
    Event? already = this.arrived.pop();
    if (already is not null) {
      t.resolve(already!);
      return t;
    }
    this.waiting.push(t);
    return t;
  }

  /** The next file the user hands over, waited for. One already handed over is not lost. */
  Ticket<Picked> nextFile(this) {
    Ticket<Picked> t;
    Picked? already = this.files.pop();
    if (already is not null) {
      t.resolve(already!);
      return t;
    }
    this.wantsFile.push(t);
    return t;
  }

  /** A ticket that settles after `ms` milliseconds, answering `now()` when it did. */
  Ticket<f64> sleep(this, i32 ms) {
    Ticket<f64> t;
    this.dom.timer(this.timers.add(t), ms);
    return t;
  }

  /** A ticket that settles before the browser next paints, answering `now()` — one per frame drawn. */
  Ticket<f64> nextFrame(this) {
    Ticket<f64> t;
    this.dom.frame(this.timers.add(t));
    return t;
  }

  /**
   * Settles once the browser has painted what the page shows now, answering `now()`. Before long work,
   * so a "reading…" note is on screen while it runs: on the page's own thread (`--in-page`) nothing is
   * painted while the program computes, and a frame callback runs *before* the paint it belongs to, so
   * the wait is a frame and then a timer. In a worker the page paints regardless, and this is a frame.
   */
  async f64 painted(this) {
    await this.nextFrame();
    return await this.sleep(0);
  }

  /** Where a suspended machine's continuation goes — see `Runner.take`. */
  void take(this, Continuation k) { this.runner.take(k); }

  /** Run what is ready, until nothing is. */
  void drain(this) { this.runner.drain(); }
}

/**
 * How a program that never blocks is run on: the schedule target its machines hand their
 * continuations to, and the queue of the ones with nothing to wait for. A page has one, and so does a
 * copy of it started by `spawnSelf`, which has no page.
 */
export struct Runner {
  /** Continuations with nothing to wait on — a bare `await;` — run before control goes back. */
  Queue<Continuation> ready;

  Runner create() {
    Queue<Continuation> ready;
    return Runner(ready);
  }

  /**
   * Where a suspended machine's continuation goes. A continuation waiting on a ticket runs when that
   * ticket settles; one waiting on nothing runs before control goes back to the browser.
   */
  void take(this, Continuation k) {
    TicketBase? on = k.t;
    if (on is null || on!.settled()) {
      this.ready.push(k);
      return;
    }
    on!.whenSettled(k.call);
  }

  /** Run what is ready, until nothing is. */
  void drain(this) {
    while (Continuation k matches this.ready.pop()) { k.call(); }
  }
}

// ── What the host calls ───────────────────────────────────────────────────────

// **Each runs the program under the page as its schedule target**, because this is where it resumes:
// a machine hands the continuation of its next wait to the target in force when it is resumed, and
// with none in force here the program's next wait would be dropped.

/** An event happened: settle the oldest ticket waiting for one, or keep it for the next `nextEvent`. */
export void deliver(Page page, string kind, string id, string value, i32 x, i32 y, i32 mods) {
  schedule page.take;
  Event e = Event(kind, id, value, x, y, mods);
  Ticket<Event>? w = page.waiting.pop();
  if (w is not null) {
    w!.resolve(e);
    page.drain();
    page.turn();
    return;
  }
  // **A `pointermove` is a position, not an occurrence.** Kept while nothing is waiting, a drag would
  // queue hundreds of them and the program would still be moving things long after the pointer
  // stopped. The newest says everything an older one did, so it replaces one for the same element
  // at the back of the queue; anything else is a thing that happened, and queues.
  i32 n = page.arrived.items.len();
  if (kind == "pointermove" && page.arrived.len() > 0) {
    Event last = page.arrived.items.get(n - 1);
    if (last.kind == "pointermove" && last.id == id) {
      page.arrived.items.set(n - 1, e);
      return;
    }
  }
  page.arrived.push(e);
}

/**
 * An event on an element the program holds: `kind` on handle `target`, heard by the listener on handle
 * `listener`, numbered `seq` (`element.wac`). Then the program runs on, and every view renders.
 */
export void elementEvent(Page page, i32 seq, string kind, i32 target, i32 listener, string value, i32 x, i32 y,
                         i32 mods) {
  schedule page.take;
  page.es.deliver(seq, kind, target, listener, value, x, y, mods);
  page.drain();
  page.turn();
}

/** The answer to `getValue` request `req`, or to an element's `value()`. One nobody is waiting for is dropped. */
export void valueArrived(Page page, i32 req, string value) {
  schedule page.take;
  if (req < 0) {
    page.es.answered(0 - req - 1, value);
    page.drain();
    page.turn();
    return;
  }
  Ticket<string>? t = page.asked.take(req);
  if (t is null) { return; }
  t!.resolve(value);
  page.drain();
  page.turn();
}

/**
 * The browser answered request `req` of the program's system — a file read, a directory listing, a
 * sleep. Settles the ticket the request was handed out as, and runs on whatever was waiting for it.
 */
export void answered(Page page, World world, i32 req, i32 fault, string text, u8[] bytes, i64 n, i64 m,
                     i32 flags) {
  schedule page.take;
  world.answers.arrive(req, Answer(fault, text, bytes, n, m, flags));
  page.drain();
  page.turn();
}

/** Timer `id` is due — a `sleep` or a `nextFrame`. */
export void timerFired(Page page, i32 id) {
  schedule page.take;
  Ticket<f64>? t = page.timers.take(id);
  if (t is null) { return; }
  t!.resolve(page.now());
  page.drain();
  page.turn();
}

/** The user handed over a file: settle the oldest ticket waiting for one, or keep it. */
export void fileArrived(Page page, bool ok, string name, u8[] bytes, string error) {
  schedule page.take;
  Picked f = Picked(ok, name, bytes, error);
  Ticket<Picked>? w = page.wantsFile.pop();
  if (w is null) {
    page.files.push(f);
    return;
  }
  w!.resolve(f);
  page.drain();
  page.turn();
}

/**
 * Tickets the host answers by number — timers, and the answers to `getValue`. Each waits in a slot
 * until the host calls back with its number, and the slot is free again once it has.
 */
struct Slots<T> {
  Ticket<T>?[] held;

  /** The number `t` waits under: a free slot, or a new one. */
  i32 add(this, Ticket<T> t) {
    for (i32 i = 0; i < this.held.len(); i++) {
      if (this.held[i] is null) {
        this.held[i] = t;
        return i;
      }
    }
    i32 id = this.held.len();
    Ticket<T>?[] more = Ticket<T>?[].defaulted(id + 1);
    for (i32 i = 0; i < id; i++) { more[i] = this.held[i]; }
    more[id] = t;
    this.held = more;
    return id;
  }

  /** The ticket waiting under `id`, freeing its slot — or null for a number nothing waits under. */
  Ticket<T>? take(this, i32 id) {
    if (id < 0 || id >= this.held.len()) { return null; }
    Ticket<T>? t = this.held[id];
    this.held[id] = null;
    return t;
  }
}

