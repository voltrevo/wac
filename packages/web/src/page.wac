// A web page, as a wac program sees it: `export async i32 main(Page page)`.
//
// **What a page shows is elements the program holds** (`design/system/0012`). `page.root()` is the
// handle to everything the program draws (`element.wac`), and `page.mount(draw)` puts a view over it —
// components that are functions of `Ui`, rendering only what changed (`view.wac`). What belongs to the
// page rather than to an element is here: its title, the clock, timers and frames, files the user hands
// over, a download, and `page.sys`, what the build granted.
//
// **The program is an `async` function, and nothing blocks.** It waits for what happens later — a timer,
// a frame, a file, an element's value, an event on an element it listens to — with `await`; each `await`
// hands control back, and the host calls back in when something arrives. Nothing is shared, so a built
// page needs nothing from the server that serves it.
//
// **Where it runs is the build's choice, not the program's.** In a worker by default, so a program
// that computes for a long time costs its own responsiveness and not the tab's; on the page's own
// thread with `--in-page`. Nothing here can tell: every change goes out through the `Dom` and nothing
// the program asks for is answered during the call that asked.
//
// **The host is small and has no decisions in it.** It supplies a `Dom` — a struct of functions that
// send changes to the document — and forwards each element event, timer, file and value to
// `elementEvent`, `timerFired`, `fileArrived` and `valueArrived`. Everything else, including the waiting,
// is here.
//
// **Waiting resumes at once.** The program runs with this page as its schedule target (spec ch35) —
// when it starts and each time the host calls in — so each machine that suspends hands its
// continuation to `take`, which attaches it to the ticket it waits on. When the host calls in, settling
// the ticket runs the program on, right there, until it waits again; then every view renders.

import { Continuation, Queue, Ticket, TicketBase, Vec } from "core";
import { Sys } from "std";
import { System, World } from "./system.wac";
import { Node, htmlOf } from "./html.wac";
import { Element, ElementOps, Elements } from "./element.wac";
import { Ui, View } from "./view.wac";

// The tree, its tags, the handles and the view are this package's too, so a page imports everything from
// `"web"` (`design/system/0012`).
export { Attr, Head, Node, On, documentOf, htmlOf, isVoidElement } from "./html.wac";
export * as html from "./tags.wac";
export { Element, ElementEvent, ElementOps, Listen } from "./element.wac";
export { Mounted, Ref, State, Ui, View } from "./view.wac";
export { TestDoc, TestNode } from "./testdoc.wac";

// A page's system — `page.sys` — is `system.wac`, exported from here because a package is one module.
export { Process, READ_DATA, READ_END, STAT_DIR, STAT_EXISTS, STAT_FILE, System, World, processAnswered } from "./system.wac";

/** `ElementEvent.mods`: which modifier keys were held. */
export static i32 MOD_SHIFT = 1;
export static i32 MOD_CTRL = 2;
export static i32 MOD_ALT = 4;
export static i32 MOD_META = 8;

/** A file the user handed over — chosen with an `<input type="file">`, or dropped on the page. */
export struct Picked {
  bool ok;
  /**
   * Its name — or, for a file inside a folder the user handed over, its path from that folder down:
   * `photos/2024/a.jpg`. A folder dropped on the page, or chosen with `<input type="file"
   * webkitdirectory>`, arrives as one `Picked` per file in it; the folder itself never arrives.
   */
  string name;
  u8[] bytes;
  /** Why it could not be read, when `ok` is false. */
  string error;
}

/**
 * What the browser does for a page, supplied by the host. Every one happens at once and answers at
 * once; nothing here waits.
 */
export struct Dom {
  /** The handles' operations: make, change and remove elements, and listen to them (`element.wac`). */
  ElementOps elements;
  /** The document's title. */
  fn<void(string)> title;
  /** A line for the console. */
  fn<void(string)> log;
  /** Milliseconds, from a clock that only goes forward. */
  fn<f64()> now;
  /** Call `timerFired(id)` after `ms` milliseconds. */
  fn<void(i32, i32)> timer;
  /** Call `timerFired(id)` before the browser next paints. */
  fn<void(i32)> frame;
  /** Offer bytes to the user as a file to save, under a name. */
  fn<void(string, u8[])> download;

  /**
   * A document that does nothing: every change is dropped, every read answers empty, and no timer
   * ever fires. For a test, which replaces the functions it wants to watch —
   * `Dom d = Dom.inert(); d.timer = (i32 id, i32 ms) => { … };` — rather than writing all of them.
   */
  Dom inert() {
    return Dom(
      ElementOps.inert(), (string t) => { }, (string line) => { }, () => 0.0, (i32 id, i32 ms) => { },
      (i32 id) => { }, (string name, u8[] bytes) => { }
    );
  }
}

/** A page: what the program is handed. */
export struct Page {
  Dom dom;
  /** Files handed over while nothing was waiting, and the tickets waiting for one. */
  Queue<Picked> files;
  Queue<Ticket<Picked>> wantsFile;
  /** Each timer's ticket, by id, until it fires. */
  Slots<f64> timers;
  /** Where the program's suspended machines wait, and how they are run on. */
  Runner runner;
  /** Every handle the program holds, the root among them. */
  Elements es;
  /** The views mounted, rendered at the end of every call into the program. */
  Vec<View> views;
  /**
   * **What the build granted** (`design/system/0012`): the files, clock, randomness and output a page's
   * program has, as a `Sys` like the one a command-line program is handed. `main` is always
   * `main(Page page)`; what this `Sys`'s `Cli` was not granted it refuses, naming the `--grant` that
   * would allow it. A page made in a test holds one that answers nothing, until the test sets its own.
   */
  Sys sys;
  /**
   * **A development build's check** (`--dev`): after every turn each view renders everything again and
   * logs each place the page does not show what its components render (`View.check`).
   */
  bool checking;
  /**
   * **Where the reader is**: the document's location hash, without its `#` — `"/spec/strings"` for
   * `…#/spec/strings`. The host says it before `main` runs and again each time it changes; a link
   * written `href="#/spec"` changes it, and so do the browser's back and forward.
   */
  string at;
  /** Who hears each change of `at`, by slot; a stopped watcher's slot is null. */
  Vec<fn<void(string)>?> watchers;

  Page create(Dom dom) {
    Queue<Picked> files;
    Queue<Ticket<Picked>> wantsFile;
    Vec<View> views = Vec.create();
    Vec<fn<void(string)>?> watchers = Vec.create();
    return Page(dom, files, wantsFile, Slots<f64>(Ticket<f64>?[]()), Runner.create(), Elements.create(dom.elements),
                views, World.create(System.inert(), 0).sys, false, "", watchers);
  }

  /**
   * The page's root element: the authority over everything the program shows. Children made through it
   * come back as handles, and holding one is the right to change that element and hear its events.
   */
  Element root(this) { return this.es.root(); }

  /**
   * Render `draw` into the root and keep it rendered: a component of no attributes, whose state and whose
   * children's state the view watches (`view.wac`). The view owns the root's children from here on.
   */
  View mount(this, fn<Node(Ui)> draw) { return this.mountIn(this.root(), draw); }

  /** The same, into one element the program holds — a widget's own corner of the page. */
  View mountIn(this, Element host, fn<Node(Ui)> draw) {
    Page page = this;
    View v = View.create(host, (i32 ms, fn<void()> f) => { page.sleep(ms).whenSettled(f); });
    this.views.push(v);
    v.mount(draw);
    return v;
  }

  /** The end of a call into the program: every view renders what changed. */
  void turn(this) {
    for (i32 i = 0; i < this.views.len(); i++) { this.views.get(i).turn(); }
    if (!this.checking) { return; }
    for (i32 i = 0; i < this.views.len(); i++) {
      string[] said = this.views.get(i).check();
      for (i32 j = 0; j < said.len(); j++) { this.dom.log("view check: " + said[j]); }
    }
  }

  /** The location hash, without its `#`: empty when there is none. */
  string location(this) { return this.at; }

  /**
   * Call `f` with each new location from here on; answers what stops it. A component follows the
   * location with a state and an effect whose cleanup is that answer:
   * `ui.effect("", () => page.onLocation((string where) => { at.set(where); }))`.
   */
  fn<void()> onLocation(this, fn<void(string)> f) {
    i32 slot = this.watchers.len();
    this.watchers.push(f);
    Vec<fn<void(string)>?> ws = this.watchers;
    return () => { ws.set(slot, null); };
  }

  void title(this, string t) { this.dom.title(t); }
  void log(this, string line) { this.dom.log(line); }
  f64 now(this) { return this.dom.now(); }

  /** Offer `bytes` to the user as a file called `name`. */
  void download(this, string name, u8[] bytes) { this.dom.download(name, bytes); }

  /** The next file the user hands over, waited for. One already handed over is not lost. */
  Ticket<Picked> nextFile(this) {
    Ticket<Picked> t;
    Picked? already = this.files.pop();
    if (already is not null) {
      t.resolve(already!);
      return t;
    }
    this.wantsFile.push(t);
    return t;
  }

  /** A ticket that settles after `ms` milliseconds, answering `now()` when it did. */
  Ticket<f64> sleep(this, i32 ms) {
    Ticket<f64> t;
    this.dom.timer(this.timers.add(t), ms);
    return t;
  }

  /** A ticket that settles before the browser next paints, answering `now()` — one per frame drawn. */
  Ticket<f64> nextFrame(this) {
    Ticket<f64> t;
    this.dom.frame(this.timers.add(t));
    return t;
  }

  /**
   * Settles once the browser has painted what the page shows now, answering `now()`. Before long work,
   * so a "reading…" note is on screen while it runs: on the page's own thread (`--in-page`) nothing is
   * painted while the program computes, and a frame callback runs *before* the paint it belongs to, so
   * the wait is a frame and then a timer. In a worker the page paints regardless, and this is a frame.
   */
  async f64 painted(this) {
    await this.nextFrame();
    return await this.sleep(0);
  }

  /** Where a suspended machine's continuation goes — see `Runner.take`. */
  void take(this, Continuation k) { this.runner.take(k); }

  /** Run what is ready, until nothing is. */
  void drain(this) { this.runner.drain(); }
}

/**
 * How a program that never blocks is run on: the schedule target its machines hand their
 * continuations to, and the queue of the ones with nothing to wait for. A page has one, and so does a
 * copy of it started by `spawnSelf`, which has no page.
 */
export struct Runner {
  /** Continuations with nothing to wait on — a bare `await;` — run before control goes back. */
  Queue<Continuation> ready;

  Runner create() {
    Queue<Continuation> ready;
    return Runner(ready);
  }

  /**
   * Where a suspended machine's continuation goes. A continuation waiting on a ticket runs when that
   * ticket settles; one waiting on nothing runs before control goes back to the browser.
   */
  void take(this, Continuation k) {
    TicketBase? on = k.t;
    if (on is null || on!.settled()) {
      this.ready.push(k);
      return;
    }
    on!.whenSettled(k.call);
  }

  /** Run what is ready, until nothing is. */
  void drain(this) {
    while (Continuation k matches this.ready.pop()) { k.call(); }
  }
}

// ── What the host calls ───────────────────────────────────────────────────────

// **Each runs the program under the page as its schedule target**, because this is where it resumes:
// a machine hands the continuation of its next wait to the target in force when it is resumed, and
// with none in force here the program's next wait would be dropped.

/**
 * An event on an element the program holds: `kind` on handle `target`, heard by the listener on handle
 * `listener`, numbered `seq` (`element.wac`). Then the program runs on, and every view renders.
 */
export void elementEvent(Page page, i32 seq, string kind, i32 target, i32 listener, string value, i32 x, i32 y,
                         i32 mods) {
  schedule page.take;
  page.es.deliver(seq, kind, target, listener, value, x, y, mods);
  page.drain();
  page.turn();
}

/**
 * The document's location hash is `hash` — before `main` runs, and on every change after. The `#` is
 * dropped if it is there. Each watcher hears it, then the program runs on, and every view renders.
 */
export void located(Page page, string hash) {
  schedule page.take;
  page.at = hash.len() > 0 && hash[0] == "#" ? hash.slice(1, hash.len()) : hash;
  for (i32 i = 0; i < page.watchers.len(); i++) {
    fn<void(string)>? w = page.watchers.get(i);
    if (w is not null) { w!(page.at); }
  }
  page.drain();
  page.turn();
}

/** The answer to an element's `value()`, request `req`. One nobody is waiting for is dropped. */
export void valueArrived(Page page, i32 req, string value) {
  schedule page.take;
  page.es.answered(req, value);
  page.drain();
  page.turn();
}

/**
 * The browser answered request `req` of the program's system — a file read, a directory listing, a
 * sleep. Settles the ticket the request was handed out as, and runs on whatever was waiting for it — unless the
 * answer came from inside the request that asked, which is still running.
 */
export void answered(Page page, World world, i32 req, i32 fault, string text, u8[] bytes, i64 n, i64 m,
                     i32 flags) {
  schedule page.take;
  if (!world.deliver(req, fault, text, bytes, n, m, flags)) { return; }
  page.drain();
  page.turn();
}

/** Timer `id` is due — a `sleep` or a `nextFrame`. */
export void timerFired(Page page, i32 id) {
  schedule page.take;
  Ticket<f64>? t = page.timers.take(id);
  if (t is null) { return; }
  t!.resolve(page.now());
  page.drain();
  page.turn();
}

/** The user handed over a file: settle the oldest ticket waiting for one, or keep it. */
export void fileArrived(Page page, bool ok, string name, u8[] bytes, string error) {
  schedule page.take;
  Picked f = Picked(ok, name, bytes, error);
  Ticket<Picked>? w = page.wantsFile.pop();
  if (w is null) {
    page.files.push(f);
    return;
  }
  w!.resolve(f);
  page.drain();
  page.turn();
}

/**
 * Tickets the host answers by number — timers. Each waits in a slot
 * until the host calls back with its number, and the slot is free again once it has.
 */
struct Slots<T> {
  Ticket<T>?[] held;

  /** The number `t` waits under: a free slot, or a new one. */
  i32 add(this, Ticket<T> t) {
    for (i32 i = 0; i < this.held.len(); i++) {
      if (this.held[i] is null) {
        this.held[i] = t;
        return i;
      }
    }
    i32 id = this.held.len();
    Ticket<T>?[] more = Ticket<T>?[].defaulted(id + 1);
    more.copyFrom(this.held, 0, 0, id);
    more[id] = t;
    this.held = more;
    return id;
  }

  /** The ticket waiting under `id`, freeing its slot — or null for a number nothing waits under. */
  Ticket<T>? take(this, i32 id) {
    if (id < 0 || id >= this.held.len()) { return null; }
    Ticket<T>? t = this.held[id];
    this.held[id] = null;
    return t;
  }
}

