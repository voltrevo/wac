// A program's system, in a page: `page.sys`.
//
// **The same `Sys` a program on a command line is handed**, over the same host call: the page serves the
// numbered requests of design/system/0013 step 6 from what a browser offers -- the Origin Private File System for
// files, the clock, randomness, and the console for output. A page asks for it by being built with grants --
// `--grant read,write` -- as `wac run` is asked with `--allow-...`, and what it was not granted is refused here,
// saying which grant would allow it.
//
// **Nothing here waits.** A browser answers a file read later, and neither a worker without shared memory nor the
// page's own thread may block until it does. So the browser answers each request through `answered` with the
// request's number when the work is done, and that settles the ticket and runs whatever was waiting on it. A
// program writes `await sys.files().readFile(p)`, and the same line works on a command line, where the host is
// waited for instead. A wait that would block answers `HOST_CANNOT_WAIT` rather than blocking.
//
// **The browser's side is small and decides nothing.** It does the operation it was asked for and answers in one
// shape; which requests a page refuses, and in which words, are decided here, where they are tested without a
// browser.

import { FAULT_NOT_GRANTED, FAULT_UNSUPPORTED, GRANT_READ, GRANT_WRITE, HOST_CANNOT_WAIT, OP_BIND_DATAGRAM, OP_CALL,
         OP_CHMOD, OP_CLOSE_OUTPUT, OP_CONNECT, OP_ACCEPT, OP_ENV, OP_EXEC, OP_LINK_STAT, OP_LISTEN, OP_LOAD,
         OP_MKDIR, OP_OPEN_FILE, OP_READ_DIR, OP_READ_FILE, OP_READ_STDIN, OP_RECEIVE_FROM, OP_REMOVE, OP_RENAME,
         OP_SEND_TO, OP_SET_EXECUTABLE, OP_SPAWN, OP_SPAWN_SELF, OP_STAT, OP_UNLOAD, OP_VALIDATE, OP_WRITE_FILE,
         OP_WRITE_STDERR, OP_WRITE_STDOUT, Sys, __WacHost, answered, faultWords } from "std";
import { Ticket } from "core";
import { Runner } from "./page.wac";

/**
 * What the browser does for a program's system, supplied by the host: `request` as std's `__WacHost` takes it,
 * answered through `answered(..., id, ...)` -- at once for what the browser knows (the clock, the arguments, the
 * working directory), later for what it has to go and do.
 */
export struct System {
  /** `request(op, id, a, b, text, bytes)`, `OP_*` numbered; `id` 0 wants no answer. */
  fn<void(i32, i32, i64, i64, string, u8[])> request;
  /** The program ended with this status. */
  fn<void(i32)> exit;

  /** A browser that does nothing: no request is ever answered. For a test, which replaces what it watches. */
  System inert() {
    return System((i32 op, i32 id, i64 a, i64 b, string text, u8[] bytes) => { }, (i32 code) => { });
  }
}

/** `flags` for a read: what arrived. */
export static i32 READ_DATA = 0;
export static i32 READ_END = 1;

/** `flags` for a `stat`: which of these the path is. */
export static i32 STAT_EXISTS = 1;
export static i32 STAT_FILE = 2;
export static i32 STAT_DIR = 4;

/** What a refusal says: the fault's own words, and the grant the page was built without. */
string notGranted(string grant) { return faultWords(FAULT_NOT_GRANTED()) + ": the page was built without `--grant " + grant + "`"; }

/** Why a page will not do `op`, or `""` when it will: a grant it was built without, or a thing a browser cannot do. */
string refusal(i32 op, i64 a, i32 grants) {
  bool read = (grants & GRANT_READ) != 0;
  bool write = (grants & GRANT_WRITE) != 0;
  if (op == OP_READ_FILE() || op == OP_STAT() || op == OP_LINK_STAT() || op == OP_READ_DIR()
      || (op == OP_OPEN_FILE() && a == 0 as i64)) {
    return read ? "" : notGranted("read");
  }
  if (op == OP_WRITE_FILE() || op == OP_MKDIR() || op == OP_REMOVE() || op == OP_RENAME() || op == OP_OPEN_FILE()
      || op == OP_SET_EXECUTABLE() || op == OP_CHMOD()) {
    return write ? "" : notGranted("write");
  }
  return "";
}

/** What a browser cannot do at all, granted or not -- saying what, because `FAULT_UNSUPPORTED` has no words of its own. */
string unsupported(i32 op) {
  if (op == OP_SET_EXECUTABLE()) { return "the browser's storage has no executable bit"; }
  if (op == OP_CHMOD()) { return "the browser's storage has no mode bits"; }
  if (op == OP_CONNECT() || op == OP_LISTEN() || op == OP_ACCEPT() || op == OP_BIND_DATAGRAM()
      || op == OP_RECEIVE_FROM() || op == OP_SEND_TO()) {
    return "a page has no sockets";
  }
  if (op == OP_EXEC()) { return "a page cannot run a host program"; }
  if (op == OP_LOAD() || op == OP_CALL() || op == OP_UNLOAD() || op == OP_VALIDATE()) { return "a page cannot do this"; }
  return "";
}

/** What `World`'s request hands the browser, and what it answers itself. */
struct PageLine {
  System system;
  i32 grants;
  /** Inside `request`: an answer arriving now is the call's own, and runs nothing on. */
  bool asking;
  /** `closeOutput` ends a stream for this program: a page's console has no end to give, so later writes are refused. */
  bool[] closed;
  __WacHost? host;
}

void pageRequest(PageLine line, i32 op, i32 id, i64 a, i64 b, string text, u8[] bytes) {
  __WacHost h = line.host!;
  string why = refusal(op, a, line.grants);
  if (why != "") {
    answered(h, id, FAULT_NOT_GRANTED(), why, u8[](), 0 as i64, 0 as i64, 0);
    return;
  }
  string cannot = unsupported(op);
  if (cannot != "") {
    answered(h, id, FAULT_UNSUPPORTED(), cannot, u8[](), 0 as i64, 0 as i64, 0);
    return;
  }
  // No environment and no standard input to read whole: a page has neither, and says so as "unset" and "empty".
  if (op == OP_ENV()) {
    answered(h, id, 0, "", u8[](), 0 as i64, 0 as i64, 0);
    return;
  }
  if (op == OP_READ_STDIN()) {
    answered(h, id, 0, "", u8[](), 0 as i64, 0 as i64, 0);
    return;
  }
  if (op == OP_CLOSE_OUTPUT()) {
    line.closed[a == 0 as i64 ? 0 : 1] = true;
    answered(h, id, 0, "", u8[](), 0 as i64, 0 as i64, 0);
    return;
  }
  if ((op == OP_WRITE_STDOUT() && line.closed[0]) || (op == OP_WRITE_STDERR() && line.closed[1])) {
    answered(h, id, 5, "", u8[](), 0 as i64, 0 as i64, 0);
    return;
  }
  // **No grant, and none kept**, as on a command line: what is started is this program again, or a module this
  // program holds (design/system/0015), and what it may do is what it is given -- never more than this holds.
  i64 asked = op == OP_SPAWN_SELF() || op == OP_SPAWN() ? a & (line.grants as i64) : a;
  line.asking = true;
  line.system.request(op, id, asked, b, text, bytes);
  line.asking = false;
}

/** A program's world in a page: the host its requests go to, and the `Sys` its `main` is handed. */
export struct World {
  __WacHost host;
  Sys sys;
  PageLine line;

  /** The world `system` provides, holding `grants` (`GRANT_*` bits) and nothing more. */
  World create(System system, i32 grants) {
    PageLine line = PageLine(system, grants, false, bool[].filled(2, false), null);
    __WacHost h = __WacHost.of(
      (i32 op, i32 id, i64 a, i64 b, string text, u8[] bytes) => { pageRequest(line, op, id, a, b, text, bytes); },
      // **Which of these has answered, never waiting for one to**: an answer reaches the program the moment the
      // browser gives it, so nothing is ever waiting to be collected, and a wait that would block cannot.
      (i32[] ids, i32 millis) => millis == 0 ? 0 - 1 : HOST_CANNOT_WAIT(),
      system.exit,
      () => false);
    line.host = h;
    return World(h, Sys.__wacOn(h), line);
  }

  /**
   * The browser answered request `req`: settle it. Whether to run on is the caller's -- `false` when the answer
   * came from inside the request that asked, which has not returned yet.
   */
  bool deliver(this, i32 req, i32 fault, string text, u8[] bytes, i64 n, i64 m, i32 flags) {
    answered(this.host, req, fault, text, bytes, n, m, flags);
    return !this.line.asking;
  }
}

/**
 * A copy of a page started by `spawnSelf`: no document, a `Sys`, and an exit status once its program is done --
 * which is what the copy is, a process, run by the same means as a page.
 */
export struct Process {
  Runner runner;
  World world;
  System system;
  Ticket<i32>? done;
  bool exited;

  /** A process holding `grants`, made under its own runner so that is where its program resumes. */
  Process create(System system, i32 grants) {
    Runner r = Runner.create();
    schedule r.take;
    return Process(r, World.create(system, grants), system, null, false);
  }

  /** The program's ticket, once started: settling it is the process ending. */
  void started(this, Ticket<i32> t) {
    this.done = t;
    this.runner.drain();
    this.settle();
  }

  /** Say the status once the program is done, and only once. */
  void settle(this) {
    if (this.exited) { return; }
    Ticket<i32>? d = this.done;
    if (d is null || !d!.settled()) { return; }
    this.exited = true;
    this.system.exit(d!.value());
  }
}

/** The browser answered request `req` of a process's system: settle it, run on, and end if that was the last of it. */
export void processAnswered(Process p, i32 req, i32 fault, string text, u8[] bytes, i64 n, i64 m, i32 flags) {
  schedule p.runner.take;
  if (!p.world.deliver(req, fault, text, bytes, n, m, flags)) { return; }
  p.runner.drain();
  p.settle();
}
