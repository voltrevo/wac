// The HTML tag functions: one per element, each answering `Node.Element` with its own name, an `Attr` per
// attribute written, an `On` per handler, and its children as `kids`. The package exports this module as
// the namespace `html`, so `<p class="hi">` is `html.p(class: "hi", kids: [])` once `html.p` is imported,
// and an attribute left out is `null` here and absent from the element.
//
// Every element takes the same attributes, the common ones: a list written per element would be a list
// nobody has decided yet, and a uniform one is easy to widen. A name outside it is written with a quoted
// tag, `<"div" aria-label="…">`, which takes any. `key` names a node among its siblings for the view and is
// never sent; `ref` is a `Ref` the view points at the element it makes (`view.wac`); `prevent` lists the
// defaults the document prevents for this element's handlers — `"Tab ArrowUp"` for keys, `"*"` for every
// event (`element.wac`'s `Listen`).
//
// The functions differ only in their names: a change to the lists in `element` is a change to every one.

import { Attr, Node, On } from "./html.wac";
import { ElementEvent } from "./element.wac";
import { Ref } from "./view.wac";

/**
 * An element named `tag`: an `Attr` for each attribute given and for `key`, and an `On` for each handler
 * given — what every tag function builds.
 */
Node element(string tag, Node[] kids, string?[] values, string? key, string? prevent, Ref? ref,
             fn<void(ElementEvent)>?[] handlers) {
  string[] names = ["class", "id", "style", "title", "lang", "role", "href", "src", "alt", "type", "name", "value", "for", "placeholder", "rel", "target", "width", "height", "action", "method", "content", "charset", "disabled", "checked", "accept", "spellcheck", "rows", "cols", "tabindex", "autocomplete", "autofocus", "multiple", "download", "readonly", "selected", "min", "max", "step", "maxlength"];
  string[] kinds = ["click", "dblclick", "input", "change", "keydown", "keyup", "submit", "focus", "blur", "pointerdown", "pointermove", "pointerup", "wheel", "scroll", "contextmenu"];
  i32 n = key is null ? 0 : 1;
  for (i32 i = 0; i < values.len(); i++) { if (values[i] is not null) { n++; } }
  Attr[] attrs = Attr[].filled(n, Attr("", ""));
  i32 at = 0;
  if (key is not null) {
    attrs[0] = Attr("key", key!);
    at = 1;
  }
  for (i32 i = 0; i < values.len(); i++) {
    if (values[i] is null) { continue; }
    attrs[at] = Attr(names[i], values[i]!);
    at++;
  }
  i32 h = 0;
  for (i32 i = 0; i < handlers.len(); i++) { if (handlers[i] is not null) { h++; } }
  On[] on = On[].filled(h, On("", "", (ElementEvent e) => { }));
  i32 k = 0;
  for (i32 i = 0; i < handlers.len(); i++) {
    if (handlers[i] is null) { continue; }
    on[k] = On(kinds[i], prevent ?? "", handlers[i]!);
    k++;
  }
  return Node.Element(tag, attrs, on, kids, ref);
}

export Node a(Node[] kids, string? @"class", string? id, string? style, string? title, string? lang, string? role, string? href, string? src, string? alt, string? @"type", string? name, string? value, string? @"for", string? placeholder, string? rel, string? target, string? width, string? height, string? action, string? method, string? content, string? charset, string? disabled, string? checked, string? accept, string? spellcheck, string? rows, string? cols, string? tabindex, string? autocomplete, string? autofocus, string? multiple, string? download, string? readonly, string? selected, string? min, string? max, string? step, string? maxlength, string? key, string? prevent, Ref? ref, fn<void(ElementEvent)>? onclick, fn<void(ElementEvent)>? ondblclick, fn<void(ElementEvent)>? oninput, fn<void(ElementEvent)>? onchange, fn<void(ElementEvent)>? onkeydown, fn<void(ElementEvent)>? onkeyup, fn<void(ElementEvent)>? onsubmit, fn<void(ElementEvent)>? onfocus, fn<void(ElementEvent)>? onblur, fn<void(ElementEvent)>? onpointerdown, fn<void(ElementEvent)>? onpointermove, fn<void(ElementEvent)>? onpointerup, fn<void(ElementEvent)>? onwheel, fn<void(ElementEvent)>? onscroll, fn<void(ElementEvent)>? oncontextmenu) {
  return element("a", kids, [@"class", id, style, title, lang, role, href, src, alt, @"type", name, value, @"for", placeholder, rel, target, width, height, action, method, content, charset, disabled, checked, accept, spellcheck, rows, cols, tabindex, autocomplete, autofocus, multiple, download, readonly, selected, min, max, step, maxlength], key, prevent, ref, [onclick, ondblclick, oninput, onchange, onkeydown, onkeyup, onsubmit, onfocus, onblur, onpointerdown, onpointermove, onpointerup, onwheel, onscroll, oncontextmenu]);
}

