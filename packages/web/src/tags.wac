// The HTML tag functions: one per element, each answering `Node.Element` with its own name, one `Attr` per
// attribute written and its children as `kids`. The package exports this module as the namespace `html`,
// so `<p class="hi">` is `html.p(class: "hi", kids: [])` once `html.p` is imported, and an attribute left
// out is `null` here and absent from the element.
//
// Every element takes the same attributes, the common ones: a list written per element would be a list
// nobody has decided yet, and a uniform one is easy to widen. A name outside it is written with a quoted
// tag, `<"div" aria-label="…">`, which takes any.

import { Attr, Node } from "./html.wac";

/**
 * An element named `tag`, with an `Attr` for each attribute given — what every `html` function builds.
 */
Node element(string tag, Node[] kids, string?[] values) {
  string[] names = ["class", "id", "style", "title", "lang", "role", "href", "src", "alt", "type", "name", "value", "for", "placeholder", "rel", "target", "width", "height", "action", "method", "content", "charset", "disabled", "checked", "accept", "spellcheck", "rows", "cols", "tabindex", "autocomplete", "autofocus", "multiple", "download", "readonly", "selected", "min", "max", "step", "maxlength"];
  i32 n = 0;
  for (i32 i = 0; i < values.len(); i++) { if (!(values[i] is null)) { n++; } }
  Attr[] attrs = Attr[].filled(n, Attr("", ""));
  i32 at = 0;
  for (i32 i = 0; i < values.len(); i++) {
    if (values[i] is null) { continue; }
    attrs[at] = Attr(names[i], values[i]!);
    at++;
  }
  return Node.Element(tag, attrs, kids);
}

export Node a(Node[] kids, string? class, string? id, string? style, string? title, string? lang, string? role, string? href, string? src, string? alt, string? @"type", string? name, string? value, string? @"for", string? placeholder, string? rel, string? target, string? width, string? height, string? action, string? method, string? content, string? charset, string? disabled, string? checked, string? accept, string? spellcheck, string? rows, string? cols, string? tabindex, string? autocomplete, string? autofocus, string? multiple, string? download, string? readonly, string? selected, string? min, string? max, string? step, string? maxlength) {
  return element("a", kids, [class, id, style, title, lang, role, href, src, alt, @"type", name, value, @"for", placeholder, rel, target, width, height, action, method, content, charset, disabled, checked, accept, spellcheck, rows, cols, tabindex, autocomplete, autofocus, multiple, download, readonly, selected, min, max, step, maxlength]);
}

