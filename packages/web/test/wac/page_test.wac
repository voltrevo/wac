// A page driven with no browser: a `Dom` made of lambdas that record what the program did, and the
// host's calls made by hand. What a browser adds is the document, and `packages/web/tools/build.wac`'s host is the
// whole of that — so what a program can ask of a page, and every order in which things can arrive, is
// tested here. The view over the elements is `view_test.wac`'s.

import { Check } from "./check.wac";
import { Ticket, Vec } from "core";
import { Dom, Element, ElementEvent, ElementOps, Listen, Node, Page, TestDoc, Ui, elementEvent, located, timerFired,
         valueArrived } from "../../src/page.wac";
import { html.button, html.p } from "../../src/page.wac";

/** What the fake document saw, as one line per call. */
struct Seen {
  string log;
  i32 timers;
}

Dom fakeDom(Seen seen) {
  ElementOps ops = ElementOps.inert();
  ops.make = (i32 id, i32 parent, string tag, i32 before) => { seen.log = seen.log + "make \{id} " + tag + "\n"; };
  ops.text = (i32 id, string text) => { seen.log = seen.log + "text \{id} " + text + "\n"; };
  ops.listen = (i32 id, string kind, string prevent) => { seen.log = seen.log + "listen \{id} " + kind + "\n"; };
  ops.value = (i32 req, i32 id) => { seen.log = seen.log + "ask \{req} \{id}\n"; };
  Dom d = Dom.inert();
  d.elements = ops;
  d.title = (string t) => { seen.log = seen.log + "title " + t + "\n"; };
  d.log = (string line) => { seen.log = seen.log + "log " + line + "\n"; };
  d.now = () => 1000.0;
  d.timer = (i32 id, i32 ms) => { seen.timers = seen.timers + 1; seen.log = seen.log + "timer \{id} \{ms}\n"; };
  d.frame = (i32 id) => { seen.timers = seen.timers + 1; seen.log = seen.log + "frame \{id}\n"; };
  return d;
}

/** The handle numbers this file's programs make, in the order they make them. */
i32 UP() { return 1; }
i32 QUIT() { return 2; }
i32 SHOWN() { return 3; }

async i32 clicks(Page page) {
  Element up = page.root().append("button");
  Element quit = page.root().append("button");
  Element shown = page.root().append("b");
  page.root().listen("click", Listen.none());
  i32 n = 0;
  while (true) {
    ElementEvent e = await page.root().next();
    if (e.target.id == UP()) {
      n += 1;
      shown.text("\{n}");
    }
    if (e.target.id == QUIT()) { return n; }
  }
}

Ticket<i32> startClicks(Page page) {
  schedule page.take;
  return clicks(page);
}

export string test_the_program_runs_until_it_waits_and_each_event_runs_it_on() {
  Check t = Check.create();
  Seen seen = Seen("", 0);
  Page page = Page.create(fakeDom(seen));
  Ticket<i32> done = startClicks(page);
  t.eqStr(seen.log, "make 1 button\nmake 2 button\nmake 3 b\nlisten 0 click\n", "it ran to its first wait");
  t.isFalse(done.settled(), "and is waiting");
  seen.log = "";
  elementEvent(page, 1, "click", UP(), 0, "", 0, 0, 0);
  elementEvent(page, 2, "click", SHOWN(), 0, "", 0, 0, 0);
  elementEvent(page, 3, "click", UP(), 0, "", 0, 0, 0);
  t.eqStr(seen.log, "text 3 1\ntext 3 2\n", "each click ran it on, there and then");
  elementEvent(page, 4, "click", QUIT(), 0, "", 0, 0, 0);
  t.isTrue(done.settled(), "quit finished it");
  t.eqI32(done.value(), 2, "with the count");
  return t.report();
}

async i32 early(Element listened) {
  // Events delivered before anything waits are kept, in order.
  ElementEvent a = await listened.next();
  ElementEvent b = await listened.next();
  return a.value.len() * 10 + b.value.len();
}

export string test_events_that_arrive_before_a_wait_are_kept_in_order() {
  Check t = Check.create();
  Seen seen = Seen("", 0);
  Page page = Page.create(fakeDom(seen));
  page.root().listen("input", Listen.none());
  elementEvent(page, 1, "input", 0, 0, "abc", 0, 0, 0);
  elementEvent(page, 2, "input", 0, 0, "de", 0, 0, 0);
  Ticket<i32> done = early(page.root());
  // Nothing was scheduled for these: both tickets were already settled.
  page.drain();
  t.isTrue(done.wait().isOk(), "it finished");
  t.eqI32(done.value(), 32, "a then b");
  return t.report();
}

async i32 sleeper(Page page) {
  page.log("before");
  f64 at = await page.sleep(250);
  page.log("after \{at as~ i32}");
  await page.sleep(10);
  return 7;
}

Ticket<i32> startSleeper(Page page) {
  schedule page.take;
  return sleeper(page);
}

export string test_a_sleep_waits_for_its_timer() {
  Check t = Check.create();
  Seen seen = Seen("", 0);
  Page page = Page.create(fakeDom(seen));
  Ticket<i32> done = startSleeper(page);
  t.eqStr(seen.log, "log before\ntimer 0 250\n", "it asked for a timer and waited");
  timerFired(page, 0);
  // The fired timer's slot is free again, so the next sleep reuses it.
  t.eqStr(seen.log, "log before\ntimer 0 250\nlog after 1000\ntimer 0 10\n",
          "the timer ran it on, answering the time it fired");
  timerFired(page, 3);
  t.isFalse(done.settled(), "a timer nobody asked for does nothing");
  timerFired(page, 0);
  t.isTrue(done.settled(), "the second timer finished it");
  t.eqI32(done.value(), 7, "with its answer");
  timerFired(page, 0);
  t.isTrue(done.settled(), "and a timer fires once");
  return t.report();
}

async i32 helper(Element listened) {
  ElementEvent e = await listened.next();
  return e.value.len();
}

async i32 nested(Element listened) {
  // A machine waiting on another machine waiting on an event: settling the event runs both.
  i32 a = await helper(listened);
  i32 b = await helper(listened);
  return a * 10 + b;
}

Ticket<i32> startNested(Page page) {
  schedule page.take;
  page.root().listen("input", Listen.none());
  return nested(page.root());
}

export string test_a_wait_on_a_wait_runs_on_through_both() {
  Check t = Check.create();
  Seen seen = Seen("", 0);
  Page page = Page.create(fakeDom(seen));
  Ticket<i32> done = startNested(page);
  elementEvent(page, 1, "input", 0, 0, "abcd", 0, 0, 0);
  t.isFalse(done.settled(), "one event in, one to go");
  elementEvent(page, 2, "input", 0, 0, "xy", 0, 0, 0);
  t.isTrue(done.settled(), "the second finished both");
  t.eqI32(done.value(), 42, "4 then 2");
  return t.report();
}

async i32 eventOrTick(Page page) {
  // The shape of an animation: whichever comes first, an event or the next frame.
  Element quit = page.root().append("button");
  page.root().listen("click", Listen.none());
  i32 ticks = 0;
  Ticket<ElementEvent> ev = page.root().next();
  Ticket<f64> tick = page.sleep(30);
  while (true) {
    await Ticket.any(ev, tick);
    if (tick.settled()) {
      ticks += 1;
      tick = page.sleep(30);
    }
    if (ev.settled()) {
      ElementEvent e = ev.value();
      if (e.target.id == quit.id) { return ticks; }
      ev = page.root().next();
    }
  }
}

Ticket<i32> startEventOrTick(Page page) {
  schedule page.take;
  return eventOrTick(page);
}

export string test_waiting_on_whichever_comes_first() {
  Check t = Check.create();
  Seen seen = Seen("", 0);
  Page page = Page.create(fakeDom(seen));
  Ticket<i32> done = startEventOrTick(page);
  t.eqI32(seen.timers, 1, "one frame asked for");
  timerFired(page, 0);
  t.eqI32(seen.timers, 2, "the frame ran it on, and it asked for the next");
  elementEvent(page, 1, "click", 0, 0, "", 0, 0, 0);
  t.eqI32(seen.timers, 2, "an event ran it on without a frame");
  timerFired(page, 0);
  elementEvent(page, 2, "click", 1, 0, "", 0, 0, 0);
  t.isTrue(done.settled(), "quit finished it");
  t.eqI32(done.value(), 2, "after two frames");
  return t.report();
}

async i32 bothArrived(Element listened) {
  (ElementEvent, ElementEvent) both = await Ticket.all(listened.next(), listened.next());
  return both.0.value.len() * 10 + both.1.value.len();
}

Ticket<i32> startBoth(Page page) {
  schedule page.take;
  page.root().listen("input", Listen.none());
  return bothArrived(page.root());
}

export string test_waiting_on_all_of_several() {
  Check t = Check.create();
  Seen seen = Seen("", 0);
  Page page = Page.create(fakeDom(seen));
  Ticket<i32> done = startBoth(page);
  elementEvent(page, 1, "input", 0, 0, "abc", 0, 0, 0);
  t.isFalse(done.settled(), "one of two");
  elementEvent(page, 2, "input", 0, 0, "de", 0, 0, 0);
  t.isTrue(done.settled(), "both");
  t.eqI32(done.value(), 32, "in order");
  return t.report();
}

async i32 asks(Page page) {
  Element what = page.root().append("input");
  Element who = page.root().append("input");
  string a = await what.value();
  string b = await who.value();
  return a.len() * 10 + b.len();
}

Ticket<i32> startAsks(Page page) {
  schedule page.take;
  return asks(page);
}

export string test_an_elements_value_is_waited_for() {
  Check t = Check.create();
  Seen seen = Seen("", 0);
  Page page = Page.create(fakeDom(seen));
  Ticket<i32> done = startAsks(page);
  t.eqStr(seen.log, "make 1 input\nmake 2 input\nask 0 1\n", "it asked, and waits for the answer");
  valueArrived(page, 0, "hello");
  t.eqStr(seen.log, "make 1 input\nmake 2 input\nask 0 1\nask 1 2\n", "the answer ran it on");
  valueArrived(page, 7, "stray");
  valueArrived(page, 0, "late");
  t.isFalse(done.settled(), "an answer nobody is waiting for is dropped");
  valueArrived(page, 1, "ab");
  t.isTrue(done.settled(), "both answered");
  t.eqI32(done.value(), 52, "in order");
  return t.report();
}

/** A count kept in a `Vec` and pushed to in place: the page does not follow, and a checking page says so. */
Node Tally(Ui ui) {
  auto seen = ui.state(Vec<i32>.create());
  return <p>{seen.get().len()}<button onclick={(ElementEvent e) => { seen.get().push(1); }}>+</button></p>;
}

export string test_a_checking_page_logs_what_its_view_does_not_show() {
  Check t = Check.create();
  Seen seen = Seen("", 0);
  Page page = Page.create(fakeDom(seen));
  page.checking = true;
  schedule page.take;
  page.mount((Ui ui) => <Tally/>);
  page.turn();
  t.isTrue(seen.log.indexOf("view check") < 0, "nothing to say at first: " + seen.log);
  // The button is the fourth handle: the root's `p`, its text, then the button.
  elementEvent(page, 1, "click", 3, 3, "", 0, 0, 0);
  t.isTrue(seen.log.indexOf("log view check: Tally renders the text \"1\" where the page shows \"0\"") >= 0,
           "the page logged the component whose state changed without a set: " + seen.log);
  return t.report();
}

/** The route a page shows, as a component follows it: the location when it mounted, then each change. */
Node Route(Ui ui, Page page) {
  auto at = ui.state(page.location());
  ui.effect("", () => page.onLocation((string where) => { at.set(where); }));
  return <p>{at.get()}</p>;
}

export string test_the_location_is_the_hash_the_host_said_and_each_change_reaches_who_watches() {
  Check t = Check.create();
  TestDoc doc = TestDoc.create();
  Page page = Page.create(doc.dom());
  doc.attach(page);
  located(page, "#/stack/oracles");
  t.eqStr(page.location(), "/stack/oracles", "without its #");
  schedule page.take;
  page.mount((Ui ui) => <Route page={page}/>);
  page.turn();
  t.eqStr(doc.shown(0), "/stack/oracles", "a component starts from it");
  string heard = "";
  fn<void()> stop = page.onLocation((string where) => { heard = heard + where + ";"; });
  located(page, "#/spec");
  t.eqStr(doc.shown(0), "/spec", "and renders again when it changes");
  stop();
  located(page, "");
  t.eqStr(heard, "/spec;", "a watcher stopped hears nothing more");
  t.eqStr(page.location(), "", "an empty hash is the empty location");
  t.eqStr(doc.shown(0), "", "the component heard that too");
  return t.report();
}

export string test_an_element_scrolls_itself_or_a_named_element_under_it_into_view() {
  Check t = Check.create();
  TestDoc doc = TestDoc.create();
  Page page = Page.create(doc.dom());
  doc.attach(page);
  Element box = page.root().append("div");
  page.root().scrollToId("oracles");
  t.eqStr(doc.scrolled, "0 oracles", "the element under the root with that id");
  box.scrollIntoView();
  t.eqStr(doc.scrolled, "1 ", "the element itself");
  return t.report();
}
