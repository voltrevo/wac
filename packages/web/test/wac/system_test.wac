// A page's system driven with no browser: a `System` that records what it was asked, and the
// answers a browser would give made by hand with `answered`. What a browser adds is the Origin Private
// File System, and `packages/web/tools/build.wac`'s system half is the whole of that — so what a program sees, in
// every order the answers can arrive, is tested here.

import { Check } from "./check.wac";
import { Buf, Ticket } from "core";
import { FAULT_NOT_FOUND, Files, GRANT_READ, GRANT_WRITE, OP_CLOSE_FILE, OP_MONOTONIC_NANOS, OP_OPEN_FILE,
         OP_READ_DIR, OP_READ_FILE, OP_RECV, OP_SEND, OP_SLEEP_MILLIS, OP_STAT, OP_WRITE_FILE, Stat, Sys } from "std";
import { Dom, Page, STAT_EXISTS, STAT_FILE, System, World, answered } from "../../src/page.wac";

/** The fake browser: what it was asked, one line per request, and the page it answers into. */
struct Browser {
  string log;
  Page page;
  World? world;
  /** Whether a parent serves this page files: the line to it exists only then, as in a real browser. */
  bool served;
}

string opName(i32 op) {
  if (op == OP_READ_FILE()) { return "read"; }
  if (op == OP_WRITE_FILE()) { return "write"; }
  if (op == OP_STAT()) { return "stat"; }
  if (op == OP_READ_DIR()) { return "dir"; }
  if (op == OP_SLEEP_MILLIS()) { return "sleep"; }
  if (op == OP_OPEN_FILE()) { return "open"; }
  if (op == OP_RECV()) { return "recv"; }
  if (op == OP_SEND()) { return "send"; }
  if (op == OP_CLOSE_FILE()) { return "close"; }
  return "op\{op}";
}

/**
 * A browser that answers what it knows at once — the clock, and a send to a parent nobody is — and records the
 * rest: `name id [text] a [+bytes]`.
 */
System recording(Browser b) {
  return System((i32 op, i32 id, i64 a, i64 n, string text, u8[] bytes) => {
    if (op == OP_MONOTONIC_NANOS()) {
      answered(b.page, b.world!, id, 0, "", u8[](), 42 as i64, 0 as i64, 0);
      return;
    }
    if (op == OP_SEND() && a == 1 as i64 && !b.served) {
      answered(b.page, b.world!, id, 5, "", u8[](), 0 as i64, 0 as i64, 0);
      return;
    }
    b.log = b.log + opName(op) + " \{id}" + (text == "" ? "" : " " + text) + " \{a}"
          + (bytes.len() > 0 ? " +\{bytes.len()}" : "") + "\n";
  }, (i32 code) => { });
}

/** A page over the fake browser, holding `grants`, with `page.sys` set as the build's wrapper sets it. */
World over(Browser b, i32 grants) {
  World w = World.create(recording(b), grants);
  b.world = w;
  b.page.sys = w.sys;
  return w;
}

/** Answer request `req` with bytes and no fault, as the browser would. */
void give(Page page, World w, i32 req, string text) {
  answered(page, w, req, 0, "", text.toBytes(), 0 as i64, 0 as i64, 0);
}

/** A page's program: what it may do is `page.sys`, as the build's wrapper sets it. */
async i32 copies(Page page) {
  Sys sys = page.sys;
  u8[] bytes = u8[]();
  match (await sys.readFile("in.txt")) {
    Ok(b): { bytes = b; }
    Err(why): { return 0 - 1; }
  }
  match (await sys.writeFile("out.txt", bytes)) {
    Ok(): { return bytes.len(); }
    Err(why): { return 0 - 2; }
  }
}

/** Run `copies` with the page as its schedule target, then drain — what the build's wrapper does. */
Ticket<i32> startCopies(Page page) {
  schedule page.take;
  Ticket<i32> t = copies(page);
  page.drain();
  return t;
}

export string test_a_read_waits_for_the_browser_and_the_answer_runs_it_on() {
  Check t = Check.create();
  Browser b = Browser("", Page.create(Dom.inert()), null, false);
  World w = over(b, GRANT_READ | GRANT_WRITE);
  Ticket<i32> done = startCopies(b.page);
  t.eqStr(b.log, "read 2 in.txt 0\n", "it asked, and waits");
  t.isFalse(done.settled(), "nothing has answered");
  give(b.page, w, 2, "hello");
  t.eqStr(b.log, "read 2 in.txt 0\nwrite 3 out.txt 0 +5\n", "the answer ran it on to the write");
  answered(b.page, w, 3, 0, "", u8[](), 0 as i64, 0 as i64, 0);
  t.isTrue(done.settled(), "the write's answer finished it");
  t.eqI32(done.value(), 5, "with what it read");
  return t.report();
}

export string test_a_missing_file_is_an_err_in_the_programs_words() {
  Check t = Check.create();
  Browser b = Browser("", Page.create(Dom.inert()), null, false);
  World w = over(b, GRANT_READ | GRANT_WRITE);
  Ticket<i32> done = startCopies(b.page);
  answered(b.page, w, 2, FAULT_NOT_FOUND(), "NotFoundError: A requested file or directory could not be found",
           u8[](), 0 as i64, 0 as i64, 0);
  t.isTrue(done.settled(), "a failed read finished it");
  t.eqI32(done.value(), 0 - 1, "as an Err");
  return t.report();
}

async string refusals(Sys sys) {
  string out = "";
  match (await sys.readFile("x")) {
    Ok(b): { out = "read went"; }
    Err(why): { out = why; }
  }
  match (await sys.writeFile("x", u8[]())) {
    Ok(): { return out + "|write went"; }
    Err(why): { return out + "|" + why; }
  }
}

export string test_what_the_page_was_not_granted_is_refused_without_asking() {
  Check t = Check.create();
  Browser b = Browser("", Page.create(Dom.inert()), null, false);
  World w = over(b, GRANT_READ);
  Ticket<i32> done = startCopies(b.page);
  give(b.page, w, 2, "hi");
  t.isTrue(done.settled(), "the write was refused at once");
  t.eqI32(done.value(), 0 - 2, "as an Err");
  t.eqStr(b.log, "read 2 in.txt 0\n", "and the browser was never asked to write");

  // Saying which grant the page was built without, which is the thing to change.
  Browser nb = Browser("", Page.create(Dom.inert()), null, false);
  World none = over(nb, 0);
  schedule nb.page.take;
  Ticket<string> said = refusals(none.sys);
  nb.page.drain();
  t.isTrue(said.settled(), "both refusals answered at once");
  t.eqStr(said.value(), "Not granted to this application: the page was built without `--grant read`|"
                        + "Not granted to this application: the page was built without `--grant write`",
          "each in the words of the grant it needs");
  t.eqStr(nb.log, "", "without asking the browser");
  return t.report();
}

async i32 clocked(Sys sys) {
  i64 a = await sys.monotonicNanos();
  await sys.sleepMillis(5);
  i64 b = await sys.monotonicNanos();
  return (a + b) as! i32;
}

export string test_what_the_browser_knows_settles_at_once_and_a_sleep_waits() {
  Check t = Check.create();
  Browser b = Browser("", Page.create(Dom.inert()), null, false);
  World w = over(b, 0);
  schedule b.page.take;
  Ticket<i32> done = clocked(w.sys);
  b.page.drain();
  t.eqStr(b.log, "sleep 2 5\n", "the clock answered inside its request, and the sleep asked");
  answered(b.page, w, 2, 0, "", u8[](), 7 as i64, 0 as i64, 0);
  t.isTrue(done.settled(), "the sleep's answer finished it");
  t.eqI32(done.value(), 84, "reading the clock twice");
  return t.report();
}

async string listed(Sys sys) {
  Files files = sys.files();
  string out = "";
  match (await files.readDir("/")) {
    Ok(names): { for (string n in names) { out = out + n + ","; } }
    Err(why): { return "none"; }
  }
  match (await files.stat("a")) {
    Ok(s): { return out + (s.isFile && !s.isDir ? " file \{s.size}" : " not a file"); }
    Err(why): { return out + " no stat"; }
  }
}

export string test_a_listing_and_a_stat_are_read_from_the_answer() {
  Check t = Check.create();
  Browser b = Browser("", Page.create(Dom.inert()), null, false);
  World w = over(b, GRANT_READ);
  schedule b.page.take;
  Ticket<string> done = listed(w.sys);
  b.page.drain();
  u8[] names = "a\0b c\0".toBytes();
  answered(b.page, w, 2, 0, "", names, 0 as i64, 0 as i64, 1);
  answered(b.page, w, 3, 0, "", u8[](), 12 as i64, 0 as i64, STAT_EXISTS | STAT_FILE);
  t.isTrue(done.settled(), "both answers finished it");
  t.eqStr(done.value(), "a,b c, file 12", "names split on NUL, spaces kept, and the stat's flags");
  return t.report();
}

async i32 readsOne(Sys sys) {
  match (await sys.readFile("x")) {
    Ok(b): { return b.len(); }
    Err(why): { return 0 - 1; }
  }
}

export string test_an_answer_nobody_asked_for_and_a_late_one_are_dropped() {
  Check t = Check.create();
  Browser b = Browser("", Page.create(Dom.inert()), null, false);
  World w = over(b, GRANT_READ);
  give(b.page, w, 99, "stray");
  t.eqI32(w.host.pending.len(), 0, "an answer to a request never made is not kept");
  // A read whose ticket is abandoned before the browser answers: the browser is told, and the late answer
  // settles nothing.
  auto read = w.sys.files().readFile("x");
  read.cancel();
  t.eqStr(b.log, "read 2 x 0\nop0 2 0\n", "the browser was told it was dropped");
  give(b.page, w, 2, "late");
  t.isFalse(read.settled(), "the late answer settled nothing");
  return t.report();
}

export string test_a_page_holds_a_system_before_the_build_gives_it_one() {
  Check t = Check.create();
  // `main` is `main(Page page)` whatever was granted, so a page has a `sys` from the start: one that
  // answers nothing and refuses what needs a grant, until the build's wrapper sets the browser's.
  Page page = Page.create(Dom.inert());
  schedule page.take;
  Ticket<i32> read = readsOne(page.sys);
  page.drain();
  t.isTrue(read.settled(), "a read is refused at once");
  t.eqI32(read.value(), 0 - 1, "as an Err");
  return t.report();
}

/** What a parent serving files answers the hello with: one frame, the greeting and who its files act as. */
u8[] servedAnswer(string user) {
  Buf body = Buf.create();
  for (string part in ["wac files 1", user]) {
    u8[] b = part.toBytes();
    body.pushU32(b.len() as@ u32);
    body.pushAll(b);
  }
  Buf framed = Buf.create();
  framed.pushU32(body.len as@ u32);
  framed.pushAll(body.bytes());
  return framed.bytes();
}

/** A spawned page program as the adapter starts it: greet the parent, then ask for the files. */
async string greetsThenAsks(Page page) {
  Sys sys = page.sys;
  await sys.__wacGreet();
  return sys.files().user;
}

/**
 * **A page program learns whether its parent serves it files without waiting.** It asked the first time `files()`
 * was called, and waited for the answer — which a page cannot do, so every applet the browser terminal spawned
 * trapped (`Uncaught RuntimeError: unreachable`, then `[exit 134]`). The adapter greets the parent before an `async`
 * `main` instead, and the answer runs it on.
 */
export string test_a_page_program_learns_it_is_served_without_waiting() {
  Check t = Check.create();
  Browser b = Browser("", Page.create(Dom.inert()), null, true);
  World w = over(b, GRANT_READ | GRANT_WRITE);
  schedule b.page.take;
  Ticket<string> user = greetsThenAsks(b.page);
  b.page.drain();
  t.eqStr(b.log, "send 1 1 +5\n", "it said hello, and waits");
  t.isFalse(user.settled(), "nothing has answered");
  answered(b.page, w, 1, 0, "", u8[](), 0 as i64, 0 as i64, 1);
  t.eqStr(b.log, "send 1 1 +5\nrecv 2 1\n", "the hello went, so it listens for the answer");
  answered(b.page, w, 2, 0, "", servedAnswer("ada"), 0 as i64, 0 as i64, 0);
  t.isTrue(user.settled(), "the answer ran it on");
  t.eqStr(user.value(), "ada", "and its files are the parent's, acting as the parent's user");
  return t.report();
}

/** `copies` again, through streams: what `cat f` and `echo x > f` do in a page's shell. */
async i32 streams(Page page) {
  await page.sys.__wacGreet();
  Files files = page.sys.files();
  u8[] bytes = u8[]();
  match (await files.openRead("in.txt")) {
    Ok(input): {
      match (await input.readAll()) {
        Ok(b): { bytes = b; }
        Err(why): { return 0 - 1; }
      }
      match (await input.close()) {
        Ok(): { }
        Err(why): { return 0 - 2; }
      }
    }
    Err(why): { return 0 - 3; }
  }
  match (await files.openWrite("out.txt")) {
    Ok(out): {
      match (await out.write(bytes)) {
        Ok(): { }
        Err(why): { return 0 - 4; }
      }
      match (await out.close()) {
        Ok(): { return bytes.len(); }
        Err(why): { return 0 - 5; }
      }
    }
    Err(why): { return 0 - 6; }
  }
}

export string test_a_page_opens_a_file_as_a_stream_to_read_and_to_write() {
  Check t = Check.create();
  Browser b = Browser("", Page.create(Dom.inert()), null, false);
  World w = over(b, GRANT_READ | GRANT_WRITE);
  schedule b.page.take;
  Ticket<i32> done = streams(b.page);
  b.page.drain();
  t.eqStr(b.log, "open 2 in.txt 0\n", "the greeting went nowhere, and the page asked the browser to open it");
  answered(b.page, w, 2, 0, "", u8[](), 5 as i64, 0 as i64, 0);
  t.eqStr(b.log, "open 2 in.txt 0\nrecv 3 5\n", "and read from the handle it was given");
  give(b.page, w, 3, "hello");
  answered(b.page, w, 4, 0, "", u8[](), 0 as i64, 0 as i64, 1);
  t.eqStr(b.log, "open 2 in.txt 0\nrecv 3 5\nrecv 4 5\nclose 5 5\n", "to the end, then closed it");
  answered(b.page, w, 5, 0, "", u8[](), 0 as i64, 0 as i64, 1);
  answered(b.page, w, 6, 0, "", u8[](), 6 as i64, 0 as i64, 0);
  answered(b.page, w, 7, 0, "", u8[](), 0 as i64, 0 as i64, 1);
  answered(b.page, w, 8, 0, "", u8[](), 0 as i64, 0 as i64, 1);
  t.eqStr(b.log, "open 2 in.txt 0\nrecv 3 5\nrecv 4 5\nclose 5 5\nopen 6 out.txt 1\nsend 7 6 +5\nclose 8 6\n",
          "a write opens, sends and closes the same way");
  t.isTrue(done.settled(), "the last close finished it");
  t.eqI32(done.value(), 5, "with what it read");
  return t.report();
}

export string test_a_page_refuses_to_open_a_stream_it_was_not_granted() {
  Check t = Check.create();
  Browser b = Browser("", Page.create(Dom.inert()), null, false);
  World w = over(b, 0);
  Files files = w.sys.files();
  t.isTrue(files.openRead("x").wait().unwrap().isErr(), "a read is refused");
  t.isTrue(files.openWrite("x").wait().unwrap().isErr(), "and a write");
  t.eqStr(b.log, "", "without asking the browser");
  return t.report();
}
