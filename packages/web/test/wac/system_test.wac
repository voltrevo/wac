// A page's system driven with no browser: a `System` that records what it was asked, and the
// answers a browser would give made by hand with `answered`. What a browser adds is the Origin Private
// File System, and `packages/web/tools/build.wac`'s system half is the whole of that — so what a program sees, in
// every order the answers can arrive, is tested here.

import { Check } from "./check.wac";
import { Buf, Ticket } from "core";
import { FAULT_NOT_FOUND, FAULT_NOT_GRANTED, Files, GRANT_READ, GRANT_WRITE, Stat, Sys } from "std";
import { Dom, Page, STAT_EXISTS, STAT_FILE, System, World, answered } from "../../src/page.wac";

/** What the fake browser was asked, one line per request. */
struct Asked {
  string log;
}

System recording(Asked asked) {
  System s = System.inert();
  s.readFile = (i32 req, string p) => { asked.log = asked.log + "read \{req} " + p + "\n"; };
  s.writeFile = (i32 req, string p, u8[] b) => { asked.log = asked.log + "write \{req} " + p + " \{b.len()}\n"; };
  s.stat = (i32 req, string p) => { asked.log = asked.log + "stat \{req} " + p + "\n"; };
  s.readDir = (i32 req, string p) => { asked.log = asked.log + "dir \{req} " + p + "\n"; };
  s.sleep = (i32 req, i32 ms) => { asked.log = asked.log + "sleep \{req} \{ms}\n"; };
  s.monotonicNanos = () => 42 as i64;
  return s;
}

/** Answer request `req` with bytes and no fault, as the browser would. */
void give(Page page, World w, i32 req, string text) {
  answered(page, w, req, 0, "", text.toBytes(), 0 as i64, 0 as i64, 0);
}

/** A page's program: what it may do is `page.sys`, as the build's wrapper sets it. */
async i32 copies(Page page) {
  Sys sys = page.sys;
  u8[] bytes = u8[]();
  match (await sys.readFile("in.txt")) {
    Ok(b): { bytes = b; }
    Err(why): { return 0 - 1; }
  }
  match (await sys.writeFile("out.txt", bytes)) {
    Ok(): { return bytes.len(); }
    Err(why): { return 0 - 2; }
  }
}

/** What the build's wrapper does: run the program with the page as its schedule target, then drain. */
Ticket<i32> startCopies(Page page, World w) {
  page.sys = w.sys;
  schedule page.take;
  Ticket<i32> t = copies(page);
  page.drain();
  return t;
}

export string test_a_read_waits_for_the_browser_and_the_answer_runs_it_on() {
  Check t = Check.create();
  Asked asked = Asked("");
  Page page = Page.create(Dom.inert());
  World w = World.create(recording(asked), GRANT_READ | GRANT_WRITE);
  Ticket<i32> done = startCopies(page, w);
  t.eqStr(asked.log, "read 1 in.txt\n", "it asked, and waits");
  t.isFalse(done.settled(), "nothing has answered");
  give(page, w, 1, "hello");
  t.eqStr(asked.log, "read 1 in.txt\nwrite 2 out.txt 5\n", "the answer ran it on to the write");
  answered(page, w, 2, 0, "", u8[](), 0 as i64, 0 as i64, 0);
  t.isTrue(done.settled(), "the write's answer finished it");
  t.eqI32(done.value(), 5, "with what it read");
  return t.report();
}

export string test_a_missing_file_is_an_err_in_the_programs_words() {
  Check t = Check.create();
  Asked asked = Asked("");
  Page page = Page.create(Dom.inert());
  World w = World.create(recording(asked), GRANT_READ | GRANT_WRITE);
  Ticket<i32> done = startCopies(page, w);
  answered(page, w, 1, FAULT_NOT_FOUND(), "NotFoundError: A requested file or directory could not be found",
           u8[](), 0 as i64, 0 as i64, 0);
  t.isTrue(done.settled(), "a failed read finished it");
  t.eqI32(done.value(), 0 - 1, "as an Err");
  return t.report();
}

export string test_what_the_page_was_not_granted_is_refused_without_asking() {
  Check t = Check.create();
  Asked asked = Asked("");
  Page page = Page.create(Dom.inert());
  World w = World.create(recording(asked), GRANT_READ);
  Ticket<i32> done = startCopies(page, w);
  give(page, w, 1, "hi");
  t.isTrue(done.settled(), "the write was refused at once");
  t.eqI32(done.value(), 0 - 2, "as an Err");
  t.eqStr(asked.log, "read 1 in.txt\n", "and the browser was never asked to write");

  // Through `sys.cli` as well, which is no way around the grant.
  World none = World.create(recording(asked), 0);
  t.isFalse(none.sys.cli.readFile("x").wait().ok, "the raw capability refuses too");
  t.eqI32(none.sys.cli.readFile("x").wait().fault, FAULT_NOT_GRANTED(), "as not granted");
  // Saying which grant the page was built without, which is the thing to change.
  t.eqStr(none.sys.cli.readFile("x").wait().error,
          "Not granted to this application: the page was built without `--grant read`", "a read's refusal");
  t.eqStr(none.sys.cli.writeFile("x", u8[]()).wait().message,
          "Not granted to this application: the page was built without `--grant write`", "a write's refusal");
  t.eqStr(asked.log, "read 1 in.txt\n", "still without asking");
  return t.report();
}

async i32 clocked(Sys sys) {
  i64 a = await sys.monotonicNanos();
  await sys.sleepMillis(5);
  i64 b = await sys.monotonicNanos();
  return (a + b) as! i32;
}

Ticket<i32> startClocked(Page page, Sys sys) {
  schedule page.take;
  Ticket<i32> t = clocked(sys);
  page.drain();
  return t;
}

export string test_what_this_side_knows_settles_at_once_and_a_sleep_waits() {
  Check t = Check.create();
  Asked asked = Asked("");
  Page page = Page.create(Dom.inert());
  World w = World.create(recording(asked), 0);
  Ticket<i32> done = startClocked(page, w.sys);
  t.eqStr(asked.log, "sleep 1 5\n", "the clock answered without a request, and the sleep asked");
  answered(page, w, 1, 0, "", u8[](), 7 as i64, 0 as i64, 0);
  t.isTrue(done.settled(), "the sleep's answer finished it");
  t.eqI32(done.value(), 84, "reading the clock twice");
  return t.report();
}

async string listed(Sys sys) {
  string[]? names = await sys.cli.readDir("/").ticket();
  Stat s = await sys.cli.stat("a").ticket();
  if (names is null) { return "none"; }
  string out = "";
  for (string n in names!) { out = out + n + ","; }
  return out + (s.exists && s.isFile && !s.isDir ? " file \{s.size}" : " not a file");
}

Ticket<string> startListed(Page page, Sys sys) {
  schedule page.take;
  Ticket<string> t = listed(sys);
  page.drain();
  return t;
}

export string test_a_listing_and_a_stat_are_read_from_the_answer() {
  Check t = Check.create();
  Asked asked = Asked("");
  Page page = Page.create(Dom.inert());
  World w = World.create(recording(asked), GRANT_READ);
  Ticket<string> done = startListed(page, w.sys);
  u8[] names = "a\0b c\0".toBytes();
  answered(page, w, 1, 0, "", names, 0 as i64, 0 as i64, 0);
  answered(page, w, 2, 0, "", u8[](), 12 as i64, 0 as i64, STAT_EXISTS | STAT_FILE);
  t.isTrue(done.settled(), "both answers finished it");
  t.eqStr(done.value(), "a,b c, file 12", "names split on NUL, spaces kept, and the stat's flags");
  return t.report();
}

export string test_an_answer_nobody_asked_for_and_a_late_one_are_dropped() {
  Check t = Check.create();
  Asked asked = Asked("");
  Page page = Page.create(Dom.inert());
  World w = World.create(recording(asked), GRANT_READ);
  give(page, w, 99, "stray");
  t.isFalse(w.answers.has(99), "an answer to a request never made is not kept");
  // A read whose ticket is abandoned before the browser answers: the late answer is not kept.
  w.sys.cli.readFile("x").cancel();
  give(page, w, 1, "late");
  t.isFalse(w.answers.has(1), "the late answer was dropped");
  return t.report();
}

export string test_a_page_holds_a_system_before_the_build_gives_it_one() {
  Check t = Check.create();
  // `main` is `main(Page page)` whatever was granted, so a page has a `sys` from the start: one that
  // answers nothing and refuses what needs a grant, until the build's wrapper sets the browser's.
  Page page = Page.create(Dom.inert());
  t.eqI32(page.sys.cli.readFile("x").wait().fault, FAULT_NOT_GRANTED(), "a read is refused");
  return t.report();
}

/** A page whose browser records the line to a parent, and answers it only when told to. */
System withParent(Asked asked) {
  System s = recording(asked);
  s.send = (i32 req, i32 h, u8[] b) => { asked.log = asked.log + "send \{req}\n"; };
  s.recv = (i32 req, i32 h) => { asked.log = asked.log + "recv \{req}\n"; };
  return s;
}

/** What a parent serving files answers the hello with: one frame, the greeting and who its files act as. */
u8[] servedAnswer(string user) {
  Buf body = Buf.create();
  for (string part in ["wac files 1", user]) {
    u8[] b = part.toBytes();
    body.pushU32(b.len() as@ u32);
    body.pushAll(b);
  }
  Buf framed = Buf.create();
  framed.pushU32(body.len as@ u32);
  framed.pushAll(body.bytes());
  return framed.bytes();
}

/** A spawned page program as the adapter starts it: greet the parent, then ask for the files. */
async string greetsThenAsks(Page page) {
  Sys sys = page.sys;
  await sys.__wacGreet();
  return sys.files().user;
}

/**
 * **A page program learns whether its parent serves it files without waiting.** It asked the first time `files()`
 * was called, and waited for the answer — which a page cannot do, so every applet the browser terminal spawned
 * trapped (`Uncaught RuntimeError: unreachable`, then `[exit 134]`). The adapter greets the parent before an `async`
 * `main` instead, and the answer runs it on.
 */
export string test_a_page_program_learns_it_is_served_without_waiting() {
  Check t = Check.create();
  Asked asked = Asked("");
  Page page = Page.create(Dom.inert());
  World w = World.create(withParent(asked), GRANT_READ | GRANT_WRITE);
  page.sys = w.sys;
  schedule page.take;
  Ticket<string> user = greetsThenAsks(page);
  page.drain();
  t.eqStr(asked.log, "send 1\n", "it said hello, and waits");
  t.isFalse(user.settled(), "nothing has answered");
  answered(page, w, 1, 0, "", u8[](), 0 as i64, 0 as i64, 1);
  t.eqStr(asked.log, "send 1\nrecv 2\n", "the hello went, so it listens for the answer");
  answered(page, w, 2, 0, "", servedAnswer("ada"), 0 as i64, 0 as i64, 0);
  t.isTrue(user.settled(), "the answer ran it on");
  t.eqStr(user.value(), "ada", "and its files are the parent's, acting as the parent's user");
  return t.report();
}

/** The fake browser for streams: each open, read, write and close it was asked, one line each. */
System streaming(Asked asked) {
  System s = recording(asked);
  s.openFile = (i32 req, string p, i32 how) => { asked.log = asked.log + "open \{req} " + p + " \{how}\n"; };
  s.recv = (i32 req, i32 h) => { asked.log = asked.log + "recv \{req} \{h}\n"; };
  s.send = (i32 req, i32 h, u8[] b) => { if (h != 1) { asked.log = asked.log + "send \{req} \{h} \{b.len()}\n"; } };
  s.closeFile = (i32 req, i32 h) => { asked.log = asked.log + "close \{req} \{h}\n"; };
  return s;
}

/** `copies` again, through streams: what `cat f` and `echo x > f` do in a page's shell. */
async i32 streams(Page page) {
  await page.sys.__wacGreet();
  Files files = page.sys.files();
  u8[] bytes = u8[]();
  match (await files.openRead("in.txt")) {
    Ok(input): {
      match (await input.readAll()) {
        Ok(b): { bytes = b; }
        Err(why): { return 0 - 1; }
      }
      match (await input.close()) {
        Ok(): { }
        Err(why): { return 0 - 2; }
      }
    }
    Err(why): { return 0 - 3; }
  }
  match (await files.openWrite("out.txt")) {
    Ok(out): {
      match (await out.write(bytes)) {
        Ok(): { }
        Err(why): { return 0 - 4; }
      }
      match (await out.close()) {
        Ok(): { return bytes.len(); }
        Err(why): { return 0 - 5; }
      }
    }
    Err(why): { return 0 - 6; }
  }
}

export string test_a_page_opens_a_file_as_a_stream_to_read_and_to_write() {
  Check t = Check.create();
  Asked asked = Asked("");
  Page page = Page.create(Dom.inert());
  World w = World.create(streaming(asked), GRANT_READ | GRANT_WRITE);
  page.sys = w.sys;
  schedule page.take;
  Ticket<i32> done = streams(page);
  page.drain();
  // The greeting, refused as a page with no parent refuses it: nothing was sent.
  answered(page, w, 1, 0, "", u8[](), 0 as i64, 0 as i64, 0);
  t.eqStr(asked.log, "open 2 in.txt 0\n", "the page asked the browser to open it");
  answered(page, w, 2, 0, "", u8[](), 5 as i64, 0 as i64, 0);
  t.eqStr(asked.log, "open 2 in.txt 0\nrecv 3 5\n", "and read from the handle it was given");
  give(page, w, 3, "hello");
  answered(page, w, 4, 0, "", u8[](), 0 as i64, 0 as i64, 1);
  t.eqStr(asked.log, "open 2 in.txt 0\nrecv 3 5\nrecv 4 5\nclose 5 5\n", "to the end, then closed it");
  answered(page, w, 5, 0, "", u8[](), 0 as i64, 0 as i64, 1);
  answered(page, w, 6, 0, "", u8[](), 6 as i64, 0 as i64, 0);
  answered(page, w, 7, 0, "", u8[](), 0 as i64, 0 as i64, 1);
  answered(page, w, 8, 0, "", u8[](), 0 as i64, 0 as i64, 1);
  t.eqStr(asked.log, "open 2 in.txt 0\nrecv 3 5\nrecv 4 5\nclose 5 5\nopen 6 out.txt 1\nsend 7 6 5\nclose 8 6\n",
          "a write opens, sends and closes the same way");
  t.isTrue(done.settled(), "the last close finished it");
  t.eqI32(done.value(), 5, "with what it read");
  return t.report();
}

export string test_a_page_refuses_to_open_a_stream_it_was_not_granted() {
  Check t = Check.create();
  Asked asked = Asked("");
  World w = World.create(streaming(asked), 0);
  t.eqI32(w.sys.cli.openFile("x", 0).wait().fault, FAULT_NOT_GRANTED(), "a read is refused");
  t.eqI32(w.sys.cli.openFile("x", 1).wait().fault, FAULT_NOT_GRANTED(), "and a write");
  t.eqStr(asked.log, "", "without asking the browser");
  return t.report();
}
