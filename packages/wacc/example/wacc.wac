// The compiler, as a program.
//
//     wacc check   main.wac          # type-check it and its imports; say what is wrong
//     wacc compile main.wac [out]    # write the module, `main.wasm` beside it by default
//     wacc build   main.wac -o stem  # ...and the manifest a native host reads, in the module
//     wacc bindgen main.wac [--js]   # main.gen.ts — the glue a host calls the module through
//
// `build` also takes `--coverage`: a counter per branch point, and `<stem>.cov` saying what each is.
// `--trace` is the other instrumented build — an ordered journal rather than counts, with
// `<stem>.trace` naming each site. `wac ctcompare` is what reads one.
//                                    #    --quiet for the success line, --allow-* for the grants
//
// A TypeScript CLI (`waccx`) did the same job until it was retired, and this was never a port for
// its own sake: it is what the `wac` binary dispatches. The wasmtime host already runs `packages/sh` and
// every one of box's applets over a real filesystem, so a compiler that is itself a wac program needs
// no JavaScript anywhere in the path — design/lang/0003 step 4.
//
// **The compiler does no I/O and this does no compiling.** `emitFiles` and its neighbours take paths
// and sources, which is what lets them run in a browser; `src/files.wac` says which files a program
// is made of; and reading them is here, where the capabilities are. Each half is testable without
// the other.

import { CallResult, Change, Child, Cli, Core, FileResult, LoadedModule, Pending, Stat, faultWords }
  from "std/platform.wac";
import { Read } from "core";
import { Vec } from "core/vec.wac";
import { atoi, itoa, itoa64 } from "../../fmt/src/itoa.wac";
import { Fs } from "../../fs/src/fs.wac";
import { bindTypesFilesIn, bindgenDeclinedFilesIn, bindgenWire, blockedFilesIn, buildFilesIn,
         covTableFilesIn, describeSeparator, diagnoseGraphIn, exportSigsFilesIn, missingImportFilesIn,
         wireHasErrors,
         emitFilesCoveredIn, emitFilesTraced, emitFilesTracedSlots, traceTableFiles,
         manifestWire } from "../src/api.wac";
import { Built } from "../src/emit.wac";
import { manifestIn, withManifestSection } from "../src/manifest.wac";
import { renderDiagnostics } from "../src/render.wac";
import { importSpecs, normalisePath, resolveFrom, resolveFromAt, resolveFromIn } from "../src/files.wac";
import { Res } from "../src/path.wac";
import { coreFile, coreSource, isBuiltinSpec, stdFile } from "../src/coretext.wac";
import { MANIFEST_NAME, candidateRoots, isProjectSpecifier } from "../../wacpkg/src/root.wac";
import { Manifest, Match, Located, readManifest, manifestWhy, matchSpecifier, locate,
         M_OK } from "../../wacpkg/src/manifest.wac";
import { Lock, LockEntry, readLock } from "../../wacpkg/src/lock.wac";
import { JsonObject, JsonValue } from "../../json/src/value.wac";
import { parse } from "../../json/src/json.wac";
import { cachePath } from "../../wacpkg/src/cache.wac";

/** How many files one program may be made of. */
i32 maxFiles() { return 512; }

/** The three answers `Built.described` folds together. */
struct Described {
  /** Why the emitter gave up, empty when it did not. */
  string blocked;
  /** `name\tret\tparams` per exported function — `exportSigsFiles`'s format. */
  string sigs;
  /** The bind-type wire — `bindTypesFiles`'s format. */
  string types;
}

/**
 * `blocked`, `sigs` and `types`, split on `describeSeparator()`.
 *
 * Two separators, three parts, and a part may be empty — a graph with nothing blocked and nothing
 * exported produces `sep + sep`. The separator is a whole line that neither half can emit, which is
 * what makes splitting on it safe: signature lines are `name\tret\tparams` and bind-type lines start
 * with a one-letter tag, so neither can contain it.
 *
 * A string that does not carry two separators is not one of these, and the honest answer to that is
 * the empty parts rather than a guess: `blockedOf` said nothing, so nothing is blocked, and a
 * manifest built from no signatures is a manifest a host will refuse loudly.
 */
Described describedParts(string described) {
  string sep = describeSeparator();
  i32 first = described.indexOf(sep);
  if (first < 0) { return Described(described, "", ""); }
  string blocked = described.slice(0, first);
  string rest = described.slice(first + sep.len(), described.len());
  i32 second = rest.indexOf(sep);
  if (second < 0) { return Described(blocked, rest, ""); }
  return Described(blocked, rest.slice(0, second), rest.slice(second + sep.len(), rest.len()));
}

/** A program's whole source: every path it reaches, and what is in each. */
struct Sources {
  string[] paths;
  string[] texts;
  /**
   * The project each file sits in, parallel to `paths` and "" for most of them.
   *
   * Only a file that writes `@/` has a root worth finding, so this is empty for every program that
   * uses none — the search costs nothing it is not asked for. `design/lang/0009` D7.
   */
  string[] roots;
  /**
   * Where each file may import from, parallel to `paths`, "" for anything local.
   *
   * A file that arrived through a mapping with a `subdir` may reach that subdirectory and nothing
   * else in its checkout, and anything it imports inherits the same bound. Separate from `roots`
   * because they answer different questions: `roots[i]` is what `@/` *means* for the file, and
   * `confine[i]` is what the answer is allowed to be. `issues/lang/0169a`.
   */
  string[] confine;
  /** The directory the walk measured every relative key from — see `Res.base`. */
  string base;
  /** One entry per mapped import: who wrote it, what they wrote, and the key it resolved to. */
  string[] mapFrom;
  string[] mapSpec;
  string[] mapTo;
  i32 mapN;
  i32 n;
  /** The first path that could not be read, or "". */
  string missing;
  /**
   * Why the walk stopped, as a whole sentence, when the reason is not "a file was not there".
   *
   * **Two facts, two fields.** `missing` is a *path* and the caller prints `cannot read <it>`; a
   * mapping with no locked commit, or a `@/` with no project, is a sentence that already says what
   * to do. Both went in `missing` at first and the caller sniffed the text to decide how to print
   * it, which works until a filename contains the phrase being sniffed for.
   */
  string why;
}

/** What `Sources.missing` says for a `@/` the importing file has no project for — D7. */
string noProject(string spec, string from) {
  return spec + " needs a project: no " + MANIFEST_NAME() + " above " + from;
}

/**
 * What `Sources.why` says for a bare `"std"` — D4, and `§wac-std-no-root-2vp6xmk`.
 *
 * **`std` is reserved but has no root module**, so this specifier is neither a file to read nor a
 * built-in to serve, and the honest answer names the one thing that would work. Without it the
 * reader falls through to path arithmetic and reports *cannot read std* — a sentence about a file,
 * for a word that was never going to be one, which sends the reader looking in the wrong place.
 *
 * `core` does have a root, so `from "core"` stays correct and this says nothing about it.
 */
/**
 * Is `path` inside `dir` — used to keep a mapped dependency inside the subdirectory it was mapped at.
 *
 * Equal counts: the directory itself is inside itself. The `+ "/"` is what stops `a/bc` reading as
 * inside `a/b`, which a plain prefix test gets wrong and is the only interesting case here.
 */
bool withinDir(string dir, string path) {
  if (dir == "") { return true; }
  if (path == dir) { return true; }
  return path.len() > dir.len() && path.slice(0, dir.len() + 1) == dir + "/";
}

/** What `Sources.why` says for an import that leaves the subdirectory its mapping was given. */
string leavesMapping(string spec, string from, string dir) {
  return spec + " leaves the mapped subdirectory: " + from + " may import from " + dir +
         " and this resolves outside it";
}

string noStdRoot() {
  return "\"std\" has no root module: import from one of its files, such as \"std/platform.wac\"";
}

/**
 * Whether `spec` could name a mapping: not relative, not a built-in, not `@/`.
 *
 * A cheap syntactic filter so that an ordinary import never reads a manifest. It says *could*: the
 * manifest decides, and a specifier that passes this and matches nothing falls through to the path
 * arithmetic exactly as before.
 */
bool isMappingCandidate(string spec) {
  if (spec.len() == 0) { return false; }
  if (spec.slice(0, 1) == "." || spec.slice(0, 1) == "/") { return false; }
  if (isProjectSpecifier(spec)) { return false; }
  return !isBuiltinSpec(spec);
}

/** `projectRootOf` with the boundary given rather than assumed — see `Mapped.checkout`. */
string projectRootIn(Fs fs, string path, string boundary) {
  string[] dirs = candidateRoots(path, boundary);
  for (i32 i = 0; i < dirs.len(); i++) {
    string at = dirs[i] == "." ? MANIFEST_NAME() : dirs[i] + "/" + MANIFEST_NAME();
    if (fs.stat(at).exists) { return dirs[i]; }
  }
  return "";
}

/**
 * `$WAC_HOME`, or `$HOME/.wac`, or "" when neither is set — the same rule `tools/install.ts` uses.
 *
 * A compiler that reads an environment variable needs the grant for it, and `wac build` may not have
 * been given one. "" is an ordinary answer rather than a failure: it means no cache can be found, so
 * a mapped import reports that rather than reading from somewhere unrelated.
 */
string wacHomeOf(Cli cli) {
  u8[]? set = cli.env("WAC_HOME").wait();
  if (!(set is null) && set!.len() > 0) { return string.fromBytes(set!); }
  u8[]? home = cli.env("HOME").wait();
  if ((home is null) || home!.len() == 0) { return ""; }
  return string.fromBytes(home!) + "/.wac";
}

/**
 * A 64-bit FNV-1a over the pieces of a build, as sixteen hex digits.
 *
 * The same construction the host uses for `test_module_key` and `$WAC_COMPILER_ID`, so that a reader
 * comparing the two caches is comparing like with like. **64 bits and not `core/hash.wac`'s 32**: a
 * collision here does not lose a lookup, it serves a *different program's module*, and 32 bits is one
 * birthday away from that at a few tens of thousands of entries.
 */
struct Fnv {
  i64 h;
  Fnv start() { return Fnv(0xcbf29ce484222325); }
  void eat(this, string s) {
    u8[] b = s.toBytes();
    for (i32 i = 0; i < b.len(); i++) {
      this.h = this.h ^ (b[i] as i64);
      this.h = this.h * 0x100000001b3;
    }
    // A length after each piece, so that eating "ab" then "c" differs from "a" then "bc" — without it
    // two different file sets with the same concatenation share a key.
    this.h = this.h ^ (b.len() as i64);
    this.h = this.h * 0x100000001b3;
  }
  string hex(const this) {
    string out = "";
    for (i32 i = 15; i >= 0; i--) {
      i64 nib = (this.h >> ((i * 4) as i64)) & 15;
      i32 d = nib as! i32;
      out = out + "0123456789abcdef".slice(d, d + 1);
    }
    return out;
  }
}

/**
 * How many built artefacts to keep. See `sweepBuildCache` for why this is a number and not "plenty".
 *
 * `$WAC_BUILD_CACHE_KEEP` overrides it, which is the only way to test the bound: proving it evicts
 * otherwise costs sixty-five real builds of real programs, and a test that slow is a test nobody runs.
 * The same reason `$WAC_TESTMOD_DIR` exists on the host's side of this.
 */
i32 keepBuilds(Cli cli) {
  u8[]? set = cli.env("WAC_BUILD_CACHE_KEEP").wait();
  if ((set is null) || set!.len() == 0) { return 64; }
  // `atoi` answers 0 for anything that is not a number, and 0 is a legitimate bound — "keep none" is
  // how a caller turns the cache off — so a malformed value is taken at its word rather than guessed at.
  return atoi(string.fromBytes(set!));
}

/**
 * Bound the build cache: keep the newest `keepBuilds()` entries and delete the rest.
 *
 * **A number with a reason.** These are whole programs rather than the test lane's aggregates — box's
 * shell is about a megabyte — so sixty-four is roughly 60 MB. `issues/system/0136` is the day this
 * filesystem filled and the reason an unbounded cache is not an option: a directory that only ever
 * grows is a disk that only ever shrinks.
 *
 * **Newest by write time, not by use.** The host's own module cache touches an entry when it hits, so
 * its bound is least-recently-*used*; there is no `utime` in this world, so this one is
 * least-recently-*written*. The difference would matter if the working set were near the bound — a
 * program built once and used daily would age out — and at sixty-four against the handful of
 * applications this repository builds, it is not near it. Worth knowing before raising the traffic.
 */
void sweepBuildCache(Cli cli, string dir) {
  string[]? names = cli.readDir(dir).wait();
  if (names is null) { return; }
  i32 n = names!.len();
  i32 keep = keepBuilds(cli);
  if (n <= keep) { return; }
  // Ages in the same order as the names, so the two can be sorted together.
  i64[] when = i64[n]();
  for (i32 i = 0; i < n; i++) {
    Stat s = cli.stat(dir + "/" + names![i]).wait();
    when[i] = s.exists ? s.modifiedMillis : (0 as i64);
  }
  // Selection sort, newest first: `n` is bounded by the entries in one directory and this runs only
  // on the write that crosses the bound, so the shape of the sort is not worth more than its clarity.
  for (i32 i = 0; i < n; i++) {
    i32 best = i;
    for (i32 j = i + 1; j < n; j++) { if (when[j] > when[best]) { best = j; } }
    if (best != i) {
      i64 tw = when[i]; when[i] = when[best]; when[best] = tw;
      string tn = names![i]; names![i] = names![best]; names![best] = tn;
    }
  }
  for (i32 i = keep; i < n; i++) { cli.remove(dir + "/" + names![i], false).wait(); }
}

/** Everything before the last `/`, which is the directory a cache entry needs to exist in. */
string dirOf(string path) {
  i32 cut = 0 - 1;
  for (i32 i = 0; i < path.len(); i++) { if (path.slice(i, i + 1) == "/") { cut = i; } }
  return cut <= 0 ? "." : path.slice(0, cut);
}

/**
 * Where this build's artefact would be cached, or `""` when it must not be.
 *
 * `issues/system/0204`. The key is everything that changes the bytes written: the compiler, the entry,
 * every source's content, the grants — they go *into* the manifest — and the output's base name, which
 * is in the manifest too, so two destinations are two artefacts.
 *
 * **`""` for anything that is not a plain build.** A coverage or traced build writes a table beside the
 * module that would have to be cached with it; `wac build` without `-o` writes elsewhere; and without
 * `$WAC_HOME` there is nowhere to put it. Each of those is a miss forever rather than a wrong hit.
 *
 * **The compiler's identity comes from the host** — a wac program cannot hash the seed it is running
 * inside. Absent it, this answers `""` rather than keying on nothing, because an entry that cannot say
 * which compiler made it is the stale hit this whole cache has to avoid.
 *
 * **`--no-cache` is neither read nor write**, and it exists because a build that has to prove something
 * about the compiler cannot be answered from disk. `packages/wacc/test/wac/selfhost_test.wac` builds
 * wacc twice and requires byte equality; served from cache that is one file compared with itself, which
 * `issues/system/0204` predicted before this cache existed and which measured 194 ms against a
 * documented 3 s once it did. `tools/seed.sh` has the same shape in its fixpoint loop, in the steady
 * state where consecutive rounds run the same compiler over the same sources.
 *
 * **And an unvalidated command line gets no hit.** The lookup happens above the dispatch, where the
 * sources are already gathered and the flags are not yet checked — so a hit used to return 0 before
 * `unknownFlag` ever ran, and `wac build --nonsense` succeeded silently on a warm cache while failing
 * correctly on a cold one. Refusing to key a command line the program has not accepted keeps the two
 * answers the same; the caller still gets the ordinary error, one compile later.
 */
string buildCachePath(Cli cli, i32 argc, string cmd, string entry, string[] paths, string[] texts,
                      string stem) {
  if (cmd != "build" || stem == "") { return ""; }
  if (hasFlag(cli, argc, "--coverage") || hasFlag(cli, argc, "--trace")) { return ""; }
  if (hasFlag(cli, argc, "--no-cache")) { return ""; }
  if (unknownFlag(cli, argc) != "") { return ""; }
  // **A bound of zero turns the cache off, lookup included.** Sweeping to nothing is not the same as
  // being off: entries written before still answer, so a caller who set this because they suspect a
  // stale hit would go on getting hits until the first build swept them away. Measured — a self-build
  // that should have recompiled came back in 160 ms with the bound at zero.
  if (keepBuilds(cli) <= 0) { return ""; }
  string home = wacHomeOf(cli);
  if (home == "") { return ""; }
  u8[]? id = cli.env("WAC_COMPILER_ID").wait();
  if ((id is null) || id!.len() == 0) { return ""; }

  Fnv h = Fnv.start();
  h.eat("wac-build 1");
  h.eat(string.fromBytes(id!));
  h.eat(entry);
  h.eat(baseName(stem) + ".wasm");
  // A bitmask, not a list — `grantsIn` answers the five bits that go into the manifest.
  h.eat(itoa(grantsIn(cli, argc)));
  for (i32 i = 0; i < paths.len(); i++) {
    h.eat(paths[i]);
    h.eat(texts[i]);
  }
  return home + "/cache/build/" + h.hex() + ".wasm";
}

/** A specifier that named a mapping, resolved to a file on disk — `design/lang/0009` D9-D11. */
struct Mapped {
  /** Whether the specifier named a mapping at all. When false the other fields mean nothing. */
  bool named;
  /** Whether it resolved to a file this build can read. */
  bool ok;
  /** The file, under `$WAC_HOME/cache/git/<repo>/<commit>/`. */
  string path;
  /**
   * The fetched dependency's root — D7's provider boundary for a mapped file.
   *
   * A `@/` *inside* a dependency means that dependency's own root, not the project that imported it,
   * and the search has to stop at the checkout or it climbs into the cache's own layout and then
   * into the importing project. This is what it stops at.
   */
  string checkout;
  /**
   * The directory this dependency's code may not import out of — `issues/lang/0169a`.
   *
   * The checkout plus the mapping's `subdir`, or just the checkout when there is none. **Not the
   * same question as `checkout` above**, which bounds the *search* for a `@/` root: a dependency's
   * `@/` means its own repository's root, because that is what its author wrote against, so the
   * search has to reach the repository root even when only a subdirectory was mapped. This bounds
   * the *answer*. You took one directory; the rest of that repository is not yours and its code
   * must not be able to reach the parts you did not take.
   */
  string confine;
  /** Why not, when `ok` is false. Written for somebody who has to act on it. */
  string error;
}

/**
 * The file a mapped specifier names, if it names one.
 *
 * **Resolution only — this never fetches.** D10 makes `wac update` the explicit operation and says
 * an ordinary command must not advance a lock because a branch moved; fetching mid-compile would be
 * the same mistake in a different place, and would put the network inside `wac build`. A commit that
 * is not in the cache is an error naming the command that would put it there.
 *
 * **The disk path is the identity, and that is D8 falling out rather than being enforced.** The cache
 * is `<repo>/<commit>/`, a function of the repository and the commit and nothing else, so
 * `cachePath(...) + "/" + located.path` *is* "repository, resolved commit, repository-relative path"
 * — the triple D8 says identity is. Two mappings naming one repository at one commit produce one
 * key; two mappings at different commits produce two. No separate canonicalisation to keep true.
 */
Mapped mapSpecifier(Fs fs, Cli cli, string root, string spec) {
  FileResult mf = fs.readFile(root == "." ? MANIFEST_NAME() : root + "/" + MANIFEST_NAME());
  if (!mf.ok) { return Mapped(false, false, "", "", "", ""); }
  Manifest m = readManifest(mf.bytes);
  if (!m.ok) {
    return Mapped(true, false, "", "", "",
                  root + "/" + MANIFEST_NAME() + ": " + manifestWhy(m.code) +
                  (m.detail == "" ? "" : " — " + m.detail));
  }
  Match hit = matchSpecifier(m, spec);
  if (!hit.found) { return Mapped(false, false, "", "", "", ""); }

  Located at = locate(m, hit);
  if (!at.ok) {
    return Mapped(true, false, "", "", "",
                  spec + " climbs out of the subtree its mapping was given");
  }
  string name = m.imports[hit.index].name;
  string git = m.imports[hit.index].git;

  FileResult lf = fs.readFile(root == "." ? "wac.lock" : root + "/wac.lock");
  if (!lf.ok) {
    return Mapped(true, false, "", "", "",
                  spec + " needs a locked commit for `" + name + "` — run `wac update`");
  }
  Lock lock = readLock(lf.bytes);
  if (!lock.ok) {
    return Mapped(true, false, "", "", "", root + "/wac.lock is not usable: " + lock.detail);
  }
  string commit = "";
  for (i32 i = 0; i < lock.entries.len(); i++) {
    if (lock.entries[i].name == name) { commit = lock.entries[i].commit; }
  }
  if (commit == "") {
    return Mapped(true, false, "", "", "",
                  "`" + name + "` has no entry in " + root + "/wac.lock — run `wac update`");
  }

  string home = wacHomeOf(cli);
  if (home == "") {
    return Mapped(true, false, "", "", "",
                  "neither WAC_HOME nor HOME is set, so there is no cache to read `" + name +
                  "` from");
  }
  string checkout = cachePath(home, git, commit);
  string file = checkout + "/" + at.path;
  if (!fs.stat(file).exists) {
    // **Says where it looked.** "not in the cache" without the path leaves the reader guessing
    // between a wrong commit, a wrong subdir and a cache that was never filled — three different
    // things to do about it.
    return Mapped(true, false, "", "", "",
                  spec + " is not in the cache — run `wac update`. Looked for " + file);
  }
  string sub = m.imports[hit.index].subdir;
  return Mapped(true, true, file, checkout, sub == "" ? checkout : checkout + "/" + sub, "");
}

/**
 * The project `path` sits in — the nearest directory at or above it holding a `wac.json5` — or "".
 *
 * **The I/O half of `@/`, and the only place in this program that looks for a manifest.** D7 defines
 * `@/` by searching upwards for the nearest one, and `packages/wacpkg/src/root.wac` says which
 * directories that means; this asks the filesystem which of them has the file. It *stats* rather than
 * reads: what a manifest says matters for mappings (D9-D11), and `@/` needs only that it is there,
 * which is what keeps the JSON parser out of the compiler's graph.
 *
 * The boundary is the filesystem root for an absolute path and `.` for a relative one — the
 * "local-filesystem boundary" of D7, which is the only provider there is until mappings land.
 */
/**
 * `projectRootOf` for a path that may be relative, searching from `base` — `issues/lang/0168a`.
 *
 * The spec is explicit that `@/` is the project containing the importing file and **"not the
 * directory the compiler was started in"**, and the lexical walk made it exactly that: it could
 * climb only as far as the path as typed spelled out, so `wac run main.wac` from a subdirectory
 * stopped at the working directory with the manifest one level above it.
 *
 * Absolute here, and brought back to a relative answer at the join rather than here, because the
 * *root* is not what has to be in the graph's key space — the resolved import is. `relativeTo` in
 * `path.wac` carries that argument.
 */
string projectRootAbs(Fs fs, string base, string path) {
  string abs = path.len() > 0 && path.slice(0, 1) == "/" ? path : normalisePath(base + "/" + path);
  return projectRootOf(fs, abs);
}

string projectRootOf(Fs fs, string path) {
  string boundary = path.len() > 0 && path.slice(0, 1) == "/" ? "/" : ".";
  string[] dirs = candidateRoots(path, boundary);
  for (i32 i = 0; i < dirs.len(); i++) {
    string at = dirs[i] == "." ? MANIFEST_NAME() : dirs[i] + "/" + MANIFEST_NAME();
    if (fs.stat(at).exists) { return dirs[i]; }
  }
  return "";
}

/**
 * Read `entry` and everything it imports, breadth first.
 *
 * A file that cannot be read stops the walk and is named: the alternative is compiling a program
 * with a hole in it and reporting whatever the hole makes the checker say, which points at the
 * wrong file.
 */
Sources gather(Fs fs, Cli cli, string entry) {
  string[] paths = string[maxFiles()](fill: "");
  string[] texts = string[maxFiles()](fill: "");
  string[] roots = string[maxFiles()](fill: "");
  string[] mapFrom = string[maxFiles()](fill: "");
  string[] mapSpec = string[maxFiles()](fill: "");
  string[] mapTo = string[maxFiles()](fill: "");
  // **Where each file may import from, parallel to `paths` and "" for anything local.** A file that
  // arrived through a mapping with a `subdir` may not reach the rest of its checkout, and a file it
  // imports inherits the same bound — `issues/lang/0169a`.
  string[] confine = string[maxFiles()](fill: "");
  // **Who asked for each file, and how they spelled it.** A file that cannot be read is named on its
  // own today — `cannot read shared/gone.wac` — and the reader is then left to find which import asked
  // for it, which in a graph of a hundred files is the whole of the work. The importer and the
  // specifier are both in scope where a path is queued, two hundred lines above where the read fails.
  // The same shape as `linkFiles`'s queue, for the same reason. `issues/lang/0157`.
  string[] askedBy = string[maxFiles()](fill: "");
  string[] askedAs = string[maxFiles()](fill: "");
  // **Where the upward search for a `@/` root starts from, and where its answer comes back to.**
  // `candidateRoots` walks the components of the path it is given, so a relative entry could climb
  // only as far as it was spelled — `wac run main.wac` from a subdirectory reported *no wac.json5
  // above main.wac* with the manifest one level up. `issues/lang/0168a`.
  string base = normalisePath(cli.cwd().wait());
  i32 mapN = 0;
  i32 n = 0;
  // **The entry in the same spelling its imports will be in.** `resolveFrom` collapses `.` and
  // `..`; the entry went in as typed, so `./a/b.wac` keyed the map one way and resolved its own
  // imports the other. `issues/lang/0134`.
  paths[0] = normalisePath(entry);
  n = 1;
  i32 at = 0;
  while (at < n) {
    string path = paths[at];
    // **A built-in is served from inside the compiler, never read.** This walk is the whole of the
    // I/O, so a built-in that reached `readFile` is a built-in that needs a `core/` directory in the
    // current working directory to exist — and one does, here, which is exactly why nothing caught
    // it: `core/option.wac` resolved off the repository's own tree for every test in the suite and
    // answered *`wacc: cannot read core/option.wac`* from any other directory. That is the property
    // the tree was moved inside the compiler to have (`design/lang/0009` D3/D4), so it is worth
    // saying plainly: the CLI has no path to read these from, and the playground has no filesystem.
    string builtin = path == "core" ? coreSource() : coreFile(path);
    // **And `std`, which is the same tree and was not on this line.** It was added to `emit.wac`'s
    // `sourceOf` when D4 landed and not to this walk, so `std/platform.wac` fell through to
    // `readFile` and resolved off the repository's own `std/` directory — the *identical* fault the
    // paragraph above records for `core/option.wac`, repeated within a day, in the function whose
    // comment describes it. Every test still passed, because they all run with the repository root
    // as the working directory. From anywhere else: `wacc: cannot read std/platform.wac`.
    if (builtin == "") { builtin = stdFile(path); }
    u8[] bytes = builtin.toBytes();
    if (builtin == "") {
      FileResult r = fs.readFile(path);
      if (!r.ok) {
        // `why` carries the whole sentence when there is an importer to name; `missing` stays set
        // either way, so the entry file's own failure still reads `cannot read <entry>`.
        string said = askedBy[at] == "" ? ""
            : "cannot read " + path + " (" + askedBy[at] + " imports it as \"" + askedAs[at] + "\")";
        return Sources(paths, texts, roots, confine, base, mapFrom, mapSpec, mapTo, mapN, n, path, said);
      }
      bytes = r.bytes;
    }
    texts[at] = string.fromBytes(bytes);
    string[] specs = importSpecs(bytes);
    for (i32 i = 0; i < specs.len(); i++) {
      // **A `@/` is resolved here or the graph is short a file**, and the root is looked up only
      // when one of this file's specifiers asks for it — so a program with no project reference
      // never stats anything, and a manifest above the tree cannot change what its imports mean.
      if ((isProjectSpecifier(specs[i]) || isMappingCandidate(specs[i])) && roots[at] == "") {
        roots[at] = projectRootAbs(fs, base, path);
      }
      // **A mapping is tried before the path arithmetic**, because a specifier like `dep/lib.wac`
      // is a legitimate relative path *and* a legitimate mapping name — and joining it to the
      // importing file's directory first would resolve to a file that is usually not there and
      // occasionally is, which is the worse of the two failures. `matchSpecifier` answers `found`
      // only for a name the manifest actually declares, so an ordinary relative import falls
      // through untouched. `design/lang/0009` D9.
      if (isMappingCandidate(specs[i]) && roots[at] != "") {
        Mapped got = mapSpecifier(fs, cli, roots[at], specs[i]);
        if (got.named) {
          if (!got.ok) { return Sources(paths, texts, roots, confine, base, mapFrom, mapSpec, mapTo, mapN, n, "", got.error); }
          // The answer the linker and the checker cannot work out for themselves.
          if (mapN < mapFrom.len()) {
            mapFrom[mapN] = path;
            mapSpec[mapN] = specs[i];
            mapTo[mapN] = got.path;
            mapN = mapN + 1;
          }
          bool seenMapped = false;
          for (i32 k = 0; k < n; k++) { if (paths[k] == got.path) { seenMapped = true; } }
          if (!seenMapped && n < maxFiles()) {
            paths[n] = got.path;
            // A dependency's own `@/` means *its* root, and the search must stop at the checkout
            // rather than climbing into the cache's layout and on into the importing project — D7's
            // provider boundary, which for a mapped file is the dependency's own checkout.
            roots[n] = projectRootIn(fs, got.path, got.checkout);
            confine[n] = got.confine;
            n = n + 1;
          }
          continue;
        }
      }
      if (specs[i] == "std") {
        return Sources(paths, texts, roots, confine, base, mapFrom, mapSpec, mapTo, mapN, n, "", noStdRoot());
      }
      string next = resolveFromAt(path, specs[i], roots[at], base);
      // **A `@/` with no project stops the walk, and saying so is the whole point.** D7 makes it a
      // compile error. Skipping the import instead is the outcome that looks like success: the
      // program compiles with the import silently absent, which is how the first version of this
      // answered *"1 file(s), no diagnostics"* for a program that imports a name it cannot reach.
      // The other wrong answer is resolving it anyway — `@/src/a.wac` against nothing is
      // `src/a.wac`, a real-looking path relative to a directory nobody named.
      if (next == "") {
        return Sources(paths, texts, roots, confine, base, mapFrom, mapSpec, mapTo, mapN, n, "", noProject(specs[i], path));
      }
      // **A mapped subdirectory bounds its code, whatever form the specifier took.** Checked here
      // rather than in the `@/` branch because `@/outside/x.wac` and `../outside/x.wac` are the same
      // escape: when this was found both reached, so a fix aimed at one would have looked finished.
      // This is the single point every resolved specifier passes through.
      //
      // **A built-in is not a path and confinement has nothing to say about it.** `resolveFromAt`
      // answers a built-in specifier unchanged, so `core/map.wac` was compared against the
      // dependency's checkout and read as an escape — GitHub issue 24. It cannot reach the
      // filesystem to escape *to*: the walk above serves `core/` and `std/` from the text embedded
      // in this compiler, which is the whole point of `design/lang/0009` D3/D4.
      //
      // Outside a mapping the same import always worked, because `confine` is empty there and
      // `withinDir` answers true for everything — so the rule was invisible until a package was
      // consumed through Git, and then it made usability depend on whether that package's own
      // closure happened to name a built-in. `packages/crypto` and `packages/codec` were fine;
      // `packages/json` was not, because `value.wac` imports `core/map.wac`.
      if (!isBuiltinSpec(specs[i]) && !withinDir(confine[at], next)) {
        return Sources(paths, texts, roots, confine, base, mapFrom, mapSpec, mapTo, mapN, n, "",
                       leavesMapping(specs[i], path, confine[at]));
      }
      bool seen = false;
      for (i32 k = 0; k < n; k++) { if (paths[k] == next) { seen = true; } }
      // **The cap is reported, not skipped.** This was `if (seen || n >= maxFiles()) { continue; }`,
      // so a program of more than 512 files was compiled *with a hole in it* — which is the exact
      // thing this function's own docstring says it refuses to do, twelve lines above. `wac check` on
      // a 1025-file program answered *"512 file(s), no diagnostics"*, and `wac build` then failed with
      // "an import of a file that was not supplied", naming neither the limit nor the file that did
      // not fit. `issues/lang/0158`.
      if (!seen && n >= maxFiles()) {
        return Sources(paths, texts, roots, confine, base, mapFrom, mapSpec, mapTo, mapN, n, "",
                       "a program may be at most " + itoa(maxFiles()) + " files, and " + next
                       + " (imported by " + path + ") is past that");
      }
      if (seen) { continue; }
      paths[n] = next;
      askedBy[n] = path;
      askedAs[n] = specs[i];
      // Inherited: a file a confined file reaches is as confined as the file that reached it — **but a
      // built-in inherits nothing**, because it was never in the confined tree. Skipping the check above
      // and leaving this line alone moves the refusal one file along rather than lifting it:
      // `core/result.wac` imports `./option.wac` *relatively*, from inside the embedded text, so it
      // resolves under the compiler's base and is refused for leaving a Git checkout it was never in.
      // Measured that way — with only the check skipped, a mapped file reaching `core/result.wac` gets
      // *"./option.wac leaves the mapped subdirectory"*. It is the one built-in with a relative import,
      // which is why the reported case (`core/map.wac`) does not show it. GitHub `voltrevo/wac#24`.
      confine[n] = isBuiltinSpec(specs[i]) ? "" : confine[at];
      n = n + 1;
    }
    at = at + 1;
  }
  return Sources(paths, texts, roots, confine, base, mapFrom, mapSpec, mapTo, mapN, n, "", "");
}

/**
 * A missing import rendered where it was written, or `""` when it cannot be located.
 *
 * `parts` is `key\tfrom\tspec` from `missingImportFilesIn`. The specifier is found in the importing
 * file's source **by string comparison** — quoted, so a word appearing in prose cannot match — and the
 * line and column come from counting to it. Nothing is resolved here, which is the whole reason this is
 * possible at all. `issues/lang/0157`.
 */
string positionedMissingImport(string parts, string[] paths, string[] texts) {
  string key = fieldOf(parts, 0);
  string from = fieldOf(parts, 1);
  string spec = fieldOf(parts, 2);
  if (key == "" || from == "" || spec == "") { return ""; }
  i32 at = -1;
  for (i32 i = 0; i < paths.len(); i++) { if (paths[i] == from) { at = i; } }
  if (at < 0) { return ""; }
  string src = texts[at];
  // Quoted, so `./b.wac` written in a comment above the import does not win the search.
  i32 hit = src.indexOf("\"" + spec + "\"");
  if (hit < 0) { return ""; }
  i32 line = 1;
  i32 col = 1;
  for (i32 i = 0; i < hit; i++) {
    if (src.slice(i, i + 1) == "\n") { line = line + 1; col = 1; } else { col = col + 1; }
  }
  // The wire `render.wac` reads: file, line, col, phase, message, note, hint, width.
  string wire = from + "\t" + itoa(line) + "\t" + itoa(col) + "\tlink\t"
      + "no file was supplied at that path\t" + key + "\t"
      + "supply the file, or check the path — `core` and `std` are the only trees that need none\t"
      + itoa(spec.len() + 2) + "\n";
  return renderDiagnostics(wire, paths, texts);
}

/** One tab-separated field of `line`, or `""`. */
string fieldOf(string line, i32 n) {
  i32 seen = 0;
  string cur = "";
  for (i32 i = 0; i < line.len(); i++) {
    string ch = line.slice(i, i + 1);
    if (ch == "\t") {
      if (seen == n) { return cur; }
      seen = seen + 1;
      cur = "";
      continue;
    }
    cur = cur + ch;
  }
  return seen == n ? cur : "";
}

/** The arrays the API wants: exactly `n` long, since it walks their whole length. */
string[] exactly(string[] xs, i32 n) {
  string[] out = string[n](fill: "");
  for (i32 i = 0; i < n; i++) { out[i] = xs[i]; }
  return out;
}

/**
 * What this compiler answers, as the reader sees it first.
 *
 * **Four commands and one flag were missing from it** — `bindgen`, `-o`, the grants and `--coverage` —
 * so the command that writes a host's glue was undiscoverable and every `build` needed a flag the
 * usage did not mention. `packages/wacc/test/wac/cli_test.wac` holds this against the dispatch and against
 * `spec/cli/wac.md`; the host adds its own commands after these, since each side lists what it
 * implements.
 */
/**
 * The first thing before the entry that looks like a flag and is not one, or "".
 *
 * `unknownFlag`'s twin for `run`, and separate because `run` is the one command with a *tail*: past
 * the entry the arguments are the program's, and `--` is one of them. Scanning the whole line rejected
 * `wac run p.wac -- --allow-read` with "unknown flag '--'" on the JavaScript hosts while the native
 * binary handed the string over as the program asked — found by running the same four command lines
 * through all three, which is what `commandparity_test.wac` now does for this command.
 */
string unknownFlagBefore(Cli cli, i32 argc, string entry) {
  for (i32 i = 1; i < argc; i++) {
    string a = string.fromBytes(cli.arg(i).wait());
    if (a == entry) { return ""; }
    if (a.len() < 2 || a.slice(0, 2) != "--") { continue; }
    if (a != "--allow-read" && a != "--allow-write" && a != "--allow-net" && a != "--allow-env"
        && a != "--allow-run") {
      return a;
    }
  }
  return "";
}

/**
 * Everything after the entry, verbatim, as the argument vector the program receives.
 *
 * **Flags before the entry are this command's; everything after it is the program's.** That is the
 * split `issues/system/0177` settled and the reason this cannot go through `positionals`, which drops
 * anything starting with `-`: `wac run prog.wac --verbose` has to hand `--verbose` over rather than
 * swallow it as a grant this command does not know.
 *
 * The entry's own path is not passed on — argument 0 is the first argument to the *program*, as
 * `docs/your-own-project.md` puts it, because a wac program reads its name from nowhere.
 *
 * A leading `--` is dropped, which is what makes a program able to receive the string `--allow-read`.
 */
u8[][] programArgs(Cli cli, i32 argc, string entry) {
  i32 at = -1;
  for (i32 i = 1; i < argc && at < 0; i++) {
    if (string.fromBytes(cli.arg(i).wait()) == entry) { at = i; }
  }
  if (at < 0) { return u8[][](); }
  i32 from = at + 1;
  if (from < argc && string.fromBytes(cli.arg(from).wait()) == "--") { from = from + 1; }
  i32 n = argc - from;
  if (n < 0) { n = 0; }
  u8[][] out = u8[][n](fill: u8[0]());
  for (i32 i = 0; i < n; i++) { out[i] = cli.arg(from + i).wait(); }
  return out;
}

/**
 * A grant written *after* the entry, which is a program argument and almost never meant as one.
 *
 * `wac run p.wac --allow-read` built an artefact with no grants and passed the flag as `argv[0]`, so
 * the program ran without the capability it asked for and its next sentence was about the bogus
 * argument — `issues/system/0177`. Refused by name instead. The scan stops at `--`, because past that
 * a program may legitimately want the string.
 */
string grantAfterEntry(Cli cli, i32 argc, string entry) {
  i32 at = -1;
  for (i32 i = 1; i < argc && at < 0; i++) {
    if (string.fromBytes(cli.arg(i).wait()) == entry) { at = i; }
  }
  if (at < 0) { return ""; }
  for (i32 i = at + 1; i < argc; i++) {
    string a = string.fromBytes(cli.arg(i).wait());
    if (a == "--") { return ""; }
    if (a == "--allow-read" || a == "--allow-write" || a == "--allow-net" || a == "--allow-env"
        || a == "--allow-run") {
      return a;
    }
  }
  return "";
}

/**
 * A grant this command asks for, from the arguments *before* the entry only.
 *
 * `grantsIn` scans the whole line, which is right for `build` — where everything on it is the
 * command's — and wrong here: `wac run p.wac --allow-net` would build a networked program out of the
 * program's own argument. Refused above rather than honoured, and this is the half that makes the
 * refusal meaningful by not reading past the entry either.
 */
i32 grantsBefore(Cli cli, i32 argc, string entry) {
  i32 bits = 0;
  for (i32 i = 1; i < argc; i++) {
    string a = string.fromBytes(cli.arg(i).wait());
    if (a == entry) { return bits; }
    if (a == "--allow-read") { bits = bits | 1; }
    if (a == "--allow-write") { bits = bits | 2; }
    if (a == "--allow-net") { bits = bits | 4; }
    if (a == "--allow-env") { bits = bits | 8; }
    if (a == "--allow-run") { bits = bits | 16; }
  }
  return bits;
}

/**
 * The grants a built module's own manifest declares, as the bitmask `spawn` takes.
 *
 * **`wac prog.wasm` runs a program with what it declared**, which is a different rule from `spawn`'s
 * "what the parent hands you" — and reading it here is how the two can be the same. `platform.wac`
 * puts the reason plainly: whoever packages the thing chooses what it may do, and the person running
 * it cannot quietly widen that. Passing every grant instead and letting the host intersect would give
 * a module more than it asked for whenever the *command* had been built with more, which is the one
 * outcome that would be a hole rather than a difference.
 *
 * `-1` when the module carries no manifest, which the caller reports rather than treating as "none":
 * a file that is not a wac program and a program that wants nothing are different answers.
 *
 * `packages/json` is already in this program's graph through `wacpkg`, so this costs a call.
 */
i32 declaredGrants(u8[] wasm) {
  string text = manifestIn(wasm);
  if (text == "") { return -1; }
  JsonValue? doc = parse(text.toBytes());
  if (doc is null) { return -1; }
  JsonObject root = JsonObject.create();
  match (doc!) {
    case Object(o): { root = o; }
    else: { return -1; }
  }
  JsonValue? g = root.getStr("grants");
  if (g is null) { return 0; }
  JsonObject table = JsonObject.create();
  match (g!) {
    case Object(o): { table = o; }
    else: { return 0; }
  }
  return (declared(table, "read") ? 1 : 0) | (declared(table, "write") ? 2 : 0)
       | (declared(table, "net") ? 4 : 0) | (declared(table, "env") ? 8 : 0)
       | (declared(table, "run") ? 16 : 0);
}

/** One grant in a manifest's `grants` table. Absent and false are the same answer. */
bool declared(JsonObject table, string name) {
  JsonValue? v = table.getStr(name);
  if (v is null) { return false; }
  match (v!) {
    case Bool(b): { return b; }
    else: { return false; }
  }
}

/**
 * `wac <prog.wasm> [args…]` — run a built module, with the grants its own manifest declares.
 *
 * The whole argument vector after the module is the program's, verbatim: no flags of ours can appear
 * there, because there is nothing here to configure. The native binary passes `args.skip(2)` and this
 * is the same list.
 *
 * The two failure sentences are the native binary's, word for word, because
 * `commandparity_test.wac` compares them. The third one it has — a manifest that is present and not
 * JSON — carries `serde`'s own text there and cannot be reproduced from here, so that case is out of
 * the differential rather than approximated. See `declaredGrants` for why the grants come from the
 * module rather than from this command.
 */
i32 runModule(Core core, Cli cli, i32 argc, string path) {
  FileResult f = cli.readFile(path).wait();
  if (!f.ok) {
    // **The fault's words, not the host's sentence.** `FileResult.error` is "No such file or directory
    // (os error 2)" under Deno, "ENOENT: no such file or directory, open '…'" under Node and a third
    // thing on a page — three spellings of one fact, which is what `FileResult.fault` exists to say and
    // what `faultWords` turns into the one phrase every host uses. The host's own sentence is kept only
    // for a fault with no category, where it is the only thing that knows.
    string words = faultWords(f.fault);
    core.warn("wac: cannot read " + path + " — " + (words == "" ? f.error : words));
    return 1;
  }
  i32 grants = declaredGrants(f.bytes);
  if (grants < 0) {
    core.warn("wac: " + path + " carries no wac.manifest section — build it with "
              + "packages/platform/native.ts");
    return 1;
  }
  u8[][] args = u8[][argc - 1 < 0 ? 0 : argc - 1](fill: u8[0]());
  for (i32 i = 1; i < argc; i++) { args[i - 1] = cli.arg(i).wait(); }
  Child kid = cli.spawn(f.bytes, args, grants, "", true, false).wait();
  if (kid.unavailable()) {
    core.warn("wac: this host cannot run a module — it has no form of `spawn`");
    return 1;
  }
  if (kid.handle < 0) {
    core.warn("wac: cannot run " + path + " — " + kid.error);
    return 1;
  }
  return relay(core, cli, kid);
}

/**
 * Where the generated aggregate goes: `.cache/`, one level down, which is what `aggregateSource`'s
 * single `../` assumes.
 *
 * **Named for the moment it was made**, because two runs in one directory must not write the same
 * path — the native command uses its process id for the same reason and this host offers no such
 * thing to a wac program. The name ends `_test.wac` so that a walk which happens across `.cache`
 * would find something that *is* a test file rather than a fragment.
 */
/**
 * The walked paths as the aggregate can import them: relative to the project, or nothing.
 *
 * **The aggregate lives in `.cache/`, so every import is `../` and then the path.** For a relative
 * path that is right. For an *absolute* one it produced `..//workspace/…/x_test.wac` — a doubled
 * slash and a climb out of the project — and the compile failed on an import nobody wrote. Naming a
 * directory by an absolute path is the ordinary thing to do from a script, so this converts rather
 * than refusing: a path under the current directory is the same file named relatively.
 *
 * Empty when one of them is not under the project. An absolute *import* is not a way out — the
 * resolver drops the leading slash and reads `tmp/…` relative to the importer, so emitting one would
 * turn a clear failure into a confusing one. The caller reports the limitation instead.
 */
string[] importable(Cli cli, string[] walked) {
  string cwd = cli.cwd().wait();
  string prefix = cwd + "/";
  string[] out = string[walked.len()](fill: "");
  for (i32 i = 0; i < walked.len(); i++) {
    string p = walked[i];
    if (p.len() > 0 && p.slice(0, 1) != "/") { out[i] = p; continue; }
    if (p.len() > prefix.len() && p.slice(0, prefix.len()) == prefix) {
      out[i] = p.slice(prefix.len(), p.len());
      continue;
    }
    return string[0]();
  }
  return out;
}

string aggregatePath(Core core, Cli cli) {
  return ".cache/wac-aggregate-" + itoa64(core.monotonicNanos().wait()) + "_test.wac";
}

/**
 * One entry that imports every test file and re-exports its tests, for a single build.
 *
 * **`issues/system/0192`.** A build per test file recompiles the same import graph once per file:
 * `packages/box`'s sixteen files took 40.9s as sixteen builds and 11.1s as one, and the difference is
 * entirely compilation — the assertions in them total under two seconds.
 *
 * Three details each cost the native implementation a wrong first attempt, and are copied rather than
 * rediscovered:
 *
 *   * **the alias must differ from the wrapper's name**, or the wrapper calls itself and the test
 *     recurses until the stack goes;
 *   * **the suffix goes on the end**, because a test that wants a trap is recognised by
 *     `test_traps_` at the *start* and `--filter` matches a substring of the name a person typed;
 *   * **`Core` and `Cli` are imported here**, since the wrappers name them in their own signatures.
 *
 * Sharing one module across files is safe because wac has no module-level variables: a trap unwinds
 * the call and leaves nothing behind, which is the same reason `test_traps_*` has always been able to
 * run beside its neighbours.
 *
 * `up` is one `../` because the aggregate is written into `.cache/`, one level down, and the paths it
 * imports are relative to the working directory.
 */
string aggregateSource(string[] files, string[] texts) {
  string out = "// Generated by `wac test <directory>` — one build for the whole walk.\n"
             + "import { Cli, Core } from \"std/platform.wac\";\n";
  string wrappers = "";
  for (i32 i = 0; i < files.len(); i++) {
    SourceTest[] tests = testsInSource(texts[i]);
    if (tests.len() == 0) { continue; }
    string aliased = "";
    for (i32 k = 0; k < tests.len(); k++) {
      aliased = aliased + (aliased == "" ? "" : ", ")
              + tests[k].name + " as impl" + itoa(i) + "_" + tests[k].name;
      wrappers = wrappers + "export string " + tests[k].name + "__f" + itoa(i)
               + "(" + tests[k].params + ") { return impl" + itoa(i) + "_" + tests[k].name
               + "(" + argsOf(tests[k].params) + "); }\n";
    }
    out = out + "import { " + aliased + " } from \"../" + files[i] + "\";\n";
  }
  return out + "\n" + wrappers;
}

/** Which file a wrapper came from: `name__f3` is file 3. `-1` when it carries no suffix. */
i32 fileOfWrapper(string name) {
  i32 at = -1;
  for (i32 i = 0; i + 3 < name.len(); i++) {
    if (name.slice(i, i + 3) == "__f") { at = i; }
  }
  if (at < 0) { return -1; }
  string digits = name.slice(at + 3, name.len());
  if (digits.len() == 0) { return -1; }
  i32 v = 0;
  u8[] b = digits.toBytes();
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] < '0' || b[i] > '9') { return -1; }
    v = v * 10 + (b[i] - '0');
  }
  return v;
}

/** A wrapper's name without its `__f<n>` suffix, which is what a reader is shown. */
string shownName(string name) {
  i32 at = -1;
  for (i32 i = 0; i + 3 < name.len(); i++) {
    if (name.slice(i, i + 3) == "__f") { at = i; }
  }
  return at < 0 ? name : name.slice(0, at);
}

/** One `test*` export as read from a file's *source*: its name and its parameter list, verbatim. */
struct SourceTest {
  string name;
  /** `Core core, Cli cli`, or empty — copied through to the wrapper so the arity matches. */
  string params;
}

/**
 * The `test*` exports a file declares, read from its text.
 *
 * **A scan, because this runs before anything is compiled** — it is what decides *what* to build, so
 * there is no manifest yet to ask. `runTests` reads the manifest instead and should: by then the
 * module exists and describes itself. Two readers of one fact, and they are answering at two different
 * times rather than duplicating a question.
 *
 * `export string test` at the **start of a line**, so the same words inside a comment or a doc block
 * are prose. A parameter list may span lines and is read to the first `)`; that is safe because the
 * only types a wac test signature carries are `Core` and `Cli`.
 */
SourceTest[] testsInSource(string text) {
  // No cap, for `testFilesIn`'s reason: a file with more tests than the limit would contribute the
  // first few and the rest would vanish from the aggregate without a word.
  Vec<SourceTest> out = Vec.create();
  string mark = "export string test";
  i32 at = 0;
  while (at < text.len()) {
    i32 hit = text.slice(at, text.len()).indexOf(mark);
    if (hit < 0) { break; }
    i32 start = at + hit;
    at = start + mark.len();
    // Only where nothing but whitespace precedes it on its line.
    if (!atLineStart(text, start)) { continue; }
    i32 open = text.slice(start, text.len()).indexOf("(");
    if (open < 0) { break; }
    open = start + open;
    i32 close = text.slice(open, text.len()).indexOf(")");
    if (close < 0) { break; }
    close = open + close;
    string name = trimmedText(text.slice(start + "export string ".len(), open));
    if (!plainName(name)) { continue; }
    out.push(SourceTest(name, trimmedText(text.slice(open + 1, close))));
    at = close + 1;
  }
  return out.toArray();
}

/** Whether only whitespace stands between `at` and the start of its line. */
bool atLineStart(string text, i32 at) {
  for (i32 i = at - 1; i >= 0; i--) {
    string c = text.slice(i, i + 1);
    if (c == "\n") { return true; }
    if (c != " " && c != "\t" && c != "\r") { return false; }
  }
  return true;
}

/** A name a wrapper can be built from: letters, digits and underscores. */
bool plainName(string name) {
  if (name.len() == 0) { return false; }
  u8[] b = name.toBytes();
  for (i32 i = 0; i < b.len(); i++) {
    bool okByte = (b[i] >= 'a' && b[i] <= 'z') || (b[i] >= 'A' && b[i] <= 'Z')
               || (b[i] >= '0' && b[i] <= '9') || b[i] == '_';
    if (!okByte) { return false; }
  }
  return true;
}

/** `s` without leading or trailing whitespace. */
string trimmedText(string s) {
  i32 from = 0;
  i32 to = s.len();
  while (from < to && isBlank(s.slice(from, from + 1))) { from = from + 1; }
  while (to > from && isBlank(s.slice(to - 1, to))) { to = to - 1; }
  return s.slice(from, to);
}

bool isBlank(string c) { return c == " " || c == "\n" || c == "\t" || c == "\r"; }

/** The last word of each comma-separated parameter — `Core core, Cli cli` gives `core, cli`. */
string argsOf(string params) {
  if (trimmedText(params) == "") { return ""; }
  string out = "";
  i32 at = 0;
  while (at <= params.len()) {
    i32 comma = params.slice(at, params.len()).indexOf(",");
    i32 end = comma < 0 ? params.len() : at + comma;
    string one = trimmedText(params.slice(at, end));
    i32 sp = -1;
    for (i32 i = 0; i < one.len(); i++) { if (isBlank(one.slice(i, i + 1))) { sp = i; } }
    if (one != "") { out = out + (out == "" ? "" : ", ") + (sp < 0 ? one : trimmedText(one.slice(sp + 1, one.len()))); }
    if (comma < 0) { break; }
    at = end + 1;
  }
  return out;
}

/**
 * `files` without anything `--ignore` excludes.
 *
 * **A prefix match, as `deno test --ignore` is**, so naming a directory excludes what is under it. The
 * native command applies it to a *named* file too, for a reason worth keeping: `tools/runTests.wac`
 * assembles the targets and the ignore list from one source, and the two must not contradict each
 * other — a caller that gets a different answer for naming one file than for naming its directory has
 * to hold both rules in its head.
 */
string[] withoutIgnored(string[] files, string spec) {
  if (trimmedText(spec) == "") { return files; }
  string[] out = string[files.len()](fill: "");
  i32 n = 0;
  for (i32 i = 0; i < files.len(); i++) {
    bool skip = false;
    i32 at = 0;
    while (at <= spec.len() && !skip) {
      i32 comma = spec.slice(at, spec.len()).indexOf(",");
      i32 end = comma < 0 ? spec.len() : at + comma;
      string one = trimmedText(spec.slice(at, end));
      if (one != "" && (files[i] == one || startsWithPath(files[i], one + "/"))) { skip = true; }
      if (comma < 0) { break; }
      at = end + 1;
    }
    if (!skip) { out[n] = files[i]; n = n + 1; }
  }
  return exactly(out, n);
}

/** Whether `path` begins with `prefix`. */
bool startsWithPath(string path, string prefix) {
  return path.len() >= prefix.len() && path.slice(0, prefix.len()) == prefix;
}

/**
 * Every `*_test.wac` under `dir`, sorted, walked recursively.
 *
 * **The suffix, not the directory.** A `test/` folder holds probes and fixtures as well as tests — of
 * this repository's files under `test/wac`, a large minority export nothing runnable and exist to be
 * driven from a host — so walking directories would report each of them as an error. The naming rule
 * is what makes discovery a question about the file rather than about where it sits, and it is the
 * native command's rule exactly, because a caller assembling both lists must not get two answers.
 *
 * Sorted at each level, so a run is the same twice. `.`-prefixed directories, `node_modules` and
 * `target` are skipped: nothing anybody wants compiled, and `target` in particular is enormous.
 */
string[] testFilesIn(Fs fs, string dir) {
  // **No cap**, because a cap here is a silent truncation and this is a *test* runner: running fewer
  // files and reporting that they passed is the worst answer available. `maxFiles()` bounds a
  // program's import graph and `issues/lang/0158` is the day it was applied by skipping rather than
  // reporting; a growing vector has nothing to skip.
  Vec<string> out = Vec.create();
  walkTests(fs, dir, out);
  return out.toArray();
}

/** One level of the walk, appending into `out`. */
void walkTests(Fs fs, string dir, Vec<string> out) {
  string[]? listed = fs.readDir(dir);
  if (listed is null) { return; }
  string[] names = sortedNames(listed!);
  for (i32 i = 0; i < names.len(); i++) {
    string name = names[i];
    if (name == "" || name.slice(0, 1) == ".") { continue; }
    if (name == "node_modules" || name == "target") { continue; }
    string path = dir + (dir.len() > 0 && dir.slice(dir.len() - 1, dir.len()) == "/" ? "" : "/") + name;
    if (fs.stat(path).isDir) {
      walkTests(fs, path, out);
      continue;
    }
    if (name.len() > 9 && name.slice(name.len() - 9, name.len()) == "_test.wac") {
      out.push(path);
    }
  }
}

/** `names`, sorted — an insertion sort, because a directory is small and this runs per level. */
string[] sortedNames(string[] names) {
  string[] out = string[names.len()](fill: "");
  for (i32 i = 0; i < names.len(); i++) { out[i] = names[i]; }
  for (i32 i = 1; i < out.len(); i++) {
    string v = out[i];
    i32 j = i - 1;
    while (j >= 0 && out[j] > v) { out[j + 1] = out[j]; j = j - 1; }
    out[j + 1] = v;
  }
  return out;
}

/**
 * Every `test*` export a manifest declares, in the order the module declares them.
 *
 * **From the manifest rather than from a scan of the source**, which is the difference between this
 * and `native/v8`'s `test_exports_of`: that reads the file with `match_indices("export string test")`
 * because it runs *before* anything is compiled and has to decide what to build. Here the module is
 * already built and describes itself, so there is nothing to guess and no comment that can look like
 * a declaration. `issues/system/0240c` is what made the module reachable from wac at all.
 */
TestExport[] testExportsIn(string manifest) {
  JsonValue? doc = parse(manifest.toBytes());
  if (doc is null) { return TestExport[0](); }
  JsonObject root = JsonObject.create();
  match (doc!) {
    case Object(o): { root = o; }
    else: { return TestExport[0](); }
  }
  JsonValue? xs = root.getStr("exports");
  if (xs is null) { return TestExport[0](); }
  // No cap, for `testFilesIn`'s reason.
  Vec<TestExport> out = Vec.create();
  match (xs!) {
    case Array(items): {
      for (i32 i = 0; i < items.len(); i++) {
        match (items.get(i)) {
          case Object(e): {
            JsonValue? nm = e.getStr("name");
            if (nm is null) { continue; }
            match (nm!) {
              case Str(bytes): {
                string name = string.fromBytes(bytes);
                if (name.len() > 4 && name.slice(0, 4) == "test") {
                  out.push(TestExport(name, namesCli(e)));
                }
              }
              else: { }
            }
          }
          else: { }
        }
      }
    }
    else: { }
  }
  return out.toArray();
}

/** One `test*` export: its name, and whether it asked for a `Cli`. */
struct TestExport {
  string name;
  /**
   * **Whether it declared `Cli`**, which is what decides if a run with no grants may call it.
   *
   * A test that names no capability cannot be affected by a grant, so it runs whatever was passed;
   * one that names `Cli` and is given nothing would fail on its first call, and failing is the wrong
   * answer to "you forgot a flag". The native host skips it and names the flag; this reads the same
   * fact from the manifest to say the same thing.
   */
  bool needsCli;
}

/** Whether an export's declared parameters include `Cli`. */
bool namesCli(JsonObject e) {
  JsonValue? ps = e.getStr("params");
  if (ps is null) { return false; }
  match (ps!) {
    case Array(items): {
      for (i32 i = 0; i < items.len(); i++) {
        match (items.get(i)) {
          case Str(bytes): { if (string.fromBytes(bytes) == "Cli") { return true; } }
          else: { }
        }
      }
    }
    else: { }
  }
  return false;
}

/**
 * The first flag-looking argument `test` does not know, or "".
 *
 * **Flags in any position**, which is `run`'s opposite and the native command's rule: `wac test
 * packages/fs/ --allow-write` counted the grant as a *file* once, printed a phantom entry that read
 * like a failing test, and ran without the capability — `tools/wac/testcli_test.wac` is that. A test
 * target is a path and a path is not a flag, so there is no tail here for `--` to protect.
 */
string unknownTestFlag(Cli cli, i32 argc, string entry) {
  for (i32 i = 1; i < argc; i++) {
    string a = string.fromBytes(cli.arg(i).wait());
    if (a.len() < 2 || a.slice(0, 2) != "--") { continue; }
    if (a != "--allow-read" && a != "--allow-write" && a != "--allow-net" && a != "--allow-env"
        && a != "--allow-run" && a != "--filter" && a != "--ignore" && a != "--coverage"
        && a != "--verbose") {
      return a;
    }
    // A value-carrying flag's value is not a flag, whatever it looks like.
    if (a == "--filter" || a == "--ignore") { i = i + 1; }
  }
  return "";
}

/** Whether `name` holds `part`. `--filter` matches a substring, as the native command's does. */
bool holds(string name, string part) {
  return part == "" || name.indexOf(part) >= 0;
}

/** The value after a flag, or "" — `--filter passes`. */
string flagValue(Cli cli, i32 argc, string flag) {
  for (i32 i = 1; i + 1 < argc; i++) {
    if (string.fromBytes(cli.arg(i).wait()) == flag) {
      return string.fromBytes(cli.arg(i + 1).wait());
    }
  }
  return "";
}

/**
 * Run one built test module's exports, and answer the exit code.
 *
 * **A test named `test_traps_*` passes by trapping**, which is the convention `native/v8`'s
 * `run_tests` owns and the reason `Cli.call` reports a trap as a value: 389 of this repository's 2553
 * test exports are that shape, and no wac program can catch one. A test with that name that *returns*
 * is a failure — "returned instead of trapping" is the native command's own sentence, matched here
 * because `commandparity_test.wac` compares them.
 */
/**
 * The branch-coverage report a `--coverage` run prints, from the counters and the table beside them.
 *
 * `table` is `index\tline\tcol\tkind\tfile` per counter, in counter order — what `covTableFilesIn`
 * answers and what `wac build --coverage` writes to `<stem>.cov`. `hit[i]` is how many times counter
 * `i` ran, so the two are read together and neither means anything alone.
 *
 * **Points, not lines.** One line can hold two branches and the question is which of them ran, so a
 * per-line count would report half a fact. The native command counts the same way.
 */
/**
 * The report, optionally narrowed to a set of files.
 *
 * **`only` is empty for a single entry and the walked files for a directory**, which is what the
 * native command does and is the more useful answer: a directory walk compiles one aggregate over
 * every test file, so the unnarrowed table is dominated by `std/platform.wac` and reads `6 of 292
 * points (2%)` where the files a person wrote are `4 of 6 (66%)`. The aggregate's own wrapper is in
 * there too, under a `.cache/` name nobody typed.
 *
 * **The skip happens after `i` is counted, not by filtering the table.** `hit[i]` is positional —
 * the table is one row per counter in counter order — so dropping rows before this would slide every
 * later counter onto the wrong point and the percentage would still look plausible.
 */
void sayCoverage(Core core, string table, i32[] hit, string[] only) {
  string[] lines = splitLines(table);
  string[] names = string[lines.len()](fill: "");
  i32[] total = i32[lines.len()]();
  i32[] taken = i32[lines.len()]();
  i32 files = 0;
  i32 points = 0;
  i32 reached = 0;
  for (i32 i = 0; i < lines.len(); i++) {
    if (lines[i] == "") { continue; }
    string file = fieldOf(lines[i], 4);
    if (file == "") { continue; }
    if (only.len() > 0) {
      bool wanted = false;
      for (i32 k = 0; k < only.len(); k++) { if (only[k] == file) { wanted = true; } }
      if (!wanted) { continue; }
    }
    i32 at = -1;
    for (i32 k = 0; k < files; k++) { if (names[k] == file) { at = k; } }
    if (at < 0) { at = files; names[at] = file; files = files + 1; }
    total[at] = total[at] + 1;
    points = points + 1;
    if (i < hit.len() && hit[i] > 0) { taken[at] = taken[at] + 1; reached = reached + 1; }
  }
  if (points == 0) { return; }
  core.log("");
  core.log("branch coverage: " + itoa(reached) + " of " + itoa(points) + " points ("
           + itoa(points == 0 ? 0 : (reached * 100) / points) + "%)");
  for (i32 k = 0; k < files; k++) {
    string left = itoa(taken[k]) + " / " + itoa(total[k]);
    string pad = "";
    for (i32 j = left.len(); j < 10; j++) { pad = pad + " "; }
    core.log("      " + left + pad + names[k]);
  }
}

/** `text` split on newlines. */
string[] splitLines(string text) {
  i32 n = 1;
  for (i32 i = 0; i < text.len(); i++) { if (text.slice(i, i + 1) == "\n") { n = n + 1; } }
  string[] out = string[n](fill: "");
  i32 at = 0;
  i32 k = 0;
  for (i32 i = 0; i <= text.len(); i++) {
    if (i == text.len() || text.slice(i, i + 1) == "\n") {
      out[k] = text.slice(at, i);
      k = k + 1;
      at = i + 1;
    }
  }
  return out;
}

/** Every counter's value, read through the module's own `__cov_len` and `__cov_get`. */
i32[] countersOf(Cli cli, i32 handle) {
  CallResult n = cli.call(handle, "__cov_len", 0);
  if (n.status != 0 || n.value <= 0) { return i32[0](); }
  i32[] out = i32[n.value]();
  for (i32 i = 0; i < n.value; i++) {
    CallResult one = cli.call(handle, "__cov_get", i);
    out[i] = one.status == 0 ? one.value : 0;
  }
  return out;
}

/** What one file's tests came to. */
struct Tally {
  i32 passed;
  i32 failed;
  i32 filtered;
  /** The names skipped for want of a capability, joined — empty when none were. */
  string ungranted;
  i32 ungrantedCount;
}

/**
 * The compiler's export table, plus the three the *instrumentation* injected.
 *
 * **`--coverage` was the native command's alone until 2026-08-24**, and this is why:
 * `__cov_init`, `__cov_len` and `__cov_get` are emitted by the coverage pass rather than written in
 * any source, so nothing put them in the export table and nothing put them in the manifest --
 * and `Cli.call` looks an export up in the manifest to find its signature. It answered "no export
 * named `__cov_len`" for a function the module plainly exports, so a JavaScript-hosted `wac test
 * --coverage` printed `branch coverage: 0 of 270 points (0%)` beside the native's `6 of 270 (2%)`:
 * the table and the totals right and every counter zero, which is a wrong number rather than a
 * missing one. `issues/system/0243c` refused the flag rather than print that.
 *
 * The signatures are not read back out of the module and are not guessed. The instrumentation is
 * this repository's, and `compiler/wasmBuildBin.ts` states them in one line:
 * `__cov_init() -> void, __cov_len() -> i32, __cov_get(i32) -> i32`. All three are inside the closed
 * set `Cli.call` accepts, which is not luck -- that set exists to cover what these commands need.
 *
 * A `name<TAB>ret<TAB>params` line each, with an empty return cell meaning void. Declaring them here
 * rather than teaching the platform about coverage keeps the boundary generic: the compiler is what
 * knows what the compiler injected.
 */
string sigsWithCounters(string sigs, bool covered) {
  if (!covered) { return sigs; }
  return sigs + "__cov_init\t\t\n__cov_len\ti32\t\n__cov_get\ti32\ti32\n";
}

/** ` (12 ms)`, the way the native runner spells a test's wall time under `--verbose`. */
string tookMs(Core core, i64 began) {
  i64 took = (core.monotonicNanos().wait() - began) / 1000000;
  return " (" + itoa64(took) + " ms)";
}

/**
 * Call the named tests on a loaded module and report each one, answering what they came to.
 *
 * Shared by the one-file and the whole-directory paths, which differ in what they print *around* this
 * and not in what a test means. `shown` is the name a reader sees: for a directory the exports carry
 * an `__f<n>` suffix naming the file they came from, and that is bookkeeping rather than the test's
 * name.
 */
Tally runNamed(Core core, Cli cli, i32 handle, TestExport[] names, i32[] which, i32 count,
               i32 grants, string filter, bool loud) {
  i32 passed = 0;
  i32 failed = 0;
  i32 filtered = 0;
  string ungranted = "";
  i32 ungrantedCount = 0;
  for (i32 k = 0; k < count; k++) {
    TestExport t = names[which[k]];
    string shown = shownName(t.name);
    if (!holds(shown, filter)) { filtered = filtered + 1; continue; }
    if (t.needsCli && grants == 0) {
      ungranted = ungranted + (ungranted == "" ? "" : ", ") + shown;
      ungrantedCount = ungrantedCount + 1;
      continue;
    }
    // **Both spellings**, because three other implementations of this rule take both — the native
    // runner, `harness/wacTestRun.ts`, and `packages/wactest/README.md`, which documents it as
    // "`test_traps_` (or `testTraps`)". This one took the first, so a camelCase `testTrapsOnNull`
    // that trapped as its name says was a pass on the native binary and a failure here. Nothing in
    // the repository is named that way today — 392 to 0 — which is why no test noticed.
    bool wantsTrap = (shown.len() > 11 && shown.slice(0, 11) == "test_traps_")
                     || (shown.len() > 9 && shown.slice(0, 9) == "testTraps");
    // The clock only when it will be printed: a run that is not `--verbose` says nothing per test, and
    // this is a host call per test on the JavaScript hosts.
    i64 began = loud ? core.monotonicNanos().wait() : 0 as i64;
    CallResult c = cli.call(handle, t.name, 0);
    // `c.text` is what the *program* said, or empty for an engine trap — a bounds check, a null
    // dereference — which writes nothing. So the message is appended rather than assumed: this read
    // `"— trapped: " + c.text` and left a dangling colon on every engine trap.
    string said = c.text == "" ? "" : ": " + c.text;
    if (c.trapped()) {
      if (wantsTrap) {
        passed = passed + 1;
        if (loud) { core.log("ok   " + shown + " — trapped, as it says" + said + tookMs(core, began)); }
      } else { failed = failed + 1; core.log("FAIL " + shown + " — trapped" + said); }
    } else if (c.status != 0) {
      failed = failed + 1;
      core.log("FAIL " + shown + " — " + c.text);
    } else if (wantsTrap) {
      // The report is ignored on purpose: a test named for a trap that returned cleanly has not
      // observed the thing it is about, and an empty string from it would otherwise read as a pass.
      failed = failed + 1;
      core.log("FAIL " + shown + " — returned instead of trapping"
               + (c.text == "" ? "" : " — " + c.text));
    } else if (c.text != "") {
      failed = failed + 1;
      core.log("FAIL " + shown + " — " + c.text);
    } else {
      passed = passed + 1;
      if (loud) { core.log("ok   " + shown + tookMs(core, began)); }
    }
  }
  return Tally(passed, failed, filtered, ungranted, ungrantedCount);
}

/** The summary one run of tests prints: what passed, what failed, and what was left out. */
void sayTally(Core core, Tally t) {
  core.log(itoa(t.passed) + " passed, " + itoa(t.failed) + " failed"
           + (t.filtered > 0 ? ", " + itoa(t.filtered) + " filtered out" : ""));
}

i32 runTests(Core core, Cli cli, string entry, u8[] whole, string manifest, i32 grants,
             string filter, string[] files, i32 ignored, string target, string covTable, bool loud) {
  // **The tests get what the caller granted, and no more.** `wac test --allow-read` means the tests
  // may read; it does not mean they may write because *this command* can. `load` narrows the world it
  // hands over, and it took a test writing a file to disk to find that it had not been asked to —
  // `issues/system/0242c`.
  LoadedModule m = cli.load(whole, grants);
  if (m.unavailable()) {
    core.warn("wac: this host cannot run tests — `test` needs `load`, which a page has no form of");
    return 1;
  }
  if (m.handle < 0) {
    core.warn("wac: the module just built will not load — " + m.error);
    return 1;
  }
  TestExport[] names = testExportsIn(manifest);
  // **The counter array is allocated by this call, not by instantiation.** Without it every
  // instrumented function traps on its first branch with "dereferencing a null pointer" — a message
  // naming the program under test rather than the missing call, which is what both other hosts
  // learnt the hard way.
  if (covTable != "") { cli.call(m.handle, "__cov_init", 0); }

  // **One file: no headers, no file count.** That is what a person naming one file wants, and it is
  // what the native command prints — the summary below is the whole output.
  if (files.len() == 0) {
    i32[] all = i32[names.len()]();
    for (i32 i = 0; i < names.len(); i++) { all[i] = i; }
    Tally t = runNamed(core, cli, m.handle, names, all, names.len(), grants, filter, loud);
    // **Read before the handle goes.** The counters live in the module, so `unload` is the end of
    // them — and an unloaded handle answers "no such export" rather than failing, so this would have
    // reported a run of nothing as a coverage of zero.
    i32[] hit = covTable != "" ? countersOf(cli, m.handle) : i32[0]();
    cli.unload(m.handle);
    if (t.ungrantedCount > 0) {
      core.log(itoa(t.ungrantedCount) + " test(s) want a capability this run was not granted: "
               + t.ungranted + " — try `wac test --allow-read …`");
      if (t.passed == 0 && t.failed == 0) {
        core.warn("wac: every test in " + entry + " wants a capability this run was not granted — "
                  + "try `--allow-read`");
        return 4;
      }
    }
    if (t.passed == 0 && t.failed == 0 && filter != "") {
      core.log("(no test matches --filter " + filter + ")");
      return 1;
    }
    sayTally(core, t);
    if (covTable != "") { sayCoverage(core, covTable, hit, string[0]()); }
    return t.failed == 0 ? 0 : 3;
  }

  // **A directory: one block per file, in the order they were walked.** The exports carry an `__f<n>`
  // suffix naming the file each came from — `aggregateSource` puts it on the *end* so that
  // `test_traps_` still reads at the start — and this is where that is spent.
  i32 ok = 0;
  i32 withFailures = 0;
  i32 unmatched = 0;
  i32 ungrantedFiles = 0;
  // **Tests, not files**, and counted across the whole walk: a file whose *other* tests passed is
  // `ok` above, so without this a run that skipped seventeen of them would report nothing but `13 ok`.
  i32 ungrantedTests = 0;
  // **Column-aligned**, which needs every name before the first line can be printed.
  string[] failingFiles = string[files.len()](fill: "");
  i32 failingN = 0;
  i32 code = 0;
  for (i32 f = 0; f < files.len(); f++) {
    i32[] mine = i32[names.len()]();
    i32 count = 0;
    for (i32 i = 0; i < names.len(); i++) {
      if (fileOfWrapper(names[i].name) == f) { mine[count] = i; count = count + 1; }
    }
    if (count == 0) { continue; }
    // **No header when the walk found one file**, which is what the native command does and was found
    // by asking it: a fresh project with a single test file printed `── t/x_test.wac` here and nothing
    // there. One file named by a directory reads like one file named directly, plus the summary line
    // that says a directory was walked.
    if (files.len() > 1) { core.log("── " + files[f]); }
    Tally t = runNamed(core, cli, m.handle, names, mine, count, grants, filter, loud);
    if (t.ungrantedCount > 0) {
      core.log(itoa(t.ungrantedCount) + " test(s) want a capability this run was not granted: "
               + t.ungranted + " — try `wac test --allow-read …`");
    }
    // **The file, not the aggregate.** A run with no grants skips every test that wants a world, and
    // the sentence telling you which flag to pass has to name the file you can look at. The native
    // command named its own generated aggregate here until 2026-08-24 — a path the caller never typed
    // and cannot open. `issues/system/0230a`'s differential is what made that visible.
    bool allUngranted = t.ungrantedCount > 0 && t.passed == 0 && t.failed == 0;
    if (allUngranted) {
      core.warn("wac: every test in " + files[f] + " wants a capability this run was not granted — "
                + "try `--allow-read`");
    }
    // **Per file, not once for the walk.** A filter that matched nothing *here* is worth saying about
    // this file; `0 passed, 0 failed, 2 filtered out` says the same thing in a shape that reads like a
    // file that has emptied itself.
    bool nothingMatched = t.passed == 0 && t.failed == 0 && filter != "";
    // **No tally under a file that ran nothing.** `0 passed, 0 failed` after "every test here wants a
    // capability" is the same fact twice, and the second telling reads like a file with no tests in it.
    if (allUngranted) {
      // The message above is this file's whole report.
    } else if (nothingMatched) {
      core.log("(no test matches --filter " + filter + ")");
    } else {
      sayTally(core, t);
    }
    if (t.failed > 0) {
      withFailures = withFailures + 1;
      failingFiles[failingN] = files[f];
      failingN = failingN + 1;
      if (code == 0) { code = 3; }
    } else if (allUngranted) {
      // **Its own kind.** A file that ran nothing for want of a flag is not `ok`, and it is not
      // "needing a host oracle" either: an oracle needs a host and a capability needs a flag on this
      // command line, so a reader told the wrong one goes looking for the wrong thing.
      ungrantedFiles = ungrantedFiles + 1;
      ungrantedTests = ungrantedTests + t.ungrantedCount;
    } else if (nothingMatched) {
      // **Counted apart from `ok`.** A file the filter emptied has not passed; calling it ok would
      // report a run of nothing as a run of everything, which is the shape a `--filter` typo takes.
      unmatched = unmatched + 1;
    } else {
      ok = ok + 1;
      ungrantedTests = ungrantedTests + t.ungrantedCount;
    }
  }
  // **Read before the handle goes**, for the reason the single-file branch above gives: the counters
  // live in the module and `unload` is the end of them.
  //
  // **`--coverage` over a directory did nothing here until 2026-08-25**, which is the shape this
  // command keeps producing: the flag was accepted, the run happened, and no report was printed —
  // where the native command answers with the table. One aggregate module means one counter array for
  // the whole walk, so this is the same two calls the single-file branch makes.
  i32[] hit = covTable != "" ? countersOf(cli, m.handle) : i32[0]();
  cli.unload(m.handle);
  // **Nothing matched anywhere is a mistake, not a clean walk.** Per file the message says which file
  // the filter emptied; across the whole walk it says the pattern found nothing at all, and exits
  // non-zero, because `N files: 0 ok` under a filter reads like a suite that passed.
  if (unmatched > 0 && ok == 0 && withFailures == 0) {
    // The blank line the summary would have had: the per-file blocks above end flush against it
    // otherwise, and this message is the summary in the case where there is nothing to summarise.
    core.log("");
    core.warn("wac: no test anywhere under " + target + " matches --filter " + filter);
    return 1;
  }
  // The report goes between the blocks and the summary, where the native command puts it, and it
  // opens with the blank line the summary would otherwise have printed for itself.
  if (covTable != "") { sayCoverage(core, covTable, hit, files); }
  // The blank line separates the per-file blocks from the summary, and there are no blocks to
  // separate when the walk found one file — the native command prints none there either.
  else if (files.len() > 1) { core.log(""); }
  // **One section of the native command's output is missing here, and cannot be written.** After the
  // summary it ranks the files that cost a second or more:
  //
  //     1 file(s) cost a second or more of CPU to run — the other 4 did not:
  //         1.1s cpu ( 1.1s here,  0.0s in children)   1.0s wall  src/nested/deep_test.wac
  //
  // That is *CPU* time, split between this process and its children, which is `getrusage` and not
  // something the platform offers a wac program — `Core` has a wall clock and no accounting. Wall
  // time alone would be a different number under a different name, which is worse than an absence.
  // It is a diagnostic aid rather than part of the result, so a walk that takes under a second a file
  // — every case in `commandparity_test.wac` — agrees anyway. `issues/system/0230a`.
  //
  // `1 file:` and `4 files:`, as the native command spells them. `file(s)` is the spelling that
  // avoids the choice, and it is a different sentence from the one this has to match.
  i32 total = ok + withFailures + unmatched + ungrantedFiles;
  core.log(itoa(total) + (total == 1 ? " file: " : " files: ") + itoa(ok) + " ok"
           + (ignored > 0 ? ", " + itoa(ignored) + " not run (--ignore)" : "")
           + (withFailures > 0 ? ", " + itoa(withFailures) + " with failures" : "")
           + (ungrantedFiles > 0 ? ", " + itoa(ungrantedFiles) + " needing a grant" : "")
           + (ungrantedTests > 0 ? ", " + itoa(ungrantedTests) + " test(s) skipped for a grant" : "")
           + (unmatched > 0 ? ", " + itoa(unmatched) + " with nothing matching --filter" : ""));
  if (failingN > 0) {
    i32 wide = 0;
    for (i32 i = 0; i < failingN; i++) {
      if (failingFiles[i].len() > wide) { wide = failingFiles[i].len(); }
    }
    string block = "";
    for (i32 i = 0; i < failingN; i++) {
      string pad = "";
      for (i32 k = failingFiles[i].len(); k < wide; k++) { pad = pad + " "; }
      block = block + "\n   " + failingFiles[i] + pad + "   failures";
    }
    core.log(block);
  }
  return code;
}

/**
 * Relay a child's two streams until both end, then answer its exit code.
 *
 * **Both, in the order they arrive.** One `recv` in flight per open stream and `waitAny` over the
 * pair, which is `packages/sh/src/exec.wac`'s shape: draining one to exhaustion first would put every
 * complaint after every line of output, and a program that interleaves them — which is most of them,
 * on failure — would be unreadable.
 *
 * The native binary's `run` does not relay at all: it instantiates the module in its own process, so
 * the program writes to the real streams. This is the same bytes on each stream and the same status,
 * which is what `commandparity_test.wac` compares, and it is not the same thing — a program wanting a
 * terminal sees a pipe here. Said plainly because it is the one place the two implementations differ
 * in kind rather than in code. `issues/system/0230a`.
 */
i32 relay(Core core, Cli cli, Child kid) {
  Pending<Read> out = cli.recv(kid.handle);
  Pending<Read> err = cli.recv(kid.errHandle);
  bool reading = true;
  bool readingErr = true;
  while (reading || readingErr) {
    i32[] live = i32[reading && readingErr ? 2 : 1]();
    i32 n = 0;
    if (reading) { live[n] = out.id; n = n + 1; }
    if (readingErr) { live[n] = err.id; }
    // No deadline: there is nothing to do between chunks, and a poll would only burn a core.
    i32 which = core.waitAny(live, -1);
    if (which < 0) { break; }
    if (reading && which == 0) {
      match (out.wait()) {
        case Data(bytes): { cli.write(bytes); out = cli.recv(kid.handle); }
        case End: { reading = false; }
        case Failed(why): { core.warn("wac: " + why); reading = false; }
      }
    } else {
      match (err.wait()) {
        case Data(bytes): { cli.writeErr(bytes); err = cli.recv(kid.errHandle); }
        case End: { readingErr = false; }
        case Failed(why): { core.warn("wac: " + why); readingErr = false; }
      }
    }
  }
  return cli.exitCode(kid.handle).wait();
}

string usage() {
  return "usage: wac check|compile|bindgen <entry.wac> [out]   # --js for bindgen's glue\n"
       + "       wac build <entry.wac> -o <stem> [--coverage|--trace [--trace-slots n]] [--quiet]\n"
       + "                [--allow-read] [--allow-write] [--allow-net] [--allow-env] [--allow-run]\n"
       + "       wac run [--allow-read] [--allow-write] [--allow-net] [--allow-env] [--allow-run]\n"
       + "                <entry.wac> [args…]   compile and run it, with no file in between;\n"
       + "                a grant goes before the entry, and after `--` an argument is the\n"
       + "                program's, whatever it looks like\n"
       + "       wac test [--allow-read] [--allow-write] [--allow-net] [--allow-env] [--allow-run]\n"
       // The flags this actually takes, which is what the native binary was printing *after* this
       // block because these two lines were narrower than the truth — so `wac --help` listed `run`
       // and `test` twice, with two different accounts of `test`. Reported against an external
       // project on 2026-08-25. One list, and it is this one.
       + "                [--coverage] [--filter <name>] [--ignore <path,…>] [--verbose] [path…]\n"
       + "                run `test*()` exports; paths may be files or directories";
}

/**
 * The usage for one command, for when the command is known and its entry is not.
 *
 * `wac run` on its own used to print the whole block, which is four commands' worth of flags to
 * answer a question about one. The native binary already printed the single line; this is the same
 * line, so the two hosts agree on it — `commandparity_test.wac` has the case.
 */
string usageFor(string cmd) {
  if (cmd == "run") {
    return "usage: wac run [--allow-read] [--allow-write] [--allow-net] [--allow-env] "
         + "[--allow-run] <entry.wac> [args…]";
  }
  return usage();
}

/**
 * The arguments that are not flags: the entry, and for `compile` the output path after it.
 *
 * **The entry used to be whatever was at argument 1**, so `wac build --allow-read p.wac` answered
 * *cannot read --allow-read* — a sentence about a file, about a command line. `wac run` takes its
 * grants before the entry and this took them after, so the two commands excluded each other's order.
 * They overlap now: a flag is a flag wherever it is written, and the entry is the first thing that is
 * not one. `issues/system/0177`.
 *
 * `-o` is the one flag carrying a value, and skipping the flag without its value would leave the stem
 * looking like the entry — which is the same class of mistake one level along.
 */
string[] positionals(Cli cli, i32 argc) {
  string[] out = string[argc](fill: "");
  i32 n = 0;
  i32 i = 1;
  while (i < argc) {
    string a = string.fromBytes(cli.arg(i).wait());
    // **Three flags carry a value**, and skipping the flag without its value leaves the value looking
    // like the entry. `--filter passes src/x_test.wac` reported *cannot read passes* — a sentence
    // about a file, about a pattern — which is `issues/system/0177`'s mistake one level along.
    if (a == "-o" || a == "--trace-slots" || a == "--filter" || a == "--ignore") {
      i = i + 2;
      continue;
    }
    if (a.len() > 0 && a.slice(0, 1) == "-") { i = i + 1; continue; }
    out[n] = a;
    n = n + 1;
    i = i + 1;
  }
  return exactly(out, n);
}

/**
 * The grants a `build` was asked for, as the bitmask `platform.wac` uses.
 *
 * The same four flags `deno task app:native` takes, and they mean the same thing: whoever packages
 * the program chooses what it may do, and the person running it cannot quietly widen that. A flag
 * this does not recognise is not silently ignored — see `unknownFlag`.
 *
 * **From 1, not from 2.** Argument 1 was the entry by position, so nothing looked there for a flag —
 * and once the entry stopped being positional, a grant written first was read by nobody and the
 * artefact came out sealed with no complaint. Every scan below starts where the arguments start.
 */
i32 grantsIn(Cli cli, i32 argc) {
  i32 bits = 0;
  for (i32 i = 1; i < argc; i++) {
    string a = string.fromBytes(cli.arg(i).wait());
    if (a == "--allow-read") { bits = bits | 1; }
    if (a == "--allow-write") { bits = bits | 2; }
    if (a == "--allow-net") { bits = bits | 4; }
    if (a == "--allow-env") { bits = bits | 8; }
    // Running a host program — `Cli.exec`. Its own bit and its own grant, not `write`'s: a build
    // that may start a confined wasm module must be able to refuse a host binary without refusing
    // both. `issues/system/0165`.
    if (a == "--allow-run") { bits = bits | 16; }
  }
  return bits;
}

/** Whether an argument is there at all. */
bool hasFlag(Cli cli, i32 argc, string flag) {
  for (i32 i = 1; i < argc; i++) {
    if (string.fromBytes(cli.arg(i).wait()) == flag) { return true; }
  }
  return false;
}

/** The first argument that looks like a flag and is not one, or "". */
string unknownFlag(Cli cli, i32 argc) {
  for (i32 i = 1; i < argc; i++) {
    string a = string.fromBytes(cli.arg(i).wait());
    if (a.len() < 2 || a.slice(0, 2) != "--") { continue; }
    if (a != "--allow-read" && a != "--allow-write" && a != "--allow-net" && a != "--allow-env"
        && a != "--allow-run" && a != "--quiet" && a != "--js" && a != "--coverage"
        && a != "--trace" && a != "--trace-slots" && a != "--no-cache") {
      return a;
    }
  }
  return "";
}

/**
 * The number after `--trace-slots`, or 0 for the compiler's own size.
 *
 * **A journal a caller can size is why this exists.** The default is 2^22 events, and a routine that
 * produces more cannot be checked for secret dependence at all — the routines that overflow being
 * exactly the ones designed to be expensive. A KDF's cost is the function rather than a parameter of
 * it: one bcrypt hash is 8.2 million events. `wac tracestat` reports what a run *wanted*, so the
 * second attempt is sized rather than doubled. `issues/lang/0059`.
 */
i32 traceSlots(Cli cli, i32 argc) {
  for (i32 i = 1; i + 1 < argc; i++) {
    if (string.fromBytes(cli.arg(i).wait()) != "--trace-slots") { continue; }
    u8[] d = string.fromBytes(cli.arg(i + 1).wait()).toBytes();
    if (d.len() == 0) { return 0; }
    i32 v = 0;
    for (i32 k = 0; k < d.len(); k++) {
      if (d[k] < 48 || d[k] > 57) { return 0; }
      v = v * 10 + (d[k] - 48);
    }
    return v;
  }
  return 0;
}

/** The value after `-o`, or "". */
string outStem(Cli cli, i32 argc) {
  for (i32 i = 1; i + 1 < argc; i++) {
    if (string.fromBytes(cli.arg(i).wait()) == "-o") {
      return string.fromBytes(cli.arg(i + 1).wait());
    }
  }
  return "";
}

/** What the manifest calls the module it sits beside: the stem's own name, without its directory. */
string baseName(string path) {
  i32 at = -1;
  for (i32 i = 0; i < path.len(); i++) {
    if (path.slice(i, i + 1) == "/") { at = i; }
  }
  return at < 0 ? path : path.slice(at + 1, path.len());
}

/** `path.wac` without its extension, which is what the generated names are built on. */
string stem(string entry) {
  i32 n = entry.len();
  return n > 4 && entry.slice(n - 4, n) == ".wac" ? entry.slice(0, n - 4) : entry;
}

/** Several lines as one, for a warning that names them all. */
string oneLine(string text) {
  string out = "";
  for (i32 i = 0; i < text.len(); i++) {
    string ch = text.slice(i, i + 1);
    if (ch == "\n") {
      if (i + 1 < text.len()) { out = out + "; "; }
      continue;
    }
    out = out + ch;
  }
  return out;
}

/** `path.wac` becomes `path.wasm`; anything else gains `.wasm`. */
string wasmBeside(string entry) {
  i32 n = entry.len();
  if (n > 4 && entry.slice(n - 4, n) == ".wac") { return entry.slice(0, n - 4) + ".wasm"; }
  return entry + ".wasm";
}

export i32 main(Core core, Cli cli) {
  i32 argc = cli.argCount().wait();
  if (argc < 1) {
    core.warn(usage());
    return 2;
  }
  string cmd = string.fromBytes(cli.arg(0).wait());

  // **A module is a program, and that is decided by what the first argument *is*.** `wac prog.wasm`
  // is the most basic thing this command does and it worked only on the native binary until
  // 2026-08-22 — the other two printed the usage block at somebody holding a built program.
  // `issues/system/0230a`: the hosts should differ in what they are, not in what they answer.
  //
  // Before the command check on purpose, exactly as the native binary orders it: a name ending in
  // `.wasm` is a program *claim* whether or not the file is there, so a mistyped path is reported as
  // a missing file rather than reaching the compiler and coming back as "unknown command
  // 'prog.wasm'" — a message about the wrong thing entirely.
  if (cmd.len() > 5 && cmd.slice(cmd.len() - 5, cmd.len()) == ".wasm") {
    return runModule(core, cli, argc, cmd);
  }

  // **After the module check, because a module is a complete invocation on its own.** This guard was
  // first, so `wac prog.wasm` — one argument — printed the usage block without ever looking at what
  // that argument was. The command is known even when nothing else is, so say what *it* takes.
  if (argc < 2) {
    core.warn(usageFor(cmd));
    return 2;
  }
  // **Normalised once, here, because every later use has to agree with every other.** The map is
  // keyed by resolved paths and `resolveFrom` collapses `.` and `..`; the entry reached
  // `diagnoseGraphRendered` and the emitter as typed, so `wac test ./a/b.wac` built a map keyed
  // `a/b.wac` and then asked about `./a/b.wac` — "an import of a file that was not supplied", about
  // a file that was. `issues/lang/0134`.
  //
  // A leading `./` is what tab completion produces, so the spelling most likely to be typed was the
  // one that did not work.
  string[] pos = positionals(cli, argc);
  if (pos.len() < 1) {
    core.warn(usageFor(cmd));
    return 2;
  }
  string entry = normalisePath(pos[0]);

  // **The command is checked before the entry is read.** This test used to sit after the graph was
  // gathered and the diagnostics printed, so a line with two mistakes in it was answered about the
  // wrong one: `wacc chekc nope.wac` reported *cannot read nope.wac* and exited 1, diagnosing the
  // typo you did not make and giving a compile-failure code for a usage mistake. Whether a usage
  // error is reported as one should not depend on an unrelated path happening to exist.
  if (cmd != "check" && cmd != "compile" && cmd != "build" && cmd != "bindgen" && cmd != "run"
      && cmd != "test") {
    core.warn("wacc: unknown command '" + cmd + "' — check, compile, build, bindgen, run or test");
    return 2;
  }

  Fs fs = Fs.onHost(cli, 0);

  // **A directory becomes one generated entry, before anything is compiled.** `wac test <dir>` walks
  // for `*_test.wac` and writes an aggregate that imports every one of them and re-exports its tests;
  // from here down the command is the single-file command, compiling that file. `issues/system/0192`
  // is why one build rather than one per file: `packages/box`'s sixteen files were 40.9s as sixteen
  // builds and 11.1s as one, and the difference is all compilation.
  //
  // The walk is not a *test* of anything, so a directory with no `*_test.wac` in it says so here
  // rather than failing to read a file nobody named.
  string[] walked = string[0](fill: "");
  // **What the caller typed**, kept because `entry` is about to stop being it: a directory target is
  // rewritten to the generated aggregate, and a message naming that names a file nobody asked about.
  string target = entry;
  // How many the `--ignore` list took out, which the summary reports: "there were none" and "you
  // excluded them all" are different answers to the same count.
  i32 ignoredCount = 0;
  if (cmd == "test" && fs.stat(entry).isDir) {
    string[] found = testFilesIn(fs, entry);
    walked = withoutIgnored(found, flagValue(cli, argc, "--ignore"));
    ignoredCount = found.len() - walked.len();
    if (walked.len() == 0) {
      // **Said differently when `--ignore` is what emptied it.** "No tests under src" is a wrong
      // answer when there were some and this run excluded every one, and it sends the reader looking
      // for a naming mistake that is not there. The native command's distinction, and its wording.
      if (ignoredCount > 0) {
        core.warn("wac: --ignore excluded all " + itoa(ignoredCount) + " test file(s) under " + entry);
      } else {
        core.warn("wac: no tests under " + entry + " — a test file is named `*_test.wac` and exports "
                  + "`test*()` answering a string, empty for a pass");
      }
      return 1;
    }
    string aggregate = aggregatePath(core, cli);
    string[] texts = string[walked.len()](fill: "");
    for (i32 i = 0; i < walked.len(); i++) {
      FileResult one = cli.readFile(walked[i]).wait();
      if (!one.ok) {
        core.warn("wac: cannot read " + walked[i] + " — " + one.error);
        return 1;
      }
      texts[i] = string.fromBytes(one.bytes);
    }
    // **`.cache/` is made, not assumed.** A fresh project has never built anything, so the directory
    // the aggregate goes in does not exist and `writeFile` answered "No such file or directory" —
    // naming a path the caller had not chosen, for a file they did not know existed. Reported against
    // an external project on 2026-08-25; the native command never hit it because it writes its
    // aggregate to a temporary directory of its own.
    Change made = cli.mkdir(".cache", true).wait();
    if (!made.ok()) {
      core.warn("wac: cannot make .cache for the test aggregate — " + made.message);
      return 1;
    }
    string[] imports = importable(cli, walked);
    if (imports.len() == 0) {
      core.warn("wac: `test <directory>` needs the directory to be inside the project — "
                + walked[0] + " is not under " + cli.cwd().wait());
      return 2;
    }
    Change wrote = cli.writeFile(aggregate, aggregateSource(imports, texts).toBytes()).wait();
    if (!wrote.ok()) {
      core.warn("wac: cannot write the aggregate " + aggregate + " — " + wrote.message);
      return 1;
    }
    entry = aggregate;
  }

  Sources src = gather(fs, cli, entry);
  if (src.missing != "" || src.why != "") {
    core.warn(src.why != "" ? "wacc: " + src.why : "wacc: cannot read " + src.missing);
    return 1;
  }
  string[] paths = exactly(src.paths, src.n);
  string[] texts = exactly(src.texts, src.n);
  Res res = Res(exactly(src.roots, src.n),
                exactly(src.mapFrom, src.mapN), exactly(src.mapSpec, src.mapN),
                exactly(src.mapTo, src.mapN), src.base);

  // **The artefact this build would write, if it has been written before.** `issues/system/0204`:
  // `wac build` compiled from source every time, and the box tests that build an application and run
  // it pay ~2 s of that per run — which is what stops the rest of `issues/system/0161` converting.
  //
  // Above the compile and below the gather, because the sources *are* the key: there is no way to know
  // a build is a repeat without reading what it reads. Gathering is the cheap half.
  string cachePath = buildCachePath(cli, argc, cmd, entry, paths, texts, outStem(cli, argc));
  if (cachePath != "") {
    FileResult hit = fs.readFile(cachePath);
    if (hit.ok && hit.bytes.len() > 8) {
      string stemHit = outStem(cli, argc);
      Change wroteHit = fs.writeFile(stemHit + ".wasm", hit.bytes);
      if (!wroteHit.ok()) {
        core.warn("wacc: cannot write " + stemHit + ".wasm — " + wroteHit.message);
        return 1;
      }
      // **A hit says so.** This printed the line a real build prints, so nothing downstream could tell
      // a compile from a lookup — which is how a determinism test came to pass without compiling
      // anything. `--no-cache` is the way to refuse one; naming it here is what lets a caller *check*
      // that it worked, rather than trusting that it did.
      if (!hasFlag(cli, argc, "--quiet")) {
        core.log(stemHit + ".wasm: " + itoa(hit.bytes.len()) + " bytes from cache, "
                 + itoa(src.n) + " file(s) unchanged");
      }
      return 0;
    }
  }

  // Diagnostics first for either command: compiling a program the checker refuses would write a
  // module built from a tree nobody approved.
  //
  // **Rendered, not the wire.** This printed `file\tline\tcol\tphase\t…` at a person until
  // `src/render.wac` — the compiler could build this repository and could not say what was wrong
  // with a file. `test/wac/renderdiag_test.wac` holds it to the layout `waccx` prints.
  //
  // **Every file, not just the entry.** One checking pass walks only the entry's bodies, so a type
  // error in an imported file was silent — and the emitter, which compiles every body, wrote a
  // module that failed validation with a wasm-level mismatch in place of a source line
  // (`issues/lang/0118`). That is as true of `compile` as of `check`: writing a module nobody
  // approved is the thing the diagnostics are here to prevent.
  // **Printed together, decided on separately** — `issues/lang/0126`. This returned 1 whenever the
  // rendered string was non-empty, which is right for errors and refuses a program that merely warns.
  // So the wire is taken once, rendered for the reader, and asked whether anything in it was an
  // error. One pass: rendering and deciding from the same string is what stops this being the second
  // whole-graph walk `issues/lang/0133` was about.
  string wire = diagnoseGraphIn(paths, texts, res, entry);
  string diags = renderDiagnostics(wire, paths, texts);
  if (diags != "") { core.warn(diags); }
  if (wireHasErrors(wire)) { return 1; }
  if (cmd == "check") {
    core.log(entry + ": " + itoa(src.n) + " file(s), no diagnostics");
    return 0;
  }

  // **One front end for the whole build**, which is what `buildFiles` exists for — `issues/lang/0129`
  // made that call and this was the caller still not using it.
  //
  // What this used to do was ask four separate questions of four separate front ends: `blockedFiles`
  // for what the emitter declines, `emitFiles` for the module, and — inside `manifestFiles` below —
  // `bindTypesLinked` and `exportSigsLinked` for the boundary. Each takes `(paths, sources, entry)`
  // and builds its own, because this compiler does no I/O and holds nothing between calls. With
  // `diagnoseGraph` above that is **five whole-graph walks to produce one module**, and it is why
  // `wac build` on this compiler took 4.7 s while the same emit under a host that calls the library
  // directly took 0.5 s. The browser's bootstrap page has always shown the honest number.
  //
  // `Built.described` carries all three of the answers the walks were for, separated by
  // `describeSeparator()`, in the order `describeFiles` documents: blocked, signatures, bind types.
  //
  // **An instrumented module is a different module**, and asking for one is the build's decision:
  // `emitFilesCovered` writes a counter per branch point, and `covTableFiles` says what each counter
  // is. Both or neither — a table without the counters describes a module that does not exist. That
  // path keeps the separate calls, because there is no folded form of it and a coverage build is
  // something a person waits for on purpose.
  bool covered = hasFlag(cli, argc, "--coverage");
  // **`--trace` is the other instrumented build**, and it is the same three exports meaning something
  // else: a journal of `(site, value)` in the order events happened rather than a count per point.
  // `wac ctcompare` reads it. The two cannot be asked for together — they are one counter array, and a
  // build that tried to be both would answer whichever question was asked last.
  bool traced = hasFlag(cli, argc, "--trace");
  if (covered && traced) {
    core.warn("wacc: --coverage and --trace are one counter array; ask for one of them");
    return 2;
  }
  string blocked = "";
  string sigs = "";
  string types = "";
  u8[] wasm = u8[0]();
  if (covered || traced) {
    // **`*In` where the callee reads `res`, plain where it does not.** `blockedFilesIn`,
    // `exportSigsFilesIn` and `bindTypesFilesIn` pass the carrier through to the linker, so a
    // `@/` or a mapped import resolves the same way it did when the graph was gathered — that is
    // `design/lang/0009` D7. The traced emitters have no `In` variant yet and build a `Res.empty()`
    // of their own, so a traced build of a program using either feature resolves from nothing.
    blocked = blockedFilesIn(paths, texts, res, entry);
    i32 slots = traceSlots(cli, argc);
    wasm = covered ? emitFilesCoveredIn(paths, texts, res, entry)
                   : (slots > 0 ? emitFilesTracedSlots(paths, texts, entry, slots)
                                : emitFilesTraced(paths, texts, entry));
    sigs = exportSigsFilesIn(paths, texts, res, entry);
    types = bindTypesFilesIn(paths, texts, res, entry);
  } else {
    Built built = buildFilesIn(paths, texts, res, entry);
    Described parts = describedParts(built.described);
    blocked = parts.blocked;
    sigs = parts.sigs;
    types = parts.types;
    wasm = built.wasm;
  }
  // **What the emitter declines is not a diagnostic**, and saying so is the difference between a
  // module that is missing a function and a message about which one. Answered from the shared front
  // end rather than from one of its own; the module beside it is discarded unread when this fires,
  // which is the one case where folding the walks does work that used to be skipped.
  if (blocked != "") {
    // **One decline can be pointed at, so it is.** A missing import is the one refusal the linker can
    // locate: it knows the key, the file that asked and the specifier as written — and the specifier is
    // what makes a position findable *by comparison*, without resolving anything, which is the step
    // that cannot be redone soundly inside a mapped checkout. `issues/lang/0157`.
    string parts = missingImportFilesIn(paths, texts, res, entry);
    if (parts != "") {
      string shown = positionedMissingImport(parts, paths, texts);
      if (shown != "") { core.warn(shown); return 1; }
    }
    core.warn("wacc: cannot emit " + entry + " — " + blocked);
    return 1;
  }

  // **A module with no sections is not a module.** `blocked` above is the emitter *declining*, with a
  // reason in words. This is the emitter answering with the eight-byte header and nothing after it, which
  // has happened: `issues/lang/0154` reaches it, and the build reported `73846 bytes from 72 file(s)` and
  // exited 0, because the manifest section appended to a bare header makes the file look substantial. The
  // size line is the one number a person checks, and it agreed with the failure.
  //
  // So: nothing written, and a non-zero exit. `issues/lang/0155`.
  if (wasm.len() <= 8) {
    core.warn("wacc: the emitter produced no code for " + entry + " — " + itoa(wasm.len()) +
              " bytes is the wasm header and no sections at all, so nothing was written. Nothing was " +
              "declined either, which is what makes this a defect in the emitter rather than in the " +
              "program: issues/lang/0154 is the one known way to reach it.");
    return 1;
  }

  // **`bindgen` writes the glue a host calls the module through**, beside the entry — `main.gen.ts`,
  // or `main.gen.js` with `--js`, since a browser cannot import TypeScript. What it cannot bind is
  // reported rather than skipped: a caller told `makeP(i32) -> P` was declined can change the
  // signature, and one handed glue missing a function finds out at the call site.
  if (cmd == "bindgen") {
    bool js = hasFlag(cli, argc, "--js");
    string declined = bindgenDeclinedFilesIn(paths, texts, res, entry);
    if (declined != "") {
      core.warn("wacc bindgen: not bound yet — " + oneLine(declined));
    }
    // From the metadata already in hand: `bindgenFiles` would build two more front ends to derive
    // exactly these two strings.
    string glue = bindgenWire(wasm, sigs, types, js ? "js" : "ts");
    string out = stem(entry) + (js ? ".gen.js" : ".gen.ts");
    Change wroteGlue = fs.writeFile(out, glue.toBytes());
    if (!wroteGlue.ok()) {
      core.warn("wacc: cannot write " + out + " — " + wroteGlue.message);
      return 1;
    }
    if (!hasFlag(cli, argc, "--quiet")) {
      core.log(out + ": " + itoa(glue.len()) + " bytes");
    }
    return 0;
  }

  // **`build` is `compile` plus the boundary.** A native host cannot run a module without knowing
  // which `$bind$` export builds `Core` and in what order its funcrefs go, so an application is a
  // module *and* a manifest — `deno task app:native` in one command, which is what lets this binary
  // produce the artefact it is itself made of.
  // **`test` — one file, and it runs where `load` runs.** `issues/system/0230a` step 5.
  //
  // The whole of it is: the module is already compiled by the lines above, so wrap it in its manifest,
  // load it, and call every `test*` the manifest declares. `Cli.load` is what made that expressible
  // (`issues/system/0240c`) — before it, a wac program could start a *program* and not call a
  // *function*, and a test is a function.
  //
  // **One file, not a directory, and the summary says so by not being printed.** `wac test <dir>` on
  // the native binary walks for `*_test.wac`, builds one aggregate module for the whole directory and
  // prints `N files: …` as well. That aggregate is the part still to come; a caller naming one file
  // gets the same output from either host today, which is what `commandparity_test.wac` holds.
  //
  // `--coverage` is not here and is not silently ignored: the counters are reached through
  // `__cov_init`/`__cov_len`/`__cov_get`, which `call` accepts — three of its four shapes — so this is
  // work rather than a gap in the boundary.
  if (cmd == "test") {
    string badFlag = unknownTestFlag(cli, argc, entry);
    if (badFlag != "") {
      core.warn("wac: unknown flag '" + badFlag + "' — --allow-read, --allow-write, --allow-net, "
                + "--allow-env, --allow-run, --filter");
      return 2;
    }
    // **`--coverage` for one file.** The shared compile above has already emitted an instrumented
    // module when it was asked for, so the whole of it here is: initialise the counters before the
    // tests, read them after, and pair them with the table. A *directory* under `--coverage` is still
    // the native command's alone, and for its reason rather than mine: the counters are per module and
    // the table is written beside it, so one aggregate would report the first file's positions for all
    // of them. That path needs a build per file, which this command does not do yet.
    i32 grants = grantsIn(cli, argc);
    string manifest = manifestWire(wasm, types, sigsWithCounters(sigs, covered), entry,
                                  baseName(stem(entry)) + ".wasm", grants);
    i32 code = runTests(core, cli, entry, withManifestSection(wasm, manifest), manifest, grants,
                        flagValue(cli, argc, "--filter"), walked, ignoredCount, target,
                        covered ? covTableFilesIn(paths, texts, res, entry) : "",
                        hasFlag(cli, argc, "--verbose"));
    // **The aggregate is scratch and goes when the run does.** It is a generated file with a unique
    // name, so leaving it would grow `.cache/` by one per invocation — `issues/system/0136` is the day
    // this repository's disk filled from exactly that shape, one temporary directory per run that
    // nothing removed. Best effort: a run that answered is not made wrong by a file that outlived it.
    if (walked.len() > 0) { cli.remove(entry, false).wait(); }
    return code;
  }

  // **`run`, and it lives here rather than in a host — `issues/system/0230a`, option 2.**
  //
  // The operator ruled that the shared thing is *this program* and that Deno, Node and the native
  // binary are hosts handing it argv and capabilities. `run` was that issue's own example of what only
  // a host could do — "the compiler writes a module and cannot instantiate one" — and it stopped being
  // true when every host learnt to start a module from bytes on 2026-08-21 (`issues/system/0144`). So
  // the *dispatch* is here and the *instantiation* is a capability, which is what lets one
  // implementation serve three hosts instead of one host having a command the others lack.
  //
  // **The grants are a ceiling, not a request.** `spawn` intersects what is asked with what this
  // process holds, so `wac run --allow-read` from a build without read gives the child a denied
  // capability rather than an error — the same rule as every other spawn, and the reason a host cannot
  // widen what a program may do.
  //
  // The native binary still answers `run` in Rust, before this program sees it, and that is deliberate
  // for now: `commandparity_test.wac` compares the two, and agreement measured is what has to come
  // before deleting either. Step 4 of that issue's order.
  if (cmd == "run") {
    string badFlag = unknownFlagBefore(cli, argc, entry);
    if (badFlag != "") {
      core.warn("wac: unknown flag '" + badFlag + "' — --allow-read, --allow-write, --allow-net, "
                + "--allow-env, --allow-run");
      return 2;
    }
    string misplaced = grantAfterEntry(cli, argc, entry);
    if (misplaced != "") {
      core.warn("wac: " + misplaced + " after the entry is a program argument, not a grant — write it "
                + "before " + entry + ", or after `--` if the program wants the string");
      return 2;
    }
    i32 grants = grantsBefore(cli, argc, entry);
    // **With its manifest**, because that is what a host reads to build the world the module imports.
    // The name inside it is the entry's own stem: nothing is written to disk, so there is no file for
    // it to be wrong about, and a program that reports its own name should not report a temporary one.
    u8[] whole = withManifestSection(
      wasm, manifestWire(wasm, types, sigs, entry, baseName(stem(entry)) + ".wasm", grants));

    // `true` for the input, so the program reads the terminal or the pipe this command was given —
    // which is what the native `run` does by instantiating in its own process. `false` for the
    // filesystem channel: this is not a program that answers `Fs.overParent` questions.
    Child kid = cli.spawn(whole, programArgs(cli, argc, entry), grants, "", true, false).wait();
    if (kid.unavailable()) {
      core.warn("wac: this host cannot run a module — `wac run` needs `spawn`, which a page has no "
                + "form of");
      return 1;
    }
    if (kid.handle < 0) {
      core.warn("wac: cannot run " + entry + " — " + kid.error);
      return 1;
    }
    return relay(core, cli, kid);
  }

  if (cmd == "build") {
    string bad = unknownFlag(cli, argc);
    if (bad != "") {
      core.warn("wacc: unknown flag '" + bad + "' — --allow-read, --allow-write, --allow-net, --allow-env, --allow-run");
      return 2;
    }
    string stem = outStem(cli, argc);
    if (stem == "") {
      core.warn("usage: wac build <entry.wac> -o <stem> [--allow-read] [--allow-write] [--allow-net] [--allow-env] [--allow-run]");
      return 2;
    }
    string wasmName = baseName(stem) + ".wasm";
    // Two more front ends, if this were `manifestFiles`: it derives `bindTypes` and `exportSigs`
    // from the sources, and both are already here.
    string manifest = manifestWire(wasm, types, sigs, entry, wasmName, grantsIn(cli, argc));
    u8[] whole = withManifestSection(wasm, manifest);
    Change wroteWasm = fs.writeFile(stem + ".wasm", whole);
    if (!wroteWasm.ok()) {
      core.warn("wacc: cannot write " + stem + ".wasm — " + wroteWasm.message);
      return 1;
    }
    // Remembered under the key computed before the compile. A failure to write the cache is not a
    // failure to build: the artefact the caller asked for is already on disk, and the next run simply
    // compiles again.
    //
    // **A build that warned is not remembered.** A hit returns above the diagnostics pass, so an entry
    // for a warned program would make its warning print once and never again — the same source and the
    // same command line saying two different things, decided by whether anybody had built it before.
    // `spec/cli/wac.md` `[§wac-cli-usage-3nkq8wj]` is explicit that warnings are *"not held back … or
    // suppressed on a command that also writes a file"*, so the cache must not be the thing that holds
    // them back. Declining to store is the cheap half of the choice: the alternative is keeping the
    // rendered diagnostics beside the artefact, which is a second file to write, evict and validate for
    // a case worth fixing rather than caching. A warned program pays full price every build, and any
    // `diags` still here is a warning — `wireHasErrors` returned above.
    if (cachePath != "" && diags == "") {
      string cacheDir = dirOf(cachePath);
      cli.mkdir(cacheDir, true).wait();
      // **Written beside and moved into place**, because three agents share this machine and a reader
      // that catches a half-written entry gets a truncated module rather than a miss. `rename` is
      // atomic on every filesystem this runs on — `std/platform.wac` says so where it explains why
      // `rename` is in the same tier as `writeFile` — so a concurrent build sees the old entry or the
      // new one and never part of either.
      //
      // The temporary name carries the *destination*, since this world has no pid: two builds racing
      // on one key are building the same program, and what distinguishes them is where each was asked
      // to put it. Two that also share a destination are already in conflict over the artefact itself.
      Fnv u = Fnv.start();
      u.eat(stem);
      string tmp = cachePath + ".tmp" + u.hex();
      Change wroteTmp = cli.writeFile(tmp, whole).wait();
      if (wroteTmp.ok()) {
        Change moved = cli.rename(tmp, cachePath).wait();
        if (!moved.ok()) { cli.remove(tmp, false).wait(); }
      }
      sweepBuildCache(cli, cacheDir);
    }
    // **Inside the module, and only there.** A `.json` went beside it until 2026-08-20, because the
    // wasmtime host predated the section and took a manifest path as its argument. Both hosts read the
    // section now (`native/manifest`), so the pair was a second copy of one thing with nothing left
    // reading it — and a manifest that can be separated from its module is one that can be swapped.
    // `index\tline\tcol\tkind\tfile` per counter, in counter order — what turns a count into a
    // position. Beside the module because whoever runs it is who needs it.
    if (covered) {
      Change wroteCov = fs.writeFile(stem + ".cov", covTableFilesIn(paths, texts, res, entry).toBytes());
      if (!wroteCov.ok()) {
        core.warn("wacc: cannot write " + stem + ".cov — " + wroteCov.message);
        return 1;
      }
    }
    // The same table for a traced build, under its own suffix. Both or neither, for the reason above:
    // a table without the module it describes names positions in a program that was not built.
    if (traced) {
      Change wroteTrace = fs.writeFile(stem + ".trace",
                                       traceTableFiles(paths, texts, entry).toBytes());
      if (!wroteTrace.ok()) {
        core.warn("wacc: cannot write " + stem + ".trace — " + wroteTrace.message);
        return 1;
      }
    }
    // **Quiet is about the *success* line only.** A build that fails still says why, on the stream a
    // caller reads for that — `wac run` compiles into a temporary file and then runs the program,
    // and a compiler announcing the file it wrote would land in the middle of that program's output.
    if (!hasFlag(cli, argc, "--quiet")) {
      core.log(stem + ".wasm: " + itoa(whole.len()) + " bytes from " + itoa(src.n) + " file(s)");
    }
    return 0;
  }

  string out = pos.len() > 1 ? pos[1] : wasmBeside(entry);
  Change wrote = fs.writeFile(out, wasm);
  if (!wrote.ok()) {
    core.warn("wacc: cannot write " + out + " — " + wrote.message);
    return 1;
  }
  core.log(out + ": " + itoa(wasm.len()) + " bytes from " + itoa(src.n) + " file(s)");
  return 0;
}
