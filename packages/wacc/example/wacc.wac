// The compiler, as a program.
//
//     wacc check   main.wac          # type-check it and its imports; say what is wrong
//     wacc compile main.wac [out]    # write the module, `main.wasm` beside it by default
//     wacc build   main.wac -o stem  # ...and the manifest a native host reads, in the module
//     wacc bindgen main.wac [--js]   # main.gen.ts — the glue a host calls the module through
//
// `build` also takes `--coverage`: a counter per branch point, and `<stem>.cov` saying what each is.
//                                    #    --quiet for the success line, --allow-* for the grants
//
// A TypeScript CLI (`waccx`) did the same job until it was retired, and this was never a port for
// its own sake: it is what the `wac` binary dispatches. The wasmtime host already runs `packages/sh` and
// every one of box's applets over a real filesystem, so a compiler that is itself a wac program needs
// no JavaScript anywhere in the path — design/lang/0003 step 4.
//
// **The compiler does no I/O and this does no compiling.** `emitFiles` and its neighbours take paths
// and sources, which is what lets them run in a browser; `src/files.wac` says which files a program
// is made of; and reading them is here, where the capabilities are. Each half is testable without
// the other.

import { Change, Cli, Core, FileResult } from "../../platform/src/platform.wac";
import { itoa } from "../../fmt/src/itoa.wac";
import { Fs } from "../../fs/src/fs.wac";
import { bindTypesFiles, bindgenDeclinedFiles, bindgenWire, blockedFiles, buildFiles, covTableFiles,
         describeSeparator, diagnoseGraph, exportSigsFiles,
         wireHasErrors,
         emitFilesCovered, manifestWire } from "../src/api.wac";
import { Built } from "../src/emit.wac";
import { withManifestSection } from "../src/manifest.wac";
import { renderDiagnostics } from "../src/render.wac";
import { importSpecs, normalisePath, resolveFrom } from "../src/files.wac";

/** How many files one program may be made of. */
i32 maxFiles() { return 512; }

/** The three answers `Built.described` folds together. */
struct Described {
  /** Why the emitter gave up, empty when it did not. */
  string blocked;
  /** `name\tret\tparams` per exported function — `exportSigsFiles`'s format. */
  string sigs;
  /** The bind-type wire — `bindTypesFiles`'s format. */
  string types;
}

/**
 * `blocked`, `sigs` and `types`, split on `describeSeparator()`.
 *
 * Two separators, three parts, and a part may be empty — a graph with nothing blocked and nothing
 * exported produces `sep + sep`. The separator is a whole line that neither half can emit, which is
 * what makes splitting on it safe: signature lines are `name\tret\tparams` and bind-type lines start
 * with a one-letter tag, so neither can contain it.
 *
 * A string that does not carry two separators is not one of these, and the honest answer to that is
 * the empty parts rather than a guess: `blockedOf` said nothing, so nothing is blocked, and a
 * manifest built from no signatures is a manifest a host will refuse loudly.
 */
Described describedParts(string described) {
  string sep = describeSeparator();
  i32 first = described.indexOf(sep);
  if (first < 0) { return Described(described, "", ""); }
  string blocked = described.slice(0, first);
  string rest = described.slice(first + sep.len(), described.len());
  i32 second = rest.indexOf(sep);
  if (second < 0) { return Described(blocked, rest, ""); }
  return Described(blocked, rest.slice(0, second), rest.slice(second + sep.len(), rest.len()));
}

/** A program's whole source: every path it reaches, and what is in each. */
struct Sources {
  string[] paths;
  string[] texts;
  i32 n;
  string missing;      // the first path that could not be read, or ""
}

/**
 * Read `entry` and everything it imports, breadth first.
 *
 * A file that cannot be read stops the walk and is named: the alternative is compiling a program
 * with a hole in it and reporting whatever the hole makes the checker say, which points at the
 * wrong file.
 */
Sources gather(Fs fs, string entry) {
  string[] paths = string[maxFiles()](fill: "");
  string[] texts = string[maxFiles()](fill: "");
  i32 n = 0;
  // **The entry in the same spelling its imports will be in.** `resolveFrom` collapses `.` and
  // `..`; the entry went in as typed, so `./a/b.wac` keyed the map one way and resolved its own
  // imports the other. `issues/lang/0134`.
  paths[0] = normalisePath(entry);
  n = 1;
  i32 at = 0;
  while (at < n) {
    string path = paths[at];
    FileResult r = fs.readFile(path);
    if (!r.ok) { return Sources(paths, texts, n, path); }
    string text = string.fromBytes(r.bytes);
    texts[at] = text;
    string[] specs = importSpecs(r.bytes);
    for (i32 i = 0; i < specs.len(); i++) {
      string next = resolveFrom(path, specs[i]);
      bool seen = false;
      for (i32 k = 0; k < n; k++) { if (paths[k] == next) { seen = true; } }
      if (seen || n >= maxFiles()) { continue; }
      paths[n] = next;
      n = n + 1;
    }
    at = at + 1;
  }
  return Sources(paths, texts, n, "");
}

/** The arrays the API wants: exactly `n` long, since it walks their whole length. */
string[] exactly(string[] xs, i32 n) {
  string[] out = string[n](fill: "");
  for (i32 i = 0; i < n; i++) { out[i] = xs[i]; }
  return out;
}

/**
 * What this compiler answers, as the reader sees it first.
 *
 * **Four commands and one flag were missing from it** — `bindgen`, `-o`, the grants and `--coverage` —
 * so the command that writes a host's glue was undiscoverable and every `build` needed a flag the
 * usage did not mention. `packages/wacc/test/wac/cli_test.wac` holds this against the dispatch and against
 * `spec/cli/wac.md`; the host adds its own commands after these, since each side lists what it
 * implements.
 */
string usage() {
  return "usage: wac check|compile|bindgen <entry.wac> [out]   # --js for bindgen's glue\n"
       + "       wac build <entry.wac> -o <stem> [--coverage] [--quiet]\n"
       + "                [--allow-read] [--allow-write] [--allow-net] [--allow-env] [--allow-run]";
}

/**
 * The arguments that are not flags: the entry, and for `compile` the output path after it.
 *
 * **The entry used to be whatever was at argument 1**, so `wac build --allow-read p.wac` answered
 * *cannot read --allow-read* — a sentence about a file, about a command line. `wac run` takes its
 * grants before the entry and this took them after, so the two commands excluded each other's order.
 * They overlap now: a flag is a flag wherever it is written, and the entry is the first thing that is
 * not one. `issues/system/0177`.
 *
 * `-o` is the one flag carrying a value, and skipping the flag without its value would leave the stem
 * looking like the entry — which is the same class of mistake one level along.
 */
string[] positionals(Cli cli, i32 argc) {
  string[] out = string[argc](fill: "");
  i32 n = 0;
  i32 i = 1;
  while (i < argc) {
    string a = string.fromBytes(cli.arg(i).wait());
    if (a == "-o") { i = i + 2; continue; }
    if (a.len() > 0 && a.slice(0, 1) == "-") { i = i + 1; continue; }
    out[n] = a;
    n = n + 1;
    i = i + 1;
  }
  return exactly(out, n);
}

/**
 * The grants a `build` was asked for, as the bitmask `platform.wac` uses.
 *
 * The same four flags `deno task app:native` takes, and they mean the same thing: whoever packages
 * the program chooses what it may do, and the person running it cannot quietly widen that. A flag
 * this does not recognise is not silently ignored — see `unknownFlag`.
 *
 * **From 1, not from 2.** Argument 1 was the entry by position, so nothing looked there for a flag —
 * and once the entry stopped being positional, a grant written first was read by nobody and the
 * artefact came out sealed with no complaint. Every scan below starts where the arguments start.
 */
i32 grantsIn(Cli cli, i32 argc) {
  i32 bits = 0;
  for (i32 i = 1; i < argc; i++) {
    string a = string.fromBytes(cli.arg(i).wait());
    if (a == "--allow-read") { bits = bits | 1; }
    if (a == "--allow-write") { bits = bits | 2; }
    if (a == "--allow-net") { bits = bits | 4; }
    if (a == "--allow-env") { bits = bits | 8; }
    // Running a host program — `Cli.exec`. Its own bit and its own grant, not `write`'s: a build
    // that may start a confined wasm module must be able to refuse a host binary without refusing
    // both. `issues/system/0165`.
    if (a == "--allow-run") { bits = bits | 16; }
  }
  return bits;
}

/** Whether an argument is there at all. */
bool hasFlag(Cli cli, i32 argc, string flag) {
  for (i32 i = 1; i < argc; i++) {
    if (string.fromBytes(cli.arg(i).wait()) == flag) { return true; }
  }
  return false;
}

/** The first argument that looks like a flag and is not one, or "". */
string unknownFlag(Cli cli, i32 argc) {
  for (i32 i = 1; i < argc; i++) {
    string a = string.fromBytes(cli.arg(i).wait());
    if (a.len() < 2 || a.slice(0, 2) != "--") { continue; }
    if (a != "--allow-read" && a != "--allow-write" && a != "--allow-net" && a != "--allow-env"
        && a != "--allow-run" && a != "--quiet" && a != "--js" && a != "--coverage") {
      return a;
    }
  }
  return "";
}

/** The value after `-o`, or "". */
string outStem(Cli cli, i32 argc) {
  for (i32 i = 1; i + 1 < argc; i++) {
    if (string.fromBytes(cli.arg(i).wait()) == "-o") {
      return string.fromBytes(cli.arg(i + 1).wait());
    }
  }
  return "";
}

/** What the manifest calls the module it sits beside: the stem's own name, without its directory. */
string baseName(string path) {
  i32 at = -1;
  for (i32 i = 0; i < path.len(); i++) {
    if (path.slice(i, i + 1) == "/") { at = i; }
  }
  return at < 0 ? path : path.slice(at + 1, path.len());
}

/** `path.wac` without its extension, which is what the generated names are built on. */
string stem(string entry) {
  i32 n = entry.len();
  return n > 4 && entry.slice(n - 4, n) == ".wac" ? entry.slice(0, n - 4) : entry;
}

/** Several lines as one, for a warning that names them all. */
string oneLine(string text) {
  string out = "";
  for (i32 i = 0; i < text.len(); i++) {
    string ch = text.slice(i, i + 1);
    if (ch == "\n") {
      if (i + 1 < text.len()) { out = out + "; "; }
      continue;
    }
    out = out + ch;
  }
  return out;
}

/** `path.wac` becomes `path.wasm`; anything else gains `.wasm`. */
string wasmBeside(string entry) {
  i32 n = entry.len();
  if (n > 4 && entry.slice(n - 4, n) == ".wac") { return entry.slice(0, n - 4) + ".wasm"; }
  return entry + ".wasm";
}

export i32 main(Core core, Cli cli) {
  i32 argc = cli.argCount().wait();
  if (argc < 2) {
    core.warn(usage());
    return 2;
  }
  string cmd = string.fromBytes(cli.arg(0).wait());
  // **Normalised once, here, because every later use has to agree with every other.** The map is
  // keyed by resolved paths and `resolveFrom` collapses `.` and `..`; the entry reached
  // `diagnoseGraphRendered` and the emitter as typed, so `wac test ./a/b.wac` built a map keyed
  // `a/b.wac` and then asked about `./a/b.wac` — "an import of a file that was not supplied", about
  // a file that was. `issues/lang/0134`.
  //
  // A leading `./` is what tab completion produces, so the spelling most likely to be typed was the
  // one that did not work.
  string[] pos = positionals(cli, argc);
  if (pos.len() < 1) {
    core.warn(usage());
    return 2;
  }
  string entry = normalisePath(pos[0]);

  // **The command is checked before the entry is read.** This test used to sit after the graph was
  // gathered and the diagnostics printed, so a line with two mistakes in it was answered about the
  // wrong one: `wacc chekc nope.wac` reported *cannot read nope.wac* and exited 1, diagnosing the
  // typo you did not make and giving a compile-failure code for a usage mistake. Whether a usage
  // error is reported as one should not depend on an unrelated path happening to exist.
  if (cmd != "check" && cmd != "compile" && cmd != "build" && cmd != "bindgen") {
    core.warn("wacc: unknown command '" + cmd + "' — check, compile, build or bindgen");
    return 2;
  }

  Fs fs = Fs.onHost(cli, 0);

  Sources src = gather(fs, entry);
  if (src.missing != "") {
    core.warn("wacc: cannot read " + src.missing);
    return 1;
  }
  string[] paths = exactly(src.paths, src.n);
  string[] texts = exactly(src.texts, src.n);

  // Diagnostics first for either command: compiling a program the checker refuses would write a
  // module built from a tree nobody approved.
  //
  // **Rendered, not the wire.** This printed `file\tline\tcol\tphase\t…` at a person until
  // `src/render.wac` — the compiler could build this repository and could not say what was wrong
  // with a file. `test/wac/renderdiag_test.wac` holds it to the layout `waccx` prints.
  //
  // **Every file, not just the entry.** One checking pass walks only the entry's bodies, so a type
  // error in an imported file was silent — and the emitter, which compiles every body, wrote a
  // module that failed validation with a wasm-level mismatch in place of a source line
  // (`issues/lang/0118`). That is as true of `compile` as of `check`: writing a module nobody
  // approved is the thing the diagnostics are here to prevent.
  // **Printed together, decided on separately** — `issues/lang/0126`. This returned 1 whenever the
  // rendered string was non-empty, which is right for errors and refuses a program that merely warns.
  // So the wire is taken once, rendered for the reader, and asked whether anything in it was an
  // error. One pass: rendering and deciding from the same string is what stops this being the second
  // whole-graph walk `issues/lang/0133` was about.
  string wire = diagnoseGraph(paths, texts, entry);
  string diags = renderDiagnostics(wire, paths, texts);
  if (diags != "") { core.warn(diags); }
  if (wireHasErrors(wire)) { return 1; }
  if (cmd == "check") {
    core.log(entry + ": " + itoa(src.n) + " file(s), no diagnostics");
    return 0;
  }

  // **One front end for the whole build**, which is what `buildFiles` exists for — `issues/lang/0129`
  // made that call and this was the caller still not using it.
  //
  // What this used to do was ask four separate questions of four separate front ends: `blockedFiles`
  // for what the emitter declines, `emitFiles` for the module, and — inside `manifestFiles` below —
  // `bindTypesLinked` and `exportSigsLinked` for the boundary. Each takes `(paths, sources, entry)`
  // and builds its own, because this compiler does no I/O and holds nothing between calls. With
  // `diagnoseGraph` above that is **five whole-graph walks to produce one module**, and it is why
  // `wac build` on this compiler took 4.7 s while the same emit under a host that calls the library
  // directly took 0.5 s. The browser's bootstrap page has always shown the honest number.
  //
  // `Built.described` carries all three of the answers the walks were for, separated by
  // `describeSeparator()`, in the order `describeFiles` documents: blocked, signatures, bind types.
  //
  // **An instrumented module is a different module**, and asking for one is the build's decision:
  // `emitFilesCovered` writes a counter per branch point, and `covTableFiles` says what each counter
  // is. Both or neither — a table without the counters describes a module that does not exist. That
  // path keeps the separate calls, because there is no folded form of it and a coverage build is
  // something a person waits for on purpose.
  bool covered = hasFlag(cli, argc, "--coverage");
  string blocked = "";
  string sigs = "";
  string types = "";
  u8[] wasm = u8[0]();
  if (covered) {
    blocked = blockedFiles(paths, texts, entry);
    wasm = emitFilesCovered(paths, texts, entry);
    sigs = exportSigsFiles(paths, texts, entry);
    types = bindTypesFiles(paths, texts, entry);
  } else {
    Built built = buildFiles(paths, texts, entry);
    Described parts = describedParts(built.described);
    blocked = parts.blocked;
    sigs = parts.sigs;
    types = parts.types;
    wasm = built.wasm;
  }
  // **What the emitter declines is not a diagnostic**, and saying so is the difference between a
  // module that is missing a function and a message about which one. Answered from the shared front
  // end rather than from one of its own; the module beside it is discarded unread when this fires,
  // which is the one case where folding the walks does work that used to be skipped.
  if (blocked != "") {
    core.warn("wacc: cannot emit " + entry + " — " + blocked);
    return 1;
  }

  // **A module with no sections is not a module.** `blocked` above is the emitter *declining*, with a
  // reason in words. This is the emitter answering with the eight-byte header and nothing after it, which
  // has happened: `issues/lang/0154` reaches it, and the build reported `73846 bytes from 72 file(s)` and
  // exited 0, because the manifest section appended to a bare header makes the file look substantial. The
  // size line is the one number a person checks, and it agreed with the failure.
  //
  // So: nothing written, and a non-zero exit. `issues/lang/0155`.
  if (wasm.len() <= 8) {
    core.warn("wacc: the emitter produced no code for " + entry + " — " + itoa(wasm.len()) +
              " bytes is the wasm header and no sections at all, so nothing was written. Nothing was " +
              "declined either, which is what makes this a defect in the emitter rather than in the " +
              "program: issues/lang/0154 is the one known way to reach it.");
    return 1;
  }

  // **`bindgen` writes the glue a host calls the module through**, beside the entry — `main.gen.ts`,
  // or `main.gen.js` with `--js`, since a browser cannot import TypeScript. What it cannot bind is
  // reported rather than skipped: a caller told `makeP(i32) -> P` was declined can change the
  // signature, and one handed glue missing a function finds out at the call site.
  if (cmd == "bindgen") {
    bool js = hasFlag(cli, argc, "--js");
    string declined = bindgenDeclinedFiles(paths, texts, entry);
    if (declined != "") {
      core.warn("wacc bindgen: not bound yet — " + oneLine(declined));
    }
    // From the metadata already in hand: `bindgenFiles` would build two more front ends to derive
    // exactly these two strings.
    string glue = bindgenWire(wasm, sigs, types, js ? "js" : "ts");
    string out = stem(entry) + (js ? ".gen.js" : ".gen.ts");
    Change wroteGlue = fs.writeFile(out, glue.toBytes());
    if (!wroteGlue.ok()) {
      core.warn("wacc: cannot write " + out + " — " + wroteGlue.message);
      return 1;
    }
    if (!hasFlag(cli, argc, "--quiet")) {
      core.log(out + ": " + itoa(glue.len()) + " bytes");
    }
    return 0;
  }

  // **`build` is `compile` plus the boundary.** A native host cannot run a module without knowing
  // which `$bind$` export builds `Core` and in what order its funcrefs go, so an application is a
  // module *and* a manifest — `deno task app:native` in one command, which is what lets this binary
  // produce the artefact it is itself made of.
  if (cmd == "build") {
    string bad = unknownFlag(cli, argc);
    if (bad != "") {
      core.warn("wacc: unknown flag '" + bad + "' — --allow-read, --allow-write, --allow-net, --allow-env, --allow-run");
      return 2;
    }
    string stem = outStem(cli, argc);
    if (stem == "") {
      core.warn("usage: wac build <entry.wac> -o <stem> [--allow-read] [--allow-write] [--allow-net] [--allow-env] [--allow-run]");
      return 2;
    }
    string wasmName = baseName(stem) + ".wasm";
    // Two more front ends, if this were `manifestFiles`: it derives `bindTypes` and `exportSigs`
    // from the sources, and both are already here.
    string manifest = manifestWire(wasm, types, sigs, entry, wasmName, grantsIn(cli, argc));
    u8[] whole = withManifestSection(wasm, manifest);
    Change wroteWasm = fs.writeFile(stem + ".wasm", whole);
    if (!wroteWasm.ok()) {
      core.warn("wacc: cannot write " + stem + ".wasm — " + wroteWasm.message);
      return 1;
    }
    // **Inside the module and beside it.** The section is what lets one artefact be handed over;
    // the pair is what the wasmtime host still reads. Writing both decides nothing at once.
    Change wroteJson = fs.writeFile(stem + ".json", manifest.toBytes());
    if (!wroteJson.ok()) {
      core.warn("wacc: cannot write " + stem + ".json — " + wroteJson.message);
      return 1;
    }
    // `index\tline\tcol\tkind\tfile` per counter, in counter order — what turns a count into a
    // position. Beside the module because whoever runs it is who needs it.
    if (covered) {
      Change wroteCov = fs.writeFile(stem + ".cov", covTableFiles(paths, texts, entry).toBytes());
      if (!wroteCov.ok()) {
        core.warn("wacc: cannot write " + stem + ".cov — " + wroteCov.message);
        return 1;
      }
    }
    // **Quiet is about the *success* line only.** A build that fails still says why, on the stream a
    // caller reads for that — `wac run` compiles into a temporary file and then runs the program,
    // and a compiler announcing the file it wrote would land in the middle of that program's output.
    if (!hasFlag(cli, argc, "--quiet")) {
      core.log(stem + ".wasm: " + itoa(whole.len()) + " bytes from " + itoa(src.n) + " file(s)");
    }
    return 0;
  }

  string out = pos.len() > 1 ? pos[1] : wasmBeside(entry);
  Change wrote = fs.writeFile(out, wasm);
  if (!wrote.ok()) {
    core.warn("wacc: cannot write " + out + " — " + wrote.message);
    return 1;
  }
  core.log(out + ": " + itoa(wasm.len()) + " bytes from " + itoa(src.n) + " file(s)");
  return 0;
}
