// Writes the status of every example in the specification: `spec/next/_drafting/STATUS.md`, and the list of
// met examples `specexamples_test.wac` holds the compiler to.
//
//     wac run --allow-read --allow-write --allow-run packages/wacc/tools/specstatus.wac [dir]
//
// Run it after a change that moves the count, and commit both files: STATUS.md says where the implementation
// stands, and MET is the ratchet — an example in it that stops being met fails the suite.

import { Change, Cli, Core, Sys } from "std";
import { itoa } from "../../fmt/src/itoa.wac";
import { ExJudged, ExVerdict, judgeAll } from "../test/wac/specexamples.wac";

export i32 main(Sys sys) {
  Core core = sys.core;
  Cli cli = sys.cli;
  string dir = "spec/next";
  if (cli.argCount().wait() > 0) { dir = string.fromBytes(cli.arg(0).wait()); }
  string status = dir + "/_drafting/STATUS.md";
  string metPath = dir + "/_drafting/MET";

  ExJudged j = judgeAll(cli, dir);
  if (j.verdicts.len() == 0) { core.warn("no examples under " + dir + " — is the cwd the repository?"); return 2; }
  ExVerdict[] vs = j.verdicts;
  Change wrote = cli.writeFile(status, render(dir, j.docs, vs).toBytes()).wait();
  if (!wrote.ok()) { core.warn("could not write " + status); return 1; }
  string met = "";
  for (i32 i = 0; i < vs.len(); i++) { if (vs[i].state == "met") { met = met + j.keys[i] + "\n"; } }
  Change wroteMet = cli.writeFile(metPath, met.toBytes()).wait();
  if (!wroteMet.ok()) { core.warn("could not write " + metPath); return 1; }
  core.log(itoa(vs.len()) + " examples: " + itoa(count(vs, "met")) + " met, " + itoa(count(vs, "missed"))
           + " missed, " + itoa(count(vs, "unsupported")) + " unsupported — " + status);
  return 0;
}

i32 count(ExVerdict[] vs, string state) {
  i32 n = 0;
  for (i32 i = 0; i < vs.len(); i++) { if (vs[i].state == state) { n = n + 1; } }
  return n;
}

// ── The report ───────────────────────────────────────────────────────────────────────────────────

string render(string dir, string[] docs, ExVerdict[] vs) {
  string out = "# Status of the examples in " + dir + "\n\n";
  out = out + "Generated by packages/wacc/test/wac/specexamples_probe.wac — do not edit by hand.\n\n";
  out = out + "**" + itoa(vs.len()) + " examples: " + itoa(count(vs, "met")) + " met, "
        + itoa(count(vs, "missed")) + " missed, " + itoa(count(vs, "unsupported")) + " unsupported.**\n\n";
  out = out + "| document | examples | met | missed | unsupported |\n|---|---:|---:|---:|---:|\n";
  for (i32 d = 0; d < docs.len(); d++) {
    i32 total = 0; i32 met = 0; i32 missed = 0; i32 unsup = 0;
    for (i32 i = 0; i < vs.len(); i++) {
      if (vs[i].fence.doc != docs[d]) { continue; }
      total = total + 1;
      if (vs[i].state == "met") { met = met + 1; }
      else if (vs[i].state == "missed") { missed = missed + 1; }
      else { unsup = unsup + 1; }
    }
    if (total == 0) { continue; }
    out = out + "| " + docs[d] + " | " + itoa(total) + " | " + itoa(met) + " | " + itoa(missed) + " | "
          + itoa(unsup) + " |\n";
  }
  out = out + "\n## Missed\n\n";
  for (i32 i = 0; i < vs.len(); i++) {
    if (vs[i].state != "missed") { continue; }
    out = out + "- `" + vs[i].fence.doc + ":" + itoa(vs[i].fence.line) + "`" + tagList(vs[i].fence.tags) + " — "
          + oneLine(vs[i].why) + "\n";
  }
  out = out + "\n## Unsupported\n\n";
  for (i32 i = 0; i < vs.len(); i++) {
    if (vs[i].state != "unsupported") { continue; }
    out = out + "- `" + vs[i].fence.doc + ":" + itoa(vs[i].fence.line) + "` — " + oneLine(vs[i].why) + "\n";
  }
  return out;
}

string tagList(string[] tags) {
  if (tags.len() == 0) { return ""; }
  string out = " (";
  for (i32 i = 0; i < tags.len(); i++) { out = out + (i == 0 ? "" : ", ") + tags[i]; }
  return out + ")";
}

string oneLine(string s) {
  string out = "";
  for (i32 i = 0; i < s.len() && i < 300; i++) {
    string c = s.slice(i, i + 1);
    out = out + (c == "\n" ? " " : c);
  }
  return out;
}
