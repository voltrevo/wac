// A string literal's bytes, away from the emitter that used to own them.
//
// Three readers want them — the emitter writing a data segment, `files.wac` reading an import
// specifier, and the static evaluator, which needs the value of `trap "…"` and of any string a static
// is built from. In `emit.wac` a third caller could not have it: this package does not compile with an
// import cycle, so a module the others can all point at is the shape that works.

import { blockValue, escapeValue, isBlockLiteral, Lexed, literalBodyStart, literalBodyEnd,
         tokenStride, unicodeEscapeEnd, unicodeEscapeValue, utf8Into } from "./lex.wac";

/**
 * A string literal's bytes, with the quotes dropped and the escapes resolved.
 *
 * The set is the language's, from `escapeValue` in `lex.wac`, rather than a list repeated here.
 * It was "the four this repository's own sources use" and the two lists agreed by luck: an escape
 * this did not know was emitted as its own two characters, a wrong string rather than a missing
 * feature, and `knownEscapes` beside it was the second copy that kept that from happening.
 * `design/lang/0013` moves the set twice more, and a set written down six times moves five times.
 */
export u8[] stringLiteralBytes(u8[] src, Lexed lexed, i32 tok) {
  i32 start = lexed.tokens[tok * tokenStride() + 1];
  i32 len = lexed.tokens[tok * tokenStride() + 2];
  if (isBlockLiteral(src, start, len)) { return blockValue(src, start, len); }
  // **Sized by the span, which is always enough.** `\\u{1F600}` is nine source bytes and four
  // encoded ones, and every other escape shrinks too; no escape encodes to more bytes than it is
  // written with, so the literal's own length bounds the result.
  u8[] out = u8[].filled(len, 0);
  i32 n = 0;
  // **The delimiters are one byte each, except the `\{` that ends an interpolated segment.**
  // `"a\{e}bc"` lexes as `"a\{` `+` `e` `+` `}bc"` — `design/lang/0013` D7 — and the segments'
  // spans are runs of the real file rather than synthesised source, so what varies is only which
  // bytes are the delimiters. Opening is always one: a quote, or the `}` that closed the
  // expression. Closing is two when it is `\{`, and a whole literal can never end that way, since
  // an escaped backslash before a brace reads as `\\` then `{`.
  i32 i = literalBodyStart(src, start, len);
  i32 end = literalBodyEnd(src, start, len);
  while (i < end) {
    if (src[i] == 92 && i + 1 < end) {
      // **`\\u{…}` is the one escape that is not one byte.** It denotes a character, so it encodes
      // as UTF-8 here — which is what keeps a literal valid UTF-8 by construction, `design/lang/0013`
      // D2 and D4. The lexer has already refused a malformed one, so a negative answer here cannot
      // reach a module; it decodes as the plain `u` rather than trapping, because this runs on
      // sources that may already carry a diagnostic and a second failure would bury the first.
      if (src[i + 1] == 'u') {
        i32 cp = unicodeEscapeValue(src, i + 1, end);
        if (cp >= 0) {
          n = n + utf8Into(out, n, cp);
          i = unicodeEscapeEnd(src, i + 1, end);
          continue;
        }
      }
      out[n] = escapeValue(src[i + 1] as i32) as@ u8;
      n = n + 1;
      i = i + 2;
      continue;
    }
    out[n] = src[i];
    n = n + 1;
    i = i + 1;
  }
  u8[] exact = u8[].filled(n, 0);
  for (i32 k = 0; k < n; k++) { exact[k] = out[k]; }
  return exact;
}
