// The wacc entry points that cross the JavaScript boundary.
//
// Everything else in this package traffics in structs and sum types, which bindgen
// cannot marshal — and should not, since an AST is not a value to hand across a
// boundary. So the surface is bytes in, text out: the caller passes source and gets
// the canonical dump the parser's own tests read.

import { Lowered, lowerProgram, ticketSigsOf } from "./asynclower.wac";
import { lex, Lexed, lexTokens, tokenStride } from "./lex.wac";
import { kAs, kAsAt, kAsBang, kAssign, kAsTilde, kAsync, kAwait, kColon, kFor, kComma, kDot, kEnum, kExport, kGt, kIdent, kImport, kindName, kIs, kLbrace,
         kLbrack, kLparen, kLt, kMatches, kQuestion, kRbrace, kRbrack, kRparen, kSemi, kShr, kStatic,
         kStruct } from "./kinds.wac";
import { checkMessage, lexMessage, parseMessage, warnMessage, hintFor, parseHintFor,
         displayTypes } from "./diag.wac";
import { P, parseProgram } from "./parse.wac";
import { declsOfFiles, declsOfProgram, evalAllConsts } from "./consteval.wac";
import { Method, Param, Program, Ty } from "./ast.wac";
import { Pr, printProgram } from "./print.wac";
import { C, checkModule, checkProgram, contextsOf, declareModule, errorsOf, hintsOf, notesOf,
         warningsOf, widthsOf, errNoSuchExport, errStaleBuiltinEmbedding, isBuiltinSubpath,
         widenAutoContributions, ViewInputs, buildStaticView } from "./check.wac";
import { emitModule, emitBlocked, emitDeclineRaw, typesGrewCatchAll, emitNames, emitLinked, emitLinkedIn, missingImportParts, emitLinkedChecked, emitLinkedCovered,
  emitLinkedCoveredIn,
         emitLinkedTraced, emitLinkedTracedSlots, traceTableLinked,
         covTableLinked, exportSigsLinked, bindTypesLinked, blockedLinked, namesLinked,
         describeLinked, describeSep, buildLinked, Built,
         sourceOf, tokenTextOf, resolveImport, numText,
         emitDeclineLinked, lambdaReportLinked, exportForwards, splitTabs } from "./emit.wac";
import {
  builtinEnumVariants, builtinTypeDefaults, builtinVariadicCallees, coreSource, isBuiltinSpec, stdSource,
} from "./coretext.wac";
import { enumVariantsIn } from "./scans.wac";
import { KeyIndex, keyAdd, keyFirst } from "./keyindex.wac";
import { manifestOf, withManifestSection } from "./manifest.wac";
import { renderDiagnostics } from "./render.wac";
import { importSpecs, importSpecsLexed } from "./files.wac";
import { isProjectSpec, Res, resolveFrom, resolveFromAt, resolveFromIn, resolveVia, startsWith } from "./path.wac";
import { Frontend, frontendOf, readLexed, readOf, readParsedLexed, readProgram, Reads, readSrc } from "./frontend.wac";
import { Pruned, pruneFor } from "./reach.wac";
import {
  lowerNamespaces, lowerNamespacesForDeclarationsWith, lowerNamespacesWith, relativeSpec,
} from "./namespaces.wac";
import { trimSpaces } from "./unions.wac";
import { bindgenDeclined, bindgenOf } from "./bindgen.wac";

/** Lex, parse, and render the AST in canonical form. */
export string dump(u8[] src) {
  return dumpAs("x.wac", src);
}

/** `src` read as the file at `path`, rendered. */
string dumpAs(string path, u8[] src) {
  Frontend fe = frontendOf(path, src);
  Pr w = Pr.create(fe.src, fe.lexed.tokens, fe.lexed.tokenCount);
  return printProgram(w, fe.prog);
}

/**
 * The parser's errors, as (code, line, col) triples.
 *
 * Separate from `dump` because a caller comparing ASTs and a caller comparing
 * diagnostics want different things, and returning both would mean a struct.
 */
/**
 * The **parser's** errors alone, with the lexer's left out.
 *
 * `dumpErrors` is the front end's answer — what a caller asking *is this a program?* wants, and
 * lexical errors belong in it. This one exists for the instrument next to it: parse_errors.test.ts
 * compares this parser against the reference's parser, and asserts of every code that some `perr*`
 * constant declares it. The lexer's codes are a space of their own (1–7), so mixing them in makes a
 * parser instrument fail on a lexer's answer.
 */
export i32[] dumpParseErrors(u8[] src) {
  Lexed lexed = lex(src);
  P p = P.create(src, lexed);
  parseProgram(p);
  i32[] out = i32[].filled(p.errorCount * 3, 0);
  for (i32 i = 0; i < p.errorCount * 3; i++) { out[i] = p.errors[i]; }
  return out;
}

/**
 * A lone source with its namespaces lowered — what a check of one file parses (spec ch03). A file naming
 * `html.li` or `[operators.add]` does not parse until this has made them verbatim names.
 */
u8[] loweredOne(u8[] src) {
  return lowerSourcesForChecking(onePath(), oneSource(src), Res.empty())[0].toBytes();
}

export i32[] dumpErrors(u8[] raw) {
  u8[] src = loweredOne(raw);
  Lexed lexed = lex(src);
  P p = P.create(src, lexed);
  parseProgram(p);
  // **The lexer's errors are errors too**, and this function dropped them. An unterminated block
  // comment, an unterminated string, an unknown escape and an unterminated character literal were
  // all found by `lex` and then thrown away with the `Lexed` that held them — no caller of this
  // package could see one, because every caller comes through here. They go first: a lexical
  // complaint is about text the parser never got to see. `spec/cases/0081`.
  i32 lexCount = lexed.errorCount * 3;
  i32[] out = i32[].filled(lexCount + p.errorCount * 3, 0);
  for (i32 i = 0; i < lexCount; i++) { out[i] = lexed.errors[i]; }
  for (i32 i = 0; i < p.errorCount * 3; i++) { out[lexCount + i] = p.errors[i]; }
  return out;
}

/**
 * The checker's sentence for one of its codes, so a bare triple can be read without guessing.
 *
 * **The phases number from the same place.** `perrExpected` is 20 in `parse.wac` and `errBuiltinArg`
 * is 20 in `check.wac`, and a `(code, line, col)` triple carries no phase — every triple from
 * `dumpTypeErrors` is a checker code, but nothing about the number says so. `issues/lang/0149` was
 * filed as "a parse error from a file that compiles" and was a false alarm from the checker, about
 * `string.fromBytes(bytes)`: a day of delta debugging aimed at the wrong phase because the only thing
 * in hand was 20.
 *
 * `diagnoseGraph` has always tagged its rows with the phase; this is that, for the callers that take
 * the triples directly.
 */
export string checkCodeMessage(i32 code) {
  return checkMessage(code);
}

/**
 * The type checker's diagnostics, as `(code, line, col)` triples — rung 3's oracle surface.
 *
 * The same shape `dumpErrors` returns for the parser, and for the same reason: our side reports
 * numeric codes and the reference reports English, so the comparison is by code, order and position.
 */
export i32[] dumpTypeErrors(u8[] raw) {
  u8[] src = loweredOne(raw);
  Lexed lexed = lex(src);
  P p = P.create(src, lexed);
  Program prog = parseProgram(p);
  return checkProgram(src, lexed.tokens, lexed.tokenCount, prog);
}

/**
 * The **hint** written for the first checker diagnostic, or "" where it has none of its own.
 *
 * A sibling of `dumpTypeErrors` and for the same reason: a test that wants to know what a reader is
 * told needs something to ask, and running the whole command to read `= help:` out of rendered text
 * makes an assertion about a sentence depend on a renderer.
 *
 * **Empty is the ordinary answer**, and is not the absence of help — it means the diagnostic takes
 * the hint its *code* carries, from `hintFor`. What this returns is the narrower thing: a hint some
 * site wrote for this occurrence because it had the reader's own expression in hand.
 */
export string dumpFirstTypeHint(u8[] src) {
  Lexed lexed = lex(src);
  P p = P.create(src, lexed);
  Program prog = parseProgram(p);
  C c = C.create(src, lexed.tokens, lexed.tokenCount, lexed.tokenCount);
  declareModule(c, prog, string[].filled(0, ""));
  checkModule(c, prog);
  string[] hints = hintsOf(c);
  return hints.len() > 0 ? hints[0] : "";
}

/** The **note** — the label under the caret — of the first checker diagnostic, as `dumpFirstTypeHint` gives its hint. */
export string dumpFirstTypeNote(u8[] src) {
  Lexed lexed = lex(src);
  P p = P.create(src, lexed);
  Program prog = parseProgram(p);
  C c = C.create(src, lexed.tokens, lexed.tokenCount, lexed.tokenCount);
  declareModule(c, prog, string[].filled(0, ""));
  checkModule(c, prog);
  string[] notes = notesOf(c);
  return notes.len() > 0 ? notes[0] : "";
}

/**
 * Every static's value, as `NAME = value` or `NAME ! outcome: why` — spec ch28.
 *
 * The evaluator's oracle surface, and single-file on purpose: it asks what a value *is* with no
 * emitter in the way, so a disagreement here is the interpreter's and nothing else's.
 */
export string[] dumpConstValues(u8[] src) {
  Lexed lexed = lex(src);
  P p = P.create(src, lexed);
  Program prog = parseProgram(p);
  return evalAllConsts(declsOfProgram(src, lexed, prog.decls));
}

/**
 * Every static's value across a whole program — the surface that shows what the evaluator
 * *resolved*: two files each with a private `helper` must each get their own.
 */
export string[] dumpConstValuesIn(string[] paths, string[] sources) {
  Lexed?[] lexes = Lexed?[].filled(sources.len() < 1 ? 1 : sources.len(), null);
  Program?[] progs = Program?[].filled(sources.len() < 1 ? 1 : sources.len(), null);
  for (i32 i = 0; i < sources.len(); i++) {
    u8[] b = sources[i].toBytes();
    Lexed lx = lex(b);
    lexes[i] = lx;
    P pp = P.create(b, lx);
    progs[i] = parseProgram(pp);
  }
  u8[] first = sources.len() > 0 ? sources[0].toBytes() : u8[]();
  return evalAllConsts(declsOfFiles(paths, sources, lexes, progs, first, lex(first)));
}

/**
 * Rung 4's surface: a wasm module for the program, as bytes.
 *
 * Bytes out rather than a structure, for the same reason everything else here is bytes in — and
 * because the oracle for this rung is that the caller can *run* what comes back.
 */
export u8[] emit(u8[] src) {
  // **An interpolation converts through core** (spec ch23), and core is linked by the
  // many-file route — so a lone file that interpolates takes it, as a file set of one.
  if (needsLinking(src)) { return emitFiles(onePath(), oneSource(src), "main.wac"); }
  return emitModule(src);
}

/** Why a module was not emitted in full — the feature that stopped it, or `""`. */
export string blocked(u8[] src) {
  if (needsLinking(src)) { return blockedFiles(onePath(), oneSource(src), "main.wac"); }
  return emitBlocked(src);
}

/**
 * Whether a lone file has to take the many-file route: an interpolation converts through core, and a
 * namespace is lowered there (spec ch03) — the one-file emitter does neither.
 */
bool needsLinking(u8[] src) {
  if (interpolates(src)) { return true; }
  // **And an `async` body**, whose lowering builds core's `Ticket` (spec ch35).
  if (saysAsync(src)) { return true; }
  string text = string.fromBytes(src);
  return loweredSources(onePath(), string[].filled(1, text))[0] != text;
}

/** Whether a source has an `async` token — which its lowering turns into uses of core's tickets. */
bool saysAsync(u8[] src) {
  Lexed lx = lex(src);
  for (i32 t = 0; t < lx.tokenCount; t++) {
    i32 k = lx.tokens[t * tokenStride()];
    if (k == kAsync()) { return true; }
    // A generator — `gen<…>`, `yield`, `coroutine` — is a machine too (spec ch36).
    if (k != kIdent()) { continue; }
    i32 from = lx.tokens[t * tokenStride() + 1];
    i32 len = lx.tokens[t * tokenStride() + 2];
    if (len != 3 && len != 5 && len != 9) { continue; }
    u8[] w = u8[].filled(len, 0);
    w.copyFrom(src, from, 0, len);
    string word = string.fromBytes(w);
    if (word == "yield" || word == "coroutine" || word == "gen") { return true; }
  }
  return false;
}

/** Whether a source holds an interpolated literal — a `\{` the lexer turns into a `+`. */
bool interpolates(u8[] src) {
  for (i32 i = 0; i + 1 < src.len(); i++) {
    if (src[i] == 92 && src[i + 1] == 123) { return true; }   // `\` then `{`
  }
  return false;
}

string[] onePath() { return string[].filled(1, "main.wac"); }

string[] oneSource(u8[] src) { return string[].filled(1, string.fromBytes(src)); }



/** The emitted functions in order, so a wasm "function #N" can be turned back into a name. */
export string names(u8[] src) {
  return emitNames(src);
}

/**
 * Rung 4 across files: one module for an entry and everything it imports.
 *
 * The file set comes from the caller because this compiler is a wasm module with no filesystem —
 * the same reason the reference takes a map of path to source rather than a directory. Passing more
 * files than the entry needs is fine; what is emitted is the closure, not the table.
 */
export u8[] emitFiles(string[] paths, string[] sources, string entry) {
  return emitLinked(paths, lowerSources(paths, sources, Res.empty()), entry);
}

/**
 * `emitFiles` with the project root each file sits in — `design/lang/0009` D7.
 *
 * The last member of the `In` family to be missing, which is why `harness/wacBind.ts` could not be
 * given the roots when everything else was: the non-coverage bind path emits through here, and there
 * was nothing to emit *with* a `Res`. `issues/system/0229a`.
 */
export u8[] emitFilesIn(string[] paths, string[] sources, Res res, string entry) {
  return emitLinkedIn(paths, lowerSources(paths, sources, res), res, entry);
}

/**
 * The same module with `--checked` arithmetic: `+`, `-` and `*` on an integer trap where the value
 * does not fit, instead of wrapping.
 *
 * A separate entry point rather than a parameter, because every existing caller wants the default
 * and the flag is the *build's* — whole-module, as the reference has it.
 */
export u8[] emitFilesChecked(string[] paths, string[] sources, string entry) {
  return emitLinkedChecked(paths, lowerSources(paths, sources, Res.empty()), entry);
}

/**
 * The same module instrumented for coverage: a counter per branch point, read through
 * `__cov_init()`, `__cov_len()`, `__cov_get(i)` and `__cov_hash(upto)`.
 */
export u8[] emitFilesCovered(string[] paths, string[] sources, string entry) {
  return emitLinkedCovered(paths, lowerSources(paths, sources, Res.empty()), entry);
}

/**
 * `emitFilesCovered` with the project root each file sits in — `design/lang/0009` D7.
 *
 * **This dropped the `Res` until 2026-08-20**: its body was character-for-character
 * `emitFilesCovered`'s, so a caller that passed roots got a coverage build that could not resolve
 * `@/` and answered "an import of a file that was not supplied". Two of the eight `Res`-taking entry
 * points here did that; the other is `diagnoseGraphIn`. `issues/lang/0157`.
 */
export u8[] emitFilesCoveredIn(string[] paths, string[] sources, Res res, string entry) {
  return emitLinkedCoveredIn(paths, lowerSources(paths, sources, res), res, entry);
}

/**
 * The exported functions and their wac types: `name\tret\tparam,param` per line.
 *
 * The metadata half of bindgen — which functions a host may call and what they take — which only the
 * compiler can answer. `packages/wacc/tools/waccBindgen.ts` turns it into TypeScript.
 */
export string exportSigsFiles(string[] paths, string[] sources, string entry) {
  Res res = Res.empty();
  return exportSigsLinked(paths, lowerSources(paths, sources, res), res, entry);
}

/** `exportSigsFiles` with the project root each file sits in — `design/lang/0009` D7. */
export string exportSigsFilesIn(string[] paths, string[] sources, Res res, string entry) {
    return exportSigsLinked(paths, lowerSources(paths, sources, res), res, entry);
}

/** The structs and enums a host can hold — see `bindTypesLinked` for the shape. */
export string bindTypesFiles(string[] paths, string[] sources, string entry) {
  Res res = Res.empty();
  return bindTypesLinked(paths, lowerSources(paths, sources, res), res, entry);
}

/** `bindTypesFiles` with the project root each file sits in — `design/lang/0009` D7. */
export string bindTypesFilesIn(string[] paths, string[] sources, Res res, string entry) {
    return bindTypesLinked(paths, lowerSources(paths, sources, res), res, entry);
}

/**
 * `blockedFiles`, `exportSigsFiles` and `bindTypesFiles` in one answer, separated by
 * `describeSep()`.
 *
 * A build wants both and used to ask twice, and each ask rebuilt the entire front end — link, lex,
 * parse, and the `settleEmittable` fixed point over every declaration. `issues/lang/0129`.
 */
export string describeFiles(string[] paths, string[] sources, string entry) {
  Res res = Res.empty();
  return describeLinked(paths, lowerSources(paths, sources, res), res, entry);
}

/**
 * The module and its description in one answer — one front end for the whole build.
 * `issues/lang/0129`.
 */
export Built buildFiles(string[] paths, string[] sources, string entry) {
  Res res = Res.empty();
  return buildLinked(paths, lowerSources(paths, sources, res), res, entry);
}

/** `buildFiles` with the project root each file sits in — `design/lang/0009` D7. */
export Built buildFilesIn(string[] paths, string[] sources, const Res res, string entry) {
    return buildLinked(paths, lowerSources(paths, sources, res), res, entry);
}

/** `describeFiles` with the project root each file sits in — `design/lang/0009` D7. */
export string describeFilesIn(string[] paths, string[] sources, Res res, string entry) {
  return describeLinked(paths, lowerSources(paths, sources, res), res, entry);
}

/**
 * Where a missing import was written: `key\tfrom\tspec`, or `""` when that is not why a link failed.
 *
 * For a caller that wants to point at the import rather than print a sentence about it — see
 * `example/wacc.wac`, which turns this into a diagnostic with a line and a caret. `issues/lang/0157`.
 */
export string missingImportFiles(string[] paths, string[] sources, string entry) {
  return missingImportParts(paths, sources, Res.empty(), entry);
}

/** The same with the project root each file sits in — `design/lang/0009` D7. */
export string missingImportFilesIn(string[] paths, string[] sources, Res res, string entry) {
  return missingImportParts(paths, sources, res, entry);
}

/** The line `describeFiles` puts between its two halves. */
export string describeSeparator() { return describeSep(); }

/**
 * The manifest a native host reads, as JSON — `packages/platform/native.ts` in wac.
 *
 * The module is a parameter rather than something this emits, because the caller building an
 * application wants both and compiling twice to answer one question is the kind of thing that makes
 * a self-hosted build slower than the one it replaces. `grants` is the bitmask `platform.wac` uses:
 * 1 read, 2 write, 4 net, 8 env.
 */
export string manifestFiles(u8[] wasm, string[] paths, string[] sources, string entry,
                            string wasmName, i32 grants) {
  Res res = Res.empty();
  return manifestOf(wasm, bindTypesLinked(paths, lowerSources(paths, sources, res), res, entry),
                    exportSigsLinked(paths, lowerSources(paths, sources, res), res, entry), entry, wasmName, grants);
}

/**
 * The same manifest, given the metadata directly rather than a program to derive it from.
 *
 * **`manifestFiles` above builds two more front ends** — `bindTypesLinked` and `exportSigsLinked` —
 * and a caller that has just run `buildFiles` already holds both answers, from a front end it has
 * already paid for. That caller was `wacc build`, which walked the graph five times to produce one
 * module: diagnose, blocked, emit, bind types, export sigs.
 *
 * `bindgenWire` is the same idea for the other consumer of that metadata, and this is its twin —
 * `wire` is `bindTypesFiles`'s format and `sigs` is `exportSigsFiles`'s, in that order, as
 * `describeFiles` hands them over.
 */
export string manifestWire(u8[] wasm, string wire, string sigs, string entry,
                           string wasmName, i32 grants) {
  return manifestOf(wasm, wire, sigs, entry, wasmName, grants);
}

/**
 * The glue a host calls this module through — `packages/wacc/tools/waccBindgen.ts` in wac.
 *
 * `lang` is `"ts"` or `"js"`. The module is a parameter for the same reason `manifestFiles` takes
 * one: the caller building an application wants both, and compiling twice to answer one question is
 * what makes a self-hosted build slower than the one it replaces.
 */
export string bindgenFiles(u8[] wasm, string[] paths, string[] sources, string entry, string lang) {
  Res res = Res.empty();
  return bindgenOf(wasm, exportSigsLinked(paths, lowerSources(paths, sources, res), res, entry),
                   bindTypesLinked(paths, lowerSources(paths, sources, res), res, entry), lang, false);
}

/**
 * The same generator, given metadata directly rather than a program to derive it from.
 *
 * **For the shapes no program can be made to produce on demand.** A name the linker keyed — `Node@2`,
 * where two files declare one name and the declaring file is not known — is the case this exists for:
 * it took `core` gaining an enum with a payload and `packages/tor` already having a `Node` for
 * anything to have two, and `@` is not a TypeScript identifier, so glue that carried it unsanitised
 * would not parse. `packages/wacc/test/wac/bindgenwac_test.wac` hands both generators the same keyed wire
 * and compares the text, which is the only way that property is checked for either of them.
 *
 * `sigs` is `exportSigsFiles`'s format and `wire` is `bindTypesFiles`'s.
 */
export string bindgenWire(u8[] wasm, string sigs, string wire, string lang) {
  return bindgenOf(wasm, sigs, wire, lang, false);
}

/** What bindgen could not write glue for, one `name(params) -> ret` per line. */
export string bindgenDeclinedFiles(string[] paths, string[] sources, string entry) {
  Res res = Res.empty();
  return bindgenDeclined(exportSigsLinked(paths, lowerSources(paths, sources, res), res, entry),
                         bindTypesLinked(paths, lowerSources(paths, sources, res), res, entry));
}

/** `bindgenDeclinedFiles` with the project root each file sits in — `design/lang/0009` D7. */
export string bindgenDeclinedFilesIn(string[] paths, string[] sources, Res res, string entry) {
    return bindgenDeclined(exportSigsLinked(paths, lowerSources(paths, sources, res), res, entry),
                         bindTypesLinked(paths, lowerSources(paths, sources, res), res, entry));
}

/**
 * The module with its manifest inside it, which is what makes it one artefact rather than two.
 *
 * **One front end, not three.** This used to be `emitLinked` followed by `manifestFiles`, and
 * `manifestFiles` derives the bind types and the export signatures with a full walk each — so a call
 * that reads as "emit, then describe what you emitted" walked the graph three times, the second and
 * third re-deriving what the first already knew. `buildLinked` is the call that answers both together
 * (`issues/lang/0129`); `manifestWire` is the manifest built from those answers rather than from a
 * program. Nine test files and every self-describing build go through here.
 */
export u8[] emitFilesSelfDescribing(string[] paths, string[] sources, string entry,
                                    string wasmName, i32 grants) {
  return emitFilesSelfDescribingIn(paths, sources, Res.empty(), entry, wasmName, grants);
}

/** `emitFilesSelfDescribing` with project roots and mappings — what a caller holding manifests passes. */
export u8[] emitFilesSelfDescribingIn(string[] paths, string[] sources, Res res, string entry,
                                      string wasmName, i32 grants) {
  Built b = buildLinked(paths, lowerSources(paths, sources, res), res, entry);
  string sep = describeSep();
  i32 first = b.described.indexOf(sep);
  // No separator is a description that did not parse — an empty wire and empty signatures, which
  // `manifestOf` turns into a manifest a host refuses loudly rather than one that is quietly wrong.
  string rest = first < 0 ? "" : b.described.slice(first + sep.len(), b.described.len());
  i32 second = rest.indexOf(sep);
  string sigs = second < 0 ? rest : rest.slice(0, second);
  string types = second < 0 ? "" : rest.slice(second + sep.len(), rest.len());
  return withManifestSection(b.wasm, manifestOf(b.wasm, types, sigs, entry, wasmName, grants));
}

/**
 * What each counter is: `index\tline\tcol\tkind\tfile` per line, in counter order.
 *
 * **The file is the fifth column and this comment omitted it** until 2026-08-29, which matters
 * because the table is the only thing that says *which* file a counter belongs to — a reader
 * writing a consumer against four columns gets line and column numbers with nothing to hang
 * them on. `wac build` writes this straight to `<stem>.cov`; the rows are the artefact.
 */
export string covTableFiles(string[] paths, string[] sources, string entry) {
  Res res = Res.empty();
  return covTableLinked(paths, lowerSources(paths, sources, res), res, entry);
}

/** `covTableFiles` with the project root each file sits in — `design/lang/0009` D7. */
export string covTableFilesIn(string[] paths, string[] sources, Res res, string entry) {
    return covTableLinked(paths, lowerSources(paths, sources, res), res, entry);
}

/**
 * The same module instrumented for a *trace* rather than for coverage — `wac ctcompare` reads one.
 *
 * Read through the same four accessors, because a consumer written against one compiler should
 * work against the other: `__cov_init()` clears the journal, `__cov_len()` is its capacity, and
 * `__cov_get(i)` reads a slot. Slot 0 is the cursor and events follow in `(site, value)` pairs.
 *
 * `__cov_hash(upto)` folds slots `[0, upto)` into one number, which is how `wac ctcompare` asks
 * whether two journals agree without fetching either: a host call carries one `i32` and costs ~1.6µs,
 * so a real journal is 13s a side to read and four calls to fold. `issues/system/0274b`.
 */
export u8[] emitFilesTraced(string[] paths, string[] sources, string entry) {
  return emitLinkedTraced(paths, lowerSources(paths, sources, Res.empty()), entry);
}

/**
 * The same with the journal sized by the caller: `slots` i32s, or 0 for the default 2^22.
 *
 * The last slot counts events whether or not there was room for them, so a run that overflows says
 * how large it needed to be — `__cov_get(__cov_len() - 1)`. `issues/lang/0059`.
 */
export u8[] emitFilesTracedSlots(string[] paths, string[] sources, string entry, i32 slots) {
  Res res = Res.empty();
  return emitLinkedTracedSlots(paths, lowerSources(paths, sources, res), res, entry, slots);
}

/** What each *trace* point is, including the `index` ones a counter build does not have. */
export string traceTableFiles(string[] paths, string[] sources, string entry) {
  Res res = Res.empty();
  return traceTableLinked(paths, lowerSources(paths, sources, res), res, entry);
}

/** Why a linked module was not emitted in full, or `""`. */
export string blockedFiles(string[] paths, string[] sources, string entry) {
  Res res = Res.empty();
  return blockedLinked(paths, lowerSources(paths, sources, res), res, entry);
}

/** `blockedFiles` with the project root each file sits in — `design/lang/0009` D7. */
export string blockedFilesIn(string[] paths, string[] sources, Res res, string entry) {
    return blockedLinked(paths, lowerSources(paths, sources, res), res, entry);
}

/**
 * Why the **emit** path gave up — the question `blockedFiles` cannot answer.
 *
 * The two walk different `Env`s, so a decline raised during emission reaches `blockedFiles` only as
 * the fallback "a type this emitter names only while emitting", whatever the real cause was. That
 * message cost four wrong guesses in a row while landing `design/lang/0002` tier two.
 *
 * `emitDeclineLinked` was written then, to end that — and was reachable only from inside `emit.wac`,
 * so the first program to hit the fallback message afterwards (`packages/platform`\'s substitute
 * capabilities) got the useless sentence again. An instrument nothing can call is not an instrument.
 */
export string emitDeclineFiles(string[] paths, string[] sources, string entry) {
  Res res = Res.empty();
  return emitDeclineLinked(paths, lowerSources(paths, sources, res), res, entry);
}

/**
 * Every lambda the walk recorded: where it is, which instantiation it belongs to, its signature and
 * what it captures.
 *
 * The same reasoning as `emitDeclineFiles` — it existed and was reachable only from inside
 * `emit.wac`, so the first thing it would have explained had to be diagnosed without it twice.
 */
export string lambdaReportFiles(string[] paths, string[] sources, string entry) {
  Res res = Res.empty();
  return lambdaReportLinked(paths, lowerSources(paths, sources, res), res, entry);
}

// ── Tokens, for a host that has to place something in a source ──────────────────────────────
//
// **A regex is the wrong instrument and that is the whole reason these exist.** `tools/mutate.ts`
// places mutations at token positions and its own note says why it will not scan for them: *"a
// regex for `<` finds every one inside a comment and a string literal."* It had the reference's
// lexer; the lexer that decides what the program means is this one.

/** `[kind, start, len, line, col]` per token, flat because bindgen cannot marshal a struct. */
export i32[] lexTokensOf(u8[] src) { return lexTokens(src); }

/** How many `i32`s a token occupies in that array. */
export i32 lexTokenStride() { return tokenStride(); }

/**
 * A token kind as the parser spells it in a diagnostic — `ident`, `int`, `const`, `trap`.
 *
 * Names rather than numbers across the boundary: a host comparing against `84` is pinned to an
 * ordering nothing promises, and `kinds.wac` is free to renumber.
 */
export string tokenKindName(i32 kind) { return kindName(kind); }

// ── The import walk, for a host that has to gather a graph ──────────────────────────────────
//
// **A host cannot hand `emitFiles` a closure it has no way to compute.** Every entry point above
// takes `paths` and `sources` already gathered, and the gathering needs three rules that belong to
// the language: which specifiers name a file at all, where a specifier resolves from, and which
// specifiers a source has. `harness/wacFiles.ts` had all three from the TypeScript reference, with
// a note saying why they were the compiler's own and not a copy — *"what it cost was the
// possibility of a program the harness gathers under one key and the compiler files under
// another"*. That reasoning is the reason these are exported rather than reimplemented.

/**
 * The import specifiers in `src`, the file at `path`.
 */
export string[] importSpecsFor(string path, u8[] src) {
  return importSpecs(src);
}

/** Whether `spec` names something the linker carries rather than a file to read. */
export bool isBuiltinSpecifier(string spec) { return isBuiltinSpec(spec); }

/** Whether `spec` is a `@/` — resolved against its file's project root rather than its directory. */
export bool isProjectSpecifier(string spec) { return isProjectSpec(spec); }

/**
 * `spec` as a key, for a file at `fromPath` whose project root is `root`.
 *
 * `root` may be empty for a file in no project, in which case a `@/` answers `""` — which is a
 * refusal rather than a fallback, and is `design/lang/0009` D7.
 */
export string resolveSpecifierAt(string fromPath, string spec, string root, string base) {
  return resolveFromAt(fromPath, spec, root, base);
}

/** The emitted functions of a linked program, in order, so a wasm "function #N" has a name. */
export string namesFiles(string[] paths, string[] sources, string entry) {
  Res res = Res.empty();
  return namesLinked(paths, lowerSources(paths, sources, res), res, entry);
}

/**
 * The type checker's diagnostics for one file **with the names it imports in scope**.
 *
 * Every diagnostic missed on this repository's own code — thirty-eight of thirty-eight — was in a
 * file that imports something, and none was in a file that does not. A checker given one file cannot
 * know what `Buf.create` takes or whether a `Node` has the field being read, and says nothing about
 * either. That is a ceiling rather than a rule, and this is the way through it.
 *
 * **Exactly the names the file asked for.** Letting an import contribute everything it declares put
 * another file's `Rng` in front of this file's — every table here is keyed by a bare name and the
 * first declaration wins — and reported forty working files. `import { X } from "…"` says which
 * names cross, so that list is the filter, and a name the file did not ask for cannot shadow one it
 * declares itself.
 */
/**
 * Does this file declare and export `name` under its own roof?
 *
 * An `Import` decl never answers yes, which is the whole of `§wac-no-reexport-f7kn4wq`: a file that
 * merely imports a symbol does not pass it on, and the fix is to import it from the file that
 * declares it. An exported enum answers for its variants as well as its own name, because a variant
 * imports like any other name (`§wac-type-name-scope-8vqk3mn`) — a check that missed that would
 * refuse most of the repository rather than find anything wrong with it.
 */
/**
 * `name` asked of the file `at`, followed through export lists to the file and name that declare it —
 * `[path, name, "y" when an export list of that file exported it as its own, else ""]`.
 *
 * Bounded, so a cycle of re-exports ends rather than spins.
 */
string[] followExport(string[] paths, string[] sources, Lexed?[] lexes, Program?[] progs, const Res res,
                      string at, string nm) {
  string local = "";
  for (i32 hop = 0; hop < 32; hop++) {
    i32 fi = indexOfPath(paths, at);
    if (fi < 0) { break; }
    u8[] fsrc = sources[fi].toBytes();
    Lexed flx = fi < lexes.len() && (lexes[fi] is not null) ? lexes[fi]! : lex(fsrc);
    Program fpg = fi < progs.len() && (progs[fi] is not null) ? progs[fi]! : parseProgram(P.create(fsrc, flx));
    string[] fw = exportForwards(fsrc, flx, fpg);
    i32 hit = 0 - 1;
    for (i32 w = 0; w < fw.len(); w++) {
      if (splitTabs(fw[w])[0] == nm) { hit = w; }
    }
    if (hit < 0) { break; }
    string[] parts = splitTabs(fw[hit]);
    string target = parts[1] == "" ? at : keyOf(resolveVia(res, paths, at, parts[1]));
    local = parts[1] == "" ? "y" : "";
    if (target == at && parts[2] == nm) { break; }
    at = target;
    nm = parts[2];
  }
  return [at, nm, local] as string[];
}

bool exportsName(u8[] src, Lexed lexed, Program prog, string name) {
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
        if (exported && tokenTextOf(src, lexed, nameTok) == name) { return true; }
      }
      StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        if (exported && tokenTextOf(src, lexed, nameTok) == name) { return true; }
      }
      EnumDecl(nameTok, variants, exported, methods, typeParams): {
        if (exported) {
          if (tokenTextOf(src, lexed, nameTok) == name) { return true; }
          for (i32 v = 0; v < variants.len(); v++) {
            if (tokenTextOf(src, lexed, variants[v].nameTok) == name) { return true; }
          }
        }
      }
      StaticDecl(nameTok, type, init, exported): {
        if (exported && tokenTextOf(src, lexed, nameTok) == name) { return true; }
      }
      SymbolDecl(nameTok, exported): {
        if (exported && tokenTextOf(src, lexed, nameTok) == name) { return true; }
      }
      TypeDecl(nameTok, typeParams, alias, body, exported): {
        if (exported && tokenTextOf(src, lexed, nameTok) == name) { return true; }
      }
      default: { }
    }
  }
  return false;
}

/**
 * Every diagnostic for an import graph, as text: one per line, `file\tline\tcol\tphase\tmessage`.
 *
 * Tab-separated because the boundary carries strings and not structures, and a caller that has to
 * parse something should parse the dullest thing available. spec/spec/errors.md asks for `span`,
 * `annotation` and `hint` as well; none of them can be filled from what `report` records, which is a
 * code and a position. That is the next thing to build rather than something to invent here.
 *
 * The parse phase answers first and alone: a file the parser could not read has no type errors worth
 * reporting, only the ones its unreadable shape would invent.
 */
/**
 * Every file's diagnostics, not just the entry's.
 *
 * `checkFiles` walks **only the entry's bodies** — every imported file contributes its signatures and
 * nothing else — so `export i32 helper() { return "x"; }` in an imported file is silent, and the
 * emitter then compiles it into a module that fails validation with a wasm-level type mismatch
 * instead of a source line. `issues/lang/0118`.
 *
 * Each file is checked *as an entry*, which is what makes this correct rather than approximate: a
 * file gets exactly the scope it would get if you named it on the command line, its own private
 * declarations included. That is why this is what `check` calls and `diagnoseFiles` is what a build
 * calls — the issue records what it would take to make both affordable.
 *
 * **What it costs, `tools/wac/benchcompile.wac`, 2026-08-19:** 378ms for wacc's own 17 files and 672ms for
 * box's 167, where box was 1347ms before the graph below was taken once instead of per file, and its
 * peak was 114 MiB above the floor rather than 51. The two numbers this docstring used to carry —
 * 0.9s and 9.9s — predate `issues/lang/0133` and were a good deal further out than they look, which
 * is the usual fate of a figure in a comment nothing checks.
 */
/**
 * The graph a build of `entry` compiles — spec ch05.
 *
 * Every declaration no export of the entry reaches is blanked, and every file no retained declaration
 * needs is left out, so what remains is checked and emitted as it stands. `wac check` does not come
 * here: checking a project retains everything (ch06).
 */
export Pruned pruneForBuild(string[] paths, string[] sources, Res res, string entry) {
  return pruneFor(paths, lowerSources(paths, sources, res), res, entry);
}

/** A build's diagnostics: the pruned graph, every remaining declaration checked in full. */
export string diagnoseBuildIn(string[] paths, string[] sources, Res res, string entry) {
  Pruned p = pruneFor(paths, lowerSources(paths, sources, res), res, entry);
  return diagnoseGraphIn(p.paths, p.sources, p.res, entry);
}

export string diagnoseGraph(string[] paths, string[] sources, string entry) {
  return diagnoseGraphIn(paths, sources, Res.empty(), entry);
}

/**
 * `diagnoseGraph` with the project root each file sits in — `design/lang/0009` D7.
 *
 * **This used to be a copy of `diagnoseGraph` that named a `Res` and never read it.** Its body
 * mentioned the parameter zero times, so `wac check` on a project — the one caller — got exactly the
 * answer it would have got from passing nothing: silence about any mistake reached through a `@/`
 * import, while the same mistake through a relative one was reported with a line and a caret. Being
 * a copy, it had also missed `issues/lang/0133`, so it walked the graph from the text. One body now.
 * `issues/lang/0175a`.
 */
export string diagnoseGraphIn(string[] paths, string[] rawSources, const Res res, string entry) {
  // Namespaces are lowered first, so checking a project reads what a build would (spec ch03).
  string[] sources = lowerSources(paths, rawSources, res);
  string out = "";
  // **Counted once for the whole graph.** Every closure below overlaps almost every other, so
  // letting each one size its own tables parsed a widely-imported file once per importer — 54% of
  // what this call cost, measured. `issues/lang/0133`.
  Lexed?[] lexes = Lexed?[].defaulted(paths.len() + 1);
  Program?[] progs = Program?[].defaulted(paths.len() + 1);
  string[] fronts = string[].filled(paths.len(), "");
  i32[] counts = declCountsAndFronts(paths, sources, lexes, progs, fronts);
  // **The edges too, once.** Every closure below was computed from the *text*: a file's import list
  // was re-extracted once per closure that reached it, and each spec resolved by a linear scan of
  // every path. Over the repository's own 718 files — closures summing to 10,904 — that is around
  // 11,000 import-list scans and tens of millions of string comparisons, to walk a graph with a few
  // thousand edges in it. Taken once, a closure is an integer walk and the loop below does no string
  // work at all.
  Edges edges = edgesOfIn(paths, sources, res, lexes);
  string coreText = coreSource();
  i32[] seen = i32[].filled(paths.len(), 0);
  for (i32 i = 0; i < paths.len(); i++) {
    // **Not the built-ins.** `std` and `core` are read for what a file imports from them, but checking
    // their own bodies here was more than checking the program that imports them, on every check; what
    // they say is fixed when the compiler is built, and `lexcost_test.wac` keeps it empty
    // (`issues/lang/0398b`).
    if (isBuiltinSpec(paths[i])) { continue; }
    // **Each file is checked against its own closure, not against the whole list.** Handing
    // `checkFilesWith` 179 files to check one that imports three is the whole of why the naive
    // loop costs `n ×` a full parse. Nothing is lost: a file cannot be affected by a file it does
    // not reach.
    i32 n = closureFrom(edges, i, seen);
    string[] subPaths = string[].filled(n, "");
    // One longer, like the three below: `core`'s text, built once for the whole graph.
    string[] subSources = string[].filled(n + 1, "");
    // One longer than the closure: `checkFilesWith` keeps `core`'s count in the last slot.
    i32[] subCounts = i32[].filled(n + 1, 0);
    Lexed?[] subLexes = Lexed?[].defaulted(n + 1);
    Program?[] subProgs = Program?[].defaulted(n + 1);
    string[] subFronts = string[].filled(n, "");
    for (i32 k = 0; k < n; k++) {
      i32 at = seen[k];
      subFronts[k] = fronts[at];
      subPaths[k] = paths[at];
      subSources[k] = at < sources.len() ? sources[at] : "";
      subCounts[k] = at < counts.len() ? counts[at] : 0;
      subLexes[k] = at < lexes.len() ? lexes[at] : null;
      subProgs[k] = at < progs.len() ? progs[at] : null;
    }
    subCounts[n] = counts[paths.len()];
    subSources[n] = coreText;
    subLexes[n] = lexes[paths.len()];
    subProgs[n] = progs[paths.len()];
    // **The roots have to be re-indexed with the paths**, because `Res.rootAt` pairs `roots[i]` with
    // `paths[i]` — a *positional* key. Everything above builds a closure array in `seen` order and
    // this call handed it the graph's `Res` unchanged, so every file read some other file's project
    // root, and usually "". `@/` then resolved against nothing, the import landed on a key nobody
    // supplied, and the names it brings in were declared *unknown* — which this checker is silent
    // about by design. So a mistake behind a `@/` import in any file but the entry was invisible.
    //
    // `issues/lang/0175a` fixed the entry's own case by threading the `Res` this far;
    // `issues/lang/0267c` is this sibling, which the thread reached and the indexing did not.
    //
    // The mappings are keyed by path *string* — `mappedTo` compares `mapFrom[i] == from` — so they
    // survive the subsetting unchanged and only `roots` needs rebuilding.
    string[] subRoots = string[].filled(n, "");
    for (i32 k = 0; k < n; k++) {
      i32 at = seen[k];
      subRoots[k] = at < res.roots.len() ? res.roots[at] : "";
    }
    Res subRes = Res(subRoots, res.mapFrom, res.mapSpec, res.mapTo, res.base);
    out = out + diagnoseFilesWithIn(subPaths, subSources, subRes, paths[i], subCounts,
                                    subLexes, subProgs, subFronts);
  }
  // **What the build will refuse, `check` says too.** An `async` function the lowering cannot take is
  // declined by the emitter, which `check` never runs — so a program checked clean and then would not
  // build, with the reason only in the build's message. The lowering is cheap where there is nothing
  // to lower, and its reason names the line when the reason has one.
  u8[][] srcBytes = u8[][].filled(sources.len(), u8[]());
  for (i32 i = 0; i < sources.len(); i++) { srcBytes[i] = sources[i].toBytes(); }
  string sigs = ticketSigsOf(progs, srcBytes, lexes);
  for (i32 i = 0; i < paths.len(); i++) {
    if (i >= progs.len() || (progs[i] is null) || (lexes[i] is null) || isBuiltinSpec(paths[i])) { continue; }
    Lowered lo = lowerProgram(progs[i]!, (i < sources.len() ? sources[i] : "").toBytes(), lexes[i]!, sigs);
    if (lo.why == "") { continue; }
    string why = lo.why;
    string line = "1";
    if (startsWith(why, "line ") && why.indexOf(": ") > 5) {
      line = why.slice(5, why.indexOf(": "));
      why = why.slice(why.indexOf(": ") + 2, why.len());
    }
    out = out + paths[i] + "\t" + line + "\t1\tcheck\tan `async` function this compiler cannot lower\t"
        + why + "\t\t0\n";
  }
  return out;
}

/** Where `path` sits in `paths`, or -1. */
i32 indexOfPath(string[] paths, string path) {
  for (i32 i = 0; i < paths.len(); i++) {
    if (paths[i] == path) { return i; }
  }
  return -1;
}

/**
 * A graph's import edges: the files `paths[i]` imports are `to[start[i] .. start[i + 1]]`.
 *
 * Compressed rather than an array of arrays, because the whole point is that a closure walk touches
 * no strings — and one flat array with offsets is the shape a fixed-size language can build in two
 * passes without a growable one.
 */
struct Edges {
  /** One longer than `paths`: `start[i]` to `start[i + 1]` are file `i`'s edges. */
  i32[] start;
  i32[] to;
}


/**
 * The same, resolving each specifier the way the reader did — `design/lang/0009` D7 and D9.
 *
 * **The `Res` is what makes a `@/` or a mapped import an edge at all.** With `resolveFrom` such a
 * spec resolves to a key no supplied file has, so it was dropped here, so the importing file's
 * closure did not contain the file it imports, so every name from it was unknown — and unknown is
 * silent. `issues/lang/0175a`.
 */
/**
 * `paths` grouped by length, so finding a path's index compares a handful rather than all of them.
 *
 * **Two equal strings have equal length**, so a bucket keyed on length can only ever miss a *different*
 * path — never the one being looked for. That is the whole of the correctness argument, and it is why
 * this needs no hash and no arithmetic that could overflow.
 *
 * Length rather than a first character because every path in a corpus walk begins `packages/`: the first
 * byte discriminates nothing. Lengths spread over a few dozen values, so 256 buckets leave tens of
 * candidates instead of a thousand.
 */
struct ByLen {
  /** `length & 255` → the first path index in that bucket, or -1. */
  i32[] head;
  /** A path index → the next index sharing its bucket, or -1. */
  i32[] next;
}

ByLen byLength(string[] paths) {
  i32[] head = i32[].filled(256, 0 - 1);
  i32[] next = i32[].filled(paths.len(), 0 - 1);
  for (i32 i = 0; i < paths.len(); i++) {
    i32 b = paths[i].len() & 255;
    next[i] = head[b];
    head[b] = i;
  }
  return ByLen(head, next);
}

/** `indexOfPath` through the buckets — the same answer, without the scan. */
i32 indexVia(ByLen ix, string[] paths, string path) {
  for (i32 i = ix.head[path.len() & 255]; i >= 0; i = ix.next[i]) {
    if (paths[i] == path) { return i; }
  }
  return 0 - 1;
}

Edges edgesOfIn(string[] paths, string[] sources, const Res res, Lexed?[] lexes) {
  i32 n = paths.len();
  ByLen ix = byLength(paths);
  // **Parsed once, resolved once, and looked up through buckets — measured at 41% of a whole-corpus
  // check before this.** The two passes each re-parsed every file's import list and re-resolved every
  // specifier, and each resolution then scanned `paths` linearly, so the whole function was
  // O(files² × imports) with the parse done twice over. On the 1,003-file corpus that was 10.9s of a
  // 26.6s `diagnoseGraph` — measured by calling this twice and subtracting, which is honest where
  // deleting the call is not: with no edges every closure is empty and almost nothing gets checked.
  //
  // The specs are kept rather than recomputed, which is what removes the second parse.
  string[][] specsOf = string[][].filled(n, string[]());
  i32 upper = 0;
  for (i32 i = 0; i < n; i++) {
    string src = i < sources.len() ? sources[i] : "";
    // **Read off the tokens the caller already has**, rather than lexing and parsing the file again
    // for its import list (`issues/lang/0398b`).
    Lexed? have = i < lexes.len() ? lexes[i] : null;
    specsOf[i] = have is null ? importSpecs(src.toBytes()) : importSpecsLexed(src.toBytes(), have!);
    upper = upper + specsOf[i].len();
  }
  // **Sized at the upper bound and filled once.** The count pass existed to size `to` exactly; a
  // specifier that resolves outside the graph is dropped, so the exact count needs the resolutions the
  // count pass was there to avoid. `start[n]` still says where the edges end and the only reader walks
  // `start[f]` to `start[f + 1]`, so a longer tail is never looked at.
  i32[] start = i32[].filled(n + 1, 0);
  i32[] to = i32[].filled(upper, 0);
  i32 at = 0;
  for (i32 i = 0; i < n; i++) {
    start[i] = at;
    for (i32 s = 0; s < specsOf[i].len(); s++) {
      i32 t = indexVia(ix, paths, keyOf(resolveVia(res, paths, paths[i], specsOf[i][s])));
      if (t >= 0) { to[at] = t; at = at + 1; }
    }
  }
  start[n] = at;
  return Edges(start, to);
}

/**
 * The files index `i` reaches, itself first, into `seen` — and how many there are.
 *
 * **The only closure walk.** There was a second one in the path domain, resolving each specifier as
 * it went, because `edgesOf` resolved with plain `resolveFrom` and so a `@/` or a mapped specifier
 * was not an edge here at all. `edgesOfIn` resolves through the `Res` instead, which is the same fix
 * one level down and leaves this walk correct for a project graph too — `issues/lang/0175a`.
 *
 * `seen` is the caller's because an array is sized where it is made, and the caller already has the
 * only bound that matters: no closure is larger than the graph. It is reused across a whole sweep,
 * since each walk overwrites the prefix it returns.
 */
i32 closureFrom(Edges e, i32 i, i32[] seen) {
  seen[0] = i;
  i32 n = 1;
  i32 at = 0;
  while (at < n) {
    i32 f = seen[at];
    for (i32 k = e.start[f]; k < e.start[f + 1]; k++) {
      i32 next = e.to[k];
      bool have = false;
      for (i32 j = 0; j < n; j++) { if (seen[j] == next) { have = true; } }
      if (have || n >= seen.len()) { continue; }
      seen[n] = next;
      n = n + 1;
    }
    at = at + 1;
  }
  return n;
}

/** The whole graph's diagnostics, laid out for a person. What `example/wacc.wac` prints. */
export string diagnoseGraphRendered(string[] paths, string[] sources, string entry) {
  return renderDiagnostics(diagnoseGraph(paths, sources, entry), paths, sources);
}

/**
 * Whether a wire holds anything that is **not** a warning.
 *
 * For a caller that has to decide whether a compile failed. `diagnoseGraphRendered` used to filter
 * warnings out, so that a caller deciding on the string's emptiness could not be handed one — which
 * protected `example/wacc.wac` at the cost of that binary never printing a warning at all. It asks
 * this instead now, so the filter is gone and both reach the reader.
 *
 * Field 3 is the phase, found by counting tabs: this file has no split, and a warning line is
 * otherwise indistinguishable from an error's.
 */
export bool wireHasErrors(string wire) {
  i32 from = 0;
  for (i32 i = 0; i <= wire.len(); i++) {
    if (i < wire.len() && wire[i] != "\n") { continue; }
    string line = wire.slice(from, i);
    from = i + 1;
    if (line == "") { continue; }
    // Severity is the last field, so this is a suffix test rather than a walk to the ninth tab.
    bool warn = line.len() >= 8 && line.slice(line.len() - 8, line.len()) == "\twarning";
    if (!warn) { return true; }
  }
  return false;
}



/**
 * The same diagnostics, laid out for a person — `src/render.wac`, and what `waccx` prints.
 *
 * The wire is for a program and this is for a reader, and a compiler that only answers the first is
 * usable exactly where nothing is wrong. `example/wacc.wac` prints this.
 */
export string diagnoseFilesRendered(string[] paths, string[] sources, string entry) {
  return renderDiagnostics(diagnoseFiles(paths, sources, entry), paths, sources);
}

export string diagnoseFiles(string[] paths, string[] sources, string entry) {
  return diagnoseFilesIn(paths, sources, Res.empty(), entry);
}

/** `diagnoseFiles` with the project root each file sits in — `design/lang/0009` D7. */
export string diagnoseFilesIn(string[] paths, string[] rawSources, Res res, string entry) {
  string[] sources = lowerSources(paths, rawSources, res);
  Lexed?[] lexes = Lexed?[].defaulted(paths.len() + 1);
  Program?[] progs = Program?[].defaulted(paths.len() + 1);
  string[] fronts = string[].filled(paths.len(), "");
  i32[] counts = declCountsAndFronts(paths, sources, lexes, progs, fronts);
  return diagnoseFilesWithIn(paths, sources, res, entry, counts, lexes, progs, fronts);
}


/** The same again with the resolution context — see `checkFilesWithIn` for what it buys. */
string diagnoseFilesWithIn(string[] paths, string[] sources, Res res, string entry, i32[] counts,
                           Lexed?[] lexes, Program?[] progs, string[] fronts) {
  // **Each file's lexical and parse complaints, as `declCountsAndFronts` wrote them** — read once per
  // file, where this used to lex and parse every file again for each closure that reached it.
  string out = "";
  for (i32 i = 0; i < paths.len(); i++) { out = out + (i < fronts.len() ? fronts[i] : ""); }
  bool parseFailed = out != "";
  if (parseFailed) { return out; }

  C c = checkFilesWithIn(paths, sources, res, entry, counts, lexes, progs);
  i32[] terrs = errorsOf(c);
  string[] notes = notesOf(c);
  // **Zero where nothing measured it.** A width of one is a claim — that the diagnostic really is
  // one character wide, as it is for `;` — and the checker only knows that where it reported at a
  // token. The renderer reads a zero as one; a *measurement* of how many diagnostics carry a real
  // span must be able to tell the two apart.
  i32[] widths = widthsOf(c);
  // **A hint written for this diagnostic wins over the code's own.** `hintFor` cannot quote the
  // reader's expression, and two clauses in spec/spec/errors.md state hints that do — so a site with
  // the text in hand records one and everything else falls through to the table exactly as before.
  string[] hints = hintsOf(c);
  // **The first line to print, where the caret's own line is not it.** `§wac-diag-multiline-ic7x2hq`
  // shows the lines above the caret, and the renderer cannot know which construct the diagnostic came
  // from — so the number crosses. `issues/lang/0232a`.
  i32[] contexts = contextsOf(c);
  for (i32 e = 0; e + 2 < terrs.len(); e = e + 3) {
    string note = e / 3 < notes.len() ? notes[e / 3] : "";
    i32 w = e / 3 < widths.len() ? widths[e / 3] : 0;
    string own = e / 3 < hints.len() ? hints[e / 3] : "";
    i32 from = e / 3 < contexts.len() ? contexts[e / 3] : 0;
    out = out + entry + "\t" + numText(terrs[e + 1]) + "\t" + numText(terrs[e + 2])
        // **Spelled as a program writes them**: the checker's own notation for a function type is not
        // wac, and a reader shown it would be taught a syntax the parser refuses.
        + "\tcheck\t" + checkMessage(terrs[e]) + "\t" + displayTypes(note)
        + "\t" + displayTypes(own == "" ? hintFor(terrs[e]) : own)
        + "\t" + numText(w)
        // **Only where there is one, which keeps every line that has none byte-identical.** The wire
        // is positional and already asymmetric on purpose — an error carries eight fields and a
        // warning nine, because *"a consumer that splits on tabs reads an absent ninth field as
        // empty"*. A tenth appended unconditionally would rewrite every diagnostic in the repository
        // for the sake of the few that have a context; appended here it changes only those.
        //
        // The empty ninth is the severity, which an error does not set: a tenth field cannot be
        // reached past an absent ninth.
        + (from > 0 ? "\t\t" + numText(from) : "")
        + "\n";
  }
  // **Warnings after the errors, with a severity in a field of its own.**
  //
  // A ninth field rather than a fourth `phase` value, which is what this did first: `spec/spec/
  // errors.md` gives a diagnostic a `severity` *and* a `phase`, and they are different questions — a
  // warning found while type-checking is `check` and `warning`, and overloading the phase leaves a
  // parse-time warning unable to say either thing truthfully. Additive, since a consumer that splits
  // on tabs reads an absent ninth field as empty, which is what an error has.
  //
  // What must not happen is a warning reaching a *count* that decides whether a compile succeeded,
  // which is why it has its own table and its own loop rather than a column on the errors.
  // `issues/lang/0126`.
  i32[] warns = warningsOf(c);
  for (i32 w2 = 0; w2 + 2 < warns.len(); w2 = w2 + 3) {
    out = out + entry + "\t" + numText(warns[w2 + 1]) + "\t" + numText(warns[w2 + 2])
        + "\tcheck\t" + warnMessage(warns[w2]) + "\t\t\t0\twarning\n";
  }
  return out;
}

export i32[] dumpTypeErrorsFiles(string[] paths, string[] sources, string entry) {
  return errorsOf(checkFiles(paths, loweredSources(paths, sources), entry));
}

/**
 * A file set with its namespaces lowered — the text a build parses (spec ch03). A caller that
 * parses files one at a time must parse these: `[operators.add]` is not a member name until the
 * lowering has made it `[@"operators.add"]`.
 */
export string[] loweredSources(string[] paths, string[] sources) {
  return lowerSources(paths, sources, Res.empty());
}

/** The checker, run over an import graph, with its tables still in hand for whatever wants them. */
/**
 * How many rows a file will add to the checker's module-wide tables.
 *
 * One per declaration, plus what a struct or an enum brings with it: its fields, its methods, its
 * variants and each variant's payload. Counted from the parse rather than estimated from the text,
 * because the whole point of `issues/lang/0099` is that a guess in either direction is a defect —
 * too small overflows silently, too large costs hundreds of megabytes. The `+ 8` is slack for the
 * rows a declaration adds beside itself, like an enum's tag.
 */
i32 declarationsIn(u8[] src, Lexed lexed, Program prog) {
  i32 n = 8;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    n = n + 8;
    match (prog.decls[d].kind) {
      StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        n = n + fields.len() + methods.len() * 2 + typeParams.len();
        for (i32 m = 0; m < methods.len(); m++) { n = n + methods[m].params.len(); }
      }
      EnumDecl(nameTok, variants, exported, methods, typeParams): {
        n = n + variants.len() * 2 + methods.len() * 2 + typeParams.len();
        for (i32 v = 0; v < variants.len(); v++) { n = n + variants[v].fields.len(); }
        for (i32 m = 0; m < methods.len(); m++) { n = n + methods[m].params.len(); }
      }
      Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
        n = n + params.len() + typeParams.len();
      }
      default: { }
    }
  }
  return n;
}

/** The name `core` resolves to: a file no caller supplies, which the compiler carries. */
string corePath() { return " core"; }

/**
 * A resolved specifier as the key this checker holds it under: `"core"` is the carried module.
 *
 * **One key, or two copies.** A caller that serves the built-ins itself — the CLI does — supplies
 * `core` under `"core"`, and this checker adds the carried copy under `corePath()`. Read through both,
 * `core` is two modules declaring every type twice, and a type that reaches a file only through a
 * signature — `Map.get` answering an `Option` — is renamed apart from itself.
 */
string keyOf(string resolved) { return resolved == "core" ? corePath() : resolved; }

/** Every named type mentioned anywhere in a `Ty`, appended to `out` with `n[0]` as the count. */
void tyNames(u8[] src, Lexed lx, Ty t, string[] out, i32[] n) {
  match (t.kind) {
    Named(tok, typeArgs): {
      if (n[0] < out.len()) {
        out[n[0]] = tokenTextOf(src, lx, tok);
        n[0] = n[0] + 1;
      }
      for (i32 i = 0; i < typeArgs.len(); i++) { tyNames(src, lx, typeArgs[i], out, n); }
    }
    Arr(elem): { tyNames(src, lx, elem, out, n); }
    Nullable(inner): { tyNames(src, lx, inner, out, n); }
    Funcref(ret, params): {
      tyNames(src, lx, ret, out, n);
      for (i32 i = 0; i < params.len(); i++) { tyNames(src, lx, params[i], out, n); }
    }
    default: { }
  }
}

/** Whether `list`'s first `n` entries hold `name`. */
/**
 * Whether some file *other* than `selfIndex` also declares a type called `name`.
 *
 * The question `issues/lang/0128`'s fix turns on. Renaming every type that reaches a file only
 * through a signature is wrong: `packages/tor` declares `Link` in `link.wac`, `bootstrap.wac` puts it
 * in `Session.link` without declaring it, and `hsfetch.wac` imports `fetchOverCircuit` without
 * importing `Link` — so a blanket rename gave the parameter a name the field did not have and
 * reported three working files. A name is only ambiguous when two files actually declare it.
 *
 * Reads the programs already parsed for the whole graph and **never parses one itself** — a file
 * whose program is absent is skipped rather than re-read, because this runs inside the loop over
 * imports and re-parsing there is what `issues/lang/0133` was about. Skipping is safe in the
 * direction that matters: it can only make this answer `false`, which leaves the name alone.
 */
/** Which files of a closure declare each struct and enum name — one row per declaration. */
struct TypeHomes {
  string[] names;
  i32[] files;
  i32 n;
  KeyIndex ix;
}

/**
 * Every struct and enum the files of a closure declare, indexed by name — built once per closure. It
 * was a walk of every other file's declarations per reached type, copying each file's text, `std`'s
 * and `core`'s included: the product of the two (`issues/lang/0398b`).
 */
TypeHomes typeHomesOf(string[] paths, string[] sources, Lexed?[] lexes, Program?[] progs) {
  TypeHomes h = TypeHomes(string[].filled(64, ""), i32[].filled(64, 0), 0, KeyIndex.create());
  for (i32 j = 0; j < paths.len(); j++) {
    if (j >= progs.len() || (progs[j] is null)) { continue; }
    if (j >= lexes.len() || (lexes[j] is null)) { continue; }
    Program jp = progs[j]!;
    Lexed jlx = lexes[j]!;
    u8[] jsrc = sources[j].toBytes();
    for (i32 d = 0; d < jp.decls.len(); d++) {
      string name = "";
      match (jp.decls[d].kind) {
        StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
          name = tokenTextOf(jsrc, jlx, nameTok);
        }
        EnumDecl(nameTok, variants, exported, methods, typeParams): {
          name = tokenTextOf(jsrc, jlx, nameTok);
        }
        default: { }
      }
      if (name == "") { continue; }
      if (h.n >= h.names.len()) {
        string[] names = string[].filled(h.names.len() * 2, "");
        i32[] files = i32[].filled(h.names.len() * 2, 0);
        for (i32 k = 0; k < h.n; k++) { names[k] = h.names[k]; files[k] = h.files[k]; }
        h.names = names;
        h.files = files;
      }
      h.names[h.n] = name;
      h.files[h.n] = j;
      keyAdd(h.ix, name, h.n);
      h.n = h.n + 1;
    }
  }
  return h;
}

/** Whether a file other than `selfIndex` declares a struct or enum called `name`. */
bool typeDeclaredElsewhere(TypeHomes h, i32 selfIndex, string name) {
  for (i32 k = keyFirst(h.ix, name); k >= 0; k = h.ix.next[k]) {
    if (h.names[k] == name && h.files[k] != selfIndex) { return true; }
  }
  return false;
}

bool listHas(string[] list, i32 n, string name) {
  for (i32 i = 0; i < n; i++) {
    if (list[i] == name) { return true; }
  }
  return false;
}

/**
 * The names a file must declare so that what the entry asked for is fully typed.
 *
 * `only` is what the entry wrote in its import list, and that is not enough: a struct's field can
 * hold `fn<Pending<i32>()>`, so calling it answers a `Pending<i32>` in a file that never named
 * `Pending`. Undeclared, that type has no members — `.wait()` on it answers nothing and every rule
 * downstream goes quiet, which built a module the engine refused to load (`issues/lang/0132`).
 *
 * So the wanted set is closed over the *signatures* of what is wanted: field types, method return
 * types and method parameter types, transitively, and only over types this file itself declares.
 * Bodies are deliberately not walked — a local variable's type inside somebody else's method is not
 * something the entry can reach, and walking them would pull in most of a large module for nothing.
 *
 * The extras are returned after the originals so the caller can tell them apart: they are declared
 * for their members and must not enter the entry's scope as names.
 */
string[] closeOverSignatures(u8[] src, Lexed lx, Program prog, string[] only) {
  i32 cap = only.len();
  for (i32 d = 0; d < prog.decls.len(); d++) { cap = cap + 1; }
  string[] want = string[].filled(cap, "");
  i32 n = 0;
  for (i32 i = 0; i < only.len() && n < cap; i++) {
    if (listHas(want, n, only[i])) { continue; }
    want[n] = only[i];
    n = n + 1;
  }

  // Names this file declares, so a signature mentioning `i32` or a type from a third module adds
  // nothing — this file could not declare those even if asked.
  string[] mine = string[].filled(prog.decls.len(), "");
  i32 mn = 0;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        mine[mn] = tokenTextOf(src, lx, nameTok);
        mn = mn + 1;
      }
      EnumDecl(nameTok, variants, exported, methods, typeParams): {
        mine[mn] = tokenTextOf(src, lx, nameTok);
        mn = mn + 1;
      }
      // An alias too: `Files.readFile` answers a `ReadFault`, and the union it names is reached through it.
      TypeDecl(nameTok, typeParams, alias, body, exported): {
        mine[mn] = tokenTextOf(src, lx, nameTok);
        mn = mn + 1;
      }
      default: { }
    }
  }

  // To a fixpoint: a reached type's own signature can reach further. Bounded by `cap`, and the loop
  // makes progress or stops, so the bound is a safety net rather than the thing that ends it.
  bool grew = true;
  while (grew) {
    grew = false;
    for (i32 d = 0; d < prog.decls.len(); d++) {
      string[] found = string[].filled(64, "");
      i32[] seen = i32[].filled(1, 0);
      match (prog.decls[d].kind) {
        StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
          if (!listHas(want, n, tokenTextOf(src, lx, nameTok))) { continue; }
          // **A parent is reached too**: its fields are the subtype's, and a default construction
          // of `Ticket<i32>` asks whether `TicketBase`'s fields all have defaults.
          if (parentTok >= 0) {
            found[seen[0]] = tokenTextOf(src, lx, parentTok);
            seen[0] = seen[0] + 1;
          }
          for (i32 i = 0; i < fields.len(); i++) { tyNames(src, lx, fields[i].type, found, seen); }
          for (i32 i = 0; i < methods.len(); i++) {
            tyNames(src, lx, methods[i].returnType, found, seen);
            for (i32 p = 0; p < methods[i].params.len(); p++) {
              tyNames(src, lx, methods[i].params[p].type, found, seen);
            }
          }
        }
        EnumDecl(nameTok, variants, exported, methods, typeParams): {
          if (!listHas(want, n, tokenTextOf(src, lx, nameTok))) { continue; }
          for (i32 v = 0; v < variants.len(); v++) {
            for (i32 i = 0; i < variants[v].fields.len(); i++) {
              tyNames(src, lx, variants[v].fields[i].type, found, seen);
            }
          }
          for (i32 i = 0; i < methods.len(); i++) {
            tyNames(src, lx, methods[i].returnType, found, seen);
            for (i32 p = 0; p < methods[i].params.len(); p++) {
              tyNames(src, lx, methods[i].params[p].type, found, seen);
            }
          }
        }
        // **A function's signature reaches as far as a field's does.** `export Pending<i32> later()`
        // hands the caller a type it never named, exactly as `Cli`'s fields do — this arm was
        // missing from the first version of the fix, and the silence it left was identical.
        Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
          if (!listHas(want, n, tokenTextOf(src, lx, nameTok))) { continue; }
          tyNames(src, lx, returnType, found, seen);
          for (i32 p = 0; p < params.len(); p++) {
            tyNames(src, lx, params[p].type, found, seen);
          }
        }
        // A module-level `const`'s type, for the same reason and by the same reach.
        StaticDecl(nameTok, type, init, exported): {
          if (!listHas(want, n, tokenTextOf(src, lx, nameTok))) { continue; }
          tyNames(src, lx, type, found, seen);
        }
        // **An alias reaches what it names**: `SpawnFault` is `union<NotGranted, Unsupported, Other>`, and a file
        // that imported the alias alone had none of the three, so the union converted to no text (case 0855).
        TypeDecl(nameTok, typeParams, alias, body, exported): {
          if (!listHas(want, n, tokenTextOf(src, lx, nameTok))) { continue; }
          if (alias is not null) { tyNames(src, lx, alias!, found, seen); }
        }
        default: { continue; }
      }
      for (i32 i = 0; i < seen[0]; i++) {
        if (!listHas(mine, mn, found[i])) { continue; }
        if (listHas(want, n, found[i])) { continue; }
        if (n >= cap) { continue; }
        want[n] = found[i];
        n = n + 1;
        grew = true;
      }
    }
  }

  string[] out = string[].filled(n, "");
  for (i32 i = 0; i < n; i++) { out[i] = want[i]; }
  return out;
}


/**
 * What other files must declare for a file that imports `only` from this one: each name the reached
 * signatures mention that this file imports, as `file<TAB>name` under the name the other file gave it
 * — plus core's `Ticket`, when a reached function or method is `async`, since its callers are handed
 * one though no signature spells it.
 *
 * **A type reached through someone else's signature is still a type with members.** `many()` answering
 * core's `Vec<i32>`, or an imported `async` function answering a `Ticket<Ran>`, left the importer with a
 * type it had never declared — unknown, so `many().nope()` and `run().out` passed silently, and the
 * emitter found them instead. Not only core's: a `Shell` whose `fs` field is an `Fs` left
 * `sh.fs.readFile(p)` unknown in a file that imported `Shell` and not `Fs`, so a missing `await` there
 * reached the engine as a module it refused (`spec/cases/0563`).
 */
string[] namesReachedThroughImports(u8[] src, Lexed lx, Program prog, string[] reach, const Res res,
                                    string[] paths, string fromPath) {
  // What this file imports, by the name it gave, the name the other file gave, and which file.
  string[] local = string[].filled(256, "");
  string[] orig = string[].filled(256, "");
  string[] from = string[].filled(256, "");
  i32 ln = 0;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      Import(pathTok, prefixTok, items): {
        string q = pathTok < 0 ? "" : tokenTextOf(src, lx, pathTok);
        string target = pathTok < 0 || q == "\"core\""
          ? corePath()
          : keyOf(resolveVia(res, paths, fromPath, q.slice(1, q.len() - 1)));
        for (i32 j = 0; j < items.len() && ln < local.len(); j++) {
          if (items[j].nameTok < 0) { continue; }
          string o = tokenTextOf(src, lx, items[j].nameTok);
          orig[ln] = o;
          local[ln] = items[j].aliasTok < 0 ? o : tokenTextOf(src, lx, items[j].aliasTok);
          from[ln] = target;
          ln = ln + 1;
        }
      }
      default: { }
    }
  }
  string[] found = string[].filled(256, "");
  i32[] seen = i32[].filled(1, 0);
  bool anyAsync = false;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
        if (!listHas(reach, reach.len(), tokenTextOf(src, lx, nameTok))) { continue; }
        if (isAsync) { anyAsync = true; }
        tyNames(src, lx, returnType, found, seen);
        for (i32 p = 0; p < params.len(); p++) { tyNames(src, lx, params[p].type, found, seen); }
      }
      StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        if (!listHas(reach, reach.len(), tokenTextOf(src, lx, nameTok))) { continue; }
        for (i32 i = 0; i < fields.len(); i++) { tyNames(src, lx, fields[i].type, found, seen); }
        for (i32 i = 0; i < methods.len(); i++) {
          if (methods[i].isAsync) { anyAsync = true; }
          tyNames(src, lx, methods[i].returnType, found, seen);
          for (i32 p = 0; p < methods[i].params.len(); p++) { tyNames(src, lx, methods[i].params[p].type, found, seen); }
        }
      }
      default: { }
    }
  }
  string[] out = string[].filled(seen[0] + 1, "");
  i32 n = 0;
  for (i32 i = 0; i < seen[0]; i++) {
    for (i32 k = 0; k < ln; k++) {
      string entry = from[k] + "\t" + orig[k];
      if (local[k] == found[i] && !listHas(out, n, entry)) {
        out[n] = entry;
        n = n + 1;
      }
    }
  }
  string ticket = corePath() + "\tTicket";
  if (anyAsync && !listHas(out, n, ticket)) {
    out[n] = ticket;
    n = n + 1;
  }
  string[] exact = string[].filled(n, "");
  for (i32 i = 0; i < n; i++) { exact[i] = out[i]; }
  return exact;
}

/** A file's lexical and parse complaints as wire lines, from its frontend — "" when it read cleanly. */
string frontDiagnostics(string path, Frontend fe) {
  Lexed lexed = fe.lexed;
  string out = "";
  // A lexical complaint names its own phase — the reference has four (`lex`, `parse`, `resolve`,
  // `typecheck`) and this package emitted two, because it never had a lex error to emit.
  for (i32 e = 0; e < lexed.errorCount; e++) {
    out = out + path + "\t" + numText(lexed.errors[e * 3 + 1]) + "\t"
        + numText(lexed.errors[e * 3 + 2]) + "\tlex\t" + lexMessage(lexed.errors[e * 3])
        + "\t\t\t1\n";
  }
  for (i32 e = 0; e < fe.errorCount; e++) {
    string note = e < fe.notes.len() ? fe.notes[e] : "";
    // The span is the token the parser stopped on. A checker diagnostic has no width to give — it
    // reports at an expression, and nothing records how far that expression ran.
    i32 width = e < fe.widths.len() ? fe.widths[e] : 0;
    out = out + path + "\t" + numText(fe.errors[e * 3 + 1]) + "\t"
        + numText(fe.errors[e * 3 + 2])
        + "\tparse\t" + parseMessage(fe.errors[e * 3]) + "\t" + note + "\t"
        + parseHintFor(fe.errors[e * 3]) + "\t" + numText(width) + "\n";
  }
  return out;
}

/**
 * The same, keeping what it parsed.
 *
 * `checkFilesWith`'s second loop lexes and parses again for every file the entry wants a name from,
 * and across a graph that is the same file re-parsed once per importer — ~210 ms on
 * `packages/box`, 25% of `diagnoseGraph` (`issues/lang/0133`). These are the programs it needs.
 */
i32[] declCountsInto(string[] paths, string[] sources, Lexed?[] lexes, Program?[] progs) {
  return declCountsAndFronts(paths, sources, lexes, progs, string[]());
}

/** `declCountsInto`, and each file's `frontDiagnostics` into `fronts` while its frontend is in hand. */
i32[] declCountsAndFronts(string[] paths, string[] sources, Lexed?[] lexes, Program?[] progs,
                          string[] fronts) {
  i32[] counts = i32[].filled(paths.len() + 1, 0);
  for (i32 i = 0; i < paths.len(); i++) {
    // **Through the shared frontend**, so this tree is the one the emitter links — see `frontend.wac`.
    Frontend cfe = frontendOf(i < paths.len() ? paths[i] : "",
                              (i < sources.len() ? sources[i] : "").toBytes());
    u8[] csrc = cfe.src;
    Lexed clexed = cfe.lexed;
    Program cprog = cfe.prog;
    counts[i] = declarationsIn(csrc, clexed, cprog);
    if (i < fronts.len()) { fronts[i] = frontDiagnostics(paths[i], cfe); }
    if (i < lexes.len()) { lexes[i] = clexed; }
    if (i < progs.len()) { progs[i] = cprog; }
  }
  u8[] ksrc = coreSource().toBytes();
  Lexed klexed = lex(ksrc);
  P kp = P.create(ksrc, klexed);
  Program kprog = parseProgram(kp);
  counts[paths.len()] = declarationsIn(ksrc, klexed, kprog);
  if (paths.len() < lexes.len()) { lexes[paths.len()] = klexed; }
  if (paths.len() < progs.len()) { progs[paths.len()] = kprog; }
  return counts;
}

C checkFiles(string[] callerPaths, string[] callerSources, string entry) {
  Lexed?[] lexes = Lexed?[].defaulted(callerPaths.len() + 1);
  Program?[] progs = Program?[].defaulted(callerPaths.len() + 1);
  i32[] counts = declCountsInto(callerPaths, callerSources, lexes, progs);
  return checkFilesWithIn(callerPaths, callerSources, Res.empty(), entry, counts, lexes, progs);
}


/**
 * The checker over a file and its closure, with the resolution context.
 *
 * **The `Res` is what makes an import resolvable.** Without it this resolved every specifier with
 * plain `resolveImport`, so a `@/` or a mapped one landed on a key no supplied file has — and an
 * import whose file never resolved contributes no declarations, which makes every name from it
 * unknown, which is silence. `wac check` on a project therefore said *"no diagnostics"* about a call
 * with the wrong number of arguments, while the same mistake through a relative import was reported
 * with a line and a caret, and `wac build` went on to emit a module the engine rejects.
 * `issues/lang/0157`, `issues/lang/0175a`.
 */
C checkFilesWithIn(string[] callerPaths, string[] callerSources, Res res, string entry,
                   i32[] counts, Lexed?[] lexes, Program?[] progs) {
  return checkFilesAutoIn(callerPaths, callerSources, res, entry, counts, lexes, progs, "", "", "");
}

/**
 * `checkFilesWithIn`, collecting one `auto` function's return contributions (spec ch34).
 * `assume` is `name=type` lines, one per `auto` function in the entry, the type empty where this path
 * excludes it; `target` is the function collected, `""` for an ordinary check.
 */
C checkFilesAutoIn(string[] callerPaths, string[] callerSources, const Res res, string entry,
                   i32[] counts, Lexed?[] lexes, Program?[] progs, string assume, string target,
                   string placeholder) {
  // **`core` is a file, and the checker had never read it.** An import from `core` used to declare
  // each name as *unknown*, so a `Node` or a `Read` had no enum behind it — and every rule that asks
  // what an enum holds went quiet: a `match` missing a variant, an arm naming a variant that does
  // not exist, two arms for one variant, an `else` that nothing reaches. All four were silent for
  // the two types the compiler itself ships, and the emitter had core's source the whole time.
  // `issues/lang/0109`. Adding it here rather than in the checker keeps one answer to "what does
  // core declare": `coreSource`, which is also what the emitter compiles.
  string[] paths = string[].filled(callerPaths.len() + 1, "");
  string[] sources = string[].filled(callerPaths.len() + 1, "");
  for (i32 i = 0; i < callerPaths.len(); i++) {
    paths[i] = callerPaths[i];
    sources[i] = i < callerSources.len() ? callerSources[i] : "";
    // A caller's own copy of `core` stands down for the carried one — see `keyOf`.
    if (paths[i] == "core") {
      sources[i] = "";
      if (i < progs.len()) { progs[i] = null; }
      if (i < lexes.len()) { lexes[i] = null; }
    }
  }
  paths[callerPaths.len()] = corePath();
  // **Carried by the caller where it has it**, one past its files, as it carries core's count, tokens and
  // tree: building the text is a few hundred microseconds, once per closure (`issues/lang/0398b`).
  sources[callerPaths.len()] = callerSources.len() > callerPaths.len() && callerSources[callerPaths.len()] != ""
    ? callerSources[callerPaths.len()] : coreSource();

  u8[] esrc = sourceOf(paths, sources, entry).toBytes();
  // **The entry, too.** `issues/lang/0133` stopped the loop below re-reading each *imported* file
  // once per importer and left the entry parsing itself on every call — which nothing notices for one
  // build and costs a whole second parse of the graph in `diagnoseGraph`, where every file takes a
  // turn as the entry. 180 files re-lexed and re-parsed to produce what `declCountsInto` already put
  // in these tables. Falls back when a caller supplied nothing, exactly as the import loop does.
  i32 eat = indexOfPath(paths, entry);
  Lexed elexed = eat >= 0 && eat < lexes.len() && (lexes[eat] is not null) ? lexes[eat]! : lex(esrc);
  Program eprog = eat >= 0 && eat < progs.len() && (progs[eat] is not null)
    ? progs[eat]!
    : parseProgram(P.create(esrc, elexed));
  // **Sized for what will go in it, and in the unit it goes in.** The tables here hold two kinds of
  // thing: the name table is per *function* and `clearScope` empties it between them, while structs,
  // fields, methods, variants and functions accumulate across every file the entry imports. So the
  // first is the entry's own token count — only its bodies are walked — and the second is a count of
  // the declarations each contributing file actually contributes.
  //
  // It was one number, and it was the entry's tokens; a small file with a large closure ran out of
  // room silently and answered *no such field* about correct code (`issues/lang/0098`). Sizing both
  // by the closure's *tokens* fixed that and cost 230 MB of peak resident set, because a token is
  // the wrong unit for a table of declarations (`issues/lang/0099`).
  // Counted already, by whoever filled `counts` — `declarationsIn` walks every declaration and this
  // is the same file it just walked. A caller that supplied nothing still gets the count computed.
  i32 declCap = eat >= 0 && eat < counts.len() && counts[eat] > 0
    ? counts[eat]
    : declarationsIn(esrc, elexed, eprog);
  // Summed, not parsed. The count has to stay exact — `C.create` allocates from it, and a loose
  // cap costs far more in allocation than any parse it saves (`issues/lang/0098`, `0099`, and a
  // measurement in `0133`: a fixed cap makes `diagnoseGraph` six times slower).
  for (i32 i = 0; i < paths.len(); i++) {
    if (paths[i] == entry) { continue; }
    declCap = declCap + (i < counts.len() ? counts[i] : 0);
  }
  C c = C.create(esrc, elexed.tokens, elexed.tokenCount, declCap);

  // **Which names, and from which file.** Filtering by name alone is not enough: `rlp.wac` exports a
  // `decode` and so does `codec/src/hex.wac`, and a closure holding both let the wrong one answer —
  // the entry asked `rlp.wac` for it. So each import is resolved to the path it names, and a file
  // contributes only what that file was asked for.
  string[] wantFrom = string[].defaulted(4096);
  string[] wantName = string[].defaulted(4096);
  // What this file calls it, which is the name it must be declared under — `Dup as DupB` brings in a
  // `DupB`, and two modules' `Dup` are two types rather than one that overwrote the other.
  string[] wantAlias = string[].defaulted(4096);
  // Where the *import* is written, taken here because the loop below retargets `c` at each imported
  // file in turn: a diagnostic about `main.wac`'s import must not carry `b.wac`'s line numbers.
  // As long as the tables beside them: at 512 the 513th imported name trapped the compiler.
  i32[] wantLine = i32[].filled(wantName.len(), 0);
  i32[] wantCol = i32[].filled(wantName.len(), 0);
  i32 n = 0;
  for (i32 d = 0; d < eprog.decls.len(); d++) {
    match (eprog.decls[d].kind) {
      Import(pathTok, prefixTok, items): {
        // A bare `core` names the compiler's own file; everything else is a path beside this one.
        string quoted = tokenTextOf(esrc, elexed, pathTok);
        string target = pathTok < 0 || quoted.len() < 2
          ? corePath()
          // **Through the `Res`**, so `@/` and a mapped specifier land on the key the caller supplied.
          //
          // `resolveVia` and not `resolveImportIn`: the root alone is not enough. A project reached
          // by an absolute root whose graph is keyed relatively resolves back through `res.base`, and
          // a mapped specifier is only in `res` at all — so honouring the root and dropping the other
          // two produced an absolute key for a relatively-keyed file, which is not the file, which is
          // silence again one step further along. On an empty `Res` this is `resolveImport`, so the
          // callers with no filesystem are unaffected. `issues/lang/0175a`.
          : keyOf(resolveVia(res, paths, entry, quoted.slice(1, quoted.len() - 1)));
        // **A specifier that resolves to a file nobody supplied is refused here** — the other half of
        // `issues/lang/0157`. The single-file entry point has said so since 2026-08-20, reading the
        // parse because one file means every non-builtin specifier is unsatisfiable; this one has a
        // real path map and a `Res`, so it can tell "resolved to a file I was not given" from "did
        // not resolve at all", which is the distinction that made resolving with the plain resolver
        // wrong. The `Res` came from `issues/lang/0175a`, which paid this cost for its own reason.
        //
        // Recorded rather than reported: `C.isUnresolved` is what the `Import` arm in `check.wac`
        // asks, so the diagnostic lands at the import's own token with the path in the annotation,
        // beside `unknown module` and `no such export` rather than in a layer
        // spec/spec/errors.md says diagnostics must not come from.
        //
        // `edgesOfIn` *drops* such a specifier, with a comment saying a missing file is the caller's
        // to report — that is where the silence came from, and it stays true of the edge list: an
        // edge to a file that is not there is not an edge. What was missing is anyone saying so.
        if (pathTok >= 0 && quoted.len() >= 2) {
          string spec = quoted.slice(1, quoted.len() - 1);
          bool supplied = false;
          for (i32 q = 0; q < paths.len(); q++) {
            if (paths[q] == target) { supplied = true; }
          }
          // A linear walk rather than `indexVia`: this runs once per import of one file, and the
          // `ByLen` index that would make it a lookup is built in `edgesOfIn`, not here.
          // **Only a plain relative specifier**, because that is the only one this resolver is
          // authoritative about when the `Res` is empty — and it is empty for every caller with no
          // filesystem, which is most of them. `@/src/point.wac` and a mapped `dep/lib.wac` need the
          // `Res` to land anywhere; without one they resolve to a key nobody supplied and look
          // exactly like the fault this rule is for. `issues/lang/0157` says the shape to avoid in
          // as many words: a caller that cannot resolve "would have to say it cannot answer rather
          // than answer wrongly."
          //
          // Measured rather than assumed: reporting all specifiers made `projectspec_test.wac` and
          // `mappedspec_test.wac` red on three cases that are *correct programs*, each importing a
          // file that is supplied and reached another way. That is the false-alarm direction, which
          // is the one a checker may not be wrong in.
          bool relative = spec.len() >= 2 && spec.slice(0, 2) == "./"
                       || spec.len() >= 3 && spec.slice(0, 3) == "../";
          // `res.base` is "" for a caller with no filesystem — the one that cannot resolve a `@/`
          // or a mapped specifier at all, and so may judge a relative path and nothing else.
          bool canJudge = relative || res.base != "";
          // A package the command could not resolve comes with its reason, which is the sentence to print.
          if (startsWith(target, "(unresolved) ")) { c.addUnresolved(spec + "\t" + target.slice(13, target.len())); }
          else if (canJudge && !isBuiltinSpec(spec) && !isBuiltinSubpath(spec) && !supplied) { c.addUnresolved(spec); }
        }
        for (i32 i = 0; i < items.len(); i++) {
          if (n >= wantName.len()) { continue; }
          wantFrom[n] = target;
          wantName[n] = tokenTextOf(esrc, elexed, items[i].nameTok);
          wantAlias[n] = tokenTextOf(esrc, elexed, items[i].aliasTok);
          wantLine[n] = elexed.tokens[items[i].nameTok * tokenStride() + 3];
          wantCol[n] = elexed.tokens[items[i].nameTok * tokenStride() + 4];
          n = n + 1;
        }
      }
      default: { }
    }
  }

  // **Each name asked for, followed through the export lists it passes** to the file and name that
  // declare it — spec ch02. A name an export list exports as this file's own (`export { area as
  // size };`, or naming it with no `as`) is exported by that list whether or not the declaration says
  // `export`, so the check below is skipped for it; a name forwarded to another module is checked
  // there, as any import is.
  bool[] wantForwarded = bool[].filled(wantName.len(), false);
  for (i32 k = 0; k < n; k++) {
    string[] got = followExport(paths, sources, lexes, progs, res, wantFrom[k], wantName[k]);
    wantFrom[k] = got[0];
    wantName[k] = got[1];
    wantForwarded[k] = got[2] != "";
  }
  // **A re-export of a name its module does not export** is refused at the item, as the import it
  // would otherwise be would be refused: the name has to be the other module's to give.
  for (i32 d = 0; d < eprog.decls.len(); d++) {
    match (eprog.decls[d].kind) {
      ExportList(pathTok, items): {
        if (pathTok < 0) { continue; }
        string rquoted = tokenTextOf(esrc, elexed, pathTok);
        string rtarget = keyOf(resolveVia(res, paths, entry, rquoted.slice(1, rquoted.len() - 1)));
        for (i32 i = 0; i < items.len(); i++) {
          if (items[i].nameTok < 0) { continue; }
          string[] got = followExport(paths, sources, lexes, progs, res, rtarget,
                                      tokenTextOf(esrc, elexed, items[i].nameTok));
          i32 fi = indexOfPath(paths, got[0]);
          if (fi < 0 || got[2] != "") { continue; }
          u8[] fsrc = sources[fi].toBytes();
          Lexed flx = fi < lexes.len() && (lexes[fi] is not null) ? lexes[fi]! : lex(fsrc);
          Program fpg = fi < progs.len() && (progs[fi] is not null) ? progs[fi]! : parseProgram(P.create(fsrc, flx));
          if (!exportsName(fsrc, flx, fpg, got[1])) {
            c.reportTok(errNoSuchExport(), items[i].nameTok, "");
          }
        }
      }
      default: { }
    }
  }

  // **What the imported signatures hand over from other files**, wanted from those files as well —
  // declared, so their members are checked, and not nameable, since the entry never asked for them.
  // See `namesReachedThroughImports`. To a fixpoint, because a reached type reaches more: `Shell`'s
  // `fs` is an `Fs`, whose methods answer `Ticket`s. A file is looked at again only when it has been
  // asked for more since the last time.
  i32 nExplicit = n;
  i32[] askedBefore = i32[].filled(paths.len(), 0);
  // The names the entry declares itself, which a reached name must not shadow.
  string[] own = string[].filled(eprog.decls.len(), "");
  i32 on = 0;
  for (i32 d = 0; d < eprog.decls.len(); d++) {
    match (eprog.decls[d].kind) {
      StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        own[on] = tokenTextOf(esrc, elexed, nameTok);
        on = on + 1;
      }
      EnumDecl(nameTok, variants, exported, methods, typeParams): {
        own[on] = tokenTextOf(esrc, elexed, nameTok);
        on = on + 1;
      }
      default: { }
    }
  }
  bool more = true;
  for (i32 round = 0; round < 32 && more; round++) {
    more = false;
    for (i32 i = 0; i < paths.len(); i++) {
      if (paths[i] == entry || paths[i] == corePath() || isBuiltinSpec(paths[i])) { continue; }
      i32 asked = 0;
      for (i32 k = 0; k < n; k++) {
        if (wantFrom[k] == paths[i]) { asked = asked + 1; }
      }
      if (asked == 0 || asked == askedBefore[i]) { continue; }
      askedBefore[i] = asked;
      string[] wanted = string[].defaulted(asked);
      i32 wat = 0;
      for (i32 k = 0; k < n; k++) {
        if (wantFrom[k] == paths[i]) { wanted[wat] = wantName[k]; wat = wat + 1; }
      }
      u8[] rsrc = sources[i].toBytes();
      Lexed rlx = i < lexes.len() && (lexes[i] is not null) ? lexes[i]! : lex(rsrc);
      Program rpg = i < progs.len() && (progs[i] is not null) ? progs[i]! : parseProgram(P.create(rsrc, rlx));
      string[] reached = namesReachedThroughImports(rsrc, rlx, rpg, closeOverSignatures(rsrc, rlx, rpg, wanted),
                                                    res, paths, paths[i]);
      for (i32 j = 0; j < reached.len(); j++) {
        string[] parts = splitTabs(reached[j]);
        string rfrom = parts[0];
        string rname = parts[1];
        if (rfrom != corePath()) {
          string[] got = followExport(paths, sources, lexes, progs, res, rfrom, rname);
          rfrom = got[0];
          rname = got[1];
          if (indexOfPath(paths, rfrom) < 0) { continue; }
        }
        bool have = false;
        // **Two types of one spelling are left unknown rather than made one.** A reached name the
        // entry declares, or wants from somewhere else, would collide with it — and a false alarm is
        // the direction a checker may not be wrong in. Core's names are core's alone.
        bool clash = false;
        for (i32 k = 0; k < n; k++) {
          if (wantFrom[k] == rfrom && wantName[k] == rname) { have = true; }
          if (rfrom != corePath() && wantFrom[k] != rfrom && (wantName[k] == rname || wantAlias[k] == rname)) {
            clash = true;
          }
        }
        if (rfrom != corePath() && listHas(own, on, rname)) { clash = true; }
        if (have || clash || n >= wantFrom.len()) { continue; }
        wantFrom[n] = rfrom;
        wantName[n] = rname;
        wantAlias[n] = rname;
        n = n + 1;
        more = true;
      }
    }
  }

  // **The static view is in hand before another file's signatures are declared**, so a parameter written with a
  // `type` that file declares — `i32 which(Fault f)` — is that type and not its bare name. Declared after the view
  // was attached, `Fault` stayed `"Fault"` while the importer's own `Fault a` was the union it names, and passing
  // one to the other was a mismatch between two spellings of one type. Built only when something asks.
  ViewInputs view = ViewInputs(paths, sources, lexes, progs, esrc, elexed, eprog, eat, null);
  c.viewLater = view;
  // Which files declare each type, built the first time a reached type has to be checked for a twin.
  TypeHomes? homes = null;
  for (i32 i = 0; i < paths.len(); i++) {
    if (paths[i] == entry) { continue; }
    i32 want = 0;
    for (i32 k = 0; k < n; k++) {
      if (wantFrom[k] == paths[i]) { want = want + 1; }
    }
    if (want == 0) { continue; }
    string[] only = string[].defaulted(want);
    i32 at = 0;
    for (i32 k = 0; k < n; k++) {
      if (wantFrom[k] != paths[i]) { continue; }
      only[at] = wantName[k];
      at = at + 1;
    }
    // **Already parsed, once, for the whole graph.** Lexing and parsing here again is the same file
    // re-read once per importer — ~210 ms on `packages/box`, 25% of `diagnoseGraph`.
    // `issues/lang/0133`. Falls back when a caller supplied nothing.
    u8[] isrc = sources[i].toBytes();
    Lexed ilexed = i < lexes.len() && (lexes[i] is not null) ? lexes[i]! : lex(isrc);
    Program iprog = i < progs.len() && (progs[i] is not null)
      ? progs[i]!
      : parseProgram(P.create(isrc, ilexed));
    // **A file's exports are its own to state.** Asked for a name it does not export, the import is
    // the error — whether the name is declared without `export` or merely imported from somewhere
    // else, which does not pass it on (`§wac-no-reexport-f7kn4wq`).
    for (i32 k = 0; k < nExplicit; k++) {
      if (wantFrom[k] != paths[i]) { continue; }
      if (!wantForwarded[k] && !exportsName(isrc, ilexed, iprog, wantName[k])) {
        // **A built-in gets its own code**, because for those two trees "that file does not export
        // this name" is usually false: the file on disk does, and the compiler is reading the copy
        // it carries. `issues/system/0291b`.
        c.report(isBuiltinSpec(paths[i]) ? errStaleBuiltinEmbedding() : errNoSuchExport(),
                 wantLine[k], wantCol[k]);
      }
    }

    c.src = isrc;
    c.toks = ilexed.tokens;
    c.renameCount = 0;
    for (i32 k = 0; k < n; k++) {
      if (wantFrom[k] != paths[i]) { continue; }
      if (wantAlias[k] == wantName[k]) { continue; }
      // **A name this file also imports plainly keeps its plain spelling**, which the canonical choice below
      // promises: renamed to the alias, the declaration was registered as `Shut` while the declaring file's own
      // `union<Closed, Full>` still said `Closed`, and a `Closed(…)` built either way fitted neither.
      bool plain = false;
      for (i32 j = 0; j < n; j++) {
        if (wantFrom[j] == paths[i] && wantName[j] == wantName[k] && wantAlias[j] == wantName[j]) { plain = true; }
      }
      if (!plain) { c.addRename(wantName[k], wantAlias[k]); }
    }
    // **One declaration asked for under two spellings.** `renamed` above answers one local name per
    // declaring name, so `declareModule` registers the declaration once — and the other spelling was
    // left undeclared, which is silent rather than wrong: `import { E, E as E2 }` made `E` stop being
    // a type, and every rule about it went quiet. spec/spec/generics.md
    // `[§wac-generic-instantiation-identity-6pnq4wj]` says the two are *one* type — "`Box<P>` and
    // `Box<Point>` are one struct" — so collapsing them is the stated rule rather than a kindness.
    //
    // The canonical spelling is whichever one `renamed` will register under: the plain name when the
    // file imported it plainly, and otherwise the first alias, which is the first entry the loop
    // above added. Every other spelling becomes a local alias of it, and `c.canon` is what the four
    // bare-name lookups and the three type-name sites consult. `issues/lang/0161`.
    for (i32 k = 0; k < n; k++) {
      if (wantFrom[k] != paths[i]) { continue; }
      string canonical = c.renamed(wantName[k]);
      if (wantAlias[k] != canonical) { c.addLocalAlias(wantAlias[k], canonical); }
    }
    // **How this file spells core's `toString`**, which is what interpolation converts through — under
    // whatever alias it was imported (spec ch23 `§wac-conversion-symbol-identity-4ga8txc`).
    if (isBuiltinSpec(paths[i]) || paths[i] == corePath()) {
      for (i32 k = 0; k < n; k++) {
        if (wantFrom[k] != paths[i]) { continue; }
        if (wantName[k] == "toString") { c.coreToString = c.renamed("toString"); }
        // And every core symbol, which is how an operator finds the method its symbol names (ch22).
        c.noteCoreSym(wantName[k], c.renamed(wantName[k]));
      }
    }
    // **Closed over what the wanted names reach**, so a type that arrives only through somebody
    // else's field signature still has its members. Everything past `only.len()` was added here
    // rather than asked for, so it is declared and *not* put in scope: writing its name stays the
    // error the reference reports. `issues/lang/0132`.
    string[] reach = closeOverSignatures(isrc, ilexed, iprog, only);
    // **A type that reached this file only through a signature is still its own type.**
    // `issues/lang/0128`. Every table in this checker is keyed by a bare name and the first
    // declaration of one wins, so two modules each exporting an `S` collapse into a single type the
    // moment neither is imported *by name*: `takesA(S)` and `makeB() -> S` both carry the string
    // `"S"`, they compare equal, nothing is reported, and the emitter — which does tell them apart —
    // writes a call that fails to validate with an index and no names in it.
    //
    // `spec/cases/0117` is the same two modules and works, because there both are imported *with
    // aliases*, and an alias is exactly a rename. So this synthesises the alias the program did not
    // write. `typeOfTy` already resolves every type name through `renamed`, which is what makes one
    // `addRename` reach the signatures as well as the declaration.
    //
    // Only this file's *own* declarations are renamed, which is also the reason a type shared through
    // a third module does not become two: `closeOverSignatures` adds a name only when the file
    // declares it, so a `Point` that a.wac merely imports is never in `reach` and is renamed once,
    // where it is declared.
    for (i32 d = 0; d < iprog.decls.len(); d++) {
      string tname = "";
      match (iprog.decls[d].kind) {
        StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
          tname = tokenTextOf(isrc, ilexed, nameTok);
        }
        EnumDecl(nameTok, variants, exported, methods, typeParams): {
          tname = tokenTextOf(isrc, ilexed, nameTok);
        }
        default: { }
      }
      if (tname == "") { continue; }
      // Asked for by name: the entry's own spelling wins, aliased or not, and renaming it here would
      // rename the thing the programmer wrote.
      if (listHas(only, only.len(), tname)) { continue; }
      if (!listHas(reach, reach.len(), tname)) { continue; }
      // **Only when the name is actually ambiguous.** One file declaring `Link` and three others
      // passing it around is the ordinary case, and renaming there gives a parameter a name the
      // field it is handed does not have — three working files in `packages/tor` reported that way.
      if (homes is null) { homes = typeHomesOf(paths, sources, lexes, progs); }
      if (!typeDeclaredElsewhere(homes!, i, tname)) { continue; }
      c.addRename(tname, tname + "#" + numText(i));
    }
    // **This file's own aliases, in the importer's spelling.** `import { Read as Chunk } from "core"` in
    // a file whose signatures say `Chunk` hands the importer core's `Read` — one type under whatever
    // name the importer gave it, or its own name when it gave none — and declaring the signatures as
    // written made `Chunk` a second type: `Read r = get();` was a mismatch between two spellings of one
    // declaration.
    for (i32 d = 0; d < iprog.decls.len(); d++) {
      match (iprog.decls[d].kind) {
        Import(ipathTok, iprefixTok, iitems): {
          string iq = ipathTok < 0 ? "" : tokenTextOf(isrc, ilexed, ipathTok);
          string itarget = ipathTok < 0 || iq.len() < 2
            ? corePath()
            : keyOf(resolveVia(res, paths, paths[i], iq.slice(1, iq.len() - 1)));
          for (i32 j = 0; j < iitems.len(); j++) {
            if (iitems[j].nameTok < 0 || iitems[j].aliasTok < 0) { continue; }
            string orig = tokenTextOf(isrc, ilexed, iitems[j].nameTok);
            string alias = tokenTextOf(isrc, ilexed, iitems[j].aliasTok);
            if (alias == orig || c.renamed(alias) != alias) { continue; }
            string local = orig;
            for (i32 k = 0; k < n; k++) {
              if (wantFrom[k] == itarget && wantName[k] == orig) { local = wantAlias[k]; }
            }
            c.addRename(alias, local);
          }
        }
        default: { }
      }
    }
    // **Which of this file's types implement core's `toString`**: those with a method named by the
    // symbol under whatever spelling this file imported it. Interpolating one in a file that did not
    // import the symbol itself is still core's conversion (case 0576); a method named by a fresh symbol
    // spelled the same is not (case 0397), and the method tables, keyed by spelling, cannot tell.
    string coreText = "";
    // **A built-in's own types are core's conversion however a user file reaches them.** Core declares the
    // symbol and std imports it plainly, so neither has an alias to find below; without this a file that
    // imported `Stuck` by name, and not `toString`, could not interpolate one (case 0854).
    if (paths[i] == corePath() || isBuiltinSpec(paths[i])) { coreText = "toString"; }
    for (i32 d = 0; d < iprog.decls.len(); d++) {
      match (iprog.decls[d].kind) {
        Import(tpathTok, tprefixTok, titems): {
          string tq = tpathTok < 0 ? "" : tokenTextOf(isrc, ilexed, tpathTok);
          if (tq != "\"core\"") { continue; }
          for (i32 j = 0; j < titems.len(); j++) {
            if (titems[j].nameTok < 0 || titems[j].aliasTok < 0) { continue; }
            if (tokenTextOf(isrc, ilexed, titems[j].nameTok) == "toString") {
              coreText = tokenTextOf(isrc, ilexed, titems[j].aliasTok);
            }
          }
        }
        default: { }
      }
    }
    if (coreText != "") {
      for (i32 d = 0; d < iprog.decls.len(); d++) {
        i32 ttok = -1;
        Method[] tmethods = Method[]();
        match (iprog.decls[d].kind) {
          StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): { ttok = nameTok; tmethods = methods; }
          EnumDecl(nameTok, variants, exported, methods, typeParams): { ttok = nameTok; tmethods = methods; }
          default: { }
        }
        if (ttok < 0) { continue; }
        for (i32 m = 0; m < tmethods.len(); m++) {
          string mn = tokenTextOf(isrc, ilexed, tmethods[m].nameTok);
          if (mn == "[toString]" || mn == "[" + coreText + "]") {
            c.coreTextTypes = c.coreTextTypes + "|" + c.renamed(tokenTextOf(isrc, ilexed, ttok)) + "|";
          }
        }
      }
    }
    // **A reached variant the entry declares a type of the same name for** is declared under a name no
    // source can write, so the two are not one struct with both field lists (`spec/cases/0566`).
    for (i32 d = 0; d < iprog.decls.len(); d++) {
      match (iprog.decls[d].kind) {
        EnumDecl(nameTok, variants, exported, methods, typeParams): {
          if (!listHas(reach, reach.len(), tokenTextOf(isrc, ilexed, nameTok))) { continue; }
          for (i32 v = 0; v < variants.len(); v++) {
            string vn = tokenTextOf(isrc, ilexed, variants[v].nameTok);
            // **Or that the entry imports from somewhere else** — a page importing `Element`, the
            // handle, and `Node`, whose variant is `Element` too: the variant reached through `Node`
            // is constructed qualified and matched through its subject (spec ch13), so the bare name
            // is the import's, and the two were one struct with both field lists.
            bool importedElsewhere = false;
            for (i32 k = 0; k < nExplicit; k++) {
              if (wantAlias[k] == vn && wantFrom[k] != paths[i]) { importedElsewhere = true; }
            }
            if ((listHas(own, on, vn) || importedElsewhere) && c.renamed(vn) == vn) { c.addRename(vn, vn + "@" + paths[i]); }
          }
        }
        default: { }
      }
    }
    // Its own `type` declarations resolve in its own scope, not the entry's.
    c.sFile = i;
    declareModule(c, iprog, reach);
    c.sFile = eat;
    // The ones only a signature asked for are declared and not nameable, as a reached type is.
    for (i32 k = nExplicit; k < n; k++) {
      if (wantFrom[k] != paths[i]) { continue; }
      if (listHas(wantAlias, nExplicit, c.renamed(wantName[k]))) { continue; }
      if (listHas(own, on, wantName[k])) { continue; }
      c.markUnnameable(c.renamed(wantName[k]));
    }
    for (i32 k = only.len(); k < reach.len(); k++) {
      // **A name the entry imported is in scope, wherever it came from.** This list is global across
      // every imported file, so hiding by the current file's `only` alone marked a name that another
      // import brought in legitimately — one false alarm on `packages/sh`'s `Word` and two spec
      // cases about same-named structs in two modules. What may not be written is a name the entry
      // never asked anybody for; `wantAlias` is exactly that set, under the entry's own spelling.
      if (listHas(wantAlias, nExplicit, c.renamed(reach[k]))) { continue; }
      if (listHas(own, on, reach[k])) { continue; }
      c.markUnnameable(c.renamed(reach[k]));
      // **An enum carries more than one name into scope.** Its variants are declared beside it and
      // `is Circle` writes one bare, so hiding only the enum's own name lets every variant in — and
      // `§wac-type-name-scope-8vqk3mn` says a type name must be in scope in the file that writes it,
      // variants included. Two spec cases said so the moment functions and consts joined the
      // closure and started reaching enums.
      for (i32 d = 0; d < iprog.decls.len(); d++) {
        match (iprog.decls[d].kind) {
          EnumDecl(nameTok, variants, exported, methods, typeParams): {
            if (tokenTextOf(isrc, ilexed, nameTok) != reach[k]) { continue; }
            for (i32 v = 0; v < variants.len(); v++) {
              string vn = tokenTextOf(isrc, ilexed, variants[v].nameTok);
              if (listHas(wantAlias, n, c.renamed(vn))) { continue; }
              // **Nor a name the entry declares itself**, which a reached variant must not hide:
              // `Backing.Host` reached through `Fs` made `main.wac`'s own `struct Host` an unknown type
              // (`spec/cases/0566`).
              if (listHas(own, on, vn)) { continue; }
              c.markUnnameable(c.renamed(vn));
            }
          }
          default: { }
        }
      }
    }
    c.renameCount = 0;
  }

  c.src = esrc;
  c.toks = elexed.tokens;
  // **Every file, for the static evaluator** (spec ch28): up front for an entry that says `static`,
  // `typeref` or `type` itself, and otherwise only if the check meets a type another file declares.
  string etext = string.fromBytes(esrc);
  if (c.sCx is not null) { c.viewLater = null; }
  else if (etext.indexOf("static") >= 0 || etext.indexOf("typeref") >= 0 || etext.indexOf("type(") >= 0
      || etext.indexOf("\ntype ") >= 0 || etext.indexOf("export type ") >= 0 || startsWith(etext, "type ")) {
    c.viewLater = null;
    buildStaticView(c, view);
  } else {
    // Built when the check meets a type only another file's `type` declaration explains.
    c.viewLater = view;
  }
  c.placeholderSpec = placeholder;
  if (target != "") {
    c.autoAssume = assume;
    c.autoTarget = target;
  }
  checkModule(c, eprog);
  return c;
}

// ---- `auto` results — spec ch34 ----

/**
 * The source-to-source passes every route takes before parsing for real: namespaces flattened
 * (ch03), then `auto` results written in (ch34). Both are idempotent.
 */
export string[] lowerSources(string[] paths, string[] sources, const Res res) {
  Reads reads = Reads.create();
  return lowerSourcesIn(paths, lowerNamespacesWith(paths, sources, res, reads), res, reads);
}

/**
 * The same for a reader that checks and never builds — one file on its own, with no module to resolve
 * an import against: an item `X.m` from a file that is not here is spelled `@"X.m" as m`, so the rest
 * of the file still parses (`lowerNamespacesForDeclarations`). Left as written, `import { html.p }
 * from "../web"` did not parse there, and every name declared after it was undefined.
 */
export string[] lowerSourcesForChecking(string[] paths, string[] sources, const Res res) {
  Reads reads = Reads.create();
  return lowerSourcesIn(paths, lowerNamespacesForDeclarationsWith(paths, sources, res, reads), res, reads);
}

/**
 * **Every pass reads through one `Reads`**, so a file a pass leaves alone is not lexed again by the
 * next: each pass lexed every file it looked at, and `std` was lexed about twenty times to check a
 * one-line program importing it (`issues/lang/0398b`). See `frontend.wac`.
 */
string[] lowerSourcesIn(string[] paths, string[] namespaced, const Res res, Reads reads) {
  string[] s1 = lowerPrimFromNumber(reads, lowerTypeDefaults(reads, lowerUnqualifiedVariants(reads,
      lowerVariadics(reads, lowerStaticLocals(reads, lowerDoneClauses(reads, namespaced))))));
  string[] s2 = lowerAutoReturns(reads, paths, lowerResultPlaceholders(reads, paths, lowerExportInstances(reads, s1), res), res);
  return lowerFromNumberLiterals(reads, paths, s2, res);
}

// ---- A built-in numeric type's `[fromNumber]` — spec ch09 ----

/**
 * `f64.[fromNumber](n)` is core's `numberLiteralToF64(n)`, and likewise for `f32`, `i64` and `i32`:
 * the conversion a built-in type answers, written as the function core implements it with, and that
 * function imported for the file. A program's own type implements the symbol as a method.
 */
string[] lowerPrimFromNumber(Reads reads, string[] sources) {
  bool any = false;
  for (i32 i = 0; i < sources.len(); i++) { if (sources[i].indexOf(".[fromNumber]") >= 0) { any = true; } }
  if (!any) { return sources; }
  string[] out = string[].filled(sources.len(), "");
  for (i32 f = 0; f < sources.len(); f++) {
    if (sources[f].indexOf(".[fromNumber]") < 0) { out[f] = sources[f]; continue; }
    i32 srcRead = readOf(reads, sources[f]);
    u8[] src = readSrc(reads, srcRead);
    Lexed lx = readLexed(reads, srcRead);
    i32 st = tokenStride();
    string text = "";
    i32 from = 0;
    string needs = "|";
    for (i32 t = 0; t + 4 < lx.tokenCount; t++) {
      if (lx.tokens[t * st] != kIdent() || lx.tokens[(t + 1) * st] != kDot() || lx.tokens[(t + 2) * st] != kLbrack()
          || lx.tokens[(t + 3) * st] != kIdent() || lx.tokens[(t + 4) * st] != kRbrack()) { continue; }
      if (tokenTextOf(src, lx, t + 3) != "fromNumber") { continue; }
      string prim = tokenTextOf(src, lx, t);
      string conv = prim == "f64" ? "numberLiteralToF64" : prim == "f32" ? "numberLiteralToF32"
                : prim == "i64" ? "numberLiteralToI64" : prim == "i32" ? "numberLiteralToI32" : "";
      if (conv == "") { continue; }
      text = text + bytesBetween(src, from, lx.tokens[t * st + 1]) + conv;
      from = lx.tokens[(t + 4) * st + 1] + 1;
      if (needs.indexOf("|" + conv + "|") < 0) { needs = needs + conv + "|"; }
    }
    string imports = "";
    string rest = needs.slice(1, needs.len());
    while (rest.indexOf("|") >= 0) {
      imports = imports + "\nimport { " + rest.slice(0, rest.indexOf("|")) + " } from \"core\";";
      rest = rest.slice(rest.indexOf("|") + 1, rest.len());
    }
    out[f] = imports == "" ? sources[f] : text + bytesBetween(src, from, src.len()) + imports + "\n";
  }
  return out;
}

/**
 * **A literal whose type implements `[fromNumber]` is converted statically** (spec ch09): each such
 * literal becomes a static of its own, `static T @"$lit_L_C" = literalValue(T.[fromNumber](
 * NumberLiteral("3")), "3");`, so the conversion runs at compile time, once per occurrence, and an
 * `Err` traps there — a compile error naming the literal. The checker says which literals these are.
 */
string[] lowerFromNumberLiterals(Reads reads, string[] paths, string[] sources, const Res res) {
  string types = "|";
  for (i32 i = 0; i < sources.len(); i++) {
    string s = sources[i];
    if (s.indexOf("[fromNumber](") < 0) { continue; }
    // The types declaring the method — read off the text: `struct Name … [fromNumber](`.
    i32 srcRead = readOf(reads, s);
    u8[] src = readSrc(reads, srcRead);
    Lexed lx = readLexed(reads, srcRead);
    i32 st = tokenStride();
    string owner = "";
    for (i32 t = 0; t + 3 < lx.tokenCount; t++) {
      i32 k = lx.tokens[t * st];
      if ((k == kStruct() || k == kEnum()) && lx.tokens[(t + 1) * st] == kIdent()) { owner = tokenTextOf(src, lx, t + 1); }
      if (k == kLbrack() && lx.tokens[(t + 1) * st] == kIdent() && tokenTextOf(src, lx, t + 1) == "fromNumber"
          && lx.tokens[(t + 2) * st] == kRbrack() && lx.tokens[(t + 3) * st] == kLparen() && owner != ""
          && t > 0 && lx.tokens[(t - 1) * st] != kDot() && types.indexOf("|" + owner + "|") < 0) {
        types = types + owner + "|";
      }
    }
  }
  if (types == "|") { return sources; }
  string[] out = string[].filled(sources.len(), "");
  for (i32 i = 0; i < sources.len(); i++) { out[i] = sources[i]; }
  for (i32 f = 0; f < paths.len() && f < out.len(); f++) {
    bool mentions = false;
    string rest = types.slice(1, types.len());
    while (rest.indexOf("|") >= 0) {
      if (out[f].indexOf(rest.slice(0, rest.indexOf("|"))) >= 0) { mentions = true; }
      rest = rest.slice(rest.indexOf("|") + 1, rest.len());
    }
    if (!mentions) { continue; }
    Lexed?[] lexes = Lexed?[].defaulted(paths.len() + 1);
    Program?[] progs = Program?[].defaulted(paths.len() + 1);
    i32[] counts = declCountsInto(paths, out, lexes, progs);
    C c = checkFilesAutoIn(paths, out, res, paths[f], counts, lexes, progs, "", "", "@literals");
    if (c.autoCollect == "") { continue; }
    i32 srcRead = readOf(reads, out[f]);
    u8[] src = readSrc(reads, srcRead);
    Lexed lx = readLexed(reads, srcRead);
    i32 st = tokenStride();
    string text = "";
    string statics = "";
    i32 from = 0;
    for (i32 t = 0; t < lx.tokenCount; t++) {
      string key = numText(lx.tokens[t * st + 3]) + ":" + numText(lx.tokens[t * st + 4]) + ":";
      i32 at = c.autoCollect.indexOf(key);
      if (at < 0 || (at > 0 && c.autoCollect.slice(at - 1, at) != "|")) { continue; }
      string tail = c.autoCollect.slice(at + key.len(), c.autoCollect.len());
      string ty = tail.slice(0, tail.indexOf("|"));
      string lit = tokenTextOf(src, lx, t);
      // Underscores, not dots: a dotted name is a namespace's member.
      string name = "@\"$lit_" + numText(lx.tokens[t * st + 3]) + "_" + numText(lx.tokens[t * st + 4]) + "\"";
      i32 start = lx.tokens[t * st + 1];
      text = text + bytesBetween(src, from, start) + name;
      from = start + lx.tokens[t * st + 2];
      statics = statics + "\nstatic " + ty + " " + name + " = literalValue(" + ty + ".[fromNumber](NumberLiteral(\""
              + lit + "\")), \"" + lit + "\");";
    }
    if (statics == "") { continue; }
    // What the statics name, imported for the file where it does not import them already.
    string have = coreImportsOf(src);
    string wanted = "";
    if (have.indexOf("|NumberLiteral|") < 0) { wanted = wanted + ", NumberLiteral"; }
    if (have.indexOf("|literalValue|") < 0) { wanted = wanted + ", literalValue"; }
    if (have.indexOf("|fromNumber|") < 0) { wanted = wanted + ", fromNumber"; }
    if (wanted != "") { wanted = wanted.slice(2, wanted.len()); }
    out[f] = text + bytesBetween(src, from, src.len()) + statics
           + (wanted == "" ? "" : "\nimport { " + wanted + " } from \"core\";") + "\n";
  }
  return out;
}

/** The names a file imports from `core`, as `|a|b|`. */
string coreImportsOf(u8[] src) {
  Lexed lx = lex(src);
  Program prog = parseProgram(P.create(src, lx));
  string out = "|";
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      Import(pathTok, prefixTok, items): {
        if (pathTok < 0 || tokenTextOf(src, lx, pathTok) != "\"core\"") { continue; }
        for (i32 i = 0; i < items.len(); i++) {
          if (items[i].nameTok < 0) { continue; }
          out = out + tokenTextOf(src, lx, items[i].aliasTok >= 0 ? items[i].aliasTok : items[i].nameTok) + "|";
        }
      }
      default: { }
    }
  }
  return out;
}

// ---- A loop's `done` clause, and `try for` — spec ch36 ----

/**
 * `for (T x in g) { … } done (R r) { … }` and `try for (T x in g) { … }` — and both after `await` — as the
 * steps they are: a `while` over `g.step()` whose `Done` arm runs the clause, so a `break` or a `return` in
 * the body leaves before it, and `continue` takes the next step. `try for` is the clause `try r;`.
 * Written on the lines the loop was on, so a diagnostic in it still points at the line it names.
 * `issues/lang/0338a`.
 */
string[] lowerDoneClauses(Reads reads, string[] sources) {
  string[] out = string[].filled(sources.len(), "");
  for (i32 i = 0; i < sources.len(); i++) {
    string text = sources[i];
    if (text.indexOf("done") >= 0 || text.indexOf("try") >= 0) {
      // One loop a pass, innermost last: a clause inside a body is met again on the next pass.
      i32 n = 0;
      string next = withOneDoneClause(reads, text, n);
      while (next != text) {
        text = next;
        n++;
        next = withOneDoneClause(reads, text, n);
      }
    }
    out[i] = text;
  }
  return out;
}

/** `text` with its first `done` clause or `try for` lowered, using `n` for the names it introduces. */
string withOneDoneClause(Reads reads, string text, i32 n) {
  i32 srcRead = readOf(reads, text);
  u8[] src = readSrc(reads, srcRead);
  Lexed lx = readLexed(reads, srcRead);
  i32 st = tokenStride();
  i32 nt = lx.tokenCount;
  for (i32 t = 0; t < nt; t++) {
    if (lx.tokens[t * st] != kFor()) { continue; }
    bool viaTry = t > 0 && lx.tokens[(t - 1) * st] == kIdent() && tokenTextOf(src, lx, t - 1) == "try";
    i32 h = t + 1;
    bool awaiting = h < nt && lx.tokens[h * st] == kAwait();
    if (awaiting) { h++; }
    if (h >= nt || lx.tokens[h * st] != kLparen()) { continue; }
    i32 hclose = closingOf(lx, h, kLparen(), kRparen());
    if (hclose < 0) { continue; }
    // `T x in e`: the first `in` at the header's own depth.
    i32 inAt = 0 - 1;
    i32 depth = 0;
    for (i32 u = h + 1; u < hclose; u++) {
      i32 k = lx.tokens[u * st];
      if (k == kLparen() || k == kLbrack() || k == kLbrace()) { depth++; }
      if (k == kRparen() || k == kRbrack() || k == kRbrace()) { depth--; }
      if (depth == 0 && k == kIdent() && tokenTextOf(src, lx, u) == "in") { inAt = u; break; }
    }
    if (inAt < h + 3) { continue; }
    i32 b = hclose + 1;
    if (b >= nt || lx.tokens[b * st] != kLbrace()) { continue; }
    i32 bclose = closingOf(lx, b, kLbrace(), kRbrace());
    if (bclose < 0) { continue; }
    // `done (R r) { … }` after the body: a `(…)` and then a block, which a call statement is not.
    bool hasDone = false;
    i32 dOpen = bclose + 1;
    i32 dClose = 0 - 1;
    i32 dBody = 0 - 1;
    i32 dEnd = 0 - 1;
    if (dOpen + 1 < nt && lx.tokens[dOpen * st] == kIdent() && tokenTextOf(src, lx, dOpen) == "done"
        && lx.tokens[(dOpen + 1) * st] == kLparen()) {
      dClose = closingOf(lx, dOpen + 1, kLparen(), kRparen());
      if (dClose > 0 && dClose + 1 < nt && lx.tokens[(dClose + 1) * st] == kLbrace()) {
        dBody = dClose + 1;
        dEnd = closingOf(lx, dBody, kLbrace(), kRbrace());
        hasDone = dEnd > 0;
      }
    }
    if (!hasDone && !viaTry) { continue; }
    string num = numText(n);
    string ty = bytesBetween(src, lx.tokens[(h + 1) * st + 1], lx.tokens[(inAt - 1) * st + 1]);
    string name = tokenTextOf(src, lx, inAt - 1);
    string iter = bytesBetween(src, lx.tokens[(inAt + 1) * st + 1], lx.tokens[hclose * st + 1]);
    string body = bytesBetween(src, lx.tokens[b * st + 1], lx.tokens[bclose * st + 1] + 1);
    string clause = "try __o" + num + ";";
    if (hasDone) {
      // `R r` binds the outcome at the type written, so a wrong one is a mismatch rather than a guess.
      string binding = bytesBetween(src, lx.tokens[(dOpen + 2) * st + 1], lx.tokens[dClose * st + 1]);
      clause = binding + " = __o" + num + "; " + bytesBetween(src, lx.tokens[dBody * st + 1], lx.tokens[dEnd * st + 1] + 1);
    }
    i32 from = lx.tokens[(viaTry ? t - 1 : t) * st + 1];
    i32 to = hasDone ? lx.tokens[dEnd * st + 1] + 1 : lx.tokens[bclose * st + 1] + 1;
    string lowered = "{ auto __for" + num + " = " + iter + "; while (true) { match ("
        + (awaiting ? "await " : "") + "__for" + num + ".step()) { Yielded(__y" + num + "): { " + ty
        + name + " = __y" + num + "; " + body + " } Done(__o" + num + "): { " + clause + " break; } } } }";
    return bytesBetween(src, 0, from) + lowered + bytesBetween(src, to, src.len());
  }
  return text;
}

/** The token closing the bracket opened at token `open`, or -1. */
i32 closingOf(Lexed lx, i32 open, i32 openKind, i32 closeKind) {
  i32 st = tokenStride();
  i32 depth = 0;
  for (i32 u = open; u < lx.tokenCount; u++) {
    i32 k = lx.tokens[u * st];
    if (k == openKind) { depth++; }
    if (k == closeKind) { depth--; if (depth == 0) { return u; } }
  }
  return 0 - 1;
}

// ---- Unqualified variants — spec ch13 ----

/**
 * `Ok(x)` for `Result.Ok(x)`, and `End` for `Read.End`: a variant written without its enum, where the
 * enum is the one visible enum that has a variant of that name — declared in the file or imported by
 * it. The qualifier is written in and the slot does the rest, as it does for `Result.Ok(x)` already: a
 * generic enum takes its instance from what the value fills. `issues/lang/0338a`.
 *
 * Left alone: a pattern (an arm's `Ok(v):`, a `matches`), a type (`Circle c`), a name after `.` or
 * `is`, a name that is itself a type here, a variant two visible enums share, and the enum
 * declarations and import lists themselves.
 */
string[] lowerUnqualifiedVariants(Reads reads, string[] sources) {
  string table = "";
  for (i32 i = 0; i < sources.len(); i++) {
    if (sources[i].indexOf("enum ") >= 0) { table = table + enumVariantsOf(reads, sources[i]); }
  }
  // `core`'s and `std`'s, read when the compiler was built — parsing both here was most of a small check.
  table = table + builtinEnumVariants();
  if (table == "") { return sources; }
  string[] out = string[].filled(sources.len(), "");
  for (i32 i = 0; i < sources.len(); i++) { out[i] = withQualifiedVariants(reads, sources[i], table); }
  return out;
}

/** Each enum `text` declares, one `Name|V1|V2|` line each. */
string enumVariantsOf(Reads reads, string text) {
  i32 srcRead = readOf(reads, text);
  u8[] src = readSrc(reads, srcRead);
  Lexed lx = readParsedLexed(reads, srcRead);
  return enumVariantsIn(src, lx, readProgram(reads, srcRead));
}

/** The variants `table` gives enum `name`, as `|V1|V2|`, or "". */
string variantsOfEnum(string table, string name) {
  i32 row = table.indexOf(name + "|");
  while (row > 0 && table.slice(row - 1, row) != "\n") {
    i32 next = table.slice(row + 1, table.len()).indexOf("\n" + name + "|");
    if (next < 0) { return ""; }
    row = row + 1 + next + 1;
  }
  if (row < 0) { return ""; }
  string line = table.slice(row + name.len(), table.len());
  return line.slice(0, line.indexOf("\n"));
}

/** `text` with each unqualified variant `lowerUnqualifiedVariants` describes given its enum. */
/** The names a file uses as types, in the order met, indexed by name. */
struct TypeNames {
  string[] names;
  i32 n;
  KeyIndex ix;
}

void addTypeName(TypeNames t, string name) {
  if (t.n >= t.names.len()) {
    string[] bigger = string[].filled(t.names.len() * 2 + 16, "");
    for (i32 i = 0; i < t.n; i++) { bigger[i] = t.names[i]; }
    t.names = bigger;
  }
  t.names[t.n] = name;
  keyAdd(t.ix, name, t.n);
  t.n = t.n + 1;
}

bool isTypeName(TypeNames t, string name) {
  for (i32 i = keyFirst(t.ix, name); i >= 0; i = t.ix.next[i]) {
    if (t.names[i] == name) { return true; }
  }
  return false;
}

string withQualifiedVariants(Reads reads, string text, string table) {
  i32 srcRead = readOf(reads, text);
  u8[] src = readSrc(reads, srcRead);
  Lexed lx = readLexed(reads, srcRead);
  i32 st = tokenStride();
  i32 nt = lx.tokenCount;
  // The visible enums' variants with their qualifiers, and the names that are types here — each in a
  // list with an index rather than a `|`-joined string, which cost the square of a file's types, and
  // its identifiers times its variants, to build and search (`issues/lang/0398b`).
  Qualifiers pairs = Qualifiers(string[](), string[](), 0, KeyIndex.create());
  TypeNames types = TypeNames(string[](), 0, KeyIndex.create());
  bool[] skip = bool[].filled(nt + 1, false);
  for (i32 t = 0; t < nt; t++) {
    i32 k = lx.tokens[t * st];
    if ((k == kEnum() || k == kStruct()) && t + 1 < nt && lx.tokens[(t + 1) * st] == kIdent()) {
      string nm = tokenTextOf(src, lx, t + 1);
      addTypeName(types, nm);
      if (k == kEnum()) { addQualified(pairs, variantsOfEnum(table, nm), nm); }
      // The declaration's body is its own: `enum E { A, B(i32 x) }` names variants, it does not build them.
      if (k == kEnum()) {
        i32 u = t + 2;
        while (u < nt && lx.tokens[u * st] != kLbrace()) { u++; }
        i32 depth = 0;
        while (u < nt) {
          i32 kk = lx.tokens[u * st];
          skip[u] = true;
          if (kk == kLbrace()) { depth++; }
          if (kk == kRbrace()) { depth--; if (depth == 0) { break; } }
          u++;
        }
      }
    }
    if (k == kImport()) {
      // `import { A, B as C } from "…";` — each name, and the statement is not rewritten.
      i32 u = t;
      while (u < nt && lx.tokens[u * st] != kSemi()) {
        skip[u] = true;
        if (lx.tokens[u * st] == kIdent() && u + 1 < nt) {
          string orig = tokenTextOf(src, lx, u);
          string local = orig;
          if (lx.tokens[(u + 1) * st] == kAs() && u + 2 < nt) { local = tokenTextOf(src, lx, u + 2); }
          // Every imported name is this file's for that spelling — a struct `Element` beside another
          // module's `Node.Element` (spec case 0591) — and an imported enum brings its variants.
          addTypeName(types, local);
          string vs = variantsOfEnum(table, orig);
          if (vs != "") { addQualified(pairs, vs, local); }
        }
        u++;
      }
    }
  }
  if (pairs.n == 0) { return text; }
  i32[] at = i32[].filled(nt + 1, 0);
  string[] what = string[].filled(nt + 1, "");
  i32 n = 0;
  i32 t = 0;
  while (t < nt) {
    if (skip[t] || lx.tokens[t * st] != kIdent()) { t++; continue; }
    string v = tokenTextOf(src, lx, t);
    string q = qualifierOf(pairs, v);
    if (q == "" || isTypeName(types, v)) { t++; continue; }
    i32 prev = t > 0 ? lx.tokens[(t - 1) * st] : 0 - 1;
    i32 next = t + 1 < nt ? lx.tokens[(t + 1) * st] : 0 - 1;
    if (prev == kDot() || prev == kIs() || prev == kLt() || prev == kAs() || prev == kAsBang()
        || prev == kAsTilde() || prev == kAsAt()) { t++; continue; }
    // A name after a type is being declared — `i32 Circle() { … }` — unless the word before is one of
    // the contextual keywords an expression can follow.
    if (prev == kIdent() || prev == kGt() || prev == kRbrack()) {
      string pw = prev == kIdent() ? tokenTextOf(src, lx, t - 1) : "";
      if (pw != "yield" && pw != "try" && pw != "in") { t++; continue; }
    }
    if (next == kDot() || next == kIdent() || next == kLt() || next == kGt() || next == kLbrack()) { t++; continue; }
    // The token after the variant and its payload, if it has one: a pattern ends in `:` or `matches`.
    i32 after = t + 1;
    if (next == kLparen()) {
      i32 depth = 0;
      while (after < nt) {
        i32 kk = lx.tokens[after * st];
        if (kk == kLparen()) { depth++; }
        if (kk == kRparen()) { depth--; if (depth == 0) { break; } }
        after++;
      }
      after++;
    }
    i32 ak = after < nt ? lx.tokens[after * st] : 0 - 1;
    if (ak == kMatches() || (ak == kColon() && prev != kQuestion())) { t = after; continue; }
    // `T? x` is a type; `c ? Dot : x` is not, and the `?` there comes before.
    if (next == kQuestion() && t + 2 < nt && lx.tokens[(t + 2) * st] == kIdent()) { t++; continue; }
    at[n] = lx.tokens[t * st + 1];
    what[n] = q + ".";
    n++;
    t++;
  }
  if (n == 0) { return text; }
  string res = "";
  i32 from = 0;
  for (i32 i = 0; i < n; i++) {
    res = res + bytesBetween(src, from, at[i]) + what[i];
    from = at[i];
  }
  return res + bytesBetween(src, from, src.len());
}

/** Variants a file can name unqualified, each with the qualifier that names its enum, by variant. */
struct Qualifiers {
  string[] variants;
  string[] quals;
  i32 n;
  KeyIndex ix;
}

/** Each variant in `vs` (`|V1|V2|`), qualified by `q`. */
void addQualified(Qualifiers qs, string vs, string q) {
  string rest = vs.slice(1, vs.len());
  while (rest.indexOf("|") > 0) {
    if (qs.n >= qs.variants.len()) {
      string[] bv = string[].filled(qs.variants.len() * 2 + 16, "");
      string[] bq = string[].filled(qs.variants.len() * 2 + 16, "");
      for (i32 i = 0; i < qs.n; i++) { bv[i] = qs.variants[i]; bq[i] = qs.quals[i]; }
      qs.variants = bv;
      qs.quals = bq;
    }
    string v = rest.slice(0, rest.indexOf("|"));
    qs.variants[qs.n] = v;
    qs.quals[qs.n] = q;
    keyAdd(qs.ix, v, qs.n);
    qs.n = qs.n + 1;
    rest = rest.slice(rest.indexOf("|") + 1, rest.len());
  }
}

/** The one qualifier `qs` gives variant `v`, or "" for none or for two different ones. */
string qualifierOf(Qualifiers qs, string v) {
  string q = "";
  bool seen = false;
  for (i32 i = keyFirst(qs.ix, v); i >= 0; i = qs.ix.next[i]) {
    if (qs.variants[i] != v) { continue; }
    if (!seen) { q = qs.quals[i]; seen = true; } else if (qs.quals[i] != q) { return ""; }
  }
  return q;
}

// ---- Default type arguments — spec ch19 ----

/**
 * `enum Result<T, E = union>` used as `Result<i32>`: every use that omits an argument with a default
 * gets the default written in, so `Result<i32>` is `Result<i32, union>` — and a `union` that lands in a
 * function's result is gathered from what the function returns (`lowerAutoReturns`), which is the
 * fresh placeholder each such use is. The defaults are read from every file supplied and from the
 * built-ins, whose `Result` is the one most uses name.
 */
string[] lowerTypeDefaults(Reads reads, string[] sources) {
  // The built-ins' defaults were read when they were embedded; a program's own files are read here.
  string table = builtinTypeDefaults();
  for (i32 i = 0; i < sources.len(); i++) {
    if (!mayDeclareTypeDefault(sources[i])) { continue; }
    table = table + typeDefaultsOf(reads, sources[i]);
  }
  if (table == "") { return sources; }
  string[] out = string[].filled(sources.len(), "");
  for (i32 i = 0; i < sources.len(); i++) {
    out[i] = mentionsAnyOf(sources[i], table) ? withTypeDefaults(reads, sources[i], table) : sources[i];
  }
  return out;
}

/** Whether `text` may declare a type with a default argument: a `struct` or `enum` header with `=` in its `<…>`. */
bool mayDeclareTypeDefault(string text) {
  // **One pass over the bytes.** This found each header by slicing off the text before it and searching
  // the rest again, for `enum ` as well as `struct `, so a source of many structs cost the square of its
  // length — and `std`, lowered on every build, is one (`issues/lang/0398b`). The rule is unchanged:
  // from each `struct ` or `enum `, the head runs to the next `{`, and an `=` after a `<` in it counts.
  u8[] b = text.toBytes();
  i32 n = b.len();
  for (i32 at = 0; at < n; at++) {
    i32 c = b[at] as i32;
    if (c != 115 && c != 101) { continue; }   // `s`, `e`: the rest is only asked where one could start
    if (!bytesAt(b, at, "struct ") && !bytesAt(b, at, "enum ")) { continue; }
    i32 from = at + 5;
    bool angled = false;
    for (i32 j = from; j < n && b[j] as i32 != 123; j++) {   // `{`
      if (b[j] as i32 == 60) { angled = true; }                // `<`
      if (angled && b[j] as i32 == 61) { return true; }        // `=`
    }
    at = from - 1;
  }
  return false;
}

/** Whether `b` holds `word`'s bytes starting at `at`. */
bool bytesAt(u8[] b, i32 at, string word) {
  u8[] w = word.toBytes();
  if (at + w.len() > b.len()) { return false; }
  for (i32 i = 0; i < w.len(); i++) { if (b[at + i] != w[i]) { return false; } }
  return true;
}

/** Whether `text` writes `Name<` for any name the defaults table holds. */
bool mentionsAnyOf(string text, string table) {
  string rest = table;
  while (rest.indexOf("|") >= 0) {
    string name = rest.slice(0, rest.indexOf("|"));
    if (text.indexOf(name + "<") >= 0) { return true; }
    // A bare use names a type whose every parameter has a default.
    if (text.indexOf(name) >= 0 && allDefaultsOf(table, name) != "") { return true; }
    if (rest.indexOf("\n") < 0) { return false; }
    rest = rest.slice(rest.indexOf("\n") + 1, rest.len());
  }
  return false;
}

/**
 * The generic types `text` declares with defaults, one `Name|count|d0;d1;…` line each — `""` for a
 * letter with none. Read off the tokens of each `struct` or `enum` header.
 */
string typeDefaultsOf(Reads reads, string text) {
  i32 srcRead = readOf(reads, text);
  u8[] src = readSrc(reads, srcRead);
  Lexed lx = readLexed(reads, srcRead);
  i32 st = tokenStride();
  string out = "";
  for (i32 t = 0; t + 2 < lx.tokenCount; t++) {
    i32 k = lx.tokens[t * st];
    if (k != kStruct() && k != kEnum()) { continue; }
    if (lx.tokens[(t + 1) * st] != kIdent() || lx.tokens[(t + 2) * st] != kLt()) { continue; }
    string name = tokenTextOf(src, lx, t + 1);
    i32 u = t + 3;
    i32 depth = 1;
    i32 count = 0;
    string defaults = "";
    bool any = false;
    string current = "";
    bool inDefault = false;
    i32 defaultFrom = 0;
    while (u < lx.tokenCount && depth > 0) {
      i32 kk = lx.tokens[u * st];
      if (kk == kLt()) { depth++; }
      if (kk == kGt()) { depth--; }
      if ((kk == kComma() && depth == 1) || depth == 0) {
        if (inDefault) { current = bytesBetween(src, defaultFrom, lx.tokens[u * st + 1]); any = true; }
        defaults = defaults + (count > 0 ? ";" : "") + trimSpaces(current);
        count++;
        current = "";
        inDefault = false;
      } else if (kk == kAssign() && depth == 1) {
        inDefault = true;
        defaultFrom = lx.tokens[(u + 1) * st + 1];
      }
      u++;
    }
    if (any) { out = out + name + "|" + numText(count) + "|" + defaults + "\n"; }
  }
  return out;
}

/** Every default of `name` in `table`, `", "`-joined — or "" when it has none or any parameter lacks one. */
string allDefaultsOf(string table, string name) {
  i32 row = table.indexOf(name + "|");
  if (row < 0 || (row > 0 && table.slice(row - 1, row) != "\n")) { return ""; }
  string line = table.slice(row + name.len() + 1, table.len());
  line = line.slice(0, line.indexOf("\n"));
  string ds = line.slice(line.indexOf("|") + 1, line.len()) + ";";
  string out = "";
  while (ds.indexOf(";") >= 0) {
    string d = ds.slice(0, ds.indexOf(";"));
    ds = ds.slice(ds.indexOf(";") + 1, ds.len());
    if (d == "") { return ""; }
    out = out + (out == "" ? "" : ", ") + d;
  }
  return out;
}

/** `text` with each use of a type in `table` that omits trailing arguments given their defaults. */
string withTypeDefaults(Reads reads, string text, string table) {
  i32 srcRead = readOf(reads, text);
  u8[] src = readSrc(reads, srcRead);
  Lexed lx = readLexed(reads, srcRead);
  i32 st = tokenStride();
  i32[] at = i32[].filled(lx.tokenCount + 1, 0);
  string[] what = string[].filled(lx.tokenCount + 1, "");
  i32 n = 0;
  for (i32 t = 0; t + 1 < lx.tokenCount; t++) {
    if (lx.tokens[t * st] != kIdent()) { continue; }
    if (t > 0 && (lx.tokens[(t - 1) * st] == kStruct() || lx.tokens[(t - 1) * st] == kEnum())) { continue; }
    // **A bare name whose every parameter has a default** is the type with all of them — `Box b` for
    // `struct Box<T = i32>`. Only where a type is written: before a name, `?`, `[`, or the `,`/`>` of an
    // enclosing argument list; `Box(…)`, `Box.of(…)` and `Box { … }` construct and are left to infer.
    if (lx.tokens[(t + 1) * st] != kLt()) {
      i32 nk = lx.tokens[(t + 1) * st];
      if (nk != kIdent() && nk != kQuestion() && nk != kLbrack() && nk != kComma() && nk != kGt()) { continue; }
      if (t > 0 && lx.tokens[(t - 1) * st] == kDot()) { continue; }
      string all = allDefaultsOf(table, tokenTextOf(src, lx, t));
      if (all == "") { continue; }
      what[n] = "<" + all + ">";
      // Before the next token, so `Box?` is `Box<i32>?` — whitespace after the name is kept after it.
      at[n] = lx.tokens[t * st + 1] + tokenTextOf(src, lx, t).len();
      n++;
      continue;
    }
    string name = tokenTextOf(src, lx, t);
    i32 row = table.indexOf(name + "|");
    if (row < 0 || (row > 0 && table.slice(row - 1, row) != "\n")) { continue; }
    string line = table.slice(row, table.len());
    line = line.slice(0, line.indexOf("\n"));
    string afterName = line.slice(name.len() + 1, line.len());
    i32 declared = 0;
    string countText = afterName.slice(0, afterName.indexOf("|"));
    for (i32 i = 0; i < countText.len(); i++) { declared = declared * 10 + (countText.toBytes()[i] as i32 - 48); }
    string defaults = afterName.slice(afterName.indexOf("|") + 1, afterName.len()) + ";";
    // The written arguments: count them to the `>` that closes this list.
    i32 u = t + 2;
    i32 depth = 1;
    i32 written = 1;
    i32 closeAt = 0 - 1;
    while (u < lx.tokenCount) {
      i32 kk = lx.tokens[u * st];
      if (kk == kLt()) { depth++; }
      if (kk == kComma() && depth == 1) { written++; }
      if (kk == kGt()) { depth--; if (depth == 0) { closeAt = lx.tokens[u * st + 1]; break; } }
      if (kk == kShr()) {
        if (depth == 1) { closeAt = lx.tokens[u * st + 1]; break; }
        if (depth == 2) { closeAt = lx.tokens[u * st + 1] + 1; break; }
        depth = depth - 2;
      }
      if (kk == kSemi() || kk == kLbrace() || kk == kRparen() && depth == 1) { break; }
      u++;
    }
    if (closeAt < 0 || written >= declared) { continue; }
    string add = "";
    string ds = defaults;
    for (i32 i = 0; i < declared; i++) {
      string d = ds.slice(0, ds.indexOf(";"));
      ds = ds.slice(ds.indexOf(";") + 1, ds.len());
      if (i < written) { continue; }
      if (d == "") { add = ""; break; }
      add = add + ", " + d;
    }
    if (add == "") { continue; }
    at[n] = closeAt;
    what[n] = add;
    n++;
  }
  if (n == 0) { return text; }
  // A use nested in another's arguments is met after the outer one opened: put them in offset order.
  for (i32 i = 1; i < n; i++) {
    i32 j = i;
    while (j > 0 && at[j - 1] > at[j]) {
      i32 ta = at[j]; at[j] = at[j - 1]; at[j - 1] = ta;
      string tw = what[j]; what[j] = what[j - 1]; what[j - 1] = tw;
      j--;
    }
  }
  string res = "";
  i32 from = 0;
  for (i32 i = 0; i < n; i++) {
    res = res + bytesBetween(src, from, at[i]) + what[i];
    from = at[i];
  }
  return res + bytesBetween(src, from, src.len());
}

/**
 * **A `union` placeholder in a function's result, gathered** (spec ch19, ch33): `Result<i32,
 * union>` — what a default writes for `Result<i32>` — collects the payloads of the variants its letter
 * types and what each `try` propagates, and is written in as that union. A function whose result names
 * no placeholder is left alone.
 */
string[] lowerResultPlaceholders(Reads reads, string[] paths, string[] sources, const Res res) {
  bool any = false;
  for (i32 i = 0; i < sources.len(); i++) { if (sources[i].indexOf("union>") >= 0 || sources[i].indexOf("union,") >= 0) { any = true; } }
  if (!any) { return sources; }
  string[] out = string[].filled(sources.len(), "");
  for (i32 i = 0; i < sources.len(); i++) { out[i] = sources[i]; }
  for (i32 f = 0; f < paths.len() && f < out.len(); f++) {
    if (out[f].indexOf("union") < 0) { continue; }
    i32 srcRead = readOf(reads, out[f]);
    u8[] src = readSrc(reads, srcRead);
    Lexed lx = readParsedLexed(reads, srcRead);
    Program prog = readProgram(reads, srcRead);
    // Each function's and method's result, with the name a collection asks for.
    PlaceholderEdits ed = PlaceholderEdits(i32[].filled(256, 0), i32[].filled(256, 0), string[].filled(256, ""), 0, "");
    for (i32 d = 0; d < prog.decls.len(); d++) {
      match (prog.decls[d].kind) {
        Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
          placeholderEditsFor(reads, paths, out, res, f, src, lx, returnType, tokenTextOf(src, lx, nameTok), ed);
        }
        StructDecl(snameTok, parentTok, fields, methods, sexported, isConst, stps): {
          for (i32 m = 0; m < methods.len(); m++) {
            placeholderEditsFor(reads, paths, out, res, f, src, lx, methods[m].returnType,
                                tokenTextOf(src, lx, snameTok) + "." + tokenTextOf(src, lx, methods[m].nameTok), ed);
          }
        }
        default: { }
      }
    }
    string text = "";
    i32 from = 0;
    for (i32 r = 0; r < ed.n; r++) {
      text = text + bytesBetween(src, from, ed.starts[r]) + ed.texts[r];
      from = ed.starts[r] + ed.lens[r];
    }
    // The imports the gathered members need, on lines of their own at the end: no earlier line moves.
    if (from > 0) { out[f] = text + bytesBetween(src, from, src.len()) + ed.imports + (ed.imports == "" ? "" : "\n"); }
  }
  return out;
}

/** Where each gathered placeholder goes in the text, in the order the declarations are written. */
struct PlaceholderEdits {
  i32[] starts;
  i32[] lens;
  string[] texts;
  i32 n;
  /** `import` lines for the members this file could not name, each once. */
  string imports;
}

/** The placeholders in one result type `ret` of function `fname`, gathered and queued as edits. */
void placeholderEditsFor(Reads reads, string[] paths, string[] sources, const Res res, i32 f, u8[] src, Lexed lx, Ty ret,
                         string fname, PlaceholderEdits ed) {
  match (ret.kind) {
    Named(rtok, rargs): {
      for (i32 k = 0; k < rargs.len(); k++) {
        match (rargs[k].kind) {
          Named(utok, uargs): {
            if (uargs.len() > 0 || tokenTextOf(src, lx, utok) != "union" || ed.n >= ed.starts.len()) { continue; }
            string tmpl = tokenTextOf(src, lx, rtok);
            string spec = tmpl + "|" + numText(k) + "|" + variantFieldsOfLetter(reads, sources, tmpl, k);
            Lexed?[] lexes = Lexed?[].defaulted(paths.len() + 1);
            Program?[] progs = Program?[].defaulted(paths.len() + 1);
            i32[] counts = declCountsInto(paths, sources, lexes, progs);
            C c = checkFilesAutoIn(paths, sources, res, paths[f], counts, lexes, progs, "", fname, spec);
            ed.starts[ed.n] = lx.tokens[utok * tokenStride() + 1];
            ed.lens[ed.n] = lx.tokens[utok * tokenStride() + 2];
            ed.texts[ed.n] = nameableGathered(reads, paths, sources, f, src, unionOfList(c.autoCollect), ed);
            ed.n = ed.n + 1;
          }
          default: { }
        }
      }
    }
    default: { }
  }
}

/**
 * The gathered union `text` with every member this file cannot name imported for it. A `try` reaches an
 * error type through the function it calls, not through an import, so the type may be declared in a file
 * this one never names — another of the program's, or `core` or `std`. Such a member is imported under
 * its own name, and the import queued on `ed`. A name the file declares or imports, and one no file exports
 * (a primitive, a type parameter), is left as it is.
 */
string nameableGathered(Reads reads, string[] paths, string[] sources, i32 f, u8[] src, string text, PlaceholderEdits ed) {
  u8[] tb = text.toBytes();
  Lexed tl = lex(tb);
  i32 st = tokenStride();
  string visible = namesVisibleIn(src);
  for (i32 t = 0; t < tl.tokenCount; t++) {
    if (tl.tokens[t * st] != kIdent()) { continue; }
    string name = tokenTextOf(tb, tl, t);
    if (visible.indexOf("|" + name + "|") >= 0) { continue; }
    string spec = moduleExportingType(reads, paths, sources, f, name);
    if (spec == "") { continue; }
    // **Imported by its own name**, which nothing here can collide with — the file neither declares nor imports
    // it. An alias would be a second spelling of the type, and the static evaluator expands a `type` the
    // declaring file wrote (`OutputFault = union<NoSpace, …>`) in that file's spelling, so `$gathered_NoSpace`
    // and `NoSpace` met as two types (`issues/lang/0397a`).
    string line = "\nimport { " + name + " } from \"" + spec + "\";";
    if (ed.imports.indexOf(line) < 0) { ed.imports = ed.imports + line; }
  }
  return text;
}

/** The names file `src` declares at the top level or binds by an import, as `|a|b|`. Lexed afresh: parsing rewrites tokens. */
string namesVisibleIn(u8[] src) {
  Lexed lx = lex(src);
  Program prog = parseProgram(P.create(src, lx));
  string out = "|";
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      Import(pathTok, prefixTok, items): {
        for (i32 i = 0; i < items.len(); i++) {
          if (items[i].nameTok < 0) { continue; }
          out = out + tokenTextOf(src, lx, items[i].aliasTok >= 0 ? items[i].aliasTok : items[i].nameTok) + "|";
        }
      }
      StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): { out = out + tokenTextOf(src, lx, nameTok) + "|"; }
      EnumDecl(nameTok, variants, exported, methods, typeParams): { out = out + tokenTextOf(src, lx, nameTok) + "|"; }
      default: { }
    }
  }
  return out;
}

/** The specifier file `f` imports type `name` by — another of `paths`, `core` or `std` — or `""` when none exports it. */
string moduleExportingType(Reads reads, string[] paths, string[] sources, i32 f, string name) {
  for (i32 m = 0; m < paths.len() && m < sources.len(); m++) {
    if (m == f || !exportsType(reads, sources[m], name)) { continue; }
    // A built-in reached under its own key — `"core"` as the CLI supplies it, `corePath()` as this
    // checker carries it — is imported by name, never by a path to it.
    if (isBuiltinSpec(paths[m])) { return paths[m]; }
    if (paths[m] == corePath()) { return "core"; }
    return relativeSpec(paths[f], paths[m]);
  }
  if (exportsType(reads, coreSource(), name)) { return "core"; }
  if (exportsType(reads, stdSource(), name)) { return "std"; }
  return "";
}

/** Whether `text` declares an exported struct or enum called `name`. */
bool exportsType(Reads reads, string text, string name) {
  if (text.indexOf("struct " + name) < 0 && text.indexOf("enum " + name) < 0) { return false; }
  i32 srcRead = readOf(reads, text);
  u8[] src = readSrc(reads, srcRead);
  Lexed lx = readParsedLexed(reads, srcRead);
  Program prog = readProgram(reads, srcRead);
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        if (exported && tokenTextOf(src, lx, nameTok) == name) { return true; }
      }
      EnumDecl(nameTok, variants, exported, methods, typeParams): {
        if (exported && tokenTextOf(src, lx, nameTok) == name) { return true; }
      }
      default: { }
    }
  }
  return false;
}

/** `a|b|a|` as `union<a, b>`, or `never` for nothing. */
string unionOfList(string list) {
  string seen = "|";
  string members = "";
  string rest = list;
  while (rest.indexOf("|") >= 0) {
    string one = rest.slice(0, rest.indexOf("|"));
    rest = rest.slice(rest.indexOf("|") + 1, rest.len());
    if (one == "" || seen.indexOf("|" + one + "|") >= 0) { continue; }
    seen = seen + one + "|";
    members = members + (members == "" ? "" : ", ") + one;
  }
  return members == "" ? "never" : "union<" + members + ">";
}

/**
 * The variant fields of enum `tmpl` typed by its letter at `index`, as `V:f,…` — read from whichever
 * file declares it, the built-ins included.
 */
string variantFieldsOfLetter(Reads reads, string[] sources, string tmpl, i32 index) {
  for (i32 i = 0; i <= sources.len() + 1; i++) {
    string text = i < sources.len() ? sources[i] : i == sources.len() ? coreSource() : stdSource();
    if (text.indexOf("enum " + tmpl) < 0) { continue; }
    i32 srcRead = readOf(reads, text);
    u8[] src = readSrc(reads, srcRead);
    Lexed lx = readParsedLexed(reads, srcRead);
    Program prog = readProgram(reads, srcRead);
    for (i32 d = 0; d < prog.decls.len(); d++) {
      match (prog.decls[d].kind) {
        EnumDecl(nameTok, variants, exported, methods, typeParams): {
          if (tokenTextOf(src, lx, nameTok) != tmpl || index >= typeParams.len()) { continue; }
          string letter = tokenTextOf(src, lx, typeParams[index]);
          string out = "";
          for (i32 v = 0; v < variants.len(); v++) {
            for (i32 fi = 0; fi < variants[v].fields.len(); fi++) {
              match (variants[v].fields[fi].type.kind) {
                Named(ftok, fargs): {
                  if (fargs.len() == 0 && tokenTextOf(src, lx, ftok) == letter) {
                    out = out + (out == "" ? "" : ",") + tokenTextOf(src, lx, variants[v].nameTok) + ":" + numText(fi);
                  }
                }
                default: { }
              }
            }
          }
          return out;
        }
        default: { }
      }
    }
  }
  return "";
}

// ---- A function's reference-typed statics — spec ch27 ----

/**
 * `static Box value = Box(1);` in a function is one value however often the function runs
 * (`§wac-modconst-ref-9jvq2mt`), which for a reference means one object — what a module-level static
 * already is. So each such static in a non-generic function moves to the top level under a name of its
 * own, `@"$static_<function>_<name>"`, and the function's uses of it are renamed. A number stays where
 * it is: its value is written as a literal. A generic's statics are per instantiation and stay too.
 */
string[] lowerStaticLocals(Reads reads, string[] sources) {
  string[] out = string[].filled(sources.len(), "");
  for (i32 f = 0; f < sources.len(); f++) {
    out[f] = sources[f].indexOf("static ") >= 0 ? staticLocalsOf(reads, sources[f]) : sources[f];
  }
  return out;
}

string staticLocalsOf(Reads reads, string text) {
  i32 srcRead = readOf(reads, text);
  u8[] src = readSrc(reads, srcRead);
  Lexed lx = readLexed(reads, srcRead);
  i32 st = tokenStride();
  i32 n = lx.tokenCount;
  i32[] at = i32[].filled(n + 1, 0);
  i32[] len = i32[].filled(n + 1, 0);
  string[] what = string[].filled(n + 1, "");
  i32 ne = 0;
  string hoisted = "";
  i32 t = 1;
  while (t + 1 < n) {
    // A function: a name and `(` after a type, its body the brace after the matching `)` — and not a
    // generic one, whose `<…>` would sit between the name and the `(`.
    i32 prev = lx.tokens[(t - 1) * st];
    if (lx.tokens[t * st] != kIdent() || lx.tokens[(t + 1) * st] != kLparen()
        || (prev != kIdent() && prev != kGt() && prev != kRbrack() && prev != kQuestion())) { t++; continue; }
    string fname = tokenTextOf(src, lx, t);
    i32 u = t + 1;
    i32 depth = 0;
    while (u < n) {
      i32 k = lx.tokens[u * st];
      if (k == kLparen()) { depth++; }
      if (k == kRparen()) { depth--; if (depth == 0) { break; } }
      u++;
    }
    if (u + 1 >= n || lx.tokens[(u + 1) * st] != kLbrace()) { t = u + 1; continue; }
    i32 open = u + 1;
    i32 close = open;
    depth = 0;
    while (close < n) {
      i32 k = lx.tokens[close * st];
      if (k == kLbrace()) { depth++; }
      if (k == kRbrace()) { depth--; if (depth == 0) { break; } }
      close++;
    }
    string renames = ";";
    for (i32 s = open + 1; s < close; s++) {
      if (lx.tokens[s * st] != kStatic()) { continue; }
      // `static T name = init;` — the name is the identifier before the `=`.
      i32 eq = s + 1;
      while (eq < close && lx.tokens[eq * st] != kAssign() && lx.tokens[eq * st] != kSemi()) { eq++; }
      if (eq >= close || lx.tokens[eq * st] != kAssign() || eq - 1 <= s + 1) { continue; }
      i32 nameTok = eq - 1;
      string ty = trimSpaces(bytesBetween(src, lx.tokens[(s + 1) * st + 1], lx.tokens[nameTok * st + 1]));
      if (isScalarSpelling(ty)) { continue; }
      i32 semi = eq;
      i32 d2 = 0;
      while (semi < close) {
        i32 k = lx.tokens[semi * st];
        if (k == kLparen() || k == kLbrack() || k == kLbrace()) { d2++; }
        if (k == kRparen() || k == kRbrack() || k == kRbrace()) { d2--; }
        if (k == kSemi() && d2 == 0) { break; }
        semi++;
      }
      string name = tokenTextOf(src, lx, nameTok);
      string hidden = "@\"$static_" + fname + "_" + name + "\"";
      hoisted = hoisted + "\nstatic " + ty + " " + hidden + " = "
              + bytesBetween(src, lx.tokens[(eq + 1) * st + 1], lx.tokens[semi * st + 1]) + ";";
      i32 from = lx.tokens[s * st + 1];
      i32 to = lx.tokens[semi * st + 1] + 1;
      at[ne] = from; len[ne] = to - from; what[ne] = blankOfApi(src, from, to); ne++;
      renames = renames + name + "=" + hidden + ";";
      s = semi;
    }
    if (renames != ";") {
      // Each use in the body, by name — a member after `.` is not one, nor the static's own line.
      for (i32 s = open + 1; s < close; s++) {
        if (lx.tokens[s * st] != kIdent() || lx.tokens[(s - 1) * st] == kDot()) { continue; }
        string nm = tokenTextOf(src, lx, s);
        i32 hit = renames.indexOf(";" + nm + "=");
        if (hit < 0 || insideEdit(at, len, ne, lx.tokens[s * st + 1])) { continue; }
        string tail = renames.slice(hit + nm.len() + 2, renames.len());
        at[ne] = lx.tokens[s * st + 1]; len[ne] = lx.tokens[s * st + 2]; what[ne] = tail.slice(0, tail.indexOf(";")); ne++;
      }
    }
    t = close + 1;
  }
  if (hoisted == "") { return text; }
  for (i32 i = 1; i < ne; i++) {
    i32 j = i;
    while (j > 0 && at[j - 1] > at[j]) {
      i32 ta = at[j]; at[j] = at[j - 1]; at[j - 1] = ta;
      i32 tl = len[j]; len[j] = len[j - 1]; len[j - 1] = tl;
      string tw = what[j]; what[j] = what[j - 1]; what[j - 1] = tw;
      j--;
    }
  }
  string res = "";
  i32 pos = 0;
  for (i32 i = 0; i < ne; i++) {
    res = res + bytesBetween(src, pos, at[i]) + what[i];
    pos = at[i] + len[i];
  }
  return res + bytesBetween(src, pos, src.len()) + hoisted + "\n";
}

/** Whether offset `b` falls inside one of the first `n` edits. */
bool insideEdit(i32[] at, i32[] len, i32 n, i32 b) {
  for (i32 i = 0; i < n; i++) { if (b >= at[i] && b < at[i] + len[i]) { return true; } }
  return false;
}

/** The bytes `from..to` as spaces, newlines kept, so no line moves. */
string blankOfApi(u8[] src, i32 from, i32 to) {
  u8[] b = u8[].filled(to - from, 32);
  for (i32 i = from; i < to; i++) { if (src[i] == 10) { b[i - from] = 10; } }
  return string.fromBytes(b);
}

/** Whether a written type is one whose value is a number a literal can carry. */
bool isScalarSpelling(string t) {
  return t == "i32" || t == "u32" || t == "i64" || t == "u64" || t == "f32" || t == "f64" || t == "bool"
      || t == "u8" || t == "i8" || t == "u16" || t == "i16";
}

// ---- Variadic parameters — spec ch14 ----

/**
 * `i32 count<Ts>(Ts ...items)` called as `count(1 as i32, "a")`: the remaining arguments are one tuple,
 * so the call is written `count((1 as i32, "a"))` — `(x,)` for one and `()` for none — and the
 * declaration is an ordinary function with a tuple parameter whose type `Ts` is inferred from it.
 * A free function named with no receiver; the names are gathered across every file supplied.
 *
 * **And a method with no receiver**, gathered as `Owner.name` and packed where a call writes the owner —
 * `Box.count(…)` or `Box<i32>.count(…)`. That is the shape of core's `Ticket.all`. A method with a
 * receiver is not lowered: which `count` `x.count(…)` calls depends on `x`'s type, and this works on
 * text. `issues/lang/0373a`.
 */
string[] lowerVariadics(Reads reads, string[] sources) {
  bool any = false;
  for (i32 i = 0; i < sources.len(); i++) { if (hasVariadicMarker(sources[i])) { any = true; } }
  // **And `core`'s, which a build adds after this runs** — `Ticket.all(a, b)` is packed although no
  // file here declares `all`. Parsing `core` costs every compile, so it is read only when a file
  // writes a call one of its variadic methods could be, found by a scan of its text.
  bool coreToo = callsCoreVariadic(sources);
  if (!any && !coreToo) { return sources; }
  string names = "|";
  string fixed = "|";
  // Where each file's markers are, as `file:offset;` — blanked once read, so lowering is idempotent.
  // `core`'s, at index `sources.len()`, are read for their names and never written back.
  string markers = ";";
  i32 scanned = sources.len() + (coreToo ? 1 : 0);
  for (i32 f = 0; f < scanned; f++) {
    string text = f < sources.len() ? sources[f] : coreSource();
    if (!hasVariadicMarker(text)) { continue; }
    i32 srcRead = readOf(reads, text);
    u8[] src = readSrc(reads, srcRead);
    Lexed lx = readParsedLexed(reads, srcRead);
    Program prog = readProgram(reads, srcRead);
    i32 st = tokenStride();
    for (i32 d = 0; d < prog.decls.len(); d++) {
      match (prog.decls[d].kind) {
        Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
          if (params.len() == 0) { continue; }
          i32 last = params[params.len() - 1].nameTok;
          if (last < 3 || lx.tokens[(last - 1) * st] != kDot() || lx.tokens[(last - 2) * st] != kDot()
              || lx.tokens[(last - 3) * st] != kDot()) { continue; }
          names = names + tokenTextOf(src, lx, nameTok) + "|";
          fixed = fixed + numText(params.len() - 1) + "|";
          markers = markers + numText(f) + ":" + numText(lx.tokens[(last - 3) * st + 1]) + ";";
        }
        StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
          for (i32 m = 0; m < methods.len(); m++) {
            Param[] mps = methods[m].params;
            if (methods[m].hasThis || mps.len() == 0) { continue; }
            i32 mlast = mps[mps.len() - 1].nameTok;
            if (mlast < 3 || lx.tokens[(mlast - 1) * st] != kDot() || lx.tokens[(mlast - 2) * st] != kDot()
                || lx.tokens[(mlast - 3) * st] != kDot()) { continue; }
            names = names + tokenTextOf(src, lx, nameTok) + "." + tokenTextOf(src, lx, methods[m].nameTok) + "|";
            fixed = fixed + numText(mps.len() - 1) + "|";
            markers = markers + numText(f) + ":" + numText(lx.tokens[(mlast - 3) * st + 1]) + ";";
          }
        }
        default: { }
      }
    }
  }
  if (names == "|") { return sources; }
  string[] out = string[].filled(sources.len(), "");
  for (i32 f = 0; f < sources.len(); f++) {
    // The declaration's `...` goes once the calls are packed: what is left is a tuple parameter, and
    // a second lowering of the same text finds nothing to pack again.
    string text = sources[f];
    string key = ";" + numText(f) + ":";
    string rest = markers;
    while (rest.indexOf(key) >= 0) {
      rest = rest.slice(rest.indexOf(key) + key.len(), rest.len());
      i32 off = decimalOfApi(rest.slice(0, rest.indexOf(";")));
      text = text.slice(0, off) + "   " + text.slice(off + 3, text.len());
    }
    out[f] = variadicCallsOf(reads, text, names, fixed);
  }
  return out;
}

i32 decimalOfApi(string s) {
  i32 n = 0;
  for (i32 i = 0; i < s.len(); i++) { n = n * 10 + (s.toBytes()[i] as i32 - 48); }
  return n;
}

/**
 * Whether any of `sources` writes `.name(` for a method of `core`'s with a variadic parameter. The names
 * are read off `core`'s text — the identifier before the `(` (or `<`) that opens the list holding each
 * ` ...name` — which is a scan rather than a parse, so a program that calls none pays almost nothing.
 */
bool callsCoreVariadic(string[] sources) {
  // Read off `core` when the compiler was built (`variadicCalleesIn`, in `scans.wac`).
  string rest = builtinVariadicCallees();
  while (rest.indexOf("|") >= 0) {
    string nm = rest.slice(0, rest.indexOf("|"));
    rest = rest.slice(rest.indexOf("|") + 1, rest.len());
    if (nm == "") { continue; }
    for (i32 i = 0; i < sources.len(); i++) {
      if (sources[i].indexOf("." + nm + "(") >= 0) { return true; }
    }
  }
  return false;
}

/** Whether `text` has a ` ...name` — a variadic parameter's marker, not prose's ellipsis. */
bool hasVariadicMarker(string text) {
  string rest = text;
  while (rest.indexOf(" ...") >= 0) {
    rest = rest.slice(rest.indexOf(" ...") + 4, rest.len());
    if (rest.len() == 0) { return false; }
    u8 c = rest.toBytes()[0];
    if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95) { return true; }
  }
  return false;
}

/** The fixed-parameter count of variadic `name`, or -1. */
i32 variadicFixed(string names, string fixed, string name) {
  i32 at = names.indexOf("|" + name + "|");
  if (at < 0) { return 0 - 1; }
  i32 k = 0;
  for (i32 i = 0; i < at; i++) { if (names.slice(i, i + 1) == "|") { k++; } }
  string rest = fixed;
  for (i32 i = 0; i < k; i++) { rest = rest.slice(rest.indexOf("|") + 1, rest.len()); }
  rest = rest.slice(rest.indexOf("|") + 1, rest.len());
  string digits = rest.slice(0, rest.indexOf("|"));
  i32 n = 0;
  for (i32 i = 0; i < digits.len(); i++) { n = n * 10 + (digits.toBytes()[i] as i32 - 48); }
  return n;
}

/** Whether `src` holds `text` at offset `at`. */
bool startsWithAt(u8[] src, i32 at, string text) {
  u8[] t = text.toBytes();
  if (at < 0 || at + t.len() > src.len()) { return false; }
  for (i32 i = 0; i < t.len(); i++) { if (src[at + i] != t[i]) { return false; } }
  return true;
}

/**
 * The type a static call's receiver names, read back from the token before the dot: `Box` in
 * `Box.count(` and in `Box<i32, string>.count(`. Empty for anything else.
 */
string staticOwnerText(u8[] src, Lexed lx, i32 t) {
  i32 st = tokenStride();
  if (t < 0) { return ""; }
  if (lx.tokens[t * st] == kIdent()) { return tokenTextOf(src, lx, t); }
  if (lx.tokens[t * st] != kGt()) { return ""; }
  i32 depth = 0;
  while (t >= 0) {
    i32 k = lx.tokens[t * st];
    if (k == kGt()) { depth++; }
    if (k == kLt()) {
      depth--;
      if (depth == 0) { break; }
    }
    t--;
  }
  if (t < 1 || lx.tokens[(t - 1) * st] != kIdent()) { return ""; }
  return tokenTextOf(src, lx, t - 1);
}

string variadicCallsOf(Reads reads, string text, string names, string fixed) {
  i32 srcRead = readOf(reads, text);
  u8[] src = readSrc(reads, srcRead);
  Lexed lx = readLexed(reads, srcRead);
  i32 st = tokenStride();
  i32 n = lx.tokenCount;
  // Insertions as `offset:text` pairs, in increasing offset — the walk meets them in that order.
  i32[] at = i32[].filled(n * 2 + 2, 0);
  string[] what = string[].filled(n * 2 + 2, "");
  i32 count = 0;
  for (i32 t = 0; t + 1 < n; t++) {
    if (lx.tokens[t * st] != kIdent() || lx.tokens[(t + 1) * st] != kLparen()) { continue; }
    string callee = tokenTextOf(src, lx, t);
    if (t > 0 && lx.tokens[(t - 1) * st] == kDot()) {
      string owner = staticOwnerText(src, lx, t - 2);
      if (owner == "") { continue; }
      callee = owner + "." + callee;
    }
    i32 fx = variadicFixed(names, fixed, callee);
    if (fx < 0) { continue; }
    // **Packed once.** A packed call carries `/*...*/` just inside its `(`, which the lexer drops and
    // this pass reads: a free function's second lowering finds no `...` left on its declaration, but
    // `core`'s are read from `core`'s own text every time, and a build lowers more than once —
    // `Ticket.all(a, b)` became `Ticket.all(((a, b),))`.
    i32 openAt = lx.tokens[(t + 1) * st + 1];
    if (startsWithAt(src, openAt + 1, "/*...*/")) { continue; }
    // A declaration is a name after a type, and a call is not: `i32 count<Ts>(…)` has `<` next, so
    // only a non-generic declaration reaches here, and its parameters are typed — a `...` among them.
    i32 depth = 0;
    i32 u = t + 1;
    i32 argIndex = 0 - 1;
    i32 packAt = 0 - 1;
    bool isDecl = false;
    while (u < n) {
      i32 k = lx.tokens[u * st];
      if (k == kLparen() || k == kLbrack() || k == kLbrace()) {
        depth++;
        if (depth == 1) {
          if (u + 1 < n && lx.tokens[(u + 1) * st] != kRparen()) {
            argIndex = 0;
            if (fx == 0) { packAt = lx.tokens[(u + 1) * st + 1]; }
          }
          u++;
          continue;
        }
      }
      if (k == kRparen() || k == kRbrack() || k == kRbrace()) {
        depth--;
        if (depth == 0) { break; }
      }
      if (depth == 1 && k == kDot() && u + 1 < n && lx.tokens[(u + 1) * st] == kDot()) { isDecl = true; }
      if (depth == 1 && k == kComma()) {
        argIndex++;
        if (argIndex == fx && u + 1 < n) { packAt = lx.tokens[(u + 1) * st + 1]; }
      }
      u++;
    }
    i32 args = argIndex + 1;
    if (isDecl || u >= n) { continue; }
    i32 closeAt = lx.tokens[u * st + 1];
    at[count] = openAt + 1; what[count] = "/*...*/"; count++;
    i32 packed = args - fx;
    if (packed <= 0) {
      at[count] = closeAt; what[count] = fx == 0 ? "()" : ", ()"; count++;
    } else {
      at[count] = packAt; what[count] = "("; count++;
      at[count] = closeAt; what[count] = packed == 1 ? ",)" : ")"; count++;
    }
  }
  if (count == 0) { return text; }
  // Sorted by offset: a call nested in an argument is met after its enclosing call opened, and its
  // own insertions fall between that call's two.
  for (i32 i = 1; i < count; i++) {
    i32 j = i;
    while (j > 0 && at[j - 1] > at[j]) {
      i32 ta = at[j]; at[j] = at[j - 1]; at[j - 1] = ta;
      string tw = what[j]; what[j] = what[j - 1]; what[j - 1] = tw;
      j--;
    }
  }
  string res = "";
  i32 from = 0;
  for (i32 i = 0; i < count; i++) {
    res = res + bytesBetween(src, from, at[i]) + what[i];
    from = at[i];
  }
  return res + bytesBetween(src, from, src.len());
}

// ---- Instantiations in an export list — spec ch02, ch19 ----

/**
 * `export { max<i32> as maxI32 };` — an instantiation exported under a name the author wrote. Each such
 * item leaves the list and becomes a function that forwards to the instance, `export i32 maxI32(i32 a,
 * i32 b) { return max<i32>(a, b); }`, so a host calls a name in the source and the generic stays one
 * declaration. Lines are kept: the item is blanked, and the functions go at the end of the file.
 */
string[] lowerExportInstances(Reads reads, string[] sources) {
  bool any = false;
  for (i32 i = 0; i < sources.len(); i++) { if (sources[i].indexOf("export {") >= 0) { any = true; } }
  if (!any) { return sources; }
  string[] out = string[].filled(sources.len(), "");
  for (i32 i = 0; i < sources.len(); i++) {
    out[i] = sources[i].indexOf("export {") >= 0 ? exportInstancesOf(reads, sources[i]) : sources[i];
  }
  return out;
}

string exportInstancesOf(Reads reads, string text) {
  i32 srcRead = readOf(reads, text);
  u8[] src = readSrc(reads, srcRead);
  Lexed lx = readLexed(reads, srcRead);
  i32 st = tokenStride();
  i32 n = lx.tokenCount;
  u8[] blanked = u8[].filled(src.len(), 0);
  for (i32 i = 0; i < src.len(); i++) { blanked[i] = src[i]; }
  string names = "";
  string argLists = "";
  string aliases = "";
  i32 found = 0;
  for (i32 t = 0; t + 1 < n; t++) {
    if (lx.tokens[t * st] != kExport() || lx.tokens[(t + 1) * st] != kLbrace()) { continue; }
    i32 u = t + 2;
    while (u < n && lx.tokens[u * st] == kIdent()) {
      i32 itemStart = lx.tokens[u * st + 1];
      i32 nameT = u;
      u++;
      if (u >= n || lx.tokens[u * st] != kLt()) {
        if (u + 1 < n && lx.tokens[u * st] == kAs()) { u += 2; }
        if (u < n && lx.tokens[u * st] == kComma()) { u++; }
        continue;
      }
      i32 argFrom = lx.tokens[u * st + 1] + 1;
      i32 depth = 0;
      i32 argTo = argFrom;
      while (u < n) {
        i32 k = lx.tokens[u * st];
        if (k == kLt()) { depth++; }
        if (k == kGt()) { depth--; }
        if (k == kShr()) { depth = depth - 2; }
        if (depth <= 0 && (k == kGt() || k == kShr())) { argTo = lx.tokens[u * st + 1]; u++; break; }
        u++;
      }
      string alias = tokenTextOf(src, lx, nameT);
      if (u + 1 < n && lx.tokens[u * st] == kAs()) { alias = tokenTextOf(src, lx, u + 1); u += 2; }
      if (u < n && lx.tokens[u * st] == kComma()) { u++; }
      i32 itemEnd = u < n ? lx.tokens[u * st + 1] : src.len();
      for (i32 b = itemStart; b < itemEnd; b++) { if (blanked[b] != 10) { blanked[b] = 32; } }
      names = names + tokenTextOf(src, lx, nameT) + "\n";
      argLists = argLists + bytesBetween(src, argFrom, argTo) + "\n";
      aliases = aliases + alias + "\n";
      found++;
    }
  }
  if (found == 0) { return text; }
  string body = string.fromBytes(blanked);
  i32 bsrcRead = readOf(reads, body);
  u8[] bsrc = readSrc(reads, bsrcRead);
  Lexed blx = readParsedLexed(reads, bsrcRead);
  Program prog = readProgram(reads, bsrcRead);
  string extra = "";
  for (i32 k = 0; k < found; k++) {
    string name = nthLine(names, k);
    string[] targs = splitTopLevelCommas(nthLine(argLists, k));
    i32 before = extra.len();
    for (i32 d = 0; d < prog.decls.len(); d++) {
      match (prog.decls[d].kind) {
        Func(nameTok, returnType, params, fbody, exported, typeParams, isAsync): {
          // An `async` instance would be forwarded as a ticket of a ticket; it stays unexported for now.
          if (tokenTextOf(bsrc, blx, nameTok) != name || typeParams.len() != targs.len() || isAsync) { continue; }
          string[] from = string[].filled(typeParams.len(), "");
          for (i32 i = 0; i < typeParams.len(); i++) { from[i] = tokenTextOf(bsrc, blx, typeParams[i]); }
          string ret = spellTyWith(bsrc, blx, returnType, from, targs);
          string sig = "";
          string fwd = "";
          for (i32 i = 0; i < params.len(); i++) {
            string pn = tokenTextOf(bsrc, blx, params[i].nameTok);
            sig = sig + (i > 0 ? ", " : "") + spellTyWith(bsrc, blx, params[i].type, from, targs) + " " + pn;
            fwd = fwd + (i > 0 ? ", " : "") + pn;
          }
          string call = name + "<" + nthLine(argLists, k) + ">(" + fwd + ")";
          extra = extra + "\nexport " + ret + " " + nthLine(aliases, k) + "(" + sig + ") { "
                + (ret == "void" ? call + "; }" : "return " + call + "; }");
        }
        // **A type's instantiation is the type under a second name** — `IntBox` and `Box<i32>` are one
        // type — which is what an alias is.
        StructDecl(snameTok, sparent, sfields, smethods, sexported, sconst, stps): {
          if (tokenTextOf(bsrc, blx, snameTok) != name || stps.len() != targs.len()) { continue; }
          extra = extra + "\nexport type " + nthLine(aliases, k) + " = " + name + "<" + nthLine(argLists, k) + ">;";
        }
        EnumDecl(enameTok, evariants, eexported, emethods, etps): {
          if (tokenTextOf(bsrc, blx, enameTok) != name || etps.len() != targs.len()) { continue; }
          extra = extra + "\nexport type " + nthLine(aliases, k) + " = " + name + "<" + nthLine(argLists, k) + ">;";
        }
        default: { }
      }
    }
    // **Declared in another file**: `export { Vec<i32> as IntVec }` names an imported template, which
    // is not here to look at — and a name that is not a function here is a type, since an imported
    // generic function's instance is not forwarded yet. The checker refuses the alias if it is not.
    if (extra.len() == before && !declaresFunc(prog, bsrc, blx, name)) {
      extra = extra + "\nexport type " + nthLine(aliases, k) + " = " + name + "<" + nthLine(argLists, k) + ">;";
    }
  }
  return body + extra + "\n";
}

/** Whether `prog` declares a function called `name`. */
bool declaresFunc(Program prog, u8[] src, Lexed lx, string name) {
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      Func(nameTok, returnType, params, fbody, exported, typeParams, isAsync): {
        if (tokenTextOf(src, lx, nameTok) == name) { return true; }
      }
      default: { }
    }
  }
  return false;
}

/** Line `k` of a `\n`-terminated list. */
string nthLine(string list, i32 k) {
  string rest = list;
  for (i32 i = 0; i < k; i++) { rest = rest.slice(rest.indexOf("\n") + 1, rest.len()); }
  return rest.slice(0, rest.indexOf("\n"));
}

/** `i32, Box<i32, string>` as its two type arguments, trimmed. */
string[] splitTopLevelCommas(string s) {
  i32 n = 1;
  i32 depth = 0;
  for (i32 i = 0; i < s.len(); i++) {
    string ch = s.slice(i, i + 1);
    if (ch == "<" || ch == "(") { depth++; }
    if (ch == ">" || ch == ")") { depth--; }
    if (ch == "," && depth == 0) { n++; }
  }
  string[] out = string[].filled(n, "");
  i32 k = 0;
  i32 from = 0;
  depth = 0;
  for (i32 i = 0; i < s.len(); i++) {
    string ch = s.slice(i, i + 1);
    if (ch == "<" || ch == "(") { depth++; }
    if (ch == ">" || ch == ")") { depth--; }
    if (ch == "," && depth == 0) { out[k] = trimSpaces(s.slice(from, i)); k++; from = i + 1; }
  }
  out[k] = trimSpaces(s.slice(from, s.len()));
  return out;
}

/** A written type, spelled back with each of `from` replaced by the matching `to`. */
string spellTyWith(u8[] src, Lexed lx, Ty t, string[] from, string[] to) {
  match (t.kind) {
    Prim(tok): { return tok < 0 ? "i32" : tokenTextOf(src, lx, tok); }
    Named(tok, args): {
      string nm = tokenTextOf(src, lx, tok);
      if (args.len() == 0) {
        for (i32 i = 0; i < from.len(); i++) { if (from[i] == nm) { return to[i]; } }
        return nm;
      }
      string s = nm + "<";
      for (i32 i = 0; i < args.len(); i++) { s = s + (i > 0 ? ", " : "") + spellTyWith(src, lx, args[i], from, to); }
      return s + ">";
    }
    Arr(elem): { return spellTyWith(src, lx, elem, from, to) + "[]"; }
    Nullable(inner): { return spellTyWith(src, lx, inner, from, to) + "?"; }
    Funcref(ret, params): {
      string s = "fn<" + spellTyWith(src, lx, ret, from, to) + "(";
      for (i32 i = 0; i < params.len(); i++) { s = s + (i > 0 ? ", " : "") + spellTyWith(src, lx, params[i], from, to); }
      return s + ")>";
    }
    TupleOf(members): {
      string s = "(";
      for (i32 i = 0; i < members.len(); i++) { s = s + (i > 0 ? ", " : "") + spellTyWith(src, lx, members[i], from, to); }
      return s + (members.len() == 1 ? ",)" : ")");
    }
    TypeOf(e): { return "type(" + "?" + ")"; }
    TypeofExpr(e): { return "typeof(?)"; }
  }
}

/** Whether a source may declare a function whose result is `auto`; parsing says for certain. */
bool mentionsAutoReturn(string s) {
  return startsWith(s, "auto ") || s.indexOf("\nauto ") >= 0 || s.indexOf("export auto ") >= 0;
}

/** One file's `auto` functions: names, each one's `auto` token, and the `|`-set of names it calls. */
struct AutoFns {
  string[] names;
  i32[] toks;
  string[] calls;
}

AutoFns autoFnsOf(u8[] src, Lexed lx, Program prog) {
  i32 n = 0;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
        if (autoTokOf(src, lx, returnType) >= 0) { n++; }
      }
      default: { }
    }
  }
  string[] names = string[].filled(n, "");
  i32[] toks = i32[].filled(n, 0);
  i32[] nameToks = i32[].filled(n, 0);
  i32 k = 0;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
        i32 at = autoTokOf(src, lx, returnType);
        if (at < 0) { continue; }
        names[k] = tokenTextOf(src, lx, nameTok);
        toks[k] = at;
        nameToks[k] = nameTok;
        k++;
      }
      default: { }
    }
  }
  // **What each one calls, by its tokens**: from the name to the brace closing its body, every name
  // followed by `(`. A dependency named and never reached costs one more traversal, not an answer.
  string[] calls = string[].filled(n, "|");
  i32 st = tokenStride();
  for (i32 f = 0; f < n; f++) {
    i32 t = nameToks[f];
    while (t < lx.tokenCount && lx.tokens[t * st] != kLbrace()) { t++; }
    i32 depth = 0;
    while (t < lx.tokenCount) {
      i32 kind = lx.tokens[t * st];
      if (kind == kLbrace()) { depth++; }
      if (kind == kRbrace()) { depth--; if (depth == 0) { break; } }
      if (kind == kIdent() && t + 1 < lx.tokenCount && lx.tokens[(t + 1) * st] == kLparen()) {
        string callee = tokenTextOf(src, lx, t);
        for (i32 g = 0; g < n; g++) {
          if (names[g] == callee && calls[f].indexOf("|" + callee + "|") < 0) {
            calls[f] = calls[f] + callee + "|";
          }
        }
      }
      t++;
    }
  }
  return AutoFns(names, toks, calls);
}

/** The token of a written `auto`, or -1. */
i32 autoTokOf(u8[] src, Lexed lx, Ty t) {
  match (t.kind) {
    Named(tok, typeArgs): {
      if (typeArgs.len() == 0 && tokenTextOf(src, lx, tok) == "auto") { return tok; }
      return 0 - 1;
    }
    default: { return 0 - 1; }
  }
}

/** What one inference over a file needs, and the traversals it has already made. */
struct AutoRun {
  string[] paths;
  string[] sources;
  const Res res;
  i32 file;
  AutoFns fns;
  string[] memoKeys;
  string[] memoLists;
  string[] memoWide;
  i32 memoCount;
}

/**
 * Function `k`'s contributions on the dependency path `path` (`|a|b|`), and their widening — spec
 * ch34. Every `auto` it calls is traversed afresh with itself added to the path, and one already on
 * the path contributes nothing: so the answer depends on the root, never on which was inferred first.
 * A traversal's contributions reach its caller widened, as the call's type.
 */
string autoCollect(AutoRun run, i32 k, string path) {
  string key = numText(k) + path;
  for (i32 i = 0; i < run.memoCount; i++) { if (run.memoKeys[i] == key) { return run.memoLists[i]; } }
  string assume = "";
  for (i32 g = 0; g < run.fns.names.len(); g++) {
    string gname = run.fns.names[g];
    string got = "";
    if (run.fns.calls[k].indexOf("|" + gname + "|") >= 0 && path.indexOf("|" + gname + "|") < 0) {
      autoCollect(run, g, path + gname + "|");
      got = autoWideOf(run, numText(g) + path + gname + "|");
      if (startsWith(got, "!")) { got = ""; }
    }
    assume = assume + gname + "=" + got + "\n";
  }
  Lexed?[] lexes = Lexed?[].defaulted(run.paths.len() + 1);
  Program?[] progs = Program?[].defaulted(run.paths.len() + 1);
  i32[] counts = declCountsInto(run.paths, run.sources, lexes, progs);
  C c = checkFilesAutoIn(run.paths, run.sources, run.res, run.paths[run.file], counts, lexes, progs,
                         assume, run.fns.names[k], "");
  if (run.memoCount >= run.memoKeys.len()) {
    i32 grown = run.memoKeys.len() * 2 + 8;
    string[] mk = string[].filled(grown, "");
    string[] ml = string[].filled(grown, "");
    string[] mw = string[].filled(grown, "");
    for (i32 i = 0; i < run.memoCount; i++) {
      mk[i] = run.memoKeys[i]; ml[i] = run.memoLists[i]; mw[i] = run.memoWide[i];
    }
    run.memoKeys = mk; run.memoLists = ml; run.memoWide = mw;
  }
  run.memoKeys[run.memoCount] = key;
  run.memoLists[run.memoCount] = c.autoCollect;
  run.memoWide[run.memoCount] = widenAutoContributions(c, c.autoCollect);
  run.memoCount = run.memoCount + 1;
  return c.autoCollect;
}

string autoWideOf(AutoRun run, string key) {
  for (i32 i = 0; i < run.memoCount; i++) { if (run.memoKeys[i] == key) { return run.memoWide[i]; } }
  return "";
}

/**
 * Every `auto` result written into its source as the type inferred — spec ch34. One that cannot
 * be inferred stays `auto`, and the checker says why (`errAutoUnresolved`). An empty collection is
 * `never`, and `never?` is spelled `null`, which is how the language writes it (ch10).
 */
export string[] lowerAutoReturns(Reads reads, string[] paths, string[] sources, const Res res) {
  bool any = false;
  for (i32 i = 0; i < sources.len(); i++) { if (mentionsAutoReturn(sources[i])) { any = true; } }
  if (!any) { return sources; }
  string[] out = string[].filled(sources.len(), "");
  for (i32 i = 0; i < sources.len(); i++) { out[i] = sources[i]; }
  for (i32 f = 0; f < paths.len() && f < out.len(); f++) {
    if (!mentionsAutoReturn(out[f])) { continue; }
    i32 srcRead = readOf(reads, out[f]);
    u8[] src = readSrc(reads, srcRead);
    Lexed lx = readParsedLexed(reads, srcRead);
    Program prog = readProgram(reads, srcRead);
    AutoFns fns = autoFnsOf(src, lx, prog);
    if (fns.names.len() == 0) { continue; }
    AutoRun run = AutoRun(paths, out, res, f, fns, string[](), string[](), string[](), 0);
    string[] spelled = string[].filled(fns.names.len(), "");
    for (i32 k = 0; k < fns.names.len(); k++) {
      string path = "|" + fns.names[k] + "|";
      autoCollect(run, k, path);
      string w = autoWideOf(run, numText(k) + path);
      if (w == "") { w = "never"; }
      if (startsWith(w, "never?")) { w = "null" + w.slice(6, w.len()); }
      spelled[k] = startsWith(w, "!") ? "" : w;
    }
    string text = "";
    i32 from = 0;
    i32 st = tokenStride();
    for (i32 k = 0; k < fns.names.len(); k++) {
      if (spelled[k] == "") { continue; }
      i32 start = lx.tokens[fns.toks[k] * st + 1];
      i32 len = lx.tokens[fns.toks[k] * st + 2];
      text = text + bytesBetween(src, from, start) + spelled[k];
      from = start + len;
    }
    out[f] = text + bytesBetween(src, from, src.len());
  }
  return out;
}

string bytesBetween(u8[] src, i32 from, i32 to) {
  u8[] b = u8[].filled(to - from, 0);
  for (i32 i = from; i < to; i++) { b[i - from] = src[i]; }
  return string.fromBytes(b);
}

/**
 * Which files in a graph can reach a host capability, and through what — `wac audit`.
 *
 * **wac has no ambient authority**, and that is what makes this answerable at all: a capability is a
 * funcref field on `Cli` or `Core`, and a function that is not handed one cannot call one. There is no
 * global to reach for, no `import fs`, nothing a body can do that its signature does not admit. So the
 * question *what can this dependency touch* has a static answer, and it is a property of declared
 * types rather than of what the code happens to do with them.
 *
 * `packages/wac/src/grants.wac` is the same idea one level up and by hand: `narrowed(cli, forCommand(
 * "update"))` refuses the fetcher everything it did not ask for, because *"a callee shares its
 * caller's capabilities"*. That is a discipline somebody remembered. This is the instrument that says
 * where it was not remembered.
 *
 * ## What "reaches" means, exactly
 *
 * A **bearing type** is `Sys`, a type `std` declares whose methods reach the host — `Cli`, `Core`,
 * `Listener`, `Socket`, `Child` — or any type with a field, a variant payload or a method return
 * whose type is bearing, to a fixpoint (spec ch49 `§wac-cli-audit-bearing-9km4txr`). That second clause is not theoretical: `packages/fs/src/remote.wac` and
 * `packages/platform/src/stream.wac` both hold a `Cli cli;` field, so a file handed one of those has
 * the whole capability set without ever naming `Cli`.
 *
 * A **file reaches** if any declaration in it mentions a bearing type in a field, a parameter or a
 * return. A file that mentions none is *sealed*: nothing in it can perform an effect, whatever its
 * body says, because it has nothing to perform one with.
 *
 * ## Sound in the direction that matters, and here is where it is not
 *
 * The useful guarantee is that **sealed is never wrong** — a file this clears cannot reach a
 * capability. It over-approximates freely in the other direction: a file that takes a `Cli` and only
 * reads `argCount` is reported as reaching, because the honest unit here is the type and not the
 * field.
 *
 * Two limits, named rather than hidden, because a ledger that reads like an audit and is not is worse
 * than none — `packages/platform/test/wac/conformance_test.wac` says so about itself:
 *
 * - **Derived authority is out of scope.** A `Socket` from `Cli.connect` is a live connection, and a
 *   file holding one can talk to the network without naming `Cli`. The seed is the two types a host
 *   *constructs*; everything reachable from them is a second question.
 * - **The unit is the type, not the field, and that is not laziness.** Naming *which* of `Cli`'s 44
 *   capabilities a file reaches would be worth more than `reaches`, and the cheap ways of getting it
 *   do not work. Measured over `packages/`: of 2,598 call sites whose method name is a capability's,
 *   **79% are on a receiver literally called `cli` or `core`** and the rest are on `fs` (253), `page`
 *   (164), `sh` and a scatter of short names — so a receiver-prefix scan is a fifth short, and the
 *   misses cluster in exactly the wrapper types that hold a `Cli`. Matching the method name on any
 *   receiver fails the other way: `remove`, `log`, `call`, `on`, `render` and `resolve` are ordinary
 *   names, so a `Vec.remove` would read as the filesystem. Field-level needs the checker's types, and
 *   a column that is 21% short would be read as exhaustive — which is the failure this whole function
 *   is written against.
 * - **A generic parameterised over a bearing type is not tracked.** `Vec<Cli>` mentions `Cli` and is
 *   caught by the mention scan, but a `T` bound to `Cli` at a distant call site is not.
 *
 * ## The output
 *
 * `file\treaches|sealed\tvia\troot` per line — `via` the bearing type the file names, `root` the
 * host-reaching type that makes it bearing (`Sink` and `Sys`) — sorted by the caller, then a `#` line with the totals and any
 * bound that was hit. **A bound is reported rather than absorbed**: a truncated table that says
 * `sealed` about a file it ran out of room for is the one failure this must not have.
 */
export string capReachFiles(const string[] paths, const string[] sources) {
  i32 n = 0;
  for (i32 i = 0; i < paths.len(); i++) { if (paths[i] != "") { n = i + 1; } }

  i32 maxTy = 8192;
  string[] tyName = string[].filled(maxTy, "");
  // What each type holds, tab-delimited and tab-terminated so a search for `"\t" + name + "\t"`
  // cannot match a prefix: `Cli` must not be found inside `ClientState`.
  string[] tyHolds = string[].filled(maxTy, "");
  bool[] bearing = bool[].filled(maxTy, false);
  // The bearing type each one holds — the next link towards the root that makes it bearing.
  string[] heldVia = string[].filled(maxTy, "");
  i32 tyCount = 0;
  bool overflowed = false;

  // Every named type any declaration in this file mentions in a field, parameter or return.
  string[] mentions = string[].filled(n + 1, "");

  for (i32 i = 0; i < n; i++) {
    if (paths[i] == "") { continue; }
    u8[] src = (i < sources.len() ? sources[i] : "").toBytes();
    Lexed lx = lex(src);
    P p = P.create(src, lx);
    Program prog = parseProgram(p);
    string seen = "\t";
    for (i32 d = 0; d < prog.decls.len(); d++) {
      string holds = "\t";
      string declName = "";
      bool isType = false;
      match (prog.decls[d].kind) {
        StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
          declName = tokenTextOf(src, lx, nameTok);
          isType = true;
          for (i32 f = 0; f < fields.len(); f++) {
            holds = holds + tyNamesJoined(src, lx, fields[f].type);
          }
          // **A method's return counts as a field does.** `Fs.onHost(cli, 0)` is how a `Cli` gets into
          // an `Fs`; a method answering one is how it gets out, and a closure over fields alone would
          // clear the holder.
          for (i32 m = 0; m < methods.len(); m++) {
            holds = holds + tyNamesJoined(src, lx, methods[m].returnType);
          }
        }
        EnumDecl(nameTok, variants, exported, methods, typeParams): {
          declName = tokenTextOf(src, lx, nameTok);
          isType = true;
          for (i32 v = 0; v < variants.len(); v++) {
            for (i32 f = 0; f < variants[v].fields.len(); f++) {
              holds = holds + tyNamesJoined(src, lx, variants[v].fields[f].type);
            }
          }
          for (i32 m = 0; m < methods.len(); m++) {
            holds = holds + tyNamesJoined(src, lx, methods[m].returnType);
          }
        }
        default: { }
      }
      if (isType) {
        if (tyCount >= maxTy) { overflowed = true; } else {
          tyName[tyCount] = declName;
          tyHolds[tyCount] = holds;
          bearing[tyCount] = isBearingRoot(declName);
          tyCount = tyCount + 1;
        }
      }
      seen = seen + mentionedIn(src, lx, prog, d);
    }
    mentions[i] = seen;
  }

  // To a fixpoint over the whole graph, not one file: a holder and the type it holds are routinely in
  // different packages, which is the case a per-file closure would miss.
  bool grew = true;
  while (grew) {
    grew = false;
    for (i32 t = 0; t < tyCount; t++) {
      if (bearing[t]) { continue; }
      if (holdsBearing(tyHolds[t], tyName, bearing, tyCount)) {
        bearing[t] = true;
        heldVia[t] = firstBearing(tyHolds[t], tyName, bearing, tyCount);
        grew = true;
      }
    }
  }

  string out = "";
  i32 reaches = 0;
  for (i32 i = 0; i < n; i++) {
    if (paths[i] == "") { continue; }
    string via = firstBearing(mentions[i], tyName, bearing, tyCount);
    if (via == "") {
      out = out + paths[i] + "\tsealed\t\n";
    } else {
      out = out + paths[i] + "\treaches\t" + via + "\t" + bearingRoot(via, tyName, heldVia, tyCount) + "\n";
      reaches = reaches + 1;
    }
  }
  // The denominator, always, and the bound when one was hit. `issues/system/0268a` is what a
  // measurement that does not say how much it looked at costs.
  out = out + "#\t" + numText(reaches) + " of " + numText(n) + " file(s) reach a capability; "
      + numText(tyCount) + " type(s) examined"
      + (overflowed ? "; TRUNCATED at " + numText(maxTy) + " types — this answer is not to be trusted"
                    : "") + "\n";
  return out;
}

/** `tyNames`, tab-delimited and tab-terminated, so a search cannot match a prefix. */
string tyNamesJoined(u8[] src, Lexed lx, Ty t) {
  string[] found = string[].filled(64, "");
  i32[] seen = i32[].filled(1, 0);
  tyNames(src, lx, t, found, seen);
  string out = "";
  for (i32 i = 0; i < seen[0]; i++) { out = out + found[i] + "\t"; }
  return out;
}

/** Every named type declaration `d` mentions in a field, parameter or return. */
string mentionedIn(u8[] src, Lexed lx, Program prog, i32 d) {
  string out = "";
  match (prog.decls[d].kind) {
    StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
      for (i32 f = 0; f < fields.len(); f++) { out = out + tyNamesJoined(src, lx, fields[f].type); }
      for (i32 m = 0; m < methods.len(); m++) {
        out = out + tyNamesJoined(src, lx, methods[m].returnType);
        for (i32 p = 0; p < methods[m].params.len(); p++) {
          out = out + tyNamesJoined(src, lx, methods[m].params[p].type);
        }
      }
    }
    EnumDecl(nameTok, variants, exported, methods, typeParams): {
      for (i32 v = 0; v < variants.len(); v++) {
        for (i32 f = 0; f < variants[v].fields.len(); f++) {
          out = out + tyNamesJoined(src, lx, variants[v].fields[f].type);
        }
      }
      for (i32 m = 0; m < methods.len(); m++) {
        out = out + tyNamesJoined(src, lx, methods[m].returnType);
        for (i32 p = 0; p < methods[m].params.len(); p++) {
          out = out + tyNamesJoined(src, lx, methods[m].params[p].type);
        }
      }
    }
    Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
      out = out + tyNamesJoined(src, lx, returnType);
      for (i32 p = 0; p < params.len(); p++) { out = out + tyNamesJoined(src, lx, params[p].type); }
    }
    default: { }
  }
  return out;
}

/** Whether any name in a tab-delimited list is a bearing type. */
bool holdsBearing(string held, string[] tyName, bool[] bearing, i32 tyCount) {
  if (firstRoot(held) != "") { return true; }
  for (i32 t = 0; t < tyCount; t++) {
    if (!bearing[t]) { continue; }
    if (listMentions(held, tyName[t])) { return true; }
  }
  return false;
}

/** The first bearing type a tab-delimited list names, or "". */
string firstBearing(string held, string[] tyName, bool[] bearing, i32 tyCount) {
  string rooted = firstRoot(held);
  if (rooted != "") { return rooted; }
  for (i32 t = 0; t < tyCount; t++) {
    if (!bearing[t]) { continue; }
    if (listMentions(held, tyName[t])) { return tyName[t]; }
  }
  return "";
}

/** The types a host reaches through directly — what every other bearing type holds, in the end. */
bool isBearingRoot(string name) {
  return name == "Sys" || name == "Cli" || name == "Core" || name == "Listener" || name == "Socket"
      || name == "Child" || name == "HostSocket" || name == "HostChild";
}

/** The first root bearing type a tab-delimited list names, `Sys` first, or "". */
string firstRoot(string held) {
  if (listMentions(held, "Sys")) { return "Sys"; }
  if (listMentions(held, "Cli")) { return "Cli"; }
  if (listMentions(held, "Core")) { return "Core"; }
  if (listMentions(held, "Listener")) { return "Listener"; }
  if (listMentions(held, "Socket")) { return "Socket"; }
  if (listMentions(held, "Child")) { return "Child"; }
  if (listMentions(held, "HostSocket")) { return "HostSocket"; }
  if (listMentions(held, "HostChild")) { return "HostChild"; }
  return "";
}

/** The root a bearing type reaches the host through: itself for a root, else along what it holds. */
string bearingRoot(string name, string[] tyName, string[] heldVia, i32 tyCount) {
  string at = name;
  for (i32 hop = 0; hop < 64 && at != ""; hop++) {
    if (isBearingRoot(at)) { return at; }
    string next = "";
    for (i32 t = 0; t < tyCount; t++) { if (tyName[t] == at) { next = heldVia[t]; } }
    at = next;
  }
  return at;
}

/**
 * Whether a tab-delimited, tab-terminated list holds `name` as a whole entry.
 *
 * Whole entry and not a substring: `Cli` appears inside `ClientState`, and a scan that matched it
 * would report most of `packages/tls` as reaching the host.
 */
bool listMentions(string list, string name) {
  if (name == "") { return false; }
  return list.indexOf("\t" + name + "\t") >= 0;
}
