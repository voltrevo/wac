// The functions and types nothing reaches, taken out of a finished module — `issues/lang/0398a`.
//
// Reachability keeps a struct whole so that all of it is *checked* (spec ch05 `§wac-reach-struct-whole-3wx2wun`),
// and the same chapter says the output need not carry what nothing uses: "retention requires checking; it does not
// require dead code in the output." The emitter compiles every retained declaration and registers every type it
// meets, so the module it wrote held every method of every struct a program touched and a type for each of them.
// `main(Sys sys) { sys.log("hi"); }` was 6,219 functions and 6,637 types, of which 58 functions can run.
//
// **Over the module, not the declarations** (operator, 2026-10-24): pruning methods in `reach.wac` would weaken what a
// build checks to get a size the emitter can get exactly. So this reads the finished bytes, walks `call`,
// `return_call` and `ref.func` from the roots, then every type what is left names, and writes the module again
// with only those, every function and type index renumbered.
//
// **Function roots** are what something outside a function body can name: the exports, the start function, every
// function an active or passive element segment holds (`call_indirect`'s table), and every `ref.func` in a global's
// initialiser. A declarative segment only declares what `ref.func` may name, so it is not a root; it is renumbered
// and loses what was dropped. **Type roots** are every type a kept function, import, global, table, tag or segment
// names, and a kept type keeps every type it names in turn.
//
// **It declines rather than guesses.** An instruction it does not know the immediates of — SIMD, or one added to the
// emitter after this was written — makes it answer the module unchanged, since a mis-read immediate would read the
// rest of the body wrong. `packages/wacc/test/wac/deadcode_test.wac` fails loudly if that ever becomes the answer.
//
// Written in the ladder's subset (`bootstrap/`): no `Map`, `Vec` or lambdas, no interpolation, no array literals.

/** A growable list of `i32`, since the ladder's subset has no `Vec`. */
struct Ints {
  i32[] v;
  i32 n;

  Ints create() { return Ints(i32[].filled(16, 0), 0); }

  void push(this, i32 x) {
    if (this.n == this.v.len()) {
      i32[] g = i32[].filled(this.v.len() * 2, 0);
      for (i32 i = 0; i < this.n; i++) { g[i] = this.v[i]; }
      this.v = g;
    }
    this.v[this.n] = x;
    this.n = this.n + 1;
  }
}

/** A growable byte buffer. */
struct ShakeOut {
  u8[] d;
  i32 n;

  ShakeOut create() { return ShakeOut(u8[].filled(256, 0), 0); }

  void byte(this, i32 x) {
    if (this.n == this.d.len()) {
      u8[] g = u8[].filled(this.d.len() * 2, 0);
      for (i32 i = 0; i < this.n; i++) { g[i] = this.d[i]; }
      this.d = g;
    }
    this.d[this.n] = x as~ u8;
    this.n = this.n + 1;
  }

  void u32(this, i32 v) {
    i32 x = v;
    while (true) {
      i32 lo = x & 127;
      x = x >>> 7;
      if (x == 0) { this.byte(lo); return; }
      this.byte(lo | 128);
    }
  }

  /** A signed LEB128 — how a block type or a heap type writes a type index. */
  void s33(this, i32 v) {
    i32 x = v;
    while (true) {
      i32 lo = x & 127;
      x = x >> 7;
      bool done = (x == 0 && (lo & 64) == 0) || (x == 0 - 1 && (lo & 64) != 0);
      if (done) { this.byte(lo); return; }
      this.byte(lo | 128);
    }
  }

  void range(this, u8[] src, i32 from, i32 to) {
    for (i32 i = from; i < to; i++) { this.byte(src[i] as i32); }
  }

  void all(this, ShakeOut o) {
    for (i32 i = 0; i < o.n; i++) { this.byte(o.d[i] as i32); }
  }

  /** A section: its id, its length, its bytes. */
  void section(this, i32 id, ShakeOut body) {
    this.byte(id);
    this.u32(body.n);
    this.all(body);
  }
}

/**
 * A cursor over a module's bytes that may also write what it reads. Every function and type index it passes is
 * noted in `fns` and `tys`; when `writing`, everything read is copied to `o`, with each index renumbered through
 * `fnMap` and `tyMap`. `bad` is set, never cleared, by anything it cannot read or renumber.
 */
struct Rw {
  u8[] b;
  i32 at;
  bool bad;
  bool writing;
  ShakeOut o;
  i32[] fnMap;
  i32[] tyMap;
  Ints fns;
  Ints tys;

  Rw reading(u8[] b, i32 at) {
    return Rw(b, at, false, false, ShakeOut.create(), i32[].filled(0, 0), i32[].filled(0, 0), Ints.create(), Ints.create());
  }

  Rw writingTo(u8[] b, i32 at, ShakeOut o, i32[] fnMap, i32[] tyMap) {
    return Rw(b, at, false, true, o, fnMap, tyMap, Ints.create(), Ints.create());
  }

  /** A byte, not copied. */
  i32 peek(this) {
    if (this.at >= this.b.len()) { this.bad = true; return 0; }
    return this.b[this.at] as i32;
  }

  /** A byte, copied. */
  i32 byte(this) {
    i32 v = this.peek();
    if (this.bad) { return 0; }
    this.at = this.at + 1;
    if (this.writing) { this.o.byte(v); }
    return v;
  }

  /** An unsigned LEB128, not copied. */
  i32 readU32(this) {
    i32 r = 0;
    i32 shift = 0;
    while (true) {
      i32 x = this.peek();
      if (this.bad) { return 0; }
      this.at = this.at + 1;
      if (shift < 32) { r = r | ((x & 127) << shift); }
      if ((x & 128) == 0) { return r; }
      shift = shift + 7;
      if (shift > 63) { this.bad = true; return 0; }
    }
    return r;
  }

  /** A signed LEB128 of up to 33 bits, not copied — sign-extended into an `i32`. */
  i32 readS33(this) {
    i32 r = 0;
    i32 shift = 0;
    while (true) {
      i32 x = this.peek();
      if (this.bad) { return 0; }
      this.at = this.at + 1;
      if (shift < 32) { r = r | ((x & 127) << shift); }
      shift = shift + 7;
      if ((x & 128) == 0) {
        if (shift < 32 && (x & 64) != 0) { r = r | ((0 - 1) << shift); }
        return r;
      }
      if (shift > 35) { this.bad = true; return 0; }
    }
    return r;
  }

  /** An unsigned LEB128 whose value is not an index: copied as written, and answered. */
  i32 u32(this) {
    i32 from = this.at;
    i32 v = this.readU32();
    if (this.writing && !this.bad) { this.o.range(this.b, from, this.at); }
    return v;
  }

  /** Any LEB128 whose value is not needed, copied as written. */
  void leb(this) {
    i32 from = this.at;
    for (i32 i = 0; i < 10; i++) {
      i32 x = this.peek();
      if (this.bad) { return; }
      this.at = this.at + 1;
      if ((x & 128) == 0) {
        if (this.writing) { this.o.range(this.b, from, this.at); }
        return;
      }
    }
    this.bad = true;
  }

  void bytes(this, i32 n) {
    if (n < 0 || this.at + n > this.b.len()) { this.bad = true; return; }
    if (this.writing) { this.o.range(this.b, this.at, this.at + n); }
    this.at = this.at + n;
  }

  /** A name: its length and its bytes. */
  void name(this) { this.bytes(this.u32()); }

  /** A function index. */
  void fnIdx(this) {
    i32 v = this.readU32();
    if (this.bad) { return; }
    this.fns.push(v);
    if (!this.writing) { return; }
    if (v >= this.fnMap.len() || this.fnMap[v] < 0) { this.bad = true; return; }
    this.o.u32(this.fnMap[v]);
  }

  /** A type index written as a `u32`. */
  void tyIdx(this) {
    i32 v = this.readU32();
    if (this.bad) { return; }
    this.tys.push(v);
    if (!this.writing) { return; }
    if (v >= this.tyMap.len() || this.tyMap[v] < 0) { this.bad = true; return; }
    this.o.u32(this.tyMap[v]);
  }

  /** A heap type, or a block type: an s33 that is a type index when it is not negative. */
  void s33Type(this) {
    i32 from = this.at;
    i32 v = this.readS33();
    if (this.bad) { return; }
    if (v < 0) {
      if (this.writing) { this.o.range(this.b, from, this.at); }
      return;
    }
    this.tys.push(v);
    if (!this.writing) { return; }
    if (v >= this.tyMap.len() || this.tyMap[v] < 0) { this.bad = true; return; }
    this.o.s33(this.tyMap[v]);
  }

  /** A value type: one byte, or `ref null`/`ref` (0x63, 0x64) and a heap type. */
  void valType(this) {
    i32 t = this.byte();
    if (t == 99 || t == 100) { this.s33Type(); }
  }

  /** A block type: a value type's reference form, or an s33. */
  void blockType(this) {
    i32 t = this.peek();
    if (t == 99 || t == 100) { this.valType(); return; }
    this.s33Type();
  }

  /** A table's limits, or a memory's. */
  void limits(this) {
    i32 flags = this.byte();
    this.leb();
    if ((flags & 1) != 0) { this.leb(); }
  }
}

/**
 * One instruction sequence, up to and including the `end` that closes it. Answers false at an instruction whose
 * immediates it does not know.
 */
bool walk(Rw r) {
  i32 depth = 0;
  while (!r.bad) {
    i32 op = r.byte();
    if (op == 11) {                                  // end
      if (depth == 0) { return !r.bad; }
      depth = depth - 1;
    } else if (op == 2 || op == 3 || op == 4 || op == 6) {   // block, loop, if, try
      r.blockType();
      depth = depth + 1;
    } else if (op == 31) {                           // try_table
      r.blockType();
      i32 n = r.u32();
      for (i32 i = 0; i < n; i++) {
        i32 kind = r.byte();
        if (kind == 0 || kind == 1) { r.leb(); }
        r.leb();
      }
      depth = depth + 1;
    } else if (op == 0 || op == 1 || op == 5 || op == 10 || op == 15 || op == 25 || op == 26 || op == 27) {
      // unreachable, nop, else, throw_ref, return, catch_all, drop, select
    } else if (op == 7 || op == 8 || op == 9 || op == 12 || op == 13) {
      r.leb();                                        // catch, throw, rethrow, br, br_if
    } else if (op == 24) {                            // delegate, which closes its try as `end` would
      r.leb();
      if (depth == 0) { return false; }
      depth = depth - 1;
    } else if (op == 14) {                            // br_table
      i32 n = r.u32();
      for (i32 i = 0; i <= n; i++) { r.leb(); }
    } else if (op == 16 || op == 18 || op == 210) {   // call, return_call, ref.func
      r.fnIdx();
    } else if (op == 17 || op == 19) {                // call_indirect, return_call_indirect
      r.tyIdx();
      r.leb();
    } else if (op == 20 || op == 21) {                // call_ref, return_call_ref
      r.tyIdx();
    } else if (op == 28) {                            // select t*
      i32 n = r.u32();
      for (i32 i = 0; i < n; i++) { r.valType(); }
    } else if (op >= 32 && op <= 38) {                // local.*, global.*, table.get/set
      r.leb();
    } else if (op >= 40 && op <= 62) {                // loads and stores: a memarg
      i32 align = r.u32();
      if ((align & 64) != 0) { r.leb(); }
      r.leb();
    } else if (op == 63 || op == 64 || op == 65 || op == 66) {   // memory.size/grow, i32/i64.const
      r.leb();
    } else if (op == 67) {                            // f32.const
      r.bytes(4);
    } else if (op == 68) {                            // f64.const
      r.bytes(8);
    } else if (op >= 69 && op <= 196) {               // the numeric instructions
    } else if (op == 208) {                           // ref.null
      r.s33Type();
    } else if (op == 209 || op == 211 || op == 212) { // ref.is_null, ref.eq, ref.as_non_null
    } else if (op == 213 || op == 214) {              // br_on_null, br_on_non_null
      r.leb();
    } else if (op == 251) {                           // the GC instructions
      i32 sub = r.u32();
      if (sub == 0 || sub == 1 || sub == 6 || sub == 7 || sub == 11 || sub == 12 || sub == 13 || sub == 14
          || sub == 16) {
        r.tyIdx();                                    // struct.new(_default), array.new(_default), array.get/set/fill
      } else if (sub == 2 || sub == 3 || sub == 4 || sub == 5 || sub == 8 || sub == 9 || sub == 10 || sub == 18
                 || sub == 19) {
        r.tyIdx();                                    // a type, then a field, a count, or a segment
        r.leb();
      } else if (sub == 17) {                         // array.copy
        r.tyIdx();
        r.tyIdx();
      } else if (sub == 15 || (sub >= 26 && sub <= 30)) {
      } else if (sub >= 20 && sub <= 23) {            // ref.test, ref.cast
        r.s33Type();
      } else if (sub == 24 || sub == 25) {            // br_on_cast, br_on_cast_fail
        r.byte();
        r.leb();
        r.s33Type();
        r.s33Type();
      } else {
        return false;
      }
    } else if (op == 252) {                           // saturating truncation, bulk memory, tables
      i32 sub = r.u32();
      if (sub <= 7) {
      } else if (sub == 8 || sub == 10 || sub == 12 || sub == 14) {
        r.leb();
        r.leb();
      } else if (sub == 9 || sub == 11 || sub == 13 || sub == 15 || sub == 16 || sub == 17) {
        r.leb();
      } else {
        return false;
      }
    } else {
      return false;
    }
  }
  return false;
}

/** A struct's or an array's field: a packed type (0x78, 0x77) or a value type, then whether it is mutable. */
void shakeFieldType(Rw r) {
  i32 t = r.peek();
  if (t == 120 || t == 119) { r.byte(); } else { r.valType(); }
  r.byte();
}

/** One subtype: its supertypes and its composite type. */
bool subType(Rw r) {
  i32 t = r.peek();
  if (t == 80 || t == 79) {                         // sub, sub final
    r.byte();
    i32 n = r.u32();
    for (i32 i = 0; i < n; i++) { r.tyIdx(); }
  }
  i32 kind = r.byte();
  if (kind == 94) {                                 // array
    shakeFieldType(r);
  } else if (kind == 95) {                          // struct
    i32 n = r.u32();
    for (i32 i = 0; i < n; i++) { shakeFieldType(r); }
  } else if (kind == 96) {                          // func
    i32 np = r.u32();
    for (i32 i = 0; i < np; i++) { r.valType(); }
    i32 nr = r.u32();
    for (i32 i = 0; i < nr; i++) { r.valType(); }
  } else {
    return false;
  }
  return !r.bad;
}

/** An import's description after its two names. */
bool importDesc(Rw r) {
  i32 kind = r.byte();
  if (kind == 0) { r.tyIdx(); }
  else if (kind == 1) { r.valType(); r.limits(); }
  else if (kind == 2) { r.limits(); }
  else if (kind == 3) { r.valType(); r.byte(); }
  else if (kind == 4) { r.byte(); r.tyIdx(); }
  else { return false; }
  return !r.bad;
}

/** One element segment, from its flags. Its function indices go to `r.fns`. */
bool elemSegment(Rw r) {
  i32 flags = r.u32();
  if (flags == 2 || flags == 6) { r.leb(); }                                       // a table index
  if (flags == 0 || flags == 2 || flags == 4 || flags == 6) {                      // an offset expression
    if (!walk(r)) { return false; }
  }
  if (flags == 1 || flags == 2 || flags == 3) { r.byte(); }                        // elemkind
  if (flags == 5 || flags == 6 || flags == 7) { r.valType(); }                     // reftype
  i32 n = r.u32();
  for (i32 i = 0; i < n && !r.bad; i++) {
    if (flags <= 3) { r.fnIdx(); } else if (!walk(r)) { return false; }
  }
  return !r.bad && flags <= 7;
}

/** A section as it was read: where its contents start and end. */
struct Sec {
  i32 id;
  i32 from;
  i32 to;
}

/** Whether the custom section starting at `from` is the `name` section. */
bool isNameSection(u8[] wasm, i32 from) {
  Rw q = Rw.reading(wasm, from);
  i32 n = q.readU32();
  if (q.bad || n != 4 || q.at + 4 > wasm.len()) { return false; }
  return wasm[q.at] == 'n' && wasm[q.at + 1] == 'a' && wasm[q.at + 2] == 'm' && wasm[q.at + 3] == 'e';
}

/** `i` through `map`, or -1 for one outside it. */
i32 mapped(i32[] map, i32 i) { return i >= 0 && i < map.len() ? map[i] : 0 - 1; }

/** `wasm` with every function and type nothing reaches taken out, or `wasm` itself if anything could not be read. */
export u8[] shake(u8[] wasm) {
  if (wasm.len() < 8) { return wasm; }
  Rw r = Rw.reading(wasm, 8);
  Sec[] secs = Sec[].filled(64, Sec(0, 0, 0));
  i32 ns = 0;
  while (r.at < wasm.len() && !r.bad) {
    i32 id = r.readU32();
    i32 size = r.readU32();
    if (r.bad || r.at + size > wasm.len() || ns >= secs.len()) { return wasm; }
    secs[ns] = Sec(id, r.at, r.at + size);
    ns = ns + 1;
    r.at = r.at + size;
  }
  if (r.bad) { return wasm; }

  i32 imported = 0;
  i32 defined = 0;
  i32 typeCount = 0;
  i32 codeSec = 0 - 1;
  i32 typeSec = 0 - 1;
  for (i32 s = 0; s < ns; s++) {
    Rw q = Rw.reading(wasm, secs[s].from);
    if (secs[s].id == 2) {
      i32 n = q.u32();
      for (i32 i = 0; i < n && !q.bad; i++) {
        q.name();
        q.name();
        if (q.peek() == 0) { imported = imported + 1; }
        if (!importDesc(q)) { return wasm; }
      }
    }
    if (secs[s].id == 3) { defined = q.u32(); }
    if (secs[s].id == 10) { codeSec = s; }
    if (secs[s].id == 1) { typeSec = s; }
  }
  if (codeSec < 0 || defined == 0) { return wasm; }
  i32 total = imported + defined;

  // Every type's extent, and the types it names.
  Ints tyFrom = Ints.create();
  Ints tyTo = Ints.create();
  Ints tyEdgeFrom = Ints.create();
  Ints tyEdges = Ints.create();
  Ints groupSize = Ints.create();
  Ints groupRec = Ints.create();
  if (typeSec >= 0) {
    Rw q = Rw.reading(wasm, secs[typeSec].from);
    i32 entries = q.u32();
    for (i32 e = 0; e < entries && !q.bad; e++) {
      i32 m = 1;
      bool rec = q.peek() == 78;
      if (rec) { q.byte(); m = q.u32(); }
      groupSize.push(m);
      groupRec.push(rec ? 1 : 0);
      for (i32 k = 0; k < m && !q.bad; k++) {
        tyFrom.push(q.at);
        tyEdgeFrom.push(q.tys.n);
        if (!subType(q)) { return wasm; }
        tyTo.push(q.at);
      }
    }
    if (q.bad || q.at != secs[typeSec].to) { return wasm; }
    tyEdgeFrom.push(q.tys.n);
    tyEdges = q.tys;
    typeCount = tyFrom.n;
  }

  // Each body's extent, and the functions and types it names.
  i32[] bodyFrom = i32[].filled(defined, 0);
  i32[] bodyTo = i32[].filled(defined, 0);
  i32[] fnEdgeFrom = i32[].filled(defined + 1, 0);
  i32[] tyRefFrom = i32[].filled(defined + 1, 0);
  Rw c = Rw.reading(wasm, secs[codeSec].from);
  if (c.u32() != defined) { return wasm; }
  for (i32 f = 0; f < defined; f++) {
    i32 size = c.u32();
    bodyFrom[f] = c.at;
    bodyTo[f] = c.at + size;
    fnEdgeFrom[f] = c.fns.n;
    tyRefFrom[f] = c.tys.n;
    i32 groups = c.u32();
    for (i32 g = 0; g < groups; g++) { c.leb(); c.valType(); }
    if (c.bad || !walk(c) || c.at != bodyTo[f]) { return wasm; }
  }
  fnEdgeFrom[defined] = c.fns.n;
  tyRefFrom[defined] = c.tys.n;

  // The function roots, and the types named outside any function.
  bool[] live = bool[].filled(total, false);
  for (i32 i = 0; i < imported; i++) { live[i] = true; }
  Ints work = Ints.create();
  Ints tyWork = Ints.create();
  i32[] fnTypes = i32[].filled(defined, 0);
  for (i32 s = 0; s < ns; s++) {
    Rw q = Rw.reading(wasm, secs[s].from);
    i32 id = secs[s].id;
    if (id == 2) {
      i32 n = q.u32();
      for (i32 i = 0; i < n && !q.bad; i++) { q.name(); q.name(); importDesc(q); }
    } else if (id == 3) {
      i32 n = q.u32();
      for (i32 i = 0; i < n && !q.bad; i++) { fnTypes[i] = q.readU32(); }
    } else if (id == 4) {
      i32 n = q.u32();
      for (i32 i = 0; i < n && !q.bad; i++) {
        bool init = q.peek() == 64;
        if (init) { q.byte(); q.byte(); }
        q.valType();
        q.limits();
        if (init && !walk(q)) { return wasm; }
      }
      for (i32 k = 0; k < q.fns.n; k++) { work.push(q.fns.v[k]); }
    } else if (id == 6) {
      i32 n = q.u32();
      for (i32 i = 0; i < n && !q.bad; i++) {
        q.valType();
        q.byte();
        if (!walk(q)) { return wasm; }
      }
      for (i32 k = 0; k < q.fns.n; k++) { work.push(q.fns.v[k]); }
    } else if (id == 7) {
      i32 n = q.u32();
      for (i32 i = 0; i < n && !q.bad; i++) {
        q.name();
        i32 kind = q.byte();
        i32 idx = q.u32();
        if (kind == 0) { work.push(idx); }
      }
    } else if (id == 8) {
      work.push(q.u32());
    } else if (id == 9) {
      i32 n = q.u32();
      for (i32 i = 0; i < n && !q.bad; i++) {
        i32 flags = q.peek();
        i32 before = q.fns.n;
        if (!elemSegment(q)) { return wasm; }
        // A declarative segment (3 and 7) only says what `ref.func` may name.
        if (flags != 3 && flags != 7) {
          for (i32 k = before; k < q.fns.n; k++) { work.push(q.fns.v[k]); }
        }
      }
    } else if (id == 13) {
      i32 n = q.u32();
      for (i32 i = 0; i < n && !q.bad; i++) { q.byte(); q.tyIdx(); }
    }
    if (q.bad) { return wasm; }
    if (id != 3) {
      for (i32 k = 0; k < q.tys.n; k++) { tyWork.push(q.tys.v[k]); }
    }
  }

  // Every function they reach.
  i32 head = 0;
  while (head < work.n) {
    i32 at = work.v[head];
    head = head + 1;
    if (at < 0 || at >= total) { return wasm; }
    if (live[at]) { continue; }
    live[at] = true;
    i32 d = at - imported;
    for (i32 e = fnEdgeFrom[d]; e < fnEdgeFrom[d + 1]; e++) { work.push(c.fns.v[e]); }
  }

  // Every type a kept function names, and every type those name.
  for (i32 f = 0; f < defined; f++) {
    if (!live[imported + f]) { continue; }
    tyWork.push(fnTypes[f]);
    for (i32 e = tyRefFrom[f]; e < tyRefFrom[f + 1]; e++) { tyWork.push(c.tys.v[e]); }
  }
  bool[] tyLive = bool[].filled(typeCount, false);
  head = 0;
  while (head < tyWork.n) {
    i32 t = tyWork.v[head];
    head = head + 1;
    if (t < 0 || t >= typeCount) { return wasm; }
    if (tyLive[t]) { continue; }
    tyLive[t] = true;
    for (i32 e = tyEdgeFrom.v[t]; e < tyEdgeFrom.v[t + 1]; e++) { tyWork.push(tyEdges.v[e]); }
  }

  // The new numbering: imports keep theirs, the rest close up.
  i32[] fnMap = i32[].filled(total, 0 - 1);
  i32 kept = 0;
  for (i32 i = 0; i < total; i++) { if (live[i]) { fnMap[i] = kept; kept = kept + 1; } }
  i32[] tyMap = i32[].filled(typeCount, 0 - 1);
  i32 keptTypes = 0;
  for (i32 i = 0; i < typeCount; i++) { if (tyLive[i]) { tyMap[i] = keptTypes; keptTypes = keptTypes + 1; } }
  if (kept == total && keptTypes == typeCount) { return wasm; }

  ShakeOut out = ShakeOut.create();
  out.range(wasm, 0, 8);
  for (i32 s = 0; s < ns; s++) {
    i32 id = secs[s].id;
    ShakeOut body = ShakeOut.create();
    Rw q = Rw.writingTo(wasm, secs[s].from, body, fnMap, tyMap);
    if (id == 1) {
      // The groups that still hold a type, each with only the types it keeps.
      i32 groups = 0;
      i32 t = 0;
      for (i32 g = 0; g < groupSize.n; g++) {
        bool any = false;
        for (i32 k = 0; k < groupSize.v[g]; k++) { if (tyLive[t + k]) { any = true; } }
        if (any) { groups = groups + 1; }
        t = t + groupSize.v[g];
      }
      body.u32(groups);
      t = 0;
      for (i32 g = 0; g < groupSize.n; g++) {
        i32 m = 0;
        for (i32 k = 0; k < groupSize.v[g]; k++) { if (tyLive[t + k]) { m = m + 1; } }
        if (m > 0) {
          if (groupRec.v[g] == 1) { body.byte(78); body.u32(m); }
          for (i32 k = 0; k < groupSize.v[g]; k++) {
            if (!tyLive[t + k]) { continue; }
            Rw w = Rw.writingTo(wasm, tyFrom.v[t + k], body, fnMap, tyMap);
            if (!subType(w) || w.at != tyTo.v[t + k]) { return wasm; }
          }
        }
        t = t + groupSize.v[g];
      }
    } else if (id == 2) {
      i32 n = q.u32();
      for (i32 i = 0; i < n && !q.bad; i++) { q.name(); q.name(); importDesc(q); }
    } else if (id == 3) {
      q.readU32();
      body.u32(kept - imported);
      for (i32 f = 0; f < defined; f++) {
        i32 ty = q.readU32();
        if (live[imported + f]) { body.u32(mapped(tyMap, ty)); }
      }
    } else if (id == 4) {
      i32 n = q.u32();
      for (i32 i = 0; i < n && !q.bad; i++) {
        bool init = q.peek() == 64;
        if (init) { q.byte(); q.byte(); }
        q.valType();
        q.limits();
        if (init && !walk(q)) { return wasm; }
      }
    } else if (id == 6) {
      i32 n = q.u32();
      for (i32 i = 0; i < n && !q.bad; i++) {
        q.valType();
        q.byte();
        if (!walk(q)) { return wasm; }
      }
    } else if (id == 7) {
      i32 n = q.u32();
      for (i32 i = 0; i < n && !q.bad; i++) {
        q.name();
        i32 kind = q.byte();
        if (kind == 0) { q.fnIdx(); } else { q.leb(); }
      }
    } else if (id == 8) {
      q.fnIdx();
    } else if (id == 9) {
      i32 n = q.u32();
      for (i32 i = 0; i < n && !q.bad; i++) {
        if (q.peek() != 3) {
          if (!elemSegment(q)) { return wasm; }
          continue;
        }
        // A declarative segment of indices keeps the functions that are still there; it never held a root.
        q.u32();
        q.byte();
        i32 m = q.readU32();
        i32[] idx = i32[].filled(m, 0);
        i32 keep = 0;
        for (i32 k = 0; k < m && !q.bad; k++) {
          idx[k] = q.readU32();
          if (mapped(fnMap, idx[k]) >= 0) { keep = keep + 1; }
        }
        body.u32(keep);
        for (i32 k = 0; k < m; k++) { if (mapped(fnMap, idx[k]) >= 0) { body.u32(fnMap[idx[k]]); } }
      }
    } else if (id == 10) {
      body.u32(kept - imported);
      for (i32 f = 0; f < defined; f++) {
        if (!live[imported + f]) { continue; }
        ShakeOut fb = ShakeOut.create();
        Rw w = Rw.writingTo(wasm, bodyFrom[f], fb, fnMap, tyMap);
        i32 groups = w.u32();
        for (i32 g = 0; g < groups; g++) { w.leb(); w.valType(); }
        if (!walk(w) || w.at != bodyTo[f]) { return wasm; }
        body.u32(fb.n);
        body.all(fb);
      }
    } else if (id == 13) {
      i32 n = q.u32();
      for (i32 i = 0; i < n && !q.bad; i++) { q.byte(); q.tyIdx(); }
    } else if (id == 0 && isNameSection(wasm, secs[s].from)) {
      if (!shakeNames(wasm, secs[s].from, secs[s].to, fnMap, tyMap, body)) { return wasm; }
    } else {
      body.range(wasm, secs[s].from, secs[s].to);
    }
    if (q.bad) { return wasm; }
    out.section(id, body);
  }
  u8[] result = u8[].filled(out.n, 0);
  for (i32 i = 0; i < out.n; i++) { result[i] = out.d[i]; }
  return result;
}

/**
 * The `name` section, renumbered. Subsections 1 to 3 are keyed by function — names, locals, labels — and 4 and 10 by
 * type — type names, field names; each loses the entries that were dropped. The rest are copied.
 */
bool shakeNames(u8[] wasm, i32 from, i32 to, i32[] fnMap, i32[] tyMap, ShakeOut o) {
  Rw q = Rw.reading(wasm, from);
  q.name();
  o.range(wasm, from, q.at);
  while (q.at < to && !q.bad) {
    i32 sub = q.readU32();
    i32 size = q.readU32();
    i32 end = q.at + size;
    bool byFn = sub == 1 || sub == 2 || sub == 3;
    bool byTy = sub == 4 || sub == 10;
    if (!byFn && !byTy) {
      o.byte(sub);
      o.u32(size);
      o.range(wasm, q.at, end);
      q.at = end;
      continue;
    }
    i32[] map = byFn ? fnMap : tyMap;
    i32 n = q.readU32();
    ShakeOut entries = ShakeOut.create();
    i32 keep = 0;
    for (i32 i = 0; i < n && !q.bad; i++) {
      i32 which = q.readU32();
      i32 at = q.at;
      if (sub == 1 || sub == 4) {
        q.name();
      } else {
        i32 inner = q.readU32();
        for (i32 k = 0; k < inner && !q.bad; k++) { q.readU32(); q.name(); }
      }
      if (mapped(map, which) >= 0) {
        entries.u32(mapped(map, which));
        entries.range(wasm, at, q.at);
        keep = keep + 1;
      }
    }
    if (q.bad || q.at != end) { return false; }
    ShakeOut s = ShakeOut.create();
    s.u32(keep);
    s.all(entries);
    o.byte(sub);
    o.u32(s.n);
    o.all(s);
  }
  return !q.bad;
}
