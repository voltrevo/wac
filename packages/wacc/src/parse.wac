// The wac parser, in wac. Port of compiler/wacParse.ts.
//
// Recursive descent over the token array the lexer produces, building the sum-type
// AST in ast.wac. Structured as a `P` struct threaded through every function, since this package
// cannot use closures to capture the position the way the reference does — the ladder's top rung
// builds it and the rung below has no lambdas. The *language* has had them since 2026-08-16; see
// `lex.wac`'s `Lexer` for the same note.
//
// The reference takes positions at very specific points — a binary node's position is
// its *operator*, a ternary's is the `?`, not the start of the condition — and this
// mirrors that exactly, because the differential test compares them. Where a `pos()`
// call looks oddly placed here, it is placed where the reference places it.
//
// Scope so far: types, the whole expression precedence ladder, and lvalues.
// Statements and declarations are next; `parseExprEntry` is the tested entry point
// until then.

import { Ty, TyKind, tyPrim, tyNamed, tyArr, tyNullable, tyFuncref, tyTuple, TupleBinding,
  Expr, ExprKind, NamedArg, Lvalue, LvalueKind,
  Stmt, StmtKind, Case, Arm, JsxAttr, Pattern,
  Decl, DeclKind, Param, Field, Method, Variant, ImportItem, Program, jsxTrim } from "./ast.wac";
import { Lexed, tokenStride } from "./lex.wac";
import { kindName } from "./kinds.wac";
import {
  kInt, kFloat, kString, kIdent, kEof, kTrue, kFalse, kNull, kVoid, kFn, kThis,
  kIs, kNot, kAs, kAsBang, kAsTilde, kAsAt,
  kConst, kExport, kIf, kElse, kWhile, kFor, kDo, kSwitch, kCase, kDefault,
  kReturn, kBreak, kContinue, kTrap, kStruct, kEnum, kMatch, kAsync, kAwait, kStatic, kPrivate, kDefer, kMatches, kImport,
  kOverride, kAssign, kQuestionDot, kSymName,
  kPlusEq, kMinusEq, kStarEq, kSlashEq, kPercentEq,
  kAndEq, kOrEq, kCaretEq, kShlEq, kShrEq, kShrUEq,
  kPlus, kMinus, kStar, kSlash, kPercent, kEq, kNe,
  kLt, kLe, kGt, kGe, kAndAnd, kOrOr, kBang, kAnd, kOr, kCaret, kTilde,
  kShl, kShr, kShrU, kInc, kDec,
  kLparen, kRparen, kLbrace, kRbrace, kLbrack, kRbrack,
  kSemi, kColon, kComma, kDot, kQuestion, kJsxText, kFatArrow,
} from "./kinds.wac";

/** Parse errors, as (code, line, col) triples like the lexer's. */
export i32 perrExpected()    { return 20; }
export i32 perrBadType()     { return 21; }
export i32 perrBadPrimary()  { return 22; }
export i32 perrBadLvalue()   { return 23; }
export i32 perrTopLevel()    { return 24; }
export i32 perrFieldName()   { return 25; }
export i32 perrMethodName()  { return 26; }
export i32 perrCtorBrace()   { return 27; }
export i32 perrFnArray()     { return 28; }
/** `fn<R(P)>`, the spelling a function type had before it was `fn<R(P)>`. */
export i32 perrFnBracket()   { return 35; }
/** `Some(v):` in a match — the arm head is the pattern alone. */
export i32 perrCaseArm()     { return 36; }
/** `default:` in a match — the catch-all arm is `default:`. */
export i32 perrElseArm()     { return 37; }
/** A statement `match` arm whose body is not a block. */
export i32 perrArmBlock()    { return 38; }
/** `T[5]()` — a size in an array type's brackets. */
export i32 perrSizedArray()  { return 39; }
/** `T[](a, b)` — a typed constructor with elements, which is a literal now. */
export i32 perrArrayElems()  { return 40; }
/** `T[].other(…)` — an array type has two factories. */
export i32 perrArrayFactory() { return 41; }
/** `const i32 X = 1;` or `i32 X = 1;` at module scope — a module-level variable is `static`. */
export i32 perrModuleVar()   { return 42; }
/** `const i32 x;` — a const local is given its value where it is declared. */
export i32 perrConstNoInit() { return 43; }
export i32 perrBareSpec()    { return 29; }
/**
 * A keyword where a name belongs — `[§wac-keyword-name-8wnq4kp]`.
 *
 * Separate from `perrExpected` because the spec makes the wording part of the rule: *"an error that
 * names the keyword and points at it"*, and the section says why in as many words — `from` was once
 * reserved, and a parameter called `from` reported a missing semicolon a hundred lines further on.
 * A generic "unexpected token" is that same error with the useful half removed.
 */
export i32 perrKeywordName() { return 30; }

/** `override` on an enum method — `[§enum-methods-6vkq2wn]`, which states the message. */
export i32 perrEnumOverride() { return 31; }

/**
 * An enum method declared without `this` — `[§enum-methods-6vkq2wn]`.
 *
 * Its own code because `perrMethodName` was carrying both faults, and the one it names is the one
 * that did not happen: `i32 make() { … }` has a method name, in the right place, spelled correctly.
 * "expected a method name" pointed at `{` and sent the reader looking for a typo in `make`.
 */
export i32 perrEnumMethodThis() { return 32; }

/**
 * `a < b > c` — a type argument list this rule claimed, with a value sitting after it.
 *
 * Its own code for the reason `perrKeywordName` gives: *"a generic 'unexpected token' is that same
 * error with the useful half removed"*. Since `design/lang/0011` widened the trigger, `a < b` parses
 * as an instantiation of `a` wherever `b` parses as a type, and the author of a double comparison is
 * told about a semicolon they did not omit, a hundred columns from the `<` that decided it.
 *
 * Only raised where what follows **cannot** continue an expression — a name or a literal. `id<i32>;`
 * and `f(id<i32>)` are the same parse and are somebody naming a generic function, so they are handed
 * to the checker, which knows whether `id` is one. `issues/lang/0235a`, `design/lang/0011`.
 */
export i32 perrTypeArgsThenValue() { return 33; }

/**
 * An interpolated literal where a written-out string is required — `design/lang/0013` D7.
 *
 * Two positions want a *constant* string rather than an expression: a module path, resolved before
 * anything runs, and a JSX attribute, which already spells an expression `attr={e}`. Interpolation
 * lexes as `("a" + e + "b")`, so both met a `(` where they wanted a literal and said
 * `unexpected token … found '"'` — the caret on an opening quote that is genuinely there, naming
 * the byte the synthetic `(` spans. One mistake produced **six** diagnostics and none of them was
 * about interpolation.
 *
 * The headline names the rule, since the code is shared; the note names the position.
 */
export i32 perrInterpolatedHere() { return 34; }

export struct P {
  u8[] src;
  /**
   * **The lexer's output, not just its array**, because parsing consumes it: `splitGt` below
   * rewrites a `>>` into a `>` in place, so a second parse of the same tokens reads a different
   * program. Holding the `Lexed` is what lets `parseProgram` say so — see `Lexed.parsed`.
   */
  Lexed lx;
  i32 at;          // token index
  i32[] errors;    // (code, line, col) triples
  /**
   * The operands of each error, one per triple — `expected ';', found 'i32'`.
   *
   * The parser is where most diagnostics come from: of the 604 the spec's refused programs provoke,
   * 349 are its, and every one of them used to read *expected a different token here*. `expect`
   * knows both halves of that sentence and simply had nowhere to put them.
   */
  string[] errorNotes;
  /** How wide each error's token is, so a diagnostic can underline the whole of it. */
  i32[] errorWidths;
  i32 errorCount;
  /**
   * This file's renaming imports so far — `describe as sameName` records `sameName` and the token of
   * `describe` — so a symbol selected by its alias can carry the declared spelling. See
   * `symNameTok`.
   */
  string[] renameFrom;
  i32[] renameName;
  i32 renameCount;

  P create(u8[] src, Lexed lexed) {
    return P(src, lexed, 0, i32[].filled(192, 0), string[].defaulted(64), i32[].filled(64, 0), 0,
             string[].defaulted(16), i32[].filled(16, 0), 0);
  }

  /**
   * **An alias carries the declared spelling**, so the emitter — which resolves names by spelling —
   * finds the member the declaring file named. The position stays the usage's; the checker reads the
   * alias back from the identifier there, since an alias is what tells two symbols of one spelling
   * apart.
   *
   * Done once the file is parsed, not as each name is made: an import may come after the member that
   * uses it, and the namespace lowering puts the imports it writes on the file's last line.
   */
  void resolveSymbolAliases(this) {
    i32 stride = tokenStride();
    for (i32 at = this.lx.tokenCount; at < this.lx.tokenCount + this.lx.synthCount; at++) {
      if (this.lx.tokens[at * stride] != kSymName()) { continue; }
      string spelled = this.textOf(at);
      for (i32 i = 0; i < this.renameCount; i++) {
        if (this.renameFrom[i] != spelled) { continue; }
        this.lx.tokens[at * stride + 1] = this.lx.tokens[this.renameName[i] * stride + 1];
        this.lx.tokens[at * stride + 2] = this.lx.tokens[this.renameName[i] * stride + 2];
        break;
      }
    }
  }

  /** Records `name as alias` from an import, growing the table as needed. */
  void noteRename(this, i32 nameTok, i32 aliasTok) {
    if (nameTok < 0 || aliasTok < 0 || nameTok == aliasTok) { return; }
    if (this.renameCount >= this.renameFrom.len()) {
      string[] f2 = string[].defaulted(this.renameFrom.len() * 2);
      i32[] n2 = i32[].filled(this.renameFrom.len() * 2, 0);
      for (i32 i = 0; i < this.renameCount; i++) { f2[i] = this.renameFrom[i]; n2[i] = this.renameName[i]; }
      this.renameFrom = f2;
      this.renameName = n2;
    }
    this.renameFrom[this.renameCount] = this.textOf(aliasTok);
    this.renameName[this.renameCount] = nameTok;
    this.renameCount = this.renameCount + 1;
  }

  // ── Token access ────────────────────────────────────────────────────────────
  //
  // Reading past the end yields the eof token rather than trapping, which is what
  // lets every lookahead below be written without a bounds check.

  i32 idx(const this, i32 offset) {
    i32 i = this.at + offset;
    if (i >= this.lx.tokenCount) { return this.lx.tokenCount - 1; }
    return i;
  }

  i32 kindAt(const this, i32 offset) {
    return this.lx.tokens[this.idx(offset) * tokenStride()];
  }
  /**
   * A `kSymName` token standing for the identifier `t` — the name of a member written `[t]`.
   *
   * Appended after the end of the file, so nothing that walks the source sees it twice, with the
   * identifier's own start, length and position: a diagnostic about the member points where the
   * symbol is written. The token array is the lexer's, sized from the input, and grows here when a
   * file full of symbol names outruns it.
   */
  i32 symNameTok(this, i32 t) {
    i32 stride = tokenStride();
    i32 at = this.lx.tokenCount + this.lx.synthCount;
    if ((at + 1) * stride > this.lx.tokens.len()) {
      i32[] bigger = i32[].filled((at + 1) * stride * 2, 0);
      for (i32 i = 0; i < this.lx.tokens.len(); i++) { bigger[i] = this.lx.tokens[i]; }
      this.lx.tokens = bigger;
    }
    for (i32 f = 0; f < stride; f++) { this.lx.tokens[at * stride + f] = this.lx.tokens[t * stride + f]; }
    this.lx.tokens[at * stride] = kSymName();
    this.lx.synthCount = this.lx.synthCount + 1;
    return at;
  }

  /**
   * `[name]` where a member's name goes, as a `kSymName` token; -1 when the next token is not `[`.
   * Only a plain identifier is a selector here — a qualified one comes with namespaces.
   */
  i32 symbolMemberName(this) {
    if (!this.at1(kLbrack()) || this.kindAt(1) != kIdent() || this.kindAt(2) != kRbrack()) { return -1; }
    this.advance();
    i32 id = this.advance();
    this.advance();
    return this.symNameTok(id);
  }

  /** Whether the next token starts exactly where this one ends — `??` rather than `? ?`. */
  bool adjacentNext(const this) {
    return this.startAt(0) + this.lenAt(0) == this.startAt(1);
  }
  i32 startAt(const this, i32 offset) {
    return this.lx.tokens[this.idx(offset) * tokenStride() + 1];
  }
  i32 lenAt(const this, i32 offset) {
    return this.lx.tokens[this.idx(offset) * tokenStride() + 2];
  }
  i32 lineAt(const this, i32 offset) {
    return this.lx.tokens[this.idx(offset) * tokenStride() + 3];
  }
  i32 colAt(const this, i32 offset) {
    return this.lx.tokens[this.idx(offset) * tokenStride() + 4];
  }

  /** Absolute token index — what the AST stores. */
  i32 abs(const this, i32 offset) { return this.idx(offset); }

  bool at1(const this, i32 kind) { return this.kindAt(0) == kind; }
  bool at2(const this, i32 kind, i32 offset) { return this.kindAt(offset) == kind; }

  /** Consume the current token, returning its absolute index. */
  i32 advance(this) {
    i32 i = this.at;
    if (this.at < this.lx.tokenCount - 1) { this.at++; }
    return i;
  }

  bool eat(this, i32 kind) {
    if (this.at1(kind)) { this.advance(); return true; }
    return false;
  }

  i32 expect(this, i32 kind) {
    if (this.at1(kind)) { return this.advance(); }
    this.failWith(perrExpected(),
                  "expected '" + kindName(kind) + "', found " + this.foundAt(0));
    return this.at;
  }

  /**
   * Whether an interpolated literal starts at the cursor.
   *
   * `"a\{e}b"` lexes as `(` `"a\{` `+` `e` `+` `}b"` `)`, and that `(` is the only one in a file
   * that spans a quote — a written `(` spans a `(`. So the token stream already says this and
   * nothing has to be recorded beside it. `design/lang/0013` D7.
   */
  bool atInterpolation(const this) {
    return this.kindAt(0) == kLparen() && this.textAt(0) == "\"";
  }

  /**
   * Step over a whole interpolated literal, so one mistake stays one diagnostic.
   *
   * Balanced, because the expressions inside may have parentheses of their own.
   */
  void skipInterpolation(this) {
    if (!this.atInterpolation()) { return; }
    i32 depth = 0;
    while (!this.at1(kEof())) {
      i32 k = this.kindAt(0);
      if (k == kLparen()) { depth = depth + 1; }
      if (k == kRparen()) {
        depth = depth - 1;
        if (depth == 0) { this.advance(); return; }
      }
      this.advance();
    }
  }

  /** How wide the token at the cursor is, which is how much of the line a diagnostic underlines. */
  i32 widthAt(const this, i32 offset) {
    i32 len = this.lx.tokens[this.idx(offset) * tokenStride() + 2];
    return len > 0 ? len : 1;
  }

  /**
   * How a diagnostic names the token at `offset`: the source text in quotes, or `end of file`.
   *
   * **The quotes say "this is what is written there"**, so the one token with nothing written must
   * not wear them. End of input used to render as `found 'eof'` — an internal kind name, quoted as
   * though the file ended with the letters e, o and f. `issues/lang/0156` found it by noticing the
   * two compilers spelled it differently, and called it a token name leaking into prose; the other
   * spelling went with the reference, so what is left is just the leak. `issues/lang/0156`.
   */
  string foundAt(const this, i32 offset) {
    i32 t = this.idx(offset);
    if (this.lx.tokens[t * tokenStride()] == kEof()) { return "end of file"; }
    return "'" + this.textAt(offset) + "'";
  }

  /** The source text of a token near the cursor, for a diagnostic that has to quote it. */
  string textAt(const this, i32 offset) {
    return this.textOf(this.idx(offset));
  }

  /** The same, for a token a caller already holds the index of rather than an offset from here. */
  string textOf(const this, i32 t) {
    i32 start = this.lx.tokens[t * tokenStride() + 1];
    i32 len = this.lx.tokens[t * tokenStride() + 2];
    if (len <= 0) { return kindName(this.lx.tokens[t * tokenStride()]); }
    u8[] out = u8[].filled(len, 0);
    for (i32 i = 0; i < len; i++) { out[i] = this.src[start + i]; }
    return string.fromBytes(out);
  }

  /**
   * Every parse error is at a token, so every one of them can at least say which token.
   *
   * `expect` says both halves; the other thirty-odd sites know only what they were looking at, and
   * naming it is the difference between *expected an expression* and *expected an expression, found
   * `;`* — which of the two is on the line the reader is staring at.
   */
  void fail(this, i32 code) {
    this.failWith(code, "found " + this.foundAt(0));
  }

  /** The same, with the operands the parser was refusing over. */
  void failWith(this, i32 code, string note) {
    i32 slot = this.errorCount * 3;
    if (slot + 3 > this.errors.len()) { return; }
    this.errors[slot] = code;
    this.errors[slot + 1] = this.lineAt(0);
    this.errors[slot + 2] = this.colAt(0);
    if (this.errorCount < this.errorNotes.len()) { this.errorNotes[this.errorCount] = note; }
    if (this.errorCount < this.errorWidths.len()) { this.errorWidths[this.errorCount] = this.widthAt(0); }
    this.errorCount++;
  }
}

/**
 * True when the current token is a keyword.
 *
 * The kinds `kImport`..`kMatch` are the keyword block and are contiguous, so this is a
 * range test rather than a list. `kinds.wac` says every kind after a removed one moves
 * down, which keeps that true — and the differential test is what noticed last time.
 */
/**
 * Whether `k` is a keyword's kind — **the one place that answers this**.
 *
 * `kImport`..`kMatch` is contiguous and `kinds.wac` asks that it stay so, but a kind added after
 * `kEof` cannot join it: everything below 84 mirrors the reference's `TokenKind` order. `async` and
 * `await` are wac's own (`design/lang/0014`), so they are named here.
 *
 * Two callers read this and they must agree. They did not: extending only `atKeyword` left
 * `looksLikeVarDecl` testing the bare range, so `i32 async = 1;` was not recognised as a declaration
 * at all and produced five cascading parse errors instead of *'async' is a keyword and cannot be used
 * as a variable name* — which `i32 const = 1;` has said all along. The test for the new keyword is
 * what found it.
 */
bool isKeywordKind(i32 k) {
  return (k >= kImport() && k <= kMatch()) || k == kAsync() || k == kAwait() || k == kStatic() || k == kPrivate() || k == kDefer() || k == kMatches();
}

bool atKeyword(P p) {
  i32 k = p.kindAt(0);
  return isKeywordKind(k);
}

/**
 * The token of a name in a declaration, or -1, recording a diagnostic either way.
 *
 * Ported from the reference's `declName`: a keyword where a name belongs is *consumed*,
 * so that one mistake yields one error at the declaration rather than a cascade through
 * the rest of it. The consumption is the part that matters here — the diagnostics are
 * compared by position, and leaving the keyword in place would put every following error
 * somewhere else.
 */
i32 declName(P p, i32 code, string what) {
  if (p.at1(kIdent())) { return p.advance(); }
  // **The keyword case says which keyword and which name position**, because the spec makes that
  // wording the rule rather than a courtesy — `[§wac-keyword-name-8wnq4kp]`. The port kept the
  // consumption and dropped the message, which nothing noticed for as long as it did because the
  // differentials compare parse errors by *position* and both compilers report in the same place.
  if (atKeyword(p)) {
    p.failWith(perrKeywordName(),
               "'" + p.textAt(0) + "' is a keyword and cannot be used as a " + what);
    return p.advance();
  }
  p.fail(code);
  return -1;
}

// ── Growable lists ────────────────────────────────────────────────────────────
//
// One of these per element type, because there are no generics. They are identical
// but for the type name, and this is the clearest measurement of that gap in the
// repo so far: a parser needs a list of every AST node type it collects, and there
// is no way to write the pattern once. Scratch slots are nullable so an unwritten
// slot is null rather than a default-constructed node with an invalid tag.

struct ExprList {
  Expr?[] items;
  i32 n;

  ExprList create() { return ExprList(Expr?[].defaulted(4), 0); }

  void push(this, Expr e) {
    if (this.n == this.items.len()) {
      Expr?[] next = Expr?[].defaulted(this.items.len() == 0 ? 4 : this.items.len() * 2);
      for (i32 i = 0; i < this.n; i++) { next[i] = this.items[i]; }
      this.items = next;
    }
    this.items[this.n] = e;
    this.n++;
  }

  Expr[] take(const this) {
    // `Expr[].defaulted(n)` would need `Expr` to have a default value, and anything reachable from an
    // enum has none. The first collected element serves as the fill; every slot is then
    // overwritten, so the sharing `fill:` implies is invisible here.
    if (this.n == 0) { return Expr[](); }
    Expr[] out = Expr[].filled(this.n, this.items[0]!);
    for (i32 i = 1; i < this.n; i++) { out[i] = this.items[i]!; }
    return out;
  }
}

/** The attributes of one JSX element, grown as they are read. Mirrors `ExprList` exactly. */
struct JsxAttrList {
  JsxAttr?[] items;
  i32 n;

  JsxAttrList create() { return JsxAttrList(JsxAttr?[].defaulted(4), 0); }

  void push(this, JsxAttr a) {
    if (this.n == this.items.len()) {
      JsxAttr?[] next = JsxAttr?[].defaulted(this.items.len() == 0 ? 4 : this.items.len() * 2);
      for (i32 i = 0; i < this.n; i++) { next[i] = this.items[i]; }
      this.items = next;
    }
    this.items[this.n] = a;
    this.n++;
  }

  JsxAttr[] take(const this) {
    if (this.n == 0) { return JsxAttr[](); }
    JsxAttr[] out = JsxAttr[].filled(this.n, this.items[0]!);
    for (i32 i = 1; i < this.n; i++) { out[i] = this.items[i]!; }
    return out;
  }
}

struct TyList {
  Ty?[] items;
  i32 n;

  TyList create() { return TyList(Ty?[].defaulted(4), 0); }

  void push(this, Ty t) {
    if (this.n == this.items.len()) {
      Ty?[] next = Ty?[].defaulted(this.items.len() == 0 ? 4 : this.items.len() * 2);
      for (i32 i = 0; i < this.n; i++) { next[i] = this.items[i]; }
      this.items = next;
    }
    this.items[this.n] = t;
    this.n++;
  }

  Ty[] take(const this) {
    // `Ty[].defaulted(n)` would need `Ty` to have a default value, and anything reachable from an
    // enum has none. The first collected element serves as the fill; every slot is then
    // overwritten, so the sharing `fill:` implies is invisible here.
    if (this.n == 0) { return Ty[](); }
    Ty[] out = Ty[].filled(this.n, this.items[0]!);
    for (i32 i = 1; i < this.n; i++) { out[i] = this.items[i]!; }
    return out;
  }
}

/** A pattern's payload slots as they are read: a name token each, or -1 where the slot is a test. */
struct IntList {
  i32[] items;
  i32 n;

  IntList create() { return IntList(i32[].filled(4, 0), 0); }

  void push(this, i32 v) {
    if (this.n == this.items.len()) {
      i32[] next = i32[].filled(this.items.len() * 2 + 4, 0);
      for (i32 i = 0; i < this.n; i++) { next[i] = this.items[i]; }
      this.items = next;
    }
    this.items[this.n] = v;
    this.n++;
  }

  i32[] take(const this) {
    i32[] out = i32[].filled(this.n, 0);
    for (i32 i = 0; i < this.n; i++) { out[i] = this.items[i]; }
    return out;
  }
}

/** The tests beside them: a type where the slot is `is T`, null where it binds. */
struct TyOptList {
  Ty?[] items;
  i32 n;

  TyOptList create() { return TyOptList(Ty?[].defaulted(4), 0); }

  void push(this, Ty? t) {
    if (this.n == this.items.len()) {
      Ty?[] next = Ty?[].defaulted(this.items.len() * 2 + 4);
      for (i32 i = 0; i < this.n; i++) { next[i] = this.items[i]; }
      this.items = next;
    }
    this.items[this.n] = t;
    this.n++;
  }

  Ty?[] take(const this) {
    Ty?[] out = Ty?[].defaulted(this.n);
    for (i32 i = 0; i < this.n; i++) { out[i] = this.items[i]; }
    return out;
  }
}

