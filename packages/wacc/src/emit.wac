// Rung 4, first slice: a wasm module that runs.
//
// The ladder's oracle for this rung is deliberately *not* byte identity with the reference — see the
// README — but a canonical module form beside the one already sitting in this repository for nothing:
// **compile a program and run it**. That oracle needs something to run, and nothing here emitted a
// byte until now, so this is the walking skeleton: the binary scaffolding every later section needs,
// and just enough of the language to make a module that answers a question.
//
// What it covers: an exported function taking `i32` parameters and returning an `i32`, whose body is
// a single `return` of a literal, a parameter, or arithmetic over those. That is a fraction of the
// language and the point is not the fraction — it is that the shape is end to end, so the next rule
// added is measured by running it rather than by reading it.

import { lex, Lexed, tokenStride } from "./lex.wac";
import { floatLit, parseInt } from "./lit.wac";
import { P, parseProgram } from "./parse.wac";
import {
  Arm, JsxAttr, JsxSpan, jsxTrim, Decl, DeclKind, Expr, ExprKind, Lvalue, LvalueKind, Method, NamedArg,
  Param, Program, Stmt, StmtKind, Ty, TyKind,
} from "./ast.wac";
import {
  kPlus, kMinus, kStar, kSlash, kPercent, kAnd, kOr, kCaret, kShl, kShr, kShrU,
  kEq, kNe, kLt, kLe, kGt, kGe, kAndAnd, kOrOr, kBang, kTilde, kAssign, kInc,
  kPlusEq, kMinusEq, kStarEq, kSlashEq, kPercentEq, kAndEq, kOrEq, kCaretEq,
  kShlEq, kShrEq, kShrUEq, kString, kAsAt, kAsBang, kAsTilde,
} from "./kinds.wac";

/**
 * A growable byte buffer.
 *
 * wac has no growable array, so this is the same doubling `Buf` every package here ends up writing —
 * kept local rather than imported because `packages/wacc` has no dependencies and the whole value of
 * a self-hosting compiler is that it needs none.
 */
export struct B {
  u8[] data;
  i32 len;

  B create() { return B(u8[64](), 0); }

  void byte(this, i32 v) {
    if (this.len >= this.data.len()) {
      u8[] bigger = u8[this.data.len() * 2]();
      for (i32 i = 0; i < this.len; i++) { bigger[i] = this.data[i]; }
      this.data = bigger;
    }
    this.data[this.len] = v;
    this.len = this.len + 1;
  }

  /** Every byte of another buffer, which is how a section is spliced in once its length is known. */
  void bytes(this, B other) {
    for (i32 i = 0; i < other.len; i++) { this.byte(other.data[i]); }
  }

  /**
   * LEB128, unsigned. Seven bits at a time, low group first, the top bit saying "more follows".
   *
   * The encoding is not canonical — `0` may be written as one byte or five — which is exactly why
   * rung 4 does not compare bytes: two implementations may both be right and differ. This writes the
   * short form, being the one everything else writes.
   */
  void u32leb(this, i32 v) {
    i32 rest = v;
    for (i32 guard = 0; guard < 5; guard++) {
      i32 low = rest & 127;
      rest = (rest as@ u32 >> 7) as@ i32;
      if (rest == 0) {
        this.byte(low);
        return;
      }
      this.byte(low | 128);
    }
  }

  /** The same for an `i64`, which a wide constant needs and which cannot go through the 32-bit one. */
  void i64leb(this, i64 v) {
    i64 rest = v;
    for (i32 guard = 0; guard < 10; guard++) {
      i32 low = (rest & 127) as~ i32;
      rest = rest >> 7;
      bool signBit = (low & 64) != 0;
      if ((rest == 0 && !signBit) || (rest == -1 && signBit)) {
        this.byte(low);
        return;
      }
      this.byte(low | 128);
    }
  }

  /** LEB128, signed: the same, but the sign bit of the last group has to be the value's own. */
  void i32leb(this, i32 v) {
    i32 rest = v;
    for (i32 guard = 0; guard < 5; guard++) {
      i32 low = rest & 127;
      rest = rest >> 7;
      bool signBit = (low & 64) != 0;
      if ((rest == 0 && !signBit) || (rest == -1 && signBit)) {
        this.byte(low);
        return;
      }
      this.byte(low | 128);
    }
  }

  /** An `f32` constant: four raw little-endian bytes, not a LEB — floats are not varints. */
  void f32bits(this, f32 v) {
    u32 bits = f32.toBits(v);
    u32 sh = 0;
    while (sh < 32) {
      this.byte((bits >> sh & 255) as~ i32);
      sh = sh + 8;
    }
  }

  /**
   * An `f64` constant: eight raw little-endian bytes.
   *
   * The shift amount is a `u64` too. Shifting a `u64` by an `i32` came out as `ff ff ff ff` in the
   * low half — every constant wrong by exactly one part in 2^20, which reads as a rounding error and
   * is not one. Keeping both sides the same width is the fix and the lesson.
   */
  void f64bits(this, f64 v) {
    u64 bits = f64.toBits(v);
    u64 sh = 0;
    while (sh < 64) {
      this.byte((bits >> sh & 255) as~ i32);
      sh = sh + 8;
    }
  }

  /** A name, length-prefixed, which is how wasm writes every string in the binary. */
  void name(this, string s) {
    u8[] b = s.toBytes();
    this.u32leb(b.len());
    for (i32 i = 0; i < b.len(); i++) { this.byte(b[i]); }
  }
}

/**
 * A wac type's wasm value type.
 *
 * Four of them, and the mapping is many-to-one: `u32` and `bool` are `i32` in wasm, `u64` is `i64`.
 * That is exactly why the opcodes cannot be chosen from the value type — `i32.div_s` and `i32.div_u`
 * are both operations on an `i32`, and which one is right is a fact about the *wac* type that the
 * wasm type has already thrown away.
 */
i32 valType(string t) {
  // **`anyref` is the top of the reference hierarchy and `i31ref` a 31-bit integer inside a
  // reference** — no allocation, which is how an unboxed number and a heap object share a container.
  // Both are one byte, like the numeric types and unlike every other reference here, because neither
  // names a type in the type section.
  if (t == "anyref") { return 110; }
  if (t == "i31ref") { return 108; }
  if (t == "i64" || t == "u64") { return 126; }
  if (t == "f32") { return 125; }
  if (t == "f64") { return 124; }
  return 127;
}

/** Whether a wac type is an array, which is a *reference* and so two bytes rather than one. */
bool isArrayType(string t) {
  u8[] a = t.toBytes();
  if (a.len() < 3) { return false; }
  return a[a.len() - 2] == 91 && a[a.len() - 1] == 93;
}

/** A wac type's element, for an array. */
string elemOf(string t) {
  u8[] a = t.toBytes();
  u8[] out = u8[a.len() - 2]();
  for (i32 i = 0; i < out.len(); i++) { out[i] = a[i]; }
  return string.fromBytes(out);
}

/**
 * A value type, written rather than returned.
 *
 * An array is `0x64 <typeidx>` — a non-null reference to a declared type — so a value type is not one
 * byte and cannot be. Every place that wrote `types.byte(valType(t))` had to become a call here,
 * which is the shape a GC type forces on an emitter that started with scalars.
 */
/**
 * How a wac type is **represented**, which is not the same as what it is.
 *
 * A `string` is stored as an `i8[]` — the reference's type section says so and a literal is
 * `array.new_fixed` over the bytes — but it is *not* an `i8[]` to the language: `s[i]` on a string
 * gives a one-character string where `b[i]` on a `u8[]` gives an `i32`. Normalising the two into one
 * type erased that and emitted `array.get_s` for a string index, which returns the wrong kind of
 * thing entirely. The representation is shared; the type is not.
 */
string repType(string t) { return t == "string" ? "i8[]" : t; }

void writeValType(B out, Env env, string t) {
  // **The heap type after `0x63` is signed.** A reference type is `0x63` followed by an *s33* — the
  // encoding that lets a negative value mean `func`, `extern`, `eq` and the rest, and a non-negative
  // one mean a type index. Written as an unsigned LEB it is identical for the first sixty-four
  // indices and wrong for every one after, because 64 sets the sign bit of a one-byte LEB: index 65
  // came back as heap type **-63**. Nothing here had sixty-four types until linking, so this was
  // right for as long as a module was one file.
  if (t == "string") {
    out.byte(99);
    out.i32leb(env.arrayType("i8[]"));
    return;
  }
  // **Nullable** references, `0x63`, not the non-null `0x64`. A non-null reference has no default
  // value, so an array of them cannot be created with `array.new_default` — *"array type 1 has
  // non-defaultable element"* — and wac arrays are created that way constantly. The reference's own
  // locals are nullable too, which is the measurement that settled it.
  if (isArrayType(t)) {
    out.byte(99);
    out.i32leb(env.arrayType(t));
    return;
  }
  if (env.isStructName(t)) {
    out.byte(99);
    out.i32leb(env.structType(t));
    return;
  }
  // **A `fn[…]` value is a pair, not a bare funcref** — `design/lang/0002`. `{funcref, env}`, so a
  // bound reference can carry its receiver and still be the same type as every other `fn[]`.
  if (isFuncrefType(t)) {
    out.byte(99);
    out.i32leb(env.pairType(t));
    return;
  }
  out.byte(valType(t));
}

/**
 * The result type of a static on a *primitive* — `f64.toBits(x)` and its three siblings — or `""`.
 *
 * These are not methods on a value and not calls to anything declared: the receiver is a type name,
 * and each is one reinterpret instruction. They are the only reason 37 corpus files stop where they
 * do, which is what makes four instructions worth a table.
 */
string primStaticType(string owner, string name) {
  if (owner == "f32" && name == "toBits") { return "u32"; }
  if (owner == "f64" && name == "toBits") { return "u64"; }
  if (owner == "f32" && name == "fromBits") { return "f32"; }
  if (owner == "f64" && name == "fromBits") { return "f64"; }
  return "";
}

/** What such a static takes, so a literal argument arrives at the right width. */
string primStaticArg(string owner, string name) {
  if (owner == "f32" && name == "toBits") { return "f32"; }
  if (owner == "f64" && name == "toBits") { return "f64"; }
  if (owner == "f32" && name == "fromBits") { return "u32"; }
  if (owner == "f64" && name == "fromBits") { return "u64"; }
  return "";
}

/** The type name a bare identifier spells, when it is a primitive rather than a value. */
string primTypeName(Env env, u8[] src, Lexed lexed, Expr obj) {
  match (obj.kind) {
    case Ident(tok): {
      string n = tokenTextOf(src, lexed, tok);
      if (env.localAt(n) >= 0) { return ""; }
      if (n == "f32" || n == "f64" || n == "i32" || n == "i64" || n == "u32" || n == "u64") {
        return n;
      }
      return "";
    }
    else: { return ""; }
  }
}

/** The key a name token means — its own file's declaration, or whichever file has one. */
string nameKeyOf(Env env, u8[] src, Lexed lexed, i32 tok) {
  return env.keyAt(tokenTextOf(src, lexed, tok), tokenLine(lexed, tok));
}

/** A non-negative number as text, for building a key no source can spell — and for a diagnostic. */
export string numText(i32 n) {
  if (n == 0) { return "0"; }
  string out = "";
  i32 v = n;
  for (i32 guard = 0; guard < 12; guard++) {
    if (v == 0) { return out; }
    i32 d = v % 10;
    out = string.fromCodepoint(48 + d) + out;
    v = v / 10;
  }
  return out;
}

/** The line a token is on, which is what says which linked file it came from. */
i32 tokenLine(Lexed lexed, i32 t) {
  if (t < 0) { return 1; }
  return lexed.tokens[t * tokenStride() + 3];
}

/** The column a token starts at, which a coverage point needs to name a `case` arm. */
i32 tokenCol(Lexed lexed, i32 t) {
  if (t < 0) { return 1; }
  return lexed.tokens[t * tokenStride() + 4];
}

/** The storage type inside an array type, where a packed element is narrower than a value type. */
i32 storageType(string elem) {
  if (elem == "i8" || elem == "u8") { return 120; }
  if (elem == "i16" || elem == "u16") { return 119; }
  return valType(elem);
}

/** Whether a wac type is one of the unsigned integers, which decides `_s` from `_u`. */
/**
 * Register a type that a declaration *names*, whichever kind it is.
 *
 * The array pre-pass has been found one declaration short four times, and each time the rule was the
 * same — *every place a type can be named* — so signatures join it here rather than in a fifth list
 * of the same places.
 */
void registerNamed(Env env, string t) {
  if (isArrayType(t)) { env.arrayType(t); }
  if (isFuncrefType(t)) { env.sigType(t); }
}

/**
 * The signature a function is **emitted** with, which is not quite the one it is declared with: a
 * method's receiver is its first wasm parameter, and `void` is no result rather than one.
 *
 * Every function's wasm type is now this signature's entry in the shared table, rather than one type
 * per function. That is what makes `ref.func f` storable in a `fn[...]` local: wasm compares two
 * type *indices* in one rec group by position, not by shape, so a function whose type is a private
 * copy of the right shape is not the right type.
 */
string emittedSig(Env env, u8[] src, Lexed lexed, Ty returnType, Param[] params, string receiver) {
  string out = "fn[" + typeOfTyName(env, src, lexed, returnType) + "(";
  if (receiver != "") { out = out + receiver; }
  for (i32 i = 0; i < params.len(); i++) {
    if (i > 0 || receiver != "") { out = out + ","; }
    out = out + typeOfTyName(env, src, lexed, params[i].type);
  }
  return out + ")]";
}

/** The signature a registered function has, spelled the way a `fn[...]` type is. */
/** The type a literal is when nothing else says — the default of its family, or `""`. */
string naturalLiteralType(Expr e) {
  match (e.kind) {
    case IntLit(tok): { return "i32"; }
    case FloatLit(tok): { return "f64"; }
    case Jsx(tagTok, closeTok, attrs, kids): { return "Node"; }
    case JsxText(startOff, endOff): { return "Node"; }
    case StrLit(tok): { return "string"; }
    case BoolLit(value): { return "bool"; }
    // A `null` says nothing about what it is a null *of*, so a type parameter it is the only
    // evidence for cannot be inferred at all.
    else: { return ""; }
  }
}

/**
 * Bind a generic function's type parameters by **matching its declared types against the actual ones**.
 *
 * `mapOption<T, U>(Option<T> o, fn[U(T)] f)` called with an `Option<i32>` and an `fn[string(i32)]`
 * binds `T` from the first argument and `U` from the *return type of the second* — which is the half
 * of it a method could not have expressed, and the reason this is a function in the first place.
 *
 * The match is structural and one-sided: the declaration is the pattern, the argument's type is the
 * subject, and a parameter that appears twice has to be given the same answer both times.
 */
bool bindTypeParams(Env env, u8[] src, Lexed lexed, Ty t, string actual, i32[] tps, string[] out) {
  match (t.kind) {
    case Prim(tok): { return true; }
    case Arr(elem): {
      if (!isArrayType(actual)) { return false; }
      return bindTypeParams(env, src, lexed, elem, elemOf(actual), tps, out);
    }
    case Nullable(inner): { return bindTypeParams(env, src, lexed, inner, actual, tps, out); }
    case Funcref(ret, params): {
      if (!isFuncrefType(actual)) { return false; }
      if (sigParamCount(actual) != params.len()) { return false; }
      if (!bindTypeParams(env, src, lexed, ret, sigReturn(actual), tps, out)) { return false; }
      for (i32 i = 0; i < params.len(); i++) {
        if (!bindTypeParams(env, src, lexed, params[i], sigParamAt(actual, i), tps, out)) {
          return false;
        }
      }
      return true;
    }
    case Named(tok, typeArgs): {
      string nm = tokenTextOf(src, lexed, tok);
      for (i32 i = 0; i < tps.len(); i++) {
        if (tokenTextOf(src, lexed, tps[i]) != nm) { continue; }
        if (actual == "") { return false; }
        // Seen before: the two uses have to agree, or this is not the instance being called.
        if (out[i] != "" && out[i] != actual) { return false; }
        out[i] = actual;
        return true;
      }
      if (typeArgs.len() == 0) { return true; }
      if (!isInstance(actual) || templateOf(actual) != nm) { return false; }
      for (i32 i = 0; i < typeArgs.len(); i++) {
        if (!bindTypeParams(env, src, lexed, typeArgs[i], typeArgAt(actual, i), tps, out)) {
          return false;
        }
      }
      return true;
    }
  }
}

/**
 * The instance a call to a generic function names — `mapOption<i32,string>` — or `""`.
 *
 * Spelled the same way a generic type's instance is, because it is the same thing: a name plus its
 * arguments, registered on sight and compiled once. The difference is only where the arguments come
 * from, and this is the function that answers that.
 */
string genericCallInstance(Env env, u8[] src, Lexed lexed, i32 tok, Expr[] args) {
  if (env.prog is null) { return ""; }
  string raw = tokenTextOf(src, lexed, tok);
  Program pg = env.prog!;
  for (i32 d = 0; d < pg.decls.len(); d++) {
    match (pg.decls[d].kind) {
      case Func(nameTok, returnType, params, body, exported, typeParams): {
        if (typeParams.len() == 0) { continue; }
        if (tokenTextOf(src, lexed, nameTok) != raw) { continue; }
        if (params.len() != args.len()) { return ""; }
        string[] bound = string[typeParams.len()]();
        for (i32 i = 0; i < args.len(); i++) {
          string at = typeOfE(src, lexed, env, args[i]);
          // **A literal has no type of its own and here there is no slot to take one from**: the
          // parameter is `T`, so what `T` is *is* the question the literal has to answer. Its natural
          // type is the answer — `ident(7)` is `ident<i32>` — which is the one place in this emitter
          // a literal's type comes from the literal.
          if (at == "") { at = naturalLiteralType(args[i]); }
          if (!bindTypeParams(env, src, lexed, params[i].type, at, typeParams, bound)) { return ""; }
        }
        string inst = raw + "<";
        for (i32 i = 0; i < bound.len(); i++) {
          // A parameter no argument mentions cannot be inferred, and guessing would compile a
          // different function from the one that was called.
          if (bound[i] == "") { return ""; }
          if (i > 0) { inst = inst + ","; }
          inst = inst + bound[i];
        }
        inst = inst + ">";
        // **Noted on sight, registered in order.** Which instances exist is discovered here, by
        // whichever walk reaches the call first; *registering* one — giving it an entry in the
        // function table — happens in `collectInstances`, which walks the instances in the order
        // they were discovered. The two have to be the same order, because the function table's
        // order is the module's numbering and the emission passes iterate the instance list. Doing
        // the registration here instead put a generic function's entry ahead of the methods of an
        // instance discovered before it, and every call after that point reached the wrong index.
        env.instantiate(inst, raw);
        return inst;
      }
      else: { }
    }
  }
  return "";
}

/**
 * The function slot `Owner.name` names when it is used as a *value*, or -1.
 *
 * Only a name that resolves to a **type** can be one: `c.inc` is a method already bound to an
 * object, which is exactly what has no representation here, and asking for it is the error the tour
 * points at rather than a thing to emit.
 */
i32 methodRefAt(u8[] src, Lexed lexed, Env env, Expr obj, i32 nameTok) {
  string own = staticOwner(src, lexed, env, obj);
  if (own == "") { return -1; }
  return env.funcAt(own + "." + tokenTextOf(src, lexed, nameTok));
}

string signatureOf(Env env, i32 at) {
  string out = "fn[" + env.funcReturns[at] + "(";
  // **The receiver is a parameter of the function that was emitted**, so a reference to a method has
  // it first and a call through that reference passes the object where `this` was.
  string recv = env.funcRecv[at];
  if (recv != "") { out = out + recv; }
  for (i32 i = 0; i < env.funcParamCount[at]; i++) {
    if (i > 0 || recv != "") { out = out + ","; }
    out = out + env.paramTypeAt(at, i);
  }
  return out + ")]";
}

/** The `i`th type argument in `Vec<i32>` or `Map<string,Vec<i32>>` — by depth, since they nest. */
string typeArgAt(string inst, i32 want) {
  i32 depth = 0;
  i32 from = -1;
  i32 n = 0;
  for (i32 i = 0; i < inst.len(); i++) {
    string c = inst[i];
    if (c == "<") {
      depth = depth + 1;
      if (depth == 1) { from = i + 1; }
      continue;
    }
    // This one already opened the angle bracket above, so it counts only the square ones.
    if (c == "[") { depth = depth + 1; }
    if (c == "]") { depth = depth - 1; }
    if (c == ">") {
      depth = depth - 1;
      if (depth == 0) { return n == want ? inst.slice(from, i) : ""; }
    }
    if (c == "," && depth == 1) {
      if (n == want) { return inst.slice(from, i); }
      n = n + 1;
      from = i + 1;
    }
  }
  return "";
}

/** Whether a name is an instantiation rather than a plain type. */
bool isInstance(string t) {
  return t.indexOf("<") > 0;
}

/** The template an instantiation is of: `Vec` from `Vec<i32>`. */
string templateOf(string inst) {
  i32 at = inst.indexOf("<");
  return at < 0 ? "" : inst.slice(0, at);
}

/**
 * The owner a static call means when it is written on a **template**: `Vec.create()`.
 *
 * The instantiation is not in the call — it is in the slot the answer goes into, which is the
 * language's own spelling: `Vec<i32> w = Vec.create();`. So this takes the wanted type, and
 * `typeOfE`, which has no slot to consult, cannot answer this shape at all.
 */
string templateStatic(Env env, u8[] src, Lexed lexed, Expr obj, string want) {
  if (!isInstance(want)) { return ""; }
  match (obj.kind) {
    case Ident(tok): {
      return tokenTextOf(src, lexed, tok) == templateOf(want) ? want : "";
    }
    else: { return ""; }
  }
}

/**
 * Bring a template's parameters into scope as its arguments, and say how many were pushed.
 *
 * The caller pops exactly that many, which is the whole protocol: a template's members are
 * registered and emitted with this in force, and nothing else about them changes.
 */
i32 pushSubstitution(Env env, u8[] src, Lexed lexed, i32[] typeParams, string inst, string of) {
  for (i32 i = 0; i < typeParams.len(); i++) {
    if (env.subCount >= env.subFrom.len()) { return i; }
    env.subFrom[env.subCount] = tokenTextOf(src, lexed, typeParams[i]);
    env.subTo[env.subCount] = typeArgAt(inst, i);
    env.subCount = env.subCount + 1;
  }
  env.curInst = inst;
  env.curGeneric = of;
  return typeParams.len();
}

void popSubstitution(Env env, i32 n) {
  env.subCount = env.subCount - n;
  env.curInst = "";
  env.curGeneric = "";
}

/**
 * Whether a type as *written* admits null — which its name cannot say.
 *
 * `T?` and `T` are one wasm type here, deliberately: every reference this emitter writes is
 * nullable, so the difference is the checker's to keep. It matters in exactly one place, and this
 * is why the flag exists rather than a spelling: the **default** of a `P?` is null, and the default
 * of a `P` is a defaulted `P`.
 */
bool isNullableTy(Ty t) {
  match (t.kind) {
    case Nullable(inner): { return true; }
    else: { return false; }
  }
}

/** Whether a type is a function reference, which is decided by its spelling. */
bool isFuncrefType(string t) {
  return t.len() > 3 && t.slice(0, 3) == "fn[";
}

/**
 * The return type inside `fn[R(A,B)]`, and the `i`th parameter — by scanning rather than splitting.
 *
 * A signature nests: `fn[i32[](fn[i32(i32)])]` has brackets and parentheses inside both halves, so
 * the split has to count depth. Getting this wrong is a type index that does not exist rather than a
 * wrong answer, but it is the kind of wrong that surfaces four functions away.
 */
/**
 * The funcref type that lives inside a `fn[…]` pair: the same signature with an `anyref` env in front.
 *
 * `design/lang/0002`. A `fn[…]` value is `{funcref, env}`, and the funcref has to accept the env
 * whatever it came from — a plain function's wrapper ignores it, a bound method's casts it to the
 * receiver. One shape for both is what keeps a bound reference interchangeable with every `fn[]`
 * that already exists.
 *
 * Built as a *string* and allocated through the ordinary `sigType`, deliberately: a function's own
 * wasm type comes from the same table via `emittedSig`, so prepending an env there would retype the
 * whole module rather than its function values.
 */
string envSig(string t) {
  string out = "fn[" + sigReturn(t) + "(anyref";
  for (i32 i = 0; i < sigParamCount(t); i++) {
    out = out + "," + sigParamAt(t, i);
  }
  return out + ")]";
}

/**
 * The marker that makes a signature-table entry a **pair struct** rather than a function type.
 *
 * The pair shares that table because the table is allocated lazily during emission and is therefore
 * last — nothing may be appended after it, since an index emitted early would move when it grew.
 * Sharing it keeps the two types a `fn[]` needs allocated together and the index arithmetic
 * untouched. `design/lang/0002` records why this is not a fourth category.
 */
string pairMark() { return "pair:"; }

/** Whether a signature-table entry is a pair struct. */
bool isPairEntry(string t) { return t.len() > 5 && t.slice(0, 5) == pairMark(); }

/** The `fn[…]` a pair entry is the pair for. */
string pairInner(string t) { return t.slice(pairMark().len(), t.len()); }

string sigReturn(string t) {
  i32 depth = 0;
  for (i32 i = 3; i < t.len(); i++) {
    string c = t[i];
    // **`<` nests too.** An instantiation is spelled `Result<i32,string>`, so a signature that
    // mentions one has a comma *inside* a parameter — and a scanner that counts only brackets and
    // parentheses reads `fn[bool(Result<i32,string>)]` as taking two. The function then declares one
    // parameter and its type says two, which wasm reports as a `struct.get` on a number, in a
    // method several functions away. This is what made two type parameters fail and one work.
    if (c == "[" || c == "<") { depth = depth + 1; }
    if (c == "]" || c == ">") { depth = depth - 1; }
    if (c == "(" && depth == 0) { return t.slice(3, i); }
  }
  return "";
}

/** How many parameters a signature has, and the `i`th of them. */
i32 sigParamCount(string t) {
  i32 depth = 0;
  i32 start = -1;
  i32 n = 0;
  bool any = false;
  for (i32 i = 3; i < t.len(); i++) {
    string c = t[i];
    // **`<` nests too.** An instantiation is spelled `Result<i32,string>`, so a signature that
    // mentions one has a comma *inside* a parameter — and a scanner that counts only brackets and
    // parentheses reads `fn[bool(Result<i32,string>)]` as taking two. The function then declares one
    // parameter and its type says two, which wasm reports as a `struct.get` on a number, in a
    // method several functions away. This is what made two type parameters fail and one work.
    if (c == "[" || c == "<") { depth = depth + 1; }
    if (c == "]" || c == ">") { depth = depth - 1; }
    if (c == "(" && depth == 0 && start < 0) {
      start = i;
      depth = depth + 1;
      continue;
    }
    if (start < 0) { continue; }
    if (c == "(") { depth = depth + 1; }
    if (c == ")") {
      depth = depth - 1;
      if (depth == 0) { return any ? n + 1 : 0; }
    }
    if (c == "," && depth == 1) { n = n + 1; }
    if (c != " ") { any = true; }
  }
  return 0;
}

string sigParamAt(string t, i32 want) {
  i32 depth = 0;
  i32 from = -1;
  i32 n = 0;
  for (i32 i = 3; i < t.len(); i++) {
    string c = t[i];
    // **`<` nests too.** An instantiation is spelled `Result<i32,string>`, so a signature that
    // mentions one has a comma *inside* a parameter — and a scanner that counts only brackets and
    // parentheses reads `fn[bool(Result<i32,string>)]` as taking two. The function then declares one
    // parameter and its type says two, which wasm reports as a `struct.get` on a number, in a
    // method several functions away. This is what made two type parameters fail and one work.
    if (c == "[" || c == "<") { depth = depth + 1; }
    if (c == "]" || c == ">") { depth = depth - 1; }
    if (c == "(" && depth == 0 && from < 0) {
      from = i + 1;
      depth = depth + 1;
      continue;
    }
    if (from < 0) { continue; }
    if (c == "(") { depth = depth + 1; }
    if (c == ")") {
      depth = depth - 1;
      if (depth == 0) {
        return n == want ? t.slice(from, i) : "";
      }
    }
    if (c == "," && depth == 1) {
      if (n == want) { return t.slice(from, i); }
      n = n + 1;
      from = i + 1;
    }
  }
  return "";
}

bool isUnsigned(string t) { return t == "u32" || t == "u64"; }

/** Whether a wac type is a float, which decides a whole family of opcodes rather than a suffix. */
bool isFloat(string t) { return t == "f32" || t == "f64"; }

/** `0x7f`, the value type of everything this emitter cannot type. */
i32 wasmI32() { return 127; }

/**
 * A section: its id, then its byte length, then its contents.
 *
 * The length has to be known before the contents are written, which is why a section is built in a
 * buffer of its own and spliced in — the same shape the reference uses and the reason a wasm emitter
 * is a tree of buffers rather than one.
 */
/**
 * Export a function, and remember what it is called.
 *
 * The two belong together: a helper the module exports is a frame a trap can happen in, and the
 * `name` section is built from this table. Exporting without recording is how every helper came out
 * as `wasm-function[147]` [issue 0101].
 */
void exportFunc(B exports, string[] fnName, string nm, i32 idx) {
  exports.name(nm);
  exports.byte(0);          // a function
  exports.u32leb(idx);
  if (idx >= 0 && idx < fnName.len()) { fnName[idx] = nm; }
}

void section(B out, i32 id, B sec) {
  out.byte(id);
  out.u32leb(sec.len);
  out.bytes(sec);
}


/**
 * Where a name lives while a function is being emitted.
 *
 * wasm has no names: a parameter and a local are both an *index*, parameters first, and a call names
 * a function by its index too. So the whole environment is two lists of names whose position is the
 * answer — which is the emitter's version of what the checker's flat name table already is.
 */
export struct Env {
  string[] locals;
  /** Each local's wac type, which is what decides every opcode the local takes part in. */
  string[] localTypes;
  i32 localCount;
  i32 paramCount;
  /**
   * How many wasm labels enclose the statement being emitted, and which of them a `break` leaves.
   *
   * wasm branches by *relative depth*, so `break` has to know how many blocks it sits inside since
   * the one it means. `depth` counts every label pushed; `breakAt` and `continueAt` remember the
   * depth at which the innermost loop's two labels were pushed, and the branch is the difference.
   * Getting it wrong produces a module that validates and jumps somewhere else, which is the reason
   * every one of these is tested by running it.
   */
  i32 depth;
  i32 breakAt;
  i32 continueAt;
  /**
   * Every distinct array type the module uses, and the wasm type index each was given.
   *
   * A wasm array is a *declared* type — `i32[]` is not a value type but a reference to an entry in
   * the type section — so the set has to be known before the section is written, and every use has
   * to name the same index. That is the first thing in this emitter that is not local to one
   * function.
   */
  string[] arrayTypes;
  i32 arrayCount;
  /**
   * Every function *signature* the module names, and the wasm type index each was given.
   *
   * A third kind of declared type, after the arrays and the structs. A function reference's value
   * type is `(ref null $sig)`, so the signature has to be a declared type of its own — separate from
   * the per-function types the code section already emits, which are indexed by function rather than
   * by shape.
   */
  /**
   * Sized for **three entries per `fn[…]`**, not one: the signature, its env shape and its pair —
   * `design/lang/0002`. At 4096 this overflowed on a real program, and an overflowed table answers
   * `sigType` with 0, which is an *array* index: `no signature at index 0 (4372 types)`, dozens of
   * functions from the cause.
   */
  string[] sigTypes;
  i32 sigCount;
  /**
   * The type arguments in force while a template is registered or emitted, and which template.
   *
   * `Vec<T>` is not a type — `Vec<i32>` is — so a template is compiled once **per instantiation**,
   * with `T` standing for its argument throughout. The substitution lives here because
   * `typeOfTyName` already takes the environment, so every place a type can be named goes through
   * it without a parameter being threaded to any of them.
   */
  string[] subFrom;
  string[] subTo;
  i32 subCount;
  /** The instance being built, and the template it is of — `Vec(…)` inside `Vec<T>` means it. */
  string curInst;
  string curGeneric;
  /** Every instantiation the module names, the template each is of, and whether one is new. */
  /** The structs whose defaults are being built, so one that reaches itself stops at a null. */
  string[] building;
  i32 buildingCount;
  string[] instName;
  string[] instOf;
  i32 instCount;
  bool instDirty;
  /**
   * The structs, in the order their type indices were handed out, and their fields flat beside them.
   *
   * A struct is the second declared type and shares the index space with the arrays, so both are
   * collected before the type section is written. The fields are flat — name, type, and which struct
   * owns them — for the same reason every table in this package is: wac has no growable array of
   * arrays, and the index is the answer.
   */
  /** The first construct that stopped a function being emitted, for the caller to report. */
  string blocked;
  /** The return type of the function being emitted, for the `return` statements inside it. */
  string returnType;
  /**
   * Module-level constants, and the expression each one *is*.
   *
   * Scalars are **inlined** at every use rather than given a global, which is what the reference does
   * and is simpler than it sounds: a constant has no identity to preserve, so substituting its
   * initialiser is exactly equivalent. An array constant is a different matter — it has identity, and
   * one array shared by every use is not the same as one array per use — so those stay declined until
   * there is a global section to put them in.
   */
  string[] constNames;
  /** The global index of a constant that needs one, or -1 for an inlined scalar. */
  i32[] constGlobal;
  string[] constTypes;
  /** Nullable because an `Expr` has no default value — this emitter's own checker says so. */
  Expr?[] constInits;
  i32 constCount;
  string[] structNames;
  i32 structCount;
  string[] fieldOwners;
  string[] fieldNames;
  string[] fieldTypes;
  /** Whether each field was written as `T?`, which is the whole of what its default turns on. */
  bool[] fieldNullable;
  i32 fieldCount;
  string[] funcs;
  /** Each function's return type, so a call has one without re-reading the declaration. */
  string[] funcReturns;
  /**
   * Each function's parameter types, flat.
   *
   * Needed for the same reason a field's type is: an argument that is a **literal** takes the type of
   * the slot it fills, and `g(4294967296)` is an `i64` constant or a zero depending on whether that
   * slot is known. Recorded rather than looked up, because a call site has a name and not a
   * declaration.
   */
  string[] funcParamTypes;
  i32[] funcParamAt;
  i32[] funcParamCount;
  i32 funcParamTotal;
  /**
   * Whether each function will be emitted, and what index it will have when it is.
   *
   * These are two different numbers and conflating them was a real bug: a function this emitter
   * cannot do is *skipped*, so the emitted module is a subset, and a call site naming the
   * registration index refers to something that is not there — *"function index #3 is not
   * declared"*. `funcOk` is the subset and `funcIndex` is the renumbering.
   */
  bool[] funcOk;
  i32[] funcIndex;
  i32 funcCount;
  /**
   * Every enum variant: the name it is known by, the enum it belongs to, the tag it carries, and
   * where its payload sits.
   *
   * **An enum is one wasm struct**, not a base type with a subtype per variant. The hierarchy the
   * language describes is what the reference emits; what this rung compares is answers, and a flat
   * struct — a tag in slot 0, then a slot per payload field of every variant in declaration order —
   * gives the same ones with no subtyping in the type section and no cast at any use. A variant is
   * then the *same wasm type* as its enum, which is what makes assigning one to the other free and
   * `match` a comparison rather than a test.
   *
   * The cost is space: a `Rect` carries the slots a `Circle` would have used. That is the trade a
   * language with no unions makes anyway, and nothing here is measuring bytes yet.
   */
  /**
   * Where each linked file begins, as a line number, and every top-level name with the file that
   * declared it.
   *
   * Linking by concatenation put every file's declarations in one pool, and a pool cannot hold two
   * meanings for one name — `sha256.wac` and `sha512.wac` both declare a `K`. What distinguishes
   * them is **where they are**: the blob is the files end to end, so a line number names a file
   * exactly, and every token carries its line. A name declared in the second file is registered
   * under a key of its own, and a reference resolves to the declaration in its *own* file before it
   * resolves to anyone else's — which is the language's rule (a file sees its own names, then what
   * it imported) arrived at from the only direction available here.
   */
  i32[] fileFirstLine;
  i32 fileCount;
  /**
   * Which file imports which, as (from, to) pairs.
   *
   * Needed because "this file's declaration, then anybody's" is not the language's rule and is not
   * even a safe approximation of it: with three files declaring `P`, a file that imported one of
   * them got whichever had registered first, and two structs that used to be one type are now two.
   * The wasm error for that is *"expected (ref null 1), got (ref null 7)"*, which names neither file.
   */
  i32[] importFrom;
  i32[] importTo;
  /**
   * The name each edge brings in, and the name the other file declares it under.
   *
   * The two differ under `import { decode as b64decode }`: the caller writes `b64decode` and no file
   * declares one. Nineteen corpus files are that import.
   */
  string[] importNames;
  string[] importDecls;
  i32 importCount;
  string[] declNames;
  i32[] declFiles;
  string[] declKeys;
  i32 declCount;
  string[] variantNames;
  string[] variantOwners;
  i32[] variantTags;
  /** The first field slot of this variant's payload, and how many slots it has. */
  i32[] variantSlot;
  i32[] variantArity;
  i32 variantCount;
  /**
   * Whether any table filled up.
   *
   * These are fixed arrays, and a table that stops writing while its count keeps rising renumbers
   * everything after it — a call to function #400 reaching #399. Linking made that reachable for the
   * first time: one file never had five hundred functions, and a closure of forty does. So it is
   * recorded and the module is declined by name, rather than emitted with the indices off by one.
   */
  bool full;
  /** Whether any name had to be guessed at — see `keyAt`. A module with one is not emitted. */
  bool ambiguous;
  /** And which name it was, because a category is not a diagnosis. */
  string ambiguousName;

  /**
   * Each struct's parent, or `""` — `struct Rect : Shape` maps to WasmGC's `sub`.
   *
   * Held beside the names rather than folded into the field table, because a subtype's fields are
   * *its parent's followed by its own* and the parent may be declared later in the file. Resolving
   * the chain when a field is asked for costs a lookup and keeps registration order irrelevant.
   */
  string[] structParents;
  /** The parent's name token, kept until every struct is declared and the key can be resolved. */
  i32[] structParentToks;
  /**
   * The program itself, so a walk can find a *declaration* rather than only what was registered.
   *
   * A generic function is the one thing that cannot be registered up front: `mapOption<T, U>` has no
   * instance until a call site says what `T` and `U` are, and it says so by the types of its
   * arguments rather than in writing. The declaration therefore has to be readable from wherever a
   * call is seen, which is several walkers deep and nowhere near the loop over `prog.decls`.
   */
  Program? prog;
  /** Whether this round built an instance's members, which can unblock a walk in the next one. */
  bool instBuilt;
  /**
   * Each function's receiver type, or `""` — the owner of a method declared with `this`.
   *
   * A method is registered with its *declared* parameters, because a call site pushes the object
   * itself and then walks the arguments. A **reference** to one has to say the other thing: its type
   * is `fn[void(Counter)]`, receiver first, since that is the signature of the function that was
   * actually emitted. This is what tells the two apart.
   */
  string[] funcRecv;

  /** A local's wac type, or `""` when the name is not one. */
  string localType(const this, string name) {
    for (i32 i = this.localCount - 1; i >= 0; i--) {
      if (this.locals[i] == name) { return this.localTypes[i]; }
    }
    return "";
  }

  /** The index of a local, or -1. Searched from the end so an inner declaration wins a shadow. */
  i32 localAt(const this, string name) {
    for (i32 i = this.localCount - 1; i >= 0; i--) {
      if (this.locals[i] == name) { return i; }
    }
    return -1;
  }

  i32 funcAt(const this, string name) {
    for (i32 i = 0; i < this.funcCount; i++) {
      if (this.funcs[i] == name) { return i; }
    }
    return -1;
  }

  /**
   * A local with no name, for a value that has to be used twice.
   *
   * A saturating cast reads its operand three times — once to compare against each bound and once to
   * convert — and an expression is not a thing you can evaluate three times. So it is spilled. Named
   * with a character no wac identifier can contain, which is how it cannot collide with a real one.
   *
   * Reused per type rather than allocated per site: the value is dead the moment the sequence that
   * spilled it ends, and one scratch of each width is all any of them needs.
   */
  /**
   * A scratch local for a named role, so two roles cannot share one slot.
   *
   * The plain `scratch` is keyed by type alone, which is right while the only thing spilling is a
   * cast. A compound assignment spills its target *across* the right-hand side, and a cast in there
   * would take the same `i32` slot — so the base and the index of `a[i] += (x as~ i32)` are asked
   * for by name.
   */
  i32 scratchNamed(this, string tag, string ty) {
    string key = " scratch " + tag + " " + ty;
    i32 at = this.localAt(key);
    if (at >= 0) { return at; }
    this.addLocal(key, ty);
    return this.localCount - 1;
  }

  i32 scratch(this, string ty) {
    string key = " scratch " + ty;
    i32 at = this.localAt(key);
    if (at >= 0) { return at; }
    this.addLocal(key, ty);
    return this.localCount - 1;
  }

  /**
   * The wasm type index for an array type, adding it if this is the first sighting.
   *
   * Arrays occupy the first block of indices and structs the second, so a struct declared later
   * cannot renumber an array. Both are known before the section is written, which is what makes a
   * fixed split possible at all.
   */
  i32 arrayType(this, string t) {
    for (i32 i = 0; i < this.arrayCount; i++) {
      if (this.arrayTypes[i] == t) { return i; }
    }
    if (this.arrayCount >= this.arrayTypes.len()) {
      this.ranOut("array types");
      return 0;
    }
    // **The element first, transitively.** `u8[][]`'s element is `u8[]`, which is a declared type of
    // its own and has to exist before anything refers to it. Registering only the outer one meant the
    // inner was created while the section was being *written* — an index past the count already
    // emitted, which wasm reports as "type index out of bounds" and which is the same mistake a field
    // of array type made two slots ago, one level further in.
    string el = elemOf(t);
    if (isArrayType(el)) { this.arrayType(el); }
    this.arrayTypes[this.arrayCount] = t;
    this.arrayCount = this.arrayCount + 1;
    return this.arrayCount - 1;
  }

  /** What a type parameter stands for right now, or `""` — the innermost binding wins. */
  string substituted(const this, string name) {
    for (i32 i = this.subCount - 1; i >= 0; i--) {
      if (this.subFrom[i] == name) { return this.subTo[i]; }
    }
    return "";
  }

  /** Record an instantiation. New ones set `instDirty`, which is what makes registration settle. */
  void instantiate(this, string inst, string of) {
    for (i32 i = 0; i < this.instCount; i++) {
      if (this.instName[i] == inst) { return; }
    }
    if (this.instCount >= this.instName.len()) {
      this.ranOut("generic instantiations");
      return;
    }
    this.instName[this.instCount] = inst;
    this.instOf[this.instCount] = of;
    this.instCount = this.instCount + 1;
    this.instDirty = true;
  }

  /**
   * A signature's type index, which follows the structs — added on first sighting, like an array's.
   *
   * The parameter and return types are registered first and transitively: a signature that mentions
   * `u8[]` is a type that mentions a type, and the inner one has to exist before the section that
   * declares them both is written.
   */
  i32 sigType(this, string t) {
    for (i32 i = 0; i < this.sigCount; i++) {
      if (this.sigTypes[i] == t) { return this.arrayCount + this.structCount + i; }
    }
    if (this.sigCount >= this.sigTypes.len()) {
      this.ranOut("function signatures");
      return 0;
    }
    this.sigTypes[this.sigCount] = t;
    this.sigCount = this.sigCount + 1;
    i32 mine = this.sigCount - 1;
    string r = sigReturn(t);
    if (isArrayType(r)) { this.arrayType(r); }
    if (isFuncrefType(r)) { this.sigType(r); }
    for (i32 i = 0; i < sigParamCount(t); i++) {
      string pt = sigParamAt(t, i);
      if (isArrayType(pt)) { this.arrayType(pt); }
      if (isFuncrefType(pt)) { this.sigType(pt); }
    }
    return this.arrayCount + this.structCount + mine;
  }

  /** A struct's type index, which follows the arrays. */
  /**
   * The struct type index for a `fn[…]` value's `{funcref, env}` pair — `design/lang/0002`.
   *
   * Allocated through `sigType` behind a marker, for the reason `pairMark` gives: the signature table
   * grows lazily during emission, so nothing may sit after it, and sharing it keeps the pair and its
   * env-taking funcref allocated together.
   */
  i32 pairType(this, string t) {
    // The funcref type first, so the struct's field type exists before the struct is written.
    i32 e = this.sigType(envSig(t));
    i32 ei = e - this.arrayCount - this.structCount;
    if (ei >= 0 && ei < this.sigNoPair.len()) { this.sigNoPair[ei] = true; }
    return this.sigType(pairMark() + t);
  }

  /**
   * Give every `fn[…]` already registered its pair, so none is first named while emitting.
   *
   * Run after the pre-pass and before the type section. A `fn[…]` reaches `writeValType` from a
   * local, a field, a parameter or a return, and all of those are registered by then — so sweeping
   * the table catches them all without a second walk of the program that could disagree with the
   * first.
   *
   * The loop re-reads `sigCount` because `pairType` appends: an env shape, which is flagged and
   * skipped, and a pair entry, which is not a funcref type. So it terminates.
   */
  void pairEverySignature(this) {
    for (i32 i = 0; i < this.sigCount; i++) {
      if (i < this.sigNoPair.len() && this.sigNoPair[i]) { continue; }
      string t = this.sigTypes[i];
      if (!isFuncrefType(t)) { continue; }
      this.pairType(t);
    }
  }

  i32 structType(this, string name) {
    string n = this.canonType(name);
    for (i32 i = 0; i < this.structCount; i++) {
      if (this.structNames[i] == n) { return this.arrayCount + i; }
    }
    return -1;
  }

  /** The index of a module-level constant, or -1. */
  i32 constAt(const this, string name) {
    for (i32 i = 0; i < this.constCount; i++) {
      if (this.constNames[i] == name) { return i; }
    }
    return -1;
  }

  bool isStructName(const this, string name) {
    string n = this.canonType(name);
    for (i32 i = 0; i < this.structCount; i++) {
      if (this.structNames[i] == n) { return true; }
    }
    return false;
  }

  /**
   * Whether one struct is the other, or descends from it.
   *
   * A widening needs **no instruction**: a `Rect` reference already is a `Shape` reference to wasm
   * once the type section says `sub`, so the only thing this answers is whether the emitter may stay
   * silent. Nothing narrows implicitly, which is why the question is asked in one direction.
   */
  bool isSubtypeOf(const this, string derived, string base) {
    if (derived == base) { return true; }
    // **`anyref` is above everything**, which is the one relation that needs no chain: a struct, an
    // array, a string and an `i31ref` are all one, and a `funcref` is *not* — function references
    // are their own hierarchy in the format and cannot be stored in an `anyref`.
    if (base == "anyref") { return isArrayType(derived) || derived == "string" ||
                                   this.isStructName(derived) || derived == "i31ref"; }
    string p = this.parentOf(derived);
    return p == "" ? false : this.isSubtypeOf(p, base);
  }

  /**
   * A method's slot, looked up **through the parent chain**.
   *
   * The child's own is found first, which is what makes `override` work — and makes it work the way
   * the language says: dispatch is by the *static* type, because this lookup is handed the type the
   * call site knows and there is no vtable anywhere to disagree with it. Statics do not come this
   * way: `Rect.create` is an error when only `Shape` declares one.
   */
  i32 methodAt(const this, string owner, string name) {
    i32 at = this.funcAt(owner + "." + name);
    if (at >= 0) { return at; }
    string p = this.parentOf(owner);
    return p == "" ? -1 : this.methodAt(p, name);
  }

  /** A struct's parent, or `""`. */
  string parentOf(const this, string owner) {
    for (i32 i = 0; i < this.structCount; i++) {
      if (this.structNames[i] == owner) { return this.structParents[i]; }
    }
    return "";
  }

  /**
   * How many fields a struct inherits — the offset every one of its own fields sits at.
   *
   * **A subtype's fields are its parent's followed by its own**, which is not this emitter's choice:
   * wasm requires a subtype to repeat its supertype's fields in order before appending, so that a
   * `struct.get` compiled against the parent reads the same slot on a child. The whole of inheritance
   * here is that one offset, applied by every accessor below.
   */
  i32 inheritedCount(const this, string owner) {
    string p = this.parentOf(owner);
    return p == "" ? 0 : this.fieldCountOf(p);
  }

  /** Which of a struct's fields this is, in declaration order, or -1. */
  i32 fieldIndex(const this, string owner, string field) {
    i32 base = this.inheritedCount(owner);
    i32 n = 0;
    for (i32 i = 0; i < this.fieldCount; i++) {
      if (this.fieldOwners[i] != owner) { continue; }
      if (this.fieldNames[i] == field) { return base + n; }
      n = n + 1;
    }
    return base == 0 ? -1 : this.fieldIndex(this.parentOf(owner), field);
  }

  /** How many fields a struct has, which decides whether a bare `P()` is a default construction. */
  i32 fieldCountOf(const this, string owner) {
    i32 n = this.inheritedCount(owner);
    for (i32 f = 0; f < this.fieldCount; f++) {
      if (this.fieldOwners[f] == owner) { n = n + 1; }
    }
    return n;
  }

  /** Whether the `i`th field admits null, which decides whether its default is one. */
  bool fieldNullableAt(const this, string owner, i32 i) {
    i32 base3 = this.inheritedCount(owner);
    if (i < base3) { return this.fieldNullableAt(this.parentOf(owner), i); }
    i32 n = base3;
    for (i32 f = 0; f < this.fieldCount; f++) {
      if (this.fieldOwners[f] != owner) { continue; }
      if (n == i) { return this.fieldNullable[f]; }
      n = n + 1;
    }
    return false;
  }

  /** The `i`th field's name, which is what a bind accessor is called after. */
  string fieldNameAt(const this, string owner, i32 i) {
    i32 baseN = this.inheritedCount(owner);
    if (i < baseN) { return this.fieldNameAt(this.parentOf(owner), i); }
    i32 n = baseN;
    for (i32 f = 0; f < this.fieldCount; f++) {
      if (this.fieldOwners[f] != owner) { continue; }
      if (n == i) { return this.fieldNames[f]; }
      n = n + 1;
    }
    return "";
  }

  /** The `i`th field's type, for a positional construction. */
  string fieldTypeAt(const this, string owner, i32 i) {
    i32 base4 = this.inheritedCount(owner);
    if (i < base4) { return this.fieldTypeAt(this.parentOf(owner), i); }
    i32 n = base4;
    for (i32 f = 0; f < this.fieldCount; f++) {
      if (this.fieldOwners[f] != owner) { continue; }
      if (n == i) { return this.fieldTypes[f]; }
      n = n + 1;
    }
    return "";
  }

  /** A function's `i`th parameter type, so an argument knows what slot it fills. */
  string paramTypeAt(const this, i32 at, i32 i) {
    if (at < 0 || at >= this.funcCount || i >= this.funcParamCount[at]) { return ""; }
    i32 slot = this.funcParamAt[at] + i;
    // A flat table that filled up stops *writing* and keeps counting, so the count can outrun what
    // was stored. Reading past it is an out-of-bounds trap in the middle of emitting, which is how a
    // corpus file with more parameters than this had room for showed up.
    if (slot >= this.funcParamTotal) { return ""; }
    return this.funcParamTypes[slot];
  }

  /** Record a function, with its parameters, in the order the calls will index them. */
  void addFunc(this, string name, string ret, string[] ptypes) {
    if (this.funcCount >= this.funcs.len()) {
      this.ranOut("functions");
      return;
    }
    this.funcs[this.funcCount] = name;
    this.funcReturns[this.funcCount] = ret;
    this.funcParamAt[this.funcCount] = this.funcParamTotal;
    this.funcParamCount[this.funcCount] = ptypes.len();
    for (i32 i = 0; i < ptypes.len(); i++) {
      if (this.funcParamTotal >= this.funcParamTypes.len()) {
        // A parameter this table has no room for makes `paramTypeAt` answer `""` for it, and an
        // unknown slot type is how a literal argument becomes an `i32.const` in a reference slot.
        this.ranOut("function parameters");
        break;
      }
      this.funcParamTypes[this.funcParamTotal] = ptypes[i];
      this.funcParamTotal = this.funcParamTotal + 1;
    }
    // Assumed emittable until something says otherwise, which is what the fixed point below removes.
    this.funcOk[this.funcCount] = true;
    this.funcIndex[this.funcCount] = -1;
    this.funcCount = this.funcCount + 1;
  }

  /** A field's wac type, which decides how it is read and what it produces. */
  string fieldType(const this, string owner, string field) {
    for (i32 i = 0; i < this.fieldCount; i++) {
      if (this.fieldOwners[i] == owner && this.fieldNames[i] == field) { return this.fieldTypes[i]; }
    }
    string p2 = this.parentOf(owner);
    return p2 == "" ? "" : this.fieldType(p2, field);
  }

  /**
   * An empty environment, with the capacities in one place rather than in three call sites.
   *
   * They were three identical lists of forty-three arguments, which is how the last two fields added
   * here cost three edits each and one of them was found by a type error rather than by reading.
   */
  /**
   * The callback signatures a host has to supply — one imported dispatcher each.
   *
   * `export i32 g(fn[i32(i32)] cb)` cannot be called from JavaScript at all without one: a host
   * function has no way into wac, and the module the reference emits imports `wac.cb0` for exactly
   * this. Collected before anything is numbered, because **an import comes first in the function
   * index space** and every index this emitter computes is measured from it. `issues/lang/0094`.
   */
  string[] cbSigs;
  i32 cbSigCount;

  /**
   * The type each field was *written* with, kept until every declaration exists.
   *
   * A field's type is resolved by name, and a name from another file can only be resolved once that
   * file's declarations are registered — which is not true while this pass is walking. The parent
   * chain has had this treatment since it was written (`structParentToks`); a field's type
   * needed it for the same reason and did not have it, so `struct Repo { FsType fs; }` — where
   * `FsType` is `import { Fs as FsType }` — resolved to nothing and fell back to `i32`.
   * `issues/lang/0097`, `spec/cases/0096`.
   */
  Ty?[] fieldTys;

  /**
   * What each file in the link order was called, by file index.
   *
   * Only the boundary needs it: a monomorphisation's bind name is the reference's, and the reference
   * qualifies a template by its declaring file. Everything else here is keyed by `declare`, which
   * needs no path at all. `issues/lang/0089`.
   */
  string[] filePaths;

  /**
   * Why each function was declined, or `""`.
   *
   * A decline cascades — `Shell.create` is declined because `runScript` is, which is declined
   * because `runList` is — and the report named only the first hop, which is the least useful end
   * of the chain. Recorded per function so a message can carry the reason underneath it.
   */
  string[] funcWhy;
  /** The reason the last `canEmit` gave, which is how `settleEmittable` learns it. */
  string lastWhy;

  /**
   * `--checked`: add/sub/mul trap instead of wrapping.
   *
   * Whole-module, as the reference has it — the flag is the build's, not a type's — and off by
   * default, where the bytes must be exactly what they were.
   */
  bool checked;

  /**
   * Coverage instrumentation: a counter per branch point, and the table that says what each is.
   *
   * `covCount` is assigned as the points are discovered — emission order *is* the numbering, which
   * is why the table is built in the same walk rather than derived afterwards. Global 0 holds the
   * counters when this is on, so every constant's global index shifts by one, exactly as an import
   * shifts every function's.
   */
  bool coverage;
  i32 covCount;
  string covTable;

  /** The funcref signatures handed out, one `$bind$callref_<j>` each. */
  string[] outSigs;
  i32 outSigCount;

  /**
   * A monomorphisation's other names — the spellings that collapse onto one instance here.
   *
   * `T?` and `T` are the same *wasm* type, so `Pending<u8[]?>` and `Pending<u8[]>` are one
   * instantiation to this emitter, which is right for emission and wrong at the boundary: a host
   * asks for `Pending$u8ArrOpt` by name and there is nothing of that name to answer with. The
   * identity stays collapsed — two structs with one layout would be a worse lie — and the metadata
   * carries the alias instead, so the glue can offer both names for the one class [issue 0106].
   */
  string[] aliasOf;
  string[] aliasName;
  i32 aliasCount;

  /**
   * Which table ran out, when one did.
   *
   * `full` alone means "this module was declined", and every caller then reported the *consequence*
   * — a decline chain seven calls deep, or an import that was said not to be supplied. Four separate
   * capacity limits were found in one night that way, each of them looking like a different bug.
   * Saying which table is the difference between a mystery and a number to change.
   */
  string fullWhy;

  /**
   * Trace mode: coverage's machinery recording an ordered *journal* rather than counts.
   *
   * It is `coverage` with two differences, and it is declared here rather than beside it because the
   * constructor is positional and a field in the middle renumbers every argument after it.
   *
   *   - a point appends `(site, value)` to the log instead of incrementing a counter, and
   *   - every array **index** is a point too, with the index as its value.
   *
   * The second is what the mode is for: a secret-dependent branch is a leak that branch coverage
   * sees, and a secret-dependent *index* — `SBOX[key]` — has no branch at all and is how AES keys
   * have been recovered from cache timing since 2005. `harness/ctTrace.ts` compares two runs.
   */
  bool trace;

  /** How many i32 slots the journal gets, or 0 for the default. `issues/lang/0059`. */
  i32 traceSlots;

  /** How many of the blob's declarations are the entry's, or -1 for a single file. */
  i32 entryDecls;

  /**
   * The `fn[…]` wrappers, built as each function is emitted — `design/lang/0002`.
   *
   * Two buffers rather than a list of anything, because they are appended to `funcs` and `code`
   * whole once every other helper is written: a wrapper's index has to fall after all of them.
   *
   * Filled from `emitFunction`, which is the one place every emitted function passes through — so
   * the set is exactly the emitted functions and the order is exactly the emission order. A previous
   * attempt built this list from `funcCount`/`funcIndex` instead, which is different bookkeeping that
   * lines up most of the time; `emit.wac` already carries a comment about the fifty-seven invalid
   * modules the same mistake produced somewhere else.
   */
  /**
   * Which signature entries are env-shaped and must **not** be given a pair of their own.
   *
   * `envSig(t)` is itself a `fn[…]`, so a sweep that pairs every funcref entry would pair it, then
   * pair *its* env-shape, without end. A flag rather than a test on the string: `fn[bool(anyref)]`
   * is a real user type — `Shell.askInterrupt` is exactly that — so "first parameter is anyref"
   * cannot tell the two apart.
   */
  bool[] sigNoPair;
  B wrapFuncs;
  B wrapCode;
  i32 wrapCount;
  /** The bound wrappers — the same, with the env cast to a receiver instead of dropped. */
  B boundFuncs;
  B boundCode;
  /** Where they start, so a bound reference can name one. */
  i32 boundAt;
  /** Where the wrappers start, so a `ref.func` site can name one. Set before any function is emitted. */
  i32 wrapAt;

  /** Record the first table to fill; the first is the one that caused the rest. */
  void ranOut(this, string what) { this.declineFor("the emitter ran out of room for " + what); }

  /**
   * Decline this module, saying why.
   *
   * `full` is the flag every caller already reads, so this sets it — the field is named for its
   * first cause and means "declined" in practice. What matters is that a reason travels with it:
   * without one, a caller reports whichever *declaration* looks unsatisfiable, and the reader ends
   * up chasing the seventh call in a chain rather than the cause.
   */
  void declineFor(this, string why) {
    this.full = true;
    if (this.fullWhy == "") { this.fullWhy = why; }
  }

  /** Record that `spelled` is another way of writing the instantiation `identity`. */
  void noteAlias(this, string identity, string spelled) {
    if (identity == spelled) { return; }
    for (i32 i = 0; i < this.aliasCount; i++) {
      if (this.aliasOf[i] == identity && this.aliasName[i] == spelled) { return; }
    }
    if (this.aliasCount >= this.aliasOf.len()) { return; }
    this.aliasOf[this.aliasCount] = identity;
    this.aliasName[this.aliasCount] = spelled;
    this.aliasCount = this.aliasCount + 1;
  }

  Env create() {
    return Env(string[2048](), string[2048](), 0, 0, 0, -1, -1, string[1024](), 0, string[16384](), 0,
               string[256](), string[256](), 0, "", "", string[64](), 0, string[512](), string[512](), 0, false,
               "", "",
               string[512](), i32[512](), string[512](), Expr?[512](), 0,
               string[1024](), 0,
               string[16384](), string[16384](), string[16384](), bool[16384](), 0,
               string[4096](), string[4096](), string[16384](), i32[4096](), i32[4096](), 0,
               bool[4096](), i32[4096](), 0,
               i32[512](), 0, i32[4096](), i32[4096](), string[4096](), string[4096](), 0,
               string[8192](), i32[8192](), string[8192](), 0,
               string[2048](), string[2048](), i32[2048](), i32[2048](), i32[2048](), 0, false, false, "",
               string[1024](), i32[1024](), null, false, string[4096](),
               string[256](), 0, Ty?[16384](), string[512](), string[16384](), "", false,
               false, 0, "", string[256](), 0,
               string[256](), string[256](), 0, "", false, 0, -1,
               bool[16384](), B.create(), B.create(), 0, B.create(), B.create(), 0, 0);
  }

  /** Which linked file a line belongs to; 0 when nothing was linked. */
  i32 fileOf(const this, i32 line) {
    i32 at = 0;
    for (i32 i = 0; i < this.fileCount; i++) {
      if (this.fileFirstLine[i] <= line) { at = i; }
    }
    return at;
  }

  /**
   * Register a top-level name, and answer with the key everything else will use for it.
   *
   * The first declaration of a name keeps the name itself, so a single-file module — and every
   * reference in every file that imported this one — is unchanged. A second file declaring the same
   * name gets a key nothing else can spell.
   */
  string declare(this, string name, i32 line) {
    i32 f = this.fileOf(line);
    bool taken = false;
    for (i32 i = 0; i < this.declCount; i++) {
      if (this.declNames[i] == name) { taken = true; }
    }
    string key = name;
    if (taken) { key = name + "@" + numText(f); }
    if (this.declCount >= this.declNames.len()) { this.ranOut("declarations"); }
    if (this.declCount < this.declNames.len()) {
      this.declNames[this.declCount] = name;
      this.declFiles[this.declCount] = f;
      this.declKeys[this.declCount] = key;
      this.declCount = this.declCount + 1;
    }
    return key;
  }

  /**
   * Is this name declared in more than one file?
   *
   * The key may carry the `@<file>` a second declaration was given, and the question is about the
   * *name* — so both `S` and `S@2` answer yes when two modules declare an `S`. What the bind helpers
   * do with that is qualify both of them by their file rather than leave the first one holding a
   * name that would mean either [issue 0100].
   */
  bool ambiguousDecl(this, string key) {
    string bare = key;
    i32 at = key.indexOf("@");
    if (at > 0) { bare = key.slice(0, at); }
    i32 n = 0;
    for (i32 i = 0; i < this.declCount; i++) {
      if (this.declNames[i] == bare) { n = n + 1; }
    }
    return n > 1;
  }

  /**
   * The key a name means when it is *used* at this line: this file's declaration, or anyone's.
   *
   * The fallback is deliberately permissive — a file here can see a name it never imported — which
   * is the same trade linking by concatenation already made, and safe in the same direction: this
   * emitter accepts more than the language does and the checker one rung down says no.
   */
  string keyAt(this, string name, i32 line) {
    // **A local shadows every file in the module, so it is not an ambiguous global.** Callers reach
    // here speculatively — `ch.toBytes()` asks whether `ch` names a type before deciding it does not
    // — and a speculative question whose answer is discarded must not leave the module unemittable.
    if (this.localAt(name) >= 0) { return name; }
    i32 f = this.fileOf(line);
    // This file's own declaration first — shadowing, as the language has it.
    for (i32 i = 0; i < this.declCount; i++) {
      if (this.declNames[i] == name && this.declFiles[i] == f) { return this.declKeys[i]; }
    }
    // Then **the import that names it**. `import { p } from "./a.wac"` says where `p` comes from,
    // exactly, and using it is the difference between resolving a name and guessing at it — this is
    // the language's own rule rather than an approximation of it.
    for (i32 e = 0; e < this.importCount; e++) {
      if (this.importFrom[e] != f || this.importNames[e] != name) { continue; }
      for (i32 i = 0; i < this.declCount; i++) {
        if (this.declNames[i] == this.importDecls[e] && this.declFiles[i] == this.importTo[e]) {
          return this.declKeys[i];
        }
      }
    }
    // Then a file this one imports, whatever it named — a type reached through another type is not
    // in anybody's import list, and **only if exactly one of them has it**, since the file-level
    // answer is a guess whenever two of them do.
    string imported = "";
    i32 importedCandidates = 0;
    for (i32 i = 0; i < this.declCount; i++) {
      if (this.declNames[i] != name) { continue; }
      for (i32 e = 0; e < this.importCount; e++) {
        if (this.importFrom[e] != f || this.importTo[e] != this.declFiles[i]) { continue; }
        if (imported != this.declKeys[i]) { importedCandidates = importedCandidates + 1; }
        imported = this.declKeys[i];
      }
    }
    if (importedCandidates > 1) {
      this.ambiguous = true;
      if (this.ambiguousName == "") { this.ambiguousName = name; }
    }
    if (imported != "") { return imported; }
    // And then anyone — but **only when there is one candidate**. Reaching a name a file neither
    // declares nor imports is the permissive part of linking, and it is safe exactly while the
    // answer is unambiguous. With two files declaring `P`, picking either is a guess, and the guess
    // shows up as *"expected (ref null 1), got (ref null 7)"* in a third file that mentions neither.
    string found = "";
    i32 candidates = 0;
    for (i32 i = 0; i < this.declCount; i++) {
      if (this.declNames[i] != name) { continue; }
      if (found != this.declKeys[i]) { candidates = candidates + 1; }
      found = this.declKeys[i];
    }
    if (candidates > 1) {
      this.ambiguous = true;
      if (this.ambiguousName == "") { this.ambiguousName = name; }
    }
    return found == "" ? name : found;
  }

  /** The enum a variant belongs to, or `""` — which is also the question "is this a variant". */
  string enumOf(const this, string variant) {
    for (i32 i = 0; i < this.variantCount; i++) {
      if (this.variantNames[i] == variant) { return this.variantOwners[i]; }
    }
    return "";
  }

  /** Whether a name is an enum's own name, which is what a construction is qualified by. */
  bool isEnumName(const this, string name) {
    for (i32 i = 0; i < this.variantCount; i++) {
      if (this.variantOwners[i] == name) { return true; }
    }
    return false;
  }

  /** Where a variant is in the table, so its tag, slot and arity come from one lookup. */
  /**
   * The key of `owner`'s variant written `written`, or `""`.
   *
   * **A variant is resolved inside its enum, not through the file.** `Kind.Tree` asked the name
   * table what `Tree` meant and got `packages/git/src/tree.wac`'s *struct* — the key a second
   * declaration of a name is given — so the qualified form stopped being a variant construction at
   * all, and the walk fell through to reading `Kind` as a value: *unresolved name Kind*. The `@` in
   * a shadowed key cannot appear in an identifier, so matching the prefix is exact.
   * `spec/cases/0099`.
   */
  string variantKeyIn(const this, string owner, string written) {
    for (i32 i = 0; i < this.variantCount; i++) {
      if (this.variantOwners[i] != owner) { continue; }
      if (this.variantNames[i] == written) { return this.variantNames[i]; }
      if (this.variantNames[i].len() > written.len() &&
          this.variantNames[i].slice(0, written.len() + 1) == written + "@") {
        return this.variantNames[i];
      }
    }
    return "";
  }

  i32 variantAt(const this, string variant) {
    for (i32 i = 0; i < this.variantCount; i++) {
      if (this.variantNames[i] == variant) { return i; }
    }
    return -1;
  }

  /**
   * A type name as the *type section* knows it: a variant and its enum are one struct.
   *
   * Everywhere a wac type name reaches wasm — a local's declaration, a field, a parameter — it goes
   * through here first, so `Circle c` and `Shape s` are the same wasm type and neither needs a cast
   * to become the other.
   */
  string canonType(const this, string name) {
    string e = this.enumOf(name);
    return e == "" ? name : e;
  }

  void addLocal(this, string name, string ty) {
    if (this.localCount >= this.locals.len()) {
      this.ranOut("locals in one function");
      return;
    }
    this.locals[this.localCount] = name;
    this.localTypes[this.localCount] = ty;
    this.localCount = this.localCount + 1;
  }
}

/** Whether a declaration is a function this slice can emit. */
bool emittable(Decl d) {
  match (d.kind) {
    case Func(nameTok, returnType, params, body, exported, typeParams): {
      return typeParams.len() == 0;
    }
    else: { return false; }
  }
}

/** Every array type a body mentions, whether as a local's type or as something it constructs. */
void collectArrayTypes(Env env, u8[] src, Lexed lexed, Stmt[] body) {
  for (i32 i = 0; i < body.len(); i++) {
    match (body[i].kind) {
      case Var(type, nameTok, init, isConst): {
        registerNamed(env, typeOfTyName(env, src, lexed, type));
        collectArrayTypesOfExpr(env, src, lexed, init);
      }
      // **The expressions too.** This walk looked only at what a `var` *declared*, so a type named
      // by a construction, a cast or an argument was invisible until the moment it was emitted —
      // which is one type past the end of a section already written.
      case ExprStmt(e2): { collectArrayTypesOfExpr(env, src, lexed, e2); }
      case Return(value): {
        if (!(value is null)) { collectArrayTypesOfExpr(env, src, lexed, value!); }
      }
      case Assign(target, op, rhs): { collectArrayTypesOfExpr(env, src, lexed, rhs); }
      case Block(inner): { collectArrayTypes(env, src, lexed, inner); }
      case If(cond, then, els): {
        collectArrayTypesOfExpr(env, src, lexed, cond);
        collectArrayTypes(env, src, lexed, then);
        collectArrayTypes(env, src, lexed, els);
      }
      case While(cond, inner): {
        collectArrayTypesOfExpr(env, src, lexed, cond);
        collectArrayTypes(env, src, lexed, inner);
      }
      case DoWhile(inner, cond): {
        collectArrayTypesOfExpr(env, src, lexed, cond);
        collectArrayTypes(env, src, lexed, inner);
      }
      case For(init, cond, update, inner): {
        if (!(init is null)) { collectArrayTypes(env, src, lexed, Stmt[](init!)); }
        if (!(cond is null)) { collectArrayTypesOfExpr(env, src, lexed, cond!); }
        if (!(update is null)) { collectArrayTypes(env, src, lexed, Stmt[](update!)); }
        collectArrayTypes(env, src, lexed, inner);
      }
      case Switch(subject, cases): {
        collectArrayTypesOfExpr(env, src, lexed, subject);
        for (i32 c = 0; c < cases.len(); c++) {
          if (!(cases[c].value is null)) {
            collectArrayTypesOfExpr(env, src, lexed, cases[c].value!);
          }
          collectArrayTypes(env, src, lexed, cases[c].body);
        }
      }
      // **An arm is a block.** The enum spec says five separate walks were missing this case, and
      // each failure was a type or a name reachable only through an arm — invisible here, and
      // reported by wasm as something else entirely.
      case Match(subject, arms): {
        collectArrayTypesOfExpr(env, src, lexed, subject);
        for (i32 a = 0; a < arms.len(); a++) { collectArrayTypes(env, src, lexed, arms[a].body); }
      }
      else: { }
    }
  }
}

/**
 * Every local a body declares, in the order wasm will number them.
 *
 * Collected before anything is emitted, exactly as the checker collects names before walking a body,
 * and for a related reason: the locals *declaration* comes before the code that uses them, so the
 * count has to be known first. Nested blocks contribute theirs — wasm has one flat frame per
 * function, whatever the language's scopes look like.
 */
void collectLocals(Env env, u8[] src, Lexed lexed, Stmt[] body) {
  for (i32 i = 0; i < body.len(); i++) {
    match (body[i].kind) {
      case Var(type, nameTok, init, isConst): {
        env.addLocal(tokenTextOf(src, lexed, nameTok), typeOfTyName(env, src, lexed, type));
      }
      case Block(inner): { collectLocals(env, src, lexed, inner); }
      case If(cond, then, els): {
        collectLocals(env, src, lexed, then);
        collectLocals(env, src, lexed, els);
      }
      case While(cond, inner): { collectLocals(env, src, lexed, inner); }
      case DoWhile(inner, cond): { collectLocals(env, src, lexed, inner); }
      case For(init, cond, update, inner): {
        if (!(init is null)) {
          match (init!.kind) {
            case Var(type, nameTok, ini, isConst): {
              env.addLocal(tokenTextOf(src, lexed, nameTok), typeOfTyName(env, src, lexed, type));
            }
            else: { }
          }
        }
        collectLocals(env, src, lexed, inner);
      }
      // An arm's *bindings* are not collected here — they are added while the arm is emitted and
      // retired after it, which is what makes them arm-scoped. Its `var`s are ordinary locals and
      // have to be, or a declaration inside an arm has no slot and every use of it reads whatever
      // slot 0 happens to hold.
      case Match(subject, arms): {
        for (i32 a = 0; a < arms.len(); a++) { collectLocals(env, src, lexed, arms[a].body); }
      }
      else: { }
    }
  }
}

/** The last `/` in a path, or -1 — the one piece of path arithmetic everything else here needs. */
i32 lastSlash(string path) {
  for (i32 i = path.len() - 1; i >= 0; i--) {
    if (path[i] == "/") { return i; }
  }
  return -1;
}

/**
 * The file an import names, resolved against the file that wrote it.
 *
 * Only the two spellings a wac import uses — `./x.wac` and `../y/z.wac` — because a path with no
 * prefix is not a file import at all but a capability, and those are declined by name.
 */
export string resolveImport(string from, string rel) {
  string dir = from.slice(0, lastSlash(from) + 1);
  string r = rel;
  for (i32 guard = 0; guard < 64; guard++) {
    if (r.len() >= 2 && r.slice(0, 2) == "./") {
      r = r.slice(2, r.len());
      continue;
    }
    if (r.len() >= 3 && r.slice(0, 3) == "../") {
      r = r.slice(3, r.len());
      // Up one: drop the trailing slash, then everything after the one before it.
      dir = dir.slice(0, dir.len() - 1);
      dir = dir.slice(0, lastSlash(dir) + 1);
      continue;
    }
    return joinDir(dir, r);
  }
  return joinDir(dir, r);
}

/**
 * `dir` (which ends in `/`, or is empty) followed by `r`, with one separator between them.
 *
 * Concatenating them plainly doubles the slash when the path is already rooted: `/main.wac`
 * importing `"/c.wac"` resolved to `//c.wac`, which is a key no file in the program map has. Nothing
 * reported that, because a name whose file never resolved is a name this checker does not know, and
 * unknown is silence — so an entire imported file went missing quietly, and the spec's own
 * `§wac-modconst-import-p7fm2wj` was accepted for want of the file that would have refused it.
 */
string joinDir(string dir, string r) {
  if (dir.len() > 0 && r.len() > 0 && dir.slice(dir.len() - 1, dir.len()) == "/"
      && r.slice(0, 1) == "/") {
    return dir + r.slice(1, r.len());
  }
  return dir + r;
}

/**
 * `core`'s declarations, which ship inside the compiler rather than living in a file.
 *
 * `import { Read } from core;` is not a path — `core` is one thing everywhere, because wac has
 * nominal types and no closures, so two declarations of a shape are two types and no adapter can
 * join them across a repository boundary. The reference embeds this text; so does this, and for the
 * same reason: a capability import is then an ordinary declaration and nothing downstream of the
 * linker has to know it was special.
 *
 * Kept to the declarations. The comments in `compiler/wacCore.ts` are the argument for the type
 * existing, and are not what a compiler needs.
 */
export string coreSource() {
  return "export enum Read {\n" +
         "  Data(u8[] bytes),\n" +
         "  End,\n" +
         "  Failed(string why)\n" +
         "}\n" +
         // **The tree JSX builds**, which is why it is here rather than in a package: the compiler
         // emits the constructor calls, so a tree built in one repository and a renderer in another
         // must name one type or nothing composes — and no author chose the name to be able to fix
         // it. `design/lang/0004`. wacc-only for now; `compiler/README.md` records the omission.
         "export struct Attr {\n" +
         "  string name;\n" +
         "  string value;\n" +
         "}\n" +
         // **`Fragment` is a variant rather than an element with an empty tag**, so that a renderer
         // is *told*: `match` is exhaustive, and a walk written before fragments existed stops
         // compiling with the arm it is missing named. An empty tag would have rendered as `<>`
         // in every renderer that had not heard of them. `design/lang/0006`.
         "export enum Node {\n" +
         "  Element(string tag, Attr[] attrs, Node[] kids),\n" +
         "  Text(string text),\n" +
         "  Fragment(Node[] kids)\n" +
         "}\n";
}

/** A file's text from the table the caller supplied, or `""` when it was not supplied. */
export string sourceOf(string[] paths, string[] sources, string path) {
  for (i32 i = 0; i < paths.len(); i++) {
    if (paths[i] == path) { return sources[i]; }
  }
  return "";
}

/**
 * The entry and everything it imports, transitively, in one buffer with the entry first.
 *
 * **Linking by concatenation**, which is available because of how this emitter already works: every
 * declaration in the module is collected before any function is emitted, so a name declared in
 * another file is reached exactly as one declared further down the same file is. What that gives up
 * is per-file scope — a file here can see a name it never imported — and giving it up is safe in one
 * direction only: this emitter *accepts* more than the language does, and the checker one rung down
 * is what says no. It could not make a program mean something different.
 *
 * The entry goes first so that the decls belonging to it are a prefix, which is what decides who may
 * be exported: the module's exports are the entry's, and an imported file's `export` marks a name as
 * reachable across files rather than as a wasm export.
 *
 * `""` means a file was named that the caller did not supply — the one failure this cannot paper
 * over, since the missing declarations would otherwise look merely undefined.
 */
/** How many newlines a source has, which is what its span in the linked blob costs. */
i32 countLines(string s) {
  u8[] b = s.toBytes();
  i32 n = 0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] == 10) { n = n + 1; }
  }
  return n;
}

string linkFiles(string[] paths, string[] sources, string entry, i32[] starts, i32[] edges,
                 string[] names, string[] filePaths) {
  // **Sized for the largest program here, which is `packages/box` at 168 files and climbing.** These
  // were 256 and 1024, and a program that outgrew them was reported as *"an import of a file that
  // was not supplied"* — the same `return ""` a genuinely missing file takes, so the message named
  // the wrong cause and six of box's programs looked like they had a broken import [issue 0106].
  string[] queue = string[1024]();
  string[] seen = string[1024]();
  // The import edges, by path: a file is imported before it has an index, so the pairs are recorded
  // as they are read and turned into indices once every file has one.
  string[] fromPath = string[8192]();
  string[] toPath = string[8192]();
  string[] edgeName = string[8192]();
  i32 en = 0;
  i32 qn = 1;
  i32 sn = 0;
  queue[0] = entry;
  string out = "";
  for (i32 qi = 0; qi < qn; qi++) {
    string path = queue[qi];
    bool dup = false;
    for (i32 i = 0; i < sn; i++) {
      if (seen[i] == path) { dup = true; }
    }
    if (dup) { continue; }
    if (sn >= seen.len()) { return ""; }
    seen[sn] = path;
    sn = sn + 1;
    string body = path == " core" ? coreSource() : sourceOf(paths, sources, path);
    if (body == "") { return ""; }
    // A newline between files, so a file that ends mid-line cannot join itself to the next one —
    // and the line each file begins on, which is the whole of how a name is scoped to it afterwards.
    if (starts.len() > sn) { starts[sn] = countLines(out) + 1; }
    // **And what the file was called.** The line boundaries say which file a declaration came from
    // and nothing said what its name was, which is the whole of what a bind name for a
    // monomorphisation needs: the reference spells `Vec<string>` from `packages/std/src/vec.wac` as
    // `Vec__packages_std_src_vec$string`. `issues/lang/0089`.
    if (filePaths.len() > sn - 1) { filePaths[sn - 1] = path; }
    out = out + body + "\n";
    u8[] b = body.toBytes();
    Lexed lexed = lex(b);
    P p = P.create(b, lexed.tokens, lexed.tokenCount);
    Program prog = parseProgram(p);
    for (i32 d = 0; d < prog.decls.len(); d++) {
      match (prog.decls[d].kind) {
        case Import(pathTok, prefixTok, items): {
          // A capability import names no file, so it cannot be resolved into one — it is *carried*
          // instead, under a path no source can spell, which makes it a file to everything below.
          if (prefixTok >= 0) {
            if (tokenTextOf(b, lexed, prefixTok) != "core") { continue; }
            if (qn >= queue.len()) { return ""; }
            queue[qn] = " core";
            qn = qn + 1;
            for (i32 it = 0; it < items.len(); it++) {
              if (en >= fromPath.len()) { continue; }
              fromPath[en] = path;
              toPath[en] = " core";
              edgeName[en] = tokenTextOf(b, lexed, items[it].aliasTok) + " " +
                             tokenTextOf(b, lexed, items[it].nameTok);
              en = en + 1;
            }
            continue;
          }
          string quoted = tokenTextOf(b, lexed, pathTok);
          if (quoted.len() < 2) { continue; }
          if (qn >= queue.len()) { return ""; }
          string target = resolveImport(path, quoted.slice(1, quoted.len() - 1));
          queue[qn] = target;
          qn = qn + 1;
          // The edge is recorded by *path*, and turned into file indices once every file has one:
          // an import often names a file this walk has not reached yet.
          // One edge per *name*, plus one for the file itself, so a type reached through another
          // file's declaration still resolves.
          if (en < fromPath.len()) {
            fromPath[en] = path;
            toPath[en] = target;
            edgeName[en] = "";
            en = en + 1;
          }
          for (i32 it = 0; it < items.len(); it++) {
            if (en >= fromPath.len()) { continue; }
            fromPath[en] = path;
            toPath[en] = target;
            // The alias and the declared name travel together, separated by a space that no
            // identifier can contain — the same trick the synthesized helpers' names use.
            edgeName[en] = tokenTextOf(b, lexed, items[it].aliasTok) + " " +
                           tokenTextOf(b, lexed, items[it].nameTok);
            en = en + 1;
          }
        }
        else: { }
      }
    }
  }
  // Paths to indices, now that `seen` is complete.
  edges[0] = 0;
  for (i32 e = 0; e < en; e++) {
    i32 a = -1;
    i32 b = -1;
    for (i32 i = 0; i < sn; i++) {
      if (seen[i] == fromPath[e]) { a = i; }
      if (seen[i] == toPath[e]) { b = i; }
    }
    if (a < 0 || b < 0) { continue; }
    i32 ec = edges[0];
    // **Losing an edge here is not losing an edge.** `import { Host } from "./host.wac"` is the only
    // thing that says which file `Host` means; drop it and the name falls through to the permissive
    // module-wide lookup, which finds another file's `Backing.Host`, calls the name ambiguous, and
    // declines the whole module. `packages/box` needs 2,236 of these and the table held 2,047, so
    // six programs emitted eight bytes and blamed a call seven levels down [issue 0106]. Failing the
    // link is loud; the quiet `continue` that used to be here is what made it take a night.
    if (ec * 2 + 2 >= edges.len() || ec >= names.len()) { return ""; }
    edges[ec * 2 + 1] = a;
    edges[ec * 2 + 2] = b;
    names[ec] = edgeName[e];
    edges[0] = ec + 1;
  }
  return out;
}

/** How many declarations the entry file contributes, which is how far the exports reach. */
i32 declCountOf(string source) {
  u8[] b = source.toBytes();
  Lexed lexed = lex(b);
  P p = P.create(b, lexed.tokens, lexed.tokenCount);
  return parseProgram(p).decls.len();
}

/**
 * A module for the functions this slice understands.
 *
 * Four sections and no more: types, functions, exports, code. No memory, no globals, no tables —
 * none of which an `i32` calculation needs, and each of which is a section that can be added when
 * something needs it rather than because a real module usually has one.
 */
export u8[] emitModule(u8[] src) {
  return emitModuleOf(src, -1, i32[1](), i32[1](), string[1](), string[1]());
}

/**
 * Whether emitting would register a type the section was already sized without.
 *
 * Asked by running the emitter and looking at what came back: a module of eight bytes with nothing
 * else wrong is that case and no other, since every other reason has already been reported by name.
 */
bool grewTypesWhileEmitting(u8[] src, i32 entryDecls, i32[] starts, i32[] edges, string[] names) {
  return emitModuleOf(src, entryDecls, starts, edges, names, string[1]()).len() == 8;
}

/**
 * One module from many files: the entry, everything it imports, and nothing else.
 *
 * The caller supplies the files because this compiler is a wasm module and has no filesystem — which
 * is the same reason the reference takes a map rather than a directory. A path it names and the
 * caller did not supply is a bare module rather than a wrong one.
 */
/**
 * The same module instrumented: a counter per branch point, and `__cov_init/_len/_get` to read them.
 *
 * The table saying what each counter *is* comes from `covTableLinked`, which emits the module and
 * throws the bytes away — the numbering is emission order, so the only way to know it is to emit.
 */
export u8[] emitLinkedCovered(string[] paths, string[] sources, string entry) {
  return emitLinkedWith2(paths, sources, entry, false, true, false);
}

/**
 * The same module instrumented for a *trace*: an ordered journal of branches and array indices.
 *
 * Coverage answers "was this reached"; this answers "in what order, and with what index" — which is
 * the question a constant-time check asks, because a secret-dependent index has no branch at all.
 * `harness/ctTrace.ts` runs a function twice with one public input and two secrets and compares.
 */
export u8[] emitLinkedTraced(string[] paths, string[] sources, string entry) {
  return emitLinkedTracedSlots(paths, sources, entry, 0);
}

/**
 * The same, with the journal sized by the caller — `slots` i32s, or 0 for the default.
 *
 * The cost is paid only by an instrumented build, which is why it is the caller's number rather than
 * a larger constant: 2^26 events is half a gigabyte, fine for a deliberate measurement and not for
 * every run. `issues/lang/0059`.
 */
export u8[] emitLinkedTracedSlots(string[] paths, string[] sources, string entry, i32 slots) {
  i32[] starts = i32[512]();
  i32[] edges = i32[65536]();
  string[] names = string[32768]();
  string[] filePaths = string[512]();
  string blob = linkFiles(paths, sources, entry, starts, edges, names, filePaths);
  if (blob == "") { return bareModule(); }
  Env env = Env.create();
  env.trace = true;
  env.traceSlots = slots;
  return emitModuleOfInto(blob.toBytes(), declCountOf(sourceOf(paths, sources, entry)), starts,
                          edges, names, filePaths, false, true, env);
}

/** `index\tline\tcol\tkind` per point, in counter order. */
export string covTableLinked(string[] paths, string[] sources, string entry) {
  i32[] starts = i32[512]();
  i32[] edges = i32[65536]();
  string[] names = string[32768]();
  string[] filePaths = string[512]();
  string blob = linkFiles(paths, sources, entry, starts, edges, names, filePaths);
  if (blob == "") { return ""; }
  Env env = Env.create();
  return covTableOf(blob.toBytes(), declCountOf(sourceOf(paths, sources, entry)), starts, edges,
                    names, filePaths, false);
}

/** `index\tline\tcol\tkind\tfile` per point of a *traced* build, which has the index points too. */
export string traceTableLinked(string[] paths, string[] sources, string entry) {
  i32[] starts = i32[512]();
  i32[] edges = i32[65536]();
  string[] names = string[32768]();
  string[] filePaths = string[512]();
  string blob = linkFiles(paths, sources, entry, starts, edges, names, filePaths);
  if (blob == "") { return ""; }
  return covTableOf(blob.toBytes(), declCountOf(sourceOf(paths, sources, entry)), starts, edges,
                    names, filePaths, true);
}

/**
 * The structs and enums a host can hold, and what it can do with them.
 *
 * The *bind set* — the same types the emitter writes helpers for, because glue for anything else
 * would call a function that is not there. Each line carries the helper's own name as well as the
 * wac one: a monomorphisation binds as `Vec__packages_std_src_vec$string`, and a generator that
 * rebuilt that spelling from the wac name would be reimplementing `mangleType` by eye.
 *
 *     S<TAB>Name<TAB>bindName<TAB>field:type,field:type
 *     E<TAB>Name<TAB>bindName<TAB>Variant:field:type|field:type;Variant:
 *     M<TAB>bindName<TAB>method<TAB>this|static<TAB>ret<TAB>param,param
 */
export string bindTypesLinked(string[] paths, string[] sources, string entry) {
  i32[] starts = i32[512]();
  i32[] edges = i32[65536]();
  string[] names = string[32768]();
  string[] filePaths = string[512]();
  string blob = linkFiles(paths, sources, entry, starts, edges, names, filePaths);
  if (blob == "") { return ""; }
  u8[] src = blob.toBytes();
  Lexed lexed = lex(src);
  P p = P.create(src, lexed.tokens, lexed.tokenCount);
  Program prog = parseProgram(p);
  Env env = Env.create();
  // **The same bound the module is emitted under.** The two halves of the boundary are computed by
  // separate walks over separate `Env`s, and a bound applied to one of them describes a module that
  // does not exist: the glue named `$bind$fnref_43` for a dispatcher the module no longer had.
  env.entryDecls = declCountOf(sourceOf(paths, sources, entry));
  for (i32 i = 0; i < starts.len(); i++) {
    if (starts[i] == 0) { continue; }
    env.fileFirstLine[env.fileCount] = starts[i];
    if (env.fileCount < env.filePaths.len() && i >= 1 && i - 1 < filePaths.len()) {
      env.filePaths[env.fileCount] = filePaths[i - 1];
    }
    env.fileCount = env.fileCount + 1;
  }
  for (i32 e = 0; e < edges[0]; e++) {
    if (env.importCount >= env.importFrom.len()) { continue; }
    env.importFrom[env.importCount] = edges[e * 2 + 1];
    env.importTo[env.importCount] = edges[e * 2 + 2];
    string pair = e < names.len() ? names[e] : "";
    i32 sp = pair.indexOf(" ");
    env.importNames[env.importCount] = sp < 0 ? pair : pair.slice(0, sp);
    env.importDecls[env.importCount] = sp < 0 ? pair : pair.slice(sp + 1, pair.len());
    env.importCount = env.importCount + 1;
  }
  collectDeclarations(env, src, lexed, prog);
  assignGlobals(env, src, lexed);
  settleEmittable(env, src, lexed, prog);

  string[] bindStructs = string[512]();
  i32 n = collectBindStructs(env, src, lexed, prog, bindStructs, env.entryDecls);
  string out = "";
  // **The callbacks, in the order the imports are numbered.** `cb0` is this line's `0`, and a host
  // that supplies its dispatchers in another order would answer the wrong callback. The same walk
  // the emitter uses, so the two cannot drift.
  env.cbSigCount = collectCallbackSigs(env, src, lexed, prog);
  env.outSigCount = collectOutSigs(env, src, lexed, prog, env.outSigs);
  for (i32 j = 0; j < env.outSigCount; j++) {
    string og = env.outSigs[j];
    string line = "O\t" + numText(j) + "\t" + sigReturn(og) + "\t";
    for (i32 i = 0; i < sigParamCount(og); i++) {
      if (i > 0) { line = line + ","; }
      line = line + sigParamAt(og, i);
    }
    out = out + line + "\t" + og + "\n";
  }
  for (i32 j = 0; j < env.cbSigCount; j++) {
    string cb = env.cbSigs[j];
    string line = "C\t" + numText(j) + "\t" + sigReturn(cb) + "\t";
    for (i32 i = 0; i < sigParamCount(cb); i++) {
      if (i > 0) { line = line + ","; }
      line = line + sigParamAt(cb, i);
    }
    out = out + line + "\t" + cb + "\n";
  }
  for (i32 i = 0; i < n; i++) {
    string name = bindStructs[i];
    // **The name the helpers were exported under.** A plain struct keeps its own — `$bind$s_Point_new`
    // — and only a monomorphisation is qualified and mangled. `collectBindStructs` holds no
    // instances, so this set is the plain half; saying `bindTypeSpelling` here would have qualified
    // every one of them and sent the glue looking for helpers nobody exported.
    //
    // The exception is a name two modules declare: those are qualified at the export sites, and
    // this has to say the same thing or the glue looks for a helper that is not there [issue 0100].
    string bind = bindNameFor(env, src, lexed, name);
    if (env.isEnumName(name)) {
      string line = "E\t" + metaTypeSpelling(env, name) + "\t" + bind + "\t";
      bool first = true;
      for (i32 v = 0; v < env.variantCount; v++) {
        if (env.variantOwners[v] != name) { continue; }
        if (!first) { line = line + ";"; }
        first = false;
        line = line + bareVariantName(env.variantNames[v]) + ":";
        for (i32 k = 0; k < env.variantArity[v]; k++) {
          if (k > 0) { line = line + "|"; }
          i32 slot = env.variantSlot[v] + k;
          line = line + payloadFieldName(env.fieldNameAt(name, slot)) + ":" +
                 metaTypeSpelling(env, env.fieldTypeAt(name, slot));
        }
      }
      out = out + line + "\n";
    } else {
      if (!bindableStruct(env, name)) { continue; }
      // `metaTypeSpelling` rather than `metaNameOf`: an instance is a *type*, and each name inside
      // it needs mapping — `Vec<Word@10>` is one key to `metaNameOf` and two names to this
      // [issue 0102].
      string line = "S\t" + metaTypeSpelling(env, name) + "\t" + bind + "\t";
      i32 fc = env.fieldCountOf(name);
      for (i32 f = 0; f < fc; f++) {
        if (f > 0) { line = line + ","; }
        line = line + env.fieldNameAt(name, f) + ":" +
               metaTypeSpelling(env, env.fieldTypeAt(name, f));
      }
      out = out + line + "\n";
    }
      // **The other names this type answers to**, one `A` line each: the identity, then a spelling
    // that collapses onto it. A host written against a compiler that keeps `T?` apart asks for
    // `Pending$u8ArrOpt`; here that is the same class as `Pending$u8Arr`, and saying so is the
    // honest way to answer [issue 0106].
    for (i32 a = 0; a < env.aliasCount; a++) {
      if (env.aliasOf[a] != name) { continue; }
      out = out + "A\t" + metaTypeSpelling(env, name) + "\t" +
            metaTypeSpelling(env, env.aliasName[a]) + "\n";
    }
  // The methods, under the names the module exports them by.
    //
    // **An instance's methods are its template's**, written in terms of type parameters — so the
    // substitution has to be pushed for the signatures to come out as `Setting` rather than as `T`.
    // The owner is the instance key either way, which is what the module registered them under.
    string tpl = isInstance(name) ? templateOf(name) : "";
    for (i32 d = 0; d < prog.decls.len(); d++) {
      match (prog.decls[d].kind) {
        case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
          if (typeParams.len() > 0) {
            if (tpl == "" || tokenTextOf(src, lexed, nameTok) != tpl) { continue; }
            i32 pushed = pushSubstitution(env, src, lexed, typeParams, name, tpl);
            out = out + methodLines(env, src, lexed, bind, name, methods);
            popSubstitution(env, pushed);
            continue;
          }
          if (nameKeyOf(env, src, lexed, nameTok) != name) { continue; }
          out = out + methodLines(env, src, lexed, bind, name, methods);
        }
        case EnumDecl(nameTok, variants, exported, methods, typeParams): {
          if (typeParams.len() > 0) {
            if (tpl == "" || tokenTextOf(src, lexed, nameTok) != tpl) { continue; }
            i32 epushed = pushSubstitution(env, src, lexed, typeParams, name, tpl);
            out = out + methodLines(env, src, lexed, bind, name, methods);
            popSubstitution(env, epushed);
            continue;
          }
          if (nameKeyOf(env, src, lexed, nameTok) != name) { continue; }
          out = out + methodLines(env, src, lexed, bind, name, methods);
        }
        else: { }
      }
    }
  }
  return out;
}

/** One `M` line per method the module actually emitted for this owner. */
string methodLines(Env env, u8[] src, Lexed lexed, string bind, string owner, Method[] methods) {
  string out = "";
  for (i32 m = 0; m < methods.len(); m++) {
    string mn = tokenTextOf(src, lexed, methods[m].nameTok);
    i32 at = env.funcAt(owner + "." + mn);
    if (at < 0 || env.funcIndex[at] < 0) { continue; }
    string line = "M\t" + bind + "\t" + mn + "\t" + (methods[m].hasThis ? "this" : "static") +
                  "\t" + metaTypeOfTy(env, src, lexed, methods[m].returnType) + "\t";
    for (i32 i = 0; i < methods[m].params.len(); i++) {
      if (i > 0) { line = line + ","; }
      line = line + metaTypeOfTy(env, src, lexed, methods[m].params[i].type);
    }
    out = out + line + "\n";
  }
  return out;
}

/**
 * What a host needs to know about a module's exports, as `name\tret\tparam,param` per line.
 *
 * The types are wac's own — `i32`, `string`, `u8[]`, a struct's name — because the generator on the
 * other side decides how each crosses, and only the compiler knows which functions are exported and
 * what they take. This is the half of bindgen that cannot live outside the compiler; the rest is
 * text, and `packages/wacc/tools/waccBindgen.ts` writes it.
 */
export string exportSigsLinked(string[] paths, string[] sources, string entry) {
  i32[] starts = i32[512]();
  i32[] edges = i32[65536]();
  string[] names = string[32768]();
  string[] filePaths = string[512]();
  string blob = linkFiles(paths, sources, entry, starts, edges, names, filePaths);
  if (blob == "") { return ""; }
  u8[] src = blob.toBytes();
  i32 entryDecls = declCountOf(sourceOf(paths, sources, entry));
  Lexed lexed = lex(src);
  P p = P.create(src, lexed.tokens, lexed.tokenCount);
  Program prog = parseProgram(p);
  Env env = Env.create();
  // Every walk that describes the module has to be bounded the way the module is emitted, or it
  // describes a different module — see `bindTypesLinked`.
  env.entryDecls = entryDecls;
  for (i32 i = 0; i < starts.len(); i++) {
    if (starts[i] == 0) { continue; }
    env.fileFirstLine[env.fileCount] = starts[i];
    // **The paths, which this pass used not to keep.** Nothing here needed them until a type name
    // had to say *which* module's `S` it meant: `qualifiedName` builds that from the declaring
    // file, and with no paths it silently answered with the bare key instead [issue 0100].
    if (env.fileCount < env.filePaths.len() && i >= 1 && i - 1 < filePaths.len()) {
      env.filePaths[env.fileCount] = filePaths[i - 1];
    }
    env.fileCount = env.fileCount + 1;
  }
  for (i32 e = 0; e < edges[0]; e++) {
    if (env.importCount >= env.importFrom.len()) { continue; }
    env.importFrom[env.importCount] = edges[e * 2 + 1];
    env.importTo[env.importCount] = edges[e * 2 + 2];
    string pair = e < names.len() ? names[e] : "";
    i32 sp = pair.indexOf(" ");
    env.importNames[env.importCount] = sp < 0 ? pair : pair.slice(0, sp);
    env.importDecls[env.importCount] = sp < 0 ? pair : pair.slice(sp + 1, pair.len());
    env.importCount = env.importCount + 1;
  }
  collectDeclarations(env, src, lexed, prog);
  assignGlobals(env, src, lexed);
  settleEmittable(env, src, lexed, prog);

  string out = "";
  i32 at = 0;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case Func(nameTok, returnType, params, body, exported, typeParams): {
        if (typeParams.len() > 0) { continue; }
        bool ok = env.funcIndex[at] >= 0;
        at = at + 1;
        if (!ok || !exported) { continue; }
        if (entryDecls >= 0 && d >= entryDecls) { continue; }
        string line = tokenTextOf(src, lexed, nameTok) + "\t" +
                      metaTypeOfTy(env, src, lexed, returnType) + "\t";
        for (i32 i = 0; i < params.len(); i++) {
          if (i > 0) { line = line + ","; }
          line = line + metaTypeOfTy(env, src, lexed, params[i].type);
        }
        out = out + line + "\n";
      }
      case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        if (typeParams.len() > 0) { continue; }
        for (i32 m = 0; m < methods.len(); m++) { at = at + 1; }
      }
      case EnumDecl(nameTok, variants, exported, methods, typeParams): {
        if (typeParams.len() > 0) { continue; }
        for (i32 m = 0; m < methods.len(); m++) { at = at + 1; }
      }
      else: { }
    }
  }
  return out;
}

/** `--checked`: the same module with trapping arithmetic. */
export u8[] emitLinkedChecked(string[] paths, string[] sources, string entry) {
  return emitLinkedWith(paths, sources, entry, true);
}

export u8[] emitLinked(string[] paths, string[] sources, string entry) {
  return emitLinkedWith(paths, sources, entry, false);
}

u8[] emitLinkedWith(string[] paths, string[] sources, string entry, bool checked) {
  return emitLinkedWith2(paths, sources, entry, checked, false, false);
}

u8[] emitLinkedWith2(string[] paths, string[] sources, string entry, bool checked, bool covered,
                     bool traced) {
  i32[] starts = i32[512]();
  i32[] edges = i32[65536]();
  string[] names = string[32768]();
  string[] filePaths = string[512]();
  string blob = linkFiles(paths, sources, entry, starts, edges, names, filePaths);
  if (blob == "") { return bareModule(); }
  return emitModuleOfWith(blob.toBytes(), declCountOf(sourceOf(paths, sources, entry)), starts, edges,
                          names, filePaths, checked, covered, traced);
}

/** A module with nothing in it, for the cases where emitting anything would be a guess. */
u8[] bareModule() {
  u8[] out = u8[8]();
  out[0] = 0;
  out[1] = 97;
  out[2] = 115;
  out[3] = 109;
  out[4] = 1;
  return out;
}

/**
 * `entryDecls` is how many declarations may be exported, or -1 when the source is a single file.
 *
 * The two are the same pipeline: linking happens before this, and what arrives is one buffer either
 * way. The count is the only thing that has to survive the join — an imported file's `export` means
 * "visible to the file that imported me", not "visible to JavaScript".
 */
/**
 * A struct's fields, **its parent's first** — the shape wasm's `sub` requires of a subtype.
 *
 * A subtype does not inherit fields in the format: it repeats them. That is what makes a
 * `struct.get` compiled against `Shape` read the right slot of a `Rect`, and it is the reason the
 * offset in `Env.inheritedCount` is the whole of inheritance here rather than a special case in
 * every accessor.
 */
i32 countStructFields(Env env, string owner) {
  i32 n = 0;
  for (i32 f = 0; f < env.fieldCount; f++) {
    if (env.fieldOwners[f] == owner) { n = n + 1; }
  }
  string p = env.parentOf(owner);
  return p == "" ? n : n + countStructFields(env, p);
}

void writeStructFields(B types, Env env, string owner) {
  string p = env.parentOf(owner);
  if (p != "") { writeStructFields(types, env, p); }
  for (i32 f = 0; f < env.fieldCount; f++) {
    if (env.fieldOwners[f] != owner) { continue; }
    writeValType(types, env, env.fieldTypes[f]);
    types.byte(1);   // mutable, which every wac field is
  }
}

void emitStructFields(B types, Env env, string owner) {
  types.u32leb(countStructFields(env, owner));
  writeStructFields(types, env, owner);
}

u8[] emitModuleOf(u8[] src, i32 entryDecls, i32[] starts, i32[] edges, string[] names,
                  string[] filePaths) {
  return emitModuleOfWith(src, entryDecls, starts, edges, names, filePaths, false, false, false);
}

/** The point table for an instrumented build, which only emitting can produce. */
string covTableOf(u8[] src, i32 entryDecls, i32[] starts, i32[] edges, string[] names,
                  string[] filePaths, bool traced) {
  Env probe = Env.create();
  probe.trace = traced;
  emitModuleOfInto(src, entryDecls, starts, edges, names, filePaths, false, true, probe);
  return probe.covTable;
}

u8[] emitModuleOfWith(u8[] src, i32 entryDecls, i32[] starts, i32[] edges, string[] names,
                      string[] filePaths, bool checked, bool covered, bool traced) {
  Env env = Env.create();
  env.trace = traced;
  return emitModuleOfInto(src, entryDecls, starts, edges, names, filePaths, checked, covered, env);
}

u8[] emitModuleOfInto(u8[] src, i32 entryDecls, i32[] starts, i32[] edges, string[] names,
                      string[] filePaths, bool checked, bool covered, Env envIn) {
  Lexed lexed = lex(src);
  P p = P.create(src, lexed.tokens, lexed.tokenCount);
  Program prog = parseProgram(p);

  Env env = envIn;
  env.checked = checked;
  env.coverage = covered;
  env.entryDecls = entryDecls;

  // The file table first: every key handed out below is derived from it, and a registration made
  // before it is loaded would be scoped to file 0 whatever line it is on.
  for (i32 i = 0; i < starts.len(); i++) {
    if (starts[i] == 0) { continue; }
    env.fileFirstLine[env.fileCount] = starts[i];
    if (env.fileCount < env.filePaths.len() && i - 1 < filePaths.len() && i >= 1) {
      env.filePaths[env.fileCount] = filePaths[i - 1];
    }
    env.fileCount = env.fileCount + 1;
  }
  for (i32 e = 0; e < edges[0]; e++) {
    if (env.importCount >= env.importFrom.len()) { continue; }
    env.importFrom[env.importCount] = edges[e * 2 + 1];
    env.importTo[env.importCount] = edges[e * 2 + 2];
    string pair = e < names.len() ? names[e] : "";
    i32 sp = pair.indexOf(" ");
    env.importNames[env.importCount] = sp < 0 ? pair : pair.slice(0, sp);
    env.importDecls[env.importCount] = sp < 0 ? pair : pair.slice(sp + 1, pair.len());
    env.importCount = env.importCount + 1;
  }
  collectDeclarations(env, src, lexed, prog);
  assignGlobals(env, src, lexed);
  // **A helper is a function like any other**, registered before emittability is settled so a call to
  // it is an ordinary call and the renumbering counts it. Named with a space, which no wac identifier
  // can contain, so it cannot collide with anything the source declares.
  // Only when the module has strings at all: the helper names the `i8[]` type, and registering that
  // while the type section is being written is the "index out of bounds" this rung has hit four times.
  // **The helper set.** Four functions nobody wrote, registered together because they are needed
  // together: a module that has strings at all is likely to compare or join them, and an unused one
  // costs a few dozen bytes. `u8[]` is registered here too — `toBytes` names it, and a type has to
  // exist before the section that declares it is written.
  // **The counter array, before anything counts the array table.** Registering it later would leave
  // the array-accessor family's four signatures per type unregistered for this one, and the type
  // section is sized before those are asked for — which the emitter answers by declining the module.
  if (env.coverage) { env.arrayType("i32[]"); }
  bool needsStrings = env.arrayCount > 0 && hasStringType(env);
  if (needsStrings) {
    env.arrayType("u8[]");
    string[] two = string[2]();
    two[0] = "string";
    two[1] = "string";
    env.addFunc(" str_eq", "bool", two);
    string[] two2 = string[2]();
    two2[0] = "string";
    two2[1] = "string";
    env.addFunc(" str_concat", "string", two2);
    string[] one = string[1]();
    one[0] = "string";
    env.addFunc(" str_to_bytes", "u8[]", one);
    string[] one2 = string[1]();
    one2[0] = "u8[]";
    env.addFunc(" str_from_bytes", "string", one2);
    string[] idx = string[2]();
    idx[0] = "string";
    idx[1] = "i32";
    env.addFunc(" str_idx", "string", idx);
    string[] one3 = string[1]();
    one3[0] = "i32";
    env.addFunc(" str_fromcp", "string", one3);
    string[] three = string[3]();
    three[0] = "string";
    three[1] = "i32";
    three[2] = "i32";
    env.addFunc(" str_slice", "string", three);
    string[] two3 = string[2]();
    two3[0] = "string";
    two3[1] = "string";
    env.addFunc(" str_index_of", "i32", two3);
    // **Last, because it is emitted last.** A helper's index is its position in this list, and the
    // order here has to be the order below — registering the comparison in the middle and emitting
    // it at the end made every call after it reach the wrong function.
    string[] cmp2 = string[2]();
    cmp2[0] = "string";
    cmp2[1] = "string";
    env.addFunc(" str_cmp", "i32", cmp2);
  }
  // A **second round** of the two passes: `assignGlobals` asks whether an initialiser is emittable,
  // and the answer can change once the functions it calls have settled. Cheap, and the alternative
  // is a global assigned from a function that was skipped.
  // **Before anything is numbered.** An imported function occupies index 0, so every index below is
  // measured from the number of them. `issues/lang/0094`.
  env.cbSigCount = collectCallbackSigs(env, src, lexed, prog);
  env.outSigCount = collectOutSigs(env, src, lexed, prog, env.outSigs);
  bool startNeeded = needsStartFunction(env, src, lexed);
  if (startNeeded) { env.addFunc(" start", "void", string[0]()); }
  if (env.full) { return bareModule(); }
  settleEmittable(env, src, lexed, prog);
  // Settling walked every function, so an ambiguous name has been reached by now if there is one.
  if (env.ambiguous || env.full) { return bareModule(); }

  B types = B.create();
  B funcs = B.create();
  B exports = B.create();
  B code = B.create();
  i32 count = 0;
  i32 exportCount = 0;
  i32 countAt = 0;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case Func(nameTok, returnType, params, body, exported, typeParams): {
        if (typeParams.len() > 0) { continue; }
        if (env.funcIndex[countAt] < 0) { countAt = countAt + 1; continue; }
        countAt = countAt + 1;
        count = count + 1;
        if (exported && (entryDecls < 0 || d < entryDecls)) { exportCount = exportCount + 1; }
      }
      case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        if (typeParams.len() > 0) { continue; }
        for (i32 m = 0; m < methods.len(); m++) {
          if (env.funcIndex[countAt] >= 0) { count = count + 1; }
          countAt = countAt + 1;
        }
      }
      case EnumDecl(nameTok, variants, exported, methods, typeParams): {
        if (typeParams.len() > 0) { continue; }
        for (i32 m = 0; m < methods.len(); m++) {
          if (env.funcIndex[countAt] >= 0) { count = count + 1; }
          countAt = countAt + 1;
        }
      }
      else: { }
    }
  }
  // **A pre-pass for the array types.** Their entries come first in the type section, so every
  // function type index is offset by however many there are — and the set is only complete once every
  // signature and every local has been looked at. Walking the declarations twice is the cost of a
  // type that has to be declared before it is used.
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case Func(nameTok, returnType, params, body, exported, typeParams): {
        if (typeParams.len() > 0) { continue; }
        string rt = typeOfTyName(env, src, lexed, returnType);
        registerNamed(env, rt);
        for (i32 i = 0; i < params.len(); i++) {
          string pt = typeOfTyName(env, src, lexed, params[i].type);
          registerNamed(env, pt);
        }
        collectArrayTypesIn(env, src, lexed, params, body);
      }
      // A **module-level constant** names a type as surely as a field or a parameter does, and its
      // initialiser can name another. Third time this pre-pass has been found one declaration short:
      // the rule is *every place a type can be named*, and the list is longer than it looks.
      case ConstDecl(nameTok, type, init, exported): {
        string ct = typeOfTyName(env, src, lexed, type);
        registerNamed(env, ct);
        collectArrayTypesOfExpr(env, src, lexed, init);
      }
      // A struct's **fields** name types too, and an array among them has to be registered before the
      // section is written — otherwise `writeValType` hands out an index while writing it, past the
      // count already emitted, and the module refers to a type that is not there. The symptom is
      // *"invalid array index"*, which names the consequence and not the cause.
      // An enum's payloads are fields, and the rule this pre-pass keeps re-learning is *every place a
      // type can be named*. A `Node(i32[] kids)` whose array type is registered while the type
      // section is being written refers to an index that is not there yet.
      case EnumDecl(nameTok, variants, exported, methods, typeParams): {
        if (typeParams.len() > 0) { continue; }
        for (i32 v = 0; v < variants.len(); v++) {
          for (i32 i = 0; i < variants[v].fields.len(); i++) {
            string vt = typeOfTyName(env, src, lexed, variants[v].fields[i].type);
            registerNamed(env, vt);
          }
        }
      }
      case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        if (typeParams.len() > 0) { continue; }
        for (i32 i = 0; i < fields.len(); i++) {
          string ft2 = typeOfTyName(env, src, lexed, fields[i].type);
          registerNamed(env, ft2);
        }
        for (i32 m = 0; m < methods.len(); m++) {
          string mrt = typeOfTyName(env, src, lexed, methods[m].returnType);
          registerNamed(env, mrt);
          for (i32 i = 0; i < methods[m].params.len(); i++) {
            string mpt = typeOfTyName(env, src, lexed, methods[m].params[i].type);
            registerNamed(env, mpt);
          }
          collectArrayTypesIn(env, src, lexed, methods[m].params, methods[m].body);
        }
      }
      else: { }
    }
  }

  // **After every declaration has named its types**, which is the pass above: a `u8[]` that appears
  // only in a signature — `export u8[] echo(u8[] b)` — is registered there and nowhere earlier, so
  // asking before it answered no for exactly the modules a host most wants to call.
  // **Every array an export can carry, not just `u8[]`.** Each one needs three helpers and two
  // signatures, and the count decides every index after them — see `issues/lang/0089`.
  // **Every array a host can hold, and the accessors it needs to hold one.** `_to_mem` and
  // `_from_mem` move bytes, so only a numeric element has them; `string[]` and `u8[][]` had no
  // helpers at all and a host asking for one saw `$bind$arr_u8Arr_new is not a function`.
  i32 arrHelpers = 0;
  for (i32 bi = 0; bi < env.arrayCount; bi++) {
    if (!bindableArray(env, env.arrayTypes[bi])) { continue; }
    arrHelpers = arrHelpers + arrayHelperCount(env, env.arrayTypes[bi]);
  }
  // The structs a host can hold, and how many helpers they need between them. Computed once: the
  // pre-pass that registers signatures and the emission that writes bodies must agree exactly, and
  // an index that disagrees with a count is a call to the wrong function.
  string[] bindStructs = string[512]();
  i32 bindStructCount = collectBindStructs(env, src, lexed, prog, bindStructs, entryDecls);
  // **An enum is a struct in this emitter's tables and not one at the boundary.** `collectBindStructs`
  // finds both, because it asks `isStructName` — which is the right question for reachability and the
  // wrong one for naming. Emitted as a struct family, `enum Shape { Circle(f64 r) }` exported
  // `$bind$s_Shape_get_ tag` and `$bind$s_Shape_get_Circle.r`: two names no host asks for, with a
  // space and a dot in them. The `e_` family below is what bindgen calls. `issues/lang/0089`.
  i32 structHelpers = 0;
  i32 enumHelpers = 0;
  for (i32 si2 = 0; si2 < bindStructCount; si2++) {
    if (env.isEnumName(bindStructs[si2])) {
      enumHelpers = enumHelpers + enumHelperCount(env, bindStructs[si2]);
    } else if (bindableStruct(env, bindStructs[si2])) {
      structHelpers = structHelpers + structHelperCount(env, bindStructs[si2]);
    }
  }

  // The instances, in the order `collectInstances` registered them: after every declaration and
  // **before the helpers**, which is where their indices are. Getting this wrong is not a subtle
  // bug — every call after the first helper reaches the wrong function — and it is why the last
  // attempt at this compiled the corpus into fifty-seven invalid modules while every hand-written
  // case, which had no strings and so no helpers, passed.
  for (i32 ii = 0; ii < env.instCount; ii++) {
  // **Only the ones registration built.** An instance discovered after the fixed point gave up —
  // or one whose template is not in this module — has no members in the tables, and emitting its
  // methods anyway shifts every index after it. The receiver comes out an `i32`, which wasm
  // reports as a `struct.get` on a number several functions later.
  // A function instance builds no type, so it is "built" when its own entry is registered.
  if (!env.isStructName(env.instName[ii]) && env.funcAt(env.instName[ii]) < 0) { continue; }
    for (i32 di = 0; di < prog.decls.len(); di++) {
      match (prog.decls[di].kind) {
        // One function per instance, in the same place in the order its registration put it.
        case Func(nameTok, returnType, params, body, exported, typeParams): {
          if (typeParams.len() == 0) { continue; }
          if (tokenTextOf(src, lexed, nameTok) != env.instOf[ii]) { continue; }
          if (env.funcIndex[countAt] >= 0) { count = count + 1; }
          countAt = countAt + 1;
        }
        case EnumDecl(nameTok, variants, exported, methods, typeParams): {
          if (typeParams.len() == 0) { continue; }
          if (tokenTextOf(src, lexed, nameTok) != env.instOf[ii]) { continue; }
          i32 epushed = pushSubstitution(env, src, lexed, typeParams, env.instName[ii],
                                         env.instOf[ii]);
          for (i32 m = 0; m < methods.len(); m++) {
            if (env.funcIndex[countAt] >= 0) { count = count + 1; }
            countAt = countAt + 1;
          }
          popSubstitution(env, epushed);
        }
        case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
          if (typeParams.len() == 0) { continue; }
          if (tokenTextOf(src, lexed, nameTok) != env.instOf[ii]) { continue; }
          i32 pushed = pushSubstitution(env, src, lexed, typeParams, env.instName[ii],
                                        env.instOf[ii]);
          for (i32 m = 0; m < methods.len(); m++) {
            if (env.funcIndex[countAt] >= 0) { count = count + 1; }
            countAt = countAt + 1;
          }
          popSubstitution(env, pushed);
        }
        else: { }
      }
    }
  }

  // `+ 1` for `$bind$mem_ensure`, which every module carries: the boundary needs it whenever an
  // exported signature moves bytes, and deciding that here would mean asking what a host will bind.
  // **Where each block of functions begins, said once.** The order is fixed — the user's, then the
  // string helpers, then the buffer, the array families, the struct families, and the start function
  // last — and four places used to spell that arithmetic out separately. They disagreed the moment a
  // family was added between them, which arrives as "invalid start func reference" or as a call to
  // the wrong function several dozen instructions later. `issues/lang/0094` adds imports in front of
  // all of it, and wasm numbers imported functions first, so every one of these gains the same term.
  i32 stringHelpers = needsStrings ? 9 : 0;
  i32 memHelperAt = env.cbSigCount + count + stringHelpers;
  i32 arrayHelpersAt = memHelperAt + 1;
  i32 structHelpersAt = arrayHelpersAt + arrHelpers;
  // The six bind-string helpers, for a module that has strings at all — the same condition the
  // reference uses, and the same condition the nine internal ones already carry.
  i32 bindStrHelpers = needsStrings ? 6 : 0;
  i32 cbHelpers = env.cbSigCount * (callbackSlots() + 1);
  i32 covHelpers = env.coverage ? 3 : 0;
  i32 outHelpers = env.outSigCount;
  i32 enumHelpersAt = structHelpersAt + structHelpers;
  i32 bindStrHelpersAt = enumHelpersAt + enumHelpers;
  i32 cbHelpersAt = bindStrHelpersAt + bindStrHelpers;
  i32 covHelpersAt = cbHelpersAt + cbHelpers;
  i32 outHelpersAt = covHelpersAt + covHelpers;
  // One wrapper per emitted function — `design/lang/0002`. `count` is the right number because the
  // wrappers are built inside `emitFunction`, so the two are the same walk rather than two walks that
  // agree.
  i32 wrapHelpers = count;
  i32 wrapHelpersAt = outHelpersAt + outHelpers;
  env.wrapAt = wrapHelpersAt;
  // The bound wrappers, one per function as well — `design/lang/0002` step 2.
  i32 boundHelpers = count;
  i32 boundHelpersAt = wrapHelpersAt + wrapHelpers;
  env.boundAt = boundHelpersAt;
  i32 startFunctionAt = boundHelpersAt + boundHelpers;
  i32 helpers = stringHelpers + (startNeeded ? 1 : 0) + 1 + arrHelpers + structHelpers +
                enumHelpers + bindStrHelpers + cbHelpers + covHelpers + outHelpers + wrapHelpers + boundHelpers;
  funcs.u32leb(count + helpers);
  // Built now for its count, appended at the end of the section: every index it names belongs to a
  // function the walk above has already numbered.
  B methodExports = B.create();
  i32 methodExportCount = bindMethodExports(methodExports, env, src, lexed, prog, bindStructs,
                                            bindStructCount);
  exports.u32leb(exportCount + 2 + arrHelpers + structHelpers + enumHelpers + bindStrHelpers +
                 env.cbSigCount + covHelpers + outHelpers + methodExportCount);
  code.u32leb(count + helpers);

  // **Every function's signature, before the section is sized.** They share the table with the
  // `fn[...]` types the source writes, which is the whole point: a function and a reference to it
  // have to name one type index, not two identical ones.
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case Func(nameTok, returnType, params, body, exported, typeParams): {
        if (typeParams.len() > 0) { continue; }
        registerFuncTypes(env, src, lexed, returnType, params, "");
      }
      case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        if (typeParams.len() > 0) { continue; }
        string owner2 = nameKeyOf(env, src, lexed, nameTok);
        for (i32 m = 0; m < methods.len(); m++) {
          registerFuncTypes(env, src, lexed, methods[m].returnType, methods[m].params,
                                 methods[m].hasThis ? owner2 : "");
        }
      }
      case EnumDecl(nameTok, variants, exported, methods, typeParams): {
        if (typeParams.len() > 0) { continue; }
        string eowner2 = nameKeyOf(env, src, lexed, nameTok);
        for (i32 m = 0; m < methods.len(); m++) {
          registerFuncTypes(env, src, lexed, methods[m].returnType, methods[m].params,
                                 methods[m].hasThis ? eowner2 : "");
        }
      }
      else: { }
    }
  }
  // The instances, in the order `collectInstances` registered them: after every declaration and
  // **before the helpers**, which is where their indices are. Getting this wrong is not a subtle
  // bug — every call after the first helper reaches the wrong function — and it is why the last
  // attempt at this compiled the corpus into fifty-seven invalid modules while every hand-written
  // case, which had no strings and so no helpers, passed.
  for (i32 ii = 0; ii < env.instCount; ii++) {
  // **Only the ones registration built.** An instance discovered after the fixed point gave up —
  // or one whose template is not in this module — has no members in the tables, and emitting its
  // methods anyway shifts every index after it. The receiver comes out an `i32`, which wasm
  // reports as a `struct.get` on a number several functions later.
  // A function instance builds no type, so it is "built" when its own entry is registered.
  if (!env.isStructName(env.instName[ii]) && env.funcAt(env.instName[ii]) < 0) { continue; }
    for (i32 di = 0; di < prog.decls.len(); di++) {
      match (prog.decls[di].kind) {
        case Func(nameTok, returnType, params, body, exported, typeParams): {
          if (typeParams.len() == 0) { continue; }
          if (tokenTextOf(src, lexed, nameTok) != env.instOf[ii]) { continue; }
          i32 fpushed2 = pushSubstitution(env, src, lexed, typeParams, env.instName[ii],
                                          env.instOf[ii]);
          registerFuncTypes(env, src, lexed, returnType, params, "");
          popSubstitution(env, fpushed2);
        }
        case EnumDecl(nameTok, variants, exported, methods, typeParams): {
          if (typeParams.len() == 0) { continue; }
          if (tokenTextOf(src, lexed, nameTok) != env.instOf[ii]) { continue; }
          i32 epushed = pushSubstitution(env, src, lexed, typeParams, env.instName[ii],
                                         env.instOf[ii]);
          for (i32 m = 0; m < methods.len(); m++) {
            registerFuncTypes(env, src, lexed, methods[m].returnType, methods[m].params,
                                   methods[m].hasThis ? env.instName[ii] : "");
          }
          popSubstitution(env, epushed);
        }
        case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
          if (typeParams.len() == 0) { continue; }
          if (tokenTextOf(src, lexed, nameTok) != env.instOf[ii]) { continue; }
          i32 pushed = pushSubstitution(env, src, lexed, typeParams, env.instName[ii],
                                        env.instOf[ii]);
          for (i32 m = 0; m < methods.len(); m++) {
            registerFuncTypes(env, src, lexed, methods[m].returnType, methods[m].params,
                                   methods[m].hasThis ? env.instName[ii] : "");
          }
          popSubstitution(env, pushed);
        }
        else: { }
      }
    }
  }

  // Before `declTypes` is taken, or the type section is sized without it and the module is declined
  // — which is what happened first time round, and the emitter said so by returning eight bytes.
  env.sigType("fn[i32(i32)]");
  // Two signatures per array type: `_len` and `_to_mem` both answer an `i32` from one, `_from_mem`
  // answers one from an `i32`.
  for (i32 bi = 0; bi < env.arrayCount; bi++) {
    string bt = env.arrayTypes[bi];
    if (!bindableArray(env, bt)) { continue; }
    string bel = bindElemType(elemOf(bt));
    if (arrNeedsFill(env, elemOf(bt))) {
      env.sigType("fn[" + bt + "(i32," + bel + ")]");
      env.sigType("fn[" + bt + "()]");
    } else {
      env.sigType("fn[" + bt + "(i32)]");
    }
    env.sigType("fn[" + bel + "(" + bt + ",i32)]");
    env.sigType("fn[void(" + bt + ",i32," + bel + ")]");
    env.sigType("fn[i32(" + bt + ")]");
  }
  for (i32 si3 = 0; si3 < bindStructCount; si3++) {
    string sn = bindStructs[si3];
    if (env.isEnumName(sn)) {
      env.sigType("fn[i32(" + sn + ")]");
      for (i32 v = 0; v < env.variantCount; v++) {
        if (env.variantOwners[v] != sn) { continue; }
        string vparams = "";
        for (i32 k = 0; k < env.variantArity[v]; k++) {
          if (k > 0) { vparams = vparams + ","; }
          vparams = vparams + bindFieldType(env.fieldTypeAt(sn, env.variantSlot[v] + k));
        }
        env.sigType("fn[" + sn + "(" + vparams + ")]");
        for (i32 k = 0; k < env.variantArity[v]; k++) {
          env.sigType("fn[" + bindFieldType(env.fieldTypeAt(sn, env.variantSlot[v] + k)) +
                      "(" + sn + ")]");
        }
      }
      continue;
    }
    if (!bindableStruct(env, sn)) { continue; }
    i32 sfc = env.fieldCountOf(sn);
    string sparams = "";
    for (i32 f = 0; f < sfc; f++) {
      if (f > 0) { sparams = sparams + ","; }
      sparams = sparams + bindFieldType(env.fieldTypeAt(sn, f));
    }
    env.sigType("fn[" + sn + "(" + sparams + ")]");
    for (i32 f = 0; f < sfc; f++) {
      string bft = bindFieldType(env.fieldTypeAt(sn, f));
      env.sigType("fn[" + bft + "(" + sn + ")]");
      env.sigType("fn[void(" + sn + "," + bft + ")]");
    }
  }
  // The dispatcher a host supplies, and the selector that answers a funcref of the callback's type.
  for (i32 j = 0; j < env.cbSigCount; j++) {
    env.sigType(env.cbSigs[j]);
    env.sigType(dispatchSig(env.cbSigs[j]));
    env.sigType("fn[" + env.cbSigs[j] + "(i32)]");
  }
  for (i32 j = 0; j < env.outSigCount; j++) {
    env.sigType(env.outSigs[j]);
    env.sigType(callrefSig(env.outSigs[j]));
  }
  if (env.coverage) {
    env.sigType("fn[void()]");
    env.sigType("fn[i32()]");
    env.sigType("fn[i32(i32)]");
  }
  if (startNeeded) { env.sigType("fn[void()]"); }
  if (needsStrings) {
    env.sigType("fn[bool(string,string)]");
    env.sigType("fn[string(string,string)]");
    env.sigType("fn[u8[](string)]");
    env.sigType("fn[string(u8[])]");
    env.sigType("fn[string(string,i32)]");
    env.sigType("fn[string(i32)]");
    env.sigType("fn[string(string,i32,i32)]");
    env.sigType("fn[i32(string,string)]");
    // **The six a host reaches a string through.** `$bind$str_new/_get/_set/_len/_from_mem/_to_mem`,
    // the same set the reference emits beside its own string helpers — a `string` crosses the
    // boundary as an opaque WasmGC reference and these are the only way to read or fill one.
    // Registered here for the reason every other helper is: the type section is sized before any
    // body is written. `issues/lang/0089`.
    env.sigType("fn[string(i32)]");
    env.sigType("fn[i32(string,i32)]");
    env.sigType("fn[void(string,i32,i32)]");
    env.sigType("fn[i32(string)]");
  }

  // **Room is checked again here, because the helpers ask for types too.** `full` was asked before
  // the walk and not after, and every signature above this line was registered since: a table that
  // filled up answers `sigType` with **0**, which is an *array* index, and the module says *"no
  // signature at index 0"* dozens of functions later. Declining is the same answer this emitter
  // gives for everything else it cannot do. Found by `corpusEmit` on `packages/tor/src/relayd.wac`
  // the moment the array family added two signatures per array type.
  if (env.full) { return bareModule(); }

  // **Every `fn[…]` gets its pair before the count is taken** — `design/lang/0002`. `declTypes` is
  // the number the section is sized from, and the guard at the end of this function declines a module
  // whose table grew after it. So the sweep has to be on this side of the snapshot: run after it, and
  // every program with a funcref in it declines with "a type this emitter names only while emitting",
  // which is that guard doing exactly its job.
  env.pairEverySignature();
  i32 declTypes = env.arrayCount + env.structCount + env.sigCount;
  // **One recursive group holding every type.** Outside a rec group a type may only refer to one
  // defined *before* it, and an array of a struct refers forward the moment the struct is declared
  // later — which wasm reports as "type index out of bounds" from the type section itself, with no
  // function to name. A rec group makes the whole set mutually visible, which is also why the
  // reference emits exactly one for the same reason.
  types.u32leb(1);
  types.byte(78);   // rec
  types.u32leb(declTypes);
  for (i32 i = 0; i < env.arrayCount; i++) {
    types.byte(94);   // array
    // A **storage type** is a value type or one of the two packed widths — and a value type can be a
    // reference. `u8[][]` is an array whose element is an array, and writing that element as a single
    // byte said `i32`, which is what `array.new` was complaining about four files later.
    string el = elemOf(env.arrayTypes[i]);
    if (el == "i8" || el == "u8") { types.byte(120); }
    else if (el == "i16" || el == "u16") { types.byte(119); }
    else { writeValType(types, env, el); }
    types.byte(1);    // mutable, which every wac array is
  }
  for (i32 i = 0; i < env.structCount; i++) {
    // **Every struct is written as an open subtype**, with a supertype list of one or of none.
    // A type is *final* by default and a final type cannot be extended, so a parent has to be
    // declared open before its child exists — and since a parent is only known to be one by
    // reading its children, declaring all of them open is the answer that needs no second pass.
    types.byte(80);   // sub
    string parent = env.structParents[i];
    types.u32leb(parent == "" ? 0 : 1);
    if (parent != "") { types.u32leb(env.structType(parent)); }
    types.byte(95);   // struct
    // Its parent's fields come first, in order, because that is what makes a `struct.get` compiled
    // against the parent read the right slot of a child.
    emitStructFields(types, env, env.structNames[i]);
  }

  // The signatures, after the structs and before the per-function types. A function reference's
  // value type points here; the type the *code section* gives each function is a different entry
  // with the same shape, and wasm's structural equality is what lets a `ref.func` of one be stored
  // in a local declared as the other.
  for (i32 i = 0; i < env.sigCount; i++) {
    string sig = env.sigTypes[i];
    // **A pair, not a function.** `fn[…]` values are `{funcref, env}` — `design/lang/0002` — and the
    // pair shares this table behind a marker because the table is grown lazily and so must stay last.
    // Two fields, both mutable-free: the env-taking funcref, then the env itself as `anyref`.
    if (isPairEntry(sig)) {
      string inner = pairInner(sig);
      types.byte(95);            // struct
      types.u32leb(2);
      types.byte(99);            // (ref null $envSig)
      types.i32leb(env.sigType(envSig(inner)));
      types.byte(0);             // immutable
      types.byte(110);           // anyref
      types.byte(0);             // immutable
      continue;
    }
    types.byte(96);
    types.u32leb(sigParamCount(sig));
    for (i32 pi = 0; pi < sigParamCount(sig); pi++) {
      writeValType(types, env, sigParamAt(sig, pi));
    }
    string r = sigReturn(sig);
    types.u32leb(r == "void" ? 0 : 1);
    if (r != "void") { writeValType(types, env, r); }
  }

  // **From the import count, like every other index.** This counter is the *export's* view of a
  // function's position and it is kept separately from `funcIndex`, so shifting one shifted only
  // half of them: every exported function named a wasm function `cbSigCount` places earlier than
  // itself. With one callback signature that is a trampoline, so `call1(f)` called the dispatcher
  // with the funcref where an `i32` belongs — a JS type error at the boundary, if the arity happened
  // to match, and a wrong answer if it did not. `issues/lang/0094`.
  i32 index = env.cbSigCount;
  i32 emitAt = 0;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case EnumDecl(nameTok, variants, exported, methods, typeParams): {
        if (typeParams.len() > 0) { continue; }
        string eowner = nameKeyOf(env, src, lexed, nameTok);
        for (i32 m = 0; m < methods.len(); m++) {
          if (env.funcIndex[emitAt] < 0) { emitAt = emitAt + 1; continue; }
          emitAt = emitAt + 1;
          emitFunction(types, funcs, exports, code, src, lexed, env, prog,
                       "", methods[m].returnType, methods[m].params, methods[m].body,
                       methods[m].hasThis ? eowner : "", index, declTypes, methods[m].nameTok);
          index = index + 1;
        }
      }
      case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        if (typeParams.len() > 0) { continue; }
        string owner = nameKeyOf(env, src, lexed, nameTok);
        for (i32 m = 0; m < methods.len(); m++) {
          if (env.funcIndex[emitAt] < 0) { emitAt = emitAt + 1; continue; }
          emitAt = emitAt + 1;
          emitFunction(types, funcs, exports, code, src, lexed, env, prog,
                       "", methods[m].returnType, methods[m].params, methods[m].body,
                       methods[m].hasThis ? owner : "", index, declTypes, methods[m].nameTok);
          index = index + 1;
        }
      }
      case Func(nameTok, returnType, params, body, exported, typeParams): {
        if (typeParams.len() > 0) { continue; }
        if (env.funcIndex[emitAt] < 0) { emitAt = emitAt + 1; continue; }
        emitAt = emitAt + 1;
        emitFunction(types, funcs, exports, code, src, lexed, env, prog,
                     exported && (entryDecls < 0 || d < entryDecls)
                       ? tokenTextOf(src, lexed, nameTok) : "",
                     returnType, params, body, "", index, declTypes, nameTok);
        index = index + 1;
      }
      else: { }
    }
  }

  // The instances, in the order `collectInstances` registered them: after every declaration and
  // **before the helpers**, which is where their indices are. Getting this wrong is not a subtle
  // bug — every call after the first helper reaches the wrong function — and it is why the last
  // attempt at this compiled the corpus into fifty-seven invalid modules while every hand-written
  // case, which had no strings and so no helpers, passed.
  for (i32 ii = 0; ii < env.instCount; ii++) {
  // **Only the ones registration built.** An instance discovered after the fixed point gave up —
  // or one whose template is not in this module — has no members in the tables, and emitting its
  // methods anyway shifts every index after it. The receiver comes out an `i32`, which wasm
  // reports as a `struct.get` on a number several functions later.
  // A function instance builds no type, so it is "built" when its own entry is registered.
  if (!env.isStructName(env.instName[ii]) && env.funcAt(env.instName[ii]) < 0) { continue; }
    for (i32 di = 0; di < prog.decls.len(); di++) {
      match (prog.decls[di].kind) {
        // **Never exported.** An instance's name is not a name anybody wrote, and two modules that
        // happened to infer the same one would collide on it.
        case Func(nameTok, returnType, params, body, exported, typeParams): {
          if (typeParams.len() == 0) { continue; }
          if (tokenTextOf(src, lexed, nameTok) != env.instOf[ii]) { continue; }
          if (env.funcIndex[emitAt] < 0) { emitAt = emitAt + 1; continue; }
          emitAt = emitAt + 1;
          i32 fpushed3 = pushSubstitution(env, src, lexed, typeParams, env.instName[ii],
                                          env.instOf[ii]);
          emitFunction(types, funcs, exports, code, src, lexed, env, prog,
                       "", returnType, params, body, "", index, declTypes, nameTok);
          popSubstitution(env, fpushed3);
          index = index + 1;
        }
        case EnumDecl(nameTok, variants, exported, methods, typeParams): {
          if (typeParams.len() == 0) { continue; }
          if (tokenTextOf(src, lexed, nameTok) != env.instOf[ii]) { continue; }
          i32 epushed = pushSubstitution(env, src, lexed, typeParams, env.instName[ii],
                                         env.instOf[ii]);
          for (i32 m = 0; m < methods.len(); m++) {
            if (env.funcIndex[emitAt] < 0) {
              emitAt = emitAt + 1;
              continue;
            }
            emitAt = emitAt + 1;
            emitFunction(types, funcs, exports, code, src, lexed, env, prog,
                         "", methods[m].returnType, methods[m].params, methods[m].body,
                         methods[m].hasThis ? env.instName[ii] : "", index, declTypes,
                         methods[m].nameTok);
            index = index + 1;
          }
          popSubstitution(env, epushed);
        }
        case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
          if (typeParams.len() == 0) { continue; }
          if (tokenTextOf(src, lexed, nameTok) != env.instOf[ii]) { continue; }
          i32 pushed = pushSubstitution(env, src, lexed, typeParams, env.instName[ii],
                                        env.instOf[ii]);
          for (i32 m = 0; m < methods.len(); m++) {
            if (env.funcIndex[emitAt] < 0) {
              emitAt = emitAt + 1;
              continue;
            }
            emitAt = emitAt + 1;
            emitFunction(types, funcs, exports, code, src, lexed, env, prog,
                         "", methods[m].returnType, methods[m].params, methods[m].body,
                         methods[m].hasThis ? env.instName[ii] : "", index, declTypes,
                         methods[m].nameTok);
            index = index + 1;
          }
          popSubstitution(env, pushed);
        }
        else: { }
      }
    }
  }

  // The helper, last, so every index the source could name is already assigned.
  if (needsStrings) {
    emitStringEquals(types, funcs, code, env, index, declTypes);
    emitStringConcat(types, funcs, code, env, index + 1, declTypes);
    emitBytesCopy(types, funcs, code, env, index + 2, declTypes, "u8[]", "i8[]");
    emitBytesCopy(types, funcs, code, env, index + 3, declTypes, "i8[]", "u8[]");
    emitStringIndex(types, funcs, code, env, index + 4, declTypes);
    emitStringFromCp(funcs, code, env);
    emitStringSlice(funcs, code, env);
    emitStringIndexOf(funcs, code, env);
    emitStringCompare(funcs, code, env);
  }
  emitMemEnsure(funcs, code, env);
  // In `arrayTypes` order, which is the order the exports below name them in — a helper's index is
  // its position among the helpers and nothing else.
  for (i32 bi = 0; bi < env.arrayCount; bi++) {
    string bt = env.arrayTypes[bi];
    if (!bindableArray(env, bt)) { continue; }
    emitArrayAccessors(funcs, code, env, bt);
    if (!isBulkArray(bt)) { continue; }
    emitArrToMem(funcs, code, env, bt);
    emitArrFromMem(funcs, code, env, bt);
  }
  for (i32 si4 = 0; si4 < bindStructCount; si4++) {
    if (env.isEnumName(bindStructs[si4])) { continue; }
    if (!bindableStruct(env, bindStructs[si4])) { continue; }
    emitStructHelpers(funcs, code, env, bindStructs[si4]);
  }
  for (i32 si6 = 0; si6 < bindStructCount; si6++) {
    if (!env.isEnumName(bindStructs[si6])) { continue; }
    emitEnumHelpers(funcs, code, env, bindStructs[si6]);
  }
  if (needsStrings) { emitStringBindHelpers(funcs, code, env); }
  for (i32 j = 0; j < env.cbSigCount; j++) {
    emitCallbackHelpers(funcs, code, env, j, cbHelpersAt + j * (callbackSlots() + 1));
  }
  if (env.coverage) { emitCoverageHelpers(funcs, code, env); }
  for (i32 j = 0; j < env.outSigCount; j++) { emitCallrefHelper(funcs, code, env, env.outSigs[j]); }
  // The wrappers last, so their indices start at `wrapHelpersAt` — after every other helper — and the
  // bound ones after those.
  funcs.bytes(env.wrapFuncs);
  code.bytes(env.wrapCode);
  funcs.bytes(env.boundFuncs);
  code.bytes(env.boundCode);

  B out = B.create();
  // `\0asm`, then version 1 as four little-endian bytes.
  out.byte(0);
  out.byte(97);
  out.byte(115);
  out.byte(109);
  out.byte(1);
  out.byte(0);
  out.byte(0);
  out.byte(0);
  B globals = B.create();
  i32 globalCount = 0;
  for (i32 i = 0; i < env.constCount; i++) {
    if (env.constGlobal[i] >= 0) { globalCount = globalCount + 1; }
  }
  globals.u32leb(globalCount + (env.coverage ? 1 : 0));
  if (env.coverage) {
    // `i32[]`, mutable, one slot per point — `array.new_default` over a constant length is a
    // constant expression, so the counters exist before any code runs and `__cov_init` only has to
    // clear them.
    writeValType(globals, env, "i32[]");
    globals.byte(1);
    globals.byte(65); globals.i32leb(env.trace ? traceSlotsOf(env) : env.covCount);
    globals.byte(251); globals.u32leb(7); globals.u32leb(env.arrayType("i32[]"));
    globals.byte(11);
  }
  // **From where the constants' indices start**, which is one along when the counter array has taken
  // global 0. Writing from zero left every constant's entry unwritten — the section then ended early
  // and the next byte was read as a value type.
  i32 firstConst = env.coverage ? 1 : 0;
  for (i32 g = firstConst; g < globalCount + firstConst; g++) {
    for (i32 i = 0; i < env.constCount; i++) {
      if (env.constGlobal[i] != g) { continue; }
      writeValType(globals, env, env.constTypes[i]);
      bool here = !(env.constInits[i] is null) && isConstExpr(src, lexed, env, env.constInits[i]!);
      // Immutable is what a `const` is, and what it can be only when its value can be written here.
      // The rest are mutable and null until the start function has run, which is the one moment
      // anything is allowed to write them.
      globals.byte(here ? 0 : 1);
      if (here) {
        emitExprAt(globals, src, lexed, env, env.constInits[i]!, env.constTypes[i]);
      }
      if (!here) { emitDefault(globals, env, env.constTypes[i]); }
      globals.byte(11);  // end of the initialiser expression
    }
  }

  // The start function goes last, so every index the constants can name is already assigned.
  if (startNeeded) {
    env.localCount = 0;
    env.paramCount = 0;
    // **After `$bind$mem_ensure`, so one past where it used to be.** The start function is emitted
    // last and numbered by hand, and adding a helper in front of it without moving this produced
    // *"invalid start func reference"* — the index named a function that is now the buffer helper.
    emitStartFunction(funcs, code, src, lexed, env,
                      startFunctionAt, declTypes);
  }

  // **The type section is written before the code that names types.** If emitting a body registered
  // one more — an array, a struct, a signature — every index after it is a lie, and the module names
  // a type it does not have: *"no signature at index 353 (353 types)"*. Rather than emit that, the
  // module is declined, which is the same answer the walk gives for everything it cannot do.
  if (env.arrayCount + env.structCount + env.sigCount != declTypes) {
    env.declineFor("a type was registered while a body was being emitted, after the type section " +
                   "had been sized: " + numText(declTypes) + " counted, " +
                   numText(env.arrayCount + env.structCount + env.sigCount) + " wanted");
    return bareModule();
  }

  // **The staging buffer, and the two names a host reaches it by.** One page to start with;
  // `$bind$mem_ensure` grows it. Emitted for every module rather than only where a signature moves
  // bytes, because which signatures a host will bind is not something the emitter can know.
  B mem = B.create();
  mem.u32leb(1);      // one memory
  mem.byte(0);        // no maximum
  mem.u32leb(1);      // one page to begin with

  // Every function this module has: the imported dispatchers, its own, and the helpers. The helpers
  // fill it as their exports are written; the rest is filled where the section is emitted.
  string[] fnName = string[env.cbSigCount + count + helpers](fill: "");

  exports.name("$bind$mem");
  exports.byte(2);    // a memory
  exports.u32leb(0);
  i32 helperBase = memHelperAt;
  exportFunc(exports, fnName, "$bind$mem_ensure", helperBase);
  i32 bulkAt = arrayHelpersAt;
  for (i32 bi = 0; bi < env.arrayCount; bi++) {
    string bt = env.arrayTypes[bi];
    if (!bindableArray(env, bt)) { continue; }
    string el = elemOf(bt);
    string sfx = bindArrSuffix(el);
    exportFunc(exports, fnName, "$bind$arr_" + sfx + "_new", bulkAt);
    bulkAt = bulkAt + 1;
    if (arrNeedsFill(env, el)) {
      exportFunc(exports, fnName, "$bind$arr_" + sfx + "_new0", bulkAt);
      bulkAt = bulkAt + 1;
    }
    exportFunc(exports, fnName, "$bind$arr_" + sfx + "_get", bulkAt);
    exportFunc(exports, fnName, "$bind$arr_" + sfx + "_set", bulkAt + 1);
    exportFunc(exports, fnName, "$bind$arr_" + sfx + "_len", bulkAt + 2);
    bulkAt = bulkAt + 3;
    if (!isBulkArray(bt)) { continue; }
    exportFunc(exports, fnName, "$bind$arr_" + sfx + "_to_mem", bulkAt);
    exportFunc(exports, fnName, "$bind$arr_" + sfx + "_from_mem", bulkAt + 1);
    bulkAt = bulkAt + 2;
  }
  for (i32 si5 = 0; si5 < bindStructCount; si5++) {
    string sn2 = bindStructs[si5];
    if (env.isEnumName(sn2)) { continue; }
    if (!bindableStruct(env, sn2)) { continue; }
    exportFunc(exports, fnName, "$bind$s_" + bindNameFor(env, src, lexed, sn2) + "_new", bulkAt);
    bulkAt = bulkAt + 1;
    i32 sfc2 = env.fieldCountOf(sn2);
    for (i32 f = 0; f < sfc2; f++) {
      string fn2 = env.fieldNameAt(sn2, f);
      exportFunc(exports, fnName, "$bind$s_" + bindNameFor(env, src, lexed, sn2) + "_get_" + fn2, bulkAt);
      exportFunc(exports, fnName, "$bind$s_" + bindNameFor(env, src, lexed, sn2) + "_set_" + fn2, bulkAt + 1);
      bulkAt = bulkAt + 2;
    }
  }
  // In the order `emitEnumHelpers` writes them, for each enum in turn.
  for (i32 si7 = 0; si7 < bindStructCount; si7++) {
    string en2 = bindStructs[si7];
    if (!env.isEnumName(en2)) { continue; }
    exportFunc(exports, fnName, "$bind$e_" + bindNameFor(env, src, lexed, en2) + "_tag", bulkAt);
    bulkAt = bulkAt + 1;
    for (i32 v = 0; v < env.variantCount; v++) {
      if (env.variantOwners[v] != en2) { continue; }
      string vn2 = bareVariantName(env.variantNames[v]);
      exportFunc(exports, fnName, "$bind$e_" + bindNameFor(env, src, lexed, en2) + "_" + vn2 + "_new", bulkAt);
      bulkAt = bulkAt + 1;
      for (i32 k = 0; k < env.variantArity[v]; k++) {
        exportFunc(exports, fnName,
                   "$bind$e_" + bindNameFor(env, src, lexed, en2) + "_" + vn2 + "_get_" +
                   payloadFieldName(env.fieldNameAt(en2, env.variantSlot[v] + k)), bulkAt);
        bulkAt = bulkAt + 1;
      }
    }
  }
  // In the order `emitStringBindHelpers` writes them.
  if (needsStrings) {
    exportFunc(exports, fnName, "$bind$str_new", bindStrHelpersAt);
    exportFunc(exports, fnName, "$bind$str_get", bindStrHelpersAt + 1);
    exportFunc(exports, fnName, "$bind$str_set", bindStrHelpersAt + 2);
    exportFunc(exports, fnName, "$bind$str_len", bindStrHelpersAt + 3);
    exportFunc(exports, fnName, "$bind$str_to_mem", bindStrHelpersAt + 4);
    exportFunc(exports, fnName, "$bind$str_from_mem", bindStrHelpersAt + 5);
  }

  for (i32 j = 0; j < env.cbSigCount; j++) {
    // **The trampolines are named without being exported**, which is why this is not `exportFunc`.
    // One per slot per signature — sixteen each — and they were the whole of what the name section
    // still left as `wasm-function[N]`: a host's callback runs *inside* one, so a trap in a function
    // the host passed in reported the only frame with no name on it. `$bind$tramp_<j>_<k>` is what
    // the reference calls them. [issue 0101]
    for (i32 k = 0; k < callbackSlots(); k++) {
      i32 at = cbHelpersAt + j * (callbackSlots() + 1) + k;
      if (at >= 0 && at < fnName.len()) {
        fnName[at] = "$bind$tramp_" + numText(j) + "_" + numText(k);
      }
    }
    exportFunc(exports, fnName, "$bind$fnref_" + numText(j), cbHelpersAt + j * (callbackSlots() + 1) + callbackSlots());
  }
  for (i32 j = 0; j < env.outSigCount; j++) {
    exportFunc(exports, fnName, "$bind$callref_" + numText(j), outHelpersAt + j);
  }
  if (env.coverage) {
    exportFunc(exports, fnName, "__cov_init", covHelpersAt);
    exportFunc(exports, fnName, "__cov_len", covHelpersAt + 1);
    exportFunc(exports, fnName, "__cov_get", covHelpersAt + 2);
  }
  // **The wrappers, named after what they wrap.** Every function in this module has a name — the test
  // that says so exists because a trap inside an unnamed one reports `wasm-function[N]` and nothing
  // else. A wrapper is the frame a call *through a `fn[…]` value* lands in, so it is exactly the
  // frame somebody debugging a callback will be looking at. `design/lang/0002`.
  for (i32 wi = 0; wi < wrapHelpers; wi++) {
    i32 wat = wrapHelpersAt + wi;
    if (wat < 0 || wat >= fnName.len()) { continue; }
    i32 target = env.cbSigCount + wi;
    fnName[wat] = target < fnName.len() && fnName[target] != ""
      ? "$fn$" + fnName[target]
      : "$fn$" + numText(wi);
  }
  for (i32 bi = 0; bi < boundHelpers; bi++) {
    i32 bat = boundHelpersAt + bi;
    if (bat < 0 || bat >= fnName.len()) { continue; }
    i32 btarget = env.cbSigCount + bi;
    fnName[bat] = btarget < fnName.len() && fnName[btarget] != ""
      ? "$bound$" + fnName[btarget]
      : "$bound$" + numText(bi);
  }
  // **The start function, named and not exported.** Nothing calls it — the engine does, before the
  // first export runs — so a trap while a module constant is being built reported the frame with no
  // name in it, in the 96 modules of this repository that have one. It is wac's own: the reference
  // emits no start section at all, having no module-level constants to initialise.
  if (startNeeded && startFunctionAt >= 0 && startFunctionAt < fnName.len()) {
    fnName[startFunctionAt] = "__wac_start";
  }
  exports.bytes(methodExports);

  section(out, 1, types);
  // **The imports, if any.** A module that takes no host function has no import section at all, so
  // everything that instantiated with nothing supplied still does.
  if (env.cbSigCount > 0) {
    B imports = B.create();
    imports.u32leb(env.cbSigCount);
    for (i32 j = 0; j < env.cbSigCount; j++) {
      imports.name("wac");
      imports.name("cb" + numText(j));
      imports.byte(0);                                  // a function
      imports.u32leb(env.sigType(dispatchSig(env.cbSigs[j])));
    }
    section(out, 2, imports);
  }
  section(out, 3, funcs);
  section(out, 5, mem);
  // The counter array is a global too, so a module with no constants still has a globals section
  // when it is instrumented — without which `global.get 0` names nothing.
  if (globalCount > 0 || env.coverage) { section(out, 6, globals); }
  section(out, 7, exports);
  if (startNeeded) {
    B st = B.create();
    st.u32leb(startFunctionAt);
    section(out, 8, st);
  }
  // **Every function declared as referenceable.** `ref.func` on a function that no element segment
  // mentions is *"undeclared function reference"* — a rule that exists so an engine knows which
  // functions can escape, and that costs one segment listing them all.
  if (count + helpers > 0) {
    B elems = B.create();
    elems.u32leb(1);
    elems.byte(3);    // declarative
    elems.byte(0);    // elemkind: funcref
    elems.u32leb(count + helpers);
    for (i32 i = 0; i < count + helpers; i++) { elems.u32leb(env.cbSigCount + i); }
    section(out, 9, elems);
  }
  section(out, 10, code);

  // **The `name` custom section**, last, after everything the format orders. Without it a trap in
  // this module is `wasm-function[147]`, and the number moves whenever anything before it does — and
  // for a program using a feature only this compiler has, there is no reference build to read
  // instead [issue 0101].
  {
    i32 total = fnName.len();
    // The imported dispatchers, one per callback signature, named for the signature they serve: four
    // identical `cb` frames in a profile are worth no more than none.
    for (i32 j = 0; j < env.cbSigCount && j < total; j++) {
      fnName[j] = "wac.cb" + numText(j) + " " + env.cbSigs[j];
    }
    // The module's own functions, under the key they were registered by — which carries the file for
    // a name two modules both declare, and `Owner.method` for a method. A builtin's key begins with a
    // space so that nothing written in wac can collide with it; a stack trace has no such problem and
    // reads better without it.
    for (i32 i = 0; i < env.funcCount; i++) {
      i32 idx = env.funcIndex[i];
      if (idx < 0 || idx >= total) { continue; }
      if (fnName[idx] != "") { continue; }          // an export already named it
      string nm = env.funcs[i];
      while (nm.len() > 0 && nm.slice(0, 1) == " ") { nm = nm.slice(1, nm.len()); }
      fnName[idx] = nm;
    }
    i32 named = 0;
    for (i32 i = 0; i < total; i++) { if (fnName[i] != "") { named = named + 1; } }
    if (named > 0) {
      B map = B.create();
      map.u32leb(named);
      for (i32 i = 0; i < total; i++) {
        if (fnName[i] == "") { continue; }
        map.u32leb(i);
        map.name(fnName[i]);
      }
      B names = B.create();
      names.name("name");
      names.byte(1);                    // the function-name subsection
      names.u32leb(map.len);
      names.bytes(map);
      section(out, 0, names);
    }
  }

  // **The standard `producers` section: which compiler made this.** Two compilers build this
  // repository, their output differs by a fifth in size, and an artefact that does not say which one
  // made it leaves "what built this page" answered by whatever the environment was when somebody ran
  // the command — `issues/lang/0103`. The format is the WebAssembly tool convention rather than one
  // invented here, so `wasm-objdump` and anything else that already reads it does.
  {
    B pr = B.create();
    pr.name("producers");
    pr.u32leb(1);            // one field
    pr.name("processed-by");
    pr.u32leb(1);            // one (value, version) pair
    pr.name("wacc");
    pr.name("");             // no version: this compiler has no number to give yet
    section(out, 0, pr);
  }

  u8[] result = u8[out.len]();
  for (i32 i = 0; i < out.len; i++) { result[i] = out.data[i]; }
  return result;
}

/** A token's text, which the emitter needs for an export's name and for every lookup. */
export string tokenTextOf(u8[] src, Lexed lexed, i32 t) {
  if (t < 0) { return ""; }
  i32 start = lexed.tokens[t * tokenStride() + 1];
  i32 len = lexed.tokens[t * tokenStride() + 2];
  u8[] out = u8[len]();
  for (i32 i = 0; i < len; i++) { out[i] = src[start + i]; }
  return string.fromBytes(out);
}

/** A declared type's name, enough to tell `void` from a value. */
string typeOfTyName(Env env, u8[] src, Lexed lexed, Ty t) {
  match (t.kind) {
    case Prim(tok): {
      return tokenTextOf(src, lexed, tok);
    }
    case Named(tok, typeArgs): {
      string raw = tokenTextOf(src, lexed, tok);
      // **`anyref` and `i31ref` are spelled as identifiers and declared by nobody.** The lexer has
      // no keyword for them, so they arrive here looking like a type name to resolve — and
      // resolution would go hunting for a declaration in the file, find none, and answer `""`,
      // which is how `i31ref x = …` came out as a bare `i32`.
      if (raw == "anyref" || raw == "i31ref") { return raw; }
      // A **type parameter** stands for its argument wherever it appears — a field's type, a
      // method's parameter, an array's element, a local inside a body.
      string bound = env.substituted(raw);
      if (bound != "") { return bound; }
      // Spelled with arguments, a name is an **instantiation**: registered on sight, compiled once.
      if (typeArgs.len() > 0) {
        string inst = raw + "<";
        // **The same arguments as the author wrote them**, kept beside the identity. They differ
        // only where a `?` was erased, and that difference is the one a host can see: it asks for
        // `Pending$u8ArrOpt`, which this emitter would otherwise have no name for at all.
        string spelled = raw + "<";
        for (i32 i = 0; i < typeArgs.len(); i++) {
          string at = typeOfTyName(env, src, lexed, typeArgs[i]);
          if (at == "") { return ""; }
          if (i > 0) { inst = inst + ","; spelled = spelled + ","; }
          inst = inst + at;
          spelled = spelled + at + (isNullableTy(typeArgs[i]) ? "?" : "");
        }
        inst = inst + ">";
        spelled = spelled + ">";
        env.instantiate(inst, raw);
        env.noteAlias(inst, spelled);
        return inst;
      }
      // Inside a template's own body its bare name is the instance being compiled: `Vec(T[](), 0)`
      // in `Vec<T>.create` builds a `Vec<i32>` when `T` is `i32`.
      if (raw == env.curGeneric && env.curInst != "") { return env.curInst; }
      // **The key, not the name.** Two linked files may each declare a `K`, and what tells them
      // apart is the line this one is written on.
      return env.keyAt(raw, tokenLine(lexed, tok));
    }
    // An array spells itself from the element out, exactly as the checker's `typeOfTy` does. Left
    // out, every array type came back as the empty string — the type section had no array entry, the
    // local was declared an `i32`, and the module asked for an array of whatever was on the stack.
    // A "" that means *unknown* propagates silently, which is the cost of using it for two things.
    case Arr(elem): {
      string inner = typeOfTyName(env, src, lexed, elem);
      return inner == "" ? "" : inner + "[]";
    }
    // **`T?` is `T`**, which is free here for the reason `array.new_default` forced two slots ago:
    // every reference this emitter writes is the nullable `0x63`, so a type that admits null and one
    // that does not are already the same wasm type and the difference is the checker's to keep. A
    // nullable *primitive* is not — there is no null `i32` — and comes back unspelled.
    // `fn[i32(i32, u8[])]` — spelled canonically, since the string *is* the identity: two spellings
    // of one signature have to reach the same type index or a value of one cannot be called as the
    // other.
    case Funcref(ret, params): {
      string r = typeOfTyName(env, src, lexed, ret);
      if (r == "") { return ""; }
      string out = "fn[" + r + "(";
      for (i32 i = 0; i < params.len(); i++) {
        string pt = typeOfTyName(env, src, lexed, params[i]);
        if (pt == "") { return ""; }
        if (i > 0) { out = out + ","; }
        out = out + pt;
      }
      return out + ")]";
    }
    case Nullable(inner): {
      match (inner.kind) {
        // A nullable **primitive** has no representation — there is no null `i32` — except that
        // `string` is a primitive by spelling and a reference by nature, so `string?` is a string.
        case Prim(tok): {
          string pn = tokenTextOf(src, lexed, tok);
          // **`anyref` and `i31ref` are references too**, and they lex as primitives — which is how
          // `anyref? interruptCtx;` became a field of no type at all, and `Shell.create` came back
          // as *a null in a slot of no known type* for the whole of `packages/sh`. A `string` was
          // already excepted here for exactly this reason; there are three such names, not one.
          // `spec/cases/0098`.
          return pn == "string" || pn == "anyref" || pn == "i31ref" ? pn : "";
        }
        else: { return typeOfTyName(env, src, lexed, inner); }
      }
    }
  }
}

/** Statements, in order. */
/**
 * The variant an arm names, within the enum it is matching on.
 *
 * A template's variants belong to its **instances**: `Some` in `Option<i32>` and `Some` in
 * `Option<string>` are two variants with one name, so an instance registers its own under a name
 * that carries the instance with it. Every place an arm's text becomes a variant comes through here
 * with the enum in hand — which is the only place that knows which `Some` is meant.
 */
string armVariant(Env env, u8[] src, Lexed lexed, i32 tok, string en) {
  string raw = tokenTextOf(src, lexed, tok);
  if (isInstance(en)) { return en + "." + raw; }
  // **Within this enum**, not within the file. Two enums in one module may each have an `Ok` — one
  // module here has an `Opened.Ok` and a `Found.Ok` — and resolving the arm by file scope finds
  // whichever was declared first, which is a different enum's variant with the same spelling.
  for (i32 i = 0; i < env.variantCount; i++) {
    if (env.variantOwners[i] != en) { continue; }
    string vk = env.variantNames[i];
    if (vk == raw) { return vk; }
    // A name two files declare is keyed with the file that declared it, so the arm's text is a
    // prefix of the key rather than the key.
    if (vk.len() > raw.len() && vk.slice(0, raw.len() + 1) == raw + "@") { return vk; }
  }
  return env.keyAt(raw, tokenLine(lexed, tok));
}

/**
 * The variant a `Enum.Variant` names, or `""` when the member is an ordinary field access.
 *
 * `Shape.Point` and `p.x` are the same node — a member of something — and only the table can tell
 * them apart: the object is a bare name that is an *enum*, and the member is one of its variants.
 */
/**
 * Where a method called on `t` is declared.
 *
 * A **payload-less variant used as a value** types as the variant — `Shape.Point` is a `Shape.Point`
 * and not a `Shape` — and an enum's methods are registered on the enum. So `Shape.Point.isFlat()`
 * asked for `isFlat` on `Shape.Point`, found nothing, and the emitter declined by name: *no method
 * Point.isFlat*. The reference compiles it. `issues/lang/0121`.
 *
 * The variant type is the right answer everywhere else — it is what lets a field access on a narrowed
 * value pick a slot without a match — so this widens the *lookup* rather than the type: ask the
 * variant, and if it has nothing, ask the enum that owns it.
 */
i32 methodOn(Env env, string t, string name) {
  i32 at = env.methodAt(t, name);
  if (at >= 0) { return at; }
  string owner = env.enumOf(t);
  return owner == "" ? -1 : env.methodAt(owner, name);
}

string variantOfMemberAt(u8[] src, Lexed lexed, Env env, Expr obj, i32 nameTok, string want) {
  match (obj.kind) {
    case Ident(tok): {
      // `Option.Some(3)` names a **template**, and which instance it is comes from the slot — the
      // same rule `Vec.create()` follows, because the instantiation is not in the call either way.
      if (isInstance(want) && templateOf(want) == tokenTextOf(src, lexed, tok)) {
        string vw = want + "." + tokenTextOf(src, lexed, nameTok);
        return env.enumOf(vw) == want ? vw : "";
      }
      string on = nameKeyOf(env, src, lexed, tok);
      if (!env.isEnumName(on)) { return ""; }
      return env.variantKeyIn(on, tokenTextOf(src, lexed, nameTok));
    }
    else: { return ""; }
  }
}

/** The same question with no slot in hand, which is every use but a template's. */
string variantOfMember(u8[] src, Lexed lexed, Env env, Expr obj, i32 nameTok) {
  return variantOfMemberAt(src, lexed, env, obj, nameTok, "");
}

/**
 * Which slot a field access on an enum value means: -1 for none, -2 for more than one.
 *
 * A value whose static type is a *variant* asks that variant. A value still typed as the enum — the
 * subject of an arm that did not narrow, since narrowing is a shadowed binding rather than a
 * retyping — asks every variant, and the answer is only usable if exactly one has the field. Two
 * variants with a field of the same name are a real shape (`Add(i32 lhs)`, `Sub(i32 lhs)`) and the
 * honest answer there is to decline rather than to pick the first.
 */
i32 enumSlot(Env env, string ty, string field) {
  string en = env.canonType(ty);
  if (env.enumOf(ty) != "") { return env.fieldIndex(en, ty + "." + field); }
  i32 found = -1;
  for (i32 i = 0; i < env.variantCount; i++) {
    if (env.variantOwners[i] != en) { continue; }
    i32 at = env.fieldIndex(en, env.variantNames[i] + "." + field);
    if (at < 0) { continue; }
    if (found >= 0 && found != at) { return -2; }
    found = at;
  }
  return found;
}

/**
 * A value of `t` that means nothing, for the payload slots a variant does not use.
 *
 * `struct.new` wants every field on the stack, and a `Circle` has to put *something* in `Rect`'s
 * two. A reference field takes a null — which is why every reference this emitter writes is the
 * nullable `0x63` and not `0x64`, a decision made one slot ago for arrays and paid off here.
 */
/**
 * A null of the right type — which is a different question from a default, and was the same one
 * until `S()` had to produce a `""` rather than a trap. `null` written in the source means this;
 * a slot nobody wrote into means `emitDefault`.
 */
void emitNull(B fb, Env env, string t) {
  // The two the format names rather than the module declares: `ref.null` takes a heap type, and
  // theirs is a single byte where a struct's is an index.
  if (t == "anyref") { fb.byte(208); fb.byte(110); return; }
  if (t == "i31ref") { fb.byte(208); fb.byte(108); return; }
  if (t == "string") { fb.byte(208); fb.i32leb(env.arrayType("i8[]")); return; }
  if (isArrayType(t)) { fb.byte(208); fb.i32leb(env.arrayType(t)); return; }
  if (isFuncrefType(t)) { fb.byte(208); fb.i32leb(env.pairType(t)); return; }
  if (env.isStructName(t)) { fb.byte(208); fb.i32leb(env.structType(t)); return; }
  emitDefault(fb, env, t);
}

/**
 * The value a slot holds when nothing is written into it — which for a reference is **not null**.
 *
 * `string`'s default is `""`, an array's is an empty one, and a struct's is a struct whose fields
 * are all defaulted in turn. `S()` and `string[3]()` are both spec'd to produce those, and emitting
 * `ref.null` for them typechecked and then trapped on the first `.len()`.
 *
 * A struct that reaches itself is the one case that must stop: a field of a struct's own type has
 * to be nullable for the type to be inhabitable at all, so `null` is its right answer and the guard
 * below is not an approximation.
 */
void emitDefault(B fb, Env env, string t) {
  // **A default `anyref` is null**, unlike a string or a struct: there is no value of the top type
  // to build, and an `anyref[3]()` is three empty slots by the same argument that makes a nullable
  // field's default a null.
  if (t == "anyref" || t == "i31ref") { emitNull(fb, env, t); return; }
  if (t == "string") {
    fb.byte(65);
    fb.i32leb(0);
    fb.byte(251);
    fb.u32leb(7);   // array.new_default — an empty i8[], which is ""
    fb.u32leb(env.arrayType("i8[]"));
    return;
  }
  if (isArrayType(t)) {
    fb.byte(65);
    fb.i32leb(0);
    fb.byte(251);
    fb.u32leb(7);
    fb.u32leb(env.arrayType(t));
    return;
  }
  if (env.isStructName(t)) {
    string canon = env.canonType(t);
    for (i32 i = 0; i < env.buildingCount; i++) {
      if (env.building[i] == canon) {
        fb.byte(208);
        fb.i32leb(env.structType(t));
        return;
      }
    }
    // An enum has no default — a tag of 0 is a variant, and choosing one would be inventing a
    // value the source did not write.
    if (env.isEnumName(canon)) {
      fb.byte(208);
      fb.i32leb(env.structType(t));
      return;
    }
    if (env.buildingCount < env.building.len()) {
      env.building[env.buildingCount] = canon;
      env.buildingCount = env.buildingCount + 1;
    }
    i32 n = env.fieldCountOf(canon);
    for (i32 i = 0; i < n; i++) {
      // A field written `N?` defaults to null; one written `N` defaults to a defaulted `N`.
      if (env.fieldNullableAt(canon, i)) {
        emitNull(fb, env, env.fieldTypeAt(canon, i));
        continue;
      }
      emitDefault(fb, env, env.fieldTypeAt(canon, i));
    }
    fb.byte(251);
    fb.u32leb(0);   // struct.new
    fb.u32leb(env.structType(t));
    env.buildingCount = env.buildingCount - 1;
    return;
  }
  if (isFuncrefType(t)) { fb.byte(208); fb.i32leb(env.pairType(t)); return; }
  i32 v = valType(t);
  if (v == 126) { fb.byte(66); fb.i64leb(0); return; }
  if (v == 125) { fb.byte(67); fb.f32bits(0.0); return; }
  if (v == 124) { fb.byte(68); fb.f64bits(0.0); return; }
  fb.byte(65);
  fb.i32leb(0);
}

/** `Shape.Circle(2.0)` — the tag, the payload in its own slots, and a default in everyone else's. */
void emitVariantNew(B fb, u8[] src, Lexed lexed, Env env, string vname, Expr?[] args) {
  i32 vi = env.variantAt(vname);
  if (vi < 0) { return; }
  string en = env.variantOwners[vi];
  i32 n = env.fieldCountOf(en);
  fb.byte(65);
  fb.i32leb(env.variantTags[vi]);
  for (i32 slot = 1; slot < n; slot++) {
    i32 k = slot - env.variantSlot[vi];
    string ft = env.fieldTypeAt(en, slot);
    if (k >= 0 && k < env.variantArity[vi] && k < args.len()) {
      if (!(args[k] is null)) {
        emitExprAt(fb, src, lexed, env, args[k]!, ft);
        continue;
      }
    }
    emitNull(fb, env, ft);
  }
  fb.byte(251);
  fb.u32leb(0);   // struct.new
  fb.u32leb(env.structType(en));
}

/**
 * Which variant `Node.Element` is, or `-1` when the program never imported the tree.
 *
 * **By owner, not by name.** A variant is recorded under its own declared name — `Element` — and a
 * name two files declare is keyed, so neither `"Element"` nor `"Node.Element"` finds it reliably.
 * The owner is the enum, which is what makes this unambiguous: a program with its own `Element`
 * variant on its own enum does not collide with core's.
 */
/** Which variant `Node.Fragment` is, found the same way and for the same reason as `Element`. */
i32 jsxFragmentVariant(Env env) {
  for (i32 i = 0; i < env.variantCount; i++) {
    string owner = env.variantOwners[i];
    bool isNode = owner == "Node" || (owner.len() > 5 && owner.slice(0, 5) == "Node@");
    string vn = env.variantNames[i];
    bool isFragment = vn == "Fragment" || (vn.len() > 9 && vn.slice(0, 9) == "Fragment@");
    if (isNode && isFragment) { return i; }
  }
  return -1;
}

i32 jsxElementVariant(Env env) {
  for (i32 i = 0; i < env.variantCount; i++) {
    string owner = env.variantOwners[i];
    bool isNode = owner == "Node" || (owner.len() > 5 && owner.slice(0, 5) == "Node@");
    string vn = env.variantNames[i];
    bool isElement = vn == "Element" || (vn.len() > 8 && vn.slice(0, 8) == "Element@");
    if (isNode && isElement) { return i; }
  }
  return -1;
}

/**
 * `<div class="a">{kid}</div>` — the tree, written where types are strings.
 *
 * This is the whole of why the node survives to the emitter: `Node`, `Attr`, `Node[]` and `Attr[]`
 * are named here without a token existing for any of them, which is what the parser could not do.
 * The shape is `emitVariantNew`'s — a tag constant, one value per slot, `struct.new` — with the
 * three values built rather than taken from expressions.
 */
/**
 * `<Card title="x">kid</Card>` — a component, which is `Card { title: "x" }.render(Node[](kid))`.
 *
 * Written as the two instructions that desugaring is rather than by building an AST: the attributes
 * are put back in **declaration order** exactly as a named construction is (wasm's `struct.new`
 * takes fields in order and knows nothing about names), the receiver is pushed first because that is
 * what a method is here, and the children are the one argument. `design/lang/0005`.
 */
void emitJsxComponent(B fb, u8[] src, Lexed lexed, Env env, string comp,
                      JsxAttr[] attrs, Expr[] kids) {
  i32 nf = env.fieldCountOf(comp);
  for (i32 i = 0; i < nf; i++) {
    bool wrote = false;
    for (i32 j = 0; j < attrs.len(); j++) {
      if (env.fieldIndex(comp, tokenTextOf(src, lexed, attrs[j].nameTok)) != i) { continue; }
      emitExprAt(fb, src, lexed, env, attrs[j].value, env.fieldTypeAt(comp, i));
      wrote = true;
    }
    // An attribute that was not written is null, exactly as an omitted field of a named construction
    // is — the same rule, because this is one.
    if (!wrote) { emitNull(fb, env, env.fieldTypeAt(comp, i)); }
  }
  fb.byte(251);
  fb.u32leb(0);   // struct.new — the component, in declaration order
  fb.u32leb(env.structType(comp));
  emitJsxKids(fb, src, lexed, env, kids);
  i32 at = env.methodAt(comp, "render");
  if (at < 0 || env.funcIndex[at] < 0) { return; }
  fb.byte(16);    // call
  fb.u32leb(env.funcIndex[at]);
}

void emitJsx(B fb, u8[] src, Lexed lexed, Env env, i32 tagTok, JsxAttr[] attrs, Expr[] kids) {
  i32 vi = jsxElementVariant(env);
  // **A fragment**: no tag, no attributes, and its children where an element's would be.
  if (tagTok < 0) {
    i32 fi = jsxFragmentVariant(env);
    if (fi < 0) { return; }
    string fen = env.variantOwners[fi];
    i32 nfrag = env.fieldCountOf(fen);
    fb.byte(65);
    fb.i32leb(env.variantTags[fi]);
    for (i32 slot = 1; slot < nfrag; slot++) {
      i32 k = slot - env.variantSlot[fi];
      if (k == 0) { emitJsxKids(fb, src, lexed, env, kids); continue; }
      emitNull(fb, env, env.fieldTypeAt(fen, slot));
    }
    fb.byte(251);
    fb.u32leb(0);   // struct.new
    fb.u32leb(env.structType(fen));
    return;
  }
  // **A tag that names a struct in scope is a component**, resolved by the same key every other name
  // goes through — so a `Card` two files declare is the one this file can see. `design/lang/0005`.
  string comp = nameKeyOf(env, src, lexed, tagTok);
  if (env.isStructName(comp) && env.methodAt(comp, "render") >= 0) {
    emitJsxComponent(fb, src, lexed, env, comp, attrs, kids);
    return;
  }
  if (vi < 0) { return; }
  string en = env.variantOwners[vi];
  i32 n = env.fieldCountOf(en);
  fb.byte(65);
  fb.i32leb(env.variantTags[vi]);
  for (i32 slot = 1; slot < n; slot++) {
    i32 k = slot - env.variantSlot[vi];
    if (k == 0) { emitRawString(fb, env, tokenTextOf(src, lexed, tagTok)); continue; }
    if (k == 1) { emitJsxAttrs(fb, src, lexed, env, attrs); continue; }
    if (k == 2) { emitJsxKids(fb, src, lexed, env, kids); continue; }
    emitNull(fb, env, env.fieldTypeAt(en, slot));
  }
  fb.byte(251);
  fb.u32leb(0);   // struct.new
  fb.u32leb(env.structType(en));
}

/** A `string` from text the source did not quote — a tag name, or an attribute's name. */
void emitRawString(B fb, Env env, string text) {
  u8[] bytes = text.toBytes();
  for (i32 i = 0; i < bytes.len(); i++) {
    fb.byte(65);
    fb.i32leb(bytes[i]);
  }
  fb.byte(251);
  fb.u32leb(8);   // array.new_fixed
  fb.u32leb(env.arrayType("i8[]"));
  fb.u32leb(bytes.len());
}

/** `Attr[](Attr("class", "a"), …)`, one `struct.new` per attribute. */
void emitJsxAttrs(B fb, u8[] src, Lexed lexed, Env env, JsxAttr[] attrs) {
  for (i32 i = 0; i < attrs.len(); i++) {
    emitRawString(fb, env, tokenTextOf(src, lexed, attrs[i].nameTok));
    emitExprAt(fb, src, lexed, env, attrs[i].value, "string");
    fb.byte(251);
    fb.u32leb(0);   // struct.new
    fb.u32leb(env.structType("Attr"));
  }
  fb.byte(251);
  fb.u32leb(8);     // array.new_fixed
  fb.u32leb(env.arrayType("Attr[]"));
  fb.u32leb(attrs.len());
}

/**
 * `Node.Text("hello")` from a span of the source.
 *
 * **Trimmed at the ends, kept in the middle** — `design/lang/0004`'s one chosen rule rather than
 * derived one: `<p> hello  world </p>` is `Text("hello  world")`. A run that is only whitespace is
 * still emitted here; the parser is what decides whether to keep it, because only the parser knows
 * whether it sat between two elements.
 */
void emitJsxText(B fb, u8[] src, Env env, i32 startOff, i32 endOff) {
  // The whitespace rule is `jsxTrim` in `ast.wac`, because the parser applies the same one to decide
  // whether a run is a child at all.
  JsxSpan span = jsxTrim(src, startOff, endOff);
  i32 from = span.from;
  i32 to = span.to;
  i32 vi = jsxTextVariant(env);
  if (vi < 0) { return; }
  string en = env.variantOwners[vi];
  i32 n = env.fieldCountOf(en);
  fb.byte(65);
  fb.i32leb(env.variantTags[vi]);
  for (i32 slot = 1; slot < n; slot++) {
    i32 k = slot - env.variantSlot[vi];
    if (k == 0) {
      for (i32 i = from; i < to; i++) {
        fb.byte(65);
        fb.i32leb(src[i]);
      }
      fb.byte(251);
      fb.u32leb(8);   // array.new_fixed
      fb.u32leb(env.arrayType("i8[]"));
      fb.u32leb(to - from);
      continue;
    }
    emitNull(fb, env, env.fieldTypeAt(en, slot));
  }
  fb.byte(251);
  fb.u32leb(0);     // struct.new
  fb.u32leb(env.structType(en));
}

/** `Node.Text`, found the same way `Node.Element` is: by owner, because a name may be keyed. */
i32 jsxTextVariant(Env env) {
  for (i32 i = 0; i < env.variantCount; i++) {
    string owner = env.variantOwners[i];
    bool isNode = owner == "Node" || (owner.len() > 5 && owner.slice(0, 5) == "Node@");
    string vn = env.variantNames[i];
    bool isText = vn == "Text" || (vn.len() > 5 && vn.slice(0, 5) == "Text@");
    if (isNode && isText) { return i; }
  }
  return -1;
}

/** `Node[](…)` — every child is already a `Node`, including a nested element. */
void emitJsxKids(B fb, u8[] src, Lexed lexed, Env env, Expr[] kids) {
  for (i32 i = 0; i < kids.len(); i++) {
    emitExprAt(fb, src, lexed, env, kids[i], "Node");
  }
  fb.byte(251);
  fb.u32leb(8);     // array.new_fixed
  fb.u32leb(env.arrayType("Node[]"));
  fb.u32leb(kids.len());
}

/** The tag of the value on the stack, which is what every arm and every `is` compares. */
void emitTagOf(B fb, Env env, i32 subj, string en) {
  fb.byte(32);
  fb.u32leb(subj);
  fb.byte(251);
  fb.u32leb(2);   // struct.get
  fb.u32leb(env.structType(en));
  fb.u32leb(0);
}

/**
 * An arm's names: its payload bindings, and the narrowed subject.
 *
 * Both are **added while the body is emitted and retired after it**, which is possible only because
 * the locals *declaration* is written once the body is finished. That makes the shadowing lexical
 * for free: a binding is found before an outer local of the same name because `localAt` searches
 * backwards, and retiring the entry by renaming it — rather than by dropping it — keeps the wasm
 * slot and its type, which the declaration list still has to describe.
 */
void emitArmNames(B fb, u8[] src, Lexed lexed, Env env, i32 subj, string vn, i32[] bindingToks,
                  Expr subject) {
  i32 vi = env.variantAt(vn);
  if (vi < 0) { return; }
  string en = env.variantOwners[vi];
  for (i32 b = 0; b < bindingToks.len(); b++) {
    if (b >= env.variantArity[vi]) { continue; }
    string bn = tokenTextOf(src, lexed, bindingToks[b]);
    if (bn == "_") { continue; }
    env.addLocal(bn, env.fieldTypeAt(en, env.variantSlot[vi] + b));
    i32 at = env.localCount - 1;
    fb.byte(32);
    fb.u32leb(subj);
    fb.byte(251);
    fb.u32leb(2);
    fb.u32leb(env.structType(en));
    fb.u32leb(env.variantSlot[vi] + b);
    fb.byte(33);
    fb.u32leb(at);
  }
  // **Narrowing is a binding, not a retyping** — the spec says so, and it is also the only version
  // this emitter could implement: the subject keeps its wasm type either way, and what the arm needs
  // is a *name* whose wac type is the variant, so `s.width` resolves to one slot rather than to
  // whichever variant declared that field first.
  match (subject.kind) {
    case Ident(tok): {
      env.addLocal(tokenTextOf(src, lexed, tok), vn);
      i32 sh = env.localCount - 1;
      fb.byte(32);
      fb.u32leb(subj);
      fb.byte(33);
      fb.u32leb(sh);
    }
    else: { }
  }
}

/** Retire every name an arm introduced, keeping the slots it declared. */
void retireFrom(Env env, i32 from) {
  for (i32 i = from; i < env.localCount; i++) { env.locals[i] = " gone"; }
}

/**
 * `match` as a statement: a comparison chain on the tag, each arm nested in the previous one's else.
 *
 * Nesting rather than a block-and-branch per arm is what makes `break` mean the enclosing **loop**,
 * which is what the language says an arm's `break` does and the one place `match` differs from
 * `switch`. An `if` is a label like any other, so `env.depth` counts every one of them or a `break`
 * three arms deep branches to the wrong place — and validates while doing it.
 */
void emitMatchStmt(B fb, u8[] src, Lexed lexed, Env env, Expr subject, Arm[] arms) {
  string en = env.canonType(typeOfE(src, lexed, env, subject));
  if (!env.isEnumName(en)) { return; }
  env.addLocal(" match", en);
  i32 subj = env.localCount - 1;
  emitExprAt(fb, src, lexed, env, subject, en);
  fb.byte(33);
  fb.u32leb(subj);
  // **The `else` arm is the default wherever it is written**, and this chain used to emit each arm
  // where it stood — so an `else` written *first* had its body emitted unconditionally and no `case`
  // was ever reached. `typeOfE` in this file has exactly that shape, which is why the compiler this
  // compiler emits could not type a call: every one of them took the default.
  i32 elseAt = -1;
  i32 cases = 0;
  for (i32 a = 0; a < arms.len(); a++) {
    if (arms[a].variantTok < 0) { elseAt = a; } else { cases = cases + 1; }
  }
  i32 opened = 0;
  i32 done = 0;
  for (i32 a = 0; a < arms.len(); a++) {
    if (a == elseAt) { continue; }
    string vn = armVariant(env, src, lexed, arms[a].variantTok, en);
    emitTagOf(fb, env, subj, en);
    fb.byte(65);
    fb.i32leb(env.variantTags[env.variantAt(vn)]);
    fb.byte(70);   // i32.eq
    fb.byte(4);
    fb.byte(64);
    env.depth = env.depth + 1;
    opened = opened + 1;
    i32 saved = env.localCount;
    // **Every arm is a decision.** A `match` with five variants is five branches, and this compiler
    // recorded none of them — 125 in `packages/fs` alone. `issues/lang/0112`, and its point is the
    // one worth repeating: a construct that stops being instrumented makes the number go *up*.
    covPoint(fb, env, "case", tokenLine(lexed, arms[a].variantTok),
             tokenCol(lexed, arms[a].variantTok));
    emitArmNames(fb, src, lexed, env, subj, vn, arms[a].bindingToks, subject);
    emitBody(fb, src, lexed, env, arms[a].body);
    retireFrom(env, saved);
    done = done + 1;
    // The rest of the chain — and the default, if there is one — goes in this arm's `else`.
    if (done < cases || elseAt >= 0) { fb.byte(5); }
  }
  if (elseAt >= 0) {
    // An `else` arm is an arm: the reference records one and so does this, or a `match` with a
    // catch-all reports every branch but the one that catches.
    covPoint(fb, env, "case", tokenLine(lexed, arms[elseAt].variantTok),
             tokenCol(lexed, arms[elseAt].variantTok));
    emitBody(fb, src, lexed, env, arms[elseAt].body);
  }
  for (i32 i = 0; i < opened; i++) {
    fb.byte(11);
    env.depth = env.depth - 1;
  }
}

/**
 * `match` as an expression, where every arm leaves a value.
 *
 * The **last arm is not tested**. An `if` that produces a value must have an else branch, and the
 * match is exhaustive, so the final arm is that branch: the test would be a comparison whose answer
 * is already known, and without it there is nowhere to put the value.
 */
void emitMatchExpr(B fb, u8[] src, Lexed lexed, Env env, Expr subject, Arm[] arms, string want) {
  string en = env.canonType(typeOfE(src, lexed, env, subject));
  if (!env.isEnumName(en) || arms.len() == 0) { return; }
  string rt = "";
  for (i32 a = 0; a < arms.len(); a++) {
    if (arms[a].value is null) { continue; }
    if (rt != "") { continue; }
    i32 saved = pushArmNames(src, lexed, env, arms[a], subject);
    rt = typeOfE(src, lexed, env, arms[a].value!);
    env.localCount = saved;
  }
  if (rt == "") { rt = want; }
  env.addLocal(" match", en);
  i32 subj = env.localCount - 1;
  emitExprAt(fb, src, lexed, env, subject, en);
  fb.byte(33);
  fb.u32leb(subj);
  // The same reordering as the statement form, and for the same reason. What differs is which arm
  // is *untested*: an `if` that produces a value must have an else branch, so the default goes there
  // — and where there is no default, the last case does, since the match is exhaustive.
  i32 elseAt = -1;
  i32 cases = 0;
  for (i32 a = 0; a < arms.len(); a++) {
    if (arms[a].variantTok < 0) { elseAt = a; } else { cases = cases + 1; }
  }
  i32 opened = 0;
  i32 done = 0;
  for (i32 a = 0; a < arms.len(); a++) {
    if (a == elseAt) { continue; }
    done = done + 1;
    bool tail = elseAt < 0 && done == cases;
    string vn = armVariant(env, src, lexed, arms[a].variantTok, en);
    if (!tail) {
      emitTagOf(fb, env, subj, en);
      fb.byte(65);
      fb.i32leb(env.variantTags[env.variantAt(vn)]);
      fb.byte(70);
      fb.byte(4);
      writeValType(fb, env, rt);
      env.depth = env.depth + 1;
      opened = opened + 1;
    }
    i32 saved = env.localCount;
    // The expression form's arms are decisions too — the statement form's are recorded in
    // `emitMatchStmt`, and a `match` used for its value is the commoner of the two in this codebase.
    covPoint(fb, env, "case", tokenLine(lexed, arms[a].variantTok),
             tokenCol(lexed, arms[a].variantTok));
    emitArmNames(fb, src, lexed, env, subj, vn, arms[a].bindingToks, subject);
    if (!(arms[a].value is null)) { emitExprAt(fb, src, lexed, env, arms[a].value!, rt); }
    retireFrom(env, saved);
    if (!tail) { fb.byte(5); }
  }
  if (elseAt >= 0 && !(arms[elseAt].value is null)) {
    covPoint(fb, env, "case", tokenLine(lexed, arms[elseAt].variantTok),
             tokenCol(lexed, arms[elseAt].variantTok));
    emitExprAt(fb, src, lexed, env, arms[elseAt].value!, rt);
  }
  for (i32 i = 0; i < opened; i++) {
    fb.byte(11);
    env.depth = env.depth - 1;
  }
}

/**
 * A statement list, which is exactly a **scope**.
 *
 * The locals a block declares are added as its `var`s are emitted and retired when it ends — by
 * renaming rather than by dropping, since the slot they claimed still has to be declared in the
 * function's header. That is the whole of block scoping: two blocks declaring `k` at two types are
 * two locals, `localAt` searches backwards so the inner one shadows, and neither can see the other.
 *
 * It replaces a pre-pass that collected every local in the function by name, which could not tell
 * the two `k`s apart and declined the function rather than get it wrong.
 */
void emitBody(B fb, u8[] src, Lexed lexed, Env env, Stmt[] body) {
  i32 saved = env.localCount;
  for (i32 i = 0; i < body.len(); i++) { emitStmt(fb, src, lexed, env, body[i]); }
  retireFrom(env, saved);
}

/**
 * One statement.
 *
 * `if` and `while` are wasm's structured control flow rather than jumps, which is the one place the
 * emitted shape is *simpler* than the language's: a `while` is a `block` wrapping a `loop`, the
 * condition inverted and branching out of the block, the body branching back to the loop's top. The
 * two labels are relative — 1 is the block, 0 is the loop — and getting them the wrong way round
 * produces a module that validates and hangs, which is why both are tested by running.
 */
void emitStmt(B fb, u8[] src, Lexed lexed, Env env, Stmt s) {
  match (s.kind) {
    case Var(type, nameTok, init, isConst): {
      string vt = typeOfTyName(env, src, lexed, type);
      emitExprAt(fb, src, lexed, env, init, vt);
      // **Declared here, not in a pre-pass.** The slot belongs to this statement, so a second `var`
      // of the same name is a second slot rather than a collision.
      env.addLocal(tokenTextOf(src, lexed, nameTok), vt);
      fb.byte(33);   // local.set
      fb.u32leb(env.localCount - 1);
    }
    case Assign(rawTarget, op, rhs): {
      Lvalue target = peelLv(rawTarget);
      match (target.kind) {
        case LField(base, nameTok): {
          string ot3 = typeOfLv(src, lexed, env, base);
          if (!env.isStructName(ot3)) { return; }
          string fname = tokenTextOf(src, lexed, nameTok);
          i32 slot = env.enumOf(ot3) != "" || env.isEnumName(ot3)
            ? enumSlot(env, ot3, fname) : env.fieldIndex(ot3, fname);
          string fty = env.enumOf(ot3) != "" || env.isEnumName(ot3)
            ? env.fieldTypeAt(env.canonType(ot3), slot) : env.fieldType(ot3, fname);
          i32 kf = lexed.tokens[op * tokenStride()];
          // **`p.x += 1` is a read, an operator and a write**, and this arm had none of the first two:
          // it emitted the assignment and dropped the operator, so the field was *replaced* by the
          // right-hand side. It validated, so nothing caught it — the field ended up an `i32` either
          // way — and no differential case had ever compounded into anything but a local.
          if (kf != kAssign()) {
            i32 b = env.scratchNamed("cmpbase", ot3);
            emitLvalue(fb, src, lexed, env, base);
            fb.byte(34);            // local.tee, so the base is evaluated once
            fb.u32leb(b);
            fb.byte(32);
            fb.u32leb(b);
            fb.byte(251);
            fb.u32leb(2);           // struct.get — the current value
            fb.u32leb(env.structType(ot3));
            fb.u32leb(slot);
            // **A shift's amount is converted, not assumed** — the same rule the binary operator
            // follows, and the compound form did not: `b.v <<= n` with an `i64` field and an `i32`
            // amount emitted `i64.shl` with an `i32` on the stack and the module would not load.
            // `emitExprAt` steers a *literal*; a typed local ignores it and arrives as itself, which
            // is why this is `emitAt`. `issues/lang/0117`.
            if (isShiftAssign(kf)) { emitAt(fb, src, lexed, env, rhs, fty); }
            else { emitExprAt(fb, src, lexed, env, rhs, fty); }
            emitCompound(fb, env, kf, fty);
            fb.byte(251);
            fb.u32leb(5);
            fb.u32leb(env.structType(ot3));
            fb.u32leb(slot);
            return;
          }
          emitLvalue(fb, src, lexed, env, base);
          emitExprAt(fb, src, lexed, env, rhs, fty);
          fb.byte(251);
          fb.u32leb(5);   // struct.set
          fb.u32leb(env.structType(ot3));
          fb.u32leb(slot);
        }
        case LIndex(base, index): {
          // The array and the index are pushed before the value, which is the order `array.set`
          // wants and the reverse of how the statement reads.
          string bt = typeOfLv(src, lexed, env, base);
          i32 ki = lexed.tokens[op * tokenStride()];
          // The same read-apply-write as a field, and the same bug: `a[i] += 1` was `a[i] = 1`. Both
          // operands are spilled first so that `a` and `i` are evaluated once and in source order.
          if (ki != kAssign()) {
            i32 ab = env.scratchNamed("cmparr", bt);
            i32 ix = env.scratchNamed("cmpidx", "i32");
            emitLvalue(fb, src, lexed, env, base);
            fb.byte(33);
            fb.u32leb(ab);
            emitAt(fb, src, lexed, env, index, "i32");
            fb.byte(33);
            fb.u32leb(ix);
            fb.byte(32); fb.u32leb(ab);
            fb.byte(32); fb.u32leb(ix);
            fb.byte(32); fb.u32leb(ab);
            fb.byte(32); fb.u32leb(ix);
            emitArrayGet(fb, env, bt);
            emitAt(fb, src, lexed, env, rhs, elemOf(bt));
            emitCompound(fb, env, ki, elemOf(bt));
            fb.byte(251);
            fb.u32leb(14);   // array.set
            fb.u32leb(env.arrayType(bt));
            return;
          }
          emitLvalue(fb, src, lexed, env, base);
          emitAt(fb, src, lexed, env, index, "i32");
          emitAt(fb, src, lexed, env, rhs, elemOf(bt));
          fb.byte(251);
          fb.u32leb(14);   // array.set
          fb.u32leb(env.arrayType(bt));
        }
        case LIdent(tok): {
          string name = tokenTextOf(src, lexed, tok);
          i32 at = env.localAt(name);
          if (at < 0) { return; }
          i32 k = lexed.tokens[op * tokenStride()];
          if (k != kAssign()) {
            // `n += 1` is `n = n + 1` with the operator spelled into the assignment, so the target is
            // pushed first and the compound operator applied to the pair.
            fb.byte(32);
            fb.u32leb(at);
          }
          string at2 = env.localTypes[at];
          // See the field case above: a shift's amount is converted rather than assumed.
          if (isShiftAssign(k)) { emitAt(fb, src, lexed, env, rhs, at2); }
          else { emitExprAt(fb, src, lexed, env, rhs, at2); }
          if (k != kAssign()) { emitCompound(fb, env, k, at2); }
          fb.byte(33);
          fb.u32leb(at);
        }
        else: { }
      }
    }
    case Return(value): {
      // The **function's** return type, which a `return` is the one statement that needs and the only
      // one that had no way to know: `return 1;` in an `i64` function is an `i64` constant, and
      // emitting it at the literal's own guess made seven corpus files invalid at once.
      if (!(value is null)) { emitExprAt(fb, src, lexed, env, value!, env.returnType); }
      fb.byte(15);   // return
    }
    case If(cond, then, els): {
      emitExpr(fb, src, lexed, env, cond);
      fb.byte(4);    // if
      fb.byte(64);   // blocktype: nothing
      env.depth = env.depth + 1;
      covPoint(fb, env, "then", s.line, s.col);
      // **`if (s is Circle)` makes `s` a `Circle` inside the block**, which the checker does by
      // shadowing the binding and this had no equivalent of at all. A field access was declined —
      // `untyped member` — and a method call was worse: it resolved against the *declared* type, so
      // an `override` was not called and the answer was silently the parent's. `issues/lang/0116`.
      //
      // The same shadow, in the emitter's own terms: a fresh local of the narrowed type, cast once
      // at the top of the block, under the same name — and `localAt` searches backwards, so the
      // inner one wins for exactly as long as it is alive.
      i32 savedNarrow = env.localCount;
      narrowInto(fb, src, lexed, env, cond);
      emitBody(fb, src, lexed, env, then);
      retireFrom(env, savedNarrow);
      if (els.len() > 0) {
        fb.byte(5);  // else
        covPoint(fb, env, "else", s.line, s.col);
        emitBody(fb, src, lexed, env, els);
      }
      // **An `else` a host can tell apart from a missing one.** wasm needs no `else` arm for an
      // `if` with none, but a coverage reader does: a point that never fires and a branch that was
      // never written are different facts about a program.
      if (els.len() == 0 && env.coverage) {
        fb.byte(5);
        covPoint(fb, env, "else", s.line, s.col);
      }
      fb.byte(11);   // end
      env.depth = env.depth - 1;
    }
    case While(cond, inner): {
      emitLoop(fb, src, lexed, env, cond, inner, null);
    }
    case DoWhile(inner, cond): {
      // The body runs before the condition is asked, so the test moves to the bottom: the loop
      // branches back only while it holds, and there is no jump out at the top to write.
      i32 savedB = env.breakAt;
      i32 savedC = env.continueAt;
      fb.byte(2);
      fb.byte(64);
      env.depth = env.depth + 1;
      env.breakAt = env.depth;
      fb.byte(3);
      fb.byte(64);
      env.depth = env.depth + 1;
      // The same inner block as `for`, so `continue` lands on the condition rather than skipping it.
      fb.byte(2);
      fb.byte(64);
      env.depth = env.depth + 1;
      env.continueAt = env.depth;
      emitBody(fb, src, lexed, env, inner);
      fb.byte(11);
      env.depth = env.depth - 1;
      emitExpr(fb, src, lexed, env, cond);
      fb.byte(13);
      fb.u32leb(0);
      fb.byte(11);
      fb.byte(11);
      env.depth = env.depth - 2;
      env.breakAt = savedB;
      env.continueAt = savedC;
    }
    case For(init, cond, update, inner): {
      // **The loop's own scope.** `for (i32 i = …)` beside an outer `i` is two locals, and the
      // init is emitted outside the body — so without this the loop's `i` stayed in the enclosing
      // scope and `localAt` found it afterwards, since it searches backwards. The spec has a case
      // for exactly this and it read 10 where the outer `i` was 99.
      i32 savedFor = env.localCount;
      if (!(init is null)) { emitStmt(fb, src, lexed, env, init!); }
      emitLoop(fb, src, lexed, env, cond is null ? null : cond, inner, update);
      retireFrom(env, savedFor);
    }
    case Break: {
      fb.byte(12);
      fb.u32leb(env.depth - env.breakAt);
    }
    case Continue: {
      fb.byte(12);
      fb.u32leb(env.depth - env.continueAt);
    }
    case Trap: { fb.byte(0); }
    case Switch(subject, cases): {
      // A chain of comparisons rather than a jump table. `br_table` is what the reference emits and
      // is an optimisation of exactly this — the values a canonical form would have to normalise
      // anyway, and the answers are what this rung compares.
      i32 savedS = env.breakAt;
      fb.byte(2);
      fb.byte(64);
      env.depth = env.depth + 1;
      env.breakAt = env.depth;
      string st = typeOfE(src, lexed, env, subject);
      for (i32 i = 0; i < cases.len(); i++) {
        if (cases[i].value is null) { continue; }
        emitExprAt(fb, src, lexed, env, subject, st);
        emitExprAt(fb, src, lexed, env, cases[i].value!, st);
        emitBinary(fb, env, kEq(), st);
        fb.byte(4);
        fb.byte(64);
        env.depth = env.depth + 1;
        covPoint(fb, env, "case", cases[i].line, cases[i].col);
        emitBody(fb, src, lexed, env, cases[i].body);
        // **Leave the switch when an arm has run.** A wac `case` is a block and not a label, so
        // nothing falls out of it — and this emitted the arms as a chain of `if`s with the default
        // *after* them, unconditionally. A later case did not run, because its comparison failed;
        // the default ran every time. `packages/json` wrote every escape twice and `"a\"b"` came
        // back as `"a\""b"`: the `case '"'` arm pushed `\"` and then `default` pushed the byte
        // again. The branch is to the block this statement opened, which is where `break` goes too.
        // `spec/cases/0089`.
        fb.byte(12);
        fb.u32leb(env.depth - env.breakAt);
        env.depth = env.depth - 1;
        fb.byte(11);
      }
      for (i32 i = 0; i < cases.len(); i++) {
        if (!(cases[i].value is null)) { continue; }
        covPoint(fb, env, "case", cases[i].line, cases[i].col);
        emitBody(fb, src, lexed, env, cases[i].body);
      }
      fb.byte(11);
      env.depth = env.depth - 1;
      env.breakAt = savedS;
    }
    case IncrStmt(rawTarget, op): {
      Lvalue target = peelLv(rawTarget);
      // `i++` is the commonest `for` update in the language and had **no arm here at all**, so the
      // update emitted nothing and the loop never advanced. It did not fail: it validated and span,
      // and the test hung rather than reporting — which is the failure mode this rung's oracle was
      // chosen to catch and the one it cannot report politely.
      match (target.kind) {
        case LIdent(tok): {
          i32 at = env.localAt(tokenTextOf(src, lexed, tok));
          if (at < 0) { return; }
          string t = env.localTypes[at];
          fb.byte(32);
          fb.u32leb(at);
          if (valType(t) == 126) { fb.byte(66); fb.i64leb(1); } else { fb.byte(65); fb.i32leb(1); }
          emitBinary(fb, env, lexed.tokens[op * tokenStride()] == kInc() ? kPlus() : kMinus(), t);
          fb.byte(33);
          fb.u32leb(at);
        }
        // **And the same for a field**, which this arm did not have — so `this.pos++` emitted
        // nothing at all, and `lex.wac`'s cursor never advanced. That is a lexer that validates and
        // loops for ever, and it is what the bootstrap found in its first minute: 336 corpus files
        // and three and a half thousand generated programs had never incremented a field.
        case LField(base, nameTok): {
          string ot4 = typeOfLv(src, lexed, env, base);
          if (!env.isStructName(ot4)) { return; }
          string fn4 = tokenTextOf(src, lexed, nameTok);
          i32 slot4 = env.enumOf(ot4) != "" || env.isEnumName(ot4)
            ? enumSlot(env, ot4, fn4) : env.fieldIndex(ot4, fn4);
          string ft4 = env.enumOf(ot4) != "" || env.isEnumName(ot4)
            ? env.fieldTypeAt(env.canonType(ot4), slot4) : env.fieldType(ot4, fn4);
          i32 b4 = env.scratchNamed("incbase", ot4);
          emitLvalue(fb, src, lexed, env, base);
          fb.byte(34);
          fb.u32leb(b4);
          fb.byte(32);
          fb.u32leb(b4);
          fb.byte(251);
          fb.u32leb(2);
          fb.u32leb(env.structType(ot4));
          fb.u32leb(slot4);
          if (valType(ft4) == 126) { fb.byte(66); fb.i64leb(1); } else { fb.byte(65); fb.i32leb(1); }
          emitBinary(fb, env, lexed.tokens[op * tokenStride()] == kInc() ? kPlus() : kMinus(), ft4);
          fb.byte(251);
          fb.u32leb(5);
          fb.u32leb(env.structType(ot4));
          fb.u32leb(slot4);
        }
        case LIndex(base, index): {
          string bt4 = typeOfLv(src, lexed, env, base);
          if (!isArrayType(bt4)) { return; }
          string et4 = elemOf(bt4);
          i32 a4 = env.scratchNamed("incarr", bt4);
          i32 i4 = env.scratchNamed("incidx", "i32");
          emitLvalue(fb, src, lexed, env, base);
          fb.byte(33); fb.u32leb(a4);
          emitAt(fb, src, lexed, env, index, "i32");
          fb.byte(33); fb.u32leb(i4);
          fb.byte(32); fb.u32leb(a4);
          fb.byte(32); fb.u32leb(i4);
          fb.byte(32); fb.u32leb(a4);
          fb.byte(32); fb.u32leb(i4);
          emitArrayGet(fb, env, bt4);
          if (valType(et4) == 126) { fb.byte(66); fb.i64leb(1); } else { fb.byte(65); fb.i32leb(1); }
          emitBinary(fb, env, lexed.tokens[op * tokenStride()] == kInc() ? kPlus() : kMinus(), et4);
          fb.byte(251);
          fb.u32leb(14);
          fb.u32leb(env.arrayType(bt4));
        }
        else: { }
      }
    }
    case Match(subject, arms): { emitMatchStmt(fb, src, lexed, env, subject, arms); }
    case Block(inner): { emitBody(fb, src, lexed, env, inner); }
    case ExprStmt(e) : {
      // A call for its effect — and if it *does* return something, the value has to go somewhere.
      // wasm's stack is not a suggestion: a function that leaves one is ill-typed at its end, which
      // is what *"expected 0 elements on the stack"* was saying about six corpus files.
      emitExpr(fb, src, lexed, env, e);
      // `""` is *unknown* and `"void"` is *nothing* — two different answers that both mean "no value
      // to drop", and treating the second as a value dropped one that was never pushed.
      string st = typeOfE(src, lexed, env, e);
      if (st != "" && st != "void") { fb.byte(26); }   // drop
    }
  }
}

/**
 * The shape `while` and `for` share: a block wrapping a loop, the condition at the top.
 *
 * `for`'s update runs before the branch back, which is what makes `continue` land on it rather than
 * skip it — the one place the two forms differ, and the reason they are one function.
 */
void emitLoop(B fb, u8[] src, Lexed lexed, Env env, Expr? cond, Stmt[] inner, Stmt? update) {
  i32 savedB = env.breakAt;
  i32 savedC = env.continueAt;
  fb.byte(2);
  fb.byte(64);   // block — what `break` leaves
  env.depth = env.depth + 1;
  env.breakAt = env.depth;
  fb.byte(3);
  fb.byte(64);   // loop — what `continue` returns to
  env.depth = env.depth + 1;
  env.continueAt = env.depth;
  if (!(cond is null)) {
    emitExpr(fb, src, lexed, env, cond!);
    fb.byte(69);   // i32.eqz — leave when the condition fails
    fb.byte(13);
    fb.u32leb(1);
  }
  // **A third block, around the body.** `continue` has to reach the update rather than skip it, so it
  // cannot branch to the loop's own label — it leaves an inner block whose end is where the update
  // begins. Branching to the loop instead is a `for` that never advances: the module validates, the
  // answer never comes, and the test *hangs* rather than failing. Which is what it did.
  fb.byte(2);
  fb.byte(64);
  env.depth = env.depth + 1;
  env.continueAt = env.depth;
  covPoint(fb, env, "loop", cond is null ? 0 : cond!.line, cond is null ? 0 : cond!.col);
  emitBody(fb, src, lexed, env, inner);
  fb.byte(11);
  env.depth = env.depth - 1;
  if (!(update is null)) { emitStmt(fb, src, lexed, env, update!); }
  fb.byte(12);
  fb.u32leb(0);
  fb.byte(11);
  fb.byte(11);
  env.depth = env.depth - 2;
  env.breakAt = savedB;
  env.continueAt = savedC;
}

/** The operator of a compound assignment, which is the binary one with the `=` taken off. */
void emitCompound(B fb, Env env, i32 k, string t) {
  // `s += x` is a concatenation, which is a call rather than an instruction — the same helper the
  // expression form uses, so the two spellings cannot drift apart.
  if (t == "string" && k == kPlusEq()) {
    i32 cc = env.funcAt(" str_concat");
    if (cc < 0 || env.funcIndex[cc] < 0) { return; }
    fb.byte(16);
    fb.u32leb(env.funcIndex[cc]);
    return;
  }
  // **All eleven**, by name. Four of them were written as raw numbers 58 to 61, which covered the
  // arithmetic and silently ignored the bitwise ones — `result ^= x` emitted its two operands and no
  // operator, leaving a value on the stack that wasm noticed at the end of the function.
  if (k == kPlusEq()) { emitBinary(fb, env, kPlus(), t); }
  if (k == kMinusEq()) { emitBinary(fb, env, kMinus(), t); }
  if (k == kStarEq()) { emitBinary(fb, env, kStar(), t); }
  if (k == kSlashEq()) { emitBinary(fb, env, kSlash(), t); }
  if (k == kPercentEq()) { emitBinary(fb, env, kPercent(), t); }
  if (k == kAndEq()) { emitBinary(fb, env, kAnd(), t); }
  if (k == kOrEq()) { emitBinary(fb, env, kOr(), t); }
  if (k == kCaretEq()) { emitBinary(fb, env, kCaret(), t); }
  if (k == kShlEq()) { emitBinary(fb, env, kShl(), t); }
  if (k == kShrEq()) { emitBinary(fb, env, kShr(), t); }
  if (k == kShrUEq()) { emitBinary(fb, env, kShrU(), t); }
}

/**
 * An expression, in the order wasm wants it: operands, then the operator.
 *
 * `&&` and `||` are the exception, and the reason is that they **short-circuit**: they cannot be two
 * operands and an opcode, because the right one may not be evaluated at all. Each becomes an `if`
 * with a value type — the one place this emitter writes a block that produces something.
 */
/**
 * `x++` and `++x` **as expressions**, which is what `spec/spec/operators.md` says they are.
 *
 * The difference between the two is only *when* the value is taken, so both forms are the same
 * instructions in a different order rather than two implementations. The base of a field or an
 * element is put in a scratch and read twice from there: `f().x++` must call `f` once, and an
 * emitter that reaches for `emitLvalue` a second time calls it twice.
 */
void emitIncrExpr(B fb, u8[] src, Lexed lexed, Env env, Lvalue rawTarget, i32 op, bool prefix) {
  Lvalue target = peelLv(rawTarget);
  i32 kind = lexed.tokens[op * tokenStride()] == kInc() ? kPlus() : kMinus();
  match (target.kind) {
    // Peeled above, so this cannot arrive — but the language wants every variant named.
    case LUnwrap(base): { emitIncrExpr(fb, src, lexed, env, base, op, prefix); }
    case LIdent(tok): {
      i32 at = env.localAt(tokenTextOf(src, lexed, tok));
      if (at < 0) { return; }
      string t = env.localTypes[at];
      fb.byte(32); fb.u32leb(at);
      if (prefix) {
        if (valType(t) == 126) { fb.byte(66); fb.i64leb(1); } else { fb.byte(65); fb.i32leb(1); }
        emitBinary(fb, env, kind, t);
        fb.byte(34); fb.u32leb(at);        // local.tee — the new value is the answer
        return;
      }
      fb.byte(32); fb.u32leb(at);          // the old value stays underneath
      if (valType(t) == 126) { fb.byte(66); fb.i64leb(1); } else { fb.byte(65); fb.i32leb(1); }
      emitBinary(fb, env, kind, t);
      fb.byte(33); fb.u32leb(at);
    }
    case LField(base, nameTok): {
      string ot = typeOfLv(src, lexed, env, base);
      if (!env.isStructName(ot)) { return; }
      string fname = tokenTextOf(src, lexed, nameTok);
      bool en = env.enumOf(ot) != "" || env.isEnumName(ot);
      i32 slot = en ? enumSlot(env, ot, fname) : env.fieldIndex(ot, fname);
      string ft = en ? env.fieldTypeAt(env.canonType(ot), slot) : env.fieldType(ot, fname);
      i32 b = env.scratchNamed("iebase", ot);
      i32 v = env.scratchNamed("ieval", ft);
      emitLvalue(fb, src, lexed, env, base);
      fb.byte(33); fb.u32leb(b);
      if (!prefix) {
        fb.byte(32); fb.u32leb(b);
        fb.byte(251); fb.u32leb(2); fb.u32leb(env.structType(ot)); fb.u32leb(slot);
      }
      fb.byte(32); fb.u32leb(b);
      fb.byte(32); fb.u32leb(b);
      fb.byte(251); fb.u32leb(2); fb.u32leb(env.structType(ot)); fb.u32leb(slot);
      if (valType(ft) == 126) { fb.byte(66); fb.i64leb(1); } else { fb.byte(65); fb.i32leb(1); }
      emitBinary(fb, env, kind, ft);
      if (prefix) { fb.byte(34); fb.u32leb(v); }
      fb.byte(251); fb.u32leb(5); fb.u32leb(env.structType(ot)); fb.u32leb(slot);
      if (prefix) { fb.byte(32); fb.u32leb(v); }
    }
    case LIndex(base, index): {
      string bt = typeOfLv(src, lexed, env, base);
      if (!isArrayType(bt)) { return; }
      string et = elemOf(bt);
      i32 a = env.scratchNamed("iearr", bt);
      i32 i = env.scratchNamed("ieidx", "i32");
      i32 v2 = env.scratchNamed("ieval", et);
      emitLvalue(fb, src, lexed, env, base);
      fb.byte(33); fb.u32leb(a);
      emitAt(fb, src, lexed, env, index, "i32");
      fb.byte(33); fb.u32leb(i);
      if (!prefix) {
        fb.byte(32); fb.u32leb(a);
        fb.byte(32); fb.u32leb(i);
        emitArrayGet(fb, env, bt);
      }
      fb.byte(32); fb.u32leb(a);
      fb.byte(32); fb.u32leb(i);
      fb.byte(32); fb.u32leb(a);
      fb.byte(32); fb.u32leb(i);
      emitArrayGet(fb, env, bt);
      if (valType(et) == 126) { fb.byte(66); fb.i64leb(1); } else { fb.byte(65); fb.i32leb(1); }
      emitBinary(fb, env, kind, et);
      if (prefix) { fb.byte(34); fb.u32leb(v2); }
      fb.byte(251); fb.u32leb(14); fb.u32leb(env.arrayType(bt));
      if (prefix) { fb.byte(32); fb.u32leb(v2); }
    }
  }
}

void emitExpr(B fb, u8[] src, Lexed lexed, Env env, Expr e) {
  emitExprAt(fb, src, lexed, env, e, "");
}

/**
 * An expression, told what type the slot it fills is.
 *
 * Only a literal needs it — everything else knows its own type — but a literal can be anywhere, so
 * the wanted type is passed down every arm rather than special-cased at the few places one is likely.
 */
void emitExprAt(B fb, u8[] src, Lexed lexed, Env env, Expr e, string want) {
  match (e.kind) {
    case IntLit(tok): {
      // A literal is emitted at the type its **context** wants, which is the same fact the checker
      // states as "a literal is polymorphic over a family": `i64 x = 1;` needs `i64.const`, and the
      // `1` says nothing about that.
      i64 v = parseInt(tokenTextOf(src, lexed, tok));
      if (valType(want) == 126) { fb.byte(66); fb.i64leb(v); return; }
      if (want == "f32") { fb.byte(67); fb.f32bits(v as~ f32); return; }
      if (want == "f64") { fb.byte(68); fb.f64bits(v as~ f64); return; }
      fb.byte(65);
      fb.i32leb(v as@ i32);
    }
    case FloatLit(tok): {
      f64 v = floatLit(tokenTextOf(src, lexed, tok));
      if (want == "f32") { fb.byte(67); fb.f32bits(v as~ f32); return; }
      fb.byte(68);
      fb.f64bits(v);
    }
    case BoolLit(value): {
      fb.byte(65);
      fb.i32leb(value ? 1 : 0);
    }
    case Jsx(tagTok, closeTok, attrs, kids): {
      emitJsx(fb, src, lexed, env, tagTok, attrs, kids);
      return;
    }
    case JsxText(startOff, endOff): {
      emitJsxText(fb, src, env, startOff, endOff);
      return;
    }
    case StrLit(tok): {
      // The bytes, then `array.new_fixed`. A literal's token spans the quotes, so the span is walked
      // rather than taken whole, and the four escapes wac's own sources use are resolved on the way.
      u8[] bytes = stringLiteralBytes(src, lexed, tok);
      for (i32 i = 0; i < bytes.len(); i++) {
        fb.byte(65);
        fb.i32leb(bytes[i]);
      }
      fb.byte(251);
      fb.u32leb(8);   // array.new_fixed
      fb.u32leb(env.arrayType("i8[]"));
      fb.u32leb(bytes.len());
    }
    case Cast(op, operand, target): {
      string from = typeOfE(src, lexed, env, operand);
      string to = typeOfTyName(env, src, lexed, target);
      // **A literal has no type of its own, so it takes the slot's** — and the slot here is the
      // cast's own target, which made `42 as! i31ref` a conversion from `i31ref` to `i31ref`: no
      // instructions at all, and an `i32` left where a reference belonged. A cast *into* a reference
      // is the one place the operand's want cannot be the target.
      string want2 = from == "" ? to : from;
      if (to == "i31ref" && from == "") { want2 = "i32"; }
      // **A float literal being converted is still a float.** With no type of its own it took the
      // cast's target, so `1.5 as~ i32` emitted the literal *as an `i32`* and then converted `i32`
      // to `i32` — nothing at all — leaving an `f64` where the function had promised an `i32`. Every
      // spelling of it was a module that would not load: `1.5 as~ i32`, `1.5 as@ i32`,
      // `-2.3 as@ i32`, `1.0e300 as@ i32`. `f64` here and the conversion does the work, except into
      // a float target, where the target's own width is the right slot. `issues/lang/0117`.
      if (from == "" && isFloatLiteral(operand) && to != "f32" && to != "f64") { want2 = "f64"; }
      emitExprAt(fb, src, lexed, env, operand, want2);
      emitCast(fb, env, want2, to, tokenKindOf(lexed, op));
    }
    case Ident(tok): {
      string nm = tokenTextOf(src, lexed, tok);
      i32 at = env.localAt(nm);
      if (at < 0) { nm = nameKeyOf(env, src, lexed, tok); }
      if (at >= 0) {
        fb.byte(32);
        fb.u32leb(at);
        return;
      }
      // A function's **name**, used as a value, is a reference to it. Nothing else in the language
      // spells this — there is no `&f` — so a bare name that is neither a local nor a constant and
      // *is* a function is the whole of the syntax.
      if (env.constAt(nm) < 0) {
        i32 fr = env.funcAt(nm);
        if (fr >= 0 && env.funcIndex[fr] >= 0) {
          emitFuncPair(fb, env, fr, want);
          return;
        }
      }
      // A module-level constant, substituted. A local wins a name clash because it is nearer, which
      // is why this is asked second.
      i32 ci = env.constAt(nm);
      if (ci < 0) { return; }
      // A constant with identity lives in a global and is *read*; a scalar has none and is
      // substituted. One array shared by every use is the whole difference between the two.
      if (env.constGlobal[ci] >= 0) {
        fb.byte(35);   // global.get
        fb.u32leb(env.constGlobal[ci]);
        return;
      }
      if (env.constInits[ci] is null) { return; }
      emitExprAt(fb, src, lexed, env, env.constInits[ci]!, env.constTypes[ci]);
    }
    case Unary(op, operand): {
      i32 k = lexed.tokens[op * tokenStride()];
      if (k == kBang()) {
        emitExpr(fb, src, lexed, env, operand);
        fb.byte(69);   // i32.eqz
        return;
      }
      string ut = typeOfE(src, lexed, env, operand);
      if (ut == "") { ut = want; }
      if (k == kMinus()) {
        // A float *has* a negation instruction; an integer does not, and is a subtraction from zero.
        if (isFloat(ut)) {
          emitExprAt(fb, src, lexed, env, operand, ut);
          fb.byte(ut == "f32" ? 140 : 154);
          return;
        }
        if (valType(ut) == 126) { fb.byte(66); fb.i32leb(0); }
        else { fb.byte(65); fb.i32leb(0); }
        emitExprAt(fb, src, lexed, env, operand, ut);
        fb.byte(valType(ut) == 126 ? 125 : 107);
        return;
      }
      if (k == kTilde()) {
        emitExprAt(fb, src, lexed, env, operand, ut);
        if (valType(ut) == 126) { fb.byte(66); fb.i32leb(-1); fb.byte(133); }
        else { fb.byte(65); fb.i32leb(-1); fb.byte(115); }
        return;
      }
    }
    case Binary(op, left, right): {
      i32 k = lexed.tokens[op * tokenStride()];
      if (k == kAndAnd() || k == kOrOr()) {
        emitExpr(fb, src, lexed, env, left);
        fb.byte(4);
        fb.byte(wasmI32());   // if, producing an i32
        if (k == kAndAnd()) {
          // **The right-hand side of a short circuit is a branch**, and it had no point — so a
          // coverage report called `a && b` covered when only `a` had ever been true, and a
          // constant-time trace could not see a secret deciding whether `b` runs at all. The
          // reference records `and-rhs`/`or-rhs`; this is the same point under the same name.
          covPoint(fb, env, "and-rhs", right.line, right.col);
          emitExpr(fb, src, lexed, env, right);
          fb.byte(5);
          fb.byte(65);
          fb.i32leb(0);
        } else {
          fb.byte(65);
          fb.i32leb(1);
          fb.byte(5);
          covPoint(fb, env, "or-rhs", right.line, right.col);
          emitExpr(fb, src, lexed, env, right);
        }
        fb.byte(11);
        return;
      }
      string ot0 = operandType(src, lexed, env, left, right);
      if (ot0 == "string" && k == kPlus()) {
        i32 cc = env.funcAt(" str_concat");
        if (cc < 0 || env.funcIndex[cc] < 0) { return; }
        emitExpr(fb, src, lexed, env, left);
        emitExpr(fb, src, lexed, env, right);
        fb.byte(16);
        fb.u32leb(env.funcIndex[cc]);
        return;
      }
      // `<`, `<=`, `>`, `>=` on strings are the helper's answer against zero — which is how the
      // comparison stays one definition rather than four.
      if (ot0 == "string" &&
          (k == kLt() || k == kLe() || k == kGt() || k == kGe())) {
        i32 cc2 = env.funcAt(" str_cmp");
        if (cc2 < 0 || env.funcIndex[cc2] < 0) { return; }
        emitExpr(fb, src, lexed, env, left);
        emitExpr(fb, src, lexed, env, right);
        fb.byte(16);
        fb.u32leb(env.funcIndex[cc2]);
        fb.byte(65);
        fb.i32leb(0);
        if (k == kLt()) { fb.byte(72); }
        if (k == kLe()) { fb.byte(76); }
        if (k == kGt()) { fb.byte(74); }
        if (k == kGe()) { fb.byte(78); }
        return;
      }
      if (ot0 == "string" && (k == kEq() || k == kNe())) {
        i32 eq = env.funcAt(" str_eq");
        if (eq < 0 || env.funcIndex[eq] < 0) { return; }
        emitExpr(fb, src, lexed, env, left);
        emitExpr(fb, src, lexed, env, right);
        fb.byte(16);
        fb.u32leb(env.funcIndex[eq]);
        // `!=` is the same comparison, negated — which is one instruction rather than a second helper.
        if (k == kNe()) { fb.byte(69); }
        return;
      }
      string ot = operandType(src, lexed, env, left, right);
      // When **both** operands are literals there is no type to take from them, and the slot is the
      // only thing that knows: `0.0 / 0.0` in an `f64` return is an `f64` division. Without this the
      // operands went out as `f64` and the operator as `i32.div_s` — the two halves of one expression
      // disagreeing, because they asked different things.
      //
      // **The slot picks the width, not the family.** `(0.0 / 0.0) as@ i32` puts a division of two
      // float literals in an `i32` slot, and taking the slot's type wholesale emitted `i32.div_s`
      // over two `f64` constants — a module that will not load. A float literal cannot be computed
      // with integer arithmetic whatever it is being converted to afterwards; what the slot may
      // still decide is `f32` against `f64`, which is what keeps `f32 x = 1.0 * 2.0` an `f32`
      // multiply. `issues/lang/0117`, `§wac-raw-truncf-nan-w9fk2xq`.
      if (ot == "") {
        bool floaty = isFloatLiteral(left) || isFloatLiteral(right);
        ot = !floaty || want == "f32" || want == "f64" ? want : "f64";
      }
      // **Except for a comparison, whose slot is a `bool` and knows nothing about its operands.**
      // `1.0 == 1.0` took `bool` from the line above, `emitBinary` read that as an integer shape, and
      // the module compared two `f64` constants with `i32.eq` and would not load. Here — and only
      // here — the literals' own family is the last word, because nothing else in the expression has
      // an opinion. Arithmetic keeps taking the slot's type, which is what makes `f32 x = 1.0 * 2.0`
      // an `f32` multiply: an earlier attempt at this rule in `operandType` applied it to both and
      // broke twelve corpus files. `issues/lang/0117`.
      if (isComparisonOp(k) && (ot == "" || ot == "bool")) {
        ot = isFloatLiteral(left) || isFloatLiteral(right) ? "f64" : "i32";
      }
      emitExprAt(fb, src, lexed, env, left, ot);
      // **A shift's amount is not the shift's type.** wac lets `wide >> narrow`, and wasm's
      // `i64.shr_s` wants both sides `i64` — so a right operand that is genuinely a different width
      // is converted rather than assumed. `emitExprAt` only steers *literals*; a typed local ignores
      // it and arrives as itself.
      emitAt(fb, src, lexed, env, right, ot);
      emitBinary(fb, env, k, ot);
    }
    case Construct(ctype, args, named): {
      match (ctype.kind) {
        case Named(tok, typeArgs): {
          // A **local** of function-reference type, called: `g(5)` is spelled exactly like a call to
          // a function named `g`, and only the scope can tell them apart. The local wins, as it does
          // everywhere else in this emitter.
          string lraw = tokenTextOf(src, lexed, tok);
          string lty = env.localType(lraw);
          if (isFuncrefType(lty)) {
            // **The env first, then the arguments, then the funcref** — `design/lang/0002`. A `fn[…]`
            // value is a pair, so a call reads both of its fields; the pair is already in a local
            // here, which is why this needs no scratch and the field case below does.
            i32 pl = env.localAt(lraw);
            fb.byte(32); fb.u32leb(pl);
            fb.byte(251); fb.u32leb(2); fb.u32leb(env.pairType(lty)); fb.u32leb(1);   // struct.get env
            for (i32 i = 0; i < args.len(); i++) {
              emitExprAt(fb, src, lexed, env, args[i], sigParamAt(lty, i));
            }
            fb.byte(32); fb.u32leb(pl);
            fb.byte(251); fb.u32leb(2); fb.u32leb(env.pairType(lty)); fb.u32leb(0);   // struct.get fn
            fb.byte(20);   // call_ref
            fb.u32leb(env.sigType(envSig(lty)));
            return;
          }
          // Through `typeOfTyName`, so a construction inside a template builds the instance being
          // compiled, and one written with arguments builds the instance it names.
          string cname = typeOfTyName(env, src, lexed, ctype);
          // The instance the slot names, when the construction did not name one — the other half of
          // `issues/lang/0092`. Approving this without emitting it would leave a module that
          // validates and calls a function that is not there.
          if (!env.isStructName(cname) && isInstance(want) && templateOf(want) == cname
              && env.isStructName(want)) {
            cname = want;
          }
          // `P(3, 4)` and `g(3, 4)` are the same syntax, and which one this is depends on whether the
          // name is a struct — the same fork the checker makes, one compiler apart.
          if (env.isStructName(cname)) {
            // **`P { y: 2, x: 1 }` is the same value as `P(1, 2)`**, so it is the same instruction
            // with the arguments put back in order: wasm's `struct.new` takes fields in declaration
            // order and knows nothing about names. Every field is named exactly once — the walk
            // below refuses anything else, which is what lets this loop trust it finds each one.
            if (named.len() > 0) {
              i32 nf = env.fieldCountOf(cname);
              for (i32 i = 0; i < nf; i++) {
                bool wrote = false;
                for (i32 j = 0; j < named.len(); j++) {
                  if (env.fieldIndex(cname, tokenTextOf(src, lexed, named[j].nameTok)) != i) {
                    continue;
                  }
                  emitExprAt(fb, src, lexed, env, named[j].value, env.fieldTypeAt(cname, i));
                  wrote = true;
                }
                // **An omitted field is null**, which the checker has already established can only
                // be a nullable one — `struct.new` takes every field in order, so a gap here is not
                // a smaller struct, it is the *next* field's value landing in this one's slot.
                if (!wrote) { emitNull(fb, env, env.fieldTypeAt(cname, i)); }
              }
              fb.byte(251);
              fb.u32leb(0);
              fb.u32leb(env.structType(cname));
              return;
            }
            // `Line()` with no arguments is every field's default — and wasm's `struct.new_default`
            // is *not* that: it fills a reference field with null, where the language says a
            // `string` field defaults to `""` and a struct field to a defaulted struct. So the
            // defaults are emitted one by one and the ordinary `struct.new` takes them.
            if (args.len() == 0 && env.fieldCountOf(cname) > 0) {
              emitDefault(fb, env, cname);
              return;
            }
            for (i32 i = 0; i < args.len(); i++) {
              emitExprAt(fb, src, lexed, env, args[i], env.fieldTypeAt(cname, i));
            }
            fb.byte(251);
            fb.u32leb(0);   // struct.new — fields in declaration order
            fb.u32leb(env.structType(cname));
            return;
          }
          i32 at = env.funcAt(cname);
          if (at < 0) { at = env.funcAt(genericCallInstance(env, src, lexed, tok, args)); }
          if (at < 0 || env.funcIndex[at] < 0) { return; }
          for (i32 i = 0; i < args.len(); i++) {
            emitExprAt(fb, src, lexed, env, args[i], env.paramTypeAt(at, i));
          }
          fb.byte(16);   // call
          fb.u32leb(env.funcIndex[at]);
        }
        else: { }
      }
    }
    /**
     * An array, in whichever of the three shapes it was written.
     *
     * `T[n]()` fills with the element's zero, `T[n](fill: v)` with a value, and `T[](a, b, c)` lists
     * its elements. wasm has a distinct instruction for each — `new_default`, `new`, `new_fixed` —
     * which is unusually generous of the format and means none of them has to be built out of the
     * others.
     */
    case ArrNew(elem, size, fill, elements): {
      string et = typeOfTyName(env, src, lexed, elem);
      i32 ti = env.arrayType(et + "[]");
      if (elements.len() > 0) {
        for (i32 i = 0; i < elements.len(); i++) {
          emitExprAt(fb, src, lexed, env, elements[i], et);
        }
        fb.byte(251);
        fb.u32leb(8);      // array.new_fixed
        fb.u32leb(ti);
        fb.u32leb(elements.len());
        return;
      }
      if (!(fill is null)) {
        emitExprAt(fb, src, lexed, env, fill!, et);
        if (!(size is null)) { emitAt(fb, src, lexed, env, size!, "i32"); }
        fb.byte(251);
        fb.u32leb(6);      // array.new — the value, then the count
        fb.u32leb(ti);
        return;
      }
      // `T[]()` names no size and means none: the length is zero, and `array.new_default` still
      // wants to be told so.
      //
      // **A reference element is defaulted, not nulled.** `string[3]()` is three empty strings, so
      // the element's default is built and `array.new` repeats it — `array.new_default` would put
      // a null in every slot, which typechecks and traps on the first `.len()`.
      if (isRefType(env, et) && !isNullableTy(elem)) {
        // **A struct element is a fresh struct per slot.** `array.new` repeats *one* reference, and
        // the spec says `P[2]()` gives two: writing `a[0].v` must not be visible in `a[1]`. An
        // empty string or an empty array has nothing to write, so sharing one is unobservable and
        // the cheap path is right for them; a struct is the case that needs the loop.
        bool distinct = env.isStructName(et) && !env.isEnumName(env.canonType(et));
        if (!distinct) {
          emitDefault(fb, env, et);
          if (size is null) { fb.byte(65); fb.i32leb(0); }
          else { emitAt(fb, src, lexed, env, size!, "i32"); }
          fb.byte(251);
          fb.u32leb(6);      // array.new
          fb.u32leb(ti);
          return;
        }
        i32 nLoc = env.scratchNamed("newn", "i32");
        i32 iLoc = env.scratchNamed("newi", "i32");
        i32 aLoc = env.scratchNamed("newa", et + "[]");
        if (size is null) { fb.byte(65); fb.i32leb(0); }
        else { emitAt(fb, src, lexed, env, size!, "i32"); }
        fb.byte(33); fb.u32leb(nLoc);          // local.set — a tee would leave the count under it
        emitDefault(fb, env, et);
        fb.byte(32); fb.u32leb(nLoc);
        fb.byte(251); fb.u32leb(6); fb.u32leb(ti);
        fb.byte(33); fb.u32leb(aLoc);
        // Slot zero keeps the one that was made above; every other slot gets its own.
        fb.byte(65); fb.i32leb(1);
        fb.byte(33); fb.u32leb(iLoc);
        fb.byte(2); fb.byte(64);
        fb.byte(3); fb.byte(64);
        fb.byte(32); fb.u32leb(iLoc);
        fb.byte(32); fb.u32leb(nLoc);
        fb.byte(78);                            // i32.ge_s
        fb.byte(13); fb.u32leb(1);              // br_if out
        fb.byte(32); fb.u32leb(aLoc);
        fb.byte(32); fb.u32leb(iLoc);
        emitDefault(fb, env, et);
        fb.byte(251); fb.u32leb(14); fb.u32leb(ti);   // array.set
        fb.byte(32); fb.u32leb(iLoc);
        fb.byte(65); fb.i32leb(1);
        fb.byte(106);
        fb.byte(33); fb.u32leb(iLoc);
        fb.byte(12); fb.u32leb(0);
        fb.byte(11);
        fb.byte(11);
        fb.byte(32); fb.u32leb(aLoc);
        return;
      }
      if (size is null) { fb.byte(65); fb.i32leb(0); }
      else { emitAt(fb, src, lexed, env, size!, "i32"); }
      fb.byte(251);
      fb.u32leb(7);        // array.new_default
      fb.u32leb(ti);
    }
    case Index(arr, index): {
      string at2 = typeOfE(src, lexed, env, arr);
      // A string index is a decode and so a call, not an `array.get`.
      if (at2 == "string") {
        i32 si = env.funcAt(" str_idx");
        if (si < 0 || env.funcIndex[si] < 0) { return; }
        emitExpr(fb, src, lexed, env, arr);
        emitExprAt(fb, src, lexed, env, index, "i32");
        fb.byte(16);
        fb.u32leb(env.funcIndex[si]);
        return;
      }
      emitExpr(fb, src, lexed, env, arr);
      emitAt(fb, src, lexed, env, index, "i32");
      // **The index, recorded, in trace mode only.** Here and nowhere else, which is where the
      // reference instruments too: a read is what leaks through a cache line — `SBOX[key]` — and a
      // write to a secret-dependent index leaks the same way, but instrumenting both would double
      // every trace and make two compilers' traces incomparable for no extra property.
      traceIndex(fb, env, index.line, index.col);
      emitArrayGet(fb, env, at2);
    }
    case Call(callee, args): {
      match (callee.kind) {
        case Member(obj, nameTok): {
          string mname = tokenTextOf(src, lexed, nameTok);
          // `Shape.Circle(2.0)` reaches here as a **call**, because that is what it looks like from
          // the parser's side. It builds a value instead — and for a template's variant, which
          // instance it builds comes from the slot.
          string vnew = variantOfMemberAt(src, lexed, env, obj, nameTok, want);
          if (vnew != "") {
            Expr?[] vargs = Expr?[args.len()]();
            for (i32 i = 0; i < args.len(); i++) { vargs[i] = args[i]; }
            emitVariantNew(fb, src, lexed, env, vnew, vargs);
            return;
          }
          // A static takes no receiver: the owner came from the *name*, so there is nothing to push.
          if (isStringTypeName(src, lexed, env, obj) && mname == "fromCodepoint" && args.len() == 1) {
            i32 cp = env.funcAt(" str_fromcp");
            if (cp < 0 || env.funcIndex[cp] < 0) { return; }
            emitExprAt(fb, src, lexed, env, args[0], "i32");
            fb.byte(16);
            fb.u32leb(env.funcIndex[cp]);
            return;
          }
          if (isStringTypeName(src, lexed, env, obj) && mname == "fromBytes" && args.len() == 1) {
            i32 fb2 = env.funcAt(" str_from_bytes");
            if (fb2 < 0 || env.funcIndex[fb2] < 0) { return; }
            emitExpr(fb, src, lexed, env, args[0]);
            fb.byte(16);
            fb.u32leb(env.funcIndex[fb2]);
            return;
          }
          string pown = primTypeName(env, src, lexed, obj);
          if (primStaticType(pown, mname) != "" && args.len() == 1) {
            emitExprAt(fb, src, lexed, env, args[0], primStaticArg(pown, mname));
            if (pown == "f32" && mname == "toBits") { fb.byte(188); }     // i32.reinterpret_f32
            if (pown == "f64" && mname == "toBits") { fb.byte(189); }     // i64.reinterpret_f64
            if (pown == "f32" && mname == "fromBits") { fb.byte(190); }   // f32.reinterpret_i32
            if (pown == "f64" && mname == "fromBits") { fb.byte(191); }   // f64.reinterpret_i64
            return;
          }
          // A **field** that holds a reference, called: `h.cb()` is a member and a call, and the
          // member is not a method. The field is read and then `call_ref`ed, which is the same
          // sequence a local takes with a `struct.get` in front of it.
          string fot = typeOfE(src, lexed, env, obj);
          if (env.isStructName(fot)) {
            string fty2 = env.fieldType(fot, mname);
            if (isFuncrefType(fty2)) {
              // The pair, once, into a scratch: the object is an *expression*, so reading the field
              // twice would evaluate it twice and any side effect with it.
              i32 sc = env.scratch(fty2);
              emitExpr(fb, src, lexed, env, obj);
              fb.byte(251);
              fb.u32leb(2);
              fb.u32leb(env.structType(fot));
              fb.u32leb(env.fieldIndex(fot, mname));
              fb.byte(33); fb.u32leb(sc);                                              // local.set
              fb.byte(32); fb.u32leb(sc);
              fb.byte(251); fb.u32leb(2); fb.u32leb(env.pairType(fty2)); fb.u32leb(1); // env
              for (i32 i = 0; i < args.len(); i++) {
                emitExprAt(fb, src, lexed, env, args[i], sigParamAt(fty2, i));
              }
              fb.byte(32); fb.u32leb(sc);
              fb.byte(251); fb.u32leb(2); fb.u32leb(env.pairType(fty2)); fb.u32leb(0); // funcref
              fb.byte(20);   // call_ref
              fb.u32leb(env.sigType(envSig(fty2)));
              return;
            }
          }
          string towner = templateStatic(env, src, lexed, obj, want);
          if (towner != "") {
            i32 ta = env.funcAt(towner + "." + mname);
            if (ta < 0 || env.funcIndex[ta] < 0) { return; }
            for (i32 i = 0; i < args.len(); i++) {
              emitExprAt(fb, src, lexed, env, args[i], env.paramTypeAt(ta, i));
            }
            fb.byte(16);
            fb.u32leb(env.funcIndex[ta]);
            return;
          }
          string sowner = staticOwner(src, lexed, env, obj);
          if (sowner != "") {
            i32 sa = env.funcAt(sowner + "." + mname);
            if (sa < 0 || env.funcIndex[sa] < 0) { return; }
            for (i32 i = 0; i < args.len(); i++) {
              emitExprAt(fb, src, lexed, env, args[i], env.paramTypeAt(sa, i));
            }
            fb.byte(16);
            fb.u32leb(env.funcIndex[sa]);
            return;
          }
          string ot = typeOfE(src, lexed, env, obj);
          // `a.len()` is an instruction rather than a call, which is the one method wasm has itself.
          // `s.toBytes()` and `string.fromBytes(b)` are copies between two array types of the same
          // shape, which is a helper rather than an instruction — the reference's own bytes say so.
          if (ot == "string" && mname == "slice" && args.len() == 2) {
            i32 sl = env.funcAt(" str_slice");
            if (sl < 0 || env.funcIndex[sl] < 0) { return; }
            emitExpr(fb, src, lexed, env, obj);
            emitExprAt(fb, src, lexed, env, args[0], "i32");
            emitExprAt(fb, src, lexed, env, args[1], "i32");
            fb.byte(16);
            fb.u32leb(env.funcIndex[sl]);
            return;
          }
          if (ot == "string" && mname == "indexOf" && args.len() == 1) {
            i32 io = env.funcAt(" str_index_of");
            if (io < 0 || env.funcIndex[io] < 0) { return; }
            emitExpr(fb, src, lexed, env, obj);
            emitExprAt(fb, src, lexed, env, args[0], "string");
            fb.byte(16);
            fb.u32leb(env.funcIndex[io]);
            return;
          }
          if (ot == "string" && mname == "toBytes") {
            i32 tb = env.funcAt(" str_to_bytes");
            if (tb < 0 || env.funcIndex[tb] < 0) { return; }
            emitExpr(fb, src, lexed, env, obj);
            fb.byte(16);
            fb.u32leb(env.funcIndex[tb]);
            return;
          }
          // `dst.copyFrom(src, srcStart, dstStart, count)` is `array.copy`, whose operands go in a
          // different order than the language writes them: wasm wants destination, destination
          // offset, source, source offset, length. The arguments are therefore emitted 2, 0, 1, 3.
          // `array.fill` takes the array, the offset, the value and the count — the order the
          // language writes them in with the first two swapped.
          if (isArrayType(ot) && mname == "fill" && args.len() == 3) {
            emitExpr(fb, src, lexed, env, obj);
            emitExprAt(fb, src, lexed, env, args[1], "i32");
            emitExprAt(fb, src, lexed, env, args[0], elemOf(ot));
            emitExprAt(fb, src, lexed, env, args[2], "i32");
            fb.byte(251);
            fb.u32leb(16);   // array.fill
            fb.u32leb(env.arrayType(ot));
            return;
          }
          if (isArrayType(ot) && mname == "copyFrom" && args.len() == 4) {
            string srcT = typeOfE(src, lexed, env, args[0]);
            if (!isArrayType(srcT)) { return; }
            emitExpr(fb, src, lexed, env, obj);
            emitAt(fb, src, lexed, env, args[2], "i32");
            emitExpr(fb, src, lexed, env, args[0]);
            emitAt(fb, src, lexed, env, args[1], "i32");
            emitAt(fb, src, lexed, env, args[3], "i32");
            fb.byte(251);
            fb.u32leb(17);   // array.copy
            fb.u32leb(env.arrayType(ot));
            fb.u32leb(env.arrayType(srcT));
            return;
          }
          // **The five integer bit methods**, each one instruction with no other spelling in the
          // language: `clz`, `ctz`, `popcnt`, `rotl`, `rotr`. The opcode comes from the receiver's
          // width alone, since signedness cannot change any of them. `issues/lang/0069`.
          if (isIntType(ot) && intBuiltinOp(ot, mname) >= 0) {
            emitExpr(fb, src, lexed, env, obj);
            for (i32 i = 0; i < args.len(); i++) {
              emitExprAt(fb, src, lexed, env, args[i], ot);
            }
            fb.byte(intBuiltinOp(ot, mname));
            return;
          }
          if ((isArrayType(ot) || ot == "string") && mname == "len") {
            emitExpr(fb, src, lexed, env, obj);
            fb.byte(251);
            fb.u32leb(15);   // array.len
            return;
          }
          // A method call pushes the receiver first and is otherwise a call. The receiver *is* the
          // first parameter, which is the whole of what a method is here.
          i32 at = methodOn(env, ot, mname);
          if (at < 0 || env.funcIndex[at] < 0) { return; }
          emitExpr(fb, src, lexed, env, obj);
          for (i32 i = 0; i < args.len(); i++) {
            emitExprAt(fb, src, lexed, env, args[i], env.paramTypeAt(at, i));
          }
          fb.byte(16);
          fb.u32leb(env.funcIndex[at]);
        }
        // A call through a **value** rather than a name: the arguments, then the reference, then
        // `call_ref` with the signature's type index. The reference goes last because that is the
        // order the instruction pops in, and the reverse of how the call reads.
        else: {
          string ct = typeOfE(src, lexed, env, callee);
          if (!isFuncrefType(ct)) { return; }
          // **The general call-through-a-value path**, and a `fn[…]` value is a pair — so the callee
          // is evaluated once into a scratch and both fields are read: the env in front, then the
          // arguments, then the funcref. `callee` is an arbitrary expression here — a field, an
          // unwrap, an element — which is why it cannot simply be emitted twice.
          i32 csc = env.scratch(ct);
          emitExpr(fb, src, lexed, env, callee);
          fb.byte(33); fb.u32leb(csc);                                            // local.set
          fb.byte(32); fb.u32leb(csc);
          fb.byte(251); fb.u32leb(2); fb.u32leb(env.pairType(ct)); fb.u32leb(1);  // env
          for (i32 i = 0; i < args.len(); i++) {
            emitExprAt(fb, src, lexed, env, args[i], sigParamAt(ct, i));
          }
          fb.byte(32); fb.u32leb(csc);
          fb.byte(251); fb.u32leb(2); fb.u32leb(env.pairType(ct)); fb.u32leb(0);  // funcref
          fb.byte(20);   // call_ref
          fb.u32leb(env.sigType(envSig(ct)));
        }
      }
    }
    case Member(obj, nameTok): {
      // A payload-less variant is a **value and not a call** — `Shape.Point`, with no parentheses —
      // so the construction has to be recognised here as well as under `Call`.
      string vnew2 = variantOfMemberAt(src, lexed, env, obj, nameTok, want);
      if (vnew2 != "") {
        emitVariantNew(fb, src, lexed, env, vnew2, Expr?[0]());
        return;
      }
      i32 mref2 = methodRefAt(src, lexed, env, obj, nameTok);
      if (mref2 >= 0 && env.funcIndex[mref2] >= 0) {
        emitFuncPair(fb, env, mref2, want);
        return;
      }
      string ot2 = typeOfE(src, lexed, env, obj);
      if (!env.isStructName(ot2)) { return; }
      emitExpr(fb, src, lexed, env, obj);
      fb.byte(251);
      fb.u32leb(2);   // struct.get
      fb.u32leb(env.structType(ot2));
      // An enum's fields are the variants' payloads, laid out flat and named for the variant that
      // declared them, so the slot comes from the variant table rather than from the field's name.
      if (env.enumOf(ot2) != "" || env.isEnumName(ot2)) {
        fb.u32leb(enumSlot(env, ot2, tokenTextOf(src, lexed, nameTok)));
        return;
      }
      fb.u32leb(env.fieldIndex(ot2, tokenTextOf(src, lexed, nameTok)));
    }
    // `s is Circle` is a **tag comparison**. No cast and no test instruction: a variant and its enum
    // are the same wasm type here, so what distinguishes them is the value in slot 0 and nothing else.
    case Is(left, target, other, negated): {
      // Three tests share one node, and which one it is comes from what is present: a type, a value,
      // or neither, which is `x is null`.
      if ((target is null) && (other is null)) {
        emitExpr(fb, src, lexed, env, left);
        fb.byte(209);   // ref.is_null
        if (negated) { fb.byte(69); }   // i32.eqz
        return;
      }
      if (!(other is null)) {
        string lt2 = typeOfE(src, lexed, env, left);
        emitExprAt(fb, src, lexed, env, left, lt2);
        emitExprAt(fb, src, lexed, env, other!, lt2);
        fb.byte(211);   // ref.eq — identity, which is what `is` means between two values
        if (negated) { fb.byte(69); }
        return;
      }
      if (target is null) { return; }
      string tt3 = typeOfTyName(env, src, lexed, target!);
      i32 vi = env.variantAt(tt3);
      if (vi < 0) {
        // **`x is Proc` on a `Proc?` asks whether it is there.** A reference is nullable in wasm
        // whatever the source says, so the test that remains is exactly the one `is null` makes,
        // negated — and with no struct inheritance in this emitter, a target that is the value's
        // own type is the only shape that can mean anything else.
        if (isRefType(env, tt3) && env.canonType(typeOfE(src, lexed, env, left)) ==
            env.canonType(tt3)) {
          emitExpr(fb, src, lexed, env, left);
          fb.byte(209);   // ref.is_null
          if (!negated) { fb.byte(69); }   // i32.eqz — `is T` is *not* null
          return;
        }
        // **A target further down the chain is what `ref.test` is for.** `s is Circle` on a `Shape`
        // is the format's own question once the types say `sub`, and the non-null form is the right
        // one: a null `Shape` is not a `Circle`, which is the same answer the null test above gives.
        if (env.isStructName(tt3) &&
            env.isSubtypeOf(env.canonType(tt3), env.canonType(typeOfE(src, lexed, env, left)))) {
          emitExpr(fb, src, lexed, env, left);
          fb.byte(251);
          fb.u32leb(20);   // ref.test (ref $T)
          fb.i32leb(env.structType(env.canonType(tt3)));
          if (negated) { fb.byte(69); }
          return;
        }
        // The same instruction with an **abstract** heap type: `items[0] is i31ref` asks what is in
        // the container, and `i31` is a heap type the format names rather than one this module
        // declares — one byte where a struct takes an index.
        if (tt3 == "i31ref" && env.isSubtypeOf("i31ref", typeOfE(src, lexed, env, left))) {
          emitExpr(fb, src, lexed, env, left);
          fb.byte(251);
          fb.u32leb(20);
          fb.byte(108);
          if (negated) { fb.byte(69); }
          return;
        }
        return;
      }
      string en = env.variantOwners[vi];
      // The scratch local, not a fresh one: the value is dead the moment its tag has been read, so
      // every `is` on the same enum in a function can share one slot. `match` cannot — its subject
      // lives for the whole chain, and a nested match on the same enum would overwrite it.
      i32 at = env.scratch(en);
      emitExprAt(fb, src, lexed, env, left, en);
      fb.byte(33);
      fb.u32leb(at);
      emitTagOf(fb, env, at, en);
      fb.byte(65);
      fb.i32leb(env.variantTags[vi]);
      fb.byte(negated ? 71 : 70);   // i32.ne / i32.eq
    }
    case MatchExpr(subject, arms): {
      emitMatchExpr(fb, src, lexed, env, subject, arms, want);
    }
    case NullLit: {
      // The same question `isRefType` answers everywhere else. Asked inline here, it was one kind of
      // reference short the moment a new one existed, and a `null` that emits nothing is an argument
      // that never arrives.
      if (isRefType(env, want)) { emitNull(fb, env, want); }
    }
    // `x!` asserts and **traps** where the assertion fails. Emitting nothing would be the same value
    // with the same type — our references are all nullable — and a different answer: the reference
    // traps on a null and silence would return one.
    case Unwrap(operand): {
      emitExpr(fb, src, lexed, env, operand);
      fb.byte(212);   // ref.as_non_null
    }
    case Incr(target, op, prefix): { emitIncrExpr(fb, src, lexed, env, target, op, prefix); }
    case Ternary(cond, then, els): {
      // **The branches' type, not `i32`.** A block that produces a value declares which, and this
      // declared `i32` for every ternary — so `n == 0 ? x : y` on two `u64`s was a block promising an
      // `i32` and delivering an `i64`. wasm says so at the *end* of the function, in a fall-through
      // it has nothing to do with.
      string tt = typeOfE(src, lexed, env, then);
      string et = typeOfE(src, lexed, env, els);
      // **Two arms of related types need the type they share**, not the first one's. `flag ? c : s`
      // with a `Circle` and a `Shape` declared a block returning a `Circle` and then handed it a
      // `Shape`: `type error in fallthru[0]`. A parent and a child give the parent; two siblings give
      // the ancestor they have in common, which is what `§wac-ternary-lca` asks for.
      // `issues/lang/0117`.
      if (tt != "" && et != "" && tt != et) {
        string shared = commonStructAncestor(env, tt, et);
        if (shared != "") { tt = shared; }
      }
      if (tt == "") { tt = et; }
      if (tt == "") { tt = want; }
      emitExpr(fb, src, lexed, env, cond);
      fb.byte(4);
      writeValType(fb, env, tt);
      // **A ternary is two decisions and had none.** `issues/lang/0112`: switching coverage to this
      // compiler dropped 157 `ternary-then` and 157 `ternary-else` points in `packages/fs` alone, and
      // a ratchet that stops instrumenting a construct does not go red — it goes *green*, with a
      // higher percentage, because what stopped existing is what was hard to reach.
      covPoint(fb, env, "ternary-then", then.line, then.col);
      emitExprAt(fb, src, lexed, env, then, tt);
      fb.byte(5);
      covPoint(fb, env, "ternary-else", els.line, els.col);
      emitExprAt(fb, src, lexed, env, els, tt);
      fb.byte(11);
    }
  }
}

/**
 * An expression's wac type — the emitter's own small type pass.
 *
 * Not the checker's. The checker answers a much harder question over the whole language and reports
 * when the answer is wrong; this one only has to be right for the expressions this slice emits, and
 * it is *needed* rather than merely useful: `a / b` is `i32.div_s` or `i32.div_u` depending on it, and
 * nothing in the token says which.
 *
 * A literal is the one case with no type of its own. It takes the other operand's, which is what the
 * language says and what makes `x + 1` an `i64` addition when `x` is an `i64`.
 */
string typeOfE(u8[] src, Lexed lexed, Env env, Expr e) {
  match (e.kind) {
    case IntLit(tok): { return ""; }
    case FloatLit(tok): { return ""; }
    case BoolLit(value): { return "bool"; }
    // A string literal, unlike a numeric one, *has* a type: it is an `i8[]` and no context can make
    // it anything else. `typeOfE` had no arm for one at all, so it came back unknown and the walk
    // declined the very literal the emitter had just learned to write.
    case Jsx(tagTok, closeTok, attrs, kids): { return "Node"; }
    case JsxText(startOff, endOff): { return "Node"; }
    case StrLit(tok): { return "string"; }
    case Ident(tok): {
      string nm = tokenTextOf(src, lexed, tok);
      string lt = env.localType(nm);
      if (lt != "") { return lt; }
      string key2 = nameKeyOf(env, src, lexed, tok);
      // A function used as a value has the type of its own signature.
      i32 fi2 = env.funcAt(key2);
      if (fi2 >= 0 && env.constAt(key2) < 0) { return signatureOf(env, fi2); }
      i32 ci = env.constAt(key2);
      return ci < 0 ? "" : env.constTypes[ci];
    }
    case Cast(op, operand, target): { return typeOfTyName(env, src, lexed, target); }
    case ArrNew(elem, size, fill, elements): { return typeOfTyName(env, src, lexed, elem) + "[]"; }
    case Member(obj, nameTok): {
      // A variant construction's type is the **variant**, not the enum: `Shape.Circle(2.0)` is a
      // `Circle`, which is what makes `s.radius` resolve to one slot in the arm that narrowed it.
      string vn3 = variantOfMember(src, lexed, env, obj, nameTok);
      if (vn3 != "") { return vn3; }
      // **`Counter.inc` with no parentheses is a value**: a reference to the function the method
      // compiled to, whose first parameter is the receiver. `this` cannot be captured — there are no
      // closures — so a method reference is the *unbound* one and nothing else can be spelled.
      i32 mref = methodRefAt(src, lexed, env, obj, nameTok);
      if (mref >= 0) { return signatureOf(env, mref); }
      string o = typeOfE(src, lexed, env, obj);
      if (env.enumOf(o) != "" || env.isEnumName(o)) {
        i32 sl = enumSlot(env, o, tokenTextOf(src, lexed, nameTok));
        return sl < 0 ? "" : env.fieldTypeAt(env.canonType(o), sl);
      }
      return env.isStructName(o) ? env.fieldType(o, tokenTextOf(src, lexed, nameTok)) : "";
    }
    case Index(arr, index): {
      string a = typeOfE(src, lexed, env, arr);
      // `s[i]` is a one-character **string**, not a byte — the representation is shared with `i8[]`
      // and the type is not, which is the same distinction `repType` exists for.
      if (a == "string") { return "string"; }
      if (!isArrayType(a)) { return ""; }
      string e = elemOf(a);
      // A packed element is an `i32` where it is used — the getter zero- or sign-extends it — which
      // is the checker's rule about packed types arrived at from the emitter's side.
      if (e == "u8" || e == "i8" || e == "u16" || e == "i16") { return "i32"; }
      return e;
    }
    case Call(callee, args): {
      match (callee.kind) {
        else: {
          string ct2 = typeOfE(src, lexed, env, callee);
          return isFuncrefType(ct2) ? sigReturn(ct2) : "";
        }
        case Member(obj, nameTok): {
          string mn = tokenTextOf(src, lexed, nameTok);
          string vn4 = variantOfMember(src, lexed, env, obj, nameTok);
          if (vn4 != "") { return vn4; }
          string pst = primStaticType(primTypeName(env, src, lexed, obj), mn);
          if (pst != "") { return pst; }
          if (isStringTypeName(src, lexed, env, obj) && mn == "fromBytes") { return "string"; }
          if (isStringTypeName(src, lexed, env, obj) && mn == "fromCodepoint") { return "string"; }
          string sown = staticOwner(src, lexed, env, obj);
          if (sown != "") {
            i32 si = env.funcAt(sown + "." + mn);
            return si < 0 ? "" : env.funcReturns[si];
          }
          string ot = typeOfE(src, lexed, env, obj);
          if (ot == "string" && mn == "toBytes") { return "u8[]"; }
          if (ot == "string" && mn == "slice") { return "string"; }
          if (ot == "string" && mn == "indexOf") { return "i32"; }
          if (isArrayType(ot) && mn == "copyFrom") { return "void"; }
          if (isArrayType(ot) && mn == "fill") { return "void"; }
          if ((isArrayType(ot) || ot == "string") && mn == "len") { return "i32"; }
          // An integer's five answer in its own width: `i64.clz` is `[i64] -> [i64]`.
          if (isIntType(ot) && intBuiltinOp(ot, mn) >= 0) { return ot; }
          string fft = env.isStructName(ot) ? env.fieldType(ot, mn) : "";
          if (isFuncrefType(fft)) { return sigReturn(fft); }
          i32 mi = methodOn(env, ot, mn);
          return mi < 0 ? "" : env.funcReturns[mi];
        }
      }
    }
    case Unary(op, operand): {
      i32 k = lexed.tokens[op * tokenStride()];
      if (k == kBang()) { return "bool"; }
      return typeOfE(src, lexed, env, operand);
    }
    case Binary(op, left, right): {
      i32 k = lexed.tokens[op * tokenStride()];
      if (k == kEq() || k == kNe() || k == kLt() || k == kLe() || k == kGt() || k == kGe() ||
          k == kAndAnd() || k == kOrOr()) {
        return "bool";
      }
      string lt = typeOfE(src, lexed, env, left);
      if (lt != "") { return lt; }
      string rt = typeOfE(src, lexed, env, right);
      if (rt != "") { return rt; }
      // **Two literals still have a family, even with no type.** `(0.0 / 0.0) as@ i32` answered ""
      // here, so the cast took its own target as the operand's type and converted `i32` to `i32` —
      // nothing — over an `f64` the emitter had just produced. A float literal is an `f64` unless a
      // slot narrows it, and that is as true inside an arithmetic expression as outside one.
      // `issues/lang/0117`, `§wac-raw-truncf-nan-w9fk2xq`.
      return isFloatLiteral(left) || isFloatLiteral(right) ? "f64" : "";
    }
    case Is(left, target, other, negated): { return "bool"; }
    case Incr(target, op, prefix): { return typeOfLv(src, lexed, env, peelLv(target)); }
    case Unwrap(operand): { return typeOfE(src, lexed, env, operand); }
    case MatchExpr(subject, arms): {
      // **With the arm's names in scope.** An arm whose value is its own binding — `case B(x): x`,
      // which is most of them — is untyped to anyone who cannot see `x`, and a match whose type is
      // unknown is declined by the guard above. Pushing the names here is what the emitter does when
      // it walks the same arm, and the two answers have to be the same one.
      string mt = "";
      for (i32 a = 0; a < arms.len(); a++) {
        if (arms[a].value is null) { continue; }
        if (mt != "") { continue; }
        i32 saved = pushArmNames(src, lexed, env, arms[a], subject);
        mt = typeOfE(src, lexed, env, arms[a].value!);
        env.localCount = saved;
      }
      return mt;
    }
    case Ternary(cond, then, els): {
      string tt = typeOfE(src, lexed, env, then);
      if (tt != "") { return tt; }
      return typeOfE(src, lexed, env, els);
    }
    case Construct(ctype, args, named): {
      match (ctype.kind) {
        case Named(tok, typeArgs): {
          string lt3 = env.localType(tokenTextOf(src, lexed, tok));
          if (isFuncrefType(lt3)) { return sigReturn(lt3); }
          string n2 = typeOfTyName(env, src, lexed, ctype);
          if (env.isStructName(n2)) { return n2; }
          i32 at = env.funcAt(n2);
          if (at < 0) { at = env.funcAt(genericCallInstance(env, src, lexed, tok, args)); }
          return at < 0 ? "" : env.funcReturns[at];
        }
        else: { return ""; }
      }
    }
    else: { return ""; }
  }
}

/** The type a binary operator's operands share, taken from whichever side is not a literal. */
string operandType(u8[] src, Lexed lexed, Env env, Expr left, Expr right) {
  string lt = typeOfE(src, lexed, env, left);
  if (lt != "") { return lt; }
  return typeOfE(src, lexed, env, right);
  // **Two literals leave this empty, and the caller reads empty as `i32`.** `1.0 == 1.0` is
  // therefore compared with `i32.eq` against two `f64` constants, and the module does not validate —
  // `§wac-cmpfloat` in `issues/lang/0116`'s list.
  //
  // Answering `"f64"` when either side is a float literal is the obvious repair and is **wrong**:
  // it is not the literals' family that decides, it is the slot's. Tried, and it made twelve corpus
  // files emit invalid modules — `bisect32` in `packages/fmt` returns an `f32` and computes with
  // literals, so forcing `f64` broke every caller of it. The fix has to reach the `want` the
  // emitter already has at the operator, which this function is not given.
}


/**
 * A binary operator's opcode.
 *
 * The signed ones are signed because this slice is `i32` throughout: `/`, `%`, `>>` and the four
 * comparisons each have a `_u` twin that an unsigned type would want instead, and choosing between
 * them is the first thing a second numeric type will need.
 */
/**
 * Record a branch point and emit its counter increment.
 *
 * The index *is* the position in the table, and the table is built as the points are emitted — so
 * emission order is the numbering, and a host reading `__cov_get(i)` and the table's `i`th row is
 * looking at the same place in the program. A no-op when instrumentation is off, which is what keeps
 * an ordinary build byte-identical.
 */
/**
 * How many i32 slots the journal gets by default: slot 0 is the cursor, then two per event.
 *
 * The reference's number, because a trace that fits under one compiler should fit under the other.
 * It is a *default* here and a constant there, which is `issues/lang/0059`: the routines that
 * overflow it are the ones selected for being expensive on purpose — bcrypt_pbkdf is 129 full
 * Blowfish key expansions per hash, and that cost is the function rather than a parameter of it. So
 * the class that cannot be measured is exactly the class whose job is to be slow.
 */
i32 defaultTraceSlots() { return 1 << 22; }

/** The journal's size for this build: what the caller asked for, or the default. */
i32 traceSlotsOf(Env env) {
  return env.traceSlots > 3 ? env.traceSlots : defaultTraceSlots();
}

/**
 * Append `(site, value)` to the journal, if there is room.
 *
 * The bounds test is a branch, but on the cursor rather than on anything the program computed, so it
 * never varies between two runs of the same length — which is the only property this instrumentation
 * has to preserve. `valueOnStack` says whether the value is already pushed: a branch appends a
 * constant zero, an index appends the index it just kept a copy of.
 */
void traceAppend(B fb, Env env, i32 site, i32 valueLocal) {
  i32 at = env.arrayType("i32[]");
  i32 cur = env.scratchNamed("tracecur", "i32");

  // **The last slot counts events, recorded or not.** A caller that overflows the journal used to
  // learn only *that* it had — a truncated flag — and had to double the size and try again. This
  // says how many it would have taken, so the next run is sized rather than guessed. It is outside
  // the pair region by construction: an append needs `cur + 3 < len`, so nothing writes past
  // `len - 2`. `issues/lang/0059`.
  fb.byte(35); fb.u32leb(0);
  fb.byte(65); fb.i32leb(traceSlotsOf(env) - 1);
  fb.byte(35); fb.u32leb(0);
  fb.byte(65); fb.i32leb(traceSlotsOf(env) - 1);
  fb.byte(251); fb.u32leb(11); fb.u32leb(at);      // array.get — the count so far
  fb.byte(65); fb.i32leb(1);
  fb.byte(106);                                    // i32.add
  fb.byte(251); fb.u32leb(14); fb.u32leb(at);      // array.set

  fb.byte(35); fb.u32leb(0);                       // global.get 0
  fb.byte(65); fb.i32leb(0);
  fb.byte(251); fb.u32leb(11); fb.u32leb(at);      // array.get — cursor = log[0]
  fb.byte(34); fb.u32leb(cur);                     // local.tee cur
  fb.byte(65); fb.i32leb(3); fb.byte(106);         // cur + 3
  fb.byte(35); fb.u32leb(0);
  fb.byte(251); fb.u32leb(15);                     // array.len
  fb.byte(73);                                     // i32.lt_u
  fb.byte(4); fb.byte(64);                         // if (there is room)

  fb.byte(35); fb.u32leb(0);
  fb.byte(32); fb.u32leb(cur); fb.byte(65); fb.i32leb(1); fb.byte(106);
  fb.byte(65); fb.i32leb(site);
  fb.byte(251); fb.u32leb(14); fb.u32leb(at);      // log[cur + 1] = site

  fb.byte(35); fb.u32leb(0);
  fb.byte(32); fb.u32leb(cur); fb.byte(65); fb.i32leb(2); fb.byte(106);
  if (valueLocal < 0) { fb.byte(65); fb.i32leb(0); } else { fb.byte(32); fb.u32leb(valueLocal); }
  fb.byte(251); fb.u32leb(14); fb.u32leb(at);      // log[cur + 2] = value

  fb.byte(35); fb.u32leb(0);
  fb.byte(65); fb.i32leb(0);
  fb.byte(32); fb.u32leb(cur); fb.byte(65); fb.i32leb(2); fb.byte(106);
  fb.byte(251); fb.u32leb(14); fb.u32leb(at);      // log[0] = cur + 2

  fb.byte(11);                                     // end
}

/**
 * Record the index about to be used by an array access, leaving it on the stack.
 *
 * Woven into the access rather than emitted beside it, because the value being recorded is the one
 * about to be consumed: `local.tee` keeps a copy without disturbing the stack.
 */
void traceIndex(B fb, Env env, i32 line, i32 col) {
  if (!env.trace) { return; }
  i32 idx = env.covCount;
  env.covCount = env.covCount + 1;
  covTableRow(env, idx, "index", line, col);
  i32 tmp = env.scratchNamed("traceidx", "i32");
  fb.byte(34); fb.u32leb(tmp);                     // local.tee — keep the index
  traceAppend(fb, env, idx, tmp);
}

/** One row of the table that says what a point is: the file's own line, not the blob's. */
void covTableRow(Env env, i32 idx, string kind, i32 line, i32 col) {
  i32 f = env.fileOf(line);
  i32 localLine = f < env.fileCount ? line - env.fileFirstLine[f] + 1 : line;
  string path = f < env.filePaths.len() ? env.filePaths[f] : "";
  env.covTable = env.covTable + numText(idx) + "\t" + numText(localLine) + "\t" + numText(col)
                 + "\t" + kind + "\t" + path + "\n";
}

void covPoint(B fb, Env env, string kind, i32 line, i32 col) {
  if (!env.coverage) { return; }
  i32 idx = env.covCount;
  env.covCount = env.covCount + 1;
  // **The file, and that file's own line.** Every line in this emitter is a line of the linked blob,
  // which is a concatenation nobody has open in an editor. A table that reports it as-is attributes
  // every point to the entry and numbers them past the end of the file it names: `packages/json`
  // read as 621 points in `json.wac` and none in the three files it imports [issue 0105]. The file
  // table is right here, so the translation happens once, where the answer is known.
  covTableRow(env, idx, kind, line, col);
  // In trace mode the array is a journal: *when* this point was reached is the whole question, and a
  // count cannot answer it.
  if (env.trace) { traceAppend(fb, env, idx, -1); return; }
  i32 at = env.arrayType("i32[]");
  fb.byte(35); fb.u32leb(0);                       // global.get 0
  fb.byte(65); fb.i32leb(idx);
  fb.byte(35); fb.u32leb(0);
  fb.byte(65); fb.i32leb(idx);
  fb.byte(251); fb.u32leb(11); fb.u32leb(at);      // array.get
  fb.byte(65); fb.i32leb(1);
  fb.byte(106);                                    // i32.add
  fb.byte(251); fb.u32leb(14); fb.u32leb(at);      // array.set
}

/**
 * `__cov_init()`, `__cov_len()` and `__cov_get(i)` — the three a host reads counters through.
 *
 * The names are the reference's, because a consumer written against one compiler should work against
 * the other. The *representation* is ours, as everywhere else on this boundary: the counters live in
 * a global `i32[]` rather than anywhere a caller can see, and `init` clears rather than allocates,
 * since a constant-expression global already made the array.
 */
void emitCoverageHelpers(B funcs, B code, Env env) {
  i32 at = env.arrayType("i32[]");

  // `__cov_init()` — every counter back to zero.
  funcs.u32leb(env.sigType("fn[void()]"));
  B ib = B.create();
  ib.u32leb(1);
  ib.u32leb(1); ib.byte(127);                      // one i32 local: the cursor
  ib.byte(65); ib.i32leb(0); ib.byte(33); ib.u32leb(0);
  ib.byte(2); ib.byte(64);
  ib.byte(3); ib.byte(64);
  ib.byte(32); ib.u32leb(0);
  ib.byte(65); ib.i32leb(env.trace ? traceSlotsOf(env) : env.covCount);
  ib.byte(78);                                     // i32.ge_s
  ib.byte(13); ib.u32leb(1);
  ib.byte(35); ib.u32leb(0);
  ib.byte(32); ib.u32leb(0);
  ib.byte(65); ib.i32leb(0);
  ib.byte(251); ib.u32leb(14); ib.u32leb(at);      // array.set
  ib.byte(32); ib.u32leb(0); ib.byte(65); ib.i32leb(1); ib.byte(106);
  ib.byte(33); ib.u32leb(0);
  ib.byte(12); ib.u32leb(0);
  ib.byte(11);
  ib.byte(11);
  ib.byte(11);
  code.u32leb(ib.len);
  code.bytes(ib);

  // `__cov_len()` — how many points this module has.
  funcs.u32leb(env.sigType("fn[i32()]"));
  B lb = B.create();
  lb.u32leb(0);
  // **Capacity in trace mode, not the number of points**: the reader uses it to say whether the log
  // filled up, and a trace that reached the end is a prefix rather than a clean run.
  lb.byte(65); lb.i32leb(env.trace ? traceSlotsOf(env) : env.covCount);
  lb.byte(11);
  code.u32leb(lb.len);
  code.bytes(lb);

  // `__cov_get(i)` — the count at a point.
  funcs.u32leb(env.sigType("fn[i32(i32)]"));
  B gb = B.create();
  gb.u32leb(0);
  gb.byte(35); gb.u32leb(0);
  gb.byte(32); gb.u32leb(0);
  gb.byte(251); gb.u32leb(11); gb.u32leb(at);      // array.get
  gb.byte(11);
  code.u32leb(gb.len);
  code.bytes(gb);
}

/**
 * The opcode for an integer's bit method, or -1 when the name is not one of the five.
 *
 * Two tables in one function because the pairing *is* the answer: which instruction depends on the
 * name and the width, and nothing else — `i32`/`u32` share a row and so do `i64`/`u64`, because not
 * one of the five reads a sign bit as a sign. `issues/lang/0069`.
 */
i32 intBuiltinOp(string t, string name) {
  bool wide = t == "i64" || t == "u64";
  if (name == "leadingZeros")  { return wide ? 121 : 103; }   // i64.clz    / i32.clz
  if (name == "trailingZeros") { return wide ? 122 : 104; }   // i64.ctz    / i32.ctz
  if (name == "onesCount")     { return wide ? 123 : 105; }   // i64.popcnt / i32.popcnt
  if (name == "rotateLeft")    { return wide ? 137 : 119; }   // i64.rotl   / i32.rotl
  if (name == "rotateRight")   { return wide ? 138 : 120; }   // i64.rotr   / i32.rotr
  return -1;
}

/**
 * Bind the narrowed name, when a condition is `x is T` and `T` is a struct below `x`'s type.
 *
 * Emitted at the top of the guarded block: read the outer local, `ref.cast` it, store it in a new
 * local of the same name. Everything after this in the block resolves the name to the narrowed one.
 * A condition of any other shape narrows nothing and this writes no instructions.
 */
string narrowedBy(u8[] src, Lexed lexed, Env env, Expr cond) {
  match (cond.kind) {
    case Is(left, target, other, negated): {
      if (negated) { return ""; }
      if (target is null) { return ""; }
      match (left.kind) {
        case Ident(tok): {
          string name = tokenTextOf(src, lexed, tok);
          if (env.localAt(name) < 0) { return ""; }
          string to = typeOfTyName(env, src, lexed, target!);
          if (!env.isStructName(env.canonType(to))) { return ""; }
          if (!isDescendantStruct(env, env.canonType(to), env.canonType(env.localType(name)))) {
            return "";
          }
          return name + " " + to;
        }
        else: { return ""; }
      }
    }
    else: { return ""; }
  }
}

/**
 * Bind the narrowed name for a *walk*: the type, and no instructions.
 *
 * The emittability walk types every expression the way the emitter will, so it has to know the same
 * shadow — without it, `s.radius` inside `if (s is Circle)` is `untyped member` and the whole file is
 * declined. One rule (`narrowedBy`), asked by both.
 */
void narrowTypes(u8[] src, Lexed lexed, Env env, Expr cond) {
  string pair = narrowedBy(src, lexed, env, cond);
  if (pair == "") { return; }
  i32 sp = pair.indexOf(" ");
  env.addLocal(pair.slice(0, sp), pair.slice(sp + 1, pair.len()));
}

void narrowInto(B fb, u8[] src, Lexed lexed, Env env, Expr cond) {
  string pair = narrowedBy(src, lexed, env, cond);
  if (pair == "") { return; }
  i32 sp = pair.indexOf(" ");
  string name = pair.slice(0, sp);
  string to = pair.slice(sp + 1, pair.len());
  fb.byte(32);
  fb.u32leb(env.localAt(name));
  fb.byte(251);
  fb.u32leb(23);   // ref.cast (ref $T) — the `is` above has already answered
  fb.i32leb(env.structType(env.canonType(to)));
  env.addLocal(name, to);
  fb.byte(33);
  fb.u32leb(env.localCount - 1);
}

/**
 * The nearest type both of these are, or `""` when they are not related.
 *
 * Walks one side's ancestry and asks whether the other fits under each in turn — so a parent and a
 * child answer the parent, and two siblings answer what they share. `""` for anything that is not a
 * pair of structs, which leaves the caller's own fallback in place.
 */
string commonStructAncestor(Env env, string a, string b) {
  string x = env.canonType(a);
  string y = env.canonType(b);
  if (!env.isStructName(x) || !env.isStructName(y)) { return ""; }
  for (i32 hop = 0; hop < 32; hop++) {
    if (x == "") { return ""; }
    if (x == y || isDescendantStruct(env, y, x)) { return x; }
    x = env.parentOf(x);
  }
  return "";
}

/** Whether this compound assignment is a shift, whose amount may be a different width. */
bool isShiftAssign(i32 k) {
  return k == kShlEq() || k == kShrEq() || k == kShrUEq();
}

/** Whether this operator answers a `bool` about its operands rather than computing with them. */
bool isComparisonOp(i32 k) {
  return k == kEq() || k == kNe() || k == kLt() || k == kLe() || k == kGt() || k == kGe();
}

/** Whether `to` is `from` or something that inherits from it — the shape a downcast goes against. */
bool isDescendantStruct(Env env, string to, string from) {
  if (to == "" || from == "" || to == from) { return false; }
  string at = env.parentOf(to);
  for (i32 hop = 0; hop < 32; hop++) {
    if (at == "") { return false; }
    if (at == from) { return true; }
    at = env.parentOf(at);
  }
  return false;
}

/** Whether this is an integer type, which is what `--checked` has anything to say about. */
bool isIntType(string t) {
  return t == "i32" || t == "u32" || t == "i64" || t == "u64";
}

/**
 * A checked add, subtract or multiply: operands on the stack, result on the stack, `unreachable`
 * where the value does not fit.
 *
 * The identities are the reference's (`compiler/wacEmitFunc.ts`), and so is the reasoning for each:
 * add and sub test signs, a 32-bit multiply widens to 64 and range-checks, and a 64-bit multiply
 * verifies by division because that is obviously correct. Two things in the last one are load-bearing
 * and were learned there the hard way — the signed form guards `MIN / -1` separately, and the
 * zero-divisor test is a *branch* rather than an `and`, since wasm evaluates both sides of an `and`
 * and the division would trap on every `0 * x`.
 *
 * The scratch locals are per function and reused: a nested checked operation has finished with
 * them by the time the outer one stores its operands.
 */
void emitCheckedArith(B fb, Env env, i32 k, string t) {
  bool is64 = t == "i64" || t == "u64";
  bool uns = t == "u32" || t == "u64";
  string wide = is64 ? "i64" : "i32";
  i32 a = env.scratchNamed("chkA", wide);
  i32 b = env.scratchNamed("chkB", wide);
  i32 sres = env.scratchNamed("chkS", wide);
  i32 s64 = env.scratchNamed("chk64", "i64");

  i32 xorOp = is64 ? 133 : 115;
  i32 andOp = is64 ? 131 : 113;
  i32 ltS = is64 ? 83 : 72;
  i32 ltU = is64 ? 84 : 73;

  fb.byte(33); fb.u32leb(b);                       // local.set b
  fb.byte(33); fb.u32leb(a);                       // local.set a
  fb.byte(32); fb.u32leb(a);
  fb.byte(32); fb.u32leb(b);
  if (k == kPlus()) { fb.byte(is64 ? 124 : 106); }
  if (k == kMinus()) { fb.byte(is64 ? 125 : 107); }
  if (k == kStar()) { fb.byte(is64 ? 126 : 108); }
  fb.byte(33); fb.u32leb(sres);                    // s = a op b, stashed rather than left

  if (k == kStar()) {
    if (!is64) {
      // Redo the multiply at 64 bits and compare — exact, and no division.
      fb.byte(32); fb.u32leb(a); fb.byte(uns ? 173 : 172);
      fb.byte(32); fb.u32leb(b); fb.byte(uns ? 173 : 172);
      fb.byte(126);                                // i64.mul
      fb.byte(33); fb.u32leb(s64);
      fb.byte(32); fb.u32leb(s64);
      fb.byte(66); fb.i64leb(uns ? 4294967295 : 2147483647);
      fb.byte(85);                                 // i64.gt_s
      fb.byte(4); fb.byte(64); fb.byte(0); fb.byte(11);
      fb.byte(32); fb.u32leb(s64);
      fb.byte(66); fb.i64leb(uns ? 0 : -2147483648);
      fb.byte(83);                                 // i64.lt_s
      fb.byte(4); fb.byte(64); fb.byte(0); fb.byte(11);
      fb.byte(32); fb.u32leb(sres);
      return;
    }
    if (!uns) {
      // `i64.div_s` traps on MIN / -1, so that pair is refused before the division below.
      fb.byte(32); fb.u32leb(a); fb.byte(66); fb.i64leb(-1); fb.byte(81);
      fb.byte(32); fb.u32leb(b); fb.byte(66); fb.i64leb(-9223372036854775808); fb.byte(81);
      fb.byte(113);                                // i32.and — two i32 comparisons
      fb.byte(4); fb.byte(64); fb.byte(0); fb.byte(11);
      fb.byte(32); fb.u32leb(b); fb.byte(66); fb.i64leb(-1); fb.byte(81);
      fb.byte(32); fb.u32leb(a); fb.byte(66); fb.i64leb(-9223372036854775808); fb.byte(81);
      fb.byte(113);
      fb.byte(4); fb.byte(64); fb.byte(0); fb.byte(11);
    }
    // A branch, not an `and`: the division traps on a zero divisor, and `and` evaluates both sides.
    fb.byte(32); fb.u32leb(a);
    fb.byte(80);                                   // i64.eqz
    fb.byte(69);                                   // i32.eqz  — i.e. a != 0
    fb.byte(4); fb.byte(64);
    fb.byte(32); fb.u32leb(sres);
    fb.byte(32); fb.u32leb(a);
    fb.byte(uns ? 128 : 127);                      // i64.div_u / i64.div_s
    fb.byte(32); fb.u32leb(b);
    fb.byte(82);                                   // i64.ne
    fb.byte(4); fb.byte(64); fb.byte(0); fb.byte(11);
    fb.byte(11);
    fb.byte(32); fb.u32leb(sres);
    return;
  }

  if (uns) {
    // Unsigned: an add overflows exactly when the sum is below an operand, a subtract when the
    // subtrahend exceeds the minuend.
    if (k == kPlus()) {
      fb.byte(32); fb.u32leb(sres); fb.byte(32); fb.u32leb(a); fb.byte(ltU);
    } else {
      fb.byte(32); fb.u32leb(a); fb.byte(32); fb.u32leb(b); fb.byte(ltU);
    }
    fb.byte(4); fb.byte(64); fb.byte(0); fb.byte(11);
    fb.byte(32); fb.u32leb(sres);
    return;
  }
  // Signed: an add overflows when the operands agree in sign and the sum differs; a subtract when
  // they differ in sign and the result differs from the minuend.
  fb.byte(32); fb.u32leb(a);
  fb.byte(32); fb.u32leb(k == kPlus() ? sres : b);
  fb.byte(xorOp);
  fb.byte(32); fb.u32leb(k == kPlus() ? b : a);
  fb.byte(32); fb.u32leb(sres);
  fb.byte(xorOp);
  fb.byte(andOp);
  if (is64) { fb.byte(66); fb.i64leb(0); } else { fb.byte(65); fb.i32leb(0); }
  fb.byte(ltS);
  fb.byte(4); fb.byte(64); fb.byte(0); fb.byte(11);
  fb.byte(32); fb.u32leb(sres);
}

void emitBinary(B fb, Env env, i32 k, string t) {
  bool u = isUnsigned(t);
  // **`--checked`**: `+`, `-` and `*` on an integer trap instead of wrapping. Everything else is
  // unchanged, and with the flag off not a byte moves — the instrument must not disturb what it is
  // not measuring, which the test asserts by comparing the two builds.
  if (env.checked && isIntType(t) &&
      (k == kPlus() || k == kMinus() || k == kStar())) {
    emitCheckedArith(fb, env, k, t);
    return;
  }
  if (isFloat(t)) {
    // The float opcodes are a block of their own rather than a suffix on the integer ones, and `f32`
    // and `f64` are two blocks 20 apart. Neither has a signed/unsigned distinction: a float has one
    // ordering, which is the reason the comparison opcodes here take no suffix.
    // The two float blocks are **14 apart** for arithmetic and **6 apart** for comparison, which is
    // not a mistake in the format and is exactly the sort of thing a table lifted from memory gets
    // wrong: `f32.add` is 0x92 and `f64.add` is 0xa0, while `f32.eq` is 0x5b and `f64.eq` is 0x61.
    i32 base = t == "f32" ? 0 : 14;
    if (k == kPlus()) { fb.byte(146 + base); }
    if (k == kMinus()) { fb.byte(147 + base); }
    if (k == kStar()) { fb.byte(148 + base); }
    if (k == kSlash()) { fb.byte(149 + base); }
    if (k == kEq()) { fb.byte(91 + (t == "f32" ? 0 : 6)); }
    if (k == kNe()) { fb.byte(92 + (t == "f32" ? 0 : 6)); }
    if (k == kLt()) { fb.byte(93 + (t == "f32" ? 0 : 6)); }
    if (k == kGt()) { fb.byte(94 + (t == "f32" ? 0 : 6)); }
    if (k == kLe()) { fb.byte(95 + (t == "f32" ? 0 : 6)); }
    if (k == kGe()) { fb.byte(96 + (t == "f32" ? 0 : 6)); }
    return;
  }
  if (valType(t) == 126) {
    // `i64`, whose arithmetic is the `i32` block shifted by 18 and whose comparisons are shifted by 6.
    if (k == kPlus()) { fb.byte(124); }
    if (k == kMinus()) { fb.byte(125); }
    if (k == kStar()) { fb.byte(126); }
    if (k == kSlash()) { fb.byte(u ? 128 : 127); }
    if (k == kPercent()) { fb.byte(u ? 130 : 129); }
    if (k == kAnd()) { fb.byte(131); }
    if (k == kOr()) { fb.byte(132); }
    if (k == kCaret()) { fb.byte(133); }
    if (k == kShl()) { fb.byte(134); }
    if (k == kShr()) { fb.byte(u ? 136 : 135); }
    if (k == kShrU()) { fb.byte(136); }
    if (k == kEq()) { fb.byte(81); }
    if (k == kNe()) { fb.byte(82); }
    if (k == kLt()) { fb.byte(u ? 84 : 83); }
    if (k == kGt()) { fb.byte(u ? 86 : 85); }
    if (k == kLe()) { fb.byte(u ? 88 : 87); }
    if (k == kGe()) { fb.byte(u ? 90 : 89); }
    return;
  }
  if (k == kPlus()) { fb.byte(106); }
  if (k == kMinus()) { fb.byte(107); }
  if (k == kStar()) { fb.byte(108); }
  if (k == kSlash()) { fb.byte(u ? 110 : 109); }
  if (k == kPercent()) { fb.byte(u ? 112 : 111); }
  if (k == kAnd()) { fb.byte(113); }
  if (k == kOr()) { fb.byte(114); }
  if (k == kCaret()) { fb.byte(115); }
  if (k == kShl()) { fb.byte(116); }
  if (k == kShr()) { fb.byte(u ? 118 : 117); }
  if (k == kShrU()) { fb.byte(118); }
  if (k == kEq()) { fb.byte(70); }
  if (k == kNe()) { fb.byte(71); }
  if (k == kLt()) { fb.byte(u ? 73 : 72); }
  if (k == kGt()) { fb.byte(u ? 75 : 74); }
  if (k == kLe()) { fb.byte(u ? 77 : 76); }
  if (k == kGe()) { fb.byte(u ? 79 : 78); }
}


/**
 * The instruction that turns one numeric type into another.
 *
 * The interesting half is what is **not** here: `i32` to `u32` and back is nothing at all, because
 * they are the same 32 bits and the difference lives only in which opcodes read them. That is the
 * whole reason this emitter needed a type model — the conversion is a no-op and the *arithmetic* is
 * not.
 */
/**
 * A cast, with `as!`'s check around it when the conversion is numeric.
 *
 * **`as!` is the checked cast and was emitting `as~`'s code**, so `1.5 as! i32` was 2 and
 * `5000000000 as! i32` was `i32` max — the one spelling whose job is to stop failing silently, and
 * inventing a plausible number while it did. `issues/lang/0127`.
 *
 * The check is one rule for every row: **convert, convert back, compare, trap if they differ.** The
 * fractional case needs no separate test — `1.5` truncates to `1` and `1.0 != 1.5` — and NaN handles
 * itself, since `trunc_sat` gives 0 and NaN is not equal to `0.0`. Not being equal to anything,
 * including itself, is what makes a comparison the right instrument here.
 *
 * Only for numeric conversions. A reference downcast is already checked by `ref.cast`, which traps
 * on a wrong type, and has no round trip to make.
 */
void emitCast(B fb, Env env, string from, string to, i32 op) {
  // **Same width is a reinterpretation, and carries no check.** `i32 as! u32` is the same
  // thirty-two bits read differently: `emitConversion` emits nothing for it, so the round trip
  // below would tee a value, convert it nowhere and back, compare it with itself and branch — six
  // instructions that can never fire, and about eighteen bytes of module each — measured, at three
  // casts, 609 base64 characters of wasm against 537.
  //
  // Not the literals: `1518500249 as! u32` takes its type from the target, so `from == to` catches
  // it before this does. It is a cast of an already-typed value — `i32 x` into a `u32` slot — that
  // reaches here, which is what the measurement above had to be rewritten to use once the first
  // version of it showed no difference at all.
  //
  // It is also the right answer rather than only the cheap one: `casts.md:86–94` lists nine
  // trapping rows and not one of them has the same wasm value type on both sides.
  if (op != kAsBang() || from == to || !isNumericTy(from) || !isNumericTy(to) ||
      valType(from) == valType(to)) {
    emitConversion(fb, env, from, to, op);
    return;
  }
  i32 srcL = env.scratchNamed("castsrc", from);
  i32 dstL = env.scratchNamed("castdst", to);
  fb.byte(34); fb.u32leb(srcL);              // local.tee  — keep the original
  emitConversion(fb, env, from, to, op);
  fb.byte(34); fb.u32leb(dstL);              // local.tee  — keep the converted
  emitConversion(fb, env, to, from, 0);      // and convert it back
  fb.byte(32); fb.u32leb(srcL);              // local.get  — the original
  fb.byte(eqOpcode(from));
  fb.byte(69);                               // i32.eqz — true when they differ
  fb.byte(4); fb.byte(64);                   // if (void)
  fb.byte(0);                                // unreachable
  fb.byte(11);                               // end
  fb.byte(32); fb.u32leb(dstL);              // local.get — the converted value
}

/**
 * Whether a type is one the round-trip check can compare.
 *
 * **Named, not asked of `valType`.** That helper answers 127 for everything it does not recognise,
 * so a struct, a string and an array all look like `i32` to it — and the first version of this check
 * used it and wrapped reference downcasts in an `i32.eq`, which is not valid wasm. Anything not
 * named here keeps the behaviour it had, which is the safe direction to be wrong in.
 */
bool isNumericTy(string t) {
  return t == "i32" || t == "u32" || t == "i64" || t == "u64" || t == "f32" || t == "f64";
}

/** The `eq` opcode for a numeric type's wasm value type. */
i32 eqOpcode(string t) {
  i32 v = valType(t);
  if (v == 125) { return 91; }               // f32.eq
  if (v == 124) { return 97; }               // f64.eq
  if (v == 126) { return 81; }               // i64.eq
  return 70;                                 // i32.eq
}

void emitConversion(B fb, Env env, string from, string to, i32 op) {
  if (from == to) { return; }
  // **Down out of the top type, into something with fields.** A callback's context comes back as
  // `anyref` and `ctx as! Keystrokes` is how it becomes usable again — the one place the language
  // asks for a downcast by name. Emitting nothing left an `anyref` where a `(ref null $T)` was
  // wanted, and the *module* failed to validate: `packages/ssh/src/sshd.wac` did not load at all
  // [issue 0106]. `ref.cast` is the instruction, and it traps on a wrong type, which is what `as!`
  // promises — `as~` has no meaning here and there is nothing to truncate.
  string castTo = to;
  if (castTo.len() > 1 && castTo.slice(castTo.len() - 1, castTo.len()) == "?") {
    castTo = castTo.slice(0, castTo.len() - 1);
  }
  // **A downcast within the hierarchy needs the same instruction**, and only `anyref` was asking for
  // it. `shapes[i] as! Rect` on a `Shape[]` emitted *nothing*: the value kept the parent's type, the
  // call that followed was handed a `Shape` where a `Rect` was wanted, and the module failed to
  // validate — `call[0] expected type (ref null 2), found array.get of type (ref null 1)`, with no
  // diagnostic and no decline before it. An upcast still emits nothing, which is right: wasm's
  // subtyping is structural and a `Rect` already is a `Shape`.
  string fromCore = from.len() > 1 && from.slice(from.len() - 1, from.len()) == "?"
    ? from.slice(0, from.len() - 1)
    : from;
  bool downcast = from != "anyref" && env.isStructName(env.canonType(fromCore))
    && isDescendantStruct(env, env.canonType(castTo), env.canonType(fromCore));
  if ((from == "anyref" || downcast) && to != "i31ref" && env.isStructName(env.canonType(castTo))) {
    fb.byte(251);
    // **Null is allowed through exactly when the target says so.** `ref.cast (ref $T)` traps on a
    // null, which is right for `S` and wrong for `S?` — the second is a type a null inhabits.
    fb.u32leb(castTo == to ? 23 : 22);
    fb.i32leb(env.structType(env.canonType(castTo)));
    return;
  }
  // **Into and out of an `i31ref`.** `42 as! i31ref` is `ref.i31`, and it is checked because the
  // instruction is not: it keeps the low 31 bits and says nothing about the rest, so a value that
  // does not fit would be silently truncated where the language says it traps. Shifting left and
  // back is the test — it returns the same number exactly when the sign bit was the 31st.
  if (to == "i31ref") {
    if (from == "anyref") {
      fb.byte(251);
      fb.u32leb(23);   // ref.cast (ref i31) — a downcast out of the top type, which traps
      fb.byte(108);
      return;
    }
    // **`as~` is the one spelling that wants the truncation.** The check below is what makes `as!`
    // checked; emitting it for every spelling made `1073741824 as~ i31ref` trap where the language
    // says it keeps the low bits — the raw cast is how a caller asks for exactly that.
    if (op == kAsTilde()) {
      fb.byte(251); fb.u32leb(28);   // ref.i31, and nothing around it
      return;
    }
    i32 t31 = env.scratchNamed("i31chk", "i32");
    fb.byte(34); fb.u32leb(t31);              // local.tee
    fb.byte(65); fb.i32leb(1); fb.byte(116);  // i32.shl 1
    fb.byte(65); fb.i32leb(1); fb.byte(117);  // i32.shr_s 1
    fb.byte(32); fb.u32leb(t31);
    fb.byte(70);                              // i32.eq
    // A **value-typed** `if`, not a `return`: this is an expression in the middle of one, and
    // leaving the function here would hand its result to whatever the function returns.
    fb.byte(4); fb.byte(108);                 // if (result i31ref)
    fb.byte(32); fb.u32leb(t31);
    fb.byte(251); fb.u32leb(28);              // ref.i31
    fb.byte(5);                               // else
    fb.byte(0);                               // unreachable — outside 31 bits, as `as!` promises
    fb.byte(11);
    return;
  }
  if (from == "i31ref" && valType(to) == 127) {
    fb.byte(251);
    fb.u32leb(29);   // i31.get_s — lossless, thirty-one bits fit an i32
    return;
  }
  // **A cast to `bool` is a test, not a reinterpretation.** `5 as~ bool` is `true`, which is the
  // number 1 — and `bool` is an `i32` here, so the same-width rule below called it a no-op and left
  // the 5 on the stack. `b == true` was then `5 == 1`.
  if (to == "bool") {
    if (valType(from) == 126) { fb.byte(80); }        // i64.eqz
    else if (valType(from) == 125) { fb.byte(67); fb.f32bits(0.0); fb.byte(91); }   // f32.eq 0
    else if (valType(from) == 124) { fb.byte(68); fb.f64bits(0.0); fb.byte(97); }   // f64.eq 0
    else { fb.byte(69); }                             // i32.eqz
    fb.byte(69);                                      // and again: zero is false, anything else true
    return;
  }
  // A sign change at the same width is **not** a no-op unless the spelling is raw: `-1 as~ u32` is 0.
  // This test used to come first and swallowed every one of them.
  if (valType(from) == valType(to) && !isFloat(from) && isUnsigned(from) != isUnsigned(to) &&
      op != kAsAt() && op != 0) {
    emitSaturate(fb, env, from, to);
    return;
  }
  if (valType(from) == valType(to) && !isFloat(from)) { return; }   // i32/u32, i64/u64
  if (valType(from) == 127 && valType(to) == 126) {
    // **Widening is still a sign change.** `(i32) -1 as~ u64` is 0, not `u64` max: the negative is
    // clamped in the *source's* width first and only then extended. Extending it signed and calling
    // the result unsigned was the last cell in the sweep, and the only one it took two rounds to see.
    if (isUnsigned(to) && !isUnsigned(from)) {
      i32 tmp = env.scratch(from);
      fb.byte(34); fb.u32leb(tmp);
      fb.byte(65); fb.i32leb(0);
      fb.byte(72);          // i32.lt_s
      fb.byte(4); fb.byte(wasmI32());
      fb.byte(65); fb.i32leb(0);
      fb.byte(5);
      fb.byte(32); fb.u32leb(tmp);
      fb.byte(11);
      fb.byte(173);         // i64.extend_i32_u, now that it cannot be negative
      return;
    }
    fb.byte(isUnsigned(from) ? 173 : 172);   // i64.extend_i32_u / _s
    return;
  }
  // **`as@` wraps where the others saturate.** Raw is a claim about the bit pattern, so the value is
  // truncated and nothing is clamped — `(i64) 0xdeadbeef as@ i32` is a negative `i32`, not `i32` max.
  if (valType(from) == 126 && valType(to) == 127 && op == kAsAt()) {
    fb.byte(167);   // i32.wrap_i64
    return;
  }
  if (valType(from) == 126 && valType(to) == 127) {
    emitSaturate(fb, env, from, to);
    return;
  }
  if (false) {
    i32 tmp = env.scratch(from);
    fb.byte(34);              // local.tee — keeps the value while storing it
    fb.u32leb(tmp);
    emitI64Const(fb, upperBound(to));
    fb.byte(isUnsigned(from) ? 86 : 85);   // i64.gt_u / gt_s
    fb.byte(4);
    fb.byte(wasmI32());       // if (result i32)
    emitI32Const(fb, upperBound(to));
    fb.byte(5);
    fb.byte(32);
    fb.u32leb(tmp);
    emitI64Const(fb, lowerBound(to));
    fb.byte(isUnsigned(from) ? 84 : 83);   // i64.lt_u / lt_s
    fb.byte(4);
    fb.byte(wasmI32());
    emitI32Const(fb, lowerBound(to));
    fb.byte(5);
    fb.byte(32);
    fb.u32leb(tmp);
    fb.byte(167);             // i32.wrap_i64
    fb.byte(11);
    fb.byte(11);
    return;
  }
  if (!isFloat(from) && to == "f64") {
    if (valType(from) == 126) { fb.byte(isUnsigned(from) ? 186 : 185); }
    else { fb.byte(isUnsigned(from) ? 184 : 183); }
    return;
  }
  if (!isFloat(from) && to == "f32") {
    if (valType(from) == 126) { fb.byte(imm(180, 181, isUnsigned(from))); }
    else { fb.byte(imm(178, 179, isUnsigned(from))); }
    return;
  }
  if (isFloat(from) && !isFloat(to)) {
    // **`as~` rounds; `as@` truncates.** Two spellings and two different answers — `1.5 as~ i32` is 2
    // and `1.5 as@ i32` is 1 — which one instruction covered wrongly for both until the sweep put a
    // `.5` through it.
    if (op != kAsAt()) { fb.byte(from == "f32" ? 144 : 158); }   // f32.nearest / f64.nearest
    // And **saturating**, not trapping: `1e10 as~ i32` is `i32` max and `-2.25 as~ u32` is 0, where
    // the plain `trunc` family raises. That is the `trunc_sat` block, behind the `0xfc` prefix.
    fb.byte(252);
    i32 base = valType(to) == 126 ? 4 : 0;
    i32 wide = from == "f32" ? 0 : 2;
    fb.u32leb(base + wide + (isUnsigned(to) ? 1 : 0));
    return;
  }
  // **The trapping `trunc` family used to sit here behind an `if (false)`**, and it is gone rather
  // than revived. It reads like the fix for `issues/lang/0127` and is not one: `i32.trunc_f64_s`
  // traps on range and NaN but *not* on a fractional part, so switching it on would have turned
  // `1.5 as! i32` from one wrong answer into another. What `as!` needed was a round trip, which
  // `emitCast` does above.
  if (from == "f32" && to == "f64") { fb.byte(187); }
  if (from == "f64" && to == "f32") { fb.byte(182); }
}

/** One of two opcodes, by signedness — the shape half of `emitConversion` is made of. */
i32 imm(i32 signed, i32 unsigned, bool u) { return u ? unsigned : signed; }

/** A decimal float literal's value. */

/** The largest value the target type holds, as the `i64` the comparison needs. */
i64 upperBound(string t) {
  if (t == "u32") { return 4294967295; }
  if (t == "i64") { return 9223372036854775807; }
  if (t == "u64") { return -1; }   // 0xffff…, which is what an unsigned compare wants
  return 2147483647;
}

/** The smallest, which is zero for an unsigned target. */
i64 lowerBound(string t) {
  if (t == "u32" || t == "u64") { return 0; }
  if (t == "i64") { return -9223372036854775808; }
  return -2147483648;
}

/** An `i64` constant, which the clamp needs on the wide side of each comparison. */
void emitI64Const(B fb, i64 v) {
  fb.byte(66);
  fb.i64leb(v);
}

/**
 * An `i32` constant, which the clamp needs on the narrow side.
 *
 * `as@` and not `as~`, and the difference is the bug this function had: `u32`'s upper bound is
 * 4294967295, which does not fit an `i32`, and `as~` **saturates** — so the constant came out as
 * `i32` max and the clamp pinned every large value there. The bit pattern is what is wanted, which is
 * what the raw spelling means. This emitter's own new rule, met immediately from the other side.
 */
void emitI32Const(B fb, i64 v) {
  fb.byte(65);
  fb.i32leb(v as@ i32);
}

/**
 * Reading an element, where a **packed** one needs a sign.
 *
 * `array.get` has three spellings: the plain one for a value type, and `_s`/`_u` for a storage type
 * narrower than a value. A `u8[]` element arrives zero-extended and an `i8[]` one sign-extended, and
 * the checker's own rule — that a packed element is an `i32` at the point of use — is this, seen from
 * the other end of the compiler.
 */
void emitArrayGet(B fb, Env env, string arrayType) {
  if (!isArrayType(arrayType)) { return; }
  string e = elemOf(arrayType);
  fb.byte(251);
  if (e == "u8" || e == "u16") { fb.u32leb(13); }        // array.get_u
  else if (e == "i8" || e == "i16") { fb.u32leb(12); }   // array.get_s
  else { fb.u32leb(11); }                                // array.get
  fb.u32leb(env.arrayType(arrayType));
}

/**
 * An lvalue with its `!`s peeled off — `nodes[i]!.up = true` writes to the same place `nodes[i].up`
 * does.
 *
 * **Unwrapping is addressing-transparent here** because `T?` and `T` are one wasm type: the write
 * goes to the same field of the same struct, and a null still traps at the access rather than
 * needing a check of its own. So the assertion says something to the *checker* and nothing to the
 * emitter, and peeling is the whole of honouring it.
 */
Lvalue peelLv(Lvalue lv) {
  match (lv.kind) {
    case LUnwrap(base): { return peelLv(base); }
    else: { return lv; }
  }
}

/** An lvalue's wac type, which a write through an index needs to know which array it is. */
string typeOfLv(u8[] src, Lexed lexed, Env env, Lvalue lv) {
  match (lv.kind) {
    case LIdent(tok): { return env.localType(tokenTextOf(src, lexed, tok)); }
    case LUnwrap(base): { return typeOfLv(src, lexed, env, base); }
    case LIndex(base, index): {
      string b = typeOfLv(src, lexed, env, base);
      return isArrayType(b) ? elemOf(b) : "";
    }
    case LField(base, nameTok): {
      string b = typeOfLv(src, lexed, env, base);
      return env.isStructName(b) ? env.fieldType(b, tokenTextOf(src, lexed, nameTok)) : "";
    }
  }
}

/** An lvalue as a *value*, which is what pushing an array before `array.set` needs. */
void emitLvalue(B fb, u8[] src, Lexed lexed, Env env, Lvalue lv) {
  match (lv.kind) {
    case LIdent(tok): {
      i32 at = env.localAt(tokenTextOf(src, lexed, tok));
      if (at < 0) { return; }
      fb.byte(32);
      fb.u32leb(at);
    }
    case LUnwrap(base): { emitLvalue(fb, src, lexed, env, base); }
    case LIndex(base, index): {
      string bt = typeOfLv(src, lexed, env, base);
      emitLvalue(fb, src, lexed, env, base);
      emitAt(fb, src, lexed, env, index, "i32");
      emitArrayGet(fb, env, bt);
    }
    case LField(base, nameTok): {
      string bt2 = typeOfLv(src, lexed, env, base);
      if (!env.isStructName(bt2)) { return; }
      emitLvalue(fb, src, lexed, env, base);
      fb.byte(251);
      fb.u32leb(2);
      fb.u32leb(env.structType(bt2));
      fb.u32leb(env.fieldIndex(bt2, tokenTextOf(src, lexed, nameTok)));
    }
  }
}

/**
 * One function: its type, its index, its export if it has one, and its body.
 *
 * Methods and plain functions differ in exactly one thing — a method has a **receiver**, which is a
 * parameter before all the others and is called `this` inside. Everything else about them is the
 * same, which is why they share this rather than being two nearly identical loops.
 *
 * `exportName` is empty for a function nobody exports, and every method: wac exports a struct's
 * methods through the struct, and this slice has no way to hand one across the boundary.
 */
void emitFunction(B types, B funcs, B exports, B code, u8[] src, Lexed lexed, Env env, Program prog,
                  string exportName, Ty returnType, Param[] params, Stmt[] body, string receiver,
                  i32 index, i32 declTypes, i32 nameTok) {
  // The **shared** signature type, registered in the pre-pass. Pooling them is not an optimisation
  // here: a private type per function is a different type from the one a `fn[...]` value declares,
  // however identical it looks.
  string ret = typeOfTyName(env, src, lexed, returnType);
  bool returnsValue = ret != "void";
  string mine = emittedSig(env, src, lexed, returnType, params, receiver);
  funcs.u32leb(env.sigType(mine));
  // **The wrapper that lets this function be the funcref inside a `fn[…]` pair** — `design/lang/0002`.
  // Built here because here is the one place every emitted function passes through, so the wrappers
  // are exactly the emitted functions, in emission order, and `wrapCount` cannot disagree with the
  // count the function section was sized from.
  //
  // It takes the env and drops it, then calls this function with everything else. A bound reference
  // will read the env rather than dropping it; this is the unbound case, where the pair carries null.
  env.wrapFuncs.u32leb(env.sigType(envSig(mine)));
  {
    B wb = B.create();
    wb.u32leb(0);                                       // no locals of its own
    for (i32 wi = 0; wi < sigParamCount(mine); wi++) {
      wb.byte(32); wb.u32leb(wi + 1);                   // local.get, skipping the env at 0
    }
    wb.byte(16); wb.u32leb(index);                      // call
    wb.byte(11);                                        // end
    env.wrapCode.u32leb(wb.len);
    env.wrapCode.bytes(wb);
  }
  env.wrapCount = env.wrapCount + 1;

  // **The bound wrapper**, which is what makes `c.inc` a value — `design/lang/0002` step 2. Same
  // shape as above but the env is *read* rather than dropped: cast to the receiver and passed as the
  // first argument, which is where a method's receiver already lives.
  //
  // Emitted for every function, not only for methods, so the index stays arithmetic —
  // `boundAt + (funcIndex - cbSigCount)`. For a receiver-less function it is a duplicate of the
  // unbound one and nothing references it; a wrapper is a handful of bytes and a second index table
  // would be a second thing to keep in step.
  string bsig = receiver == "" ? mine : emittedSig(env, src, lexed, returnType, params, "");
  env.boundFuncs.u32leb(env.sigType(envSig(bsig)));
  {
    B bb = B.create();
    bb.u32leb(0);
    if (receiver != "") {
      bb.byte(32); bb.u32leb(0);                        // local.get env
      bb.byte(251); bb.u32leb(23);                      // ref.cast (ref $Receiver)
      bb.i32leb(env.structType(env.canonType(receiver)));
    }
    for (i32 wi = 0; wi < params.len(); wi++) {
      bb.byte(32); bb.u32leb(wi + 1);
    }
    bb.byte(16); bb.u32leb(index);                      // call
    bb.byte(11);
    env.boundCode.u32leb(bb.len);
    env.boundCode.bytes(bb);
  }
  if (exportName != "") {
    exports.name(exportName);
    exports.byte(0);
    exports.u32leb(index);
  }

  env.returnType = ret;
  env.localCount = 0;
  if (receiver != "") { env.addLocal("this", receiver); }
  for (i32 i = 0; i < params.len(); i++) {
    env.addLocal(tokenTextOf(src, lexed, params[i].nameTok),
                 typeOfTyName(env, src, lexed, params[i].type));
  }
  env.paramCount = env.localCount;

  // **The body first, then the declaration that precedes it.** A scratch local is allocated while
  // emitting — a saturating cast needs one and nothing before the cast knows that — so the count is
  // not final until the last instruction is written. Same shape as a section, whose length is only
  // knowable once its contents are: build it apart, then write the header and splice it in.
  B insns = B.create();
  // **A point at the entry**, so a function that is never called is visible as such rather than as a
  // body whose branches happen not to have fired — **at the function's own name**, which is the
  // whole of what makes it one point rather than all of them. With `0, 0` every entry point in a
  // program shared the key `<entry file>:0:0:entry`, `report` merged them into **one**, and it was
  // covered the moment any function anywhere ran: 145 of `packages/json`'s 146 "was this ever
  // called?" measurements did not exist, and the percentage went up for measuring less. They were
  // also all attributed to the entry file, so a package's number claimed its dependencies' entries.
  // `issues/lang/0115`.
  covPoint(insns, env, "entry", tokenLine(lexed, nameTok), tokenCol(lexed, nameTok));
  emitBody(insns, src, lexed, env, body);

  B fb = B.create();
  // One entry per local rather than runs of a repeated type. Both are legal, the runs form is
  // shorter, and a canonical module form flattens the difference.
  i32 extra = env.localCount - env.paramCount;
  fb.u32leb(extra);
  for (i32 i = env.paramCount; i < env.localCount; i++) {
    fb.u32leb(1);
    writeValType(fb, env, env.localTypes[i]);
  }
  fb.bytes(insns);
  // Every wac function that returns a value returns on all paths — the checker says so — so the
  // fall-through is unreachable rather than missing.
  if (returnsValue) { fb.byte(0); }
  fb.byte(11);    // `end`
  code.u32leb(fb.len);
  code.bytes(fb);
}

/**
 * The first construct in a function this emitter cannot do, or `""` when it can do all of them.
 *
 * **Why this exists.** Every walk here ends in `else: { }`, which for an *expression* means emitting
 * nothing where a value was expected. That is not a gap, it is a corruption: the function that
 * follows is wrong in a way wasm reports as *"not enough arguments on the stack"*, naming a stack
 * depth rather than the construct. Across the repository it accounted for 199 of 308 broken modules
 * and told me nothing about what was missing.
 *
 * So the emitter asks first. A function with something unsupported in it is **not emitted at all**,
 * and the name of what stopped it is the answer — which turns a list of stack errors into a list of
 * language features, ordered by how much they would buy.
 */
string unsupportedIn(u8[] src, Lexed lexed, Env env, Stmt[] body) {
  // The **same scope the emitter will have**, which is the point: this walk decides whether a name
  // is a local, and it has to decide that the same way twice or it approves a body the emitter
  // cannot resolve — or declines one it can.
  i32 saved = env.localCount;
  for (i32 i = 0; i < body.len(); i++) {
    string r = unsupportedStmt(src, lexed, env, body[i]);
    if (r != "") {
      env.localCount = saved;
      return r;
    }
  }
  env.localCount = saved;
  return "";
}

/**
 * What stops a `match` — the subject, the arms' variants, or the enum itself.
 *
 * Shared by the statement and the expression form, which differ only in what an arm holds.
 */
string unsupportedMatch(u8[] src, Lexed lexed, Env env, Expr subject, Arm[] arms) {
  string sv = unsupportedValue(src, lexed, env, subject);
  if (sv != "") { return sv; }
  string en = env.canonType(typeOfE(src, lexed, env, subject));
  if (!env.isEnumName(en)) { return "a match on something that is not an enum"; }
  for (i32 a = 0; a < arms.len(); a++) {
    if (arms[a].variantTok < 0) { continue; }
    string vn = armVariant(env, src, lexed, arms[a].variantTok, en);
    if (env.enumOf(vn) != en) {
      // Named, both of them: which arm, and which enum it belongs to instead of this one.
      string owner = env.enumOf(vn);
      return "the arm " + tokenTextOf(src, lexed, arms[a].variantTok) + " belongs to " +
             (owner == "" ? "no enum" : owner) + ", not to " + en;
    }
  }
  return "";
}

/**
 * The arm's names, in scope for the walk exactly as they will be for the emission.
 *
 * The walk asks the same questions of an arm's body that the emitter will — whether a name is a
 * local, what type it has, which slot a field is — so it has to see the same scope, or it approves a
 * body that reads a binding it thinks is undefined. Returns what to restore the count to.
 */
i32 pushArmNames(u8[] src, Lexed lexed, Env env, Arm arm, Expr subject) {
  i32 saved = env.localCount;
  if (arm.variantTok < 0) { return saved; }
  string vn = armVariant(env, src, lexed, arm.variantTok,
                         env.canonType(typeOfE(src, lexed, env, subject)));
  i32 vi = env.variantAt(vn);
  if (vi < 0) { return saved; }
  string en = env.variantOwners[vi];
  for (i32 b = 0; b < arm.bindingToks.len(); b++) {
    if (b >= env.variantArity[vi]) { continue; }
    string bn = tokenTextOf(src, lexed, arm.bindingToks[b]);
    if (bn == "_") { continue; }
    env.addLocal(bn, env.fieldTypeAt(en, env.variantSlot[vi] + b));
  }
  match (subject.kind) {
    case Ident(tok): { env.addLocal(tokenTextOf(src, lexed, tok), vn); }
    else: { }
  }
  return saved;
}

string unsupportedStmt(u8[] src, Lexed lexed, Env env, Stmt s) {
  match (s.kind) {
    case Var(type, nameTok, init, isConst): {
      string t = typeOfTyName(env, src, lexed, type);
      if (t == "") { return "local of an unspelled type"; }
      string r0 = unsupportedValueAt(src, lexed, env, init, t);
      // The name comes into scope **after** its initialiser, which is where it comes into scope in
      // the language too.
      env.addLocal(tokenTextOf(src, lexed, nameTok), t);
      if (r0 != "") { return r0; }
      // Two known types that differ. wac has struct inheritance and this emitter has no notion of a
      // subtype, so `Base b = aSub;` is a `local.set` of the wrong reference type — and there is no
      // conversion to write, because the two are the same value and only the *checker* knows that.
      string g0 = isLiteral(init) ? "" : typeOfE(src, lexed, env, init);
      // A **variant and its enum are not related types here, they are the same one** — `Shape s =
      // Shape.Point;` differs only in the name, and the flat representation is what makes that true.
      // Canonicalising before the comparison is the whole of the difference between an enum this
      // emitter can do and one it declines on its first line.
      // **Except up the chain**, where they are related in the way the format understands: a
      // subtype's reference is its parent's reference, and the widening is the absence of an
      // instruction rather than the presence of one.
      if (g0 != "" && env.canonType(g0) != env.canonType(t) && valType(g0) == valType(t) &&
          (isArrayType(t) || env.isStructName(t)) &&
          !env.isSubtypeOf(env.canonType(g0), env.canonType(t))) {
        return "an assignment between related reference types";
      }
      return "";
    }
    case Assign(target, op, rhs): {
      string lv = unsupportedLvalue(src, lexed, env, target);
      if (lv != "") { return lv; }
      string tt2 = typeOfLv(src, lexed, env, target);
      i32 ka = lexed.tokens[op * tokenStride()];
      if (ka != kAssign() && tt2 == "string" && ka != kPlusEq()) {
        return "a compound assignment to a string that is not +=";
      }
      if (ka != kAssign() && tt2 != "string" &&
          (isArrayType(tt2) || env.isStructName(tt2))) {
        return "a compound assignment to a reference";
      }
      // **The target is the slot.** `own = null;` where `own` is a `string[]?` is a null with its
      // type written on the line above, and this arm asked about the right-hand side with nothing
      // in hand — the same omission the array `fill` and the variant payload had.
      return unsupportedValueAt(src, lexed, env, rhs, tt2);
    }
    case IncrStmt(target, op): { return unsupportedLvalue(src, lexed, env, target); }
    case Return(value): {
      if (value is null) { return ""; }
      return unsupportedValueAt(src, lexed, env, value!, env.returnType);
    }
    case ExprStmt(e): {
      string r = unsupportedExpr(src, lexed, env, e);
      if (r != "") { return r; }
      // A statement's value has to be *dropped*, and dropping needs to know whether there is one.
      // An unknown type means the emitter cannot tell, so it emits no `drop` and leaves the value on
      // the stack — which wasm reports at the end of the function as a fall-through of the wrong
      // type, seven files away from the statement that caused it.
      return typeOfE(src, lexed, env, e) == "" ? "a statement whose value this slice cannot place" : "";
    }
    case If(cond, then, els): {
      string c = unsupportedExpr(src, lexed, env, cond);
      if (c != "") { return c; }
      // The guarded block sees the narrowed type, exactly as the emitter will.
      i32 savedIf = env.localCount;
      narrowTypes(src, lexed, env, cond);
      string t = unsupportedIn(src, lexed, env, then);
      env.localCount = savedIf;
      if (t != "") { return t; }
      return unsupportedIn(src, lexed, env, els);
    }
    case While(cond, inner): {
      string c = unsupportedExpr(src, lexed, env, cond);
      if (c != "") { return c; }
      return unsupportedIn(src, lexed, env, inner);
    }
    case DoWhile(inner, cond): {
      string c = unsupportedExpr(src, lexed, env, cond);
      if (c != "") { return c; }
      return unsupportedIn(src, lexed, env, inner);
    }
    case For(init, cond, update, inner): {
      // The same scope the emitter gives it: a `for`'s own variable is not in the scope that
      // follows the loop, and a walk that thinks otherwise types the code after it against the
      // wrong local.
      i32 savedFor = env.localCount;
      string r2 = "";
      if (r2 == "" && !(init is null)) { r2 = unsupportedStmt(src, lexed, env, init!); }
      if (r2 == "" && !(cond is null)) { r2 = unsupportedExpr(src, lexed, env, cond!); }
      if (r2 == "" && !(update is null)) { r2 = unsupportedStmt(src, lexed, env, update!); }
      if (r2 == "") { r2 = unsupportedIn(src, lexed, env, inner); }
      env.localCount = savedFor;
      return r2;
    }
    case Block(inner): { return unsupportedIn(src, lexed, env, inner); }
    case Switch(subject, cases): {
      string sj = unsupportedExpr(src, lexed, env, subject);
      if (sj != "") { return sj; }
      for (i32 i = 0; i < cases.len(); i++) {
        string b = unsupportedIn(src, lexed, env, cases[i].body);
        if (b != "") { return b; }
      }
      return "";
    }
    case Break: { return ""; }
    case Continue: { return ""; }
    case Trap: { return ""; }
    case Match(subject, arms): {
      string ms = unsupportedMatch(src, lexed, env, subject, arms);
      if (ms != "") { return ms; }
      for (i32 a = 0; a < arms.len(); a++) {
        i32 saved = pushArmNames(src, lexed, env, arms[a], subject);
        string b = unsupportedIn(src, lexed, env, arms[a].body);
        env.localCount = saved;
        if (b != "") { return b; }
      }
      return "";
    }
  }
}

string unsupportedLvalue(u8[] src, Lexed lexed, Env env, Lvalue lv) {
  match (lv.kind) {
    case LIdent(tok): { return ""; }
    case LUnwrap(base): { return unsupportedLvalue(src, lexed, env, base); }
    case LIndex(base, index): {
      string b = unsupportedLvalue(src, lexed, env, base);
      if (b != "") { return b; }
      if (!isArrayType(typeOfLv(src, lexed, env, base))) { return "index of an unknown type"; }
      return unsupportedExpr(src, lexed, env, index);
    }
    case LField(base, nameTok): {
      string b = unsupportedLvalue(src, lexed, env, base);
      if (b != "") { return b; }
      return env.isStructName(typeOfLv(src, lexed, env, base)) ? "" : "field of an unknown type";
    }
  }
}

/**
 * An expression in a position that **consumes a value**, which is the stricter question.
 *
 * Structure is not enough. Every remaining broken module in the corpus was a function whose shape the
 * walk approved and whose *types* the emitter then guessed: a literal emitted at `i32` where an `i64`
 * was wanted, an operand pair whose shared type came back empty. If this emitter cannot say what an
 * expression **is**, it cannot emit it correctly, and saying so is the only honest answer.
 *
 * Separate from `unsupportedExpr` because a call in statement position legitimately has no type — a
 * `void` function returns nothing, and demanding one there would decline every effectful call.
 */
/** Whether a wac type is a reference, which is the only kind of slot a `null` can fill. */
bool isRefType(Env env, string t) {
  return isArrayType(t) || t == "string" || env.isStructName(t) || isFuncrefType(t) ||
         t == "anyref" || t == "i31ref";
}

/**
 * A value **for a known slot**, which is the only way `null` can be asked about.
 *
 * `null` has no type of its own, so whether it can be emitted is a question about where it is going,
 * and the walk answers questions with no `want` in hand. The sites that do know one — an
 * initialiser, an argument, a field — ask through here; everywhere else `null` stays declined, which
 * is conservative in the direction that matters. Approving it everywhere and emitting it only where
 * the type was a reference is how nine corpus modules came back with *"not enough arguments on the
 * stack for struct.new"*: the argument had emitted nothing at all.
 */
/**
 * Whether a struct construction of `n` can be emitted — the arguments, the named form, the count.
 *
 * Extracted so the same rules answer for a construction whose instance came from the **slot**:
 * `MapEntry(k, v)` into a `MapEntry<K,V>` field is the same construction as one written with its
 * arguments, and duplicating thirty lines to say so is how the two would drift apart.
 */
string unsupportedConstructOf(u8[] src, Lexed lexed, Env env, string n, Expr[] args,
                              NamedArg[] named) {
          i32 want = env.fieldCountOf(n);
          // **Named construction names every field, once, in any order** — a partial one is a
          // reference error rather than a defaulted struct, and this is the rule that lets the
          // emitter above walk the fields instead of the arguments.
          if (named.len() > 0) {
            if (args.len() > 0) { return "a construction mixing named and positional"; }
            for (i32 i = 0; i < want; i++) {
              i32 seen = 0;
              for (i32 j = 0; j < named.len(); j++) {
                if (env.fieldIndex(n, tokenTextOf(src, lexed, named[j].nameTok)) == i) {
                  seen = seen + 1;
                }
              }
              // **None is allowed when the field is nullable**, which is the emitter's half of
              // `design/lang/0007`: it fills the slot with null. Twice is still a decline, and so is
              // none for a field that has no null to stand for absence.
              if (seen == 0 && env.fieldNullableAt(n, i)) { continue; }
              if (seen != 1) { return "a named construction that does not name every field once"; }
            }
            for (i32 j = 0; j < named.len(); j++) {
              i32 fi = env.fieldIndex(n, tokenTextOf(src, lexed, named[j].nameTok));
              string a5 = unsupportedValueAt(src, lexed, env, named[j].value,
                                             env.fieldTypeAt(n, fi));
              if (a5 != "") { return a5; }
            }
            return "";
          }
          if (args.len() != 0 && args.len() != want) {
            return "a construction of " + n + " with " + numText(args.len()) + " of " +
                   numText(want) + " fields";
          }
          for (i32 i = 0; i < args.len(); i++) {
            string a = unsupportedValueAt(src, lexed, env, args[i], env.fieldTypeAt(n, i));
            if (a != "") { return a; }
          }
          return "";
}

string unsupportedValueAt(u8[] src, Lexed lexed, Env env, Expr e, string want) {
  match (e.kind) {
    // **A bare generic constructor takes its instance from the slot** — `MapEntry(k, v)` into a
    // `MapEntry<K,V>` field. The language spells it this way everywhere else too, and
    // `templateStatic` says so for `Vec.create()`; nothing said it for a plain construction, so the
    // name reached the call path looking like a function nobody declared. `issues/lang/0092`.
    case Construct(ctype, args, named): {
      string cn = typeOfTyName(env, src, lexed, ctype);
      if (!env.isStructName(cn) && isInstance(want) && templateOf(want) == cn
          && env.isStructName(want)) {
        return unsupportedConstructOf(src, lexed, env, want, args, named);
      }
      return unsupportedValue(src, lexed, env, e);
    }
    // A payload-less variant of a template is a **value and not a call** — `Opt.None` — so it needs
    // the slot in the same way and reaches it through a different node.
    case Member(obj, nameTok): {
      return variantOfMemberAt(src, lexed, env, obj, nameTok, want) != ""
        ? "" : unsupportedValue(src, lexed, env, e);
    }
    // A static on a template takes its instantiation from the slot, so it can only be asked about
    // where there is one — `typeOfE` has none and would call the whole call untyped.
    case Call(callee, args): {
      match (callee.kind) {
        case Member(obj, nameTok): {
          // A **template's variant** — `Option.Some(3)` — before its statics, since both are written
          // on the template and only the table can tell a variant from a method.
          string vw = variantOfMemberAt(src, lexed, env, obj, nameTok, want);
          if (vw != "") {
            i32 vwi = env.variantAt(vw);
            if (args.len() != env.variantArity[vwi]) { return "a variant with the wrong count"; }
            string vwo = env.variantOwners[vwi];
            for (i32 i = 0; i < args.len(); i++) {
              string a7 = unsupportedValueAt(src, lexed, env, args[i],
                                             env.fieldTypeAt(vwo, env.variantSlot[vwi] + i));
              if (a7 != "") { return a7; }
            }
            return "";
          }
          string tw = templateStatic(env, src, lexed, obj, want);
          if (tw == "") { return unsupportedValue(src, lexed, env, e); }
          string tn = tokenTextOf(src, lexed, nameTok);
          i32 ta = env.funcAt(tw + "." + tn);
          if (ta < 0) { return "no static " + tw + "." + tn; }
          if (!env.funcOk[ta]) { return declinedBecause("a static " + tw + "." + tn, env, ta); }
          if (env.funcParamCount[ta] != args.len()) { return "a static with the wrong count"; }
          for (i32 i = 0; i < args.len(); i++) {
            string a6 = unsupportedValueAt(src, lexed, env, args[i], env.paramTypeAt(ta, i));
            if (a6 != "") { return a6; }
          }
          return "";
        }
        else: { return unsupportedValue(src, lexed, env, e); }
      }
    }
    // **And a `match` expression hands it to every arm**, for the same reason and one node over:
    // `return match (o) { case Some(v): Opt.Some(f(v)), case None: Opt.None };` is a whole generic
    // function's body, and which instance those variants build is written nowhere but the return
    // type. The arm's own bindings go into scope first, exactly as the emitter puts them there.
    case MatchExpr(subject, arms): {
      string mm2 = unsupportedMatch(src, lexed, env, subject, arms);
      if (mm2 != "") { return mm2; }
      for (i32 a = 0; a < arms.len(); a++) {
        if (arms[a].value is null) { return "an arm with no value"; }
        i32 saved2 = pushArmNames(src, lexed, env, arms[a], subject);
        string v2 = unsupportedValueAt(src, lexed, env, arms[a].value!, want);
        env.localCount = saved2;
        if (v2 != "") { return v2; }
      }
      return "";
    }
    // **A ternary in a slot hands that slot to both branches.** `return c ? Option.None :
    // Option.Some(v);` has arms that know nothing on their own — which instance of a template they
    // build comes from the return type — and this walk had no arm for one, so the question reached
    // the version that has no slot to give and came back as "unresolved name Option". The order is
    // the emitter's: the branches' own type first, and the slot only when they have none.
    case Ternary(cond, then, els): {
      string tc = unsupportedValue(src, lexed, env, cond);
      if (tc != "") { return tc; }
      string tw2 = typeOfE(src, lexed, env, then);
      if (tw2 == "") { tw2 = typeOfE(src, lexed, env, els); }
      if (tw2 == "") { tw2 = want; }
      string t2 = unsupportedValueAt(src, lexed, env, then, tw2);
      if (t2 != "") { return t2; }
      return unsupportedValueAt(src, lexed, env, els, tw2);
    }
    case NullLit: {
      if (isRefType(env, want)) { return ""; }
      // Named, not categorised: which slot it is, is the whole of what a reader needs — and where
      // the slot has no type at all, that is a different problem wearing the same message.
      return want == "" ? "a null in a slot of no known type" : "a null in a " + want + " slot";
    }
    else: { return unsupportedValue(src, lexed, env, e); }
  }
}

string unsupportedValue(u8[] src, Lexed lexed, Env env, Expr e) {
  string r = unsupportedExpr(src, lexed, env, e);
  if (r != "") { return r; }
  // A literal has no type of its own and takes the slot's, which is the one thing that is *meant* to
  // come back empty here.
  if (isLiteral(e)) { return ""; }
  if (typeOfE(src, lexed, env, e) == "") { return "untyped " + kindOfExpr(e); }
  return "";
}

/** Whether a literal is a float one, which cannot share a slot with an integer one. */
bool isFloatLiteral(Expr e) {
  match (e.kind) {
    case FloatLit(tok): { return true; }
    case Unary(op, operand): { return isFloatLiteral(operand); }
    case Binary(op, left, right): { return isFloatLiteral(left) || isFloatLiteral(right); }
    else: { return false; }
  }
}

/**
 * Whether an expression takes its type from **context** rather than having one of its own.
 *
 * A literal, obviously — and also arithmetic over literals, which is the same fact one level up:
 * `0 - 100000` in an `i32` slot is an `i32` subtraction and in an `i64` slot an `i64` one, and
 * neither operand says which. Calling it untyped and declining it refused a working function, which
 * is how this arm found out it had to exist.
 */
bool isLiteral(Expr e) {
  match (e.kind) {
    case IntLit(tok): { return true; }
    case FloatLit(tok): { return true; }
    case BoolLit(value): { return true; }
    // `null` takes its type from the slot exactly as `0` does — it is context-typed rather than
    // untyped, which is why the emitter can give it the wanted reference type and why the guard that
    // declines an expression of unknown type is not about it.
    case NullLit: { return true; }
    case Unary(op, operand): { return isLiteral(operand); }
    // Both sides literal *and of the same family*. `1 / 2.0` is two literals and not one type: the
    // context cannot settle it, because whatever it says one of the two will be wrong. Treating it as
    // context-typed emitted an `f64.const` into an `i32` division.
    case Binary(op, left, right): {
      if (!isLiteral(left) || !isLiteral(right)) { return false; }
      return isFloatLiteral(left) == isFloatLiteral(right);
    }
    // `cond ? 1 : 2` has no type of its own for the same reason `1` does not: both branches are
    // literals and the slot is what settles them. The condition is not part of the question — it is
    // always a boolean and never the value.
    case Ternary(cond, then, els): {
      if (!isLiteral(then) || !isLiteral(els)) { return false; }
      return isFloatLiteral(then) == isFloatLiteral(els);
    }
    else: { return false; }
  }
}

string unsupportedExpr(u8[] src, Lexed lexed, Env env, Expr e) {
  match (e.kind) {
    case IntLit(tok): { return ""; }
    case FloatLit(tok): { return ""; }
    case BoolLit(value): { return ""; }
    case JsxText(startOff, endOff): { return ""; }
    case Jsx(tagTok, closeTok, attrs, kids): {
      // **The tree has to be reachable**, which it is exactly when the program imported it: `core`
      // is only linked in when something names it. Saying which import is missing beats declining
      // an expression the reader can see is well formed.
      if (jsxElementVariant(env) < 0) {
        return "a JSX element without `import { Attr, Node } from core;`";
      }
      for (i32 i = 0; i < attrs.len(); i++) {
        string why = unsupportedExpr(src, lexed, env, attrs[i].value);
        if (why != "") { return why; }
      }
      for (i32 i = 0; i < kids.len(); i++) {
        string why = unsupportedExpr(src, lexed, env, kids[i]);
        if (why != "") { return why; }
      }
      return "";
    }
    case StrLit(tok): {
      return knownEscapes(src, lexed, tok) ? "" : "a string literal with an escape this slice cannot read";
    }
    case NullLit: { return "null"; }
    case Ident(tok): {
      string nm = tokenTextOf(src, lexed, tok);
      if (env.localAt(nm) >= 0) { return ""; }
      i32 ci = env.constAt(nm);
      // A **function's name as a value** is a reference to it, which is only emittable if the
      // function is: a reference to something this emitter skipped would be a `ref.func` naming an
      // index that is not there.
      if (ci < 0) {
        i32 fr2 = env.funcAt(nm);
        if (fr2 >= 0) {
          return env.funcOk[fr2] ? "" : declinedBecause("a reference to " + nm, env, fr2);
        }
      }
      if (ci < 0) {
        // With the line, because a name is unresolved *somewhere* and the file may use it ten times
        // — `packages/git/src/repo.wac` says `Kind` in four places and only one of them was the
        // problem. `issues/lang/0097`'s reduction cost an hour for want of this.
        return "unresolved name " + nm + " on line " + numText(tokenLine(lexed, tok));
      }
      // A constant is inlined, so whatever its initialiser needs, the *use site* needs. An array
      // constant would be allocated afresh at each use, which is a different program — declined until
      // there is a global to hold one.
      string ct = env.constTypes[ci];
      // A constant with identity is read from a global, which it has only if its initialiser is a
      // constant expression — wasm's sense of that, which is far narrower than wac's.
      if (isArrayType(ct) || env.isStructName(ct)) {
        return env.constGlobal[ci] >= 0 ? "" : "a constant whose value is not a constant expression";
      }
      if (env.constInits[ci] is null) { return "a constant with no initialiser"; }
      return unsupportedValue(src, lexed, env, env.constInits[ci]!);
    }
    case Unary(op, operand): { return unsupportedExpr(src, lexed, env, operand); }
    case Binary(op, left, right): {
      string l = unsupportedValue(src, lexed, env, left);
      if (l != "") { return l; }
      string r = unsupportedValue(src, lexed, env, right);
      if (r != "") { return r; }
      // **No binary operator applies to a reference.** Now that a `string` is an `i8[]`, `a + b` on
      // two of them types as an array and emits `i32.add` over two references — twenty-four corpus
      // files' worth. Concatenation and comparison are generated helper *functions* in the reference,
      // not instructions, and this slice has none, so it says so.
      string ot2 = operandType(src, lexed, env, left, right);
      i32 bk = lexed.tokens[op * tokenStride()];
      // String equality has a helper now; everything else on a reference still does not.
      if (ot2 == "string" &&
          (bk == kEq() || bk == kNe() || bk == kPlus() ||
           bk == kLt() || bk == kLe() || bk == kGt() || bk == kGe())) {
        return "";
      }
      if (isArrayType(ot2) || ot2 == "string" || env.isStructName(ot2)) {
        return "an operator on " + ot2;
      }
      return "";
    }
    case Cast(op, operand, target): {
      string t = typeOfTyName(env, src, lexed, target);
      bool known = isArrayType(t) || env.isStructName(t) || t == "i32" || t == "u32" ||
                   t == "i64" || t == "u64" || t == "f32" || t == "f64" || t == "bool" ||
                   t == "anyref" || t == "i31ref";
      if (!known) { return "cast to an unsupported type"; }
      return unsupportedExpr(src, lexed, env, operand);
    }
    case Ternary(cond, then, els): {
      string c = unsupportedValue(src, lexed, env, cond);
      if (c != "") { return c; }
      // **A branch's slot is the other branch.** `cond is null ? null : cond` asks nothing of the
      // context — the ternary's type is what the non-null side has — and asking each branch on its
      // own is how the emitter's own `emitLoop` call was declined by the emitter.
      string tw = typeOfE(src, lexed, env, then);
      if (tw == "") { tw = typeOfE(src, lexed, env, els); }
      string t = unsupportedValueAt(src, lexed, env, then, tw);
      if (t != "") { return t; }
      return unsupportedValueAt(src, lexed, env, els, tw);
    }
    case Index(arr, index): {
      string a = unsupportedValue(src, lexed, env, arr);
      if (a != "") { return a; }
      string ia = typeOfE(src, lexed, env, arr);
      if (ia != "string" && !isArrayType(ia)) { return "index of an unknown type"; }
      return unsupportedValue(src, lexed, env, index);
    }
    case Member(obj, nameTok): {
      // The variant question comes **first**, because the object of `Shape.Point` is a bare name
      // that is not a local and every other path here would decline it as one.
      if (variantOfMember(src, lexed, env, obj, nameTok) != "") { return ""; }
      // A method reference resolves through the *name* on the left, so the object is not an
      // expression to walk — asking about it produces "unresolved name Counter", which is a true
      // statement about a type name and a useless one.
      i32 mr = methodRefAt(src, lexed, env, obj, nameTok);
      if (mr >= 0) {
        return env.funcOk[mr] ? "" : "a method reference to a declined function";
      }
      string o = unsupportedExpr(src, lexed, env, obj);
      if (o != "") { return o; }
      string ot3 = typeOfE(src, lexed, env, obj);
      if (env.enumOf(ot3) != "" || env.isEnumName(ot3)) {
        i32 sl = enumSlot(env, ot3, tokenTextOf(src, lexed, nameTok));
        if (sl == -2) { return "a payload name two variants share"; }
        return sl < 0 ? "a payload that is not on this variant" : "";
      }
      return env.isStructName(ot3) ? "" : "member of an unknown type";
    }
    case ArrNew(elem, size, fill, elements): {
      string et2 = typeOfTyName(env, src, lexed, elem);
      if (et2 == "") { return "array of an unspelled type"; }
      if (!(size is null)) {
        string sz = unsupportedValueAt(src, lexed, env, size!, "i32");
        if (sz != "") { return sz; }
      }
      // **The element type is the slot.** `Vec<i32>[n](fill: Vec.create())` is a static on a
      // template, which takes its instantiation from where the answer goes — and this arm was
      // asking about the fill and every element with no slot at all, so a `null` or a template
      // static among them was refused for want of a type that is written right there.
      if (!(fill is null)) {
        string fl = unsupportedValueAt(src, lexed, env, fill!, et2);
        if (fl != "") { return fl; }
      }
      for (i32 i = 0; i < elements.len(); i++) {
        string el = unsupportedValueAt(src, lexed, env, elements[i], et2);
        if (el != "") { return el; }
      }
      return "";
    }
    case Construct(ctype, args, named): {
      match (ctype.kind) {
        case Named(tok, typeArgs): {
          string lraw2 = tokenTextOf(src, lexed, tok);
          string lty2 = env.localType(lraw2);
          if (isFuncrefType(lty2)) {
            if (named.len() > 0) { return "named arguments in a call"; }
            if (sigParamCount(lty2) != args.len()) { return "a call with the wrong count"; }
            for (i32 i = 0; i < args.len(); i++) {
              string a4 = unsupportedValueAt(src, lexed, env, args[i], sigParamAt(lty2, i));
              if (a4 != "") { return a4; }
            }
            return "";
          }
          string n = typeOfTyName(env, src, lexed, ctype);
          if (env.isStructName(n)) {
            return unsupportedConstructOf(src, lexed, env, n, args, named);
          }
          if (named.len() > 0) { return "named arguments in a call"; }
          i32 fa = env.funcAt(n);
          // A generic function is registered under the *instance* the arguments imply, never under
          // the bare name — so a lookup that fails is the question "which instance is this?" not yet
          // asked. `mapOption(some, double)` names `mapOption<i32,i32>`.
          if (fa < 0) { fa = env.funcAt(genericCallInstance(env, src, lexed, tok, args)); }
          // **Named, not categorised.** "a call to something unknown" was the corpus's largest
          // category at 66 files and said nothing about any of them; the name turns a category into
          // a diagnosis, which is the difference between a slot of guessing and one of fixing.
          if (fa < 0) { return "a call to " + tokenTextOf(src, lexed, tok); }
          if (!env.funcOk[fa]) {
            return declinedBecause("a call to " + tokenTextOf(src, lexed, tok), env, fa);
          }
          for (i32 i = 0; i < args.len(); i++) {
            string a = unsupportedValueAt(src, lexed, env, args[i], env.paramTypeAt(fa, i));
            if (a != "") { return a; }
          }
          return "";
        }
        else: { return "a construction kind"; }
      }
    }
    case Call(callee, args): {
      match (callee.kind) {
        case Member(obj, nameTok): {
          string mn = tokenTextOf(src, lexed, nameTok);
          string pw = primTypeName(env, src, lexed, obj);
          if (primStaticType(pw, mn) != "") {
            if (args.len() != 1) { return "a " + pw + "." + mn + " with the wrong count"; }
            return unsupportedValueAt(src, lexed, env, args[0], primStaticArg(pw, mn));
          }
          string vcall = variantOfMember(src, lexed, env, obj, nameTok);
          if (vcall != "") {
            i32 cvi = env.variantAt(vcall);
            if (args.len() != env.variantArity[cvi]) { return "a variant with the wrong count"; }
            // The payload slots are known here, so a `null` among them can be asked about rather
            // than refused — `ExprKind.Is(e, null, null, negated)` is why `parse.wac` could not be
            // compiled by the compiler it is part of.
            string ven = env.variantOwners[cvi];
            for (i32 i = 0; i < args.len(); i++) {
              string a2 = unsupportedValueAt(src, lexed, env, args[i],
                                             env.fieldTypeAt(ven, env.variantSlot[cvi] + i));
              if (a2 != "") { return a2; }
            }
            return "";
          }
          // A **static** call names its owner with a type rather than a value: `Big.create(…)`. The
          // receiver is not an expression at all, so asking whether it is one calls a perfectly good
          // struct name unresolved — which is what three corpus files were saying.
          if (isStringTypeName(src, lexed, env, obj) && mn == "fromBytes" && args.len() == 1) {
            return unsupportedValue(src, lexed, env, args[0]);
          }
          if (isStringTypeName(src, lexed, env, obj) && mn == "fromCodepoint" && args.len() == 1) {
            return unsupportedValueAt(src, lexed, env, args[0], "i32");
          }
          string owner = staticOwner(src, lexed, env, obj);
          if (owner != "") {
            i32 sa = env.funcAt(owner + "." + mn);
            if (sa < 0) { return "no static " + owner + "." + mn; }
            if (!env.funcOk[sa]) { return declinedBecause("a static " + owner + "." + mn, env, sa); }
            for (i32 i = 0; i < args.len(); i++) {
              string a = unsupportedValueAt(src, lexed, env, args[i], env.paramTypeAt(sa, i));
              if (a != "") { return a; }
            }
            return "";
          }
          string o = unsupportedExpr(src, lexed, env, obj);
          if (o != "") { return o; }
          string ot = typeOfE(src, lexed, env, obj);
          if (ot == "string" && mn == "toBytes" && args.len() == 0) { return ""; }
          if (ot == "string" && mn == "slice" && args.len() == 2) {
            string s1 = unsupportedValueAt(src, lexed, env, args[0], "i32");
            if (s1 != "") { return s1; }
            return unsupportedValueAt(src, lexed, env, args[1], "i32");
          }
          if (ot == "string" && mn == "indexOf" && args.len() == 1) {
            return unsupportedValueAt(src, lexed, env, args[0], "string");
          }
          if (isArrayType(ot) && mn == "fill" && args.len() == 3) {
            string fv = unsupportedValueAt(src, lexed, env, args[0], elemOf(ot));
            if (fv != "") { return fv; }
            string fs2 = unsupportedValueAt(src, lexed, env, args[1], "i32");
            if (fs2 != "") { return fs2; }
            return unsupportedValueAt(src, lexed, env, args[2], "i32");
          }
          if (isArrayType(ot) && mn == "copyFrom" && args.len() == 4) {
            // The source has to be an array this emitter can name, and the two element types have to
            // match — `array.copy` takes both type indices and wasm checks they agree.
            string st = typeOfE(src, lexed, env, args[0]);
            if (!isArrayType(st) || st != ot) { return "a copyFrom between different array types"; }
            for (i32 i = 0; i < args.len(); i++) {
              string a = unsupportedValue(src, lexed, env, args[i]);
              if (a != "") { return a; }
            }
            return "";
          }
          if ((isArrayType(ot) || ot == "string") && mn == "len") { return ""; }
          // The five bit methods are instructions, not functions, so there is no method to find.
          if (isIntType(ot) && intBuiltinOp(ot, mn) >= 0) {
            for (i32 i = 0; i < args.len(); i++) {
              string ab = unsupportedValueAt(src, lexed, env, args[i], ot);
              if (ab != "") { return ab; }
            }
            return "";
          }
          string ffty = env.isStructName(ot) ? env.fieldType(ot, mn) : "";
          if (isFuncrefType(ffty)) {
            if (sigParamCount(ffty) != args.len()) { return "a call with the wrong count"; }
            for (i32 i = 0; i < args.len(); i++) {
              string a5 = unsupportedValueAt(src, lexed, env, args[i], sigParamAt(ffty, i));
              if (a5 != "") { return a5; }
            }
            return "";
          }
          i32 ma = methodOn(env, ot, mn);
          if (ma < 0) { return "no method " + ot + "." + mn; }
          if (!env.funcOk[ma]) { return declinedBecause("a method " + ot + "." + mn, env, ma); }
          for (i32 i = 0; i < args.len(); i++) {
            // A method is registered with its declared parameters; the receiver is pushed at the
            // call site and is not one of them.
            string a = unsupportedValueAt(src, lexed, env, args[i], env.paramTypeAt(ma, i));
            if (a != "") { return a; }
          }
          return "";
        }
        // A call through a value is a `call_ref`, and what it needs is a signature this emitter can
        // name: the arguments are checked against the *signature's* parameters rather than a
        // declaration's, since there is no declaration at a call site like this.
        else: {
          string cv = unsupportedValue(src, lexed, env, callee);
          if (cv != "") { return cv; }
          string cty = typeOfE(src, lexed, env, callee);
          if (!isFuncrefType(cty)) { return "a call through something that is not a function"; }
          if (sigParamCount(cty) != args.len()) { return "a call with the wrong count"; }
          for (i32 i = 0; i < args.len(); i++) {
            string a3 = unsupportedValueAt(src, lexed, env, args[i], sigParamAt(cty, i));
            if (a3 != "") { return a3; }
          }
          return "";
        }
      }
    }
    case Incr(target, op, prefix): {
      string it = typeOfLv(src, lexed, env, peelLv(target));
      if (it != "i32" && it != "i64" && it != "u8" && it != "u32" && it != "u64" && it != "i8" &&
          it != "i16" && it != "u16") {
        return "increment of " + (it == "" ? "an unknown type" : it);
      }
      return unsupportedLvalue(src, lexed, env, target);
    }
    case Is(left, target, other, negated): {
      if ((target is null) && (other is null)) {
        string nl = unsupportedValue(src, lexed, env, left);
        if (nl != "") { return nl; }
        string nt = typeOfE(src, lexed, env, left);
        return isRefType(env, nt) ? "" : "a null test on a value";
      }
      if (!(other is null)) {
        string il2 = unsupportedValue(src, lexed, env, left);
        if (il2 != "") { return il2; }
        string ir2 = unsupportedValue(src, lexed, env, other!);
        if (ir2 != "") { return ir2; }
        string it2 = typeOfE(src, lexed, env, left);
        return isArrayType(it2) || env.isStructName(it2) ? "" : "an identity test on a value";
      }
      if (target is null) { return "is null"; }
      string ty3 = typeOfTyName(env, src, lexed, target!);
      if (env.variantAt(ty3) < 0) {
        string lt3 = unsupportedValue(src, lexed, env, left);
        if (lt3 != "") { return lt3; }
        string lty = env.canonType(typeOfE(src, lexed, env, left));
        if (isRefType(env, ty3) && lty == env.canonType(ty3)) { return ""; }
        // A test against a *different* type asks about the hierarchy, and there is one now — but
        // only downwards. `aRect is Shape` is a question with a constant answer, and `x is Y` where
        // the two are unrelated is one the format would refuse to type.
        if (env.isStructName(ty3) && env.isSubtypeOf(env.canonType(ty3), lty)) { return ""; }
        if (ty3 == "i31ref" && env.isSubtypeOf("i31ref", lty)) { return ""; }
        return "a test for " + ty3 + " on a " + (lty == "" ? "value of no known type" : lty);
      }
      string il = unsupportedValue(src, lexed, env, left);
      if (il != "") { return il; }
      return env.isEnumName(env.canonType(typeOfE(src, lexed, env, left))) ? ""
                                                                           : "a test on a non-enum";
    }
    case Unwrap(operand): { return unsupportedValue(src, lexed, env, operand); }
    case MatchExpr(subject, arms): {
      string mm = unsupportedMatch(src, lexed, env, subject, arms);
      if (mm != "") { return mm; }
      for (i32 a = 0; a < arms.len(); a++) {
        if (arms[a].value is null) { return "an arm with no value"; }
        i32 saved = pushArmNames(src, lexed, env, arms[a], subject);
        string v = unsupportedValue(src, lexed, env, arms[a].value!);
        env.localCount = saved;
        if (v != "") { return v; }
      }
      return "";
    }
  }
}

/**
 * Whether a function can be emitted at all, with its parameters in scope while the question is asked.
 *
 * The scope matters: `unsupportedExpr` calls a bare name unsupported when it is not a local, and a
 * parameter is only a local once it has been declared. Asking without the parameters would refuse
 * every function that mentions one, which is every function.
 *
 * Records what stopped it on the way out, so a caller can report the *feature* rather than the wasm
 * stack error that a half-emitted function eventually produces.
 */
/**
 * `a call to runList, declined: a local declared twice` — the hop, and what stopped it.
 *
 * A decline cascades, and naming only the nearest hop points at a function that is perfectly fine.
 * `sh`'s report read *a static Shell.capturing, declined*, which is three functions away from
 * anything wrong. The reason a callee recorded when it was declined is carried here, and since it
 * was itself built this way the message unrolls the whole chain.
 */
string declinedBecause(string what, Env env, i32 at) {
  string why = at >= 0 && at < env.funcWhy.len() ? env.funcWhy[at] : "";
  return why == "" ? what + ", declined" : what + ", declined: " + why;
}

bool canEmit(u8[] src, Lexed lexed, Env env, Param[] params, Stmt[] body, string receiver,
             string ret) {
  i32 savedCount = env.localCount;
  // The **return type**, for the same reason the parameters are here: `return null;` is a question
  // about the slot it is returning into, and a walk that does not know the slot can only decline.
  string savedRet = env.returnType;
  env.returnType = ret;
  i32 savedParams = env.paramCount;
  env.localCount = 0;
  if (receiver != "") { env.addLocal("this", receiver); }
  for (i32 i = 0; i < params.len(); i++) {
    string pt = typeOfTyName(env, src, lexed, params[i].type);
    env.addLocal(tokenTextOf(src, lexed, params[i].nameTok), pt);
  }
  env.paramCount = env.localCount;
  // **Two locals of one name.** wasm has a single flat frame per function and the language has block
  // scopes, so `for (i32 k = …)` in one block and `i64 k = …` in another are two different locals
  // with one name — and a name-to-index lookup cannot tell them apart. Searching from the end gives
  // the *later* one to the earlier block, which is an `i32.const` going into an `i64` slot and a
  // module that does not validate. Declined until there is a scope stack to resolve them properly.
  string why = unsupportedIn(src, lexed, env, body);
  env.lastWhy = why;
  if (why != "" && env.blocked == "") { env.blocked = why; }
  env.localCount = savedCount;
  env.paramCount = savedParams;
  env.returnType = savedRet;
  return why == "";
}

/**
 * What stopped this module, or `""` when every function in it was emitted.
 *
 * A second entry point rather than a second return value, because `emitModule` hands back bytes and
 * wac has no tuple — and because a corpus harness asking "why not" is a different caller from one
 * asking "what did you produce". It re-parses, which costs a millisecond and keeps the two honest.
 */
export string emitBlocked(u8[] src) { return emitBlockedOf(src, -1, i32[1](), i32[1](), string[1]()); }

/** Why a linked module was not emitted in full, over the same file set `emitLinked` takes. */
export string blockedLinked(string[] paths, string[] sources, string entry) {
  i32[] starts = i32[512]();
  i32[] edges = i32[65536]();
  string[] names = string[32768]();
  string[] filePaths = string[1024]();
  string blob = linkFiles(paths, sources, entry, starts, edges, names, filePaths);
  if (blob == "") {
    return starts[0] == 1 ? "more import edges than the linker was given room for"
                          : "an import of a file that was not supplied";
  }
  return emitBlockedOf(blob.toBytes(), declCountOf(sourceOf(paths, sources, entry)), starts,
                       edges, names);
}

string emitBlockedOf(u8[] src, i32 entryDecls, i32[] starts, i32[] edges, string[] names) {
  Lexed lexed = lex(src);
  P p = P.create(src, lexed.tokens, lexed.tokenCount);
  Program prog = parseProgram(p);
  Env env = Env.create();
  // The file table first: every key handed out below is derived from it, and a registration made
  // before it is loaded would be scoped to file 0 whatever line it is on.
  for (i32 i = 0; i < starts.len(); i++) {
    if (starts[i] == 0) { continue; }
    env.fileFirstLine[env.fileCount] = starts[i];
    env.fileCount = env.fileCount + 1;
  }
  for (i32 e = 0; e < edges[0]; e++) {
    if (env.importCount >= env.importFrom.len()) { continue; }
    env.importFrom[env.importCount] = edges[e * 2 + 1];
    env.importTo[env.importCount] = edges[e * 2 + 2];
    string pair = e < names.len() ? names[e] : "";
    i32 sp = pair.indexOf(" ");
    env.importNames[env.importCount] = sp < 0 ? pair : pair.slice(0, sp);
    env.importDecls[env.importCount] = sp < 0 ? pair : pair.slice(sp + 1, pair.len());
    env.importCount = env.importCount + 1;
  }
  collectDeclarations(env, src, lexed, prog);
  assignGlobals(env, src, lexed);
  if (env.full) { return "more declarations than this emitter has room for"; }

  // **The same fixed point the emitter runs, because the answer has to be the same.** This walked
  // every declaration once and the emitter settles to a fixed point, so a function declined only
  // because something it *calls* was declined — round two and after — was dropped from the module
  // while this reported nothing wrong. That is `issues/lang/0090`: 29 of the 335 files rung 4 called
  // whole were missing an export, and the report could not have said so, because the two paths were
  // answering with different algorithms.
  settleEmittable(env, src, lexed, prog);
  // **A full table first, and by name.** Everything below reports what a *declaration* needs; when a
  // table ran out, every one of those is a consequence, and the chain that comes back describes the
  // seventh call rather than the reason. `packages/box` read as "a call to boxApplet, declined: …"
  // six levels deep, and as "an import of a file that was not supplied" before that [issue 0106].
  if (env.full) { return env.fullWhy; }
  string declined = declinedExport(env, src, lexed, prog);
  if (declined != "") { return declined; }

  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case Func(nameTok, returnType, params, body, exported, typeParams): {
        // A generic function is a **template**, and a template emits nothing: `mapOption<T, U>` is
        // not a function until its arguments say which one. Declining the declaration declined every
        // file that merely imports the file it lives in — which is most of `std`'s consumers, none
        // of which call it.
        if (typeParams.len() > 0) { continue; }
        canEmit(src, lexed, env, params, body, "", typeOfTyName(env, src, lexed, returnType));
      }
      case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        // A **template emits nothing** — `Vec<T>` is not a type. Its instances are structs of
        // their own and their methods functions like any other, so there is nothing to refuse here.
        if (typeParams.len() > 0) { continue; }
        string owner = nameKeyOf(env, src, lexed, nameTok);
        for (i32 m = 0; m < methods.len(); m++) {
          canEmit(src, lexed, env, methods[m].params, methods[m].body,
                  methods[m].hasThis ? owner : "",
                  typeOfTyName(env, src, lexed, methods[m].returnType));
        }
      }
      // An enum itself emits nothing — it is a type, and its declaration is what registered it. What
      // can still stop it is a **method**, which would be a function this pass never registered, and
      // a type parameter, which nothing here does.
      // An enum itself emits nothing — it is a type, and its declaration is what registered it. The
      // arm must not answer `""` for the whole module: this loop reports the *first* thing that
      // stops it, so returning "nothing wrong here" ends the scan before the functions are asked,
      // and the module then comes back empty while the report says it is whole.
      case EnumDecl(nameTok, variants, exported, methods, typeParams): {
        // A template emits nothing; its instances are enums of their own.
        if (typeParams.len() > 0) { continue; }
      }
      // An import is only a blocker when nothing resolved it. Linked, the names it brings in are
      // already in the pool — except a capability import, which names no file and would be a wasm
      // import of something this emitter has no way to supply.
      case Import(pathTok, prefixTok, items): {
        if (entryDecls < 0) { return "an import"; }
        // `core` is carried by the linker; anything else with a bare specifier is a module this
        // compiler has never heard of, which is worth saying by name.
        if (prefixTok >= 0 && tokenTextOf(src, lexed, prefixTok) != "core") {
          return "an import from " + tokenTextOf(src, lexed, prefixTok);
        }
      }
      case ConstDecl(nameTok, type, init, exported): {
        string ct = typeOfTyName(env, src, lexed, type);
        if (isArrayType(ct) || env.isStructName(ct)) {
          i32 ci = env.constAt(tokenTextOf(src, lexed, nameTok));
          if (ci < 0 || env.constGlobal[ci] < 0) {
            return "a constant whose value is not a constant expression";
          }
        }
      }
    }
    if (env.blocked != "") { return env.blocked; }
  }
  // Asked last, because it is discovered by the walk above rather than before it: a name only turns
  // out to be a guess when something reaches for it.
  if (env.ambiguous) { return "the name " + env.ambiguousName + ", which more than one file declares"; }
  if (env.full) { return "more declarations than this emitter has room for"; }
  if (env.blocked == "" && grewTypesWhileEmitting(src, entryDecls, starts, edges, names)) {
    return "a type this emitter names only while emitting";
  }
  return env.blocked;
}

/**
 * Everything the module knows before a single instruction is written: structs and their fields,
 * functions and methods with their signatures, and every array type any of them names.
 *
 * Three passes in one place, because all three answer questions the *next* one asks — a method's
 * receiver is a struct, an array type can be named by a field, and a call site has only a name.
 * Extracted so `emitBlocked` can ask the same questions without emitting anything.
 */
/**
 * Register the members of every instantiation, until naming one stops naming another.
 *
 * A template is compiled once per instantiation, so this is where `Vec<i32>` becomes a struct with
 * an `i32[] data` and a `Vec<i32>.push`. It is a fixed point because a field can name one: a
 * `Map<string, Vec<i32>>` names a `Vec<i32>` that nothing else in the module mentions.
 *
 * **The order it registers in is the order every other loop must walk**, since a function's index is
 * its position in this table and nothing else.
 */
void collectInstances(Env env, u8[] src, Lexed lexed, Program prog) {
  for (i32 round = 0; round < 8; round++) {
    env.instDirty = false;
    env.instBuilt = false;
    // **Every body, walked the way the emitter walks it.** A call to a generic function is the only
    // instance nothing declares, and its arguments are *locals* — so the walk that finds it has to be
    // one that has locals in scope, which is `canEmit` and not the array-type pre-pass. It runs here
    // rather than later because a function counted before its instance exists is one whose index
    // nobody reserved: the answer is thrown away and the registration it caused is the point.
    // **Its verdict is discarded, and so is what it recorded.** This walk runs while half the
    // instances do not exist yet, so what stops it here says nothing about the program — and
    // `canEmit` remembers the first thing that stopped it for the report. Keeping that would name a
    // round-zero shortage as the reason a file was not emitted.
    string savedBlocked = env.blocked;
    for (i32 d = 0; d < prog.decls.len(); d++) {
      match (prog.decls[d].kind) {
        case Func(nameTok, returnType, params, body, exported, typeParams): {
          if (typeParams.len() > 0) { continue; }
          canEmit(src, lexed, env, params, body, "", typeOfTyName(env, src, lexed, returnType));
        }
        case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
          if (typeParams.len() > 0) { continue; }
          string sowner = nameKeyOf(env, src, lexed, nameTok);
          for (i32 m = 0; m < methods.len(); m++) {
            canEmit(src, lexed, env, methods[m].params, methods[m].body,
                    methods[m].hasThis ? sowner : "",
                    typeOfTyName(env, src, lexed, methods[m].returnType));
          }
        }
        else: { }
      }
    }
    env.blocked = savedBlocked;
    for (i32 i = 0; i < env.instCount; i++) {
      string inst = env.instName[i];
      if (env.isStructName(inst)) { continue; }
      for (i32 d = 0; d < prog.decls.len(); d++) {
        match (prog.decls[d].kind) {
          case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
            if (typeParams.len() == 0) { continue; }
            if (tokenTextOf(src, lexed, nameTok) != env.instOf[i]) { continue; }
            i32 pushed = pushSubstitution(env, src, lexed, typeParams, inst, env.instOf[i]);
            if (env.structCount >= env.structNames.len()) { env.ranOut("structs"); }
            if (env.structCount < env.structNames.len()) {
              env.structNames[env.structCount] = inst;
              env.structParentToks[env.structCount] = -1;
              env.structParents[env.structCount] = "";
              env.structCount = env.structCount + 1;
            }
            for (i32 f = 0; f < fields.len(); f++) {
              if (env.fieldCount >= env.fieldNames.len()) {
                env.ranOut("struct fields");
                break;
              }
              env.fieldOwners[env.fieldCount] = inst;
              env.fieldNames[env.fieldCount] = tokenTextOf(src, lexed, fields[f].nameTok);
              env.fieldTypes[env.fieldCount] = typeOfTyName(env, src, lexed, fields[f].type);
              env.fieldNullable[env.fieldCount] = isNullableTy(fields[f].type);
              env.fieldCount = env.fieldCount + 1;
            }
            for (i32 m = 0; m < methods.len(); m++) {
              string[] mpts = string[methods[m].params.len()]();
              for (i32 a = 0; a < methods[m].params.len(); a++) {
                mpts[a] = typeOfTyName(env, src, lexed, methods[m].params[a].type);
              }
              // **The body too, under this substitution.** A template's method names types that
              // exist only once its arguments are known — `Vec<i32>.push` names `i32[]` — and a
              // type first named while that method is being emitted is one the section was already
              // written without.
              collectArrayTypesIn(env, src, lexed, methods[m].params, methods[m].body);
              env.addFunc(inst + "." + tokenTextOf(src, lexed, methods[m].nameTok),
                          typeOfTyName(env, src, lexed, methods[m].returnType), mpts);
              // **The receiver, which this site did not record.** `addFunc` keeps only the declared
              // parameters and `funcRecv` holds the receiver, so a generic instance's method looked
              // like a free function to everything reading those tables — including `signatureOf`,
              // which is what a reference to a method is built from.
              env.funcRecv[env.funcCount - 1] = methods[m].hasThis ? inst : "";
              string savedM = env.blocked;
              canEmit(src, lexed, env, methods[m].params, methods[m].body,
                      methods[m].hasThis ? inst : "",
                      typeOfTyName(env, src, lexed, methods[m].returnType));
              env.blocked = savedM;
            }
            env.instBuilt = true;
            popSubstitution(env, pushed);
          }
          // A generic **function**. It has no type of its own to build — only a body to compile once
          // per binding — so registering it is registering *one function* under the instance's name,
          // with its parameters and return type resolved under the substitution the name carries.
          case Func(nameTok, returnType, params, body, exported, typeParams): {
            if (typeParams.len() == 0) { continue; }
            if (tokenTextOf(src, lexed, nameTok) != env.instOf[i]) { continue; }
            if (env.funcAt(inst) >= 0) { continue; }
            i32 fpushed = pushSubstitution(env, src, lexed, typeParams, inst, env.instOf[i]);
            string[] fpts = string[params.len()]();
            for (i32 a = 0; a < params.len(); a++) {
              fpts[a] = typeOfTyName(env, src, lexed, params[a].type);
              registerNamed(env, fpts[a]);
            }
            string frt = typeOfTyName(env, src, lexed, returnType);
            registerNamed(env, frt);
            collectArrayTypesIn(env, src, lexed, params, body);
            env.addFunc(inst, frt, fpts);
            env.instBuilt = true;
            // **The instance's own body, walked with its parameters in scope.** A generic function
            // that calls a generic function names an instance whose arguments are its own locals —
            // `twice<T>` calling `ident(x)` is `ident<T>` under this substitution — and a walk
            // without locals types `x` as nothing and infers nothing. The verdict is discarded; the
            // instances it discovers are the point.
            string savedB = env.blocked;
            canEmit(src, lexed, env, params, body, "", frt);
            env.blocked = savedB;
            popSubstitution(env, fpushed);
          }
          // A generic **enum** — `Option<T>` — laid out exactly as a plain one is: a tag, then a
          // slot per payload field of every variant. Its variants are registered under the
          // instance's own name, since `Some` belongs to `Option<i32>` and to `Option<string>` and
          // they are not the same variant.
          case EnumDecl(nameTok, variants, exported, methods, typeParams): {
            if (typeParams.len() == 0) { continue; }
            if (tokenTextOf(src, lexed, nameTok) != env.instOf[i]) { continue; }
            i32 epushed = pushSubstitution(env, src, lexed, typeParams, inst, env.instOf[i]);
            if (env.structCount >= env.structNames.len()) { env.ranOut("structs"); }
            if (env.structCount < env.structNames.len()) {
              env.structNames[env.structCount] = inst;
              env.structParentToks[env.structCount] = -1;
              env.structParents[env.structCount] = "";
              env.structCount = env.structCount + 1;
            }
            if (env.fieldCount >= env.fieldNames.len()) { env.ranOut("struct fields"); }
            if (env.fieldCount < env.fieldNames.len()) {
              env.fieldOwners[env.fieldCount] = inst;
              env.fieldNames[env.fieldCount] = " tag";
              env.fieldTypes[env.fieldCount] = "i32";
              env.fieldNullable[env.fieldCount] = false;
              env.fieldCount = env.fieldCount + 1;
            }
            i32 eslot = 1;
            for (i32 v = 0; v < variants.len(); v++) {
              string vname = inst + "." + tokenTextOf(src, lexed, variants[v].nameTok);
              if (env.variantCount >= env.variantNames.len()) { env.ranOut("enum variants"); }
              if (env.variantCount < env.variantNames.len()) {
                env.variantNames[env.variantCount] = vname;
                env.variantOwners[env.variantCount] = inst;
                env.variantTags[env.variantCount] = v;
                env.variantSlot[env.variantCount] = eslot;
                env.variantArity[env.variantCount] = variants[v].fields.len();
                env.variantCount = env.variantCount + 1;
              }
              for (i32 fi = 0; fi < variants[v].fields.len(); fi++) {
                if (env.fieldCount >= env.fieldNames.len()) {
                  env.ranOut("struct fields");
                  break;
                }
                env.fieldOwners[env.fieldCount] = inst;
                env.fieldNames[env.fieldCount] = vname + "." +
                  tokenTextOf(src, lexed, variants[v].fields[fi].nameTok);
                env.fieldTypes[env.fieldCount] =
                  typeOfTyName(env, src, lexed, variants[v].fields[fi].type);
                env.fieldCount = env.fieldCount + 1;
              }
              eslot = eslot + variants[v].fields.len();
            }
            for (i32 m = 0; m < methods.len(); m++) {
              string[] empts = string[methods[m].params.len()]();
              for (i32 a = 0; a < methods[m].params.len(); a++) {
                empts[a] = typeOfTyName(env, src, lexed, methods[m].params[a].type);
              }
              // **The body too, under this substitution.** A template's method names types that
              // exist only once its arguments are known — `Vec<i32>.push` names `i32[]` — and a
              // type first named while that method is being emitted is one the section was already
              // written without.
              collectArrayTypesIn(env, src, lexed, methods[m].params, methods[m].body);
              env.addFunc(inst + "." + tokenTextOf(src, lexed, methods[m].nameTok),
                          typeOfTyName(env, src, lexed, methods[m].returnType), empts);
              // The receiver, as at the struct-instance site above: `funcRecv` is where it lives, and
              // a method missing it reads as a free function to everything that walks these tables.
              env.funcRecv[env.funcCount - 1] = methods[m].hasThis ? inst : "";
              env.instBuilt = true;
            }
            popSubstitution(env, epushed);
          }
          else: { }
        }
      }
    }
    // **Building one counts as progress.** A body walked in the round before an instance existed
    // stops at the first thing it cannot resolve, so the call further down it — the only place a
    // generic *function*'s instance is ever named — is not reached until the round after. Leaving on
    // "no new instance was named" therefore left on the round that could not have named one.
    if (!env.instDirty && !env.instBuilt) { return; }
    env.instBuilt = false;
  }
  // Eight rounds and still finding new ones: rather than emit a module built from half a table, say
  // so — `full` is the flag every other table overflow already sets.
  env.ranOut("a table this emitter keeps");
}

/**
 * Walk a function body for the types it names, **with the function's own parameters in scope**.
 *
 * These pre-passes run before anything has locals, and `keyAt` reads a bare name as a module-level
 * one when nothing says otherwise — so `write(bytes)` inside a function whose parameter is called
 * `write` was resolved against the whole module. Two files declaring a `write` then made the name
 * ambiguous, and an ambiguous name stops the *module*, not the expression: `packages/box` emitted
 * eight bytes because one of its 178 files takes a `write` callback [issue 0106].
 *
 * `canEmit` already does exactly this before its own walk. Same reason, same shape.
 */
void collectArrayTypesIn(Env env, u8[] src, Lexed lexed, Param[] params, Stmt[] body) {
  i32 saved = env.localCount;
  for (i32 i = 0; i < params.len(); i++) {
    env.addLocal(tokenTextOf(src, lexed, params[i].nameTok),
                 typeOfTyName(env, src, lexed, params[i].type));
  }
  collectArrayTypes(env, src, lexed, body);
  env.localCount = saved;
}

void collectDeclarations(Env env, u8[] src, Lexed lexed, Program prog) {
  // Kept, so a call to a generic function can read the declaration it names from wherever it is seen.
  env.prog = prog;
  // **A string literal names the `i8[]` type**, and nothing else in the file need mention it: a bare
  // `"hello".len()` declares no `string` anywhere. Scanning the tokens is complete by construction,
  // where walking declarations for it would be one more place to forget — which this pre-pass has
  // now been caught doing four times.
  for (i32 t = 0; t < lexed.tokenCount; t++) {
    if (lexed.tokens[t * tokenStride()] == kString()) {
      env.arrayType("i8[]");
      break;
    }
  }
  // **And a `string` used only as a type.** A module whose strings arrive as parameters has no string
  // *literal* anywhere, so the scan above never fires — and then the equality helper, which names
  // `i8[]`, is not emitted and `a == b` compiles to nothing at all. The type name is a plain
  // identifier, so this reads the text rather than a token kind.
  for (i32 t = 0; t < lexed.tokenCount; t++) {
    if (tokenTextOf(src, lexed, t) == "string") {
      env.arrayType("i8[]");
      break;
    }
  }
  // Structs first of all: their fields are what a construction and every access are about, and a
  // method's receiver type is one of them.
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        if (typeParams.len() > 0) { continue; }
        string sname = env.declare(tokenTextOf(src, lexed, nameTok), tokenLine(lexed, nameTok));
        if (env.structCount >= env.structNames.len()) { env.ranOut("structs"); }
        if (env.structCount < env.structNames.len()) {
          env.structNames[env.structCount] = sname;
          // The *token*, not the key: the parent may be declared further down this file, so the
          // name it resolves to is not known until every struct in the program has been declared.
          env.structParentToks[env.structCount] = parentTok;
          env.structParents[env.structCount] = "";
          env.structCount = env.structCount + 1;
        }
        for (i32 i = 0; i < fields.len(); i++) {
          // **A field this table has no room for is not a field it can do without.** `struct.new`
          // takes every field, so a truncated struct is a construction with the wrong arity — and
          // the byte stream desynchronises from there, which wasm reports as a nonsense heap type in
          // a function much further down.
          if (env.fieldCount >= env.fieldNames.len()) {
            env.ranOut("struct fields");
            break;
          }
          env.fieldOwners[env.fieldCount] = sname;
          env.fieldNames[env.fieldCount] = tokenTextOf(src, lexed, fields[i].nameTok);
          env.fieldTypes[env.fieldCount] = typeOfTyName(env, src, lexed, fields[i].type);
          env.fieldTys[env.fieldCount] = fields[i].type;
          env.fieldNullable[env.fieldCount] = isNullableTy(fields[i].type);
          env.fieldCount = env.fieldCount + 1;
        }
      }
      // **An enum is registered as a struct**, because that is what it becomes: slot 0 is the tag
      // and the rest are every variant's payload laid end to end. The slots are named `Variant.field`
      // — a spelling no wac identifier has, so a payload can share a name with a real field, and with
      // another variant's payload, without either being reachable by accident.
      case EnumDecl(nameTok, variants, exported, methods, typeParams): {
        if (typeParams.len() > 0) { continue; }
        string ename = env.declare(tokenTextOf(src, lexed, nameTok), tokenLine(lexed, nameTok));
        if (env.structCount >= env.structNames.len()) { env.ranOut("structs"); }
        if (env.structCount < env.structNames.len()) {
          env.structNames[env.structCount] = ename;
          env.structParentToks[env.structCount] = -1;
          env.structParents[env.structCount] = "";
          env.structCount = env.structCount + 1;
        }
        if (env.fieldCount >= env.fieldNames.len()) { env.ranOut("struct fields"); }
        if (env.fieldCount < env.fieldNames.len()) {
          env.fieldOwners[env.fieldCount] = ename;
          env.fieldNames[env.fieldCount] = " tag";
          env.fieldTypes[env.fieldCount] = "i32";
          env.fieldNullable[env.fieldCount] = false;
          env.fieldCount = env.fieldCount + 1;
        }
        i32 slot = 1;
        for (i32 v = 0; v < variants.len(); v++) {
          string vname = env.declare(tokenTextOf(src, lexed, variants[v].nameTok),
                                     tokenLine(lexed, variants[v].nameTok));
          if (env.variantCount >= env.variantNames.len()) { env.ranOut("enum variants"); }
          if (env.variantCount < env.variantNames.len()) {
            env.variantNames[env.variantCount] = vname;
            env.variantOwners[env.variantCount] = ename;
            env.variantTags[env.variantCount] = v;
            env.variantSlot[env.variantCount] = slot;
            env.variantArity[env.variantCount] = variants[v].fields.len();
            env.variantCount = env.variantCount + 1;
          }
          for (i32 i = 0; i < variants[v].fields.len(); i++) {
            if (env.fieldCount >= env.fieldNames.len()) {
              env.ranOut("struct fields");
              break;
            }
            env.fieldOwners[env.fieldCount] = ename;
            env.fieldNames[env.fieldCount] = vname + "." +
              tokenTextOf(src, lexed, variants[v].fields[i].nameTok);
            env.fieldTypes[env.fieldCount] = typeOfTyName(env, src, lexed, variants[v].fields[i].type);
            env.fieldNullable[env.fieldCount] = isNullableTy(variants[v].fields[i].type);
            env.fieldCount = env.fieldCount + 1;
          }
          slot = slot + variants[v].fields.len();
        }
      }
      else: { }
    }
  }

  // **Now** the parents can be named: every struct in the program is declared, so `Shape` resolves
  // to the same key whether it was written above its child or below it.
  for (i32 i = 0; i < env.structCount; i++) {
    if (env.structParentToks[i] < 0) { continue; }
    env.structParents[i] = nameKeyOf(env, src, lexed, env.structParentToks[i]);
  }
  // And the fields, for the same reason and with the same timing: a field written with a name this
  // file imported resolves only once the file it came from has been walked.
  for (i32 i = 0; i < env.fieldCount; i++) {
    if (env.fieldTys[i] is null) { continue; }
    env.fieldTypes[i] = typeOfTyName(env, src, lexed, env.fieldTys[i]!);
  }
  // **A supertype must be declared before its subtype**, and a rec group does not lift that: being
  // mutually visible is not the same as being defined, and wasm answers a child written first with
  // "invalid supertype" from the type section. A struct declares its parent by name and the source
  // may name it in either order, so the order is fixed here rather than required of the author.
  for (i32 pass = 0; pass < env.structCount; pass++) {
    bool moved = false;
    for (i32 i = 0; i < env.structCount; i++) {
      if (env.structParents[i] == "") { continue; }
      i32 pi = -1;
      for (i32 j = 0; j < env.structCount; j++) {
        if (env.structNames[j] == env.structParents[i]) { pi = j; }
      }
      if (pi <= i) { continue; }
      string tn = env.structNames[i];
      env.structNames[i] = env.structNames[pi];
      env.structNames[pi] = tn;
      string tp = env.structParents[i];
      env.structParents[i] = env.structParents[pi];
      env.structParents[pi] = tp;
      i32 tt = env.structParentToks[i];
      env.structParentToks[i] = env.structParentToks[pi];
      env.structParentToks[pi] = tt;
      moved = true;
    }
    if (!moved) { break; }
  }

  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case ConstDecl(nameTok, type, init, exported): {
        if (env.constCount >= env.constNames.len()) {
          env.ranOut("constants");
          continue;
        }
        string cname = env.declare(tokenTextOf(src, lexed, nameTok), tokenLine(lexed, nameTok));
        env.constNames[env.constCount] = cname;
        env.constGlobal[env.constCount] = -1;
        env.constTypes[env.constCount] = typeOfTyName(env, src, lexed, type);
        env.constInits[env.constCount] = init;
        env.constCount = env.constCount + 1;
      }
      else: { }
    }
  }

  // Function names first, over the whole file: a call names one declared elsewhere and often further
  // down, which is the same argument the checker makes for collecting signatures before bodies.
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case Func(nameTok, returnType, params, body, exported, typeParams): {
        if (typeParams.len() > 0) { continue; }
        string[] pts = string[params.len()]();
        for (i32 i = 0; i < params.len(); i++) { pts[i] = typeOfTyName(env, src, lexed, params[i].type); }
        string fname = env.declare(tokenTextOf(src, lexed, nameTok), tokenLine(lexed, nameTok));
        env.addFunc(fname, typeOfTyName(env, src, lexed, returnType), pts);
      }
      // A method is a function with the receiver as its first parameter — which is what the call site
      // does too, pushing the object before the arguments. Registered under `Struct.name` so a bare
      // function of the same name is a different entry.
      case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        if (typeParams.len() > 0) { continue; }
        string owner = nameKeyOf(env, src, lexed, nameTok);
        for (i32 i = 0; i < methods.len(); i++) {
          string[] mpts = string[methods[i].params.len()]();
          for (i32 j = 0; j < methods[i].params.len(); j++) {
            mpts[j] = typeOfTyName(env, src, lexed, methods[i].params[j].type);
          }
          env.addFunc(owner + "." + tokenTextOf(src, lexed, methods[i].nameTok),
                      typeOfTyName(env, src, lexed, methods[i].returnType), mpts);
          env.funcRecv[env.funcCount - 1] = methods[i].hasThis ? owner : "";
        }
      }
      // **An enum declares methods exactly as a struct does**, and this walk had no arm for it — so
      // `Kind.word` was a function nothing registered, and the emittability walk declined the file
      // with *a method on an enum* rather than emitting one. The instances of a *generic* enum have
      // had their methods emitted all along, which is what made the gap look like a missing feature
      // rather than a missing case. `spec/cases/0097`.
      case EnumDecl(nameTok, variants, exported, methods, typeParams): {
        if (typeParams.len() > 0) { continue; }
        string eowner = nameKeyOf(env, src, lexed, nameTok);
        for (i32 i = 0; i < methods.len(); i++) {
          string[] epts = string[methods[i].params.len()]();
          for (i32 j = 0; j < methods[i].params.len(); j++) {
            epts[j] = typeOfTyName(env, src, lexed, methods[i].params[j].type);
          }
          env.addFunc(eowner + "." + tokenTextOf(src, lexed, methods[i].nameTok),
                      typeOfTyName(env, src, lexed, methods[i].returnType), epts);
          env.funcRecv[env.funcCount - 1] = methods[i].hasThis ? eowner : "";
        }
      }
      else: { }
    }
  }


  // **Every type a body can name**, before anything is emitted: an instantiation written only as a
  // local's type is still one the module has to build. The array pre-pass walks the same ground
  // later and registering a type twice is free, which is why this can be the blunt version.
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case Func(nameTok, returnType, params, body, exported, typeParams): {
        if (typeParams.len() > 0) { continue; }
        collectArrayTypesIn(env, src, lexed, params, body);
      }
      case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        if (typeParams.len() > 0) { continue; }
        for (i32 m = 0; m < methods.len(); m++) {
          collectArrayTypesIn(env, src, lexed, methods[m].params, methods[m].body);
        }
      }
      else: { }
    }
  }
  collectInstances(env, src, lexed, prog);
}

/**
 * Which functions will be emitted, to a fixed point.
 *
 * A function is unemittable if it *contains* something unsupported — and a call to an unemittable
 * function is itself unsupported, so removing one can remove its callers, and removing those can
 * remove theirs. One pass is not enough and the dependency is not a tree: mutual recursion means the
 * only honest answer is to keep going until nothing changes.
 *
 * Assumes everything works and removes, rather than assuming nothing works and adding — because two
 * functions that call each other are both fine, and the optimistic direction says so while the
 * pessimistic one would never admit it.
 */
/**
 * An exported function the settling declined, named — or `""` when every export survived.
 *
 * The reason itself comes back from asking `canEmit` once more now that the fixed point has run:
 * it records what stopped it, and by this point that is the real answer rather than a round-zero
 * shortage. Only exports are asked about, because a private function that is declined and never
 * called costs the module nothing.
 */
string declinedExport(Env env, u8[] src, Lexed lexed, Program prog) {
  i32 at = 0;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case Func(nameTok, returnType, params, body, exported, typeParams): {
        if (typeParams.len() > 0) { continue; }
        if (exported && !env.funcOk[at]) {
          string was = env.blocked;
          env.blocked = "";
          canEmit(src, lexed, env, params, body, "", typeOfTyName(env, src, lexed, returnType));
          string why = env.blocked;
          env.blocked = was;
          return why == "" ? "an export it declined: " + tokenTextOf(src, lexed, nameTok)
                           : why;
        }
        at = at + 1;
      }
      case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        if (typeParams.len() > 0) { continue; }
        for (i32 m = 0; m < methods.len(); m++) { at = at + 1; }
      }
      else: { }
    }
  }
  return "";
}

void settleEmittable(Env env, u8[] src, Lexed lexed, Program prog) {
  for (i32 round = 0; round < 16; round++) {
    bool changed = false;
    i32 at = 0;
    for (i32 d = 0; d < prog.decls.len(); d++) {
      match (prog.decls[d].kind) {
        case Func(nameTok, returnType, params, body, exported, typeParams): {
          if (typeParams.len() > 0) { continue; }
          if (env.funcOk[at] &&
              !canEmit(src, lexed, env, params, body, "",
                       typeOfTyName(env, src, lexed, returnType))) {
            env.funcOk[at] = false;
            if (at < env.funcWhy.len()) { env.funcWhy[at] = env.lastWhy; }
            changed = true;
          }
          at = at + 1;
        }
        case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
          if (typeParams.len() > 0) { continue; }
          string owner = nameKeyOf(env, src, lexed, nameTok);
          for (i32 m = 0; m < methods.len(); m++) {
            if (env.funcOk[at] &&
                !canEmit(src, lexed, env, methods[m].params, methods[m].body,
                         methods[m].hasThis ? owner : "",
                         typeOfTyName(env, src, lexed, methods[m].returnType))) {
              env.funcOk[at] = false;
              if (at < env.funcWhy.len()) { env.funcWhy[at] = env.lastWhy; }
              changed = true;
            }
            at = at + 1;
          }
        }
        // **And an enum's, in the same place in the order.** `at` walks the function table, so an
        // arm that does not advance it does not merely skip a verdict: every function after it takes
        // somebody else's. Registration puts an enum's methods here, so this must too.
        case EnumDecl(nameTok, variants, exported, methods, typeParams): {
          if (typeParams.len() > 0) { continue; }
          string eowner = nameKeyOf(env, src, lexed, nameTok);
          for (i32 m = 0; m < methods.len(); m++) {
            if (env.funcOk[at] &&
                !canEmit(src, lexed, env, methods[m].params, methods[m].body,
                         methods[m].hasThis ? eowner : "",
                         typeOfTyName(env, src, lexed, methods[m].returnType))) {
              env.funcOk[at] = false;
              if (at < env.funcWhy.len()) { env.funcWhy[at] = env.lastWhy; }
              changed = true;
            }
            at = at + 1;
          }
        }
        else: { }
      }
    }
    for (i32 ii = 0; ii < env.instCount; ii++) {
    // **Only the ones registration built.** An instance discovered after the fixed point gave up —
    // or one whose template is not in this module — has no members in the tables, and emitting its
    // methods anyway shifts every index after it. The receiver comes out an `i32`, which wasm
    // reports as a `struct.get` on a number several functions later.
    // A function instance builds no type, so it is "built" when its own entry is registered.
  if (!env.isStructName(env.instName[ii]) && env.funcAt(env.instName[ii]) < 0) { continue; }
      for (i32 di = 0; di < prog.decls.len(); di++) {
        match (prog.decls[di].kind) {
          case EnumDecl(nameTok, variants, exported, methods, typeParams): {
            if (typeParams.len() == 0) { continue; }
            if (tokenTextOf(src, lexed, nameTok) != env.instOf[ii]) { continue; }
            i32 epushed = pushSubstitution(env, src, lexed, typeParams, env.instName[ii],
                                           env.instOf[ii]);
            for (i32 m = 0; m < methods.len(); m++) {
              if (env.funcOk[at] &&
                  !canEmit(src, lexed, env, methods[m].params, methods[m].body,
                           methods[m].hasThis ? env.instName[ii] : "",
                           typeOfTyName(env, src, lexed, methods[m].returnType))) {
                env.funcOk[at] = false;
                if (at < env.funcWhy.len()) { env.funcWhy[at] = env.lastWhy; }
                changed = true;
              }
              at = at + 1;
            }
            popSubstitution(env, epushed);
          }
          case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
            if (typeParams.len() == 0) { continue; }
            if (tokenTextOf(src, lexed, nameTok) != env.instOf[ii]) { continue; }
            i32 pushed = pushSubstitution(env, src, lexed, typeParams, env.instName[ii],
                                          env.instOf[ii]);
            for (i32 m = 0; m < methods.len(); m++) {
              if (env.funcOk[at] &&
                  !canEmit(src, lexed, env, methods[m].params, methods[m].body,
                           methods[m].hasThis ? env.instName[ii] : "",
                           typeOfTyName(env, src, lexed, methods[m].returnType))) {
                env.funcOk[at] = false;
                if (at < env.funcWhy.len()) { env.funcWhy[at] = env.lastWhy; }
                changed = true;
              }
              at = at + 1;
            }
            popSubstitution(env, pushed);
          }
          else: { }
        }
      }
    }
    if (!changed) { break; }
  }
  // The renumbering, once the set has stopped moving.
  // **Imports are numbered first**, so the first function this module defines is not index 0. Every
  // call, every export and every `ref.func` reads `funcIndex`, so saying it once here is the whole
  // of it — the helper blocks below are the only other arithmetic, and they gain the same term.
  i32 next = env.cbSigCount;
  for (i32 i = 0; i < env.funcCount; i++) {
    if (!env.funcOk[i]) { continue; }
    env.funcIndex[i] = next;
    next = next + 1;
  }
}

/**
 * An expression that must arrive as a particular type, converted if it does not.
 *
 * `emitExprAt` steers a *literal*, which has no type of its own. A typed expression ignores it and
 * arrives as itself — which is right almost everywhere and wrong exactly where an instruction demands
 * a width: an array index is an `i32` whatever the language allowed, and a shift's two operands must
 * agree even when wac let them differ.
 */
void emitAt(B fb, u8[] src, Lexed lexed, Env env, Expr e, string want) {
  string got = typeOfE(src, lexed, env, e);
  emitExprAt(fb, src, lexed, env, e, want);
  if (want == "" || got == "" || got == want) { return; }
  if (valType(got) == valType(want) && !isFloat(got)) { return; }
  emitConversion(fb, env, got, want, 0);
}

/**
 * The names of the functions in the module, in the order they were emitted.
 *
 * wasm reports a failure as *"compiling function #7"*, and #7 is an index into a list this emitter
 * builds and nobody else can see. Without this, diagnosing a corpus failure means guessing which
 * function of two hundred it was; with it, the index is a name.
 */
/** The emitted functions of a linked program, in order — the same answer for a file set. */
export string namesLinked(string[] paths, string[] sources, string entry) {
  i32[] starts = i32[512]();
  i32[] edges = i32[65536]();
  string[] names = string[32768]();
  string blob = linkFiles(paths, sources, entry, starts, edges, names, string[512]());
  return blob == "" ? "" : emitNamesOf(blob.toBytes(), starts, edges, names);
}

/** The single-file spelling, which has no file table and no imports to load. */
export string emitNames(u8[] src) {
  return emitNamesOf(src, i32[512](), i32[4096](), string[4096]());
}

/**
 * What each emitted function is called, in the order the module emits them.
 *
 * **The same preamble the emitter runs**, and it did not have it: this built its `Env` from the blob
 * alone, so every key was scoped to file 0 and `settleEmittable` declined a different set. The list
 * then disagreed with the module — twelve exported functions of the first forty corpus files were
 * missing from it outright — which matters because the only consumer of this is somebody holding a
 * wasm error that says *function #N*. It sent me to `hexOf` for a fault in `openRepo`.
 * `issues/lang/0097`.
 */
string emitNamesOf(u8[] src, i32[] starts, i32[] edges, string[] names) {
  Lexed lexed = lex(src);
  P p = P.create(src, lexed.tokens, lexed.tokenCount);
  Program prog = parseProgram(p);
  Env env = Env.create();
  for (i32 i = 0; i < starts.len(); i++) {
    if (starts[i] == 0) { continue; }
    env.fileFirstLine[env.fileCount] = starts[i];
    env.fileCount = env.fileCount + 1;
  }
  for (i32 e = 0; e < edges[0]; e++) {
    if (env.importCount >= env.importFrom.len()) { continue; }
    env.importFrom[env.importCount] = edges[e * 2 + 1];
    env.importTo[env.importCount] = edges[e * 2 + 2];
    string pair = e < names.len() ? names[e] : "";
    i32 sp = pair.indexOf(" ");
    env.importNames[env.importCount] = sp < 0 ? pair : pair.slice(0, sp);
    env.importDecls[env.importCount] = sp < 0 ? pair : pair.slice(sp + 1, pair.len());
    env.importCount = env.importCount + 1;
  }
  collectDeclarations(env, src, lexed, prog);
  assignGlobals(env, src, lexed);
  settleEmittable(env, src, lexed, prog);
  string out = "";
  for (i32 emitted = 0; emitted < env.funcCount; emitted++) {
    for (i32 i = 0; i < env.funcCount; i++) {
      if (env.funcIndex[i] != emitted) { continue; }
      out = out + env.funcs[i] + "\n";
    }
  }
  return out;
}

/**
 * Whether an expression is a **constant expression** in wasm's sense, which is much narrower than in
 * wac's.
 *
 * A global's initialiser runs before any function does, so it may only be built from instructions
 * that need no stack beyond their own operands and no locals at all: the four `const`s, and — because
 * this is a GC module — `array.new_fixed`, `array.new_default`, `array.new` and `struct.new` over
 * more of the same. `3 * 4` is *not* one, which is why scalars are inlined instead of given globals.
 */
bool isConstExpr(u8[] src, Lexed lexed, Env env, Expr e) {
  match (e.kind) {
    case IntLit(tok): { return true; }
    case FloatLit(tok): { return true; }
    case BoolLit(value): { return true; }
    // A string literal is `array.new_fixed` over its bytes, which *is* a constant expression — so a
    // `const string` can live in a global like any other array constant.
    case StrLit(tok): { return true; }
    case ArrNew(elem, size, fill, elements): {
      if (typeOfTyName(env, src, lexed, elem) == "") { return false; }
      for (i32 i = 0; i < elements.len(); i++) {
        if (!isConstExpr(src, lexed, env, elements[i])) { return false; }
      }
      if (!(fill is null)) {
        if (!isConstExpr(src, lexed, env, fill!)) { return false; }
      }
      if (!(size is null)) {
        if (!isConstExpr(src, lexed, env, size!)) { return false; }
      }
      return true;
    }
    case Construct(ctype, args, named): {
      for (i32 i = 0; i < named.len(); i++) {
        if (!isConstExpr(src, lexed, env, named[i].value)) { return false; }
      }
      match (ctype.kind) {
        case Named(tok, typeArgs): {
          if (!env.isStructName(tokenTextOf(src, lexed, tok))) { return false; }
        }
        else: { return false; }
      }
      for (i32 i = 0; i < args.len(); i++) {
        if (!isConstExpr(src, lexed, env, args[i])) { return false; }
      }
      return true;
    }
    else: { return false; }
  }
}

/**
 * Give a global to every constant that has identity and can have one.
 *
 * Identity is the test, not size: a scalar is substituted because two copies of `7` are the same
 * seven, and an array is not because two arrays are two arrays. A constant that wants a global and
 * whose initialiser is not a constant expression gets neither — it is declined by name, which is the
 * only honest answer when the language allows something the format does not.
 */
/**
 * Whether any constant has to be filled in at instantiation rather than declared with its value.
 *
 * `const u8[] TAG = "x".toBytes();` is a constant in wac and a *call* in wasm, and a call is not a
 * constant expression. The global exists either way; this asks whether something has to run to put
 * a value in it.
 */
bool needsStartFunction(Env env, u8[] src, Lexed lexed) {
  for (i32 i = 0; i < env.constCount; i++) {
    if (env.constGlobal[i] < 0) { continue; }
    if (env.constInits[i] is null) { continue; }
    if (!isConstExpr(src, lexed, env, env.constInits[i]!)) { return true; }
  }
  return false;
}

/**
 * The function that assigns them, run by wasm's `start` section at instantiation.
 *
 * In declaration order, which is the order a file reads and the order one constant may refer to
 * another in.
 */
void emitStartFunction(B funcs, B code, u8[] src, Lexed lexed, Env env, i32 index, i32 declTypes) {
  funcs.u32leb(env.sigType("fn[void()]"));

  B insns = B.create();
  for (i32 i = 0; i < env.constCount; i++) {
    if (env.constGlobal[i] < 0) { continue; }
    if (env.constInits[i] is null) { continue; }
    if (isConstExpr(src, lexed, env, env.constInits[i]!)) { continue; }
    emitExprAt(insns, src, lexed, env, env.constInits[i]!, env.constTypes[i]);
    insns.byte(36);   // global.set
    insns.u32leb(env.constGlobal[i]);
  }

  B fb = B.create();
  // The locals declaration, which is where `scratch` ends up if an initialiser needed one — so the
  // body is built first and the header written around it, as every other function here is.
  i32 extra = env.localCount - env.paramCount;
  fb.u32leb(extra);
  for (i32 i = env.paramCount; i < env.localCount; i++) {
    fb.u32leb(1);
    writeValType(fb, env, env.localTypes[i]);
  }
  fb.bytes(insns);
  fb.byte(11);
  code.u32leb(fb.len);
  code.bytes(fb);
}

void assignGlobals(Env env, u8[] src, Lexed lexed) {
  // **Global 0 is the counter array** when instrumenting, so a constant's global starts at one.
  i32 next = env.coverage ? 1 : 0;
  for (i32 i = 0; i < env.constCount; i++) {
    string t = env.constTypes[i];
    if (!isArrayType(t) && !env.isStructName(t)) { continue; }
    if (env.constInits[i] is null) { continue; }
    // **Not only the constant expressions.** wasm's sense of one is far narrower than wac's — no
    // arithmetic, no call, no concatenation — and a constant it cannot express is not a constant it
    // cannot *have*: the global is declared mutable and assigned at instantiation instead. What
    // still has to hold is that the initialiser is an expression this emitter can emit at all.
    if (unsupportedValueAt(src, lexed, env, env.constInits[i]!, env.constTypes[i]) != "") { continue; }
    env.constGlobal[i] = next;
    next = next + 1;
  }
}

/** Every array type an expression constructs, which a constant's initialiser can do at module level. */
void collectArrayTypesOfExpr(Env env, u8[] src, Lexed lexed, Expr e) {
  match (e.kind) {
    case ArrNew(elem, size, fill, elements): {
      string t = typeOfTyName(env, src, lexed, elem);
      if (t != "") { registerNamed(env, t + "[]"); }
      for (i32 i = 0; i < elements.len(); i++) {
        collectArrayTypesOfExpr(env, src, lexed, elements[i]);
      }
      if (!(fill is null)) { collectArrayTypesOfExpr(env, src, lexed, fill!); }
      if (!(size is null)) { collectArrayTypesOfExpr(env, src, lexed, size!); }
    }
    // **A construction names its type**, and `Vec<i32>(…)` names an instantiation nothing else in
    // the file has to mention. Registering it here is what stops the type table growing while the
    // section that declares it is being written.
    case Construct(ctype, args, named): {
      // **A call to a generic function is registered on sight**, exactly as a generic type written
      // in the source is — the difference being that nothing here is written, so the instance has to
      // be inferred from what the arguments turned out to be.
      match (ctype.kind) {
        case Named(tok, typeArgs): {
          if (typeArgs.len() == 0) {
            string gi = genericCallInstance(env, src, lexed, tok, args);
            if (gi != "") { env.instantiate(gi, tokenTextOf(src, lexed, tok)); }
          }
        }
        else: { }
      }
      registerNamed(env, typeOfTyName(env, src, lexed, ctype));
      for (i32 i = 0; i < args.len(); i++) { collectArrayTypesOfExpr(env, src, lexed, args[i]); }
      for (i32 i = 0; i < named.len(); i++) {
        collectArrayTypesOfExpr(env, src, lexed, named[i].value);
      }
    }
    case Cast(op, operand, target): {
      registerNamed(env, typeOfTyName(env, src, lexed, target));
      collectArrayTypesOfExpr(env, src, lexed, operand);
    }
    case Is(left, target, other, negated): {
      if (!(target is null)) { registerNamed(env, typeOfTyName(env, src, lexed, target!)); }
      collectArrayTypesOfExpr(env, src, lexed, left);
      if (!(other is null)) { collectArrayTypesOfExpr(env, src, lexed, other!); }
    }
    case Call(callee, args): {
      collectArrayTypesOfExpr(env, src, lexed, callee);
      for (i32 i = 0; i < args.len(); i++) { collectArrayTypesOfExpr(env, src, lexed, args[i]); }
    }
    case Member(obj, nameTok): { collectArrayTypesOfExpr(env, src, lexed, obj); }
    case Index(arr, index): {
      collectArrayTypesOfExpr(env, src, lexed, arr);
      collectArrayTypesOfExpr(env, src, lexed, index);
    }
    case Unary(op, operand): { collectArrayTypesOfExpr(env, src, lexed, operand); }
    case Unwrap(operand): { collectArrayTypesOfExpr(env, src, lexed, operand); }
    case Binary(op, left, right): {
      collectArrayTypesOfExpr(env, src, lexed, left);
      collectArrayTypesOfExpr(env, src, lexed, right);
    }
    case Ternary(cond, then, els): {
      collectArrayTypesOfExpr(env, src, lexed, cond);
      collectArrayTypesOfExpr(env, src, lexed, then);
      collectArrayTypesOfExpr(env, src, lexed, els);
    }
    case MatchExpr(subject, arms): {
      collectArrayTypesOfExpr(env, src, lexed, subject);
      for (i32 a = 0; a < arms.len(); a++) {
        if (arms[a].value is null) { continue; }
        collectArrayTypesOfExpr(env, src, lexed, arms[a].value!);
      }
    }
    else: { }
  }
}

/** A one-word name for an expression kind, so a decline says *what* rather than merely *that*. */
string kindOfExpr(Expr e) {
  match (e.kind) {
    case IntLit(tok): { return "int literal"; }
    case FloatLit(tok): { return "float literal"; }
    case StrLit(tok): { return "string literal"; }
    case Jsx(tagTok, closeTok, attrs, kids): { return "JSX element"; }
    case JsxText(startOff, endOff): { return "JSX text"; }
    case BoolLit(value): { return "bool literal"; }
    case NullLit: { return "null"; }
    case Ident(tok): { return "name"; }
    case Unary(op, operand): { return "unary"; }
    case Binary(op, left, right): { return "binary"; }
    case Cast(op, operand, target): { return "cast"; }
    case Ternary(cond, then, els): { return "ternary"; }
    case Index(arr, index): { return "index"; }
    case Member(obj, nameTok): { return "member"; }
    case Call(callee, args): { return "call"; }
    case Construct(ctype, args, named): { return "construct"; }
    case ArrNew(elem, size, fill, elements): { return "array"; }
    case Unwrap(operand): { return "unwrap"; }
    case Is(left, target, other, negated): { return "is"; }
    case Incr(target, op, prefix): { return "incr"; }
    case MatchExpr(subject, arms): { return "match"; }
  }
}

/**
 * The struct a receiver names, when the receiver is a **type** rather than a value.
 *
 * `Big.create(…)` and `b.create(…)` are the same syntax and differ only in this, which is the fork
 * the checker makes too — and the scope is consulted first for the same reason: a local called `Big`
 * is a value, and shadowing wins.
 */
string staticOwner(u8[] src, Lexed lexed, Env env, Expr obj) {
  match (obj.kind) {
    case Ident(tok): {
      string raw = tokenTextOf(src, lexed, tok);
      if (env.localAt(raw) >= 0) { return ""; }
      string n = nameKeyOf(env, src, lexed, tok);
      if (env.constAt(n) >= 0) { return ""; }
      return env.isStructName(n) ? n : "";
    }
    else: { return ""; }
  }
}

/**
 * A name declared twice at **different types**, or `""`.
 *
 * Two `for (i32 i = …)` loops in sequence declare `i` twice and are perfectly safe: both slots are
 * `i32`, so whichever the lookup returns is well-typed. Declining those refused six corpus files and
 * a test of this emitter's own. It is the *type* that cannot be shared, not the name.
 *
 * What this still does not catch is two same-typed locals of one name whose live ranges **overlap** —
 * a nested shadow. That is a semantic error rather than a validation one, so it survives the module
 * check; it wants a scope stack, which this slice has not got, and is named here rather than fixed.
 */
string duplicateLocal(Env env) {
  for (i32 i = 0; i < env.localCount; i++) {
    for (i32 j = i + 1; j < env.localCount; j++) {
      if (env.locals[i] == env.locals[j] && env.localTypes[i] != env.localTypes[j]) {
        return env.locals[i];
      }
    }
  }
  return "";
}

/**
 * A string literal's bytes, with the quotes dropped and the escapes resolved.
 *
 * Only the four this repository's own sources use — `\\n`, `\\t`, `\\\\`, `\\"` — because an escape
 * this does not know would be emitted as its own two characters, which is a wrong string rather than
 * a missing feature. Anything else declines the literal instead.
 */
export u8[] stringLiteralBytes(u8[] src, Lexed lexed, i32 tok) {
  i32 start = lexed.tokens[tok * tokenStride() + 1];
  i32 len = lexed.tokens[tok * tokenStride() + 2];
  u8[] out = u8[len]();
  i32 n = 0;
  i32 i = start + 1;
  i32 end = start + len - 1;
  while (i < end) {
    if (src[i] == 92 && i + 1 < end) {
      i32 c = src[i + 1];
      if (c == 110) { out[n] = 10; }
      else if (c == 116) { out[n] = 9; }
      else if (c == 114) { out[n] = 13; }
      else if (c == 48) { out[n] = 0; }
      else { out[n] = c; }
      n = n + 1;
      i = i + 2;
      continue;
    }
    out[n] = src[i];
    n = n + 1;
    i = i + 1;
  }
  u8[] exact = u8[n]();
  for (i32 k = 0; k < n; k++) { exact[k] = out[k]; }
  return exact;
}

/** Whether a string literal uses only escapes this emitter resolves the same way the language does. */
bool knownEscapes(u8[] src, Lexed lexed, i32 tok) {
  i32 start = lexed.tokens[tok * tokenStride() + 1];
  i32 end = start + lexed.tokens[tok * tokenStride() + 2] - 1;
  i32 i = start + 1;
  while (i < end) {
    if (src[i] != 92) { i = i + 1; continue; }
    if (i + 1 >= end) { return false; }
    i32 c = src[i + 1];
    bool ok = c == 110 || c == 116 || c == 114 || c == 48 || c == 92 || c == 34 || c == 39;
    if (!ok) { return false; }
    i = i + 2;
  }
  return true;
}

/**
 * `bool str_eq(string a, string b)`, written instruction by instruction.
 *
 * The first function this emitter **synthesizes**: nothing in the source declares it, and `a == b` on
 * two strings compiles to a call to it. wac's `==` on strings compares *contents*, and wasm has no
 * instruction for that — the reference generates the same helper, which is why its modules contain a
 * `__str_cmp` nobody wrote.
 *
 * The shape is a length check, then a loop comparing bytes:
 *
 *     if (a.len != b.len) return false
 *     i = 0
 *     while (i < a.len) { if (a[i] != b[i]) return false; i = i + 1 }
 *     return true
 *
 * Two parameters and one local, and the local is why the body is written after the header rather than
 * before: the count has to be known, which is the same reason a section is built apart and spliced.
 */
void emitStringEquals(B types, B funcs, B code, Env env, i32 index, i32 declTypes) {
  i32 at = env.arrayType("i8[]");

  funcs.u32leb(env.sigType("fn[bool(string,string)]"));

  B b = B.create();
  b.u32leb(1);
  b.u32leb(1);
  b.byte(127);       // one i32 local: the cursor

  // Lengths differ -> false.
  b.byte(32); b.u32leb(0); b.byte(251); b.u32leb(15);
  b.byte(32); b.u32leb(1); b.byte(251); b.u32leb(15);
  b.byte(71);        // i32.ne
  b.byte(4); b.byte(64);
  b.byte(65); b.i32leb(0);
  b.byte(15);
  b.byte(11);

  b.byte(65); b.i32leb(0);
  b.byte(33); b.u32leb(2);

  b.byte(2); b.byte(64);   // block
  b.byte(3); b.byte(64);   // loop
  // Past the end -> true.
  b.byte(32); b.u32leb(2);
  b.byte(32); b.u32leb(0); b.byte(251); b.u32leb(15);
  b.byte(72);        // i32.lt_s
  b.byte(69);        // i32.eqz
  b.byte(13); b.u32leb(1);
  // A byte differs -> false.
  b.byte(32); b.u32leb(0); b.byte(32); b.u32leb(2); b.byte(251); b.u32leb(12); b.u32leb(at);
  b.byte(32); b.u32leb(1); b.byte(32); b.u32leb(2); b.byte(251); b.u32leb(12); b.u32leb(at);
  b.byte(71);        // i32.ne
  b.byte(4); b.byte(64);
  b.byte(65); b.i32leb(0);
  b.byte(15);
  b.byte(11);
  b.byte(32); b.u32leb(2); b.byte(65); b.i32leb(1); b.byte(106);
  b.byte(33); b.u32leb(2);
  b.byte(12); b.u32leb(0);
  b.byte(11);
  b.byte(11);

  b.byte(65); b.i32leb(1);
  b.byte(11);        // end
  code.u32leb(b.len);
  code.bytes(b);
}

/** Whether the module declared the `i8[]` type, which is what a string is represented by. */
bool hasStringType(Env env) {
  for (i32 i = 0; i < env.arrayCount; i++) {
    if (env.arrayTypes[i] == "i8[]") { return true; }
  }
  return false;
}

/**
 * `string str_concat(string a, string b)` — allocate the total, copy both halves in.
 *
 * `array.copy` does the copying in one instruction rather than a loop, which is the difference
 * between fifteen instructions and fifty. It pops five operands — destination, destination offset,
 * source, source offset, length — and its immediates are the two array *types*, which here are the
 * same one.
 */
void emitStringConcat(B types, B funcs, B code, Env env, i32 index, i32 declTypes) {
  i32 at = env.arrayType("i8[]");

  funcs.u32leb(env.sigType("fn[string(string,string)]"));

  B b = B.create();
  b.u32leb(2);
  b.u32leb(1); b.byte(127);              // local 2: the joined length
  b.u32leb(1); b.byte(99); b.i32leb(at); // local 3: the result

  // n = a.len + b.len
  b.byte(32); b.u32leb(0); b.byte(251); b.u32leb(15);
  b.byte(32); b.u32leb(1); b.byte(251); b.u32leb(15);
  b.byte(106);
  b.byte(33); b.u32leb(2);
  // out = i8[n]()
  b.byte(32); b.u32leb(2);
  b.byte(251); b.u32leb(7); b.u32leb(at);
  b.byte(33); b.u32leb(3);
  // out[0..a.len] = a
  b.byte(32); b.u32leb(3);
  b.byte(65); b.i32leb(0);
  b.byte(32); b.u32leb(0);
  b.byte(65); b.i32leb(0);
  b.byte(32); b.u32leb(0); b.byte(251); b.u32leb(15);
  b.byte(251); b.u32leb(17); b.u32leb(at); b.u32leb(at);
  // out[a.len..] = b
  b.byte(32); b.u32leb(3);
  b.byte(32); b.u32leb(0); b.byte(251); b.u32leb(15);
  b.byte(32); b.u32leb(1);
  b.byte(65); b.i32leb(0);
  b.byte(32); b.u32leb(1); b.byte(251); b.u32leb(15);
  b.byte(251); b.u32leb(17); b.u32leb(at); b.u32leb(at);

  b.byte(32); b.u32leb(3);
  b.byte(11);
  code.u32leb(b.len);
  code.bytes(b);
}

/**
 * `string str_slice(string s, i32 from, i32 to)` — the overlap of a range with the string.
 *
 * **It clamps rather than trapping**, which is the whole of its specification: every combination of
 * arguments has an answer, a reversed range is empty, and a negative start is zero. Four `select`s
 * say that in eight instructions, and they are why this is not four nested `if`s.
 */
/**
 * `$bind$mem_ensure(bytes) -> i32` — grow the staging buffer to hold `bytes`, and answer its size.
 *
 * The JavaScript boundary moves arrays and strings through a page of linear memory rather than one
 * element at a time, and `wacBindgen` generates glue that calls this before every bulk copy. wacc
 * emitted no memory at all, so 21 of the repository's 33 packages could not be bound to a
 * wacc-compiled module — `issues/lang/0089`.
 *
 * The caller re-reads `memory.buffer` afterwards: growing detaches the old `ArrayBuffer`, and a view
 * built before the call is dead. Answering the size rather than the growth is what lets the caller
 * tell "already big enough" from "grown to fit" without asking twice.
 */

/** Whether a module already deals in this array type, asked without registering one that does not. */
bool hasArrayType(Env env, string t) {
  for (i32 i = 0; i < env.arrayCount; i++) {
    if (env.arrayTypes[i] == t) { return true; }
  }
  return false;
}

/**
 * The element types a bulk transfer knows how to move, and how.
 *
 * `width` is bytes per element; `load` and `store` are the linear-memory opcodes; `get` is the
 * `array.get` variant, which differs for the packed types because a `u8` widens unsigned and an `i8`
 * widens signed. Answers `-1` for a width when the element is not a primitive this can move — an
 * array of structs crosses element by element through other helpers, not through the buffer.
 */
i32 bulkWidth(string el) {
  if (el == "u8" || el == "i8") { return 1; }
  if (el == "u16" || el == "i16") { return 2; }
  if (el == "i32" || el == "u32" || el == "f32") { return 4; }
  if (el == "i64" || el == "u64" || el == "f64") { return 8; }
  return -1;
}

i32 bulkLoad(string el) {
  if (el == "u8" || el == "i8") { return 45; }      // i32.load8_u
  if (el == "u16" || el == "i16") { return 47; }    // i32.load16_u
  if (el == "i32" || el == "u32") { return 40; }    // i32.load
  if (el == "i64" || el == "u64") { return 41; }    // i64.load
  if (el == "f32") { return 42; }
  if (el == "f64") { return 43; }
  return -1;
}

i32 bulkStore(string el) {
  if (el == "u8" || el == "i8") { return 58; }      // i32.store8
  if (el == "u16" || el == "i16") { return 59; }    // i32.store16
  if (el == "i32" || el == "u32") { return 54; }    // i32.store
  if (el == "i64" || el == "u64") { return 55; }    // i64.store
  if (el == "f32") { return 56; }
  if (el == "f64") { return 57; }
  return -1;
}

/** `array.get` for a packed element is signed or unsigned by the element; everything else is plain. */
i32 bulkGet(string el) {
  if (el == "i8" || el == "i16") { return 12; }     // array.get_s
  if (el == "u8" || el == "u16") { return 13; }     // array.get_u
  return 11;                                        // array.get
}

/** The wasm value type an element arrives as, which is not the element's own for a packed one. */
string bulkValType(string el) {
  if (el == "i64" || el == "u64") { return "i64"; }
  if (el == "f32") { return "f32"; }
  if (el == "f64") { return "f64"; }
  return "i32";
}

/** Whether this array type can cross through the staging buffer at all. */
bool isBulkArray(string t) {
  return isArrayType(t) && !isArrayType(elemOf(t)) && bulkWidth(elemOf(t)) > 0;
}

/**
 * `$bind$arr_<el>_len(a) -> i32` — how many elements the array holds.
 *
 * The first of three a host needs to move an array across the boundary: it asks the length,
 * allocates, and copies through the staging buffer.
 */
void emitArrLen(B funcs, B code, Env env, string arrType) {
  funcs.u32leb(env.sigType("fn[i32(" + arrType + ")]"));
  B b = B.create();
  b.u32leb(0);
  b.byte(32); b.u32leb(0);
  b.byte(251); b.u32leb(15);            // array.len
  b.byte(11);
  code.u32leb(b.len);
  code.bytes(b);
}

/**
 * `$bind$arr_<el>_to_mem(a) -> i32` — copy the array into the staging buffer, answer its length.
 *
 * Element at a time rather than `array.copy`, which moves between two WasmGC arrays and not between
 * an array and linear memory: there is no bulk instruction for this direction. The host has already
 * called `$bind$mem_ensure`, so writing past the end traps rather than growing — the right way
 * round, since a short copy is a wrong answer and a trap is not.
 */
void emitArrToMem(B funcs, B code, Env env, string arrType) {
  string el = elemOf(arrType);
  i32 at = env.arrayType(arrType);
  i32 w = bulkWidth(el);
  funcs.u32leb(env.sigType("fn[i32(" + arrType + ")]"));

  B b = B.create();
  b.u32leb(1);
  b.u32leb(2); b.byte(127);             // locals 1, 2: the cursor and the length

  b.byte(65); b.i32leb(0); b.byte(33); b.u32leb(1);
  b.byte(32); b.u32leb(0); b.byte(251); b.u32leb(15); b.byte(33); b.u32leb(2);

  b.byte(2); b.byte(64);
  b.byte(3); b.byte(64);
  b.byte(32); b.u32leb(1); b.byte(32); b.u32leb(2); b.byte(78);
  b.byte(13); b.u32leb(1);
  // The address is the index scaled by the element's width.
  b.byte(32); b.u32leb(1);
  if (w > 1) { b.byte(65); b.i32leb(w); b.byte(108); }             // i32.mul
  b.byte(32); b.u32leb(0); b.byte(32); b.u32leb(1);
  b.byte(251); b.u32leb(bulkGet(el)); b.u32leb(at);
  b.byte(bulkStore(el)); b.u32leb(0); b.u32leb(0);
  b.byte(32); b.u32leb(1); b.byte(65); b.i32leb(1); b.byte(106);
  b.byte(33); b.u32leb(1);
  b.byte(12); b.u32leb(0);
  b.byte(11);
  b.byte(11);
  b.byte(32); b.u32leb(2);
  b.byte(11);
  code.u32leb(b.len);
  code.bytes(b);
}

/**
 * `$bind$arr_<el>_from_mem(count) -> <el>[]` — a new array holding `count` elements of the buffer.
 *
 * The local holding it is nullable, because `array.new_default` is what fills it and a local has to
 * have a type before that runs; the `ref.as_non_null` at the end is what the signature promises.
 */
void emitArrFromMem(B funcs, B code, Env env, string arrType) {
  string el = elemOf(arrType);
  i32 at = env.arrayType(arrType);
  i32 w = bulkWidth(el);
  funcs.u32leb(env.sigType("fn[" + arrType + "(i32)]"));

  B b = B.create();
  b.u32leb(2);
  b.u32leb(1); b.byte(99); b.i32leb(at);   // local 1: the array being built
  b.u32leb(1); b.byte(127);                // local 2: the cursor

  b.byte(32); b.u32leb(0);
  b.byte(251); b.u32leb(7); b.u32leb(at);  // array.new_default
  b.byte(33); b.u32leb(1);
  b.byte(65); b.i32leb(0); b.byte(33); b.u32leb(2);

  b.byte(2); b.byte(64);
  b.byte(3); b.byte(64);
  b.byte(32); b.u32leb(2); b.byte(32); b.u32leb(0); b.byte(78);
  b.byte(13); b.u32leb(1);
  b.byte(32); b.u32leb(1); b.byte(32); b.u32leb(2);
  b.byte(32); b.u32leb(2);
  if (w > 1) { b.byte(65); b.i32leb(w); b.byte(108); }
  b.byte(bulkLoad(el)); b.u32leb(0); b.u32leb(0);
  b.byte(251); b.u32leb(14); b.u32leb(at);                        // array.set
  b.byte(32); b.u32leb(2); b.byte(65); b.i32leb(1); b.byte(106);
  b.byte(33); b.u32leb(2);
  b.byte(12); b.u32leb(0);
  b.byte(11);
  b.byte(11);
  b.byte(32); b.u32leb(1);
  b.byte(212);                            // ref.as_non_null
  b.byte(11);
  code.u32leb(b.len);
  code.bytes(b);
}

/**
 * The six helpers a host reaches a `string` through.
 *
 * A `string` crosses the boundary as an opaque WasmGC reference, exactly as an array does, so
 * `wacBindgen`'s generated JS reads and fills one through `$bind$str_new`, `_get`, `_set`, `_len`,
 * `_from_mem` and `_to_mem`. The last two are the array family's loops at width one: a `string` is
 * `i8[]` underneath, which is why reading an element is `array.get_u` and not `array.get`.
 *
 * Spelled `string` rather than `i8[]` in the signatures because that is how they were registered in
 * the pre-pass, and a signature asked for by a name nobody registered grows the type table after the
 * type section has been sized — which this emitter answers by declining the module. `issues/lang/0089`.
 */
void emitStringBindHelpers(B funcs, B code, Env env) {
  i32 si = env.arrayType("i8[]");

  // `$bind$str_new(n) -> string`
  funcs.u32leb(env.sigType("fn[string(i32)]"));
  B nw = B.create();
  nw.u32leb(0);
  nw.byte(32); nw.u32leb(0);
  nw.byte(251); nw.u32leb(7); nw.u32leb(si);      // array.new_default
  nw.byte(11);
  code.u32leb(nw.len);
  code.bytes(nw);

  // `$bind$str_get(s, i) -> i32`, unsigned because `u8` is what a byte of text is.
  funcs.u32leb(env.sigType("fn[i32(string,i32)]"));
  B gt = B.create();
  gt.u32leb(0);
  gt.byte(32); gt.u32leb(0);
  gt.byte(32); gt.u32leb(1);
  gt.byte(251); gt.u32leb(13); gt.u32leb(si);     // array.get_u
  gt.byte(11);
  code.u32leb(gt.len);
  code.bytes(gt);

  // `$bind$str_set(s, i, b)`
  funcs.u32leb(env.sigType("fn[void(string,i32,i32)]"));
  B st = B.create();
  st.u32leb(0);
  st.byte(32); st.u32leb(0);
  st.byte(32); st.u32leb(1);
  st.byte(32); st.u32leb(2);
  st.byte(251); st.u32leb(14); st.u32leb(si);     // array.set
  st.byte(11);
  code.u32leb(st.len);
  code.bytes(st);

  // `$bind$str_len(s) -> i32`
  funcs.u32leb(env.sigType("fn[i32(string)]"));
  B ln = B.create();
  ln.u32leb(0);
  ln.byte(32); ln.u32leb(0);
  ln.byte(251); ln.u32leb(15);                    // array.len
  ln.byte(11);
  code.u32leb(ln.len);
  code.bytes(ln);

  // `$bind$str_to_mem(s) -> i32` — the array family's loop, width one.
  funcs.u32leb(env.sigType("fn[i32(string)]"));
  B tm = B.create();
  tm.u32leb(1);
  tm.u32leb(2); tm.byte(127);
  tm.byte(65); tm.i32leb(0); tm.byte(33); tm.u32leb(1);
  tm.byte(32); tm.u32leb(0); tm.byte(251); tm.u32leb(15); tm.byte(33); tm.u32leb(2);
  tm.byte(2); tm.byte(64);
  tm.byte(3); tm.byte(64);
  tm.byte(32); tm.u32leb(1); tm.byte(32); tm.u32leb(2); tm.byte(78);
  tm.byte(13); tm.u32leb(1);
  tm.byte(32); tm.u32leb(1);
  tm.byte(32); tm.u32leb(0); tm.byte(32); tm.u32leb(1);
  tm.byte(251); tm.u32leb(13); tm.u32leb(si);     // array.get_u
  tm.byte(58); tm.u32leb(0); tm.u32leb(0);        // i32.store8
  tm.byte(32); tm.u32leb(1); tm.byte(65); tm.i32leb(1); tm.byte(106);
  tm.byte(33); tm.u32leb(1);
  tm.byte(12); tm.u32leb(0);
  tm.byte(11);
  tm.byte(11);
  tm.byte(32); tm.u32leb(2);
  tm.byte(11);
  code.u32leb(tm.len);
  code.bytes(tm);

  // `$bind$str_from_mem(n) -> string`
  funcs.u32leb(env.sigType("fn[string(i32)]"));
  B fm = B.create();
  fm.u32leb(2);
  fm.u32leb(1); fm.byte(99); fm.i32leb(si);
  fm.u32leb(1); fm.byte(127);
  fm.byte(32); fm.u32leb(0);
  fm.byte(251); fm.u32leb(7); fm.u32leb(si);
  fm.byte(33); fm.u32leb(1);
  fm.byte(65); fm.i32leb(0); fm.byte(33); fm.u32leb(2);
  fm.byte(2); fm.byte(64);
  fm.byte(3); fm.byte(64);
  fm.byte(32); fm.u32leb(2); fm.byte(32); fm.u32leb(0); fm.byte(78);
  fm.byte(13); fm.u32leb(1);
  fm.byte(32); fm.u32leb(1); fm.byte(32); fm.u32leb(2);
  fm.byte(32); fm.u32leb(2);
  fm.byte(45); fm.u32leb(0); fm.u32leb(0);        // i32.load8_u
  fm.byte(251); fm.u32leb(14); fm.u32leb(si);     // array.set
  fm.byte(32); fm.u32leb(2); fm.byte(65); fm.i32leb(1); fm.byte(106);
  fm.byte(33); fm.u32leb(2);
  fm.byte(12); fm.u32leb(0);
  fm.byte(11);
  fm.byte(11);
  fm.byte(32); fm.u32leb(1);
  fm.byte(212);                                   // ref.as_non_null
  fm.byte(11);
  code.u32leb(fm.len);
  code.bytes(fm);
}

/**
 * The methods of every struct and enum a host can hold, as export entries.
 *
 * **No bodies.** A method is already a function in this module; what was missing is a name a host
 * can find it by, which is what `wacBindgen` generates JS against — `$bind$m_<S>_<name>` for an
 * instance method and `$bind$sm_<S>_<name>` for a static, since a struct may have both under one
 * name and they are different functions. Built into a buffer of its own so the count is known
 * before the export section is sized, and appended after the helpers. `issues/lang/0089`.
 */
i32 bindMethodExports(B out, Env env, u8[] src, Lexed lexed, Program prog,
                      string[] bindStructs, i32 bindStructCount) {
  i32 n = 0;
  // **An instance's methods, which no declaration carries.** `Vec<string>.create` is emitted from a
  // substitution rather than from a `StructDecl`, so the walk below — which reads declarations —
  // cannot see it, and `packages/box` stopped at `$bind$sm_Vec__packages_std_src_vec$string_create`.
  // Every instance the module builds is exported, not only the ones an export mentions: an instance
  // exists at all because something in this module named it, and a name a host cannot call costs one
  // export entry. `issues/lang/0089`.
  for (i32 ii = 0; ii < env.instCount; ii++) {
    string inst = env.instName[ii];
    if (!env.isStructName(inst)) { continue; }
    for (i32 d = 0; d < prog.decls.len(); d++) {
      match (prog.decls[d].kind) {
        case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
          if (typeParams.len() == 0) { continue; }
          if (tokenTextOf(src, lexed, nameTok) != env.instOf[ii]) { continue; }
          i32 tf = env.fileOf(tokenLine(lexed, nameTok));
          string tplPath = tf >= 0 && tf < env.filePaths.len() ? env.filePaths[tf] : "";
          string bind = bindNameOf(bindTypeSpelling(env, inst, tplPath));
          for (i32 m = 0; m < methods.len(); m++) {
            string mn = tokenTextOf(src, lexed, methods[m].nameTok);
            i32 at = env.funcAt(inst + "." + mn);
            if (at < 0 || env.funcIndex[at] < 0) { continue; }
            out.name((methods[m].hasThis ? "$bind$m_" : "$bind$sm_") + bind + "_" + mn);
            out.byte(0);
            out.u32leb(env.funcIndex[at]);
            n = n + 1;
          }
        }
        else: { }
      }
    }
  }
  for (i32 si = 0; si < bindStructCount; si++) {
    string owner = bindStructs[si];
    for (i32 d = 0; d < prog.decls.len(); d++) {
      match (prog.decls[d].kind) {
        case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
          if (typeParams.len() > 0) { continue; }
          // **The key, not the text.** Five files here declare a `Reader`; the first keeps the name
          // and the rest are keyed `Reader@<file>`, so matching on the token text matched all five
          // and exported one struct's helpers once per declaration. WebAssembly rejects a duplicate
          // export name, so `packages/box` compiled to a module that would not load [issue 0106].
          if (nameKeyOf(env, src, lexed, nameTok) != owner) { continue; }
          for (i32 m = 0; m < methods.len(); m++) {
            string mn = tokenTextOf(src, lexed, methods[m].nameTok);
            i32 at = env.funcAt(owner + "." + mn);
            if (at < 0 || env.funcIndex[at] < 0) { continue; }
            out.name((methods[m].hasThis ? "$bind$m_" : "$bind$sm_") + bindKeyOf(env, owner) + "_" + mn);
            out.byte(0);
            out.u32leb(env.funcIndex[at]);
            n = n + 1;
          }
        }
        case EnumDecl(nameTok, variants, exported, methods, typeParams): {
          if (typeParams.len() > 0) { continue; }
          if (nameKeyOf(env, src, lexed, nameTok) != owner) { continue; }
          for (i32 m = 0; m < methods.len(); m++) {
            string mn = tokenTextOf(src, lexed, methods[m].nameTok);
            i32 at = env.funcAt(owner + "." + mn);
            if (at < 0 || env.funcIndex[at] < 0) { continue; }
            out.name((methods[m].hasThis ? "$bind$m_" : "$bind$sm_") + bindKeyOf(env, owner) + "_" + mn);
            out.byte(0);
            out.u32leb(env.funcIndex[at]);
            n = n + 1;
          }
        }
        else: { }
      }
    }
  }
  return n;
}

/**
 * A declaring file's tag, the reference's way: the path without `.wac`, every other character `_`.
 *
 * `packages/std/src/vec.wac` is `packages_std_src_vec`, which is what makes
 * `Vec__packages_std_src_vec` the name a monomorphisation is spelled from. `issues/lang/0089`.
 */
string fileTagOf(string path) {
  u8[] a = path.toBytes();
  i32 end = a.len();
  if (end > 4 && a[end - 4] == 46 && a[end - 3] == 119 && a[end - 2] == 97 && a[end - 1] == 99) {
    end = end - 4;                                            // a trailing `.wac`
  }
  u8[] out = u8[end]();
  for (i32 i = 0; i < end; i++) {
    i32 c = a[i];
    bool ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
    out[i] = ok ? c : 95;                                     // `_`
  }
  return string.fromBytes(out);
}

/** The file a declared key came from, or `""` — the key is what `declare` handed out. */
string pathOfKey(Env env, string key) {
  for (i32 i = 0; i < env.declCount; i++) {
    if (env.declKeys[i] != key) { continue; }
    i32 f = env.declFiles[i];
    if (f < 0 || f >= env.fileCount) { return ""; }
    return env.filePaths[f];
  }
  return "";
}

/**
 * How the boundary spells a type: `Vec__packages_std_src_vec<string>`, `IndexEntry__packages_git…`.
 *
 * **The reference's spelling, because the glue is generated from it.** A plain struct crosses under
 * its own name — `$bind$sm_Fs_inMemory` — and a *monomorphisation* is built out of canonical names,
 * which are qualified by the declaring file. So the qualification is applied to a template and to
 * each of its arguments, and to nothing else.
 */
string bindTypeSpelling(Env env, string t, string templatePath) {
  // An array and a nullable are spelled by suffix, a funcref by its shape, and an instantiation by
  // its arguments after a `$` — `mangleType` in `compiler/wacResolve.ts`, which is what the generated
  // glue is named from. `u8[]` is `u8_arr`, and `Vec<u8[]>` from `packages/std/src/vec.wac` is
  // `Vec__packages_std_src_vec$u8_arr`.
  if (isArrayType(t)) { return bindTypeSpelling(env, elemOf(t), "") + "_arr"; }
  u8[] a = t.toBytes();
  if (a.len() > 1 && a[a.len() - 1] == 63) {                  // a trailing `?`
    return bindTypeSpelling(env, t.slice(0, t.len() - 1), "") + "_opt";
  }
  if (isFuncrefType(t)) {
    string fout = "fn_";
    for (i32 i = 0; i < sigParamCount(t); i++) {
      if (i > 0) { fout = fout + "_"; }
      fout = fout + bindTypeSpelling(env, sigParamAt(t, i), "");
    }
    return fout + "_to_" + bindTypeSpelling(env, sigReturn(t), "");
  }
  if (!isInstance(t)) { return qualifiedName(env, t); }
  // **The template's own file, handed in.** A generic declaration is never `declare`d — that table
  // holds what the module *emits*, and a template emits nothing until it is instantiated — so there
  // is no entry to look a path up in. The caller has the declaration in hand and its line says which
  // file it came from.
  string tpl = templateOf(t);
  string out = templatePath == "" ? qualifiedName(env, tpl) : tpl + "__" + fileTagOf(templatePath);
  // The arguments, split at the commas that are not inside a nested instantiation.
  i32 depth = 0;
  i32 start = -1;
  for (i32 i = 0; i < a.len(); i++) {
    i32 c = a[i];
    if (c == 60) {                                            // `<`
      depth = depth + 1;
      if (depth == 1) { start = i + 1; }
      continue;
    }
    if (c == 62) {                                            // `>`
      depth = depth - 1;
      if (depth != 0) { continue; }
      out = out + "$" + bindTypeSpelling(env, t.slice(start, i), "");
      continue;
    }
    if (c == 44 && depth == 1) {                              // `,` at the top level
      out = out + "$" + bindTypeSpelling(env, t.slice(start, i), "");
      start = i + 1;
    }
  }
  return out;
}

/** A declared name with its file behind it; anything this module did not declare is left alone. */
string qualifiedName(Env env, string name) {
  string path = pathOfKey(env, name);
  if (path == "" || path == " core") { return name; }
  // The key may carry the `@<file>` a shadowed name got; the reference knows nothing of that.
  string bare = name;
  i32 at = name.indexOf("@");
  if (at > 0) { bare = name.slice(0, at); }
  return bare + "__" + fileTagOf(path);
}

/**
 * What a bind helper calls a plain struct or enum: its own name, or a file-qualified one when more
 * than one module declares that name.
 *
 * The reference does the same and spells it the same way, which is the point — a host reads these
 * names, and the native manifest keys a struct by one. Naming the *second* declaration `S@2` and
 * leaving the first as `S` made the answer depend on which was met first, and left `S` meaning
 * either of them [issue 0100].
 */
string bindKeyOf(Env env, string key) {
  if (env.ambiguousDecl(key)) { return bindNameOf(qualifiedName(env, key)); }
  return bindNameOf(key);
}

/**
 * What a host should call the type this key names.
 *
 * The key is an *identity* — `S` for the first declaration of a name and `S@2` for a second one in
 * another file — and it is the right thing everywhere inside this emitter. It is the wrong thing in
 * the metadata a host reads: `S` there means either of them, and `S@2` is not a name TypeScript can
 * declare, so `waccBindgen` wrote `export class S@2` and the file did not parse [issue 0100].
 */
/**
 * A variant's name without the key that tells two files' variants apart.
 *
 * A variant is scoped by its enum, and the enum's own name is already qualified where it needs to
 * be — so `Ok` declared in two files needs nothing here beyond dropping the `@<file>` its key
 * carries. Left on, it reached the metadata and the export names, and the generated glue declared
 * `static Ok@5(request: Request)`, which is not a name TypeScript can spell [issue 0102].
 */
/**
 * The file a generic declaration was written in, or `""`.
 *
 * A template is never `declare`d — that table holds what the module *emits*, and a template emits
 * nothing until it is instantiated — so `pathOfKey` has no entry for one. The declarations are still
 * here, and `env.prog` keeps them, so this walks for it. Wanted by the bind names: a `Vec<Setting>`
 * is spelled from the *template's* path, not from the file that happened to instantiate it.
 */
string templatePathOf(Env env, u8[] src, Lexed lexed, string tpl) {
  if (env.prog is null) { return ""; }
  Program pg = env.prog!;
  for (i32 d = 0; d < pg.decls.len(); d++) {
    match (pg.decls[d].kind) {
      case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        if (typeParams.len() == 0) { continue; }
        if (tokenTextOf(src, lexed, nameTok) != tpl) { continue; }
        i32 f = env.fileOf(tokenLine(lexed, nameTok));
        return f >= 0 && f < env.filePaths.len() ? env.filePaths[f] : "";
      }
      case EnumDecl(nameTok, variants, exported, methods, typeParams): {
        if (typeParams.len() == 0) { continue; }
        if (tokenTextOf(src, lexed, nameTok) != tpl) { continue; }
        i32 f = env.fileOf(tokenLine(lexed, nameTok));
        return f >= 0 && f < env.filePaths.len() ? env.filePaths[f] : "";
      }
      else: { }
    }
  }
  return "";
}

/**
 * What the bind helpers of `key` are named after — the one answer for both an ordinary declaration
 * and a monomorphisation.
 *
 * An instance is spelled the way the reference mangles one, `Vec__packages_std_src_vec$Setting__…`,
 * because that is what its *method* helpers were already exported under; naming its struct helpers
 * any other way would give one type two names at one boundary [issue 0102].
 */
string bindNameFor(Env env, u8[] src, Lexed lexed, string key) {
  if (!isInstance(key)) { return bindKeyOf(env, key); }
  return bindNameOf(bindTypeSpelling(env, key, templatePathOf(env, src, lexed, templateOf(key))));
}

string bareVariantName(string key) {
  i32 at = key.indexOf("@");
  return at > 0 ? key.slice(0, at) : key;
}

/**
 * A type as the metadata should spell it — the identity, and the `?` the identity drops.
 *
 * `typeOfTyName` answers with the *wasm* type, where `T?` and `T` are the same thing and the
 * difference is the checker's to keep. A host cannot see it that way: `JsonValue? parse(u8[])` was
 * recorded as returning `JsonValue`, so the glue never answered `null` and `parse("")` came back as
 * a wrapper around nothing [issue 0102].
 */
string metaTypeOfTy(Env env, u8[] src, Lexed lexed, Ty t) {
  string base = metaTypeSpelling(env, typeOfTyName(env, src, lexed, t));
  if (base == "") { return base; }
  match (t.kind) {
    case Nullable(inner): { return base + "?"; }
    else: { return base; }
  }
}

string metaNameOf(Env env, string key) {
  if (env.ambiguousDecl(key)) { return qualifiedName(env, key); }
  return key;
}

/**
 * `metaNameOf` for every name inside a type string — `S[]`, `S?`, `fn[S(i32)]`, `Vec<S>`.
 *
 * A type reaches the metadata already spelled, so this rewrites the spelling rather than repeating
 * the walk that built it: a second implementation of that walk is one that drifts from the first.
 */
string metaTypeSpelling(Env env, string t) {
  u8[] a = t.toBytes();
  string out = "";
  string cur = "";
  for (i32 i = 0; i < a.len(); i++) {
    i32 c = a[i];
    // The characters a key can hold: an identifier, plus the `@` a second declaration carries, plus
    // `$` and `.` from the names this compiler mints. Everything else separates one name from the
    // next and is copied through.
    bool part = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) ||
                c == 95 || c == 64 || c == 36 || c == 46;
    if (part) { cur = cur + t.slice(i, i + 1); continue; }
    if (cur != "") { out = out + metaNameOf(env, cur); cur = ""; }
    out = out + t.slice(i, i + 1);
  }
  if (cur != "") { out = out + metaNameOf(env, cur); }
  return out;
}

/**
 * What `wacBindgen` calls a type: every run of characters an identifier cannot hold becomes `$`.
 *
 * `Vec__packages_std_src_vec<string>` is `Vec__packages_std_src_vec$string`. `$` and not `_`,
 * because a monomorphisation has to stay distinguishable from a struct somebody wrote — and wac's
 * lexer rejects `$`, so a name holding one cannot come from source.
 */
string bindNameOf(string spelling) {
  u8[] a = spelling.toBytes();
  u8[] tmp = u8[a.len()]();
  i32 n = 0;
  bool pending = false;
  for (i32 i = 0; i < a.len(); i++) {
    i32 c = a[i];
    bool ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
    if (ok) {
      if (pending && n > 0) { tmp[n] = 36; n = n + 1; }        // `$`, one per run
      pending = false;
      tmp[n] = c;
      n = n + 1;
    } else {
      pending = true;
    }
  }
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = tmp[i]; }
  return string.fromBytes(out);
}

/**
 * The callback signatures this module's exports ask a host for, in declaration order.
 *
 * A funcref *parameter* of an exported function is a host function coming in — the one thing a wac
 * module cannot do without an import, since `ref.func` can only name a function this module defines.
 * Deduplicated by signature, because one dispatcher serves every callback of the same shape, and in
 * the order the reference walks so `cb0` means the same thing on both sides of the generated glue.
 * `issues/lang/0094`.
 */
i32 collectCallbackSigs(Env env, u8[] src, Lexed lexed, Program prog) {
  i32 n = 0;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case Func(nameTok, returnType, params, body, exported, typeParams): {
        if (!exported || typeParams.len() > 0) { continue; }
        for (i32 i = 0; i < params.len(); i++) {
          n = noteCallbackSig(env, n, typeOfTyName(env, src, lexed, params[i].type));
        }
      }
      else: { }
    }
  }
  // **Every funcref *field* needs a dispatcher too.** `Core` is a struct of eight of them — `log`,
  // `waitAny`, `nowMillis` — and a host builds one by handing in JavaScript functions; `Pending<i64>`
  // is another three. Collecting only from parameters left those with no `wac.cb<j>` to go through
  // and no `$bind$fnref_<j>` to make one with, so the glue typed the field as a number and the
  // boundary answered *"type incompatibility when transforming from/to JS"* [issue 0106].
  //
  // Read from the **field table** rather than from the declarations: a generic instance has no
  // declaration of its own, and `Pending<i64>` is exactly the case that matters — walking `prog`
  // finds `Pending<T>`, whose field type is `T`.
  //
  // **Only the structs that cross**, though. Every struct's fields would mean a module importing a
  // dispatcher for a funcref it only ever holds internally: `struct H { fn[f64(f64)] cb; }` used
  // inside one function suddenly needs `wac.cb0` supplied at instantiation, which the generated
  // sweep caught as *"Import #0 wac"* on a program that had never needed a host at all.
  //
  // No package showed the original defect: a package exports functions, and only a *program* takes
  // `main(Core, Cli)`.
  string[] crossing = string[512]();
  // The callback walk asks the same question about the same roots, and it is handed the blob rather
  // than the file list — so it takes the bound from the environment the emitter already set up.
  i32 cn = collectBindStructs(env, src, lexed, prog, crossing, env.entryDecls);
  for (i32 i = 0; i < cn; i++) {
    i32 fc = env.fieldCountOf(crossing[i]);
    for (i32 f = 0; f < fc; f++) {
      n = noteCallbackSig(env, n, env.fieldTypeAt(crossing[i], f));
    }
    // **And its methods' signatures.** `Pending<i32>.of(id, resolve, settled, drop)` takes three
    // funcrefs, and a host calls it to build one — so those need dispatchers exactly as a field's do.
    // Found from the frame the failure actually named, `_Pending$i32.of`, after fields and returns
    // were both covered and an application still would not start [issue 0106].
    n = noteMethodCallbackSigs(env, src, lexed, prog, n, crossing[i]);
  }
  return n;
}

/** The funcref types in the signatures of `owner`'s methods, an instance's substituted like its own. */
i32 noteMethodCallbackSigs(Env env, u8[] src, Lexed lexed, Program prog, i32 n, string owner) {
  string tpl = isInstance(owner) ? templateOf(owner) : "";
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        string want = tpl == "" ? owner : tpl;
        if (tokenTextOf(src, lexed, nameTok) != want) { continue; }
        if (typeParams.len() > 0 && tpl == "") { continue; }
        i32 pushed = tpl == "" ? 0 : pushSubstitution(env, src, lexed, typeParams, owner, tpl);
        for (i32 m = 0; m < methods.len(); m++) {
          n = noteCallbackSig(env, n, typeOfTyName(env, src, lexed, methods[m].returnType));
          for (i32 pi = 0; pi < methods[m].params.len(); pi++) {
            n = noteCallbackSig(env, n, typeOfTyName(env, src, lexed, methods[m].params[pi].type));
          }
        }
        if (tpl != "") { popSubstitution(env, pushed); }
      }
      else: { }
    }
  }
  return n;
}

/**
 * Record a callback signature once, if that is what it is.
 *
 * **A full table declines the module rather than dropping a signature.** The capacity was 32 and
 * `packages/platform` needs 35: the 33rd was silently discarded, so `Pending<i32>`'s `resolve` and
 * `settled` crossed as numbers while `drop` — which happened to fit — crossed as a function. That is
 * a wrong module rather than a missing feature, and it presented as a boundary error naming neither
 * [issue 0106]. `full` is what the rest of this emitter uses to say "not this one" honestly.
 */
i32 noteCallbackSig(Env env, i32 n, string t) {
  if (!isFuncrefType(t)) { return n; }
  for (i32 k = 0; k < n; k++) { if (env.cbSigs[k] == t) { return n; } }
  if (n >= env.cbSigs.len()) { env.ranOut("callback signatures"); return n; }
  env.cbSigs[n] = t;
  return n + 1;
}

/**
 * The funcref signatures handed *out* — returned by an exported function.
 *
 * JavaScript cannot call a WasmGC function reference, but it can call an export that does the
 * `call_ref` for it. So a returned funcref crosses as a closure over one helper per signature: the
 * mirror of the trampolines that bring one in. `issues/lang/0089`'s last row.
 */
i32 collectOutSigs(Env env, u8[] src, Lexed lexed, Program prog, string[] out) {
  i32 n = 0;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case Func(nameTok, returnType, params, body, exported, typeParams): {
        if (!exported || typeParams.len() > 0) { continue; }
        string rt = typeOfTyName(env, src, lexed, returnType);
        if (!isFuncrefType(rt)) { continue; }
        bool seen = false;
        for (i32 k = 0; k < n; k++) { if (out[k] == rt) { seen = true; } }
        if (seen || n >= out.len()) { continue; }
        out[n] = rt;
        n = n + 1;
      }
      else: { }
    }
  }
  return n;
}

/**
 * A function, as a `fn[…]` **value**: its wrapper and a null env — `design/lang/0002`.
 *
 * The wrapper rather than the function itself, because the funcref inside a pair takes the env in
 * front and a plain function does not. Which wrapper is arithmetic: they are emitted one per function
 * in emission order, starting at `wrapAt`, so the wrapper for a function at wasm index `i` is at
 * `wrapAt + (i - cbSigCount)` — the imports being what `i` counts from.
 *
 * The env is null because this is the *unbound* case. A bound method reference is the same pair with
 * a receiver in it, which is the whole of what step 2 adds.
 */
void emitFuncPair(B fb, Env env, i32 at, string want) {
  fb.byte(210);                                       // ref.func <wrapper>
  fb.u32leb(env.wrapAt + (env.funcIndex[at] - env.cbSigCount));
  fb.byte(208); fb.byte(110);                         // ref.null any — no receiver
  fb.byte(251); fb.u32leb(0);                         // struct.new
  // **The slot's type, not a reconstruction of the function's.** The pair has to be the type the
  // value is being stored into, and that type is registered by whatever declared the slot — whereas
  // `signatureOf` rebuilds a signature from tables assembled by four different sites, which is how
  // the first attempt at this named types the section had already been written without.
  fb.u32leb(env.pairType(isFuncrefType(want) ? want : signatureOf(env, at)));
}

/**
 * Every type emitting one function will name — `design/lang/0002`.
 *
 * Four, not one: its own signature, the env shape its unbound wrapper has, the receiver-less
 * signature a *bound* reference to it has, and that one's env shape. Registered together and in the
 * pre-pass, because the type section is sized before any body is emitted and a type first named
 * while emitting is a module that declines.
 *
 * For a function with no receiver the last two are the first two, and registering a type twice is
 * free — `sigType` is a lookup before it is an append.
 */
void registerFuncTypes(Env env, u8[] src, Lexed lexed, Ty returnType, Param[] params,
                       string receiver) {
  string own = emittedSig(env, src, lexed, returnType, params, receiver);
  env.sigType(own);
  env.sigType(envSig(own));
  string bare = emittedSig(env, src, lexed, returnType, params, "");
  env.sigType(bare);
  env.sigType(envSig(bare));
}

/** The helper's signature for one of them: the reference first, then what it takes. */
string callrefSig(string cb) {
  string out = "fn[" + sigReturn(cb) + "(" + cb;
  for (i32 i = 0; i < sigParamCount(cb); i++) { out = out + "," + sigParamAt(cb, i); }
  return out + ")]";
}

/**
 * `$bind$callref_<j>(f, …) -> ret` — call a funcref the module handed out.
 *
 * The receiver comes first so a host can bind it: the generated closure holds the reference and
 * passes the arguments after it, which is the reference's order and therefore the glue's.
 */
void emitCallrefHelper(B funcs, B code, Env env, string cb) {
  funcs.u32leb(env.sigType(callrefSig(cb)));
  i32 np = sigParamCount(cb);
  B b = B.create();
  b.u32leb(0);
  // The callee is a **pair** — `design/lang/0002` — so this reads both fields: the env first, then
  // the arguments the host passed, then the funcref. Parameter 0 is the pair itself, which is why it
  // can be read twice without a scratch.
  b.byte(32); b.u32leb(0);
  b.byte(251); b.u32leb(2); b.u32leb(env.pairType(cb)); b.u32leb(1);   // struct.get env
  for (i32 i = 0; i < np; i++) { b.byte(32); b.u32leb(i + 1); }
  b.byte(32); b.u32leb(0);
  b.byte(251); b.u32leb(2); b.u32leb(env.pairType(cb)); b.u32leb(0);   // struct.get funcref
  b.byte(20); b.u32leb(env.sigType(envSig(cb)));    // call_ref
  b.byte(11);
  code.u32leb(b.len);
  code.bytes(b);
}

/** The dispatcher's signature for a callback: the slot first, then what the callback takes. */
string dispatchSig(string cb) {
  string out = "fn[" + sigReturn(cb) + "(i32";
  for (i32 i = 0; i < sigParamCount(cb); i++) { out = out + "," + sigParamAt(cb, i); }
  return out + ")]";
}

/** How many slots a host may hold callbacks in — the reference offers sixteen, and glue is generated
 * against that number. */
i32 callbackSlots() { return 16; }

/**
 * The trampolines and the selector for one callback signature.
 *
 * A host function reaches wac as a *slot number*, not as a reference: JavaScript cannot make a
 * WasmGC funcref, and an imported function is not one. So the module defines `callbackSlots()`
 * functions of the callback's own type, each closing over its own constant `k` and calling the
 * imported dispatcher with it — `wac.cb<j>(k, …)`. `$bind$fnref_<j>(k)` answers the `k`th of them,
 * which is a funcref wac code calls like any other.
 */
void emitCallbackHelpers(B funcs, B code, Env env, i32 j, i32 firstIndex) {
  string cb = env.cbSigs[j];
  // **Env-shaped, because a trampoline is the funcref inside a pair** — `design/lang/0002`. Every
  // funcref a `fn[…]` can hold takes the env in front, whether or not it reads one, so these take it
  // and ignore it exactly as a plain function's wrapper does. Their own parameters move up one.
  i32 sigIdx = env.sigType(envSig(cb));
  i32 np = sigParamCount(cb);

  for (i32 k = 0; k < callbackSlots(); k++) {
    funcs.u32leb(sigIdx);
    B tb = B.create();
    tb.u32leb(0);
    tb.byte(65); tb.i32leb(k);                       // i32.const k — the slot
    for (i32 i = 0; i < np; i++) { tb.byte(32); tb.u32leb(i + 1); }
    tb.byte(16); tb.u32leb(j);                       // call the imported dispatcher
    tb.byte(11);
    code.u32leb(tb.len);
    code.bytes(tb);
  }

  // `$bind$fnref_<j>(slot) -> (ref <cb>)`. The `if` carries no result type and each arm returns
  // instead: a reference type in block-type position is encoded ambiguously — a value type or a
  // type index — and returning sidesteps the question, which is the reference's reasoning too.
  funcs.u32leb(env.sigType("fn[" + cb + "(i32)]"));
  B sb = B.create();
  sb.u32leb(0);
  for (i32 k = 0; k < callbackSlots(); k++) {
    sb.byte(32); sb.u32leb(0);
    sb.byte(65); sb.i32leb(k);
    sb.byte(70);                                     // i32.eq
    sb.byte(4); sb.byte(64);                         // if
    // **A pair, not a bare funcref** — `design/lang/0002`. The trampoline is already env-shaped
    // where it needs to be: a host function reaches the module through a slot, so the env carries
    // nothing and the funcref is the trampoline itself.
    sb.byte(210); sb.u32leb(firstIndex + k);         // ref.func tramp_k
    sb.byte(208); sb.byte(110);                      // ref.null any
    sb.byte(251); sb.u32leb(0); sb.u32leb(env.pairType(cb));   // struct.new
    sb.byte(15);                                     // return
    sb.byte(11);                                     // end
  }
  sb.byte(0);                                        // unreachable — no such slot
  sb.byte(11);
  code.u32leb(sb.len);
  code.bytes(sb);
}

/**
 * What a host calls this array's helpers: `arr_i32_…`, `arr_string_…`, `arr_u8Arr_…`.
 *
 * The reference's spelling, because the glue is generated from *its* view of the type and then
 * handed wacc's module — an element that is itself an array appends `Arr`, and a nullable one
 * appends `_null`. `issues/lang/0089`.
 */
string bindArrSuffix(string el) {
  if (isArrayType(el)) { return bindArrSuffix(elemOf(el)) + "Arr"; }
  u8[] a = el.toBytes();
  if (a.len() > 1 && a[a.len() - 1] == 63) {                    // a trailing `?`
    u8[] inner = u8[a.len() - 1]();
    for (i32 i = 0; i < inner.len(); i++) { inner[i] = a[i]; }
    return bindArrSuffix(string.fromBytes(inner)) + "_null";
  }
  // **A monomorphisation is spelled, not written raw.** `MapEntry<u8[],i32>[]` gave
  // `$bind$arr_MapEntry<u8[],i32>_new`, an export name holding `<`, `,` and brackets — which no
  // host can declare a function for. Only visible once an array of instances could cross at all
  // [issue 0102].
  if (isInstance(el)) { return bindNameOf(el); }
  return el;
}

/**
 * Whether the host has to say what to fill a new array with.
 *
 * **The reference's answer, not this emitter's.** wacc declares every reference element *nullable*,
 * so `array.new_default` would serve for all of them — but the generated glue asks
 * `$bind$arr_string_new(n, fill)` and `$bind$arr_string_new0()` because the reference declares a
 * `string` or array element non-null, and a helper set is a calling convention before it is a
 * layout. A struct element is nullable on both sides and takes the one-argument form.
 */
bool arrNeedsFill(Env env, string el) {
  // **A `string` element only.** The reference declares an array element non-null exactly when it is
  // a `string`; an element that is itself an array is declared nullable, so `array.new_default`
  // serves and the glue calls `$bind$arr_u8Arr_new(n)` with one argument. Emitting the two-argument
  // form for it is not a wrong answer but a wrong *shape*: `packages/bls` stopped with "type
  // incompatibility when transforming from/to JS" at the call, which is the boundary refusing an
  // arity nobody generated glue for. Read off the generated glue rather than reasoned about.
  return el == "string";
}

/** Whether an array's elements cross as an opaque reference rather than as a number. */
bool refElem(Env env, string el) {
  if (isArrayType(el) || el == "string") { return true; }
  u8[] a = el.toBytes();
  if (a.len() > 1 && a[a.len() - 1] == 63) { return true; }
  return env.isStructName(el);
}

/** How the element crosses: a packed one arrives as an `i32`, a reference as itself. */
string bindElemType(string el) {
  return refElem2(el) ? el : bindFieldType(el);
}

/** `refElem` without an `Env`, for the places that only have the spelling. */
bool refElem2(string el) {
  if (isArrayType(el) || el == "string") { return true; }
  u8[] a = el.toBytes();
  return a.len() > 1 && a[a.len() - 1] == 63;
}

/** How many helpers an array type needs — `new`, `get`, `set`, `len`, and the two bulk ones. */
i32 arrayHelperCount(Env env, string at) {
  string el = elemOf(at);
  i32 n = 4;
  if (arrNeedsFill(env, el)) { n = n + 1; }
  if (isBulkArray(at)) { n = n + 2; }
  return n;
}

/** Whether this array type can have helpers at all — a funcref element has no spelling here. */
bool bindableArray(Env env, string at) {
  string el = elemOf(at);
  // A funcref element has no spelling on this side and no helper a host could call.
  u8[] fb = el.toBytes();
  if (fb.len() >= 3 && fb[0] == 102 && fb[1] == 110 && fb[2] == 91) { return false; }
  if (isArrayType(el)) { return bindableArray(env, el); }
  if (refElem2(el)) {
    u8[] a = el.toBytes();
    if (a.len() > 1 && a[a.len() - 1] == 63) {
      u8[] inner = u8[a.len() - 1]();
      for (i32 i = 0; i < inner.len(); i++) { inner[i] = a[i]; }
      string core = string.fromBytes(inner);
      return core == "string" || isArrayType(core) || env.isStructName(core);
    }
    return true;
  }
  return el == "string" || env.isStructName(el) || isBulkArray(el + "[]");
}

/**
 * `$bind$arr_<suffix>_new`, `_get`, `_set`, `_len` for one array type.
 *
 * The per-element accessors every array needs, whatever its element is: `_to_mem` and `_from_mem`
 * move bytes and only a numeric element has bytes to move, so `string[]` and `u8[][]` had nothing
 * at all until now — `$bind$arr_u8Arr_new is not a function` is what a host saw.
 */
void emitArrayAccessors(B funcs, B code, Env env, string at) {
  string el = elemOf(at);
  string bel = bindElemType(el);
  i32 ti = env.arrayType(at);
  bool fill = arrNeedsFill(env, el);

  if (fill) {
    // `array.new` takes the value first and the count second.
    funcs.u32leb(env.sigType("fn[" + at + "(i32," + bel + ")]"));
    B nb = B.create();
    nb.u32leb(0);
    nb.byte(32); nb.u32leb(1);
    nb.byte(32); nb.u32leb(0);
    nb.byte(251); nb.u32leb(6); nb.u32leb(ti);                  // array.new
    nb.byte(11);
    code.u32leb(nb.len);
    code.bytes(nb);

    // An empty one, which is the only shape there is no element to fill.
    funcs.u32leb(env.sigType("fn[" + at + "()]"));
    B zb = B.create();
    zb.u32leb(0);
    zb.byte(251); zb.u32leb(8); zb.u32leb(ti); zb.u32leb(0);    // array.new_fixed, no elements
    zb.byte(11);
    code.u32leb(zb.len);
    code.bytes(zb);
  } else {
    funcs.u32leb(env.sigType("fn[" + at + "(i32)]"));
    B nb2 = B.create();
    nb2.u32leb(0);
    nb2.byte(32); nb2.u32leb(0);
    nb2.byte(251); nb2.u32leb(7); nb2.u32leb(ti);               // array.new_default
    nb2.byte(11);
    code.u32leb(nb2.len);
    code.bytes(nb2);
  }

  funcs.u32leb(env.sigType("fn[" + bel + "(" + at + ",i32)]"));
  B gb = B.create();
  gb.u32leb(0);
  gb.byte(32); gb.u32leb(0);
  gb.byte(32); gb.u32leb(1);
  gb.byte(251); gb.u32leb(bulkGet(el)); gb.u32leb(ti);
  gb.byte(11);
  code.u32leb(gb.len);
  code.bytes(gb);

  funcs.u32leb(env.sigType("fn[void(" + at + ",i32," + bel + ")]"));
  B sb = B.create();
  sb.u32leb(0);
  sb.byte(32); sb.u32leb(0);
  sb.byte(32); sb.u32leb(1);
  sb.byte(32); sb.u32leb(2);
  sb.byte(251); sb.u32leb(14); sb.u32leb(ti);                   // array.set
  sb.byte(11);
  code.u32leb(sb.len);
  code.bytes(sb);

  funcs.u32leb(env.sigType("fn[i32(" + at + ")]"));
  B lb = B.create();
  lb.u32leb(0);
  lb.byte(32); lb.u32leb(0);
  lb.byte(251); lb.u32leb(15);                                  // array.len
  lb.byte(11);
  code.u32leb(lb.len);
  code.bytes(lb);
}

/**
 * How many helpers an enum needs: the tag, then a constructor and a payload getter per variant.
 */
i32 enumHelperCount(Env env, string ename) {
  i32 n = 1;
  for (i32 v = 0; v < env.variantCount; v++) {
    if (env.variantOwners[v] != ename) { continue; }
    n = n + 1 + env.variantArity[v];
  }
  return n;
}

/**
 * `$bind$e_<E>_tag`, then `_<V>_new` and `_<V>_get_<f>` for each variant.
 *
 * **The representation is ours and the names are bindgen's.** The reference gives an enum a base
 * struct per module and a subtype per variant, so its payload getters cast before they read; wacc
 * lays every variant's payload out in one struct beside the tag, so a getter is a plain
 * `struct.get` at the variant's own slot. A host cannot tell the two apart — it holds an opaque
 * reference either way — which is exactly why the helper set is the contract and the layout is not.
 *
 * Reading the wrong variant's payload is the one place they differ: the reference traps on the cast
 * and this answers whatever is in the slot. `match` is what a caller should use, and the tag is
 * there so it can. `issues/lang/0089`.
 */
void emitEnumHelpers(B funcs, B code, Env env, string ename) {
  i32 ti = env.structType(ename);
  i32 fc = env.fieldCountOf(ename);

  // The tag, which is field 0 — `emitVariantNew` writes it first for every variant.
  funcs.u32leb(env.sigType("fn[i32(" + ename + ")]"));
  B tb = B.create();
  tb.u32leb(0);
  tb.byte(32); tb.u32leb(0);
  tb.byte(251); tb.u32leb(2); tb.u32leb(ti); tb.u32leb(0);      // struct.get
  tb.byte(11);
  code.u32leb(tb.len);
  code.bytes(tb);

  for (i32 v = 0; v < env.variantCount; v++) {
    if (env.variantOwners[v] != ename) { continue; }
    i32 arity = env.variantArity[v];
    i32 slot0 = env.variantSlot[v];

    // `new` supplies the tag itself, so a host cannot build one whose tag disagrees with its
    // payload. Every other variant's slots take the default, as `emitVariantNew` does.
    string params = "";
    for (i32 k = 0; k < arity; k++) {
      if (k > 0) { params = params + ","; }
      params = params + bindFieldType(env.fieldTypeAt(ename, slot0 + k));
    }
    funcs.u32leb(env.sigType("fn[" + ename + "(" + params + ")]"));
    B nb = B.create();
    nb.u32leb(0);
    nb.byte(65); nb.i32leb(env.variantTags[v]);
    for (i32 slot = 1; slot < fc; slot++) {
      i32 k = slot - slot0;
      if (k >= 0 && k < arity) {
        nb.byte(32); nb.u32leb(k);
      } else {
        emitNull(nb, env, env.fieldTypeAt(ename, slot));
      }
    }
    nb.byte(251); nb.u32leb(0); nb.u32leb(ti);                  // struct.new
    nb.byte(11);
    code.u32leb(nb.len);
    code.bytes(nb);

    for (i32 k = 0; k < arity; k++) {
      string ft = env.fieldTypeAt(ename, slot0 + k);
      funcs.u32leb(env.sigType("fn[" + bindFieldType(ft) + "(" + ename + ")]"));
      B gb = B.create();
      gb.u32leb(0);
      gb.byte(32); gb.u32leb(0);
      gb.byte(251); gb.u32leb(structGetOp(ft)); gb.u32leb(ti); gb.u32leb(slot0 + k);
      gb.byte(11);
      code.u32leb(gb.len);
      code.bytes(gb);
    }
  }
}

/** The part of an enum field name after the `<Variant>.`, which is what a host asks for. */
string payloadFieldName(string qualified) {
  u8[] a = qualified.toBytes();
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] != 46) { continue; }                               // `.`
    u8[] out = u8[a.len() - i - 1]();
    for (i32 k = 0; k < out.len(); k++) { out[k] = a[i + 1 + k]; }
    return string.fromBytes(out);
  }
  return qualified;
}

/**
 * How a field crosses the boundary — a packed one arrives as an `i32`, as it does from an array.
 */
string bindFieldType(string t) {
  if (t == "u8" || t == "i8" || t == "u16" || t == "i16") { return "i32"; }
  return t;
}

/**
 * Always plain `struct.get`, because this emitter does not pack a struct's fields.
 *
 * Arrays are packed — a `u8[]` is an `i8` array and reading one needs `array.get_u` — and a struct's
 * `u8` is stored as an `i32`, so the signed and unsigned forms are wrong here and wasm says so:
 * *"Field 2 of type 0 has type i32. Use struct.get instead."* The reference packs both and needs the
 * three forms; this needs one.
 */
i32 structGetOp(string t) {
  return 2;
}

/**
 * The structs a host can be handed — those an exported signature names, and any struct they hold.
 *
 * A JS caller holds one as an opaque reference and reaches its contents through these accessors, so
 * a struct that only appears inside another still needs them: `Canonical` carries a `u8[]` and
 * `FseTable` carries three, and neither is reachable without the getters.
 */
/**
 * `entryDecls` bounds the **roots**, not the walk.
 *
 * What crosses the boundary is what the *entry* exposes. A linked blob holds every imported file's
 * declarations too, and `export struct` in one of those means "visible to the file that imported me"
 * rather than "reachable from JavaScript" — so rooting in all of them binds types no host can name,
 * and hands the host constructors for capabilities the program never asked for.
 *
 * **That is a security property before it is a size one.** A program should be given what it
 * declared and nothing more; a `main(Core)` that gets a `Socket`, a `Child` and a window system
 * because something it imports mentions them is ambient authority arriving through the back door.
 * `native/v8/example/hello.wac` — a program that logs one line — was described by a manifest of 31
 * structs and 51 callback signatures, and is now described by 4 and 10.
 *
 * The size follows: `packages/box` goes 506.5 KB → 425.8 KB of module and 991 KB → 782 KB built,
 * which puts wacc below the reference rather than above it. `issues/lang/0107`.
 *
 * The transitive walk below is deliberately *not* bounded: a type reached from an entry signature
 * has to be bound wherever it was declared, which is usually an imported file. -1 means no bound,
 * which is what a single-file source wants.
 */
i32 collectBindStructs(Env env, u8[] src, Lexed lexed, Program prog, string[] out, i32 entryDecls) {
  i32 n = 0;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    if (entryDecls >= 0 && d >= entryDecls) { break; }
    match (prog.decls[d].kind) {
      case Func(nameTok, returnType, params, body, exported, typeParams): {
        if (!exported || typeParams.len() > 0) { continue; }
        n = noteBindStruct(env, out, n, baseOfType(typeOfTyName(env, src, lexed, returnType)));
        n = noteSignatureTypes(env, out, n, typeOfTyName(env, src, lexed, returnType));
        for (i32 i = 0; i < params.len(); i++) {
          string pt = typeOfTyName(env, src, lexed, params[i].type);
          n = noteBindStruct(env, out, n, baseOfType(pt));
          // **A callback's own types are part of this signature.** `gunzip(fn[Read()] next)` puts
          // `Read` in the entry's interface as surely as a parameter would, and taking only the base
          // of the parameter sees a funcref and stops — which left `packages/gzip`'s streaming tests
          // holding a module with no `Read` to build. `issues/lang/0107`.
          n = noteSignatureTypes(env, out, n, pt);
        }
      }
      // **`export struct` is a root of its own.** A type built only by its own static method — which
      // is how a type with an invariant is constructed — is reachable from no signature at all, and
      // was bound nowhere although the language had already been told it is public.
      // `$bind$sm_Procs_create` is what a host saw missing. `issues/lang/0089`.
      case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        if (!exported || typeParams.len() > 0) { continue; }
        // **The key, not the name written here.** A bare name that another file already took is
        // registered as `Word@<file>`, and `Word` alone is then whatever *did* take it — in
        // `packages/sh` that is `lex.wac`'s `Kind.Word`, so a helper built a `Kind` out of a
        // `Word`'s fields. Every other root on this walk comes from `typeOfTyName`, which resolves;
        // these two were added later and read the token. `issues/lang/0095`.
        n = noteBindStruct(env, out, n,
                           env.keyAt(tokenTextOf(src, lexed, nameTok), tokenLine(lexed, nameTok)));
      }
      case EnumDecl(nameTok, variants, exported, methods, typeParams): {
        if (!exported || typeParams.len() > 0) { continue; }
        n = noteBindStruct(env, out, n,
                           env.keyAt(tokenTextOf(src, lexed, nameTok), tokenLine(lexed, nameTok)));
      }
      else: { }
    }
  }
  // Transitively, through fields **and through method signatures** — a fixed point, since a struct
  // can hold one that holds another. A method that returns a type nothing bound is a method the glue
  // silently drops, which is the one accessor some types exist for.
  for (i32 round = 0; round < 8; round++) {
    i32 before = n;
    for (i32 i = 0; i < before; i++) {
      i32 fc = env.fieldCountOf(out[i]);
      for (i32 f = 0; f < fc; f++) {
        n = noteBindStructIn(env, out, n, env.fieldTypeAt(out[i], f));
      }
      for (i32 d = 0; d < prog.decls.len(); d++) {
        match (prog.decls[d].kind) {
          case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
            if (typeParams.len() > 0) { continue; }
            if (tokenTextOf(src, lexed, nameTok) != out[i]) { continue; }
            for (i32 m = 0; m < methods.len(); m++) {
              n = noteBindStruct(env, out, n,
                                 baseOfType(typeOfTyName(env, src, lexed, methods[m].returnType)));
              for (i32 pi = 0; pi < methods[m].params.len(); pi++) {
                n = noteBindStruct(env, out, n, baseOfType(
                  typeOfTyName(env, src, lexed, methods[m].params[pi].type)));
              }
            }
          }
          case EnumDecl(nameTok, variants, exported, methods, typeParams): {
            if (typeParams.len() > 0) { continue; }
            if (tokenTextOf(src, lexed, nameTok) != out[i]) { continue; }
            for (i32 m = 0; m < methods.len(); m++) {
              n = noteBindStruct(env, out, n,
                                 baseOfType(typeOfTyName(env, src, lexed, methods[m].returnType)));
              for (i32 pi = 0; pi < methods[m].params.len(); pi++) {
                n = noteBindStruct(env, out, n, baseOfType(
                  typeOfTyName(env, src, lexed, methods[m].params[pi].type)));
              }
            }
          }
          else: { }
        }
      }
    }
    if (n == before) { return n; }
  }
  return n;
}

/** The type under any `?` and `[]`, which is what decides whether a name is a struct. */
string baseOfType(string t) {
  string core = t;
  for (i32 guard = 0; guard < 8; guard++) {
    if (isArrayType(core)) { core = elemOf(core); continue; }
    u8[] a = core.toBytes();
    if (a.len() > 1 && a[a.len() - 1] == 63) {          // a trailing `?`
      u8[] out = u8[a.len() - 1]();
      for (i32 i = 0; i < out.len(); i++) { out[i] = a[i]; }
      core = string.fromBytes(out);
      continue;
    }
    break;
  }
  return core;
}

/**
 * Note every struct a type *reaches*, following a funcref into its own signature.
 *
 * `Core.nowMillis` is `fn[Pending<i64>()]` — nothing in the program names `Pending<i64>` any other
 * way, so a walk that stopped at the funcref left the host with a field it could read and no class
 * to wrap what came out: `cls.Pending$i64.of` was undefined in `packages/platform/host/provider.ts`
 * [issue 0106]. A capability is a struct of funcrefs that answer other structs, so this is the shape
 * the whole platform is made of, and it was reachable by no other route.
 */
/**
 * The types inside a funcref signature, which are as much a part of an interface as the funcref.
 *
 * Not recursive on purpose: a signature that takes a signature is a shape nothing here writes, and a
 * fixed point over two levels would be a guess at a case rather than a case.
 */
i32 noteSignatureTypes(Env env, string[] out, i32 n, string t) {
  if (!isFuncrefType(t)) { return n; }
  n = noteBindStructIn(env, out, n, sigReturn(t));
  for (i32 i = 0; i < sigParamCount(t); i++) {
    n = noteBindStructIn(env, out, n, sigParamAt(t, i));
  }
  return n;
}

i32 noteBindStructIn(Env env, string[] out, i32 n, string t) {
  string core = baseOfType(t);
  if (!isFuncrefType(core)) { return noteBindStruct(env, out, n, core); }
  n = noteBindStructIn(env, out, n, sigReturn(core));
  for (i32 i = 0; i < sigParamCount(core); i++) {
    n = noteBindStructIn(env, out, n, sigParamAt(core, i));
  }
  return n;
}

/** Add a struct to the list once, and only if it is one this module declares. */
i32 noteBindStruct(Env env, string[] out, i32 n, string name) {
  // **An instance counts.** It was excluded while nothing could name one at the boundary; now that
  // `bindNameFor` can, a `Vec<Setting>` crossing an exported signature needs its helpers like any
  // other struct — `packages/git`, `packages/box` and `packages/fs` are all this [issue 0102].
  if (name == "" || !env.isStructName(name)) { return n; }
  for (i32 i = 0; i < n; i++) { if (out[i] == name) { return n; } }
  // **A type that crosses and is not written down does not fail here.** It fails in the generated
  // glue, as a class the host asks for and cannot find: `boxsh` filled this table at 64 and lost
  // every `Pending<T>` — what every capability returns — so the shell built, loaded, and printed
  // nothing at the first `cls.Pending$i64.of(…)` [issue 0106].
  if (n >= out.len()) { env.ranOut("the types that cross the bind boundary"); return n; }
  out[n] = name;
  return n + 1;
}

/**
 * Whether this struct's helpers can be emitted at all.
 *
 * **The two field counts have to agree.** `fieldCountOf` is what the helpers are built from and
 * `countStructFields` is what the *type section* declares, and for `packages/sh/src/parse.wac`'s
 * `Word` — one field, of a generic instance from another file — they disagreed: the constructor
 * pushed nothing and the type wanted one, which wasm reports as *"not enough arguments on the stack
 * for struct.new (need 1, got 0)"* in a helper the source never wrote. Skipping is the same answer
 * this emitter gives everywhere else it cannot do something; a host sees a missing helper rather
 * than a module that will not load. `issues/lang/0089`.
 */
bool bindableStruct(Env env, string name) {
  // **The two field counts have to agree.** `fieldCountOf` is what the helpers are built from and
  // `countStructFields` is what the *type section* declares; a helper built from one against the
  // other is a `struct.new` with the wrong number of arguments, which wasm reports in a function the
  // source never wrote. They disagreed once because this set was collected under *unresolved* names
  // — `issues/lang/0095`, fixed at the root in `collectBindStructs` — and the guard stays because a
  // disagreement is exactly the shape that must never reach the type section.
  return env.fieldCountOf(name) == countStructFields(env, name);
}

/** How many helpers a struct needs: one constructor, and a getter and setter per field. *//** How many helpers a struct needs: one constructor, and a getter and setter per field. */
i32 structHelperCount(Env env, string name) {
  return 1 + env.fieldCountOf(name) * 2;
}

/** `$bind$s_<S>_new(fields…) -> S`, then a getter and a setter for each field. */
void emitStructHelpers(B funcs, B code, Env env, string name) {
  i32 fc = env.fieldCountOf(name);
  i32 ti = env.structType(name);

  string params = "";
  for (i32 i = 0; i < fc; i++) {
    if (i > 0) { params = params + ","; }
    params = params + bindFieldType(env.fieldTypeAt(name, i));
  }
  funcs.u32leb(env.sigType("fn[" + name + "(" + params + ")]"));
  B nb = B.create();
  nb.u32leb(0);
  for (i32 i = 0; i < fc; i++) { nb.byte(32); nb.u32leb(i); }
  nb.byte(251); nb.u32leb(0); nb.u32leb(ti);      // struct.new
  nb.byte(11);
  code.u32leb(nb.len);
  code.bytes(nb);

  for (i32 i = 0; i < fc; i++) {
    string ft = env.fieldTypeAt(name, i);
    funcs.u32leb(env.sigType("fn[" + bindFieldType(ft) + "(" + name + ")]"));
    B gb = B.create();
    gb.u32leb(0);
    gb.byte(32); gb.u32leb(0);
    gb.byte(251); gb.u32leb(structGetOp(ft)); gb.u32leb(ti); gb.u32leb(i);
    gb.byte(11);
    code.u32leb(gb.len);
    code.bytes(gb);

    funcs.u32leb(env.sigType("fn[void(" + name + "," + bindFieldType(ft) + ")]"));
    B sb = B.create();
    sb.u32leb(0);
    sb.byte(32); sb.u32leb(0);
    sb.byte(32); sb.u32leb(1);
    sb.byte(251); sb.u32leb(5); sb.u32leb(ti); sb.u32leb(i);   // struct.set
    sb.byte(11);
    code.u32leb(sb.len);
    code.bytes(sb);
  }
}

void emitMemEnsure(B funcs, B code, Env env) {
  funcs.u32leb(env.sigType("fn[i32(i32)]"));

  B b = B.create();
  b.u32leb(1);
  b.u32leb(1); b.byte(127);            // one i32 local: the pages needed

  // needPages = (bytes + 65535) >>> 16
  b.byte(32); b.u32leb(0);
  b.byte(65); b.i32leb(65535); b.byte(106);
  b.byte(65); b.i32leb(16); b.byte(118);
  b.byte(33); b.u32leb(1);

  // if (memory.size < needPages) { memory.grow(needPages - memory.size); }
  b.byte(63); b.byte(0);               // memory.size
  b.byte(32); b.u32leb(1);
  b.byte(73);                          // i32.lt_u
  b.byte(4); b.byte(64);               // if
  b.byte(32); b.u32leb(1);
  b.byte(63); b.byte(0);
  b.byte(107);                         // i32.sub
  b.byte(64); b.byte(0);               // memory.grow
  b.byte(26);                          // drop — the size answered below is what the caller reads
  b.byte(11);                          // end if

  // return memory.size << 16
  b.byte(63); b.byte(0);
  b.byte(65); b.i32leb(16); b.byte(116);
  b.byte(11);
  code.u32leb(b.len);
  code.bytes(b);
}

void emitStringSlice(B funcs, B code, Env env) {
  i32 at = env.arrayType("i8[]");
  funcs.u32leb(env.sigType("fn[string(string,i32,i32)]"));

  B b = B.create();
  b.u32leb(2);
  b.u32leb(3); b.byte(127);                // locals 3, 4, 5: the length and the clamped bounds
  b.u32leb(1); b.byte(99); b.i32leb(at);   // local 6: the result

  b.byte(32); b.u32leb(0); b.byte(251); b.u32leb(15);   // array.len
  b.byte(33); b.u32leb(3);

  // from, clamped up to 0 and down to the length.
  b.byte(65); b.i32leb(0);
  b.byte(32); b.u32leb(1);
  b.byte(32); b.u32leb(1); b.byte(65); b.i32leb(0); b.byte(72);   // from < 0
  b.byte(27);                                                     // select
  b.byte(33); b.u32leb(4);
  b.byte(32); b.u32leb(3);
  b.byte(32); b.u32leb(4);
  b.byte(32); b.u32leb(4); b.byte(32); b.u32leb(3); b.byte(74);   // a > len
  b.byte(27);
  b.byte(33); b.u32leb(4);

  // to, the same, and then never below from — a reversed range is empty rather than an error.
  b.byte(65); b.i32leb(0);
  b.byte(32); b.u32leb(2);
  b.byte(32); b.u32leb(2); b.byte(65); b.i32leb(0); b.byte(72);
  b.byte(27);
  b.byte(33); b.u32leb(5);
  b.byte(32); b.u32leb(3);
  b.byte(32); b.u32leb(5);
  b.byte(32); b.u32leb(5); b.byte(32); b.u32leb(3); b.byte(74);
  b.byte(27);
  b.byte(33); b.u32leb(5);
  b.byte(32); b.u32leb(4);
  b.byte(32); b.u32leb(5);
  b.byte(32); b.u32leb(5); b.byte(32); b.u32leb(4); b.byte(72);   // b < a
  b.byte(27);
  b.byte(33); b.u32leb(5);

  b.byte(32); b.u32leb(5); b.byte(32); b.u32leb(4); b.byte(107);  // n = b - a
  b.byte(251); b.u32leb(7); b.u32leb(at);                         // array.new_default
  b.byte(33); b.u32leb(6);
  b.byte(32); b.u32leb(6);
  b.byte(65); b.i32leb(0);
  b.byte(32); b.u32leb(0);
  b.byte(32); b.u32leb(4);
  b.byte(32); b.u32leb(5); b.byte(32); b.u32leb(4); b.byte(107);
  b.byte(251); b.u32leb(17); b.u32leb(at); b.u32leb(at);          // array.copy
  b.byte(32); b.u32leb(6);
  b.byte(11);
  code.u32leb(b.len);
  code.bytes(b);
}

/**
 * `i32 str_index_of(string hay, string needle)` — the first byte offset, or -1.
 *
 * The naive search, which is the one whose answers are easy to be sure of: every start position,
 * every byte, and an empty needle found immediately at 0.
 */
void emitStringIndexOf(B funcs, B code, Env env) {
  i32 at = env.arrayType("i8[]");
  funcs.u32leb(env.sigType("fn[i32(string,string)]"));

  B b = B.create();
  b.u32leb(1);
  b.u32leb(4); b.byte(127);   // locals 2..5: the two lengths and the two cursors

  b.byte(32); b.u32leb(0); b.byte(251); b.u32leb(15);
  b.byte(33); b.u32leb(2);
  b.byte(32); b.u32leb(1); b.byte(251); b.u32leb(15);
  b.byte(33); b.u32leb(3);

  b.byte(65); b.i32leb(0);
  b.byte(33); b.u32leb(4);

  // The outer loop over start positions, wrapped in a block so a failure can leave it with -1.
  b.byte(2); b.byte(64);            // block
  b.byte(3); b.byte(64);            // loop
  // Past the last position it could still fit at: not found.
  b.byte(32); b.u32leb(4); b.byte(32); b.u32leb(3); b.byte(106);
  b.byte(32); b.u32leb(2); b.byte(74);        // i + nl > hl
  b.byte(13); b.u32leb(1);                    // br_if out of the block
  b.byte(65); b.i32leb(0);
  b.byte(33); b.u32leb(5);
  // The inner comparison, in its own block so a mismatch can leave it.
  b.byte(2); b.byte(64);
  b.byte(3); b.byte(64);
  b.byte(32); b.u32leb(5); b.byte(32); b.u32leb(3); b.byte(78);   // j >= nl — matched
  b.byte(4); b.byte(64);
  b.byte(32); b.u32leb(4);
  b.byte(15);                                                     // return i
  b.byte(11);
  b.byte(32); b.u32leb(0);
  b.byte(32); b.u32leb(4); b.byte(32); b.u32leb(5); b.byte(106);
  b.byte(251); b.u32leb(13); b.u32leb(at);                        // hay[i + j]
  b.byte(32); b.u32leb(1);
  b.byte(32); b.u32leb(5);
  b.byte(251); b.u32leb(13); b.u32leb(at);                        // needle[j]
  b.byte(71);                                                     // i32.ne
  // **`1`, not `2`.** A branch counts labels outward from where it stands: 0 is the inner loop, 1
  // the inner block, 2 the *outer loop* — and branching there restarts the search at the same start
  // position without advancing it, which is a module that validates and never finishes.
  b.byte(13); b.u32leb(1);                                        // br_if out of the inner block
  b.byte(32); b.u32leb(5); b.byte(65); b.i32leb(1); b.byte(106);
  b.byte(33); b.u32leb(5);
  b.byte(12); b.u32leb(0);                                        // br to the inner loop
  b.byte(11);
  b.byte(11);
  b.byte(32); b.u32leb(4); b.byte(65); b.i32leb(1); b.byte(106);
  b.byte(33); b.u32leb(4);
  b.byte(12); b.u32leb(0);                                        // br to the outer loop
  b.byte(11);
  b.byte(11);
  b.byte(65); b.i32leb(-1);
  b.byte(11);
  code.u32leb(b.len);
  code.bytes(b);
}
/**
 * `string str_fromcp(i32 cp)` — the one-character string whose scalar is `cp`, UTF-8 encoded.
 *
 * The only way to reach a character that is not already written down somewhere, and the reason a
 * codepoint arithmetic routine can be written in wac at all. It **traps** rather than substituting a
 * replacement character, which is what the language says, and which makes the range tests below a
 * decision rather than a guess.
 */
void emitStringFromCp(B funcs, B code, Env env) {
  i32 at = env.arrayType("i8[]");
  funcs.u32leb(env.sigType("fn[string(i32)]"));

  B b = B.create();
  b.u32leb(1);
  b.u32leb(1); b.byte(99); b.i32leb(at);   // local 1: the result

  // Out of range, or half of a surrogate pair, which is not a scalar value.
  b.byte(32); b.u32leb(0); b.byte(65); b.i32leb(1114111); b.byte(74);   // i32.gt_s
  b.byte(32); b.u32leb(0); b.byte(65); b.i32leb(0); b.byte(72);         // i32.lt_s
  b.byte(114);
  b.byte(32); b.u32leb(0); b.byte(65); b.i32leb(55296); b.byte(79);     // >= 0xD800
  b.byte(32); b.u32leb(0); b.byte(65); b.i32leb(57344); b.byte(73);     // <  0xE000
  b.byte(113);
  b.byte(114);
  b.byte(4); b.byte(64);
  b.byte(0);                                                            // unreachable
  b.byte(11);

  // One byte: 0xxxxxxx.
  b.byte(32); b.u32leb(0); b.byte(65); b.i32leb(128); b.byte(73);
  b.byte(4); b.byte(64);
  b.byte(65); b.i32leb(1); b.byte(251); b.u32leb(7); b.u32leb(at);
  b.byte(33); b.u32leb(1);
  b.byte(32); b.u32leb(1); b.byte(65); b.i32leb(0); b.byte(32); b.u32leb(0);
  b.byte(251); b.u32leb(14); b.u32leb(at);
  b.byte(32); b.u32leb(1); b.byte(15);
  b.byte(11);

  // Two bytes: 110xxxxx 10xxxxxx.
  b.byte(32); b.u32leb(0); b.byte(65); b.i32leb(2048); b.byte(73);
  b.byte(4); b.byte(64);
  b.byte(65); b.i32leb(2); b.byte(251); b.u32leb(7); b.u32leb(at);
  b.byte(33); b.u32leb(1);
  b.byte(32); b.u32leb(1); b.byte(65); b.i32leb(0);
  b.byte(32); b.u32leb(0); b.byte(65); b.i32leb(6); b.byte(118);        // i32.shr_u
  b.byte(65); b.i32leb(192); b.byte(114);
  b.byte(251); b.u32leb(14); b.u32leb(at);
  b.byte(32); b.u32leb(1); b.byte(65); b.i32leb(1);
  b.byte(32); b.u32leb(0); b.byte(65); b.i32leb(63); b.byte(113);
  b.byte(65); b.i32leb(128); b.byte(114);
  b.byte(251); b.u32leb(14); b.u32leb(at);
  b.byte(32); b.u32leb(1); b.byte(15);
  b.byte(11);

  // Three bytes: 1110xxxx 10xxxxxx 10xxxxxx.
  b.byte(32); b.u32leb(0); b.byte(65); b.i32leb(65536); b.byte(73);
  b.byte(4); b.byte(64);
  b.byte(65); b.i32leb(3); b.byte(251); b.u32leb(7); b.u32leb(at);
  b.byte(33); b.u32leb(1);
  b.byte(32); b.u32leb(1); b.byte(65); b.i32leb(0);
  b.byte(32); b.u32leb(0); b.byte(65); b.i32leb(12); b.byte(118);
  b.byte(65); b.i32leb(224); b.byte(114);
  b.byte(251); b.u32leb(14); b.u32leb(at);
  b.byte(32); b.u32leb(1); b.byte(65); b.i32leb(1);
  b.byte(32); b.u32leb(0); b.byte(65); b.i32leb(6); b.byte(118);
  b.byte(65); b.i32leb(63); b.byte(113); b.byte(65); b.i32leb(128); b.byte(114);
  b.byte(251); b.u32leb(14); b.u32leb(at);
  b.byte(32); b.u32leb(1); b.byte(65); b.i32leb(2);
  b.byte(32); b.u32leb(0); b.byte(65); b.i32leb(63); b.byte(113);
  b.byte(65); b.i32leb(128); b.byte(114);
  b.byte(251); b.u32leb(14); b.u32leb(at);
  b.byte(32); b.u32leb(1); b.byte(15);
  b.byte(11);

  // Four bytes: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx.
  b.byte(65); b.i32leb(4); b.byte(251); b.u32leb(7); b.u32leb(at);
  b.byte(33); b.u32leb(1);
  b.byte(32); b.u32leb(1); b.byte(65); b.i32leb(0);
  b.byte(32); b.u32leb(0); b.byte(65); b.i32leb(18); b.byte(118);
  b.byte(65); b.i32leb(240); b.byte(114);
  b.byte(251); b.u32leb(14); b.u32leb(at);
  b.byte(32); b.u32leb(1); b.byte(65); b.i32leb(1);
  b.byte(32); b.u32leb(0); b.byte(65); b.i32leb(12); b.byte(118);
  b.byte(65); b.i32leb(63); b.byte(113); b.byte(65); b.i32leb(128); b.byte(114);
  b.byte(251); b.u32leb(14); b.u32leb(at);
  b.byte(32); b.u32leb(1); b.byte(65); b.i32leb(2);
  b.byte(32); b.u32leb(0); b.byte(65); b.i32leb(6); b.byte(118);
  b.byte(65); b.i32leb(63); b.byte(113); b.byte(65); b.i32leb(128); b.byte(114);
  b.byte(251); b.u32leb(14); b.u32leb(at);
  b.byte(32); b.u32leb(1); b.byte(65); b.i32leb(3);
  b.byte(32); b.u32leb(0); b.byte(65); b.i32leb(63); b.byte(113);
  b.byte(65); b.i32leb(128); b.byte(114);
  b.byte(251); b.u32leb(14); b.u32leb(at);
  b.byte(32); b.u32leb(1);
  b.byte(11);
  code.u32leb(b.len);
  code.bytes(b);
}
/**
 * `i32 str_cmp(string a, string b)` — -1, 0 or 1, lexicographically **by bytes**, which is what the
 * specification says and what makes UTF-8 compare in codepoint order for free.
 *
 * A prefix is less than what extends it, so the lengths decide once the shared bytes agree.
 */
void emitStringCompare(B funcs, B code, Env env) {
  i32 at = env.arrayType("i8[]");
  funcs.u32leb(env.sigType("fn[i32(string,string)]"));

  B b = B.create();
  b.u32leb(1);
  b.u32leb(3); b.byte(127);   // locals 2, 3, 4: the two lengths and the cursor

  b.byte(32); b.u32leb(0); b.byte(251); b.u32leb(15);
  b.byte(33); b.u32leb(2);
  b.byte(32); b.u32leb(1); b.byte(251); b.u32leb(15);
  b.byte(33); b.u32leb(3);
  b.byte(65); b.i32leb(0);
  b.byte(33); b.u32leb(4);

  b.byte(2); b.byte(64);      // block
  b.byte(3); b.byte(64);      // loop
  // Past the end of either one: the shared bytes agreed, so the lengths decide.
  b.byte(32); b.u32leb(4); b.byte(32); b.u32leb(2); b.byte(78);   // i >= alen
  b.byte(13); b.u32leb(1);
  b.byte(32); b.u32leb(4); b.byte(32); b.u32leb(3); b.byte(78);   // i >= blen
  b.byte(13); b.u32leb(1);
  b.byte(32); b.u32leb(0); b.byte(32); b.u32leb(4);
  b.byte(251); b.u32leb(13); b.u32leb(at);                        // a[i], unsigned
  b.byte(32); b.u32leb(1); b.byte(32); b.u32leb(4);
  b.byte(251); b.u32leb(13); b.u32leb(at);                        // b[i]
  b.byte(71);                                                     // i32.ne
  // A **void** `if` that returns, rather than one promising a value: the branch that finds a
  // difference leaves through `return`, and the branch that does not has nothing to say. Writing it
  // as an `if -> i32` meant the second arm had to produce a number it would immediately drop, and
  // wasm counted the stack at the end of the function and found it empty.
  b.byte(4); b.byte(64);
  b.byte(32); b.u32leb(0); b.byte(32); b.u32leb(4);
  b.byte(251); b.u32leb(13); b.u32leb(at);
  b.byte(32); b.u32leb(1); b.byte(32); b.u32leb(4);
  b.byte(251); b.u32leb(13); b.u32leb(at);
  b.byte(73);                                                     // i32.lt_u
  b.byte(4); b.byte(127);
  b.byte(65); b.i32leb(0 - 1);
  b.byte(5);
  b.byte(65); b.i32leb(1);
  b.byte(11);
  b.byte(15);                                                     // return it
  b.byte(11);
  b.byte(32); b.u32leb(4); b.byte(65); b.i32leb(1); b.byte(106);
  b.byte(33); b.u32leb(4);
  b.byte(12); b.u32leb(0);
  b.byte(11);
  b.byte(11);
  // The shorter is the smaller, and equal lengths with equal bytes are equal strings.
  b.byte(32); b.u32leb(2); b.byte(32); b.u32leb(3); b.byte(72);   // alen < blen
  b.byte(4); b.byte(127);
  b.byte(65); b.i32leb(0 - 1);
  b.byte(5);
  b.byte(32); b.u32leb(2); b.byte(32); b.u32leb(3); b.byte(74);   // alen > blen
  b.byte(4); b.byte(127);
  b.byte(65); b.i32leb(1);
  b.byte(5);
  b.byte(65); b.i32leb(0);
  b.byte(11);
  b.byte(11);
  b.byte(11);
  code.u32leb(b.len);
  code.bytes(b);
}

/**
 * `string str_idx(string s, i32 i)` — the codepoint starting at byte `i`, as a one-character string.
 *
 * Indexing a string is a **decode**, not a read: the lead byte says how many bytes the character is,
 * a byte in the middle of a sequence is `""` rather than half a character, and an index past the end
 * traps — which `array.get` does on its own, so the bounds check is the instruction.
 */
void emitStringIndex(B types, B funcs, B code, Env env, i32 index, i32 declTypes) {
  i32 at = env.arrayType("i8[]");

  funcs.u32leb(env.sigType("fn[string(string,i32)]"));

  B b = B.create();
  b.u32leb(2);
  b.u32leb(2); b.byte(127);              // locals 2, 3: the lead byte and the character's length
  b.u32leb(1); b.byte(99); b.i32leb(at); // local 4: the result

  // lead = s[i] — and this is the bounds check, since `array.get` traps on its own.
  b.byte(32); b.u32leb(0);
  b.byte(32); b.u32leb(1);
  b.byte(251); b.u32leb(13);  // array.get_u
  b.u32leb(at);
  b.byte(33); b.u32leb(2);

  b.byte(65); b.i32leb(0);
  b.byte(33); b.u32leb(3);

  // 0xxxxxxx is one byte, 110xxxxx two, 1110xxxx three, 11110xxx four. Anything else — a
  // continuation byte, or a lead byte UTF-8 never uses — leaves the length at zero.
  b.byte(32); b.u32leb(2); b.byte(65); b.i32leb(128); b.byte(73);   // i32.lt_u
  b.byte(4); b.byte(64);
  b.byte(65); b.i32leb(1); b.byte(33); b.u32leb(3);
  b.byte(11);

  b.byte(32); b.u32leb(2); b.byte(65); b.i32leb(192); b.byte(79);   // i32.ge_u
  b.byte(32); b.u32leb(2); b.byte(65); b.i32leb(224); b.byte(73);
  b.byte(113);                                                      // i32.and
  b.byte(4); b.byte(64);
  b.byte(65); b.i32leb(2); b.byte(33); b.u32leb(3);
  b.byte(11);

  b.byte(32); b.u32leb(2); b.byte(65); b.i32leb(224); b.byte(79);
  b.byte(32); b.u32leb(2); b.byte(65); b.i32leb(240); b.byte(73);
  b.byte(113);
  b.byte(4); b.byte(64);
  b.byte(65); b.i32leb(3); b.byte(33); b.u32leb(3);
  b.byte(11);

  b.byte(32); b.u32leb(2); b.byte(65); b.i32leb(240); b.byte(79);
  b.byte(32); b.u32leb(2); b.byte(65); b.i32leb(248); b.byte(73);
  b.byte(113);
  b.byte(4); b.byte(64);
  b.byte(65); b.i32leb(4); b.byte(33); b.u32leb(3);
  b.byte(11);

  // Nothing to copy — a mid-sequence byte, or a sequence that runs off the end.
  b.byte(32); b.u32leb(3); b.byte(69);                              // i32.eqz
  b.byte(32); b.u32leb(1); b.byte(32); b.u32leb(3); b.byte(106);    // i + n
  b.byte(32); b.u32leb(0); b.byte(251); b.u32leb(15);               // array.len
  b.byte(74);                                                       // i32.gt_s
  b.byte(114);                                                      // i32.or
  b.byte(4); b.byte(64);
  b.byte(65); b.i32leb(0);
  b.byte(251); b.u32leb(7); b.u32leb(at);                           // array.new_default
  b.byte(15);                                                       // return
  b.byte(11);

  b.byte(32); b.u32leb(3);
  b.byte(251); b.u32leb(7); b.u32leb(at);
  b.byte(33); b.u32leb(4);
  b.byte(32); b.u32leb(4);
  b.byte(65); b.i32leb(0);
  b.byte(32); b.u32leb(0);
  b.byte(32); b.u32leb(1);
  b.byte(32); b.u32leb(3);
  b.byte(251); b.u32leb(17); b.u32leb(at); b.u32leb(at);            // array.copy
  b.byte(32); b.u32leb(4);
  b.byte(11);
  code.u32leb(b.len);
  code.bytes(b);
}

/**
 * `to(from)` — a copy between two array types of the same shape.
 *
 * `string` and `u8[]` hold the same bytes and are *different types*, which is why this is a copy and
 * not the no-op it looks like. One function serves both directions, because the only difference is
 * which type index goes where.
 */
void emitBytesCopy(B types, B funcs, B code, Env env, i32 index, i32 declTypes, string to, string from) {
  i32 dst = env.arrayType(to);
  i32 srcT = env.arrayType(from);

  funcs.u32leb(env.sigType(to == "u8[]" ? "fn[u8[](string)]" : "fn[string(u8[])]"));

  B b = B.create();
  b.u32leb(2);
  b.u32leb(1); b.byte(127);
  b.u32leb(1); b.byte(99); b.u32leb(dst);

  b.byte(32); b.u32leb(0); b.byte(251); b.u32leb(15);
  b.byte(33); b.u32leb(1);
  b.byte(32); b.u32leb(1);
  b.byte(251); b.u32leb(7); b.u32leb(dst);
  b.byte(33); b.u32leb(2);
  b.byte(32); b.u32leb(2);
  b.byte(65); b.i32leb(0);
  b.byte(32); b.u32leb(0);
  b.byte(65); b.i32leb(0);
  b.byte(32); b.u32leb(1);
  b.byte(251); b.u32leb(17); b.u32leb(dst); b.u32leb(srcT);
  b.byte(32); b.u32leb(2);
  b.byte(11);
  code.u32leb(b.len);
  code.bytes(b);
}

/** Whether a receiver is the *type name* `string`, as in `string.fromBytes(b)`. */
bool isStringTypeName(u8[] src, Lexed lexed, Env env, Expr obj) {
  match (obj.kind) {
    case Ident(tok): {
      string n = tokenTextOf(src, lexed, tok);
      // A local of that name would be a value, and shadowing wins — the same order every receiver
      // question in this emitter uses.
      if (env.localAt(n) >= 0 || env.constAt(n) >= 0) { return false; }
      return n == "string";
    }
    else: { return false; }
  }
}

/** A token's kind, which the cast rules need because the operator decides the conversion. */
i32 tokenKindOf(Lexed lexed, i32 t) { return lexed.tokens[t * tokenStride()]; }

/**
 * Clamp a value into the target's range, then narrow.
 *
 * The two comparisons use the **source's** signedness and the **target's** bounds, which is the pair
 * that was wrong: a `u64` source compared with `i64.lt_s` made every small value look negative and
 * pinned it to the target's minimum. `0 as! i32` came out as `i32` min.
 */
void emitSaturate(B fb, Env env, string from, string to) {
  i32 tmp = env.scratch(from);
  bool wide = valType(from) == 126;

  // **A sign change at the same width needs one clamp, not two**, and which one depends on the
  // direction. Going signed to unsigned, only a negative is out of range — every non-negative fits.
  // Going the other way, only a value above the signed maximum is. Trying to use the target's *other*
  // bound is meaningless: it is not representable in the source's signedness, and comparing against
  // it produced `0 as! u32 == u32 max`.
  if (valType(from) == valType(to)) {
    fb.byte(34);
    fb.u32leb(tmp);
    if (isUnsigned(to)) {
      emitBound(fb, wide, 0);
      fb.byte(wide ? 83 : 72);        // lt_s — is it negative
      fb.byte(4); fb.byte(wide ? 126 : wasmI32());
      emitBound(fb, wide, 0);
      fb.byte(5);
      fb.byte(32); fb.u32leb(tmp);
      fb.byte(11);
      return;
    }
    emitBound(fb, wide, upperBound(to));
    fb.byte(wide ? 86 : 75);          // gt_u — is it above the signed maximum
    fb.byte(4); fb.byte(wide ? 126 : wasmI32());
    emitBound(fb, wide, upperBound(to));
    fb.byte(5);
    fb.byte(32); fb.u32leb(tmp);
    fb.byte(11);
    return;
  }

  // Narrowing: both of the target's bounds fit in the source's width, so both are compared — with the
  // source's signedness, and with the lower one skipped for an unsigned source, which can never be
  // below it.
  bool u = isUnsigned(from);
  fb.byte(34);
  fb.u32leb(tmp);
  emitBound(fb, wide, upperBound(to));
  fb.byte(wide ? (u ? 86 : 85) : (u ? 75 : 74));
  fb.byte(4);
  fb.byte(wasmI32());
  emitI32Const(fb, upperBound(to));
  fb.byte(5);
  if (u) {
    fb.byte(32); fb.u32leb(tmp);
    if (wide) { fb.byte(167); }
    fb.byte(11);
    return;
  }
  fb.byte(32); fb.u32leb(tmp);
  emitBound(fb, wide, lowerBound(to));
  fb.byte(wide ? 83 : 72);
  fb.byte(4);
  fb.byte(wasmI32());
  emitI32Const(fb, lowerBound(to));
  fb.byte(5);
  fb.byte(32); fb.u32leb(tmp);
  if (wide) { fb.byte(167); }
  fb.byte(11);
  fb.byte(11);
}

/** A bound at the source's width, so the comparison's two operands agree. */
void emitBound(B fb, bool wide, i64 v) {
  if (wide) { fb.byte(66); fb.i64leb(v); }
  else { fb.byte(65); fb.i32leb(v as@ i32); }
}
