// Rung 3, first slice: the type of a returned literal against the function's declared return type.
//
// The rung is 3,190 reference lines and ~210 distinct messages. This is one of them, chosen because
// it is the smallest diagnostic that still needs everything a type checker needs — a declaration
// walked for its signature, a body walked for a statement nested arbitrarily deep, a type inferred
// from an expression, the two compared, and a position reported that a caller can point at.
//
// ## Two rules, because the language has two
//
// A returned **name** must have the declared type *exactly*: `return p` where `p` is an `i64` is an
// error from an `i32` function, and `f32` from `f64` is too. A returned **literal** is not a value of
// some type that has to match — it is polymorphic over a family, and any of `i32 i64 u32 u64` accepts
// an integer literal.
//
// Modelling only the family is what the first version did, and the parameter grid found it: 58 of 72
// rejections caught, the missing fourteen all within a family. Modelling only exact types would be
// worse, because it would report `return 1` from an `i64` as an error the reference does not.
//
// ## Why a subset is the point
//
// Everything this slice cannot type — a call, a member, arithmetic, a name from another module — is
// silence rather than a guess. It reports a subset of the reference and never a superset, which is
// the only property that lets a partial checker be compared against a complete one at all.
//
// ## Positions
//
// The reference reports the **returned expression**, not the `return` keyword:
//
//     export i32 main() { return "x"; }
//     return: expected i32, found string   @ 1:28
//
// Column 28 is the `"`, column 21 is the `r` of `return`. Every AST node here carries its own line
// and column, so this is `e.line, e.col` and not arithmetic.

import { lex, tokenStride } from "./lex.wac";
import { floatLit, parseInt } from "./lit.wac";
import { isBuiltinSpec } from "./coretext.wac";
import {
  kPlus, kMinus, kStar, kSlash, kPercent, kAnd, kOr, kCaret,
  kLt, kLe, kGt, kGe, kEq, kNe, kAndAnd, kOrOr, kAssign, kBang,
  kAs, kAsBang, kAsTilde, kAsAt, kShrU, kShl, kShr, kTilde, kShlEq, kShrEq, kShrUEq,
} from "./kinds.wac";
import {
  Arm, Decl, DeclKind, Expr, ExprKind, JsxAttr, Lvalue, LvalueKind, Method, NamedArg, Param, Program,
  Stmt, StmtKind, Ty, TyKind, tyPrim,
} from "./ast.wac";

/** A returned value whose type cannot be the declared one. */
export i32 errReturnTypeMismatch() { return 1; }
/** A non-void function that can reach its closing brace. */
export i32 errMissingReturn() { return 2; }
/**
 * A variable initialised with something that cannot be its declared type.
 *
 * A separate code from the return mismatch because the reference words them differently — *"type
 * mismatch: expected i32, got string"* against *"return: expected i32, found string"* — and rung 3's
 * comparison is by code and position, so two families that a caller could tell apart should not
 * arrive here as one.
 */
export i32 errInitTypeMismatch() { return 3; }
/** Two operands of an arithmetic operator that are not the same type. */
export i32 errOperandMismatch() { return 4; }
/** An argument that cannot be the parameter it is passed to. */
export i32 errArgumentMismatch() { return 5; }
/**
 * An expression that has to be `bool` and is not.
 *
 * Two of the reference's messages, kept as one code because they are one rule in two positions:
 * *"'&&' requires bool operands, got i32"* and *"condition must be bool"*. Both say the same thing —
 * this expression is used where only a boolean can go — and nothing a caller does with the diagnostic
 * would distinguish them.
 */
export i32 errNotBool() { return 6; }
/** `==` or `!=` on a reference type, where the language wants `is`. */
export i32 errNotComparable() { return 7; }
/** A construction argument that cannot be the field it fills. */
export i32 errFieldMismatch() { return 8; }
/** A nullable value where a non-null one is required. */
export i32 errNullableToNonNull() { return 9; }
/**
 * The three ways a write can be refused, kept apart because the reference keeps them apart.
 *
 * *"cannot assign to const variable 'n'"*, *"cannot write to const field 'k'"* and *"cannot write
 * through const reference"* say different things about where the constness lives — on the binding,
 * on the field, or on the path to it — and a caller fixing one would not fix the others.
 */
export i32 errConstVariable() { return 10; }
export i32 errConstField() { return 11; }
export i32 errConstReference() { return 12; }
/** A static method that the struct does not have. */
export i32 errNoStaticMethod() { return 13; }
/** An instance method that the struct does not have. */
export i32 errNoMethod() { return 14; }
/** A non-const method called through a const receiver. */
export i32 errNonConstThroughConst() { return 15; }
/** A cast written with an operator the conversion does not take. */
export i32 errWrongCastOp() { return 16; }
/** Two parameters of one function with the same name. */
export i32 errDuplicateParam() { return 17; }
/** An array element or fill that cannot be the array's element type. */
export i32 errArrayElement() { return 18; }
/** A builtin called with the wrong number of arguments. */
export i32 errBuiltinArity() { return 19; }
/** A builtin argument of the wrong type. */
export i32 errBuiltinArg() { return 20; }
/** A name used where nothing declares it. */
export i32 errUndefinedName() { return 35; }
/** A `void` where a type is needed. */
export i32 errVoidType() { return 36; }
/** A `return` that disagrees with the function's own `void`ness, either way. */
export i32 errReturnValueness() { return 37; }
/** An operator given something it cannot work on. */
export i32 errOperandKind() { return 38; }
/** A field read from something that has no such field, or no fields at all. */
export i32 errNoSuchField() { return 39; }
/** A member reached through a nullable without unwrapping it. */
export i32 errThroughNullable() { return 40; }
/** An index into something that is not an array, or with something that is not an index. */
export i32 errIndex() { return 41; }
/**
 * Indexing something that is neither an array nor a string.
 *
 * Split from `errIndex`, whose message is *"an index must be an integer"* — true when the index is the
 * problem and false when the *operand* is: `n[0]` on an `i32` denied that `0` is an integer, which it
 * plainly is. The comment at the lvalue site already knew there were two complaints, *"the 'not an
 * array' one names the operand and the 'bad index' one names the index"*, and they shared one sentence.
 * `issues/lang/0240a`.
 */
export i32 errNotIndexable() { return 206; }
/** A ternary whose branches cannot be the same type. */
export i32 errTernaryBranches() { return 42; }
/** `is` or `!` applied to something the question does not make sense for. */
export i32 errReferenceOp() { return 43; }
/**
 * `!` applied to something that is not nullable.
 *
 * Split from `errReferenceOp`, which says *"this operator needs a reference"* — true for `is` on a
 * primitive, and false for `p!` on a non-nullable `P`, which **is** a reference. A message that denies
 * something the program has sends the reader to the wrong place. `issues/lang/0237a`.
 */
export i32 errNeedsNullable() { return 203; }
/** A `switch` on something it cannot switch on. */
export i32 errSwitchSubject() { return 44; }
/** A named construction naming a field the struct does not have, or leaving one out. */
export i32 errNamedField() { return 45; }
/** A float literal too large for the type it is going into. */
export i32 errFloatRange() { return 50; }
/** `E.nope` where `E` is an enum and `nope` is none of its variants. */
export i32 errNoVariant() { return 51; }
/** An import specifier that is a bare word other than `core` — `spec/spec/imports.md`. */
export i32 errUnknownModule() { return 52; }
/**
 * A quoted import specifier naming a file the caller did not supply.
 *
 * Distinct from `errUnknownModule`, which is a *bare* word — a specifier that names no tree. This
 * one names a path and there is nothing at it. It was caught a phase later, by the linker, through a
 * sentinel with no position and no file name, so every checker entry point reported the program was
 * fine. `issues/lang/0157`.
 *
 * The list of unresolved specifiers is handed to `C` rather than computed here, because resolving a
 * specifier needs the caller's path map and `isBuiltinSpec` — but the *diagnostic* belongs to the
 * checking phase, at the import's own token, which is what `spec/spec/errors.md` requires of a
 * phase field.
 */
export i32 errMissingImportFile() { return 77; }
/** A generic that instantiates itself with a larger argument, so it never terminates. */
export i32 errInfiniteGeneric() { return 53; }
/** An enum method whose name is one of the enum's own variants: `E.A` would mean both. */
export i32 errVariantMethodClash() { return 54; }
/** Two imports of the same name, or an import colliding with a name this file declares. */
export i32 errDuplicateImport() { return 55; }
/**
 * An import of a name the named file does not export — either because it is declared without
 * `export`, or because that file only imports it itself. Importing does not re-export
 * (`§wac-no-reexport-f7kn4wq`), which is the rule that keeps a file's exports its own to state.
 */
export i32 errNoSuchExport() { return 56; }
/**
 * A type name written in a file that never brought it into scope — `§wac-type-name-scope-8vqk3mn`.
 * A variant imports like any other name, so `x is Circle` needs `Circle` imported just as `K k`
 * needs `K`.
 */
export i32 errUndefinedType() { return 57; }

/**
 * Warning codes, numbered from 200 so they cannot be confused with an error's at a glance in a wire
 * dump — the two travel in the same shape and are counted separately. `issues/lang/0126`.
 */
export i32 warnNeverNull() { return 200; }
export i32 warnNeverThat() { return 201; }
export i32 warnAlwaysTraps() { return 202; }
/** A `match` that leaves one of the enum's variants uncovered and has no `else`. */
export i32 errMatchInexhaustive() { return 58; }
/** Two arms of one `match` naming the same variant. */
export i32 errDuplicateCase() { return 59; }
/** An `else` on a `match` whose arms already cover every variant. */
export i32 errElseUnreachable() { return 60; }
/**
 * A `match` with more than one `else` arm.
 *
 * A code of its own rather than `errDuplicateCase`, whose message names a *variant* — an `else` is not
 * one, and the reference keeps them apart too (`duplicate else arm`). Before this the checker said
 * nothing and the build **trapped**: `array element access out of bounds`, then a null dereference,
 * naming `packages/wac/src/wac.wac` rather than the program. `issues/lang/0239a`.
 */
export i32 errDuplicateElse() { return 204; }
/** A `case` that binds one name twice, where the later binding silently won. `issues/lang/0239a`. */
export i32 errDuplicateBinding() { return 205; }
/** An arm binding named after the subject it is matching: inside the arm the two would be one name. */
export i32 errBindingCollision() { return 61; }
/** A `match` on a nullable value — there is no variant for the null. */
export i32 errMatchNullable() { return 62; }
/** Two arms of a `match` used as an expression whose values are of unrelated types. */
export i32 errArmTypes() { return 63; }

/** A cast between two types that are already the same. */
export i32 errRedundantCast() { return 46; }
/** Calling something that is not a function, or naming something that does not exist to call. */
export i32 errNotCallable() { return 47; }
/** A method named without calling it. */
export i32 errMethodAsValue() { return 48; }
/** A type's name — a struct, an enum or a primitive — used where a value belongs. */
export i32 errTypeAsValue() { return 49; }
/** A method that hides a parent's without saying `override`. */
export i32 errOverrideMissing() { return 21; }
/** `override` on a method no parent declares. */
export i32 errOverrideSpurious() { return 22; }
/** `++` or `--` on something that is not an integer. */
export i32 errIncrType() { return 23; }
/** `>>>` on a type where it says nothing, or on a non-integer. */
export i32 errShiftOp() { return 24; }
/** Positional construction with the wrong number of arguments. */
export i32 errCtorArity() { return 25; }
/** A packed type in a position that has no slot for one. */
export i32 errPackedPosition() { return 26; }
/** A write through a string index — strings are immutable. */
export i32 errStringIndexWrite() { return 27; }
/** A default construction of something that has no default value. */
export i32 errNoDefault() { return 28; }
/** A non-null field that refers back to its own struct. */
export i32 errRecursiveField() { return 29; }
/** `as` where the conversion is a downcast and may fail. */
export i32 errDowncast() { return 30; }
/** `break` or `continue` with nothing to leave. */
export i32 errNoLoop() { return 31; }
/** A call with the wrong number of arguments. */
export i32 errCallArity() { return 32; }
/** A nullable packed type, which has no representation. */
export i32 errPackedNullable() { return 33; }
/** A module-level `const` whose value cannot be computed at compile time. */
export i32 errNotCompileTime() { return 34; }
/** Two declarations of one name at file scope. */
export i32 errDuplicateName() { return 64; }
/** Two fields, two methods, or a field and a method of one name in one struct. */
export i32 errDuplicateMember() { return 65; }
/** A character literal holding none or more than one character. */
export i32 errCharLiteral() { return 66; }
/** A `switch` with two `default` clauses. */
export i32 errTwoDefaults() { return 67; }
/**
 * A JSX element whose closing tag names something else — `<div></span>`.
 *
 * wacc-only, as JSX is: `design/lang/0004`. Its own code rather than a borrowed one, because the
 * text a reader sees comes from the code and "that file does not export this name" is about
 * something else entirely.
 */
export i32 errJsxTagMismatch() { return 68; }
/**
 * The same attribute written twice on one element — `<div class="a" class="b"/>`.
 *
 * Refused rather than resolved, which is this language's habit: a switch with two defaults and a
 * struct with two members of one name are both errors, and the tree cannot express precedence
 * either. HTML would take one of them and say nothing, which is the behaviour to *not* inherit.
 */
export i32 errJsxDuplicateAttr() { return 69; }
/**
 * A tag naming a struct that is not a component — one with no `Node render(const this, Node[] kids)`.
 *
 * A tag that names a struct in scope *is* a component (`design/lang/0005`), so this is what says the
 * struct cannot serve as one. It names the signature rather than saying "not a component", because
 * the fix is almost always to write that method or to correct its shape.
 */
export i32 errJsxNotComponent() { return 70; }
/**
 * A generic enum's variant where nothing says which instantiation it is.
 *
 * `Maybe.Just(4)` takes its type arguments from the expected type, and every position has one except
 * a receiver: `Maybe.Just(4).orElse(0)`. The emitter declines that with `unresolved name Maybe`,
 * which names a type that is defined and sends the reader looking for a typo. `issues/lang/0088`.
 */
export i32 errGenericVariantSlot() { return 71; }
/** `match` on a value that is not an enum, which has no variants to have arms for. */
export i32 errMatchNotEnum() { return 72; }
/**
 * A lambda where nothing wanted a funcref — `i32 g = () => 42;`.
 *
 * Its own code because it is the one lambda mistake the ordinary mismatch machinery cannot report:
 * a lambda has no type of its own, `typeOfExpr` answers unknown for one, and unknown is assignable
 * to everything. So the caller's `assignable` agrees and says nothing — which is how all five of the
 * wrong programs in `test/wac/lambda_test.wac` were accepted before `checkLambda` existed.
 */
export i32 errLambdaNoTarget() { return 73; }
/** A lambda whose parameters do not match the funcref it is being used as, in count or in type. */
export i32 errLambdaSignature() { return 74; }

/**
 * A call to a method that declares its own type parameters.
 *
 * The **declaration** is legal and the syntax parses; what is missing is inference — nothing works out
 * the method's type arguments from the call, and nothing emits one function per set of them. Reported
 * here rather than left to fall out downstream: the first thing that noticed was the lambda argument,
 * which answered *"nothing here wants a function"* about a lambda that is fine, because the parameter
 * it was being checked against is written in a letter nobody has bound.
 */
export i32 errMethodTypeParams() { return 75; }

/**
 * `case C(p, q)` where `C` carries one field: the arm binds names the variant does not have.
 *
 * The reference reports it at the `case` keyword and only when the count is *non-zero* and wrong —
 * binding nothing is how a payload is ignored, and `case C(_)` binds one name that happens to be a
 * discard. Measured against it before writing this, because "fewer names than fields" is the half a
 * reader would guess is allowed and is not.
 *
 * Silent when the arm's variant is not one this enum owns: that is the provenance question the rules
 * around it already refuse to guess at.
 */
export i32 errArmBindArity() { return 76; }

/**
 * How many bytes the first character of `s` takes, read from its lead byte.
 *
 * The same four ranges `str_idx` decodes with, and here for the same reason: "one character" is a
 * question about an encoding, not about a length.
 */
i32 utf8Width(string s) {
  u8[] b = s.toBytes();
  if (b.len() == 0) { return 0; }
  i32 lead = b[0];
  if (lead < 128) { return 1; }
  if (lead < 224) { return 2; }
  if (lead < 240) { return 3; }
  return 4;
}

/**
 * A type is its **canonical name**: `"i32"`, `"P"`, or `""` for one this slice cannot name.
 *
 * It was a small integer per primitive, which was enough while every type was a primitive and became
 * the limit the moment structs mattered. A name costs a string compare where an id cost an integer
 * one, and buys the whole rest of the type system for nothing: two struct types differ exactly when
 * their names do, and "is this a reference type" is "is this name not a primitive".
 *
 * `""` is *unknown*, and unknown is silence. That is different from a type that exists and fits
 * nothing — `u8` cannot be a return type at all — which is a primitive with a name like any other and
 * is refused by `acceptsLiteral` and by never equalling anything a caller can produce.
 */
export string typeNone() { return ""; }

/** Whether a name is one of the language's primitives, as opposed to a struct, enum or import. */
export bool isPrimitiveName(string n) {
  return n == "i32" || n == "i64" || n == "u32" || n == "u64" ||
         n == "f32" || n == "f64" || n == "bool" || n == "string" ||
         n == "u8" || n == "u16" || n == "i8" || n == "i16";
}

/**
 * Whether `==` and `!=` are allowed on this type.
 *
 * They are not, on a reference type: the reference answers `'==' not allowed on reference type P —
 * use 'is' for identity`, and it says so even when both sides are the same `P`, because the question
 * is identity rather than equality. `string` is the exception the language makes — two strings
 * compare by value — which is why this asks about the name rather than about reference-ness.
 */
/**
 * Whether a function with this return type must return a value.
 *
 * `void` is the only type that means *no value*, and under the old id model it came back as "unknown"
 * and so was excluded by accident. Now that a type is its name, `void` is a name like any other and
 * has to be excluded on purpose — which is better, because the exclusion is now a statement about
 * `void` rather than a side effect of not modelling it.
 */
export bool returnsAValue(string n) { return n != "" && n != "void"; }

/**
 * Whether `from` to `to` loses nothing, so plain `as` is the operator.
 *
 * Measured, not derived. There is no tidy formula: `u32 -> u64` is lossless and `i32 -> u64` is not,
 * because the first cannot be negative; `f32 -> f64` is and `i64 -> f64` is not, because 53 bits of
 * mantissa do not hold 64 of integer. A rule invented to cover the first six would have been wrong
 * about the seventh, so this is the set the reference agrees to, and the grid in
 * `test/wac/typecheck_test.wac` re-derives it from the reference on every run rather than trusting it.
 */
bool losslessCast(string from, string to) {
  // A `bool` widens to every numeric type and needs no help doing it — `x as! i32` on a bool is
  // *"lossy cast not needed"*. The other direction is lossy, and takes `as!` or `as~` but not `as@`:
  // there is no raw conversion to a bool, because the bit pattern is not the question.
  if (from == "bool") {
    return to == "i32" || to == "i64" || to == "u32" || to == "u64" || to == "f32" || to == "f64";
  }
  if (from == "i32") { return to == "i64" || to == "f64"; }
  if (from == "u32") { return to == "i64" || to == "u64" || to == "f64"; }
  if (from == "f32") { return to == "f64"; }
  return false;
}

/**
 * Whether `as@` — reinterpret the bits — is available for this conversion.
 *
 * Also measured. It is close to "the target is an integer no wider than the source", and that rule
 * is wrong for `f64 -> i64`, which the reference refuses while allowing `f64 -> i32`. Rather than
 * carry a formula with an exception, this carries the pairs.
 */
bool rawCast(string from, string to) {
  if (from == "i32") { return to == "u32"; }
  if (from == "u32") { return to == "i32"; }
  if (from == "i64") { return to == "i32" || to == "u32" || to == "u64"; }
  if (from == "u64") { return to == "i32" || to == "u32" || to == "i64"; }
  if (from == "f32" || from == "f64") { return to == "i32" || to == "u32"; }
  return false;
}

/** Whether `s` ends with `suffix`. wac has no string method for it. */
bool endsWith(string s, string suffix) {
  u8[] a = s.toBytes();
  u8[] b = suffix.toBytes();
  if (b.len() > a.len()) { return false; }
  for (i32 i = 0; i < b.len(); i++) {
    if (a[a.len() - b.len() + i] != b[i]) { return false; }
  }
  return true;
}

/**
 * The template name in an instantiation — `Box` in `Box<i32>` — or `""` when it is not one.
 *
 * Everything the checker knows about a generic is recorded under the template, because that is the
 * only place its fields are written down. So every lookup that takes an owner has to come back here
 * first, and the type arguments are what it substitutes afterwards.
 */
string genericBase(string t) {
  if (!endsWith(t, ">")) { return ""; }
  u8[] a = t.toBytes();
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] == 60) {
      u8[] out = u8[i]();
      for (i32 j = 0; j < i; j++) { out[j] = a[j]; }
      return string.fromBytes(out);
    }
  }
  return "";
}

/**
 * The type arguments of an instantiation, split at the commas that are not inside another one.
 *
 * `Pair<Vec<i32>, f64>` has two arguments and four commas' worth of temptation to get this wrong, so
 * the split counts `<` and `>` depth rather than looking for a separator.
 */
string[] genericArgs(string t) {
  string base = genericBase(t);
  if (base == "") { return string[0](); }
  u8[] a = t.toBytes();
  i32 start = base.toBytes().len() + 1;
  i32 end = a.len() - 1;
  i32 n = 1;
  i32 depth = 0;
  for (i32 i = start; i < end; i++) {
    if (a[i] == 60) { depth = depth + 1; }
    else if (a[i] == 62) { depth = depth - 1; }
    else if (a[i] == 44 && depth == 0) { n = n + 1; }
  }
  string[] out = string[n]();
  i32 at = 0;
  i32 from = start;
  depth = 0;
  for (i32 i = start; i <= end; i++) {
    bool cut = i == end;
    if (i < end) {
      if (a[i] == 60) { depth = depth + 1; }
      else if (a[i] == 62) { depth = depth - 1; }
      else if (a[i] == 44 && depth == 0) { cut = true; }
    }
    if (!cut) { continue; }
    i32 lo = from;
    while (lo < i && a[lo] == 32) { lo = lo + 1; }
    u8[] piece = u8[i - lo]();
    for (i32 j = 0; j < piece.len(); j++) { piece[j] = a[lo + j]; }
    out[at] = string.fromBytes(piece);
    at = at + 1;
    from = i + 1;
  }
  return out;
}

/** The template an instantiation is of — `Box` for `Box<i32>` — or the type itself when it is not one. */
string templateOf(string t) {
  string base = genericBase(t);
  return base == "" ? t : base;
}

/**
 * A type written inside a generic, read in the world of one of its instantiations.
 *
 * `T` inside `Box<T>` is `i32` when the owner is `Box<i32>`, and `T[]` is `i32[]` — the suffixes come
 * along, because a parameter can appear under any number of them. A type that mentions no parameter
 * comes back unchanged, which is most of them.
 *
 * Returns unknown when the owner is not an instantiation but the written type still names a
 * parameter: that is a generic's member read without knowing what it was instantiated with, and
 * there is no answer to give.
 */
string substituteType(C c, string owner, string written) {
  string base = genericBase(owner);
  string template = base == "" ? owner : base;
  i32 si = c.structAt(template);
  // **An enum instance is not in the struct table.** `Wrap<i32>` owns a payload written `Box<T>`,
  // and asking the struct table what `Wrap`'s parameters are called answered *nothing* — so the
  // payload kept its `T` and `Wrap.W(Box(5))` read as a field mismatch. The two tables answer the
  // same question about the same kind of name; only one of them was ever asked. `spec/cases/0046`.
  i32 ei = si >= 0 ? -1 : c.enumAt(template);
  string[] params = string[0]();
  if (si >= 0) {
    params = string[c.structParamCount[si]]();
    for (i32 i = 0; i < params.len(); i++) {
      params[i] = c.structParamNames[c.structParamAt[si] + i];
    }
  } else if (ei >= 0) {
    params = string[c.enumParamCount[ei]]();
    for (i32 i = 0; i < params.len(); i++) {
      params[i] = c.enumParamNames[c.enumParamAt[ei] + i];
    }
  }
  if (params.len() == 0) { return written; }

  // Peel `[]` and `?` off, substitute the core, and put them back in the order they came off.
  string core = written;
  string suffix = "";
  for (i32 guard = 0; guard < 8; guard++) {
    if (endsWith(core, "[]")) { core = dropLast(core, 2); suffix = "[]" + suffix; }
    else if (endsWith(core, "?")) { core = dropLast(core, 1); suffix = "?" + suffix; }
    else { break; }
  }

  string[] args = genericArgs(owner);
  // **A bare template substitutes nothing.** Inside `Map<K, V>`'s own body the receiver is `Map`,
  // with no arguments to put anywhere — `K` means `K` there and the written type is already the
  // answer. Without this the recursion below rebuilt `MapEntry<K, V>` out of nothing and reported a
  // field against a type that does not exist.
  if (args.len() == 0) {
    // **Outside the template's own body a bare parameter is unknown, not a type.** Inside `Map<K,
    // V>` the receiver is `Map` and `K` means `K` — that is the case above. At a call site, `Box(5)`
    // is a bare construction whose `T` the arguments decide, and answering `T` reported the literal
    // against a type nobody wrote: *expected T, found i32*. The parameters being active is what
    // separates the two, exactly as it does everywhere else in this file.
    for (i32 i = 0; i < params.len(); i++) {
      if (params[i] == core && !isActiveParam(c, core)) { return typeNone(); }
    }
    return written;
  }
  for (i32 i = 0; i < params.len(); i++) {
    if (params[i] != core) { continue; }
    if (i >= args.len()) { return typeNone(); }
    return args[i] + suffix;
  }
  // **And inside a funcref**, which is a type holding one just as much as `Option<V>` is. A generic
  // whose method takes an `fn[T(i32)]`, or whose field is an `fn[T()]`, kept its `T` here and every
  // question about it was asked against a type nobody wrote. `issues/lang/0141` is where it showed:
  // a lambda handed to `Pending.of` was offered `fn(i32) -> T` as its target and could not match it.
  if (startsWithFn(core)) {
    string fret = funcrefReturn(core);
    if (fret != "") {
      string out = "fn(";
      for (i32 i = 0; i < funcrefParamCount(core); i++) {
        if (i > 0) { out = out + ", "; }
        out = out + substituteType(c, owner, funcrefParamAt(core, i));
      }
      return out + ") -> " + substituteType(c, owner, fret) + suffix;
    }
  }
  // **And inside an instantiation.** `Map<K, V>.get` returns `Option<V>`, whose core is not a
  // parameter — it is a type *holding* one. Answering `Option<V>` for a `Map<string, i32>` made
  // `Option<i32> got = m.get(k);` a mismatch against a type nobody wrote. Substituting the arguments
  // and rebuilding is the same rule one level down, and it recurses because `Map<K, Vec<V>>` exists.
  string inner = genericBase(core);
  if (inner != "") {
    string[] iargs = genericArgs(core);
    string out = inner + "<";
    for (i32 i = 0; i < iargs.len(); i++) {
      if (i > 0) { out = out + ", "; }
      out = out + substituteType(c, owner, iargs[i]);
    }
    return out + ">" + suffix;
  }
  return written;
}

/** `s` without its last `n` bytes. */
string dropLast(string s, i32 n) {
  u8[] a = s.toBytes();
  if (n > a.len()) { return ""; }
  u8[] out = u8[a.len() - n]();
  for (i32 i = 0; i < out.len(); i++) { out[i] = a[i]; }
  return string.fromBytes(out);
}

/**
 * Whether a type is held *by value* — a number or a boolean.
 *
 * The concept `isPrimitiveName` keeps getting used for and is not: `string` is in that list, because
 * the list is about how a type is **passed**, and a string is nonetheless a reference. It can be
 * null, so `s is null` is a fair question; it can be cast to itself, so `s as string` is not
 * redundant; it has methods, so `s.slice(…)` is not a call on something with none.
 *
 * Three rules have now been written with `isPrimitiveName` where they meant this, and each reported
 * working code until it was corrected. Naming the distinction is cheaper than remembering it.
 */
bool isValueType(string n) { return isPrimitiveName(n) && n != "string"; }

/**
 * Whether the unary operator `uk` takes an operand of type `ut` at all.
 *
 * **One predicate, two readers.** `checkExpr` reports when the answer is no, and `typeOfExpr` answers
 * *unknown* for the expression — because an operator that rejects its operand produces something with
 * no type, not something of the operand's type. Answering the operand's type made a slot rule
 * downstream disagree with a type this checker had invented for an expression it had just refused, so
 * `export i32 f(string s) { return ~s; }` reported two faults where there is one. `issues/lang/0238a`.
 *
 * The `u32`/`u64` row is negation: an unsigned integer has none, and the reference says so.
 */
bool unaryAccepts(C c, i32 uk, string ut) {
  if (uk == kBang()) { return ut == "bool"; }
  if (uk == kMinus()) {
    return !(ut == "bool" || ut == "u32" || ut == "u64" || isReferenceName(c, ut));
  }
  if (uk == kTilde()) { return isIntegerName(ut); }
  return true;
}

/** Whether a type is one of the integers, which is what the bitwise operators and `~` demand. */
bool isIntegerName(string n) {
  return n == "i32" || n == "i64" || n == "u32" || n == "u64";
}

/** Whether a type is nullable, which is one of the ways to have a default value: null. */
bool isNullableName(string n) { return endsWith(n, "?"); }

/** The type inside a `T?`, or `""` when it is not one. */
string withoutNull(string n) {
  if (!endsWith(n, "?")) { return ""; }
  return dropLast(n, 1);
}

/**
 * Whether a type is one of the language's references.
 *
 * A predicate a *deleted* helper used to carry, and deleting it is how its list stopped being kept:
 * the rules that survived asked about structs and arrays and forgot enums, and `a == b` on two of
 * them was accepted for as long as that lasted. So it is back, complete, and it is the one place the
 * question is answered — comparisons and arithmetic both call it, which is what stops the two lists
 * drifting apart again.
 *
 * `anyref` and `i31ref` are here because they are references that resolve to themselves rather than
 * to a declaration, so every `isStruct`-shaped question answers no about them. A 3,600-cell sweep
 * against the reference is what found that; nobody was going to write `anyref < anyref` by hand.
 */
bool isReferenceName(C c, string t) {
  if (t == typeNone() || t == "") { return false; }
  if (isNullableName(t)) { return true; }
  if (t == "string" || t == "anyref" || t == "i31ref") { return true; }
  return isArrayName(t) || c.isStruct(t) || c.isEnum(t) || startsWithFn(t);
}

/**
 * Whether a value of type `got` may be where a `want` is expected.
 *
 * Not equality, because the language has one widening this slice can see: a non-null value goes into
 * a nullable slot, so `P? q = p;` is legal for a `P`. The other direction is not — `P q = p;` for a
 * `P?` is *"cannot assign nullable to non-null"* — but that is a **different family** with its own
 * message, so this answers `true` for it and stays quiet. Saying nothing about a program the
 * reference rejects is a subset checker doing its job; saying the wrong thing about it is not.
 */
export bool assignable(C c, string want, string got) {
  if (want == "" || got == "") { return true; }
  if (want == got) { return true; }
  if (withoutNull(want) == got) { return true; }
  // A nullable source is a hatch **only when its base would fit**. `P?` into a `P` is the
  // nullable-into-non-null family and reports there; `P?` into an `i32` is an ordinary mismatch and
  // was silent for as long as this said "any nullable is assignable to anything". The sweep found it
  // forty times over — one cell per (nullable type, unrelated slot) — which is what a blanket
  // exemption looks like from the outside: not a wrong answer anywhere, just no answer at all.
  // Both nullable: the question is entirely about the bases, and `Circle?` goes into a `Shape?` for
  // the same reason a `Circle` goes into a `Shape`. Unwrapping only the source compared `Shape?`
  // against `Circle` and called a working program wrong — the reference corpus caught it where the
  // sweep did not, because the sweep's accepted half has no nullable-child-into-nullable-parent cell.
  if (isNullableName(want) && isNullableName(got)) {
    return assignable(c, withoutNull(want), withoutNull(got));
  }
  if (isNullableName(got)) { return assignable(c, want, withoutNull(got)); }
  // **A nullable slot accepts whatever its base accepts**, and the missing half was the ordinary one.
  // `withoutNull(want) == got` above answers when the names match exactly — `Base? b = Base(9)` — and
  // the both-nullable line answers `Base? b = k` for a `Kid? k` by recursing onto `Base` against
  // `Kid`. So the rule this needs was already being relied on one line up; what had no route to it
  // was a source that is *not* nullable. `Base? b = Kid(2, 38)` reported, in every position a value
  // can be written: local, parameter, return, field, array element and a later assignment, all six
  // measured against the reference, which accepts, emits and runs each of them.
  //
  // Stated as a general unwrap rather than a struct rule, because it is one: a `?` widens what a slot
  // takes and narrows nothing. It subsumes the exact-name line above and the `anyref?` line below,
  // both of which are special cases of it, and it cannot let anything new through — `i32? n = "x"`
  // still asks whether a `string` fits an `i32`, and still gets no.
  if (isNullableName(want)) { return assignable(c, withoutNull(want), got); }
  // A child goes into a parent's slot without a cast; the other direction is the downcast that needs
  // `as!`. Upcasting *by assignment* is the same fact as upcasting by cast, one syntax along, and was
  // missed because nothing in the spec corpus assigns a child to a parent.
  if (c.isStruct(want) && c.isStruct(got) && descendsFrom(c, got, want)) { return true; }
  // A generic child into a parent — `Task t = c` for a `Cont<string> c` — is the line above too, now
  // that `descendsFrom` starts from the template. It was a separate clause here for one commit, which
  // was one caller patching a shared helper's blind spot; the cast rule had the same spot and the
  // opposite symptom, which is what said the fix belonged in the helper.
  // **A variant is a value of its enum.** `Option<i32> a = Option.Some(5);` — the source has the
  // variant's own type, which is what the reference answers too (*"expected i32, got A"*), and the
  // slot has the enum's. Compared against the *template*, so an instance takes its own variants:
  // `Option<i32>` accepts `Some`, and `Other<i32>` does not.
  // Under any `?` as well: `E? e = E.A(5);` is the nullable slot taking a value, and the two
  // questions — is it the right type, may it be absent — are separate ones.
  string wantCore = withoutNull(want) == "" ? want : withoutNull(want);
  string wantBase = genericBase(wantCore) == "" ? wantCore : genericBase(wantCore);
  if (c.isEnum(wantBase) && c.variantArityIn(wantBase, got) >= 0) { return true; }
  // `anyref` holds any **reference**: a struct, an array, a string, a nullable one of those. Not a
  // primitive — `anyref r = someI32` is a mismatch — so this is not simply "accepts everything".
  //
  // **And an `i31ref`**, which is the one name that was missing: an integer packed *into* a
  // reference is a reference, and that is the entire reason the type exists — it is how an unboxed
  // number and a heap object share one container. `items[0] = 7 as! i31ref;` in `spec/tour.wac` was
  // reported as a mismatch until the repository's own code was put to this checker for the first
  // time. Answered here rather than in `isReferenceType`, which also decides which *casts* are
  // reference casts — and `i31ref as i32` is a conversion, not a downcast.
  if (want == "anyref") { return got == "i31ref" || isReferenceType(c, got); }
  // **And `anyref?`**, which is the same top type with the same rule: `anyref? ctx;` holding a
  // struct is how `packages/sh` carries the context its interrupt callback is handed, and refusing
  // it stopped `packages/ssh/src/sshd.wac` compiling. The line above answers for `anyref` and the
  // `withoutNull(want) == got` line above that answers when the names match exactly — a struct into
  // a nullable top type fell between the two.
  if (withoutNull(want) == "anyref") { return got == "i31ref" || isReferenceType(c, got); }
  return false;
}

/**
 * Whether a type is held by reference, which is what `anyref` accepts and primitives are not.
 *
 * **An enum is one**, and this said it was not — so `anyref r = someEnum` was refused, which is the
 * worse kind of wrong: a gap costs a diagnostic nobody gets, and this cost a program nobody could
 * compile. The fact was not even unknown. `isCastRef` below carries a comment saying "an enum and a
 * funcref are references too", written next to the helper that did not use it.
 *
 * A funcref stays out, and that is not an oversight repeated: the reference refuses
 * `anyref r = someFn` as well, so the two agree and the 324-cell grid is what says so.
 */
bool isReferenceType(C c, string t) {
  string core = withoutNull(t);
  string at = core == "" ? t : core;
  return isArrayName(at) || at == "string" || at == "anyref" || c.isStruct(at) || c.isEnum(at);
}

/**
 * Whether this is specifically a nullable value going into a non-null slot.
 *
 * Its own diagnostic — *"cannot assign nullable to non-null"* — rather than a type mismatch, because
 * the reference words it that way and a caller can tell them apart: one says the types are unrelated,
 * the other says they are the same type and one of them might not be there.
 *
 * `assignable` still answers `true` for it, so the mismatch rules stay quiet and this reports instead
 * of both firing at one position.
 */
export bool nullableIntoNonNull(C c, string want, string got) {
  if (want == "" || got == "") { return false; }
  if (!endsWith(got, "?")) { return false; }
  if (endsWith(want, "?")) { return false; }
  // **`anyref` is already nullable**, so `anyref? into anyref` takes nothing away and the reference
  // accepts it. The old exact-name test reported it, which is the one cell of this family wacc
  // invented — found by putting `anyref?` in the slot grid.
  if (want == "anyref") { return false; }
  // **The base has to *fit* the slot, not equal it.** `withoutNull(got) == want` was the whole test,
  // so this family was only ever recognised when the two names matched exactly: `S? into S` reported
  // and `K? into S` said nothing at all, for a `K : S`. The reference gives both the same message —
  // *"cannot assign nullable to non-null"* — because both are the same mistake, and the child one is
  // the likelier to be written. `G<i32>? into S` was missed for the same reason one spelling further
  // along.
  //
  // Asking `assignable` is what keeps the two families apart rather than overlapping: `string? into
  // i32` fails here, because a `string` does not fit an `i32` under any nullability, and falls
  // through to the ordinary mismatch — which is what the reference calls it too.
  return assignable(c, want, withoutNull(got));
}

/** Whether `==` is refused on this type because it is a reference. Arrays are, as structs are. */
bool isArrayName(string n) { return endsWith(n, "[]"); }

/**
 * The storage types, which WasmGC allows as array elements and nowhere else.
 *
 * The distinction that matters is **position**, and it took a false alarm on 113 files to see it.
 * `u8 x = 5;` is an error — a packed type cannot be a local — while `bytes[i] = 5;` is the ordinary
 * way every byte buffer in this repository is written, because there the `u8` is an array element and
 * an `i32` truncates into it at the store. A rule about the type alone cannot tell those apart, and
 * the one here was written from the return-type grid, where packed accepts nothing.
 */
bool isPackedName(string n) {
  return n == "u8" || n == "u16" || n == "i8" || n == "i16";
}

// A `comparableByValue(n)` — `n == "" || n == "string" || isPrimitiveName(n)` — was here, exported and
// called by nothing. This file already carries the argument against it: `isValueType` above exists
// because "three rules have now been written with `isPrimitiveName` where they meant this, and each
// reported working code until it was corrected". A fourth predicate in the same family, with no
// caller to say which rule it is for, is the next one of those waiting to happen.

/** The families a literal is polymorphic over. */
export i32 litNone() { return 0; }
export i32 litInteger() { return 1; }
export i32 litFloat() { return 2; }
export i32 litBool() { return 3; }
export i32 litString() { return 4; }
/**
 * `null`, which is also what an *uninitialised* declaration holds.
 *
 * `i32 z;` and `i32 x = null;` parse to the same thing — a `NullLit` init — and the reference gives
 * them the same diagnostic, *"expected i32, got null"*. So the missing initialiser needs no separate
 * rule; it is already this one.
 */
export i32 litNull() { return 5; }

/** The checker's state: what it is reading, and what it has found. */
export struct C {
  u8[] src;
  i32[] toks;
  /**
   * The names declared in the function being checked, and the primitive each was declared with.
   *
   * Two parallel arrays because wac has no map, which is the shape every symbol table in this
   * package will have. Rebuilt per function: a name means nothing outside the one that declared it.
   */
  string[] names;
  string[] types;
  /** Whether each name was declared `const`. */
  bool[] nameConsts;
  /**
   * Whether that constness came only from **aliasing** something const, rather than from the
   * declaration saying so.
   *
   * The two are one flag everywhere else and they answer different questions. `N? cur = this.head;`
   * in a `const this` method may not be written *through* — that is the laundering the alias rule
   * exists to stop — but rebinding the local mutates nothing, and refusing that made every list walk
   * in the spec illegal.
   */
  bool[] nameAliasOnly;
  /**
   * Whether the name is in this table only so that the name *exists*.
   *
   * An `import { f } from "./x.wac"` declares `f` with no type, which is what makes a single-file
   * check say nothing about it rather than call it undefined. That entry is not a binding: it has no
   * type to narrow, nothing assigns to it, and the declaration it refers to is recorded properly
   * elsewhere — `declareModule` gives an imported function its return type, its parameters and its
   * arity. Rules that ask *does this name exist* want it; rules that ask *what is this local* must
   * skip it and look the declaration up instead. `issues/lang/0180a`.
   */
  bool[] nameImportOnly;
  i32 nameCount;
  /** Enum names. An enum has no default value, which is the only thing recorded about one here. */
  string[] enumNames;
  i32 enumCount;
  /**
   * A generic enum's type parameters, laid out exactly as a struct's are.
   *
   * Nothing recorded them until `Wrap<i32> w = Wrap.W(Box(5))` needed them: substituting a type
   * argument into a payload asks the owner what its parameters are called, and an enum could not
   * answer — so `Box<T>` stayed `Box<T>` and the constructor's argument read as a mismatch.
   */
  string[] enumParamNames;
  i32[] enumParamAt;
  i32[] enumParamCount;
  i32 enumParamTotal;
  /** How many of `names` are module-level and outlive a function. */
  i32 globalCount;
  /**
   * Every function in the file, and the primitives of its parameters.
   *
   * The first table here that outlives one function: locals are cleared per declaration, and this is
   * not — a call names something declared elsewhere in the file, and often further down it. Flat
   * storage because wac has no map and no growable array of structs: `funcParamAt` and
   * `funcParamCount` index into one shared `funcParamPrims`, which is the same shape `lex.wac` uses
   * for tokens and for the same reason.
   */
  /** The structs declared in this file, so a name can be known to be a reference type. */
  string[] structNames;
  /** Each struct's parent, or `""`. Parallel to `structNames`, so inheritance is one hop per lookup. */
  string[] structParents;
  /**
   * The names of each struct's type parameters — `T` for `Box<T>`, `A` and `B` for `Pair<A, B>`.
   *
   * Flat, with `structParamAt` and `structParamCount` indexing into it, which is the same shape the
   * function parameters use and for the same reason: wac has no growable array of arrays. These are
   * what a field type written `T` is substituted *from*, so without them a generic's fields are text.
   */
  string[] structParamNames;
  i32[] structParamAt;
  i32[] structParamCount;
  i32 structParamTotal;
  /**
   * Whether each struct takes type parameters.
   *
   * Recorded rather than inferred from an empty field table, because "generic" and "has no fields"
   * are different facts and only one of them means *say nothing*. A generic's fields and methods are
   * not modelled — `struct Box<T> { T v; }` has a field whose type is the parameter — so every rule
   * that would consult them has to know to stop, and an empty table cannot tell it why it is empty.
   */
  bool[] structGenerics;
  i32 structCount;
  /**
   * Every field of every struct, as three parallel arrays.
   *
   * Flat rather than nested because wac has no map and no growable array of structs, and a field
   * lookup is rare enough that a scan costs nothing at this size. `structNames` could have held an
   * offset and a count, as the function table does — it does not, because a field is looked up by
   * (struct, name) rather than by position, so the offset would buy nothing.
   */
  /**
   * Every method of every struct: who owns it, its name, and the two facts a call site needs.
   *
   * `isStatic` is "declared without `this`", which is what makes `P.mk()` legal and `p.mk()` not.
   * `isConst` is `const this`, which decides whether a const receiver may call it.
   */
  string[] methodOwners;
  string[] methodNames;
  bool[] methodStatics;
  bool[] methodConsts;
  /**
   * What each method returns, as written — `T` inside a generic, substituted at the call site.
   *
   * Absent until now, so a method call typed as *unknown* and every rule downstream of one stopped
   * there: `this.getInner().mutate()` could not be refused because nothing knew what `getInner()`
   * handed back, and `S.make` as a value had no type to mismatch against.
   */
  string[] methodReturns;
  /**
   * Each method's parameter types, flat, with `methodParamAt` and `methodParamCount` indexing in.
   *
   * Only a **static** method needs them: taking one as a value produces a funcref, and a funcref
   * spells its parameters. An instance method cannot be taken as a value at all, so its parameters
   * are recorded and never read — which is cheaper than a second table that leaves them out.
   */
  string[] methodParamTypes;
  i32[] methodParamAt;
  i32[] methodParamCount;
  i32 methodParamTotal;
  i32 methodCount;
  string[] fieldOwners;
  string[] fieldNames;
  string[] fieldTypes;
  /** Whether each field was declared `const`. */
  bool[] fieldConsts;
  i32 fieldCount;
  string[] funcNames;
  /** Each function's return type, so a call has one. */
  string[] funcReturns;
  i32[] funcParamAt;
  i32[] funcParamCount;
  string[] funcParamTypes;
  /**
   * Whether each function takes type parameters, and what they are called.
   *
   * A generic function's signature is written in its own parameters, which mean nothing at a call
   * site until they are bound. Recorded **as written** now rather than blanked, because binding them
   * is exactly what inference does — and the flag is what keeps the ordinary argument check from
   * reading `Box<T>` as a type nobody has.
   */
  bool[] funcGenerics;
  string[] funcTypeParamNames;
  i32[] funcTypeParamAt;
  i32[] funcTypeParamCount;
  i32 funcTypeParamTotal;
  i32 funcCount;
  i32 funcParamTotal;
  /**
   * How many loops and switches enclose the statement being checked.
   *
   * On the state rather than threaded through `checkStmt`, which every rule here would otherwise have
   * to carry to reach the two that use it. Switches count: `break` leaves one, and the reference also
   * accepts `continue` inside one, which is measured rather than inferred from its message.
   */
  i32 loopDepth;
  /**
   * What the expression **about to be walked** is required to be, or unknown.
   *
   * The one piece of information that flows *down* the tree rather than up. Every other rule here
   * reads an expression and asks what it is; a bare `Box(1.0)` cannot be asked that, because its type
   * arguments are inferred from wherever it is going. Carried on the state rather than threaded
   * through `checkExpr`, which forty call sites would otherwise have to pass along.
   *
   * Read and **cleared** at the top of `checkExpr`, so it reaches exactly one expression: the one the
   * context set it for. A sub-expression of that one is in a position of its own, and `Box(1).get()`
   * is the case that proves it — the receiver inherits nothing from the `return` it sits under.
   */
  string expected;
  /** `(code, line, col)` triples, the same shape `dumpErrors` returns for the parser. */
  i32[] errors;
  /**
   * The operands, one per error: `expected bool, found i32`, or `""` where they were not recorded.
   *
   * `spec/spec/errors.md` calls this the `annotation` — the text after the underline — and it is the
   * difference between a diagnostic that names the rule and one that helps. It sits beside the
   * triples rather than inside them because the triples are `i32` and this is not; every site that
   * has the operands in hand passes them, and a site that does not says nothing rather than guessing.
   */
  string[] errorNotes;
  /**
   * How wide each diagnostic is, or `0` where nothing recorded one.
   *
   * **Zero means unknown, not one.** The parse phase has always carried a width — the token it
   * stopped on — and the checker had none, so every check diagnostic underlined a single character
   * whether or not that was the truth. Recording it where a token is in hand makes the two phases
   * comparable, and leaving it `0` elsewhere keeps "we did not measure this" distinguishable from
   * "this really is one character wide", which is what `;` is.
   */
  i32[] errorWidths;
  /**
   * The first source line to print for each diagnostic, or `0` to print only the caret's line.
   *
   * **Where to start printing is not how wide the span is**, and the two were confused into one
   * missing field. `widthBetween` decided — correctly — that an expression running across lines has no
   * width this can state, *"a decision for the formatter rather than a number for the wire"*. That
   * settled the span and left this: `spec/spec/errors.md`'s `§wac-diag-multiline-ic7x2hq` shows the
   * lines *above* the caret, because a caret under `3.14` says nothing about which call it is an
   * argument to, and the renderer cannot work out which construct the diagnostic came from. The
   * checker can, and does — it has the call in hand at the point it reports.
   *
   * `0` rather than the caret's own line so that "nothing recorded one" is distinguishable, the same
   * convention `errorWidths` uses and for the same reason. `issues/lang/0232a`.
   */
  i32[] errorContexts;
  /**
   * A hint written for *this* diagnostic, or empty to take the code's own.
   *
   * **Because a hint that quotes an identifier cannot be static.** `hintFor(code)` answered every
   * non-bool condition with *"use a comparison, such as `x != 0`"*, so `if (flag)` was told to compare
   * a variable it does not have — a sentence that reads as authoritative and points at nothing.
   * `spec/spec/errors.md` states hints that quote the reader's own expression
   * (`§wac-diag-bool-r8kn4wp`: *"use a comparison: if (x != 0) { ... }"* for a program whose variable
   * is `x`, and `§wac-diag-wide-k4rn8wp`: *"use `(sum > 0) as i32` to convert"*), which a per-code
   * table cannot do. Empty everywhere else, so the static hints stay exactly as they were.
   */
  string[] errorHints;
  i32 errorCount;
  /** Whether diagnostics are being discarded — see `report`. */
  bool quiet;
  /**
   * Whether a type name that resolves to nothing is an error yet.
   *
   * Off until every declaration is in, because until then "not declared" only means "not declared
   * *yet*" — a struct whose field names a struct further down the file would be refused on the way
   * past. `checkModule` turns it on once, after the declaration passes.
   */
  bool scopeTypes;
  /**
   * The type parameters of the generic function being checked, which are **unknown types**.
   *
   * `T oops<T>(T a) { i32 x = "hello"; return a; }` is an error `spec/spec/generics.md` names, and
   * the error has nothing to do with `T` — so the body is checked, and every question about `T`
   * answers the way this checker answers every question it cannot resolve: with nothing.
   */
  string[] activeParams;
  i32 activeParamCount;
  /**
   * The generic function whose body is being walked, or `""`.
   *
   * Only self-recursion needs it: `grow<T>` calling `grow` with a `Box<T>` instantiates itself
   * again with a bigger type, which never bottoms out. Calling *another* generic that way is
   * finite, so the name is the whole of what separates the two.
   */
  string activeFunc;
  /**
   * Which enum each variant belongs to, and how many payload fields it has.
   *
   * A variant is *also* declared as a struct under its bare name, because that is how `is Circle`
   * and `case Circle:` write it and how a narrowed value finds its payload. That spelling cannot
   * tell two enums apart: `enum Opened { Ok(i32 fd) }` beside `enum Found { Ok(i32 at) }` is one
   * `Ok` in the struct table holding both payloads, so asking it how many arguments `Ok` takes
   * answers two and belongs to neither. Recorded here per declaration instead — no de-duplication,
   * because the duplication is the fact being recorded.
   */
  string[] variantOwners;
  string[] variantNames;
  i32[] variantArities;
  /** Whether each variant can be written bare — see `markVariantBare`. */
  bool[] variantBare;
  i32 variantCount;

  /**
   * What the file being declared calls a type, against what the file that imported it calls it.
   *
   * `import { Dup as DupB } from "./b.wac"` means `b.wac`'s `Dup` enters this file as `DupB`, and it
   * has to enter under that name throughout — not only as a declaration but everywhere `b.wac`'s own
   * signatures mention it, or `DupB b = fromB()` binds a type whose fields belong to somebody else's
   * `Dup`. Empty except while an imported file is being declared.
   */
  string[] renameFrom;
  string[] renameTo;
  i32 renameCount;

  /**
   * Each method's body, so a call site can ask what its `return`s hand back.
   *
   * `const this` makes what the receiver *reaches* const, and a call through a const receiver has to
   * inherit that — an accessor handing back a field is a way to launder it. But a method whose every
   * `return` constructs a value out of copies reaches nothing, and treating its result as const is
   * what stopped `Counter copy = this.clone(); copy.bump();` from compiling [issue 0060].
   *
   * The body rather than the answer, because the answer needs the field types of whatever is being
   * constructed and the declaration pass runs before the types it would ask about are all known —
   * asking there reported 38 working files against a position in the linked blob.
   */
  Stmt[][] methodBodies;

  /**
   * Types declared for their *members* and not for their *name*.
   *
   * A file may only write the type names it imported, and it may reach further than that: `Cli`'s
   * fields hold `fn[Pending<i32>()]`, so calling one gives a `Pending<i32>` in a file that never
   * named `Pending`. Both facts are true at once, and declaring the reachable type the ordinary way
   * makes only the first one false — `knownTypeName` would then accept `Pending<i32> p`, which the
   * reference refuses with *"undefined type 'Pending'"*.
   *
   * So the declaration happens and this list says it does not carry a name into scope.
   * `issues/lang/0132` is what the missing declaration cost: `.wait()` on a struct nobody had
   * declared answers nothing, and every rule downstream of it goes quiet.
   */
  string[] unnameable;
  i32 unnameableCount;

  /**
   * Warnings: a code, a line and a column each, beside the errors rather than among them.
   *
   * **A parallel table, not a severity column.** Diagnostics are a flat `i32[]` of three slots each
   * with a parallel notes array, touched at twenty-odd sites; adding a fourth slot would change the
   * stride and every one of them. This disturbs nothing, and a warning that is not an error must not
   * reach any count that decides whether a compile succeeded. `issues/lang/0126`.
   */
  i32[] warnings;
  i32 warnCount;
  /**
   * Block scope, as two parallel facts about the name table — `issues/lang/0122`.
   *
   * `nameScope[i]` is the `Stmt[]` body the name was declared in. Every scope in wac has one, and
   * arrays are references, so the body *is* the identity with nothing for two walks to keep in
   * step. `openScopes[0..openScopeCount)` is what is open now. A name is visible when the body
   * that declared it is one of them, filtered inside the lookups rather than at their call sites.
   */
  Stmt[][] nameScope;
  Stmt[][] openScopes;
  i32 openScopeCount;
  /**
   * The scope of a name declared while none was open — one array, compared by identity.
   *
   * It cannot be a fresh `Stmt[]()` per declaration: `is` is identity, so each would match nothing
   * and the name would be invisible everywhere. It cannot be an empty array either, because `{ }`
   * is a real scope with an empty body. A caller that declares names without pushing a scope is
   * saying it does not track scope, and the answer for it has to be *visible*, not *nowhere*.
   */
  Stmt[] noScope;
  /**
   * The return type a `return` inside a lambda answers to, or `""` when not inside one.
   *
   * `checkStmt` takes the enclosing function's return as an AST `Ty`, and a lambda has no return type
   * written — `design/lang/0002` takes it from the `fn[…]` the lambda is checked against, which is a
   * *string*. Every `Ty` variant carries a token, so one cannot be synthesised from a name, and this
   * is the seam that avoids needing to: the `Return` case prefers this when it is set.
   *
   * Saved and restored around the body rather than cleared, because a lambda can sit inside a lambda
   * and the inner one's return type must not become the outer's when it finishes.
   *
   * Saved and restored around the body rather than cleared, because a lambda can sit inside a lambda
   * and the inner one\'s return type must not become the outer\'s when it finishes.
   */
  string lambdaReturn;

  /**
   * Whether `expected` is empty because **nothing could say** what was wanted, as opposed to nothing
   * wanting anything.
   *
   * `typeNone()` is `""`, so those two facts share a spelling — and they need different answers in
   * exactly one place. `i32 g = () => 42;` has a slot and it is not a funcref, which is an error a
   * lambda cannot report any other way, since unknown is assignable to everything. `Pending.of(0,
   * (i32 id) => v, …)` in a file checked **without its imports** has no slot at all, because
   * `Pending` is a name this file does not contain — and refusing there is inventing a diagnostic
   * about a program that is fine.
   *
   * That is not hypothetical: `rung 3` type-checks every `.wac` file in the repository single-file
   * and requires silence, and the first package file to hold a lambda over an imported type
   * (`packages/platform/src/frame.wac`) produced 29 false alarms.
   *
   * Set for one argument at a time by the call arm, read and cleared by `checkExpr` beside
   * `expected` so the two always travel together.
   *
   * `C` is built positionally, and `expected` and `lambdaReturn` are both `string`s, so a value
   * inserted next to them could land in the wrong slot with the types still agreeing and nothing
   * failing. A `bool` has neither problem.
   */
  bool expectedUnknown;

  /**
   * Whether each method declares **its own** type parameters — `then<U>(…)`.
   *
   * Parallel to `methodNames`, and the only thing the checker needs to know about them: the
   * declaration is legal, a *call* is not supported yet, and saying which feature is missing beats
   * whatever falls out downstream. What fell out was the lambda argument answering "nothing here
   * wants a function" about a lambda that is fine, because the parameter it was checked against is
   * written in a letter nobody has bound.
   *
   * **Last field**, for the reason the ones above give: `C` is built positionally.
   */
  bool[] methodTypeParams;
  /**
   * Each name's funcref **arity**, taken from the type as *written*, or -1.
   *
   * `typeOfTy` answers unknown for `fn[U(T)]` as soon as one component is unknown, so a parameter of
   * that type inside a generic has no resolved type at all — and three separate rules then read "cannot
   * name it" as "not a funcref", which is how a call to a parameter `f` reached a module-level `f`
   * instead. The arity needs no resolution: it is the number of parameters in the written type, and it
   * is what those rules actually want. `issues/lang/0145`.
   */
  i32[] nameFuncArity;
  /**
   * `switch` nesting, kept apart from loop nesting because the two rules differ: a `break` leaves a
   * switch and a `continue` has nothing to do with one. One counter for both accepted `continue`
   * inside a switch, and — because a `match` bumped it too, being modelled on the switch beside it —
   * accepted both inside a match arm, which is neither. The reference words them separately for the
   * same reason: *"'break' outside loop or switch"* against *"'continue' outside loop"*.
   *
   * Last in this struct because construction is positional: a field added in the middle renumbers
   * every argument after it.
   */
  i32 switchDepth;

  /**
   * Local spellings that are other names for **one** imported declaration, and what they collapse
   * onto.
   *
   * `import { Point, Point as P }` gives one declaration two names in this file, and
   * `spec/spec/generics.md` `[§wac-generic-instantiation-identity-6pnq4wj]` says they are one type:
   * *"`Box<P>` and `Box<Point>` are one struct"*. `renameFrom`/`renameTo` cannot express that — it
   * maps a declaring name to a **single** local one, so `declareModule` registered the declaration
   * under one spelling and left the other undeclared, which is silent rather than wrong.
   *
   * Different from `renameFrom` in two ways that matter: this maps a *local* name to another *local*
   * name, and it survives past the import walk, because the entry file's own body is where the second
   * spelling gets written. `issues/lang/0161`.
   */
  string[] aliasFrom;
  string[] aliasTo;
  i32 aliasCount;

  /**
   * Quoted import specifiers in the file being checked that resolve to no supplied file.
   *
   * Populated by the caller, which is the only layer holding the path map — see
   * `errMissingImportFile` for why the diagnostic is still the checker's.
   */
  string[] unresolvedSpecs;
  i32 unresolvedCount;



  /**
   * Two capacities, because the tables here hold two different things.
   *
   * `locals` sizes the four that are *per function* — the name table and what goes beside it, which
   * `clearScope` empties between functions, so it only ever holds one body's worth. `decls` sizes
   * everything else: structs, fields, methods, variants, functions, which accumulate across every
   * file the entry imports.
   *
   * They were one number, and it was the entry file's token count. Sizing both by the closure's
   * tokens fixed the overflow (`issues/lang/0098`) and cost 230 MB, because a token is the wrong
   * unit for a table that holds declarations — `issues/lang/0099`.
   */
  C create(u8[] src, i32[] toks, i32 locals, i32 decls) {
    return C(src, toks, string[locals](), string[locals](), bool[locals](),
             bool[locals](), bool[locals](), 0,
             string[decls](), 0,
             string[decls](), i32[decls](), i32[decls](), 0,
             0,
             string[decls](), string[decls](),
             string[decls](), i32[decls](), i32[decls](), 0, bool[decls](), 0,
             string[decls](), string[decls](), bool[decls](), bool[decls](),
             string[decls](), string[decls](), i32[decls](), i32[decls](), 0, 0,
             string[decls](), string[decls](), string[decls](), bool[decls](), 0,
             string[decls](), string[decls](), i32[decls](), i32[decls](),
             string[decls](), bool[decls](), string[decls](), i32[decls](),
             i32[decls](), 0, 0, 0,
             0, "",
             i32[decls * 3](), string[decls](), i32[decls](), i32[decls](), string[decls](), 0, false, false,
             string[16](), 0, "",
             string[decls](), string[decls](), i32[decls](), bool[decls](), 0,
             string[decls](), string[decls](), 0,
             Stmt[][decls](fill: Stmt[]()),
             string[decls](), 0,
             i32[decls * 3](), 0,
             Stmt[][locals](fill: Stmt[]()), Stmt[][256](fill: Stmt[]()), 0, Stmt[](), "", false,
             bool[decls](), i32[locals](fill: 0 - 1), 0,
             string[decls](), string[decls](), 0,
             string[decls](), 0);
  }

  /**
   * Record a warning — something true about the program that is not a reason to refuse it.
   *
   * Deliberately not `report`: nothing about a warning may fail a compile, so it shares no storage
   * and no counter with the errors. `[§wac-nonnull-isnull-k8fn3wp]` is why the first rule is a
   * warning at all — a non-null reference `is null` is *legal* and answers false, and a generic like
   * `Slot<T>.empty` has to instantiate for nullable and non-nullable `T` alike.
   */
  void warn(this, i32 code, i32 line, i32 col) {
    if (this.quiet) { return; }
    for (i32 i = 0; i + 2 < this.warnCount * 3; i = i + 3) {
      if (this.warnings[i] == code && this.warnings[i + 1] == line && this.warnings[i + 2] == col) {
        return;
      }
    }
    if (this.warnCount * 3 + 2 >= this.warnings.len()) { return; }
    this.warnings[this.warnCount * 3] = code;
    this.warnings[this.warnCount * 3 + 1] = line;
    this.warnings[this.warnCount * 3 + 2] = col;
    this.warnCount = this.warnCount + 1;
  }

  /**
   * Declare that `name` was brought in for its members only, and does not enter the file's scope.
   *
   * Sized by `decls` like everything else here, because what goes in it is a subset of the
   * declarations the closure contains — a fixed cap would silently stop hiding names in a large
   * graph, and a type that becomes nameable by accident is exactly the diagnostic this is protecting.
   */
  void markUnnameable(this, string name) {
    for (i32 i = 0; i < this.unnameableCount; i++) {
      if (this.unnameable[i] == name) { return; }
    }
    if (this.unnameableCount >= this.unnameable.len()) { return; }
    this.unnameable[this.unnameableCount] = name;
    this.unnameableCount = this.unnameableCount + 1;
  }

  /** Whether `name` is declared but may not be written as a type in this file. */
  bool isUnnameable(const this, string name) {
    for (i32 i = 0; i < this.unnameableCount; i++) {
      if (this.unnameable[i] == name) { return true; }
    }
    return false;
  }

  /** The name this file's import gave to a type the declaring file calls something else. */
  string renamed(const this, string n) {
    for (i32 i = 0; i < this.renameCount; i++) {
      if (this.renameFrom[i] == n) { return this.renameTo[i]; }
    }
    return n;
  }

  /**
   * The one spelling this file's other names for a declaration collapse onto.
   *
   * Identity for every name that is not a second spelling, which is nearly all of them — the loop
   * runs over an empty table in any file that does not import one name twice.
   */
  string canon(const this, string n) {
    for (i32 i = 0; i < this.aliasCount; i++) {
      if (this.aliasFrom[i] == n) { return this.aliasTo[i]; }
    }
    return n;
  }

  /** Record a quoted specifier this file imports that no supplied file answers. */
  void addUnresolved(this, string spec) {
    if (this.unresolvedCount >= this.unresolvedSpecs.len()) { return; }
    this.unresolvedSpecs[this.unresolvedCount] = spec;
    this.unresolvedCount = this.unresolvedCount + 1;
  }

  bool isUnresolved(const this, string spec) {
    for (i32 i = 0; i < this.unresolvedCount; i++) {
      if (this.unresolvedSpecs[i] == spec) { return true; }
    }
    return false;
  }

  /** Record that this file's `from` is another name for its own `to`. */
  void addLocalAlias(this, string from, string to) {
    if (this.aliasCount >= this.aliasFrom.len()) { return; }
    this.aliasFrom[this.aliasCount] = from;
    this.aliasTo[this.aliasCount] = to;
    this.aliasCount = this.aliasCount + 1;
  }

  /** Record that the file being declared calls `from` what this file calls `to`. */
  void addRename(this, string from, string to) {
    if (this.renameCount >= this.renameFrom.len()) { return; }
    this.renameFrom[this.renameCount] = from;
    this.renameTo[this.renameCount] = to;
    this.renameCount = this.renameCount + 1;
  }

  /**
   * Record a declared name.
   *
   * A second declaration of the same name **poisons** it to `primNone` rather than replacing or
   * keeping the first. wac scopes by block, and this slice does not track blocks — so a local
   * shadowing a parameter, or two locals of different types in sibling blocks, would otherwise make
   * a lookup confidently wrong and produce a diagnostic the reference does not. Poisoning costs the
   * few names that are declared twice and keeps the checker a subset, which is the property
   * everything here depends on.
   */
  void declare(this, string name, string ty) { this.declareConst(name, ty, false); }

  /** The same, recording whether the binding is `const`. */
  void declareConst(this, string name, string ty, bool isConst) {
    // **Poisoned only by a clash in the *same* scope.** The loop used to run over every name and
    // blank the type of any match, so `{ i32 q = 1; } { string q = "a"; }` left both `q`s
    // untyped — and a name with no type is a name no rule can be wrong about, which is how
    // `i32 r = q` against a `string` reached the emitter and produced invalid wasm. Shadowing is
    // legal (`§wac-shadow-8u8qh2j`), so a match in an enclosing scope is a new binding, not a
    // collision. `issues/lang/0122`.
    // **A same-scope clash keeps the first type, and the checking walk retypes at the declaration.**
    // This blanked it to `primNone` instead, and unknown is silent everywhere here — so
    // `i32 a = a.m(); return a.m()`, a method call on an `i32`, got no diagnostic at all and the
    // program was refused by the emitter as a missing export. `issues/lang/0174a`.
    //
    // Retyping *here* is the wrong repair and was measured to be: this walk runs over the whole body
    // before `checkStmt` sees any of it, so the second declaration's type would be in the table while
    // line 5 is checked and a declaration on line 6 got reported against a use above it. Keeping the
    // first type makes this pass position-correct for everything before the redeclaration, and
    // `checkStmt`'s `Var` arm calls `setType` when it reaches the declaration, which is what makes it
    // correct after.
    for (i32 i = 0; i < this.nameCount; i++) {
      if (this.names[i] == name && this.sameScope(i)) { return; }
    }
    if (this.nameCount >= this.names.len()) { return; }
    this.names[this.nameCount] = name;
    this.types[this.nameCount] = ty;
    this.nameConsts[this.nameCount] = isConst;
    this.nameAliasOnly[this.nameCount] = false;
    this.nameImportOnly[this.nameCount] = false;
    if (this.nameCount < this.nameFuncArity.len()) { this.nameFuncArity[this.nameCount] = 0 - 1; }
    if (this.nameCount < this.nameScope.len()) {
      this.nameScope[this.nameCount] = this.openScopeCount > 0
        ? this.innermost()
        : this.noScope;
    }
    this.nameCount = this.nameCount + 1;
  }

  /** Whether name `i` was declared in the scope now innermost — where a redeclaration collides. */
  bool sameScope(const this, i32 i) {
    if (this.openScopeCount == 0) { return true; }
    if (i >= this.nameScope.len()) { return true; }
    return this.innermost() is this.nameScope[i];
  }

  /** Say that the name just declared is const only because it aliases something const. */
  void markAliasOnly(this, string name) {
    i32 i = this.findName(name);
    if (i >= 0) { this.nameAliasOnly[i] = true; }
  }

  /** Say that the name just declared is there only so the name exists — see `nameImportOnly`. */
  void markImportOnly(this, string name) {
    i32 i = this.findName(name);
    if (i >= 0 && i < this.nameImportOnly.len()) { this.nameImportOnly[i] = true; }
  }

  /** Whether the nearest binding of `name` is an import's placeholder rather than a binding. */
  bool isImportOnlyName(const this, string name) {
    i32 i = this.findName(name);
    return i >= 0 && i < this.nameImportOnly.len() ? this.nameImportOnly[i] : false;
  }

  /** Whether a name's constness is the aliasing kind, which does not stop it being rebound. */
  bool isAliasOnlyName(this, string name) {
    i32 i = this.findName(name);
    return i >= 0 ? this.nameAliasOnly[i] : false;
  }

  /**
   * Whether `name` is bound more than once — a local standing in front of an outer binding.
   *
   * An `import` puts the name in this table too, so a local of the same name makes two entries and
   * `findName` returns the inner one. That count is the only thing here that can tell "a local
   * shadowing an imported function" from "a local and nothing else", which is the difference
   * between deferring to the outer binding and reporting. `issues/lang/0143`.
   */
  bool shadowsOuterName(const this, string name) {
    i32 seen = 0;
    for (i32 i = 0; i < this.nameCount; i++) {
      if (this.names[i] == name) { seen = seen + 1; }
    }
    return seen > 1;
  }

  /** Whether a name was declared `const`. Unknown names are not, which is silence. */
  bool isConstName(this, string name) {
    i32 i = this.findName(name);
    return i >= 0 ? this.nameConsts[i] : false;
  }

  /** The type a name was declared with, or `typeNone` for one this slice never saw. */
  /**
   * Whether the name is bound at all, which is a different question from what its type is.
   *
   * A match binding is declared with an *unknown* type, so `typeOfName` answers the same for it as
   * for a name that was never declared. The undefined-variable rule needs the distinction and nothing
   * else does, which is why this is separate rather than a change to the other.
   */
  /**
   * Retype an existing name, without the poisoning `declareConst` does on a redeclaration.
   *
   * Narrowing needs to say "for the length of this branch, `s` is a `Circle`" and then put it back.
   * Declaring would mark the name unknown instead, which is the right answer for a *second*
   * declaration and the wrong one for the same binding seen more precisely.
   */
  void setType(this, string name, string ty) {
    i32 i = this.findName(name);
    if (i >= 0) { this.types[i] = ty; }
  }

  /**
   * Set both const flags at once, for the length of a `match` arm.
   *
   * The subject cannot be assigned while an arm has it narrowed — writing to it would leave the
   * narrowing describing a value that is no longer there. Both flags move together because the
   * declared kind is what refuses an assignment, and the arm's constness is the declared kind.
   */
  void setConstFlags(this, string name, bool isConst, bool aliasOnly) {
    i32 i = this.findName(name);
    if (i >= 0) {
      this.nameConsts[i] = isConst;
      this.nameAliasOnly[i] = aliasOnly;
    }
  }

  bool isDeclaredName(const this, string name) { return this.findName(name) >= 0; }

  string typeOfName(this, string name) {
    i32 i = this.findName(name);
    return i >= 0 ? this.types[i] : typeNone();
  }

  /**
   * Record a function's signature.
   *
   * A second declaration of the same name is skipped rather than poisoned. Unlike a local, two
   * functions with one name are a program that does not compile at all — the reference says so with
   * its own diagnostic — so there is no ambiguity to be conservative about, only a program this
   * slice will not reach.
   */
  void declareFunc(this, string name, string ret, string[] paramTypes, i32 count,
                   string[] typeParams) {
    for (i32 i = 0; i < this.funcCount; i++) {
      if (this.funcNames[i] == name) { return; }
    }
    if (this.funcCount >= this.funcNames.len()) { return; }
    if (this.funcParamTotal + count > this.funcParamTypes.len()) { return; }
    this.funcNames[this.funcCount] = name;
    this.funcReturns[this.funcCount] = ret;
    this.funcParamAt[this.funcCount] = this.funcParamTotal;
    this.funcParamCount[this.funcCount] = count;
    this.funcGenerics[this.funcCount] = typeParams.len() > 0;
    this.funcTypeParamAt[this.funcCount] = this.funcTypeParamTotal;
    this.funcTypeParamCount[this.funcCount] = typeParams.len();
    for (i32 i = 0; i < typeParams.len(); i++) {
      if (this.funcTypeParamTotal >= this.funcTypeParamNames.len()) { break; }
      this.funcTypeParamNames[this.funcTypeParamTotal] = typeParams[i];
      this.funcTypeParamTotal = this.funcTypeParamTotal + 1;
    }
    for (i32 i = 0; i < count; i++) {
      this.funcParamTypes[this.funcParamTotal + i] = paramTypes[i];
    }
    this.funcParamTotal = this.funcParamTotal + count;
    this.funcCount = this.funcCount + 1;
  }

  /** Record a struct declared in this file, and who it inherits from. */
  void declareStruct(this, string name, string parent, string[] typeParams) {
    for (i32 i = 0; i < this.structCount; i++) {
      if (this.structNames[i] == name) { return; }
    }
    if (this.structCount >= this.structNames.len()) { return; }
    this.structNames[this.structCount] = name;
    this.structParents[this.structCount] = parent;
    this.structGenerics[this.structCount] = typeParams.len() > 0;
    this.structParamAt[this.structCount] = this.structParamTotal;
    this.structParamCount[this.structCount] = typeParams.len();
    for (i32 i = 0; i < typeParams.len(); i++) {
      if (this.structParamTotal >= this.structParamNames.len()) { break; }
      this.structParamNames[this.structParamTotal] = typeParams[i];
      this.structParamTotal = this.structParamTotal + 1;
    }
    this.structCount = this.structCount + 1;
  }

  /**
   * Record the funcref arity of the name just declared — see `nameFuncArity`.
   *
   * Written as "the last one" rather than by name because a shadowing declaration is a *new* entry and
   * looking the name up would find the outer one.
   */
  void noteFuncArity(this, i32 arity) {
    if (arity < 0) { return; }
    if (this.nameCount == 0 || this.nameCount > this.nameFuncArity.len()) { return; }
    this.nameFuncArity[this.nameCount - 1] = arity;
  }

  /** The funcref arity recorded for a name, or -1 — innermost first, as `typeOfName` reads it. */
  i32 funcArityOf(const this, string name) {
    for (i32 i = this.nameCount - 1; i >= 0; i--) {
      if (this.names[i] != name) { continue; }
      if (i >= this.nameFuncArity.len()) { return 0 - 1; }
      return this.nameFuncArity[i];
    }
    return 0 - 1;
  }

  /** Which entry holds this struct, or -1. */
  i32 structAt(const this, string name) {
    for (i32 i = 0; i < this.structCount; i++) {
      if (this.structNames[i] == name) { return i; }
    }
    return -1;
  }

  /** Whether this struct takes type parameters, and so is not modelled beyond its name. */
  bool isGeneric(this, string name) {
    for (i32 i = 0; i < this.structCount; i++) {
      if (this.structNames[i] == name) { return this.structGenerics[i]; }
    }
    return this.isGenericEnum(name);
  }

  /**
   * Whether `name` is a generic **enum**, which `isGeneric` does not answer.
   *
   * `isGeneric` walks the struct table only, so `Maybe<T>` comes back as not generic — and every
   * rule that asks it about an enum is answered wrongly. Written as its own question rather than by
   * widening that one, because a caller like the variant-arity check reads `!isGeneric(recv)` and
   * would change meaning under it. `issues/lang/0088` records the wider version.
   */
  bool isGenericEnum(const this, string name) {
    for (i32 i = 0; i < this.enumCount; i++) {
      if (this.enumNames[i] == name) { return this.enumParamCount[i] > 0; }
    }
    return false;
  }

  /** Record one field of one struct. */
  void declareField(this, string owner, string name, string ty) {
    this.declareFieldConst(owner, name, ty, false);
  }

  /** The same, recording whether the field is `const`. */
  void declareFieldConst(this, string owner, string name, string ty, bool isConst) {
    if (this.fieldCount >= this.fieldNames.len()) { return; }
    this.fieldOwners[this.fieldCount] = owner;
    this.fieldNames[this.fieldCount] = name;
    this.fieldTypes[this.fieldCount] = ty;
    this.fieldConsts[this.fieldCount] = isConst;
    this.fieldCount = this.fieldCount + 1;
  }

  /** A struct's declared parent, or `""`. */
  string parentOf(this, string name) {
    for (i32 i = 0; i < this.structCount; i++) {
      if (this.structNames[i] == name) { return this.structParents[i]; }
    }
    return "";
  }

  /** Record one method of one struct. */
  void declareMethod(this, string owner, string name, bool isStatic, bool isConst, string ret,
                     string[] params, Stmt[] body, bool ownTypeParams) {
    if (this.methodCount >= this.methodNames.len()) { return; }
    if (this.methodCount < this.methodTypeParams.len()) {
      this.methodTypeParams[this.methodCount] = ownTypeParams;
    }
    this.methodBodies[this.methodCount] = body;
    this.methodParamAt[this.methodCount] = this.methodParamTotal;
    this.methodParamCount[this.methodCount] = params.len();
    for (i32 i = 0; i < params.len(); i++) {
      if (this.methodParamTotal >= this.methodParamTypes.len()) { break; }
      this.methodParamTypes[this.methodParamTotal] = params[i];
      this.methodParamTotal = this.methodParamTotal + 1;
    }
    this.methodOwners[this.methodCount] = owner;
    this.methodNames[this.methodCount] = name;
    this.methodStatics[this.methodCount] = isStatic;
    this.methodConsts[this.methodCount] = isConst;
    this.methodReturns[this.methodCount] = ret;
    this.methodCount = this.methodCount + 1;
  }

  /**
   * Which entry holds `owner.name` **without** inheritance, or -1.
   *
   * Static methods are not inherited: `Sub.make()` is an error even when `Base` declares `make` and
   * `Sub` extends it — the reference says *"struct 'Sub' has no static method 'make'"*. That is the
   * opposite of instance methods, which are, and it is why the two lookups are separate rather than
   * one with a flag.
   */
  i32 ownMethodAt(this, string owner, string name) {
    owner = templateOf(owner);
    for (i32 i = 0; i < this.methodCount; i++) {
      if (this.methodOwners[i] == owner && this.methodNames[i] == name) { return i; }
    }
    return -1;
  }

  /** The body of the method at `at`, or an empty one. See `methodBodies`. */
  Stmt[] methodBodyAt(this, i32 at) {
    return at >= 0 && at < this.methodCount ? this.methodBodies[at] : Stmt[]();
  }

  /** Which entry holds `owner.name`, following the inheritance chain, or -1. */
  i32 methodAt(this, string owner, string name) {
    owner = templateOf(owner);
    string at = owner;
    for (i32 hop = 0; hop <= this.structCount; hop++) {
      if (at == "") { return -1; }
      for (i32 i = 0; i < this.methodCount; i++) {
        if (this.methodOwners[i] == at && this.methodNames[i] == name) { return i; }
      }
      at = this.parentOf(at);
    }
    return -1;
  }

  /**
   * Whether `owner` has a field called `name` at all, whatever its type.
   *
   * Distinct from `fieldType` answering something: a funcref field has no name this slice can spell,
   * so its type is unknown while the field plainly exists. `sh.externalNames()` calls one, and asking
   * the type would have said "no such field" about a field two lines above it.
   */
  bool hasField(this, string owner, string name) {
    string at = templateOf(owner);
    for (i32 hop = 0; hop <= this.structCount; hop++) {
      if (at == "") { return false; }
      for (i32 i = 0; i < this.fieldCount; i++) {
        if (this.fieldOwners[i] == at && this.fieldNames[i] == name) { return true; }
      }
      at = this.parentOf(at);
    }
    return false;
  }

  /** Whether `owner.name` is a const field, following the inheritance chain. */
  bool isConstField(this, string owner, string name) {
    string at = templateOf(owner);
    for (i32 hop = 0; hop <= this.structCount; hop++) {
      if (at == "") { return false; }
      for (i32 i = 0; i < this.fieldCount; i++) {
        if (this.fieldOwners[i] == at && this.fieldNames[i] == name) { return this.fieldConsts[i]; }
      }
      at = this.parentOf(at);
    }
    return false;
  }

  /** How many fields `owner` declares itself, ignoring anything inherited. */
  i32 ownFieldCount(this, string owner) {
    i32 n = 0;
    for (i32 i = 0; i < this.fieldCount; i++) {
      if (this.fieldOwners[i] == owner) { n = n + 1; }
    }
    return n;
  }

  /** The type of `owner`'s `k`th own field, in declaration order. */
  string ownFieldAt(this, string owner, i32 k) {
    i32 n = 0;
    for (i32 i = 0; i < this.fieldCount; i++) {
      if (this.fieldOwners[i] != owner) { continue; }
      if (n == k) { return this.fieldTypes[i]; }
      n = n + 1;
    }
    return typeNone();
  }

  /**
   * How many fields a positional construction of `owner` takes.
   *
   * Inherited ones included, because a construction fills them: `C(1, 2.0)` for `struct C : B` with
   * `B { i32 b }` and `C { f64 c }` fills `b` then `c`. The parent's come **first**, which is not a
   * guess — `C(1.0, 2.0)` puts the reference's complaint on the first argument.
   */
  i32 constructArity(this, string owner) {
    i32 n = 0;
    string at = templateOf(owner);
    for (i32 hop = 0; hop <= this.structCount; hop++) {
      if (at == "") { return n; }
      n = n + this.ownFieldCount(at);
      at = this.parentOf(at);
    }
    return n;
  }

  /** The type of the `i`th positional field of `owner`, parents first. */
  string constructFieldAt(this, string owner, i32 i) {
    owner = templateOf(owner);
    string parent = this.parentOf(owner);
    i32 inherited = parent == "" ? 0 : this.constructArity(parent);
    if (i < inherited) { return this.constructFieldAt(parent, i); }
    return this.ownFieldAt(owner, i - inherited);
  }

  /**
   * The type of `owner.name`, following the inheritance chain, or `typeNone`.
   *
   * A field the chain does not have is unknown rather than an error: *"struct 'P' has no field
   * 'nope'"* is the reference's own diagnostic and a family this slice does not own. The walk is
   * bounded by the number of structs, so a cycle in the parent chain — which the reference rejects
   * separately — terminates here rather than hanging.
   */
  /** The type of a struct's `i`th field, in declaration order — what a positional argument goes into. */
  string fieldTypeAtIndex(this, string owner, i32 i) {
    string at = templateOf(owner);
    i32 seen = 0;
    for (i32 k = 0; k < this.fieldCount; k++) {
      if (this.fieldOwners[k] != at) { continue; }
      if (seen == i) { return substituteType(this, owner, this.fieldTypes[k]); }
      seen = seen + 1;
    }
    return typeNone();
  }

  string fieldType(this, string owner, string name) {
    // The table is keyed by template — `Box`, never `Box<i32>` — so an instantiation resolves to its
    // template to find the field and substitutes on the way back out.
    string at = templateOf(owner);
    for (i32 hop = 0; hop <= this.structCount; hop++) {
      if (at == "") { return typeNone(); }
      for (i32 i = 0; i < this.fieldCount; i++) {
        if (this.fieldOwners[i] == at && this.fieldNames[i] == name) {
          return substituteType(this, owner, this.fieldTypes[i]);
        }
      }
      at = this.parentOf(at);
    }
    return typeNone();
  }

  /**
   * Whether this name is a struct declared here.
   *
   * Deliberately narrower than "not a primitive". An enum, an imported type or a generic parameter is
   * also not a primitive, and this slice has not measured what the reference says about comparing
   * those — so they stay unknown rather than being swept in by a rule about everything else.
   */
  bool isStruct(const this, string name) {
    // An instantiation is a struct: `Box<i32>` is as much a reference type as `Box` is, and every
    // rule that asks this question means the reference-type one. `isGeneric` stays exact, so the two
    // together say what is wanted — a bare `Box` is the unmodelled template, `Box<i32>` is a type.
    string at = templateOf(this.canon(name));
    for (i32 i = 0; i < this.structCount; i++) {
      if (this.structNames[i] == at) { return true; }
    }
    return false;
  }

  /** Which entry holds this function, or -1. */
  i32 funcAt(this, string name) {
    string want = this.canon(name);
    for (i32 i = 0; i < this.funcCount; i++) {
      if (this.funcNames[i] == want) { return i; }
    }
    return -1;
  }

  /**
   * Forget every name, for the next function — except the module-level ones.
   *
   * A file's `const` declarations are in scope everywhere in it, so they are declared once before any
   * body is walked and survive the clear. `globalCount` is where the per-function names start; a
   * function's own names are the ones above it.
   */
  void clearScope(this) { this.nameCount = this.globalCount; this.openScopeCount = 0; }

  /**
   * Enter a scope; the body array is its identity.
   *
   * **The count rises even when the table is full**, so that `popScope` stays its exact inverse.
   * Skipping the increment instead would make the next `popScope` discard a real enclosing scope,
   * and from there every outer name reads as out of scope — an avalanche of false errors from a
   * nesting depth nobody reaches. Past the table, `innermost` keeps answering the deepest scope it
   * did record, which is the lenient direction: names stay visible, as they were before scopes.
   */
  void pushScope(this, Stmt[] body) {
    if (this.openScopeCount < this.openScopes.len()) { this.openScopes[this.openScopeCount] = body; }
    this.openScopeCount = this.openScopeCount + 1;
  }

  /** The scope a declaration lands in, clamped to what the table holds. */
  Stmt[] innermost(const this) {
    i32 n = this.openScopeCount;
    if (n > this.openScopes.len()) { n = this.openScopes.len(); }
    if (n == 0) { return Stmt[](); }
    return this.openScopes[n - 1];
  }

  void popScope(this) {
    if (this.openScopeCount > 0) { this.openScopeCount = this.openScopeCount - 1; }
  }

  /** How many scopes are open, clamped to what the table recorded. */
  i32 scopeTop(const this) {
    return this.openScopeCount > this.openScopes.len()
      ? this.openScopes.len()
      : this.openScopeCount;
  }

  /**
   * How deeply nested the scope that declared name `i` is, or -1 when it is not open here.
   *
   * Globals answer 0 — they live below `globalCount` and no scope declared them — and so does
   * anything declared while no scope was open, which is the state a caller that never pushes one
   * is in. This has to stay usable by walks that do not track scope at all.
   */
  i32 depthOf(const this, i32 i) {
    if (i < this.globalCount) { return 0; }
    if (this.nameScope[i] is this.noScope) { return 0; }
    for (i32 k = this.scopeTop() - 1; k >= 0; k--) {
      if (this.openScopes[k] is this.nameScope[i]) { return k + 1; }
    }
    return -1;
  }

  /**
   * The table index `name` resolves to here, or -1 for a name nothing in scope declared.
   *
   * **Innermost wins, not latest.** The declare walk declares every name in a function before the
   * check walk reads any of them, so a `k` declared later in the function body is already in the
   * table while an inner loop's own `k` is being checked — and both are in scope, so a scan that
   * simply takes the last match gives the inner `k` the outer one's type. That is not theoretical:
   * `packages/crypto/src/fieldp.wac` has an `i32 k` loop counter and an `i64 k` further down the
   * same function, and it reported `i64 and i32` on `k < n`. Depth separates them; among equal
   * depths the later declaration wins, which is what shadowing means.
   */
  i32 findName(const this, string name) {
    i32 top = this.scopeTop();
    i32 best = -1;
    i32 bestDepth = -1;
    for (i32 i = this.nameCount - 1; i >= 0; i--) {
      if (this.names[i] != name) { continue; }
      i32 d = this.depthOf(i);
      if (d > bestDepth) {
        best = i;
        bestDepth = d;
        // Nothing can be nested deeper than the scope we are standing in.
        if (d == top) { return best; }
      }
    }
    return best;
  }

  void declareEnum(this, string name, string[] typeParams) {
    if (this.enumCount >= this.enumNames.len()) { return; }
    this.enumNames[this.enumCount] = name;
    this.enumParamAt[this.enumCount] = this.enumParamTotal;
    this.enumParamCount[this.enumCount] = typeParams.len();
    for (i32 i = 0; i < typeParams.len(); i++) {
      if (this.enumParamTotal >= this.enumParamNames.len()) { break; }
      this.enumParamNames[this.enumParamTotal] = typeParams[i];
      this.enumParamTotal = this.enumParamTotal + 1;
    }
    this.enumCount = this.enumCount + 1;
  }

  /** Which entry holds this enum, or -1. */
  i32 enumAt(const this, string name) {
    for (i32 i = 0; i < this.enumCount; i++) {
      if (this.enumNames[i] == name) { return i; }
    }
    return -1;
  }

  /** Record `Enum.Variant` with its payload count, ambiguity and all. */
  /**
   * Whether this variant has a bare name — false for a generic enum's, whose variants belong to its
   * instances. Kept beside the table rather than derived, because by the time somebody writes `is
   * Some` the enum's type parameters are three lookups away.
   */
  void markVariantBare(this, string name, bool bare) {
    for (i32 i = this.variantCount - 1; i >= 0; i--) {
      if (this.variantNames[i] == name) { this.variantBare[i] = bare; return; }
    }
  }

  void declareVariant(this, string owner, string name, i32 arity) {
    if (this.variantCount >= this.variantNames.len()) { return; }
    this.variantOwners[this.variantCount] = owner;
    this.variantNames[this.variantCount] = name;
    this.variantArities[this.variantCount] = arity;
    this.variantBare[this.variantCount] = true;
    this.variantCount = this.variantCount + 1;
  }

  /**
   * How many payload fields `Enum.Variant` has, or -1 when this enum has no such variant.
   *
   * Asked with **both** names, which is the whole point: the answer for `Found.Ok` is one whatever
   * `Opened.Ok` happens to hold.
   */
  i32 variantArityIn(const this, string owner, string name) {
    string want = this.canon(owner);
    for (i32 i = 0; i < this.variantCount; i++) {
      if (this.variantOwners[i] == want && this.variantNames[i] == name) {
        return this.variantArities[i];
      }
    }
    return -1;
  }

  /**
   * Is this the name of a variant of some enum that is in scope?
   *
   * Asked by name alone, unlike `variantArityIn`, because the question here is whether the file may
   * *write* the name at all — `x is Circle` needs `Circle` to have come from somewhere, and which
   * enum owns it is the next question rather than this one.
   */
  bool isVariantName(const this, string name) {
    for (i32 i = 0; i < this.variantCount; i++) {
      if (this.variantNames[i] == name && this.variantBare[i]) { return true; }
    }
    return false;
  }

  /** An enum has no default value, which is the only thing this pass records about one. */
  bool isEnum(const this, string name) {
    string want = this.canon(name);
    for (i32 i = 0; i < this.enumCount; i++) {
      if (this.enumNames[i] == want) { return true; }
    }
    return false;
  }

  void report(this, i32 code, i32 line, i32 col) {
    // **Quiet is for a file being read only for its declarations.** An import is walked to learn
    // what it declares, not to be judged: its diagnostics belong to its own compilation, and
    // reporting them here would put another file's line numbers in this file's answer.
    if (this.quiet) { return; }
    if (this.errorCount * 3 + 3 > this.errors.len()) { return; }
    // **The same complaint twice is one complaint.** A literal is now checked on two paths — the
    // one that types it and the one that only asks whether it fits — and an assignment takes both.
    // The reference reports it once, and a diagnostic list that says it twice is a list that
    // disagrees about how many things are wrong.
    //
    // **Every entry, not just the last one.** This compared against `errorCount - 1` alone, so a
    // repeat separated by any other diagnostic went straight through: `i32 r = a & b;` for an `i32`
    // and a `bool` printed *operands have mismatched types* at 1:42, then a second rule's complaint
    // at the same character, then *operands have mismatched types at 1:42 again* — three errors for
    // one mistake where the reference reports one. **630 of the 10,013 generated sweep programs**
    // were in that shape, and neither rung-3 check could see it: both ask whether each position we
    // report is one the reference reports, and a second copy of a position still is.
    //
    // The scan is linear in a list that `errors.len()` caps, and it runs only when a rule has already
    // decided to report, so it costs nothing measurable against the walk that got here.
    for (i32 i = 0; i < this.errorCount; i++) {
      if (this.errors[i * 3] == code && this.errors[i * 3 + 1] == line &&
          this.errors[i * 3 + 2] == col) {
        return;
      }
    }
    this.errors[this.errorCount * 3] = code;
    this.errors[this.errorCount * 3 + 1] = line;
    this.errors[this.errorCount * 3 + 2] = col;
    if (this.errorCount < this.errorNotes.len()) { this.errorNotes[this.errorCount] = ""; }
    this.errorCount = this.errorCount + 1;
  }

  /**
   * The same, with the operands the rule was broken by.
   *
   * Kept as a second entry point rather than a fourth parameter on `report`, because most of the
   * hundred-odd call sites have nothing to say and a required argument would have them all inventing
   * one. The note is added after the fact so the de-duplication in `report` still decides whether
   * there is an error here at all.
   */
  void reportWith(this, i32 code, i32 line, i32 col, string note) {
    i32 before = this.errorCount;
    this.report(code, line, col);
    if (this.errorCount == before) { return; }
    if (before < this.errorNotes.len()) { this.errorNotes[before] = note; }
  }

  /**
   * Record that the diagnostic at slot `before` should print from `callLine` down.
   *
   * **The rule lives here rather than at each caller.** The reference has one site and one condition —
   * *"if the argument sits on a later line than the call opens on, point the diagnostic's leading
   * context back at the call line"* — and wacc has the same rule spread over three argument-checking
   * functions reaching three different report methods. Passing both lines in keeps "only when they
   * differ" from being written out six times, which is how a rule comes to be enforced five ways.
   *
   * Called *after* the report, with the count taken before it, because a report can decline: quiet
   * while an import is walked, past the cap, or collapsed as a repeat of the diagnostic before it. Any
   * of those and there is no slot to annotate — the same guard `reportWith` and `reportTok` use.
   * `issues/lang/0232a`.
   */
  void contextAt(this, i32 before, i32 argLine, i32 callLine) {
    if (this.errorCount == before) { return; }
    if (argLine == callLine || callLine <= 0) { return; }
    if (before < this.errorContexts.len()) { this.errorContexts[before] = callLine; }
  }

  /**
   * The width from one token's start to another's end, or 0 when they are not on one line.
   *
   * **Zero is honest rather than a guess.** A span is a single-line measurement in every renderer here,
   * so an expression that runs across lines has no width this can state — `§wac-diag-multiline-ic7x2hq`
   * renders such a case by underlining the *last* line's part, which is a decision for the formatter
   * rather than a number for the wire.
   */
  i32 widthBetween(const this, i32 fromTok, i32 toTok) {
    if (fromTok < 0 || toTok < 0) { return 0; }
    i32 fl = this.toks[fromTok * tokenStride() + 3];
    i32 tl = this.toks[toTok * tokenStride() + 3];
    if (fl != tl) { return 0; }
    i32 fc = this.toks[fromTok * tokenStride() + 4];
    i32 tc = this.toks[toTok * tokenStride() + 4];
    i32 tw = this.toks[toTok * tokenStride() + 2];
    return tc + tw - fc;
  }

  /** `reportWith`, with a width measured by the caller. */
  void reportSpan(this, i32 code, i32 line, i32 col, string note, i32 width) {
    i32 before = this.errorCount;
    this.report(code, line, col);
    if (this.errorCount == before) { return; }
    if (before < this.errorNotes.len()) { this.errorNotes[before] = note; }
    if (before < this.errorWidths.len() && width > 0) { this.errorWidths[before] = width; }
  }

  /** The same, with a hint written for this diagnostic rather than for its code. */
  void reportSpanHinted(this, i32 code, i32 line, i32 col, string note, i32 width, string hint) {
    i32 before = this.errorCount;
    this.report(code, line, col);
    if (this.errorCount == before) { return; }
    if (before < this.errorNotes.len()) { this.errorNotes[before] = note; }
    if (before < this.errorWidths.len() && width > 0) { this.errorWidths[before] = width; }
    if (before < this.errorHints.len()) { this.errorHints[before] = hint; }
  }

  /**
   * The same, keeping the caller's position and taking **only the width** from a token.
   *
   * `reportTok` moves the report to the token, which is wrong wherever the position was chosen
   * deliberately: `x += 1.5;` is reported at `x`, and the first version of the span work handed
   * `reportTok` the literal's token and moved it to `1.5` — the reference says 1:26, we said 1:31, and
   * rung 3 failed on the difference. Position and width are separate decisions, so they are separate
   * arguments.
   */
  void reportWidthOf(this, i32 code, i32 line, i32 col, string note, i32 tok) {
    i32 before = this.errorCount;
    this.report(code, line, col);
    if (this.errorCount == before) { return; }
    if (before < this.errorNotes.len()) { this.errorNotes[before] = note; }
    if (before < this.errorWidths.len()) {
      this.errorWidths[before] = this.toks[tok * tokenStride() + 2];
    }
  }

  /** The same, positioned *at a token* — which is what makes a width knowable. */
  void reportTok(this, i32 code, i32 tok, string note) {
    i32 before = this.errorCount;
    this.report(code, this.toks[tok * tokenStride() + 3], this.toks[tok * tokenStride() + 4]);
    if (this.errorCount == before) { return; }
    if (before < this.errorNotes.len()) { this.errorNotes[before] = note; }
    if (before < this.errorWidths.len()) { this.errorWidths[before] = this.toks[tok * tokenStride() + 2]; }
  }
}

/**
 * A token's kind.
 *
 * `Binary.op` is a token *index*, not a kind — `print.wac` renders it with `tok(op)`, which reads the
 * source text at that index. Comparing the index against a `kPlus()` constant compares an index to a
 * kind and is quietly always false, which is what the first version of the operand check did: it
 * compiled, ran, and reported nothing.
 */
i32 tokenKind(C c, i32 t) {
  if (t < 0) { return -1; }
  return c.toks[t * tokenStride()];
}

/** A token's line, for the diagnostics that name a keyword rather than a node. */
i32 tokenLine(C c, i32 t) { return c.toks[t * tokenStride() + 3]; }

/** A token's column, paired with `tokenLine`. */
i32 tokenCol(C c, i32 t) { return c.toks[t * tokenStride() + 4]; }

/** A token's source text. Primitive type names are ordinary identifiers, so this is how they are read. */
string tokenText(C c, i32 t) {
  if (t < 0) { return ""; }
  i32 start = c.toks[t * tokenStride() + 1];
  i32 len = c.toks[t * tokenStride() + 2];
  u8[] out = u8[len]();
  for (i32 i = 0; i < len; i++) { out[i] = c.src[start + i]; }
  return string.fromBytes(out);
}

/**
 * The canonical name of a declared type, or `typeNone` for one this slice cannot name.
 *
 * `Prim` and `Named` are both just their token's text — `i32` and `P` are the same question once a
 * type is a name. An array, a nullable or a funcref is unknown: they have names (`i32[]`, `P?`) that
 * this could spell, and nothing here compares them yet, so spelling them would be inventing a
 * capability the rules do not have.
 */
/**
 * Is this name something the file may write as a type?
 *
 * A struct or an enum it declared or imported, and `isDeclaredName` for everything else that carries
 * a name into scope — an imported alias the single-file slice knows only as unknown, and the two
 * things the spec says look like type names and are not: `f(x)` where `f` is a funcref, and
 * `x is Other` where `Other` is a variable, which is an identity test.
 */
/**
 * Report a name that is standing in a type position and is a **binding** rather than a type.
 *
 * `knownTypeName` accepts any declared name on purpose, and its comment gives the two reasons: the
 * spec says `x is Other` where `Other` is a variable is an identity test, and `f(x)` where `f` is a
 * funcref is a call. Both are bare names at the *top* of a type, and both are why that function may
 * not simply ask "is this a type". Inside `[]` or before `?` there is no such reading — a name there
 * is a type or the program is wrong — so the permissiveness those two need is a hole here.
 *
 * What it cost was a silence. `i32 zz = 1; zz[1]();` drew **no diagnostic at all**: `zz` is declared,
 * so `zz[]` was invented and travelled, either into a mismatch naming a type not in the program —
 * *expected i32, found zz[]* — or, in a statement position, into nothing whatever, leaving the
 * emitter's whole-module decline as the only thing between `wac check`'s "no diagnostics" and a
 * module a reader would believe. The reference reports `undefined type 'zz'` for both.
 *
 * **Import-only is exempt, and that is the reason this cannot just be `isStruct || isEnum`.** Under a
 * single-file check an imported alias is declared with no type so that the name *exists*
 * (`nameImportOnly`) — calling that undefined would report on every file that imports a type. A
 * binding with a real type behind it is not that case.
 *
 * Returns true when it reported, so the caller answers `typeNone()` and nothing invents a spelling.
 * **Two positions of four.** `fn[i32(zz)]` and `Box<zz>` have the same root and are not silent — they
 * report a downstream mismatch against an invented `fn(zz) -> i32` — so they are a worse message
 * rather than a missing one, and are left for a change that can be checked against the reference's
 * wording.
 */
bool bindingAsType(C c, Ty elem) {
  match (elem.kind) {
    case Named(etok, eargs): {
      if (eargs.len() > 0) { return false; }
      string ebase = c.canon(c.renamed(tokenText(c, etok)));
      if (!c.scopeTypes) { return false; }
      if (c.isStruct(ebase) || c.isEnum(ebase) || c.isVariantName(ebase)) { return false; }
      return !c.isImportOnlyName(ebase) && c.isDeclaredName(ebase);
    }
    else: { return false; }
  }
}

/**
 * The same question, reported.
 *
 * **Split from the predicate because the two callers need different halves, and reporting from both
 * would contradict the reference.** The typing walk must answer `typeNone()` so that no `zz[]`
 * spelling is invented and carried into a second diagnostic — `return zz[1]();` produced *expected
 * i32, found zz[]* that way, a position the reference does not report, which is a contradiction and
 * not merely a worse message. The checking walk is the one that runs once per expression, so it is the
 * one that says so. Unknown is silent everywhere in this checker, which is what makes that division
 * safe rather than a second silence.
 */
bool reportBindingAsType(C c, Ty elem) {
  if (!bindingAsType(c, elem)) { return false; }
  match (elem.kind) {
    case Named(etok, eargs): {
      c.reportTok(errUndefinedType(), etok,
                  "unknown type '" + c.canon(c.renamed(tokenText(c, etok))) + "'");
      return true;
    }
    else: { return false; }
  }
}

bool knownTypeName(C c, string base) {
  // **Declared is not the same as in scope.** A type reached through an imported signature is
  // declared so that its members can be resolved, and writing its name is still an error — see
  // `C.unnameable`.
  if (c.isUnnameable(base)) { return false; }
  return c.isStruct(base) || c.isEnum(base) || c.isDeclaredName(base) || c.isVariantName(base);
}

export string typeOfTy(C c, Ty t) {
  match (t.kind) {
    case Prim(tok): { return tokenText(c, tok); }
    case Named(tok, typeArgs): {
      // A generic instantiation spells itself. `Box<i32>` and `Box<f64>` are different types and the
      // model here is that a type *is* its canonical name, so the name has to carry the arguments —
      // an earlier version returned unknown for all of them, which made every generic invisible.
      // Invariance then costs nothing: two instantiations differ exactly when their names do.
      // Under the importing file's name for it, when this is an imported file being declared: a
      // signature that says `Dup` in `b.wac` says `DupB` to the file that imported it that way.
      string base = c.canon(c.renamed(tokenText(c, tok)));
      // **A type parameter of the function being checked is an unknown type**, not a name. `T` in
      // `T oops<T>(T a)` stands for whatever a call site binds, so every question about it has an
      // answer this checker cannot compute — and answering with the letter itself made `return a;` a
      // mismatch against a type nobody declared.
      for (i32 i = 0; i < c.activeParamCount; i++) {
        if (c.activeParams[i] == base) { return typeNone(); }
      }
      // Spelled as identifiers and declared by nobody, so resolution would hunt for a declaration
      // and find none. They *are* types; what needed fixing was the hierarchy they sit in, which
      // `isReferenceType` answers.
      if (base == "anyref" || base == "i31ref") { return base; }
      // **The three reports below name the token, not the node's position.** They are the same place
      // — a `Named` type is positioned at its own name — and `reportTok` records the name's *width*
      // as well, which is what puts the caret under `Circle` rather than under its first letter.
      // Forty-seven of the corpus's 264 spanless diagnostics were this one code, the largest single
      // group; `waccx.test.ts` measures the share and holds a floor under it.
      // **A name that resolves to nothing is not a type this file may write.** Writing one requires
      // importing it, variants included (`§wac-type-name-scope-8vqk3mn`) — and the cost of not
      // saying so was a wrong answer rather than a missing message: an unresolved name had no type
      // index, so `x is Circle` fell back to a table keyed by bare name and answered about whichever
      // module's `Circle` was declared first.
      // **A template takes the number of arguments it declares.** `Box<i32, f64>` names no type, and
      // the arity is the one thing that can be checked here without instantiating anything.
      // `spec/cases/0072`.
      if (typeArgs.len() > 0) {
        i32 sat = c.structAt(base);
        if (sat >= 0 && c.structParamCount[sat] != typeArgs.len()) {
          c.reportTok(errUndefinedType(), tok, "");
          return typeNone();
        }
      }
      if (c.scopeTypes && !knownTypeName(c, base)) {
        // **The spec names these words.** `§wac-diag-parse-bad-type-n7qm3xf`: *"The compiler must emit
        // `span: 3`, `annotation: "unknown type 'foo'"`"*. This said "no type foo in scope", which is
        // the same fact in different words — and where the spec quotes an annotation, the quote is the
        // contract. The reference attaches no annotation here at all, so nothing is lost by agreeing
        // with the spec instead of with it.
        c.reportTok(errUndefinedType(), tok, "unknown type '" + base + "'");
        return typeNone();
      }
      // **A template is not a type.** `Box b = Box(1)` writes the name of a thing that takes an
      // argument and gives none, and the language wants `Box<i32>`. This was refused by accident
      // until now — the construction's field read as *expected T, found i32*, a complaint about the
      // wrong half of the program, and it went silent the moment a bare `Box(5)` stopped being asked
      // to be a `T`. Inside the template's own body the bare name is how the receiver is written,
      // which is what the active parameters say. `spec/cases/0088`.
      if (typeArgs.len() == 0) {
        i32 gsi = c.structAt(base);
        i32 gei = c.enumAt(base);
        bool template = (gsi >= 0 && c.structParamCount[gsi] > 0) ||
                        (gei >= 0 && c.enumParamCount[gei] > 0);
        if (template && c.activeParamCount == 0) {
          c.reportTok(errUndefinedType(), tok, base + " takes type arguments");
          return typeNone();
        }
        return base;
      }
      string out = base + "<";
      for (i32 i = 0; i < typeArgs.len(); i++) {
        string a = typeOfTy(c, typeArgs[i]);
        if (a == typeNone()) { return typeNone(); }
        if (i > 0) { out = out + ", "; }
        out = out + a;
      }
      return out + ">";
    }
    // `i32[]` and `P?` are names too, built from the name inside. An element or inner type this
    // slice cannot spell makes the whole thing unspellable rather than half-named: `Box<i32>[]` is
    // not `[]`.
    case Arr(elem): {
      // A name inside `[]` is a type or the program is wrong — `reportBindingAsType`. This is how
      // `issues/lang/0265c` is *seen* rather than what causes it: `a[0]()` reads as constructing an
      // array of the type `a` because nothing at parse time separates a type name from a variable, and
      // that reading stands. What changes is that the name is resolved as a type, so the message names
      // `a` instead of inventing `a[]` and carrying it downstream.
      if (reportBindingAsType(c, elem)) { return typeNone(); }
      string inner = typeOfTy(c, elem);
      if (inner == typeNone()) { return typeNone(); }
      return inner + "[]";
    }
    case Nullable(inner): {
      // The same hole as `Arr` above, and it was silent in the same way: `i32 zz = 1; zz? q = null;`
      // drew nothing at all while the reference said `undefined type 'zz'`. Found by asking what the
      // siblings of the `[]` case were rather than by a second report.
      if (reportBindingAsType(c, inner)) { return typeNone(); }
      string base = typeOfTy(c, inner);
      if (base == typeNone()) { return typeNone(); }
      return base + "?";
    }
    // A funcref spells itself the way the reference words it — `fn(i32) -> i32` — so two of them are
    // the same type exactly when their parameters and return agree, which is what the language means
    // by assignable here. There is no variance: `fn(bool) -> i32` does not hold a `fn(i32) -> i32`.
    case Funcref(ret, params): {
      string out = "fn(";
      for (i32 i = 0; i < params.len(); i++) {
        string pt = typeOfTy(c, params[i]);
        if (pt == typeNone()) { return typeNone(); }
        if (i > 0) { out = out + ", "; }
        out = out + pt;
      }
      string rt = typeOfTy(c, ret);
      if (rt == typeNone()) { return typeNone(); }
      return out + ") -> " + rt;
    }
  }
}

/**
 * Report a literal that does not fit, with the caller's own code — unless the problem is the range,
 * which has a code of its own.
 *
 * Eight positions ask this question and the reference answers all of them the same way, so the choice
 * is one function here or the same three lines eight times. `mismatch` is what the caller calls a
 * wrong *family*; a float too large for an `f32` is a different complaint about a literal that was
 * otherwise the right kind.
 */
/**
 * A character literal holds exactly one character.
 *
 * Called from two places because a literal reaches the checker two ways: through `checkExpr`, and
 * through the fast path that asks only whether it *fits* a wanted type — `return 'ab'` and
 * `i32 x = 'ab'` take the second and never touched the first.
 */
void checkCharLiteral(C c, Expr e) {
  match (e.kind) {
    case IntLit(tok): {
      string lit = tokenText(c, tok);
      if (lit.len() < 2 || lit[0] != "'") { return; }
      string inner = lit.slice(1, lit.len() - 1);
      if (inner == "") {
        c.report(errCharLiteral(), e.line, e.col);
        return;
      }
      // An escape is one character by construction; anything else is one only if its first
      // character's encoding covers the whole of what is between the quotes.
      if (inner[0] != "\\" && utf8Width(inner) != inner.len()) {
        c.report(errCharLiteral(), e.line, e.col);
      }
    }
    else: { }
  }
}

/**
 * The token an expression is written at, or -1 where it is not a single one.
 *
 * **This is what makes a caret's width knowable.** `reportTok` reads the width out of the token table;
 * `reportWith` takes a line and a column and records `span: 0`, which the wire means as *"nothing
 * measured a width"* — so a rendered diagnostic puts one caret under the first character of the
 * offending expression instead of under the whole of it. `spec/spec/errors.md` states the width for
 * particular programs — `span: 1` for `if (x)` under `§wac-diag-bool-r8kn4wp` and `span: 4` for
 * `3.14` under `§wac-diag-assign-j3qm7xf` — so these are clauses rather than presentation.
 *
 * Only the leaves carry a token: an `Ident` and the three literal kinds. A compound expression has no
 * single token and answers -1, which is honest — its width is a question about where it ends, and the
 * parser does not record that today.
 */
i32 tokenOfExpr(Expr e) {
  return match (e.kind) {
    case Ident(tok): tok,
    case IntLit(tok): tok,
    case FloatLit(tok): tok,
    case StrLit(tok): tok,
    else: -1
  };
}

/**
 * The **last** token of an expression, or -1 where the shape does not carry one.
 *
 * With `tokenOfExpr` as the first token this gives an extent, which is what the spec's wider clauses
 * ask for: `span: 7` over `sum > 0` (`§wac-diag-wide-k4rn8wp`) and `span: 3` over `p.x`
 * (`§wac-diag-const-w2jm5xf`). A `Call` or an `Index` ends at a bracket the parser does not record, so
 * those answer -1 and keep the zero they had — a missing width is better than a wrong one.
 */
i32 lastTokenOfExpr(Expr e) {
  return match (e.kind) {
    case Ident(tok): tok,
    case IntLit(tok): tok,
    case FloatLit(tok): tok,
    case StrLit(tok): tok,
    case Member(obj, nameTok): nameTok,
    case Binary(op, left, right): lastTokenOfExpr(right),
    case Unary(op, operand): lastTokenOfExpr(operand),
    else: -1
  };
}

/** The first token of an expression, following the left edge down. */
i32 firstTokenOfExpr(Expr e) {
  return match (e.kind) {
    case Ident(tok): tok,
    case IntLit(tok): tok,
    case FloatLit(tok): tok,
    case StrLit(tok): tok,
    case Member(obj, nameTok): firstTokenOfExpr(obj),
    case Binary(op, left, right): firstTokenOfExpr(left),
    case Index(arr, index): firstTokenOfExpr(arr),
    case Call(callee, args): firstTokenOfExpr(callee),
    else: -1
  };
}

/** The same pair for an lvalue: `p.x` is `p` through `x`. */
i32 firstTokenOfLvalue(Lvalue lv) {
  return match (lv.kind) {
    // No `else`: the four variants are all of them, and wacc refuses a dead arm — which is the
    // checker catching this file the moment it was written.
    case LIdent(tok): tok,
    case LField(base, nameTok): firstTokenOfLvalue(base),
    case LIndex(base, index): firstTokenOfLvalue(base),
    case LUnwrap(base): firstTokenOfLvalue(base)
  };
}

i32 lastTokenOfLvalue(Lvalue lv) {
  return match (lv.kind) {
    case LIdent(tok): tok,
    case LField(base, nameTok): nameTok,
    else: -1
  };
}

/**
 * The source text an expression is written as, or `""` where its extent is unknown.
 *
 * Read from the source between the first token's start and the last token's end, so it is the reader's
 * own spelling — spacing and all — rather than something printed back from the tree. That is what a
 * hint quoting the expression needs: `use \`(sum > 0) as i32\` to convert` has to say `sum > 0`
 * because that is what is on the line the caret is under.
 */
string sourceOfExpr(C c, Expr e) {
  i32 a = firstTokenOfExpr(e);
  i32 b = lastTokenOfExpr(e);
  if (a < 0 || b < 0) { return ""; }
  i32 start = c.toks[a * tokenStride() + 1];
  i32 end = c.toks[b * tokenStride() + 1] + c.toks[b * tokenStride() + 2];
  if (end <= start || end > c.src.len()) { return ""; }
  u8[] out = u8[end - start]();
  for (i32 i = 0; i < end - start; i++) { out[i] = c.src[start + i]; }
  return string.fromBytes(out);
}

/** `reportWith`, with the width of the whole expression where its extent is knowable. */
void reportExprSpan(C c, i32 code, Expr e, string note) {
  c.reportSpan(code, e.line, e.col, note, c.widthBetween(firstTokenOfExpr(e), lastTokenOfExpr(e)));
}

/** The same for an lvalue, reported at `at` — which is the root, not the whole path. */
void reportLvalueSpan(C c, i32 code, Lvalue at, Lvalue whole, string note) {
  c.reportSpan(code, at.line, at.col, note,
               c.widthBetween(firstTokenOfLvalue(whole), lastTokenOfLvalue(whole)));
}

/** `reportWith`, positioned at the expression's own token when it has one. */
void reportExpr(C c, i32 code, Expr e, string note) {
  i32 tok = tokenOfExpr(e);
  if (tok >= 0) {
    c.reportWidthOf(code, e.line, e.col, note, tok);
    return;
  }
  c.reportWith(code, e.line, e.col, note);
}

void reportLiteral(C c, string want, Expr e, i32 mismatch, i32 line, i32 col) {
  checkCharLiteral(c, e);
  if (literalFits(c, want, e)) { return; }
  if (!acceptsLiteral(want, litFamily(c, e))) {
    // The literal's own family is what it was found to be: `1.5` in an `i32` slot is a float where an
    // integer was wanted, and saying so is the whole of the complaint.
    // **At the literal's token where there is one**, which is what gives `3.14` a caret four wide
    // rather than one — `§wac-diag-assign-j3qm7xf` states that width. The line and column arguments
    // stay for the compound case, where no single token holds the expression.
    i32 tok = tokenOfExpr(e);
    if (tok >= 0) {
      c.reportWidthOf(mismatch, line, col, expectedFound(want, foundType(c, e)), tok);
    } else {
      c.reportWith(mismatch, line, col, expectedFound(want, foundType(c, e)));
    }
    return;
  }
  // A range complaint names the **literal**, where a family mismatch names the whole expression:
  // `i32 x = -1.5` is reported at the `-` and `f32 x = -1.0e40` at the `1`. Measured, and the pair is
  // worth stating together, because either one alone reads as an off-by-one against the other.
  Expr inner = innermostLiteral(e);
  c.reportWith(errFloatRange(), inner.line, inner.col, "out of range for " + want);
}

/**
 * A literal that stands for a value — so not `null`, which stands for the absence of one.
 *
 * **`litFamily`, so a compound literal counts.** `1 + 1` is an integer literal exactly as `1` is, and
 * asking `litKindOf` here meant the two were different programs to every rule that gated on this:
 * `b ? 1 + 1 : "a"` was accepted while `b ? 1 : "a"` was refused, in all six shapes of that pair.
 * Takes a `C` for the same reason `litFamily` does — an operator's kind is a token, and a token needs
 * the source. `issues/lang/0246a`.
 */
bool isPlainLiteral(C c, Expr e) {
  i32 k = litFamily(c, e);
  return k != litNone() && k != litNull();
}

/** The literal under any signs — `1.0e40` in `-1.0e40`, and the expression itself otherwise. */
Expr innermostLiteral(Expr e) {
  match (e.kind) {
    case Unary(op, operand): { return innermostLiteral(operand); }
    else: { return e; }
  }
}

/**
 * A float literal's value, read out of its text.
 *
 * Needed for one rule and no other: an `f32` slot refuses a literal too large to be one, and the
 * boundary is the *value* rather than anything visible in the text — `3.4028235e38` fits and
 * `3.4028236e38` does not, and f32's maximum written out in full with no exponent at all fits. An
 * exponent check would have been wrong on both of those.
 *
 * Accumulated in `f64`, which has room to spare for the comparison. No sign: a leading `-` is a unary
 * operator and never part of the token, which the reference's own column confirms.
 */
/**
 * A float literal's value — read in `lit.wac`, which the emitter reads it in too.
 *
 * This used to have its own reader, and the two disagreed exactly where a reader written twice
 * always does: `f32 x = 1_0e38;` is out of range, and this one stopped at the underscore, saw `1`
 * and let it through. The reference has the same file for the same reason — its issue 0044.
 */
/**
 * Whether an integer literal is inside the bounds of the type it is going into.
 *
 * `negated` is carried down rather than the value being negated on the way up, because the bounds
 * are not symmetric: `-2147483648` is an `i32` and `2147483648` is not, and a check that only looked
 * at the magnitude would refuse the one the language allows.
 */
/**
 * Whether a decimal literal's digits name a number larger than `limit`, compared as text.
 *
 * Longer is larger once the leading zeros and separators are gone, and equal lengths compare
 * character by character. No arithmetic, because the values in question are exactly the ones no
 * integer in this compiler can hold.
 */
bool decimalExceeds(string digits, string limit) {
  u8[] a = digits.toBytes();
  u8[] out = u8[a.len()]();
  i32 n = 0;
  bool seenDigit = false;
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] == 95) { continue; }
    if (a[i] < 48 || a[i] > 57) { return false; }
    if (a[i] == 48 && !seenDigit) { continue; }
    seenDigit = true;
    out[n] = a[i];
    n = n + 1;
  }
  u8[] lim = limit.toBytes();
  if (n != lim.len()) { return n > lim.len(); }
  for (i32 i = 0; i < n; i++) {
    if (out[i] != lim[i]) { return out[i] > lim[i]; }
  }
  return false;
}

/** Whether the literal was written in hex — `0x…`, which the language reads as bits. */
bool isHexText(string t) {
  return t.len() > 2 && t.slice(0, 1) == "0" && (t.slice(1, 2) == "x" || t.slice(1, 2) == "X");
}

bool integerLiteralFits(C c, string want, Expr e, bool negated) {
  match (e.kind) {
    case IntLit(tok): {
      string text = tokenText(c, tok);
      i64 v = parseInt(text);
      // **A hex literal names bits, not a magnitude.** `0xFFFFFFFF` is how an `i32` of all ones is
      // written and the language takes it; the same value in decimal is out of range. So the bound
      // for one is the type's *width* and for the other its signed range, and a check that used one
      // bound for both reported four of the spec's own programs and eight working files.
      if (isHexText(text)) {
        if (want == "i32" || want == "u32") { return v <= 4294967295; }
        if (want == "i16" || want == "u16") { return v <= 65535; }
        if (want == "i8" || want == "u8") { return v <= 255; }
        return true;
      }
      // **The 64-bit bounds are compared as text.** `parseInt` answers an `i64`, so a literal one past
      // the top wraps and comes back looking small — 2^63 arrives negative and 2^64 arrives as zero.
      // The digits do not wrap. `spec/cases/0061` and `0062`, with `0063` holding the boundary from
      // the other side.
      if (want == "i64") { return !decimalExceeds(text, negated ? "9223372036854775808"
                                                                : "9223372036854775807"); }
      if (want == "u64") { return !negated && !decimalExceeds(text, "18446744073709551615"); }
      // Past the 64-bit answers, because a literal wider than an `i64` wraps in `parseInt` and the
      // comparisons below would read the wrapped value. Those two ask the digits instead, which is
      // why they come first — putting this guard in front of them let 2^63 through.
      //
      // **A wrapped value does not fit anything narrower than an `i64`, and this used to say it did.**
      // The guard below stops the comparisons reading wrapped bits, and answering *true* to do it
      // reads as "no complaint": `i32 b = 18446744073709551615;` drew **no diagnostic**, built, and
      // returned **-1** — `wac run` exited 255, which is the silent wrong answer
      // `spec/spec/types.md`'s `§wac-litctx-nofit-k3mq8wl` exists to prevent. The digits are what has
      // to be asked, and the answer is the same for all six: a magnitude too wide for an `i64` is too
      // wide for every type narrower than one, whatever the sign. The 64-bit wants have already
      // answered from the digits above, and everything else keeps falling through to `true`, so this
      // refuses only where it is certainly right.
      if (v < 0 && (want == "i32" || want == "u32" || want == "i16" || want == "u16" ||
                    want == "i8" || want == "u8")) {
        return false;
      }
      if (v < 0) { return true; }
      if (want == "i32") { return negated ? v <= 2147483648 : v <= 2147483647; }
      if (want == "u32") { return !negated && v <= 4294967295; }
      if (want == "i16") { return negated ? v <= 32768 : v <= 32767; }
      if (want == "u16") { return !negated && v <= 65535; }
      if (want == "i8") { return negated ? v <= 128 : v <= 127; }
      if (want == "u8") { return !negated && v <= 255; }
      return true;
    }
    // The sign is a unary operator, and which sign it is decides the bound.
    case Unary(op, operand): {
      return integerLiteralFits(c, want, operand, tokenKind(c, op) == kMinus() ? !negated : negated);
    }
    else: { return true; }
  }
}

f64 floatLiteralValue(C c, i32 tok) {
  return floatLit(tokenText(c, tok));
}

/**
 * Whether a literal fits the slot it is going into — the family question, plus `f32`'s range.
 *
 * One function so the range rule reaches every position at once. It applies in all of them, measured:
 * an initialiser, a return, an argument, an array element, a field, an assignment. Only `f32` is
 * checked — the reference accepts `f64 x = 1.0e400`, which is out of range for an `f64` too, and
 * matching that is the job rather than improving on it.
 */
bool literalFits(C c, string want, Expr e) {
  // `litFamily`, not `litKindOf`: an expression made only of literals is one of them for this
  // question — `f64 s = 1 + 2` is an integer literal sum in a float slot. `issues/lang/0120`.
  i32 lit = litFamily(c, e);
  if (!acceptsLiteral(want, lit)) { return false; }
  string core = withoutNull(want);
  string base = core == "" ? want : core;
  // **An integer literal has to fit the slot it is going into**, which is a different question from
  // the family one above: `4294967296` is an integer and an `i32` has no room for it. Asked of the
  // types whose bounds are exact here — the 64-bit ones would need the literal's own width to answer
  // honestly, and a guess about the top of `u64` is worse than saying nothing.
  if (lit == litInteger()) { return integerLiteralFits(c, base, e, false); }
  if (base != "f32" || lit != litFloat()) { return true; }
  match (e.kind) {
    case FloatLit(tok): {
      // f32's largest finite value plus half an ulp: anything above it rounds to infinity, and
      // anything at or below it rounds to something an `f32` can hold.
      return floatLiteralValue(c, tok) <= 3.4028235677973366e38;
    }
    // The sign is a unary operator and the magnitude is what the range is about, so this asks the
    // same question one node down. The reference agrees: it reports at the literal, not at the `-`.
    case Unary(op, operand): { return literalFits(c, want, operand); }
    else: { return true; }
  }
}

/**
 * The family of an expression made **only of literals** — `1 + 2` is an integer literal sum.
 *
 * `litKindOf` answers about one literal and takes no `C`, so it cannot read an operator's kind; this
 * can, and the operator decides everything. `f64 s = 1 + 2;` was accepted because a `Binary` answered
 * *not a literal* and `typeOfExpr` of two literals is unknown, and unknown is silence — while the
 * spec has an integer literal taking an *integer* type from its context and no implicit conversions
 * (`spec/spec/types.md`). `issues/lang/0120`.
 *
 * A comparison answers a `bool` whatever its operands are, so `bool b = 1 == 1;` must stay a `bool`
 * and not become an integer literal sum. Mixed families answer nothing rather than guessing, which
 * leaves `1.5 * 2` exactly where it was.
 */
i32 litFamily(C c, Expr e) {
  i32 direct = litKindOf(e);
  if (direct != litNone()) { return direct; }
  match (e.kind) {
    case Binary(op, left, right): {
      i32 k = tokenKind(c, op);
      if (k == kEq() || k == kNe() || k == kLt() || k == kLe() || k == kGt() || k == kGe() ||
          k == kAndAnd() || k == kOrOr()) {
        return litNone();
      }
      i32 l = litFamily(c, left);
      if (l != litFamily(c, right)) { return litNone(); }
      return l == litInteger() || l == litFloat() ? l : litNone();
    }
    // **A conditional of literals is a literal of the family they share.** `cond ? 1 : 2` in an `i64`
    // slot is legal and `cond ? false : true` in an `i32` slot is not, and both are facts about the
    // *family* rather than about a type — the branches take the slot's type the way any literal does.
    //
    // This was reverted once, because it makes the whole conditional a *leaf* to a caller that takes the
    // literal path and returns, and a conditional has a **condition** those callers then never walked:
    // `i32 n = p is null ? 1 : 0;` lost the warning about `is null` on a non-null reference and the reach
    // sweep lost `Ternary-cond`. The callers walk the expression either way now, which is the half of
    // `issues/lang/0145` that had to come first.
    case Ternary(tcond, tthen, tels): {
      i32 tf = litFamily(c, tthen);
      if (tf == litNone() || tf == litNull()) { return litNone(); }
      return tf == litFamily(c, tels) ? tf : litNone();
    }
    /**
     * **And an expression `match` of literals, for the same reason and by the same rule.**
     *
     * `spec/spec/enums.md` `[§enum-match-expr-4wnq7bk]`: the arms unify *"exactly as a ternary's two
     * branches are (see control.md), and by the same code"*. The arm above was that code and this one
     * was missing, so the identical program was refused written with `?:` and accepted written with
     * `match` — `string s = b ? 1 : 2;` reported, `string s = match (e) { case A: 1, else: 2 };`
     * silent, along with every other family: string arms in an `i32` slot, bool arms in an `i32` slot,
     * integer arms in an `f64` slot that `f64 d = 1;` refuses on its own.
     *
     * Nothing was checking them because `typeOfExpr` answers `typeNone()` for an all-literal match
     * *deliberately* — the arms take the type expected of the whole expression, so the match has no
     * type of its own to compare — and unknown is silence unless the literal path picks it up. This is
     * the literal path picking it up. `issues/lang/0243a`.
     *
     * **Mixed integer and float arms stay unanswered**, exactly as a ternary's do: `1` and `2.5` are
     * different families, so this returns `litNone()` and `f64 d = match (e) { case A: 1, else: 2.5 }`
     * behaves as it did. Whether that program is legal is a question the spec answers twice and
     * differently — `enums.md` has literal arms taking the expected type, `control.md:256` has a float
     * literal typing as `f64` "regardless of context" — and picking one is not this arm's business.
     * Filed as the decision in `issues/lang/0243a`.
     */
    case MatchExpr(subject, arms): {
      if (arms.len() == 0) { return litNone(); }
      i32 mf = litNone();
      for (i32 i = 0; i < arms.len(); i++) {
        // A statement arm carries a body and no value; one `Arm` serves both forms.
        if (arms[i].value is null) { return litNone(); }
        i32 af = litFamily(c, arms[i].value!);
        if (af == litNone() || af == litNull()) { return litNone(); }
        if (i == 0) { mf = af; } else if (af != mf) { return litNone(); }
      }
      return mf;
    }
    else: { return litNone(); }
  }
}

/** The family a literal expression belongs to, or `litNone` when the expression is not one. */
export i32 litKindOf(Expr e) {
  match (e.kind) {
    case IntLit(tok): { return litInteger(); }
    case FloatLit(tok): { return litFloat(); }
    case StrLit(tok): { return litString(); }
    case BoolLit(value): { return litBool(); }
    case NullLit: { return litNull(); }
    // `-1.0e40` is a float literal with a sign in front, and every rule that asks this means that.
    // Left out, the whole literal path skipped a negated one — so `f32 x = -1.0e40;` went unchecked
    // while `f32 x = 1.0e40;` did not, which is the sort of hole that only shows up beside its twin.
    case Unary(op, operand): {
      i32 inner = litKindOf(operand);
      return inner == litInteger() || inner == litFloat() ? inner : litNone();
    }
    else: { return litNone(); }
  }
}

/**
 * Whether a declared type accepts a literal of this family.
 *
 * The grid in `test/wac/typecheck_test.wac` regenerates this from the reference on every run, so a
 * disagreement fails loudly rather than sitting here as a stale table.
 */
export bool acceptsLiteral(string want, i32 lit) {
  // A `T?` takes a null, and takes whatever `T` takes: `i32? n = null;` and `i32? n = 5;` are both
  // legal. So the question for a nullable is the question for the type inside it, plus null.
  if (endsWith(want, "?")) {
    if (lit == litNull()) { return true; }
    return acceptsLiteral(withoutNull(want), lit);
  }
  if (lit == litInteger()) {
    return want == "i32" || want == "i64" || want == "u32" || want == "u64";
  }
  if (lit == litFloat()) { return want == "f32" || want == "f64"; }
  if (lit == litBool()) { return want == "bool"; }
  if (lit == litString()) { return want == "string"; }
  // Nothing this slice can name is nullable. A `T?` is, and `typeOfTy` answers `typeNone` for one, so
  // a nullable declaration never reaches here — silence rather than a wrong refusal. A struct is not
  // nullable either: `P q = null;` is `expected P, got null`, which this now says.
  if (lit == litNull()) { return false; }
  return true;
}

/**
 * The type of a non-literal expression, or `typeNone`.
 *
 * Only a name, resolved against the parameters and locals of the function being checked. A call, a
 * member access or arithmetic still needs an expression typer, and silence is the honest answer for
 * all of them.
 */
/**
 * The type an assignment target has, or `typeNone`.
 *
 * The same walk as `typeOfExpr` over a different node family, because an lvalue is its own tree: a
 * name, a field of one, an element of one, or an unwrapped nullable. `LUnwrap` is `x!`, which is the
 * `T` inside a `T?` — the one place a type gets *narrower* going down the tree.
 */
/**
 * Where an lvalue *starts* — `p.x` begins at `p`, not at the dot.
 *
 * The node's own position is the dot, which is right: rung 2 compares this parser's tree against the
 * reference's node for node, positions included, and they agree. What differs is where a *diagnostic*
 * about the whole assignment goes, and the reference puts it at the beginning of the thing assigned
 * to. Walking down to the leftmost node is the difference between agreeing with it and reporting one
 * column later — which a differential oracle counts as a position the reference never mentions.
 */
i32 lvalueStartLine(Lvalue lv) {
  match (lv.kind) {
    case LField(base, nameTok): { return lvalueStartLine(base); }
    case LIndex(base, index): { return lvalueStartLine(base); }
    case LUnwrap(base): { return lvalueStartLine(base); }
    else: { return lv.line; }
  }
}

i32 lvalueStartCol(Lvalue lv) {
  match (lv.kind) {
    case LField(base, nameTok): { return lvalueStartCol(base); }
    case LIndex(base, index): { return lvalueStartCol(base); }
    case LUnwrap(base): { return lvalueStartCol(base); }
    else: { return lv.col; }
  }
}

export string typeOfLvalue(C c, Lvalue lv) {
  match (lv.kind) {
    case LIdent(tok): { return c.typeOfName(tokenText(c, tok)); }
    case LField(base, nameTok): {
      string owner = typeOfLvalue(c, base);
      if (owner == typeNone()) { return typeNone(); }
      return c.fieldType(owner, tokenText(c, nameTok));
    }
    case LIndex(base, index): {
      string arr = typeOfLvalue(c, base);
      if (!isArrayName(arr)) { return typeNone(); }
      return dropLast(arr, 2);
    }

    case LUnwrap(base): {
      string inner = withoutNull(typeOfLvalue(c, base));
      return inner == "" ? typeNone() : inner;
    }
  }
}

/**
 * The type of a **declared function used as a value** — `fn(i32) -> bool`.
 *
 * `design/lang/0002` tier one made every `fn[…]` a value, and a bare function name is how one is
 * written: there is no `&f`. The checker had no type for that name at all, so every mismatch through
 * it was silent — `i32 x = bytes;` and `return bytes;` in an `i32` function both type-checked, and the
 * emitter then produced a module wasm rejects. `issues/system/0170` is that, found through `wac build`
 * reporting a byte count for a program `wac run` could not load.
 *
 * `typeNone()` for a **generic** function: its signature is written in letters, and a letter is not a
 * type any assignment can be checked against.
 */
string funcValueType(C c, i32 at) {
  if (at < 0 || c.funcGenerics[at]) { return typeNone(); }
  string out = "fn(";
  for (i32 i = 0; i < c.funcParamCount[at]; i++) {
    if (i > 0) { out = out + ", "; }
    out = out + c.funcParamTypes[c.funcParamAt[at] + i];
  }
  return out + ") -> " + c.funcReturns[at];
}

export string typeOfExpr(C c, Expr e) {
  match (e.kind) {
    // **A JSX element is core's `Node`**, whatever it contains. `design/lang/0004`.
    case Jsx(tagTok, closeTok, attrs, kids): { return "Node"; }
    case Ident(tok): {
      string idName = tokenText(c, tok);
      string held = c.typeOfName(idName);
      // **A local or parameter wins, as it does everywhere: it is nearer** — and it wins even when its
      // own type cannot be named, which the condition here used to miss. Checked alone, a match
      // binding from an unresolved variant has no type, and this answered with a *module function* of
      // the same name instead: `case Str(bytes): string.fromBytes(bytes)` in a file that also exports
      // `Fixture bytes(Core, Cli, …)` was reported as passing a funcref where `u8[]` belongs. Unknown
      // is the answer, and unknown is silence. `issues/lang/0145`'s family, in value position.
      // **Except an import's placeholder, which is not a binding.** It is in the table so the name
      // exists; its type is unknown because nothing put one there, and answering unknown here hid
      // the signature `declareModule` had already recorded. `issues/lang/0180a`.
      if (c.isDeclaredName(idName) && !c.isImportOnlyName(idName)) { return held; }
      // **A declared function used as a value is a funcref** — see `funcValueType`.
      return funcValueType(c, c.funcAt(idName));
    }
    // `p.x`, typed from the struct's field declarations and its parents'. The receiver is typed by
    // this same function, so `a.b.c` works by recursion for as long as every step is nameable.
    case Member(obj, nameTok): {
      string owner = typeOfExpr(c, obj);
      if (owner == typeNone()) {
        // A **static** method named without being called is a value: a funcref of its own signature.
        // `S.make` is a `fn() -> S`, which is why assigning it to an `i32` is an ordinary mismatch
        // rather than the *"cannot use method as a value"* an instance method gets — a static is a
        // function, and an instance method is not one until it has a receiver.
        return staticMethodType(c, obj, tokenText(c, nameTok));
      }
      string mem = tokenText(c, nameTok);
      // A field first: a field and a method may share a name, and the field is what `p.x` means.
      string ft = c.fieldType(owner, mem);
      if (ft != typeNone() && ft != "") { return ft; }
      // **And an instance method named without being called is a bound reference** —
      // `design/lang/0002` tier one. Answering `typeNone()` here is what made it unassignable and
      // therefore refusable; the value it denotes is the method with its receiver already in it.
      return boundMethodType(c, owner, mem);
    }
    // A cast is its target type, whichever of the four spellings it used. The four differ in what
    // they *permit* — see `checkCast` — and not in what they produce.
    case Cast(op, operand, target): { return typeOfTy(c, target); }
    /**
     * A method call, typed by what the method says it returns.
     *
     * Read in the receiver's world, so `Vec<i32>.at()` declared `T at(…)` is an `i32`. A funcref call
     * has no name to look up and stays unknown, as it always did.
     */
    case Call(callee, args): {
      match (callee.kind) {
        case Member(obj, nameTok): {
          // **A variant construction is a value, and had no type at all.** `E.A(1)` is an `A` — the
          // reference says so in as many words, *"expected i32, got A"* — and it reaches here as a
          // member call on a name that is an enum rather than a value, so `receiverType` answered
          // unknown and every rule downstream went quiet. `match (E.A(1))` was the visible one: the
          // subject had no type, so exhaustiveness, a duplicated arm and a name no variant declares
          // all said nothing about the whole match. `spec/cases/0093`.
          match (obj.kind) {
            case Ident(tok): {
              string en = tokenText(c, tok);
              if (c.isEnum(en) && !c.isDeclaredName(en) &&
                  c.variantArityIn(en, tokenText(c, nameTok)) >= 0) {
                return tokenText(c, nameTok);
              }
              // A static on a built-in type: the receiver is a type name rather than a value, so
              // `receiverType` answers unknown for it and the table below is the only thing that knows.
              // Shadowed by a local of the same name, as everywhere.
              if (!c.isDeclaredName(en)) {
                string bs = builtinStaticReturn(en, tokenText(c, nameTok));
                if (bs != "") { return bs; }
              }
            }
            else: { }
          }
          string recvT = receiverType(c, obj);
          if (recvT == typeNone() || recvT == "") { return typeNone(); }
          // **A field holding a funcref answers what its signature says.** `Cli`'s members are
          // `fn[Pending<i32>()] argCount` and friends — fields, not methods — so `cli.readFile(p)`
          // had no type at all, and `.wait(1)` on the result had no receiver to be wrong about. Three
          // files' worth of missed diagnostics were downstream of this one unknown.
          string fref = c.isStruct(recvT) ? c.fieldType(recvT, tokenText(c, nameTok)) : "";
          if (startsWithFn(fref)) {
            string fret = funcrefReturn(fref);
            return fret == "" ? typeNone() : substituteType(c, recvT, fret);
          }
          // **The builtins answer something too**, and nothing here knew what: `return a.len();`
          // from a `string` function was silent because the returned expression had no type to be
          // wrong with, not because the rule was missing. Same closed surface the missing-method
          // rule is written against, one question further on.
          string bret = builtinReturnType(recvT, tokenText(c, nameTok));
          if (bret != "") { return bret; }
          // **A static on a template does not say which instance it builds.** `Box.of(5)` returns
          // `Box<T>` as written, and `T` is bound by the *slot* the call fills rather than by
          // anything here — so answering with the declaration's own text claims `Box<i32> b =
          // Box.of(5)` is a mismatch. The instantiation is what this checker does not model, and the
          // honest answer to a question it cannot answer is no answer.
          if (c.isGeneric(recvT)) { return typeNone(); }
          i32 mi = c.methodAt(recvT, tokenText(c, nameTok));
          // **An enum instantiation is not in the method table.** `Opt<i32>` has no entry of its own —
          // only the template `Opt` does, unlike a generic *struct*, whose instantiations are
          // registered — so a method call on one had no type, and every rule downstream went quiet with
          // it: `export bool f() { return o.isSome(); }` where `isSome` answers an `i32` was accepted,
          // and that was the whole of one family in the mutation sweep. The lookup falls back to the
          // template and `substituteType` reads the declaration in the instantiation's world, which is
          // what the line below was already doing for the struct case.
          if (mi < 0) {
            string tmplOf = templateOf(recvT);
            if (tmplOf != recvT) { mi = c.methodAt(tmplOf, tokenText(c, nameTok)); }
          }
          if (mi < 0) { return typeNone(); }
          return substituteType(c, recvT, c.methodReturns[mi]);
        }
        else: { return typeNone(); }
      }
    }
    // `x is T` asks a question, so it answers a boolean whatever `x` and `T` are.
    case Is(left, target, other, negated): { return "bool"; }
    /**
     * A binary expression, which had no arm here at all — every one of them typed as unknown, so a
     * comparison used as a value, an arithmetic result returned, and an operand of an operand were
     * all invisible to every rule that asks what an expression is.
     *
     * A comparison and the logical operators are always `bool`. Everything else is the type of its
     * operands, taken from whichever side is not a literal: `x + 1` is an `i32` because `x` is, and
     * the literal takes its type from the other side rather than giving one.
     */
    case Binary(op, left, right): {
      i32 bk = tokenKind(c, op);
      if (bk == kEq() || bk == kNe() || bk == kLt() || bk == kLe() || bk == kGt() || bk == kGe() ||
          bk == kAndAnd() || bk == kOrOr()) {
        return "bool";
      }
      // **A string or bool literal is not polymorphic, so it does have a type to offer.** The
      // sentence above is about `1`, which is an `i32`, an `i64`, a `u32` or a `u64` depending on
      // where it is going and therefore cannot give one. `"a"` is a `string` and `true` is a `bool`,
      // and folding them into unknown left `i32 n = "a" + "b";` accepted while `i32 n = "a";` and
      // `i32 n = "a" + s;` were both refused — the rule worked whenever *one* side was not a
      // literal. `naturalTypeOf` in this file already draws the line here. `issues/lang/0245a`.
      i32 lk = litKindOf(left);
      i32 rk = litKindOf(right);
      bool lLit = lk == litInteger() || lk == litFloat();
      bool rLit = rk == litInteger() || rk == litFloat();
      string bl = lLit ? typeNone()
                : lk == litString() ? "string" : lk == litBool() ? "bool" : typeOfExpr(c, left);
      string br = rLit ? typeNone()
                : rk == litString() ? "string" : rk == litBool() ? "bool" : typeOfExpr(c, right);
      // **Two literals of different families answer nothing**, because the operand rule has already
      // reported at the operator: `1 + "a"` is one fault. Giving the string side a type here — which
      // is what the four lines above started doing — made the *initialiser* complain a second time,
      // so `i32 n = 1 + "a";` drew two diagnostics where the reference draws one. This is the rule
      // stated three times over in this arm already, arriving for the pair `0245a` newly typed.
      // `issues/lang/0247a`.
      if (lk != litNone() && rk != litNone() && lk != rk &&
          lk != litNull() && rk != litNull()) {
        return typeNone();
      }
      // **Unknown from a literal and unknown from an error are the same value and not the same
      // thing.** `x + 1` takes its type from `x`, because the literal has none of its own; `(s * 2) +
      // t` has an operand that was *reported* and therefore has no type to offer, and answering with
      // the other side made the enclosing `return` complain a second time about a chain the
      // reference had already finished with.
      if (!lLit && bl == typeNone()) { return typeNone(); }
      if (!rLit && br == typeNone()) { return typeNone(); }
      // **Two known operands that disagree make the result unknown**, which is how the reference
      // behaves and why it reports `t.a + t.b + t.c` once rather than twice: the first `+` is an
      // error, so what it produces is not a `string` for the second `+` to complain about. Answering
      // with the left operand's type instead made this checker report every operator in the chain,
      // and every one after the first was a position the reference never mentions.
      if (bl != typeNone() && br != typeNone() && bl != br) { return typeNone(); }
      // **And an operator that has nothing to do to its operand produces nothing.** `t.a * 1000` on
      // a `string` is reported at the `*`; answering "string" for it as well made the enclosing
      // `return` complain a second time, at a position the reference never mentions because it had
      // already said what was wrong.
      if (bk != kPlus() && (bl == "string" || br == "string")) { return typeNone(); }
      // **And the same for a `bool` now that a bool literal has a type here.** Arithmetic on one is
      // refused at the operator, so answering "bool" would let the slot rule speak a second time and
      // `i32 n = true + false;` would draw two where the reference draws one. The `Unary` arm states
      // this rule in the same words. `issues/lang/0245a`.
      if ((bk == kPlus() || bk == kMinus() || bk == kStar() || bk == kSlash() || bk == kPercent())
          && (bl == "bool" || br == "bool")) {
        return typeNone();
      }
      if (bl != typeNone()) { return bl; }
      return br;
    }
    case Unwrap(operand): {
      string inner = withoutNull(typeOfExpr(c, operand));
      return inner == "" ? typeNone() : inner;
    }
    case Index(arr, index): {
      string a = typeOfExpr(c, arr);
      // **`s[i]` is a one-character string**, not a byte and not unknown — `spec/spec/strings.md`
      // §Indexing. The emitter's twin has said so for a while, in the same words; this side answered
      // `typeNone()` because a string is not an array name, and everything downstream that needed the
      // type went quiet with it. `s[0] - 1` is `string - i32` and was accepted, and `i32 n = s[0];`
      // was accepted, while the *same rules* refuse `s - 1` and `i32 n = s;`. `issues/lang/0159`.
      if (a == "string") { return "string"; }
      if (!isArrayName(a)) { return typeNone(); }
      string elem = dropLast(a, 2);
      // Reading a packed element **widens to `i32`**, which is why `return this.data[i];` from an
      // `i32` function is the ordinary way this repository reads a byte. Calling it a `u8` reported
      // 115 files, and that is what this used to avoid by saying nothing at all — but nothing is not
      // the same answer as `i32`, and saying nothing silenced the rules that need it: `i64 x = b[0];`
      // and `return b[0];` from an `i64` function were both accepted, and the emitter then wrote a
      // module the engine refuses — `local.set[0] expected type i64, found array.get_u of type i32`.
      //
      // `i32` exactly, not "some integer": the reference accepts `i32 x = b[0];` and refuses
      // `i64 x = b[0];` with *found i32*. `issues/lang/0170a`.
      if (isPackedName(elem)) { return "i32"; }
      return elem;
    }
    // `!x` is a boolean; `-x` and `~x` are whatever `x` is.
    case Unary(op, operand): {
      i32 uk = tokenKind(c, op);
      if (uk == kBang()) { return "bool"; }
      string ut3 = typeOfExpr(c, operand);
      // **A rejected operand leaves the expression with no type**, rather than with the operand's.
      // Unknown is silence here, which is what stops a slot rule reporting a second time for the one
      // fault the operand rule already named. `issues/lang/0238a`.
      if (ut3 != typeNone() && !unaryAccepts(c, uk, ut3)) { return typeNone(); }
      return ut3;
    }
    // Both branches or nothing. A conditional whose arms disagree has a type the reference works out
    // by unification, which this slice cannot do — and guessing one branch would be worse than
    // silence, because the guess is right half the time and wrong in a way nothing here would catch.
    case Ternary(cond, then, els): {
      string t = typeOfExpr(c, then);
      string other = typeOfExpr(c, els);
      if (t == other) { return t; }
      // **A literal branch takes the other branch's type.** A literal has no type of its own, so two
      // branches "disagreeing" when one of them is a literal is this checker comparing a type against
      // nothing — and the whole conditional then answered unknown, which took every rule downstream
      // with it: `return s.len() > 3 ? s[3] == s[3] : true;` from an `i32` function was accepted, and
      // that shape was three of the mutation sweep's remaining misses.
      //
      // `literalFits` is the same question the literal path asks everywhere else, so `cond ? 1 : 2` in
      // an `i64` slot still answers `i64` and `cond ? 1.5 : x` where `x` is an `i32` still answers
      // nothing. `null` is excluded: it is not a value of any type, and whether it belongs in a slot is
      // a rule of its own.
      if (t != typeNone() && t != "" && isPlainLiteral(c, els) && literalFits(c, t, els)) { return t; }
      if (other != typeNone() && other != "" && isPlainLiteral(c, then) && literalFits(c, other, then)) {
        return other;
      }
      // **Branches that differ only in nullability unify to the nullable one**, which is their common
      // type: `c ? a : b` for a `P` and a `P?` is a `P?`. Answering unknown instead made
      // `P r = c ? a : b;` silent — unknown is silent everywhere in this checker — while `P r = b;`
      // beside it was reported, and that was the largest group in `sweep.test.ts`'s miss queue. The
      // reference types it the same way, which is why its complaint is *cannot assign nullable to
      // non-null* at the declaration and says nothing about the arms.
      //
      // `withoutNull` answers `""` for a type that is not nullable, so the bases are taken explicitly
      // rather than by comparing its output — which would call `P` and `Q` the same thing.
      // **The arms' common type, by the function a `match` expression uses too.** Sharing it is what
      // `spec/spec/enums.md` §enum-match-expr-4wnq7bk asks for — *"and by the same code"* — and the day
      // these were two copies is the day they disagreed.
      string joined = unifyArms(c, t, other);
      if (joined != typeNone()) { return joined; }
      return typeNone();
    }
    // **A `match` used as an expression**, by exactly the rule one arm up: every arm agrees and that
    // is the type, or they do not and this says nothing rather than guessing. There was no arm here
    // at all, so `string got = match (o) { … };` over arms that all answer `i32` went unreported —
    // the mutation sweep's second-to-last miss, in `core/test/option_test.wac`.
    //
    // A *statement* arm has no value and a match containing one is not an expression, so an arm
    // without one ends the question. Unknown is contagious for the same reason it is in `Ternary`:
    // one arm this checker cannot type says nothing about whether the others agree with it.
    case MatchExpr(subject, arms): {
      if (arms.len() == 0) { return typeNone(); }
      string mt = "";
      for (i32 i = 0; i < arms.len(); i++) {
        if (arms[i].value is null) { return typeNone(); }
        // **A literal arm adapts and says nothing.** `spec/spec/enums.md`: the arms unify exactly as
        // a ternary's branches do, and *"an integer or float literal arm takes the type expected of
        // the whole expression"*. So `f64 x = match (o) { case A: 1, case B: 2.5 }` is legal and the
        // `1` is an `f64`, which is why a literal cannot be asked what it is here — reading one as
        // `i32` refused a program the spec runs.
        if (litFamily(c, arms[i].value!) != litNone()) { continue; }
        string at = typeOfExpr(c, arms[i].value!);
        if (at == typeNone() || at == "") { return typeNone(); }
        // The same unification a ternary's branches get — `unifyArms`, shared rather than restated.
        // This required the arms to be *equal*, so a nullable arm or a subtype pair answered unknown,
        // and unknown is silent: the identical program was refused with `?:` and accepted here.
        if (mt == "") { mt = at; } else { mt = unifyArms(c, mt, at); }
        if (mt == typeNone()) { return typeNone(); }
      }
      // Every arm was a literal, so the whole match takes its type from wherever it is going — which
      // is the slot's business and not this function's.
      return mt == "" ? typeNone() : mt;
    }
    // A construction is either a struct being made or a function being called — the parser cannot
    // tell, so neither can this, and the name decides. A struct name gives the struct; a function
    // name gives what it returns; anything else is unknown.
    case Construct(ctype, args, named): {
      string name = "";
      match (ctype.kind) {
        case Named(tok, typeArgs): {
          if (typeArgs.len() > 0) { return typeOfTy(c, ctype); }
          name = tokenText(c, tok);
        }
        else: { }
      }
      if (name == "") { return typeNone(); }
      // `Box(1.0)` with no type arguments written is legal — the arguments are *inferred*, from the
      // declared type of whatever the construction flows into, and inside the generic's own methods
      // the bare name means the instantiation being compiled. Neither is knowable from the syntax at
      // hand, so this says unknown rather than guessing `Box`, which would be a type nothing has.
      if (c.isStruct(name)) { return c.isGeneric(name) ? typeNone() : name; }
      // **A funcref whose type cannot be named is still a funcref**, and the call is still *its* call.
      // Answering with a same-named module function's return type is how `Box.of(f(this.v))` inside
      // `Box<U> map<U>(const this, fn[U(T)] f)` came back `i32` and was then reported against `U`.
      // Unknown is the honest answer, and the silent one. `issues/lang/0145`.
      if (c.isDeclaredName(name)) {
        string declHeld = c.typeOfName(name);
        if ((declHeld == typeNone() || declHeld == "") && c.funcArityOf(name) >= 0) {
          return typeNone();
        }
      }
      i32 at = c.funcAt(name);
      if (at < 0) {
        // **A name holding a funcref is callable, and says what it answers.** `fn[Read()] read` is a
        // parameter, not a declared function, so `read()` fell out of here with no type — and the
        // arm above says a funcref call "has no name to look up and stays unknown", which is true of
        // `(f())()` and not of this. There is a name, and `typeOfName` has it.
        //
        // What it cost was not the call: `match (read())` had no subject type, so the *bindings* had
        // none either, and `bytes.len(1)` inside the arm was unreported in `packages/stream`. A
        // subject this checker cannot type takes every rule inside the match down with it.
        string held = c.typeOfName(name);
        if (startsWithFn(held)) {
          string hret = funcrefReturn(held);
          return hret == "" ? typeNone() : hret;
        }
        return typeNone();
      }
      if (c.funcGenerics[at]) { return genericCallReturn(c, at, args); }
      return c.funcReturns[at];
    }
    // **An array construction has a type, and this had no arm for it.** `i32[0]()` answered unknown,
    // and unknown is what every caller skips — `if (got == typeNone()) { continue; }` — so *any array
    // satisfied any slot*, including a slot that is not an array at all. `take(i32[0]())` where `take`
    // wants a struct passed the checker and produced a module the engine refused, blaming the compiler
    // for a plain type error (`issues/lang/0164a`).
    //
    // `assignable` was never the problem and neither was `nameableType`, which admits arrays. The rule
    // existed and could not see its input, which is the shape of every gap `issues/lang/0170a` found.
    case ArrNew(elem, size, fill, elements): {
      // **An element type here can only be a type**, so a binding standing in for one gives unknown
      // rather than a spelling. `zz[1]()` where `zz` is an `i32` local answered `zz[]` — a type not in
      // the program — and that travelled: into *expected i32, found zz[]* in a return, and into no
      // complaint at all in a statement, which left the emitter's whole-module decline as the only
      // thing behind `wac check`'s "no diagnostics". The report is in the checking walk; see
      // `reportBindingAsType` for why the two halves are split.
      if (bindingAsType(c, elem)) { return typeNone(); }
      string el = typeOfTy(c, elem);
      return el == "" || el == typeNone() ? typeNone() : el + "[]";
    }
    /**
     * `x++` and `++x` are the type of what they increment — `spec/tour.wac`: *"`++`/`--` ARE
     * expressions, prefix and postfix, on i32/i64 lvalues. As in C, `i32 old = x++;`"*.
     *
     * **The operand had a rule and the result had no type.** `checkIncr` refuses a bool, a float, a
     * string, a struct — everything that is not an integer — so what was missing was never *whether*
     * the operand was right but what the expression then produced. Unknown is silence, so
     * `string s = x++;` was accepted by the checker and the emitter both, and a build wrote a module
     * with the exported function missing and exited 0. All four spellings, since one arm serves them:
     * postfix, prefix, `--`, and an argument rather than an initialiser. `issues/lang/0242a`.
     *
     * `typeOfLvalue` is what `checkIncr` already asks, so the answer is the one the guard used.
     */
    case Incr(target, op, prefix): {
      string it = typeOfLvalue(c, target);
      // **A packed element widens to `i32` here too**, exactly as reading one does in `case Index`
      // above — `a[0]++` *is* a read, and `spec/cases/0108` says what it reads: *"postfix `++`
      // answers what the element held, and a packed element holds what a store-and-read leaves — 255,
      // not -1"*, which is an `i32` value. Answering `u8` refused that case with *expected i32, found
      // u8*: the widening rule was already written down one arm away, and a new arm that skipped it
      // woke the packed-position guard on a value that had never had a type to check.
      return isPackedName(it) ? "i32" : it;
    }
    else: { return typeNone(); }
  }
}

/**
 * Whether a statement list always leaves the function — the reference's *"not all code paths return
 * a value"*.
 *
 * Control flow rather than types, and the second kind of thing rung 3 does. The rule is the ordinary
 * definite-return analysis with one subtlety that the spec's own cases are mostly about:
 *
 * **`while (true)` leaves the function unless something can break out of it.** An infinite loop with
 * no exit never reaches the statement after it, so a function ending in one needs no return; give it
 * a reachable `break` and the loop can finish, so the closing brace becomes reachable again and a
 * return is required. Four of the seven spec cases are exactly this, and they place the `break`
 * inside a block, inside an `else if`, and inside a `match` arm — so "does this loop contain a
 * break" has to walk as deep as the statements go.
 *
 * A `break` inside a **nested** loop or a `switch` belongs to that construct, not to this loop, and
 * does not make it finite. That is why `breaksOut` stops descending at a loop or a switch and
 * `alwaysLeaves` does not.
 */
bool alwaysLeaves(Stmt[] body) {
  // **Any** statement, not the last one. An earlier `return` settles it just as well: everything
  // after it is unreachable, so the function still always leaves. Reading only the last statement
  // said otherwise for `{ return 1; i32 dead = 2; }`, which the reference accepts — a false alarm,
  // and the kind that only a corpus of *accepted* programs can find.
  for (i32 i = 0; i < body.len(); i++) {
    if (leaves(body[i])) { return true; }
  }
  return false;
}

/** Whether one statement always leaves the function. */
bool leaves(Stmt s) {
  match (s.kind) {
    case Return(value): { return true; }
    case Trap: { return true; }
    case Block(body): { return alwaysLeaves(body); }
    // Both arms, and there must be an arm to take: an `if` with no `else` falls through when the
    // condition is false.
    case If(cond, then, els): {
      return els.len() > 0 && alwaysLeaves(then) && alwaysLeaves(els);
    }
    case While(cond, body): { return isTrueLiteral(cond) && !breaksOut(body); }
    case DoWhile(body, cond): { return isTrueLiteral(cond) && !breaksOut(body); }
    // A `for` with no condition is the other spelling of `while (true)`.
    case For(init, cond, update, body): { return (cond is null) && !breaksOut(body); }
    // A `match` is exhaustive by construction — the language requires every variant — so it leaves
    // when every arm does. Modelling it was not optional: six functions in this very file are a
    // single `match` whose arms all return, and treating that as falling through reported all six.
    case Match(subject, arms): {
      if (arms.len() == 0) { return false; }
      for (i32 i = 0; i < arms.len(); i++) {
        if (!alwaysLeaves(arms[i].body)) { return false; }
      }
      return true;
    }
    // A `switch` needs a `default` as well: without one, a subject matching no case falls straight
    // through. A `break` in a case leaves the switch and not the function, so `alwaysLeaves` on the
    // case body is exactly the right question.
    case Switch(subject, cases): {
      bool hasDefault = false;
      for (i32 i = 0; i < cases.len(); i++) {
        if (cases[i].value is null) { hasDefault = true; }
        if (!alwaysLeaves(cases[i].body)) { return false; }
      }
      return hasDefault;
    }
    else: { return false; }
  }
}

/** `true`, written literally — the only condition this slice will call infinite. */
bool isTrueLiteral(Expr e) {
  match (e.kind) {
    case BoolLit(value): { return value; }
    else: { return false; }
  }
}

/**
 * Whether a `break` in this list belongs to the loop enclosing it.
 *
 * Does not descend into a nested loop or a `switch`: a `break` there is that construct's, and the
 * outer loop is still infinite. Does descend into blocks, `if`/`else` and `match` arms, because a
 * break in any of those is the loop's — which is what three of the spec's cases check.
 */
bool breaksOut(Stmt[] body) {
  for (i32 i = 0; i < body.len(); i++) {
    if (breaksOutOf(body[i])) { return true; }
  }
  return false;
}

bool breaksOutOf(Stmt s) {
  match (s.kind) {
    case Break: { return true; }
    case Block(body): { return breaksOut(body); }
    case If(cond, then, els): { return breaksOut(then) || breaksOut(els); }
    case Match(subject, arms): {
      for (i32 i = 0; i < arms.len(); i++) {
        if (breaksOut(arms[i].body)) { return true; }
      }
      return false;
    }
    else: { return false; }
  }
}

/**
 * The operands of `+ - * / %`, which must be the same type.
 *
 * Three sets, and which set an operator is in was read off the reference rather than assumed:
 *
 *   - **`+ - * / %` and `& | ^`** answer `type mismatch in 'op': A and B` whenever the operands
 *     differ. One rule, no exceptions among primitives.
 *   - **`< <= > >= == !=`** answer the same. A mixed comparison against a `string` answers a
 *     *different* message depending on which side it is on — `i32 < string` is `'<' not allowed on
 *     reference type` while `string < i32` is `type mismatch in '<'` — but both sit at the operator,
 *     which is the position this reports, so the distinction costs nothing here. An earlier version
 *     excluded strings from comparisons on the strength of seeing the first message and not the
 *     second, and lost recall for no reason. `string == string` is allowed and stays silent because
 *     the two agree, not because of a rule about strings.
 *   - **`&& ||`** never answer a mismatch at all. `1 && 2` is `'&&' requires bool operands`, which is
 *     about each operand on its own rather than about the pair, so it is not this check.
 *
 * Shifts are in none of them: they deliberately accept mixed widths — `i64 << i32` is legal, and the
 * friction log records a compiler bug from assuming otherwise.
 *
 * A literal operand is skipped rather than typed. `x + 1` is legal for any numeric `x` because the
 * literal takes the other side's type, so demanding they agree would report exactly the code
 * everybody writes.
 */
/**
 * An expression's type, **with a literal's own family filled in**.
 *
 * A literal is polymorphic over its family and takes the type of the slot it fills, which is why
 * `typeOfExpr` answers unknown for one. A comparison is not a slot: `1 == "hello"` has nothing to
 * take a type from, and the whole complaint is that the two sides cannot be the same type.
 */
/**
 * How many digits an integer literal is written with, ignoring `_`, a sign and a base prefix.
 *
 * Used only to answer "is this certainly an `i32`", so it counts rather than parses: this checker
 * has no integer parser and does not need one to know that twenty digits is not an `i32`.
 */
/**
 * The digits of a **positive plain-decimal** integer literal, or `""`.
 *
 * `decimalExceeds` compares digit strings and answers *false* for anything holding a non-digit, so a
 * based literal reaching it would read as "does not exceed" — which is why this returns nothing for
 * one rather than letting the caller find out. Empty for a negated literal too: the sign is a separate
 * node and the bounds differ by one on the signed rungs, so a caller that cannot account for it should
 * not be handed the digits. `literalDigits` already refuses a based literal by returning 0, and this
 * is deliberately a second refusal rather than a shared one — the two answer different questions and
 * sharing a helper is how the underscore rule would come to differ between them.
 */
string decimalLiteralText(C c, Expr e) {
  match (e.kind) {
    case IntLit(tok): {
      string t = tokenText(c, tok);
      return isHexText(t) ? "" : t;
    }
    else: { return ""; }
  }
}

i32 literalDigits(C c, Expr e) {
  match (e.kind) {
    case IntLit(tok): {
      string t = tokenText(c, tok);
      i32 n = 0;
      for (i32 i = 0; i < t.len(); i++) {
        string ch = t[i];
        if (ch == "_" || ch == "-" || ch == "+") { continue; }
        if (ch == "x" || ch == "X" || ch == "b" || ch == "B" || ch == "o" || ch == "O") { return 0; }
        n = n + 1;
      }
      return n;
    }
    case Unary(op, operand): { return literalDigits(c, operand); }
    else: { return 0; }
  }
}

/**
 * The common type of two arms, or `typeNone()` — the rule a ternary's branches and a `match`
 * expression's arms **share**.
 *
 * `spec/spec/enums.md` §enum-match-expr-4wnq7bk has the arms unifying *"exactly as a ternary's two
 * branches are … and by the same code"*, and for a day it was not the same code: the ternary learned
 * these two cases and the match kept requiring equality, so `P r = c ? a : b;` was refused and the
 * identical `match` was accepted. One function now, which is what makes that sentence true
 * structurally rather than by anyone remembering to change both.
 *
 * Two cases, in this order and not the other:
 *
 *   - **differing only in nullability** unify to the nullable one — `P` with `P?` is a `P?`;
 *   - **at equal nullability**, whichever type accepts the other — `Sub` with `Base` is a `Base`.
 *
 * The order matters because `assignable` is deliberately blind to a `?` (see `nullableIntoNonNull`),
 * so both directions answer true for `P` against `P?` and whichever ran first would win. And the
 * hierarchy case is asked only at equal nullability for the same reason: `Sub?` against `Base` would
 * otherwise unify to `Base` and lose the `?`, which the reference calls *incompatible types*.
 */
string unifyArms(C c, string a, string b) {
  if (a == b) { return a; }
  if (a == typeNone() || b == typeNone() || a == "" || b == "") { return typeNone(); }
  string ab = endsWith(a, "?") ? withoutNull(a) : a;
  string bb = endsWith(b, "?") ? withoutNull(b) : b;
  if (ab == bb) { return endsWith(a, "?") ? a : b; }
  if (endsWith(a, "?") == endsWith(b, "?")) {
    if (assignable(c, b, a)) { return b; }
    if (assignable(c, a, b)) { return a; }
  }
  return typeNone();
}

string naturalTypeOf(C c, Expr e) {
  // **Two literals joined are still a literal's family.** `("46316…" + "…").toBytes(1)` is a string
  // receiver however many pieces it was written in, and `typeOfExpr` answers unknown for it because
  // each side answers unknown on its own. Only where the two agree: `1 + x` is still the slot's
  // business, and this must not decide it.
  match (e.kind) {
    case Binary(op, left, right): {
      // **A chain, not only a pair.** `"a" + "b" + "c"` has a *binary* on its left, so asking whether
      // each side is a literal stopped at the second `+` — and the string this repository actually
      // writes, a 78-digit constant split across two lines and then `.toBytes()`, is exactly that
      // shape. Recursing answers `string` for the whole chain; two sides that disagree still answer
      // nothing, and a side that is not a literal at all still leaves the question to the slot.
      // **A comparison answers `bool`, whatever it compared.** Recursing without this said `i32`
      // for `status == 204`, and the `!` in front of it — four files write one — became a unary
      // operator on a number. `typeOfExpr` has always known this; the recursion had to be told.
      i32 bk2 = tokenKind(c, op);
      if (bk2 == kEq() || bk2 == kNe() || bk2 == kLt() || bk2 == kLe() || bk2 == kGt() ||
          bk2 == kGe() || bk2 == kAndAnd() || bk2 == kOrOr()) {
        return "bool";
      }
      string ln = naturalTypeOf(c, left);
      string rn = naturalTypeOf(c, right);
      if (ln == typeNone() || rn == typeNone()) { return typeOfExpr(c, e); }
      return ln == rn ? ln : typeNone();
    }
    else: { }
  }
  i32 lk = litKindOf(e);
  if (lk == litInteger()) {
    // **Only when it certainly fits.** An integer literal is polymorphic over `i32 i64 u32 u64`, and
    // calling it an `i32` is a useful answer for a rule with nothing else to go on — but
    // `18446744073709551615` is not an `i32` in any reading, and saying so produced a complaint
    // about a type the program never had, where the reference reports the literal being out of range
    // and stops. Ten digits is the boundary and nine is the one that is certain; a based literal
    // counts as unknown, which is the safe direction.
    i32 digits = literalDigits(c, e);
    if (digits <= 0) { return typeNone(); }
    if (digits < 10) { return "i32"; }
    // **Ten digits is not the same as "does not fit", and the digit count was standing in for the
    // question.** `1000000000` has ten and is an `i32`; asking the count answered unknown, and unknown
    // is silent, so `1000000000.nofield` drew nothing while `999999999.nofield` was reported. The
    // reference walks a ladder here — `i32` if the value fits, else `i64`, else *integer literal out of
    // range* — and `decimalExceeds` is the same digit comparison `integerLiteralFits` uses for the
    // 64-bit bounds, so asking it is exact rather than a wider guess.
    //
    // **A negated literal keeps the old answer.** Its bound is one larger on the `i32` rung — `i64`
    // for `-2147483648` would be wrong where unknown is merely unhelpful — and the sign is a separate
    // node, so the text here cannot see it. Left alone rather than approximated: this widening is meant
    // to add answers where they are certain and not to move any that already existed.
    string txt = decimalLiteralText(c, e);
    if (txt == "") { return typeNone(); }
    if (!decimalExceeds(txt, "2147483647")) { return "i32"; }
    if (!decimalExceeds(txt, "9223372036854775807")) { return "i64"; }
    return typeNone();
  }
  if (lk == litFloat()) { return "f64"; }
  if (lk == litBool()) { return "bool"; }
  if (lk == litString()) { return "string"; }
  return typeOfExpr(c, e);
}
/**
 * A JSX element's own rules: an attribute's value is a `string`, and a child is a `Node`.
 *
 * Both are ordinary assignability questions, which is why the errors read like every other type
 * error rather than like a syntax special case — and why the *positions* are the value's, not the
 * element's. `design/lang/0004`.
 */
/**
 * A component's own rules: it is a struct with a `render`, and its attributes are its fields.
 *
 * The field rules are named construction's — every field written, written once, and no name the
 * struct does not have — because the desugaring *is* a named construction, and two sets of rules for
 * one construct would differ the first time either moved. `errNamedField` is the same code
 * `Card { … }` reports, so the message a reader gets does not depend on which spelling they used.
 */
void checkJsxComponent(C c, string comp, i32 tagTok, JsxAttr[] attrs) {
  // `Node render(const this, Node[] kids)` is what makes a struct usable as a tag. Checked by shape
  // rather than by existence: a `render` taking nothing is a likelier mistake than no `render` at all.
  i32 mi = c.methodAt(comp, "render");
  bool ok = mi >= 0 && !c.methodStatics[mi] && c.methodReturns[mi] == "Node"
    && c.methodParamCount[mi] == 1 && c.methodParamTypes[c.methodParamAt[mi]] == "Node[]";
  if (!ok) {
    c.reportTok(errJsxNotComponent(), tagTok,
                comp + " is not a component: it has no `Node render(const this, Node[] kids)`");
    return;
  }
  for (i32 i = 0; i < attrs.len(); i++) {
    if (!c.hasField(comp, tokenText(c, attrs[i].nameTok))) {
      c.reportTok(errNamedField(), attrs[i].nameTok,
                  comp + " has no " + tokenText(c, attrs[i].nameTok));
    }
  }
  // Every field, because a named construction builds the whole struct. An optional attribute is a
  // thing named construction does not have either, and fixing it there fixes it here — so the
  // message names the field that is missing rather than counting, which is the half a reader needs.
  string at = templateOf(comp);
  for (i32 hop = 0; hop <= c.structCount; hop++) {
    if (at == "") { break; }
    for (i32 fi = 0; fi < c.fieldCount; fi++) {
      if (c.fieldOwners[fi] != at) { continue; }
      // A nullable attribute is optional, by the rule named construction follows — which is the same
      // rule, because this *is* a named construction. `design/lang/0007`.
      if (withoutNull(c.fieldTypes[fi]) != "") { continue; }
      bool set = false;
      for (i32 i = 0; i < attrs.len(); i++) {
        if (tokenText(c, attrs[i].nameTok) == c.fieldNames[fi]) { set = true; }
      }
      if (!set) {
        c.reportTok(errNamedField(), tagTok, comp + " needs " + c.fieldNames[fi]);
      }
    }
    at = c.parentOf(at);
  }
}

void checkJsx(C c, i32 tagTok, i32 closeTok, JsxAttr[] attrs, Expr[] kids) {
  // **A closing tag names the element it closes.** `<div></span>` is well formed as *shape* — the
  // parser read an element with a name at each end — and wrong as a program, which is why it is
  // said here, with the name that was written and the one that was expected.
  if (closeTok >= 0 && tagTok >= 0 && tokenText(c, closeTok) != tokenText(c, tagTok)) {
    c.reportTok(errJsxTagMismatch(), closeTok,
                "</" + tokenText(c, closeTok) + "> closes <" + tokenText(c, tagTok) + ">");
  }
  // A fragment has no name, so nothing here is about its tag: only its children are checked, by the
  // loop below that every element shares. `design/lang/0006`.
  // **A tag that names a struct in scope is a component**, and then its attributes are that struct's
  // fields rather than strings: `<Card count={3}/>` is `Card { count: 3 }.render(…)`, so `count` is
  // checked against the field's declared type. `design/lang/0005`.
  string comp = tagTok < 0 ? "" : tokenText(c, tagTok);
  bool isComponent = c.isStruct(comp) && !c.isGeneric(comp);
  if (isComponent) {
    checkJsxComponent(c, comp, tagTok, attrs);
  }
  for (i32 i = 0; i < attrs.len(); i++) {
    for (i32 j = 0; j < i; j++) {
      if (tokenText(c, attrs[j].nameTok) == tokenText(c, attrs[i].nameTok)) {
        c.reportTok(errJsxDuplicateAttr(), attrs[i].nameTok,
                    tokenText(c, attrs[i].nameTok) + " is already set on this element");
      }
    }
    checkExpr(c, attrs[i].value);
    // A component's attribute answers to its field's type; an element's is a string. Both are the
    // ordinary assignability question, asked against a different want.
    if (isComponent) {
      string want = c.fieldType(comp, tokenText(c, attrs[i].nameTok));
      if (want == typeNone() || want == "") { continue; }
      if (litFamily(c, attrs[i].value) != litNone()) {
        reportLiteral(c, want, attrs[i].value, errFieldMismatch(),
                      attrs[i].value.line, attrs[i].value.col);
        continue;
      }
      string got = typeOfExpr(c, attrs[i].value);
      // **The same complaint the named spelling makes**, because this *is* the named spelling: the
      // paragraph above says the field rules are a construction's, and `assignable` answers true for
      // `P?` into `P` by design, so a slot asking only `assignable` takes a nullable in silence.
      // `Card { p: a }` reported it and `<Card p={a} />` did not — one construct written two ways
      // giving two answers, which is exactly what that paragraph says must not happen.
      //
      // **And nothing else could have caught it**: the reference has no JSX — it answers *expected
      // expression, found '<'* — so no rung-3 differential covers this family. The test for it is
      // wacc against itself, in `illtyped_test.wac`.
      if (nullableIntoNonNull(c, want, got)) {
        c.report(errNullableToNonNull(), attrs[i].value.line, attrs[i].value.col);
      } else if (got != typeNone() && !assignable(c, want, got)) {
        c.reportWith(errFieldMismatch(), attrs[i].value.line, attrs[i].value.col,
                     tokenText(c, attrs[i].nameTok) + " is " + want + ", and this is " + got);
      }
      continue;
    }
    // **A literal is asked whether it fits, not what it is.** `{7}` has no type until something
    // wants one — asking `typeOfExpr` gives nothing and the mismatch goes unreported, which is how
    // `<div id={7}/>` was accepted. Every other position in this file reaches for `reportLiteral`
    // first for exactly this reason.
    if (litFamily(c, attrs[i].value) != litNone()) {
      reportLiteral(c, "string", attrs[i].value, errFieldMismatch(),
                    attrs[i].value.line, attrs[i].value.col);
      continue;
    }
    string got = typeOfExpr(c, attrs[i].value);
    // A `string?` is not a `string`, and `assignable` says it is — see `nullableIntoNonNull`, which
    // carries that complaint separately so the two do not both fire. Without asking it, the one value
    // that might not be there was the one an attribute accepted, while an `i32` was refused.
    if (nullableIntoNonNull(c, "string", got)) {
      c.report(errNullableToNonNull(), attrs[i].value.line, attrs[i].value.col);
    } else if (got != typeNone() && !assignable(c, "string", got)) {
      c.reportWith(errFieldMismatch(), attrs[i].value.line, attrs[i].value.col,
                   "an attribute is a string, and " + tokenText(c, attrs[i].nameTok) +
                   " is " + got);
    }
  }
  for (i32 i = 0; i < kids.len(); i++) {
    checkExpr(c, kids[i]);
    if (litFamily(c, kids[i]) != litNone()) {
      reportLiteral(c, "Node", kids[i], errFieldMismatch(), kids[i].line, kids[i].col);
      continue;
    }
    string got = typeOfExpr(c, kids[i]);
    // The same for a child, which is a `Node` by `spec/spec/jsx.md` and was taking a `Node?`.
    if (nullableIntoNonNull(c, "Node", got)) {
      c.report(errNullableToNonNull(), kids[i].line, kids[i].col);
    } else if (got != typeNone() && !assignable(c, "Node", got)) {
      c.reportWith(errFieldMismatch(), kids[i].line, kids[i].col,
                   "a child is a Node, and this is " + got);
    }
  }
}

void checkExpr(C c, Expr e) {
  string want = c.expected;
  bool wantUnknown = c.expectedUnknown;
  c.expected = typeNone();
  c.expectedUnknown = false;
  // A **character literal** arrives as an integer literal wearing quotes, and how many characters
  // are inside is a question only its text can answer: `''` holds none and `'ab'` holds two. Both
  // are reported at the literal, which is where the reference reports them.
  checkCharLiteral(c, e);

  match (e.kind) {
    // **Reported here rather than from `typeOfExpr`**, because that function is asked the same
    // question about the same node more than once and a diagnostic from it would arrive as many
    // times as it was asked. `checkExpr` walks each expression once, which is what makes it the
    // place a refusal belongs. The seam for implementing this is `c.expected` — already the
    // target-type channel a literal is checked through — plus a scope holding the parameters.
    case Lambda(params, body): {
      checkLambda(c, want, wantUnknown, e, params, body);
    }
    case Binary(op, left, right): {
      checkExpr(c, left);
      checkExpr(c, right);
      i32 k = tokenKind(c, op);
      // `>>>` is an unsigned shift, so on a type that is already unsigned it says nothing that `>>`
      // does not — the language calls that redundant rather than harmless. On a float it has no
      // meaning at all. Both name the operator, so both are one code here.
      // **Only the redundancy here.** `>>>` on a float is not an integer question this rule can
      // answer better than the operand rule below, which says exactly that — and reporting both gave
      // *two* diagnostics for `d >>> 1` where the reference gives one. So this narrows to the case
      // that is its own: an unsigned operand, where `>>>` asks for something `>>` already does.
      // `issues/lang/0237a`.
      if (k == kShrU()) {
        string st = typeOfExpr(c, left);
        if (st == "u32" || st == "u64") { c.reportTok(errShiftOp(), op, ""); }
      }
      bool arith = k == kPlus() || k == kMinus() || k == kStar() || k == kSlash() ||
                   k == kPercent() || k == kAnd() || k == kOr() || k == kCaret();
      // Arithmetic and bitwise operators want a number. Two booleans *agree*, so the same-type rule
      // below has nothing to say about `a + b` — this is the question of what the operands are, which
      // is the same distinction `&&` draws, one operator family further along.
      string alt = typeOfExpr(c, left);
      string art = typeOfExpr(c, right);
      // **`==` on a reference asks the wrong question, and asks it once.**
      //
      // Two references are equal when they are the same object, which the language spells `is`, so
      // the reference compiler answers *"'==' not allowed on reference type P — use 'is' for
      // identity"* — one sentence, whether the two sides are the same reference type or one is a
      // reference and the other is not. `< <= > >=` are the same rule and get the same answer: the
      // reference refuses `p < q` on a reference with that wording too, so splitting them would be
      // two rules that have to be kept saying the same thing.
      //
      // This is the only place that answers it, and it returns. Three rules used to overlap here:
      // a mismatch rule, a reference-versus-something-else rule, and a struct-or-array rule further
      // down, so `a == b` on two structs came back twice and `1 == "s"` came back twice — nine
      // diagnostics over six lines where the reference gives six. `report` already refuses the same
      // code twice at one position for the reason that applies to two different codes just as well:
      // a list that says it twice disagrees about how many things are wrong.
      //
      // **A nullable name is always a reference** — primitives have no nullable form — so `N?` and
      // `i32[]?` need no lookup, and asking `isStruct` about them answered no, which is how they
      // escaped the old rule and reached the emitter with nowhere to go.
      //
      // `string` is the exception, and it is on `string` **exactly**: `==` on two strings compares
      // bytes, which the emitter has a helper for, while `string?` would have to answer for null
      // first and so goes to `is` like anything else.
      // **Each side's type, from whichever of the two questions can answer it.** `at == ""` compares
      // a string against a string *literal*, and a literal has no type until something gives it one,
      // so `typeOfExpr` says unknown and the two-strings exemption below would not apply — the
      // checker refuses forty lines of its own source. `naturalTypeOf` fills a literal in and says
      // unknown for plenty that `typeOfExpr` knows, `c.activeParams[i]` among them, which is the
      // same failure from the other side. Neither alone is enough; the first that answers is.
      string nl = alt != typeNone() ? alt : naturalTypeOf(c, left);
      string nr = art != typeNone() ? art : naturalTypeOf(c, right);
      bool anyCmp = k == kEq() || k == kNe() || k == kLt() || k == kLe() || k == kGt() || k == kGe();
      if (anyCmp) {
        // A side that is *known* to be a reference other than a plain string. `string` is not in
        // here because two of them compare by value; it comes back below, where the two disagree.
        //
        // **An enum belongs in this list and was in none of the rules this replaced**, so `a == b`
        // on two of them was accepted outright: the struct-or-array rule asked `isStruct`, and the
        // mixed rule needed the sides to differ, which two `E`s do not. A funcref is deliberately
        // absent — the reference compares two of those without complaint.
        // A reference, minus the two the reference compiler compares anyway: a plain `string`, whose
        // `==` compares bytes, and a **funcref**, which it compares without complaint. Both
        // exceptions are read off the reference rather than argued for — the funcref one is not
        // obvious, and the sweep is what turned it up, as six false alarms on the first attempt.
        bool lRef = nl != "string" && !startsWithFn(nl) && isReferenceName(c, nl);
        bool rRef = nr != "string" && !startsWithFn(nr) && isReferenceName(c, nr);
        // **A string against a known something-else** — `1 == "hello"`, by far the commonest of
        // these in the corpus. Both sides have to be known: an expression this checker cannot type
        // compared against a string literal is not an error, and treating unknown as not-a-string
        // made it one in forty places in this file alone.
        bool strMix = nl != typeNone() && nr != typeNone() &&
                      (nl == "string") != (nr == "string");
        if (lRef || rRef || strMix) {
          c.report(errNotComparable(), e.line, e.col);
          return;
        }
      }
      // **Arithmetic on a reference**, which is the same question one operator family along. This
      // asked about `bool` and funcrefs only, so `S + S`, `E * E`, `i32[] - i32[]` and
      // `anyref % anyref` were all accepted — forty-five cells of the sweep, and every one of them a
      // program the reference refuses. `+` on two strings is the exception and concatenates; every
      // other combination involving a string is caught by the rule below, which predates this.
      // **`nl`/`nr`, not `alt`/`art`, or this cannot see a literal** — the correction the bitwise
      // branch below records for `1.5 & 2.5`, in the branch beside it. `true + false` has two operands
      // of a kind this rule refuses and neither had a type to refuse, so it was silent where the
      // reference says *"'+' requires numeric type, got bool"*. Moved **in lockstep with
      // `operandRuleSaid`** below, which mirrors this condition to decide whether the mismatch rule
      // should stay quiet: pointing one at `nl`/`nr` and not the other gives `n * "a"` two
      // diagnostics for one fault. `issues/lang/0245a`.
      bool lArith = nl != "string" && isReferenceName(c, nl);
      bool rArith = nr != "string" && isReferenceName(c, nr);
      if (arith && (nl == "bool" || nr == "bool" || lArith || rArith)) {
        c.reportTok(errOperandMismatch(), op, "");
      }
      // **A `string` is a number for exactly one operator.** `+` concatenates and the comparisons
      // order it, and the rest of the arithmetic family has nothing to do to one — *"'*' requires
      // numeric type, got string"*, at the operator. Read off the reference rather than assumed:
      // `==`, `<` and `+` are all accepted on two strings, so the rule is about the operator and not
      // about the type being a reference.
      if (arith && k != kPlus() && (nl == "string" || nr == "string")) {
        c.reportTok(errOperandKind(), op, "");
      }
      // **Two literals of different families**, which is the one case where neither side can take
      // its type from the other: `1 + "é"` has nothing to infer from and is a mismatch whatever the
      // slot wants. Measured across the ten pairs — an integer with a float, a string with a bool
      // and the rest — and the answer is the same every time, reported at the operator. Same family
      // is silent, including `true + false`, which is the numeric rule's business and not this one's.
      bool bothLit = litKindOf(left) != litNone() && litKindOf(right) != litNone();
      if (bothLit && litKindOf(left) != litKindOf(right) &&
          litKindOf(left) != litNull() && litKindOf(right) != litNull() &&
          (arith || k == kEq() || k == kNe() || k == kLt() || k == kLe() || k == kGt() ||
           k == kGe())) {
        c.reportTok(errOperandMismatch(), op, "");
      }
      // The bitwise operators want *integers*, which is a narrower demand than "numeric": `a & b` on
      // two `f64`s is refused although the two agree, so the same-type rule below never sees it. A
      // shift asks it of both sides separately — the value being shifted and the amount to shift by.
      bool bitwise = k == kAnd() || k == kOr() || k == kCaret();
      bool shift = k == kShl() || k == kShr() || k == kShrU();
      if (bitwise || shift) {
        // **`nl`/`nr`, not `typeOfExpr` alone, or this cannot see a literal.** A literal has no type
        // until something gives it one, so asking `typeOfExpr` about `1.5` answers unknown and the
        // guard below skipped it — which left `1.5 & 2.5`, `x & 1.5` and `x << "a"` checking clean,
        // and the last two emitting a module the engine refuses. `naturalTypeOf` fills a literal in,
        // and the pair computed above is exactly "whichever of the two questions can answer it".
        // `issues/lang/0236a`.
        bool badL = nl != "" && !isIntegerName(nl);
        bool badR = nr != "" && !isIntegerName(nr);
        // **One fault, one complaint: where the operands *differ*, the mismatch is the whole of it.**
        // `& | ^` are in both rule sets — this block wants integers, and the same-type block below
        // wants the two to agree — while `%` is only in the second. That is why `issues/lang/0238a`
        // fixed `s % 2` and left `a & b` on an `i32` and a `bool` at two diagnostics, both at the
        // operator. The reference reports one, and which one depends on the pair:
        //
        //     i32 & bool    type mismatch in '&': i32 and bool        they differ
        //     i32 & f64     type mismatch in '&': i32 and f64         they differ
        //     f64 & f64     '&' requires i32 or i64, got f64          they agree, and are not integers
        //
        // So this rule stands aside exactly when the one below will speak, and the condition is that
        // one's own, mirrored: no literal on either side (the literal branch there answers nothing for
        // a pair like `x & 1.5`, so standing aside would leave **no** diagnostic), both types known and
        // different, and neither a `string` — a string in a bitwise operator returns there and this is
        // its only report. `f64 & f64` is the row that makes the narrowness necessary rather than
        // tidy: suppressing whenever this block fires would take that program's only diagnostic away,
        // which is the shape `n * "a"` recorded in `illtyped_test.wac` after a suppression keyed on
        // the operator alone made an ill-typed program compile.
        bool eitherLit = litKindOf(left) != litNone() || litKindOf(right) != litNone();
        string tl = typeOfExpr(c, left);
        string tr = typeOfExpr(c, right);
        bool mismatchWillSpeak = bitwise && !eitherLit &&
                                 tl != typeNone() && tr != typeNone() && tl != tr &&
                                 tl != "string" && tr != "string";
        if ((badL || badR) && !mismatchWillSpeak) { c.reportTok(errOperandKind(), op, ""); }
      }
      bool sameType = k == kPlus() || k == kMinus() || k == kStar() || k == kSlash() ||
                      k == kPercent() || k == kAnd() || k == kOr() || k == kCaret();
      bool comparison = k == kLt() || k == kLe() || k == kGt() || k == kGe() ||
                        k == kEq() || k == kNe();
      // `&&` and `||` are the other rule: each operand must be a boolean on its own, which is a
      // different question from whether the two agree. Reported at the operator, where the reference
      // reports it, and a literal counts — `p && 1` is an error while `p && true` is not.
      if (k == kAndAnd() || k == kOrOr()) {
        if (notBool(c, left) || notBool(c, right)) {
          c.report(errNotBool(), e.line, e.col);
        }
        return;
      }
      if (!sameType && !comparison) { return; }
      string nl2 = naturalTypeOf(c, left);
      string nr2 = naturalTypeOf(c, right);
      // A literal operand takes the other side's type, so `x + 1` is legal for any numeric `x` and
      // demanding they agree would report the code everybody writes.
      if (litKindOf(left) != litNone() || litKindOf(right) != litNone()) {
        // **A literal only adapts inside its own family.** That is the whole content of the skip
        // above, and it was written as *every* literal adapts — so `x + s` was refused for a named
        // `string s` and `x + "s"` was accepted, which is the same program twice. A string literal
        // is a string whatever slot it lands in and has nothing to take from the other side.
        // Asked through `naturalTypeOf`, which is what fills a literal's own family in; two
        // literals are the rule further up, and a comparison is the reference-type rule's.
        bool oneString = (nl2 == "string") != (nr2 == "string");
        // **Only for `+`, because that is the only one the operand rule leaves alone.** A string in
        // any other arithmetic operator is already reported as an operand of the wrong kind — *"`+`
        // concatenates and the comparisons order it, and the rest of the arithmetic family has nothing
        // to do to one"* — so asking again here gave `s % 2` two diagnostics for one fault, where the
        // reference gives one because its numeric check returns before the same-type check runs.
        // `+` is where a string is legitimate and the mismatch is the whole of the complaint.
        // `issues/lang/0238a`.
        // **Suppressed only where the operand rule actually spoke, which is narrower than "not `+`".**
        // That rule reads `typeOfExpr`, which is empty for a string *literal*, so it never fires for
        // `n * "a"` — and this one, reading `naturalTypeOf`, is the only thing that catches it. A
        // first attempt keyed the suppression on the operator alone and made `n * "a"` compile: the
        // mutation sweep's recall caught it where its count-disagreement number called it an
        // improvement, which is the argument for having both. `issues/lang/0238a`.
        // **`nl`/`nr` here too.** This mirrors the operand rule's condition, so the two have to be
        // asked the same question — the note above about `typeOfExpr` being blind to a string literal
        // described the state before `0245a` pointed both at the filled-in pair.
        bool operandRuleSaid = k != kPlus() && (nl == "string" || nr == "string");
        if (sameType && !operandRuleSaid && !bothLit && oneString &&
            nl2 != typeNone() && nr2 != typeNone()) {
          c.report(errOperandMismatch(), e.line, e.col);
        }
        return;
      }
      string a = typeOfExpr(c, left);
      string b = typeOfExpr(c, right);
      if (a == typeNone() || b == typeNone() || a == b) { return; }
      // **The same suppression as the literal branch, and here the operator alone is enough.** This
      // path runs only when neither side is a literal, so `typeOfExpr` has answered for both and
      // cannot be blind the way it is for `"a"` — which is what made the literal branch above need
      // the narrower condition. `string x = 1; u32 y = 1; return x / y;` drew three where the
      // reference draws two. `issues/lang/0238a`.
      if (sameType && k != kPlus() && (a == "string" || b == "string")) { return; }
      c.reportWith(errOperandMismatch(), e.line, e.col, a + " and " + b);
    }
    // A name that nothing declares. The most-missed family in the reference's own tests, and the last
    // rule here to need a *complete* picture of scope rather than a fact about one construct: every
    // binder the language has must be known, because anything missed is a false alarm on working
    // code rather than a gap. Locals, parameters, `this` and match bindings come from the name table;
    // functions, structs, enums, imports and the primitive type names are looked up where they live.
    case Jsx(tagTok, closeTok, attrs, kids): { checkJsx(c, tagTok, closeTok, attrs, kids); }
    case Ident(tok): {
      string idn = tokenText(c, tok);
      if (!nameExists(c, idn)) {
        c.reportWith(errUndefinedName(), e.line, e.col, "no " + idn + " in scope");
        return;
      }
      // A type's name is not a value. It reaches expression position legitimately as the receiver
      // of a static call, and that arrives through the `Call` and `Member` arms rather than here —
      // so an `Ident` that names a type and nothing else is one used where a value belongs.
      //
      // **All three kinds, not just a struct.** The reason above is about how a type name arrives, and
      // it does not distinguish them: an enum reaches a value position only as `E.Variant` and a
      // primitive only as a cast or a static, both through the same two arms. Asking about structs
      // alone left `x < i32` and `x < E` with **no diagnostic at all** — the emitter caught them
      // later, with `unresolved name i32 on line 1` and no position, and only because it declines what
      // it cannot resolve. That is also why `b.map<i32>(…)` reported `expected Box<i32>, found bool`:
      // the comparison's right operand was a type name nothing objected to. `issues/lang/0235a`.
      //
      // **`isPrimitiveName` and not `isValueType` here, deliberately.** The comment on `isValueType`
      // warns that three rules have used `isPrimitiveName` where they meant "held by value", because
      // `string` is in that list and is a reference. This rule wants the other thing: the list of
      // *type names*, which is what `isPrimitiveName` is — and `x < string` is as much a type name in
      // value position as `x < i32`, so `string` belonging to the list is the point rather than a
      // trap. `string.fromBytes(…)` is unaffected: a static call arrives through `Member`.
      if (!c.isDeclaredName(idn) && c.funcAt(idn) < 0 &&
          (c.isStruct(idn) || c.isEnum(idn) || isPrimitiveName(idn))) {
        c.report(errTypeAsValue(), e.line, e.col);
      }
    }
    // `x is null` and `a is b` ask about a *reference*, so a primitive is not something they can be
    // asked about. Both land on the `is`, which is this node's own position.
    case Is(left, target, other, negated): {
      checkExpr(c, left);
      // **A type test needs no payload** — `[§enum-is-qualified-8jkq4wp]`: `s is Shape.Circle(1.0)`
      // is an error rather than silently false. The right of `is` parses as an expression when it is
      // qualified, so a variant *construction* arrives here looking like an ordinary identity test
      // against a freshly built value, which can never be identical to anything. Asked of the shape
      // rather than of the type, because the construction is what is wrong. `spec/cases/0076`.
      if (!(other is null) && isVariantConstruction(c, other!)) {
        c.report(errOperandKind(), e.line, e.col);
      }
      if (!(other is null)) { checkExpr(c, other!); }
      // **The target is a type, and this is the only place that reads it as one.** Every other rule
      // here asks about the left operand, so `mkA() is Circle` never resolved `Circle` at all — and a
      // variant needs importing like any other name (`§wac-type-name-scope-8vqk3mn`). The identity
      // form `x is Other`, where `Other` is a variable, arrives as `other` rather than `target` and
      // is untouched by this.
      if (!(target is null)) {
        string want = typeOfTy(c, target!);
        // **`A is B` where the two share no ancestor is always false** — the second of
        // `issues/lang/0126`'s three. Legal, and the reader believes it defends something.
        //
        // Both types known, both references, neither generic: a generic instantiation's chain is
        // what this checker does not model, and "cannot know" must not become "never true".
        string have = typeOfExpr(c, left);
        if (want != typeNone() && want != "" && have != typeNone() && have != "" &&
            isReferenceType(c, want) && isReferenceType(c, have) &&
            !c.isGeneric(want) && !c.isGeneric(have) && !shareAncestor(c, have, want)) {
          c.warn(warnNeverThat(), e.line, e.col);
        }
      }
      // Phrased as "is it a **primitive**" rather than "is it not a reference". The two are not the
      // same question: an enum, a funcref and a generic instantiation are all references, and asking
      // the negative form reported 27 files that were doing nothing wrong. The positive form only
      // ever fires on a type this checker can name, which is the direction to be wrong in.
      string lt3 = typeOfExpr(c, left);
      // **`x is null` on something that is never null** — the first of `issues/lang/0126`'s three.
      // Legal, and answers false: `[§wac-nonnull-isnull-k8fn3wp]`, which is why it is a warning and
      // not an error — `Slot<T>.empty` must instantiate for nullable and non-nullable `T` alike.
      //
      // The reference's own note is the argument for saying it at all: `packages/platform` changed
      // `env` from `string?` to `Pending<string?>`, every `cli.env(n) is not null` became a
      // tautology, and five survived a migration the type checker otherwise caught completely.
      //
      // Only where the type is *known* and a reference: a primitive cannot be null and is refused
      // above rather than warned about, an unknown type is the answer this checker gives whenever it
      // cannot compute one, and a type parameter is unknown by construction — warning on any of
      // those is a false alarm on correct code, which is the direction that costs trust.
      // **A funcref is one of these and `isReferenceType` does not say so, correctly.** That predicate
      // decides what may be stored in an `anyref` — its other five callers are all that question — and
      // a funcref may not be, in WasmGC or here, so widening it to reach this rule would answer a
      // different question wrongly. What is true is narrower: a funcref written without a `?` can no
      // more be null than a struct can, so `cb is null` on one is the same tautology, and it is the
      // shape the warning was written for. `packages/platform` changed a field's type and five
      // `is not null` tests became always-true; a callback field is exactly where that happens again.
      bool neverNullKind = isReferenceType(c, lt3) || startsWithFn(lt3);
      if ((target is null) && (other is null) && lt3 != typeNone() && lt3 != "" &&
          withoutNull(lt3) == "" && neverNullKind && !c.isGeneric(lt3)) {
        c.warn(warnNeverNull(), e.line, e.col);
      }
      // **A funcref is a reference and still not testable**, which is why it is named rather than
      // reached by the negative form the comment above rejects: the reference answers *"'is' type
      // test requires a reference type, got fn(i32) -> i32"*, because there is no hierarchy of
      // function types and nothing to test at runtime. The positive form stays for everything else.
      // …and only when there *is* a target, because `f is null` on a nullable funcref is the
      // ordinary way to ask whether one was supplied, which the reference accepts. The restriction
      // is about testing a funcref's *type*, not about mentioning one.
      if (isValueType(lt3) || (!(target is null) && startsWithFn(lt3))) {
        c.report(errReferenceOp(), e.line, e.col);
      }
      // **And a bare `null` on the left**, which has no type at all rather than a wrong one — so
      // every guard above skipped it and `null is null` reached the emitter, which declined the whole
      // module with the reason *"null"*. `spec/spec/types.md`: *"`null` is a keyword literal with no
      // type of its own … the compiler infers the type from context"*, and there is no context here to
      // infer from. The reference says *"'is null' requires a reference type, got null"*, which is
      // this rule's own code. `issues/lang/0249a`.
      if (litKindOf(left) == litNull()) { c.report(errReferenceOp(), e.line, e.col); }
    }
    // `p!` on something that was never nullable: there is nothing to unwrap.
    case Unwrap(operand): {
      checkExpr(c, operand);
      // The same caution: unwrapping is refused only when the operand is a type this checker knows
      // is not nullable — rather than whenever it cannot see a `?`. What it knows is wider than the
      // struct-or-primitive this used to list: an enum, an array, a funcref and `anyref` are all
      // types with no `?`, and `someEnum!` compiled. The `withoutNull` guard above is what makes
      // asking `isReferenceName` safe here, since it has already established there is no `?`.
      string ut2 = typeOfExpr(c, operand);
      if (withoutNull(ut2) == "" &&
          (isPrimitiveName(ut2) || ut2 == "bool" || isReferenceName(c, ut2))) {
        c.report(errNeedsNullable(), e.line, e.col);
      }
      // A bare `null!` for the same reason as `null is null` one arm up: nothing to unwrap and no type
      // to notice it by. The reference: *"'!' unwrap requires nullable type, got null"*.
      // `issues/lang/0249a`.
      if (litKindOf(operand) == litNull()) { c.report(errNeedsNullable(), e.line, e.col); }
    }
    case Unary(op, operand): {
      checkExpr(c, operand);
      // `!` wants a boolean; `-` wants a number; `~` wants an integer. Three different demands on the
      // one node, all reported at the operator, and all of them silent on an unknown operand.
      i32 uk = tokenKind(c, op);
      // **A literal's own family, not the slot's.** `-"s"` is the whole of the mistake and there is
      // nothing else for the literal to take a type from — the same argument that made a comparison
      // fill it in. Asking `typeOfExpr` answered unknown and stayed silent on every one of them.
      string ut = naturalTypeOf(c, operand);
      if (ut != typeNone()) {
        // **All three ask `unaryAccepts`**, which `typeOfExpr` also reads so that a rejected
        // operand leaves the expression with no type. The lists that were spelled out here are the
        // ones that forgot enums twice; one predicate is the answer to that as well.
        //
        // `-a` on a `u32` or `u64` is included because an unsigned integer has no negation — the
        // reference answers *"unary '-' is not defined on u32"*. `u8` and `u16` are packed rather
        // than unsigned-arithmetic types and the reference complains about them three times over;
        // this catches one of the three, which rung 3 permits, because a subset at the right
        // position is the contract.
        if (!unaryAccepts(c, uk, ut)) {
          c.reportTok(errOperandKind(), op, "");
        }
      }
    }
    // The expression form of `++`. `IncrStmt` had it as a statement, and `return x++` is neither —
    // the same shape reached through a different node, which is the third time that has happened.
    case Incr(target, op, prefix): { checkIncr(c, target, e.line, e.col); }
    // A `match` used for its value. Its arms hold expressions rather than statements, so nothing that
    // walked the statement form reached them — found by the grid, not by a rule looking wrong.
    case MatchExpr(subject, arms): {
      checkExpr(c, subject);
      // An expression arm carries a value and no body — one `Arm` type serves both forms, as the
      // reference has it — so the value is the whole of what there is to walk here.
      //
      // The bindings are declared *here* rather than in `declareStmt`, because that walks statements
      // and this is an expression: a `match` used for its value can sit inside an initialiser or a
      // return, where the declaration pass never goes. Three files said so — `case Some(v): v * 3`
      // reported `v` as undefined. Declaring them at the point of use is enough because an arm's
      // value is walked immediately afterwards, and leaving them in scope for the rest of the
      // function is over-permissive in the silent direction, which is the one to err in.
      checkArmVariants(c, subject, arms);
      for (i32 i = 0; i < arms.len(); i++) {
        for (i32 b = 0; b < arms[i].bindingToks.len(); b++) {
          c.declare(tokenText(c, arms[i].bindingToks[b]), armBindingType(c, subject, arms[i], b));
        }
        checkBindingCollision(c, subject, arms[i]);
        // **An arm of an expression match narrows too.** Only the statement form did, so
        // `match (s) { case Circle: s.radius, ... }` looked for `radius` on the un-narrowed subject
        // and reported a field that was there all along — the spec's own program for this clause.
        // The same const rule applies for the same reason: the arm is describing one value.
        string saved = armNarrowing(c, subject, arms[i]);
        string subj = subjectName(c, subject);
        bool wasConst = subj == "" ? false : c.isConstName(subj);
        bool wasAlias = subj == "" ? false : c.isAliasOnlyName(subj);
        if (subj != "" && arms[i].variantTok >= 0) { c.setConstFlags(subj, true, false); }
        if (!(arms[i].value is null)) { checkExpr(c, arms[i].value!); }
        if (subj != "") { c.setConstFlags(subj, wasConst, wasAlias); }
        restoreNarrowing(c, subject, saved);
      }
      checkArmValueTypes(c, arms, e.line, e.col);
    }
    // `i32[](1, 2)`, `i8[](1.5)`, `E[2](fill: 5)` — every element and the fill must fit the element
    // type, which is the same question as an initialiser with the type coming from the `[]`.
    case ArrNew(elem, size, fill, elements): {
      if (!(size is null)) {
        checkExpr(c, size!);
        // A length is a count, so it is an `i32` — at the size expression, which is the only thing
        // there is to name.
        Expr sz = size!;
        i32 slit = litFamily(c, sz);
        if (slit != litNone()) {
          if (!acceptsLiteral("i32", slit)) { c.report(errIndex(), sz.line, sz.col); }
        } else {
          // The same rule as an index and the same slip: `isIntegerName` accepted `i64`, `u32` and
          // `u64`, while the literal branch above demanded an `i32`.
          string st2 = typeOfExpr(c, sz);
          if (st2 != typeNone() && st2 != "i32") { c.report(errIndex(), sz.line, sz.col); }
        }
      }
      // The report for the case the typing arm answers `typeNone()` for: a local's name standing where
      // an element type belongs. Once per expression, at the name.
      reportBindingAsType(c, elem);
      string elemWant = typeOfTy(c, elem);
      // An element's slot is the element type, which is what lets a bare generic infer inside one.
      for (i32 i = 0; i < elements.len(); i++) {
        c.expected = elemWant;
        checkExpr(c, elements[i]);
      }
      if (!(fill is null)) {
        c.expected = elemWant;
        checkExpr(c, fill!);
      }
      string want = elemWant;
      if (want == typeNone()) { return; }
      // `E[2]()` with nothing to fill it asks every element for a default, and an enum has none.
      //
      // **`E[]()` asks for nothing**, which is a different program: the listed form with no elements
      // is an empty array, and an array with no elements never builds one. `return Expr[]();` is a
      // line in this compiler's own parser, and it was reported the moment the checker could see
      // what `Expr` is — the rule needed a size before it needed a default.
      if (!(size is null) && elements.len() == 0 && (fill is null) && !hasDefault(c, want, 0)) {
        c.report(errNoDefault(), e.line, e.col);
      }
      // A packed element is an `i32` at this position, the way `bytes[i] = 5` is: the width is the
      // array's business, not the element expression's.
      if (isPackedName(want)) { want = "i32"; }
      for (i32 i = 0; i < elements.len(); i++) { checkElement(c, want, elements[i]); }
      if (!(fill is null)) { checkElement(c, want, fill!); }
    }
    // A cast's operand. `(p + q) as i64` reported nothing, because typing a cast as its target — the
    // right answer — meant never looking inside it.
    case Cast(op, operand, target): { checkExpr(c, operand); checkCast(c, e, op, operand, target); }
    case Ternary(cond, then, els): {
      // **Both branches sit in the ternary's own slot.** `Box<i32> b = c ? Box(1) : Box(2);` needs
      // it: a bare `Box(…)` takes its type arguments from where it is going, and `c.expected` is
      // cleared by the first expression that reads it — so the second branch got nothing and the
      // whole thing was reported as a template used as a value.
      // `want`, not `c.expected`: the slot was read and cleared at the top of this function, which is
      // the whole mechanism — an expression gets the context it was given and cannot leak it sideways.
      string slot = want;
      checkExpr(c, cond);
      c.expected = slot;
      checkExpr(c, then);
      c.expected = slot;
      checkExpr(c, els);
      // The condition is the `if` rule in expression position, and lands on the condition itself.
      if (notBool(c, cond)) {
        reportExpr(c, errNotBool(), cond, expectedFound("bool", foundType(c, cond)));
      }
      // The branches have to agree, because the whole expression is one type. A literal branch takes
      // the other's type, as everywhere, so only two known and different types are a complaint — and
      // it names the node rather than either branch, neither being more wrong than the other.
      // **A literal branch is exempt only if it fits.** This arm was skipped whenever *either*
      // branch was a literal, on the grounds that a literal takes the other's type — true when it
      // can. `1` cannot be a `string`, so `b ? s : 1` disagreed, went unreported, and the whole
      // conditional answered unknown, which took the return rule with it: the function was declined
      // and `wac build` exited 0. `literalFits` is the question the typing walk above already asks
      // for the same pair, so the two now agree. `issues/lang/0170a`.
      if (isPlainLiteral(c, els) && !isPlainLiteral(c, then)) {
        string lt = typeOfExpr(c, then);
        if (lt != typeNone() && lt != "" && (concreteShape(lt) || literalNeverFits(c, lt)) &&
            !literalFits(c, lt, els)) {
          c.report(errTernaryBranches(), e.line, e.col);
        }
      } else if (isPlainLiteral(c, then) && !isPlainLiteral(c, els)) {
        string rt2 = typeOfExpr(c, els);
        if (rt2 != typeNone() && rt2 != "" && (concreteShape(rt2) || literalNeverFits(c, rt2)) &&
            !literalFits(c, rt2, then)) {
          c.report(errTernaryBranches(), e.line, e.col);
        }
      }
      // **`litFamily` in both of these, and it had to change with `isPlainLiteral` above.** Widening
      // that predicate alone fixes **two of the six** pairs and leaves four, measured by reverting
      // exactly these two lines: a pair like `b ? 1 + 1 : "a"` now has two literal branches, so it
      // goes past the two arms above and into the second arm here, which was still asking
      // `litKindOf` and declined as well. For those four, fixing one guard changed which guard was
      // silent rather than the answer.
      // `issues/lang/0246a`; `issues/lang/0245a` is the same lesson about a rule and its mirror.
      if (litFamily(c, then) == litNone() && litFamily(c, els) == litNone()) {
        string tt = typeOfExpr(c, then);
        string et = typeOfExpr(c, els);
        // **Reference branches take their closest common ancestor**, which `spec/spec/control.md`
        // states and this rule did not know: `flag ? c : r` on a `Circle` and a `Rect` is a `Shape`,
        // and neither branch is assignable to the other. Asking assignability in both directions
        // answers "no" for every pair of siblings, and refused four programs the spec runs.
        if (tt != typeNone() && et != typeNone() && !assignable(c, tt, et) &&
            !assignable(c, et, tt) && !shareAncestor(c, tt, et)) {
          c.report(errTernaryBranches(), e.line, e.col);
        }
      } else if (litFamily(c, then) != litNone() && litFamily(c, els) != litNone()) {
        // Two literals of different families — `c ? 1 : true` — have nothing to take a type from.
        // **Except a `null`**, which takes the other branch's type: `c ? 1 : null` in an `i32?` slot
        // is the shape the spec writes for a nullable primitive.
        if (litFamily(c, then) != litFamily(c, els) &&
            litFamily(c, then) != litNull() && litFamily(c, els) != litNull()) {
          c.report(errTernaryBranches(), e.line, e.col);
        }
      }
    }
    case Index(arr, index): {
      checkExpr(c, arr);
      checkExpr(c, index);
      checkIndex(c, e, arr, index);
    }
    case Member(obj, nameTok): {
      checkReceiver(c, obj);
      checkMember(c, e, obj, tokenText(c, nameTok));
    }
    // `g(a)` is a **Construct**, not a Call. The parser cannot tell a call from a struct
    // construction — `Point(1, 2)` and `g(a)` are the same syntax — so it builds `Construct` with a
    // `Named` type for both and the resolver decides which later. A `case Call` never matches a
    // plain named call, which is why the first version of this reported nothing at all.
    case Construct(ctype, args, named): {
      // Each argument is walked with the slot it is going into, which is what lets a generic
      // construction nested in one — `g(Box(1.0))` — infer from the parameter.
      match (ctype.kind) {
        case Named(ctok, ctargs): {
          string cname = tokenText(c, ctok);
          for (i32 i = 0; i < args.len(); i++) {
            c.expected = argumentSlot(c, cname, ctargs.len() > 0 ? typeOfTy(c, ctype) : cname, i);
            // `argumentSlot` answers `typeNone()` for four different reasons, and one of them is that
            // `cname` is neither a struct nor a function *this file* contains — an imported type,
            // under a single-file check. Empty therefore means "could not tell" here as it does in
            // the call arm; see `C.expectedUnknown`.
            c.expectedUnknown = c.expected == typeNone();
            checkExpr(c, args[i]);
            c.expectedUnknown = false;
          }
        }
        else: {
          // A constructed type that is not a plain name: nothing named a slot at all.
          for (i32 i = 0; i < args.len(); i++) {
            c.expectedUnknown = true;
            checkExpr(c, args[i]);
            c.expectedUnknown = false;
          }
        }
      }
      match (ctype.kind) {
        case Named(tok, typeArgs): {
          string name = tokenText(c, tok);
          if (c.isStruct(name)) {
            // A **bare generic** takes its type arguments from wherever it is going. With a target
            // whose template is this one, the construction *is* that type and its arguments are
            // checked against the substituted fields; with no target at all there is nothing to infer
            // from, and the reference calls the bare name undefined — which it is, since a template
            // is not a type. `Box(1.0)` assigned to a `Box<f64>` is ordinary and `Box(1).get()` is
            // not, and the only difference between them is the slot.
            string spelled = typeArgs.len() > 0 ? typeOfTy(c, ctype) : name;
            if (typeArgs.len() == 0 && c.isGeneric(name)) {
              // The target's **nullability is not part of the question**: a `MapEntry<K, V>?` slot
              // takes a `MapEntry<K, V>`, and the construction produces the non-null one. Comparing
              // the spelled target directly missed that and reported a working line in `packages/std`.
              string wantCore = withoutNull(want);
              string wantBase = wantCore == "" ? want : wantCore;
              if (templateOf(wantBase) == name) {
                spelled = wantBase;
              } else {
                c.report(errNotCallable(), e.line, e.col);
                return;
              }
            }
            checkConstruct(c, spelled, args, named, e);
            // Two questions a construction asks that the field types do not. With arguments, the
            // count has to match — parents included, since a child is constructed with the whole
            // chain's fields. With none, it is a *default* construction, and the struct has to have
            // a default at all.
            //
            // **The count is the template's, so a generic is not exempt from it.** This whole block
            // was gated on `!c.isGeneric(name)`, which is right for the *default* question below —
            // whether `Box()` has a default depends on field types, and inside the template those are
            // parameters — and wrong for the count: `Box` has one field for every `T` there is, so
            // `Box(x, 1)` is two arguments too many in every instantiation. `Box.of` writing
            // `Box(x, 1)` inside the generic's own method was silent while the same mistake in a plain
            // struct was reported, at the same position, by the line below.
            if (args.len() > 0 && named.len() == 0 && args.len() != fieldArity(c, name)) {
              c.report(errCtorArity(), e.line, e.col);
            } else if (!c.isGeneric(name)
                       && args.len() == 0 && named.len() == 0 && !hasDefault(c, name, 0)) {
              c.report(errNoDefault(), e.line, e.col);
            }
          }
          else { checkCallee(c, name, args, named, e); }
        }
        else: { }
      }
    }
    // A real `Call` is a method or a funcref. A method call is `Call(Member(receiver, name), args)`
    // and is checked; a funcref call has no name to look up and is not.
    case Call(callee, args): {
      // **A variant construction's arguments have slots, and they are the payload's.** `Wrap.W(Box(5))`
      // puts a `Box<T>` in the first one, which is what a bare `Box(5)` needs to know which instance
      // it is — without it the construction was checked against no slot at all and refused as "not
      // callable". `spec/cases/0046`.
      string payloadOwner = variantCalleeOwner(c, callee);
      // **In the instance's world, not the template's.** The slot `W` declares is written `Box<T>`,
      // and handing that to a bare `Box(5)` asks it to be a `Box<T>` — a type nobody wrote. Which
      // instance it is comes from the slot the construction itself lands in: `Wrap<i32> w = …` is
      // the only place `i32` is said. `spec/cases/0046`.
      // `want`, not `c.expected`: the slot is read and cleared at the top of this function, exactly
      // as the array and construction arms above already note.
      string outerSlot = want;
      string outerBase = genericBase(outerSlot);
      bool ownerKnown = payloadOwner != "" && outerBase != "" && c.enumAt(outerBase) >= 0 &&
                        c.variantArityIn(outerBase, payloadOwner) >= 0;
      // **A method's parameter types, so an argument knows what it is filling.** Without this a
      // lambda passed to a method had no target and was refused outright — `issues/lang/0141`, which
      // is most of this repository's APIs: `Pending.of` is a static taking three funcrefs, and every
      // capability answers through it.
      //
      // A generic receiver is left alone: its parameter types are written in the template's letters,
      // and `typeOfExpr` already declines to answer for one rather than claiming `T`.
      string methodOwner = "";
      // **A generic static takes its `T` from the slot the call lands in.** `Pending.of` is declared
      // `Pending<T> of(…)` inside `struct Pending<T>`, so it returns the owner instantiated — which
      // means the wanted type *is* the instantiation, and no unification is needed to read `T` off
      // it. `issues/lang/0141`; the enum-payload arm below binds from `want` the same way and for the
      // same reason.
      string methodInst = "";
      match (callee.kind) {
        case Member(mobj, mnameTok): {
          string mrecv = typeOfExpr(c, mobj);
          if (mrecv == typeNone()) { mrecv = staticOwnerName(c, mobj); }
          if (mrecv != "" && mrecv != typeNone()) {
            if (!c.isGeneric(mrecv)) {
              methodOwner = mrecv;
              // **A receiver that names an instantiation carries its own `T`.** `methodAt` collapses
              // `Vec<fn[i32(i32)]>` to the template it was declared in, so a parameter written `T`
              // arrives spelled `T` — and an argument checked against `T` is checked against a type
              // nobody wrote. `issues/lang/0141` bound `T` for a *static* from the slot the call lands
              // in; an instance method needs no slot, because the receiver already says which
              // instantiation this is.
              //
              // `Vec<fn[i32(i32)]> hs; hs.push((i32 n) => n);` is what found it: a lambda has no type
              // of its own, so *expected T, found a lambda* is the whole diagnostic, and a container
              // of continuations could not be filled.
              if (templateOf(mrecv) != mrecv) { methodInst = mrecv; }
            }
            else if (genericBase(want) == mrecv) {
              // The call's result is an instantiation of the very generic being called on, so its
              // arguments can be read in that world. Anything else is left alone: a generic whose
              // parameters this checker cannot bind is one it declines to guess about.
              methodOwner = mrecv;
              methodInst = want;
            }
          }
        }
        else: { }
      }
      i32 methodIx = methodOwner == "" ? -1 : c.methodAt(methodOwner, tokenText(c, calleeName(c, callee)));
      for (i32 i = 0; i < args.len(); i++) {
        // **Whether this argument has a slot at all**, which is a different question from what the
        // slot is. Neither branch fires when the receiver is a type this file does not contain — an
        // import, in a single-file check — and an empty `c.expected` then means "could not tell"
        // rather than "nothing wanted". Only `checkLambda` needs the difference; see
        // `C.expectedUnknown`.
        bool slotted = false;
        if (payloadOwner != "") {
          string slot = c.fieldTypeAtIndex(payloadOwner, i);
          c.expected = ownerKnown ? substituteType(c, outerSlot, slot) : slot;
          slotted = true;
        } else if (methodIx >= 0 && i < c.methodParamCount[methodIx]) {
          string mslot = c.methodParamTypes[c.methodParamAt[methodIx] + i];
          c.expected = methodInst == "" ? mslot : substituteType(c, methodInst, mslot);
          slotted = true;
        }
        c.expectedUnknown = !slotted;
        checkExpr(c, args[i]);
        c.expectedUnknown = false;
      }
      match (callee.kind) {
        case Member(obj, nameTok): {
          // The **object**, not the whole callee. Walking the callee as an expression would read
          // `p.inc()` as a field access to `inc` and call it a missing field, which is the method it
          // is about to check. The nullable rule still applies and is asked for separately, because
          // *"cannot call method on nullable"* is its own diagnostic.
          checkReceiver(c, obj);
          checkThroughNullable(c, e, obj);
          checkMethodCall(c, e, callee, obj, tokenText(c, nameTok), args, methodInst);
        }
        else: {
          checkExpr(c, callee);
          // **`7()` is not a call.** A funcref is, a name that is a function is, and everything else
          // this checker can put a type to is *"type 'i32' is not callable"* — at the callee, which
          // is where the reference reports it. Silent on a type it cannot name, as everywhere.
          //
          // `null()` is the one that has no type to put: a null is not a value of anything, and
          // `naturalTypeOf` says so by answering nothing. It is still not callable, and
          // `packages/bls/src/fp12.wac` is where a mutation wrote one.
          if (litKindOf(callee) == litNull()) {
            c.report(errNotCallable(), callee.line, callee.col);
            return;
          }
          string ct = naturalTypeOf(c, callee);
          if (ct != typeNone() && ct != "" && !startsWithFn(ct)) {
            c.report(errNotCallable(), callee.line, callee.col);
          }
        }
      }
    }
    else: { }
  }
}

/**
 * `x++` and `--x`, which are a write and an arithmetic operation at once.
 *
 * Two rules, and they land in different places: the write is refused at the **operand**, which is
 * where every other const complaint goes, and a type that cannot be incremented is refused at the
 * **node's own position**. Those are the same column for `++x` and differ for `x++`, and the node's
 * position differs again between the two forms — a statement `x++;` starts at the `x`, while the
 * expression `return x++` is positioned at the operator. Passing the position in rather than deriving
 * it from the operator token is what lets one function serve both.
 *
 * Unsigned types are fine despite the wording of the reference's message — `u32` and `u64` increment
 * — which is measured rather than read off the text. Everything that is not an integer at all is
 * refused, floats included; that half used to be spelled as the two float names, so a struct or a
 * string incremented quietly.
 */
void checkIncr(C c, Lvalue target, i32 line, i32 col) {
  checkWrite(c, target);
  checkLvalueExprs(c, target);
  string t = typeOfLvalue(c, target);
  // **Everything that is not an integer**, which this listed as the two floats. A `bool`, a string,
  // a struct, an enum, an array, a funcref and an `anyref` were all incrementable — seven of the
  // thirteen types a grid tries. Unsigned integers *are* fine despite the wording of the reference's
  // message, which is the part that has to be measured rather than read.
  // A `u8[]` element is an integer that happens to be stored narrow — `b[0]++` is ordinary — so the
  // packed names count here even though they cannot be written as a type anywhere useful.
  if (t != typeNone() && t != "" && !isIntegerName(t) && !isPackedName(t)) {
    c.report(errIncrType(), line, col);
  }
}

/**
 * A nullable packed type, which the language has nowhere to put.
 *
 * `u8?` is not a narrower `i32?`: unwrapping one has to yield a value, and no slot is one byte wide,
 * so there is no representation for the unwrapped case at all. Refused wherever the type is written,
 * and the array form `u8?[]` is the same fact one level down — an array of them would need the
 * element to exist.
 */
/**
 * A packed type written where it has no slot to live in.
 *
 * `checkParams` has said for a long time that a packed type "exists as an array element and nowhere
 * else", and enforced it for parameters. A local, a return type and a cast target are the other
 * three positions, and each was silent — a rule claimed in four places and implemented in one, which
 * a grid over the types by the positions is what found.
 *
 * An **array element** is the only position that is legal — not a struct field, which is refused
 * too, and which I had assumed was allowed until the grid said otherwise. So this asks about the
 * type as written rather than about anything inside it: `u8[]` is an array and fine anywhere, and
 * only a bare `u8` is wrong.
 */
void checkPackedHere(C c, string t, i32 line, i32 col) {
  if (isPackedName(t)) { c.report(errPackedPosition(), line, col); }
}

void checkPackedNullable(C c, string t, Ty at) {
  // **Every `[]`, not the outermost one.** `u8?[][]` is an array of arrays of a nullable packed
  // type, and stripping one suffix left `u8?[]`, which is not itself packed. `spec/cases/0070`.
  string inner = t;
  for (i32 guard = 0; guard < 8; guard++) {
    if (!isArrayName(inner)) { break; }
    inner = dropLast(inner, 2);
  }
  string unwrapped = withoutNull(inner);
  if (unwrapped != "" && isPackedName(unwrapped)) {
    Ty base = baseTy(at);
    c.reportWith(errPackedNullable(), base.line, base.col, t + " has no room for the absent case");
  }
}

/**
 * The innermost type under any `[]` and `?` suffixes.
 *
 * Each suffix carries its own token position — the parser records where the `[` is, not where the
 * type it decorates begins — so a complaint about `u8?[]` reported at the `Ty` itself lands on the
 * bracket, three columns past where the reference puts it. Rung 2 learned this about parse errors;
 * this is the same fact reaching a different consumer.
 */
Ty baseTy(Ty t) {
  match (t.kind) {
    case Arr(elem): { return baseTy(elem); }
    case Nullable(inner): { return baseTy(inner); }
    else: { return t; }
  }
}

/**
 * The expressions buried inside an lvalue — the `i` in `a[i]`, and so on down the path.
 *
 * A write's target is walked for what it *is* (const, a string index) and, until the grid asked, not
 * at all for what is in it: `a[(p + q)]++` had a fault in a position nothing visited. Writing this
 * separately from `checkWrite` keeps the two questions apart, since one reports about the path and
 * the other about the expressions hanging off it.
 */
void checkLvalueExprs(C c, Lvalue lv) {
  match (lv.kind) {
    case LIndex(base, index): { checkLvalueExprs(c, base); checkExpr(c, index); }
    case LField(base, nameTok): { checkLvalueExprs(c, base); }
    case LUnwrap(base): { checkLvalueExprs(c, base); }
    else: { }
  }
}

/**
 * Whether anything in the file binds this name.
 *
 * Every binder wac has, in one place, because the undefined-name rule is only as good as this list:
 * a name it does not know about is a false diagnostic on working code rather than a missed case.
 * Locals, parameters, `this`, match bindings and imports live in the name table; functions, structs
 * and enums have tables of their own; and the primitive type names are bound by the language rather
 * than by anything in the file — `string.fromBytes(b)` puts one in expression position.
 */
bool nameExists(C c, string n) {
  if (c.isDeclaredName(n)) { return true; }
  if (c.funcAt(n) >= 0 || c.isStruct(n) || c.isEnum(n)) { return true; }
  // `isPrimitiveName` already covers `string` and `bool`; naming them again here read as though it
  // did not, which is the same doubt `isValueType`'s comment exists to settle. `anyref` is the only
  // one it does not list.
  return isPrimitiveName(n) || n == "anyref";
}

/** Whether an expression is known not to be a boolean. Unknown is `false`: silence, as everywhere. */
/**
 * `expected <want>, found <got>` — the annotation `spec/spec/errors.md` asks for, phrased as the
 * reference phrases it.
 *
 * Empty when either side is a type this checker cannot name, because "expected i32, found unknown"
 * is worse than no annotation at all: it reads as a fact about the program when it is a fact about
 * the compiler.
 */
string expectedFound(string want, string got) {
  if (want == typeNone() || want == "" || got == typeNone() || got == "") { return ""; }
  return "expected " + want + ", found " + got;
}

/** What an expression is, for a diagnostic — a literal answers with the type it naturally has. */
string foundType(C c, Expr e) {
  i32 k = litFamily(c, e);
  if (k == litInteger()) { return "i32"; }
  if (k == litFloat()) { return "f64"; }
  if (k == litBool()) { return "bool"; }
  if (k == litString()) { return "string"; }
  return typeOfExpr(c, e);
}

bool notBool(C c, Expr e) {
  // **`litFamily`, so a compound literal is asked the same question.** `if (1)` was refused and
  // `if (1 + 1)` was not — an integer literal sum has no type of its own, so the fallback below saw
  // `typeNone()` and stayed quiet. The reference says *"condition must be bool"* for both.
  // `issues/lang/0248a`.
  i32 lit = litFamily(c, e);
  if (lit != litNone()) { return lit != litBool(); }
  string t = typeOfExpr(c, e);
  return t != typeNone() && t != "bool";
}

/**
 * What is being called, before anything about the arguments.
 *
 * Four answers, and only the first is a function: a **declared function**, a **local holding a
 * funcref**, a **local holding something else** — which is not callable at all — and a name that is
 * nothing, which is the undefined-name rule reaching call position. All three complaints land on the
 * call, which is the only thing there is to name.
 *
 * A call through a funcref is checked for arity and no further: the parameter *types* are in the
 * funcref's spelling and could be compared, but that needs the spelling taken apart again and the
 * corpus does not distinguish it.
 */
void checkCallee(C c, string name, Expr[] args, NamedArg[] named, Expr call) {
  // **The local of funcref type is asked about first, because that is the rule** —
  // `[§wac-param-shadows-func-5nkq2wp]`, "before any function". Asking `funcAt` first applied the rule
  // only when the shadowed function was *imported*, which is how `issues/lang/0143` left it: a
  // same-file function of the same name won, so `void run(fn[void(i32)] f)` calling `f(x)` beside a
  // module-level `f()` was refused for the module function's arity. It is the same defect 0143 names,
  // one lookup earlier.
  //
  // Only a funcref local shadows. A declared name of any other type falls through to the function, as
  // `i32 cert = cert(cli);` must — the rule has that condition and dropping it was the other half of
  // 0143.
  bool localFuncref = false;
  bool unnameableFn = false;
  i32 writtenArity = 0 - 1;
  if (c.isDeclaredName(name)) {
    string dty = c.typeOfName(name);
    localFuncref = dty != typeNone() && dty != "" && funcrefArity(dty) >= 0;
    // **A type this checker cannot name is not evidence that it is not a funcref.** `fn[U(T)] f` inside
    // a generic resolves to nothing, so asking only the resolved type answered *no* and the call fell
    // through to a module-level `f` — the same defect this order was written to fix, arriving through
    // the condition instead. The arity was recorded from the type as *written*, which needs no
    // resolution. `issues/lang/0145`.
    if (!localFuncref && (dty == typeNone() || dty == "")) {
      writtenArity = c.funcArityOf(name);
      unnameableFn = writtenArity >= 0;
    }
  }
  if (unnameableFn) {
    if (named.len() > 0) { c.report(errNotCallable(), call.line, call.col); return; }
    if (args.len() != writtenArity) { c.report(errCallArity(), call.line, call.col); }
    // The argument *types* live in the part that cannot be named, so they stay unasked.
    return;
  }
  if (!localFuncref && c.funcAt(name) >= 0) {
    // `f { x: 1 }` — the named-argument syntax belongs to struct construction and nothing else.
    if (named.len() > 0) { c.report(errNotCallable(), call.line, call.col); return; }
    checkCall(c, name, args, call);
    return;
  }
  if (c.isDeclaredName(name)) {
    string t = c.typeOfName(name);
    if (t == typeNone() || t == "") { return; }
    if (named.len() > 0) { c.report(errNotCallable(), call.line, call.col); return; }
    i32 arity = funcrefArity(t);
    if (arity < 0) {
      // **A local that is not a funcref does not take the call position.**
      // `[§wac-param-shadows-func-5nkq2wp]`: a bare name in call position resolves to a local or
      // parameter *of funcref type* before any function. So `i32 cert = cert(cli);` calls the
      // imported `cert`, and reporting the local's type here applied the rule with its condition
      // dropped. It only ever fired when the shadowed function was *imported*, because a same-file
      // one is found by `funcAt` above. `issues/lang/0143`.
      //
      // Still reported when the name is bound only once: `i32 x = 1; x()` with no `x` anywhere is
      // not callable and the reference says so too, so silence there would be a new disagreement in
      // the other direction rather than a fix.
      if (c.shadowsOuterName(name)) { return; }
      c.report(errNotCallable(), call.line, call.col);
      return;
    }
    // A **type parameter's** funcref says how many arguments it takes and nothing about what they
    // are, and inside a generic function even that is a substitution this checker does not perform.
    if (arity != args.len()) { c.report(errCallArity(), call.line, call.col); return; }
    checkFuncrefArgs(c, t, args, call.line);
    return;
  }
  if (c.isEnum(name) || isPrimitiveName(name) || name == "string" || name == "bool") { return; }
  c.report(errNotCallable(), call.line, call.col);
}

/**
 * How many parameters a funcref type takes, or -1 when the type is not one.
 *
 * Counted from the spelling — `fn(i32, f64) -> void` — because the spelling *is* the type here. An
 * empty parameter list is zero rather than one, which is the whole of the special case.
 */
i32 funcrefArity(string t) {
  if (!startsWithFn(t)) { return -1; }
  u8[] a = t.toBytes();
  i32 depth = 0;
  i32 n = 1;
  bool empty = true;
  for (i32 i = 3; i < a.len(); i++) {
    if (a[i] == 41 && depth == 0) { break; }
    if (a[i] == 40 || a[i] == 60) { depth = depth + 1; }
    else if (a[i] == 41 || a[i] == 62) { depth = depth - 1; }
    else if (a[i] == 44 && depth == 0) { n = n + 1; }
    if (a[i] != 32) { empty = false; }
  }
  return empty ? 0 : n;
}

/**
 * The `i`th parameter of a funcref type, from its spelling, or `""`.
 *
 * Split the way `funcrefArity` counts: on a comma at depth zero, so `fn(fn(i32, i32) -> i32, u8[])`
 * is two parameters rather than three. The spelling *is* the type here, which is why this can be
 * read off it at all.
 */
string funcrefParam(string t, i32 index) {
  if (!startsWithFn(t)) { return ""; }
  u8[] a = t.toBytes();
  i32 depth = 0;
  i32 n = 0;
  i32 from = 3;
  for (i32 i = 3; i < a.len(); i++) {
    if (a[i] == 41 && depth == 0) {
      if (n == index) { return trimmed(t, from, i); }
      return "";
    }
    if (a[i] == 40 || a[i] == 60) { depth = depth + 1; }
    else if (a[i] == 41 || a[i] == 62) { depth = depth - 1; }
    else if (a[i] == 44 && depth == 0) {
      if (n == index) { return trimmed(t, from, i); }
      n = n + 1;
      from = i + 1;
    }
  }
  return "";
}

/** `t[from..to)` without surrounding spaces. */
string trimmed(string t, i32 from, i32 to) {
  u8[] a = t.toBytes();
  i32 b = from;
  i32 e = to;
  while (b < e && a[b] == 32) { b = b + 1; }
  while (e > b && a[e - 1] == 32) { e = e - 1; }
  u8[] out = u8[e - b]();
  for (i32 i = 0; i < out.len(); i++) { out[i] = a[b + i]; }
  return string.fromBytes(out);
}

/**
 * A call through a funcref, argument by argument.
 *
 * **Only against a parameter this checker can name.** An unbound `T` inside a generic, or a
 * `Pending<T>`, is a spelling it cannot compare without performing a substitution it does not
 * perform — and a wrong complaint about correct code is worse than a missed one, so those are
 * skipped. What is left is the concrete case, which is the one that matters: every capability the
 * platform hands a program is a funcref field, so `cli.sendTo(handle, bytes, peer, port)` against
 * `fn(i32, string, i32, u8[])` went to nobody until the module refused to instantiate.
 */
void checkFuncrefArgs(C c, string held, Expr[] args, i32 callLine) {
  for (i32 i = 0; i < args.len(); i++) {
    string want = funcrefParam(held, i);
    if (want == "" || want == typeNone()) { continue; }
    if (!nameableType(c, want)) { continue; }
    // `callLine` is here only for `contextAt` — the same rule as `checkCall`'s, which is why it is one
    // method and not a condition written out per site. `issues/lang/0232a`.
    i32 before = c.errorCount;
    i32 lit = litFamily(c, args[i]);
    if (lit != litNone()) {
      reportLiteral(c, want, args[i], errArgumentMismatch(), args[i].line, args[i].col);
      c.contextAt(before, args[i].line, callLine);
      continue;
    }
    string got = typeOfExpr(c, args[i]);
    if (got == typeNone() || got == "") { continue; }
    if (nullableIntoNonNull(c, want, got)) {
      c.report(errNullableToNonNull(), args[i].line, args[i].col);
    } else if (!assignable(c, want, got)) {
      c.report(errArgumentMismatch(), args[i].line, args[i].col);
    }
    c.contextAt(before, args[i].line, callLine);
  }
}

/** Whether this checker can compare against a type by name, rather than only carry it around. */
bool nameableType(C c, string t) {
  if (isArrayName(t)) { return true; }
  return isPrimitiveName(t) || t == "string" || t == "bool" || c.isStruct(t) || c.isEnum(t);
}

/**
 * What a funcref answers — the `T` of `fn(i32) -> T` — or `""` when the type is not one.
 *
 * The arrow is the separator, and the one that matters is the one after the **parameter list's own
 * closing parenthesis** — found by depth, not by position. `fn(fn(i32) -> i32) -> bool` takes a
 * funcref and answers a bool, so splitting on the *first* arrow would have said `i32`.
 *
 * Taking the *last* one is wrong in the mirror case, which is what this used to do: a funcref that
 * answers a funcref, `fn(fn(i32) -> i32) -> fn(i32) -> i32`, has its final arrow inside its own
 * return type, and splitting there answered `i32` for something that hands back a function. Nothing
 * noticed while the only caller was a struct field, because no field in this repository holds one —
 * the generated sweep found it within a minute of a second caller existing.
 */
string funcrefReturn(string t) {
  if (!startsWithFn(t)) { return ""; }
  u8[] a = t.toBytes();
  // `fn(` opens the parameter list at index 2; the matching close is where the signature's own
  // arrow follows.
  i32 depth = 0;
  i32 close = -1;
  for (i32 i = 2; i < a.len(); i++) {
    if (a[i] == 40) { depth = depth + 1; }
    if (a[i] == 41) {
      depth = depth - 1;
      if (depth == 0) { close = i; break; }
    }
  }
  if (close < 0) { return ""; }
  i32 at = -1;
  if (close + 3 < a.len() && a[close + 1] == 32 && a[close + 2] == 45 && a[close + 3] == 62) {
    at = close + 4;
  }
  if (at < 0) { return ""; }
  string out = "";
  for (i32 i = at; i < a.len(); i++) {
    if (a[i] == 32 && out == "") { continue; }
    out = out + t[i];
  }
  return out;
}

/**
 * A lambda against the `fn[…]` the context wants — `design/lang/0002` tier two.
 *
 * **The target is the whole of its type.** A lambda writes its parameters and nothing else, so its
 * signature is only complete once something says what it is being used as. wac always does: there is
 * no `var`, so a lambda is written into an assignment, an argument or a `return`, and `c.expected`
 * carries that type down — the same channel a literal is checked through, for the same reason.
 *
 * The parameters are compared as one string rather than one at a time. A funcref has no variance
 * (`typeOfTy` says so where it builds the name), so two signatures agree exactly when they spell the
 * same, and one comparison reports arity and parameter types together in the words the rest of this
 * checker uses: *expected fn(i32) -> i32, found fn() -> i32*.
 */
void checkLambda(C c, string want, bool wantUnknown, Expr e, Param[] params, Stmt[] body) {
  // Nothing wanted a funcref here. A lambda has no type of its own to fall back on, so this is the
  // one shape that cannot be reported as a mismatch by the caller: `typeOfExpr` answers unknown for
  // a lambda, and unknown is assignable to everything, which is exactly how `i32 g = () => 42;` was
  // accepted before this function existed.
  if (!startsWithFn(want)) {
    // **Nothing could say what was wanted is not the same as nothing wanted one.** See
    // `C.expectedUnknown`: an argument to a call whose callee this file cannot see has no slot to be
    // wrong about, and reporting there invents a diagnostic about a program that compiles.
    if (wantUnknown) { return; }
    c.reportWith(errLambdaNoTarget(), e.line, e.col,
                 want == typeNone() ? "" : expectedFound(want, "a lambda"));
    return;
  }

  string ret = funcrefReturn(want);
  string got = "fn(";
  for (i32 i = 0; i < params.len(); i++) {
    string pt = typeOfTy(c, params[i].type);
    if (i > 0) { got = got + ", "; }
    got = got + pt;
  }
  got = got + ") -> " + ret;
  if (got != want) {
    c.reportWith(errLambdaSignature(), e.line, e.col, expectedFound(want, got));
    return;
  }

  // The body, with the parameters visible and `return` answering to the target's return type.
  //
  // Saved and restored rather than cleared: a lambda inside a lambda would otherwise leave the outer
  // one's returns checked against nothing when the inner one finished.
  string outer = c.lambdaReturn;
  c.lambdaReturn = ret;
  c.pushScope(body);
  for (i32 i = 0; i < params.len(); i++) {
    c.declareConst(tokenText(c, params[i].nameTok), typeOfTy(c, params[i].type), params[i].isConst);
    c.noteFuncArity(funcrefArityOfTy(c, params[i].type));
  }
  // **The locals, before the walk** — the same two passes a function body gets, and for the same
  // reason: a statement may name something declared further down. The enclosing function's
  // `declareAll` cannot do it, because a lambda is an *expression* and `declareStmt` walks
  // statements, so a lambda's body is the one place locals were never collected. Without this,
  // `() => { i32 x = 2; return x; }` reported *undefined name* at `x`.
  declareAll(c, body);
  for (i32 i = 0; i < body.len(); i++) { checkStmt(c, body[i], tyPrim(-1, e.line, e.col)); }
  // **A lambda owes its slot a value, which a plain function is already held to.** `export i32 f() {
  // }` is *not every path returns a value*; `fn[i32(i32)] g = (i32 a) => { };` was accepted, and the
  // failure arrived as `unreachable` at runtime, from a call site that looks fine. The rule is the
  // function's, applied to the return type the funcref names. `issues/lang/0170a`.
  //
  // `ret == ""` is a lambda in a slot this checker cannot name, where an empty answer means "not
  // known" rather than "returns nothing" — the same exemption every rule here takes.
  if (ret != "" && returnsAValue(ret) && !alwaysLeaves(body)) {
    c.report(errMissingReturn(), e.line, e.col);
  }
  c.popScope();
  c.lambdaReturn = outer;
}

/** A call's method name token, or -1 when the callee is not a member access. */
i32 calleeName(C c, Expr callee) {
  match (callee.kind) {
    case Member(obj, nameTok): { return nameTok; }
    else: { return -1; }
  }
}

/**
 * The type a *static* call is on — `Box.make(…)` — where the receiver is a type rather than a value.
 *
 * `typeOfExpr` answers nothing for the `Box` in `Box.make`, because it is a name that is not a
 * variable. A static is called on the type, so the name itself is the owner.
 */
string staticOwnerName(C c, Expr obj) {
  match (obj.kind) {
    case Ident(tok): {
      string n = c.canon(c.renamed(tokenText(c, tok)));
      return c.isStruct(n) || c.isEnum(n) ? n : "";
    }
    else: { return ""; }
  }
}

/**
 * How many parameters a funcref spelling has, and the `i`th of them.
 *
 * The spelling is `fn(A, B) -> R`, so the parameters are what sits between the first `(` and its
 * matching `)`, split on commas at depth zero — a parameter may itself be an `fn(…)` or a `Map<K, V>`,
 * and neither may be split through.
 */
i32 funcrefParamCount(string t) {
  string inside = funcrefParamText(t);
  if (inside == "") { return 0; }
  i32 n = 1;
  i32 depth = 0;
  u8[] a = inside.toBytes();
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] == 40 || a[i] == 60) { depth = depth + 1; }
    else if (a[i] == 41 || a[i] == 62) { depth = depth - 1; }
    else if (a[i] == 44 && depth == 0) { n = n + 1; }
  }
  return n;
}

string funcrefParamAt(string t, i32 at) {
  string inside = funcrefParamText(t);
  i32 n = 0;
  i32 depth = 0;
  i32 start = 0;
  u8[] a = inside.toBytes();
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] == 40 || a[i] == 60) { depth = depth + 1; }
    else if (a[i] == 41 || a[i] == 62) { depth = depth - 1; }
    else if (a[i] == 44 && depth == 0) {
      if (n == at) { return trimSpace(inside.slice(start, i)); }
      n = n + 1;
      start = i + 1;
    }
  }
  return n == at ? trimSpace(inside.slice(start, a.len())) : "";
}

/** What is between `fn(` and its matching `)`. */
string funcrefParamText(string t) {
  if (!startsWithFn(t)) { return ""; }
  u8[] a = t.toBytes();
  i32 depth = 0;
  for (i32 i = 2; i < a.len(); i++) {
    if (a[i] == 40) { depth = depth + 1; }
    if (a[i] == 41) {
      depth = depth - 1;
      if (depth == 0) { return i == 3 ? "" : t.slice(3, i); }
    }
  }
  return "";
}

/** `s` without leading or trailing spaces. */
string trimSpace(string s) {
  u8[] a = s.toBytes();
  i32 from = 0;
  i32 to = a.len();
  while (from < to && a[from] == 32) { from = from + 1; }
  while (to > from && a[to - 1] == 32) { to = to - 1; }
  return s.slice(from, to);
}

/** Whether a type name is a funcref, which this spells `fn(` and nothing else does. */
bool startsWithFn(string t) {
  u8[] a = t.toBytes();
  if (a.len() < 4) { return false; }
  return a[0] == 102 && a[1] == 110 && a[2] == 40;
}

/**
 * The arguments of a call against the parameters of what it calls.
 *
 * Only a plain named function declared in this file. A name that is not one — a struct being
 * constructed, an imported function, a generic — simply is not in the table, and `funcAt` answering
 * -1 is the silence that keeps this a subset.
 *
 * An arity mismatch is left alone too. The reference answers it with its own message — *"expected 2
 * argument(s), got 1"* — and pairing arguments with parameters positionally when the counts differ
 * would report the wrong ones anyway.
 */
/**
 * Whether a call to a generic function says what its type parameters are.
 *
 * Three ways it can fail and they are one rule: a parameter no argument's type mentions
 * (`T zero<T>()`), an argument whose type is not evident (`id(null)` — a null is not a value of
 * anything), and an argument whose shape cannot match the parameter's (`unbox(p)` where `p` is a `P`
 * and the parameter is `Box<T>`). All three end with a `T` nobody has bound, which is the thing to
 * report, and `bindTypeParams` already answers it — it binds what it can and says nothing about
 * what it cannot, so an unbound name after every argument means the call did not determine it.
 *
 * What this does **not** do is check each argument against its substituted parameter type. That
 * needs the substitution, and being wrong in the silent direction is the rule here.
 */
/**
 * A type **as written**, with the type parameters left standing: `Box<T>`, `T[]`, `T?`.
 *
 * `typeOfTy` answers `unknown` for all of these on purpose — `T` stands for whatever a call site
 * binds, so no question about it has an answer. But a *local* declared `Box<T> b` still needs a
 * spelling for one rule: a generic that instantiates itself with a type built out of its own
 * parameter never bottoms out, and unknown cannot tell `grow(b)` from `grow(a)`.
 */
string writtenTy(C c, Ty t) {
  match (t.kind) {
    case Prim(tok): { return tokenText(c, tok); }
    case Named(tok, typeArgs): {
      string base = c.canon(c.renamed(tokenText(c, tok)));
      if (typeArgs.len() == 0) { return base; }
      string out = base + "<";
      for (i32 i = 0; i < typeArgs.len(); i++) {
        if (i > 0) { out = out + ", "; }
        out = out + writtenTy(c, typeArgs[i]);
      }
      return out + ">";
    }
    case Arr(elem): { return writtenTy(c, elem) + "[]"; }
    case Nullable(inner): { return writtenTy(c, inner) + "?"; }
    else: { return ""; }
  }
}

/**
 * How many parameters a written funcref type takes, or -1 when it is not one.
 *
 * The **written** type, so a `fn[U(T)]` inside a generic answers 1 where `typeOfTy` answers unknown for
 * the whole thing. That is the only question the shadowing rule needs: whether a name in call position
 * is a funcref, and how many arguments it takes.
 */
i32 funcrefArityOfTy(C c, Ty t) {
  match (t.kind) {
    case Funcref(ret, params): { return params.len(); }
    else: { return 0 - 1; }
  }
}

/** Whether a written type is exactly one of the type parameters in scope. */
bool isActiveParam(C c, string t) {
  for (i32 i = 0; i < c.activeParamCount; i++) {
    if (c.activeParams[i] == t) { return true; }
  }
  return false;
}

/**
 * Whether a written type *mentions* a type parameter in scope — `Box<T>`, `T[]`, `T?`.
 *
 * A whole-name match: `Tree` does not mention `T`, which a substring search would say it does.
 */
bool mentionsActiveParam(C c, string t) {
  u8[] b = t.toBytes();
  for (i32 i = 0; i < c.activeParamCount; i++) {
    u8[] p = c.activeParams[i].toBytes();
    if (p.len() == 0) { continue; }
    for (i32 at = 0; at + p.len() <= b.len(); at++) {
      bool hit = true;
      for (i32 k = 0; k < p.len(); k++) {
        if (b[at + k] != p[k]) { hit = false; }
      }
      if (!hit) { continue; }
      bool beforeOk = at == 0 || !isNameByte(b[at - 1]);
      i32 after = at + p.len();
      bool afterOk = after >= b.len() || !isNameByte(b[after]);
      if (beforeOk && afterOk) { return true; }
    }
  }
  return false;
}

/** A byte a name may be spelled with, so a whole-name match knows where one ends. */
bool isNameByte(i32 b) {
  return (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95;
}

/** Whether an expression is a call made *through a funcref value* rather than to a named function. */
bool funcrefCall(C c, Expr e) {
  match (e.kind) {
    // `g(1)` where `g` is a local reaches here as a **`Construct`**, not a `Call`: `name(args)` is
    // ambiguous until something says whether `name` is a type, and the parser leaves that to the
    // checker. Both spellings are the same question here.
    case Construct(ctype, args, named): {
      match (ctype.kind) {
        case Named(tok, typeArgs): { return startsWithFn(c.typeOfName(tokenText(c, tok))); }
        else: { return false; }
      }
    }
    case Call(callee, args): {
      match (callee.kind) {
        case Ident(tok): { return startsWithFn(c.typeOfName(tokenText(c, tok))); }
        else: { return false; }
      }
    }
    else: { return false; }
  }
}

void checkGenericInference(C c, i32 at, string name, Expr[] args, Expr call) {
  i32 n = c.funcTypeParamCount[at];
  if (n == 0) { return; }
  string[] names = string[n]();
  string[] bound = string[n]();
  for (i32 i = 0; i < n; i++) {
    names[i] = c.funcTypeParamNames[c.funcTypeParamAt[at] + i];
    bound[i] = "";
  }
  for (i32 i = 0; i < args.len(); i++) {
    // **A literal does say what `T` is, here.** `pick(3, 9, true)` infers `i32` from the literals and
    // the language means it — `spec/tour.wac` says so and `genericCallReturn` passes `typeNone` for
    // one because *its* question is what the call returns, where a literal must not pin the answer.
    // Two questions, one argument, and the fourth time this session that "a literal has no type of
    // its own" has been the wrong half of the rule to reach for.
    // **A call through a funcref says nothing about `T`.** `id(g(1))` for `fn[i32(i32)] g` is a
    // compile error the spec spells out — *"a call through a funcref, whose return type is not read
    // here"* — and this checker could name the type, which is not the same as the language reading
    // it. Bound by nothing, so `T` reaches the unbound report below exactly as `null` does.
    // `spec/cases/0085`.
    if (funcrefCall(c, args[i])) { continue; }
    string got = foundType(c, args[i]);
    bindTypeParams(c, c.funcParamTypes[c.funcParamAt[at] + i], got, names, bound);
  }
  // **A funcref parameter is not judged.** `mapOption<T, U>(Option<T> o, fn[U(T)] f)` binds `U`
  // through the *shape* of a function type, and `bindTypeParams` decomposes arrays, nullables and
  // generic instances but not `fn(…) -> …`. Reporting an unbound `U` here refused
  // `core/test/option_test.wac`, which is correct code. Silence until the binder can
  // read a funcref, which is the direction to be wrong in.
  for (i32 i = 0; i < args.len(); i++) {
    if (startsWithFn(c.funcParamTypes[c.funcParamAt[at] + i])) { return; }
  }
  // **A generic that instantiates itself with a bigger type never bottoms out.** `i32 grow<T>(T a)
  // { Box<T> b = Box(a); return grow(b); }` asks for `grow<Box<T>>`, then `grow<Box<Box<T>>>`, and
  // no depth limit makes that finite. The binding is what says so: an ordinary recursion binds `T`
  // to `T` — a recursive sort calling itself on the same `T[]` is the commonest shape in the
  // language — and this one binds it to a type that *contains* `T`. `spec/cases/0086`.
  if (c.activeParamCount > 0 && name == c.activeFunc) {
    for (i32 t = 0; t < n; t++) {
      if (bound[t] == "" || isActiveParam(c, bound[t])) { continue; }
      if (!mentionsActiveParam(c, bound[t])) { continue; }
      c.reportWith(errCallArity(), call.line, call.col,
                   "instantiating " + name + " again with " + bound[t]);
      return;
    }
  }
  // **Inside a generic function nothing is evident.** `T twice<T>(T a) { return id(id(a)); }` calls
  // `id` with a value whose type *is* the enclosing `T`, which this checker holds as an unknown type
  // on purpose — so every argument looks inevident and every call looks uninferrable. The enclosing
  // parameters being active is exactly the condition, and it is the same silence the rest of this
  // file keeps about a type it cannot name.
  if (c.activeParamCount > 0) { return; }
  // **An argument this checker cannot name is its own limit, not the program's.** `id(true ? x : 0)`,
  // `id(s[1])` and `which(i32[2]())` are all inferrable and all answer `typeNone` here, and reporting
  // them refused three of the spec's own programs. A `null` is the one argument that is genuinely
  // evident *and* nameless — it is not a value of anything, which is why the spec refuses `id(null)`
  // and why that case survives this guard.
  for (i32 i = 0; i < args.len(); i++) {
    if (litKindOf(args[i]) == litNull()) { continue; }
    if (funcrefCall(c, args[i])) { continue; }
    if (foundType(c, args[i]) == typeNone()) { return; }
  }
  for (i32 t = 0; t < n; t++) {
    if (bound[t] != "") { continue; }
    c.reportWith(errCallArity(), call.line, call.col,
                 "nothing in the call says what " + names[t] + " is");
    return;
  }
}

void checkCall(C c, string name, Expr[] args, Expr call) {
  i32 at = c.funcAt(name);
  if (at < 0) { return; }
  // The count first, and it stops there: a call with the wrong number of arguments is one complaint
  // about the call, not one per argument that happened to line up with the wrong parameter.
  if (c.funcParamCount[at] != args.len()) {
    c.report(errCallArity(), call.line, call.col);
    return;
  }
  // Arity applies to a generic function; the *types* do not, until the parameters are bound. Binding
  // them is what this asks about — not whether each argument fits, which needs the substitution this
  // checker does not perform, but whether the call determines `T` at all.
  if (c.funcGenerics[at]) {
    checkGenericInference(c, at, name, args, call);
    return;
  }
  for (i32 i = 0; i < args.len(); i++) {
    string want = c.funcParamTypes[c.funcParamAt[at] + i];
    if (want == typeNone()) { continue; }
    // **An argument on a later line than the call opens on prints from the call line down.** Taken
    // before each report and applied after it, because `report` can decline and there is then no slot
    // — see `contextAt`. `issues/lang/0232a`.
    i32 before = c.errorCount;
    i32 lit = litFamily(c, args[i]);
    if (lit != litNone()) {
      reportLiteral(c, want, args[i], errArgumentMismatch(), args[i].line, args[i].col);
      c.contextAt(before, args[i].line, call.line);
      continue;
    }
    string got = typeOfExpr(c, args[i]);
    if (nullableIntoNonNull(c, want, got)) {
      c.report(errNullableToNonNull(), args[i].line, args[i].col);
    } else if (!assignable(c, want, got)) {
      c.report(errArgumentMismatch(), args[i].line, args[i].col);
    }
    c.contextAt(before, args[i].line, call.line);
  }
}

/**
 * A struct construction's arguments against the fields they fill.
 *
 * Positional only, and the arity has to match. Both restrictions are the reference's rather than
 * convenience: a wrong count is *"positional construction of 'P' expects 2 arguments"*, its own
 * family; and `P(x: 1)` is not named-argument syntax at all — the reference answers *"expects 2
 * arguments"* **and** *"undefined variable 'x'"*, so whatever that spelling means, it is not this.
 */
void checkConstruct(C c, string name, Expr[] args, NamedArg[] named, Expr at) {
  if (named.len() > 0) {
    // `Point { x: 1, z: 3 }` names its fields, so the two questions are whether every name is one the
    // struct has and whether every field the struct has was named. Both land on the construction.
    string tmpl = templateOf(name);
    if (!c.isStruct(tmpl) || c.isGeneric(tmpl)) { return; }
    for (i32 i = 0; i < named.len(); i++) {
      if (!c.hasField(tmpl, tokenText(c, named[i].nameTok))) {
        c.report(errNamedField(), at.line, at.col);
        return;
      }
    }
    // **A field may be left out when its type is nullable, and not otherwise.** The strict rule was
    // right about the danger — a construction that quietly defaults a field it forgot is a wrong
    // value with no diagnostic — and wrong about which fields have that danger: `string? note` says
    // *absent is one of the values*, and `null` is what absent means. A non-nullable field has no
    // such value, so leaving it out is still refused. `design/lang/0007`.
    for (i32 fi = 0; fi < c.fieldCount; fi++) {
      if (c.fieldOwners[fi] != tmpl) { continue; }
      if (withoutNull(c.fieldTypes[fi]) != "") { continue; }
      bool set = false;
      for (i32 i = 0; i < named.len(); i++) {
        if (tokenText(c, named[i].nameTok) == c.fieldNames[fi]) { set = true; }
      }
      if (!set) { c.report(errNamedField(), at.line, at.col); return; }
    }
    // **And each value against the field it fills**, which only the positional spelling asked about:
    // `P { x: "s", y: 1 }` was accepted where `P("s", 1)` was refused, and they are the same
    // construction written twice. Same loop, same codes, at the value — where the reference puts it.
    for (i32 i = 0; i < named.len(); i++) {
      string nwant = substituteType(c, name, c.fieldType(tmpl, tokenText(c, named[i].nameTok)));
      if (nwant == typeNone() || nwant == "") { continue; }
      if (litKindOf(named[i].value) != litNone()) {
        reportLiteral(c, nwant, named[i].value, errFieldMismatch(),
                      named[i].value.line, named[i].value.col);
        continue;
      }
      string ngot = typeOfExpr(c, named[i].value);
      // A nullable into a non-null field is its own complaint — `assignable` says yes to it by design,
      // so a slot that asks only `assignable` takes it silently. Both spellings, for the reason the
      // paragraph above gives: they are one construction written twice.
      if (nullableIntoNonNull(c, nwant, ngot)) {
        c.report(errNullableToNonNull(), named[i].value.line, named[i].value.col);
      } else if (ngot != typeNone() && ngot != "" && !assignable(c, nwant, ngot)) {
        c.reportWith(errFieldMismatch(), named[i].value.line, named[i].value.col,
                     expectedFound(nwant, ngot));
      }
    }
    return;
  }
  if (c.constructArity(name) != args.len()) { return; }
  for (i32 i = 0; i < args.len(); i++) {
    // Read in the instantiation's world: `Box<i32>(1)` wants an `i32` where the field says `T`, and
    // a bare `Box(1)` has nothing to substitute from, so `T` comes back unknown and says nothing.
    string want = substituteType(c, name, c.constructFieldAt(name, i));
    if (want == typeNone()) { continue; }
    i32 lit = litFamily(c, args[i]);
    if (lit != litNone()) {
      reportLiteral(c, want, args[i], errFieldMismatch(), args[i].line, args[i].col);
      continue;
    }
    string agot = typeOfExpr(c, args[i]);
    if (nullableIntoNonNull(c, want, agot)) {
      c.report(errNullableToNonNull(), args[i].line, args[i].col);
    } else if (!assignable(c, want, agot)) {
      c.report(errFieldMismatch(), args[i].line, args[i].col);
    }
  }
}

/**
 * The index question for one `[…]` node: is what is between the brackets an integer.
 *
 * Reported at the `LIndex` node, which is where the reference puts it — an lvalue is one node with one
 * position, and both index complaints land on it.
 */
void checkIndexType(C c, Lvalue lv, Expr index) {
  i32 wlit = litFamily(c, index);
  if (wlit != litNone()) {
    if (!acceptsLiteral("i32", wlit)) { c.report(errIndex(), lv.line, lv.col); }
  } else {
    string wit = typeOfExpr(c, index);
    if (wit != typeNone() && !isIntegerName(wit)) { c.report(errIndex(), lv.line, lv.col); }
  }
}

/**
 * The same question for every `[…]` *below* the top of a path.
 *
 * **`checkWrite` matches on the top node and asked nothing of the rest.** `a["s"]++` was reported and
 * `a["s"].v--` was silent, because the top node there is the field and its arm never went back down to
 * the index — the fourth or fifth time in this checker that a rule written for one node kind has been
 * silent one kind along. Every index in the path is asked exactly once: the top one by the arm that
 * owns it, the rest by this.
 */
void checkIndicesUnder(C c, Lvalue lv) {
  match (lv.kind) {
    case LIndex(base, index): {
      checkIndicesUnder(c, base);
      checkIndexType(c, lv, index);
    }
    case LField(base, nameTok): { checkIndicesUnder(c, base); }
    case LUnwrap(base): { checkIndicesUnder(c, base); }
    else: { }
  }
}

/**
 * Whether writing through this lvalue is refused, and why.
 *
 * Three answers because the reference gives three, and they are about different things: the binding
 * is const, the field is const, or the path to it goes through a const reference. A caller fixing one
 * would not fix the others.
 *
 * Reported at the **target**, which is where the reference puts all three.
 */
void checkWrite(C c, Lvalue lv) {
  match (lv.kind) {
    case LIdent(tok): {
      // A write to a name nothing declares. Reached here rather than by the expression rule, because
      // an assignment's target is an `Lvalue` and not an `Expr` — the same rule, one node kind along,
      // which is the fourth time that distinction has hidden a case.
      if (!nameExists(c, tokenText(c, tok))) {
        c.report(errUndefinedName(), lv.line, lv.col);
        return;
      }
      // Only when the declaration said `const`. A local that merely aliases something const may be
      // rebound — assigning to the name mutates nothing, and the alias rule is about writing through.
      if (c.isConstName(tokenText(c, tok)) && !c.isAliasOnlyName(tokenText(c, tok))) {
        c.reportWith(errConstVariable(), lv.line, lv.col, tokenText(c, tok) + " is const");
      }
    }
    case LField(base, nameTok): {
      Lvalue root = rootOf(lv);
      if (undefinedRoot(c, root)) { c.report(errUndefinedName(), root.line, root.col); return; }
      // `a["s"].v = 7` and `a["s"].v--`: the index is in the path rather than at the top of it.
      checkIndicesUnder(c, base);
      // The same two questions the expression form asks, in the position an `LField` node occupies —
      // the dot — rather than at the root, where the const complaints go. Writing to a field is not
      // a different question from reading one about whether the field is there.
      string ownerT = typeOfLvalue(c, base);
      if (ownerT != typeNone() && ownerT != "") {
        if (withoutNull(ownerT) != "") {
          c.report(errThroughNullable(), lv.line, lv.col);
          return;
        }
        string ownerTmpl = templateOf(ownerT);
        if (c.isStruct(ownerTmpl) && !c.isGeneric(ownerTmpl)) {
          if (!c.hasField(ownerT, tokenText(c, nameTok)) &&
              c.methodAt(ownerT, tokenText(c, nameTok)) < 0) {
            c.report(errNoSuchField(), lv.line, lv.col);
            return;
          }
        } else if (isPrimitiveName(ownerT) || ownerT == "bool") {
          c.report(errNoSuchField(), lv.line, lv.col);
          return;
        }
      }
      string owner = typeOfLvalue(c, base);
      if (owner != typeNone() && c.isConstField(owner, tokenText(c, nameTok))) {
        c.report(errConstField(), root.line, root.col);
        return;
      }
      // Otherwise the path itself may be const: a `const P p` refuses every write through it, field
      // by field, whatever those fields say about themselves.
      if (constPath(c, base)) {
        // At the root, with the caret over the whole path: `§wac-diag-const-w2jm5xf` states `span: 3`
        // for `p.x = 5;`, which is `p` through `x`.
        reportLvalueSpan(c, errConstReference(), root, lv, constNote(c, root));
      }
    }
    case LIndex(base, index): {
      string baseT = typeOfLvalue(c, base);
      if (baseT != typeNone() && baseT != "" && !isArrayName(baseT) && baseT != "string") {
        c.report(errNotIndexable(), lv.line, lv.col);
        return;
      }
      // Both index complaints land on the `LIndex` node — the bracket — where as an expression the
      // "not an array" one names the operand and the "bad index" one names the index. An lvalue is
      // one node with one position and the reference uses it for both.
      checkIndicesUnder(c, base);
      checkIndexType(c, lv, index);
      Lvalue idxRoot = rootOf(lv);
      if (undefinedRoot(c, idxRoot)) {
        c.report(errUndefinedName(), idxRoot.line, idxRoot.col);
        return;
      }
      // A string is not an array with a store: indexing one reads a byte and there is nowhere to put
      // one back. Reported at the index itself rather than at the root, which is where every other
      // complaint in this function goes — the immutability is the string's, not the path's.
      if (typeOfLvalue(c, base) == "string") {
        c.report(errStringIndexWrite(), lv.line, lv.col);
        return;
      }
      Lvalue r = rootOf(lv);
      if (constPath(c, base)) {
        reportLvalueSpan(c, errConstReference(), r, lv, constNote(c, r));
      }
    }
    case LUnwrap(base): { checkWrite(c, base); }
  }
}

/** Whether the root of a write path is a name nothing declares. */
bool undefinedRoot(C c, Lvalue root) {
  match (root.kind) {
    case LIdent(tok): { return !nameExists(c, tokenText(c, tok)); }
    else: { return false; }
  }
}

/**
 * The leftmost lvalue in a path — `p` in `p.a.b[0]`.
 *
 * Every const complaint is reported here, which is where the reference puts them: for `p.k = 1` it
 * names column 56, the `p`, and not 57, the field node. Reporting at the node that *is* const would
 * have been the obvious choice and is off by one against every compound target.
 */
/** `` `xs` is const `` when the root of the path is a plain name, and nothing when it is not. */
string constNote(C c, Lvalue root) {
  match (root.kind) {
    case LIdent(tok): { return tokenText(c, tok) + " is const"; }
    else: { return ""; }
  }
}

Lvalue rootOf(Lvalue lv) {
  match (lv.kind) {
    case LIdent(tok): { return lv; }
    case LField(base, nameTok): { return rootOf(base); }
    case LIndex(base, index): { return rootOf(base); }
    case LUnwrap(base): { return rootOf(base); }
  }
}

/**
 * Whether an lvalue names a const reference — a binding declared `const`, or a path through one.
 *
 * Distinct from `checkWrite`'s first case: assigning *to* `p` is a const-variable error, while
 * assigning to `p.x` through a const `p` is a const-reference one. Same constness, different
 * complaint, because one rebinds the name and the other reaches past it.
 */
/**
 * Whether an expression is a **const binding by name** — `c`, and not `c.field` or `this.items[i]`.
 *
 * The narrow question on purpose. A path *rooted* at something const is read all over this
 * repository — `out[i] = this.items[i]!` in `parse.wac` copies out of a `const this` and is
 * ordinary — and only the binding itself carries the constness the language tracks.
 */
bool constName(C c, Expr e) {
  match (e.kind) {
    case Ident(tok): {
      string n = tokenText(c, tok);
      return c.isConstName(n) || c.isAliasOnlyName(n);
    }
    else: { return false; }
  }
}

/** Whether a write target is reached *through* something — a field or an element, not a name. */
bool indirectLvalue(Lvalue lv) {
  match (lv.kind) {
    case LField(base, nameTok): { return true; }
    case LIndex(base, index): { return true; }
    case LUnwrap(base): { return indirectLvalue(base); }
    else: { return false; }
  }
}

bool constPath(C c, Lvalue lv) {
  match (lv.kind) {
    case LIdent(tok): { return c.isConstName(tokenText(c, tok)); }
    case LField(base, nameTok): { return constPath(c, base); }
    case LIndex(base, index): { return constPath(c, base); }
    case LUnwrap(base): { return constPath(c, base); }
  }
}

/** One array element or fill against the element type. */
void checkElement(C c, string want, Expr e) {
  i32 lit = litFamily(c, e);
  if (lit != litNone()) {
    reportLiteral(c, want, e, errArrayElement(), e.line, e.col);
    return;
  }
  string got = typeOfExpr(c, e);
  // **A nullable element is its own complaint, and this slot was not asking.** `assignable` answers
  // *true* for `P?` into `P` deliberately — see `nullableIntoNonNull`, which carries the reference's
  // own wording so that the two rules do not both fire at one position — so a slot that only asks
  // `assignable` accepts a nullable silently. `P[] v = P[](a);` and `P[1](fill: a)` for a `P? a` both
  // checked clean while `P r = a;` beside them was reported. Both spellings come through here, which
  // is why one branch fixes two positions.
  if (nullableIntoNonNull(c, want, got)) {
    c.report(errNullableToNonNull(), e.line, e.col);
  } else if (!assignable(c, want, got)) {
    c.report(errArrayElement(), e.line, e.col);
  }
}

/**
 * Whether an expression calls a function, which is what a module-level `const` may not do.
 *
 * A constant's value is computed before the program runs, so arithmetic on literals is fine and
 * `P(1)` is fine — a construction is a shape rather than a computation — while `n()` and `i32[n()]()`
 * are not. Phrased as "does this contain a call" rather than "is this constant" on purpose: the
 * second is the larger claim and the first is the one the corpus actually distinguishes, so this
 * says nothing about anything else.
 */
/**
 * Whether an initialiser reads a module-level constant that does not have a value yet.
 *
 * "Yet" is the file's own order: the ones before this declaration are settled and the rest are not,
 * which makes a self-reference and a cycle the same question asked at different distances. A name
 * that is not a module constant at all — a function, a struct, an enum — is somebody else's rule.
 */
bool readsUnsettledConst(C c, Program prog, Expr e, string[] settled, i32 settledCount) {
  match (e.kind) {
    case Ident(tok): {
      string n = tokenText(c, tok);
      if (!isModuleConst(c, prog, n)) { return false; }
      for (i32 i = 0; i < settledCount; i++) {
        if (settled[i] == n) { return false; }
      }
      return true;
    }
    case Binary(op, left, right): {
      return readsUnsettledConst(c, prog, left, settled, settledCount)
          || readsUnsettledConst(c, prog, right, settled, settledCount);
    }
    case Unary(op, operand): { return readsUnsettledConst(c, prog, operand, settled, settledCount); }
    case Construct(ctype, args, named): {
      for (i32 i = 0; i < args.len(); i++) {
        if (readsUnsettledConst(c, prog, args[i], settled, settledCount)) { return true; }
      }
      for (i32 i = 0; i < named.len(); i++) {
        if (readsUnsettledConst(c, prog, named[i].value, settled, settledCount)) { return true; }
      }
      return false;
    }
    case Call(callee, args): {
      for (i32 i = 0; i < args.len(); i++) {
        if (readsUnsettledConst(c, prog, args[i], settled, settledCount)) { return true; }
      }
      return false;
    }
    case ArrNew(elem, size, fill, elements): {
      for (i32 i = 0; i < elements.len(); i++) {
        if (readsUnsettledConst(c, prog, elements[i], settled, settledCount)) { return true; }
      }
      return false;
    }
    else: { return false; }
  }
}

/** Whether a name is one of this file's module-level constants. */
bool isModuleConst(C c, Program prog, string name) {
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case ConstDecl(nameTok, type, init, exported): {
        if (tokenText(c, nameTok) == name) { return true; }
      }
      else: { }
    }
  }
  return false;
}

bool callsAFunction(C c, Expr e) {
  match (e.kind) {
    case Construct(ctype, args, named): {
      match (ctype.kind) {
        case Named(tok, typeArgs): {
          if (c.funcAt(tokenText(c, tok)) >= 0) { return true; }
        }
        else: { }
      }
      for (i32 i = 0; i < args.len(); i++) {
        if (callsAFunction(c, args[i])) { return true; }
      }
      return false;
    }
    case Call(callee, args): {
      // **A variant construction is a value, not a call.** `const E X = E.A(7);` is a constant the
      // spec writes down — `variables.md` lists a struct, an enum variant, and anything built out of
      // them — and it parses as `Call(Member(E, A), …)` like everything else with parentheses. What
      // makes it a constant is that `struct.new` is a constant instruction; what made this rule
      // refuse it is that the shape looks like a call from the outside.
      match (callee.kind) {
        case Member(obj, nameTok): {
          match (obj.kind) {
            case Ident(tok): {
              string en = tokenText(c, tok);
              if (c.isEnum(en) && c.variantArityIn(en, tokenText(c, nameTok)) >= 0) {
                for (i32 i = 0; i < args.len(); i++) {
                  if (callsAFunction(c, args[i])) { return true; }
                }
                return false;
              }
            }
            else: { }
          }
        }
        else: { }
      }
      return true;
    }
    case Binary(op, left, right): { return callsAFunction(c, left) || callsAFunction(c, right); }
    case Unary(op, operand): { return callsAFunction(c, operand); }
    case ArrNew(elem, size, fill, elements): {
      if (!(size is null)) {
        if (callsAFunction(c, size!)) { return true; }
      }
      if (!(fill is null)) {
        if (callsAFunction(c, fill!)) { return true; }
      }
      for (i32 i = 0; i < elements.len(); i++) {
        if (callsAFunction(c, elements[i])) { return true; }
      }
      return false;
    }
    else: { return false; }
  }
}

/**
 * Whether an expression names something const, following field access.
 *
 * `this.inner.mutate()` inside a `const this` method is refused, and the constness has to travel
 * through the field access to see it — a receiver that is a plain name was all the first version
 * looked at, so every deep receiver came back non-const. Three spec cases are this shape.
 *
 * What it deliberately does not do is follow an *assignment*: `Counter c = this; c.mutate();` is also
 * refused by the reference, and knowing that needs to track where `c` came from, which is flow
 * analysis rather than a walk. That case stays uncaught, and uncaught is the safe direction.
 */
/** Is this type one a write can reach shared state through — a struct, an enum or an array? */
bool mutableRefName(C c, string t) {
  string at = endsWith(t, "?") ? t.slice(0, t.len() - 1) : t;
  return isArrayName(at) || c.isStruct(at) || c.isEnum(at);
}

/**
 * Can a value this expression produces be reached from anywhere the caller already holds?
 *
 * A construction is a new object, which is not enough on its own: `Box(this.i)` is a fresh `Box`
 * whose field is the receiver's, and writing through it writes through the const reference. So a
 * field that could hold a reference has to be built from something fresh in turn, while a field that
 * cannot — an `i32`, a `string` — is a copy and may be built from anything. That is what makes
 * `Counter(this.n)` fresh and `Box(this.i)` not [issue 0060].
 *
 * Everything else is not fresh, a nested call and a named construction included: a syntactic
 * question with a conservative default, not an escape analysis.
 */
bool freshValue(C c, Expr e) {
  match (e.kind) {
    case ArrNew(elem, size, fill, elements): {
      if (!mutableRefName(c, typeOfTy(c, elem))) { return true; }   // one copy per element
      for (i32 i = 0; i < elements.len(); i++) {
        if (!freshValue(c, elements[i])) { return false; }
      }
      if (fill is not null) { return freshValue(c, fill!); }
      return true;
    }
    case Construct(ctype, args, named): {
      if (named.len() > 0) { return false; }
      string t = typeOfTy(c, ctype);
      i32 n = c.constructArity(t);
      for (i32 i = 0; i < n && i < args.len(); i++) {
        if (!mutableRefName(c, c.constructFieldAt(t, i))) { continue; }   // a copy, whatever built it
        if (!freshValue(c, args[i])) { return false; }
      }
      return true;
    }
    else: { return false; }
  }
}

/**
 * Does every `return` in this body hand back something freshly built?
 *
 * A body with no `return` answers yes, which costs nothing: the question is only ever asked about a
 * call whose value is used, and a method that returns a value has a `return`.
 */
bool returnsOnlyFresh(C c, Stmt[] body) {
  for (i32 i = 0; i < body.len(); i++) {
    match (body[i].kind) {
      case Return(value): {
        if (value is not null) {
          if (!freshValue(c, value!)) { return false; }
        }
      }
      case If(cond, then, els): {
        if (!returnsOnlyFresh(c, then)) { return false; }
        if (!returnsOnlyFresh(c, els)) { return false; }
      }
      case While(wcond, wbody): { if (!returnsOnlyFresh(c, wbody)) { return false; } }
      case For(init, fcond, update, fbody): { if (!returnsOnlyFresh(c, fbody)) { return false; } }
      case DoWhile(dbody, dcond): { if (!returnsOnlyFresh(c, dbody)) { return false; } }
      case Block(bbody): { if (!returnsOnlyFresh(c, bbody)) { return false; } }
      case Switch(subject, cases): {
        for (i32 k = 0; k < cases.len(); k++) {
          if (!returnsOnlyFresh(c, cases[k].body)) { return false; }
        }
      }
      case Match(msubject, arms): {
        for (i32 k = 0; k < arms.len(); k++) {
          if (!returnsOnlyFresh(c, arms[k].body)) { return false; }
        }
      }
      else: { }
    }
  }
  return true;
}

bool constExpr(C c, Expr e) {
  match (e.kind) {
    case Ident(tok): { return c.isConstName(tokenText(c, tok)); }
    case Member(obj, nameTok): { return constExpr(c, obj); }
    case Index(arr, index): { return constExpr(c, arr); }
    case Unwrap(operand): { return constExpr(c, operand); }
    // What a method hands back through a const receiver is itself const. `this.getInner().mutate()`
    // inside a `const this` method is refused, and the accessor is the whole point of the case: it
    // looks like a way to launder the constness and is not one. The receiver decides, not the return
    // type — a method called on something const returns something const.
    case Call(callee, args): {
      match (callee.kind) {
        case Member(obj, nameTok): {
          if (!constExpr(c, obj)) { return false; }
          // …unless the method can only be handing back something it built out of copies, which
          // reaches nothing the receiver holds [issue 0060].
          i32 mi = c.methodAt(typeOfExpr(c, obj), tokenText(c, nameTok));
          if (mi < 0) { return true; }
          return !returnsOnlyFresh(c, c.methodBodyAt(mi));
        }
        else: { return false; }
      }
    }
    else: { return false; }
  }
}

/**
 * Whether a type can be produced out of nothing — `P p = P();` and `P[2]()` both ask this.
 *
 * Primitives have a zero, arrays and strings have an empty one, a nullable has null. A struct has a
 * default when every field does, so this recurses; an **enum has none at all**, even one whose every
 * variant is payload-free, because there is no variant the language would pick for you.
 *
 * `depth` is the cycle guard, and returning `false` at the bottom of it is not a fallback: a struct
 * that reaches itself through non-null fields genuinely has no default, since building one would
 * require building one first. That is the same fact the recursive-field rule reports, seen from the
 * construction rather than from the declaration.
 *
 * Unknown is `true` — silence, as everywhere else here. A type this pass cannot see is not a type it
 * gets to complain about.
 */
bool hasDefault(C c, string t, i32 depth) {
  if (t == typeNone() || t == "") { return true; }
  if (depth > 16) { return false; }
  if (isNullableName(t) || isArrayName(t)) { return true; }
  // A funcref has no zero: there is no function to point at until something points it somewhere.
  if (startsWithFn(t)) { return false; }
  if (c.isEnum(t)) { return false; }
  if (!c.isStruct(t) || c.isGeneric(t)) { return true; }
  for (i32 i = 0; i < c.fieldCount; i++) {
    if (c.fieldOwners[i] != t) { continue; }
    if (!hasDefault(c, c.fieldTypes[i], depth + 1)) { return false; }
  }
  string parent = c.parentOf(t);
  if (parent != "") { return hasDefault(c, parent, depth + 1); }
  return true;
}

/** Whether `from`'s non-null fields can reach `target`, which is what makes a reference recursive. */
bool reachesStruct(C c, string from, string target, i32 depth) {
  if (depth > 16 || !c.isStruct(from) || c.isGeneric(from)) { return false; }
  if (from == target) { return true; }
  for (i32 i = 0; i < c.fieldCount; i++) {
    if (c.fieldOwners[i] != from) { continue; }
    string ft = c.fieldTypes[i];
    if (isNullableName(ft) || isArrayName(ft)) { continue; }
    if (reachesStruct(c, ft, target, depth + 1)) { return true; }
  }
  return false;
}

/** How many fields a positional construction of this struct takes, parents included. */
/**
 * What `case List(xs)` binds `xs` to: the variant's `b`th payload field.
 *
 * Declared as unknown until now, which is safe and silent — and silence is what `xs.len(1)` got,
 * along with every other question about a payload. A variant is a struct here and its payload is
 * that struct's fields in order, so the answer is already in the table; nothing was asking for it.
 *
 * Unknown when the variant is not one this checker holds, which is the usual direction: a generic
 * enum's payload is written in its parameters, and a name that means nothing here means nothing.
 */
string armBindingType(C c, Expr subject, Arm arm, i32 b) {
  if (arm.variantTok < 0) { return typeNone(); }
  string variant = tokenText(c, arm.variantTok);
  // **A generic enum's variant is not a struct, and it is still a variant.** This used to require
  // `c.isStruct(variant)` and returned at the door for every generic enum: `declareModule` registers
  // a variant as a bare struct only when its enum takes no type parameters, because `Some` belongs to
  // `Option<i32>` and to every other instance and so names no type on its own (`spec/cases/0037`).
  // Its *fields* are declared either way, which is what this function actually reads — so the guard
  // was excluding the case it was capable of answering, and `isVariantName` is no use either because
  // that asks the same bare-name question.
  //
  // Nothing replaces it: the owners loop below already answers "is this a variant, and exactly one
  // enum's" and returns when it is not. The guard was an early-out that happened to be wrong.
  // **A binding belongs to the enum being matched, and this asked the file instead.**
  // `match (unzip(f))` on an imported `Unzipped { Ok(u8[] bytes) }`, in a file that also declares
  // `Object { Ok(i32 kind, …) }`, bound `raw` to the *local* `Ok`'s first payload and reported every
  // use of it — a false alarm about a name whose declaration is in another file. The owner guard
  // below could not see it: exactly one enum declares `Ok` as far as this slice knows, and it is the
  // wrong one. So the subject decides, and when the subject's type is unknown — which is what an
  // imported function's return is here — nothing about the binding is knowable.
  // `issues/lang/0096`, `spec/cases/0093`.
  string subjT = typeOfExpr(c, subject);
  if (subjT == typeNone() || subjT == "") { return typeNone(); }
  string subjCore = withoutNull(subjT);
  if (subjCore == "") { subjCore = subjT; }
  string subjOwner = enumOfSubject(c, subjCore, isVariantConstruction(c, subject));
  if (subjOwner == "" || !c.isEnum(subjOwner)) { return typeNone(); }
  // **The enum is what may be generic, not the variant.** `Opt<T> { Some(T v) }` registers `Some` as
  // an ordinary struct whose field is written `T`, so binding `v` to it says a working `case Some(v):
  // v` returns a `T` where an `i32` was declared. Six programs said so at once.
  //
  // And **only when one enum declares this variant**: the table is keyed by bare name, so `Ok` from
  // two enums is one struct holding both payloads, and a binding typed from it belongs to neither.
  i32 owners = 0;
  string owner = "";
  for (i32 i = 0; i < c.variantCount; i++) {
    if (c.variantNames[i] != variant) { continue; }
    owners = owners + 1;
    owner = c.variantOwners[i];
  }
  if (owners != 1) { return typeNone(); }
  // And the one that declares it has to be the one being matched. Two enums cannot both declare `Ok`
  // in one file — `spec/cases/0073` — so this fires when the other declarer is imported, where the
  // payload fields under that bare name are the *local* enum's and belong to neither.
  if (owner != subjOwner) { return typeNone(); }
  i32 n = 0;
  for (i32 i = 0; i < c.fieldCount; i++) {
    if (c.fieldOwners[i] != variant) { continue; }
    if (n == b) {
      // **A generic enum's payload is written as its parameter, and the subject says what that is.**
      // `Opt<T> { Some(T v) }` records the field as `T`, which names nothing on its own — so the
      // instantiation has to supply it. `substituteType` already reads the *enum* table for exactly
      // this (`spec/cases/0046`); it had simply never been reached from here.
      //
      // An unsubstituted `T` still fails `nameable`, so an enum with no instantiation to consult is
      // exactly as silent as it was.
      string ft = substituteType(c, subjCore, c.fieldTypes[i]);
      return nameable(c, ft) ? ft : typeNone();
    }
    n = n + 1;
  }
  return typeNone();
}

/**
 * Whether this checker can name the type at all — as opposed to holding a string that looks like one.
 *
 * `Opt<T> { Some(T v) }` records a field whose type is written `T`, and `T` is a *parameter*: an
 * enum's generic-ness cannot be asked of `isGeneric`, which reads the struct table and has no row for
 * an enum. Asking what the type is instead of who declared it answers both — a parameter is a name
 * nothing declares, and binding to it made a working `case Some(v): v` return the wrong type in six
 * programs.
 */
bool nameable(C c, string t) {
  string core = t;
  for (i32 guard = 0; guard < 8; guard++) {
    if (endsWith(core, "[]")) { core = dropLast(core, 2); }
    else if (endsWith(core, "?")) { core = dropLast(core, 1); }
    else { break; }
  }
  string base = genericBase(core);
  string at = base == "" ? core : base;
  return isPrimitiveName(at) || at == "string" || at == "bool" || startsWithFn(at) ||
         c.isStruct(at) || c.isEnum(at);
}

i32 fieldArity(C c, string t) {
  i32 n = 0;
  string at = t;
  for (i32 guard = 0; guard < 16; guard++) {
    if (at == "") { return n; }
    for (i32 i = 0; i < c.fieldCount; i++) {
      if (c.fieldOwners[i] == at) { n = n + 1; }
    }
    at = c.parentOf(at);
  }
  return n;
}

/**
 * Whether a type is held by reference, for the purposes of a cast.
 *
 * Wider than `isReferenceType`, which `anyref` asks: an enum and a funcref are references too, and a
 * nullable one is still one. Kept separate because the two questions have different answers for
 * `anyref` itself and there is no benefit to pretending otherwise.
 */
bool isCastRef(C c, string t) {
  string core = withoutNull(t);
  string at = core == "" ? t : core;
  if (at == "" || at == typeNone()) { return false; }
  return isArrayName(at) || at == "string" || at == "anyref" || startsWithFn(at) ||
         c.isEnum(at) || c.isStruct(at);
}

/**
 * Whether two types meet anywhere in the hierarchy — the ternary's rule.
 *
 * `spec/spec/control.md`: the type of a ternary over references is their *closest common ancestor*,
 * "found by walking each branch's chain of parent structs and taking the nearest struct that appears
 * in both chains". Only branches with **no** common ancestor are an error. Nullability is not part of
 * the question: `S?` and `Sub` meet at `S` whether or not either can be absent.
 */
bool shareAncestor(C c, string a, string b) {
  string ac = withoutNull(a) == "" ? a : withoutNull(a);
  string bc = withoutNull(b) == "" ? b : withoutNull(b);
  // **`anyref` is the top of the reference hierarchy**, so it shares an ancestor with every reference
  // and a cast to or from it is the documented way down: `spec/spec/casts.md` gives
  // `i31ref x = val as! i31ref;` in as many words. Walking the struct parent chain never reaches
  // `anyref` — nothing declares it as a parent — so this answered "no common ancestor" and warned that
  // a cast which succeeds always traps (`issues/lang/0152`). The reference does not warn.
  //
  // The condition is the one `assignable` already uses for an `anyref` slot, deliberately: `i31ref` or
  // a reference. A **primitive** shares nothing with `anyref`, so `anyref as! i32` keeps its complaint.
  if (ac == "anyref") { return bc == "i31ref" || isReferenceType(c, bc); }
  if (bc == "anyref") { return ac == "i31ref" || isReferenceType(c, ac); }
  // **Two variants of one enum are siblings**, in exactly the sense two structs with one parent are:
  // `y ? E.A(3) : E.B(4)` is an `E`, and each branch has its own variant's type. The parent chain
  // cannot say so — a variant is registered as a struct with no parent — so the enum that owns them
  // answers instead. `spec/cases/0093`'s neighbourhood.
  string ao = variantOwnerOf(c, ac);
  if (ao != "" && ao == variantOwnerOf(c, bc)) { return true; }
  if (ao != "" && (ao == bc || genericBase(bc) == ao)) { return true; }
  string bo = variantOwnerOf(c, bc);
  if (bo != "" && (bo == ac || genericBase(ac) == bo)) { return true; }
  string walk = ac;
  for (i32 guard = 0; guard < 16; guard++) {
    if (walk == "") { return false; }
    if (bc == walk || descendsFrom(c, bc, walk)) { return true; }
    walk = c.parentOf(walk);
  }
  return false;
}

/** The enum that declares this variant, or `""` — ambiguous when two enums do, so nobody's. */
string variantOwnerOf(C c, string name) {
  i32 owners = 0;
  string only = "";
  for (i32 i = 0; i < c.variantCount; i++) {
    if (c.variantNames[i] != name) { continue; }
    owners = owners + 1;
    only = c.variantOwners[i];
  }
  return owners == 1 ? only : "";
}

/** Whether `sub` inherits from `super`, which is what makes a cast between them a downcast. */
bool descendsFrom(C c, string sub, string sup) {
  // **From the template, because a use site spells a generic with its arguments.** `parentOf` matches
  // a declared name, so `Cont<string>` found no declaration and this answered false for a type that
  // plainly has a parent. `isStruct` next door already went through `templateOf` for exactly this
  // reason, with the note that "every rule that asks this question means the reference-type one" —
  // this was the neighbouring rule that had not.
  //
  // It was wrong in **both directions**, which is why it belongs here rather than at either caller.
  // In `assignable` it invented a diagnostic: `Task t = c` for a `Cont<string> c` was refused, and the
  // reference accepts, emits and runs it. In the cast rule it lost one: `c as! Task` is an upcast, the
  // reference says *"upcast to 'Task' is always safe — use 'as'"*, and wacc said nothing — while
  // catching the identical `k as! Base` for a plain `Kid`. One blind spot, a false alarm on one side of
  // it and a miss on the other.
  //
  // Only the *sub* side is unwrapped. A generic **ancestor** — `Cont<T> : Box<T>` — needs `T`
  // substituted along the chain before `Box<string>` and `Box<i32>` can be told apart, and the parent
  // is recorded as it was written, so the comparison below simply fails and both callers stay as they
  // were. Guessing there would trade a false alarm for a wrong answer.
  string at = c.parentOf(templateOf(sub));
  for (i32 guard = 0; guard < 16; guard++) {
    if (at == "") { return false; }
    if (at == sup) { return true; }
    at = c.parentOf(at);
  }
  return false;
}

/**
 * The builtin statics on the primitive types, and the one instance method with an arity worth checking.
 *
 * `f64.toBits`, `string.fromCodepoint` and their siblings are not declared anywhere. They are the
 * language's own surface, so no signature in the file describes them and the receiver is a type name
 * that is not a struct — which is exactly why they were invisible to every rule up to here, and why
 * they were the largest uncaught cluster once the struct rules were done. Eight spec cases.
 *
 * The surface, measured rather than guessed: each float pairs with the unsigned integer of its own
 * width, `toBits` takes the float and gives the bits and `fromBits` is the reverse; `string.fromBytes`
 * takes `u8[]`, `string.fromCodepoint` takes `i32`. Any other name on those three types has no static
 * method at all, rather than a wrong signature. Arity is reported at the call and an argument's type
 * at the argument, so the two are different positions and are kept as different codes.
 *
 * An argument is compared *exactly*, not by assignability — `f32.toBits(someF64)` is refused even
 * though an `f32` widens to an `f64`, because reinterpretation is about a width and not a value. A
 * literal is the one exception, and takes the parameter's type the way an initialiser does.
 *
 * Returns whether the receiver was a builtin, which is what stops the struct rules from also looking.
 */
bool checkBuiltinCall(C c, Expr call, Expr recvExpr, string recv, string name, Expr[] args) {
  string want = "";
  if (recv == "f64" || recv == "f32") {
    if (name != "toBits" && name != "fromBits") {
      c.reportWith(errNoStaticMethod(), call.line, call.col, "no " + recv + "." + name);
      return true;
    }
    if (name == "toBits") { want = recv; }
    else if (recv == "f64") { want = "u64"; }
    else { want = "u32"; }
  } else if (recv == "string") {
    if (name == "fromBytes") { want = "u8[]"; }
    else if (name == "fromCodepoint") { want = "i32"; }
    else {
      c.reportWith(errNoStaticMethod(), call.line, call.col, "no " + recv + "." + name);
      return true;
    }
  } else if (isIntegerType(recv) || isPackedName(recv) || recv == "bool") {
    // **An integer and a `bool` have no statics at all**, which is a fact and not a list: the surface
    // above is the whole of it. Falling through instead said nothing about `i32.fromBytes(bytes)` or
    // `bool.toBits(1e308)` — the receiver is a type name, so no local, struct or enum rule looks at it
    // either, and it was the one shape in this family nothing owned. The five bit methods are
    // *instance* methods on a value and are checked where a value receiver is.
    //
    // **At the receiver, not at the dot**, which is the other two branches' position and would be a
    // disagreement here. The reference has no static receiver for an integer at all, so `i32` there is
    // a name used as a *value* and it answers *undefined variable 'i32'* at the `i32`. Same place, our
    // own wording — the sweep compares where, and a reader is better served by a sentence about the
    // static than by one about a variable nobody wrote.
    c.reportWith(errNoStaticMethod(), recvExpr.line, recvExpr.col, "no " + recv + "." + name);
    return true;
  } else {
    return false;
  }
  if (args.len() != 1) {
    c.report(errBuiltinArity(), call.line, call.col);
    return true;
  }
  i32 lit = litFamily(c, args[0]);
  if (lit != litNone()) {
    reportLiteral(c, want, args[0], errBuiltinArg(), args[0].line, args[0].col);
    return true;
  }
  string got = typeOfExpr(c, args[0]);
  if (got != typeNone() && got != want) { c.report(errBuiltinArg(), args[0].line, args[0].col); }
  return true;
}

/** The funcref type of `S.make`, or unknown when the receiver is not a struct with that static. */
/**
 * `c.inc` — an **instance** method already bound to that object, as a value.
 *
 * The receiver-less signature: `i32 inc(this)` bound to a `Counter` is an `fn[i32()]`, which is the
 * whole point of the feature — a bound reference is interchangeable with every `fn[…]` a program
 * already passes around, so `Shell.askInterrupt`'s funcref-plus-context pair can collapse into one.
 *
 * `design/lang/0002`, tier one. The emitter has carried this since the pair representation landed: a
 * `fn[…]` value is `{funcref, env}`, and the bound wrapper casts the env to the receiver rather than
 * dropping it. What was missing was the language admitting the value.
 *
 * Generics stay out, as they do for a static: the instantiation is what this checker does not model,
 * and answering the template's own text would claim a type no instance has.
 */
string boundMethodType(C c, string recv, string name) {
  if (recv == "" || c.isGeneric(recv) || !c.isStruct(recv)) { return typeNone(); }
  i32 at = c.methodAt(recv, name);
  if (at < 0 || c.methodStatics[at]) { return typeNone(); }
  string out = "fn(";
  for (i32 i = 0; i < c.methodParamCount[at]; i++) {
    if (i > 0) { out = out + ", "; }
    out = out + c.methodParamTypes[c.methodParamAt[at] + i];
  }
  return out + ") -> " + c.methodReturns[at];
}

string staticMethodType(C c, Expr obj, string name) {
  string owner = "";
  match (obj.kind) {
    case Ident(tok): {
      string n = tokenText(c, tok);
      if (c.typeOfName(n) == typeNone() && c.isStruct(n)) { owner = n; }
    }
    else: { }
  }
  if (owner == "" || c.isGeneric(owner)) { return typeNone(); }
  i32 at = c.ownMethodAt(owner, name);
  if (at < 0 || !c.methodStatics[at]) { return typeNone(); }
  string out = "fn(";
  for (i32 i = 0; i < c.methodParamCount[at]; i++) {
    if (i > 0) { out = out + ", "; }
    out = out + c.methodParamTypes[c.methodParamAt[at] + i];
  }
  return out + ") -> " + c.methodReturns[at];
}

/**
 * The type a receiver denotes: the value's type, or the struct itself when the receiver names one.
 *
 * `p.m()` and `P.m()` are the same syntax and differ only in that, which the method-call rule already
 * knew and `typeOfExpr` did not.
 */
/**
 * What a static on a built-in type answers, or `""` for a name that is not one.
 *
 * **The closed surface `checkBuiltinCall` is written against, read the other way.** That function says
 * whether `string.fromCodepoint(2047)` is *allowed*; nothing said what it *is*, so the call had no type,
 * and every rule downstream of one went quiet — `string.fromCodepoint(2047).nope()` had no receiver to
 * be wrong about, and `("x" + string.fromCodepoint(1114111)).len()` returned from a `string` function
 * with nothing to compare. Two categories of the mutation sweep, one missing table.
 *
 * Kept beside `receiverType` because that is where a type-name receiver stops being a value.
 */
string builtinStaticReturn(string recv, string name) {
  if (recv == "string") {
    if (name == "fromBytes" || name == "fromCodepoint") { return "string"; }
    return "";
  }
  if (recv == "f64") {
    if (name == "toBits") { return "u64"; }
    if (name == "fromBits") { return "f64"; }
    return "";
  }
  if (recv == "f32") {
    if (name == "toBits") { return "u32"; }
    if (name == "fromBits") { return "f32"; }
    return "";
  }
  return "";
}

string receiverType(C c, Expr obj) {
  match (obj.kind) {
    case Ident(tok): {
      string n = tokenText(c, tok);
      string t = c.typeOfName(n);
      if (t != typeNone()) { return t; }
      if (c.isStruct(n)) { return n; }
      return typeNone();
    }
    // **A literal receiver has the type of its own family**, which is the third place this checker
    // has needed that: `"abc".len()` is a `string`'s builtin however the string was written, and
    // asking `typeOfExpr` about a literal answers unknown by design.
    else: { return naturalTypeOf(c, obj); }
  }
}

/**
 * Bind a generic function's type parameters by matching its written parameter against an actual type.
 *
 * `Box<T>` against `Box<f64>` binds `T` to `f64`; `T` against anything binds it to that; `T[]` against
 * `f64[]` looks one level down. Anything that does not line up binds nothing, which leaves the
 * parameter unbound and the return type unknown — silence, as everywhere.
 *
 * String against string, because in this checker a type *is* its canonical name and the written form
 * and the actual form are both one.
 */
void bindTypeParams(C c, string written, string actual, string[] names, string[] bound) {
  if (written == "" || actual == "" || written == typeNone() || actual == typeNone()) { return; }
  for (i32 i = 0; i < names.len(); i++) {
    if (names[i] == written) {
      if (bound[i] == "") { bound[i] = actual; }
      return;
    }
  }
  if (endsWith(written, "[]") && endsWith(actual, "[]")) {
    bindTypeParams(c, dropLast(written, 2), dropLast(actual, 2), names, bound);
    return;
  }
  if (endsWith(written, "?") && endsWith(actual, "?")) {
    bindTypeParams(c, dropLast(written, 1), dropLast(actual, 1), names, bound);
    return;
  }
  string wb = genericBase(written);
  if (wb == "" || wb != genericBase(actual)) { return; }
  string[] wargs = genericArgs(written);
  string[] aargs = genericArgs(actual);
  if (wargs.len() != aargs.len()) { return; }
  for (i32 i = 0; i < wargs.len(); i++) { bindTypeParams(c, wargs[i], aargs[i], names, bound); }
}

/** A written type with the bound parameters put in, or unknown when any of them is still open. */
string applyBindings(string written, string[] names, string[] bound) {
  string core = written;
  string suffix = "";
  for (i32 guard = 0; guard < 8; guard++) {
    if (endsWith(core, "[]")) { core = dropLast(core, 2); suffix = "[]" + suffix; }
    else if (endsWith(core, "?")) { core = dropLast(core, 1); suffix = "?" + suffix; }
    else { break; }
  }
  for (i32 i = 0; i < names.len(); i++) {
    if (names[i] != core) { continue; }
    if (bound[i] == "") { return typeNone(); }
    return bound[i] + suffix;
  }
  // **And inside an instantiation.** `Box<T> wrap<T>(T v)` returns a `Box<T>`, whose core is not a
  // parameter but a type *holding* one — so answering with the written text made `Box<i32> b =
  // wrap(x);` a mismatch against a type nobody wrote. `T` alone already worked, which is exactly why
  // it went unnoticed: the identity function is the case everybody tests.
  string base = genericBase(core);
  if (base != "") {
    string[] args = genericArgs(core);
    string out = base + "<";
    for (i32 i = 0; i < args.len(); i++) {
      string one = applyBindings(args[i], names, bound);
      if (one == typeNone()) { return typeNone(); }
      if (i > 0) { out = out + ", "; }
      out = out + one;
    }
    return out + ">" + suffix;
  }
  return written;
}

/**
 * The return type of a call to a generic function, with its type parameters inferred from the
 * arguments — or unknown when the arguments do not settle them.
 */
string genericCallReturn(C c, i32 at, Expr[] args) {
  i32 n = c.funcTypeParamCount[at];
  string[] names = string[n]();
  string[] bound = string[n]();
  for (i32 i = 0; i < n; i++) {
    names[i] = c.funcTypeParamNames[c.funcTypeParamAt[at] + i];
    bound[i] = "";
  }
  i32 count = c.funcParamCount[at];
  if (args.len() != count) { return typeNone(); }
  for (i32 i = 0; i < count; i++) {
    string got = litKindOf(args[i]) != litNone() ? typeNone() : typeOfExpr(c, args[i]);
    bindTypeParams(c, c.funcParamTypes[c.funcParamAt[at] + i], got, names, bound);
  }
  return applyBindings(c.funcReturns[at], names, bound);
}

/**
 * What the `i`th argument of a call or construction is required to be, or unknown.
 *
 * A struct's `i`th field or a function's `i`th parameter — the two shapes share the syntax, so this
 * asks which one the name is, exactly as the checking rules do one level up.
 */
string argumentSlot(C c, string name, string spelled, i32 i) {
  if (c.isStruct(name)) {
    if (c.isGeneric(name) && spelled == name) { return typeNone(); }
    return substituteType(c, spelled, c.constructFieldAt(spelled, i));
  }
  i32 at = c.funcAt(name);
  if (at < 0 || c.funcGenerics[at] || i >= c.funcParamCount[at]) { return typeNone(); }
  return c.funcParamTypes[c.funcParamAt[at] + i];
}

/**
 * The object of a member access or a method call, which is not quite an ordinary expression.
 *
 * `P.mk()` and `f64.toBits(x)` put a **type name** in receiver position, and a type name is not a
 * value — the struct-as-value rule would report every static call in the repo, which is exactly what
 * it did. A receiver that is a bare name denoting a type is therefore not walked as an expression at
 * all; anything else is.
 */
void checkReceiver(C c, Expr obj) {
  match (obj.kind) {
    case Ident(tok): {
      string n = tokenText(c, tok);
      // A local of that name shadows the type and is an ordinary value again.
      if (!c.isDeclaredName(n) && (c.isStruct(n) || c.isEnum(n) || isPrimitiveName(n) ||
          n == "string" || n == "bool")) {
        return;
      }
    }
    else: { }
  }
  checkExpr(c, obj);
}

/**
 * Reaching through a nullable without unwrapping it.
 *
 * `p.x` on a `P?` is refused even though `P` has an `x`: the value might not be there, and the
 * language wants that said with `!` rather than assumed. Its own diagnostic rather than a missing
 * field, because the field is not missing.
 */
void checkThroughNullable(C c, Expr at, Expr obj) {
  string t = typeOfExpr(c, obj);
  if (t == typeNone()) { return; }
  string inner = withoutNull(t);
  if (inner != "" && c.isStruct(inner)) { c.report(errThroughNullable(), at.line, at.col); }
}

/**
 * A field that the owner does not have — or that it could not have, being a primitive.
 *
 * Silent unless the owner is *known*: an unknown type has no fields to be missing. A name that is a
 * method rather than a field is not missing either, which is why the method table is consulted before
 * complaining — `c.get` without parentheses is the reference's own separate diagnostic.
 */
void checkMember(C c, Expr at, Expr obj, string name) {
  // **`E.nope` is a variant that is not there.** The object is a *type name* rather than a value, so
  // every rule below — which asks what the object's type is — had nothing to work with and stayed
  // silent. The variant table answers it directly, and answers it per enum: `Ok` belonging to some
  // other enum says nothing about this one, which is why the question is asked with both names.
  match (obj.kind) {
    case Ident(tok): {
      string en = tokenText(c, tok);
      if (c.isEnum(en) && c.typeOfName(en) == typeNone() && c.variantArityIn(en, name) < 0) {
        c.report(errNoVariant(), at.line, at.col);
        return;
      }
    }
    else: { }
  }
  // **A literal has fields as much as any other value of its type**, which is to say none: `7.n` is
  // *"type 'i32' has no field 'n'"*. Asking `typeOfExpr` answered unknown, as it does for every
  // literal by design, and this rule then had nothing to be about — the fifth place that has come
  // up, and the reason `naturalTypeOf` exists.
  string t = naturalTypeOf(c, obj);
  if (t == typeNone() || t == "") { return; }
  if (withoutNull(t) != "") { checkThroughNullable(c, at, obj); return; }
  // **A string and an array have members, and a short list of them.** This returned for both, so
  // `s.nope` on a string was silent where the reference says *"type 'string' has no field 'nope'"*.
  // The lists are `isArrayBuiltin` and `isStringBuiltin`, which `checkMethodCall` has used all along
  // — I wrote a third copy before finding them, which is the mistake this file has been full of
  // today in the other direction. They are also right: asking the reference about two dozen
  // plausible names (`push`, `at`, `trim`, `startsWith`…) turns up exactly these.
  //
  // A name that *is* on the list falls through to the method-as-value rule, because `s.len` without
  // the call is a different complaint from `s.nope`.
  if (isArrayName(t) || t == "string") {
    bool known = t == "string" ? isStringBuiltin(name) : isArrayBuiltin(name);
    if (!known) { c.report(errNoSuchField(), at.line, at.col); }
    return;
  }
  if (c.isStruct(t)) {
    // **A generic's own field set is known; only its type *arguments* are not.** This bailed out
    // before asking anything, so `T get(const this) { return this.nofield; }` inside a `Box<T>` was
    // silent — a name that is no field and no method of the template is wrong for every instantiation,
    // which is the same argument the constructor-arity rule makes one screen up. The bail moves below
    // the lookups rather than away: a template whose *parent* this file cannot see still answers
    // nothing, which is the direction to be wrong in.
    if (c.hasField(t, name)) { return; }
    if (c.isGeneric(t) && c.methodAt(templateOf(t), name) >= 0) { return; }
    // A method reached as a *value*. This function is only asked about members that are not the
    // callee of a call — the `Call` arm walks the object instead — so a method name arriving here is
    // one that was named without being called, which the language does not allow.
    // **An instance method named without being called is a value now** — `design/lang/0002` tier one,
    // decided 2026-08-15. It denotes the method bound to this receiver, an `fn[…]` of the
    // receiver-less signature, interchangeable with every other `fn[…]` a program passes around.
    //
    // A *static* reached through a value is still not one: `c.make` where `make` takes no `this` is
    // a function that has nothing to do with `c`, and naming it through an instance says something
    // the language does not mean. `S.make` is how a static is referenced and `staticMethodType`
    // types it.
    i32 mi = c.methodAt(t, name);
    if (mi >= 0) {
      if (c.methodStatics[mi]) { c.report(errMethodAsValue(), at.line, at.col); }
      return;
    }
    c.report(errNoSuchField(), at.line, at.col);
    return;
  }
  // An enum's value is one of its variants and the checker does not know which, so a payload field is
  // not reachable through the enum type — only through a variant, which `is` narrowing produces.
  // **Only when no variant has it.** A `case B:` arm makes `B`'s payload reachable through the
  // subject's own name — `case B: return e.x;` is accepted by the reference — and this checker does
  // not model that narrowing. Reporting every field on an enum therefore refused correct programs,
  // which is the one direction a subset checker may not be wrong in. A name no variant declares is
  // still wrong whichever arm you are in, and that is what is left.
  // A payload is reachable through the enum's own name **inside an arm that narrowed it**, which is
  // where `case B: return e.x;` gets its meaning — and the arm walk below retypes the subject for
  // exactly that reason. Outside one the enum has no such field, which the reference says too.
  if (c.isEnum(t)) { c.report(errNoSuchField(), at.line, at.col); return; }
  // A primitive has no fields at all. Its *statics* are reached through a type name rather than a
  // value, so this cannot be one of those — `f64.toBits` has an `Ident` for an object, not a value.
  //
  // **Nor does a funcref or an `anyref`**, and those fell off the end of this function: every branch
  // above is about a type that has *some* members, and the last one asked about primitives, so the
  // two references with none at all were the ones nothing was about.
  if (isPrimitiveName(t) || t == "bool" || startsWithFn(t) || t == "anyref" || t == "i31ref") {
    c.report(errNoSuchField(), at.line, at.col);
  }
}

/** An index expression: is the thing an array, and is the index one. */
void checkIndex(C c, Expr at, Expr arr, Expr index) {
  string t = typeOfExpr(c, arr);
  if (t != typeNone() && t != "" && !isArrayName(t) && t != "string") {
    // At the **operand**: it is the thing that is not an array. As an lvalue the same complaint lands
    // on the bracket instead, because that is where an `LIndex` node sits — two node kinds, two
    // positions, which is the second time this exact split has come up.
    //
    // And its own code, because `errIndex` says *"an index must be an integer"* — which denies
    // something `n[0]` plainly has. `issues/lang/0240a`.
    c.report(errNotIndexable(), arr.line, arr.col);
    return;
  }
  i32 lit = litFamily(c, index);
  if (lit != litNone()) {
    if (!acceptsLiteral("i32", lit)) { c.report(errIndex(), index.line, index.col); }
    return;
  }
  // **`i32`, not "some integer".** This asked `isIntegerName`, which is true of `i64`, `u32` and
  // `u64` too, so `xs[someI64]` compiled — while the literal path three lines up already spelled
  // `acceptsLiteral("i32", …)`. The two halves of one rule disagreed about what the rule was, and
  // the typed half was the lenient one, which is the direction that compiles and then means
  // something else. wasm's array instructions take an `i32`; the wider question was never this one.
  string it = typeOfExpr(c, index);
  if (it != typeNone() && it != "i32") { c.report(errIndex(), index.line, index.col); }
}

/**
 * A method call: does the struct have it, and may this receiver call it?
 *
 * Static and instance calls are the same syntax — `P.mk()` and `p.mk()` differ only in whether the
 * receiver names a struct or a value — so the receiver decides which question is asked. A local
 * shadowing a struct name is a value, which is why the scope is consulted first.
 *
 * Reported at the call, which is the receiver's own position and where the reference puts all three.
 */
/** Whether an expression is a bare identifier, which is the only receiver whose position is settled. */
bool isPlainName(Expr e) {
  match (e.kind) {
    case Ident(tok): { return true; }
    else: { return false; }
  }
}

/**
 * Whether a name is one of the builtins the language gives every array, or every string.
 *
 * **Read off `compiler/wacTypeCheck.ts` rather than guessed at**, which is the whole reason this rule
 * can exist: an earlier version of this checker declined to report a missing method on either,
 * saying the surface was larger than `len` and had not been measured. It is four names and three
 * names, and both lists are closed — so the measurement was one grep, and the comment outlived it.
 */
string builtinReturnType(string recv, string name) {
  if (isArrayName(recv) && name == "len") { return "i32"; }
  if (recv == "string") {
    if (name == "len") { return "i32"; }
    if (name == "indexOf") { return "i32"; }
    if (name == "slice") { return "string"; }
    if (name == "toBytes") { return "u8[]"; }
  }
  // **An integer's five answer in the receiver's own width**, which is what the instruction does:
  // `i64.clz` is `[i64] -> [i64]`, not `[i64] -> [i32]`. Stating it here rather than assuming `i32`
  // is what keeps `i64 n = x.leadingZeros()` from being a mismatch on one side or the other.
  if (isIntegerType(recv) && isIntBuiltin(name)) { return recv; }
  // `fill` and `copyFrom` are deliberately absent: they answer nothing, and an expression with no
  // type is what `typeNone` already means everywhere else here.
  return "";
}

/**
 * An offset or a length handed to a bulk builtin — a count, so an integer.
 *
 * A literal is asked whether the family fits, exactly as an index is; anything else is asked what it
 * is, and nothing is said about a type this checker cannot name.
 */
void checkCountArg(C c, Expr e) {
  // `litFamily` for the same reason: `slice(1, "x")` was refused and `slice(1, b ? "x" : "y")` was
  // not. `issues/lang/0248a`.
  i32 lit = litFamily(c, e);
  if (lit != litNone()) {
    if (!acceptsLiteral("i32", lit)) {
      c.reportWith(errBuiltinArg(), e.line, e.col, expectedFound("i32", foundType(c, e)));
    }
    return;
  }
  string t = typeOfExpr(c, e);
  if (t != typeNone() && t != "" && !isIntegerName(t)) {
    c.reportWith(errBuiltinArg(), e.line, e.col, expectedFound("i32", t));
  }
}

bool isArrayBuiltin(string name) {
  return name == "len" || name == "copyFrom" || name == "fill";
}

bool isStringBuiltin(string name) {
  return name == "len" || name == "slice" || name == "toBytes" || name == "indexOf";
}

/**
 * The five bit methods every integer has, which are five wasm instructions with no other spelling.
 *
 * `clz`, `ctz`, `popcnt`, `rotl` and `rotr` are MVP — every engine that can run a wac module has had
 * them since 2017 — and the language could not reach them, so `packages/zstd` writes a 32-iteration
 * loop for `highBit` in its FSE hot path and five crypto primitives each define their own `rotl`.
 * `issues/lang/0069`, whose shape this is: a **method**, so the width comes from the receiver with no
 * overloading, and so that the existing free functions named `rotl` keep working.
 */
bool isIntBuiltin(string name) {
  return name == "leadingZeros" || name == "trailingZeros" || name == "onesCount"
      || name == "rotateLeft" || name == "rotateRight";
}

/** How many arguments each takes: a rotation takes its count, the other three take nothing. */
i32 intBuiltinArity(string name) {
  return name == "rotateLeft" || name == "rotateRight" ? 1 : 0;
}

/** Whether a receiver is an integer, which is the one thing these five need of it. */
bool isIntegerType(string t) {
  return t == "i32" || t == "u32" || t == "i64" || t == "u64";
}

/**
 * The variant a call is constructing — `Wrap.W(…)` answers `W` — or `""` for anything else.
 *
 * Named by the variant rather than the enum because that is what the field table is keyed by: a
 * variant is a struct whose fields are its payload, which is how `case W(b)` finds `b` a type.
 */
string variantCalleeOwner(C c, Expr callee) {
  match (callee.kind) {
    case Member(obj, nameTok): {
      match (obj.kind) {
        case Ident(tok): {
          string en = tokenText(c, tok);
          string vn = tokenText(c, nameTok);
          if (c.isEnum(en) && c.variantArityIn(en, vn) >= 0) { return vn; }
          return "";
        }
        else: { return ""; }
      }
    }
    else: { return ""; }
  }
}

/**
 * A method call: what is being called, how many arguments it takes, and what types they are.
 *
 * `inst` is the instantiation the call's *result* lands in, or empty. It matters only for a generic
 * static — `Box.of`, called on the template, where nothing about the receiver says what `T` is and the
 * slot does. The caller has already computed it to give a lambda argument its target type.
 */
void checkMethodCall(C c, Expr call, Expr callee, Expr obj, string name, Expr[] args, string inst) {
  string recv = "";
  bool isStatic = false;
  match (obj.kind) {
    case Ident(tok): {
      string n = tokenText(c, tok);
      string ty = c.typeOfName(n);
      if (ty != typeNone()) {
        recv = ty;
      } else if (c.isStruct(n)) {
        recv = n;
        isStatic = true;
      } else if (c.isEnum(n)) {
        recv = n;
        isStatic = true;
      } else if (checkBuiltinCall(c, call, obj, n, name, args)) {
        // A primitive type name as the receiver — a builtin static. A local of that name would have
        // been found above, which is what keeps a variable called `string` a variable.
        return;
      }
    }
    else: {
      // **The same answer `receiverType` gives**, which this had grown its own version of: a string
      // literal was special-cased here and a *concatenation* of two was not, so
      // `("aaa, " + "bbb").toBytes(1)` had no receiver and no complaint. A literal takes its type
      // from context everywhere except here, where the receiver is the context — and that rule lives
      // in one function now rather than in two that disagree.
      recv = naturalTypeOf(c, obj);
      // **A generic enum's variant, used as a receiver.** `Maybe.Just(4).orElse(0)` has nowhere to
      // take its instantiation from: inference works from the expected type, and a receiver is the
      // one position with none. The checker used to say nothing at all and the *emitter* declined it
      // with `unresolved name Maybe` — a diagnostic from the wrong phase, naming a type that is
      // perfectly well defined. `issues/lang/0088`.
      // Not `recv == typeNone()`: a variant *with* a payload answers the template's own name here,
      // which is a type no instance has. What both spellings share is that the answer is not an
      // instantiation, and an instantiation is what a method call needs.
      if (genericBase(recv) == "" && genericVariantConstruction(c, obj)) {
        c.reportWith(errGenericVariantSlot(), obj.line, obj.col,
                     "a generic enum's variant takes its type arguments from the expected type, " +
                     "and a receiver has none — assign it to a declared local first");
      }
    }
  }
  // **The two closed surfaces.** An array has three methods and a string four, and a name that is
  // not one of them is a missing method however the receiver was written — which is what makes this
  // reportable at last: the rule needed the list, and the list is in the compiler this is measured
  // against. A *nullable* receiver is somebody else's diagnostic ("unwrap with '!'") and is not
  // named here, which is why the test is against the array's own spelling rather than against
  // "contains a bracket".
  if (isArrayName(recv) && !isArrayBuiltin(name)) {
    c.report(errNoMethod(), callee.line, callee.col);
    return;
  }
  if (recv == "string" && !isStringBuiltin(name)) {
    c.report(errNoMethod(), callee.line, callee.col);
    return;
  }
  // **A variant construction is a call with an arity.** `E.C(1, 0)` reaches here spelled like a
  // static — the enum names the variant — and the count is the variant's own, asked for with both
  // names so that two enums sharing a variant name answer separately. Asking the struct table
  // instead said "two" for an `Ok` that two enums declare, and reported a correct program.
  // **`!isGeneric(recv)` used to be here and was dead**: `isGeneric` walked the struct table only,
  // so it answered *no* for every enum and this arm ran for all of them. Widening `isGeneric` to know
  // about enums made it live, and live it turns the check off for exactly the enums that had it —
  // `Maybe.Just(1, 2)` became accepted. The clause is gone rather than repaired, because what it was
  // there to exclude, a generic *struct*, `isEnum` already excludes. `issues/lang/0088`.
  if (isStatic && c.isEnum(recv)) {
    i32 wantArgs = c.variantArityIn(recv, name);
    if (wantArgs >= 0 && args.len() != wantArgs) {
      c.report(errCallArity(), call.line, call.col);
      return;
    }
    // **And the payload's types**, which nothing asked about: `E.B("s")` for a `B(i32 x)` was accepted
    // while `B("s")` as a positional struct construction was refused, and a variant *is* a struct
    // holding its payload. The fields are registered under the variant's own name, which is what
    // `c.expected` is already computed from a few lines up in the caller, for a lambda's target type.
    //
    // Only where the letters can be bound: a generic enum's payload is written in the enum's
    // parameters, so without an instantiation from the slot `Some(T v)` would be compared against `T`
    // and every correct call would be reported.
    bool payloadKnown = wantArgs > 0 && (inst != "" || !c.isGeneric(recv));
    if (payloadKnown) {
      string world = inst == "" ? recv : inst;
      for (i32 i = 0; i < args.len(); i++) {
        string vwant = substituteType(c, world, c.fieldTypeAtIndex(name, i));
        if (vwant == typeNone() || vwant == "") { continue; }
        if (litFamily(c, args[i]) != litNone()) {
          reportLiteral(c, vwant, args[i], errFieldMismatch(), args[i].line, args[i].col);
          continue;
        }
        string vgot = typeOfExpr(c, args[i]);
        // **A variant's payload is a slot like any other, and it was not asking.** `assignable`
        // answers *true* for `P?` into `P` by design — `nullableIntoNonNull` carries the reference's
        // own wording so the two rules do not both fire at one position — so a slot that asks only
        // `assignable` takes a nullable silently. `E.Some(a)` for a `P? a` and a payload declared `P`
        // checked clean, while `E.Some(1)` and a wrong struct beside it were both reported, which is
        // what made it look covered.
        //
        // **Found by enumerating the sites rather than the programs.** Grepping every `!assignable(c,`
        // in this file and asking which had `nullableIntoNonNull` within six lines found nine that did
        // and eight that did not; this was the one of those eight with a program to prove it. The
        // others were a JSX attribute and a component field, an `is`-test pair, a builtin's argument
        // against its receiver, and `copyFrom`/`fill`'s element.
        //
        // **Two of those are settled now, and the way they were settled is the lesson.** The first
        // probes for `copyFrom` and `fill` were refused for *arity* by both compilers, which reads
        // exactly like "no gap here" — they had guessed the signature. `spec/spec/arrays.md` has
        // `dst.fill(value, start, end)` and `dst.copyFrom(src, srcStart, dstStart, count)`; with the
        // right shapes, `fill`'s value was a gap and is fixed beside `errBuiltinArg`, and `copyFrom`
        // already reported. So one leaked and one did not, which no invalid probe could have told
        // apart.
        //
        // **The list is closed now: eight sites, five real gaps.** This payload, `fill`'s value, a
        // component's field, a JSX attribute and a JSX child. `copyFrom` and a builtin's argument
        // against its receiver already reported, and the `is`-test pair is a warning about unrelated
        // types rather than a slot a value passes through. Recall on the generated sweep never moved
        // through any of it, because `generate.ts` builds none of these shapes — which is the whole
        // argument for enumerating the *sites* and not the programs.
        if (nullableIntoNonNull(c, vwant, vgot)) {
          c.report(errNullableToNonNull(), args[i].line, args[i].col);
        } else if (vgot != typeNone() && vgot != "" && !assignable(c, vwant, vgot)) {
          c.reportWith(errFieldMismatch(), args[i].line, args[i].col, expectedFound(vwant, vgot));
        }
      }
    }
    return;
  }
  // `"hi".toBytes()` is a method on a string value, not a static, and takes no arguments.
  if (recv == "string" && name == "toBytes") {
    if (args.len() != 0) { c.report(errBuiltinArity(), call.line, call.col); }
    return;
  }
  // **The two string builtins that take arguments**, and the two whose arity nothing asked about —
  // every instance of that family in the mutation sweep was missed, `"hello".slice(1)` among them.
  // The rules are the reference's: `slice(start, end)` is exactly two `i32`s and `indexOf(needle)`
  // exactly one `string`. Arity at the call, types at the argument, which is where it puts them.
  if (recv == "string" && name == "slice") {
    if (args.len() != 2) { c.report(errBuiltinArity(), call.line, call.col); return; }
    for (i32 i = 0; i < args.len(); i++) { checkCountArg(c, args[i]); }
    return;
  }
  if (recv == "string" && name == "indexOf") {
    if (args.len() != 1) { c.report(errBuiltinArity(), call.line, call.col); return; }
    if (litFamily(c, args[0]) != litNone()) {
      reportLiteral(c, "string", args[0], errBuiltinArg(), args[0].line, args[0].col);
      return;
    }
    string needleT = typeOfExpr(c, args[0]);
    if (needleT != typeNone() && needleT != "" && needleT != "string") {
      c.reportWith(errBuiltinArg(), args[0].line, args[0].col, expectedFound("string", needleT));
    }
    return;
  }
  // **The integer bit methods.** Signedness is irrelevant to all five and the opcode is chosen by
  // width alone, so `i32`/`u32` and `i64`/`u64` get the same five; the result and a rotation's count
  // are the receiver's own type, which is what makes `x.rotateLeft(1)` need no inference.
  if (isIntegerType(recv) && isIntBuiltin(name)) {
    i32 wantArgs = intBuiltinArity(name);
    if (args.len() != wantArgs) {
      c.report(errBuiltinArity(), call.line, call.col);
      return;
    }
    for (i32 i = 0; i < args.len(); i++) {
      if (litFamily(c, args[i]) != litNone()) {
        reportLiteral(c, recv, args[i], errBuiltinArg(), args[i].line, args[i].col);
        continue;
      }
      string got = typeOfExpr(c, args[i]);
      if (got != typeNone() && !assignable(c, recv, got)) {
        c.reportWith(errBuiltinArg(), args[i].line, args[i].col, expectedFound(recv, got));
      }
    }
    return;
  }
  // An integer has those five and nothing else, which is worth saying by name rather than letting
  // the struct rules look for a method on an `i32`.
  if (isIntegerType(recv) && !isIntBuiltin(name)) {
    c.reportWith(errNoMethod(), callee.line, callee.col, "no " + recv + "." + name);
    return;
  }
  // `len()` is the one method an array and a string share, and it takes nothing.
  if ((isArrayName(recv) || recv == "string") && name == "len") {
    if (args.len() != 0) { c.report(errBuiltinArity(), call.line, call.col); }
    return;
  }
  // **The bulk pair.** `copyFrom(src, srcStart, dstStart, count)` moves elements between two arrays,
  // so the source is an array holding the same kind; `fill(value, start, count)` writes one value
  // across a range. Both were listed as builtins and neither was checked, which is six of the spec's
  // own programs — `spec/cases/0030` through `0035`.
  if (isArrayName(recv) && name == "copyFrom") {
    if (args.len() != 4) {
      c.report(errBuiltinArity(), call.line, call.col);
      return;
    }
    // **A literal has no type of its own**, so `typeOfExpr` answers nothing for `copyFrom(5, …)` and
    // the guard below would let it past. `foundType` gives a literal the type it naturally has,
    // which is the whole of what makes `5` not an array.
    string srcT = foundType(c, args[0]);
    if (srcT != typeNone() && srcT != "" && srcT != recv) {
      c.reportWith(errBuiltinArg(), args[0].line, args[0].col, expectedFound(recv, srcT));
    }
    for (i32 i = 1; i < args.len(); i++) { checkCountArg(c, args[i]); }
    return;
  }
  if (isArrayName(recv) && name == "fill") {
    if (args.len() != 3) {
      c.report(errBuiltinArity(), call.line, call.col);
      return;
    }
    // **A packed element widens to `i32` on the way out and takes one on the way in.** `u8[]` filled
    // from an `i32` is how `packages/zstd/src/block.wac` writes a run, and asking for a `u8` exactly
    // refused a working file — `spec/cases/0036`.
    string el = dropLast(recv, 2);
    if (isPackedName(el)) { el = "i32"; }
    if (litKindOf(args[0]) != litNone()) {
      reportLiteral(c, el, args[0], errBuiltinArg(), args[0].line, args[0].col);
    } else {
      string vt = typeOfExpr(c, args[0]);
      // A nullable into a non-null element is its own complaint here as everywhere: `assignable`
      // answers *true* for `P?` into `P` by design, so a slot that asks only `assignable` takes one in
      // silence. `xs.fill(a, 0, xs.len())` for a `P? a` checked clean while `copyFrom` beside it
      // reported. The reference says *'fill()' value must be P, got P?*.
      if (nullableIntoNonNull(c, el, vt)) {
        c.report(errNullableToNonNull(), args[0].line, args[0].col);
      } else if (vt != typeNone() && vt != "" && !assignable(c, el, vt)) {
        c.reportWith(errBuiltinArg(), args[0].line, args[0].col, expectedFound(el, vt));
      }
    }
    for (i32 i = 1; i < args.len(); i++) { checkCountArg(c, args[i]); }
    return;
  }
  // A method on something that has none. A primitive has no methods at all, and an array has only
  // the builtins — so a name that is not one of those is missing rather than unknown. Reported at the
  // **receiver**, which is where the reference puts this one: `x.toString()` names the `x`, unlike a
  // struct's missing method, which names the call.
  // **Numbers and booleans only.** An array's builtin surface is larger than `len` — `push`, `fill`,
  // `copy` and more — and a string's has `slice` in it, and this has measured neither, so calling an
  // unknown method on one missing reported 70 files and then 10. What is left is the half of the rule
  // that can be stated without the measurement: a number has no methods at all, which is a fact
  // rather than a list. `string` is in `isPrimitiveName` and has to be excluded by name, which is the
  // whole trap — the predicate is about how a type is *passed*, not about what it can do.
  if (isValueType(recv)) {
    // **At the callee**, which is the node the reference reports at — `errAt(ctx, …, callee.line,
    // callee.col)` — and rung 2 says this parser's node positions are the reference's. Reporting at
    // the *receiver* agreed with it for `n.len()` and missed by three columns for `xs[0].len()`,
    // which is what "the same node" fixes and what guessing at the dot would not have.
    c.report(errNoMethod(), callee.line, callee.col);
    return;
  }
  bool recvConst = !isStatic && constExpr(c, obj);
  // **An instantiation answers to its template here.** `cli.readFile(path)` is a
  // `Pending<FileResult>`, and the struct table holds `Pending` — so the gate below saw a name that
  // is not a struct and returned, which is why `.wait(1)` went unreported in three files. Everything
  // this function decides — is there such a method, how many arguments does it take, is the receiver
  // const — is the template's business and not the type arguments'. What *is* theirs is the return
  // type, and that is `typeOfExpr`'s question, asked elsewhere and still asked of the instance.
  // Kept before the rewrites below, because the argument types are the one question the *type
  // arguments* answer: `Box<i32>.set` takes an `i32` where the template says `T`.
  string recvInst = recv;
  string recvBase = genericBase(recv);
  // **An enum instantiation answers to its template too.** Only the struct case was mapped, so
  // everything below returned for an `Opt<i32>` — `o.nosuchmethod()` and `o.num(1, 2)` were both
  // silent, and so were the argument types. An enum's methods are recorded under the template name
  // exactly as a struct's are, which is what makes the same mapping the right one.
  if (recvBase != "" && !c.isStruct(recv) &&
      (c.isStruct(recvBase) || c.isEnum(recvBase))) { recv = recvBase; }
  // **A narrowed variant keeps its enum's methods.** `if (e is A) { e.val() }` retypes `e` to the
  // variant, and `val` belongs to the enum — the variant is a struct holding the payload and nothing
  // else. Looking the method up on the owner is what makes narrowing free rather than costly.
  if (c.isStruct(recv) && c.methodAt(recv, name) < 0) {
    for (i32 i = 0; i < c.variantCount; i++) {
      if (c.variantNames[i] != recv) { continue; }
      if (c.methodAt(c.variantOwners[i], name) >= 0) { recv = c.variantOwners[i]; }
    }
  }
  // **The receivers that fell out of every arm above.** This bailed for anything that is not a
  // struct, so an enum, a funcref and an `anyref` were the three kinds nothing was about — and the
  // reference answers *"struct 'E' has no method 'nope'"* for all of them. An enum's own methods are
  // recorded like a struct's, so the lookup is the same one; a funcref and an `anyref` have none at
  // all and need no lookup. Generics stay exempt for the reason spelled out below: an empty answer
  // there means "not modelled" rather than "not there".
  // **Including a generic one.** `!c.isGeneric(recv)` was here because a generic's members are not
  // modelled and an empty answer would mean "not modelled" rather than "not there" — true of a struct,
  // whose instantiations carry their own entries, and not of an enum: an enum's methods and variants are
  // recorded under the template name, so the table can say *no such method* about `Opt<i32>` with the
  // same confidence as about `Flag`. `o.nosuchmethod()` was silent.
  if (c.isEnum(recv) && c.methodAt(recv, name) < 0 &&
      c.variantArityIn(recv, name) < 0) {
    c.reportWith(errNoMethod(), callee.line, callee.col, "no " + recv + "." + name);
    return;
  }
  if (startsWithFn(recv) || recv == "anyref" || recv == "i31ref") {
    c.reportWith(errNoMethod(), callee.line, callee.col, "no " + recv + "." + name);
    return;
  }
  // **An enum gets this far too.** The gate was `isStruct` alone, so everything below — a missing
  // method, an arity, the argument types — stopped at an enum, generic or not. An enum's methods are in
  // the same table under the same kind of name; the arms below that are about *fields* and *parents*
  // simply find none.
  if (recv == typeNone() || recv == "" || !(c.isStruct(recv) || c.isEnum(recv))) { return; }
  // **A method with its own type parameters cannot be called yet** — see `errMethodTypeParams`. Said
  // here, before anything is checked against the method's declared types: those are written in a
  // letter nobody has bound, so every complaint downstream is about the wrong thing. The one that
  // actually came out was *"nothing here wants a function"* at a lambda that is fine.
  i32 tpAt = c.methodAt(genericBase(recv) == "" ? recv : genericBase(recv), name);
  if (tpAt >= 0 && tpAt < c.methodTypeParams.len() && c.methodTypeParams[tpAt]) {
    c.reportWith(errMethodTypeParams(), callee.line, callee.col, "no " + recv + "." + name +
                 " without its type arguments");
    return;
  }
  // A generic's methods are not recorded, so an empty answer here means "not modelled" rather than
  // "not there". Three files and a spec case said so: `this.hash(k)` inside `Map<K, V>` is an
  // ordinary call that this would otherwise call missing.
  //
  // **The count is recorded, though, and does not depend on the type arguments.** `Pending<T>.wait`
  // takes none whatever `T` is, so `.wait(1)` is wrong for every instantiation at once — which is
  // seven of the nine diagnostics this checker still missed on the repository's own code, all of
  // them a `Pending<…>` from the platform. Types stay unmodelled; arity does not need them.
  if (c.isGeneric(recv)) {
    i32 gm = c.methodAt(genericBase(recv) == "" ? recv : genericBase(recv), name);
    if (gm >= 0 && args.len() != c.methodParamCount[gm]) {
      c.report(errCallArity(), call.line, call.col);
      return;
    }
    // **And the types, when the slot says which instantiation this is.** `Box.of` is a static on the
    // *template* — the receiver is a bare name, so nothing about it binds `T` — and the wanted type of
    // the call does: `Box<i32> b = Box.of("no", …)` says `T` is `i32`. That is `issues/lang/0141`'s
    // rule, and it is already computed at the call site for the sake of a lambda argument's target
    // type: lambdas were being given a slot while every other argument went unchecked. `Pending.of` is
    // how every capability answer in this repository is built, so this is not a corner.
    //
    // Nothing without a slot: `inst` is empty when the call's result goes somewhere this checker cannot
    // name, and substituting in no world at all compares against the letter.
    if (gm >= 0 && inst != "") { checkMethodArgs(c, inst, gm, args, call.line); }
    return;
  }

  // A field can hold a funcref, and `sh.externalNames()` calls the field rather than a method of
  // that name. `packages/sh` has four of them. A name that is a field is not a missing method.
  //
  // **It still has an arity**, which is written in the field's own type: `fn(i32) -> bool` takes one
  // however it is reached. Returning here without asking made a call through a field the one call
  // shape this checker never counted — and `Cli`'s whole surface is fields.
  if (c.hasField(recv, name)) {
    string held = c.fieldType(recv, name);
    i32 heldArity = funcrefArity(held);
    if (heldArity >= 0 && args.len() != heldArity) {
      c.report(errCallArity(), call.line, call.col);
      return;
    }
    // And the argument *types*, which used to stop at the count. The reference reports both;
    // `issues/lang/0123` is what the gap cost.
    if (heldArity >= 0 && !c.isGeneric(recv)) { checkFuncrefArgs(c, held, args, call.line); }
    // **A field that is not a funcref cannot be called at all**, and this returned as if it could.
    //
    // The arm above exists because a field *may* hold a funcref — `sh.externalNames()` and the whole
    // of `Cli` — so a name that is a field is not a missing method. But `funcrefArity` answers < 0 for
    // an `i32` field, and both guards above are `heldArity >= 0`, so `p.foo()` on `struct P { i32
    // foo; }` fell out of the bottom with nothing said. The emitter then dropped the function
    // containing it and `wac build` exited 0. `issues/lang/0165`.
    //
    // A generic's fields are not modelled, so an empty answer there means "not known" rather than
    // "not callable" — the same exemption the arms above take.
    if (heldArity < 0 && !c.isGeneric(recv) && held != "" && held != typeNone()) {
      c.reportWith(errNotCallable(), callee.line, callee.col,
                   recv + "." + name + " is a field of type " + held + ", not a method");
    }
    return;
  }

  // Statics are looked up on the struct itself; instance methods inherit.
  i32 at = isStatic ? c.ownMethodAt(recv, name) : c.methodAt(recv, name);
  if (at < 0) {
    // **Where the reference puts this, which turned out to be a rule and not a guess.**
    //
    // It reports at the start of the receiver for `n.len()` and at the *dot* for `xs[0].len()`, and
    // this used to say that nothing here could tell which — so a receiver that was not a plain name
    // went unreported rather than reported in a place the reference never mentions. The sentence
    // naming the two cases *is* the discriminator, and measuring it settles which applies:
    //
    // | receiver | the reference's column |
    // | --- | --- |
    // | `j.nope()` | the start of `j` |
    // | `sh.j.nope()`, `arr[0].nope()`, `j.self().nope()`, `sh.m.j.nope()` | the dot before `nope` |
    //
    // A plain name keeps `call`'s own position, which is that start and already agreed. Everything
    // else reports at the dot, which is the token before the method's name — there is nothing
    // between them, so `nameTok - 1` is it.
    //
    // The oracle for the position is `corpusMutate`, which asserts that where the reference answers
    // with one diagnostic every position we report is that one, over 223 broken real files. A dot
    // computed wrongly fails there rather than passing quietly.
    if (!isPlainName(obj)) {
      i32 dotTok = -1;
      match (callee.kind) {
        case Member(mobj, mnameTok): { dotTok = mnameTok - 1; }
        else: { }
      }
      if (dotTok < 0) { return; }
      c.reportTok(isStatic ? errNoStaticMethod() : errNoMethod(), dotTok, "");
      return;
    }
    c.report(isStatic ? errNoStaticMethod() : errNoMethod(), call.line, call.col);
    return;
  }
  // A static call must name a static method, and an instance call must not. The reference words the
  // first as "has no static method", which is why a mismatch here is the same diagnostic as a
  // missing one rather than a fourth.
  // **`(C.inc)(c)` is the inline form of a method reference**, which `spec/tour.wac` documents two
  // lines above the code that needed it: an instance method named through its type is a value whose
  // first parameter is the receiver, and calling it there and then is the same call. It reads as a
  // static call and is not one, so the mismatch below has to let this shape through rather than
  // report the method missing.
  // The arity is still checked, and **counts the receiver**: `P.get()` passes none where the
  // unbound method takes one, which the reference reports as "expected 1 argument(s), got 0" rather
  // than as a missing static. That is the same arithmetic the emitter does when it puts the object
  // in front of the arguments.
  if (isStatic && !c.methodStatics[at]) {
    if (args.len() != c.methodParamCount[at] + 1) {
      c.report(errCallArity(), call.line, call.col);
    }
    return;
  }
  if (isStatic != c.methodStatics[at]) {
    c.report(isStatic ? errNoStaticMethod() : errNoMethod(), call.line, call.col);
    return;
  }
  if (!isStatic && recvConst && !c.methodConsts[at]) {
    c.report(errNonConstThroughConst(), call.line, call.col);
    return;
  }
  // **A method call has a count too**, and this checker had never asked: a plain function's arity is
  // checked, a variant construction's is, and `b.trim(1)` on a method taking none went through. The
  // receiver is not among the recorded parameters — it is `this` and belongs to the call rather than
  // the list — so the comparison is direct for both an instance call and a static one.
  //
  // Real code is where this showed up. Seventeen of twenty missed diagnostics in a mutation of the
  // repository's own packages were this shape, and none of the four thousand generated programs had
  // ever called a method with the wrong number of arguments.
  if (args.len() != c.methodParamCount[at]) {
    c.report(errCallArity(), call.line, call.col);
    return;
  }
  // **...and the argument types, which stopped at the count.** A plain function's arguments are
  // checked, a funcref field's are — `issues/lang/0123` — and a method's were not, so
  // `p.take(b)` with a `B` where an `A` is declared was accepted. Two one-field structs share a
  // wasm type, so it validated and ran, reading the wrong field: a type confusion with no
  // diagnostic anywhere. The reference answers *"expected A, found B"* and always did.
  //
  checkMethodArgs(c, recvInst, at, args, call.line);
}

/**
 * Each argument of a method call against the parameter it fills, read in `owner`'s world.
 *
 * `owner` is the instantiation the method belongs to — `Box<i32>` — and the parameter types are the
 * template's, written in its letters, so `set(this, T x)` wants an `i32` here. Comparing against the
 * letter itself reported six valid programs the first time this was written, which is why the
 * substitution is not optional.
 *
 * The same loop and the same silences as `checkCall`: an unnamed parameter type or an expression this
 * checker cannot type says nothing, because "expected A, found unknown" is a fact about the compiler
 * rather than about the program. `substituteType` answers unknown for a letter with nothing to bind
 * it, which is a generic's own body — where `T` means `T` and there is nothing to check it against.
 */
void checkMethodArgs(C c, string owner, i32 at, Expr[] args, i32 callLine) {
  for (i32 i = 0; i < args.len(); i++) {
    string mwant = substituteType(c, owner, c.methodParamTypes[c.methodParamAt[at] + i]);
    if (mwant == typeNone() || mwant == "") { continue; }
    i32 before = c.errorCount;
    if (litKindOf(args[i]) != litNone()) {
      reportLiteral(c, mwant, args[i], errArgumentMismatch(), args[i].line, args[i].col);
      c.contextAt(before, args[i].line, callLine);
      continue;
    }
    string mgot = typeOfExpr(c, args[i]);
    if (mgot == typeNone() || mgot == "") { continue; }
    if (nullableIntoNonNull(c, mwant, mgot)) {
      c.report(errNullableToNonNull(), args[i].line, args[i].col);
    } else if (!assignable(c, mwant, mgot)) {
      c.reportWith(errArgumentMismatch(), args[i].line, args[i].col, expectedFound(mwant, mgot));
    }
    c.contextAt(before, args[i].line, callLine);
  }
}

/**
 * Whether this cast used the operator the conversion takes.
 *
 * Four spellings, and the language treats them as a claim about what is happening rather than as
 * synonyms: `as` says nothing is lost, `as!` says the value is checked, `as~` says it is truncated,
 * `as@` says the bits are reinterpreted. Using the wrong one is *"lossy cast not needed"* or its
 * siblings — the reference's own family — and the point is that a reader can trust the spelling.
 *
 * Only conversions between two primitives this slice can name. A cast to or from a struct, an array
 * or a generic is a reference cast, which has its own rules and its own diagnostics.
 *
 * The **position differs by which complaint it is**, which no amount of reasoning would have
 * suggested and which took three corrections to get right:
 *
 *   - *"lossy cast not needed"* — a heavier operator on a conversion that loses nothing — names the
 *     **operand**. For `x as~ i64` it is the `x`, not the `as~` two columns later.
 *   - *"'i32' -> 'u32' is lossy — use 'as!', 'as~', or 'as@'"* names the **operator**, because it is
 *     advice about which operator to write.
 *   - *"no raw conversion for 'f64' -> 'f32'"* names the **operator** too.
 *
 * The one that names the operand is the one saying the cast should not be there at all; the two that
 * name the operator are saying this operator is the wrong one. That reads as a principle in
 * hindsight and was three separate contradictions from the spec corpus in practice.
 */
/**
 * What a cast's operand *is*, including when it is a literal.
 *
 * **A literal has a default type, and a cast's slot cannot give it one**: the slot here is the cast's
 * own target, so asking a literal what it is answered "nothing" and every cast on one went unchecked
 * — `1 as~ i32`, `1 as! i32` and `1.5 as~ f64` are each a lossy spelling where `as` would work, which
 * the reference refuses and this accepted (`issues/lang/0119`). A literal falls back to its own
 * notation: `f64` for a float, `i32` for an integer with a reading there and `i64` for one without,
 * which is what keeps `1000000000000 as@ i32` the legal truncation it is.
 *
 * One function because `checkCast` asked this in three places, and two of them had already been given
 * the answer the third was about to need.
 */
string castOperandType(C c, Expr operand) {
  i32 lit = litKindOf(operand);
  if (lit == litFloat()) { return "f64"; }
  if (lit == litInteger()) {
    return integerLiteralFits(c, "i32", operand, false) ? "i32" : "i64";
  }
  if (lit != litNone()) { return typeNone(); }
  return typeOfExpr(c, operand);
}

void checkCast(C c, Expr e, i32 op, Expr operand, Ty target) {
  string to = typeOfTy(c, target);
  // A cast down a struct hierarchy is the one cast that can *fail* rather than lose precision, so it
  // takes `as!` — the checked spelling — and plain `as` is refused. Upcasting is silent: a `Circle`
  // is a `Shape` with nothing to check. Reported at the operator, like every other wrong-spelling
  // complaint in this family.
  // A cast between two references, which is a different family from a numeric conversion: only `as`
  // and `as!` mean anything, and which of the two is right is decided by the direction. Upcasting is
  // always safe and takes `as`; downcasting can fail and takes `as!`; `as~` and `as@` are refused
  // outright, because truncating and reinterpreting are questions about a bit pattern and a reference
  // does not have one to talk about. All at the operator, like every other wrong-spelling complaint.
  string castFrom = castOperandType(c, operand);
  if (castFrom == typeNone() || castFrom == "" || to == typeNone() || to == "") { return; }
  // **A packed type is not castable, in either direction.** The rule below excluded packed types
  // from the crossing check, which reads as a carve-out for something legal — and the reference
  // refuses every one of them: `n as u8`, `a[0] as i32` where `a` is a `u8[]`, `s.v as i32` for a
  // packed field, and the same with `as~`. A packed value is read and widened where it sits; there
  // is no conversion to spell because there is no slot to put the result of one in.
  //
  // Reported at the operator, which is where the reference puts it and where every other
  // wrong-spelling complaint in this family goes.
  if (isPackedName(castFrom) || isPackedName(to)) {
    c.reportTok(errWrongCastOp(), op, "from " + castFrom + " to " + to);
    return;
  }
  bool fromRef = isCastRef(c, castFrom);
  bool toRef = isCastRef(c, to);
  i32 ck = tokenKind(c, op);
  // Crossing between the two worlds is never a conversion. `i32 as string` and `P as i32` are both
  // *"no valid cast"*, whichever spelling is used — a number and a reference have nothing in common
  // to convert. The one exception is `i31ref`, handled below, which exists precisely to cross.
  if (fromRef != toRef && castFrom != "i31ref" && to != "i31ref" &&
      (fromRef || isValueType(castFrom)) && (toRef || isValueType(to)) &&
      !isPackedName(castFrom) && !isPackedName(to)) {
    c.reportTok(errWrongCastOp(), op, "from " + castFrom + " to " + to);
    return;
  }
  // Two references. Only `as` and `as!` mean anything, and which is right depends on the direction:
  // upcasting — including a type to itself — is always safe and takes `as`, and everything else is
  // treated as a downcast that may fail and takes `as!`. `string as P` is a downcast by this rule
  // rather than an error of its own, which is measured: the reference words it *"downcast to 'P' may
  // fail"* even though a string will never be a `P`.
  if (fromRef && toRef && castFrom != "i31ref" && to != "i31ref") {
    // A funcref is a reference that converts to nothing but itself — there is no hierarchy of
    // function types here and nothing to check at runtime, so every spelling is refused.
    if (startsWithFn(castFrom) != startsWithFn(to) ||
        (startsWithFn(castFrom) && castFrom != to)) {
      c.reportTok(errWrongCastOp(), op, "from " + castFrom + " to " + to);
      return;
    }
    if (ck == kAsTilde() || ck == kAsAt()) {
      c.reportTok(errWrongCastOp(), op, "from " + castFrom + " to " + to);
      return;
    }
    // Two things have to widen for a cast to be the safe direction: the **type**, and the
    // **nullability**. `P as P?` adds the possibility of being absent and cannot fail; `P? as P`
    // takes it away and can; `Sub as Base?` does both at once. Measured across the nullable row,
    // where `P? as Base?` is a downcast despite both sides being nullable, because `P` is not a
    // `Base` — the two conditions are independent and both are required.
    string fromCore = withoutNull(castFrom);
    string fromBase = fromCore == "" ? castFrom : fromCore;
    string toCore = withoutNull(to);
    string toBase = toCore == "" ? to : toCore;
    // **`anyref` is the top type, and this rule did not know it.** `assignable` does — its `anyref`
    // line takes any reference and `i31ref` besides — and the two are the same fact about the same
    // type lattice, written twice, with only one of them complete. So a cast *to* `anyref` fell
    // through to "not a widening" and both operators came out backwards: `s as anyref` was reported
    // as a downcast, and `s as! anyref` — an upcast, which the reference refuses with *"use 'as'"* —
    // was waved through. Ten cells of a ninety-cell reference-cast grid, five each way.
    //
    // The same condition as `assignable`'s, deliberately: a primitive still does not widen to
    // `anyref`, so `5 as anyref` stays a downcast and stays reported.
    bool toAnyref = toBase == "anyref" && (fromBase == "i31ref" || isReferenceType(c, fromBase));
    bool widensType = fromBase == toBase || descendsFrom(c, fromBase, toBase) || toAnyref;
    // **And `anyref` is already nullable**, so nothing is taken away by casting a `S?` into it. This
    // is the nullability half of the same fact as `toAnyref` above and it has to be said separately,
    // because the two conditions are independent by design — the comment above this block says so.
    // Without it `S? as anyref` was still a downcast and the pair came out backwards for the four
    // nullable rows of the grid, after the six non-nullable ones were fixed.
    //
    // Third place this repository states that `anyref` holds anything and may be absent: `assignable`
    // has it twice and `nullableIntoNonNull` once. They are not textually shareable — each is a
    // different question about the same lattice — but a fourth should be a helper rather than a fourth.
    bool widensNull = isNullableName(to) || !isNullableName(castFrom) || toBase == "anyref";
    bool up = widensType && widensNull;
    if (up && ck == kAsBang()) {
      c.reportTok(errWrongCastOp(), op, "from " + castFrom + " to " + to);
    }
    if (!up && ck == kAs()) { c.reportTok(errDowncast(), op, ""); }
    // **`x as! T` between types that share no ancestor always traps** — the third of
    // `issues/lang/0126`'s three. A downcast is a claim checked at run time, and one that cannot
    // hold is a trap the reader has written on purpose-looking code.
    //
    // Only for `as!`, which is the spelling that traps; `as` between unrelated references is already
    // the error above, and saying both would be two complaints about one line.
    if (ck == kAsBang() && !c.isGeneric(fromBase) && !c.isGeneric(toBase) &&
        !shareAncestor(c, fromBase, toBase)) {
      c.warn(warnAlwaysTraps(), e.line, e.col);
    }
    return;
  }
  // `i31ref` is a reference that pairs with `i32`, and with nothing else: coming back out is
  // lossless, going in is lossy, and any other source has no conversion at all whichever spelling is
  // used. Handled here rather than in the numeric tables because it is not a primitive.
  if (to == "i31ref") {
    string i31from = castOperandType(c, operand);
    if (i31from == typeNone() || i31from == "i31ref") { return; }
    // **Out of `anyref` is the other way in**, and it is the shape `spec/tour.wac` uses: an
    // `anyref[]` holds unboxed numbers beside heap objects, and getting one back out is a downcast
    // that can fail — so `as!` carries it and the other three spellings do not. This block knew
    // only the `i32` pairing and called the tour's own line a cast with no conversion.
    if (i31from == "anyref") {
      if (tokenKind(c, op) != kAsBang()) {
        c.reportTok(errDowncast(), op, "");
      }
      return;
    }
    // **"these types" has to name them.** Six of this code's eleven report sites passed no operand,
    // so the message promised information it did not give — the worst kind of diagnostic, because a
    // reader stops looking for what it did not say. The five that already named them show the
    // format, and the two types are in scope at every one of the six.
    if (i31from != "i32") {
      c.reportTok(errWrongCastOp(), op, "from " + i31from + " to " + to);
      return;
    }
    // `i32 -> i31ref` is the lossy direction: `as!` and `as~` carry it, `as` and `as@` do not.
    i32 ik = tokenKind(c, op);
    if (ik == kAs() || ik == kAsAt()) {
      c.reportTok(errWrongCastOp(), op, "from " + i31from + " to " + to);
    }
    return;
  }
  // Only conversions between two **value** types from here on. A `string` reaches this point through
  // `isPrimitiveName` and must not: casting one to itself is ordinary, where casting an `i32` to an
  // `i32` is redundant.
  //
  // **A funcref cast to itself is a standing disagreement, parked here on purpose.** The reference
  // refuses `a as fn[i32(i32)]` for an `a` of that type — *"cast from 'fn(i32) -> i32' to
  // 'fn(i32) -> i32' is redundant"* — and allows a `string`, a struct and an array cast to
  // themselves, which this allows too. `spec/spec/casts.md` says nothing about a cast to the same
  // type at all, so there is no authority to settle it: matching the reference for funcrefs alone
  // would copy an inconsistency, and matching it for all four would refuse three programs both
  // compilers accept today. It is the `cast as` row in `sweep.test.ts`'s miss queue, and it stays
  // there rather than being closed by picking a side.
  if (to == typeNone() || !isValueType(to) || isPackedName(to)) { return; }
  string from = castOperandType(c, operand);
  // Out of an `i31ref` and into an integer, which is the lossless direction — so `as` is the only
  // spelling that carries it, and every other one is a complaint at the operator.
  if (from == "i31ref") {
    if (to == "i32" && tokenKind(c, op) != kAs()) {
      c.reportTok(errWrongCastOp(), op, "from " + from + " to " + to);
    }
    return;
  }
  if (from == typeNone() || !isValueType(from) || isPackedName(from)) { return; }
  i32 k = tokenKind(c, op);
  // A cast to the type it already is does nothing, and the language says so rather than allowing it
  // as a no-op. Only measured for plain `as`; the checked and truncating spellings say nothing here.
  // A cast to the type it already is does nothing, whichever of the four was written — the checked
  // and truncating spellings are as redundant as the plain one, which the first version of this
  // assumed the opposite of.
  if (from == to) {
    c.reportTok(errRedundantCast(), op, "");
    return;
  }

  bool lossless = losslessCast(from, to);

  // Losslessness is decided first, whichever operator was written. `x as@ i64` from an `i32` is
  // *"lossy cast not needed"* and not *"no raw conversion"* — the reference complains that the
  // conversion needs no help before it complains about which help was offered. Ordering this the
  // other way round put the right diagnostic at the wrong position, and only the corpus said so.
  if (k == kAs()) {
    // At the operator: *"'i32' -> 'u32' is lossy — use 'as!', 'as~', or 'as@'"* is advice about
    // which operator to write, so it points at the one that is there.
    if (!lossless) { c.reportWith(errWrongCastOp(), e.line, e.col, "from " + from + " to " + to); }
    return;
  }
  if (lossless) {
    c.reportWith(errWrongCastOp(), operand.line, operand.col, "from " + from + " to " + to);
    return;
  }
  // Not lossless, so `as!` and `as~` are both fine. `as@` additionally needs a raw form to exist,
  // and *that* complaint is about the operator, so it is reported there.
  if (k == kAsAt() && !rawCast(from, to)) {
    c.reportWith(errWrongCastOp(), e.line, e.col, "from " + from + " to " + to);
  }
}

/**
 * Two parameters of one function or method sharing a name.
 *
 * Reported at the second, which is the one that could be renamed. Nothing else here looks at a
 * declaration for its own sake — every other rule is about a use — so this is the first check that
 * reads a signature rather than following a walk.
 */
void checkParams(C c, Param[] params) {
  for (i32 i = 0; i < params.len(); i++) {
    // A packed type has no slot of its own — it exists as an array element and nowhere else — so it
    // cannot be a parameter. Reported at the type, which is the same position a duplicate name uses.
    string pt = typeOfTy(c, params[i].type);
    if (isPackedName(pt)) {
      c.report(errPackedPosition(), params[i].type.line, params[i].type.col);
    }
    // `void` is what a function returns, not a value anything can hold, so it is not a type a
    // parameter or a field can have.
    if (pt == "void") { c.report(errVoidType(), params[i].type.line, params[i].type.col); }
    checkPackedNullable(c, pt, params[i].type);
    string a = tokenText(c, params[i].nameTok);
    for (i32 j = 0; j < i; j++) {
      if (tokenText(c, params[j].nameTok) == a) {
        c.report(errDuplicateParam(), params[i].type.line, params[i].type.col);
        break;
      }
    }
  }
}

/** Every name a statement declares, however deeply nested. */
void declareStmt(C c, Stmt s) {
  match (s.kind) {
    case Var(type, nameTok, init, isConst): {
      // A local that **aliases** something const is const too. `Counter c = this; c.mutate();` inside
      // a `const this` method looks like a way to launder the constness and is not one — the local
      // and the receiver are the same object.
      //
      // Only for a type you can write **through**: a struct or an array. `i32 v = this.n;` is a copy
      // and writing to it is nobody's business but the local's, and a `string` is a reference but an
      // immutable one — assigning a new string to the local mutates nothing, which is why
      // `string s = SOME_CONST; s = s + "x";` is ordinary and reported seven times before this said
      // "reference" where it meant "writable".
      string vt = typeOfTy(c, type);
      string vcore = withoutNull(vt);
      string vbase = vcore == "" ? vt : vcore;
      bool writable = isArrayName(vbase) || c.isStruct(vbase);
      bool aliasesConst = writable && constExpr(c, init);
      // **A local built out of a live type parameter keeps its written spelling.** `Box<T> b` is
      // unknown to every other rule here, and has to be — but the name then carries no trace of `T`
      // at all, which is what a self-instantiating generic is recognised by. Only when the written
      // type *mentions* a parameter in scope: everything else already has a real answer.
      if (vt == typeNone() && c.activeParamCount > 0) {
        string wt = writtenTy(c, type);
        if (wt != "" && !isActiveParam(c, wt) && mentionsActiveParam(c, wt)) { vt = wt; }
      }
      c.declareConst(tokenText(c, nameTok), vt, isConst || aliasesConst);
      // Recorded as the aliasing kind, so a write *through* it is still refused while rebinding the
      // name is not. `while (cur is not null) { cur = cur!.next; }` walks a list in a `const this`
      // method, which is what ten of the spec's own linked-list programs do.
      if (!isConst && aliasesConst) { c.markAliasOnly(tokenText(c, nameTok)); }
      // **A `match` used as an initialiser binds names too**, and this walked only statements — so
      // `i32 got = match (o) { case Some(v): v * 3, … };` left `v` undeclared, every arm typed as
      // unknown, and the whole initialiser unknown with them. The statement form two arms down has
      // always done this; the expression form was simply never walked.
      declareMatchBindings(c, init);
    }
    case Block(body): { declareScoped(c, body); }
    case If(cond, then, els): { declareScoped(c, then); declareScoped(c, els); }
    case While(cond, body): { declareScoped(c, body); }
    case DoWhile(body, cond): { declareScoped(c, body); }
    case For(init, cond, update, body): {
      // **The body is the initialiser's scope too.** `for (i32 i = ...) { } i32 r = i;` is an error
      // because `i` belongs to the loop, and pushing the body before declaring the initialiser says
      // so without a second stack to keep in step with this one. `issues/lang/0122`.
      c.pushScope(body);
      if (!(init is null)) { declareStmt(c, init!); }
      declareAll(c, body);
      c.popScope();
    }
    case Switch(subject, cases): {
      for (i32 i = 0; i < cases.len(); i++) { declareScoped(c, cases[i].body); }
    }
    case Match(subject, arms): {
      for (i32 i = 0; i < arms.len(); i++) {
        // The arm's bindings are names too, and they scope to the arm. This slice does not track
        // that, so they are declared as *unknown* — which both silences them and, because a second
        // declaration poisons, silences any local elsewhere in the function with the same name.
        //
        // Not modelling them was a false alarm rather than a gap. `typeOfTy` in this very file has an
        // `Arr` arm declaring a local `string inner` and a `Nullable` arm binding a `Ty` called
        // `inner`; without this, the local's type leaked across and `typeOfTy(c, inner)` was reported
        // as an argument mismatch against its own parameter.
        c.pushScope(arms[i].body);
        for (i32 b = 0; b < arms[i].bindingToks.len(); b++) {
          c.declare(tokenText(c, arms[i].bindingToks[b]), armBindingType(c, subject, arms[i], b));
        }
        declareAll(c, arms[i].body);
        c.popScope();
      }
    }
    else: { }
  }
}

/** Every name declared in a list of statements. */
/**
 * Declare the bindings of a `match` written as an expression.
 *
 * `declareAll` walks statements, and an arm's bindings are declared where the statement form is
 * walked. An initialiser is an *expression*, so a match in one was never reached and its bindings
 * never existed — which made every arm mentioning one unknown, and the match unknown with them.
 *
 * Only the initialiser itself, not every expression inside it: a match nested deeper is a shape this
 * repository does not contain, and walking all of `ExprKind` to find one would be a lot of code for
 * a case nothing writes. The bindings are declared with `armBindingType`, the same answer the
 * statement form uses.
 */
void declareMatchBindings(C c, Expr e) {
  match (e.kind) {
    case MatchExpr(subject, arms): {
      for (i32 i = 0; i < arms.len(); i++) {
        for (i32 b = 0; b < arms[i].bindingToks.len(); b++) {
          c.declare(tokenText(c, arms[i].bindingToks[b]), armBindingType(c, subject, arms[i], b));
        }
      }
    }
    else: { }
  }
}

/** `declareAll` in a scope of its own, which is what a block, a case or a loop body is. */
void declareScoped(C c, Stmt[] body) {
  c.pushScope(body);
  declareAll(c, body);
  c.popScope();
}

void declareAll(C c, Stmt[] body) {
  for (i32 i = 0; i < body.len(); i++) { declareStmt(c, body[i]); }
}

/**
 * How many names a condition narrows, and to what — written into `outNames` / `outTypes`.
 *
 * Purely syntactic, which is what the reference does and is measured rather than assumed: `x is T`
 * narrows, `a && b` narrows with either side, and **`||` and `!` do not**. `(s is Circle) || true`
 * leaves `s` a `Shape`, because the other arm may be the one that held; `!(s is Circle)` guarding an
 * early return does not narrow what follows either, which is the reference declining to reason about
 * control flow it could have.
 *
 * The narrowing lasts for the **then** branch and no further. Nothing here survives the `if`.
 */
i32 narrowingsOf(C c, Expr cond, string[] outNames, string[] outTypes, i32 n) {
  match (cond.kind) {
    case Is(left, target, other, negated): {
      if (negated || (target is null) || n >= outNames.len()) { return n; }
      match (left.kind) {
        case Ident(tok): {
          string t = typeOfTy(c, target!);
          if (t == typeNone()) { return n; }
          // **`p is P` on a `P?` asks whether it is *there*, not what it is.** Recording it as a
          // retyping to `P` makes the checker believe the name is no longer nullable, and the very
          // next thing such code does is `p!.v` — which it then refuses, because there is nothing
          // left to unwrap. The knowledge changes; the type does not. A target that is a genuinely
          // different type still narrows, which is the case this exists for.
          // **And an *ancestor* is the same non-answer**, which the exact name match above missed.
          // `k is S` for a `K? k` where `K : S` tells you the value is there; it does not tell you
          // anything about its type that was not already written down, because a `K` is an `S`
          // already. Retyping to `S` dropped the `?` along with it, so wacc accepted `k.v` where the
          // reference says *"cannot access field on nullable type 'K?' — unwrap with '!'"* — while
          // refusing the identical `k is K` right beside it, which is the tell that this was a
          // spelling the rule could not see rather than a decision.
          //
          // A genuinely different type still narrows, which is what this rule is for: `s is K` on an
          // `S s` retypes, and so does `s is K` on an `S? s`, because neither is an ancestor of the
          // target.
          string cur = c.typeOfName(tokenText(c, tok));
          string curCore = withoutNull(cur) == "" ? cur : withoutNull(cur);
          if (curCore == t || descendsFrom(c, curCore, t)) { return n; }
          outNames[n] = tokenText(c, tok);
          outTypes[n] = t;
          return n + 1;
        }
        else: { return n; }
      }
    }
    case Binary(op, l, r): {
      if (tokenKind(c, op) != kAndAnd()) { return n; }
      return narrowingsOf(c, r, outNames, outTypes, narrowingsOf(c, l, outNames, outTypes, n));
    }
    else: { return n; }
  }
}

/** Whether an expression builds an enum variant: `Shape.Circle(1.0)`, or a bare `Circle(1.0)`. */
/**
 * A variant construction whose enum is generic, which is the one that needs a slot to be known.
 *
 * **Asked without the arity**, unlike `isVariantConstruction`: a generic enum's variants are recorded
 * under the *template's* name and `variantArityIn` is keyed by owner, so asking it here answered -1
 * and the whole predicate came back false for exactly the case it exists to catch. What identifies
 * this shape is that the name is an enum, that enum is generic, and a member of it is being called.
 */
bool genericVariantConstruction(C c, Expr e) {
  match (e.kind) {
    // `Maybe.Just(4)` — a variant with a payload, which is a call.
    case Call(callee, args): { return genericEnumMember(c, callee); }
    // `Maybe.Absent` — one without, which is not.
    case Member(obj, nameTok): { return genericEnumMember(c, e); }
    else: { return false; }
  }
}

/** Whether this is `E.Name` where `E` is a generic enum in scope. */
bool genericEnumMember(C c, Expr e) {
  match (e.kind) {
    case Member(obj, nameTok): {
      match (obj.kind) {
        case Ident(tok): {
          string en = tokenText(c, tok);
          return c.isGenericEnum(en);
        }
        else: { return false; }
      }
    }
    else: { return false; }
  }
}

bool isVariantConstruction(C c, Expr e) {
  match (e.kind) {
    case Call(callee, args): {
      match (callee.kind) {
        case Member(obj, nameTok): {
          match (obj.kind) {
            case Ident(tok): {
              string en = tokenText(c, tok);
              return c.isEnum(en) && c.variantArityIn(en, tokenText(c, nameTok)) >= 0;
            }
            else: { return false; }
          }
        }
        case Ident(tok): { return c.isVariantName(tokenText(c, tok)); }
        else: { return false; }
      }
    }
    else: { return false; }
  }
}

/**
 * A condition, which must be a boolean.
 *
 * Reported at the condition itself rather than at the `if`, which is where the reference puts it —
 * *"condition must be bool"* names the expression that is wrong, not the statement containing it.
 * The condition is also walked as an ordinary expression, so a mismatch inside it is still found.
 */
void checkCond(C c, Expr cond) {
  if (notBool(c, cond)) {
    // At the condition's own token: `if (x)` wants a caret of one under `x` — `§wac-diag-bool-r8kn4wp`.
    // **And the hint names what is on the line.** The table's version said "such as `x != 0`" whatever
    // the condition was called, so `if (flag)` was told to compare a variable it does not have.
    string wrote = sourceOfExpr(c, cond);
    string note = expectedFound("bool", foundType(c, cond));
    if (wrote == "") {
      reportExpr(c, errNotBool(), cond, note);
    } else {
      c.reportSpanHinted(errNotBool(), cond.line, cond.col, note,
                         c.widthBetween(firstTokenOfExpr(cond), lastTokenOfExpr(cond)),
                         "use a comparison, such as `" + wrote + " != 0`");
    }
  }
  checkExpr(c, cond);
}

/** Every `return` in a list of statements. */
/** `checkAll` in a scope of its own, matching `declareScoped` in the declare walk. */
void checkScoped(C c, Stmt[] body, Ty want) {
  c.pushScope(body);
  checkAll(c, body, want);
  c.popScope();
}

void checkAll(C c, Stmt[] body, Ty want) {
  for (i32 i = 0; i < body.len(); i++) { checkStmt(c, body[i], want); }
}

/** Every `return` in a statement, however deeply nested, checked against `want`. */
void checkStmt(C c, Stmt s, Ty want) {
  match (s.kind) {
    /**
     * An assignment, which is the initialiser question with the declared type coming from the target
     * rather than from a `Ty` node.
     *
     * Only plain `=`. A compound assignment (`n += 1`) is the operator's rule rather than this one —
     * the reference accepts `n += 1` for an `i32` exactly as it accepts `n + 1` — and folding the two
     * would report the literal cases that rule deliberately skips.
     */
    // `n++` writes as much as `n = n + 1` does.
    case IncrStmt(target, op): { checkIncr(c, target, s.line, s.col); }
    // A bare expression — `p.set(1);` — was walked nowhere. Every expression rule reached only
    // expressions that were part of something else: a return, an initialiser, a condition. A
    // statement that is just a call is the commonest shape in the language and had no rule applied
    // to it at all, which is how the const-receiver check looked broken when it was merely unreached.
    case ExprStmt(expr): { checkExpr(c, expr); }
    case Assign(target, op, rhs): {
      c.expected = typeOfLvalue(c, target);
      checkExpr(c, rhs);
      // **A const reference stored somewhere that outlives the binding.** `h.i = c` and `xs[0] = c`
      // put a `const S` where nothing downstream can tell it apart from a mutable one — the write
      // `h.i.v = 2` is then accepted, which is the laundering `[§wac-const-deep-j6b1nyg]` refuses.
      // A *local* is the exception and not an oversight: `S t = c;` propagates the constness onto
      // the new name instead (`markAliasOnly`), because a name is something this checker can track
      // and a field of some struct on the heap is not. `spec/cases/0079`, `0080`.
      if (tokenKind(c, op) == kAssign() && indirectLvalue(target) && constName(c, rhs)) {
        string rt = typeOfExpr(c, rhs);
        string rcore = withoutNull(rt);
        string rbase = rcore == "" ? rt : rcore;
        if (isArrayName(rbase) || c.isStruct(rbase)) {
          c.report(errConstReference(), rhs.line, rhs.col);
        }
      }
      // Every assignment writes, compound or not — `n += 1` on a const is refused exactly as `n = 1`
      // is, so this comes before the plain-`=` gate below.
      checkWrite(c, target);
      if (tokenKind(c, op) != kAssign()) {
        // A compound assignment is the operator's rule and the assignment's at once: `x += 1.5` on an
        // `i32` is refused for the same reason `x + 1.5` would be, but reported at the **target**
        // rather than at the operator. Literals count here, unlike in a binary expression, because
        // there is no other side for the literal to take its type from — the target settles it.
        string ct = typeOfLvalue(c, target);
        if (ct == typeNone() || ct == "" || isPackedName(ct)) { return; }
        // **A shift's right-hand side is a count, not the other half of a pair.**
        // `spec/spec/operators.md`: a compound operator has *"same type rules as the underlying
        // operator"*, and spells the consequence out — `i64 <<= i32` is allowed wherever `i64 <<
        // i32` is. The same-type rule below is right for `+=` and wrong here, and it refused three
        // programs the spec runs.
        i32 shiftKind = tokenKind(c, op);
        if (shiftKind == kShlEq() || shiftKind == kShrEq() || shiftKind == kShrUEq()) {
          string samt = typeOfExpr(c, rhs);
          if (!isIntegerName(ct) || (samt != typeNone() && !isIntegerName(samt))) {
            c.report(errOperandKind(), lvalueStartLine(target), lvalueStartCol(target));
          }
          return;
        }
        // `+=` and its siblings are arithmetic, so the target has to be something arithmetic can be
        // done to: a number, or a `string`, which concatenates. An array, a struct, an enum and a
        // funcref all *agree with themselves*, so the type comparison below has nothing to say about
        // `a += b` on two of them — the same shape as `a & b` on two floats, one operator family on.
        i32 tline = lvalueStartLine(target);
        i32 tcol = lvalueStartCol(target);
        if (!isValueType(ct) && ct != "string") {
          c.report(errOperandMismatch(), tline, tcol);
          return;
        }
        // **A `bool` is a value type and arithmetic still cannot be done to it.** The gate above asks
        // whether the target is a value, which a `bool` is, so `a += b` on two of them fell through to
        // the same-type comparison below — where they agree, so nothing was said. Two stated clauses
        // compose to make it an error: `§wac-bool-arith-f2nx8k3`, *"`a + 1` where a is bool is a
        // compile error"*, and a compound operator having *"same type rules as the underlying
        // operator"*. The reference reports *'+' requires numeric type, got bool*.
        //
        // `errOperandKind` rather than the mismatch above, because the two operands *do* match — what
        // is wrong is the kind, which is what that code's headline says. There is no `&&=` or `||=` in
        // the language, so no compound operator is legitimate on a `bool`.
        if (ct == "bool") {
          c.report(errOperandKind(), tline, tcol);
          return;
        }
        i32 clit = litKindOf(rhs);
        if (clit != litNone()) {
          reportLiteral(c, ct, rhs, errOperandMismatch(), tline, tcol);
          return;
        }
        string cgot = typeOfExpr(c, rhs);
        if (cgot != typeNone() && cgot != ct) {
          c.report(errOperandMismatch(), tline, tcol);
        }
        return;
      }
      string wantTo = typeOfLvalue(c, target);
      if (wantTo == typeNone()) { return; }
      // **A packed target takes an `i32`** — which is measured now rather than assumed. A packed
      // target is an array element by construction, nothing else can have that type, and an integer
      // truncates into one at the store; what this used to add was that what the reference accepts
      // *beyond* that was not measured, so it said nothing at all and `bytes[i] = "s"` was accepted.
      //
      // Measured: the reference takes an integer literal and an `i32` there, and refuses `i64`,
      // `f64`, `bool` and `string`, naming `i32` in each. So the rule is the `i32` rule, which is
      // the same widening `typeOfExpr`'s `Index` arm already does on the reading side — `bytes[i]`
      // from a `u8[]` is an i32-shaped value. Four element types were unchecked, `u8` `i8` `u16`
      // `i16`; `u32`, `i64`, `f64` and `bool` were not, because those are variable types that answer
      // for themselves.
      if (isPackedName(wantTo)) { wantTo = "i32"; }
      i32 litTo = litFamily(c, rhs);
      if (litTo != litNone()) {
        reportLiteral(c, wantTo, rhs, errInitTypeMismatch(), rhs.line, rhs.col);
        return;
      }
      string gotTo = typeOfExpr(c, rhs);
      if (nullableIntoNonNull(c, wantTo, gotTo)) {
        c.report(errNullableToNonNull(), rhs.line, rhs.col);
      } else if (!assignable(c, wantTo, gotTo)) {
        reportExpr(c, errInitTypeMismatch(), rhs, expectedFound(wantTo, gotTo));
      }
    }
    // The same question one position over: a declared type, and something that has to fit it.
    case Var(type, nameTok, init, isConst): {
      string wantVar = typeOfTy(c, type);
      checkPackedNullable(c, wantVar, type);
      checkPackedHere(c, wantVar, type.line, type.col);
      if (wantVar == typeNone()) { return; }
      // **The declaration takes effect here, not in the collecting walk.** For all but a redeclared
      // name this is what the table already says; for a redeclared one it is the difference between
      // a rule that can see the shadow and one that cannot. Set after `wantVar` is known and before
      // the initialiser is walked, because the initialiser was checked against the *old* binding
      // above — `i32 a = a.m()` reads the parameter, and only the uses after it read the local.
      i32 litVar = litFamily(c, init);
      if (litVar != litNone()) {
        reportLiteral(c, wantVar, init, errInitTypeMismatch(), init.line, init.col);
        // **And walked.** This gate is `litFamily`, so a *compound* expression can take it — `1 + 2`
        // always could and `cond ? 1 : 2` does now — and returning here skipped everything inside:
        // `i32 n = p is null ? 1 : 0;` lost the warning about `is null` on a non-null reference, and the
        // reach sweep lost `Ternary-cond`. `issues/lang/0145`.
        c.expected = wantVar;
        checkExpr(c, init);
        c.setType(tokenText(c, nameTok), wantVar);
        return;
      }
      string gotVar = typeOfExpr(c, init);
      if (nullableIntoNonNull(c, wantVar, gotVar)) {
        c.report(errNullableToNonNull(), init.line, init.col);
      } else if (!assignable(c, wantVar, gotVar)) {
        reportExpr(c, errInitTypeMismatch(), init, expectedFound(wantVar, gotVar));
      }
      c.expected = wantVar;
      checkExpr(c, init);
      // **The type and not the const flags.** Setting those too laundered `const`-ness away: a local
      // that aliases a const receiver is const *by alias*, `markAliasOnly` records that, and an
      // unconditional `setConstFlags(name, isConst, false)` undid it — `spec/cases/0006` and
      // `spec/cases/0119` both went from refused to accepted. A redeclared name therefore keeps the
      // first declaration's constness, which is a residual inaccuracy in a case nothing writes:
      // `const i32 a = 1; i32 a = 2; a = 3;` would be refused where the reference allows it.
      c.setType(tokenText(c, nameTok), wantVar);
    }
    case Return(value): {
      // Before the types: whether there should be a value here at all. Both directions are errors and
      // both name the `return` itself rather than what follows it — there is nothing to name in the
      // second case, which is presumably why the reference settled on the statement for both.
      //
      // **Inside a lambda the answer comes from `c.lambdaReturn`**, because a lambda writes no return
      // type and `want` is still the enclosing function's. `design/lang/0002` settles what `return`
      // means here: it returns from the lambda, which is the only available reading once the lambda
      // can outlive the frame it was written in.
      string declared = c.lambdaReturn != "" ? c.lambdaReturn : typeOfTy(c, want);
      // **Whether a value belongs here is syntactic, and `typeOfTy` answers unknown for a type built
      // out of a type parameter.** `Box<T> of(T x) { return; }` inside the template: `Box<T>` has no
      // name in this checker's world, so `declared` was `""`, `returnsAValue("")` is false, and a bare
      // return from a function that owes a value was accepted. The *comparisons* below genuinely need a
      // resolved type and stay unknown-means-silent; this question needs only the spelling, which
      // `writtenTy` keeps with the parameters standing.
      string valueness = declared == "" && c.lambdaReturn == "" ? writtenTy(c, want) : declared;
      if (valueness == "void" && !(value is null)) {
        c.report(errReturnValueness(), s.line, s.col);
        return;
      }
      if ((value is null) && returnsAValue(valueness)) {
        c.report(errReturnValueness(), s.line, s.col);
        return;
      }
      if (value is null) { return; }
      string expected = declared;
      Expr e = value!;
      if (!returnsAValue(expected)) {
        // **The expression is still walked when the declared type is one this checker cannot name.**
        // `T get(const this) { return zzz.v; }` inside a `Box<T>` returned here and *nothing* inside was
        // checked — no undefined name, no operand mismatch, no arity — while the identical line in a
        // non-generic struct was reported. `T` makes the comparison impossible and says nothing about
        // the names in the expression. `issues/lang/0145`.
        //
        // The slot is the declared type as **written**: `typeOfTy` answers unknown for `Box<T>`, and
        // passing that on as "no slot" reported `return Box(x);` inside `Box<T> of(T x)` as not
        // callable — a bare generic construction does need a slot, and the template is all that rule
        // reads.
        string spelled = writtenTy(c, want);
        c.expected = spelled == "" ? typeNone() : spelled;
        c.expectedUnknown = spelled == "";
        checkExpr(c, e);
        c.expectedUnknown = false;
        return;
      }
      // **`litFamily`, not `litKindOf`** — the same gate the declaration one position over uses, so a
      // compound of literals is asked the same question a bare one is: `return 1 + 2;` from a `string`
      // function is a mismatch, and so is `return cond ? false : true;` from an `i32` one. Safe only
      // because the walk below happens either way now.
      i32 lit = litFamily(c, e);
      if (lit != litNone()) {
        // A literal: polymorphic over a family, so the question is whether the declared type is in it.
        reportLiteral(c, expected, e, errReturnTypeMismatch(), e.line, e.col);
        // **And the expression is still walked.** Harmless for a leaf, which is what a literal was when
        // this returned here — and `litFamily` already calls `1 + 2` a literal, so anything compound
        // that qualifies had everything inside it skipped. `issues/lang/0145`.
        c.expected = expected;
        checkExpr(c, e);
        return;
      }
      // A name: a value of exactly one type, so the question is whether it is the declared one.
      string got = typeOfExpr(c, e);
      if (nullableIntoNonNull(c, expected, got)) {
        c.report(errNullableToNonNull(), e.line, e.col);
      } else if (!assignable(c, expected, got)) {
        // The whole returned expression, not its first token: `§wac-diag-wide-k4rn8wp` states `span: 7`
        // for `return sum > 0;`, and the hint it states quotes the expression —
        // *"use `(sum > 0) as i32` to convert"*. Only where the text is in hand and a cast is what the
        // reader wants: from a `bool` to a number that is a comparison used as a value, which is the
        // case the clause is about.
        string wrote = sourceOfExpr(c, e);
        string note = expectedFound(expected, got);
        if (wrote == "" || got != "bool" || expected == "bool") {
          reportExprSpan(c, errReturnTypeMismatch(), e, note);
        } else {
          c.reportSpanHinted(errReturnTypeMismatch(), e.line, e.col, note,
                             c.widthBetween(firstTokenOfExpr(e), lastTokenOfExpr(e)),
                             "use `(" + wrote + ") as " + expected + "` to convert");
        }
      }
      c.expected = expected;
      checkExpr(c, e);
    }
    // Every arm carrying statements recurses. `els` is an empty array rather than a null for "no
    // else", and `Switch`/`Match` hold their bodies one level deeper, inside cases and arms.
    case Block(body): { checkScoped(c, body, want); }
    case If(cond, then, els): {
      checkCond(c, cond);
      // `if (s is Circle) { s.radius }` — the guard is what makes the payload reachable, so the then
      // branch is walked with `s` retyped and the old type put back afterwards. Saved and restored
      // rather than scoped, because this checker's names are one flat table per function.
      string[] nNames = string[8]();
      string[] nTypes = string[8]();
      i32 nCount = narrowingsOf(c, cond, nNames, nTypes, 0);
      string[] saved = string[nCount]();
      bool[] savedConst = bool[nCount]();
      bool[] savedAlias = bool[nCount]();
      for (i32 i = 0; i < nCount; i++) {
        saved[i] = c.typeOfName(nNames[i]);
        // **A narrowed name is const for the branch**, exactly as a match arm's subject is: writing
        // to it would leave the narrowing describing a value that has gone. `spec/cases/0071`.
        savedConst[i] = c.isConstName(nNames[i]);
        savedAlias[i] = c.isAliasOnlyName(nNames[i]);
        c.setType(nNames[i], nTypes[i]);
        c.setConstFlags(nNames[i], true, false);
      }
      // The narrowings are set and restored *outside* the arm's scope: they retype names that
      // belong to an enclosing one, and a name is only reachable while its own scope is open.
      checkScoped(c, then, want);
      for (i32 i = 0; i < nCount; i++) {
        c.setType(nNames[i], saved[i]);
        c.setConstFlags(nNames[i], savedConst[i], savedAlias[i]);
      }
      checkScoped(c, els, want);
    }
    // `break` and `continue` need something to leave. Switches count for both — `break` obviously,
    // and `continue` because the reference accepts it there, which is measured rather than read off
    // its message. Reported at the statement, which is the whole of it.
    // **A trap's message is what the host is told, so it is text.** Accepting a message at all meant
    // accepting any expression as one until this: `spec/cases/0043` is the message, `0045` is that it
    // has to be a string.
    case Trap(value): {
      if (!(value is null)) {
        Expr msg = value!;
        c.expected = "string";
        checkExpr(c, msg);
        if (litKindOf(msg) != litNone()) {
          if (litKindOf(msg) != litString()) {
            c.reportWith(errOperandKind(), msg.line, msg.col,
                         expectedFound("string", foundType(c, msg)));
          }
        } else {
          string mt = typeOfExpr(c, msg);
          if (mt != typeNone() && mt != "" && mt != "string") {
            c.reportWith(errOperandKind(), msg.line, msg.col, expectedFound("string", mt));
          }
        }
      }
    }
    case Break: {
      // A `break` leaves whichever of the two is innermost, so either will do.
      if (c.loopDepth == 0 && c.switchDepth == 0) { c.report(errNoLoop(), s.line, s.col); }
    }
    case Continue: {
      // A `continue` needs a *loop*: there is nothing in a switch to go round again.
      if (c.loopDepth == 0) { c.report(errNoLoop(), s.line, s.col); }
    }
    case While(cond, body): {
      checkCond(c, cond);
      c.loopDepth = c.loopDepth + 1;
      checkScoped(c, body, want);
      c.loopDepth = c.loopDepth - 1;
    }
    case DoWhile(body, cond): {
      checkCond(c, cond);
      c.loopDepth = c.loopDepth + 1;
      checkScoped(c, body, want);
      c.loopDepth = c.loopDepth - 1;
    }
    case For(init, cond, update, body): {
      // The init and update are statements, and were declared but never checked — a `for` whose
      // initialiser is wrong said nothing. The reachability grid found it: `For` passed on its body
      // and failed on its init, which is exactly the shape of a walk that descends one field and not
      // its siblings.
      // Initialiser, condition and update are all inside the body's scope: `i` is declared there
      // and read by all three. Matches the declare walk. `issues/lang/0122`.
      c.pushScope(body);
      if (!(init is null)) { checkStmt(c, init!, want); }
      if (!(cond is null)) { checkCond(c, cond!); }
      if (!(update is null)) { checkStmt(c, update!, want); }
      c.loopDepth = c.loopDepth + 1;
      checkAll(c, body, want);
      c.loopDepth = c.loopDepth - 1;
      c.popScope();
    }
    case Switch(subject, cases): {
      checkExpr(c, subject);
      // A `switch` jumps on an integer, and a signed or unsigned 32-bit one at that. Reported at the
      // subject, which is the expression that cannot be switched on.
      // **A literal subject has a type even though `typeOfExpr` says nothing about one.** That answer
      // is deliberate — a literal takes the type of the slot it fills — but a `switch` *is* the slot
      // here, and `switch ("s")` was the one program in this family the sweep found and nothing
      // reported. `naturalTypeOf` is the same fallback the receiver rule uses for `"abc".len()`.
      string subT = typeOfExpr(c, subject);
      if (subT == typeNone() || subT == "") { subT = naturalTypeOf(c, subject); }
      if (subT != typeNone() && subT != "" && subT != "i32" && subT != "u32") {
        c.report(errSwitchSubject(), subject.line, subject.col);
      }
      // **One `default` at most**, reported at the second one's own keyword — the first is the
      // arm that works and the second is the mistake.
      bool sawDefault = false;
      for (i32 i = 0; i < cases.len(); i++) {
        if (!(cases[i].value is null)) { continue; }
        if (sawDefault) { c.report(errTwoDefaults(), cases[i].line, cases[i].col); }
        sawDefault = true;
      }
      // A case value is compared against the subject with `==`, so it is an `i32` like the subject.
      // At the `case` keyword rather than at the value, which is why a `Case` now carries a position:
      // the complaint is about the arm rather than about the expression in it.
      for (i32 i = 0; i < cases.len(); i++) {
        if (cases[i].value is null) { continue; }
        Expr cv = cases[i].value!;
        i32 cvl = litKindOf(cv);
        if (cvl != litNone()) {
          if (!acceptsLiteral("i32", cvl)) {
            c.report(errSwitchSubject(), cases[i].line, cases[i].col);
          }
        } else {
          string cvt = typeOfExpr(c, cv);
          if (cvt != typeNone() && !isIntegerName(cvt)) {
            c.report(errSwitchSubject(), cases[i].line, cases[i].col);
          }
        }
      }
      // A `switch`, not a loop: a `break` here leaves it and a `continue` still needs one.
      c.switchDepth = c.switchDepth + 1;
      for (i32 i = 0; i < cases.len(); i++) { checkScoped(c, cases[i].body, want); }
      c.switchDepth = c.switchDepth - 1;
    }
    case Match(subject, arms): {
      checkArmVariants(c, subject, arms);
      for (i32 i = 0; i < arms.len(); i++) {
        // **An arm narrows the subject**, exactly as `if (s is Circle)` does — `case Circle:` is the
        // same question asked by the other syntax, and `s.radius` inside it means the payload. The
        // subject has to be a plain name for this: narrowing `f().x` would mean claiming the second
        // call returns what the first did.
        string saved = armNarrowing(c, subject, arms[i]);
        checkBindingCollision(c, subject, arms[i]);
        // The subject is const for the length of a narrowed arm: assigning to it would leave the
        // narrowing describing a value that is no longer there.
        string subj = subjectName(c, subject);
        bool wasConst = subj == "" ? false : c.isConstName(subj);
        bool wasAlias = subj == "" ? false : c.isAliasOnlyName(subj);
        if (subj != "" && arms[i].variantTok >= 0) { c.setConstFlags(subj, true, false); }
        // Scoped: the arm's bindings were declared against this same body array.
        checkScoped(c, arms[i].body, want);
        if (subj != "") { c.setConstFlags(subj, wasConst, wasAlias); }
        restoreNarrowing(c, subject, saved);
      }
      // **A match arm is neither a loop nor a switch.** This bumped `loopDepth`, having been written
      // from the switch above, so `case A: break;` and `case A: continue;` were both accepted — nine
      // of the mutation sweep's missed diagnostics. An arm is a branch of an expression: there is
      // nothing to break out of and nothing to go round again.
    }
  }
}

/**
 * Retype a match subject to the arm's variant for the arm's body, answering what to put back.
 *
 * The saved type is returned through the checker's own table rather than by value, because a name
 * that was not narrowed must be left exactly as it was — and "not narrowed" happens for every arm
 * whose subject is an expression rather than a name, and for `else`.
 */
/**
 * The arms of an expression match all produce the one value, so their types have to agree.
 *
 * Compared only between arms this checker can name, and never against a literal: `case A: 0.0,
 * case B: 1` is an integer literal in a float's slot, which is the literal rule's business and not a
 * disagreement between arms. Two concrete types that cannot stand in for one another in either
 * direction are the case worth reporting, and the second one is where the mistake reads.
 */
void checkArmValueTypes(C c, Arm[] arms, i32 line, i32 col) {
  string first = "";
  for (i32 i = 0; i < arms.len(); i++) {
    if (arms[i].value is null) { continue; }
    Expr v = arms[i].value!;
    string vt = armShape(c, v);
    if (vt == "") { continue; }
    if (first == "") { first = vt; continue; }
    if (vt == first) { continue; }
    // Any mix of numbers is somebody else's rule — the literal's slot decides whether `0` belongs in
    // an `f64`, and two arms both producing numbers are not the disagreement this is looking for.
    if (numericShape(vt) && numericShape(first)) { continue; }
    if (assignable(c, first, vt) || assignable(c, vt, first)) { continue; }
    // **Both sides have to be a type this checker can vouch for.** `case Some(v): v * 3` in
    // `packages/std` has a payload whose type comes from the enum's instantiation, and what came back
    // was a name rather than a type — against `-1` that read as a disagreement and refused a working
    // file. Silence on anything else is the same rule the rest of this checker keeps.
    // **Or a type a literal can never be**, which is the same widening the ternary's rule needed:
    // `concreteShape` is what a literal *can* be, so a struct arm beside an integer arm satisfied
    // neither side and this skipped it — and the emitter then wrote a module the engine refuses.
    // `literalNeverFits` names only what this checker is sure of, a struct, an enum, an array or a
    // funcref, so the caution the paragraph above is about is kept: a payload whose type comes back as
    // a name is in neither half and still says nothing.
    if (!(concreteShape(vt) || literalNeverFits(c, vt))) { continue; }
    if (!(concreteShape(first) || literalNeverFits(c, first))) { continue; }
    // **At the `match`, not at the arm.** The reference reports the whole expression — *match arms
    // have incompatible types: P and i32* — and this reported the offending arm's value, so every
    // report was a position the reference does not have. Nothing caught it because the case this rule
    // already handled is in no differential; the widened case above is, and named it at once. A
    // position the reference does not report is a *contradiction*, which is the one thing rung 3
    // asserts outright.
    c.report(errArmTypes(), line, col);
  }
}

/**
 * What an arm's value is, as a type name — a literal answers with the type it naturally has.
 *
 * Skipping literals outright was the first version, on the grounds that a literal takes its type
 * from its slot. It does, but only among types that could hold it: `case Point: 0.0, else: "x"` is
 * the spec's own example of arms that disagree, and both of its arms are literals, so skipping them
 * skipped the case the rule exists for.
 */
string armShape(C c, Expr v) {
  i32 k = litKindOf(v);
  if (k == litInteger()) { return "i32"; }
  if (k == litFloat()) { return "f64"; }
  if (k == litBool()) { return "bool"; }
  if (k == litString()) { return "string"; }
  if (k == litNull()) { return ""; }
  string t = typeOfExpr(c, v);
  return t == typeNone() ? "" : t;
}

/** Integers and floats alike, which is the set this rule declines to police. */
bool numericShape(string t) {
  return isIntegerName(t) || t == "f32" || t == "f64";
}

/** A primitive this checker is sure of. Anything else — a struct, a generic payload — stays silent. */
/**
 * A type a **plain** literal can never be — a struct, an enum, an array or a funcref.
 *
 * `concreteShape` answers the other half: the numbers, `bool` and `string`, which a literal *can* be
 * and which `literalFits` then judges. Between them they cover every type this checker is sure about;
 * a type parameter or an unresolved name is in neither and stays silent, which is the subset rule.
 *
 * **Why it exists.** The ternary's literal-against-a-branch rule asked `concreteShape` alone, so
 * `c ? p : 1` for a struct `p` matched no branch of it and was accepted — and the emitter then wrote a
 * module the engine refuses, which `wac build`'s own check calls a compiler bug. The reference says
 * *ternary branches have incompatible types: P and i32*.
 *
 * The base is taken through a `?` because a plain literal is no more a `P?` than a `P`, and
 * `isPlainLiteral` has already excluded `null` — which is the one literal a nullable does take, and
 * why `c ? p : null` never reaches here.
 */
bool literalNeverFits(C c, string t) {
  string base = endsWith(t, "?") ? withoutNull(t) : t;
  return c.isStruct(base) || c.isEnum(base) || isArrayName(base) || startsWithFn(base);
}

bool concreteShape(string t) {
  return numericShape(t) || t == "bool" || t == "string";
}

/** The subject's name, when the subject is a plain name — `""` for anything else. */
string subjectName(C c, Expr subject) {
  match (subject.kind) {
    case Ident(tok): { return tokenText(c, tok); }
    else: { return ""; }
  }
}

/**
 * A binding may not reuse the subject's name.
 *
 * `case Circle(s):` where the subject is also `s` would put two meanings on one name for the length
 * of the arm — the payload and the value it came out of — and the language refuses rather than
 * choosing one.
 */
void checkBindingCollision(C c, Expr subject, Arm arm) {
  string nm = subjectName(c, subject);
  for (i32 b = 0; b < arm.bindingToks.len(); b++) {
    string bt = tokenText(c, arm.bindingToks[b]);
    // **`_` is a deliberate discard and may repeat.** It is the wildcard for a payload field nobody
    // wants a name for, so `case Ok(_, _, _, _, _, _)` names nothing six times rather than one thing
    // six times. Treating it as a name made the duplicate rule below report in 19 places across
    // `packages/http`, `packages/json` and their oracles — working files, caught by rung 3, which is
    // the corpus that exists for exactly this. `issues/lang/0239a`.
    if (bt == "_") { continue; }
    if (nm != "" && bt == nm) {
      c.reportTok(errBindingCollision(), arm.bindingToks[b], "");
      continue;
    }
    // **And against each other, which is the same rule with both names from the payload.**
    // `case A(n, n)` compiled, and the *second* binding won: `A(7, 9)` answered 9. The reference
    // refuses it — *"duplicate binding 'n' in case 'A'"* — and silently choosing one of two meanings
    // is what the subject check above exists to prevent. Reported at the later binding, which is the
    // one to rename.
    //
    // The reference keeps a set of the bindings it accepted and says "duplicate" once per repeat; this
    // loop compares against every earlier twin, so `A(n, n, n)` reaches the third `n` with two matches.
    // `break` makes that one report rather than two. **It is not what makes the count agree** — the two
    // would land at one position with one code and `report` collapses a repeat of the diagnostic
    // immediately before it, which was measured by taking the `break` out and watching the count stay
    // at two. It is here so the count does not *depend* on those two reports staying adjacent.
    for (i32 d = 0; d < b; d++) {
      if (tokenText(c, arm.bindingToks[d]) == bt) {
        c.reportTok(errDuplicateBinding(), arm.bindingToks[b], "");
        break;
      }
    }
  }
}

string armNarrowing(C c, Expr subject, Arm arm) {
  if (arm.variantTok < 0) { return ""; }
  match (subject.kind) {
    case Ident(tok): {
      string nm = tokenText(c, tok);
      string was = c.typeOfName(nm);
      if (was == typeNone()) { return ""; }
      string variant = tokenText(c, arm.variantTok);
      if (!c.isStruct(variant)) { return ""; }
      c.setType(nm, variant);
      return was;
    }
    else: { return ""; }
  }
}

void restoreNarrowing(C c, Expr subject, string was) {
  if (was == "") { return; }
  match (subject.kind) {
    case Ident(tok): { c.setType(tokenText(c, tok), was); }
    else: { }
  }
}

/** Check one program, and return `(code, line, col)` triples in source order. */
/**
 * Two declarations of one name, at file scope and inside a struct.
 *
 * The **positions are the reference's**, and they are not where a reader would guess: a duplicate
 * *declaration* is reported at the declaration's own start — the `i32` of `i32 foo()`, not the
 * `foo` — and a duplicate *member* at its type's start for the same reason. This slice reports a
 * subset of the reference and never a superset, so a position that is merely reasonable is a
 * contradiction; these were read off the reference one case at a time.
 */
/**
 * The two declaration rules the spec states and this checker did not.
 *
 * **`E.A` cannot mean two things.** A variant is reached as `E.A` and so is a static, so an enum
 * whose method is named after one of its own variants has a name with two meanings —
 * `spec/spec/enums.md` makes a variant a name in its own right, and this is that rule inside the
 * enum rather than across the file.
 *
 * **A generic that instantiates itself with a *larger* argument never terminates.**
 * `struct Rec<T> { Rec<Box<T>>? next; }` is the spec's own example: `Rec<i32>` needs `Rec<Box<i32>>`
 * needs `Rec<Box<Box<i32>>>`. The test is *growth*, not self-reference: `Node<T> { Node<T>? next; }`
 * is an ordinary linked list, and `Pair<A, B> { Pair<B, A>? swap; }` cycles between two
 * instantiations and terminates. What cannot terminate is an argument that *contains* a parameter
 * without being it. The spec caps nesting at 24 rather than reasoning about shape; this rejects the
 * shape, which is narrower, and a program it accepts is one the cap would have caught anyway.
 */
/**
 * The two collision rules `spec/spec/naming.md` states about imports.
 *
 * *"Two imports with the same name is a compile error"* (`§wac-dup-import-vqn4100`), and *"an import
 * colliding with a local name is a compile error"* (`§wac-dup-import-local-4fadlvg`). Both are
 * decidable from the importing file alone — its import list and its own declarations — which is why
 * they are here rather than waiting on anything that reads the other files.
 *
 * Reported at the second mention, which is the one that could have been written differently: the
 * spec's own remedy is `import { foo as bar }`, and it is the later import that takes the rename.
 */
void checkImportCollisions(C c, Program prog) {
  string[] seen = string[256]();
  i32 n = 0;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case Import(pathTok, prefixTok, items): {
        for (i32 i = 0; i < items.len(); i++) {
          // **An item the parse did not finish has no alias, and `""` is not a name.** A failed import
          // — `import * as p from "./p.wac";`, which the parser refuses with *expected '{', found '*'* —
          // leaves `aliasTok` at -1 and `tokenText` answers `""`. That empty string then compared equal
          // to `declaredNameOf` for every declaration that introduces no name, so the item "collided"
          // and the report below indexed the token table at **-1**: *array element access out of
          // bounds*, a trap rather than a diagnostic. No user path reached it, because `wac check` and
          // `wac build` stop at the parse error; `dumpTypeErrors` does not stop, and every harness that
          // asks the checker about generated input goes through it.
          if (items[i].aliasTok < 0) { continue; }
          string alias = tokenText(c, items[i].aliasTok);
          if (alias == "") { continue; }
          bool clash = false;
          for (i32 k = 0; k < n; k++) {
            if (seen[k] == alias) { clash = true; }
          }
          if (!clash) {
            for (i32 e = 0; e < prog.decls.len(); e++) {
              if (declaredNameOf(c, prog.decls[e]) == alias) { clash = true; }
            }
          }
          if (clash) {
            c.reportTok(errDuplicateImport(), items[i].aliasTok, "");
          } else if (n < seen.len()) {
            seen[n] = alias;
            n = n + 1;
          }
        }
      }
      else: { }
    }
  }
}

/** The name a declaration introduces, or `""` — an import introduces one too, and is not one. */
string declaredNameOf(C c, Decl d) {
  match (d.kind) {
    case Func(nameTok, returnType, params, body, exported, typeParams): {
      return tokenText(c, nameTok);
    }
    case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
      return tokenText(c, nameTok);
    }
    case EnumDecl(nameTok, variants, exported, methods, typeParams): { return tokenText(c, nameTok); }
    case ConstDecl(nameTok, type, init, exported): { return tokenText(c, nameTok); }
    else: { return ""; }
  }
}

void checkDeclarationRules(C c, Program prog) {
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case EnumDecl(nameTok, variants, exported, methods, typeParams): {
        for (i32 m = 0; m < methods.len(); m++) {
          string mn = tokenText(c, methods[m].nameTok);
          for (i32 v = 0; v < variants.len(); v++) {
            if (tokenText(c, variants[v].nameTok) != mn) { continue; }
            c.reportTok(errVariantMethodClash(), methods[m].nameTok, "");
          }
        }
      }
      case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        if (typeParams.len() == 0) { continue; }
        // Not named `self`: a wac local by that name has no wapy rendering — `issues/lang/0077` —
        // and this file round-trips through wapy on every suite run, which is where that showed up.
        string owner = tokenText(c, nameTok);
        for (i32 f = 0; f < fields.len(); f++) {
          if (!growsItself(c, fields[f].type, owner, typeParams)) { continue; }
          c.report(errInfiniteGeneric(), fields[f].type.line, fields[f].type.col);
        }
      }
      else: { }
    }
  }
}

/** Whether this written type is the struct itself with an argument that *contains* a parameter. */
bool growsItself(C c, Ty t, string owner, i32[] typeParams) {
  match (t.kind) {
    case Arr(elem): { return growsItself(c, elem, owner, typeParams); }
    case Nullable(inner): { return growsItself(c, inner, owner, typeParams); }
    case Named(tok, typeArgs): {
      if (tokenText(c, tok) == owner) {
        for (i32 i = 0; i < typeArgs.len(); i++) {
          if (argumentGrows(c, typeArgs[i], typeParams)) { return true; }
        }
      }
      for (i32 i = 0; i < typeArgs.len(); i++) {
        if (growsItself(c, typeArgs[i], owner, typeParams)) { return true; }
      }
      return false;
    }
    else: { return false; }
  }
}

/** Whether an argument mentions a type parameter without being one: `Box<T>` does, `T` does not. */
bool argumentGrows(C c, Ty t, i32[] typeParams) {
  match (t.kind) {
    case Named(tok, typeArgs): {
      string nm = tokenText(c, tok);
      for (i32 i = 0; i < typeParams.len(); i++) {
        if (tokenText(c, typeParams[i]) == nm) { return false; }
      }
      for (i32 i = 0; i < typeArgs.len(); i++) {
        if (mentionsParam(c, typeArgs[i], typeParams)) { return true; }
      }
      return false;
    }
    case Arr(elem): { return mentionsParam(c, elem, typeParams); }
    case Nullable(inner): { return argumentGrows(c, inner, typeParams); }
    else: { return false; }
  }
}

/** Whether a written type mentions one of these parameters anywhere inside it. */
bool mentionsParam(C c, Ty t, i32[] typeParams) {
  match (t.kind) {
    case Named(tok, typeArgs): {
      string nm = tokenText(c, tok);
      for (i32 i = 0; i < typeParams.len(); i++) {
        if (tokenText(c, typeParams[i]) == nm) { return true; }
      }
      for (i32 i = 0; i < typeArgs.len(); i++) {
        if (mentionsParam(c, typeArgs[i], typeParams)) { return true; }
      }
      return false;
    }
    case Arr(elem): { return mentionsParam(c, elem, typeParams); }
    case Nullable(inner): { return mentionsParam(c, inner, typeParams); }
    else: { return false; }
  }
}

/**
 * A line number for a diagnostic's note.
 *
 * Local rather than imported: `numText` lives in the emitter, and the checker does not depend on it —
 * a diagnostic wanting to say "line 12" is not a reason to make the front end depend on the back one.
 */
string lineText(i32 v) {
  if (v <= 0) { return "?"; }
  string out = "";
  i32 x = v;
  while (x > 0) {
    i32 d = x % 10;
    out = "0123456789".slice(d, d + 1) + out;
    x = x / 10;
  }
  return out;
}

void checkDuplicates(C c, Program prog) {
  string[] names = string[512]();
  i32[] nameLines = i32[512]();
  i32 n = 0;
  // A variant is reachable as a bare name — `Circle(1.0)` with no `Shape.` in front of it — so two
  // enums declaring one leave the file with a name that means two things. Kept across the whole walk
  // rather than per enum, which is the only way the collision is visible at all. `spec/cases/0073`.
  string[] variantNames = string[256]();
  // Where each was declared, so a collision can name **both** places. A message that says only
  // "declared twice" at the second one leaves a reader searching for the first, which in a file with
  // an enum of twenty variants is the whole of the work. `issues/lang/0114`.
  i32[] variantLines = i32[256]();
  i32 vn = 0;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    string name = "";
    match (prog.decls[d].kind) {
      case Func(nameTok, returnType, params, body, exported, typeParams): {
        name = tokenText(c, nameTok);
      }
      case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        name = tokenText(c, nameTok);
        // A struct's members share one namespace: two fields, two methods, or one of each.
        string[] members = string[256]();
        i32 m = 0;
        for (i32 f = 0; f < fields.len(); f++) {
          string fname = tokenText(c, fields[f].nameTok);
          bool dup = false;
          for (i32 k = 0; k < m; k++) {
            if (members[k] == fname) { dup = true; }
          }
          if (dup) {
            c.reportWith(errDuplicateMember(), fields[f].type.line, fields[f].type.col,
                         fname + " appears twice");
          }
          if (m < members.len()) {
            members[m] = fname;
            m = m + 1;
          }
        }
        for (i32 t = 0; t < methods.len(); t++) {
          string mn = tokenText(c, methods[t].nameTok);
          bool dup2 = false;
          for (i32 k = 0; k < m; k++) {
            if (members[k] == mn) { dup2 = true; }
          }
          if (dup2) {
            c.report(errDuplicateMember(), methods[t].returnType.line, methods[t].returnType.col);
          }
          if (m < members.len()) {
            members[m] = mn;
            m = m + 1;
          }
        }
      }
      case EnumDecl(nameTok, variants, exported, methods, typeParams): {
        name = tokenText(c, nameTok);
        for (i32 v = 0; v < variants.len(); v++) {
          string vname = tokenText(c, variants[v].nameTok);
          i32 dupv = -1;
          for (i32 k = 0; k < vn; k++) {
            if (variantNames[k] == vname) { dupv = variantLines[k]; }
          }
          // **And against the names already at file scope.** A variant is reachable bare — `Thing(7)`
          // with no `E.` in front — so it shares a namespace with every struct, enum, function and
          // constant in the file, and the two lists were never compared with each other. A `struct
          // Thing` beside a variant `Thing` was reported as *wrong number of arguments to the
          // constructor* at the call site in one order, and **not at all** in the other, while the
          // reference said *duplicate name* for both. `issues/lang/0114`.
          for (i32 k = 0; k < n; k++) {
            if (names[k] == vname) { dupv = nameLines[k]; }
          }
          if (dupv >= 0) {
            c.reportTok(errDuplicateName(), variants[v].nameTok,
                        vname + " is declared twice — the first is on line " + lineText(dupv));
          }
          if (vn < variantNames.len()) {
            variantNames[vn] = vname;
            variantLines[vn] = variants[v].nameTok < 0 ? 0 : tokenLine(c, variants[v].nameTok);
            vn = vn + 1;
          }
        }
        // A variant's payload fields are named like a struct's, and collide like them.
        for (i32 v = 0; v < variants.len(); v++) {
          string[] payload = string[64]();
          i32 pn = 0;
          for (i32 f = 0; f < variants[v].fields.len(); f++) {
            string pname = tokenText(c, variants[v].fields[f].nameTok);
            bool dup3 = false;
            for (i32 k = 0; k < pn; k++) {
              if (payload[k] == pname) { dup3 = true; }
            }
            if (dup3) {
              c.reportWith(errDuplicateMember(), variants[v].fields[f].type.line,
                         variants[v].fields[f].type.col, pname + " appears twice");
            }
            if (pn < payload.len()) {
              payload[pn] = pname;
              pn = pn + 1;
            }
          }
        }
      }
      case ConstDecl(nameTok, type, init, exported): { name = tokenText(c, nameTok); }
      else: { }
    }
    if (name == "") { continue; }
    i32 seen = -1;
    for (i32 k = 0; k < n; k++) {
      if (names[k] == name) { seen = nameLines[k]; }
    }
    // The other direction of the same collision: a declaration whose name a variant already took.
    for (i32 k = 0; k < vn; k++) {
      if (variantNames[k] == name) { seen = variantLines[k]; }
    }
    if (seen >= 0) {
      c.reportWith(errDuplicateName(), prog.decls[d].line, prog.decls[d].col,
                   name + " is declared twice — the first is on line " + lineText(seen));
    }
    if (n < names.len()) {
      names[n] = name;
      nameLines[n] = prog.decls[d].line;
      n = n + 1;
    }
  }
}

export i32[] checkProgram(u8[] src, i32[] toks, i32 tokenCount, Program prog) {
  C c = C.create(src, toks, tokenCount, tokenCount);
  // **One file was supplied, so every quoted specifier that is not a built-in tree names a file
  // nobody gave.** Read off the parse rather than by scanning the text, which also keeps `files.wac`
  // out of this file's imports.
  //
  // **The reason given here used to be a cycle, and there is no cycle.** It said `files.wac` "imports
  // `emit.wac`, and `emit.wac` imports this" — the first clause is true and the second is not. Checked
  // 2026-08-21: `emit.wac` imports lex, coretext, lit, parse, path, ast and kinds, and nothing imports
  // `check.wac` except `api.wac`. The two are siblings, so `check → files → emit` would be acyclic. The
  // honest reason to read off the parse is that it needs no resolver at all for a single file, which is
  // a smaller claim and still a good one. `issues/lang/0157`. The
  // files-based entry point does the same job with a real path map, in `api.wac` — where it resolves
  // each specifier with `resolveVia` and tests it against the map, so a mapped or project specifier is
  // not mistaken for a missing file. That half landed 2026-08-21; this sentence described it for a day
  // before it existed. `issues/lang/0157`.
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case Import(pathTok, prefixTok, items): {
        if (pathTok < 0) { continue; }
        string q = tokenText(c, pathTok);
        string bare = q.len() >= 2 ? q.slice(1, q.len() - 1) : "";
        if (bare != "" && !isBuiltinSpec(bare)) { c.addUnresolved(bare); }
      }
      else: { }
    }
  }
  checkModule(c, prog);
  return errorsOf(c);
}

/** The `(code, line, col)` triples a finished check answers with. */
export i32[] errorsOf(C c) {
  i32[] out = i32[c.errorCount * 3]();
  for (i32 i = 0; i < c.errorCount * 3; i++) { out[i] = c.errors[i]; }
  return out;
}

/** The warnings, in the same `(code, line, col)` shape and from their own table. */
export i32[] warningsOf(C c) {
  i32[] out = i32[c.warnCount * 3]();
  for (i32 i = 0; i < c.warnCount * 3; i++) { out[i] = c.warnings[i]; }
  return out;
}

/** The operands of each diagnostic, in the same order — `""` where the site had none to give. */
export string[] notesOf(C c) {
  string[] out = string[c.errorCount]();
  for (i32 i = 0; i < c.errorCount; i++) {
    out[i] = i < c.errorNotes.len() ? c.errorNotes[i] : "";
  }
  return out;
}

/** The hint written for each diagnostic, in the same order — empty where the code's own is right. */
export string[] hintsOf(C c) {
  string[] out = string[c.errorCount]();
  for (i32 i = 0; i < c.errorCount; i++) {
    out[i] = i < c.errorHints.len() ? c.errorHints[i] : "";
  }
  return out;
}

/** How wide each diagnostic is, in the same order — `0` where nothing measured one. */
export i32[] widthsOf(C c) {
  i32[] out = i32[c.errorCount]();
  for (i32 i = 0; i < c.errorCount; i++) {
    out[i] = i < c.errorWidths.len() ? c.errorWidths[i] : 0;
  }
  return out;
}

/** The first line to print for each diagnostic, in the same order — `0` for the caret's line alone. */
export i32[] contextsOf(C c) {
  i32[] out = i32[c.errorCount]();
  for (i32 i = 0; i < c.errorCount; i++) {
    out[i] = i < c.errorContexts.len() ? c.errorContexts[i] : 0;
  }
  return out;
}

/**
 * Everything this checker does to one module, against whatever is already declared in `c`.
 *
 * Split out so a file's **imports** can be run through it first with `c.quiet` set: their
 * declarations land in the same tables, their diagnostics are thrown away, and the file that matters
 * is then checked with every name it can see. A single file is that with an empty `c` and nothing
 * quiet, which is what `checkProgram` is.
 */
/**
 * Everything a module *declares*, into `c` — and, when `only` is non-empty, **only the names in it**.
 *
 * Split from the checking passes so a file's imports can contribute their declarations without being
 * checked. The filter is what makes that safe: every table in this checker is keyed by a bare name
 * and the first declaration of one wins, so letting an import contribute every name it happens to
 * hold put another file's `Rng` in front of this file's — forty working files reported as errors.
 * `import { X } from "…"` says exactly which names cross, and this honours it.
 *
 * A type that crosses brings its members with it: the filter is asked about the struct, and its
 * fields and methods follow, because a name reaches them through the type rather than on its own.
 */
export void declareModule(C c, Program prog, string[] only) {
  // Module-level `const` declarations, which are in scope in every body and outlive `clearScope`.
  // A write to one is *"cannot assign to constant 'S'"*, which is the const-variable rule reaching a
  // scope it did not have — and reaching it through fields too: `S.v = 9` on a `const P S` is refused
  // the way a `const P p` parameter is.
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case ConstDecl(nameTok, type, init, exported): {
        if (!wantedName(only, tokenText(c, nameTok))) { continue; }
        c.declareConst(c.renamed(tokenText(c, nameTok)), typeOfTy(c, type), true);
        c.noteFuncArity(funcrefArityOfTy(c, type));
      }
      else: { }
    }
  }
  c.globalCount = c.nameCount;

  // Signatures first, over the whole file: a call names something declared elsewhere, and often
  // further down. The same argument as collecting locals before walking a body, one scope up.
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case EnumDecl(nameTok, variants, exported, methods, typeParams): {
        if (!wantedName(only, tokenText(c, nameTok))) { continue; }
        string[] etps = string[typeParams.len()]();
        for (i32 i = 0; i < typeParams.len(); i++) { etps[i] = tokenText(c, typeParams[i]); }
        c.declareEnum(c.renamed(tokenText(c, nameTok)), etps);
        // Each variant is a type of its own, with its payload as fields. `s is Circle` narrows `s`
        // to `Circle`, and `s.radius` then has to find a `radius` somewhere — so the variant has to
        // be as much a struct as anything else here. Registered under its bare name, which is how
        // `is` writes it; the qualified `Shape.Circle` is a construction and goes elsewhere.
        for (i32 vi = 0; vi < variants.len(); vi++) {
          string vname = tokenText(c, variants[vi].nameTok);
          // **A generic enum's variants have no bare name.** `Some` belongs to `Option<i32>` and to
          // every other instance, so it names no type on its own — `a is Some` is a name nobody
          // declared rather than a narrowing (`spec/cases/0037`). A non-generic enum's variant *is*
          // a bare name, which is how `s is Circle` narrows.
          //
          // The variant still goes in the table, because `Option.None` is how one is written and
          // that has to keep working — skipping the registration entirely refused four working files
          // and `spec/tour.wac` itself. What it loses is the bare *type*: `spec/cases/0042`.
          bool bare = typeParams.len() == 0;
          if (bare) { c.declareStruct(vname, "", string[0]()); }
          // **Under the name this file calls the enum**, which is `c.renamed` — the same wrapper
          // `declareEnum` seventeen lines above already uses. Without it an aliased import registered
          // the *enum* as `E2` and its variants as belonging to `E`, so `E2.A` was "no variant of that
          // name" while `E2` worked perfectly as a parameter type (`issues/lang/0161`).
          c.declareVariant(c.renamed(tokenText(c, nameTok)), vname, variants[vi].fields.len());
          c.markVariantBare(vname, bare);
          for (i32 fi = 0; fi < variants[vi].fields.len(); fi++) {
            c.declareFieldConst(vname, tokenText(c, variants[vi].fields[fi].nameTok),
                                typeOfTy(c, variants[vi].fields[fi].type), false);
          }
        }
        // **An enum's methods, which were never declared at all.** `enum E { … i32 val(const this) }`
        // put `val` nowhere, so `e.val()` was unreported only because an enum is not a struct and the
        // method check returns on anything else — silence by accident rather than by rule. Declared
        // under the enum's own name, which is where a receiver typed `E` looks, and where a variant
        // narrowed out of it looks too.
        string ename = tokenText(c, nameTok);
        for (i32 mi = 0; mi < methods.len(); mi++) {
          string[] emps = string[methods[mi].params.len()]();
          for (i32 pi = 0; pi < methods[mi].params.len(); pi++) {
            emps[pi] = typeOfTy(c, methods[mi].params[pi].type);
          }
          // **A generic enum's method answers its return type as *written*, for the call site to
          // substitute.** It used to be erased to unknown here, and the reason given was that "there is
          // no substitution for an enum — the parameter table belongs to structs". That stopped being
          // true: `substituteType` reads the enum table too, which `spec/cases/0046` is about. So the
          // eighteen programs that broke when the letter was recorded raw are handled by substituting
          // it, and erasing it cost the type of every method call on a generic enum — `export bool f()
          // { return o.isSome(); }` where `isSome` answers an `i32` was accepted.
          //
          // Written rather than resolved, because this pass does not put the enum's letters in scope:
          // `typeOfTy` would answer unknown for `T` and we would be back where we started.
          bool gen = typeParams.len() > 0;
          c.declareMethod(ename, tokenText(c, methods[mi].nameTok),
                          !methods[mi].hasThis, methods[mi].thisConst,
                          gen ? writtenTy(c, methods[mi].returnType)
                              : typeOfTy(c, methods[mi].returnType), emps,
                          methods[mi].body, methods[mi].typeParams.len() > 0);
        }
      }
      case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        // Filtered on the name the declaring file wrote, declared under the name the importing
        // file gave it: `only` carries what was asked for, the rename carries what to call it.
        string name = tokenText(c, nameTok);
        if (!wantedName(only, name)) { continue; }
        name = c.renamed(name);
        string[] tps = string[typeParams.len()]();
        for (i32 i = 0; i < typeParams.len(); i++) { tps[i] = tokenText(c, typeParams[i]); }
        c.declareStruct(name, parentTok < 0 ? "" : tokenText(c, parentTok), tps);
        // A generic struct's fields are not recorded. `struct Box<T> { T v; }` has a field whose
        // type is the *parameter* `T`, which is a name like any other to `typeOfTy` and therefore
        // looks like a struct called `T` — enough to make `Box(1)` a field mismatch against a type
        // that does not exist. The spec corpus caught it:
        // `[§wac-generic-expected-position-3qmz8vk]`. With no fields recorded the arity is zero,
        // never matches, and construction of a generic says nothing — which is the honest answer
        // until instantiation is modelled.
        // Generics included, and their field types recorded **as written** — `T`, `T[]`. A name like
        // `T` is meaningless on its own, and becomes a type only once an instantiation says what its
        // arguments are, which is what `substituteType` does at every lookup. Recording nothing, as
        // the first version did, made every generic's members invisible rather than unknown.
        for (i32 i = 0; i < fields.len(); i++) {
          // `const struct Config { … }` makes every field const without any of them saying so,
          // which is the whole point of the spelling: one word instead of one per field.
          c.declareFieldConst(name, tokenText(c, fields[i].nameTok),
                              typeOfTy(c, fields[i].type), isConst || fields[i].isConst);
        }
        for (i32 i = 0; i < methods.len(); i++) {
          // The method's own letters, so its declared types resolve while they are being recorded —
          // see `addActiveParams`.
          i32 savedActive = addActiveParams(c, methods[i].typeParams);
          string[] mps = string[methods[i].params.len()]();
          for (i32 pi = 0; pi < methods[i].params.len(); pi++) {
            mps[pi] = typeOfTy(c, methods[i].params[pi].type);
          }
          c.declareMethod(name, tokenText(c, methods[i].nameTok),
                          !methods[i].hasThis, methods[i].thisConst,
                          typeOfTy(c, methods[i].returnType), mps,
                          methods[i].body, methods[i].typeParams.len() > 0);
          c.activeParamCount = savedActive;
        }
      }
      else: { }
    }
  }
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case Func(nameTok, returnType, params, body, exported, typeParams): {
        // A generic function's signature is written in terms of its own type parameters, which mean
        // nothing at a call site: `Box<T>` accepts every `Box<…>`, and `T` accepts everything. Its
        // arity is still worth having — that does not depend on the types — so the parameters are
        // recorded as unknown rather than the function being left out.
        // Recorded **as written**, generics included: `Box<T>` and `T` are what a call site binds
        // against. An earlier version blanked them, which was right when nothing could bind them and
        // is now the thing standing between a generic call and its return type.
        if (!wantedName(only, tokenText(c, nameTok))) { continue; }
        string[] prims = string[params.len()]();
        for (i32 i = 0; i < params.len(); i++) { prims[i] = typeOfTy(c, params[i].type); }
        string[] ftps = string[typeParams.len()]();
        for (i32 i = 0; i < typeParams.len(); i++) { ftps[i] = tokenText(c, typeParams[i]); }
        c.declareFunc(c.renamed(tokenText(c, nameTok)), typeOfTy(c, returnType), prims,
                      params.len(), ftps);
      }
      else: { }
    }
  }
}

/**
 * Every arm names a variant the subject's enum actually has.
 *
 * Reported at the **`case`**, which is the token before the name — the reference's position, and one
 * this checker can reach because the tokens are a flat array and the arm knows its own index.
 *
 * Asked of the enum the subject *is*: a variant belonging to some other enum is not this one's, and
 * an instantiation asks its template, since `Opt<i32>` and `Opt` have the same variants by
 * construction.
 */
/**
 * The enum a subject is a value of — `E` for an `E`, and `E` for an `E.A(1)`.
 *
 * A variant construction has the *variant's* own type, because a variant is registered as a struct
 * of its own: that is how `case A:` narrows and how a payload is found. So `match (E.A(1))` asked
 * `isEnum` about `A` and was told no, and every rule keyed on that question — exhaustiveness, a
 * duplicated arm, a name no variant declares — said nothing at all about the whole match.
 * Ambiguity answers `""`: two enums declaring one variant name cannot happen in a file
 * (`spec/cases/0073`), but one of them may be imported, and then the payload under that name
 * belongs to neither. `spec/cases/0093`.
 */
string enumOfSubject(C c, string t, bool built) {
  string base = genericBase(t);
  string owner = base == "" ? t : base;
  if (c.isEnum(owner)) { return owner; }
  // **Only for a subject this file built itself.** `match (E.A(1))`'s type is the variant `A`, and
  // mapping it to `E` is the whole point of this function. But a *type name* that happens to match a
  // local variant is a different thing: `packages/git/src/repo.wac` declares `RepoAt.Opened` and
  // matches a value whose type is `pack.wac`'s `enum Opened`, which it never imported — so the name
  // resolved to `RepoAt`, and every arm of the real enum came back as "no variant of that name".
  // A name is only read as a variant when the expression in hand is a construction of one.
  if (!built) { return ""; }
  i32 owners = 0;
  string only = "";
  for (i32 i = 0; i < c.variantCount; i++) {
    if (c.variantNames[i] != owner) { continue; }
    owners = owners + 1;
    only = c.variantOwners[i];
  }
  return owners == 1 ? only : "";
}

void checkArmVariants(C c, Expr subject, Arm[] arms) {
  string t = typeOfExpr(c, subject);
  if (t == typeNone() || t == "") { return; }
  // **A nullable subject has no arm for the null.** Asked before the enum question, because
  // `Shape?` is not an enum name and the check below would bail out on it and say nothing.
  if (withoutNull(t) != "") {
    c.report(errMatchNullable(), subject.line, subject.col);
    return;
  }
  string owner = enumOfSubject(c, t, isVariantConstruction(c, subject));
  // **A subject that is not an enum at all**, which this returned for silently — so `match (someI32)`
  // compiled, along with every other non-enum subject: twelve of the thirteen types a grid tries.
  // The reference answers *"match requires an enum value, got i32"*.
  //
  // The silence was right for a subject this checker cannot *type* — an unknown answers nothing, and
  // that is still the branch above. What was wrong is treating "typed, and not an enum" as the same
  // case. A generic is exempt for the usual reason: its instantiation is not modelled here, so an
  // empty answer means unmodelled rather than absent.
  //
  // **Phrased as "is it one of these" rather than "is it not an enum"**, which is the same choice the
  // `is` rule explains a few hundred lines up, for the same reason and after the same mistake. The
  // negative form fires on any name this file cannot resolve — `JsonValue` imported from a file the
  // caller did not supply is not an enum *here* — and it turned fifteen of the repository's own
  // files red, `packages/json` and `packages/url` among them. The positive form only ever fires on a
  // type this checker can name, which is the direction to be wrong in.
  //
  // `c.isStruct` is true of a **variant**, which is a struct holding the payload — and
  // `packages/git/src/repo.wac` matches on another file's `Opened` while declaring a variant of its
  // own by that name, so the subject resolved to a struct and this reported a correct program. The
  // file is the one the paragraph below is already about, which is a fair warning that its shape is
  // the one to test any rule here against.
  bool notEnum = (isValueType(t) || t == "string" || isArrayName(t) || startsWithFn(t) ||
                  t == "anyref" || t == "i31ref" || c.isStruct(t)) &&
                 variantOwnerOf(c, t) == "";
  if (owner == "" && notEnum && !c.isGeneric(t) && !isVariantConstruction(c, subject)) {
    c.report(errMatchNotEnum(), subject.line, subject.col);
    return;
  }
  if (owner == "" || !c.isEnum(owner)) { return; }
  // **And the file has to be able to see what that enum holds.** `packages/git/src/repo.wac` matches
  // on `pack.wac`'s `enum Opened` while declaring a variant of its own called `Opened`, and imports
  // the *function* rather than the enum — so the name resolves to an enum whose variants are not in
  // this file's table at all. Every rule below counts them: an arm was "no variant of that name"
  // and the match "does not cover every variant", both about an enum nobody here can enumerate.
  // Nothing is knowable, which is the same answer an unknown subject gets. `spec/cases/0095`.
  i32 known = 0;
  for (i32 k = 0; k < c.variantCount; k++) {
    if (c.variantOwners[k] == owner) { known = known + 1; }
  }
  if (known == 0) { return; }
  // **Reported only for a name that is nobody's variant.** Belonging to *this* enum is the question
  // the reference answers, and answering it needs to know which file the subject's type came from —
  // the provenance this checker does not keep, and the reason `case Match:` in `packages/ssh` was
  // refused while being perfectly correct. A name no enum anywhere declares is wrong under every
  // reading, and that is the half worth reporting.
  for (i32 i = 0; i < arms.len(); i++) {
    if (arms[i].variantTok <= 0) { continue; }
    string vn = tokenText(c, arms[i].variantTok);
    bool anywhere = false;
    for (i32 k = 0; k < c.variantCount; k++) {
      if (c.variantNames[k] == vn) { anywhere = true; }
    }
    if (anywhere) { continue; }
    c.reportTok(errNoVariant(), arms[i].variantTok - 1, "");
  }

  // **The names an arm binds, against the payload the variant has.** `case C(p, q)` for a variant with
  // one field bound a name to nothing; the whole category was uncaught. Non-zero and unequal, at the
  // `case` keyword, both of which are the reference's contract rather than a guess — binding *no*
  // names is how an arm ignores a payload, and it accepts that in silence.
  for (i32 i = 0; i < arms.len(); i++) {
    if (arms[i].variantTok <= 0) { continue; }
    i32 bound = arms[i].bindingToks.len();
    if (bound == 0) { continue; }
    i32 fields = c.variantArityIn(owner, tokenText(c, arms[i].variantTok));
    if (fields < 0) { continue; }
    if (bound != fields) {
      c.reportTok(errArmBindArity(), arms[i].variantTok - 1, "");
    }
  }

  // **The same variant twice.** One arm of the two can never run, and which one is not the point:
  // the second mention is the mistake, so that is where it is reported.
  string[] seen = string[arms.len()]();
  i32 seenCount = 0;
  for (i32 i = 0; i < arms.len(); i++) {
    if (arms[i].variantTok <= 0) { continue; }
    string vn = tokenText(c, arms[i].variantTok);
    bool dup = false;
    for (i32 k = 0; k < seenCount; k++) { if (seen[k] == vn) { dup = true; } }
    if (dup) {
      c.reportTok(errDuplicateCase(), arms[i].variantTok - 1, "");
    } else {
      seen[seenCount] = vn;
      seenCount = seenCount + 1;
    }
  }

  // **Every variant, or an `else`.** Counted against the variants this enum owns rather than against
  // every variant in the file, which is the question that needed provenance — and the comment above
  // said that provenance was missing. It is not any more: `variantOwners` records which enum each
  // variant belongs to, and an imported enum now enters under the importing file's name for it, so
  // two modules' same-named variants no longer answer for each other.
  i32 total = 0;
  i32 covered = 0;
  for (i32 k = 0; k < c.variantCount; k++) {
    if (c.variantOwners[k] != owner) { continue; }
    total = total + 1;
    for (i32 i = 0; i < seenCount; i++) {
      if (seen[i] == c.variantNames[k]) { covered = covered + 1; }
    }
  }
  // An enum whose variants this checker cannot see at all says nothing, by the same rule that keeps
  // it quiet about every other name it cannot resolve.
  if (total == 0) { return; }

  // **Counted, not merely noticed.** This asked *whether* there was an `else`, so a second one was
  // invisible here and reached the emitter, which indexed past the end of an array and trapped the
  // compiler. One `else` is the ordinary case and builds; two is a program nobody writes on purpose and
  // is refused now. `issues/lang/0239a`.
  i32 elseCount = 0;
  for (i32 i = 0; i < arms.len(); i++) { if (arms[i].variantTok < 0) { elseCount = elseCount + 1; } }
  bool hasElse = elseCount > 0;
  if (elseCount > 1) { c.report(errDuplicateElse(), subject.line, subject.col); }

  if (!hasElse && covered < total) {
    c.report(errMatchInexhaustive(), subject.line, subject.col);
  }
  // And the other way round: once every variant is named, an `else` is a branch nothing reaches.
  if (hasElse && covered == total) {
    c.report(errElseUnreachable(), subject.line, subject.col);
  }
}

/** Whether an unfiltered pass, or a filtered one that wants this name. */
bool wantedName(string[] only, string name) {
  if (only.len() == 0) { return true; }
  for (i32 i = 0; i < only.len(); i++) {
    if (only[i] == name) { return true; }
  }
  return false;
}

/**
 * Re-reads the type names written in declarations, now that every declaration is in.
 *
 * `declareModule` resolves a struct's field types while it is still declaring structs, so it cannot
 * be the pass that judges them — `struct Holder { Inner i; }` would be refused whenever `Inner` came
 * later in the file. Bodies need no such pass: they are walked after all of this, and every type they
 * mention goes through `typeOfTy` on the way.
 *
 * A declaration's own type parameters are in scope while its annotations are read, or `Box<T>`'s
 * `T value;` becomes a name nobody declared.
 */
void checkDeclaredTypeNames(C c, Program prog) {
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        setActiveParams(c, typeParams);
        // `struct R : Shape` with no `Shape` anywhere: a parent is a written type name like any
        // other, and every other position that takes one is already checked. Reported at the parent
        // itself, which is the only part of the declaration that is wrong. `spec/cases/0074`.
        if (parentTok >= 0 && !c.isStruct(tokenText(c, parentTok))) {
          c.reportTok(errUndefinedType(), parentTok, "");
        }
        for (i32 i = 0; i < fields.len(); i++) {
          // A packed type has no room for the absent case, in a field exactly as in a parameter or
          // a local — the rule was written for the two positions somebody happened to hit first.
          checkPackedNullable(c, typeOfTy(c, fields[i].type), fields[i].type);
        }
        for (i32 m = 0; m < methods.len(); m++) {
          // The method's own letters, on top of the owner's — see `addActiveParams`.
          i32 savedActive = addActiveParams(c, methods[m].typeParams);
          typeOfTy(c, methods[m].returnType);
          for (i32 i = 0; i < methods[m].params.len(); i++) {
            typeOfTy(c, methods[m].params[i].type);
          }
          c.activeParamCount = savedActive;
        }
        c.activeParamCount = 0;
      }
      case EnumDecl(nameTok, variants, exported, methods, typeParams): {
        setActiveParams(c, typeParams);
        for (i32 v = 0; v < variants.len(); v++) {
          for (i32 i = 0; i < variants[v].fields.len(); i++) {
            checkPackedNullable(c, typeOfTy(c, variants[v].fields[i].type),
                                variants[v].fields[i].type);
          }
        }
        for (i32 m = 0; m < methods.len(); m++) {
          // The method's own letters, on top of the owner's — see `addActiveParams`.
          i32 savedActive = addActiveParams(c, methods[m].typeParams);
          typeOfTy(c, methods[m].returnType);
          for (i32 i = 0; i < methods[m].params.len(); i++) {
            typeOfTy(c, methods[m].params[i].type);
          }
          c.activeParamCount = savedActive;
        }
        c.activeParamCount = 0;
      }
      case Func(nameTok, returnType, params, body, exported, typeParams): {
        setActiveParams(c, typeParams);
        // A return type is the fourth position a type can be written in, and the packed rule is the
        // same in all of them — `spec/cases/0060`.
        checkPackedNullable(c, typeOfTy(c, returnType), returnType);
        // **At the declaration, not at the type.** The reference puts this one at column 1 — the
        // start of the whole declaration rather than the return type's own position, which is where
        // every other packed complaint sits. Read off it rather than made consistent, because a
        // diagnostic in a different place from the reference's is a rung-3 failure whichever of the
        // two reads better.
        checkPackedHere(c, typeOfTy(c, returnType), returnType.line, 1);
        for (i32 i = 0; i < params.len(); i++) { typeOfTy(c, params[i].type); }
        c.activeParamCount = 0;
      }
      case ConstDecl(nameTok, type, init, exported): { typeOfTy(c, type); }
      else: { }
    }
  }
}

/** The type parameters of the declaration being read, which are unknown types rather than names. */
/**
 * Add a method\'s **own** type parameters to the ones already active, and answer the count to restore.
 *
 * A struct\'s letters are set by `setActiveParams`, which resets. A method may introduce its own on
 * top of those — `Pending<U> then<U>(fn[U(T)] f)`, where `U` appears nowhere but that method — so this
 * appends and the caller puts the count back.
 *
 * Without it the *declaration* is an error: `U` is a type nobody declared, and the checker says
 * "undefined type" at the return type. Whether a call to one works is a separate question, and today
 * the answer is no — the emitter refuses it by name.
 */
i32 addActiveParams(C c, i32[] typeParams) {
  i32 saved = c.activeParamCount;
  for (i32 i = 0; i < typeParams.len(); i++) {
    if (c.activeParamCount >= c.activeParams.len()) { continue; }
    c.activeParams[c.activeParamCount] = tokenText(c, typeParams[i]);
    c.activeParamCount = c.activeParamCount + 1;
  }
  return saved;
}

void setActiveParams(C c, i32[] typeParams) {
  c.activeParamCount = 0;
  for (i32 i = 0; i < typeParams.len(); i++) {
    if (c.activeParamCount >= c.activeParams.len()) { continue; }
    c.activeParams[c.activeParamCount] = tokenText(c, typeParams[i]);
    c.activeParamCount = c.activeParamCount + 1;
  }
}

/**
 * Every method body of one struct or enum, in the owner's world.
 *
 * `parent` is the owner's parent or empty — it decides only what `override` is about, so an enum
 * passes empty and the two questions answer *no* for it. The owner's type parameters are already
 * active when this is called; a method's own letters are added on top and taken off again.
 */
void checkMethodBodies(C c, string owner, string parent, Method[] methods) {
  for (i32 mi = 0; mi < methods.len(); mi++) {
    // The method's own letters, added to the owner's for as long as this method is being checked —
    // see `addActiveParams`. This is the pass that has `scopeTypes` on, so it is the one that reports
    // `U` as a type nobody declared.
    i32 savedActive = addActiveParams(c, methods[mi].typeParams);
    // `override` is a claim about a parent, and the language checks it both ways: a method that hides
    // one without saying so, and a method that says so with nothing to hide. The first is reported at
    // the return type — where a method's declaration starts, as with a missing return — and the
    // second at the keyword itself, which is the part that is wrong.
    bool hides = parent != "" && c.methodAt(parent, tokenText(c, methods[mi].nameTok)) >= 0;
    if (methods[mi].isOverride && !hides) {
      c.reportTok(errOverrideSpurious(), methods[mi].overrideTok, "");
    } else if (!methods[mi].isOverride && hides) {
      c.report(errOverrideMissing(), methods[mi].returnType.line, methods[mi].returnType.col);
    }
    c.clearScope();
    // **The function's own body is the outermost scope**, pushed before `this` and the parameters so
    // that they belong to it. `issues/lang/0122`.
    c.pushScope(methods[mi].body);
    // A method without `this` is static, and `this` means nothing in it. A `const this` method may not
    // write through the receiver, which is the same rule as a `const P p` parameter and reuses it.
    if (methods[mi].hasThis) {
      c.declareConst("this", owner, methods[mi].thisConst);
    }
    checkParams(c, methods[mi].params);
    for (i32 i = 0; i < methods[mi].params.len(); i++) {
      c.declareConst(tokenText(c, methods[mi].params[i].nameTok),
                     typeOfTy(c, methods[mi].params[i].type),
                     methods[mi].params[i].isConst);
      c.noteFuncArity(funcrefArityOfTy(c, methods[mi].params[i].type));
    }
    declareAll(c, methods[mi].body);
    checkAll(c, methods[mi].body, methods[mi].returnType);
    c.popScope();
    // At the **return type**, where the reference puts it. A `Method` carries no position of its own —
    // unlike a `Decl`, which is why the top-level version reports at the declaration — and the return
    // type is the first thing a method has that does.
    if (returnsAValue(typeOfTy(c, methods[mi].returnType)) && !alwaysLeaves(methods[mi].body)) {
      c.report(errMissingReturn(), methods[mi].returnType.line, methods[mi].returnType.col);
    }
    c.activeParamCount = savedActive;
  }
}

export void checkModule(C c, Program prog) {
  checkDuplicates(c, prog);
  checkDeclarationRules(c, prog);
  checkImportCollisions(c, prog);
  // Imported names, which this single-file slice cannot resolve but must not call undefined. What is
  // imported is in scope for the whole file, so these sit with the module-level constants.
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case Import(pathTok, prefixTok, items): {
        // **There is no bare specifier any more** — `design/lang/0009` D5, completed 2026-08-19.
        // `core` was the one word an import could name without quotes, on the argument that it was
        // not a file; D4 made it a source tree whose other members are imported quoted, so the root
        // being spelled differently was the odd thing rather than the principled one. Both spellings
        // were accepted while the files using the old one were swept, and this is the removal.
        //
        // Every bare word is `unknown module` now, `core` included. The parser is where the better
        // message lives — it can say *write `from "core"`* — and this is the rule stated on its own
        // terms, which is what `spec/spec/imports.md` asks for.
        if (prefixTok >= 0) {
          c.reportTok(errUnknownModule(), prefixTok, "");
        }
        // A quoted `"core"` was refused here until `design/lang/0009` D5, on the argument that a
        // quoted specifier says *a file lives at this path* and there was no path here to be right
        // about. D4 removed the premise: `core` is a source tree, `core/option.wac` is one of its
        // files and is imported quoted, and the root being the one member written bare is the odd
        // spelling rather than the principled one. Both now resolve, to the same key.
        //
        // Worth recording, because it is the kind of thing that outlives the rule: this refusal
        // reported `unknown module` while the reference reported `` `core` is not a file — import
        // it unquoted `` for the same program. One rule, two implementations, two diagnostics, and
        // nothing compared them — the corpus differential only asks *whether* each side complains.
        // **What `core` exports, and the bar for adding to it.** `spec/spec/imports.md` sets it:
        // a type earns a place here only if a value of it has to cross a *repository* boundary
        // through a funcref signature, because wac has nominal types and no closures. `Read` passes
        // it; `Node` and `Attr` pass it more strongly, since the compiler emits their constructors
        // for JSX and no author picks the name to be able to fix a mismatch — `design/lang/0004`.
        //
        // A name it does not export is `no such export`, the same complaint a `./file.wac` import
        // gets, and it is checkable here because `core` ships inside the compiler rather than
        // living on disk. `spec/cases/0087`.
        // **Asked of the quoted spelling now**, which is the only one there is. This branch used to
        // key on the bare prefix, and removing that form would have made it dead code that still
        // read like a live check — the shape this repository keeps finding late. The specifier is
        // compared without its quotes rather than against a spelling with escaped ones: an escaped
        // quote inside a literal is something `wapy`'s rendering of this file cannot read back, and
        // this source round-trips through it on every suite run.
        string spec = pathTok < 0 ? "" : tokenText(c, pathTok);
        string bare = spec.len() >= 2 ? spec.slice(1, spec.len() - 1) : "";
        // **Nothing at that path.** The caller resolved it — see `errMissingImportFile` — and this is
        // the import's own token, so the message can name the file the way
        // `§wac-diag-parse-bad-type-n7qm3xf` names a type nobody declared.
        if (bare != "" && c.isUnresolved(bare)) {
          c.reportTok(errMissingImportFile(), pathTok, bare);
        }
        if (bare == "core") {
          for (i32 i = 0; i < items.len(); i++) {
            string named = tokenText(c, items[i].nameTok);
            if (named == "Read" || named == "Node" || named == "Attr") { continue; }
            c.reportTok(errNoSuchExport(), items[i].nameTok, "");
          }
        }
        for (i32 i = 0; i < items.len(); i++) {
          // **Only when nothing better is known.** Declaring an imported name as unknown is what
          // makes a single-file check silent about it rather than calling it undefined — but when
          // the file's imports have actually been read, the name already has a struct, an enum or a
          // signature behind it, and a second declaration *poisons* it back to unknown. `Decoded d =
          // decode(raw);` came out a mismatch that way, with both names imported and both known.
          string alias = tokenText(c, items[i].aliasTok);
          if (c.isDeclaredName(alias) || c.isStruct(alias) || c.isEnum(alias)) { continue; }
          c.declare(alias, typeNone());
          // **Declared so the name exists, and marked so nothing reads it as a binding.** The line
          // above is why a single-file check calls an imported name unknown rather than undefined,
          // and `isDeclaredName` is then read by two kinds of rule asking different questions: *does
          // this name exist* and *what is this local's type*. An imported function is a yes to the
          // first and not a subject for the second, and with one answer for both, `typeOfExpr`'s
          // `Ident` arm returned unknown and shadowed the funcref that `declareModule` had already
          // recorded — so `take(MESSAGE)` for an imported `MESSAGE` got no diagnostic and the
          // emitter built the funcref pair for a call wanting an `i32`. `issues/lang/0180a`.
          c.markImportOnly(alias);
        }
        if (prefixTok >= 0 && !c.isDeclaredName(tokenText(c, prefixTok))) {
          c.declare(tokenText(c, prefixTok), typeNone());
        }
      }
      else: { }
    }
  }

  declareModule(c, prog, string[0]());

  // **Every declaration is in, so a name that resolves to nothing now resolves to nothing.** From
  // here a type name this file never brought into scope is an error rather than something unknown,
  // and the declarations written above are re-read under that rule: a struct's field type is
  // resolved during the pass that declares it, when half the file is still unseen.
  c.scopeTypes = true;
  checkDeclaredTypeNames(c, prog);

  // Methods, which until now were not walked at all: every rule here stopped at the edge of a
  // struct, so a method's returns, initialisers and operands went entirely unchecked. `this` is an
  // ordinary `Ident` whose text is `this`, so typing it is one entry in the scope — the struct's own
  // name — and every rule then reaches `this.x` through the field table that already existed.
  // A module-level constant's initialiser, *after* the signatures — the rule is "does this call a
  // function", so it needs to know which names are functions, and a constant may be initialised by
  // one declared further down the file. The first version of this ran before the signature pass and
  // silently found nothing, which looked exactly like the rule not working.
  // **A constant is computed in the order the file writes them**, so its initialiser may only read
  // one that already has a value. Reading itself is the same rule seen close up — `const i32 A = A +
  // 1` has nothing to read yet, and `A = B; B = A` has no order in which either could go first.
  // `spec/cases/0056` and `0057`.
  string[] settled = string[256]();
  i32 settledCount = 0;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case ConstDecl(nameTok, type, init, exported): {
        // **The initialiser is an expression, and nothing was walking it.** Every rule in this file
        // about literals, elements, defaults and names applied to a local's initialiser and to none
        // of these — `const E[] T = E[3]()` was silent where the same line inside a function was
        // refused, and so was `i32[2](fill: "x")`. `spec/cases/0067` and `0068`.
        string constType = typeOfTy(c, type);
        // A constant is a value, and `void` is the absence of one. `spec/cases/0069`.
        if (constType == "void") { c.report(errVoidType(), type.line, type.col); }
        checkPackedNullable(c, constType, type);
        // A literal initialiser is asked whether it fits, exactly as a local's is — `const i32 A =
        // 1.5` is a float in an integer's slot. `spec/cases/0075`.
        if (litKindOf(init) != litNone() && constType != typeNone()) {
          reportLiteral(c, constType, init, errInitTypeMismatch(), init.line, init.col);
        }
        c.expected = constType;
        checkExpr(c, init);
        if (callsAFunction(c, init)) { c.report(errNotCompileTime(), init.line, init.col); }
        if (readsUnsettledConst(c, prog, init, settled, settledCount)) {
          c.report(errNotCompileTime(), init.line, init.col);
        }
        if (settledCount < settled.len()) {
          settled[settledCount] = tokenText(c, nameTok);
          settledCount = settledCount + 1;
        }
      }
      else: { }
    }
  }

  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        string owner = tokenText(c, nameTok);
        // `Box<T>`'s own parameters are in scope for its fields and for every method it declares —
        // `T v;` and `T get(const this)` are the template's, not names the file left undeclared.
        setActiveParams(c, typeParams);
        // A non-null field that reaches its own struct: `struct Node { Node next; }` cannot be built
        // at all, because building one needs one first. Reported at the field's type, which is the
        // only place it *can* be reported — a struct like this is refused on sight, with no
        // construction anywhere in the file to hang the complaint on.
        for (i32 fi = 0; fi < fields.len(); fi++) {
          string ft = typeOfTy(c, fields[fi].type);
          // The same two rules a parameter has, in the other declaration position that takes a type.
          if (isPackedName(ft)) {
            c.report(errPackedPosition(), fields[fi].type.line, fields[fi].type.col);
          }
          if (ft == "void") { c.report(errVoidType(), fields[fi].type.line, fields[fi].type.col); }
          if (isNullableName(ft) || isArrayName(ft) || !c.isStruct(ft)) { continue; }
          if (reachesStruct(c, ft, owner, 0)) {
            c.report(errRecursiveField(), fields[fi].type.line, fields[fi].type.col);
          }
        }
        checkMethodBodies(c, owner, c.parentOf(owner), methods);
        c.activeParamCount = 0;
      }
      // **An enum's methods have bodies too, and nothing was checking them.** This case was the
      // `else` below, so every rule in this file stopped at an enum's brace: a `return "x"` from an
      // `i32` method, an undefined name, a `break` outside a loop — the reference reports all three
      // and this reported none. Found in the mutation sweep, where the missed diagnostics that were
      // not about `match` were all inside an enum method.
      //
      // The same loop as a struct's, because the differences are all absences: an enum has no parent,
      // so `override` has nothing to be about, and its payload types are checked with the variants in
      // the declaration pass rather than here.
      case EnumDecl(nameTok, variants, exported, methods, typeParams): {
        setActiveParams(c, typeParams);
        checkMethodBodies(c, tokenText(c, nameTok), "", methods);
        c.activeParamCount = 0;
      }
      else: { }
    }
  }
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      case Func(nameTok, returnType, params, body, exported, typeParams): {
        // **A generic function's body is checked**, with its type parameters left unknown.
        //
        // It was skipped entirely once, because answering questions about `T` produced wrong answers.
        // But `spec/spec` says `T oops<T>(T a) { i32 x = "hello"; return a; }` is an error, and it is
        // — the mistake in it has nothing to do with `T`. Leaving the parameters unknown is what
        // separates the two: everything involving one is silent by the same rule that keeps this
        // checker quiet about anything it cannot name, and everything concrete is checked as usual.
        // Declarations first, in a pass of their own over the whole body, so a `return` that reads a
        // name declared later still resolves it. A checker that declared as it walked would treat a
        // forward reference as unknown for no reason — the reference has the whole function in hand
        // and so does this.
        c.activeParamCount = 0;
        for (i32 i = 0; i < typeParams.len(); i++) {
          if (c.activeParamCount >= c.activeParams.len()) { continue; }
          c.activeParams[c.activeParamCount] = tokenText(c, typeParams[i]);
          c.activeParamCount = c.activeParamCount + 1;
        }
        c.activeFunc = tokenText(c, nameTok);
        c.clearScope();
        c.pushScope(body);
        checkParams(c, params);
        for (i32 i = 0; i < params.len(); i++) {
          c.declareConst(tokenText(c, params[i].nameTok), typeOfTy(c, params[i].type),
                         params[i].isConst);
          c.noteFuncArity(funcrefArityOfTy(c, params[i].type));
        }
        declareAll(c, body);
        checkAll(c, body, returnType);
        c.popScope();
        // Reported at the declaration rather than at the closing brace, which is where the reference
        // puts it: the fault is the function's, not any one statement's.
        //
        // The type parameters stay in scope for this last question: it reads the return type again,
        // and `T max<T>(T a, T b)` clearing them first made `T` a name nobody had declared.
        if (returnsAValue(typeOfTy(c, returnType)) && !alwaysLeaves(body)) {
          c.report(errMissingReturn(), prog.decls[d].line, prog.decls[d].col);
        }
        c.activeParamCount = 0;
      }
      else: { }
    }
  }
}
