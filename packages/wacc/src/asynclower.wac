// Rewriting an `async` function into ordinary wac — `design/lang/0014` step 4, retargeted onto
// core's `Ticket` by spec/next ch35.
//
// The body becomes a **flattened state machine**: a `while (true)` over a `switch` on a state
// variable, where each `await` ends one arm and begins the next. The machine's locals live in the
// enclosing function and the step is a lambda — so a local that outlives a suspension is *captured*,
// which `design/lang/0002` makes by reference, and there is no frame struct to build. That was the
// discovery that made this small: **the captured local is the state slot.**
//
// What comes out, for `async R f(…) { T x = await e; return g(x); }`:
//
//     Ticket<R> f(…) {
//       i32[] __wacState = i32[].defaulted(1);
//       Ticket<R> __wacT;
//       T[] x = T[].defaulted(1);
//       Ticket<T>? __wacUp0 = null;
//       __wacMachine __wacM = __wacMachine(__wacT, __wacNoStep, __wacScheduleTarget(), 0);
//       fn<bool()> __wacStepFn = () => {
//         while (true) {
//           switch (__wacState[0]) {
//             case 0: { __wacUp0 = e; __wacM.park(__wacUp0); __wacState[0] = 1; return false; }
//             case 1: { x[0] = __wacUp0!.value();
//                       { __wacT.resolve(g(x[0])); return true; } }
//             default: { return true; }
//           }
//         }
//       };
//       __wacM.step = __wacStepFn;
//       __wacState[0] = 0;
//       __wacM.run();                    // eager: runs to the first suspension and stops
//       return __wacT;
//     }
//
// **Every `await` suspends**, settled ticket or not (ch35): `park` records a `Continuation` on the
// machine's ticket, and `run` hands it to the schedule target in force where the call was made. What
// drives the machine on is either that continuation being called — by `sys.drain()`, or whoever holds
// the target — or a `wait` on the ticket, which follows the parked continuation to what it waits on.
// Both reach the same `call`, and `__wacMachine` lets only the current suspension's copy resume it.
//
// **Every hoisted local is a one-element array.** `T[].defaulted(1)` works for any `T`, struct included, which
// is what makes this uniform: there is no default value to invent. The cost is that every mention of
// `x` becomes `x[0]`, which is a substitution rather than a judgement — and it has to reach inside
// lambdas, because a lambda that captured `x` now captures the array.
//
// **`return` is rewritten everywhere except inside a lambda.** A `return` in the body leaves the
// *machine*, so it becomes "settle the ticket, stop stepping". A `return` inside a lambda in the body
// leaves the lambda and must be left exactly as it is — the same distinction the checker makes when
// it clears `inAsync` for a lambda body.
//
// **What an `await` answers has to be written somewhere**, because this pass runs on a tree with no
// types: the slot a value-reading `await` keeps its ticket in is a `Ticket<X>?`. `T x = await e;`
// writes `X`, and `return await e;` writes the function's return type; an `await` nested in a larger
// expression is hoisted into a temporary when `e` is a parameter, a local or a call whose declaration
// in this file says what ticket it is — and declined by name when it is not. An `await` whose value
// is thrown away needs no slot at all: its ticket is parked as a `TicketBase?`.

import {
  Arm, Case, Decl, DeclKind, Expr, ExprKind, JsxAttr, Lvalue, LvalueKind, Method, NamedArg, Param,
  Program, Stmt, StmtKind, Ty, TyKind,
} from "./ast.wac";
import { Lexed, tokenStride } from "./lex.wac";
import { AsyncPlan, awaitInBody, awaitInExpr, awaitInStmt, planBody, planSuspends, statesNeeded } from "./asyncplan.wac";
import {
  synthSource, synthTokens, synthTok, synthTextAt,
  synthTicket, synthValue, synthStep, synthWaiting, synthYielded, synthDone, synthCoroutine,
  synthTicketBase, synthNever, synthState, synthRes, synthMachine, synthStartName, synthOrReady,
  synthTargetSet, synthTargetGet, synthNextName, synthCurrentName, synthStepCall, synthIsDoneName, synthYieldedName,
  synthAssign, synthI32, synthBool, synthVoid, synthStepFn,
  synthOk, synthErr, synthResult, synthTryV, synthTryE, synthGenerator, synthAsyncGenerator,
  synthSlot, synthAw, synthNum, synthZero, synthOne, synthArg,
} from "./asyncsynth.wac";
import { kAndAnd, kAwait, kFor, kIdent, kLparen, kOrOr, kQuestion } from "./kinds.wac";

/** Everything the rewrite needs that is not the statement in front of it. */
struct Ctx {
  i32 first;        // index of the first synthetic token
  i32 ups;          // how many suspension slots the tail carries
  i32 args;         // how many `__wacArgK` names the tail carries — `issues/lang/0294c`
  i32 line;
  i32 col;
  string[] hoisted; // names that have become cells
  u8[] src;
  Lexed lexed;
  /**
   * The next column to hand a synthesised lambda.
   *
   * **Lambdas are keyed by position.** The emitter finds a lambda's hoisted function by the position
   * key its walk recorded — it says so, and its own diagnostic counts the ones *"sharing a position
   * key"*. Three lambdas built at one line and column are three lambdas with one key, and what comes
   * out is a cell of the wrong type rather than a complaint. A cell, because the collision makes the
   * walk believe one lambda captures another.
   */
  i32[] col2;
  /**
   * Whether the walk is currently inside a lambda.
   *
   * Carried here rather than threaded, because `subExpr` needs it too — a `match` used as an
   * *expression* has arm bodies, and a `return` in one of those means what it means in whatever
   * function the walk is in. Threading it would have changed every call site of `subExpr`.
   */
  bool[] inLam;
  /** The state a finished machine sits in, answering `Done` again; set once the states are numbered. */
  i32[] finState;
  /**
   * `Step`'s three type arguments for the machine being built, once known — so a step is built as
   * `Step<W, Y, R>.Done(…)`. Bare `Step` is a name another file of the program may also declare, and
   * a file the lowering writes into need not have imported core's.
   */
  Ty?[] stepWyr;
}

i32 tTicket(Ctx c)     { return synthTok(c.first, synthTicket()); }
i32 tValue(Ctx c)      { return synthTok(c.first, synthValue()); }
i32 tStep(Ctx c)       { return synthTok(c.first, synthStep()); }
i32 tWaiting(Ctx c)    { return synthTok(c.first, synthWaiting()); }
i32 tYielded(Ctx c)    { return synthTok(c.first, synthYielded()); }
i32 tDone(Ctx c)       { return synthTok(c.first, synthDone()); }
i32 tCoroutine(Ctx c)  { return synthTok(c.first, synthCoroutine()); }
i32 tTicketBase(Ctx c) { return synthTok(c.first, synthTicketBase()); }
i32 tNever(Ctx c)      { return synthTok(c.first, synthNever()); }
i32 tState(Ctx c)      { return synthTok(c.first, synthState()); }
i32 tRes(Ctx c)        { return synthTok(c.first, synthRes()); }
i32 tMachine(Ctx c)    { return synthTok(c.first, synthMachine()); }
i32 tStartName(Ctx c)  { return synthTok(c.first, synthStartName()); }
i32 tOrReady(Ctx c)    { return synthTok(c.first, synthOrReady()); }
i32 tTargetSet(Ctx c)  { return synthTok(c.first, synthTargetSet()); }
i32 tEq(Ctx c)         { return synthTok(c.first, synthAssign()); }
i32 tI32(Ctx c)        { return synthTok(c.first, synthI32()); }
i32 tBool(Ctx c)       { return synthTok(c.first, synthBool()); }
i32 tVoid(Ctx c)       { return synthTok(c.first, synthVoid()); }
i32 tStepFn(Ctx c)     { return synthTok(c.first, synthStepFn()); }
i32 tOk(Ctx c)         { return synthTok(c.first, synthOk()); }
i32 tErr(Ctx c)        { return synthTok(c.first, synthErr()); }
i32 tResult(Ctx c)     { return synthTok(c.first, synthResult()); }
i32 tTryV(Ctx c)       { return synthTok(c.first, synthTryV()); }
i32 tTryE(Ctx c)       { return synthTok(c.first, synthTryE()); }
i32 tGenerator(Ctx c)  { return synthTok(c.first, synthGenerator()); }
i32 tAsyncGenerator(Ctx c) { return synthTok(c.first, synthAsyncGenerator()); }
i32 tNextName(Ctx c)   { return synthTok(c.first, synthNextName()); }
i32 tTargetGet(Ctx c)  { return synthTok(c.first, synthTargetGet()); }
i32 tCurrentName(Ctx c) { return synthTok(c.first, synthCurrentName()); }
i32 tStepCall(Ctx c)   { return synthTok(c.first, synthStepCall()); }
i32 tIsDoneName(Ctx c) { return synthTok(c.first, synthIsDoneName()); }
i32 tYieldedName(Ctx c) { return synthTok(c.first, synthYieldedName()); }

i32 tUp(Ctx c, i32 k) { return synthTok(c.first, synthSlot(k)); }
i32 tAw(Ctx c, i32 k) { return synthTok(c.first, synthAw(k)); }
i32 tNum(Ctx c, i32 k) { return synthTok(c.first, synthNum(c.ups, c.args, k)); }
/** The synthetic name an async lambda's parameter `k` is renamed to — `issues/lang/0294c`. */
i32 tArg(Ctx c, i32 k) { return synthTok(c.first, synthArg(c.ups, k)); }

// ── Builders ─────────────────────────────────────────────────────────────────

/**
 * The next unused column.
 *
 * **A declaration is promoted to a cell by its position.** `notePromoted(line, col)` is how the
 * emitter records that a local is captured, and `localIsCell` asks the same way — so two
 * declarations at one position are one declaration as far as that table is concerned. Every local
 * the machine declares sat at the function's own line and column, so promoting `__wacState`
 * promoted `__wacResolve` with it, and the emitter went looking for the cell struct of a funcref
 * nothing captures: *a value of a type this emitter cannot write: `$cell$fni32(i32)$a`*.
 *
 * Source cannot produce two declarations at one position, which is why nothing had ever needed to
 * say this. A generator can, and must not.
 */
i32 freshCol(Ctx c) {
  c.col2[0] = c.col2[0] + 1;
  return c.col2[0];
}

/**
 * A synthesised lambda, at a column no other has.
 *
 * Never `async`: these are the machine's own parts — the step, the three ticket functions — and they
 * are what an `async` body has already been turned *into*. One that was async would ask to be
 * lowered again.
 */
Expr eLambda(Ctx c, Param[] ps, Stmt[] body) {
  return Expr(ExprKind.Lambda(ps, body, false), c.line, freshCol(c));
}

Expr eId(Ctx c, i32 tok) { return Expr(ExprKind.Ident(tok), c.line, c.col); }
Expr eInt(Ctx c, i32 k) { return Expr(ExprKind.IntLit(tNum(c, k)), c.line, c.col); }
Expr eBool(Ctx c, bool v) { return Expr(ExprKind.BoolLit(v), c.line, c.col); }
Expr eNull(Ctx c) { return Expr(ExprKind.NullLit, c.line, c.col); }
Expr eIx(Ctx c, Expr a, Expr i) { return Expr(ExprKind.Index(a, i), c.line, c.col); }
Expr eBang(Ctx c, Expr e) { return Expr(ExprKind.Unwrap(e), c.line, c.col); }
Expr eDot(Ctx c, Expr o, i32 tok) { return Expr(ExprKind.Member(o, tok), c.line, c.col); }
Expr eCall0(Ctx c, Expr f) { return Expr(ExprKind.Call(f, Expr[](), Ty[]()), c.line, c.col); }
Expr eCall1(Ctx c, Expr f, Expr a) {
  return Expr(ExprKind.Call(f, Expr[].filled(1, a), Ty[]()), c.line, c.col);
}
/** `e is not null`. */
Expr eNotNull(Ctx c, Expr e) {
  return Expr(ExprKind.Is(e, null, null, true), c.line, c.col);
}

/**
 * `name()` — calling a funcref held in a local.
 *
 * **A `Construct`, not a `Call`, and that is what the parser produces.** `Name()` is construction
 * syntax in wac, so `__wacStep()` parses as a construction of something called `__wacStep`, and the
 * emitter is what decides it is a call because the name is a local of funcref type. Generating a
 * `Call(Ident(…))` instead builds a tree no source can produce, and the emitter took a different
 * path through it — the decline was *a value of a type this emitter cannot write:
 * `$cell$fni32(i32)$a`*, which named neither the node nor the reason.
 *
 * Found by printing the generated tree beside the hand-written one and diffing them, after four
 * hypotheses tested by rebuilding the ladder found nothing. Two lines apart in a 119-line dump.
 */
Expr eCallLocal(Ctx c, i32 tok) {
  return Expr(ExprKind.Construct(Ty(TyKind.Named(tok, Ty[]()), c.line, c.col),
                                 Expr[](), NamedArg[]()), c.line, c.col);
}

/**
 * `name(args)` — a call to a top-level function, as the parser writes one: a `Construct` of the
 * name, for the reason `eCallLocal` gives.
 */
Expr eCallFn(Ctx c, i32 tok, Expr[] args) {
  return Expr(ExprKind.Construct(Ty(TyKind.Named(tok, Ty[]()), c.line, c.col), args, NamedArg[]()),
              c.line, c.col);
}

/** `recv.m(args)` — a method call. */
Expr eMethod(Ctx c, Expr recv, i32 m, Expr[] args) {
  return Expr(ExprKind.Call(eDot(c, recv, m), args, Ty[]()), c.line, c.col);
}

/** `name[0]` — reading a cell. */
Expr eCell(Ctx c, i32 nameTok) { return eIx(c, eId(c, nameTok), eInt(c, 0)); }

/** `name[0] = v;` */
Stmt sCellSet(Ctx c, i32 nameTok, Expr v) {
  Lvalue base = Lvalue(LvalueKind.LIdent(nameTok), c.line, c.col);
  Lvalue lv = Lvalue(LvalueKind.LIndex(base, eInt(c, 0)), c.line, c.col);
  return Stmt(StmtKind.Assign(lv, tEq(c), v), c.line, c.col);
}

/** `name = v;` — for the nullable suspension slots, which are not cells. */
Stmt sSet(Ctx c, i32 nameTok, Expr v) {
  return Stmt(StmtKind.Assign(Lvalue(LvalueKind.LIdent(nameTok), c.line, c.col), tEq(c), v),
              c.line, c.col);
}

/**
 * A fresh copy of `t`.
 *
 * **Because a node is a reference, and source never shares one.** The machine mentions the
 * function's return type in three places — the ticket it hands back, the cell that holds the answer,
 * and the `Ticket<R>` it declares — and handing the same `Ty` object to all three is a shape no
 * parser produces. Any walk that remembers what it has already visited would then see one node where
 * a reader sees three.
 */
Ty cloneTy(Ty t) {
  match (t.kind) {
    Prim(tok): { return Ty(TyKind.Prim(tok), t.line, t.col); }
    Named(tok, typeArgs): {
      Ty[] args = Ty[].filled(typeArgs.len(), t);
      for (i32 i = 0; i < typeArgs.len(); i++) { args[i] = cloneTy(typeArgs[i]); }
      return Ty(TyKind.Named(tok, args), t.line, t.col);
    }
    Arr(elem): { return Ty(TyKind.Arr(cloneTy(elem)), t.line, t.col); }
    Nullable(inner): { return Ty(TyKind.Nullable(cloneTy(inner)), t.line, t.col); }
    Funcref(ret, params): {
      Ty[] ps = Ty[].filled(params.len(), t);
      for (i32 i = 0; i < params.len(); i++) { ps[i] = cloneTy(params[i]); }
      return Ty(TyKind.Funcref(cloneTy(ret), ps), t.line, t.col);
    }
    TupleOf(members): {
      Ty[] ms = Ty[].filled(members.len(), t);
      for (i32 i = 0; i < members.len(); i++) { ms[i] = cloneTy(members[i]); }
      return Ty(TyKind.TupleOf(ms), t.line, t.col);
    }
  }
}

/**
 * Whether `t` is `void`.
 *
 * **A machine for an `async void` has no answer to keep.** Every other return type gets a cell to
 * lowPut the answer in; `void[].defaulted(1)` is not a thing, and `Ticket<void>` is settled rather than resolved, and
 * returns none — which is what `design/lang/0014` D5 made expressible in the first place.
 */
bool isVoidTy(Ctx c, Ty t) {
  match (t.kind) {
    Prim(tok): { return synthTextAt(c.src, c.lexed, tok) == "void"; }
    default: { return false; }
  }
}

Ty lowPrimTy(Ctx c, i32 tok) { return Ty(TyKind.Prim(tok), c.line, c.col); }
Ty lowArrTy(Ctx c, Ty el) { return Ty(TyKind.Arr(el), c.line, c.col); }
Ty lowOptTy(Ctx c, Ty el) { return Ty(TyKind.Nullable(el), c.line, c.col); }
Ty lowTicketTy(Ctx c, Ty el) {
  return Ty(TyKind.Named(tTicket(c), Ty[].filled(1, cloneTy(el))), c.line, c.col);
}
Ty lowFnTy(Ctx c, Ty ret, Ty[] ps) { return Ty(TyKind.Funcref(ret, ps), c.line, c.col); }

/** `T[] name = T[].defaulted(1);` */
Stmt sCellDecl(Ctx c, i32 nameTok, Ty el) {
  Expr mk = Expr(ExprKind.ArrNew(el, eInt(c, 1), null, Expr[]()), c.line, c.col);
  return Stmt(StmtKind.Var(lowArrTy(c, el), nameTok, mk, false), c.line, freshCol(c));
}

/**
 * `T[] name = T[].filled(1, init);` — a cell that starts out holding something.
 *
 * Only an `async` lambda's parameters need this: a hoisted *local* is declared in the body and its
 * declaration is rewritten in place, so there is nothing to carry in. A parameter arrives with a
 * value already, and the cell is what the machine reads it out of afterwards.
 */
Stmt sCellFrom(Ctx c, i32 nameTok, Ty el, Expr init) {
  Expr mk = Expr(ExprKind.ArrNew(el, eInt(c, 1), init, Expr[]()), c.line, c.col);
  return Stmt(StmtKind.Var(lowArrTy(c, el), nameTok, mk, false), c.line, freshCol(c));
}

/** `Ticket<T>? name = null;` */
Stmt sSlotDecl(Ctx c, i32 nameTok, Ty el) {
  return Stmt(StmtKind.Var(lowOptTy(c, lowTicketTy(c, el)), nameTok, eNull(c), false),
              c.line, freshCol(c));
}

Stmt sRet(Ctx c, Expr? v) { return Stmt(StmtKind.Return(v), c.line, c.col); }
Stmt sBlock(Ctx c, Stmt[] b) { return Stmt(StmtKind.Block(b), c.line, c.col); }
Stmt sExpr(Ctx c, Expr e) { return Stmt(StmtKind.ExprStmt(e), c.line, c.col); }

/** `Step.v(args)` — a variant of `Step`, typed by the slot it is returned into. */
Expr eStep(Ctx c, i32 variantTok, Expr[] args) {
  if (c.stepWyr[0] is null) { return eMethod(c, eId(c, tStep(c)), variantTok, args); }
  Ty[] a = Ty[].filled(3, cloneTy(c.stepWyr[0]!));
  a[1] = cloneTy(c.stepWyr[1]!);
  a[2] = cloneTy(c.stepWyr[2]!);
  Expr owner = Expr(ExprKind.TypeName(Ty(TyKind.Named(tStep(c), a), c.line, c.col)), c.line, c.col);
  return eMethod(c, owner, variantTok, args);
}

/**
 * How a `return` in the body ends the machine: `__wacRes[0] = v; __wacState[0] = fin; return
 * Step.Done(__wacRes[0]);` — the result kept, so a step after `Done` answers `Done` again with it
 * (`§wac-step-finished-noop-2tenu9x`). A body answering nothing has no result to keep.
 */
Stmt sFinish(Ctx c, Expr? v) {
  Stmt[] out = Stmt[].filled(v is null ? 2 : 3, sRet(c, null));
  i32 at = 0;
  if (v is not null) { out[at] = sCellSet(c, tRes(c), v!); at = at + 1; }
  out[at] = sCellSet(c, tState(c), eInt(c, c.finState[0])); at = at + 1;
  out[at] = sRet(c, doneStep(c, v is null));
  return sBlock(c, out);
}

/** `Step.Done(__wacRes[0])`, or `Step.Done()` for a machine answering nothing. */
Expr doneStep(Ctx c, bool isVoid) {
  return eStep(c, tDone(c), isVoid ? Expr[]() : Expr[].filled(1, eCell(c, tRes(c))));
}

// ── Substitution: a hoisted name becomes a cell, and `return` becomes a finish ─

bool isHoisted(Ctx c, i32 tok) {
  string nm = synthTextAt(c.src, c.lexed, tok);
  if (nm == "") { return false; }
  for (i32 i = 0; i < c.hoisted.len(); i++) {
    if (c.hoisted[i] == nm) { return true; }
  }
  return false;
}

Expr[] subExprs(Ctx c, Expr[] es) {
  Expr[] out = Expr[].filled(es.len(), es.len() > 0 ? es[0] : eNull(c));
  for (i32 i = 0; i < es.len(); i++) { out[i] = subExpr(c, es[i]); }
  return out;
}

/** `e` with every hoisted name replaced by its cell. Descends into lambdas: they capture the array. */
Expr subExpr(Ctx c, Expr e) {
  match (e.kind) {
    Ident(tok): {
      if (!isHoisted(c, tok)) { return e; }
      return eIx(c, e, eInt(c, 0));
    }
    Await(operand): {
      if (operand is null) { return e; }
      return Expr(ExprKind.Await(subExpr(c, operand!)), e.line, e.col);
    }
    // **In the machine's own body a `try` cannot leave by returning** — that would return from the
    // step — so it becomes the `match` it means, with the `Err` arm settling the ticket as a `return`
    // does: `match (e) { Ok(v): v, Err(x): { __wacT.resolve(Result.Err(x)); return true; } }`.
    // Inside a lambda it is the lambda's, and stays.
    CoroutineOf(call): { return coroutineCall(c, subExpr(c, call), e); }
    Try(operand): {
      if (c.inLam[0]) { return Expr(ExprKind.Try(subExpr(c, operand)), e.line, e.col); }
      Arm[] arms = Arm[].filled(2, Arm(0 - 1, 0 - 1, i32[](), Stmt[](), null));
      arms[0] = Arm(tOk(c), 0 - 1, i32[].filled(1, tTryV(c)), Stmt[](), eId(c, tTryV(c)));
      Expr err = eMethod(c, eId(c, tResult(c)), tErr(c), Expr[].filled(1, eId(c, tTryE(c))));
      arms[1] = Arm(tErr(c), 0 - 1, i32[].filled(1, tTryE(c)), Stmt[].filled(1, sFinish(c, err)), null);
      return Expr(ExprKind.MatchExpr(subExpr(c, operand), arms), e.line, e.col);
    }
    Unary(op, operand): {
      return Expr(ExprKind.Unary(op, subExpr(c, operand)), e.line, e.col);
    }
    Binary(op, left, right): {
      return Expr(ExprKind.Binary(op, subExpr(c, left), subExpr(c, right)), e.line, e.col);
    }
    Cast(op, operand, target): {
      return Expr(ExprKind.Cast(op, subExpr(c, operand), target), e.line, e.col);
    }
    Is(left, target, other, negated): {
      Expr? o = (other is null) ? null : subExpr(c, other!);
      return Expr(ExprKind.Is(subExpr(c, left), target, o, negated), e.line, e.col);
    }
    Matches(pat, subject): { return Expr(ExprKind.Matches(pat, subExpr(c, subject)), e.line, e.col); }
    Ternary(cond, then, els): {
      return Expr(ExprKind.Ternary(subExpr(c, cond), subExpr(c, then), subExpr(c, els)),
                  e.line, e.col);
    }
    Call(callee, args, typeArgs): {
      return Expr(ExprKind.Call(subExpr(c, callee), subExprs(c, args), typeArgs), e.line, e.col);
    }
    Index(arr, index): {
      return Expr(ExprKind.Index(subExpr(c, arr), subExpr(c, index)), e.line, e.col);
    }
    SafeMember(obj, nameTok): {
      return Expr(ExprKind.SafeMember(subExpr(c, obj), nameTok), e.line, e.col);
    }
    Member(obj, nameTok): {
      return Expr(ExprKind.Member(subExpr(c, obj), nameTok), e.line, e.col);
    }
    Unwrap(operand): { return Expr(ExprKind.Unwrap(subExpr(c, operand)), e.line, e.col); }
    Construct(ctype, args, named): {
      NamedArg[] ns = NamedArg[].filled(named.len(), named.len() > 0 ? named[0]
                                                                 : NamedArg(0 - 1, eNull(c)));
      for (i32 i = 0; i < named.len(); i++) {
        ns[i] = NamedArg(named[i].nameTok, subExpr(c, named[i].value));
      }
      return Expr(ExprKind.Construct(ctype, subExprs(c, args), ns), e.line, e.col);
    }
    Incr(target, op, prefix): {
      return Expr(ExprKind.Incr(subLv(c, target), op, prefix), e.line, e.col);
    }
    ArrLit(elements): { return Expr(ExprKind.ArrLit(subExprs(c, elements)), e.line, e.col); }
    TupleLit(elements): { return Expr(ExprKind.TupleLit(subExprs(c, elements)), e.line, e.col); }
    ArrNew(elem, size, fill, elements): {
      Expr? sz = (size is null) ? null : subExpr(c, size!);
      Expr? fl = (fill is null) ? null : subExpr(c, fill!);
      return Expr(ExprKind.ArrNew(elem, sz, fl, subExprs(c, elements)), e.line, e.col);
    }
    // **Inside, but as a lambda.** The names it captures are cells now, so the substitution goes in;
    // its `return`s are its own, so `inLambda` stops the finish rewrite at the boundary.
    Lambda(params, body, lamAsync): {
      return Expr(ExprKind.Lambda(params, subBody(c, body, true, 0 - 1, 0 - 1), lamAsync),
                  e.line, e.col);
    }
    MatchExpr(subject, arms): {
      Arm[] out = Arm[].filled(arms.len(), arms.len() > 0 ? arms[0]
                                                       : Arm(0 - 1, 0 - 1, i32[](), Stmt[](), null));
      for (i32 i = 0; i < arms.len(); i++) {
        Expr? av = (arms[i].value is null) ? null : subExpr(c, arms[i].value!);
        out[i] = Arm(arms[i].variantTok, arms[i].elseTok, arms[i].bindingToks,
                     subBody(c, arms[i].body, c.inLam[0], 0 - 1, 0 - 1), av);
      }
      return Expr(ExprKind.MatchExpr(subExpr(c, subject), out), e.line, e.col);
    }
    // Same reasoning as the `match` arms: an attribute's value and a child are expressions, and a
    // hoisted name can appear in either.
    Jsx(tagTok, closeTok, attrs, kids): {
      JsxAttr[] as2 = JsxAttr[].filled(attrs.len(), attrs.len() > 0 ? attrs[0]
                                                                 : JsxAttr(0 - 1, eNull(c)));
      for (i32 i = 0; i < attrs.len(); i++) {
        as2[i] = JsxAttr(attrs[i].nameTok, subExpr(c, attrs[i].value));
      }
      return Expr(ExprKind.Jsx(tagTok, closeTok, as2, subExprs(c, kids)), e.line, e.col);
    }
    JsxText(startOff, endOff): { return e; }
    IntLit(tok): { return e; }
    FloatLit(tok): { return e; }
    StrLit(tok): { return e; }
    BoolLit(value): { return e; }
    NullLit: { return e; }
    TypeName(qualifier): { return e; }
  }
}

Lvalue subLv(Ctx c, Lvalue lv) {
  match (lv.kind) {
    LIdent(tok): {
      if (!isHoisted(c, tok)) { return lv; }
      return Lvalue(LvalueKind.LIndex(lv, eInt(c, 0)), lv.line, lv.col);
    }
    LField(base, nameTok): {
      return Lvalue(LvalueKind.LField(subLv(c, base), nameTok), lv.line, lv.col);
    }
    LIndex(base, index): {
      return Lvalue(LvalueKind.LIndex(subLv(c, base), subExpr(c, index)), lv.line, lv.col);
    }
    LUnwrap(base): { return Lvalue(LvalueKind.LUnwrap(subLv(c, base)), lv.line, lv.col); }
  }
}

/**
 * `body`, substituted.
 *
 * `brkTo` and `contTo` are the states a `break` and a `continue` become when the loop they belong to
 * has been flattened away, or -1 when they still mean what they say. **They do not descend into a
 * nested loop or switch**: a `break` in there belongs to *that* one, which is still a real `while`
 * or `switch` in the emitted code.
 */
Stmt[] subBody(Ctx c, Stmt[] body, bool inLambda, i32 brkTo, i32 contTo) {
  bool was = c.inLam[0];
  c.inLam[0] = inLambda;
  Stmt[] out = Stmt[].filled(body.len(), body.len() > 0 ? body[0] : sRet(c, null));
  for (i32 i = 0; i < body.len(); i++) { out[i] = subStmt(c, body[i], inLambda, brkTo, contTo); }
  c.inLam[0] = was;
  return out;
}

Stmt subStmt(Ctx c, Stmt s, bool inLambda, i32 brkTo, i32 contTo) {
  match (s.kind) {
    // **A declaration of a hoisted local becomes an assignment to its cell**, because the cell was
    // declared in the enclosing function. Nothing else could work: a second declaration inside the
    // switch arm would be a different variable, scoped to the arm, forgotten on resume.
    Var(type, nameTok, init, isConst): {
      // A hoisted local with no initialiser is already its cell, holding its default.
      if (init is null) {
        if (!inLambda && isHoisted(c, nameTok)) { return sBlock(c, Stmt[]()); }
        return s;
      }
      Expr v = subExpr(c, init!);
      if (!inLambda && isHoisted(c, nameTok)) { return sCellSet(c, nameTok, v); }
      return Stmt(StmtKind.Var(type, nameTok, v, isConst), s.line, s.col);
    }
    Assign(target, op, rhs): {
      return Stmt(StmtKind.Assign(subLv(c, target), op, subExpr(c, rhs)), s.line, s.col);
    }
    IncrStmt(target, op): {
      return Stmt(StmtKind.IncrStmt(subLv(c, target), op), s.line, s.col);
    }
    If(cond, then, els): {
      return Stmt(StmtKind.If(subExpr(c, cond), subBody(c, then, inLambda, brkTo, contTo),
                              subBody(c, els, inLambda, brkTo, contTo)), s.line, s.col);
    }
    While(cond, body): {
      return Stmt(StmtKind.While(subExpr(c, cond), subBody(c, body, inLambda, 0 - 1, 0 - 1)), s.line, s.col);
    }
    Destructure(whole, pattern, init): {
      return Stmt(StmtKind.Destructure(whole, pattern, subExpr(c, init)), s.line, s.col);
    }
    TupleAssign(targets, rhs): {
      Lvalue[] ts = Lvalue[].filled(targets.len(), Lvalue(LvalueKind.LIdent(-1), s.line, s.col));
      for (i32 i = 0; i < targets.len(); i++) { ts[i] = subLv(c, targets[i]); }
      return Stmt(StmtKind.TupleAssign(ts, subExpr(c, rhs)), s.line, s.col);
    }
    ForIn(elemTy, nameTok, iterable, body): {
      return Stmt(StmtKind.ForIn(elemTy, nameTok, subExpr(c, iterable),
                                 subBody(c, body, inLambda, 0 - 1, 0 - 1)), s.line, s.col);
    }
    For(init, cond, update, body): {
      Stmt? i2 = (init is null) ? null : subStmt(c, init!, inLambda, 0 - 1, 0 - 1);
      Expr? c2 = (cond is null) ? null : subExpr(c, cond!);
      Stmt? u2 = (update is null) ? null : subStmt(c, update!, inLambda, 0 - 1, 0 - 1);
      return Stmt(StmtKind.For(i2, c2, u2, subBody(c, body, inLambda, 0 - 1, 0 - 1)), s.line, s.col);
    }
    DoWhile(body, cond): {
      return Stmt(StmtKind.DoWhile(subBody(c, body, inLambda, 0 - 1, 0 - 1), subExpr(c, cond)), s.line, s.col);
    }
    Switch(subject, cases): {
      Case[] cs = Case[].filled(cases.len(), cases.len() > 0 ? cases[0]
                                                          : Case(null, Stmt[](), s.line, s.col));
      for (i32 i = 0; i < cases.len(); i++) {
        Expr? v = (cases[i].value is null) ? null : subExpr(c, cases[i].value!);
        cs[i] = Case(v, subBody(c, cases[i].body, inLambda, 0 - 1, 0 - 1), cases[i].line, cases[i].col);
      }
      return Stmt(StmtKind.Switch(subExpr(c, subject), cs), s.line, s.col);
    }
    // The one that is not a substitution. Outside a lambda a `return` leaves the *machine*.
    Return(value): {
      Expr? v = (value is null) ? null : subExpr(c, value!);
      if (inLambda) { return Stmt(StmtKind.Return(v), s.line, s.col); }
      return sFinish(c, v);
    }
    Trap(value): {
      Expr? v = (value is null) ? null : subExpr(c, value!);
      return Stmt(StmtKind.Trap(v), s.line, s.col);
    }
    Block(body): { return sBlock(c, subBody(c, body, inLambda, brkTo, contTo)); }
    ExprStmt(expr): { return sExpr(c, subExpr(c, expr)); }
    Schedule(target): { return Stmt(StmtKind.Schedule(subExpr(c, target)), s.line, s.col); }
    Yield(value): {
      if (value is null) { return s; }
      return Stmt(StmtKind.Yield(subExpr(c, value!)), s.line, s.col);
    }
    // Only ever inside a lambda: `planBody` declines a machine whose own body holds one.
    Defer(body): {
      return Stmt(StmtKind.Defer(subStmt(c, body, inLambda, 0 - 1, 0 - 1)), s.line, s.col);
    }
    // **An arm's body is code.** Returning the `match` unchanged left every assignment inside an arm
    // writing to a name that had become a cell — silently, because the checker ran on the original
    // tree and the emitter was handed a write it could not mean. What it produced was an `echo` that
    // stayed empty and a server that sent nothing, with no diagnostic anywhere. `issues/lang/0005`
    // is the same lesson from the other direction: five AST walks were missing enum arms.
    Match(subject, arms): {
      Arm[] out = Arm[].filled(arms.len(), arms.len() > 0 ? arms[0]
                                                       : Arm(0 - 1, 0 - 1, i32[](), Stmt[](), null));
      for (i32 i = 0; i < arms.len(); i++) {
        Expr? av = (arms[i].value is null) ? null : subExpr(c, arms[i].value!);
        out[i] = Arm(arms[i].variantTok, arms[i].elseTok, arms[i].bindingToks,
                     subBody(c, arms[i].body, inLambda, brkTo, contTo), av);
      }
      return Stmt(StmtKind.Match(subExpr(c, subject), out), s.line, s.col);
    }
    // **A `break` whose loop is gone has to go somewhere.** After flattening there is no `while` for
    // it to leave — the only loop left is the dispatch, and breaking that would resume the machine at
    // whatever state happened to be set. So it becomes the transfer the loop's exit is.
    Break: { return brkTo < 0 ? s : sBlock(c, gotoS(c, brkTo)); }
    Continue: { return contTo < 0 ? s : sBlock(c, gotoS(c, contTo)); }
  }
}

// ── Assembling the machine ───────────────────────────────────────────────────


/** What an `await` waits on — `null` for a bare `await;` — or `e` itself when it is not one. */
Expr innerAwait(Ctx c, Expr e) {
  match (e.kind) {
    Await(operand): { return (operand is null) ? eNull(c) : operand!; }
    default: { return e; }
  }
}


/** `__wacState[0] = k; break;` — leaving the arm so the dispatch picks up state `k`. */
Stmt[] gotoS(Ctx c, i32 k) {
  Stmt[] out = Stmt[].filled(2, sRet(c, null));
  out[0] = sCellSet(c, tState(c), eInt(c, k));
  out[1] = Stmt(StmtKind.Break, c.line, c.col);
  return out;
}

/**
 * The states, as they are built.
 *
 * A state is a straight-line list of statements ending in a transfer — a `goto`, a suspend, or a
 * finish. That is the whole of the flattening: **once every state is straight-line, plain wac can
 * express the machine**, and the loop's back edge is `__wacState[0] = header;` rather than a jump.
 */
struct Bld {
  Ctx c;
  Stmt[][] states;
  i32 n;
  /** Where `break` and `continue` go, innermost last. */
  i32[] brk;
  i32[] cont;
  i32 depth;
  /** The next suspension slot; each `await` in the body gets its own. */
  i32[] slot;
  /**
   * What each slot's ticket answers, filled as slots are handed out.
   *
   * **Recorded here rather than derived afterwards**, because the flattening walks the body backwards
   * and nests into loops, so slot order is the order the walk reached them and nothing outside can
   * reconstruct it. It used to be read off the plan's list of top-level indices, which stopped
   * meaning anything the moment a suspension could be inside a loop.
   */
  Ty[] slotTy;
  /** Whether slot `k` is read back, and so needs declaring as a `Ticket<X>?`. */
  bool[] slotUsed;
  Ty ret;
}

i32 lowAlloc(Bld b) {
  if (b.n >= b.states.len()) { return b.n - 1; }
  b.n = b.n + 1;
  return b.n - 1;
}

void lowPut(Bld b, i32 id, Stmt[] body) {
  if (id >= 0 && id < b.states.len()) { b.states[id] = body; }
}

Stmt[] lowJoin(Ctx c, Stmt[] head, Stmt[] tail) {
  Stmt[] out = Stmt[].filled(head.len() + tail.len(), sRet(c, null));
  for (i32 i = 0; i < head.len(); i++) { out[i] = head[i]; }
  for (i32 i = 0; i < tail.len(); i++) { out[head.len() + i] = tail[i]; }
  return out;
}

/**
 * `body` as states, entered at the returned one, leaving to `next`.
 *
 * **Built backwards**, because a statement needs to know where it goes when it is done and that is
 * the state after it. Runs of statements with no suspension in them are grouped into one state
 * rather than one each, which keeps the `switch` the size of the *control flow* rather than the size
 * of the program.
 */
i32 lowerSeq(Bld b, Stmt[] body, i32 next) {
  i32 entry = next;
  i32 i = body.len() - 1;
  while (i >= 0) {
    if (awaitInStmt(body[i])) {
      entry = lowerOne(b, body[i], entry);
      i = i - 1;
    } else {
      i32 j = i;
      while (j >= 0 && !awaitInStmt(body[j])) { j = j - 1; }
      i32 count = i - j;
      Stmt[] run = Stmt[].filled(count, sRet(b.c, null));
      i32 brkTo = b.depth > 0 ? b.brk[b.depth - 1] : 0 - 1;
      i32 contTo = b.depth > 0 ? b.cont[b.depth - 1] : 0 - 1;
      for (i32 k = 0; k < count; k++) {
        run[k] = flatStmt(b.c, body[j + 1 + k], brkTo, contTo);
      }
      i32 e = lowAlloc(b);
      lowPut(b, e, lowJoin(b.c, run, gotoS(b.c, entry)));
      entry = e;
      i = j;
    }
  }
  return entry;
}

/**
 * One statement of a flattened run.
 *
 * **A `schedule` here sets the target and does not restore it at the end of the state**, because
 * the block it applies to goes on past this state's transfer — and the machine saves the target the
 * body left in force each time it suspends and restores it on resume, so a plain write is the whole
 * of it. The end of the *function* is restored by `__wacMachine.run`. A `schedule` in a nested block
 * that holds no suspension is left alone, and restores where that block ends as everywhere else.
 */
Stmt flatStmt(Ctx c, Stmt s, i32 brkTo, i32 contTo) {
  match (s.kind) {
    Schedule(target): {
      return sExpr(c, eCallFn(c, tTargetSet(c), Expr[].filled(1, subExpr(c, target))));
    }
    default: { return subStmt(c, s, false, brkTo, contTo); }
  }
}

/**
 * A suspension: park on what is awaited and stop stepping, with `rest` where the machine carries on
 * once a continuation or a `wait` resumes it.
 *
 * `ty` is what the awaited ticket answers when `rest` reads the value, and null when nothing does —
 * a bare `await;`, an `await e;` whose value is thrown away, an `await` on a `TicketBase?`. A typed
 * suspension keeps its ticket in slot `k` for `rest` to read with `value()`; an untyped one hands it
 * straight to `park`, which takes any ticket at all.
 */
i32 lowerSuspend(Bld b, Expr awaited, Ty? ty, i32 rest) {
  Ctx c = b.c;
  i32 k = b.slot[0];
  b.slot[0] = b.slot[0] + 1;
  bool typed = ty is not null && k < b.slotTy.len();
  if (typed) { b.slotTy[k] = cloneTy(ty!); b.slotUsed[k] = true; }

  // `__wacUpK = e; __wacState[0] = rest; return Step.Waiting(__wacOrReady(__wacUpK));` — and with no
  // slot, the operand straight in. `__wacOrReady` answers a settled ticket for `null`, which is what a
  // bare `await;` and an `await` on a null `TicketBase?` wait on.
  i32 susp = lowAlloc(b);
  Stmt[] sus = Stmt[].filled(typed ? 3 : 2, sRet(c, null));
  i32 at = 0;
  Expr parked = awaited;
  if (typed) {
    sus[at] = sSet(c, tUp(c, k), awaited); at = at + 1;
    parked = eId(c, tUp(c, k));
  }
  sus[at] = sCellSet(c, tState(c), eInt(c, rest)); at = at + 1;
  Expr ready = eCallFn(c, tOrReady(c), Expr[].filled(1, parked));
  sus[at] = sRet(c, eStep(c, tWaiting(c), Expr[].filled(1, ready)));
  lowPut(b, susp, sus);
  return susp;
}

/** `__wacUpK!.value()` — the answer of the ticket slot `k` suspended on. */
Expr eSlotValue(Ctx c, i32 k) {
  return eMethod(c, eBang(c, eId(c, tUp(c, k))), tValue(c), Expr[]());
}

/** One statement that contains a suspension, as states. */
i32 lowerOne(Bld b, Stmt s, i32 next) {
  Ctx c = b.c;
  match (s.kind) {
    // `T x = await e;` — suspend, then bind from the slot and carry on.
    Var(type, nameTok, init, isConst): {
      i32 rest = lowAlloc(b);
      i32 k = b.slot[0];
      lowPut(b, rest, lowJoin(c, Stmt[].filled(1, sCellSet(c, nameTok, eSlotValue(c, k))),
                        gotoS(c, next)));
      return lowerSuspend(b, subExpr(c, innerAwait(c, init!)), type, rest);
    }
    // `return await e;` — suspend, then the answer *is* the machine's.
    Return(value): {
      i32 rest = lowAlloc(b);
      i32 k = b.slot[0];
      lowPut(b, rest, Stmt[].filled(1, sFinish(c, eSlotValue(c, k))));
      return lowerSuspend(b, subExpr(c, innerAwait(c, (value is null) ? eNull(c) : value!)),
                          cloneTy(b.ret), rest);
    }
    // `await e;` and `await;` — suspend, and carry straight on: nothing reads what it answered.
    ExprStmt(expr): {
      return lowerSuspend(b, subExpr(c, innerAwait(c, expr)), null, next);
    }
    // **A `match` whose arms suspend** — a head state that matches and jumps to each arm's states,
    // copying the arm's bindings (the leading locals `splitMatch` wrote) on the way.
    Match(subject, arms): {
      Arm[] heads = Arm[].filled(arms.len(), arms.len() > 0 ? arms[0] : Arm(0 - 1, 0 - 1, i32[](), Stmt[](), null));
      for (i32 a = 0; a < arms.len(); a++) {
        i32 copies = 0;
        for (i32 k = 0; k < arms[a].bindingToks.len(); k++) {
          if (synthTextAt(c.src, c.lexed, arms[a].bindingToks[k]) != "_") { copies = copies + 1; }
        }
        Stmt[] rest = Stmt[].filled(arms[a].body.len() - copies, sRet(c, null));
        for (i32 i = copies; i < arms[a].body.len(); i++) { rest[i - copies] = arms[a].body[i]; }
        i32 entry = lowerSeq(b, rest, next);
        Stmt[] hb = Stmt[].filled(copies + 2, sRet(c, null));
        for (i32 i = 0; i < copies; i++) { hb[i] = subStmt(c, arms[a].body[i], false, 0 - 1, 0 - 1); }
        Stmt[] go = gotoS(c, entry);
        hb[copies] = go[0];
        hb[copies + 1] = go[1];
        heads[a] = Arm(arms[a].variantTok, arms[a].elseTok, arms[a].bindingToks, hb, null);
      }
      i32 head = lowAlloc(b);
      lowPut(b, head, Stmt[].filled(1, Stmt(StmtKind.Match(subExpr(c, subject), heads), c.line, c.col)));
      return head;
    }
    // `yield v;` — `__wacState[0] = next; return Step.Yielded(v);` (ch36).
    Yield(value): {
      i32 ys = lowAlloc(b);
      Stmt[] yb = Stmt[].filled(2, sRet(c, null));
      yb[0] = sCellSet(c, tState(c), eInt(c, next));
      yb[1] = sRet(c, eStep(c, tYielded(c), (value is null) ? Expr[]() : Expr[].filled(1, subExpr(c, value!))));
      lowPut(b, ys, yb);
      return ys;
    }
    Block(body): { return lowerSeq(b, body, next); }
    If(cond, then, els): {
      i32 tEntry = lowerSeq(b, then, next);
      i32 eEntry = els.len() > 0 ? lowerSeq(b, els, next) : next;
      i32 head = lowAlloc(b);
      Stmt[] hd = Stmt[].filled(2, sRet(c, null));
      hd[0] = Stmt(StmtKind.If(subExpr(c, cond), gotoS(c, tEntry), Stmt[]()), c.line, c.col);
      hd[1] = sBlock(c, gotoS(c, eEntry));
      lowPut(b, head, hd);
      return head;
    }
    // **The loop, which is the whole reason this is a state machine.** The header tests and either
    // enters the body or leaves; the body's last act is to go back to the header. There is no jump
    // and none is needed — the dispatch is at the top of the `while`, so *every* state is reachable
    // from it, including one in the middle of what used to be a loop.
    While(cond, body): {
      i32 head = lowAlloc(b);
      lowPush(b, next, head);
      i32 bodyEntry = lowerSeq(b, body, head);
      lowPop(b);
      Stmt[] hd = Stmt[].filled(2, sRet(c, null));
      hd[0] = Stmt(StmtKind.If(subExpr(c, cond), gotoS(c, bodyEntry), Stmt[]()), c.line, c.col);
      hd[1] = sBlock(c, gotoS(c, next));
      lowPut(b, head, hd);
      return head;
    }
    For(init, cond, update, body): {
      i32 head = lowAlloc(b);
      i32 step = lowAlloc(b);
      lowPush(b, next, step);
      i32 bodyEntry = lowerSeq(b, body, step);
      lowPop(b);
      Stmt[] up = Stmt[].filled(1, (update is null) ? sRet(c, null)
                                                : subStmt(c, update!, false, 0 - 1, 0 - 1));
      if (update is null) { up = Stmt[](); }
      lowPut(b, step, lowJoin(c, up, gotoS(c, head)));
      Stmt[] hd = Stmt[].filled(2, sRet(c, null));
      Expr test = (cond is null) ? eBool(c, true) : subExpr(c, cond!);
      hd[0] = Stmt(StmtKind.If(test, gotoS(c, bodyEntry), Stmt[]()), c.line, c.col);
      hd[1] = sBlock(c, gotoS(c, next));
      lowPut(b, head, hd);
      i32 entry = lowAlloc(b);
      Stmt[] pre = (init is null) ? Stmt[]()
                                  : Stmt[].filled(1, subStmt(c, init!, false, 0 - 1, 0 - 1));
      lowPut(b, entry, lowJoin(c, pre, gotoS(c, head)));
      return entry;
    }
    default: {
      // Unreachable: the plan refuses every other shape holding a suspension, by name.
      i32 e = lowAlloc(b);
      lowPut(b, e, gotoS(c, next));
      return e;
    }
  }
}

void lowPush(Bld b, i32 brkTo, i32 contTo) {
  if (b.depth >= b.brk.len()) { return; }
  b.brk[b.depth] = brkTo;
  b.cont[b.depth] = contTo;
  b.depth = b.depth + 1;
}

void lowPop(Bld b) { if (b.depth > 0) { b.depth = b.depth - 1; } }

/**
 * The `switch` arms, and the state the machine starts in.
 *
 * `entry` comes back through `plan.suspendAt` being unused now — the caller reads it from
 * `arms[0]`'s companion, which is why this answers both.
 */
struct Arms {
  Case[] cases;
  i32 entry;
  /** One per suspension, in the order the slots were handed out. */
  Ty[] slotTy;
  bool[] slotUsed;
  i32 slots;
}

Arms buildArms(Ctx c, Stmt[] body, AsyncPlan plan, Ty fnRet) {
  Bld b = Bld(c, Stmt[][].filled(256, Stmt[]()), 0, i32[].filled(64, 0), i32[].filled(64, 0), 0, i32[].filled(1, 0),
              Ty[].filled(64, fnRet), bool[].filled(64, false), fnRet);
  // The state a finished machine stays in, answering `Done` again with what it kept.
  i32 fin = lowAlloc(b);
  c.finState[0] = fin;
  lowPut(b, fin, Stmt[].filled(1, sRet(c, doneStep(c, isVoidTy(c, fnRet)))));
  // Falling off the end finishes a body that answers nothing; one that answers something returns on
  // every path, so for it this state is unreachable.
  i32 done = lowAlloc(b);
  lowPut(b, done, Stmt[].filled(1, isVoidTy(c, fnRet) ? sFinish(c, null) : sRet(c, doneStep(c, false))));
  i32 entry = lowerSeq(b, body, done);
  Case[] arms = Case[].filled(b.n + 1, Case(null, Stmt[](), c.line, c.col));
  for (i32 i = 0; i < b.n; i++) {
    arms[i] = Case(eInt(c, i), b.states[i], c.line, c.col);
  }
  Stmt[] dflt = Stmt[].filled(1, sRet(c, doneStep(c, isVoidTy(c, fnRet))));
  arms[b.n] = Case(null, dflt, c.line, c.col);
  return Arms(arms, entry, b.slotTy, b.slotUsed, b.slot[0]);
}

/** `while (true) { switch (__wacState[0]) { … } }` — the step lambda's whole body. */
Stmt[] stepBody(Ctx c, Case[] arms) {
  Stmt sw = Stmt(StmtKind.Switch(eCell(c, tState(c)), arms), c.line, c.col);
  Stmt[] inner = Stmt[].filled(1, sw);
  Stmt loop = Stmt(StmtKind.While(eBool(c, true), inner), c.line, c.col);
  return Stmt[].filled(1, loop);
}

/**
 * The whole rewritten body.
 *
 * The cells first, because everything else mentions them; the step, which captures them; the state
 * set to where the flattening says the body starts; and the call handed back — for an `async`
 * function, its coroutine run at once to its first suspension and wrapped in a ticket
 * (`§wac-async-eager-2rf9kdp`).
 */
Stmt[] machineBody(Ctx c, Stmt[] body, AsyncPlan plan, Ty fnRet, Ty? yieldTy, bool isAsync, bool raw) {
  Ty[] w3 = wyr(c, fnRet, yieldTy, isAsync);
  for (i32 i = 0; i < 3; i++) { c.stepWyr[i] = w3[i]; }
  Arms made = buildArms(c, body, plan, fnRet);
  i32 n = 6 + plan.hoist.len() + made.slots;
  Stmt[] out = Stmt[].filled(n, sRet(c, null));
  i32 at = 0;

  out[at] = sCellDecl(c, tState(c), lowPrimTy(c, tI32(c))); at = at + 1;
  if (!isVoidTy(c, fnRet)) { out[at] = sCellDecl(c, tRes(c), cloneTy(fnRet)); at = at + 1; }
  for (i32 i = 0; i < plan.hoist.len(); i++) {
    out[at] = sCellDecl(c, plan.hoist[i], cloneTy(plan.hoistTy[i])); at = at + 1;
  }
  for (i32 k = 0; k < made.slots; k++) {
    if (!made.slotUsed[k]) { continue; }
    out[at] = sSlotDecl(c, tUp(c, k), cloneTy(made.slotTy[k]));
    at = at + 1;
  }

  // `fn<Step<W, Y, R>()> __wacStepFn = () => { while (true) { switch … } };` — `W` is `TicketBase` for
  // something that can wait and `never` for a generator; `Y` is `never` for an `async` function.
  Ty stepTy = Ty(TyKind.Named(tStep(c), wyr(c, fnRet, yieldTy, isAsync)), c.line, c.col);
  Expr step = eLambda(c, Param[](), stepBody(c, made.cases));
  out[at] = Stmt(StmtKind.Var(lowFnTy(c, stepTy, Ty[]()), tStepFn(c), step, false), c.line, freshCol(c));
  at = at + 1;

  out[at] = sCellSet(c, tState(c), eInt(c, made.entry)); at = at + 1;

  // `Coroutine<W, Y, R>(__wacStepFn)`, and what a call hands back made from it: for an `async` function
  // `__wacMachine<R>.start(…)`, its first steps run at once; a generator's `Generator<Y, R>(…)` and an
  // async generator's `AsyncGenerator<Y, R>(…)` run nothing yet.
  Expr[] coArgs = Expr[].filled(2, eId(c, tStepFn(c)));
  coArgs[1] = eCallFn(c, tTargetGet(c), Expr[]());
  Expr co = Expr(ExprKind.Construct(Ty(TyKind.Named(tCoroutine(c), wyr(c, fnRet, yieldTy, isAsync)), c.line, c.col),
                                    coArgs, NamedArg[]()), c.line, c.col);
  out[at] = sRet(c, raw ? co : wrapMachine(c, co, fnRet, yieldTy, isAsync)); at = at + 1;

  Stmt[] trimmed = Stmt[].filled(at, sRet(c, null));
  for (i32 i = 0; i < at; i++) { trimmed[i] = out[i]; }
  return trimmed;
}

/**
 * `coroutine f(…)` — the call of `f`'s coroutine form, `__wacCo_f(…)`, which builds the machine and
 * runs none of it (spec/next ch36). Left as written when no such form is spelled in this file, and the
 * emitter names the refusal.
 */
Expr coroutineCall(Ctx c, Expr call, Expr whole) {
  match (call.kind) {
    Construct(ctype, args, named): {
      match (ctype.kind) {
        Named(tok, typeArgs): {
          i32 co = coTokFor(c, "__wacCo_" + synthTextAt(c.src, c.lexed, tok));
          if (co < 0) { return Expr(ExprKind.CoroutineOf(call), whole.line, whole.col); }
          return Expr(ExprKind.Construct(Ty(TyKind.Named(co, typeArgs), ctype.line, ctype.col), args, named),
                      call.line, call.col);
        }
        default: { }
      }
    }
    Call(callee, args, typeArgs): {
      match (callee.kind) {
        Member(obj, nameTok): {
          i32 co = coTokFor(c, "__wacCo_" + synthTextAt(c.src, c.lexed, nameTok));
          if (co < 0) { return Expr(ExprKind.CoroutineOf(call), whole.line, whole.col); }
          return Expr(ExprKind.Call(Expr(ExprKind.Member(obj, co), callee.line, callee.col), args, typeArgs),
                      call.line, call.col);
        }
        default: { }
      }
    }
    default: { }
  }
  return Expr(ExprKind.CoroutineOf(call), whole.line, whole.col);
}

/** The appended token spelling `want` — `__wacCo_f`, or `this` — or -1; searched after the source. */
i32 coTokFor(Ctx c, string want) {
  for (i32 t = c.first; t < c.lexed.tokenCount; t++) {
    if (synthTextAt(c.src, c.lexed, t) == want) { return t; }
  }
  return 0 - 1;
}

/** `W, Y, R` for a machine: what it can wait on, what it yields, what it returns. */
Ty[] wyr(Ctx c, Ty fnRet, Ty? yieldTy, bool isAsync) {
  Ty[] a = Ty[].filled(3, cloneTy(fnRet));
  a[0] = isAsync ? Ty(TyKind.Named(tTicketBase(c), Ty[]()), c.line, c.col) : lowPrimTy(c, tNever(c));
  a[1] = (yieldTy is null) ? lowPrimTy(c, tNever(c)) : cloneTy(yieldTy!);
  return a;
}

/** What a call of a machine function hands back, built from its coroutine `co`. */
Expr wrapMachine(Ctx c, Expr co, Ty fnRet, Ty? yieldTy, bool isAsync) {
  if (yieldTy is null) {
    Ty mty = Ty(TyKind.Named(tMachine(c), Ty[].filled(1, cloneTy(fnRet))), c.line, c.col);
    Expr owner = Expr(ExprKind.TypeName(mty), c.line, c.col);
    return eMethod(c, owner, tStartName(c), Expr[].filled(1, co));
  }
  Ty[] yr = Ty[].filled(2, cloneTy(fnRet));
  yr[0] = cloneTy(yieldTy!);
  if (isAsync) {
    return Expr(ExprKind.Construct(Ty(TyKind.Named(tAsyncGenerator(c), yr), c.line, c.col),
                                   Expr[].filled(1, co), NamedArg[]()), c.line, c.col);
  }
  Expr[] gargs = Expr[].filled(2, co);
  gargs[1] = eNull(c);
  return Expr(ExprKind.Construct(Ty(TyKind.Named(tGenerator(c), yr), c.line, c.col), gargs, NamedArg[]()),
              c.line, c.col);
}

/** What a call of a machine function declared to answer `ret` gets: `Ticket<R>`, `Generator<Y, R>`… */
Ty machineCallerTy(Ctx c, Ty ret, bool isAsync) {
  Ty[] gp = genParts(c.src, c.lexed, ret);
  if (gp.len() != 2) { return lowTicketTy(c, cloneTy(ret)); }
  Ty[] yr = Ty[].filled(2, cloneTy(gp[1]));
  yr[0] = cloneTy(gp[0]);
  return Ty(TyKind.Named(isAsync ? tAsyncGenerator(c) : tGenerator(c), yr), c.line, c.col);
}

/** `Coroutine<W, Y, R>` — what a machine function's coroutine form answers (ch36). */
Ty coroutineTy(Ctx c, Ty ret, bool isAsync) {
  Ty[] gp = genParts(c.src, c.lexed, ret);
  if (gp.len() == 2) { return Ty(TyKind.Named(tCoroutine(c), wyr(c, gp[1], gp[0], isAsync)), c.line, c.col); }
  return Ty(TyKind.Named(tCoroutine(c), wyr(c, ret, null, true)), c.line, c.col);
}

/**
 * The body of a machine function once its machine lives in its coroutine form `co`: hand back what a
 * call gets, made from `co(args)` — `return __wacMachine<R>.start(__wacCo_f(a, b));` and the like.
 * `self` is the receiver's spelling for a method, or -1.
 */
Stmt[] coWrapperBody(Ctx c, i32 coTok, Param[] params, Ty ret, bool isAsync, i32 self) {
  Expr[] args = Expr[].filled(params.len(), eNull(c));
  for (i32 i = 0; i < params.len(); i++) { args[i] = eId(c, params[i].nameTok); }
  Expr call = self >= 0
      ? eMethod(c, eId(c, self), coTok, args)
      : Expr(ExprKind.Construct(Ty(TyKind.Named(coTok, Ty[]()), c.line, c.col), args, NamedArg[]()), c.line, c.col);
  Ty[] gp = genParts(c.src, c.lexed, ret);
  Expr made = gp.len() == 2 ? wrapMachine(c, call, gp[1], gp[0], isAsync) : wrapMachine(c, call, ret, null, true);
  return Stmt[].filled(1, sRet(c, made));
}

/** The source and tokens with `words` appended behind a comment, as `synthSource` does. */
struct Tail {
  u8[] src;
  Lexed lexed;
}

Tail appendWords(u8[] src, Lexed lexed, string marker, string[] words) {
  string tail = "\n" + marker;
  for (i32 i = 0; i < words.len(); i++) { tail = tail + (i > 0 ? " " : "") + words[i]; }
  u8[] add = (tail + "\n").toBytes();
  u8[] out = u8[].filled(src.len() + add.len(), 0);
  for (i32 i = 0; i < src.len(); i++) { out[i] = src[i]; }
  for (i32 i = 0; i < add.len(); i++) { out[src.len() + i] = add[i]; }
  i32 stride = tokenStride();
  i32 have = lexed.tokenCount + lexed.synthCount;
  i32[] toks = i32[].filled((have + words.len()) * stride, 0);
  for (i32 i = 0; i < have * stride; i++) { toks[i] = lexed.tokens[i]; }
  i32 at = src.len() + 1 + marker.toBytes().len();
  for (i32 i = 0; i < words.len(); i++) {
    i32 o = (have + i) * stride;
    toks[o] = kIdent();
    toks[o + 1] = at;
    toks[o + 2] = words[i].toBytes().len();
    toks[o + 3] = 1;
    toks[o + 4] = 1;
    at = at + words[i].toBytes().len() + 1;
  }
  return Tail(out, Lexed(toks, have + words.len(), lexed.errors, lexed.errorCount, 0, lexed.parsed));
}

/**
 * The words a file's coroutine forms need: `__wacCo_<name>` for each machine function it declares,
 * and for each name a `coroutine` call in it reaches — declared here or not — plus `this`, which a
 * method's wrapper calls its form on.
 */
string[] coWords(Program prog, u8[] src, Lexed lexed) {
  string[] out = string[].defaulted(prog.decls.len() + lexed.tokenCount / 8 + 2);
  i32 n = 0;
  out[n] = "this";
  n = n + 1;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    Method[] ms = methodsOf(prog.decls[d]);
    for (i32 m = 0; m < ms.len(); m++) {
      if (!isMachineDecl(src, lexed, ms[m].returnType, ms[m].isAsync)) { continue; }
      n = addWord(out, n, "__wacCo_" + synthTextAt(src, lexed, ms[m].nameTok));
    }
    match (prog.decls[d].kind) {
      Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
        if (isMachineDecl(src, lexed, returnType, isAsync)) { n = addWord(out, n, "__wacCo_" + synthTextAt(src, lexed, nameTok)); }
      }
      default: { }
    }
  }
  // `coroutine a.b.f(` — the last name before the first `(`.
  for (i32 t = 0; t < lexed.tokenCount; t++) {
    if (lexed.tokens[t * tokenStride()] != kIdent() || synthTextAt(src, lexed, t) != "coroutine") { continue; }
    i32 last = 0 - 1;
    i32 u = t + 1;
    while (u < lexed.tokenCount && lexed.tokens[u * tokenStride()] != kLparen()) {
      if (lexed.tokens[u * tokenStride()] == kIdent()) { last = u; }
      u = u + 1;
    }
    if (last >= 0) { n = addWord(out, n, "__wacCo_" + synthTextAt(src, lexed, last)); }
  }
  string[] exact = string[].defaulted(n);
  for (i32 i = 0; i < n; i++) { exact[i] = out[i]; }
  return exact;
}

i32 addWord(string[] out, i32 n, string w) {
  for (i32 i = 0; i < n; i++) { if (out[i] == w) { return n; } }
  if (n >= out.len()) { return n; }
  out[n] = w;
  return n + 1;
}

/** Whether a file has a `coroutine` call, which needs rewriting even with no machine of its own. */
bool saysCoroutine(u8[] src, Lexed lexed) {
  for (i32 t = 0; t < lexed.tokenCount; t++) {
    if (lexed.tokens[t * tokenStride()] == kIdent() && synthTextAt(src, lexed, t) == "coroutine") { return true; }
  }
  return false;
}

/** `[Y, R]` of a generator's return type, held as `gen<Y, R>` — empty for anything else. */
Ty[] genParts(u8[] src, Lexed lexed, Ty t) {
  match (t.kind) {
    Named(tok, typeArgs): {
      if (typeArgs.len() == 2 && synthTextAt(src, lexed, tok) == "gen") { return typeArgs; }
      return Ty[]();
    }
    default: { return Ty[](); }
  }
}

/** Whether a declaration is a machine: `async`, or a generator. */
bool isMachineDecl(u8[] src, Lexed lexed, Ty ret, bool isAsync) {
  return isAsync || genParts(src, lexed, ret).len() == 2;
}

// ── What an awaited ticket answers, from what the file writes ─────────────────
//
// The machine keeps a value-reading `await`'s ticket in a slot of type `Ticket<X>?`, and this pass has
// no types — so `X` is read off declarations: a parameter's or a local's written type, a function's
// or a method's written return (a `Ticket` of it when `async`), a field's. Only this file's, and only
// non-generic ones. Anything else answers null and the `await` is declined by name, with the fix —
// `T v = await e;` — that writes the type down.

/** Where a body sits, for reading the types its names were declared with. */
struct Rz {
  Ctx c;
  Param[] params;
  Stmt[] body;
  Program prog;
  /** The struct whose method this is, or -1 — what `this` names. */
  i32 selfTok;
  /** How many temporaries have been handed out — `__wacAwK`. */
  i32[] next;
}

string rzText(Rz z, i32 tok) { return synthTextAt(z.c.src, z.c.lexed, tok); }

bool isAutoTyL(Rz z, Ty t) {
  match (t.kind) {
    Named(tok, typeArgs): { return typeArgs.len() == 0 && rzText(z, tok) == "auto"; }
    default: { return false; }
  }
}

/** A local's written type, searched for at any depth outside lambdas; null when `auto` or absent. */
Ty? localTyIn(Rz z, Stmt[] body, string nm) {
  for (i32 i = 0; i < body.len(); i++) {
    Ty? got = null;
    match (body[i].kind) {
      Var(type, nameTok, init, isConst): {
        if (rzText(z, nameTok) == nm && !isAutoTyL(z, type)) { return type; }
      }
      If(cond, then, els): {
        got = localTyIn(z, then, nm);
        if (got is null) { got = localTyIn(z, els, nm); }
      }
      While(cond, b): { got = localTyIn(z, b, nm); }
      DoWhile(b, cond): { got = localTyIn(z, b, nm); }
      For(init, cond, update, b): {
        if (init is not null) { got = localTyIn(z, Stmt[].filled(1, init!), nm); }
        if (got is null) { got = localTyIn(z, b, nm); }
      }
      Block(b): { got = localTyIn(z, b, nm); }
      // **A `match` arm's bindings** have its variant's payload types, when the subject is an enum
      // this file declares.
      Match(subject, arms): {
        for (i32 a = 0; a < arms.len() && got is null; a++) {
          for (i32 k = 0; k < arms[a].bindingToks.len(); k++) {
            if (rzText(z, arms[a].bindingToks[k]) != nm) { continue; }
            Ty? st = tyOfE(z, subject);
            if (st is not null && arms[a].variantTok >= 0) { got = payloadTy(z, st!, rzText(z, arms[a].variantTok), k); }
          }
          if (got is null) { got = localTyIn(z, arms[a].body, nm); }
        }
      }
      default: { }
    }
    if (got is not null) { return got; }
  }
  return null;
}

/** Field `k` of variant `v` of the same-file, non-generic enum `t`, or null. */
Ty? payloadTy(Rz z, Ty t, string v, i32 k) {
  string owner = "";
  match (t.kind) {
    Named(tok, typeArgs): { if (typeArgs.len() == 0) { owner = rzText(z, tok); } }
    default: { }
  }
  if (owner == "") { return null; }
  for (i32 d = 0; d < z.prog.decls.len(); d++) {
    match (z.prog.decls[d].kind) {
      EnumDecl(eName, eVariants, eExported, eMethods, eTypeParams): {
        if (eTypeParams.len() > 0 || rzText(z, eName) != owner) { continue; }
        for (i32 i = 0; i < eVariants.len(); i++) {
          if (rzText(z, eVariants[i].nameTok) == v && k < eVariants[i].fields.len()) { return eVariants[i].fields[k].type; }
        }
      }
      default: { }
    }
  }
  return null;
}

Ty? nameTy(Rz z, string nm) {
  if (nm == "this") {
    return z.selfTok >= 0 ? Ty(TyKind.Named(z.selfTok, Ty[]()), z.c.line, z.c.col) : null;
  }
  for (i32 i = 0; i < z.params.len(); i++) {
    if (rzText(z, z.params[i].nameTok) == nm) { return z.params[i].type; }
  }
  return localTyIn(z, z.body, nm);
}

/** `ret` as a caller sees it: a `Ticket` of it for `async`, a `Generator` for `gen<Y> R`. */
Ty callerTy(Rz z, Ty ret, bool isAsync) {
  if (genParts(z.c.src, z.c.lexed, ret).len() == 2) { return machineCallerTy(z.c, ret, isAsync); }
  return isAsync ? lowTicketTy(z.c, ret) : ret;
}

/** A same-file, non-generic function's return as its caller sees it. */
Ty? funcRetTy(Rz z, string nm) {
  for (i32 d = 0; d < z.prog.decls.len(); d++) {
    match (z.prog.decls[d].kind) {
      Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
        if (typeParams.len() == 0 && rzText(z, nameTok) == nm) { return callerTy(z, returnType, isAsync); }
      }
      default: { }
    }
  }
  return null;
}

/** A field's type, or a method's return as its caller sees it, on a same-file non-generic struct. */
Ty? memberTy(Rz z, Ty recv, string m, bool call) {
  string owner = "";
  match (recv.kind) {
    Named(tok, typeArgs): { if (typeArgs.len() == 0) { owner = rzText(z, tok); } }
    default: { }
  }
  if (owner == "") { return null; }
  for (i32 d = 0; d < z.prog.decls.len(); d++) {
    match (z.prog.decls[d].kind) {
      EnumDecl(eName, eVariants, eExported, eMethods, eTypeParams): {
        if (!call || eTypeParams.len() > 0 || rzText(z, eName) != owner) { continue; }
        for (i32 i = 0; i < eMethods.len(); i++) {
          if (rzText(z, eMethods[i].nameTok) == m && eMethods[i].typeParams.len() == 0) {
            return callerTy(z, eMethods[i].returnType, eMethods[i].isAsync);
          }
        }
      }
      StructDecl(nameTok, parentTok, fields, methods, exported, isConst, typeParams): {
        if (typeParams.len() > 0 || rzText(z, nameTok) != owner) { continue; }
        if (call) {
          for (i32 i = 0; i < methods.len(); i++) {
            if (rzText(z, methods[i].nameTok) == m && methods[i].typeParams.len() == 0) {
              return callerTy(z, methods[i].returnType, methods[i].isAsync);
            }
          }
        } else {
          for (i32 i = 0; i < fields.len(); i++) {
            if (rzText(z, fields[i].nameTok) == m) { return fields[i].type; }
          }
        }
      }
      default: { }
    }
  }
  return null;
}

/** The written type of `e`, as far as declarations in this file say it; null past that. */
Ty? tyOfE(Rz z, Expr e) {
  match (e.kind) {
    Ident(tok): { return nameTy(z, rzText(z, tok)); }
    Unwrap(inner): {
      Ty? t = tyOfE(z, inner);
      if (t is null) { return null; }
      match (t!.kind) {
        Nullable(under): { return under; }
        default: { return t; }
      }
    }
    Construct(ctype, args, named): {
      match (ctype.kind) {
        Named(tok, typeArgs): {
          if (typeArgs.len() > 0) { return null; }
          return funcRetTy(z, rzText(z, tok));
        }
        default: { return null; }
      }
    }
    Call(callee, args, typeArgs): {
      match (callee.kind) {
        Member(obj, nameTok): {
          Ty? rt = tyOfE(z, obj);
          return (rt is null) ? null : memberTy(z, rt!, rzText(z, nameTok), true);
        }
        default: { return null; }
      }
    }
    Member(obj, nameTok): {
      Ty? rt = tyOfE(z, obj);
      return (rt is null) ? null : memberTy(z, rt!, rzText(z, nameTok), false);
    }
    default: { return null; }
  }
}

/** The `X` of the `Ticket<X>` that `operand` is, or null when nothing written says. */
Ty? awaitedTy(Rz z, Expr operand) {
  Ty? t = tyOfE(z, operand);
  if (t is null) { return null; }
  match (t!.kind) {
    Named(tok, typeArgs): {
      if (typeArgs.len() == 1 && rzText(z, tok) == "Ticket") { return typeArgs[0]; }
      return null;
    }
    default: { return null; }
  }
}

// ── An `await` inside a larger expression ─────────────────────────────────────
//
// `return (await t) * 2;` becomes `X __wacAw0 = await t; return __wacAw0 * 2;` — the shapes the
// flattening already takes. **The awaits run before the rest of their statement**, which is the
// order a reader expects only where nothing to their left has an effect; where something must run
// conditionally — the right of `&&`, `||` or `??`, an arm of `?:` or `match`, a lambda — the `await`
// is left in place and the plan declines it.

/** What hoisting one statement's awaits produced. */
struct Pulled {
  Stmt[] pre;
  i32 n;
  bool failed;
}

void pushPre(Pulled p, Stmt s) {
  if (p.n >= p.pre.len()) {
    Stmt[] more = Stmt[].filled(p.pre.len() * 2 + 4, s);
    for (i32 i = 0; i < p.n; i++) { more[i] = p.pre[i]; }
    p.pre = more;
  }
  p.pre[p.n] = s;
  p.n = p.n + 1;
}

bool isShortCircuit(Rz z, i32 op) {
  i32 k = z.c.lexed.tokens[op * tokenStride()];
  return k == kAndAnd() || k == kOrOr() || k == kQuestion();
}

Expr[] pullAll(Rz z, Expr[] es, Pulled p) {
  Expr[] out = Expr[].filled(es.len(), es.len() > 0 ? es[0] : eNull(z.c));
  for (i32 i = 0; i < es.len(); i++) { out[i] = pullE(z, es[i], p); }
  return out;
}

/** `e` with each `await` in it replaced by a temporary declared in `p.pre`, in evaluation order. */
Expr pullE(Rz z, Expr e, Pulled p) {
  if (p.failed || !awaitInExpr(e)) { return e; }
  Ctx c = z.c;
  match (e.kind) {
    Await(operand): {
      if (operand is null) { p.failed = true; return e; }
      Expr inner = pullE(z, operand!, p);
      Ty? x = awaitedTy(z, inner);
      if (x is null) { p.failed = true; return e; }
      i32 k = z.next[0];
      z.next[0] = z.next[0] + 1;
      pushPre(p, Stmt(StmtKind.Var(cloneTy(x!), tAw(c, k), Expr(ExprKind.Await(inner), e.line, e.col),
                                   false), e.line, freshCol(c)));
      return Expr(ExprKind.Ident(tAw(c, k)), e.line, e.col);
    }
    Binary(op, left, right): {
      if (isShortCircuit(z, op) && awaitInExpr(right)) { p.failed = true; return e; }
      Expr l = pullE(z, left, p);
      return Expr(ExprKind.Binary(op, l, pullE(z, right, p)), e.line, e.col);
    }
    Unary(op, operand): { return Expr(ExprKind.Unary(op, pullE(z, operand, p)), e.line, e.col); }
    Cast(op, operand, target): {
      return Expr(ExprKind.Cast(op, pullE(z, operand, p), target), e.line, e.col);
    }
    Call(callee, args, typeArgs): {
      Expr cl = pullE(z, callee, p);
      return Expr(ExprKind.Call(cl, pullAll(z, args, p), typeArgs), e.line, e.col);
    }
    Construct(ctype, args, named): {
      if (named.len() > 0) { p.failed = true; return e; }
      return Expr(ExprKind.Construct(ctype, pullAll(z, args, p), named), e.line, e.col);
    }
    Member(obj, nameTok): { return Expr(ExprKind.Member(pullE(z, obj, p), nameTok), e.line, e.col); }
    Unwrap(operand): { return Expr(ExprKind.Unwrap(pullE(z, operand, p)), e.line, e.col); }
    Try(operand): { return Expr(ExprKind.Try(pullE(z, operand, p)), e.line, e.col); }
    Index(arr, index): {
      Expr a = pullE(z, arr, p);
      return Expr(ExprKind.Index(a, pullE(z, index, p)), e.line, e.col);
    }
    ArrLit(elements): { return Expr(ExprKind.ArrLit(pullAll(z, elements, p)), e.line, e.col); }
    TupleLit(elements): { return Expr(ExprKind.TupleLit(pullAll(z, elements, p)), e.line, e.col); }
    Is(left, target, other, negated): {
      if (other is not null) { p.failed = true; return e; }
      return Expr(ExprKind.Is(pullE(z, left, p), target, other, negated), e.line, e.col);
    }
    // **A `match`'s subject runs first and always**, so an `await` there can go before the statement —
    // which is what `try await t` becomes once `try` is lowered. One in an arm runs only sometimes.
    MatchExpr(subject, arms): {
      for (i32 i = 0; i < arms.len(); i++) {
        if (arms[i].value is not null && awaitInExpr(arms[i].value!)) { p.failed = true; return e; }
        if (awaitInBody(arms[i].body)) { p.failed = true; return e; }
      }
      return Expr(ExprKind.MatchExpr(pullE(z, subject, p), arms), e.line, e.col);
    }
    default: { p.failed = true; return e; }
  }
}

bool isAwaitL(Expr e) {
  match (e.kind) {
    Await(operand): { return true; }
    default: { return false; }
  }
}

/** `s` preceded by the temporaries its nested awaits became — or `s` alone when it cannot be split. */
Stmt[] splitStmt(Rz z, Stmt s) {
  Pulled p = Pulled(Stmt[](), 0, false);
  Stmt made = s;
  match (s.kind) {
    Var(type, nameTok, init, isConst): {
      if (init is null) { return Stmt[].filled(1, s); }
      if (isAwaitL(init!)) {
        // `auto x = await e;` — the slot needs `X`, so the local gets it written.
        if (!isAutoTyL(z, type)) { return Stmt[].filled(1, s); }
        Ty? x = awaitedTy(z, innerAwait(z.c, init!));
        if (x is null) { return Stmt[].filled(1, s); }
        return Stmt[].filled(1, Stmt(StmtKind.Var(cloneTy(x!), nameTok, init!, isConst), s.line, s.col));
      }
      made = Stmt(StmtKind.Var(type, nameTok, pullE(z, init!, p), isConst), s.line, s.col);
    }
    Return(value): {
      if (value is null || isAwaitL(value!)) { return Stmt[].filled(1, s); }
      made = Stmt(StmtKind.Return(pullE(z, value!, p)), s.line, s.col);
    }
    ExprStmt(expr): {
      if (isAwaitL(expr)) { return Stmt[].filled(1, s); }
      made = Stmt(StmtKind.ExprStmt(pullE(z, expr, p)), s.line, s.col);
    }
    Yield(value): {
      if (value is null) { return Stmt[].filled(1, s); }
      made = Stmt(StmtKind.Yield(pullE(z, value!, p)), s.line, s.col);
    }
    Assign(target, op, rhs): {
      if (isAwaitL(rhs)) {
        Pulled q = Pulled(Stmt[](), 0, false);
        Expr v = pullE(z, rhs, q);
        if (q.failed) { return Stmt[].filled(1, s); }
        p = q;
        made = Stmt(StmtKind.Assign(target, op, v), s.line, s.col);
      } else {
        made = Stmt(StmtKind.Assign(target, op, pullE(z, rhs, p)), s.line, s.col);
      }
    }
    If(cond, then, els): {
      made = Stmt(StmtKind.If(pullE(z, cond, p), splitBody(z, then), splitBody(z, els)), s.line, s.col);
    }
    While(cond, b): { return Stmt[].filled(1, Stmt(StmtKind.While(cond, splitBody(z, b)), s.line, s.col)); }
    For(init, cond, update, b): {
      return Stmt[].filled(1, Stmt(StmtKind.For(init, cond, update, splitBody(z, b)), s.line, s.col));
    }
    Block(b): { return Stmt[].filled(1, Stmt(StmtKind.Block(splitBody(z, b)), s.line, s.col)); }
    ForIn(elemTy, nameTok, iterable, b): { return splitForIn(z, s, elemTy, nameTok, iterable, b); }
    Match(subject, arms): { return Stmt[].filled(1, splitMatch(z, s, subject, arms)); }
    default: { return Stmt[].filled(1, s); }
  }
  if (p.failed) { return Stmt[].filled(1, s); }
  Stmt[] out = Stmt[].filled(p.n + 1, made);
  for (i32 i = 0; i < p.n; i++) { out[i] = p.pre[i]; }
  out[p.n] = made;
  return out;
}

/**
 * A `for … in` whose body suspends, or a `for await`, as a `while` the flattening can take (ch36) —
 * over a generator `Generator<Y, R> g = it; while (g.__wacNext()) { T x = g.__wacCurrent(); … }`, and
 * over an async one `AsyncGenerator<Y, R> g = it; while (true) { Step<never, Y, R> s = await g.step();
 * if (s.__wacIsDone()) { break; } T x = s.__wacYieldedOf(); … }`. Left as written when the iterable's
 * type is not one this file writes, or it is not a generator, and the plan declines it by name.
 */
Stmt[] splitForIn(Rz z, Stmt s, Ty? elemTy, i32 nameTok, Expr iterable, Stmt[] body) {
  Ctx c = z.c;
  Expr it = iterable;
  bool awaiting = false;
  match (iterable.kind) {
    Await(op): { if (op is not null) { it = op!; awaiting = true; } }
    default: { }
  }
  Ty? t = tyOfE(z, it);
  if (t is null) { return Stmt[].filled(1, s); }
  string tname = "";
  Ty[] targs = Ty[]();
  match (t!.kind) {
    Named(tok, typeArgs): { tname = rzText(z, tok); targs = typeArgs; }
    default: { }
  }
  if (targs.len() != 2) { return Stmt[].filled(1, s); }
  if (!(tname == "Generator" && !awaiting) && !(tname == "AsyncGenerator" && awaiting)) { return Stmt[].filled(1, s); }
  Ty elem = (elemTy is null) ? targs[0] : elemTy!;
  i32 k = z.next[0];
  z.next[0] = z.next[0] + 2;
  i32 g = tAw(c, k);
  Stmt[] inner = splitBody(z, body);
  Stmt[] out = Stmt[].filled(2, sRet(c, null));
  out[0] = Stmt(StmtKind.Var(cloneTy(t!), g, it, false), s.line, freshCol(c));
  if (!awaiting) {
    Stmt[] wb = Stmt[].filled(inner.len() + 1, sRet(c, null));
    wb[0] = Stmt(StmtKind.Var(cloneTy(elem), nameTok, eMethod(c, eId(c, g), tCurrentName(c), Expr[]()), false),
                 s.line, freshCol(c));
    for (i32 i = 0; i < inner.len(); i++) { wb[i + 1] = inner[i]; }
    out[1] = Stmt(StmtKind.While(eMethod(c, eId(c, g), tNextName(c), Expr[]()), wb), s.line, s.col);
    return out;
  }
  i32 st = tAw(c, k + 1);
  Ty[] wyrT = Ty[].filled(3, cloneTy(targs[1]));
  wyrT[0] = lowPrimTy(c, tNever(c));
  wyrT[1] = cloneTy(targs[0]);
  Ty stepT = Ty(TyKind.Named(tStep(c), wyrT), c.line, c.col);
  Stmt[] wb = Stmt[].filled(inner.len() + 3, sRet(c, null));
  wb[0] = Stmt(StmtKind.Var(stepT, st, Expr(ExprKind.Await(eMethod(c, eId(c, g), tStepCall(c), Expr[]())), s.line, s.col),
                            false), s.line, freshCol(c));
  wb[1] = Stmt(StmtKind.If(eMethod(c, eId(c, st), tIsDoneName(c), Expr[]()),
                           Stmt[].filled(1, Stmt(StmtKind.Break, s.line, s.col)), Stmt[]()), s.line, s.col);
  wb[2] = Stmt(StmtKind.Var(cloneTy(elem), nameTok, eMethod(c, eId(c, st), tYieldedName(c), Expr[]()), false),
               s.line, freshCol(c));
  for (i32 i = 0; i < inner.len(); i++) { wb[i + 3] = inner[i]; }
  out[1] = Stmt(StmtKind.While(eBool(c, true), wb), s.line, s.col);
  return out;
}

/**
 * A `match` statement whose arms suspend, made ready to flatten: each arm's bindings become fresh
 * names, copied at the arm's head into locals of the bindings' own names — `A(x): { … }` is
 * `A(__wacAwK): { T x = __wacAwK; … }` — so they are hoisted like any local, and `lowerOne` keeps the
 * copies in the state that dispatches. Left as written when a binding's type is not one this file
 * writes, and the plan declines it.
 */
Stmt splitMatch(Rz z, Stmt s, Expr subject, Arm[] arms) {
  Ctx c = z.c;
  Ty? st = tyOfE(z, subject);
  Arm[] out = Arm[].filled(arms.len(), arms.len() > 0 ? arms[0] : Arm(0 - 1, 0 - 1, i32[](), Stmt[](), null));
  for (i32 a = 0; a < arms.len(); a++) {
    Arm arm = arms[a];
    i32 nb = arm.bindingToks.len();
    i32[] fresh = i32[].filled(nb, 0);
    Stmt[] body = splitBody(z, arm.body);
    Stmt[] full = Stmt[].filled(nb + body.len(), sRet(c, null));
    i32 kept = 0;
    for (i32 k = 0; k < nb; k++) {
      string bn = rzText(z, arm.bindingToks[k]);
      if (bn == "_") { fresh[k] = arm.bindingToks[k]; continue; }
      Ty? bt = (st is null || arm.variantTok < 0) ? null : payloadTy(z, st!, rzText(z, arm.variantTok), k);
      if (bt is null) { return s; }
      i32 f = tAw(c, z.next[0]);
      z.next[0] = z.next[0] + 1;
      fresh[k] = f;
      full[kept] = Stmt(StmtKind.Var(cloneTy(bt!), arm.bindingToks[k], eId(c, f), false), s.line, freshCol(c));
      kept = kept + 1;
    }
    Stmt[] trimmed = Stmt[].filled(kept + body.len(), sRet(c, null));
    for (i32 i = 0; i < kept; i++) { trimmed[i] = full[i]; }
    for (i32 i = 0; i < body.len(); i++) { trimmed[kept + i] = body[i]; }
    out[a] = Arm(arm.variantTok, arm.elseTok, fresh, trimmed, arm.value);
  }
  return Stmt(StmtKind.Match(subject, out), s.line, s.col);
}

/** `body` with every statement split around its nested awaits. */
Stmt[] splitBody(Rz z, Stmt[] body) {
  i32 n = 0;
  Stmt[][] parts = Stmt[][].filled(body.len(), Stmt[]());
  for (i32 i = 0; i < body.len(); i++) {
    parts[i] = awaitInStmt(body[i]) ? splitStmt(z, body[i]) : Stmt[].filled(1, body[i]);
    n = n + parts[i].len();
  }
  Stmt[] out = Stmt[].filled(n, body.len() > 0 ? body[0] : sRet(z.c, null));
  i32 at = 0;
  for (i32 i = 0; i < body.len(); i++) {
    for (i32 j = 0; j < parts[i].len(); j++) { out[at] = parts[i][j]; at = at + 1; }
  }
  return out;
}

/** The number of `await` tokens in a file — at least as many as any machine in it suspends. */
i32 awaitTokens(Lexed lexed) {
  i32 n = 0;
  for (i32 i = 0; i < lexed.tokenCount; i++) {
    i32 k = lexed.tokens[i * tokenStride()];
    if (k == kAwait()) { n = n + 1; }
    // A `for … in` a machine rewrites takes two temporaries of the same family (`splitForIn`).
    if (k == kFor()) { n = n + 2; }
  }
  return n;
}

// ── The entry ────────────────────────────────────────────────────────────────

/** A program with its `async` functions rewritten, and the source and tokens that go with it. */
export struct Lowered {
  Program prog;
  u8[] src;
  Lexed lexed;
  /** Whether anything was rewritten — when false the other three are the originals, untouched. */
  bool changed;
  /** Why the first `async` body that could not be lowered was declined, or empty. */
  string why;
}

// ── async lambdas — `issues/lang/0294c` ──────────────────────────────────────
//
// The same machine, built for a lambda instead of a function, with two differences that both come
// from a lambda never writing a return type.
//
// **Where `R` comes from.** This pass runs on the tree with no type information at all, and
// `machineBody` needs `R` to declare the cell the answer lands in. A function writes it; a lambda
// takes it from the `fn<…>` it is assigned to. So the lowering takes an `async` lambda that is the
// initialiser of a declaration whose type spells `Ticket<R>` out, because that is the one place `R`
// is present in the AST — and the emitter declines the rest by name. That is less of a restriction
// than it sounds: `async` is only *legal* on a slot naming a ticket, so the type has to be written
// somewhere, and a declaration is where it is written.
//
// **Why the parameters are renamed.** The machine puts the whole body inside `__wacStep`, so every
// mention of a parameter becomes a capture — and a lambda's parameter captured by an inner lambda
// emits a module the engine rejects (`issues/lang/0296c`, still live: a cell is keyed by the
// position of a *declaration*, and a parameter has none). The parameter takes a synthetic name and
// its cell keeps the written one, which turns the capture into an ordinary hoisted local and needs
// no change to the substitution:
//
//     fn<Ticket<i32>(string)> f = async (string p) => { … p … };
//     fn<Ticket<i32>(string)> f = (string __wacArg0) => {
//       string[] p = string[].filled(1, __wacArg0);   // `p` is a hoisted local now
//       …                                          // and every read of it is `p[0]`
//     };

/**
 * The `R` of a `fn<Ticket<R>(…)>`, or null when the type is not one.
 *
 * Read off the written type rather than resolved, so a slot spelled through an alias is not one this
 * finds. That is the honest limit of a pass with no types: it can read what the program says.
 */
Ty? slotTicketTy(u8[] src, Lexed lexed, Ty t) {
  match (t.kind) {
    Funcref(ret, params): {
      match (ret.kind) {
        Named(tok, typeArgs): {
          if (synthTextAt(src, lexed, tok) != "Ticket") { return null; }
          if (typeArgs.len() != 1) { return null; }
          return typeArgs[0];
        }
        default: { return null; }
      }
    }
    default: { return null; }
  }
}

/** The `async` lambda `s` declares, or null — `fn<Ticket<R>(…)> n = async (…) => { … };`. */
Expr? asyncLambdaOf(u8[] src, Lexed lexed, Stmt s) {
  match (s.kind) {
    Var(type, nameTok, init, isConst): {
      if (slotTicketTy(src, lexed, type) is null || (init is null)) { return null; }
      match (init!.kind) {
        Lambda(params, body, isAsync): { return isAsync ? init! : null; }
        default: { return null; }
      }
    }
    default: { return null; }
  }
}

/** Whether this file has an `async` lambda the lowering can take. */
bool anyLambdaLowerable(Program prog, u8[] src, Lexed lexed) {
  for (i32 d = 0; d < prog.decls.len(); d++) {
    match (prog.decls[d].kind) {
      Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
        for (i32 i = 0; i < body.len(); i++) {
          Expr? lam = asyncLambdaOf(src, lexed, body[i]);
          if (lam is null) { continue; }
          match (lam!.kind) {
            Lambda(lps, lbody, la): { if (la) { return true; } }
            default: { }
          }
        }
      }
      default: { }
    }
  }
  return false;
}

/**
 * The methods a declaration carries — a struct's or an enum's, and none for anything else.
 *
 * **One accessor rather than five copies of the same `match`.** `anyLowerable`, `slotsNeeded`,
 * `numsNeeded`, `argsNeeded` and `lowerProgram` all walk `prog.decls`, and every one of them was
 * written as a `Func(…)` with `default: { }` — so a method was invisible to all five at once.
 * `issues/lang/0301b` is explicit about why that matters: miss `anyLowerable` and nothing is lowered
 * at all, miss one of the sizes and the machine is built with too few cells. Neither says anything;
 * both produce a program that is wrong rather than refused.
 *
 * **Enums too, not just structs.** `EnumDecl` holds `Method[]` exactly as `StructDecl` does —
 * `Option<T>` has six — so covering only structs would leave the same silent miss one declaration
 * kind over.
 */
Method[] methodsOf(Decl d) {
  match (d.kind) {
    StructDecl(sName, sParent, sFields, sMethods, sExported, sConst, sTypeParams): {
      return sMethods;
    }
    EnumDecl(eName, eVariants, eExported, eMethods, eTypeParams): { return eMethods; }
    default: { return Method[](); }
  }
}

/**
 * The widest parameter list any lowerable `async` lambda has.
 *
 * One `__wacArgK` per position, shared across the file the way the suspension slots are — the tail
 * is built once for a file and sized by its largest asker.
 */
i32 argsNeeded(Program prog, u8[] src, Lexed lexed) {
  i32 most = 0;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    Method[] ms = methodsOf(prog.decls[d]);
    for (i32 m = 0; m < ms.len(); m++) {
      for (i32 i = 0; i < ms[m].body.len(); i++) {
        Expr? lamM = asyncLambdaOf(src, lexed, ms[m].body[i]);
        if (lamM is null) { continue; }
        match (lamM!.kind) {
          Lambda(mps, mbody, ma): {
            if (mps.len() > most) { most = mps.len(); }
          }
          default: { }
        }
      }
    }
    match (prog.decls[d].kind) {
      Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
        for (i32 i = 0; i < body.len(); i++) {
          Expr? lam = asyncLambdaOf(src, lexed, body[i]);
          if (lam is null) { continue; }
          match (lam!.kind) {
            Lambda(lps, lbody, la): {
              if (lps.len() > most) { most = lps.len(); }
            }
            default: { }
          }
        }
      }
      default: { }
    }
  }
  return most;
}

/**
 * How many numerals this file needs — the largest state bound any one machine asks for.
 *
 * **Lambdas count, and a lambda in a *plain* function counts.** The walk cannot filter on the
 * declaration being `async`, because an `async` lambda is a machine of its own wherever it sits.
 * Undersizing this is not a diagnostic: it is a token index past the end of the tail, which traps
 * inside the compiler and is reported as `wac.wac trapped`.
 */
i32 numsNeeded(Program prog, u8[] src, Lexed lexed) {
  i32 most = 0;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    Method[] ms = methodsOf(prog.decls[d]);
    for (i32 m = 0; m < ms.len(); m++) {
      if (!isMachineDecl(src, lexed, ms[m].returnType, ms[m].isAsync)) { continue; }
      i32 wantM = statesNeeded(ms[m].body);
      if (wantM > most) { most = wantM; }
    }
    match (prog.decls[d].kind) {
      Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
        if (isMachineDecl(src, lexed, returnType, isAsync)) {
          i32 want = statesNeeded(body);
          if (want > most) { most = want; }
        }
        for (i32 i = 0; i < body.len(); i++) {
          Expr? lam = asyncLambdaOf(src, lexed, body[i]);
          if (lam is null) { continue; }
          match (lam!.kind) {
            Lambda(lps, lbody, la): {
              i32 w = statesNeeded(lbody);
              if (w > most) { most = w; }
            }
            default: { }
          }
        }
      }
      default: { }
    }
  }
  return most;
}

/** Whether anything here is worth extending the source for. */
bool anyLowerable(Program prog, u8[] src, Lexed lexed) {
  for (i32 d = 0; d < prog.decls.len(); d++) {
    Method[] ms = methodsOf(prog.decls[d]);
    for (i32 m = 0; m < ms.len(); m++) {
      if (isMachineDecl(src, lexed, ms[m].returnType, ms[m].isAsync)) { return true; }
    }
    match (prog.decls[d].kind) {
      Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
        if (isMachineDecl(src, lexed, returnType, isAsync)) { return true; }
      }
      default: { }
    }
  }
  return false;
}

/** What every machine in one file shares: the tail of spellings, and the file's declarations. */
struct Lw {
  i32 first;
  i32 ups;
  i32 args;
  u8[] src;
  Lexed lexed;
  Program prog;
  /** Temporaries handed out so far, across the file, so a lambda's never shadow its function's. */
  i32[] next;
  /** Why the first machine in the file that could not be built was declined, or empty. */
  string[] why;
}

void noteWhy(Lw w, string why) { if (w.why[0] == "") { w.why[0] = why; } }

/** Whether `body` still holds `auto x = await e;` — a slot whose ticket type nothing wrote. */
bool autoAwaitIn(Rz z, Stmt[] body) {
  for (i32 i = 0; i < body.len(); i++) {
    match (body[i].kind) {
      Var(type, nameTok, init, isConst): {
        if (init is not null && isAwaitL(init!) && isAutoTyL(z, type)) { return true; }
      }
      If(cond, then, els): { if (autoAwaitIn(z, then) || autoAwaitIn(z, els)) { return true; } }
      While(cond, b): { if (autoAwaitIn(z, b)) { return true; } }
      For(init, cond, update, b): { if (autoAwaitIn(z, b)) { return true; } }
      Block(b): { if (autoAwaitIn(z, b)) { return true; } }
      default: { }
    }
  }
  return false;
}

/** Where one machine sits: its parameters, its receiver's struct, its position. */
struct Site {
  Param[] params;
  i32 selfTok;
  i32 line;
  i32 col;
  /** The first column handed to the lambdas it synthesises — the emitter keys a lambda by position. */
  i32 colBase;
  bool isAsync;
  /** Build the coroutine form, answering the machine itself rather than what a call hands back. */
  bool raw;
}

/**
 * One body's machine: split around its nested awaits, planned, and built — or null when the plan does
 * not hold, so the caller leaves the declaration as it was and the emitter names the refusal.
 * `extra` are names that become cells beyond the ones the plan hoists — a lambda's parameters.
 */
Stmt[]? machineOf(Lw w, Site at, Stmt[] body, Ty ret, string[] extra) {
  Ctx c0 = Ctx(w.first, w.ups, w.args, at.line, at.col, string[](), w.src, w.lexed,
               i32[].filled(1, at.colBase), bool[].filled(1, false), i32[].filled(1, 0), Ty?[].defaulted(3));
  Rz z = Rz(c0, at.params, body, w.prog, at.selfTok, w.next);
  Stmt[] split = splitBody(z, body);
  AsyncPlan plan = planBody(split);
  if (!plan.ok) { noteWhy(w, plan.why); return null; }
  if (autoAwaitIn(z, split)) {
    noteWhy(w, "an `await` into an `auto` local, on a ticket whose type this file does not write — write the type");
    return null;
  }
  string[] names = string[].filled(plan.hoist.len() + extra.len(), "");
  for (i32 i = 0; i < plan.hoist.len(); i++) { names[i] = synthTextAt(w.src, w.lexed, plan.hoist[i]); }
  for (i32 i = 0; i < extra.len(); i++) { names[plan.hoist.len() + i] = extra[i]; }
  Ctx c = Ctx(w.first, w.ups, w.args, at.line, at.col, names, w.src, w.lexed, c0.col2, c0.inLam,
              c0.finState, c0.stepWyr);
  Ty[] gp = genParts(w.src, w.lexed, ret);
  if (gp.len() == 2) { return machineBody(c, split, plan, gp[1], gp[0], at.isAsync, at.raw); }
  return machineBody(c, split, plan, ret, null, true, at.raw);
}

/**
 * Every `async` lambda declared directly in `body`, rewritten into a machine.
 *
 * **Directly, not at any depth.** A declaration nested inside an `if` or a loop is left alone and
 * declined by name, which is the same standard the four suspension shapes `design/lang/0014` could
 * not flatten are held to. Declaring a handler is a top-of-body act, so this is where they are.
 */
Stmt[] lowerLambdasIn(Lw w, Stmt[] body, i32 selfTok) {
  if (body.len() == 0) { return body; }
  Stmt[] out = Stmt[].filled(body.len(), body[0]);
  for (i32 i = 0; i < body.len(); i++) {
    out[i] = body[i];
    match (body[i].kind) {
      Var(type, nameTok, init, isConst): {
        Ty? tick = slotTicketTy(w.src, w.lexed, type);
        if (tick is null || (init is null)) { continue; }
        match (init!.kind) {
          Lambda(lps, lbody, la): {
            if (!la) { continue; }
            // **Every parameter becomes a cell**, whether or not it outlives a suspension, because
            // the machine puts the whole body inside the step — so even a read in state 0 is a capture.
            string[] pnames = string[].filled(lps.len(), "");
            for (i32 j = 0; j < lps.len(); j++) { pnames[j] = synthTextAt(w.src, w.lexed, lps[j].nameTok); }
            // A column of its own: the emitter keys a lambda by position, and this builds several.
            Site at = Site(lps, selfTok, init!.line, init!.col, init!.col + 5000, true, false);
            Stmt[]? mach = machineOf(w, at, lbody, tick!, pnames);
            if (mach is null) { continue; }
            Ctx c = Ctx(w.first, w.ups, w.args, init!.line, init!.col, pnames, w.src, w.lexed,
                        i32[].filled(1, init!.col + 9000), bool[].filled(1, false), i32[].filled(1, 0), Ty?[].defaulted(3));

            Param[] ps2 = Param[].filled(lps.len(), lps.len() > 0 ? lps[0]
                                                               : Param(0 - 1, type, false));
            for (i32 j = 0; j < lps.len(); j++) {
              ps2[j] = Param(tArg(c, j), cloneTy(lps[j].type), lps[j].isConst);
            }
            Stmt[] m2 = mach!;
            Stmt[] full = Stmt[].filled(lps.len() + m2.len(), m2[0]);
            for (i32 j = 0; j < lps.len(); j++) {
              full[j] = sCellFrom(c, lps[j].nameTok, cloneTy(lps[j].type), eId(c, tArg(c, j)));
            }
            for (i32 k = 0; k < m2.len(); k++) { full[lps.len() + k] = m2[k]; }

            Expr made = Expr(ExprKind.Lambda(ps2, full, false), init!.line, init!.col);
            out[i] = Stmt(StmtKind.Var(type, nameTok, made, isConst), body[i].line, body[i].col);
          }
          default: { }
        }
      }
      default: { }
    }
  }
  return out;
}

/** The name token of the struct `at` declares, or -1 for an enum — what `this` is in its methods. */
i32 selfOf(Decl at) {
  match (at.kind) {
    StructDecl(sName, sParent, sFields, sMethods, sExported, sConst, sTypeParams): {
      return sTypeParams.len() == 0 ? sName : 0 - 1;
    }
    EnumDecl(eName, eVariants, eExported, eMethods, eTypeParams): {
      return eTypeParams.len() == 0 ? eName : 0 - 1;
    }
    default: { return 0 - 1; }
  }
}

/**
 * `ms` with every `async` method rewritten into a machine, and every method's lambdas lowered.
 *
 * The same calls `lowerProgram` makes for a free function, and the same rebuild with `lowTicketTy`
 * and `isAsync: false`, because a lowered machine is an ordinary function that answers a `Ticket<T>`
 * and must not be lowered twice. A method whose plan does not hold is left exactly as it was, so the
 * emitter declines it by name rather than emitting a half-rewritten body.
 */
Method[] loweredMethods(Lw w, Decl at) {
  Method[] ms = methodsOf(at);
  i32 self = selfOf(at);
  // A machine method becomes two: its coroutine form, and the method calling it.
  Method[] out = Method[].filled(ms.len() * 2, ms[0]);
  i32 n = 0;
  for (i32 m = 0; m < ms.len(); m++) {
    Method me = ms[m];
    Ctx c = Ctx(w.first, w.ups, w.args, at.line, at.col, string[](), w.src, w.lexed,
                i32[].filled(1, 0), bool[].filled(1, false), i32[].filled(1, 0), Ty?[].defaulted(3));
    Stmt[] body2 = coRewrite(c, lowerLambdasIn(w, me.body, self));
    if (!isMachineDecl(w.src, w.lexed, me.returnType, me.isAsync)) {
      out[n] = Method(me.nameTok, me.returnType, me.params, body2, me.isOverride, me.overrideTok,
                      me.hasThis, me.thisConst, me.typeParams, false, me.isPrivate, me.isVirtual);
      n = n + 1;
      continue;
    }
    Stmt[]? machine = machineOf(w, Site(me.params, self, at.line, at.col, at.col + 1000 + 100 * m, me.isAsync, true),
                                body2, me.returnType, string[]());
    i32 coTok = coTokFor(c, "__wacCo_" + synthTextAt(w.src, w.lexed, me.nameTok));
    i32 thisTok = coTokFor(c, "this");
    if (machine is null || coTok < 0 || thisTok < 0 || !me.hasThis) { out[n] = me; n = n + 1; continue; }
    out[n] = Method(coTok, coroutineTy(c, me.returnType, me.isAsync), me.params, machine!,
                    false, 0 - 1, me.hasThis, me.thisConst, me.typeParams, false, me.isPrivate, false);
    out[n + 1] = Method(me.nameTok, machineCallerTy(c, me.returnType, me.isAsync), me.params,
                        coWrapperBody(c, coTok, me.params, me.returnType, me.isAsync, thisTok),
                        me.isOverride, me.overrideTok, me.hasThis, me.thisConst, me.typeParams, false,
                        me.isPrivate, me.isVirtual);
    n = n + 2;
  }
  Method[] exact = Method[].filled(n, ms[0]);
  for (i32 i = 0; i < n; i++) { exact[i] = out[i]; }
  return exact;
}

/** `coroutine f(…)` anywhere in `body` rewritten to its coroutine form's call — and nothing else. */
Stmt[] coRewrite(Ctx c, Stmt[] body) {
  if (coTokFor(c, "this") < 0) { return body; }
  return subBody(c, body, true, 0 - 1, 0 - 1);
}

/**
 * Every `async` function in `prog`, rewritten into a state machine.
 *
 * **A function this cut cannot flatten is left exactly as it was**, still marked `async`, so the
 * emitter's own refusal names it rather than this producing a half-machine.
 *
 * The source is extended once for the whole file, not once per function, because `synthSource` is
 * idempotent and the token indices it hands out are absolute. It is sized from the file's `await`
 * tokens, which bound both the slots any one machine needs and the temporaries the whole file does.
 */
export Lowered lowerProgram(Program prog, u8[] src, Lexed lexed) {
  if (!anyLowerable(prog, src, lexed) && !anyLambdaLowerable(prog, src, lexed) && !saysCoroutine(src, lexed)) {
    return Lowered(prog, src, lexed, false, "");
  }
  i32 ups = awaitTokens(lexed);
  i32 states = numsNeeded(prog, src, lexed) + 4 * ups;
  i32 args = argsNeeded(prog, src, lexed);

  u8[] srcA = synthSource(src, ups, states, args);
  i32 first = lexed.tokenCount;
  Lexed lexedA = synthTokens(lexed, srcA, ups, states, args, 1, 1);
  // **The coroutine forms' names**, behind a second comment (ch36).
  Tail tl = appendWords(srcA, lexedA, "// wac:co-synth ", coWords(prog, src, lexed));
  u8[] src2 = tl.src;
  Lexed lexed2 = tl.lexed;
  Lw w = Lw(first, ups, args, src2, lexed2, prog, i32[].filled(1, 0), string[].filled(1, ""));

  // A machine function becomes two: the function calling its coroutine form, where it was, and the
  // form itself after every declaration the file wrote — whose count is how the emitter tells the
  // entry's own declarations, and so its exports, from the rest.
  Decl[] out = Decl[].filled(prog.decls.len() * 2, prog.decls[0]);
  Decl[] forms = Decl[].filled(prog.decls.len(), prog.decls[0]);
  i32 nf = 0;
  i32 n = 0;
  for (i32 d = 0; d < prog.decls.len(); d++) {
    out[n] = prog.decls[d];
    n = n + 1;
    match (prog.decls[d].kind) {
      Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
        Ctx c = Ctx(first, ups, args, prog.decls[d].line, prog.decls[d].col, string[](), src2, lexed2,
                    i32[].filled(1, 0), bool[].filled(1, false), i32[].filled(1, 0), Ty?[].defaulted(3));
        // **Lambdas first.** An `async` function's own machine substitutes its hoisted names into
        // everything its body contains, lambdas included — so a lambda lowered beforehand is
        // ordinary code by the time that walk reaches it.
        Stmt[] body2 = coRewrite(c, lowerLambdasIn(w, body, 0 - 1));
        if (!isMachineDecl(src2, lexed2, returnType, isAsync)) {
          out[n - 1] = Decl(DeclKind.Func(nameTok, returnType, params, body2, exported, typeParams,
                                          false),
                            prog.decls[d].line, prog.decls[d].col);
          continue;
        }
        Site at = Site(params, 0 - 1, prog.decls[d].line, prog.decls[d].col, prog.decls[d].col + 1000, isAsync, true);
        Stmt[]? machine = machineOf(w, at, body2, returnType, string[]());
        i32 coTok = coTokFor(c, "__wacCo_" + synthTextAt(src2, lexed2, nameTok));
        if (machine is null || coTok < 0) { continue; }
        forms[nf] = Decl(DeclKind.Func(coTok, coroutineTy(c, returnType, isAsync), params, machine!,
                                       exported, typeParams, false),
                         prog.decls[d].line, prog.decls[d].col);
        nf = nf + 1;
        out[n - 1] = Decl(DeclKind.Func(nameTok, machineCallerTy(c, returnType, isAsync), params,
                                        coWrapperBody(c, coTok, params, returnType, isAsync, 0 - 1),
                                        exported, typeParams, false),
                          prog.decls[d].line, prog.decls[d].col);
      }
      // **A method is a `Func` in all but name**, and `this` is an ordinary parameter, so the machine
      // that already survives a suspension over parameters needs nothing new for a receiver.
      StructDecl(sName, sParent, sFields, sMethods, sExported, sConst, sTypeParams): {
        if (sMethods.len() == 0) { continue; }
        out[n - 1] = Decl(DeclKind.StructDecl(sName, sParent, sFields, loweredMethods(w, prog.decls[d]),
                                          sExported, sConst, sTypeParams),
                      prog.decls[d].line, prog.decls[d].col);
      }
      EnumDecl(eName, eVariants, eExported, eMethods, eTypeParams): {
        if (eMethods.len() == 0) { continue; }
        out[n - 1] = Decl(DeclKind.EnumDecl(eName, eVariants, eExported, loweredMethods(w, prog.decls[d]),
                                        eTypeParams),
                      prog.decls[d].line, prog.decls[d].col);
      }
      default: { }
    }
  }

  Decl[] exact = Decl[].filled(n + nf, prog.decls[0]);
  for (i32 i = 0; i < n; i++) { exact[i] = out[i]; }
  for (i32 i = 0; i < nf; i++) { exact[n + i] = forms[i]; }
  return Lowered(Program(exact), src2, lexed2, true, w.why[0]);
}
