// The manifest a native host reads, written by the compiler rather than about it.
//
// `packages/platform/native.ts` derives this from wacc's metadata wire and writes the JSON — which
// is why `native/v8` can compile wac in one file but cannot yet *rebuild the file it carries*: the
// module it emits is correct and the section that makes a module self-describing is TypeScript.
// This is that half, in wac. `design/lang/0003` step 4.
//
// **Byte-identical output, not merely equivalent.** The two derivations are checked against each
// other with `cmp` — and a manifest that only *parsed* the
// same would leave the rebuilt seed a different file from the built one, so the interesting question
// (is this the same artefact?) would have no cheap answer. That is why the layout below reproduces
// `JSON.stringify(m, null, 2)` exactly, down to `[]` for an empty array.
//
// **What is not here: the walk.** The manifest is a function of the two wires the compiler already
// answers with (`bindTypesLinked`, `exportSigsLinked`) and the module's own export section. Nothing
// in this file knows how a struct is bound or how callbacks are numbered; it rearranges what the
// emitter said. A second copy of *that* would be the thing that drifts.

/**
 * The `$bind$` exports a module has, in the order it exports them.
 *
 * **The module is the authority on its own spelling.** A monomorphisation binds as
 * `Vec__packages_std_src_vec$string`, and a host that rebuilt that name from the wac one would be
 * reimplementing `mangleType` by eye. The method helpers (`$bind$m_`, `$bind$sm_`) are left out
 * because the manifest names those against the struct that owns them.
 */
export string[] bindExportsOf(u8[] wasm) {
  string[] out = string[4096](fill: "");
  i32 n = 0;
  if (wasm.len() < 8) { return exactlyN(out, 0); }
  i32 at = 8;
  while (at < wasm.len()) {
    i32 id = wasm[at];
    at = at + 1;
    i32 size = ulebAt(wasm, at);
    at = at + ulebWidth(wasm, at);
    i32 end = at + size;
    if (end > wasm.len()) { return exactlyN(out, n); }
    // Section 7 is the export section: a count, then `name`, kind, index for each.
    if (id == 7) {
      i32 p = at;
      i32 count = ulebAt(wasm, p);
      p = p + ulebWidth(wasm, p);
      for (i32 i = 0; i < count; i++) {
        i32 len = ulebAt(wasm, p);
        p = p + ulebWidth(wasm, p);
        u8[] name = u8[len]();
        for (i32 k = 0; k < len; k++) { name[k] = wasm[p + k]; }
        p = p + len;
        p = p + 1;                        // the kind byte
        p = p + ulebWidth(wasm, p);       // the index
        string s = string.fromBytes(name);
        if (s.len() > 6 && s.slice(0, 6) == "$bind$" && !startsWith(s, "$bind$m_")
            && !startsWith(s, "$bind$sm_") && n < out.len()) {
          out[n] = s;
          n = n + 1;
        }
      }
    }
    at = end;
  }
  return exactlyN(out, n);
}

bool startsWith(string s, string p) {
  return s.len() >= p.len() && s.slice(0, p.len()) == p;
}

string[] exactlyN(string[] xs, i32 n) {
  string[] out = string[n](fill: "");
  for (i32 i = 0; i < n; i++) { out[i] = xs[i]; }
  return out;
}

i32 ulebAt(u8[] bytes, i32 at) {
  i32 value = 0;
  i32 shift = 0;
  i32 i = at;
  while (i < bytes.len()) {
    i32 b = bytes[i];
    value = value | ((b & 0x7f) << shift);
    i = i + 1;
    if ((b & 0x80) == 0) { return value; }
    shift = shift + 7;
    if (shift > 28) { return value; }
  }
  return value;
}

i32 ulebWidth(u8[] bytes, i32 at) {
  i32 i = at;
  while (i < bytes.len()) {
    if ((bytes[i] & 0x80) == 0) { return i - at + 1; }
    i = i + 1;
  }
  return 1;
}

/**
 * Split on `sep`, ignoring one inside brackets.
 *
 * A type can hold the separator: `Map<u8[],i32>` is one field type with a comma in it, and a plain
 * split turns `index:Map<u8[],i32>` into a field of type `Map<u8[]` and a second called `i32>`.
 */
export string[] splitTop(string text, string sep) {
  string[] out = string[countOf(text, sep) + 1](fill: "");
  i32 n = 0;
  i32 depth = 0;
  string cur = "";
  for (i32 i = 0; i < text.len(); i++) {
    string ch = text.slice(i, i + 1);
    if (ch == "<" || ch == "[" || ch == "(") { depth = depth + 1; }
    else if (ch == ">" || ch == "]" || ch == ")") { depth = depth - 1; }
    if (ch == sep && depth == 0) {
      if (n < out.len()) { out[n] = cur; n = n + 1; }
      cur = "";
      continue;
    }
    cur = cur + ch;
  }
  if (n < out.len()) { out[n] = cur; n = n + 1; }
  return exactlyN(out, n);
}

/** The cells of one tab-separated line. Plain: a tab cannot be inside a type. */
string[] cells(string line) {
  return splitOn(line, "\t");
}

/**
 * How many pieces a split will produce, counted before allocating one.
 *
 * **Sized from what fills it.** These arrays held 64 and 256, which is plenty for a line's cells and
 * nowhere near enough for the lines of a metadata wire — and an overflowing write was dropped, so a
 * struct simply had no methods and the manifest was *shorter* rather than wrong-looking. A truncated
 * list reads exactly like a short one.
 */
i32 countOf(string text, string sep) {
  i32 n = 0;
  for (i32 i = 0; i < text.len(); i++) {
    if (text.slice(i, i + 1) == sep) { n = n + 1; }
  }
  return n;
}

string[] splitOn(string text, string sep) {
  string[] out = string[countOf(text, sep) + 1](fill: "");
  i32 n = 0;
  string cur = "";
  for (i32 i = 0; i < text.len(); i++) {
    string ch = text.slice(i, i + 1);
    if (ch == sep) {
      if (n < out.len()) { out[n] = cur; n = n + 1; }
      cur = "";
      continue;
    }
    cur = cur + ch;
  }
  if (n < out.len()) { out[n] = cur; n = n + 1; }
  return exactlyN(out, n);
}

string cellAt(string[] cs, i32 i) { return i < cs.len() ? cs[i] : ""; }

/** A JSON string literal. The names here are identifiers and types, and this assumes nothing. */
string quoted(string s) {
  string out = "\"";
  for (i32 i = 0; i < s.len(); i++) {
    string ch = s.slice(i, i + 1);
    if (ch == "\"") { out = out + "\\\""; }
    else if (ch == "\\") { out = out + "\\\\"; }
    else if (ch == "\n") { out = out + "\\n"; }
    else if (ch == "\t") { out = out + "\\t"; }
    else { out = out + ch; }
  }
  return out + "\"";
}

/** `n` levels of two-space indent, which is what `JSON.stringify(m, null, 2)` writes. */
string pad(i32 n) {
  string out = "";
  for (i32 i = 0; i < n; i++) { out = out + "  "; }
  return out;
}

/** `["a", "b"]` on one line is not what `stringify` does — each element gets a line. */
string jsonStrings(string[ ] xs, i32 depth) {
  if (xs.len() == 0) { return "[]"; }
  string out = "[\n";
  for (i32 i = 0; i < xs.len(); i++) {
    out = out + pad(depth + 1) + quoted(xs[i]) + (i + 1 < xs.len() ? ",\n" : "\n");
  }
  return out + pad(depth) + "]";
}

/** A type as the manifest spells it: an empty return is `void`. */
string orVoid(string t) { return t == "" ? "void" : t; }

/**
 * The manifest for a module, given the compiler's own description of it.
 *
 * `wire` is `bindTypesLinked`, `sigs` is `exportSigsLinked`, `wasm` is the module — read for its
 * export names only. `wasmName` is the file the manifest sits beside, and `grants` is the bitmask
 * `platform.wac` uses: 1 read, 2 write, 4 net, 8 env.
 */
export string manifestOf(u8[] wasm, string wire, string sigs, string entry, string wasmName,
                         i32 grants) {
  string out = "{\n";
  out = out + pad(1) + "\"version\": 1,\n";
  out = out + pad(1) + "\"entry\": " + quoted(entry) + ",\n";
  out = out + pad(1) + "\"wasm\": " + quoted(wasmName) + ",\n";
  out = out + pad(1) + "\"grants\": {\n";
  out = out + pad(2) + "\"read\": " + ((grants & 1) != 0 ? "true" : "false") + ",\n";
  out = out + pad(2) + "\"write\": " + ((grants & 2) != 0 ? "true" : "false") + ",\n";
  out = out + pad(2) + "\"env\": " + ((grants & 8) != 0 ? "true" : "false") + ",\n";
  out = out + pad(2) + "\"net\": " + ((grants & 4) != 0 ? "true" : "false") + ",\n";
  out = out + pad(2) + "\"run\": " + ((grants & 16) != 0 ? "true" : "false") + "\n";
  out = out + pad(1) + "},\n";
  out = out + pad(1) + "\"callbacks\": " + callbacksJson(wire) + ",\n";
  out = out + pad(1) + "\"bind\": " + bindJson(wasm) + ",\n";
  out = out + pad(1) + "\"structs\": " + structsJson(wire) + ",\n";
  out = out + pad(1) + "\"exports\": " + exportsJson(sigs) + "\n";
  return out + "}\n";
}

/**
 * The callbacks, in the order `wac.cb<j>` is numbered.
 *
 * `slots` is 16 because both compilers write that many trampolines per signature — `callbackSlots()`
 * in `emit.wac` — and a host that registers a seventeenth dies a long way from the cause.
 */
string callbacksJson(string wire) {
  string[] lines = splitOn(wire, "\n");
  string out = "";
  i32 n = 0;
  for (i32 i = 0; i < lines.len(); i++) {
    if (!startsWith(lines[i], "C\t")) { continue; }
    string[] c = cells(lines[i]);
    string index = cellAt(c, 1);
    string params = cellAt(c, 3);
    if (n > 0) { out = out + ",\n"; }
    out = out + pad(2) + "{\n";
    out = out + pad(3) + "\"field\": " + quoted("cb" + index) + ",\n";
    out = out + pad(3) + "\"helper\": " + quoted("$bind$fnref_" + index) + ",\n";
    out = out + pad(3) + "\"type\": " + quoted(cellAt(c, 4)) + ",\n";
    out = out + pad(3) + "\"params\": " + jsonStrings(params == "" ? string[0](fill: "")
                                                     : splitTop(params, ","), 3) + ",\n";
    out = out + pad(3) + "\"ret\": " + quoted(orVoid(cellAt(c, 2))) + ",\n";
    out = out + pad(3) + "\"slots\": 16\n";
    out = out + pad(2) + "}";
    n = n + 1;
  }
  if (n == 0) { return "[]"; }
  return "[\n" + out + "\n" + pad(1) + "]";
}

/** The exports a host needs by name — the memory and the string helpers, as the module spells them. */
string bindJson(u8[] wasm) {
  string[] names = bindExportsOf(wasm);
  if (names.len() == 0) { return "{}"; }
  string out = "{\n";
  for (i32 i = 0; i < names.len(); i++) {
    string key = names[i].slice(6, names[i].len());
    out = out + pad(2) + quoted(key) + ": " + quoted(names[i])
        + (i + 1 < names.len() ? ",\n" : "\n");
  }
  return out + pad(1) + "}";
}

/**
 * The structs and enums the boundary carries, with an alias for each second spelling.
 *
 * `Pending<u8[]?>` and `Pending<u8[]>` are one wasm type — a nullable reference and a reference are
 * the same slot — so the emitter registers one and records the other as an alias. A host asks by
 * name, so each alias becomes a second entry pointing at the same bind stem, which is true rather
 * than a workaround: they are the same type reached by two names.
 */
string structsJson(string wire) {
  string[] lines = splitOn(wire, "\n");
  // Two passes rather than a growing list of structs: one to render each type, one to render the
  // aliases against the text already produced. The rendering needs the owner's methods, which arrive
  // on later lines, so the walk collects per type first.
  string[] names = string[512](fill: "");
  string[] binds = string[512](fill: "");
  string[] kinds = string[512](fill: "");
  string[] payloads = string[512](fill: "");
  i32 count = 0;
  for (i32 i = 0; i < lines.len(); i++) {
    string[] c = cells(lines[i]);
    string tag = cellAt(c, 0);
    if (tag != "S" && tag != "E") { continue; }
    if (count >= names.len()) { continue; }
    names[count] = cellAt(c, 1);
    binds[count] = cellAt(c, 2);
    kinds[count] = tag;
    payloads[count] = cellAt(c, 3);
    count = count + 1;
  }
  string out = "";
  i32 n = 0;
  for (i32 t = 0; t < count; t++) {
    if (n > 0) { out = out + ",\n"; }
    out = out + oneStruct(names[t], binds[t], kinds[t], payloads[t], lines);
    n = n + 1;
  }
  // `A <identity> <spelling>`: the same class under another name, unless that name is already a
  // class of its own.
  for (i32 i = 0; i < lines.len(); i++) {
    if (!startsWith(lines[i], "A\t")) { continue; }
    string[] c = cells(lines[i]);
    string of = cellAt(c, 1);
    string alias = cellAt(c, 2);
    bool taken = false;
    for (i32 t = 0; t < count; t++) { if (names[t] == alias) { taken = true; } }
    if (taken) { continue; }
    for (i32 t = 0; t < count; t++) {
      if (names[t] != of) { continue; }
      if (n > 0) { out = out + ",\n"; }
      out = out + oneStruct(alias, binds[t], kinds[t], payloads[t], lines);
      n = n + 1;
    }
  }
  if (n == 0) { return "[]"; }
  return "[\n" + out + "\n" + pad(1) + "]";
}

string oneStruct(string name, string bind, string kind, string payload, string[] lines) {
  string out = pad(2) + "{\n";
  out = out + pad(3) + "\"name\": " + quoted(name) + ",\n";
  out = out + pad(3) + "\"bind\": " + quoted(bind) + ",\n";
  out = out + pad(3) + "\"fields\": " + fieldsJson(kind == "S" ? payload : "", 3) + ",\n";
  out = out + pad(3) + "\"methods\": " + methodsJson(bind, lines) + ",\n";
  out = out + pad(3) + "\"variants\": " + variantsJson(kind == "E" ? payload : "", bind) + "\n";
  return out + pad(2) + "}";
}

/** `field:type,field:type` — a struct's fields in construction order. */
string fieldsJson(string payload, i32 depth) {
  if (payload == "") { return "[]"; }
  string[] fs = splitTop(payload, ",");
  string out = "[\n";
  for (i32 i = 0; i < fs.len(); i++) {
    i32 at = fs[i].indexOf(":");
    string fname = at < 0 ? fs[i] : fs[i].slice(0, at);
    string ftype = at < 0 ? "" : fs[i].slice(at + 1, fs[i].len());
    out = out + pad(depth + 1) + "{\n";
    out = out + pad(depth + 2) + "\"name\": " + quoted(fname) + ",\n";
    out = out + pad(depth + 2) + "\"type\": " + quoted(ftype) + "\n";
    out = out + pad(depth + 1) + "}" + (i + 1 < fs.len() ? ",\n" : "\n");
  }
  return out + pad(depth) + "]";
}

/** `M <bind> <method> this|static <ret> <params>` — the methods of the type that owns them. */
string methodsJson(string bind, string[] lines) {
  string out = "";
  i32 n = 0;
  for (i32 i = 0; i < lines.len(); i++) {
    if (!startsWith(lines[i], "M\t")) { continue; }
    string[] c = cells(lines[i]);
    if (cellAt(c, 1) != bind) { continue; }
    bool hasThis = cellAt(c, 3) == "this";
    string params = cellAt(c, 5);
    if (n > 0) { out = out + ",\n"; }
    out = out + pad(4) + "{\n";
    out = out + pad(5) + "\"name\": " + quoted(cellAt(c, 2)) + ",\n";
    out = out + pad(5) + "\"isStatic\": " + (hasThis ? "false" : "true") + ",\n";
    out = out + pad(5) + "\"params\": " + jsonStrings(params == "" ? string[0](fill: "")
                                                     : splitTop(params, ","), 5) + ",\n";
    out = out + pad(5) + "\"ret\": " + quoted(orVoid(cellAt(c, 4))) + ",\n";
    out = out + pad(5) + "\"export\": "
        + quoted("$bind$" + (hasThis ? "m_" : "sm_") + bind + "_" + cellAt(c, 2)) + "\n";
    out = out + pad(4) + "}";
    n = n + 1;
  }
  if (n == 0) { return "[]"; }
  return "[\n" + out + "\n" + pad(3) + "]";
}

/** `Variant:field:type|field:type;Variant:` — a variant's payload, and how to build one. */
string variantsJson(string payload, string bind) {
  if (payload == "") { return "[]"; }
  string[] vs = splitTop(payload, ";");
  string out = "[\n";
  for (i32 i = 0; i < vs.len(); i++) {
    i32 at = vs[i].indexOf(":");
    string vname = at < 0 ? vs[i] : vs[i].slice(0, at);
    string rest = at < 0 ? "" : vs[i].slice(at + 1, vs[i].len());
    out = out + pad(4) + "{\n";
    out = out + pad(5) + "\"name\": " + quoted(vname) + ",\n";
    out = out + pad(5) + "\"fields\": " + variantFields(rest, 5) + ",\n";
    out = out + pad(5) + "\"make\": " + quoted("$bind$e_" + bind + "_" + vname + "_new") + "\n";
    out = out + pad(4) + "}" + (i + 1 < vs.len() ? ",\n" : "\n");
  }
  return out + pad(3) + "]";
}

/** A variant's payload is `|`-separated, because `,` is already inside a type. */
string variantFields(string rest, i32 depth) {
  if (rest == "") { return "[]"; }
  string[] fs = splitTop(rest, "|");
  string out = "[\n";
  for (i32 i = 0; i < fs.len(); i++) {
    i32 at = fs[i].indexOf(":");
    string fname = at < 0 ? fs[i] : fs[i].slice(0, at);
    string ftype = at < 0 ? "" : fs[i].slice(at + 1, fs[i].len());
    out = out + pad(depth + 1) + "{\n";
    out = out + pad(depth + 2) + "\"name\": " + quoted(fname) + ",\n";
    out = out + pad(depth + 2) + "\"type\": " + quoted(ftype) + "\n";
    out = out + pad(depth + 1) + "}" + (i + 1 < fs.len() ? ",\n" : "\n");
  }
  return out + pad(depth) + "]";
}

/** `name<TAB>ret<TAB>params` — what a host may call, the `$bind$` helpers excluded. */
string exportsJson(string sigs) {
  string[] lines = splitOn(sigs, "\n");
  string out = "";
  i32 n = 0;
  for (i32 i = 0; i < lines.len(); i++) {
    if (lines[i] == "") { continue; }
    string[] c = cells(lines[i]);
    string name = cellAt(c, 0);
    if (startsWith(name, "$bind$")) { continue; }
    string params = cellAt(c, 2);
    if (n > 0) { out = out + ",\n"; }
    out = out + pad(2) + "{\n";
    out = out + pad(3) + "\"name\": " + quoted(name) + ",\n";
    out = out + pad(3) + "\"params\": " + jsonStrings(params == "" ? string[0](fill: "")
                                                     : splitTop(params, ","), 3) + ",\n";
    out = out + pad(3) + "\"ret\": " + quoted(orVoid(cellAt(c, 1))) + "\n";
    out = out + pad(2) + "}";
    n = n + 1;
  }
  if (n == 0) { return "[]"; }
  return "[\n" + out + "\n" + pad(1) + "]";
}

/**
 * The module with its manifest **inside it**, as a custom section named `wac.manifest`.
 *
 * A module that describes itself is one artefact rather than two, which is what lets `spawn` take
 * wasm: a program handed bytes can run them without a second file it has no way to find. A custom
 * section is the format's own extension point — id 0, a name, and bytes nobody else reads.
 */
export u8[] withManifestSection(u8[] wasm, string manifest) {
  u8[] name = "wac.manifest".toBytes();
  u8[] body = manifest.toBytes();
  u8[] nameLen = uleb(name.len());
  i32 payload = nameLen.len() + name.len() + body.len();
  u8[] size = uleb(payload);
  u8[] out = u8[wasm.len() + 1 + size.len() + payload]();
  i32 at = 0;
  for (i32 i = 0; i < wasm.len(); i++) { out[at + i] = wasm[i]; }
  at = at + wasm.len();
  out[at] = 0;                                     // a custom section
  at = at + 1;
  for (i32 i = 0; i < size.len(); i++) { out[at + i] = size[i]; }
  at = at + size.len();
  for (i32 i = 0; i < nameLen.len(); i++) { out[at + i] = nameLen[i]; }
  at = at + nameLen.len();
  for (i32 i = 0; i < name.len(); i++) { out[at + i] = name[i]; }
  at = at + name.len();
  for (i32 i = 0; i < body.len(); i++) { out[at + i] = body[i]; }
  return out;
}

/** The format's own integer encoding, which is the only reason this needs any code at all. */
u8[] uleb(i32 n) {
  u8[] buf = u8[5]();
  i32 len = 0;
  i32 v = n;
  bool more = true;
  while (more) {
    i32 b = v & 0x7f;
    v = v >>> 7;
    if (v != 0) { b = b | 0x80; }
    buf[len] = b;
    len = len + 1;
    more = v != 0;
  }
  u8[] out = u8[len]();
  for (i32 i = 0; i < len; i++) { out[i] = buf[i]; }
  return out;
}
