          + "   */\n"
          + "  Pending<T> driven(i32 id, fn<T(i32)> resolve, fn<bool(i32)> settled, fn<void(i32)> drop) {\n"
          + "    return Pending<T>(id, resolve, settled, drop, null, true);\n"
          + "  }\n"
          + "\n"
          + "  /**\n"
          + "   * The same ticket, told **which world** runs its continuations.\n"
