          + "\n"
          + "/** Byte-wise equality, the companion `eq` for a `u8[]`-keyed Map. */\n"
          + "export bool bytesEq(const u8[] a, u8[] b) {\n"
          + "  if (a.len() != b.len()) { return false; }\n"
          + "  for (i32 i = 0; i < a.len(); i++) {\n"
          + "    if (a[i] != b[i]) { return false; }\n"
          + "  }\n"
          + "  return true;\n"
          + "}\n"
