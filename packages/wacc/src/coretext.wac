// Generated by `wac task gen:core` from core/read.wac, core/jsx.wac. Do not edit.
//
// wacc's embedding of `core`. `core/README.md` says why anything is in there; this file is only the
// text, kept apart from `emit.wac` so that a generator owns a whole file rather than splicing into
// one that is also in the seed.

export string coreSource() {
  string s = "// What a read answered.\n"
             + "//\n"
             + "// The shape exists because the obvious answer, `u8[]`, has a hole in it: an empty array means both\n"
             + "// \"the input finished\" and \"the read failed\". Filters that treated the second as the first exited 0\n"
             + "// having written half their output, and a gzip stream produced a *valid* archive of half its input\n"
             + "// with a CRC to match. A companion `inputError()` to ask afterwards was tried first and left the\n"
             + "// ordinary path looking exactly as correct as it had been, so anyone who forgot to ask got the old\n"
             + "// behaviour back. This cannot be forgotten: `match` is exhaustive, and a caller that ignores\n"
             + "// `Failed` does not compile.\n"
             + "//\n"
             + "// It is in `core` rather than in a package because both ends of a stream have to name it and no\n"
             + "// adapter can join two copies — see the note at the top of compiler/wacCore.ts.\n"
             + "\n"
             + "export enum Read {\n"
             + "  /** Bytes, and never zero of them — an empty answer is `End`. */\n"
             + "  Data(u8[] bytes),\n"
             + "  /** The input finished. Not a failure. */\n"
             + "  End,\n"
             + "  /** It did not finish, and this is the host's own message. */\n"
             + "  Failed(string why)\n"
             + "}\n"
             + "\n"
             + "// The tree JSX builds.\n"
             + "//\n"
             + "// It is here rather than in a package because the compiler emits the constructor calls: a tree\n"
             + "// built in one repository and a renderer in another must name one type or nothing composes, and no\n"
             + "// author chose the name to be able to fix it. `design/lang/0004`.\n"
             + "//\n"
             + "// **wacc-only.** The reference compiler has no JSX frontend, so its embedding of `core` does not\n"
             + "// include this file — `compiler/README.md` carries the row. That omission is the reason `core` is a\n"
             + "// directory rather than one file: which compiler gets a declaration is expressed by which file it\n"
             + "// is in, and `tools/genCore.ts` lists them. A marker inside a shared file would have been a third\n"
             + "// thing to invent and to keep true.\n"
             + "\n"
             + "export struct Attr {\n"
             + "  string name;\n"
             + "  string value;\n"
             + "}\n"
             + "\n"
             + "// **`Fragment` is a variant rather than an element with an empty tag**, so that a renderer is\n"
             + "// *told*: `match` is exhaustive, and a walk written before fragments existed stops compiling with\n"
             + "// the arm it is missing named. An empty tag would have rendered as `<>` in every renderer that had\n"
             + "// not heard of them. `design/lang/0006`.\n"
             + "export enum Node {\n"
             + "  Element(string tag, Attr[] attrs, Node[] kids),\n"
             + "  Text(string text),\n"
             + "  Fragment(Node[] kids)\n"
             + "}\n";
  return s;
}

/**
 * A sibling of the tree by the specifier that names it, or "" when there is no such file.
 *
 * `coreSource` above is the *root* — what `import … from core;` gets. These are files in the tree,
 * each its own module, reached as `import { Option } from "core/option.wac";`. "" rather than a trap
 * because the caller has to tell "not a built-in" from "a built-in that is broken": the first falls
 * through to the filesystem and the second is this generator's bug.
 */
export string coreFile(string path) {
  if (path == "core/option.wac") {
    string s = "// Option<T> — a value that may be absent, without using null.\n"
               + "//\n"
               + "// wac has `T?`, and it works for every T including a primitive (wac issue 0045). For a\n"
               + "// reference it is also cheaper — one word, no allocation — so `Point?` is the right thing to\n"
               + "// write and `Option<Point>` is not. Option earns its place on two narrower grounds:\n"
               + "//\n"
               + "//   - **a nested absence.** `T??` does not exist, so a container of nullables cannot\n"
               + "//     distinguish \"no entry\" from \"an entry holding null\". `Option<T?>` can, which is why\n"
               + "//     `Map.get` returns one: `Map<string, JsonValue?>` is a real shape and `null` would be\n"
               + "//     ambiguous in it.\n"
               + "//   - **an absent case that is a compile error to forget.** `match` is exhaustive. A missing\n"
               + "//     `case` is refused; a missing null check is not.\n"
               + "//\n"
               + "// A nullable primitive is boxed, and so is an Option, so between `i32?` and `Option<i32>`\n"
               + "// there is nothing to choose on cost — pick by which of the two reasons above applies.\n"
               + "\n"
               + "export enum Option<T> {\n"
               + "  Some(T v), None\n"
               + "\n"
               + "  bool isSome(const this) {\n"
               + "    return match (this) { case Some(_): true, case None: false };\n"
               + "  }\n"
               + "\n"
               + "  bool isNone(const this) {\n"
               + "    return match (this) { case Some(_): false, case None: true };\n"
               + "  }\n"
               + "\n"
               + "  /** The value, or `d` if there is none. */\n"
               + "  T orElse(const this, T d) {\n"
               + "    return match (this) { case Some(v): v, case None: d };\n"
               + "  }\n"
               + "\n"
               + "  /**\n"
               + "   * The value, or a trap.\n"
               + "   *\n"
               + "   * For the case where absence is a bug rather than a possibility — the parallel of `x!`\n"
               + "   * on a nullable. `trap` carries no message, so prefer `match` where the caller can say\n"
               + "   * something useful.\n"
               + "   */\n"
               + "  T unwrap(const this) {\n"
               + "    match (this) {\n"
               + "      case Some(v): return v;\n"
               + "      case None: trap;\n"
               + "    }\n"
               + "  }\n"
               + "}\n"
               + "\n"
               + "/**\n"
               + " * `f` applied to the value, if there is one.\n"
               + " *\n"
               + " * A free function rather than a method because a method cannot introduce a type parameter\n"
               + " * of its own: `U` is not the enum's. Inference reads `T` from the Option and `U` from the\n"
               + " * function's return type, so the call site names neither.\n"
               + " */\n"
               + "export Option<U> mapOption<T, U>(Option<T> o, fn[U(T)] f) {\n"
               + "  return match (o) {\n"
               + "    case Some(v): Option.Some(f(v)),\n"
               + "    case None: Option.None,\n"
               + "  };\n"
               + "}\n";
    return s;
  }
  if (path == "core/result.wac") {
    string s = "// Result<T, E> — a value or an error, as a type rather than a convention.\n"
               + "//\n"
               + "// wac has `trap`, which carries no message and cannot be caught, so a function that can\n"
               + "// fail has had three options: trap, return a sentinel, or return a bool and write the real\n"
               + "// answer through an out-parameter struct. json's parser uses the third and it costs a\n"
               + "// struct per call site.\n"
               + "//\n"
               + "// `E` is a type parameter rather than a fixed error type because the useful error differs:\n"
               + "// a parser wants a message and a position, an arithmetic routine wants a code, and a\n"
               + "// caller that only branches wants nothing but the fact of failure — `Result<T, bool>`.\n"
               + "\n"
               + "import { Option } from \"./option.wac\";\n"
               + "\n"
               + "export enum Result<T, E> {\n"
               + "  Ok(T v), Err(E e)\n"
               + "\n"
               + "  bool isOk(const this) {\n"
               + "    return match (this) { case Ok(_): true, case Err(_): false };\n"
               + "  }\n"
               + "\n"
               + "  bool isErr(const this) {\n"
               + "    return match (this) { case Ok(_): false, case Err(_): true };\n"
               + "  }\n"
               + "\n"
               + "  /** The value, or `d` if this is an error. */\n"
               + "  T orElse(const this, T d) {\n"
               + "    return match (this) { case Ok(v): v, case Err(_): d };\n"
               + "  }\n"
               + "\n"
               + "  /** The value, or a trap. For when an error here means the program is wrong. */\n"
               + "  T unwrap(const this) {\n"
               + "    match (this) {\n"
               + "      case Ok(v): return v;\n"
               + "      case Err(_): trap;\n"
               + "    }\n"
               + "  }\n"
               + "\n"
               + "  /** The value if there is one, discarding the error — for when only presence matters. */\n"
               + "  Option<T> ok(const this) {\n"
               + "    return match (this) {\n"
               + "      case Ok(v): Option.Some(v),\n"
               + "      case Err(_): Option.None,\n"
               + "    };\n"
               + "  }\n"
               + "\n"
               + "  /** The error if there is one. */\n"
               + "  Option<E> err(const this) {\n"
               + "    return match (this) {\n"
               + "      case Ok(_): Option.None,\n"
               + "      case Err(e): Option.Some(e),\n"
               + "    };\n"
               + "  }\n"
               + "}\n";
    return s;
  }
  if (path == "core/hash.wac") {
    string s = "// Hash and equality functions for the key types worth having ready-made.\n"
               + "//\n"
               + "// `Map<K, V>` takes its hash and equality as funcrefs rather than requiring anything of K,\n"
               + "// because wac has no traits and no constraints on type parameters. That is not only a\n"
               + "// workaround: it also lets one key type be hashed two ways — case-insensitively, or on a\n"
               + "// field of a struct — without a wrapper type.\n"
               + "//\n"
               + "// A hash may return any i32. `Map` masks it, so a poor low bit distribution costs\n"
               + "// collisions rather than correctness.\n"
               + "\n"
               + "/**\n"
               + " * FNV-1a over a byte slice, 32-bit.\n"
               + " *\n"
               + " * Chosen over anything stronger for the reason a hash table wants: it is a handful of\n"
               + " * instructions per byte, and the keys it will see are identifiers and JSON member names\n"
               + " * rather than adversarial input. It is not keyed and not collision-resistant — a Map fed\n"
               + " * untrusted keys wants a keyed hash passed in instead, which is what the funcref is for.\n"
               + " *\n"
               + " * Bytes rather than `string` is the primitive because that is what `json` has: it holds\n"
               + " * member names as `u8[]` on purpose, so hashing one must not allocate a string first.\n"
               + " */\n"
               + "export i32 hashBytes(u8[] b) {\n"
               + "  u32 h = 2166136261;\n"
               + "  for (i32 i = 0; i < b.len(); i++) {\n"
               + "    h = h ^ (b[i] as@ u32);\n"
               + "    h = h * 16777619;\n"
               + "  }\n"
               + "  return h as@ i32;\n"
               + "}\n"
               + "\n"
               + "/** Byte-wise equality, the companion `eq` for a `u8[]`-keyed Map. */\n"
               + "export bool bytesEq(u8[] a, u8[] b) {\n"
               + "  if (a.len() != b.len()) { return false; }\n"
               + "  for (i32 i = 0; i < a.len(); i++) {\n"
               + "    if (a[i] != b[i]) { return false; }\n"
               + "  }\n"
               + "  return true;\n"
               + "}\n"
               + "\n"
               + "/**\n"
               + " * The same hash over a string's UTF-8 bytes.\n"
               + " *\n"
               + " * Delegates rather than repeating the loop: FNV-1a was written twice — here and in `bytes` —\n"
               + " * and two copies of a hash can drift into disagreeing about the same bytes. Nothing would\n"
               + " * catch that, because a Map answers every query correctly as long as *one* hash is used per\n"
               + " * map; it would surface only where something hashed a key one way and looked it up the other\n"
               + " * (wac-mono issue 0004, reported by agent-b).\n"
               + " */\n"
               + "export i32 hashString(string s) { return hashBytes(s.toBytes()); }\n"
               + "\n"
               + "export bool stringEq(string a, string b) { return a == b; }\n"
               + "\n"
               + "/**\n"
               + " * An i32 key, mixed.\n"
               + " *\n"
               + " * Returning the key unchanged would be a valid hash and a bad one: `Map` takes the low bits\n"
               + " * of it, and consecutive or aligned integers — array indices, pointers, ids — would then\n"
               + " * collide in runs. This is the finaliser from MurmurHash3, which is four multiplies and\n"
               + " * gives every input bit a chance to affect the low ones.\n"
               + " */\n"
               + "export i32 hashI32(i32 x) {\n"
               + "  u32 h = x as@ u32;\n"
               + "  h = h ^ (h >> 16);\n"
               + "  h = h * 2246822507;\n";
    s = s + "  h = h ^ (h >> 13);\n"
            + "  h = h * 3266489909;\n"
            + "  h = h ^ (h >> 16);\n"
            + "  return h as@ i32;\n"
            + "}\n"
            + "\n"
            + "export bool i32Eq(i32 a, i32 b) { return a == b; }\n"
            + "\n"
            + "/** The same mixing for a 64-bit key, folded to 32 bits. */\n"
            + "export i32 hashI64(i64 x) {\n"
            + "  u64 h = x as@ u64;\n"
            + "  h = h ^ (h >> 33);\n"
            + "  h = h * 18397679294719823053;\n"
            + "  h = h ^ (h >> 29);\n"
            + "  h = h * 14181476777654086739;\n"
            + "  h = h ^ (h >> 32);\n"
            + "  return (h & 4294967295) as@ i32;\n"
            + "}\n"
            + "\n"
            + "export bool i64Eq(i64 a, i64 b) { return a == b; }\n";
    return s;
  }
  if (path == "core/map.wac") {
    string s = "// Map<K, V> — a hash map, open-addressed with linear probing.\n"
               + "//\n"
               + "// The measured demand: `json`'s object lookup is O(n) in the number of members, so a\n"
               + "// document that reads the same object repeatedly is quadratic. Nothing in this repo could\n"
               + "// fix that before generics, because a map over `string -> JsonValue` written by hand would\n"
               + "// have been a fourth hand-rolled container.\n"
               + "//\n"
               + "// **Hash and equality arrive as funcrefs**, not as a requirement on K. wac has no traits, so\n"
               + "// there is no `K: Hash` to ask for — and the funcrefs turn out to be better than a trait\n"
               + "// would have been: `hash.wac` has the ready-made ones, and a caller who wants\n"
               + "// case-insensitive keys or hashing on one field of a struct passes their own without\n"
               + "// wrapping the key type.\n"
               + "//\n"
               + "// Linear probing rather than chaining because it needs one array rather than one per bucket,\n"
               + "// and WasmGC arrays are the only allocation wac gives cheaply. Deletion is backward-shift,\n"
               + "// not tombstones, so a table that is filled and emptied repeatedly does not degrade.\n"
               + "\n"
               + "import { Option } from \"core/option.wac\";\n"
               + "\n"
               + "/**\n"
               + " * One slot's contents.\n"
               + " *\n"
               + " * A struct rather than parallel `K[]`/`V[]` arrays because an empty slot has to be\n"
               + " * representable: `Entry<K, V>?[]` is an array of nulls at creation, whereas `K[n]()` needs a\n"
               + " * default value for K and a struct or enum has none. The nullable is the same trick\n"
               + " * `json`'s hand-written containers use, and it costs one reference per slot.\n"
               + " */\n"
               + "struct MapEntry<K, V> {\n"
               + "  K key;\n"
               + "  V val;\n"
               + "}\n"
               + "\n"
               + "export struct Map<K, V> {\n"
               + "  MapEntry<K, V>?[] slots;\n"
               + "  i32 n;\n"
               + "  fn[i32(K)] hash;\n"
               + "  fn[bool(K, K)] eq;\n"
               + "\n"
               + "  /**\n"
               + "   * An empty Map.\n"
               + "   *\n"
               + "   * ```wac\n"
               + "   * Map<string, i32> m = Map.create(hashString, stringEq);\n"
               + "   * ```\n"
               + "   *\n"
               + "   * The type arguments come from the declared type; the funcrefs say how K behaves.\n"
               + "   */\n"
               + "  Map<K, V> create(fn[i32(K)] hash, fn[bool(K, K)] eq) {\n"
               + "    return Map(MapEntry<K, V>?[8](), 0, hash, eq);\n"
               + "  }\n"
               + "\n"
               + "  /** An empty Map with room for `capacity` entries before it has to grow. */\n"
               + "  Map<K, V> withCapacity(i32 capacity, fn[i32(K)] hash, fn[bool(K, K)] eq) {\n"
               + "    // Slots are a power of two so the mask replaces a modulo, and the load factor is 3/4, so\n"
               + "    // the array has to be a third larger than the capacity asked for.\n"
               + "    // In i64, because both lines wrapped in i32: a large `capacity` made `want` negative, and once\n"
               + "    // the doubling passed the ceiling `size` went negative and the loop ran for ever. Clamped at the\n"
               + "    // largest power of two an array can hold, so an impossible request fails on the allocation\n"
               + "    // rather than hanging before it.\n"
               + "    i64 want = (capacity as i64) + ((capacity as i64) / 3) + 1;\n"
               + "    i64 size = 8;\n"
               + "    while (size < want && size < 1073741824) { size = size * 2; }\n"
               + "    return Map(MapEntry<K, V>?[size as! i32](), 0, hash, eq);\n"
               + "  }\n";
    s = s + "\n"
            + "  i32 len(const this) { return this.n; }\n"
            + "\n"
            + "  bool isEmpty(const this) { return this.n == 0; }\n"
            + "\n"
            + "  /** Slots allocated. Interesting only when measuring growth. */\n"
            + "  i32 capacity(const this) { return this.slots.len(); }\n"
            + "\n"
            + "  /**\n"
            + "   * The slot `k` lives in, or the first free slot on its probe sequence.\n"
            + "   *\n"
            + "   * One function for lookup and insert, because they walk the same sequence and separating\n"
            + "   * them means writing the probe loop twice. The caller tells the two cases apart by asking\n"
            + "   * whether the slot is null.\n"
            + "   */\n"
            + "  i32 slotFor(const this, K k) {\n"
            + "    i32 mask = this.slots.len() - 1;\n"
            + "    i32 i = this.hash(k) & mask;\n"
            + "    while (true) {\n"
            + "      MapEntry<K, V>? e = this.slots[i];\n"
            + "      if (e is null) { return i; }\n"
            + "      if (this.eq(e!.key, k)) { return i; }\n"
            + "      i = (i + 1) & mask;\n"
            + "    }\n"
            + "    // Unreachable: the table is never full — `set` grows at 3/4 load — so the loop always\n"
            + "    // finds a null slot. Without a `return` here the checker cannot see that.\n"
            + "    return -1;\n"
            + "  }\n"
            + "\n"
            + "  /** The value for `k`, or None. */\n"
            + "  Option<V> get(const this, K k) {\n"
            + "    MapEntry<K, V>? e = this.slots[this.slotFor(k)];\n"
            + "    if (e is null) { return Option.None; }\n"
            + "    return Option.Some(e!.val);\n"
            + "  }\n"
            + "\n"
            + "  /** The value for `k`, or `d` — for when absence has an obvious answer. */\n"
            + "  V getOr(const this, K k, V d) {\n"
            + "    MapEntry<K, V>? e = this.slots[this.slotFor(k)];\n"
            + "    return e is null ? d : e!.val;\n"
            + "  }\n"
            + "\n"
            + "  bool has(const this, K k) {\n"
            + "    MapEntry<K, V>? e = this.slots[this.slotFor(k)];\n"
            + "    return !(e is null);\n"
            + "  }\n"
            + "\n"
            + "  /** Insert or overwrite. True if `k` was already present. */\n"
            + "  bool set(this, K k, V v) {\n"
            + "    // Grown before the insert rather than after, so the slot index this computes stays valid.\n"
            + "    if ((this.n + 1) * 4 > this.slots.len() * 3) { this.grow(); }\n"
            + "    i32 i = this.slotFor(k);\n"
            + "    MapEntry<K, V>? e = this.slots[i];\n"
            + "    if (e is null) {\n"
            + "      this.slots[i] = MapEntry(k, v);\n"
            + "      this.n++;\n"
            + "      return false;\n"
            + "    }\n"
            + "    // The key stays as it was first inserted: for a K where equality is looser than identity\n"
            + "    // — case-insensitive strings — overwriting it would silently change what the caller sees\n"
            + "    // back from an iteration.\n"
            + "    e!.val = v;\n"
            + "    return true;\n"
            + "  }\n";
    s = s + "\n"
            + "  /**\n"
            + "   * Remove `k`. True if it was there.\n"
            + "   *\n"
            + "   * Backward-shift deletion: an entry after the hole is moved into it if the hole is at\n"
            + "   * least as close to where that entry wants to be. That keeps every probe sequence\n"
            + "   * contiguous without tombstones, which is what stops a table that is filled and emptied\n"
            + "   * repeatedly from filling with dead slots.\n"
            + "   */\n"
            + "  bool remove(this, K k) {\n"
            + "    i32 mask = this.slots.len() - 1;\n"
            + "    i32 hole = this.slotFor(k);\n"
            + "    if (this.slots[hole] is null) { return false; }\n"
            + "    this.slots[hole] = null;\n"
            + "    this.n--;\n"
            + "\n"
            + "    i32 j = hole;\n"
            + "    while (true) {\n"
            + "      j = (j + 1) & mask;\n"
            + "      MapEntry<K, V>? e = this.slots[j];\n"
            + "      if (e is null) { return true; }\n"
            + "      i32 ideal = this.hash(e!.key) & mask;\n"
            + "      // Move it back only if the hole is on or after its ideal slot, cyclically — which is\n"
            + "      // exactly \"the hole is not inside the run this entry has already probed past\".\n"
            + "      if (!this.cyclicBetween(ideal, hole, j)) {\n"
            + "        this.slots[hole] = e;\n"
            + "        this.slots[j] = null;\n"
            + "        hole = j;\n"
            + "      }\n"
            + "    }\n"
            + "    return true;\n"
            + "  }\n"
            + "\n"
            + "  /** Is `x` in the cyclic interval (a, b]? Used only by `remove`. */\n"
            + "  bool cyclicBetween(const this, i32 x, i32 a, i32 b) {\n"
            + "    if (a < b) { return x > a && x <= b; }\n"
            + "    return x > a || x <= b;\n"
            + "  }\n"
            + "\n"
            + "  void clear(this) {\n"
            + "    for (i32 i = 0; i < this.slots.len(); i++) { this.slots[i] = null; }\n"
            + "    this.n = 0;\n"
            + "  }\n"
            + "\n"
            + "  /**\n"
            + "   * Every key, in slot order — which is to say an order the caller must not rely on. It\n"
            + "   * depends on the hash, the capacity, and the insertion history.\n"
            + "   */\n"
            + "  K[] keys(const this) {\n"
            + "    K[] out = K[]();\n"
            + "    i32 seen = 0;\n"
            + "    for (i32 i = 0; i < this.slots.len(); i++) {\n"
            + "      MapEntry<K, V>? e = this.slots[i];\n"
            + "      if (e is null) { continue; }\n"
            + "      // The first live entry supplies the fill value, which is why the array is not\n"
            + "      // allocated before the loop: there is nothing to fill it with until one is found.\n"
            + "      if (seen == 0) { out = K[this.n](fill: e!.key); }\n"
            + "      out[seen] = e!.key;\n"
            + "      seen++;\n"
            + "    }\n"
            + "    return out;\n"
            + "  }\n"
            + "\n"
            + "  /** Every value, in the same order as `keys()`. */\n";
    s = s + "  V[] values(const this) {\n"
            + "    V[] out = V[]();\n"
            + "    i32 seen = 0;\n"
            + "    for (i32 i = 0; i < this.slots.len(); i++) {\n"
            + "      MapEntry<K, V>? e = this.slots[i];\n"
            + "      if (e is null) { continue; }\n"
            + "      if (seen == 0) { out = V[this.n](fill: e!.val); }\n"
            + "      out[seen] = e!.val;\n"
            + "      seen++;\n"
            + "    }\n"
            + "    return out;\n"
            + "  }\n"
            + "\n"
            + "  /** Double the table and reinsert. Private in spirit; wac has no way to say so. */\n"
            + "  void grow(this) {\n"
            + "    MapEntry<K, V>?[] old = this.slots;\n"
            + "    this.slots = MapEntry<K, V>?[old.len() * 2]();\n"
            + "    this.n = 0;\n"
            + "    for (i32 i = 0; i < old.len(); i++) {\n"
            + "      MapEntry<K, V>? e = old[i];\n"
            + "      if (e is null) { continue; }\n"
            + "      // Through `set` rather than a raw store, so the probe sequence is built by the same\n"
            + "      // code that reads it. `set` cannot recurse into `grow` here: the table just doubled.\n"
            + "      this.set(e!.key, e!.val);\n"
            + "    }\n"
            + "  }\n"
            + "}\n";
    return s;
  }
  if (path == "core/vec.wac") {
    string s = "// Vec<T> — a growable array.\n"
               + "//\n"
               + "// The container this repo wrote by hand three times before generics existed: `Buf` over\n"
               + "// `u8`, `JsonArray.items` over `JsonValue?`, `JsonObject.members` over `JsonMember?`.\n"
               + "// `Buf` stays as it is — it is a byte buffer with `pushU16`/`pushU32` and a measured\n"
               + "// reason for `len` to be a field rather than a method — but nothing else needs writing\n"
               + "// again.\n"
               + "//\n"
               + "// Capacity doubles, so n pushes cost O(n) amortised.\n"
               + "//\n"
               + "// One shape note that is wac rather than taste: growing an array needs a value to fill it\n"
               + "// with, because `T[n]()` requires T to have a default and a struct or enum has none. The\n"
               + "// value being pushed is always available at exactly the moment growth is needed, so `push`\n"
               + "// fills with it. That is why there is no `reserve()` without an element and why\n"
               + "// `withCapacity` asks for one.\n"
               + "\n"
               + "import { Option } from \"core/option.wac\";\n"
               + "\n"
               + "export struct Vec<T> {\n"
               + "  T[] data;\n"
               + "  i32 n;\n"
               + "\n"
               + "  /** An empty Vec. Zero capacity, so the first push allocates. */\n"
               + "  Vec<T> create() {\n"
               + "    // The array *literal* form with no elements, not `T[0]()`: a sized array needs a default\n"
               + "    // value for T and an enum or a struct has none, whereas a literal with no elements needs\n"
               + "    // nothing. That is what makes an empty `Vec<Option<i32>>` possible at all.\n"
               + "    return Vec(T[](), 0);\n"
               + "  }\n"
               + "\n"
               + "  /**\n"
               + "   * An empty Vec with room for `capacity` elements.\n"
               + "   *\n"
               + "   * `fill` is never read: the slots above `n` are unreachable through `get`, and `push`\n"
               + "   * overwrites before it increments. It is a parameter because WasmGC arrays are\n"
               + "   * initialised on creation and wac will not invent a value for a T it knows nothing about.\n"
               + "   */\n"
               + "  Vec<T> withCapacity(i32 capacity, T fill) {\n"
               + "    if (capacity < 0) { trap; }\n"
               + "    return Vec(T[capacity](fill: fill), 0);\n"
               + "  }\n"
               + "\n"
               + "  /** A Vec over an existing array, taking ownership of it — no copy. */\n"
               + "  Vec<T> fromArray(T[] xs) {\n"
               + "    return Vec(xs, xs.len());\n"
               + "  }\n"
               + "\n"
               + "  i32 len(const this) { return this.n; }\n"
               + "\n"
               + "  bool isEmpty(const this) { return this.n == 0; }\n"
               + "\n"
               + "  /** Allocated room, which is only interesting when measuring growth. */\n"
               + "  i32 capacity(const this) { return this.data.len(); }\n"
               + "\n"
               + "  /** Element `i`. Traps outside `0 <= i < len()`, as an array index does. */\n"
               + "  T get(const this, i32 i) {\n"
               + "    if (i < 0 || i >= this.n) { trap; }\n"
               + "    return this.data[i];\n"
               + "  }\n"
               + "\n"
               + "  /** Element `i`, or None rather than a trap. */\n"
               + "  Option<T> at(const this, i32 i) {\n"
               + "    if (i < 0 || i >= this.n) { return Option.None; }\n"
               + "    return Option.Some(this.data[i]);\n";
    s = s + "  }\n"
            + "\n"
            + "  void set(this, i32 i, T v) {\n"
            + "    if (i < 0 || i >= this.n) { trap; }\n"
            + "    this.data[i] = v;\n"
            + "  }\n"
            + "\n"
            + "  void push(this, T v) {\n"
            + "    if (this.n == this.data.len()) {\n"
            + "      // Doubling zero is zero, so the floor matters: `create()` starts at zero capacity and\n"
            + "      // without it the store below would go out of bounds. Buf learned the same thing.\n"
            + "      i32 grown = this.data.len() == 0 ? 4 : this.data.len() * 2;\n"
            + "      T[] next = T[grown](fill: v);\n"
            + "      for (i32 i = 0; i < this.n; i++) { next[i] = this.data[i]; }\n"
            + "      this.data = next;\n"
            + "    }\n"
            + "    this.data[this.n] = v;\n"
            + "    this.n++;\n"
            + "  }\n"
            + "\n"
            + "  /** The last element, removed. None if empty. */\n"
            + "  Option<T> pop(this) {\n"
            + "    if (this.n == 0) { return Option.None; }\n"
            + "    this.n--;\n"
            + "    // The slot keeps its reference: there is no value to overwrite it with, so a popped\n"
            + "    // element stays reachable from the backing array until something else is pushed over\n"
            + "    // it. It matters only if T is large and the Vec is long-lived.\n"
            + "    return Option.Some(this.data[this.n]);\n"
            + "  }\n"
            + "\n"
            + "  Option<T> last(const this) {\n"
            + "    return this.n == 0 ? Option.None : Option.Some(this.data[this.n - 1]);\n"
            + "  }\n"
            + "\n"
            + "  Option<T> first(const this) {\n"
            + "    return this.n == 0 ? Option.None : Option.Some(this.data[0]);\n"
            + "  }\n"
            + "\n"
            + "  /**\n"
            + "   * Remove element `i`, shifting everything after it down. O(n).\n"
            + "   *\n"
            + "   * `swapRemove` is the O(1) alternative when order does not matter.\n"
            + "   */\n"
            + "  T remove(this, i32 i) {\n"
            + "    if (i < 0 || i >= this.n) { trap; }\n"
            + "    T out = this.data[i];\n"
            + "    for (i32 j = i; j < this.n - 1; j++) { this.data[j] = this.data[j + 1]; }\n"
            + "    this.n--;\n"
            + "    return out;\n"
            + "  }\n"
            + "\n"
            + "  /** Remove element `i` by moving the last element into its place. O(1), reorders. */\n"
            + "  T swapRemove(this, i32 i) {\n"
            + "    if (i < 0 || i >= this.n) { trap; }\n"
            + "    T out = this.data[i];\n"
            + "    this.data[i] = this.data[this.n - 1];\n"
            + "    this.n--;\n"
            + "    return out;\n"
            + "  }\n"
            + "\n"
            + "  /** Insert `v` at `i`, shifting everything from `i` up. `i == len()` appends. */\n"
            + "  void insert(this, i32 i, T v) {\n"
            + "    if (i < 0 || i > this.n) { trap; }\n"
            + "    this.push(v);                       // grows if needed, and puts v at the end\n";
    s = s + "    for (i32 j = this.n - 1; j > i; j--) { this.data[j] = this.data[j - 1]; }\n"
            + "    this.data[i] = v;\n"
            + "  }\n"
            + "\n"
            + "  /**\n"
            + "   * Forget every element.\n"
            + "   *\n"
            + "   * Keeps the capacity, and keeps the elements reachable from the backing array for the\n"
            + "   * same reason `pop` does.\n"
            + "   */\n"
            + "  void clear(this) { this.n = 0; }\n"
            + "\n"
            + "  /** Everything, as an array of exactly `len()` — a copy, so the Vec may still be used. */\n"
            + "  T[] toArray(const this) {\n"
            + "    if (this.n == 0) { return T[](); }\n"
            + "    T[] out = T[this.n](fill: this.data[0]);\n"
            + "    for (i32 i = 0; i < this.n; i++) { out[i] = this.data[i]; }\n"
            + "    return out;\n"
            + "  }\n"
            + "\n"
            + "  /** Append every element of `other`, which is left alone. */\n"
            + "  /**\n"
            + "   * Append everything in `other`.\n"
            + "   *\n"
            + "   * The length is read **once**, before anything is appended, because `other` may be `this`:\n"
            + "   * `v.extend(v)` re-read `other.n` every iteration, so the bound grew as fast as the index and it\n"
            + "   * ran until `requested new array is too large`. Self-append is a reasonable thing to write — it\n"
            + "   * doubles a buffer — and it should double it.\n"
            + "   *\n"
            + "   * `data` is re-read through `other` each time on purpose: `push` may reallocate, and when `other`\n"
            + "   * is `this` the old array is the stale one.\n"
            + "   */\n"
            + "  void extend(this, const Vec<T> other) {\n"
            + "    i32 upTo = other.n;\n"
            + "    for (i32 i = 0; i < upTo; i++) { this.push(other.data[i]); }\n"
            + "  }\n"
            + "}\n";
    return s;
  }
  return "";
}

/**
 * Does this specifier name a module inside the compiler rather than a file on disk?
 *
 * The wac twin of `isBuiltinSpecifier` in `compiler/wacCore.ts`, and the two must agree: a built-in
 * one resolver knows about and the other does not is a module the graph reads and the linker cannot
 * find. Both are generated from the same list, which is the point of generating them.
 */
/**
 * A file of the `std` tree by the specifier that names it, or "" when there is no such file.
 *
 * The capability half of the built-ins — `design/lang/0009` D4. Separate from `coreFile` because the
 * two trees admit different things and the admission tests are different: `core` needs no capability
 * and `std` is nothing but capability. `""` on a miss for the same reason as `coreFile`.
 */
export string stdFile(string path) {
  if (path == "std/platform.wac") {
    string s = "//\n"
               + "// `Pending.then` is a lambda — `design/lang/0002` — and the reference compiler does not have\n"
               + "// them. The marker is not a skip: the corpus tests that read it assert the two front ends\n"
               + "// genuinely *disagree* here, so a stale marker fails rather than dropping the file silently.\n"
               + "//\n"
               + "// **Keep new text in this file ASCII, until `issues/lang/0253a` is fixed.** One non-ASCII character\n"
               + "// in a *comment* here is enough to turn `test_rung_5_wacc_compiled_by_wacc_compiles_wacc_to_the_same_bytes`\n"
               + "// red: this file's text is embedded in `packages/wacc/src/coretext.wac`, so a comment reaches what\n"
               + "// the compiler is built from, and the reference and wacc then disagree about the bytes. `deno task\n"
               + "// seed`'s own fixpoint check does *not* catch it, so the first sign is a red suite some minutes\n"
               + "// later with no obvious connection to the sentence that was typed. An em dash is the usual way in,\n"
               + "// because the rest of this repository writes them freely.\n"
               + "//\n"
               + "// The platform world: everything an application may do, and nothing else.\n"
               + "//\n"
               + "// wac has no ambient access — no imports a program can name, no globals reaching outside\n"
               + "// — so an application can only touch what it is handed. These structs *are* the\n"
               + "// permission list. Reading one tells you exactly what a program can do, not because of a\n"
               + "// convention but because there is no other route out.\n"
               + "//\n"
               + "// Two profiles rather than one flat struct, so an application takes what it needs and a\n"
               + "// reader can see the difference between \"reads the clock\" and \"reads your filesystem\".\n"
               + "//\n"
               + "// Every capability returns a value; none fills a buffer. Arrays *copy* across the\n"
               + "// boundary, so a `fn[void(u8[])] fill` type-checks and quietly does nothing — the host's\n"
               + "// writes land on a copy. Returning is the only shape that works.\n"
               + "//\n"
               + "// Capabilities are also coarse on purpose. Behind each one may be a thread parking and\n"
               + "// unparking on a `SharedArrayBuffer`, which is nothing per file read and ruinous per byte.\n"
               + "// `readFile`, never `readByte`.\n"
               + "\n"
               + "/**\n"
               + " * A call that has been started but not yet collected.\n"
               + " *\n"
               + " * Every capability that produces a value hands back one of these instead of the value.\n"
               + " * `.wait()` blocks until the answer is there and gives it to you, which is what almost\n"
               + " * every caller wants and is why the swap from the old surface is `x(…)` to `x(…).wait()`\n"
               + " * and nothing more.\n"
               + " *\n"
               + " * What the shape buys is the calls you *do not* wait for immediately:\n"
               + " *\n"
               + " * ```wac\n"
               + " * Pending<FileResult> a = cli.readFile(\"one\");\n"
               + " * Pending<FileResult> b = cli.readFile(\"two\");   // both are already running\n"
               + " * FileResult ra = a.wait();\n"
               + " * FileResult rb = b.wait();\n"
               + " * ```\n"
               + " *\n"
               + " * and, more importantly, waiting on whichever of several answers first — which is how a\n"
               + " * program watches two sockets at once, and is the only reason `nc`, an SSH relay and a\n"
               + " * shell were not writable before.\n"
               + " *\n"
               + " * **The ticket carries its own resolver, and an `id` rather than a closure.** The reason is\n"
               + " * the host boundary, not the language: a JS closure is not a wasm function, so bindgen\n"
               + " * registers one wasm function per host function and only *sixteen per signature* can be\n"
               + " * live at once — see `spec/spec/bindgen.md`. A resolver closed over its own answer would\n"
               + " * burn a slot per call and die on the seventeenth outstanding read. So one resolver is\n"
               + " * registered per signature and the `id` selects which call it is for.\n"
               + " *\n"
               + " * **The same table caught the host out a second time**, which is worth knowing before anyone\n"
               + " * economises on either side of it: a worker that runs a *second* program used to build a second\n"
               + " * `Core` and `Cli`, three more `fn[void(i32)]` each time, and failed on the fifth run with the\n"
               + " * message this paragraph predicts. `host/entry.ts` builds them once and re-points the bridge\n"
               + " * instead (wac-mono 0076). Registration is by identity, so the fix is exactly \"pass the same\n";
    s = s + " * function again\".\n"
            + " *\n"
            + " * This comment used to say \"wac has no closures, so whatever `.wait()` calls has to be\n"
            + " * inside the ticket\". The first half is true and the second does not follow — context can\n"
            + " * travel *beside* a funcref, as an unbound method reference with the receiver as its first\n"
            + " * parameter (`[§wac-fnref-method-h9pd3wn]`). Read as written it says callbacks cannot carry\n"
            + " * context in wac, which cost agent-b an hour of threading it by hand. Corrected on their\n"
            + " * report.\n"
            + " *\n"
            + " * **And it can travel *inside* one now**: `c.inc` is a bound reference, an `fn[…]` of the\n"
            + " * receiver-less signature, as of `design/lang/0002` tier one — `[§wacc-fnref-bound]`. So a\n"
            + " * funcref-plus-context pair is no longer the only spelling, which is what `Shell.askInterrupt`\n"
            + " * exists to stop being.\n"
            + " *\n"
            + " * A ticket is good once. Waiting on a spent one is an error rather than a plausible wrong\n"
            + " * answer, because the slot underneath is reused and its generation has moved on.\n"
            + " */\n"
            + "// The one type this world does not define itself. `Read` is in `core` — the compiler's own module —\n"
            + "// because the streaming transforms in `gzip` and `stream` must name it too and have no business\n"
            + "// depending on a capability world, and because with no closures in the language a second copy of it\n"
            + "// could never be converted into this one. See wac's `design/0001`.\n"
            + "import { Read } from \"core\";\n"
            + "\n"
            + "/** A handler slot that does nothing, so a table can be filled before anything is registered. */\n"
            + "void schedIdle(i32 id) { }\n"
            + "\n"
            + "/**\n"
            + " * Milliseconds as nanoseconds, because a budget is given in the first and the clock answers in the\n"
            + " * second. Named rather than written out at each use: `Sched.run` compares a difference of nanoseconds\n"
            + " * against a number of milliseconds, and getting that by a factor of a million is a bug that looks like\n"
            + " * a scheduler that never waits.\n"
            + " */\n"
            + "i64 millisToNanos(i32 millis) { return (millis as i64) * (1000000 as i64); }\n"
            + "\n"
            + "/**\n"
            + " * Outstanding continuations, and what to run when each ticket answers.\n"
            + " *\n"
            + " * **A program never names one.** The world hands it over inside `Core`, and reaches it through\n"
            + " * `core.delay`, `core.drain` and `core.dropAll` — so this is a capability like every other thing in\n"
            + " * this file, rather than an object a program assembles for itself. `Loop`, which it replaces, was the\n"
            + " * second kind and read wrong in every example.\n"
            + " *\n"
            + " * Plain arrays rather than `Vec`, so `platform` keeps its one import and depends on no package.\n"
            + " */\n"
            + "export struct Sched {\n"
            + "  i32[] ids;\n"
            + "  fn[void(i32)][] handlers;\n"
            + "  /** Each ticket's own `drop`, so abandoning releases the host's slot rather than forgetting it. */\n"
            + "  fn[void(i32)][] drops;\n"
            + "  i32 n;\n"
            + "\n"
            + "  Sched create() {\n"
            + "    return Sched(i32[8](), fn[void(i32)][8](fill: schedIdle), fn[void(i32)][8](fill: schedIdle), 0);\n"
            + "  }\n"
            + "\n"
            + "  /** How much work is outstanding — what the host asks before deciding a clean exit. */\n"
            + "  i32 pending(const this) { return this.n; }\n"
            + "\n"
            + "  /** Run `handler` when `id` answers. Registering the same id twice runs both, in order. */\n"
            + "  void on(this, i32 id, fn[void(i32)] handler, fn[void(i32)] drop) {\n"
            + "    if (this.n == this.ids.len()) { this.grow(); }\n"
            + "    this.ids[this.n] = id;\n"
            + "    this.handlers[this.n] = handler;\n"
            + "    this.drops[this.n] = drop;\n";
    s = s + "    this.n = this.n + 1;\n"
            + "  }\n"
            + "\n"
            + "  void grow(this) {\n"
            + "    i32 want = this.ids.len() * 2;\n"
            + "    i32[] ni = i32[want]();\n"
            + "    fn[void(i32)][] nh = fn[void(i32)][want](fill: schedIdle);\n"
            + "    fn[void(i32)][] nd = fn[void(i32)][want](fill: schedIdle);\n"
            + "    for (i32 i = 0; i < this.n; i++) {\n"
            + "      ni[i] = this.ids[i];\n"
            + "      nh[i] = this.handlers[i];\n"
            + "      nd[i] = this.drops[i];\n"
            + "    }\n"
            + "    this.ids = ni;\n"
            + "    this.handlers = nh;\n"
            + "    this.drops = nd;\n"
            + "  }\n"
            + "\n"
            + "  void removeAt(this, i32 at) {\n"
            + "    for (i32 i = at; i + 1 < this.n; i++) {\n"
            + "      this.ids[i] = this.ids[i + 1];\n"
            + "      this.handlers[i] = this.handlers[i + 1];\n"
            + "      this.drops[i] = this.drops[i + 1];\n"
            + "    }\n"
            + "    this.n = this.n - 1;\n"
            + "  }\n"
            + "\n"
            + "  /**\n"
            + "   * Run registered work until nothing is outstanding or the budget runs out. Answers how many ran.\n"
            + "   *\n"
            + "   * **This is the only place other code runs while a program waits.** There is no second stack — a\n"
            + "   * park in `waitAny` runs nothing — so a continuation can only run inside a call that dispatches,\n"
            + "   * and this is that call. A program blocked anywhere else stalls its continuations until it gets\n"
            + "   * here, which is the honest cost of having no preemption and is why `drain` is written by the\n"
            + "   * program rather than happening to it.\n"
            + "   *\n"
            + "   * A handler is unregistered **before** it runs, so it may register more work — including re-arming\n"
            + "   * the same kind of read, which is what a relay does on every packet.\n"
            + "   *\n"
            + "   * **`millis` bounds the call, not each wait.** It cannot be handed straight to `waitAny`: that\n"
            + "   * bounds one wait, and this does many, so `n` handlers and a one-second budget would be `n` seconds\n"
            + "   * — and a handler that re-arms would make it unbounded, because work arriving is what keeps the\n"
            + "   * loop going. So the clock is read and each wait is asked for what is *left*. The first wait always\n"
            + "   * happens with the whole budget, which keeps `0` askable: that is `waitAny`'s \"which is ready right\n"
            + "   * now\", and a `run` that could not do it would have no way to poll.\n"
            + "   *\n"
            + "   * `-1` is \"as long as it takes\" and reads no clock at all, so `drain` — the only caller in the\n"
            + "   * repository — pays nothing for a budget it does not have. It matters that it is nothing rather than\n"
            + "   * a little: the clock is a capability call, so it parks the worker like any other.\n"
            + "   */\n"
            + "  i32 run(this, const Core core, i32 millis) {\n"
            + "    i32 ran = 0;\n"
            + "    bool bounded = millis >= 0;\n"
            + "    i64 deadline = 0 as i64;\n"
            + "    if (bounded) { deadline = core.monotonicNanos().wait() + millisToNanos(millis); }\n"
            + "    i32 waits = 0;\n"
            + "    while (this.n > 0) {\n"
            + "      i32 budget = millis;\n"
            + "      if (bounded && waits > 0) {\n"
            + "        i64 left = deadline - core.monotonicNanos().wait();\n"
            + "        if (left <= 0 as i64) { return ran; }\n"
            + "        // Rounded down, so a fraction of a millisecond left asks for `0` — a poll, which is the\n"
            + "        // truth: there is no time to wait with.\n"
            + "        // `as!` rather than `as~`: this is bounded above by `millis`, which is an `i32` already, so\n";
    s = s + "        // the check is a claim that cannot fail rather than a value being squeezed.\n"
            + "        budget = (left / (1000000 as i64)) as! i32;\n"
            + "      }\n"
            + "      // **In registration order**, which `removeAt` preserves by shifting rather than swapping — so\n"
            + "      // with several continuations due at once they run in the order they were registered. That is\n"
            + "      // `waitAny`'s tie-break plus this list's order; neither alone is enough to say it.\n"
            + "      i32[] live = i32[this.n]();\n"
            + "      for (i32 i = 0; i < this.n; i++) { live[i] = this.ids[i]; }\n"
            + "      i32 which = core.waitAny(live, budget);\n"
            + "      waits = waits + 1;\n"
            + "      if (which < 0) { return ran; }\n"
            + "      i32 id = this.ids[which];\n"
            + "      fn[void(i32)] handler = this.handlers[which];\n"
            + "      this.removeAt(which);\n"
            + "      handler(id);\n"
            + "      ran = ran + 1;\n"
