          + " * are for the targeted updates that would otherwise mean re-rendering to change a word. There\n"
          + " * is deliberately no `querySelector`-shaped surface: every property poke would be a round trip\n"
          + " * across a thread boundary, to arrive at an object this side cannot hold.\n"
          + " */\n"
          + "export struct Page {\n"
          + "  /** Replace the application root's markup. The application builds it; nothing escapes it. */\n"
          + "  fn<Pending<bool>(string)> render;\n"
          + "  /**\n"
          + "   * Set an element's *text*, by id.\n"
