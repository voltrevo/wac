/**
 * The default type arguments `core` and `std` declare, as `Name|count|d0;d1;…` lines — read here, once,
 * so `lowerTypeDefaults` need not lex the whole of both on every compile (spec ch19).
 */
export string builtinTypeDefaults() {
  return "Result|2|;union" + "\n";
}

/**
 * Does this specifier name a module inside the compiler rather than a file on disk? Only the two
 * names do: a path below either is refused, since a package is named whole (`§wac-no-subpath-wqatc72`).
 */
export bool isBuiltinSpec(string spec) { return spec == "core" || spec == "std"; }
