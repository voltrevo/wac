          + "   * says so; getting it wrong the other way is what this replaces — a silent zero.\n"
          + "   */\n"
          + "  bool waitable;\n"
          + "\n"
          + "  /**\n"
          + "   * A ticket the host will answer. Every capability's is made through here, which is why this sets\n"
          + "   * `waitable`: being waited on is how the host is asked.\n"
          + "   */\n"
          + "  Pending<T> of(i32 id, fn<T(i32)> resolve, fn<bool(i32)> settled, fn<void(i32)> drop) {\n"
          + "    return Pending<T>(id, resolve, settled, drop, null, true);\n"
          + "  }\n"
