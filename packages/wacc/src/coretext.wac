            + "    i32[] ids = i32[had]();\n"
            + "    fn[void(i32)][] drops = fn[void(i32)][had](fill: schedIdle);\n"
            + "    for (i32 i = 0; i < had; i++) {\n"
            + "      ids[i] = this.ids[i];\n"
            + "      drops[i] = this.drops[i];\n"
            + "    }\n"
            + "    this.n = 0;\n"
            + "    for (i32 i = 0; i < had; i++) { drops[i](ids[i]); }\n"
            + "    return had;\n"
            + "  }\n"
            + "}\n"
            + "\n"
            + "export struct Pending<T> {\n"
            + "  i32 id;\n"
            + "  fn[T(i32)] resolve;\n"
            + "  fn[bool(i32)] settled;\n"
            + "  fn[void(i32)] drop;\n"
            + "  /**\n"
            + "   * Where a continuation goes, or null for a ticket nobody linked.\n"
            + "   *\n"
            + "   * The host builds tickets through `of` and knows nothing about any scheduler; a capability that\n"
            + "   * hands out *linked* tickets does so itself. So `then` works on `core.delay(…)` and does not on a\n"
            + "   * raw `recv`, and which is which is a property of the capability rather than of this type.\n"
            + "   */\n"
            + "  Sched? sched;\n"
            + "\n"
            + "  Pending<T> of(i32 id, fn[T(i32)] resolve, fn[bool(i32)] settled, fn[void(i32)] drop) {\n"
            + "    return Pending<T>(id, resolve, settled, drop, null);\n"
            + "  }\n"
            + "\n"
            + "  /**\n";
    s = s + "   * The same ticket, told **which world** runs its continuations.\n"
            + "   *\n"
            + "   * Takes a `Core` rather than the scheduler inside it, so a program never names a scheduler — the\n"
            + "   * same rule `delay`, `drain` and `dropAll` keep. It is also the honest statement of the\n"
            + "   * relationship: the world that answers a ticket is the world that dispatches it.\n"
            + "   *\n"
            + "   * `delay` does this for you. Every *other* capability answers with an unlinked ticket, so\n"
            + "   * `cli.readFile(p).linkedTo(core).then(f)` is how the rest of the world gets continuations —\n"
            + "   * `waitAny` already takes ticket ids across differing `Pending<T>`, which is the property that\n"
            + "   * makes one scheduler enough for all of them.\n"
            + "   */\n"
            + "  Pending<T> linkedTo(const this, const Core core) {\n"
            + "    return Pending<T>(this.id, this.resolve, this.settled, this.drop, core.sched);\n"
            + "  }\n"
            + "\n"
            + "  /**\n"
            + "   * Run `f` with the answer once it is here, and return **now**.\n"
            + "   *\n"
            + "   * The scheduler holding the continuation never learns `T`: what is registered is a `fn[void(i32)]`,\n"
            + "   * and the wrapper closing over `resolve` is what carries the type across. That wrapper is a lambda\n"
            + "   * written inside a generic, which is why this could not exist before `issues/lang/0142`.\n"
            + "   *\n"
            + "   * **Traps on an unlinked ticket** rather than dropping the continuation on the floor — a `then`\n"
            + "   * that silently never runs is the worst failure this could have, and a ticket is unlinked only\n"
            + "   * when the capability that made it does not schedule.\n"
            + "   *\n"
            + "   * The ticket's own `drop` is registered beside the handler, so `Sched.dropAll` can release the\n"
            + "   * host's slot rather than merely forgetting the callback.\n"
            + "   */\n"
            + "  void then(this, fn[void(T)] f) {\n"
            + "    // **A bare trap, and it should not be.** This is the one mistake the API invites — `delay` hands\n"
            + "    // back a linked ticket and every other capability hands back an unlinked one — so `then` on a\n"
            + "    // `readFile` is where a reader arrives, and what they get is *Uncaught RuntimeError: unreachable*.\n"
            + "    //\n"
            + "    // `trap \"…\"` is the language's answer and does not work here: wacc's emitter matches the statement\n"
            + "    // without binding its message and emits a bare `unreachable`, and no host reads the reference's\n"
            + "    // version of it either — that message reaches a JS caller through bindgen's wrappers and nowhere\n"
            + "    // else. `issues/lang/0147` has both halves. Written as a bare trap rather than as a message that\n"
            + "    // is silently discarded, which would read as working.\n"
            + "    if (this.sched is null) { trap; }\n"
            + "    this.sched!.on(this.id, (i32 id) => { f(this.resolve(id)); }, this.drop);\n"
            + "  }\n"
            + "\n"
            + "  /**\n"
            + "   * Block until the answer is here, and take it. The ticket is spent afterwards.\n"
            + "   *\n"
            + "   * `const this` because it writes nothing — the spending happens on the host side of the\n"
            + "   * resolver. It has to be const to be callable at all from a `const this` method, which\n"
            + "   * is where half the capability calls in `packages/sh` and `packages/ssh` live.\n"
            + "   */\n"
            + "  T wait(const this) { return this.resolve(this.id); }\n"
            + "\n"
            + "  /** Whether `wait` would return immediately. Never blocks. */\n"
            + "  bool isDone(const this) { return this.settled(this.id); }\n"
            + "\n"
            + "  /**\n"
            + "   * Stop caring. **Detach, not abort**: the host may already be inside the work and\n"
            + "   * generally cannot be interrupted. What this guarantees is that the answer is discarded.\n"
            + "   */\n"
            + "  void cancel(const this) { this.drop(this.id); }\n"
            + "}\n"
            + "\n"
            + "/**\n"
            + " * A file that may not have been there. `bytes` is empty when `ok` is false.\n";
    s = s + " *\n"
            + " * The static exists so the *host* can build one. A struct has no constructor JavaScript\n"
            + " * can reach, and without this every application had to re-export a maker of its own —\n"
            + " * ceremony that had nothing to do with counting words.\n"
            + " */\n"
            + "export struct FileResult {\n"
            + "  bool ok;\n"
            + "  u8[] bytes;\n"
