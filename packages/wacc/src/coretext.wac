          + " */\n"
          + "Node @\"html.element\"(string tag, Node[] kids, string?[] values) {\n"
          + "  string[] names = [\"class\", \"id\", \"style\", \"title\", \"lang\", \"role\", \"href\", \"src\", \"alt\", \"type\", \"name\", \"value\", \"for\", \"placeholder\", \"rel\", \"target\", \"width\", \"height\", \"action\", \"method\", \"content\", \"charset\", \"disabled\", \"checked\"];\n"
          + "  i32 n = 0;\n"
          + "  for (i32 i = 0; i < values.len(); i++) { if (!(values[i] is null)) { n++; } }\n"
          + "  Attr[] attrs = Attr[].filled(n, Attr(\"\", \"\"));\n"
          + "  i32 at = 0;\n"
          + "  for (i32 i = 0; i < values.len(); i++) {\n"
          + "    if (values[i] is null) { continue; }\n"
