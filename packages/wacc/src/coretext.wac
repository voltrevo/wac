          + "\n"
          + "/**\n";
  s = s + " * A file that may not have been there. `bytes` is empty when `ok` is false.\n"
          + " *\n"
          + " * The static exists so the *host* can build one. A struct has no constructor JavaScript\n"
          + " * can reach, and without this every application had to re-export a maker of its own —\n"
          + " * ceremony that had nothing to do with counting words.\n"
          + " */\n"
          + "export struct FileResult {\n"
          + "  bool ok;\n"
          + "  u8[] bytes;\n"
          + "  /** The host's own sentence, which is the only text worth showing a person. */\n"
          + "  string error;\n"
          + "  /**\n"
          + "   * Which `FAULT_*` this was — `FAULT_NONE` when `ok`.\n"
          + "   *\n"
          + "   * The message cannot be branched on: \"No such file or directory (os error 2)\" from Deno, \"ENOENT: no\n"
          + "   * such file or directory\" from Node and a `NotFoundError` from the Origin Private File System are\n"
