            + "    fn[Pending<string>(string)] getValue,\n"
            + "    fn[Pending<bool>(string, string)] on,\n"
            + "    fn[Pending<Event>()] nextEvent,\n"
            + "    fn[Pending<bool>(string)] title,\n"
            + "    fn[Pending<bool>(string, i32, i32, u8[])] drawPixels,\n"
            + "    fn[Pending<bool>(string, i32, i32, i32, i32, u8[])] drawPixelsIn,\n"
            + "    fn[Pending<Picked>()] nextFile,\n"
            + "    fn[Pending<bool>(string, u8[])] offerDownload\n"
            + "  ) {\n"
            + "    return Page(\n"
            + "      render, setText, setValue, setStyle, getValue, on, nextEvent, title,\n"
            + "      drawPixels, drawPixelsIn, nextFile, offerDownload\n"
            + "    );\n"
            + "  }\n"
            + "}\n"
            + "\n"
            + "/**\n"
            + " * What every host can do, synchronously or made to look so.\n"
            + " *\n"
            + " * Deno, Node and a browser all provide these, which is what makes an application that\n"
            + " * uses only `Core` portable without qualification.\n"
            + " */\n"
            + "export struct Core {\n"
            + "  /** Wall clock, milliseconds since the epoch. Moves backwards; do not measure with it. */\n"
            + "  fn[Pending<i64>()] nowMillis;\n"
            + "  /** Monotonic nanoseconds from an arbitrary origin. For measuring, never for dating. */\n"
            + "  fn[Pending<i64>()] monotonicNanos;\n"
            + "  /**\n"
            + "   * A ticket that settles once the given milliseconds have passed, resolving to the\n"
            + "   * monotonic nanoseconds at which it did — so `.wait()` is a sleep that tells you how far\n"
            + "   * it overshot.\n"
            + "   *\n"
            + "   * **For a deadline, use `Cli.waitAny`'s `millis` instead.** This was originally built to\n"
            + "   * be that: a timer ticket in the `waitAny` list, whichever lands first wins. It works, and\n"
            + "   * it is the wrong shape — the ticket costs a ring slot, cannot be written inline (there\n"
            + "   * would be nothing left to cancel), and has to be disposed of on every path or the ring\n"
            + "   * fills up and the next call stops the program. `Atomics.wait` already takes a timeout, so\n"
            + "   * the deadline needs no ticket, no slot and no cleanup at all.\n"
            + "   *\n"
            + "   * What is left is sleeping, which this is good at and which `waitAny` cannot express: a\n"
            + "   * retry backoff, a poll interval, a deliberate pause. It stays in `Core` because a clock\n"
            + "   * is not authority and all three hosts have one.\n"
            + "   */\n"
            + "  fn[Pending<i64>(i32)] sleepMillis;\n"
            + "  /**\n"
            + "   * Cryptographically secure random bytes, from one byte to a megabyte.\n"
            + "   *\n"
            + "   * The ceiling is the capability's rather than any host's, and asking for more is a fault instead\n"
            + "   * of a short answer: a caller that wanted two megabytes of key material and silently received one\n"
            + "   * is the worse failure. The floor of the *implementation* is a host detail that leaked once —\n"
            + "   * Web Crypto refuses more than 65,536 bytes in a single call, so two of the three hosts threw on\n"
            + "   * everything above that while the third chunked and did not (0122). `example/entropy.wac` walks\n"
            + "   * the range on both hosts, one byte past that cap included.\n"
            + "   */\n"
            + "  fn[Pending<u8[]>(i32)] randomBytes;\n"
            + "  /** A line of output. */\n"
            + "  fn[void(string)] log;\n"
            + "  /** A line of output on the error channel. */\n"
            + "  fn[void(string)] warn;\n"
            + "\n";
    s = s + "  /**\n"
            + "   * Block until one of these calls has an answer, and say which — for at most `millis`.\n"
            + "   *\n"
            + "   * Takes the `id` of each ticket and returns its index in the list. Every id is accepted\n"
            + "   * whatever its `Pending<T>`: a relay waits on a `recv` and an `accept` together, and\n"
            + "   * their types differ.\n"
            + "   *\n"
            + "   * **This is the capability the ring exists for.** Overlapping two reads is a\n"
            + "   * convenience; waiting on whichever of two *sockets* speaks first is the difference\n"
            + "   * between a program being writable and not. `nc`, an SSH relay and a shell all need it,\n"
            + "   * and `isDone` alone does not give it to them — polling `isDone` in a loop is a spin,\n"
            + "   * which burns a core to avoid parking.\n"
            + "   *\n"
            + "   * `millis` is the deadline, and **-1 means wait as long as it takes**:\n"
            + "   *\n"
            + "   *     i32 w = core.waitAny(i32[](r.id, a.id), -1);   // until one of them answers\n"
            + "   *     i32 w = core.waitAny(i32[](r.id), 5000);       // ...or five seconds, whichever first\n"
            + "   *     i32 w = core.waitAny(i32[](click.id, file.id), 0);   // which is ready right now\n"
            + "   *\n"
            + "   * **When several are ready, the answer is the first of them in the list you passed** — not the one\n"
            + "   * that finished first. Both hosts scan the caller's order and return the first settled ticket:\n"
            + "   * `packages/platform/host/call.ts` is `for (const t of tickets) if (isDone(b, t)) return t;`, and\n"
            + "   * `native/src/tickets.rs` says why — *\"first in the caller's list rather than first to finish, so the\n"
            + "   * answer does not depend on how the threads were scheduled\"*, which is `design/system/0001` D12.\n"
            + "   *\n"
            + "   * **It is not a statement about when work finishes.** A ticket the host has not marked ready yet is\n"
            + "   * not ready, so a 1ms timer that has been descheduled loses to a 2ms one that has not — and no\n"
            + "   * tie-break can change that, because there is no tie. `issues/system/0202` was filed on that\n"
            + "   * observation and asked which policy to adopt; the policy was already here, and what it saw was the\n"
            + "   * other thing. `packages/platform/test/wac/scheduled_test.wac` asserts the tie-break by asking twice\n"
            + "   * with the list reversed, which is what separates position from completion.\n"
            + "   *\n"
            + "   * **Returns -1 when the time ran out**, and also for an empty list, which is the same\n"
            + "   * statement: nothing settled. That is how a silent peer is survivable — see\n"
            + "   * `example/patience.wac` — and it is why there is no `recvWithin`. A deadline belongs to\n"
            + "   * the wait rather than to each capability, so this one parameter bounds `connect`,\n"
            + "   * `accept`, `readFile` or a child's `exitCode` without any of them knowing about it.\n"
            + "   *\n"
            + "   * The deadline **costs nothing**: no opcode, no slot, no ticket to dispose of, because\n"
            + "   * `Atomics.wait` takes a timeout and the wait is already in this worker's own memory. An\n"
            + "   * earlier design passed a timer ticket in the list instead; it worked, and every caller\n"
            + "   * had to remember to cancel the loser or lose a slot for good. `core.sleepMillis` remains\n"
            + "   * for *sleeping*, which is a different thing from a deadline.\n"
            + "   *\n"
            + "   * Blocking, and it reaches no further than this worker's own memory: the wait is on the\n"
            + "   * completion counter the host bumps, so it takes no slot and cannot deadlock the ring\n"
            + "   * however many tickets are outstanding.\n"
            + "   *\n"
            + "   * **In `Core` rather than `Cli`**, which it was not at first and should have been. It grants\n"
            + "   * nothing — it cannot start work, only notice that some has finished — and it is the same in\n"
            + "   * every host, which is what `Core` means. Keeping it beside the filesystem left an\n"
            + "   * interactive page unable to wait on a click *or* a dropped file, and that is exactly the\n"
            + "   * question this exists to answer.\n"
            + "   */\n"
            + "  fn[i32(i32[], i32)] waitAny;\n"
            + "\n"
            + "  /**\n"
            + "   * Whether the user has asked to interrupt what is running — `^C`, and nothing else.\n"
            + "   *\n"
            + "   * **The seam design/system/0001 step 5 was missing, and it is on `Core` rather than on the shell.**\n"
            + "   * A signal here is cooperative: `kill` writes on a row in the process table and the receiver\n"
            + "   * collects it at its next check point. That reaches a shell *between* commands and cannot reach a\n"
            + "   * running one, because a running applet is inside `dispatch` and the shell's check points are not\n"
            + "   * executing. An applet is handed `Core`, `Cli`, `Fs` and `Args` and never a `Page` or a `Conn`, so\n";
    s = s + "   * whatever it polls must be one of those four.\n"
            + "   *\n"
            + "   * **Only a host that owns the keyboard can answer yes.** In a page the keydown listener and the\n"
            + "   * code that services the bridge are both on the main thread, so while the worker is parked waiting\n"
            + "   * for this very answer the page is free to have seen the keystroke. Under Deno, Node and wasmtime\n"
            + "   * the terminal belongs to whatever started the program — over ssh, to `sshd` on the far side of an\n"
            + "   * encrypted socket — so those answer *no*. That is the true answer where nothing can ask, not a stub.\n"
            + "   *\n"
            + "   * Reading clears it, so two callers do not both act on one `^C`.\n"
            + "   *\n"
            + "   * `i32` because that is what crosses; `interrupted()` is the read.\n"
            + "   */\n"
            + "  fn[i32()] askInterrupt;\n"
            + "\n"
            + "  /**\n"
            + "   * The world\\'s scheduler — where a continuation registered with `then` waits its turn.\n"
            + "   *\n"
            + "   * **A program never names this.** It reaches it through `delay`, `drain` and `dropAll` below, which\n"
            + "   * read as what they are: things this world can do. The scheduler is a value the host builds at\n"
            + "   * start-up and hands over with the rest of the capabilities, which is what keeps \"no ambient\n"
            + "   * anything\" true — a program given no world cannot schedule.\n"
            + "   *\n"
            + "   * A field rather than a funcref, unlike everything else here, because the methods below are wac\n"
            + "   * code over it rather than host calls. The host has only to construct it.\n"
            + "   */\n"
            + "  Sched sched;\n"
            + "\n"
            + "  /**\n"
            + "   * A ticket that settles after `millis`, already able to carry a continuation.\n"
            + "   *\n"
            + "   * `sleepMillis` is the ticket; the only thing added is where its continuations go. So\n"
            + "   * `core.delay(500).wait()` is the sleep it always was, and `core.delay(500).then(f)` is the same\n"
            + "   * ticket with a continuation on it.\n"
            + "   */\n"
            + "  Pending<i64> delay(const this, i32 millis) {\n"
            + "    return this.sleepMillis(millis).linkedTo(this);\n"
            + "  }\n"
            + "\n"
            + "  /**\n"
            + "   * Run continuations until none are outstanding. Answers how many ran.\n"
            + "   *\n"
            + "   * **The program says when.** There is no second stack here — a park in `waitAny` runs nothing at\n"
            + "   * all — so a continuation can only run inside a call that dispatches, and this is that call. A\n"
            + "   * `main` that schedules and returns without draining leaves work outstanding, which the host\n"
            + "   * treats as an error; `dropAll` is how a program says it meant to.\n"
            + "   */\n"
            + "  i32 drain(this) { return this.sched.run(this, -1); }\n"
            + "\n"
            + "  /**\n"
            + "   * `drain`, for at most `millis` — and answers how many ran, so what is left is `outstanding()`.\n"
            + "   *\n"
            + "   * The budget bounds the whole call rather than each wait, which is the only reading that is any use:\n"
            + "   * a bound per wait is `n` bounds for `n` continuations, and none at all once a handler re-arms.\n"
            + "   *\n"
            + "   * **What is left over is still outstanding**, so a program that leaves after a partial drain gets the\n"
            + "   * same error as one that never drained. Running out of time is not a decision; `dropAll` is.\n"
            + "   */\n"
            + "  i32 drainFor(this, i32 millis) { return this.sched.run(this, millis); }\n"
            + "\n"
            + "  /**\n"
            + "   * Abandon every outstanding continuation, releasing each ticket. Answers how many there were.\n"
            + "   *\n"
            + "   * Not `const this`, like `drain` and unlike everything else here: a scheduler reached through a\n"
            + "   * `const` receiver is const too, and both of these write to it. That is the aliasing rule doing its\n";
    s = s + "   * job — a `Core` held const cannot quietly run somebody\\'s continuations.\n"
            + "   */\n"
            + "  i32 dropAll(this) { return this.sched.dropAll(); }\n"
            + "\n"
            + "  /** How much work is outstanding — the question the host asks when `main` returns. */\n"
            + "  i32 outstanding(const this) { return this.sched.pending(); }\n"
            + "\n"
            + "  /**\n"
            + "   * Whether the user has asked to interrupt. Call it once per *block* of work, never per byte:\n"
            + "   * every opcode parks the worker, so this is a round trip.\n"
            + "   *\n"
            + "   *     while (cli.write(block)) { if (core.interrupted()) { return 130; } }\n"
            + "   *\n"
            + "   * 130 is `128 + SIGINT`, which is what a shell reports for a program a `^C` ended.\n"
            + "   */\n"
            + "  bool interrupted(const this) { return this.askInterrupt() != 0; }\n"
            + "\n"
            + "  Core of(\n"
            + "    fn[Pending<i64>()] nowMillis,\n"
            + "    fn[Pending<i64>()] monotonicNanos,\n"
            + "    fn[Pending<i64>(i32)] sleepMillis,\n"
            + "    fn[Pending<u8[]>(i32)] randomBytes,\n"
            + "    fn[void(string)] log,\n"
            + "    fn[void(string)] warn,\n"
            + "    fn[i32(i32[], i32)] waitAny,\n"
            + "    fn[i32()] askInterrupt,\n"
            + "    Sched sched\n"
            + "  ) {\n"
            + "    return Core(nowMillis, monotonicNanos, sleepMillis, randomBytes, log, warn, waitAny,\n"
            + "                askInterrupt, sched);\n"
            + "  }\n"
            + "}\n"
            + "\n"
            + "/** What a path is, if it is anything. Everything is zero or false when `exists` is false. */\n"
            + "/**\n"
            + " * Why a filesystem change did not happen, in a form a program can act on.\n"
            + " *\n"
            + " * **Integers rather than an enum**, which is the opposite of `Read` above and for a reason that\n"
            + " * survives asking: a fault is *compared* (`rm -f` wants to know whether it was merely absent), and a\n"
            + " * wac enum is a reference type with no `==` — payload-less variants allocate, so even `is` would be\n"
            + " * false between two `NotFound`s. `ERR_*` in `packages/http` and `GRANT_*` below are the same shape\n"
            + " * for the same reason. If enums ever compare by value, this becomes one.\n"
            + " *\n"
            + " * A category *and* the host's message, because neither replaces the other: the category is what a\n"
            + " * program branches on, and the message is what a person reads. Matching the message's words to\n"
            + " * recover the category — which is what an applet had to do before this existed — is a guess about\n"
            + " * three operating systems.\n"
            + " */\n"
            + "export i32 FAULT_NONE() { return 0; }\n"
            + "export i32 FAULT_NOT_FOUND() { return 1; }\n"
            + "export i32 FAULT_DENIED() { return 2; }\n"
            + "export i32 FAULT_EXISTS() { return 3; }\n"
            + "export i32 FAULT_NOT_EMPTY() { return 4; }\n"
            + "/** The host said something this world has no category for; the message is all there is. */\n"
            + "export i32 FAULT_OTHER() { return 5; }\n"
            + "/**\n"
            + " * The host cannot express this name, so the operation was never attempted.\n"
            + " *\n"
            + " * Not the same as absent, and the difference is visible from a shell: `ls` in a directory holding a file\n"
            + " * whose name is not valid UTF-8 lists `bad-\\ufffd-name`, and every attempt to open *that* answers \"no such\n"
            + " * file or directory\" — a file you can see and cannot touch, with the blame on whoever typed it.\n"
            + " *\n"
            + " * Measured on Deno, which is where this world mostly runs: `Deno.readDir` replaces the invalid bytes with\n"
            + " * U+FFFD, and `Deno.stat` of the name it just handed you fails `NotFound`. There is no byte-oriented path\n";
    s = s + " * in that API, so the file is genuinely unnameable from here — this is not a conversion this repository can fix by\n"
            + " * changing a signature, which is what wac-mono 0065 assumed at first. Node's `fs` takes a `Buffer` and\n"
            + " * could do it; the Deno host cannot, and says so.\n"
            + " */\n"
            + "export i32 FAULT_NOT_REPRESENTABLE() { return 6; }\n"
            + "\n"
            + "/**\n"
            + " * The program was not given this capability.\n"
            + " *\n"
            + " * Not an operating-system failure, which is why it is not `FAULT_DENIED`: that one is the file saying no,\n"
            + " * and this one is the program never having been handed the file. A caller wants to say different things\n"
            + " * about them, and until this existed it could not tell them apart — a withheld filesystem and a\n"
            + " * `chmod 000` were the same category with different sentences.\n"
            + " *\n"
            + " * **`faultWords` has a phrase for it, and used not to.** The argument for having none was that the host's\n"
            + " * own sentence — \"filesystem read not granted to this application\" — says what no errno phrase can, and a\n"
            + " * caller falling back to the message would print exactly the right thing. That holds only where there *is*\n"
            + " * a message: `Change` and `FileResult` carry one, and **`Stat` does not**. So `stat: cannot tell — ` was\n"
            + " * what a program printed for the answer this category exists to give, with nothing after the dash.\n"
            + " */\n"
            + "export i32 FAULT_NOT_GRANTED() { return 7; }\n"
            + "\n"
            + "/**\n"
            + " * A directory where a file was wanted.\n"
            + " *\n"
            + " * The eighth, and the argument against it was that this taxonomy is not errno granularity. What\n"
            + " * overruled it: a program *branches* on this. `cat` on a directory and `cat` on a missing file are\n"
            + " * different mistakes and every real tool says so, and wac-mono 0067 recorded the question when\n"
            + " * `Fs.readFile` had to answer `FAULT_OTHER` for it. Without a category the host's own sentence was the\n"
            + " * only information, so a read of a directory reached the output as \"Is a directory (os error 21)\" — an\n"
            + " * errno, no filename, and a different sentence per runtime.\n"
            + " */\n"
            + "export i32 FAULT_IS_DIR() { return 8; }\n"
            + "\n"
            + "/**\n"
            + " * **We have not written this.** Not the file's fault, not the build's, and not the host's.\n"
            + " *\n"
            + " * The ninth, and it exists because the closest available word was reaching users as a lie. `Fs.chmod`\n"
            + " * on a host mount is not implemented and said so in its *message* — while answering `FAULT_DENIED`,\n"
            + " * because that was the nearest category. `packages/sh` renders a fault as `faultWords` gives it, so\n"
            + " * \"we have not written this\" arrived as `chmod: cannot access 'o': Permission denied`, which blames\n"
            + " * the file for something the file did not do. GNU succeeds there: `chmod` wants ownership, not read.\n"
            + " *\n"
            + " * `faultWords` deliberately has **no phrase** for it, which is not an oversight but the mechanism:\n"
            + " * every caller already spells the empty case as `words == \"\" ? f.error : words`, so the *message* is\n"
            + " * what reaches the user — and the message is the only thing that can say **what** is unimplemented.\n"
            + " * A category with fixed words would say less than the sentence it replaced.\n"
            + " *\n"
            + " * So why a category at all, if it prints the message either way? Because a caller can **branch** on\n"
            + " * it, which is the same argument `FAULT_IS_DIR` won on. `FAULT_OTHER` means \"the host said something\n"
            + " * no category covers\" — a real failure, out there. This one means the request never reached a host.\n"
            + " * A program deciding whether to try another route needs to tell those apart, and until now could not.\n"
            + " *\n"
            + " * wac-mono 0117.\n"
            + " */\n"
            + "export i32 FAULT_UNSUPPORTED() { return 9; }\n"
            + "\n"
            + "/**\n"
            + " * A file where a directory was wanted — `ENOTDIR`, the other half of `FAULT_IS_DIR`.\n"
            + " *\n"
            + " * The tenth, and it is the one the taxonomy could least afford to be without, because **every operation\n"
            + " * can hit it**: any path with a `/` in it walks components, and a component that turns out to be a file\n"
            + " * fails this way. `FAULT_IS_DIR` is one operation on one path; this is `f/g` for every `f` that is not a\n"
            + " * directory, and it had no category at all — so `cat f/g` said `Not a directory (os error 20)` and\n";
    s = s + " * `mkdir f/g` said `Not a directory (os error 20): mkdir '/abs/path/f/g'`, an errno and the *host's*\n"
            + " * absolute path, in a world whose first claim is that a session cannot see the host it runs on.\n"
            + " *\n"
            + " * It is a genuinely different answer from absence, which is what it was arriving as. GNU distinguishes\n"
            + " * them everywhere — `cat: f/g: Not a directory` against `cat: f/g: No such file or directory` — and a\n"
            + " * person needs to: one means fix the name, the other means `f` is not what you thought it was.\n"
            + " *\n"
            + " * **`stat` is the exception, and deliberately.** `test -e f/g` is *false* in bash rather than an error,\n"
            + " * so a stat that hit this still answers \"nothing there\". It now carries the category alongside — see\n"
            + " * `statFault` in `host/faults.ts` — so `ls` and `cd` can say which absence it was without `test`\n"
            + " * changing its mind.\n"
            + " */\n"
            + "export i32 FAULT_NOT_A_DIR() { return 10; }\n"
            + "\n"
            + "/**\n"
            + " * The filesystem will not take a write at all — `EROFS`.\n"
            + " *\n"
            + " * The eleventh, and it was found the same way `FAULT_NOT_A_DIR` was, one layer down: `packages/fs`'s\n"
            + " * synthesised backing answers this for `/dev` and `/proc` and had to say it in its *message*, as\n"
            + " * `FAULT_DENIED` with the words \"read-only file system\". That worked only for as long as callers\n"
            + " * printed the message — the moment `reasonOf` started preferring the category's phrase, which is the\n"
            + " * whole point of having categories, a write to `/dev/zero` began saying `Permission denied` and the\n"
            + " * one useful fact was gone.\n"
            + " *\n"
            + " * It is a different answer from `FAULT_DENIED` in the way that matters to whoever reads it: nothing\n"
            + " * about this file or this user refused, and no `chmod` will help. `strerror(EROFS)` is \"Read-only file\n"
            + " * system\" and that is what `faultWords` says, because it is what bash prints when a redirection lands\n"
            + " * on a read-only mount.\n"
            + " */\n"
            + "export i32 FAULT_READ_ONLY() { return 11; }\n"
            + "\n"
            + "/**\n"
            + " * The name is longer than the host will take — `ENAMETOOLONG`.\n"
            + " *\n"
            + " * Found by hand, not by a differential: no corpus script has a three-hundred-character filename, so\n"
            + " * every two-host comparison agreed, and what they agreed on was `File name too long (os error 36)` —\n"
            + " * the operating system's sentence with its errno still attached, where GNU prints the same words and\n"
            + " * nothing else. The two hosts matching each other is exactly why this survived; they were both wrong\n"
            + " * in the same way, which is the failure a two-host differential cannot see and a real tool can.\n"
            + " */\n"
            + "export i32 FAULT_NAME_TOO_LONG() { return 12; }\n"
            + "\n"
            + "/**\n"
            + " * A symbolic link that leads back to itself — `ELOOP`.\n"
            + " *\n"
            + " * The other half of the same find, and the same shape: `cat loop` said \"Too many levels of symbolic\n"
            + " * links (os error 40)\" on both hosts where GNU says it without the errno. A filesystem that can make\n"
            + " * links can make this one, and `packages/fs` grew `linkStat` this week, so it is reachable now in a\n"
            + " * way it was not when the fault table was written.\n"
            + " */\n"
            + "export i32 FAULT_LOOP() { return 13; }\n"
            + "\n"
            + "/**\n"
            + " * The filesystem will not take any more — `ENOSPC`.\n"
            + " *\n"
            + " * The one of the three that is **not** the same on both hosts, and the reason is the runtime rather\n"
            + " * than the code: Deno refuses `/dev/full` at `open` for want of `--allow-all`, so a JavaScript host\n"
            + " * answers `FAULT_NOT_GRANTED` and never reaches the write; the wasmtime host opens it and the write\n"
            + " * fails, which is the only place in this repository where `outputError` carries a real reason. Both\n"
            + " * answers are true about their own runtime, and the category is what lets a program tell them apart\n"
            + " * from each other and from a full disk.\n"
            + " */\n"
            + "export i32 FAULT_NO_SPACE() { return 14; }\n"
            + "\n";
    s = s + "/**\n"
            + " * The three a *socket* needs, and the reason they are here rather than folded into `FAULT_OTHER`.\n"
            + " *\n"
            + " * Every code above this line is about a filesystem, and so is `fault_of` in both native hosts: it\n"
            + " * maps `NotFound`, `PermissionDenied`, `IsADirectory` and seven more, and everything else falls to\n"
            + " * `FAULT_OTHER`. The network capability inherited that vocabulary, so `Socket.fault` could say \"you\n"
            + " * were not granted this\" and otherwise only \"something went wrong\" -- a refused connection, a host\n"
            + " * with no route to it and one that never answered were one category.\n"
            + " *\n"
            + " * **They are three answers a person acts on differently**, which is the argument\n"
            + " * `packages/tor/src/socks5.wac` already makes for the SOCKS reply codes it maps: \"Connection refused\"\n"
            + " * and \"not allowed by ruleset\" send someone to look in different places, and collapsing both to a\n"
            + " * general failure sends them nowhere. `issues/system/0255c` is the consumer.\n"
            + " */\n"
            + "export i32 FAULT_REFUSED() { return 15; }\n"
            + "/** Nothing at that address, or no route to it -- `EHOSTUNREACH` and `ENETUNREACH`. */\n"
            + "export i32 FAULT_UNREACHABLE() { return 16; }\n"
            + "/** It never answered. Distinct from refused: a refusal is an answer. */\n"
            + "export i32 FAULT_TIMED_OUT() { return 17; }\n"
            + "\n"
            + "/**\n"
            + " * A fault in the words the real tools use, or `\"\"` where the category has none to give.\n"
            + " *\n"
            + " * One table, because there were four: `sh` had one for a `Change` and another for a `FileResult`, `box`\n"
            + " * had a third, and a fourth was about to be written for `Stat`. Four copies of a phrase list drift, and\n"
            + " * the drift is invisible — each one is only read when something has already gone wrong. The `sh` and `box`\n"
            + " * copies had already diverged: one of them had no phrase for `FAULT_NOT_REPRESENTABLE` and said the host's\n"
            + " * English instead, which is the exact failure the category was added to prevent.\n"
            + " *\n"
            + " * The words are GNU's, deliberately, because that is what our differential tests compare against and what\n"
            + " * a person reading a shell's output expects: `No such file or directory`, not `os error 2`. The\n"
            + " * capability layer is the right home for them — a fault number is meaningless without them, and every\n"
            + " * struct that carries one is declared here.\n"
            + " *\n"
            + " * `\"\"` for `FAULT_OTHER` and `FAULT_NONE`: the first means the host had something to say that no category\n"
            + " * covers, so the caller should print *its* message rather than a category's, and the second is not a\n"
            + " * failure at all. Callers spell that as `words == \"\" ? f.error : words`, which is the shape all four\n"
            + " * copies already had.\n"
            + " */\n"
            + "export string faultWords(i32 fault) {\n"
            + "  if (fault == FAULT_NOT_FOUND()) { return \"No such file or directory\"; }\n"
            + "  if (fault == FAULT_DENIED()) { return \"Permission denied\"; }\n"
            + "  if (fault == FAULT_EXISTS()) { return \"File exists\"; }\n"
            + "  if (fault == FAULT_NOT_EMPTY()) { return \"Directory not empty\"; }\n"
            + "  // Not GNU's words, because GNU has none for this: a filesystem it can name every file in has no reason\n"
            + "  // to. Saying the host cannot express the name is the true sentence, and it beats \"No such file or\n"
            + "  // directory\" for a file the caller has just seen in `ls`. wac-mono 0065.\n"
            + "  if (fault == FAULT_NOT_REPRESENTABLE()) { return \"cannot be named on this host\"; }\n"
            + "  // Also not GNU's, for the same reason: a program the operating system runs was granted everything the\n"
            + "  // operating system has, so GNU never had to say this. It is the sentence a caller most needs, because it\n"
            + "  // is the one failure that is nothing to do with the file.\n"
            + "  if (fault == FAULT_NOT_GRANTED()) { return \"Not granted to this application\"; }\n"
            + "  // Capitalised, like the rest here and like `strerror`, which is where GNU's wording comes from.\n"
            + "  if (fault == FAULT_IS_DIR()) { return \"Is a directory\"; }\n"
            + "  // `strerror(ENOTDIR)`, and GNU prints exactly this and nothing else — no errno, no path beyond the one\n"
            + "  // the user typed. Compared against `/bin/cat`, `/bin/mkdir` and the rest in `box/test/notdir.test.ts`.\n"
            + "  if (fault == FAULT_NOT_A_DIR()) { return \"Not a directory\"; }\n"
            + "  // `strerror(EROFS)`, which is what bash prints for a redirection onto a read-only mount.\n"
            + "  if (fault == FAULT_READ_ONLY()) { return \"Read-only file system\"; }\n"
            + "  // The next three are `strerror` too, and each is what GNU prints with no errno after it: compared\n"
            + "  // against `cat`, `wc` and a redirection in `native_hostfs`, on both hosts.\n"
            + "  if (fault == FAULT_NAME_TOO_LONG()) { return \"File name too long\"; }\n"
            + "  if (fault == FAULT_LOOP()) { return \"Too many levels of symbolic links\"; }\n"
            + "  if (fault == FAULT_NO_SPACE()) { return \"No space left on device\"; }\n";
    s = s + "  // `strerror`'s words for ECONNREFUSED, EHOSTUNREACH and ETIMEDOUT, so a program that prints a\n"
            + "  // socket failure says what `nc` and `curl` say.\n"
            + "  if (fault == FAULT_REFUSED()) { return \"Connection refused\"; }\n"
            + "  if (fault == FAULT_UNREACHABLE()) { return \"No route to host\"; }\n"
            + "  if (fault == FAULT_TIMED_OUT()) { return \"Connection timed out\"; }\n"
            + "  // `FAULT_UNSUPPORTED` falls through to `\"\"` on purpose — see its own comment. The message says what\n"
            + "  // is unimplemented, and no fixed phrase could.\n"
            + "  return \"\";\n"
            + "}\n"
            + "\n"
            + "/**\n"
            + " * Why a failed `Change` failed, in the words the tool this world imitates uses.\n"
            + " *\n"
            + " * A fault the world has a *category* for gets the category's phrase; anything else keeps the host's own\n"
            + " * message, which is then the only thing that knows. That distinction is what the fault numbers are for:\n"
            + " * the host's words differ per platform and per runtime — `File exists (os error 17): mkdir '/tmp/x'`\n"
            + " * under Deno, `EEXIST: file already exists, mkdir '/tmp/x'` under Node, `already exists` in a browser —\n"
            + " * while what happened does not.\n"
            + " *\n"
            + " * **Here rather than in `packages/sh`, which is where it was.** `sh`'s builtins had it and `box`'s\n"
            + " * applets did not, and they are the same programs: `mkdir` is a builtin of one and an applet of the\n"
            + " * other, so the same failure printed GNU's four words through the shell and an errno with the host's\n"
            + " * absolute path through the applet. Two applets had gone further and inlined a *one-row* copy of the\n"
            + " * table — `c.fault == FAULT_EXISTS() ? \"File exists\" : c.message` — which is the drift `faultWords`\n"
            + " * exists to stop, one row at a time. It belongs beside the phrases, where anything holding a fault can\n"
            + " * reach it.\n"
            + " */\n"
            + "export string reasonOf(Change c) {\n"
            + "  string words = faultWords(c.fault);\n"
            + "  return words == \"\" ? c.message : words;\n"
            + "}\n"
            + "\n"
            + "/** The same, for a read that failed: `FileResult` carries its host sentence as `error`. */\n"
            + "export string readReason(FileResult f) {\n"
            + "  string words = faultWords(f.fault);\n"
            + "  return words == \"\" ? f.error : words;\n"
            + "}\n"
            + "\n"
            + "/**\n"
            + " * The same, for a program that did not do what was asked — and the **killed** case is why it exists.\n"
            + " *\n"
            + " * Every caller writes the same phrase by hand: `e.error + string.fromBytes(e.stderr)`. It is right for\n"
            + " * the two ordinary outcomes and renders the third as nothing at all. `error` is empty whenever the\n"
            + " * program started, and a child killed by a signal writes no `stderr` before it dies — so an\n"
            + " * out-of-memory kill prints as a sentence that stops after the dash. A reason with no cause in it is\n"
            + " * what `issues/system/0142` is a page of.\n"
            + " *\n"
            + " * Takes no status, because `std` has no integer formatter and the caller has the number anyway.\n"
            + " */\n"
            + "export string execReason(Exec r) {\n"
            + "  if (!r.ran()) { return r.error; }\n"
            + "  if (r.signalled()) {\n"
            + "    return \"killed by a signal, having written nothing — on a shared machine the usual cause is memory\";\n"
            + "  }\n"
            + "  string said = string.fromBytes(r.stderr);\n"
            + "  return said.len() > 0 ? said : \"exited non-zero and said nothing\";\n"
            + "}\n"
            + "\n"
            + "/** What a filesystem change answered. */\n"
            + "/**\n"
            + " * What a host program did: `Cli.exec`'s answer.\n"
            + " *\n"
            + " * **`status` is an exit code, not a fault.** A program that ran and exited non-zero is a different\n"
            + " * fact from a program that could not be started, and every differential oracle in this repository\n";
    s = s + " * asserts on the first constantly — the interesting case for `openssl`, `python3` or `git` is\n"
            + " * usually the input the reference implementation *rejects*. So a refusal to start is reported in\n"
            + " * `error`, which is empty whenever the program ran at all, whatever it then did.\n"
            + " *\n"
            + " * `stdout` and `stderr` are bytes and stay separate. Bytes because a compressor's output is not\n"
            + " * text and a lossy decode would corrupt exactly the differential it was fetched for; separate\n"
            + " * because merging them makes a warning indistinguishable from an answer.\n"
            + " *\n"
            + " * `issues/system/0165`.\n"
            + " */\n"
            + "export struct Exec {\n"
            + "  /**\n"
            + "   * The exit code, when the program ran. Meaningless when `error` is non-empty.\n"
            + "   *\n"
            + "   * **`-1` means the child died by a signal rather than exiting**, and it is a real value rather than\n"
            + "   * an absence: a signalled process has no exit code at all, so all four hosts write `code ?? -1`.\n"
            + "   * It is safe as a sentinel because a POSIX status is eight bits — no child that *exited* can\n"
            + "   * produce it — which is the one thing that saves it from being a sentinel drawn from the value's own\n"
            + "   * range. Read it through `signalled()` rather than by comparing, so the convention has a name.\n"
            + "   *\n"
            + "   * `ran()` is still true for such a child: it started, and a signal is how it ended.\n"
            + "   */\n"
            + "  i32 status;\n"
            + "  u8[] stdout;\n"
            + "  u8[] stderr;\n"
            + "  /**\n"
            + "   * Why it could not be started, and **empty when it was** — including when it then failed.\n"
            + "   *\n"
            + "   * `FAULT_NOT_GRANTED`'s message appears here too: a build without `--allow-run` is told it was\n"
            + "   * not granted, rather than being handed a plausible-looking empty answer.\n"
            + "   */\n"
            + "  string error;\n"
            + "\n"
            + "  Exec of(i32 status, u8[] stdout, u8[] stderr, string error) {\n"
            + "    return Exec(status, stdout, stderr, error);\n"
            + "  }\n"
            + "\n"
            + "  /** Whether the program started. Says nothing about whether it succeeded — read `status` for that. */\n"
            + "  bool ran(const this) { return this.error.len() == 0; }\n"
            + "\n"
            + "  /** Whether it ran **and** exited zero, which is what most callers mean by \"it worked\". */\n"
            + "  bool ok(const this) { return this.ran() && this.status == 0; }\n"
            + "\n"
            + "  /**\n"
            + "   * Whether it started and was **killed** rather than exiting — see `status`.\n"
            + "   *\n"
            + "   * Worth a name because the alternative is every caller writing `status == 0 - 1`, and because the\n"
            + "   * two facts a caller usually wants to separate are \"it failed\" and \"it was killed\": an out-of-memory\n"
            + "   * kill and a program that exited non-zero are the same `!ok()` and very different problems. The\n"
            + "   * signal *number* is not carried — the hosts do not report it — so this says that it happened and\n"
            + "   * not which one.\n"
            + "   */\n"
            + "  bool signalled(const this) { return this.ran() && this.status == 0 - 1; }\n"
            + "}\n"
            + "\n"
            + "export struct Change {\n"
            + "  /** `FAULT_NONE` when it worked. */\n"
            + "  i32 fault;\n"
            + "  /** The host's own words, and empty when it worked. */\n"
            + "  string message;\n"
            + "\n"
            + "  Change of(i32 fault, string message) { return Change(fault, message); }\n"
            + "\n"
            + "  bool ok(const this) { return this.fault == FAULT_NONE(); }\n";
    s = s + "\n"
            + "  /**\n"
            + "   * Whether the thing was simply not there — the case `rm -f` is allowed to ignore.\n"
            + "   *\n"
            + "   * Before this, `remove` answered a message and `rm -f` had to ask `stat` first, which is both an\n"
            + "   * extra call and a race: a file can vanish between the two. Asking the failure itself cannot race\n"
            + "   * with anything.\n"
            + "   *\n"
            + "   * **`FAULT_NOT_A_DIR` counts, and this is what GNU does.** `rm -f f/g` where `f` is a file exits 0\n"
            + "   * and says nothing, exactly as `rm -f nosuch` does, because both mean \"there is nothing at that\n"
            + "   * path\". Ours failed with a diagnostic — first because `ENOTDIR` had no category at all and landed in\n"
            + "   * `FAULT_OTHER`, then, once it had one, because this method still named only the one. The `-f` in\n"
            + "   * `rm -rf build/x/y` is written for precisely this: a path whose middle turned out not to be there.\n"
            + "   */\n"
            + "  bool absent(const this) {\n"
            + "    return this.fault == FAULT_NOT_FOUND() || this.fault == FAULT_NOT_A_DIR();\n"
            + "  }\n"
            + "}\n"
            + "\n"
            + "export struct Stat {\n"
            + "  bool exists;\n"
            + "  bool isFile;\n"
            + "  bool isDir;\n"
            + "  i64 size;\n"
            + "  /** Milliseconds since the epoch, or 0 where the host does not say. */\n"
            + "  i64 modifiedMillis;\n"
            + "  /**\n"
            + "   * Whether the path itself is a symbolic link.\n"
            + "   *\n"
            + "   * **Always false from `stat`**, which follows links and therefore describes what one leads to.\n"
            + "   * `linkStat` is the one that answers this. Both exist because both questions are real: `find`\n"
            + "   * wants to know whether to descend into what a name leads to, and `tar` wants to know whether the\n"
            + "   * name is a link before it stores anything.\n"
            + "   */\n"
            + "  bool isSymlink;\n"
            + "\n"
            + "  /**\n"
            + "   * Whether the owner-execute bit is set.\n"
            + "   *\n"
            + "   * **One bit, not a mode**, for the reason `Cli.setExecutable` gives. It is what distinguishes git's\n"
            + "   * `100644` from its `100755`, and building a tree from a working tree cannot tell them apart without it\n"
            + "   * — every blob was recorded as `100644`, which made a commit of an executable record a mode change\n"
            + "   * nobody asked for. issues/system/0132.\n"
            + "   *\n"
            + "   * **False where the host has no mode bits**, which is a true answer rather than a stand-in: a browser's\n"
            + "   * OPFS does not have them, so nothing there is executable and saying so is correct.\n"
            + "   */\n"
            + "  bool isExecutable;\n"
            + "\n"
            + "  /**\n"
            + "   * Why this is not an answer, or `FAULT_NONE` when it is.\n"
            + "   *\n"
            + "   * **Absence is an answer, not a fault.** A path that is simply not there gives `exists = false` with\n"
            + "   * `FAULT_NONE`, because \"there is nothing here\" is what `stat` was asked. A fault means the question\n"
            + "   * could not be *reached*: `FAULT_NOT_GRANTED` when the world has no read capability, `FAULT_DENIED`\n"
            + "   * when it has one and the operating system refused anyway, and\n"
            + "   * `FAULT_NOT_REPRESENTABLE` for a name this host cannot express — a file `ls` has just listed, whose\n"
            + "   * name came back from `readDir` with an invalid byte replaced, so every path built from it fails.\n"
            + "   *\n"
            + "   * Before this field, both of those arrived as `exists = false`: `test -e` said no about a file that is\n"
            + "   * there, and a program with no read grant could not tell \"absent\" from \"not allowed to look\". wac-mono\n"
            + "   * 0065 left this open on the grounds that giving `Stat` a fault changes every caller. It does, and the\n"
            + "   * callers are better for it — a caller that only wants existence still reads `exists`, and one that\n"
            + "   * reports to a person now has something true to say.\n";
    s = s + "   *\n"
            + "   * So: **check `fault` before trusting `exists`.**\n"
            + "   *\n"
            + "   * ## The exception, which is `FAULT_NOT_A_DIR`\n"
            + "   *\n"
            + "   * There is one fault here that does *not* mean the question went unreached: `f/g` where `f` is a\n"
            + "   * file. The host is certain, `exists = false` is exactly right, and the extra thing to say is which\n"
            + "   * kind of nothing it is. Every real tool distinguishes them — `cat: f/g: Not a directory` against\n"
            + "   * `cat: f/g: No such file or directory` — and bash's `test -e f/g` is nonetheless plain *false*\n"
            + "   * rather than an error, so a caller that only wanted existence must not start failing.\n"
            + "   *\n"
            + "   * So this one rides along with the facts intact, and `answered` is what draws the line. `statFault`\n"
            + "   * in `host/faults.ts` decides which faults reach a `Stat` at all, and `faults_agree.test.ts` holds\n"
            + "   * the two ends together.\n"
            + "   */\n"
            + "  i32 fault;\n"
            + "\n"
            + "  Stat of(bool exists, bool isFile, bool isDir, i64 size, i64 modifiedMillis, bool isSymlink,\n"
            + "          bool isExecutable, i32 fault) {\n"
            + "    return Stat(exists, isFile, isDir, size, modifiedMillis, isSymlink, isExecutable, fault);\n"
            + "  }\n"
            + "\n"
            + "  /**\n"
            + "   * Whether `exists`, `isFile` and `isDir` can be trusted.\n"
            + "   *\n"
            + "   * Not `fault == FAULT_NONE()`, which is what it was: `FAULT_NOT_A_DIR` is a fault whose facts are\n"
            + "   * *sound* — see the field above — and every caller here treats a false answer as \"the question could\n"
            + "   * not be reached\", which for that one would be untrue. `test -e f/g` would have begun exiting 2 with\n"
            + "   * a diagnostic where bash says false.\n"
            + "   *\n"
            + "   * The list is short and belongs in one place rather than spelled out at each of the five call sites,\n"
            + "   * which is the whole reason this method exists.\n"
            + "   */\n"
            + "  bool answered(this) {\n"
            + "    return this.fault == FAULT_NONE() || this.fault == FAULT_NOT_A_DIR();\n"
            + "  }\n"
            + "\n"
            + "  /**\n"
            + "   * This `Stat`'s fault in a real tool's words, or `otherwise` where the category has none.\n"
            + "   *\n"
            + "   * The fallback is the caller's because it depends on what the caller already knows, and there were\n"
            + "   * **four** of these written out separately — the shell's `ls` said `\"Permission denied\"` for a\n"
            + "   * directory it could not list, the `ls` applet said the same thing a different way, `cd` and the\n"
            + "   * `stat` applet hard-coded `\"No such file or directory\"` and `\"not found\"`, and `packages/sh` had a\n"
            + "   * `statReason` saying `\"cannot be examined\"`. Four spellings of `words == \"\" ? something : words`,\n"
            + "   * which is how the `ls` builtin came to say GNU's sentence for an absence and the `ls` applet an\n"
            + "   * invented one, for the same fault, in the same binary.\n"
            + "   *\n"
            + "   * Three of those fallbacks were right for their call site; the fourth (`\"not found\"`) was a phrase no\n"
            + "   * real tool prints. Passing it in keeps that judgement where it belongs and the lookup in one place.\n"
            + "   */\n"
            + "  string words(this, string otherwise) {\n"
            + "    string found = faultWords(this.fault);\n"
            + "    return found == \"\" ? otherwise : found;\n"
            + "  }\n"
            + "}\n"
            + "\n"
            + "/**\n"
            + " * The command line, the standard streams and the filesystem. Absent in a browser, which\n"
            + " * is the honest reason this is not part of `Core`.\n"
            + " *\n"
            + " * `readStdin` and `write` need no grant, for the same reason `arg` does not: what the\n"
            + " * user pipes in and what the program prints are the user's own doing, not a reach into\n"
            + " * anything they did not offer. The filesystem is different and is gated.\n";
    s = s + " */\n"
            + "/**\n"
            + " * A socket, or why there isn't one.\n"
            + " *\n"
            + " * A handle rather than a current-socket, unlike `openInput` and `openOutput`. Those are\n"
            + " * one-at-a-time because the transforms take `fn[u8[]()]`, which has no parameter to\n"
            + " * carry a handle *in* — not because wac cannot pass context beside a funcref, which it\n"
            + " * can;\n"
            + " * an `i32` in a struct has no such problem, and a server needs a listener and a\n"
            + " * connection open at the same time, so a current-socket could not express it.\n"
            + " */\n"
            + "export struct Socket {\n"
            + "  i32 handle;      // negative when `error` is set\n"
            + "  string error;\n"
            + "  /**\n"
            + "   * Who is at the other end, for a socket that came from `accept`. Empty otherwise.\n"
            + "   *\n"
            + "   * The address only — `127.0.0.1`, or an IPv6 address without brackets — because the port a client\n"
            + "   * dialled *from* is of no use to anyone and would invite string parsing at every call site.\n"
            + "   *\n"
            + "   * A server could not previously log who connected, rate-limit by source, or refuse a non-loopback\n"
            + "   * peer. That last one is the check that makes a bind to every interface survivable, and it was not\n"
            + "   * expressible: the address exists on the host side and was dropped at the boundary. wac-mono 0025.\n"
            + "   */\n"
            + "  string peer;\n"
            + "\n"
            + "  /**\n"
            + "   * This socket's own port: what `listen` bound, what `connect` dialled *from*, what an accepted\n"
            + "   * socket is served on. Zero when the host does not say.\n"
            + "   *\n"
            + "   * It exists because port 0 was useless without it. Asking the kernel for a free port is how a server\n"
            + "   * avoids a clash it cannot predict — and `listen` answered with a handle alone, so a program that\n"
            + "   * asked for 0 got one and could never learn which port it had, which is the same as not being able\n"
            + "   * to ask. `platform/test/listen.test.ts` had a comment saying exactly that, above three hardcoded\n"
            + "   * port numbers, and one of them collided with another agent's suite run and blocked a push.\n"
            + "   */\n"
            + "  i32 port;\n"
            + "\n"
            + "  /**\n"
            + "   * Declared here rather than left to bindgen, because the host builds these.\n"
            + "   *\n"
            + "   * bindgen emits a constructor for a struct that has none, and its name carries the `$` that marks\n"
            + "   * a generated identifier — so relying on it means the host reaches for a name no wac source\n"
            + "   * mentions. Two lines here and the capability world states its own construction API.\n"
            + "   */\n"
            + "  Socket of(i32 handle, string error, string peer, i32 port, i32 fault) {\n"
            + "    return Socket(handle, error, peer, port, fault);\n"
            + "  }\n"
            + "\n"
            + "  /** Whether the peer is this machine — the check a server on every interface needs. */\n"
            + "  /**\n"
            + "   * Why it failed, when `handle` is negative: one of the `FAULT_*` codes, and `FAULT_NONE` on success.\n"
            + "   *\n"
            + "   * **`FileResult` and `Change` have carried a category for a long time and this did not**, so the one\n"
            + "   * refusal a program most needs to tell from an ordinary failure -- \"you were not granted the\n"
            + "   * network\" against \"nothing is listening there\" -- was the one with only English to go on. The\n"
            + "   * hosts do not even agree on the English: `wacland` says \"network access not granted to this\n"
            + "   * application\" and the V8 host says \"Not granted to this application\", so\n"
            + "   * `packages/platform/example/probe.wac` matched `\"ot granted\"` with the first letter dropped to\n"
            + "   * catch both. That is what this field removes. `issues/system/0238c`.\n"
            + "   *\n"
            + "   * The same mistake made with `FileResult.error` reported `failed` under both native hosts while the\n"
            + "   * confinement was working, which is the worst direction for a program that reports what it may do.\n"
            + "   */\n";
    s = s + "  i32 fault;\n"
            + "\n"
            + "  bool fromLoopback(const this) {\n"
            + "    return this.peer == \"127.0.0.1\" || this.peer == \"::1\" || this.peer == \"localhost\";\n"
            + "  }\n"
            + "}\n"
            + "\n"
            + "/**\n"
            + " * One datagram, **and who sent it**, in a single answer.\n"
            + " *\n"
            + " * The pairing is the whole reason this is a struct rather than two calls. A datagram socket serves\n"
            + " * many peers at once, so bytes and sender only mean something together: with `receiveFrom` answering\n"
            + " * the payload and a separate `senderOf` answering the address, two datagrams arriving between the two\n"
            + " * calls would hand a program one datagram's bytes with another's sender. That is not a race it could\n"
            + " * detect — both halves are well-formed, and for QUIC the connection id inside the packet would be the\n"
            + " * only clue that the address is wrong. Answering both at once makes the mistake unspellable.\n"
            + " *\n"
            + " * `peer` is the address alone, as `Socket.peer` is, and `port` is the peer's — *unlike* `Socket.port`,\n"
            + " * which is this end's. A reply goes back to exactly this pair, which is why the sender's port is kept\n"
            + " * here when a stream socket had no use for it.\n"
            + " */\n"
            + "export struct Datagram {\n"
            + "  u8[] bytes;\n"
            + "  /** The sender's address: `127.0.0.1`, or an IPv6 address without brackets. */\n"
            + "  string peer;\n"
            + "  /** The sender's port. `sendTo(handle, peer, port, …)` is the reply. */\n"
            + "  i32 port;\n"
            + "  /** Why there is no datagram. Empty on success, and `bytes` is then the payload — which may be empty. */\n"
            + "  string error;\n"
            + "\n"
            + "  /** Declared rather than generated, for the reason `Socket.of` gives: the host builds these. */\n"
            + "  Datagram of(u8[] bytes, string peer, i32 port, string error) {\n"
            + "    return Datagram(bytes, peer, port, error);\n"
            + "  }\n"
            + "}\n"
            + "\n"
            + "/**\n"
            + " * A spawned worker, or why there isn't one.\n"
            + " *\n"
            + " * The handle goes to `recv`, `send`, `waitAny` and `closeSocket` exactly as a socket's does.\n"
            + " * That is the point of the design: a child is not a new kind of thing, so a shell running\n"
            + " * `a | b` reads one handle and writes another, and watching a child beside a socket is\n"
            + " * `waitAny` over two handles that happen to have different origins.\n"
            + " */\n"
            + "/**\n"
            + " * What a spawned child may do, for `Cli.spawn`.\n"
            + " *\n"
            + " * Bit flags, combined with `|`. The host intersects them with its own grants, so these are a\n"
            + " * request rather than an instruction and a parent can never widen what it was given.\n"
            + " *\n"
            + " * There is deliberately no flag for standard input and output: a child always has those, they\n"
            + " * are how a parent talks to it at all, and they reach nothing the parent did not hand over.\n"
            + " */\n"
            + "export const i32 GRANT_NONE = 0;\n"
            + "/** `readFile`, `stat`, `readDir`, `openInput` on a path. */\n"
            + "export const i32 GRANT_READ = 1;\n"
            + "/** `writeFile`, `mkdir`, `remove`, `rename`, `openOutput` to a path. */\n"
            + "export const i32 GRANT_WRITE = 2;\n"
            + "/** `connect`, `listen`, `accept` — the child's own sockets, not the parent's. */\n"
            + "export const i32 GRANT_NET = 4;\n"
            + "/** `env`, which reports every variable unset without it. */\n"
            + "export const i32 GRANT_ENV = 8;\n"
            + "\n"
            + "/**\n";
    s = s + " * Running a host program — `Cli.exec`.\n"
            + " *\n"
            + " * **Bit 16, and added late on purpose.** `Cli.spawn`'s note says there is no bit for this and that a\n"
            + " * loaded module which could `exec` would hold the one authority the narrowing exists for. That was\n"
            + " * right while the *host* decided grants: nothing could pass it on, so `load_module` hard-coded\n"
            + " * `run: false`. With the built-in program holding every capability and deciding what it hands on, the\n"
            + " * bit is how it hands this one on — a test runner granting its own oracle the right to spawn, and\n"
            + " * nothing else getting it by default. `issues/system/0264c`.\n"
            + " */\n"
            + "export const i32 GRANT_RUN = 16;\n"
            + "/**\n"
            + " * Every grant there is: \"narrow nothing\", which is not the same as \"everything\".\n"
            + " *\n"
            + " * A `spawn` or a `load` asking for this gets the intersection with what the caller holds, so a program\n"
            + " * built with no grants hands over none of them whatever it asks. It is the honest spelling for a\n"
            + " * caller that means \"as much as I have\": `GRANT_NONE` is the other honest one, and a hand-written\n"
            + " * `GRANT_READ | GRANT_WRITE | GRANT_NET | GRANT_ENV` is a fourth thing to keep in step every time a\n"
            + " * bit is added.\n"
            + " */\n"
            + "export i32 GRANT_ALL() { return GRANT_READ | GRANT_WRITE | GRANT_NET | GRANT_ENV | GRANT_RUN; }\n"
            + "\n"
            + "/**\n"
            + " * How many host calls one worker may have outstanding at once.\n"
            + " *\n"
            + " * Every unsettled `Pending<T>` holds one call slot until it is collected or cancelled, so this is the\n"
            + " * ceiling on how many handles a program can watch: watching N sockets means N outstanding `recv`s, plus\n"
            + " * one for an `accept` and one for whatever it writes with. Exceeding it does not degrade into slowness —\n"
            + " * the extra submission parks, and the calls holding the slots cannot complete, so it deadlocks.\n"
            + " *\n"
            + " * Stated here rather than transcribed into each program, because it has already changed twice (four,\n"
            + " * sixteen, 128) and every copy of the old number becomes a limit nobody can explain.\n"
            + " * `test/wac/slots_test.wac` fails if this and `host/layout.ts` disagree.\n"
            + " */\n"
            + "export const i32 CALL_SLOTS = 128;\n"
            + "\n"
            + "/**\n"
            + " * Standard input's handle, so that `waitAny` can watch it beside a socket and a child.\n"
            + " *\n"
            + " * Reserved rather than allocated: a host's handle counter starts past the reserved ones, so this\n"
            + " * can never name anything else. `test/wac/handles_test.wac` is what holds the hosts to that.\n"
            + " */\n"
            + "export const i32 STDIN = 0;\n"
            + "\n"
            + "/**\n"
            + " * The handle a **child** reads and writes to reach its parent's filesystem — the other end of\n"
            + " * `Child.fsHandle`, seen from inside the child.\n"
            + " *\n"
            + " * Reserved in the same way and for the same reason as `STDIN`, and it has to be a fixed number\n"
            + " * because there is nothing to tell a child what its own number would be: a program that starts and\n"
            + " * wants its parent's filesystem asks on this handle or does not ask at all. `Fs.overParent` is the\n"
            + " * only caller, and `recv(PARENT_FS)` on a program that was not spawned answers nothing — which is\n"
            + " * how a program can tell the difference without a capability to ask with.\n"
            + " */\n"
            + "export const i32 PARENT_FS = 1;\n"
            + "\n"
            + "export struct Child {\n"
            + "  /**\n"
            + "   * The child's handle, or a negative number and an `error`.\n"
            + "   *\n"
            + "   * Two negatives, and the difference is the caller's whole decision:\n"
            + "   *\n"
            + "   *   -1  this program exists and would not start — `packages/sh` reports 126, as a shell does for\n"
            + "   *       a file that is not executable\n"
            + "   *   -2  **this world has no `spawn` at all**, so nothing was attempted and nothing is wrong with\n";
    s = s + "   *       the program. A caller with another route should take it\n"
            + "   *\n"
            + "   * Without the second, a world that cannot spawn made every spawnable name *fail* rather than fall\n"
            + "   * through: in the browser shell, `WACPATH=/b` with a file named `wc` in it reported\n"
            + "   * \"no handler for capability 27\" and exit 126, hiding `packages/box`'s own `wc`, which was sitting\n"
            + "   * right there and works. A missing capability is not a broken program.\n"
            + "   */\n"
            + "  i32 handle;\n"
            + "  /**\n"
            + "   * The child's *error* stream, as a handle of its own — `recv(errHandle)` reads it.\n"
            + "   *\n"
            + "   * A program has two output streams and a handle carries one, so a child needs two. Without this\n"
            + "   * they were merged: a shell running `cat nosuch | wc -c` counted the error message, because the\n"
            + "   * child's complaint arrived on the same handle as its output, and `cat nosuch` alone printed to\n"
            + "   * *standard output*. Both are wrong in the same way, and a second handle rather than a second\n"
            + "   * capability keeps everything that already works on handles working — `waitAny` most of all, which\n"
            + "   * is what lets a parent watch a child's two streams and a socket together.\n"
            + "   *\n"
            + "   * Negative when `handle` is: there is nothing to read from a child that never started.\n"
            + "   */\n"
            + "  i32 errHandle;\n"
            + "  /**\n"
            + "   * The child's **filesystem channel**, as a handle of its own — the third stream, and the one that\n"
            + "   * makes a child able to see anything but what its parent sends it.\n"
            + "   *\n"
            + "   * A spawned child is a separate instance with its own memory, which is the confinement `spawnSelf`\n"
            + "   * exists to provide. It is also why a child could not see its parent's *filesystem*: a session\n"
            + "   * booted on an image holds that image in wac memory, and there is no route from one instance's\n"
            + "   * memory to another's. So a spawned stage got `Fs.onHost` — the machine — and a sealed session\n"
            + "   * could not spawn at all without unsealing itself. That is wac-mono 0116.\n"
            + "   *\n"
            + "   * The route is a channel rather than a copy. The child asks and the parent answers, on this handle:\n"
            + "   * `recv(fsHandle)` in the parent reads a request, `send(fsHandle, …)` answers it, and\n"
            + "   * `packages/fs`'s `Backing.Remote` is the other end. Which means the parent's filesystem stays the\n"
            + "   * only one there is — the child's writes are the parent's writes, its permissions are checked\n"
            + "   * against the parent's `user`, and the mounts it sees are whatever the parent has mounted, because\n"
            + "   * nothing has been duplicated.\n"
            + "   *\n"
            + "   * **It is a handle so that `waitAny` can watch it beside the child's output**, which is what a\n"
            + "   * parent serving a child while relaying its bytes actually needs. A parent that does not serve it\n"
            + "   * leaves the child parked on a request; a parent that does not *want* to serve it should not pass\n"
            + "   * `PARENT_FS` to the child in the first place.\n"
            + "   *\n"
            + "   * Negative when `handle` is, and on a host with no spawn at all.\n"
            + "   */\n"
            + "  i32 fsHandle;\n"
            + "  string error;\n"
            + "\n"
            + "  /** As `Socket.of`: the host builds these, so the constructor is declared rather than generated. */\n"
            + "  Child of(i32 handle, i32 errHandle, i32 fsHandle, string error) {\n"
            + "    return Child(handle, errHandle, fsHandle, error);\n"
            + "  }\n"
            + "\n"
            + "  /** Whether this world can spawn at all. False says nothing about the program. */\n"
            + "  bool unavailable(const this) { return this.handle == -2; }\n"
            + "}\n"
            + "\n"
            + "/**\n"
            + " * A module this program has instantiated and may call the exports of.\n"
            + " *\n"
            + " * **The other half of `spawn`, and deliberately not a replacement for it.** `spawn` hands over a\n"
            + " * *program*: an argument vector, two streams, an exit code, on its own thread, and `closeSocket` stops\n"
            + " * it wherever it is. This hands over a module's *functions*, in this program's own world, on this\n"
            + " * program's own thread — so an export that loops forever hangs the caller, and nothing here can stop\n";
    s = s + " * it. Anything unbounded or untrusted is `spawn`'s.\n"
            + " *\n"
            + " * Its world is the caller's, undiminished: see `load` for why there is no grant argument.\n"
            + " *\n"
            + " * It exists because four commands needed it and no wac program could express them: `wac test` calls a\n"
            + " * module's `test*` exports and has to survive one of them trapping, and `covdump`, `tracestat` and\n"
            + " * `ctcompare` read the counters through `__cov_init`, `__cov_len` and `__cov_get`. Every host already\n"
            + " * did this internally — `host/driver.ts`'s `asAppModule`, `native/v8`'s `run_tests` — and none of them\n"
            + " * offered it. `issues/system/0240c`.\n"
            + " *\n"
            + " * **Which exports there are is not a capability.** A module carries its own manifest, and the manifest\n"
            + " * lists every non-`$bind$` export with its parameters and return type — so a caller reads the names\n"
            + " * from the bytes it already has (`manifestIn` in `packages/wacc/src/manifest.wac`) and the host\n"
            + " * dispatches on the signature it finds there. Nothing has to describe a module to the host that the\n"
            + " * module does not already say about itself.\n"
            + " */\n"
            + "export struct LoadedModule {\n"
            + "  /**\n"
            + "   * The module, or why not.\n"
            + "   *\n"
            + "   *   >= 0  a handle for `call` and `unload`\n"
            + "   *    -1   this world can load and this module could not be — `error` says why\n"
            + "   *    -2   **this world has no `load` at all**, so nothing was attempted\n"
            + "   *\n"
            + "   * The same two negatives `Child` uses, for the same reason it uses them: a caller that reads -2 has\n"
            + "   * a host without the capability and should fall through to whatever it would have done, where -1 is\n"
            + "   * a real failure about this module.\n"
            + "   */\n"
            + "  i32 handle;\n"
            + "  /** The host's own sentence, empty when `handle` is not negative. */\n"
            + "  string error;\n"
            + "\n"
            + "  /** Whether this world can load a module at all. False says nothing about the module. */\n"
            + "  bool unavailable(const this) { return this.handle == -2; }\n"
            + "\n"
            + "  LoadedModule of(i32 handle, string error) { return LoadedModule(handle, error); }\n"
            + "}\n"
            + "\n"
            + "/**\n"
            + " * What one call to a loaded module's export answered.\n"
            + " *\n"
            + " * **A trap is a value here, and that is the point.** 389 of this repository's 2553 test exports are\n"
            + " * `test_traps_*` — a test that passes *by* trapping — and no wac program can catch one. Without a\n"
            + " * status for it, a caller learns about such a test by dying with it.\n"
            + " *\n"
            + " * The signatures a call accepts are a **closed set**: `void f()`, `i32 f()`, `i32 f(i32)`, and\n"
            + " * `i32`- or `string`-returning `f(Core?, Cli?)`. That is every shape the four commands need. Anything\n"
            + " * else answers `status == 3` rather than being marshalled — widening the set is a decision about the\n"
            + " * boundary, and answering plainly is what stops it being made by accident.\n"
            + " */\n"
            + "export struct CallResult {\n"
            + "  /**\n"
            + "   * 0 returned, 1 **trapped**, 2 no such export, 3 a signature this cannot call.\n"
            + "   *\n"
            + "   * Distinct rather than merged because the remedies differ: 2 is a typo or a module built without\n"
            + "   * the export, and 3 is a request to widen the boundary.\n"
            + "   */\n"
            + "  i32 status;\n"
            + "  /**\n"
            + "   * A `string`-returning export's answer, or, when `status` is 1, what the trap said.\n"
            + "   *\n"
            + "   * **Empty when it said nothing**, which is an engine trap: a bounds check, a null dereference, a\n"
            + "   * bare `trap;`. Only `trap \"...\"` writes a sentence. This field is the answer to \"did it say why\",\n"
            + "   * and `status` is already the answer to \"did it trap\" -- so the engine's own word for the\n";
    s = s + "   * instruction does not go here. It used to, and one host had to invent that word to match another.\n"
            + "   */\n"
            + "  string text;\n"
            + "  /** An `i32`-returning export's answer, and 0 for every other shape. */\n"
            + "  i32 value;\n"
            + "\n"
            + "  /** It returned. Says nothing about *what*: a failing test returns a report. */\n"
            + "  bool ok(const this) { return this.status == 0; }\n"
            + "  /** It trapped, which for a `test_traps_*` export is the pass. */\n"
            + "  bool trapped(const this) { return this.status == 1; }\n"
            + "\n"
            + "  CallResult of(i32 status, string text, i32 value) { return CallResult(status, text, value); }\n"
            + "}\n"
            + "\n"
            + "export struct Cli {\n"
            + "  fn[Pending<i32>()] argCount;\n"
            + "  /**\n"
            + "   * One argument, **as bytes**.\n"
            + "   *\n"
            + "   * Not a `string`, and that is the whole of wac-mono 0065. An argument is bytes on every system this\n"
            + "   * targets, and a capability that called it text forced a conversion at the boundary — `TextDecoder`\n"
            + "   * one way, `TextEncoder` the other — so a name that is not valid UTF-8 came back as replacement\n"
            + "   * characters. It was silent: `cat $(printf '\\xff\\xfe')` named a file nobody had asked about, and a\n"
            + "   * program using the argument as a path would have opened the wrong one.\n"
            + "   *\n"
            + "   * A caller that wants text says so: `string.fromBytes(cli.arg(0).wait())`. That is one call longer and\n"
            + "   * it is honest about where the interpretation happens — the alternative was a clever codec smuggling\n"
            + "   * bytes through a type that should not have been there.\n"
            + "   */\n"
            + "  fn[Pending<u8[]>(i32)] arg;\n"
            + "  /**\n"
            + "   * One environment value, as bytes. Null when the variable is unset, which is not the same as empty.\n"
            + "   *\n"
            + "   * Bytes for the same reason as `arg`: an environment value is not text on any system here, and this is\n"
            + "   * how a path in `$HOME` or `$WACPATH` survives being one.\n"
            + "   */\n"
            + "  fn[Pending<u8[]?>(string)] env;\n"
            + "\n"
            + "  /** All of standard input, to the end. Empty when there is none. */\n"
            + "  fn[Pending<u8[]>()] readStdin;\n"
            + "  /**\n"
            + "   * Exactly these bytes on standard output — no newline, no encoding.\n"
            + "   *\n"
            + "   * `log` is for lines of text; this is for a program whose output *is* bytes. Without it\n"
            + "   * nothing could emit binary, which ruled out every compressor and encoder as a filter.\n"
            + "   *\n"
            + "   * Answers with whether the write succeeded, which most callers discard. The type is not\n"
            + "   * for them: `fn[bool(u8[])]` is the shape every streaming transform in this repo takes\n"
            + "   * for its sink, so `write` can be handed to one directly instead of through an adapter\n"
            + "   * — and `fn[bool(u8[])]` has no spare parameter, so an adapter has nowhere to keep one.\n"
            + "   */\n"
            + "  fn[bool(u8[])] write;\n"
            + "  /**\n"
            + "   * Exactly these bytes on standard error, with the same shape and the same absence of a grant.\n"
            + "   *\n"
            + "   * `warn` is the program talking about itself: a diagnostic *line*, which is what every applet in\n"
            + "   * `packages/box` wants and what it should keep using. This is the program passing bytes through,\n"
            + "   * and the two are different jobs rather than one with a redundant spelling.\n"
            + "   *\n"
            + "   * `packages/ssh` is why it exists. A remote command's two streams arrive interleaved and tagged,\n"
            + "   * in the order the command wrote them, and with only `warn` the client could reproduce standard\n"
            + "   * output exactly and standard error not at all: emitting per packet inserted a newline at every\n"
            + "   * boundary, so it had to buffer to the end, which lost the ordering — and mangled anything that\n"
            + "   * was not valid UTF-8, since `warn` takes a string. wac-mono issue 0014.\n";
    s = s + "   *\n"
            + "   * No grant, for the reason `write` has none: what a program prints is the user's own doing.\n"
            + "   */\n"
            + "  fn[bool(u8[])] writeErr;\n"
            + "\n"
            + "  fn[Pending<FileResult>(string)] readFile;\n"
            + "  /**\n"
            + "   * **Answers a `Change`**: a fault category and the host's message. A `bool` could say that a write\n"
            + "   * failed and never why, and a bare message could say why to a person but not to a program.\n"
            + "   *\n"
            + "   * That mattered more than it looks. `rm -f` could only suppress every failure or none, because\n"
            + "   * \"no such file\" and \"permission denied\" arrived as the same `false`; `find` could report that a\n"
            + "   * directory was unreadable but not that it was a mount point rather than a typo; and every\n"
            + "   * `writeFile` diagnostic in this repo was the applet's guess at what had gone wrong. The message\n"
            + "   * is the host's own, which is the only one that knows.\n"
            + "   */\n"
            + "  fn[Pending<Change>(string, u8[])] writeFile;\n"
            + "  /** What a path is. `exists` is false where the filesystem was not granted. */\n"
            + "  fn[Pending<Stat>(string)] stat;\n"
            + "  /**\n"
            + "   * `stat` without following the last component: the link, not its target.\n"
            + "   *\n"
            + "   * A separate capability rather than a flag on `stat`, and rather than making `stat` stop\n"
            + "   * following, because every caller in this repo wants the followed answer — `find` and `du` ask\n"
            + "   * \"is this a directory I should walk into\", and that is a question about the target. Doing both\n"
            + "   * syscalls inside `stat` would have doubled the cost of every directory walk to serve the one\n"
            + "   * applet that cares.\n"
            + "   *\n"
            + "   * `tar` is that applet: its header says symbolic links are refused, and until this existed it\n"
            + "   * could not tell one from the thing it points at, so a link to a directory was archived as the\n"
            + "   * directory and a cycle grew the path until something trapped.\n"
            + "   *\n"
            + "   * A host with no links answers exactly as `stat` does, `isSymlink` false — that is true rather\n"
            + "   * than a stand-in, since the Origin Private File System has none.\n"
            + "   */\n"
            + "  fn[Pending<Stat>(string)] linkStat;\n"
            + "  /** Names within a directory, or null if it is not one — or not permitted. */\n"
            + "  fn[Pending<string[]?>(string)] readDir;\n"
            + "\n"
            + "  /**\n"
            + "   * Making, unmaking and moving. All three answer a `Change`, as `writeFile` does.\n"
            + "   *\n"
            + "   * `writeFile` alone cannot express a safe update: it truncates and then fills, so a\n"
            + "   * reader arriving in between sees a half-written file, and a crash leaves one. With\n"
            + "   * `rename` an application can write beside the target and move it into place, which on\n"
            + "   * every filesystem this runs on is atomic. That is why these are one tier rather than\n"
            + "   * three conveniences — see `applets/cp.wac`, which does exactly that.\n"
            + "   *\n"
            + "   * `parents` and `recursive` are `mkdir -p` and `rm -r`. Both default to nothing: a\n"
            + "   * caller has to ask for the recursive form, because the recursive form is the one that\n"
            + "   * can destroy something it was not pointed at.\n"
            + "   */\n"
            + "  fn[Pending<Change>(string, bool)] mkdir;\n"
            + "  fn[Pending<Change>(string, bool)] remove;\n"
            + "  fn[Pending<Change>(string, string)] rename;\n"
            + "\n"
            + "  /**\n"
            + "   * Make a file executable, or stop it being one.\n"
            + "   *\n"
            + "   * **One bit rather than a mode, and that is a decision rather than a shortcut** —\n"
            + "   * issues/system/0132. Three reasons, in the order they mattered:\n"
            + "   *\n"
            + "   *   - git's two regular-file modes, `100644` and `100755`, differ only in this bit. Symlink and\n"
            + "   *     gitlink are entry *kinds*, not permissions. Nothing in this repository needs the rest of a\n";
    s = s + "   *     POSIX mode, and a surface that promised one would be promising something no caller wants.\n"
            + "   *   - a browser's OPFS has no mode bits at all. With one bit the browser host answers\n"
            + "   *     `FAULT_UNSUPPORTED` — the capability is present and the *backing* refuses, which is a\n"
            + "   *     distinction this vocabulary can make since 0117. A general `chmod(path, mode)` there would be\n"
            + "   *     unanswerable rather than merely unsupported.\n"
            + "   *   - widening later is additive; narrowing later removes something callers depend on. The cheaper\n"
            + "   *     mistake to make is the narrow one.\n"
            + "   *\n"
            + "   * `Stat.isExecutable` is the reading half, and the two together are what let a checkout produce a\n"
            + "   * working tree `git status` calls clean.\n"
            + "   */\n"
            + "  fn[Pending<Change>(string, bool)] setExecutable;\n"
            + "\n"
            + "  /**\n"
            + "   * Streaming input: `openInput` chooses the source, `readChunk` pulls from it.\n"
            + "   *\n"
            + "   * Everything else here answers with the whole of something, which is fine for a\n"
            + "   * filename and wrong for a pipe — `cat` of a large file held it entirely in memory, and\n"
            + "   * so did every filter. These two are the incremental half.\n"
            + "   *\n"
            + "   * `openInput(\"\")` selects standard input, which is also where a program starts, so an\n"
            + "   * applet that only ever filters need not call it at all. A path selects that file\n"
            + "   * instead, and the previous source is closed.\n"
            + "   *\n"
            + "   * There is one current input rather than a handle per file because the transforms take\n"
            + "   * `fn[u8[]()]`, which has no parameter to carry a handle in. That is a choice in those\n"
            + "   * packages, not a limit of the language — wac can pass context beside a funcref, and a\n"
            + "   * transform taking `fn[u8[](i32)]` could be handed a real file handle. Worth knowing\n"
            + "   * before anyone repeats the design: `recv(handle)` is what it looks like done that way,\n"
            + "   * and standard input has a handle now precisely so `waitAny` can watch it.\n"
            + "   *\n"
            + "   * `readChunk` answers with an empty array at end of input, and with at most\n"
            + "   * `CHUNK` bytes otherwise. A short chunk does not mean the end.\n"
            + "   *\n"
            + "   * `openInput` answers with a `Change`: `FAULT_NONE` when the source was selected, and a\n"
            + "   * category with the host's words when it was not.\n"
            + "   *\n"
            + "   * **A `Change` and not a bare message**, which is what this used to be, for the reason\n"
            + "   * `openOutput` was changed first: a message alone cannot be translated. `readFile` carries a\n"
            + "   * fault and its callers print what GNU prints; this carried the host's sentence, so\n"
            + "   * `cat missing` said `No such file or directory (os error 2): open '/tmp/x'` where the whole-file\n"
            + "   * path said `No such file or directory` — the same failure, worded two ways in one program,\n"
            + "   * depending on whether the applet happened to stream. That is the drift `faultWords` exists to\n"
            + "   * end, and it survived in the streaming half until a differential test against `cat` caught it.\n"
            + "   */\n"
            + "  fn[Pending<Change>(string)] openInput;\n"
            + "  /**\n"
            + "   * **Blocking, unlike its neighbours**, and so is `write`.\n"
            + "   *\n"
            + "   * Two reasons, and the second is the binding one. They act on the *current* stream,\n"
            + "   * which the world keeps in order regardless, so there is nothing to overlap: two\n"
            + "   * `readChunk`s in flight is not a faster read, it is an undefined one. And they are\n"
            + "   * passed as bare function references to the streaming transforms in this repo —\n"
            + "   * `gzipStream(cli.readChunk, cli.write)` — which expect `fn[u8[]()]` and `fn[bool(u8[])]`.\n"
            + "   * A ticket-returning capability does not match those, and `fn[u8[]()]` takes no\n"
            + "   * parameter, so there is nowhere for an adapter to carry a ticket either.\n"
            + "   *\n"
            + "   * Note what that does *not* say. Context can travel beside a funcref in wac, as an\n"
            + "   * unbound method reference — `fn[u8[](Reader)]` would work fine. What forbids it here is\n"
            + "   * the transforms' own signature, which is a choice in `packages/gzip` and\n"
            + "   * `packages/stream` rather than anything about the language.\n"
            + "   *\n"
            + "   * The capabilities worth a ticket are the ones that *name their target*: `readFile(path)`,\n"
            + "   * `stat(path)`, `recv(handle)`, `connect(host)`. Those are the ones a program has reason\n";
    s = s + "   * to have several of at once.\n"
            + "   */\n"
            + "  fn[Read()] readChunk;\n"
            + "  /**\n"
            + "   * Why the last `write` or `writeErr` answered false: the empty string when the other end simply\n"
            + "   * went away, and the host's message when the write itself failed.\n"
            + "   *\n"
            + "   * One question for both streams rather than two, because no caller has ever needed to know *which*\n"
            + "   * stream failed — a program asks this to decide between exiting 0 and reporting a real failure, and\n"
            + "   * that decision is the same either way. If one ever does need to tell them apart, that is the point\n"
            + "   * to split it, and the split will be visible rather than guessed at.\n"
            + "   *\n"
            + "   * A closed pipe is an answer rather than an error — `yes | head -1` ends that way and should exit\n"
            + "   * 0 — so the two have to be distinguishable. Without this a full disk and a departed reader were\n"
            + "   * the same `false`, and every filter treated both as \"my work here is done\".\n"
            + "   */\n"
            + "  fn[Pending<string>()] outputError;\n"
            + "\n"
            + "  /**\n"
            + "   * Where `write` goes. `openOutput(\"\")` is standard output, which is where it starts.\n"
            + "   *\n"
            + "   * The mirror of `openInput`, and for the same reason: without it a program could not\n"
            + "   * produce more output to a *file* than fits in memory, because `writeFile` takes the\n"
            + "   * whole of it at once. `cp` of a file larger than memory needed this; so would `split`,\n"
            + "   * or any filter told to write somewhere other than a pipe.\n"
            + "   *\n"
            + "   * A path truncates that file and makes it the destination of every subsequent `write`.\n"
            + "   * Opening another output closes the previous one, and so does opening `\"\"` — which is\n"
            + "   * how a program that has finished writing a file knows the bytes are there, since\n"
            + "   * `rename` over a file still open would move it half-written. `cp` does exactly that.\n"
            + "   *\n"
            + "   * **Answers a `Change`**, so a caller can tell *which* failure it was rather than only that the\n"
            + "   * sentence came from the host. It used to answer a bare string, and the host's sentence reached the\n"
            + "   * user: `sh`'s streaming redirection reported `No such file or directory (os error 2): open\n"
            + "   * '/tmp/…/sub/out'` where bash says `sub/out: No such file or directory`. Every other call that\n"
            + "   * changes something — `writeFile`, `mkdir`, `remove`, `rename` — has carried a fault category since\n"
            + "   * wac-mono 0062, and this one was left behind because nothing had needed to word its failure yet.\n"
            + "   */\n"
            + "  fn[Pending<Change>(string)] openOutput;\n"
            + "\n"
            + "\n"
            + "  /**\n"
            + "   * The network. `--allow-net`, and nothing without it.\n"
            + "   *\n"
            + "   * `connect` resolves and dials; `listen` binds an address and a port, and `accept` blocks until\n"
            + "   * someone arrives. `recv` answers with at most `CHUNK` bytes and with an empty array when the\n"
            + "   * peer has closed — a short read means nothing, exactly as it does for a file.\n"
            + "   *\n"
            + "   * **`listen` takes the address to bind, and it is not optional.** It used to take a port alone and\n"
            + "   * the host bound `0.0.0.0`, so every server written on this platform was reachable from every\n"
            + "   * interface and no program could ask for loopback. For most servers that is a deployment surprise;\n"
            + "   * for `packages/tor`'s SOCKS proxy it is the difference between serving the person at the keyboard\n"
            + "   * and running an open proxy that sources strangers' traffic out of somebody else's exit node. Every\n"
            + "   * other SOCKS implementation binds loopback for that reason, so the safe configuration was not only\n"
            + "   * unavailable, it was the one people would assume they already had.\n"
            + "   *\n"
            + "   * `\"127.0.0.1\"` is loopback, `\"0.0.0.0\"` is every interface, and the empty string means *every\n"
            + "   * interface* as well — the old behaviour, spelled out rather than defaulted into. A caller has to\n"
            + "   * write one of them, which is the point: the surprising one is now a thing somebody typed.\n"
            + "   *\n"
            + "   * Watching two sockets at once is `waitAny` below, over the ids of two tickets in flight.\n"
            + "   * This comment used to say there was no way to do that and that \"when something needs it,\n"
            + "   * that is the shape to add\" — it was left behind when the shape was added, twenty lines\n"
            + "   * further down, and contradicting it.\n";
    s = s + "   */\n"
            + "  fn[Pending<Socket>(string, i32)] connect;\n"
            + "  fn[Pending<Socket>(string, i32)] listen;\n"
            + "  fn[Pending<Socket>(i32)] accept;\n"
            + "  fn[Pending<Read>(i32)] recv;\n"
            + "  fn[Pending<bool>(i32, u8[])] send;\n"
            + "  fn[void(i32)] closeSocket;\n"
            + "\n"
            + "  /**\n"
            + "   * **Say \"that is all\" without saying \"goodbye\"**: end the outbound direction and keep reading.\n"
            + "   *\n"
            + "   * `closeSocket` stops the socket both ways, so a client that used it to signal end-of-input could\n"
            + "   * never receive the answer. That is the exchange every request/response protocol over a raw socket\n"
            + "   * needs — the server reads to the end and only then replies — and until 2026-08-20 there was no\n"
            + "   * call for it. `issues/system/0215`.\n"
            + "   *\n"
            + "   * The argument was already written one capability over: `closeFeed` says *\"a program that reads to\n"
            + "   * the end before answering — `wc` is the obvious one — needs the end to arrive while it is still\n"
            + "   * running, and killing it instead means it never speaks.\"* The same sentence, and the same example\n"
            + "   * program, for a socket instead of a child. `closeFeed` is the child case and this is the socket\n"
            + "   * one; a handle is a handle everywhere else, and this is the one place the two differ, because a\n"
            + "   * child has a standard input to end and a socket has a direction.\n"
            + "   *\n"
            + "   * **A separate call rather than a flag on `closeSocket`**, deliberately. A host that did not know\n"
            + "   * about a new argument would read it as an ordinary close, so the program would hang waiting for a\n"
            + "   * reply that the host had just made unreachable — where an unrecognised call fails and says so.\n"
            + "   *\n"
            + "   * After this, `send` on the handle is over; `recv` keeps working until the peer closes its own\n"
            + "   * side. Under `--allow-net` with everything else here: the authority is \"speak to something that\n"
            + "   * is not this process\", and stopping speaking is not a second question.\n"
            + "   */\n"
            + "  fn[void(i32)] closeSend;\n"
            + "\n"
            + "  /**\n"
            + "   * Datagrams, under the same one `--allow-net` grant.\n"
            + "   *\n"
            + "   * The authority is \"speak to something that is not this process\", and the transport does not change\n"
            + "   * what that means: a program that may open a TCP connection may send a UDP packet, and one that may\n"
            + "   * not may do neither. A second grant would be a second question with the same answer.\n"
            + "   *\n"
            + "   * Every field above this is *stream* — `connect`, `listen`, `accept`, `recv`, `send` — and QUIC needs\n"
            + "   * none of them. A QUIC server answers many peers from one socket, and a connection is identified by\n"
            + "   * its connection id rather than by an address, so a peer may legitimately move mid-connection. A\n"
            + "   * connected socket represents neither: not one socket for many peers, and not one peer at changing\n"
            + "   * addresses. That is `design/system/0007`, and this is its first step.\n"
            + "   *\n"
            + "   * `bindDatagram` takes an address and a port exactly as `listen` does, with the same rule that the\n"
            + "   * address is not optional — `\"127.0.0.1\"` for loopback, `\"0.0.0.0\"` or `\"\"` for every interface — and\n"
            + "   * answers a `Socket` whose `port` is what the kernel bound, so `bindDatagram(addr, 0)` is usable.\n"
            + "   * The handle goes to `receiveFrom`, `sendTo`, `waitAny` and `closeSocket` like any other.\n"
            + "   *\n"
            + "   * There is no `connect` for datagrams and no `accept`. The peer is named on every `sendTo` and\n"
            + "   * arrives with every `receiveFrom`, which is what makes one socket serve many.\n"
            + "   */\n"
            + "  fn[Pending<Socket>(string, i32)] bindDatagram;\n"
            + "  /** One datagram with its sender — see `Datagram` for why those are one answer and not two. */\n"
            + "  fn[Pending<Datagram>(i32)] receiveFrom;\n"
            + "  /** A datagram to a peer named in this call, which is the half that makes one socket serve many. */\n"
            + "  fn[Pending<bool>(i32, string, i32, u8[])] sendTo;\n"
            + "\n"
            + "\n"
            + "  /**\n"
            + "   * Start a child on `prog`, with `args` as its arguments.\n"
            + "   *\n";
    s = s + "   * `prog` is a **program's bytes**: since 2026-08-21 a wasm module carrying its own `wac.manifest`\n"
            + "   * runs on every host — the two native ones and, through `host/driver.ts`, Deno and Node — and the\n"
            + "   * JavaScript hosts also accept the worker bundle they used to require. So one artefact is a program\n"
            + "   * everywhere, which is what `issues/system/0144` was open on: before it, a program that read a file\n"
            + "   * and ran it worked under `wac` and failed under Deno, and `packages/sh` searching `$WACPATH` was\n"
            + "   * where that split showed up first.\n"
            + "   *\n"
            + "   * Running a *program* is therefore two steps, read it and spawn it, which is why there is no\n"
            + "   * registry of launchable things here: the capability is \"run this\", and where the code\n"
            + "   * came from is the caller's business and the filesystem's.\n"
            + "   *\n"
            + "   * The child talks through its handle. What it writes arrives at `recv(handle)`; what\n"
            + "   * `send(handle, bytes)` carries becomes its standard input; `closeSocket(handle)` stops\n"
            + "   * it. `exitCode(handle)` waits for it to finish.\n"
            + "   *\n"
            + "   * **`closeSocket` stops it wherever it is**, and this is a guarantee rather than a request: a\n"
            + "   * child that is computing and not writing stops too. That took a runtime change on the host with\n"
            + "   * no JavaScript in it — a wasm guest leaves a loop only when it decides to, so the engine ticks an\n"
            + "   * epoch and the child traps on the next check (issue 0123). Before it, the three JavaScript hosts\n"
            + "   * terminated a worker and the native one finished the child's queues and let the thread run, which\n"
            + "   * is the same thing for every program that writes and nothing at all for one that does not.\n"
            + "   *\n"
            + "   * **And the handle stays askable afterwards.** `exitCode` on a stopped child answers **-1** — \"no\n"
            + "   * status of its own\" — on every host, because stopping something and then finding out it is gone\n"
            + "   * is one operation in two halves and a supervisor needs both. All four hosts used to drop the\n"
            + "   * child at `closeSocket`: two threw, one silently read the call as the *other* meaning of\n"
            + "   * `exitCode` and set the caller's own status to the handle number.\n"
            + "   *\n"
            + "   * **What \"stops it\" means differs between the hosts, and the weaker one is the contract.** The\n"
            + "   * JavaScript host terminates the worker outright; the native runtime finishes all three of the\n"
            + "   * child's queues, so the child stops at its *next write*, which answers false. Every program in this\n"
            + "   * repo writes, so the two are the same to watch — `kill %1` on a background `seq` ends it on both —\n"
            + "   * but a child that computed without writing would keep going on one host and not the other. Depend\n"
            + "   * on the streams ending, not on the instant. wac-mono 0123.\n"
            + "   *\n"
            + "   * **`grants` is what the child may do beyond those streams**, as `GRANT_*` flags — and it\n"
            + "   * is a *ceiling of the parent's own*, intersected by the host rather than trusted.\n"
            + "   *\n"
            + "   * **The four are independent on three hosts out of four.** In a page, `GRANT_WRITE` without\n"
            + "   * `GRANT_READ` yields nothing: reaching a file to write it means walking directory handles from the\n"
            + "   * root, and holding the root handle *is* the read capability on the Origin Private File System.\n"
            + "   * Deno and Node have a path-based open and can give a child `write` without `read`; a page cannot,\n"
            + "   * and the child finds out as a `FAULT_NOT_GRANTED` from its first write rather than being told at\n"
            + "   * spawn. Named here because \"intersected by the host\" reads as four separate switches, and on one\n"
            + "   * host two of them are one. A parent\n"
            + "   * built without `--allow-net` cannot hand `GRANT_NET` to anyone; asking is not an error, and\n"
            + "   * the child simply finds the capability denied. `GRANT_NONE` is the honest default and what\n"
            + "   * every example passes.\n"
            + "   *\n"
            + "   *     cli.spawn(source, args, GRANT_NONE, \"\", false, false)          // fed; nothing else\n"
            + "   *     cli.spawn(source, args, GRANT_READ | GRANT_NET, dir, true, false)  // ...if the parent has both\n"
            + "   *\n"
            + "   * This is the reason to prefer spawning a worker to spawning a process. What the child may\n"
            + "   * do is the *parent's* choice; `--allow-run=/bin/sh` cannot express it at any granularity,\n"
            + "   * because there the child inherits the operating system's authority instead. A shell served\n"
            + "   * over a socket can be given one directory and no network.\n"
            + "   *\n"
            + "   * Flags rather than a struct because no capability takes a struct *parameter* anywhere in\n"
            + "   * this world — every one of them returns structs — so this would have been the first, and a\n"
            + "   * bitmask needs nothing from the boundary that is not already exercised.\n"
            + "   *\n"
            + "   * **The confinement is this language's, not the runtime's.** A wac child cannot reach\n"
            + "   * past what it was handed because wac has no ambient anything. Arbitrary JavaScript in a\n"
            + "   * worker can: it inherits the process's permissions, and dropping them needs an unstable\n";
    s = s + "   * Deno flag that would appear in the shebang of every program that spawns. So this is a\n"
            + "   * composition and concurrency primitive rather than a sandbox. See wac-mono issue 0015.\n"
            + "   *\n"
            + "   * `cwd` is where the child's relative paths resolve from, and what its own `cwd()` reports. Empty\n"
            + "   * means \"wherever the host already was\", which is what a program with no opinion wants. A shell\n"
            + "   * has an opinion: without this, `cd sub; prog f` looked in the wrong place, because a spawned\n"
            + "   * program inherited the *host's* directory rather than the shell's. `pushChild` took a directory\n"
            + "   * from the start for exactly this reason and `spawn` did not.\n"
            + "   *\n"
            + "   * **`inheritIn` gives the child this program's own standard input** instead of the queue that\n"
            + "   * `send` fills. Two things follow from it, and both are the difference between modelling a\n"
            + "   * process and imitating one:\n"
            + "   *\n"
            + "   *   - it *streams*. A parent that feeds a child must first have the bytes, so `yes | sh -c\n"
            + "   *     'head -1'` buffered without bound; an inherited input is read by the child as it goes, and\n"
            + "   *     the child closing it ends the producer.\n"
            + "   *   - it is *shared*. Two children that inherit read the same stream, so the second finds what\n"
            + "   *     the first left — which is why `cat; cat` prints one line in every real shell and printed\n"
            + "   *     two here. A shell cannot know how much a program read, and with this it does not have to.\n"
            + "   *\n"
            + "   * False is the ordinary case: a child fed from a pipeline, a redirection or a here-document gets\n"
            + "   * exactly the bytes its parent chose, and `send` is how they arrive.\n"
            + "   */\n"
            + "  fn[Pending<Child>(u8[], u8[][], i32, string, bool, bool)] spawn;\n"
            + "\n"
            + "  /**\n"
            + "   * **This same program again, as a child**, with these arguments and at most these grants.\n"
            + "   *\n"
            + "   * `spawn` needs a worker bundle from somewhere, and somewhere is a filesystem — which is fine on a\n"
            + "   * command line and impossible in a browser tab, where there is no directory of programs and\n"
            + "   * nothing to have put one there. So a page could spawn and had nothing to spawn, and\n"
            + "   * `packages/box`'s applets ran *inside* the shell's own wasm instance with no boundary at all.\n"
            + "   *\n"
            + "   * Every built program already carries its own worker bundle: the launcher holds it as a string,\n"
            + "   * because that is how it started the program in the first place. So \"run me again\" needs no file,\n"
            + "   * no path and no grant of its own — the code is already here, and the argument is what decides\n"
            + "   * which program it becomes. `box sort` is `box` with `sort` as its first argument, which is exactly\n"
            + "   * what a multi-call binary is; a shell that can say that has sixty real programs instead of sixty\n"
            + "   * function calls.\n"
            + "   *\n"
            + "   * The child runs `main`, never `page`, even when the program has both. A page is the top-level\n"
            + "   * thing a person opened; a child is a program with a handle, and there is nowhere for it to draw.\n"
            + "   *\n"
            + "   * Grants are a ceiling of the parent's own, as with `spawn`: a shell that may read hands its\n"
            + "   * children reading, and a program granted nothing cannot widen itself by spawning. `cwd` is where\n"
            + "   * the child's relative paths resolve from, empty for the host's own directory, and `inheritIn`\n"
            + "   * hands over this program's own standard input rather than a queue — see `spawn` above for what\n"
            + "   * that buys.\n"
            + "   *\n"
            + "   * **`serveFs` is a promise to answer the child's filesystem questions**, on `Child.fsHandle`. It\n"
            + "   * is not a grant — it widens nothing, since what the child can reach is whatever this program's\n"
            + "   * own `Fs` will answer — it is a statement about what this program is *going to do*, and the child\n"
            + "   * needs it because the alternative is waiting for an answer that is never coming. False ends the\n"
            + "   * child's end of the channel before it starts, so a program built on `Fs.overParent` finds out\n"
            + "   * immediately and falls back to the host, and every spawner that predates this goes on behaving\n"
            + "   * exactly as it did. A parent that passes true and then does not serve parks its child, which is\n"
            + "   * the one failure this cannot make safe and the reason it is stated rather than assumed.\n"
            + "   */\n"
            + "  fn[Pending<Child>(u8[][], i32, string, bool, bool)] spawnSelf;\n"
            + "\n"
            + "  /**\n"
            + "   * End a spawned worker's standard input without stopping it.\n"
            + "   *\n"
            + "   * Distinct from `closeSocket`, which stops the child outright. A program that reads to the\n";
    s = s + "   * end before answering — `wc` is the obvious one — needs the end to arrive while it is\n"
            + "   * still running, and killing it instead means it never speaks.\n"
            + "   */\n"
            + "  fn[void(i32)] closeFeed;\n"
            + "\n"
            + "  /** Wait for a spawned worker to finish. Negative if it failed to run at all. */\n"
            + "  fn[Pending<i32>(i32)] exitCode;\n"
            + "  /**\n"
            + "   * Where relative paths are resolved from, as the host sees it.\n"
            + "   *\n"
            + "   * A *read*, and nothing more: there is no `chdir`, because a mutable working directory is\n"
            + "   * ambient state — it changes what every relative path in the program means, from anywhere, and\n"
            + "   * that is the shape this world exists to avoid. A program that wants to move around keeps its\n"
            + "   * own idea of where it is and passes whole paths, which is what `packages/sh` does.\n"
            + "   *\n"
            + "   * It is here because a program cannot otherwise answer \"where am I\", and the first thing\n"
            + "   * anybody types into a new shell is `pwd`. Under Deno and Node it is the process's directory;\n"
            + "   * in a browser it is `/`, the root of the Origin Private File System, because that is the\n"
            + "   * honest answer rather than a fiction.\n"
            + "   */\n"
            + "  fn[Pending<string>()] cwd;\n"
            + "\n"
            + "  /**\n"
            + "   * Run a program *inside* this one: the world a child sees, pushed and then popped.\n"
            + "   *\n"
            + "   * `pushChild` says what the next stretch of work is called and was given, what it reads, where\n"
            + "   * its relative paths resolve from, and that its output is to be kept rather than written. `popChild` ends that and\n"
            + "   * answers with what it wrote. Between the two, `arg` and `argCount` answer from `argv`,\n"
            + "   * `readChunk` returns `stdin` and then end of input, `Core.log`, `write` and `Core.warn`\n"
            + "   * accumulate, and every path is taken relative to `cwd`.\n"
            + "   *\n"
            + "   * **The last argument says the child reads the *real* standard input** rather than the bytes handed\n"
            + "   * over. A shell that runs a command in process has to have bytes to give it, and to have them it must\n"
            + "   * read its own input to the end — which at a terminal never comes, so `seq 1 3` hung a shell that\n"
            + "   * could not spawn (wac-mono 0110). With it set, `readChunk` and `readStdin` reach past the frame to\n"
            + "   * the process's own input, exactly as they do when nothing is pushed; the output is still captured,\n"
            + "   * which is what the frame is for.\n"
            + "   *\n"
            + "   * `argv` is in the layout `box` uses — the program's own name first — because an applet that\n"
            + "   * reads its arguments positionally rather than through a parser is reading that layout already.\n"
            + "   * `Core.log` is captured along with `write` for the same kind of reason: it is where thirty of\n"
            + "   * those applets send their output, so a capture that took only `write` would lose most of them\n"
            + "   * silently. That is exactly what the first working version of this did.\n"
            + "   *\n"
            + "   * **Why this exists.** A shell has to run a program and keep its output, and in wac it cannot\n"
            + "   * do that by handing the program a different `Cli`: there are no closures, so a substitute\n"
            + "   * capability has nowhere to put what it collected. `packages/sh` therefore had its own small\n"
            + "   * `cat`, `wc`, `grep` and nine more — implementations that existed only because the real ones\n"
            + "   * could not be called. With this, `packages/box`'s applets run in the shell unchanged, and one\n"
            + "   * `grep` serves both.\n"
            + "   *\n"
            + "   * **Why a scope rather than a `chdir`.** `cwd` above refuses to be settable because a mutable\n"
            + "   * working directory changes what every relative path in a program means. This does not\n"
            + "   * contradict that: it is a *child's* view, bounded by a matching `popChild`, and what the\n"
            + "   * parent's own paths mean is unchanged before and after. That is also the honest fix for\n"
            + "   * something `spawn` gets wrong today — a spawned program inherits the host's directory rather\n"
            + "   * than the shell's, so `cd sub; prog f` looks in the wrong place.\n"
            + "   *\n"
            + "   * Nesting is a stack, so a program that runs a program that runs a program is fine. A\n"
            + "   * `popChild` with nothing pushed answers with two empty arrays rather than failing: the\n"
            + "   * caller has nothing to clean up, and there is no state to corrupt.\n"
            + "   *\n"
            + "   * This is *not* isolation. The child is the same wasm instance with the same authority; it can\n"
            + "   * still open any file the parent could. A real boundary is `spawn`, which is a separate worker\n";
    s = s + "   * with its own grants — and which a browser cannot do yet.\n"
            + "   */\n"
            + "  fn[Pending<bool>(string[], u8[], string, bool)] pushChild;\n"
            + "  fn[Pending<Captured>()] popChild;\n"
            + "\n"
            + "  /**\n"
            + "   * Run a program on the host, to completion, and hand back what it said.\n"
            + "   *\n"
            + "   * The capability `spawn` is repeatedly mistaken for. `spawn` starts another **wasm module** and\n"
            + "   * `spawnSelf` starts an applet of this one; neither runs `/usr/bin/gunzip`. This does, which is why\n"
            + "   * it is a separate capability rather than an overload: a host that will start a confined wasm\n"
            + "   * module must be able to refuse a host binary without refusing both, and in a browser it always\n"
            + "   * does. Granted by `--allow-run`.\n"
            + "   *\n"
            + "   * `args` are arguments, **not a shell line**. They are passed as an argument vector, so a value\n"
            + "   * containing a space, a quote or a semicolon arrives whole and is never re-split or interpreted.\n"
            + "   * A caller who wants a shell asks for one by name: `exec(\"/bin/sh\", string[](\"-c\", line), ...)`.\n"
            + "   *\n"
            + "   * `stdin` is handed over and then closed, so a program that reads to the end — which is most\n"
            + "   * oracles — sees the end.\n"
            + "   *\n"
            + "   * **Buffered, and that is measured rather than a simplification.** Of the 107 host-side test files\n"
            + "   * that spawn a process, not one reads a child's output while still writing to it; the fifteen that\n"
            + "   * keep a child alive start a *server* and then talk to it over a socket, which is `connect`. So\n"
            + "   * there is no streaming form here, and adding one should wait for a caller that needs it.\n"
            + "   * `issues/system/0165` records the count.\n"
            + "   *\n"
            + "   * `env` is `NAME=value` strings, and a name given twice takes the last value. A string with no\n"
            + "   * `=` in it is ignored rather than being a fault: there is nothing it could mean.\n"
            + "   *\n"
            + "   * **`clearEnv` is the whole of `issues/system/0198`**, which is why this parameter exists at all\n"
            + "   * rather than only the four the runner wanted. False — what `Cli.exec` passes — *adds* `env` to\n"
            + "   * everything this process holds, and that inheritance is an authority nobody declared: a program\n"
            + "   * refused `--allow-env` can still read `HOME` by running `printenv`, so `--allow-run` confers\n"
            + "   * `--allow-env`. True hands the child exactly `env` and nothing else, which is the shape\n"
            + "   * `issues/system/0182` argued for — total, so that what you pass is what it gets and passing\n"
            + "   * nothing means nothing.\n"
            + "   *\n"
            + "   * It is not the default **yet**, and the reason is a count rather than a doubt: 342 call sites,\n"
            + "   * many of them oracles that read `PATH` or reach the network through a proxy variable, and every\n"
            + "   * one of them needs its own answer to \"which of these did it actually need\". Flipping the default\n"
            + "   * is that sweep, not this parameter. `Cli.exec` is where it flips.\n"
            + "   *\n"
            + "   * **Removing a named variable is still not expressible**, and `clearEnv` is not it: a caller who\n"
            + "   * wants everything *except* one name has to name what stays, and nothing here can enumerate the\n"
            + "   * environment — `Cli.env` answers one name at a time. `packages/wactest/src/childenv.wac`'s\n"
            + "   * `withoutEnv` uses a shell's `unset` for that, and has to.\n"
            + "   *\n"
            + "   * `inherit` sends the child's stdout and stderr to this program's own, and then `Exec.stdout` and\n"
            + "   * `Exec.stderr` come back **empty**: the bytes went somewhere else, and reporting them in both\n"
            + "   * places would be a copy the caller cannot ask not to have. `status` still arrives. It is what a\n"
            + "   * runner wants — a lane that shows its output as it runs, rather than three minutes of silence and\n"
            + "   * then everything — and it is the nearest thing here to streaming: incremental output, without a\n"
            + "   * caller having to read it. What it is *not* is capturable — an inherited stream goes to the real\n"
            + "   * file descriptor, so `pushChild`'s capture does not see it.\n"
            + "   */\n"
            + "  fn[Pending<Exec>(string, string[], u8[], string[], bool, bool)] execWith;\n"
            + "\n"
            + "  /**\n"
            + "   * `execWith` with nothing added, nothing cleared and buffered output — what almost every caller\n"
            + "   * wants: 342 call sites in 154 files, and the ones that do not are a test runner and the fixtures\n"
            + "   * that need a child's environment to be theirs rather than the machine's.\n"
            + "   *\n"
            + "   * A method rather than a second capability, so that there is one thing for a host to implement and\n";
    s = s + "   * one payload on the bridge. It is also **where the default flips** when `issues/system/0198` is\n"
            + "   * closed: the second `false` below becomes `true`, and the call sites that were relying on\n"
            + "   * inheritance fail here rather than in six hosts.\n"
            + "   */\n"
            + "  Pending<Exec> exec(const this, string path, string[] args, u8[] stdin) {\n"
            + "    return this.execWith(path, args, stdin, string[](), false, false);\n"
            + "  }\n"
            + "\n"
            + "  /**\n"
            + "   * Instantiate `module` and answer a handle to call its exports through — `issues/system/0240c`.\n"
            + "   *\n"
            + "   * **`grants` narrows, and cannot widen.** Asking for more than this program holds ends where every\n"
            + "   * other over-ask ends: at the host, which serves what the build granted. So the module gets the\n"
            + "   * intersection, exactly as a spawned child does.\n"
            + "   *\n"
            + "   * **This argument was left out once, and that was wrong.** The reasoning was that a loaded module\n"
            + "   * shares the caller's world and there is nowhere to enforce a narrowing: true of the *launcher*,\n"
            + "   * which cannot tell this module's calls from its loader's, and false of the world the module is\n"
            + "   * *handed*, which is built here. `wac test --allow-read` handed a test the command's write\n"
            + "   * capability and a test wrote a file to disk; the native host failed the same test. `issues/system/0242c`.\n"
            + "   *\n"
            + "   * What makes handing over a narrowed world sufficient is the argument `spawn` makes for itself:\n"
            + "   * **the isolation is the language's, not the runtime's.** A wac module reaches only what it was\n"
            + "   * given, because wac has no ambient anything. That would not hold for arbitrary JavaScript, and a\n"
            + "   * loaded module is a wac module.\n"
            + "   *\n"
            + "   * **Not `Pending`, because nothing crosses to a host.** Driving a module and calling one of its\n"
            + "   * exports both finish before the call returns. Every other field here answers a ticket because it\n"
            + "   * asks the launcher something; these three do not ask anybody.\n"
            + "   *\n"
            + "   * **On this thread.** See `LoadedModule`: nothing can stop a running export, so an export that loops\n"
            + "   * forever hangs the caller.\n"
            + "   */\n"
            + "  fn[LoadedModule(u8[], i32)] load;\n"
            + "\n"
            + "  /**\n"
            + "   * Call `name` on a loaded module, and answer what it did — including trapping.\n"
            + "   *\n"
            + "   * `arg` is passed to a signature that takes one `i32` and ignored by every other shape in the set.\n"
            + "   * One field rather than a vector because the set is closed and one is all of it: `__cov_get(i)` is\n"
            + "   * the only member that takes anything at all.\n"
            + "   *\n"
            + "   * A trap does not end the caller and does not poison the handle: the next `call` on the same module\n"
            + "   * runs. That is what lets a runner take a file's tests in order when one of them is meant to trap —\n"
            + "   * and it is safe for the same reason `test_traps_*` has always been able to run beside its\n"
            + "   * neighbours, which is that wac has no module-level state for a trap to leave behind.\n"
            + "   */\n"
            + "  fn[CallResult(i32, string, i32)] call;\n"
            + "\n"
            + "  /**\n"
            + "   * Let a loaded module go.\n"
            + "   *\n"
            + "   * `void`, and forgiving of a handle that is not one: a caller tidying up after a failure should not\n"
            + "   * have to know how far it got. Not required for correctness — a program that exits releases\n"
            + "   * everything — but a runner that loads a module per file would otherwise hold every one of them.\n"
            + "   */\n"
            + "  fn[void(i32)] unload;\n"
            + "\n"
            + "  /**\n"
            + "   * Would the engine accept these bytes as a module? \"\" if it would, and why not if it would not.\n"
            + "   *\n"
            + "   * **Compiles and stops there**, which is the whole difference from `load` and the reason this is\n"
            + "   * its own field rather than a flag on it. `load` wants a `wac.manifest` section, instantiates, and\n"
            + "   * builds a world out of the exports — three things that can fail for reasons that are nothing to do\n";
    s = s + "   * with the bytes being a well-formed module. A program asking \"did the compiler emit something the\n"
            + "   * engine will take\" is asking about the *bytes*.\n"
            + "   *\n"
            + "   * **The question only a host can answer**, and so the one thing about modules that stayed on this\n"
            + "   * side of `issues/system/0257c`'s line. wac has no `WebAssembly.validate`, so\n"
            + "   * `packages/wacc/test/wac/corpusemit_test.wac` used to run each module it emitted — a fork per\n"
            + "   * module, 142s of the 193s it took — and `wac validate` was a host command for want of this.\n"
            + "   *\n"
            + "   * **Not `Pending`, for `load`'s reason:** nothing crosses to a launcher. The engine is here.\n"
            + "   *\n"
            + "   * A host with no engine to ask answers a refusal, as every unsupported capability does. That is not\n"
            + "   * the same as \"these bytes are bad\", so the sentence has to say which — `FAULT_UNSUPPORTED`'s words\n"
            + "   * rather than a bare \"rejected\".\n"
            + "   */\n"
            + "  fn[string(u8[])] validated;\n"
            + "\n"
            + "\n"
            + "  Cli of(\n"
            + "    fn[Pending<i32>()] argCount,\n"
            + "    fn[Pending<u8[]>(i32)] arg,\n"
            + "    fn[Pending<u8[]?>(string)] env,\n"
            + "    fn[Pending<u8[]>()] readStdin,\n"
            + "    fn[bool(u8[])] write,\n"
            + "    fn[bool(u8[])] writeErr,\n"
            + "    fn[Pending<FileResult>(string)] readFile,\n"
            + "    fn[Pending<Change>(string, u8[])] writeFile,\n"
            + "    fn[Pending<Stat>(string)] stat,\n"
            + "    fn[Pending<Stat>(string)] linkStat,\n"
            + "    fn[Pending<string[]?>(string)] readDir,\n"
            + "    fn[Pending<Change>(string, bool)] mkdir,\n"
            + "    fn[Pending<Change>(string, bool)] remove,\n"
            + "    fn[Pending<Change>(string, string)] rename,\n"
            + "    fn[Pending<Change>(string, bool)] setExecutable,\n"
            + "    fn[Pending<Change>(string)] openInput,\n"
            + "    fn[Read()] readChunk,\n"
            + "    fn[Pending<string>()] outputError,\n"
            + "    fn[Pending<Change>(string)] openOutput,\n"
            + "    fn[Pending<Socket>(string, i32)] connect,\n"
            + "    fn[Pending<Socket>(string, i32)] listen,\n"
            + "    fn[Pending<Socket>(i32)] accept,\n"
            + "    fn[Pending<Read>(i32)] recv,\n"
            + "    fn[Pending<bool>(i32, u8[])] send,\n"
            + "    fn[void(i32)] closeSocket,\n"
            + "    fn[void(i32)] closeSend,\n"
            + "    fn[Pending<Socket>(string, i32)] bindDatagram,\n"
            + "    fn[Pending<Datagram>(i32)] receiveFrom,\n"
            + "    fn[Pending<bool>(i32, string, i32, u8[])] sendTo,\n"
            + "    fn[Pending<Child>(u8[], u8[][], i32, string, bool, bool)] spawn,\n"
            + "    fn[Pending<Child>(u8[][], i32, string, bool, bool)] spawnSelf,\n"
            + "    fn[void(i32)] closeFeed,\n"
            + "    fn[Pending<i32>(i32)] exitCode,\n"
            + "    fn[Pending<string>()] cwd,\n"
            + "    fn[Pending<bool>(string[], u8[], string, bool)] pushChild,\n"
            + "    fn[Pending<Captured>()] popChild,\n"
            + "    fn[Pending<Exec>(string, string[], u8[], string[], bool, bool)] execWith,\n"
            + "    fn[LoadedModule(u8[], i32)] load,\n"
            + "    fn[CallResult(i32, string, i32)] call,\n"
            + "    fn[void(i32)] unload,\n"
            + "    fn[string(u8[])] validated\n"
            + "  ) {\n"
            + "    return Cli(\n"
            + "      argCount, arg, env, readStdin, write, writeErr, readFile, writeFile, stat, linkStat, readDir,\n"
            + "      mkdir, remove, rename, setExecutable, openInput, readChunk, outputError, openOutput,\n"
            + "      connect, listen, accept, recv, send, closeSocket, closeSend, bindDatagram, receiveFrom, sendTo,\n";
    s = s + "      spawn, spawnSelf, closeFeed, exitCode, cwd,\n"
            + "      pushChild, popChild, execWith,\n"
            + "      load, call, unload, validated\n"
            + "    );\n"
            + "  }\n"
            + "}\n";
    return s;
  }
  return "";
}

/** Every `std` specifier, so a caller can reserve them without guessing the list. */
export string[] stdFiles() {
  return string[]("std/platform.wac");
}

/**
 * **Named, not fetched.** This asked `coreFile(spec) != "" || stdFile(spec) != ""`, and those *build*
 * the file's whole source by concatenating hundreds of literals — so a membership test reconstructed up
 * to 107 KB of `std/platform.wac` and threw it away. `resolveFromAt` calls this once per import
 * specifier, and this repository has 603 imports of that one file: measured at **4.7s of a 21.1s
 * whole-corpus check**, by doubling the resolve loop and subtracting.
 *
 * The comparisons below are generated from the same two lists that generate `coreFile` and
 * `stdFile`, so they cannot fall out of step with what those answer for — which is the whole reason
 * this file is generated.
 */
export bool isBuiltinSpec(string spec) {
  if (spec == "core" || spec == "std") { return true; }
  return spec == "core/option.wac"
      || spec == "core/result.wac"
      || spec == "core/hash.wac"
      || spec == "core/map.wac"
      || spec == "core/vec.wac"
      || spec == "std/platform.wac";
}

/** Every sibling's specifier, so a caller can reserve them without guessing the list. */
export string[] coreFiles() {
  return string[]("core/option.wac", "core/result.wac", "core/hash.wac", "core/map.wac", "core/vec.wac");
}
