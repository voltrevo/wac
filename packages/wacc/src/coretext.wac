          + "   * lands as those characters. `render` is the one that parses, and the difference is where\n"
          + "   * every injection bug in a page like this would come from.\n"
          + "   */\n"
          + "  fn<Pending<bool>(string, string)> setText;\n"
          + "  /** Set an input's value, by id. */\n"
          + "  fn<Pending<bool>(string, string)> setValue;\n"
          + "  /**\n"
          + "   * Replace an element's inline style, by id.\n"
