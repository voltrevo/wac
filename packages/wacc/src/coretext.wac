    "    return true;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Remove `k`. True if it was there.\n",
    "   *\n",
    "   * Backward-shift deletion: an entry after the hole is moved into it if the hole is at\n",
    "   * least as close to where that entry wants to be. That keeps every probe sequence\n",
    "   * contiguous without tombstones, which is what stops a table that is filled and emptied\n",
    "   * repeatedly from filling with dead slots.\n",
    "   */\n",
    "  bool remove(this, K k) {\n",
    "    i32 mask = this.slots.len() - 1;\n",
    "    i32 hole = this.slotFor(k);\n",
    "    if (this.slots[hole] is null) { return false; }\n",
    "    this.slots[hole] = null;\n",
    "    this.n--;\n",
    "\n",
    "    i32 j = hole;\n",
    "    while (true) {\n",
    "      j = (j + 1) & mask;\n",
    "      MapEntry<K, V>? e = this.slots[j];\n",
    "      if (e is null) { return true; }\n",
    "      i32 ideal = this.hash(e!.key) & mask;\n",
    "      // Move it back only if the hole is on or after its ideal slot, cyclically — which is\n",
    "      // exactly \"the hole is not inside the run this entry has already probed past\".\n",
    "      if (!this.cyclicBetween(ideal, hole, j)) {\n",
    "        this.slots[hole] = e;\n",
    "        this.slots[j] = null;\n",
    "        hole = j;\n",
    "      }\n",
    "    }\n",
    "    return true;\n",
    "  }\n",
    "\n",
    "  /** Is `x` in the cyclic interval (a, b]? Used only by `remove`. */\n",
    "  bool cyclicBetween(const this, i32 x, i32 a, i32 b) {\n",
    "    if (a < b) { return x > a && x <= b; }\n",
    "    return x > a || x <= b;\n",
    "  }\n",
    "\n",
    "  void clear(this) {\n",
    "    for (i32 i = 0; i < this.slots.len(); i++) { this.slots[i] = null; }\n",
    "    this.n = 0;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Every key, in slot order — which is to say an order the caller must not rely on. It\n",
    "   * depends on the hash, the capacity, and the insertion history.\n",
    "   */\n",
    "  K[] keys(const this) {\n",
    "    K[] out = K[]();\n",
    "    i32 seen = 0;\n",
    "    for (i32 i = 0; i < this.slots.len(); i++) {\n",
    "      MapEntry<K, V>? e = this.slots[i];\n",
    "      if (e is null) { continue; }\n",
    "      // The first live entry supplies the fill value, which is why the array is not\n",
    "      // allocated before the loop: there is nothing to fill it with until one is found.\n",
    "      if (seen == 0) { out = K[].filled(this.n, e!.key); }\n",
    "      out[seen] = e!.key;\n",
    "      seen++;\n",
    "    }\n",
    "    return out;\n",
    "  }\n",
    "\n",
    "  /** Every value, in the same order as `keys()`. */\n",
    "  V[] values(const this) {\n",
    "    V[] out = V[]();\n",
    "    i32 seen = 0;\n",
    "    for (i32 i = 0; i < this.slots.len(); i++) {\n",
    "      MapEntry<K, V>? e = this.slots[i];\n",
    "      if (e is null) { continue; }\n",
    "      if (seen == 0) { out = V[].filled(this.n, e!.val); }\n",
    "      out[seen] = e!.val;\n",
    "      seen++;\n",
    "    }\n",
    "    return out;\n",
    "  }\n",
    "\n",
    "  /** Double the table and reinsert. Private in spirit; wac has no way to say so. */\n",
    "  void grow(this) {\n",
    "    MapEntry<K, V>?[] old = this.slots;\n",
    "    this.slots = MapEntry<K, V>?[].defaulted(old.len() * 2);\n",
    "    this.n = 0;\n",
    "    for (i32 i = 0; i < old.len(); i++) {\n",
    "      MapEntry<K, V>? e = old[i];\n",
    "      if (e is null) { continue; }\n",
    "      // Through `set` rather than a raw store, so the probe sequence is built by the same\n",
    "      // code that reads it. `set` cannot recurse into `grow` here: the table just doubled.\n",
    "      this.set(e!.key, e!.val);\n",
    "    }\n",
    "  }\n",
    "}\n",
    "\n",
    "// Vec<T> — a growable array.\n",
    "//\n",
    "// The container this repo wrote by hand three times before generics existed: `Buf` over\n",
    "// `u8`, `JsonArray.items` over `JsonValue?`, `JsonObject.members` over `JsonMember?`.\n",
    "// `Buf` stays as it is — it is a byte buffer with `pushU16`/`pushU32` and a measured\n",
    "// reason for `len` to be a field rather than a method — but nothing else needs writing\n",
    "// again.\n",
    "//\n",
    "// Capacity doubles, so n pushes cost O(n) amortised.\n",
    "//\n",
    "// One shape note that is wac rather than taste: growing an array needs a value to fill it\n",
    "// with, because `T[].defaulted(n)` requires T to have a default and a struct or enum has none. The\n",
    "// value being pushed is always available at exactly the moment growth is needed, so `push`\n",
    "// fills with it. That is why there is no `reserve()` without an element, and why `withCapacity`\n",
    "// is a hint for now.\n",
    "\n",
    "\n",
    "export struct Vec<T> {\n",
    "  T[] data;\n",
    "  // A default, so `Vec<i32> v;` is an empty Vec (spec ch38 `§wac-vec-create-8zprdms`) — the\n",
    "  // array beside it defaults to empty already.\n",
    "  i32 n = 0;\n",
    "  /**\n",
    "   * The room `withCapacity` asked for, taken when the first push allocates — an array is filled when\n",
    "   * it is made, and there is no element to fill it with until then.\n",
    "   */\n",
    "  i32 wanted = 0;\n",
    "\n",
    "  /** An empty Vec. Zero capacity, so the first push allocates. */\n",
    "  Vec<T> create() {\n",
    "    // The array *literal* form with no elements, not `T[]()`: a sized array needs a default\n",
    "    // value for T and an enum or a struct has none, whereas a literal with no elements needs\n",
    "    // nothing. That is what makes an empty `Vec<Result<i32, E>>` possible at all.\n",
    "    return Vec(T[](), 0, 0);\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * An empty Vec meant to hold about `capacity` elements (spec ch38).\n",
    "   *\n",
    "   * The slots past the length are never read before they are written, so nothing observable has to\n",
    "   * be put there — but a WasmGC array is filled when it is made, and wac will not invent a value for a\n",
    "   * `T` it knows nothing about. So the room is remembered and allocated by the first push, which has\n",
    "   * the element to fill it with; `capacity()` reports it from the start.\n",
    "   */\n",
    "  Vec<T> withCapacity(i32 capacity) {\n",
    "    if (capacity < 0) { trap; }\n",
    "    return Vec(T[](), 0, capacity);\n",
    "  }\n",
    "\n",
    "  /** A Vec over an existing array, taking ownership of it — no copy. */\n",
    "  Vec<T> fromArray(T[] xs) {\n",
    "    return Vec(xs, xs.len(), 0);\n",
    "  }\n",
    "\n",
    "  i32 len(const this) { return this.n; }\n",
    "\n",
    "  bool isEmpty(const this) { return this.n == 0; }\n",
    "\n",
    "  /** Allocated room, which is only interesting when measuring growth. */\n",
    "  i32 capacity(const this) { return this.data.len() > this.wanted ? this.data.len() : this.wanted; }\n",
    "\n",
    "  /** Element `i`. Traps outside `0 <= i < len()`, as an array index does. */\n",
    "  T get(const this, i32 i) {\n",
    "    if (i < 0 || i >= this.n) { trap; }\n",
    "    return this.data[i];\n",
    "  }\n",
    "\n",
    "  /** Element `i`, or `null` rather than a trap (spec ch38 `§wac-vec-at-3dehker`). */\n",
    "  T? at(const this, i32 i) {\n",
    "    if (i < 0 || i >= this.n) { return null; }\n",
    "    return this.data[i];\n",
    "  }\n",
    "\n",
    "  void set(this, i32 i, T v) {\n",
    "    if (i < 0 || i >= this.n) { trap; }\n",
    "    this.data[i] = v;\n",
    "  }\n",
    "\n",
    "  void push(this, T v) {\n",
    "    if (this.n == this.data.len()) {\n",
    "      // Doubling zero is zero, so the floor matters: `create()` starts at zero capacity and\n",
    "      // without it the store below would go out of bounds. Buf learned the same thing.\n",
    "      i32 grown = this.data.len() == 0 ? (this.wanted > 4 ? this.wanted : 4) : this.data.len() * 2;\n",
    "      T[] next = T[].filled(grown, v);\n",
    "      for (i32 i = 0; i < this.n; i++) { next[i] = this.data[i]; }\n",
    "      this.data = next;\n",
    "    }\n",
    "    this.data[this.n] = v;\n",
    "    this.n++;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * The last element, removed, or `null` when there is none (spec ch38 `§wac-vec-pop-yszir66`).\n",
    "   * At `T = U?` that is a `U??`, so an empty `Vec` and a popped `null` stay apart.\n",
    "   */\n",
    "  T? pop(this) {\n",
    "    if (this.n == 0) { return null; }\n",
    "    this.n--;\n",
    "    // The slot keeps its reference: there is no value to overwrite it with, so a popped\n",
    "    // element stays reachable from the backing array until something else is pushed over\n",
    "    // it. It matters only if T is large and the Vec is long-lived.\n",
    "    return this.data[this.n];\n",
    "  }\n",
    "\n",
    "  T? last(const this) {\n",
    "    if (this.n == 0) { return null; }\n",
    "    return this.data[this.n - 1];\n",
    "  }\n",
    "\n",
    "  T? first(const this) {\n",
    "    if (this.n == 0) { return null; }\n",
    "    return this.data[0];\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Remove element `i`, shifting everything after it down. O(n).\n",
    "   *\n",
    "   * `swapRemove` is the O(1) alternative when order does not matter.\n",
    "   */\n",
    "  T remove(this, i32 i) {\n",
    "    if (i < 0 || i >= this.n) { trap; }\n",
    "    T out = this.data[i];\n",
    "    for (i32 j = i; j < this.n - 1; j++) { this.data[j] = this.data[j + 1]; }\n",
    "    this.n--;\n",
    "    return out;\n",
    "  }\n",
    "\n",
    "  /** Remove element `i` by moving the last element into its place. O(1), reorders. */\n",
    "  T swapRemove(this, i32 i) {\n",
    "    if (i < 0 || i >= this.n) { trap; }\n",
    "    T out = this.data[i];\n",
    "    this.data[i] = this.data[this.n - 1];\n",
    "    this.n--;\n",
    "    return out;\n",
    "  }\n",
    "\n",
    "  /** Insert `v` at `i`, shifting everything from `i` up. `i == len()` appends. */\n",
    "  void insert(this, i32 i, T v) {\n",
    "    if (i < 0 || i > this.n) { trap; }\n",
    "    this.push(v);                       // grows if needed, and puts v at the end\n",
    "    for (i32 j = this.n - 1; j > i; j--) { this.data[j] = this.data[j - 1]; }\n",
    "    this.data[i] = v;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Forget every element.\n",
    "   *\n",
    "   * Keeps the capacity, and keeps the elements reachable from the backing array for the\n",
    "   * same reason `pop` does.\n",
    "   */\n",
    "  void clear(this) { this.n = 0; }\n",
    "\n",
    "  /** Everything, as an array of exactly `len()` — a copy, so the Vec may still be used. */\n",
    "  T[] toArray(const this) {\n",
    "    if (this.n == 0) { return T[](); }\n",
    "    T[] out = T[].filled(this.n, this.data[0]);\n",
    "    for (i32 i = 0; i < this.n; i++) { out[i] = this.data[i]; }\n",
    "    return out;\n",
    "  }\n",
    "\n",
    "  /** Append every element of `other`, which is left alone. */\n",
    "  /**\n",
    "   * Append everything in `other`.\n",
    "   *\n",
    "   * The length is read **once**, before anything is appended, because `other` may be `this`:\n",
    "   * `v.extend(v)` re-read `other.n` every iteration, so the bound grew as fast as the index and it\n",
    "   * ran until `requested new array is too large`. Self-append is a reasonable thing to write — it\n",
    "   * doubles a buffer — and it should double it.\n",
    "   *\n",
    "   * `data` is re-read through `other` each time on purpose: `push` may reallocate, and when `other`\n",
    "   * is `this` the old array is the stale one.\n",
    "   */\n",
    "  void extend(this, const Vec<T> other) {\n",
    "    i32 upTo = other.n;\n",
    "    for (i32 i = 0; i < upTo; i++) { this.push(other.data[i]); }\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * A left fold — `v.fold(0, (i32 acc, i32 x) => acc + x)`.\n",
    "   *\n",
    "   * **`U` is the method's own type parameter**, and this is the first thing in the repository to\n",
    "   * have one. It is the accumulator's type and need not be `T`: summing a `Vec<i32>` into an `i64`,\n",
    "   * or joining one into a `string`, is what makes the letter worth having rather than a method fixed\n",
    "   * to the element type.\n",
    "   *\n",
    "   * `design/lang/0010` is the document about exactly this method, and `core/vec.wac` having no\n",
    "   * `fold`, `map` or `filter` was that document's own evidence that the feature was missing: a\n",
    "   * lambda states no return type — it takes one from the slot it is written into — so the callback's\n",
    "   * `U` had nowhere to come from and the method was declarable and uncallable.\n",
    "   *\n",
    "   * Usually nothing is written, because the **seed** says what `U` is. Where it cannot, the call\n",
    "   * says so: `v.fold<i64>(0 as i64, (i64 a, i32 x) => a + (x as i64))`, since `0` alone would make\n",
    "   * the accumulator an `i32`.\n",
    "   *\n",
    "   * Left, and by index, so the order is the vector's and a caller may rely on it.\n",
    "   */\n",
    "  U fold<U>(const this, U seed, fn<U(U, T)> f) {\n",
    "    U acc = seed;\n",
    "    for (i32 i = 0; i < this.n; i++) { acc = f(acc, this.data[i]); }\n",
    "    return acc;\n",
    "  }\n",
    "\n",
    "}\n",
    "\n",
    "// Buf — a growable byte buffer. spec ch42.\n",
    "//\n",
    "// In core because the language's own text needs one — interpolation and every `toString` build a\n",
    "// string a piece at a time — and because `gzip`, `json` and a hundred-odd files besides had all\n",
    "// imported the same one from `packages/bytes`.\n",
    "//\n",
    "// Why it is not `Vec<u8>`: `len` is a public field read once per pushed byte in gzip's inner loops,\n",
    "// and `reserve()` checks for exactly one byte to keep `push` to a single comparison. A generic\n",
    "// container cannot offer either without giving every element type the same shape.\n",
    "//\n",
    "// Capacity doubles, so appending n bytes is amortised O(n).\n",
    "//\n",
    "// Shape notes, because they are load-bearing rather than stylistic:\n",
    "//\n",
    "//   `len` is a public field, not a method. It is read once per pushed byte in\n",
    "//   gzip's inner loops, and a method call there is measurable.\n",
    "//\n",
    "//   `reserve()` takes no argument and only checks for one byte. That keeps the\n",
    "//   common `push` path to a single comparison. Bulk appends use `reserveFor(n)`\n",
    "//   so they grow once instead of doubling repeatedly.\n",
    "\n",
    "export struct Buf {\n",
    "  u8[] data;\n",
    "  i32 len;\n",
    "\n",
    "  Buf create() {\n",
    "    return Buf(u8[].filled(16, 0), 0);\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * A buffer pre-sized to `capacity`.\n",
    "   *\n",
    "   * Worth it when the final length is known up front — inflate reads it from the\n",
    "   * gzip trailer — because it skips the doubling reallocations *and* lets `take`\n",
    "   * hand back the array without a copy.\n",
    "   */\n",
    "  Buf withCapacity(i32 capacity) {\n",
    "    if (capacity < 16) { capacity = 16; }\n",
    "    return Buf(u8[].filled(capacity, 0), 0);\n",
    "  }\n",
    "\n",
    "  /** Byte `i`, trapping outside `0 … len - 1` (`§wac-buf-push-pw83mxx`). */\n",
    "  u8 get(const this, i32 i) {\n",
    "    if (i < 0 || i >= this.len) { trap; }\n",
    "    return this.data[i];\n",
    "  }\n",
    "\n",
    "  // Make room for at least one more byte.\n",
    "  void reserve(this) {\n",
    "    if (this.len < this.data.len()) { return; }\n",
    "    // Doubling zero is zero, so the floor is load-bearing rather than defensive:\n",
    "    // without it an empty buffer grows to nothing and the store below goes out of\n",
    "    // bounds. Unreachable while every constructor started at 16, and reachable as\n",
    "    // soon as `take` began leaving the buffer empty.\n",
    "    i32 cap = this.data.len() * 2;\n",
    "    if (cap < 16) { cap = 16; }\n",
    "    u8[] next = u8[].filled(cap, 0);\n",
    "    next.copyFrom(this.data, 0, 0, this.len);\n",
    "    this.data = next;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Make room for at least `extra` more bytes, growing once.\n",
    "   *\n",
    "   * Repeated `push` would reach the same capacity through a series of doublings,\n",
    "   * each copying everything written so far.\n",
    "   */\n",
    "  /**\n",
    "   * Make room for `extra` more bytes.\n",
    "   *\n",
    "   * **The arithmetic is i64.** In i32 both halves wrapped: `this.len + extra` past the ceiling went\n",
    "   * negative, `need <= data.len()` was then true and the buffer silently did not grow; and once the\n",
    "   * doubling passed the ceiling `cap` went negative too, so `while (cap < need)` doubled a negative\n",
    "   * number for ever. A hang and a silent under-allocation from the same two lines.\n",
    "   *\n",
    "   * A `need` beyond what an array can hold is impossible rather than merely large — an array's\n",
    "   * length is an i32 — so the request is made at that ceiling and the allocation refuses it. That\n",
    "   * is the honest end of the path: better a trap saying the array is too large than a buffer that\n",
    "   * quietly did not grow.\n",
    "   */\n",
    "  void reserveFor(this, i32 extra) {\n",
    "    i64 need = (this.len as i64) + (extra as i64);\n",
    "    if (need <= (this.data.len() as i64)) { return; }\n",
    "    i64 cap = (this.data.len() as i64) * 2;\n",
    "    if (cap < 16) { cap = 16; }\n",
    "    while (cap < need) { cap = cap * 2; }\n",
    "    if (cap > 2147483647) { cap = 2147483647; }\n",
    "    u8[] next = u8[].filled(cap as! i32, 0);\n",
    "    next.copyFrom(this.data, 0, 0, this.len);\n",
    "    this.data = next;\n",
    "  }\n",
    "\n",
    "  /** One byte. A byte is a `u8`: a wider value says which of its bits it means. */\n",
    "  void push(this, u8 v) {\n",
    "    this.reserve();\n",
    "    this.data[this.len] = v;\n",
    "    this.len++;\n",
    "  }\n",
    "\n",
    "  /** A string's UTF-8 bytes (`§wac-buf-push-pw83mxx`). */\n",
    "  void pushStr(this, string s) {\n",
    "    this.pushAll(s.toBytes());\n",
    "  }\n",
    "\n",
    "  // gzip and DEFLATE are little-endian throughout.\n",
    "  // Unsigned, because a header field is a bit pattern rather than a magnitude.\n",
    "  // `>>` is the logical shift on an unsigned type, so no `>>>` is needed.\n",
    "  void pushU16(this, u32 v) {\n",
    "    this.push(v as@ u8);\n",
    "    this.push((v >> 8) as@ u8);\n",
    "  }\n",
    "\n",
    "  void pushU32(this, u32 v) {\n",
    "    this.push(v as@ u8);\n",
    "    this.push((v >> 8) as@ u8);\n",
    "    this.push((v >> 16) as@ u8);\n",
    "    this.push((v >> 24) as@ u8);\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * `v` in decimal ASCII, sign and all.\n",
    "   *\n",
    "   * Here rather than in each caller because it was written twice, byte for byte, in\n",
    "   * `packages/http`'s `outgoing.wac` and `response.wac` — a `Content-Length` and a status code are\n",
    "   * the same problem, and two copies of a loop are two places for it to drift.\n",
    "   *\n",
    "   * **The sign is handled through i64.** `-v` on `i32.MIN` is `i32.MIN` again, so negating first\n",
    "   * writes the wrong number for exactly one input and nothing else — the same wrap that\n",
    "   * `packages/bignum`'s `shl` guards against, GitHub wac-mono#4. Widening before negating has no\n",
    "   * such value.\n",
    "   */\n",
    "  void pushDecimal(this, i32 v) {\n",
    "    if (v == 0) { this.push('0'); return; }\n",
    "    i64 x = v as i64;\n",
    "    if (x < 0) { this.push('-'); x = 0 - x; }\n",
    "    u8[] tmp = u8[].filled(12, 0);\n",
    "    i32 n = 0;\n",
    "    while (x > 0) { tmp[n] = (48 + ((x % 10) as! i32)) as@ u8; x = x / 10; n++; }\n",
    "    for (i32 i = n - 1; i >= 0; i--) { this.push(tmp[i]); }\n",
    "  }\n",
    "\n",
    "  // `start`, not `from` — `from` is a keyword (import ... from \"...\").\n",
    "  void pushBytes(this, const u8[] src, i32 start, i32 count) {\n",
    "    this.reserveFor(count);\n",
    "    this.data.copyFrom(src, start, this.len, count);\n",
    "    this.len += count;\n",
    "  }\n",
    "\n",
    "  /** The whole of `src`. */\n",
    "  void pushAll(this, const u8[] src) {\n",
    "    this.pushBytes(src, 0, src.len());\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Append a Unicode scalar as UTF-8.\n",
    "   *\n",
    "   * Callers must have resolved surrogate pairs already — a lone surrogate has no\n",
    "   * UTF-8 form. Kept here rather than in `json` because the encoding is a\n",
    "   * property of UTF-8, not of JSON.\n",
    "   */\n",
    "  /**\n",
    "   * Append one code point as UTF-8.\n",
    "   *\n",
    "   * **Anything that is not a Unicode scalar becomes U+FFFD**: negative, above U+10FFFF, or in the\n",
    "   * surrogate range D800..DFFF, which UTF-8 cannot encode at all. It used to encode them anyway —\n",
    "   * `0x110000` produced a five-byte-shaped sequence and a surrogate produced the CESU-8 form that\n",
    "   * strict decoders reject — so a `Buf` could end up holding bytes that are not text. Replacing is\n",
    "   * what encoders conventionally do, and it keeps this method's promise that what it appends is\n",
    "   * valid UTF-8; a caller that wants to know can check the value first.\n",
    "   */\n",
    "  void pushCodepoint(this, i32 cp0) {\n",
    "    i32 cp = (cp0 < 0 || cp0 > 0x10FFFF || (cp0 >= 0xD800 && cp0 <= 0xDFFF)) ? 0xFFFD : cp0;\n",
    "    if (cp < 0x80) {\n",
    "      this.push(cp as@ u8);\n",
    "    } else if (cp < 0x800) {\n",
    "      this.push((0xC0 | (cp >> 6)) as@ u8);\n",
    "      this.push((0x80 | (cp & 0x3F)) as@ u8);\n",
    "    } else if (cp < 0x10000) {\n",
    "      this.push((0xE0 | (cp >> 12)) as@ u8);\n",
    "      this.push((0x80 | ((cp >> 6) & 0x3F)) as@ u8);\n",
    "      this.push((0x80 | (cp & 0x3F)) as@ u8);\n",
    "    } else {\n",
    "      this.push((0xF0 | (cp >> 18)) as@ u8);\n",
    "      this.push((0x80 | ((cp >> 12) & 0x3F)) as@ u8);\n",
    "      this.push((0x80 | ((cp >> 6) & 0x3F)) as@ u8);\n",
    "      this.push((0x80 | (cp & 0x3F)) as@ u8);\n",
    "    }\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Hand over the contents, avoiding the copy when the buffer is exactly full.\n",
    "   *\n",
    "   * The returned array is the buffer's own storage in that case, so the Buf must not\n",
    "   * be used afterwards. That is why this is separate from `bytes()`: callers that\n",
    "   * keep appending need the copy.\n",
    "   *\n",
    "   * The buffer is emptied to enforce it. Without that, a caller who kept pushing\n",
    "   * would be writing through a value it had already handed away, and nothing would\n",
    "   * say so — the array it returned would change under its new owner. Reusing a taken\n",
    "   * Buf now traps on the next `get`, and pushes land in fresh storage.\n",
    "   */\n",
    "  u8[] take(this) {\n",
    "    if (this.len == this.data.len()) {\n",
    "      u8[] out = this.data;\n",
    "      this.data = u8[]();\n",
    "      this.len = 0;\n",
    "      return out;\n",
    "    }\n",
    "    // The copy path has to empty the buffer too. It did not, so `take` kept its contents\n",
    "    // whenever the buffer was not exactly full — which is almost always — and the next push\n",
    "    // appended to bytes the caller thought it had handed away. Nothing here notices, because\n",
    "    // every caller in this repo used to take once and drop the Buf; `packages/url` reuses one\n",
    "    // across a parse and got its scheme glued to the front of its path.\n",
    "    u8[] out = this.bytes();\n",
    "    this.data = u8[]();\n",
    "    this.len = 0;\n",
    "    return out;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Copy `count` bytes from position `at` to the end of the buffer.\n",
    "   *\n",
    "   * For a back-reference: LZ77 and its descendants encode a run as a match that overlaps what it\n",
    "   * is writing, so a copy of five bytes from three back is a legitimate way to spell a repeating\n",
    "   * triple. Byte at a time for exactly that reason — a bulk move would read the source before the\n",
    "   * loop had written it.\n",
    "   *\n",
    "   * The point is the call, not the loop: a decoder that writes `push(get(i))` per byte pays two\n",
    "   * calls for every byte of every match, which measured as a third of zstd's decode time here.\n",
    "   */\n",
    "  void pushRepeat(this, i32 at, i32 count) {\n",
    "    // Only the *start* has to be inside what is written. A copy may run past the old end, and\n",
    "    // routinely does — that is what an overlapping match is — because the read index trails the\n",
    "    // write index by a fixed distance and every byte it reads was written earlier in this loop.\n",
    "    // Requiring `at + count` to fit would refuse every run, which is most of what this is for.\n",
    "    if (count < 0 || at < 0) { trap; }\n",
    "    if (count > 0 && at >= this.len) { trap; }\n",
    "    this.reserveFor(count);\n",
    "    i32 to = this.len;\n",
    "\n",
    "    // `copyFrom` moves like `memmove`, which is right for a copy whose ranges do not overlap and\n",
    "    // *wrong* for one whose do: a run wants the bytes this loop is writing, not the ones that\n",
    "    // were there before. So the bulk instruction is used exactly when the source ends before the\n",
    "    // destination begins, and the loop stays for the overlapping case it exists to serve.\n",
    "    if (at + count <= to) {\n",
    "      this.data.copyFrom(this.data, at, to, count);\n",
    "    } else {\n",
    "      u8[] d = this.data;\n",
    "      for (i32 k = 0; k < count; k++) {\n",
    "        d[to + k] = d[at + k];\n",
    "      }\n",
    "    }\n",
    "    this.len = to + count;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Discard the first `n` bytes and shift the rest to the front.\n",
    "   *\n",
    "   * For a sliding window: a decoder that has emitted the front of its output still needs the\n",
    "   * tail addressable for back-references, and needs the buffer to stop growing. Shifts in\n",
    "   * place rather than reallocating, because bounding what is held is the whole point.\n",
    "   *\n",
    "   * Indices move. A caller holding absolute positions has to track how much has been\n",
    "   * dropped — `Window` in `packages/gzip/src/inflate.wac` is the worked example.\n",
    "   */\n",
    "  void dropFront(this, i32 n) {\n",
    "    if (n <= 0) { return; }\n",
    "    if (n >= this.len) { this.len = 0; return; }\n",
    "    // A self-copy towards the front, which `copyFrom` handles: it moves like `memmove`, so the\n",
    "    // source is read before it is overwritten.\n",
    "    i32 keep = this.len - n;\n",
    "    this.data.copyFrom(this.data, n, 0, keep);\n",
    "    this.len = keep;\n",
    "  }\n",
    "\n",
    "  // Exact-length copy — the internal array is over-allocated.\n",
    "  u8[] bytes(const this) {\n",
    "    u8[] out = u8[].filled(this.len, 0);\n",
    "    out.copyFrom(this.data, 0, 0, this.len);\n",
    "    return out;\n",
    "  }\n",
    "\n",
    "  /** The contents as a string, taking them to be UTF-8. */\n",
    "  string toStr(const this) {\n",
    "    return string.fromBytes(this.bytes());\n",
    "  }\n",
    "}\n",
    "\n",
    "// Text — the built-in `toString` conversions. spec ch23 `§wac-tostring-builtin-only-k9w4hcz`.\n",
    "//\n",
    "// `bool`, every integer and every float type convert to text without a method of their own: decimal\n",
    "// digits for an integer, the shortest decimal that reads back as the same float, and `true` or\n",
    "// `false`. Interpolation (`\"\\{n}\"`) and `n.[toString]()` both arrive here; the compiler calls these\n",
    "// by name, which is why they are private — nothing outside core names them, and the core's public\n",
    "// surface is ch37's table.\n",
    "//\n",
    "// The float formatter is Burger & Dybvig's free-format algorithm, the same as `packages/fmt/src/\n",
    "// ftoa.wac`'s, which matches JavaScript's `Number::toString`. Core cannot import a package, so it\n",
    "// carries its own copy, and differs in exactly one place the spec decides: negative zero is \"-0\".\n",
    "// A fix to the digit loop belongs in both copies.\n",
    "\n",
    "\n",
    "\n",
    "/** The conversion interpolation uses: a method named by this turns its type into text (ch23). */\n",
    "export symbol toString;\n",
    "\n",
    "// The markup symbols — `design/lang/0017`. Markup names no tree: a tag's children are its `kids`\n",
    "// parameter's element type, and that type builds text, quoted tags and fragments itself with static\n",
    "// methods named by these. `K.[markup.text](string)`, `K.[markup.element](string tag, string[] names,\n",
    "// string[] values, K[] kids)` and `K.[markup.fragment](K[] kids)`, each answering a `K`.\n",
    "export symbol @\"markup.text\";\n",
    "export symbol @\"markup.element\";\n",
    "export symbol @\"markup.fragment\";\n",
    "// A component tag — one naming a function whose first parameter's type `P` has a static\n",
    "// `[markup.component]` — is not called: it is `P.[markup.component](name, key, draw, snaps, same)`, with\n",
    "// `draw` the function applied to these attributes and `snaps` their `[markup.snapshot]`s, which `same`\n",
    "// compares with another instance's. A value is its own snapshot unless its type says otherwise.\n",
    "export symbol @\"markup.component\";\n",
    "export symbol @\"markup.snapshot\";\n",
    "\n",
    "/** Decimal text of an `i32`, a minus sign if negative — the minimum included. */\n",
    "string coreTextI32(i32 v) { return coreTextI64(v as i64); }\n",
    "\n",
    "/** Decimal text of an `i64`. The minimum is spelled out: negating it gives itself. */\n",
    "string coreTextI64(i64 v) {\n",
    "  if (v == 0) { return \"0\"; }\n",
    "  if (v == -9223372036854775807 - 1) { return \"-9223372036854775808\"; }\n",
    "  bool neg = v < 0;\n",
    "  u64 m = (neg ? 0 - v : v) as@ u64;\n",
    "  string digits = coreTextU64(m);\n",
    "  return neg ? \"-\" + digits : digits;\n",
    "}\n",
    "\n",
    "string coreTextU32(u32 v) { return coreTextU64(v as u64); }\n",
    "\n",
    "string coreTextU64(u64 v) {\n",
    "  if (v == 0) { return \"0\"; }\n",
    "  u8[] tmp = u8[].filled(20, 0);\n",
    "  i32 n = 0;\n",
    "  u64 m = v;\n",
    "  while (m > 0) {\n",
    "    tmp[19 - n] = ('0' + (m % 10) as@ i32) as@ u8;\n",
    "    m = m / 10;\n",
    "    n++;\n",
    "  }\n",
    "  u8[] out = u8[].filled(n, 0);\n",
    "  out.copyFrom(tmp, 20 - n, 0, n);\n",
    "  return string.fromBytes(out);\n",
    "}\n",
    "\n",
    "string coreTextBool(bool b) { return b ? \"true\" : \"false\"; }\n",
    "\n",
    "string coreTextF64(f64 x) {\n",
    "  u64 bits = f64.toBits(x);\n",
    "  bool neg = (bits >> 63) != 0;\n",
    "  i32 be = ((bits >> 52) & 2047) as@ i32;\n",
    "  u64 frac = bits & 4503599627370495;\n",
    "  return floatText(neg, be, frac, 2047, 4503599627370496, 1075);\n",
    "}\n",
    "\n",
    "string coreTextF32(f32 x) {\n",
    "  u32 bits = f32.toBits(x);\n",
    "  bool neg = (bits >> 31) != 0;\n",
    "  i32 be = ((bits >> 23) & 255) as@ i32;\n",
    "  u64 frac = (bits & 8388607) as u64;\n",
    "  return floatText(neg, be, frac, 255, 8388608, 150);\n",
    "}\n",
    "\n",
    "/** A float's text from its fields: the specials, zero with its sign, or the shortest digits. */\n",
    "string floatText(bool neg, i32 be, u64 frac, i32 maxBe, u64 implicitBit, i32 bias) {\n",
    "  if (be == maxBe) {\n",
    "    if (frac != 0) { return \"NaN\"; }\n",
    "    return neg ? \"-Infinity\" : \"Infinity\";\n",
    "  }\n",
    "  if (be == 0 && frac == 0) { return neg ? \"-0\" : \"0\"; }\n",
    "  u8[] digits = u8[].filled(24, 0);\n",
    "  i32[] meta = i32[].filled(2, 0);               // [count, exp10]\n",
    "  shortestDigits(be, frac, implicitBit, bias, digits, meta);\n",
    "  Buf out = Buf.create();\n",
    "  if (neg) { out.push('-'); }\n",
    "  placePoint(out, digits, meta[0], meta[1]);\n",
    "  return out.toStr();\n",
    "}\n",
    "\n",
    "/**\n",
    " * The shortest digit string that identifies this float, into `digits`; `meta` gets the count and\n",
    " * the decimal exponent (the value is 0.digits × 10^exp10). Burger & Dybvig — see the file header.\n",
    " */\n",
    "void shortestDigits(i32 be, u64 frac, u64 implicitBit, i32 bias, u8[] digits, i32[] meta) {\n",
    "  i32 count = 0;\n",
    "  u64 f = frac;\n",
    "  i32 e = 1 - bias;\n",
    "  bool lowerCloser = false;\n",
    "  if (be != 0) {\n",
    "    f = frac + implicitBit;\n",
    "    e = be - bias;\n",
    "    lowerCloser = (frac == 0 && be > 1);\n",
    "  }\n",
    "  bool boundaryOk = (f & 1) == 0;\n",
    "\n",
    "  TextBig r = TextBig.fromU64(f);\n",
    "  TextBig s = TextBig.zero();\n",
    "  TextBig mPlus = TextBig.zero();\n",
    "  TextBig mMinus = TextBig.zero();\n",
    "  if (e >= 0) {\n",
    "    TextBig pow = TextBig.fromU64(1);\n",
    "    pow.shiftLeft(e);\n",
    "    r.shiftLeft(e);\n",
    "    if (lowerCloser) {\n",
    "      r.mulSmall(4);\n",
    "      s.setU64(4);\n",
    "      mPlus.copyFrom(pow);\n",
    "      mPlus.mulSmall(2);\n",
    "      mMinus.copyFrom(pow);\n",
    "    } else {\n",
    "      r.mulSmall(2);\n",
    "      s.setU64(2);\n",
    "      mPlus.copyFrom(pow);\n",
    "      mMinus.copyFrom(pow);\n",
    "    }\n",
    "  } else {\n",
    "    s.setU64(1);\n",
    "    s.shiftLeft(-e);\n",
    "    if (lowerCloser) {\n",
    "      r.mulSmall(4);\n",
    "      s.mulSmall(4);\n",
    "      mPlus.setU64(2);\n",
    "      mMinus.setU64(1);\n",
    "    } else {\n",
    "      r.mulSmall(2);\n",
    "      s.mulSmall(2);\n",
    "      mPlus.setU64(1);\n",
    "      mMinus.setU64(1);\n",
    "    }\n",
    "  }\n",
    "\n",
    "  i32 k = 0;\n",
    "  TextBig scratch = TextBig.zero();\n",
    "  while (true) {\n",
    "    scratch.setSum(r, mPlus);\n",
    "    i32 c = scratch.cmp(s);\n",
    "    if (c > 0 || (boundaryOk && c == 0)) { s.mulSmall(10); k++; } else { break; }\n",
    "  }\n",
    "  while (true) {\n",
    "    scratch.setSum(r, mPlus);\n",
    "    scratch.mulSmall(10);\n",
    "    if (scratch.cmp(s) <= 0) {\n",
    "      r.mulSmall(10);\n",
    "      mPlus.mulSmall(10);\n",
    "      mMinus.mulSmall(10);\n",
    "      k--;\n",
    "    } else {\n",
    "      break;\n",
    "    }\n",
    "  }\n",
    "  i32 exp10 = k;\n",
    "\n",
    "  TextBig twice = TextBig.zero();\n",
    "  while (true) {\n",
    "    r.mulSmall(10);\n",
    "    mPlus.mulSmall(10);\n",
    "    mMinus.mulSmall(10);\n",
    "    i32 digit = 0;\n",
    "    while (r.cmp(s) >= 0) { r.sub(s); digit++; }\n",
    "    i32 cLow = r.cmp(mMinus);\n",
    "    bool low = boundaryOk ? cLow <= 0 : cLow < 0;\n",
    "    scratch.setSum(r, mPlus);\n",
    "    i32 cHigh = scratch.cmp(s);\n",
    "    bool high = boundaryOk ? cHigh >= 0 : cHigh > 0;\n",
    "    if (!low && !high) {\n",
    "      digits[count] = ('0' + digit) as@ u8;\n",
    "      count++;\n",
    "      continue;\n",
    "    }\n",
    "    i32 last = digit;\n",
    "    if (low && high) {\n",
    "      twice.copyFrom(r);\n",
    "      twice.mulSmall(2);\n",
    "      i32 c = twice.cmp(s);\n",
    "      if (c > 0 || (c == 0 && (digit % 2) != 0)) { last = digit + 1; }\n",
    "    } else if (high) {\n",
    "      last = digit + 1;\n",
    "    }\n",
    "    if (last < 10) {\n",
    "      digits[count] = ('0' + last) as@ u8;\n",
    "      count++;\n",
    "      meta[0] = count;\n",
    "      meta[1] = exp10;\n",
    "      return;\n",
    "    }\n",
    "    // A 9 rounding up carries only on the first digit (fmt's ftoa.wac has the proof), so the value\n",
    "    // becomes the next power of ten.\n",
    "    if (count != 0) { trap; }\n",
    "    digits[0] = '1';\n",
    "    meta[0] = 1;\n",
    "    meta[1] = exp10 + 1;\n",
    "    return;\n",
    "  }\n",
    "}\n",
    "\n",
    "/** The digits with the decimal point placed as `Number::toString` places it. */\n",
    "void placePoint(Buf out, u8[] digits, i32 k, i32 n) {\n",
    "  if (k <= n && n <= 21) {\n",
    "    out.pushBytes(digits, 0, k);\n",
    "    for (i32 i = 0; i < n - k; i++) { out.push('0'); }\n",
    "    return;\n",
    "  }\n",
    "  if (0 < n && n <= 21) {\n",
    "    out.pushBytes(digits, 0, n);\n",
    "    out.push('.');\n",
    "    out.pushBytes(digits, n, k - n);\n",
    "    return;\n",
    "  }\n",
    "  if (-6 < n && n <= 0) {\n",
    "    out.push('0');\n",
    "    out.push('.');\n",
    "    for (i32 i = 0; i < -n; i++) { out.push('0'); }\n",
    "    out.pushBytes(digits, 0, k);\n",
    "    return;\n",
    "  }\n",
    "  out.push(digits[0]);\n",
    "  if (k > 1) {\n",
    "    out.push('.');\n",
    "    out.pushBytes(digits, 1, k - 1);\n",
    "  }\n",
    "  out.push('e');\n",
    "  i32 exp = n - 1;\n",
    "  if (exp < 0) { out.push('-'); exp = -exp; } else { out.push('+'); }\n",
    "  out.pushDecimal(exp);\n",
    "}\n",
    "\n",
    "/** A fixed-width unsigned bignum, enough limbs for any float's exact digits (about 2^1030). */\n",
    "struct TextBig {\n",
    "  u32[] limbs;\n",
    "  i32 n;\n",
    "\n",
    "  TextBig zero() { return TextBig(u32[].filled(40, 0), 0); }\n",
    "\n",
    "  TextBig fromU64(u64 v) {\n",
    "    TextBig b = TextBig.zero();\n",
    "    b.setU64(v);\n",
    "    return b;\n",
    "  }\n",
    "\n",
    "  void trim(this) {\n",
    "    while (this.n > 0 && this.limbs[this.n - 1] == 0) { this.n--; }\n",
    "  }\n",
    "\n",
    "  void setU64(this, u64 v) {\n",
    "    for (i32 i = 0; i < this.n; i++) { this.limbs[i] = 0; }\n",
    "    this.limbs[0] = v as@ u32;\n",
    "    this.limbs[1] = (v >> 32) as@ u32;\n",
    "    this.n = 2;\n",
    "    this.trim();\n",
    "  }\n",
    "\n",
    "  void copyFrom(this, TextBig src) {\n",
    "    for (i32 i = src.n; i < this.n; i++) { this.limbs[i] = 0; }\n",
    "    for (i32 i = 0; i < src.n; i++) { this.limbs[i] = src.limbs[i]; }\n",
    "    this.n = src.n;\n",
    "  }\n",
    "\n",
    "  void shiftLeft(this, i32 bits) {\n",
    "    if (this.n == 0 || bits == 0) { return; }\n",
    "    i32 words = bits / 32;\n",
    "    i32 rem = bits % 32;\n",
    "    if (rem == 0) {\n",
    "      for (i32 i = this.n - 1; i >= 0; i--) { this.limbs[i + words] = this.limbs[i]; }\n",
    "      this.n = this.n + words;\n",
    "    } else {\n",
    "      this.limbs[this.n + words] = 0;\n",
    "      for (i32 i = this.n - 1; i >= 0; i--) {\n",
    "        u32 v = this.limbs[i];\n",
    "        this.limbs[i + words + 1] = this.limbs[i + words + 1] | (v >> ((32 - rem) as@ u32));\n",
    "        this.limbs[i + words] = v << (rem as@ u32);\n",
    "      }\n",
    "      this.n = this.n + words + 1;\n",
    "    }\n",
    "    for (i32 i = 0; i < words; i++) { this.limbs[i] = 0; }\n",
    "    this.trim();\n",
    "  }\n",
    "\n",
    "  void mulSmall(this, u32 m) {\n",
    "    if (this.n == 0) { return; }\n",
    "    u64 carry = 0;\n",
    "    for (i32 i = 0; i < this.n; i++) {\n",
    "      u64 t = (this.limbs[i] as u64) * (m as u64) + carry;\n",
    "      this.limbs[i] = t as@ u32;\n",
    "      carry = t >> 32;\n",
    "    }\n",
    "    while (carry != 0) {\n",
    "      this.limbs[this.n] = carry as@ u32;\n",
    "      carry = carry >> 32;\n",
    "      this.n++;\n",
    "    }\n",
    "  }\n",
    "\n",
    "  i32 cmp(const this, TextBig o) {\n",
    "    if (this.n != o.n) { return this.n > o.n ? 1 : -1; }\n",
    "    for (i32 i = this.n - 1; i >= 0; i--) {\n",
    "      if (this.limbs[i] != o.limbs[i]) { return this.limbs[i] > o.limbs[i] ? 1 : -1; }\n",
    "    }\n",
    "    return 0;\n",
    "  }\n",
    "\n",
    "  void sub(this, TextBig o) {\n",
    "    u64 borrow = 0;\n",
    "    for (i32 i = 0; i < this.n; i++) {\n",
    "      u64 a = this.limbs[i] as u64;\n",
    "      u64 b = borrow;\n",
    "      if (i < o.n) { b = b + (o.limbs[i] as u64); }\n",
    "      if (a >= b) {\n",
    "        this.limbs[i] = (a - b) as@ u32;\n",
    "        borrow = 0;\n",
    "      } else {\n",
    "        this.limbs[i] = ((a + 4294967296) - b) as@ u32;\n",
    "        borrow = 1;\n",
    "      }\n",
    "    }\n",
    "    this.trim();\n",
    "  }\n",
    "\n",
    "  void setSum(this, TextBig a, TextBig b) {\n",
    "    i32 m = a.n > b.n ? a.n : b.n;\n",
    "    u64 carry = 0;\n",
    "    for (i32 i = 0; i < m; i++) {\n",
    "      u64 t = carry;\n",
    "      if (i < a.n) { t = t + (a.limbs[i] as u64); }\n",
    "      if (i < b.n) { t = t + (b.limbs[i] as u64); }\n",
    "      this.limbs[i] = t as@ u32;\n",
    "      carry = t >> 32;\n",
    "    }\n",
    "    i32 top = m;\n",
    "    if (carry != 0) {\n",
    "      this.limbs[m] = carry as@ u32;\n",
    "      top = m + 1;\n",
    "    }\n",
    "    for (i32 i = top; i < this.limbs.len(); i++) { this.limbs[i] = 0; }\n",
    "    this.n = top;\n",
    "    this.trim();\n",
    "  }\n",
    "}\n",
    "\n",
    "// The operator symbols — spec ch22. `a + b` on a type that is not built in calls `a.[operators.add](b)`.\n",
    "//\n",
    "// Core exports them as the namespace `operators` (ch37), and declares each member under the name a\n",
    "// namespace member has once lowered: a verbatim name with a dot in it (`src/namespaces.wac` says\n",
    "// why). So `import { operators } from \"core\"`, `import { operators.add } from \"core\"` and\n",
    "// `[operators.add]` all reach the declarations below, and nothing here needs namespace syntax —\n",
    "// which matters, because the compiler carries this text and never lowers it.\n",
    "\n",
    "export symbol @\"operators.add\";\n",
    "export symbol @\"operators.subtract\";\n",
    "export symbol @\"operators.multiply\";\n",
    "export symbol @\"operators.divide\";\n",
    "export symbol @\"operators.remainder\";\n",
    "export symbol @\"operators.negate\";\n",
    "export symbol @\"operators.equal\";\n",
    "export symbol @\"operators.notEqual\";\n",
    "export symbol @\"operators.lessThan\";\n",
    "export symbol @\"operators.lessThanOrEqual\";\n",
    "export symbol @\"operators.greaterThan\";\n",
    "export symbol @\"operators.greaterThanOrEqual\";\n",
    "export symbol @\"operators.not\";\n",
    "export symbol @\"operators.bitwiseNot\";\n",
    "export symbol @\"operators.bitwiseAnd\";\n",
    "export symbol @\"operators.bitwiseOr\";\n",
    "export symbol @\"operators.bitwiseXor\";\n",
    "export symbol @\"operators.shiftLeft\";\n",
    "export symbol @\"operators.shiftRight\";\n",
    "export symbol @\"operators.unsignedShiftRight\";\n",
    "export symbol @\"operators.addAssign\";\n",
    "export symbol @\"operators.subtractAssign\";\n",
    "export symbol @\"operators.multiplyAssign\";\n",
    "export symbol @\"operators.divideAssign\";\n",
    "export symbol @\"operators.remainderAssign\";\n",
    "export symbol @\"operators.bitwiseAndAssign\";\n",
    "export symbol @\"operators.bitwiseOrAssign\";\n",
    "export symbol @\"operators.bitwiseXorAssign\";\n",
    "export symbol @\"operators.shiftLeftAssign\";\n",
    "export symbol @\"operators.shiftRightAssign\";\n",
    "export symbol @\"operators.unsignedShiftRightAssign\";\n",
    "export symbol @\"operators.preIncrement\";\n",
    "export symbol @\"operators.postIncrement\";\n",
    "export symbol @\"operators.preDecrement\";\n",
    "export symbol @\"operators.postDecrement\";\n",
    "\n",
    "// The reverses: `2.0 * v` on a `v` that is not a number calls `v.[operators.multiplyFromLeft](2.0)`.\n",
    "export symbol @\"operators.addFromLeft\";\n",
    "export symbol @\"operators.subtractFromLeft\";\n",
    "export symbol @\"operators.multiplyFromLeft\";\n",
    "export symbol @\"operators.divideFromLeft\";\n",
    "export symbol @\"operators.remainderFromLeft\";\n",
    "export symbol @\"operators.equalFromLeft\";\n",
    "export symbol @\"operators.notEqualFromLeft\";\n",
    "export symbol @\"operators.lessThanFromLeft\";\n",
    "export symbol @\"operators.lessThanOrEqualFromLeft\";\n",
    "export symbol @\"operators.greaterThanFromLeft\";\n",
    "export symbol @\"operators.greaterThanOrEqualFromLeft\";\n",
    "export symbol @\"operators.bitwiseAndFromLeft\";\n",
    "export symbol @\"operators.bitwiseOrFromLeft\";\n",
    "export symbol @\"operators.bitwiseXorFromLeft\";\n",
    "export symbol @\"operators.shiftLeftFromLeft\";\n",
    "export symbol @\"operators.shiftRightFromLeft\";\n",
    "export symbol @\"operators.unsignedShiftRightFromLeft\";\n",
    "\n",
    "// Tickets, and the scheduling they need — spec ch35.\n",
    "//\n",
    "// A `Ticket<T>` is a value that will answer a `T`. An `async` function hands its caller one, and the\n",
    "// lowering of its body is the only other thing that writes these fields: it parks a `Continuation`\n",
    "// on the ticket each time the body suspends, and resolves the ticket when the body returns.\n",
    "//\n",
    "// **Driving is by waiting.** Nothing here runs on its own. A ticket advances when somebody waits on\n",
    "// it — `wait` follows what the ticket's machine is parked on, and steps the machine once that has\n",
    "// settled — or when the continuation handed to the schedule target is called. Both routes reach the\n",
    "// same `call`, and a machine resumes once however many copies of its continuation are lying about:\n",
    "// `call` steps the machine only if that continuation is still the one parked, so a copy a `wait`\n",
    "// already took back does nothing (`§wac-async-once-3jhw8qk`).\n",
    "//\n",
    "// **The schedule target is the compiler's.** `scheduleTarget` and `setScheduleTarget` are bodies the\n",
    "// emitter replaces with a read and a write of one hidden global, because wac has no mutable module\n",
    "// state and the target is scoped dynamically: a `schedule` statement sets it to the end of its block,\n",
    "// and an `async` body restores the one it suspended under each time it resumes. Nothing else may\n",
    "// call them; the names begin `__wac` so no program does by accident.\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "/** What a suspended machine is waiting on — `null` for a bare `await;` — and the call that resumes it. */\n",
    "export struct Continuation {\n",
    "  TicketBase? t;\n",
    "  fn<void()> call;\n",
    "  /**\n",
    "   * Whether this is still the suspension its machine is at. **A `wait` can run a machine itself**, past a\n",
    "   * continuation already handed to a queue, and that one then does nothing when called — so a scheduler\n",
    "   * asking what is left counts only the current ones.\n",
    "   */\n",
    "  fn<bool()> current;\n",
    "}\n",
    "\n",
    "/**\n",
    " * Everything about a ticket that does not depend on what it answers — which is everything a `wait`\n",
    " * or a scheduler needs, so neither has to know `T`.\n",
    " */\n",
    "export struct TicketBase {\n",
    "  bool done = false;\n",
    "  /** The machine's continuation while it is suspended, which a `wait` drives rather than the queue. */\n",
    "  Continuation? parked = null;\n",
    "  /** For a ticket the host answers: block until it has, answering false when it cannot. */\n",
    "  fn<bool()>? drive = null;\n",
    "  /** Set while this ticket's own `advance` is following what it is parked on. */\n",
    "  bool following = false;\n",
    "  /**\n",
    "   * Called once when the ticket settles, in the order added. **A list, not a closure around the one before**:\n",
    "   * a long-lived read raced on every poll gains a watcher each time, and nesting them made settling it a\n",
    "   * recursion as deep as the polls (`ticket_test.wac`).\n",
    "   */\n",
    "  Vec<fn<void()>>? watchers = null;\n",
    "\n",
    "  /**\n",
    "   * **For a ticket the host answers**, the host's id for the work, or -1 for any other ticket. Set beside\n",
    "   * `waitHost` and `release` by whoever made the ticket from the host's answer — std — so core needs no way\n",
    "   * to reach the host of its own: the functions arrive as values (design/system/0013).\n",
    "   */\n",
    "  i32 hostId = -1;\n",
    "  /**\n",
    "   * Block until one of `ids` has an answer, for at most `millis` (-1: as long as it takes), and answer its\n",
    "   * index, -1 when none did. How a `wait` on `Ticket.any` of several host tickets blocks on all of them at\n",
    "   * once rather than on the first.\n",
    "   */\n",
    "  fn<i32(i32[], i32)>? waitHost = null;\n",
    "  /** Tell the host its answer is no longer wanted, releasing what holds it. What `cancel` calls. */\n",
    "  fn<void()>? release = null;\n",
    "  /** For `Ticket.all` and `Ticket.any`, what they wait on — so a `wait` can find the host work beneath. */\n",
    "  TicketBase[]? parts = null;\n",
    "\n",
    "  /**\n",
    "   * Have `f` called when this ticket settles, beside whatever else is watching it. How `Ticket.any`\n",
    "   * knows which of its tickets settled first, which driving them later cannot tell.\n",
    "   */\n",
    "  void whenSettled(this, fn<void()> f) {\n",
    "    if (this.watchers is null) { this.watchers = Vec<fn<void()>>.create(); }\n",
    "    this.watchers!.push(f);\n",
    "  }\n",
    "\n",
    "  bool settled(const this) { return this.done; }\n",
    "\n",
    "  /**\n",
    "   * Whether this ticket has settled, **asking the host without waiting** when the answer is the host's — and\n",
    "   * settling it then, since the answer is in hand. One question per call, for a poll between steps of other\n",
    "   * work; `settled` alone never asks, and racing a zero timer asks three times.\n",
    "   */\n",
    "  bool settledNow(this) {\n",
    "    if (this.done) { return true; }\n",
    "    fn<i32(i32[], i32)>? ask = this.waitHost;\n",
    "    if (ask is null || this.hostId < 0) { return false; }\n",
    "    if (ask!([this.hostId], 0) < 0) { return false; }\n",
    "    // Answered, so driving it does not block.\n",
    "    this.advance();\n",
    "    return this.done;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Stop caring about the answer. **On a ticket the host answers** it releases the host's slot and the\n",
    "   * answer is discarded: the ticket never settles, and a `wait` on it answers `Stuck`. On any other ticket\n",
    "   * it does nothing — wac cannot stop a machine part-way through its body, and a ticket made directly is\n",
    "   * settled by whoever holds it.\n",
    "   */\n",
    "  void cancel(this) {\n",
    "    if (this.done || this.hostId < 0) { return; }\n",
    "    fn<void()>? r = this.release;\n",
    "    this.hostId = -1;\n",
    "    this.waitHost = null;\n",
    "    this.release = null;\n",
    "    this.drive = null;\n",
    "    if (r is not null) { r!(); }\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Advance this ticket — `Ticket.all` or `Ticket.any` of `parts` — as soon as `parts` allow: every one\n",
    "   * of them settled, or with `every` false any one. Not only when something drives it\n",
    "   * (`§wac-ticket-any-v8nr3r9` says it *settles with* the first).\n",
    "   *\n",
    "   * **A scheduler that resumes on settling never drives.** A page resumes a machine when the ticket it\n",
    "   * waits on settles (`whenSettled`), and nothing on a page calls `advance`; driven only, `await\n",
    "   * Ticket.any(click, frame)` there waited for ever. `advance` runs the ticket's own `drive`, which by\n",
    "   * then has nothing left to step: the parts it needs are settled.\n",
    "   */\n",
    "  void settleWhenParts(this, TicketBase[] parts, bool every) {\n",
    "    this.parts = parts;\n",
    "    for (i32 k = 0; k < parts.len(); k++) { this.advanceOnSettle(parts, parts[k], every); }\n",
    "    if (canSettle(parts, every)) { this.advance(); }\n",
    "  }\n",
    "\n",
    "  /** When `t` settles, advance this ticket if `parts` now allow it. */\n",
    "  void advanceOnSettle(this, TicketBase[] parts, TicketBase t, bool every) {\n",
    "    t.whenSettled(() => {\n",
    "      if (!this.done && canSettle(parts, every)) { this.advance(); }\n",
    "    });\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * One step towards settling. False when nothing a `wait` may drive can advance this ticket — it was\n",
    "   * made directly and nobody has resolved it, or what it is parked on is in that state.\n",
    "   *\n",
    "   * **A ticket that depends on itself answers true**, so the `wait` asking loops rather than refusing:\n",
    "   * nothing refused, and the program is running rather than idle (ch35, \"A `wait` that depends on\n",
    "   * itself loops\").\n",
    "   */\n",
    "  bool advance(this) {\n",
    "    if (this.done) { return true; }\n",
    "    if (this.following) { return true; }\n",
    "    Continuation? p = this.parked;\n",
    "    if (p is not null) {\n",
    "      TicketBase? up = p!.t;\n",
    "      if (up is not null && !up!.done) {\n",
    "        this.following = true;\n",
    "        bool moved = up!.advance();\n",
    "        this.following = false;\n",
    "        return moved;\n",
    "      }\n",
    "      p!.call();\n",
    "      return true;\n",
    "    }\n",
    "    fn<bool()>? d = this.drive;\n",
    "    if (d is not null) { return d!(); }\n",
    "    return false;\n",
    "  }\n",
    "}\n",
    "\n",
    "/**\n",
    " * Why a `wait` was refused: nothing it may drive can settle the ticket (`§wac-wait-refuses-jj8u2ie`). A bug in\n",
    " * the program rather than a fault in the world, which is why it is its own type and not one of a capability's.\n",
    " */\n",
    "export struct Stuck {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "\n",
    "/** A value that will answer a `T`. Settled once, by `resolve` or by the body of the `async` call that made it. */\n",
    "export struct Ticket<T> : TicketBase {\n",
    "  /**\n",
    "   * Null until settled, and then a function answering it. A function rather than the value, so `T`\n",
    "   * needs no default and `Ticket<void>` is a ticket like any other: its answer is a function\n",
    "   * answering nothing.\n",
    "   */\n",
    "  fn<T()>? answer = null;\n",
    "\n",
    "  /** Settle this ticket with `v`. Traps if it is already settled: a ticket answers once. */\n",
    "  void resolve(this, T v) { this.settleWith(() => v); }\n",
    "\n",
    "  /** Settle this ticket with what `f` answers — how an `async void` body settles, having no value. */\n",
    "  void settleWith(this, fn<T()> f) {\n",
    "    if (this.done) { trap; }\n",
    "    this.answer = f;\n",
    "    this.done = true;\n",
    "    Vec<fn<void()>>? watching = this.watchers;\n",
    "    if (watching is not null) {\n",
    "      for (i32 i = 0; i < watching!.len(); i++) { watching!.get(i)(); }\n",
    "    }\n",
    "  }\n",
    "\n",
    "  /** The answer. Traps if the ticket has not settled. */\n",
    "  T value(const this) {\n",
    "    if (!this.done) { trap; }\n",
    "    return this.answer!();\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Drive the work this ticket awaited until it answers, without suspending the caller\n",
    "   * (`§wac-async-wait-5tqm2wh`). `Err` when nothing it may drive can advance it\n",
    "   * (`§wac-wait-refuses-jj8u2ie`).\n",
    "   *\n",
    "   * `wait` stops between continuations, never inside one, so everything up to a refusal ran and is\n",
    "   * settled, and `await` on the same ticket afterwards picks up from the link that refused.\n",
    "   */\n",
    "  Result<T, Stuck> wait(this) {\n",
    "    while (!this.done) {\n",
    "      if (!this.advance()) { return Result.Err(Stuck(\"nothing this wait may drive can settle the ticket\")); }\n",
    "    }\n",
    "    return Result.Ok(this.answer!());\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * A ticket of the tuple of what each of `tickets` answers, settled when every one is (spec ch35\n",
    "   * `§wac-ticket-all-2h6iwfr`). It writes no `T`, so it is called on the bare template —\n",
    "   * `Ticket.all(a, b)` — and is one function however `Ticket` is spelled (ch19).\n",
    "   *\n",
    "   * **Driven, not `async`.** The answer is a ticket whose `drive` steps every ticket not yet settled,\n",
    "   * so whoever drives it — a `wait`, or a scheduler asking `advance` — drives them, and a `wait` that\n",
    "   * nothing can help refuses (`§wac-wait-refuses-jj8u2ie`) rather than parking on one of them.\n",
    "   */\n",
    "  Ticket<Values<Ts>> all<Ts>(Ts ...tickets) {\n",
    "    TicketBase[] parts = TicketBase[].defaulted(typeref(Ts).tupleMembers().len());\n",
    "    static_for (i32 i = 0; i < typeref(Ts).tupleMembers().len(); i++) { parts[i] = tickets.[i]; }\n",
    "    Ticket<Values<Ts>> out;\n",
    "    out.drive = () => {\n",
    "      i32 s = stepEvery(parts);\n",
    "      if (s < 0) { return false; }\n",
    "      // A part settling while it was stepped runs its watchers, and one of them is this ticket's own\n",
    "      // `settleWhenParts` — which may already have settled it. It answers once.\n",
    "      if (s == 0 || out.done) { return true; }\n",
    "      Values<Ts> v;\n",
    "      static_for (i32 i = 0; i < typeref(Ts).tupleMembers().len(); i++) { v.[i] = tickets.[i].value(); }\n",
    "      out.resolve(v);\n",
    "      return true;\n",
    "    };\n",
    "    out.settleWhenParts(parts, true);\n",
    "    return out;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * A ticket of what the first of `tickets` to settle answers, as the union of what they answer (spec\n",
    "   * ch35 `§wac-ticket-any-v8nr3r9`): `Ticket.any(a, b)` over two `Ticket<i32>`s answers an `i32`. The\n",
    "   * others are not cancelled. Driven as `all` is.\n",
    "   */\n",
    "  Ticket<AnyValue<Ts>> any<Ts>(Ts ...tickets) {\n",
    "    TicketBase[] parts = TicketBase[].defaulted(typeref(Ts).tupleMembers().len());\n",
    "    static_for (i32 i = 0; i < typeref(Ts).tupleMembers().len(); i++) { parts[i] = tickets.[i]; }\n",
    "    i32[] first = watchFirst(parts);\n",
    "    Ticket<AnyValue<Ts>> out;\n",
    "    out.drive = () => {\n",
    "      i32 k = stepFirst(parts, first);\n",
    "      if (k == -2) { return false; }\n",
    "      if (k == -1 || out.done) { return true; }\n",
    "      static_for (i32 i = 0; i < typeref(Ts).tupleMembers().len(); i++) {\n",
    "        if (i == k) {\n",
    "          AnyValue<Ts> v = tickets.[i].value();\n",
    "          out.resolve(v);\n",
    "        }\n",
    "      }\n",
    "      return true;\n",
    "    };\n",
    "    out.settleWhenParts(parts, false);\n",
    "    return out;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Which of `parts` settles first, by its index — `any` for a set that is only known at run time, as\n",
    "   * `TicketBase`s whose answers the caller reads for itself. A program watching what is still open of\n",
    "   * several streams has a different set each time round, and a tuple cannot say that. Driven as `any`\n",
    "   * is; an empty set never settles.\n",
    "   */\n",
    "  Ticket<i32> first(TicketBase[] parts) {\n",
    "    i32[] firstAt = watchFirst(parts);\n",
    "    Ticket<i32> out;\n",
    "    out.drive = () => {\n",
    "      i32 k = stepFirst(parts, firstAt);\n",
    "      if (k == -2) { return false; }\n",
    "      if (k == -1 || out.done) { return true; }\n",
    "      out.resolve(k);\n",
    "      return true;\n",
    "    };\n",
    "    out.settleWhenParts(parts, false);\n",
    "    return out;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * `any`, with the winner's index beside its value (spec ch35 `§wac-ticket-any-with-index-q2v7hcn`) —\n",
    "   * what says which one won when two of them answer the same type.\n",
    "   */\n",
    "  Ticket<(i32, AnyValue<Ts>)> anyWithIndex<Ts>(Ts ...tickets) {\n",
    "    TicketBase[] parts = TicketBase[].defaulted(typeref(Ts).tupleMembers().len());\n",
    "    static_for (i32 i = 0; i < typeref(Ts).tupleMembers().len(); i++) { parts[i] = tickets.[i]; }\n",
    "    i32[] first = watchFirst(parts);\n",
    "    Ticket<(i32, AnyValue<Ts>)> out;\n",
    "    out.drive = () => {\n",
    "      i32 k = stepFirst(parts, first);\n",
    "      if (k == -2) { return false; }\n",
    "      if (k == -1 || out.done) { return true; }\n",
    "      static_for (i32 i = 0; i < typeref(Ts).tupleMembers().len(); i++) {\n",
    "        if (i == k) {\n",
    "          AnyValue<Ts> v = tickets.[i].value();\n",
    "          out.resolve((k, v));\n",
    "        }\n",
    "      }\n",
    "      return true;\n",
    "    };\n",
    "    out.settleWhenParts(parts, false);\n",
    "    return out;\n",
    "  }\n",
    "}\n",
    "\n",
    "/**\n",
    " * The tuple of what each of a tuple of tickets answers: `Values<(Ticket<A>, Ticket<B>)>` is `(A, B)` —\n",
    " * what `Ticket.all` returns (spec ch30, ch35). Read from each ticket's `value()` through `typeof`, so it\n",
    " * follows the type and not how the type was spelled.\n",
    " */\n",
    "export type Values<Ts> {\n",
    "  typeref[] ts = typeref(Ts).tupleMembers();\n",
    "  typeref[] out = typeref[].filled(ts.len(), typeref(void));\n",
    "  for (i32 i = 0; i < ts.len(); i++) {\n",
    "    out[i] = typeref(typeof(hypothetical<type(ts[i])>().value()));\n",
    "  }\n",
    "  return typeref.tuple(out);\n",
    "}\n",
    "\n",
    "/**\n",
    " * The union of what each of a tuple of tickets answers: `AnyValue<(Ticket<A>, Ticket<B>)>` is\n",
    " * `union<A, B>` — what `Ticket.any` answers (spec ch35), normalised as any union is, so two tickets of\n",
    " * one type answer that type.\n",
    " */\n",
    "export type AnyValue<Ts> {\n",
    "  return typeref.union(typeref(Values<Ts>).tupleMembers());\n",
    "}\n",
    "\n",
    "/** Whether every one of `parts` has settled, or with `every` false any one. */\n",
    "bool canSettle(TicketBase[] parts, bool every) {\n",
    "  for (i32 k = 0; k < parts.len(); k++) {\n",
    "    if (parts[k].done != every) { return !every; }\n",
    "  }\n",
    "  return every;\n",
    "}\n",
    "\n",
    "/**\n",
    " * One step towards every one of `parts` settling: 1 when all have, 0 when one not yet settled moved, -1\n",
    " * when none of them could — which is when a `wait` on `Ticket.all` refuses.\n",
    " */\n",
    "i32 stepEvery(TicketBase[] parts) {\n",
    "  bool moved = false;\n",
    "  bool every = true;\n",
    "  for (i32 k = 0; k < parts.len(); k++) {\n",
    "    if (parts[k].done) { continue; }\n",
    "    if (parts[k].advance()) { moved = true; }\n",
    "    if (!parts[k].done) { every = false; }\n",
    "  }\n",
    "  if (every) { return 1; }\n",
    "  return moved ? 0 : -1;\n",
    "}\n",
    "\n",
    "/**\n",
    " * Which of `parts` settles first, as a cell `Ticket.any` reads: one already settled when it is called —\n",
    " * the first of those in argument order — or else whichever's `whenSettled` fires first. -1 until then.\n",
    " */\n",
    "i32[] watchFirst(TicketBase[] parts) {\n",
    "  i32[] first = [-1];\n",
    "  for (i32 k = 0; k < parts.len(); k++) {\n",
    "    if (parts[k].done && first[0] < 0) { first[0] = k; }\n",
    "  }\n",
    "  for (i32 k = 0; k < parts.len(); k++) { watchOne(parts[k], first, k); }\n",
    "  return first;\n",
    "}\n",
    "\n",
    "/** Record `k` in `first` when `t` settles, unless another settled before it. */\n",
    "void watchOne(TicketBase t, i32[] first, i32 k) {\n",
    "  t.whenSettled(() => {\n",
    "    if (first[0] < 0) { first[0] = k; }\n",
    "  });\n",
    "}\n",
    "\n",
    "/**\n",
    " * The index of the first of `parts` to settle, after driving each one step if none has; -1 when none\n",
    " * has settled but one moved, -2 when none could move.\n",
    " */\n",
    "i32 stepFirst(TicketBase[] parts, i32[] first) {\n",
    "  if (first[0] >= 0) { return first[0]; }\n",
    "  // **Driving a host ticket blocks until the host answers it**, so stepping the parts in turn would sit\n",
    "  // on the first one's host work while the second's had long answered. So step only the parts that can\n",
    "  // move without the host, and when every part left is waiting on host work, ask the host once which of\n",
    "  // all of it answers first.\n",
    "  bool moved = false;\n",
    "  Vec<TicketBase> leaves = Vec<TicketBase>.create();\n",
    "  for (i32 k = 0; k < parts.len(); k++) {\n",
    "    if (parts[k].done) { continue; }\n",
    "    i32 before = leaves.len();\n",
    "    hostLeaves(parts[k], leaves);\n",
    "    if (leaves.len() > before) { continue; }\n",
    "    if (parts[k].advance()) { moved = true; }\n",
    "    if (first[0] >= 0) { return first[0]; }\n",
    "  }\n",
    "  if (moved) { return -1; }\n",
    "  if (leaves.len() == 0) { return -2; }\n",
    "  TicketBase answered = leaves.get(0);\n",
    "  fn<i32(i32[], i32)>? ask = answered.waitHost;\n",
    "  if (leaves.len() > 1 && ask is not null) {\n",
    "    i32[] ids = i32[].filled(leaves.len(), 0);\n",
    "    for (i32 i = 0; i < leaves.len(); i++) { ids[i] = leaves.get(i).hostId; }\n",
    "    i32 w = ask!(ids, -1);\n",
    "    if (w < 0) { return -2; }\n",
    "    answered = leaves.get(w);\n",
    "  }\n",
    "  if (!answered.advance()) { return -2; }\n",
    "  return first[0] >= 0 ? first[0] : -1;\n",
    "}\n",
    "\n",
    "/**\n",
    " * The host tickets `t` is waiting on, added to `out`: `t` itself, what its machine is parked on, or the parts\n",
    " * of a `Ticket.all` or `Ticket.any` — none when `t` can move without the host.\n",
    " */\n",
    "void hostLeaves(TicketBase t, Vec<TicketBase> out) {\n",
    "  // `following` is set on a ticket already being followed — an `advance` further up this chain, or this\n",
    "  // walk itself — which is a ticket that depends on itself: it moves by looping (`advance`), not by the host.\n",
    "  if (t.done || t.following) { return; }\n",
    "  if (t.hostId >= 0) {\n",
    "    out.push(t);\n",
    "    return;\n",
    "  }\n",
    "  t.following = true;\n",
    "  Continuation? p = t.parked;\n",
    "  TicketBase[]? ps = t.parts;\n",
    "  if (p is not null) {\n",
    "    TicketBase? up = p!.t;\n",
    "    if (up is not null) { hostLeaves(up!, out); }\n",
    "  } else if (ps is not null) {\n",
    "    for (i32 k = 0; k < ps!.len(); k++) { hostLeaves(ps![k], out); }\n",
    "  }\n",
    "  t.following = false;\n",
    "}\n",
    "\n",
    "/** First in, first out — what a program's pending continuations are kept in. */\n",
    "export struct Queue<T> {\n",
    "  Vec<T> items;\n",
    "  i32 head = 0;\n",
    "\n",
    "  void push(this, T v) { this.items.push(v); }\n",
    "\n",
    "  /** The oldest item, or `null` when there is none. */\n",
    "  T? pop(this) {\n",
    "    if (this.head >= this.items.len()) { return null; }\n",
    "    T v = this.items.get(this.head);\n",
    "    this.head++;\n",
    "    // Start afresh once everything has been taken, so a queue that is drained now and then does not\n",
    "    // grow forever.\n",
    "    if (this.head == this.items.len()) {\n",
    "      this.items = Vec<T>.create();\n",
    "      this.head = 0;\n",
    "    }\n",
    "    return v;\n",
    "  }\n",
    "\n",
    "  i32 len(const this) { return this.items.len() - this.head; }\n",
    "\n",
    "  bool isEmpty(const this) { return this.len() == 0; }\n",
    "}\n",
    "\n",
    "/**\n",
    " * What one step of a coroutine came to (spec ch36): it is waiting on a ticket, it yielded a\n",
    " * value, or it is done with its result. `W` is `never` for a machine that cannot wait and `Y` for one\n",
    " * that cannot yield.\n",
    " */\n",
    "export enum Step<W, Y, R> {\n",
    "  Waiting(W ticket),\n",
    "  Yielded(Y value),\n",
    "  Done(R result)\n",
    "\n",
    "  /** Whether this step is `Waiting`. For the lowering and the machines below. */\n",
    "  bool __wacIsWaiting(const this) {\n",
    "    return match (this) { Waiting(_): true, default: false };\n",
    "  }\n",
    "\n",
    "  /** The ticket a `Waiting` step waits on. */\n",
    "  W __wacWaitingOn(const this) {\n",
    "    match (this) {\n",
    "      Waiting(w): { return w; }\n",
    "      default: { trap; }\n",
    "    }\n",
    "  }\n",
    "\n",
    "  /** The result of a `Done` step. */\n",
    "  R __wacDoneOf(const this) {\n",
    "    match (this) {\n",
    "      Done(r): { return r; }\n",
    "      default: { trap; }\n",
    "    }\n",
    "  }\n",
    "\n",
    "  /** Whether this step is `Done`. */\n",
    "  bool __wacIsDone(const this) {\n",
    "    return match (this) { Done(_): true, default: false };\n",
    "  }\n",
    "\n",
    "  /** The value of a `Yielded` step. */\n",
    "  Y __wacYieldedOf(const this) {\n",
    "    match (this) {\n",
    "      Yielded(y): { return y; }\n",
    "      default: { trap; }\n",
    "    }\n",
    "  }\n",
    "}\n",
    "\n",
    "/**\n",
    " * The machine under `async` and `gen`: each `step()` runs the body to its next suspension or its end.\n",
    " * `coroutine f(…)` answers one without running anything (`§wac-coroutine-runs-nothing-zumpwje`), and\n",
    " * a step after `Done` answers `Done` again (`§wac-step-finished-noop-2tenu9x`).\n",
    " */\n",
    "export struct Coroutine<W, Y, R> {\n",
    "  fn<Step<W, Y, R>()> resume;\n",
    "  /**\n",
    "   * The schedule target its body runs under: the one in force where it was made, or whatever a\n",
    "   * `schedule` in it set since — restored on every resume, whoever resumes it\n",
    "   * (`§wac-schedule-restored-b9qsydd`).\n",
    "   */\n",
    "  fn<void(Continuation)>? inner;\n",
    "\n",
    "  Step<W, Y, R> step(this) {\n",
    "    fn<void(Continuation)>? outer = __wacScheduleTarget();\n",
    "    __wacSetScheduleTarget(this.inner);\n",
    "    Step<W, Y, R> s = this.resume();\n",
    "    this.inner = __wacScheduleTarget();\n",
    "    __wacSetScheduleTarget(outer);\n",
    "    return s;\n",
    "  }\n",
    "}\n",
    "\n",
    "/** What calling a `gen<Y> R` function answers: a coroutine whose steps never wait. */\n",
    "export struct Generator<Y, R> {\n",
    "  Coroutine<never, Y, R> co;\n",
    "  /** The last step `__wacNext` took, which `__wacCurrent` reads — how `for … in` walks one. */\n",
    "  Step<never, Y, R>? last = null;\n",
    "\n",
    "  Step<never, Y, R> step(this) { return this.co.step(); }\n",
    "\n",
    "  /** Step, and answer whether it yielded. For `for … in`. */\n",
    "  bool __wacNext(this) {\n",
    "    Step<never, Y, R> s = this.co.step();\n",
    "    this.last = s;\n",
    "    return !s.__wacIsDone();\n",
    "  }\n",
    "\n",
    "  /** What the last step yielded. */\n",
    "  Y __wacCurrent(this) { return this.last!.__wacYieldedOf(); }\n",
    "}\n",
    "\n",
    "/** What calling an `async gen<Y> R` function answers: its step is a ticket that does the waiting itself. */\n",
    "export struct AsyncGenerator<Y, R> {\n",
    "  Coroutine<TicketBase, Y, R> co;\n",
    "\n",
    "  async Step<never, Y, R> step(this) {\n",
    "    Step<TicketBase, Y, R> s = this.co.step();\n",
    "    while (s.__wacIsWaiting()) {\n",
    "      await s.__wacWaitingOn();\n",
    "      s = this.co.step();\n",
    "    }\n",
    "    if (s.__wacIsDone()) { return Step.Done(s.__wacDoneOf()); }\n",
    "    return Step.Yielded(s.__wacYieldedOf());\n",
    "  }\n",
    "}\n",
    "\n",
    "/** The ticket a bare `await;` waits on: settled already, and a continuation parks on `null` for it. */\n",
    "struct __wacReadyTicket : TicketBase { }\n",
    "\n",
    "/** What `await t` waits on: `t`, or for a `null` — or a bare `await;` — a ticket already settled. */\n",
    "export TicketBase __wacOrReady(TicketBase? t) {\n",
    "  if (t is not null) { return t!; }\n",
    "  __wacReadyTicket r;\n",
    "  r.done = true;\n",
    "  return r;\n",
    "}\n",
    "\n",
    "/**\n",
    " * The runtime half of a lowered `async` body: its ticket and its coroutine. Nothing but the lowering\n",
    " * names it.\n",
    " *\n",
    " * `run` steps the coroutine — which runs the body under its own schedule target — and hands the\n",
    " * continuation of a suspension to the target in force *outside*, which is where the suspended call\n",
    " * was made (`§wac-schedule-target-fri2qzd`). `Done` settles the ticket.\n",
    " */\n",
    "export struct __wacMachine<R> {\n",
    "  Ticket<R> ticket;\n",
    "  Coroutine<TicketBase, never, R> co;\n",
    "  /** Which suspension is current, so a continuation from an earlier one does nothing when called. */\n",
    "  i32 seq;\n",
    "\n",
    "  /**\n",
    "   * An `async` call: its coroutine run at once to its first suspension, wrapped in a ticket. A static\n",
    "   * rather than a generic function, which another module could not call (`issues/lang/0304c`).\n",
    "   */\n",
    "  Ticket<R> start(Coroutine<TicketBase, never, R> co) {\n",
    "    Ticket<R> t;\n",
    "    __wacMachine<R> m = __wacMachine<R>(t, co, 0);\n",
    "    m.run();\n",
    "    return t;\n",
    "  }\n",
    "\n",
    "  void run(this) {\n",
    "    // The continuation goes to the target in force *here*, where the suspended call was made; the\n",
    "    // coroutine's step runs the body under its own.\n",
    "    fn<void(Continuation)>? outer = __wacScheduleTarget();\n",
    "    Step<TicketBase, never, R> s = this.co.step();\n",
    "    if (!s.__wacIsWaiting()) {\n",
    "      this.ticket.settleWith(() => s.__wacDoneOf());\n",
    "      return;\n",
    "    }\n",
    "    this.park(s.__wacWaitingOn());\n",
    "    Continuation? k = this.ticket.parked;\n",
    "    if (outer is not null && k is not null) { outer!(k!); }\n",
    "  }\n",
    "\n",
    "  /** Park on `on` — a bare `await;`'s ready ticket parks as `null` (ch35). */\n",
    "  void park(this, TicketBase on) {\n",
    "    this.seq++;\n",
    "    __wacResumer<R> r = __wacResumer<R>(this, this.seq);\n",
    "    TicketBase? t = on;\n",
    "    if (on is __wacReadyTicket) { t = null; }\n",
    "    this.ticket.parked = Continuation(t, r.call, r.current);\n",
    "  }\n",
    "}\n",
    "\n",
    "/** One suspension's `call`: resumes the machine if that suspension is still the current one. */\n",
    "struct __wacResumer<R> {\n",
    "  __wacMachine<R> m;\n",
    "  i32 seq;\n",
    "\n",
    "  /** Whether the machine is still parked at this suspension. */\n",
    "  bool current(const this) { return this.m.seq == this.seq && this.m.ticket.parked is not null; }\n",
    "\n",
    "  void call(this) {\n",
    "    if (this.m.seq != this.seq) { return; }\n",
    "    Continuation? k = this.m.ticket.parked;\n",
    "    if (k is null) { return; }\n",
    "    TicketBase? on = k!.t;\n",
    "    // `§wac-continuation-early-trap-rg9d475`: the ticket it waits on has to have settled.\n",
    "    if (on is not null && !on!.done) { trap; }\n",
    "    this.m.ticket.parked = null;\n",
    "    this.m.run();\n",
    "  }\n",
    "}\n",
    "\n",
    "/** The schedule target in force. The emitter replaces this body with a read of its hidden global. */\n",
    "export fn<void(Continuation)>? __wacScheduleTarget() { return null; }\n",
    "\n",
    "/** Make `f` the schedule target. The emitter replaces this body with a write of its hidden global. */\n",
    "export void __wacSetScheduleTarget(fn<void(Continuation)>? f) { }\n",
    "\n",
    "// Numbers as they are written, and the symbol that turns one into a value of a type — spec ch09.\n",
    "//\n",
    "// A numeric literal has no type of its own: its context gives it one. When that type is a program's own,\n",
    "// the type says how through `[fromNumber]`, a method without a receiver that takes the literal's exact\n",
    "// written value and answers a `Result`. The compiler calls it statically, once per literal, and the\n",
    "// `Ok` value is the literal's value (`§wac-fromnumber-literal-jqssasj`); an `Err` is a compile error at\n",
    "// the literal (`§wac-fromnumber-err-refused-e8w89yu`).\n",
    "//\n",
    "// The built-in numeric types answer the same question, as `f64.[fromNumber](n)` and its siblings, which\n",
    "// the compiler reads as the functions below — so a conversion written for a program's own type can\n",
    "// lean on them with ordinary `try`.\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "/**\n",
    " * A numeric literal's exact value, as written — before any rounding to a machine number. Only the\n",
    " * compiler makes one; a conversion reads `text`, or hands it to one of the conversions below.\n",
    " */\n",
    "export struct NumberLiteral {\n",
    "  string text;\n",
    "}\n",
    "\n",
    "/** What a type implements to be the target of a numeric literal (spec ch09). */\n",
    "export symbol fromNumber;\n",
    "\n",
    "/** A literal's text is not a number at all. */\n",
    "export struct NotANumber {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "\n",
    "/** A literal is a number, but an integer type was wanted and it has a fraction or an exponent. */\n",
    "export struct NotAnInteger {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "\n",
    "/** A literal is a number the wanted type cannot hold. */\n",
    "export struct OutOfRange {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "\n",
    "/** `f64.[fromNumber](n)`: the nearest `f64`. Refused only for text that is not a number. */\n",
    "export Result<f64, union<NotANumber, OutOfRange>> numberLiteralToF64(NumberLiteral n) {\n",
    "  string s = n.text;\n",
    "  if (isHexLiteral(s)) {\n",
    "    return match (numberLiteralToI64(n)) {\n",
    "      Ok(v): Result.Ok(v as~ f64),\n",
    "      Err(e): match (e) {\n",
    "        NotAnInteger: Result.Err(NotANumber(e.message)),\n",
    "        OutOfRange: Result.Err(e),\n",
    "      },\n",
    "    };\n",
    "  }\n",
    "  i32 i = 0;\n",
    "  bool negative = false;\n",
    "  if (i < s.len() && s.slice(i, i + 1) == \"-\") { negative = true; i++; }\n",
    "  f64 value = 0.0;\n",
    "  bool digits = false;\n",
    "  while (i < s.len() && isDigitOrSeparator(s.slice(i, i + 1))) {\n",
    "    string ch = s.slice(i, i + 1);\n",
    "    if (ch != \"_\") { value = value * 10.0 + (digitOf(ch) as f64); digits = true; }\n",
    "    i++;\n",
    "  }\n",
    "  if (i < s.len() && s.slice(i, i + 1) == \".\") {\n",
    "    i++;\n",
    "    f64 scale = 0.1;\n",
    "    while (i < s.len() && isDigitOrSeparator(s.slice(i, i + 1))) {\n",
    "      string ch = s.slice(i, i + 1);\n",
    "      if (ch != \"_\") { value = value + (digitOf(ch) as f64) * scale; scale = scale / 10.0; digits = true; }\n",
    "      i++;\n",
    "    }\n",
    "  }\n",
    "  if (i < s.len() && (s.slice(i, i + 1) == \"e\" || s.slice(i, i + 1) == \"E\")) {\n",
    "    i++;\n",
    "    bool down = false;\n",
    "    if (i < s.len() && (s.slice(i, i + 1) == \"-\" || s.slice(i, i + 1) == \"+\")) { down = s.slice(i, i + 1) == \"-\"; i++; }\n",
    "    i32 exp = 0;\n",
    "    while (i < s.len() && isDigitOrSeparator(s.slice(i, i + 1))) {\n",
    "      string ch = s.slice(i, i + 1);\n",
    "      if (ch != \"_\") { exp = exp * 10 + digitOf(ch); }\n",
    "      i++;\n",
    "    }\n",
    "    for (i32 k = 0; k < exp; k++) { value = down ? value / 10.0 : value * 10.0; }\n",
    "  }\n",
    "  if (!digits || i != s.len()) { return Result.Err(NotANumber(\"`\" + s + \"` is not a number\")); }\n",
    "  return Result.Ok(negative ? 0.0 - value : value);\n",
    "}\n",
    "\n",
    "/** `f32.[fromNumber](n)`: the nearest `f32`. */\n",
    "export Result<f32, union<NotANumber, OutOfRange>> numberLiteralToF32(NumberLiteral n) {\n",
    "  return match (numberLiteralToF64(n)) { Ok(v): Result.Ok(v as~ f32), Err(e): Result.Err(e) };\n",
    "}\n",
    "\n",
    "/** `i64.[fromNumber](n)`: the integer, refused when the text has a fraction or does not fit. */\n",
    "export Result<i64, union<NotAnInteger, OutOfRange>> numberLiteralToI64(NumberLiteral n) {\n",
    "  string s = n.text;\n",
    "  i32 i = 0;\n",
    "  bool negative = false;\n",
    "  if (i < s.len() && s.slice(i, i + 1) == \"-\") { negative = true; i++; }\n",
    "  bool hex = isHexLiteral(s.slice(i, s.len()));\n",
    "  if (hex) { i = i + 2; }\n",
    "  i64 value = 0 as i64;\n",
    "  bool digits = false;\n",
    "  i64 base = hex ? 16 as i64 : 10 as i64;\n",
    "  // The magnitude is gathered negatively, so `-9223372036854775808` fits as it does in the type.\n",
    "  i64 limit = negative || hex ? 0 as i64 - 9223372036854775807 - 1 : 0 as i64 - 9223372036854775807;\n",
    "  while (i < s.len()) {\n",
    "    string ch = s.slice(i, i + 1);\n",
    "    if (ch == \"_\") { i++; continue; }\n",
    "    i32 d = hex ? hexDigitOf(ch) : (isDigitOrSeparator(ch) ? digitOf(ch) : 0 - 1);\n",
    "    if (d < 0) { break; }\n",
    "    if (value < (limit + (d as i64)) / base) { return Result.Err(OutOfRange(\"`\" + s + \"` does not fit in an i64\")); }\n",
    "    value = value * base - (d as i64);\n",
    "    digits = true;\n",
    "    i++;\n",
    "  }\n",
    "  if (!digits || i != s.len()) { return Result.Err(NotAnInteger(\"`\" + s + \"` is not an integer\")); }\n",
    "  if (negative) { return Result.Ok(value); }\n",
    "  if (hex) { return Result.Ok(0 as i64 - value); }\n",
    "  return Result.Ok(0 as i64 - value);\n",
    "}\n",
    "\n",
    "/** `i32.[fromNumber](n)`: the integer, refused when it does not fit; a hex literal names bits. */\n",
    "export Result<i32, union<NotAnInteger, OutOfRange>> numberLiteralToI32(NumberLiteral n) {\n",
    "  return match (numberLiteralToI64(n)) {\n",
    "    Ok(v): fitsBits(n.text, v, 0 as i64 - 2147483648, 2147483647 as i64, 4294967295 as i64)\n",
    "             ? Result.Ok(v as@ i32) : Result.Err(OutOfRange(\"`\" + n.text + \"` does not fit in an i32\")),\n",
    "    Err(e): Result.Err(e),\n",
    "  };\n",
    "}\n",
    "\n",
    "/** Whether `v`, written as `text`, fits a type of range `lo..hi` — or, written in hex, its width `mask`. */\n",
    "bool fitsBits(string text, i64 v, i64 lo, i64 hi, i64 mask) {\n",
    "  if (isHexLiteral(text)) { return v >= 0 as i64 && v <= mask; }\n",
    "  return v >= lo && v <= hi;\n",
    "}\n",
    "\n",
    "bool isHexLiteral(string s) {\n",
    "  return s.len() > 2 && s.slice(0, 1) == \"0\" && (s.slice(1, 2) == \"x\" || s.slice(1, 2) == \"X\");\n",
    "}\n",
    "\n",
    "bool isDigitOrSeparator(string ch) {\n",
    "  return ch == \"_\" || (ch.len() == 1 && ch.toBytes()[0] >= 48 && ch.toBytes()[0] <= 57);\n",
    "}\n",
    "\n",
    "i32 digitOf(string ch) { return ch.toBytes()[0] as i32 - 48; }\n",
    "\n",
    "i32 hexDigitOf(string ch) {\n",
    "  if (ch.len() != 1) { return 0 - 1; }\n",
    "  i32 b = ch.toBytes()[0] as i32;\n",
    "  if (b >= 48 && b <= 57) { return b - 48; }\n",
    "  if (b >= 97 && b <= 102) { return b - 87; }\n",
    "  if (b >= 65 && b <= 70) { return b - 55; }\n",
    "  return 0 - 1;\n",
    "}\n",
    "\n",
    "/**\n",
    " * The value a literal's `[fromNumber]` conversion answered, or a trap naming the literal — which, run as\n",
    " * the static each such literal becomes, is a compile error at it (spec ch09\n",
    " * `§wac-fromnumber-err-refused-e8w89yu`).\n",
    " */\n",
    "export T literalValue<T, E>(Result<T, E> converted, string literal) {\n",
    "  match (converted) {\n",
    "    Ok(v): { return v; }\n",
    "    Err(e): { trap \"the literal \" + literal + \" cannot be converted: its `fromNumber` answered Err\"; }\n",
    "  }\n",
    "}\n",
    "\n",
    "// `hypothetical<T>()` — an expression of any type, for `typeof` to read (spec ch30, ch37).\n",
    "\n",
    "/**\n",
    " * A `T` that is never produced: it traps when called. It exists to be written inside `typeof`, which\n",
    " * checks its operand and never runs it, so a computed type can ask what an expression of type `T` would\n",
    " * give without having one — `typeof(hypothetical<Ticket<A>>().value())` is `A`.\n",
    " */\n",
    "export T hypothetical<T>() { trap; }\n"
  ] as string[];
  i32 total = 0;
  for (i32 i = 0; i < lines.len(); i++) { total = total + lines[i].toBytes().len(); }
  u8[] all = u8[].filled(total, 0);
  i32 at = 0;
  for (i32 i = 0; i < lines.len(); i++) {
    u8[] b = lines[i].toBytes();
    all.copyFrom(b, 0, at, b.len());
    at = at + b.len();
  }
  return string.fromBytes(all);
}

/** `std`, the module `import { … } from "std"` reaches. */
export string stdSource() {
  string[] lines = [
    "//\n",
    "// `Pending.then` is a lambda — `design/lang/0002` — and the reference compiler does not have\n",
    "// them. The marker is not a skip: the corpus tests that read it assert the two front ends\n",
    "// genuinely *disagree* here, so a stale marker fails rather than dropping the file silently.\n",
    "//\n",
    "// **Keep new text in this file ASCII, until `issues/lang/0253a` is fixed.** One non-ASCII character\n",
    "// in a *comment* here is enough to turn `test_rung_5_wacc_compiled_by_wacc_compiles_wacc_to_the_same_bytes`\n",
    "// red: this file's text is embedded in `packages/wacc/src/coretext.wac`, so a comment reaches what\n",
    "// the compiler is built from, and the reference and wacc then disagree about the bytes. `wac task\n",
    "// seed`'s own fixpoint check does *not* catch it, so the first sign is a red suite some minutes\n",
    "// later with no obvious connection to the sentence that was typed. An em dash is the usual way in,\n",
    "// because the rest of this repository writes them freely.\n",
    "//\n",
    "// The platform world: everything an application may do, and nothing else.\n",
    "//\n",
    "// wac has no ambient access — no imports a program can name, no globals reaching outside\n",
    "// — so an application can only touch what it is handed. These structs *are* the\n",
    "// permission list. Reading one tells you exactly what a program can do, not because of a\n",
    "// convention but because there is no other route out.\n",
    "//\n",
    "// Two profiles rather than one flat struct, so an application takes what it needs and a\n",
    "// reader can see the difference between \"reads the clock\" and \"reads your filesystem\".\n",
    "//\n",
    "// Every capability returns a value; none fills a buffer. Arrays *copy* across the\n",
    "// boundary, so a `fn<void(u8[])> fill` type-checks and quietly does nothing — the host's\n",
    "// writes land on a copy. Returning is the only shape that works.\n",
    "//\n",
    "// Capabilities are also coarse on purpose. Behind each one may be a thread parking and\n",
    "// unparking on a `SharedArrayBuffer`, which is nothing per file read and ruinous per byte.\n",
    "// `readFile`, never `readByte`.\n",
    "\n",
    "/**\n",
    " * A call that has been started but not yet collected.\n",
    " *\n",
    " * Every capability that produces a value hands back one of these instead of the value.\n",
    " * `.wait()` blocks until the answer is there and gives it to you, which is what almost\n",
    " * every caller wants and is why the swap from the old surface is `x(…)` to `x(…).wait()`\n",
    " * and nothing more.\n",
    " *\n",
    " * What the shape buys is the calls you *do not* wait for immediately:\n",
    " *\n",
    " * ```wac\n",
    " * Pending<FileResult> a = cli.readFile(\"one\");\n",
    " * Pending<FileResult> b = cli.readFile(\"two\");   // both are already running\n",
    " * FileResult ra = a.wait();\n",
    " * FileResult rb = b.wait();\n",
    " * ```\n",
    " *\n",
    " * and, more importantly, waiting on whichever of several answers first — which is how a\n",
    " * program watches two sockets at once, and is the only reason `nc`, an SSH relay and a\n",
    " * shell were not writable before.\n",
    " *\n",
    " * **The ticket carries its own resolver, and an `id` rather than a closure.** The reason is\n",
    " * the host boundary, not the language: a JS closure is not a wasm function, so bindgen\n",
    " * registers one wasm function per host function and only *sixteen per signature* can be\n",
    " * live at once — see spec/spec/bindgen.md. A resolver closed over its own answer would\n",
    " * burn a slot per call and die on the seventeenth outstanding read. So one resolver is\n",
    " * registered per signature and the `id` selects which call it is for.\n",
    " *\n",
    " * **The same table caught the host out a second time**, which is worth knowing before anyone\n",
    " * economises on either side of it: a worker that runs a *second* program used to build a second\n",
    " * `Core` and `Cli`, three more `fn<void(i32)>` each time, and failed on the fifth run with the\n",
    " * message this paragraph predicts. `host/entry.ts` builds them once and re-points the bridge\n",
    " * instead (wac-mono 0076). Registration is by identity, so the fix is exactly \"pass the same\n",
    " * function again\".\n",
    " *\n",
    " * This comment used to say \"wac has no closures, so whatever `.wait()` calls has to be\n",
    " * inside the ticket\". Both halves are wrong now and only the second was when this note was\n",
    " * written: lambdas landed 2026-08-16 and capture by reference, `spec/cases/0191`. Context can\n",
    " * travel *beside* a funcref, as an unbound method reference with the receiver as its first\n",
    " * parameter (`[§wac-fnref-method-h9pd3wn]`). Read as written it says callbacks cannot carry\n",
    " * context in wac, which cost agent-b an hour of threading it by hand. Corrected on their\n",
    " * report.\n",
    " *\n",
    " * **And it can travel *inside* one now**: `c.inc` is a bound reference, an `fn<…>` of the\n",
    " * receiver-less signature, as of `design/lang/0002` tier one — `[§wacc-fnref-bound]`. So a\n",
    " * funcref-plus-context pair is no longer the only spelling, which is what `Shell.askInterrupt`\n",
    " * exists to stop being.\n",
    " *\n",
    " * A ticket is good once. Waiting on a spent one is an error rather than a plausible wrong\n",
    " * answer, because the slot underneath is reused and its generation has moved on.\n",
    " */\n",
    "// The one type this world does not define itself. `Read` is in `core` — the compiler's own module —\n",
    "// because the streaming transforms in `gzip` and `stream` must name it too and have no business\n",
    "// depending on a capability world, and because **nominal typing** means a second copy of it could\n",
    "// never be converted into this one. See wac's `design/0001`. (That reason was written as \"with no\n",
    "// closures in the language\", which is both out of date and never the reason: two declarations of a\n",
    "// shape are two types whatever a funcref can capture.)\n",
    "import { Buf, Continuation, Map, Queue, Read, Result, Ticket, TicketBase, Vec, hashString, stringEq, toString, __wacScheduleTarget,\n",
    "         __wacSetScheduleTarget } from \"core\";\n",
    "\n",
    "/** A handler slot that does nothing, so a table can be filled before anything is registered. */\n",
    "void schedIdle(i32 id) { }\n",
    "\n",
    "/**\n",
    " * Milliseconds as nanoseconds, because a budget is given in the first and the clock answers in the\n",
    " * second. Named rather than written out at each use: `Sched.run` compares a difference of nanoseconds\n",
    " * against a number of milliseconds, and getting that by a factor of a million is a bug that looks like\n",
    " * a scheduler that never waits.\n",
    " */\n",
    "i64 millisToNanos(i32 millis) { return (millis as i64) * (1000000 as i64); }\n",
    "\n",
    "/**\n",
    " * Outstanding continuations, and what to run when each ticket answers.\n",
    " *\n",
    " * **A program never names one.** The world hands it over inside `Core`, and reaches it through\n",
    " * `core.delay`, `core.drain` and `core.dropAll` — so this is a capability like every other thing in\n",
    " * this file, rather than an object a program assembles for itself. `Loop`, which it replaces, was the\n",
    " * second kind and read wrong in every example.\n",
    " *\n",
    " * Plain arrays rather than `Vec`, so `platform` keeps its one import and depends on no package.\n",
    " */\n",
    "/**\n",
    " * What a host's `waitAny` answers when it **cannot wait** — a page, which may not block until an answer\n",
    " * arrives. Distinct from `-1`, \"nothing answered in time\": this one means \"return to me, and I will call\n",
    " * you again when something has\". Design `system/0015`, decision 4.\n",
    " */\n",
    "export i32 HOST_CANNOT_WAIT() { return 0 - 2; }\n",
    "\n",
    "export struct Sched {\n",
    "  i32[] ids;\n",
    "  fn<void(i32)>[] handlers;\n",
    "  /** Each ticket's own `drop`, so abandoning releases the host's slot rather than forgetting it. */\n",
    "  fn<void(i32)>[] drops;\n",
    "  i32 n;\n",
    "  /**\n",
    "   * The continuations nobody awaited — the program's schedule target, installed by `Core.of`, and\n",
    "   * what `Core.drain` runs (spec ch35). Here rather than on `Core` because the host builds this\n",
    "   * with `create` and marshals `Core` field by field.\n",
    "   */\n",
    "  Queue<Continuation> queued;\n",
    "  /**\n",
    "   * Whether the last wait was refused by a host that cannot wait — a page, which has no way to sleep\n",
    "   * until an answer arrives, and whose `waitAny` answers `HOST_CANNOT_WAIT` instead. The program then\n",
    "   * yields to the host rather than failing, and is resumed when an answer has arrived (design\n",
    "   * `system/0015`, decision 4). Hosts that can wait never set it.\n",
    "   */\n",
    "  bool yielded;\n",
    "\n",
    "  Sched create() {\n",
    "    Queue<Continuation> queued;\n",
    "    return Sched(i32[].filled(8, 0), fn<void(i32)>[].filled(8, schedIdle), fn<void(i32)>[].filled(8, schedIdle), 0,\n",
    "                 queued, false);\n",
    "  }\n",
    "\n",
    "  /** How much work is outstanding — what the host asks before deciding a clean exit. */\n",
    "  i32 pending(const this) { return this.n; }\n",
    "\n",
    "  /**\n",
    "   * How many queued continuations are still current, dropping the rest — the ones a `wait` ran past, which\n",
    "   * do nothing when called and would otherwise count as work left.\n",
    "   */\n",
    "  i32 liveQueued(this) {\n",
    "    Queue<Continuation> kept;\n",
    "    i32 live = 0;\n",
    "    while (true) {\n",
    "      Continuation? c = this.queued.pop();\n",
    "      if (c is null) { break; }\n",
    "      if (!c!.current()) { continue; }\n",
    "      kept.push(c!);\n",
    "      live = live + 1;\n",
    "    }\n",
    "    while (true) {\n",
    "      Continuation? c = kept.pop();\n",
    "      if (c is null) { break; }\n",
    "      this.queued.push(c!);\n",
    "    }\n",
    "    return live;\n",
    "  }\n",
    "\n",
    "  /** Run `handler` when `id` answers. Registering the same id twice runs both, in order. */\n",
    "  void on(this, i32 id, fn<void(i32)> handler, fn<void(i32)> drop) {\n",
    "    if (this.n == this.ids.len()) { this.grow(); }\n",
    "    this.ids[this.n] = id;\n",
    "    this.handlers[this.n] = handler;\n",
    "    this.drops[this.n] = drop;\n",
    "    this.n = this.n + 1;\n",
    "  }\n",
    "\n",
    "  void grow(this) {\n",
    "    i32 want = this.ids.len() * 2;\n",
    "    i32[] ni = i32[].filled(want, 0);\n",
    "    fn<void(i32)>[] nh = fn<void(i32)>[].filled(want, schedIdle);\n",
    "    fn<void(i32)>[] nd = fn<void(i32)>[].filled(want, schedIdle);\n",
    "    for (i32 i = 0; i < this.n; i++) {\n",
    "      ni[i] = this.ids[i];\n",
    "      nh[i] = this.handlers[i];\n",
    "      nd[i] = this.drops[i];\n",
    "    }\n",
    "    this.ids = ni;\n",
    "    this.handlers = nh;\n",
    "    this.drops = nd;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Withdraw the registration for `id`, if there is one. Answers whether there was.\n",
    "   *\n",
    "   * **For work that is abandoned rather than finished.** `run` unregisters a handler before running\n",
    "   * it, so a continuation that re-arms needs nothing from this — the normal path never calls it. What\n",
    "   * does is a caller giving up on something it registered: a relay dropping a connection has to take\n",
    "   * back the reads still outstanding on that connection's other sockets, or they fire later against a\n",
    "   * closed handle.\n",
    "   *\n",
    "   * The ticket's own `drop` is called, as `dropAll` does, so the host's slot is released rather than\n",
    "   * leaked. Silent when `id` is not registered, because \"already fired\" and \"never registered\" are\n",
    "   * both fine answers to *make sure this is not pending*.\n",
    "   */\n",
    "  bool off(this, i32 id) {\n",
    "    i32 at = this.indexOf(id);\n",
    "    if (at < 0) { return false; }\n",
    "    fn<void(i32)> go = this.drops[at];\n",
    "    this.removeAt(at);\n",
    "    go(id);\n",
    "    return true;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Take the continuation off and **keep the ticket**.\n",
    "   *\n",
    "   * The other half of `off`, which abandons both. This is for a caller that means to resolve the\n",
    "   * ticket itself: it must take the handler back first, or the answer arrives twice — once where the\n",
    "   * caller waited and once when `run` dispatches — and a body that appends to a list or sends a\n",
    "   * packet does that twice too.\n",
    "   *\n",
    "   * **Found by `design/lang/0014` step 2**, where an async function's ticket has to answer a plain\n",
    "   * `.wait()` by driving its own chain. Written as `off` at first, and every wait-driven case\n",
    "   * trapped: `off` releases the host's slot, so the very next line waited on a ticket that was gone.\n",
    "   * The two are one search and two policies, which is why `indexOf` exists rather than a second loop\n",
    "   * that can drift from this one.\n",
    "   */\n",
    "  bool detach(this, i32 id) {\n",
    "    i32 at = this.indexOf(id);\n",
    "    if (at < 0) { return false; }\n",
    "    this.removeAt(at);\n",
    "    return true;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Run what is registered for `id`, now, and answer how many ran — for a world that is **told** a\n",
    "   * ticket answered rather than waiting to find out.\n",
    "   *\n",
    "   * `run` learns which ticket answered by parking in `waitAny`, and a page cannot park: its host\n",
    "   * calls in when an answer arrives, and this is what that call does. Each registration for `id` is\n",
    "   * taken off before any of them runs, as `run` does, so a handler that registers for the same id\n",
    "   * again is waiting for the *next* answer rather than this one.\n",
    "   */\n",
    "  i32 fire(this, i32 id) {\n",
    "    i32 n = 0;\n",
    "    for (i32 i = 0; i < this.n; i++) {\n",
    "      if (this.ids[i] == id) { n = n + 1; }\n",
    "    }\n",
    "    if (n == 0) { return 0; }\n",
    "    fn<void(i32)>[] due = fn<void(i32)>[].filled(n, schedIdle);\n",
    "    i32 k = 0;\n",
    "    while (true) {\n",
    "      i32 at = this.indexOf(id);\n",
    "      if (at < 0) { break; }\n",
    "      due[k] = this.handlers[at];\n",
    "      k = k + 1;\n",
    "      this.removeAt(at);\n",
    "    }\n",
    "    for (i32 i = 0; i < n; i++) { due[i](id); }\n",
    "    return n;\n",
    "  }\n",
    "\n",
    "  /** Where `id` is registered, or -1. */\n",
    "  i32 indexOf(const this, i32 id) {\n",
    "    for (i32 i = 0; i < this.n; i++) {\n",
    "      if (this.ids[i] == id) { return i; }\n",
    "    }\n",
    "    return 0 - 1;\n",
    "  }\n",
    "\n",
    "  void removeAt(this, i32 at) {\n",
    "    for (i32 i = at; i + 1 < this.n; i++) {\n",
    "      this.ids[i] = this.ids[i + 1];\n",
    "      this.handlers[i] = this.handlers[i + 1];\n",
    "      this.drops[i] = this.drops[i + 1];\n",
    "    }\n",
    "    this.n = this.n - 1;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Run registered work until nothing is outstanding or the budget runs out. Answers how many ran.\n",
    "   *\n",
    "   * **This is the only place other code runs while a program waits.** There is no second stack — a\n",
    "   * park in `waitAny` runs nothing — so a continuation can only run inside a call that dispatches,\n",
    "   * and this is that call. A program blocked anywhere else stalls its continuations until it gets\n",
    "   * here, which is the honest cost of having no preemption and is why `drain` is written by the\n",
    "   * program rather than happening to it.\n",
    "   *\n",
    "   * A handler is unregistered **before** it runs, so it may register more work — including re-arming\n",
    "   * the same kind of read, which is what a relay does on every packet.\n",
    "   *\n",
    "   * **`millis` bounds the call, not each wait.** It cannot be handed straight to `waitAny`: that\n",
    "   * bounds one wait, and this does many, so `n` handlers and a one-second budget would be `n` seconds\n",
    "   * — and a handler that re-arms would make it unbounded, because work arriving is what keeps the\n",
    "   * loop going. So the clock is read and each wait is asked for what is *left*. The first wait always\n",
    "   * happens with the whole budget, which keeps `0` askable: that is `waitAny`'s \"which is ready right\n",
    "   * now\", and a `run` that could not do it would have no way to poll.\n",
    "   *\n",
    "   * `-1` is \"as long as it takes\" and reads no clock at all, so `drain` — the only caller in the\n",
    "   * repository — pays nothing for a budget it does not have. It matters that it is nothing rather than\n",
    "   * a little: the clock is a capability call, so it parks the worker like any other.\n",
    "   */\n",
    "  i32 run(this, const Core core, i32 millis) {\n",
    "    i32 ran = 0;\n",
    "    bool bounded = millis >= 0;\n",
    "    i64 deadline = 0 as i64;\n",
    "    if (bounded) { deadline = core.monotonicNanos().wait() + millisToNanos(millis); }\n",
    "    i32 waits = 0;\n",
    "    while (this.n > 0) {\n",
    "      i32 budget = millis;\n",
    "      if (bounded && waits > 0) {\n",
    "        i64 left = deadline - core.monotonicNanos().wait();\n",
    "        if (left <= 0 as i64) { return ran; }\n",
    "        // Rounded down, so a fraction of a millisecond left asks for `0` — a poll, which is the\n",
    "        // truth: there is no time to wait with.\n",
    "        // `as!` rather than `as~`: this is bounded above by `millis`, which is an `i32` already, so\n",
    "        // the check is a claim that cannot fail rather than a value being squeezed.\n",
    "        budget = (left / (1000000 as i64)) as! i32;\n",
    "      }\n",
    "      // **In registration order**, which `removeAt` preserves by shifting rather than swapping — so\n",
    "      // with several continuations due at once they run in the order they were registered. That is\n",
    "      // `waitAny`'s tie-break plus this list's order; neither alone is enough to say it.\n",
    "      i32[] live = i32[].filled(this.n, 0);\n",
    "      for (i32 i = 0; i < this.n; i++) { live[i] = this.ids[i]; }\n",
    "      i32 which = core.waitAny(live, budget);\n",
    "      waits = waits + 1;\n",
    "      if (which < 0) { return ran; }\n",
    "      i32 id = this.ids[which];\n",
    "      fn<void(i32)> handler = this.handlers[which];\n",
    "      this.removeAt(which);\n",
    "      handler(id);\n",
    "      ran = ran + 1;\n",
    "    }\n",
    "    return ran;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Wait for one registered ticket and run its handler — the single round `Core.drain` interleaves\n",
    "   * with the continuations it runs. Answers how many ran: one, or none when nothing is registered or\n",
    "   * nothing answered within `millis` (below zero: as long as it takes).\n",
    "   */\n",
    "  i32 runOne(this, const Core core, i32 millis) {\n",
    "    if (this.n == 0) { return 0; }\n",
    "    i32[] live = i32[].filled(this.n, 0);\n",
    "    for (i32 i = 0; i < this.n; i++) { live[i] = this.ids[i]; }\n",
    "    i32 which = core.waitAny(live, millis);\n",
    "    if (which == HOST_CANNOT_WAIT()) { this.yielded = true; }\n",
    "    if (which < 0) { return 0; }\n",
    "    i32 id = this.ids[which];\n",
    "    fn<void(i32)> handler = this.handlers[which];\n",
    "    this.removeAt(which);\n",
    "    handler(id);\n",
    "    return 1;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Abandon everything outstanding, and answer how much there was.\n",
    "   *\n",
    "   * **Exiting with work outstanding is an error; exiting after this is not.** The difference is that\n",
    "   * one of them said so. Each ticket's own `drop` is called, so the host's slots are released rather\n",
    "   * than left for a ring that fills up.\n",
    "   */\n",
    "  i32 dropAll(this) {\n",
    "    // **Taken out of the list before any of them runs**, like `run` unregisters a handler before\n",
    "    // running it. Walking `this.n` while a `drop` calls `on` reaches entries that were not there when\n",
    "    // this was called — dropping work it was not asked to abandon — and the clear afterwards then\n",
    "    // forgets whatever the drops registered while still reporting a clean exit.\n",
    "    i32 had = this.n;\n",
    "    i32[] ids = i32[].filled(had, 0);\n",
    "    fn<void(i32)>[] drops = fn<void(i32)>[].filled(had, schedIdle);\n",
    "    for (i32 i = 0; i < had; i++) {\n",
    "      ids[i] = this.ids[i];\n",
    "      drops[i] = this.drops[i];\n",
    "    }\n",
    "    this.n = 0;\n",
    "    for (i32 i = 0; i < had; i++) { drops[i](ids[i]); }\n",
    "    return had;\n",
    "  }\n",
    "}\n",
    "\n",
    "export struct Pending<T> {\n",
    "  i32 id;\n",
    "  fn<T(i32)> resolve;\n",
    "  fn<bool(i32)> settled;\n",
    "  fn<void(i32)> drop;\n",
    "  /**\n",
    "   * Where a continuation goes, or null for a ticket nobody linked.\n",
    "   *\n",
    "   * The host builds tickets through `of` and knows nothing about any scheduler; a capability that\n",
    "   * hands out *linked* tickets does so itself. So `then` works on `core.delay(…)` and does not on a\n",
    "   * raw `recv`, and which is which is a property of the capability rather than of this type.\n",
    "   */\n",
    "  Sched? sched;\n",
    "\n",
    "  /**\n",
    "   * Whether **waiting** on this ticket can make it answer.\n",
    "   *\n",
    "   * True of every ticket a host hands out, because waiting is exactly how the host is asked. True of\n",
    "   * an `async` function's ticket, because waiting drives its machine. False of a ticket the program\n",
    "   * made whose answer arrives only when somebody *else's* continuation runs — nothing a `wait` is\n",
    "   * allowed to do can advance one of those, and `design/lang/0014` D2 is what makes that so: a wait\n",
    "   * drives its own chain and deliberately runs no unrelated registered work.\n",
    "   *\n",
    "   * **It has to be recorded rather than worked out.** Measured 2026-08-30: at the moment of the wait\n",
    "   * a host ticket whose answer has not arrived and a ticket nothing can ever answer are\n",
    "   * indistinguishable — `sched` is null and `settled` is false for both. Asking again afterwards does\n",
    "   * not separate them either, because a host ticket is *not* settled after being waited on: its slot\n",
    "   * is spent and `settled` answers false again.\n",
    "   *\n",
    "   * **False is the default a hand-written ticket should have.** Getting it wrong that way traps and\n",
    "   * says so; getting it wrong the other way is what this replaces — a silent zero.\n",
    "   */\n",
    "  bool waitable;\n",
    "\n",
    "  /**\n",
    "   * A ticket the host will answer. Every capability's is made through here, which is why this sets\n",
    "   * `waitable`: being waited on is how the host is asked.\n",
    "   */\n",
    "  Pending<T> of(i32 id, fn<T(i32)> resolve, fn<bool(i32)> settled, fn<void(i32)> drop) {\n",
    "    return Pending<T>(id, resolve, settled, drop, null, true);\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * A ticket the *program* answers, which waiting can drive — an `async` function's, and anything\n",
    "   * else whose `resolve` does the work rather than asking for it.\n",
    "   *\n",
    "   * The counterpart is no static at all: a ticket only a continuation can answer is built with the\n",
    "   * constructor and `false`, and saying so is the point.\n",
    "   */\n",
    "  Pending<T> driven(i32 id, fn<T(i32)> resolve, fn<bool(i32)> settled, fn<void(i32)> drop) {\n",
    "    return Pending<T>(id, resolve, settled, drop, null, true);\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * The same ticket, told **which world** runs its continuations.\n",
    "   *\n",
    "   * Takes a `Core` rather than the scheduler inside it, so a program never names a scheduler — the\n",
    "   * same rule `delay`, `drain` and `dropAll` keep. It is also the honest statement of the\n",
    "   * relationship: the world that answers a ticket is the world that dispatches it.\n",
    "   *\n",
    "   * **`Core`'s own tickets arrive linked** — `Core.of` does it, so `core.delay`, `core.randomBytes`,\n",
    "   * `core.nowMillis` and `core.monotonicNanos` all carry continuations without being asked. This is\n",
    "   * for the ones handed out by a capability that is *not* the world that dispatches: `Cli` has no\n",
    "   * scheduler, so `cli.readFile(p).linkedTo(core).then(f)` is how the rest of the world gets them.\n",
    "   * `waitAny` already takes ticket ids across differing `Pending<T>`, which is the property that\n",
    "   * makes one scheduler enough for all of them.\n",
    "   *\n",
    "   * **It read `core.randomBytes(8).linkedTo(core).then(f)` until 2026-08-30**, which asked the caller\n",
    "   * to hand `core` back to a ticket `core` had just produced — and the failure for forgetting was a\n",
    "   * bare trap. The operator had said so when this was built.\n",
    "   */\n",
    "  Pending<T> linkedTo(const this, const Core core) {\n",
    "    return this.on(core.sched);\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * The same ticket, told which scheduler dispatches its continuations.\n",
    "   *\n",
    "   * **`Core.of` uses this on every ticket `Core` itself hands out**, which is why `core.delay`,\n",
    "   * `core.randomBytes`, `core.nowMillis` and `core.monotonicNanos` carry continuations without being\n",
    "   * asked to. A capability reached *through* the world that dispatches has no business making the\n",
    "   * caller say so a second time; `linkedTo` above is for a ticket some *other* capability handed\n",
    "   * out, and `Cli`'s are all of those.\n",
    "   */\n",
    "  Pending<T> on(const this, const Sched s) {\n",
    "    return Pending<T>(this.id, this.resolve, this.settled, this.drop, s, this.waitable);\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * The same ticket with `f` applied to its answer — a **chained** ticket of a different type.\n",
    "   *\n",
    "   * `design/lang/0010` criterion 4, and it is smaller than that document predicted. It expected a\n",
    "   * derived ticket resolved when the first resolves, which is scheduler plumbing; what it needs is\n",
    "   * function composition and no scheduler change at all. A ticket is an id plus three functions of\n",
    "   * that id, so the chained one keeps the **same host id** — the same slot, the same `settled`, the\n",
    "   * same `drop`, the same world — and differs only in `resolve`, which gains `f` on top. `waitAny`\n",
    "   * takes ids across differing `Pending<T>` for exactly this reason.\n",
    "   *\n",
    "   * Nothing runs here. `f` is applied when the answer arrives and the ticket is resolved, so a\n",
    "   * chained ticket nobody consumes costs a closure and never calls `f`:\n",
    "   *\n",
    "   *     cli.readFile(p).linkedTo(core).map<i32>((string s) => s.len()).then((i32 n) => …)\n",
    "   *\n",
    "   * **Not named `then`, and that is not a preference.** wac has no overloading, `then` has five real\n",
    "   * callers all passing a void lambda, and a void-bodied lambda cannot satisfy `fn<U(T)>`. So the\n",
    "   * consumer keeps the name it has and the transform takes the one it would have in any case.\n",
    "   *\n",
    "   * **Two chains from one ticket resolve one host slot twice**, which is the pre-existing property of\n",
    "   * `resolve` rather than something this adds — a ticket answers once, and `map` does not copy it.\n",
    "   */\n",
    "  Pending<U> map<U>(const this, fn<U(T)> f) {\n",
    "    return Pending<U>(this.id, (i32 id) => f(this.resolve(id)), this.settled, this.drop, this.sched,\n",
    "                      this.waitable);\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Run `f` with the answer once it is here, and return **now**.\n",
    "   *\n",
    "   * The scheduler holding the continuation never learns `T`: what is registered is a `fn<void(i32)>`,\n",
    "   * and the wrapper closing over `resolve` is what carries the type across. That wrapper is a lambda\n",
    "   * written inside a generic, which is why this could not exist before `issues/lang/0142`.\n",
    "   *\n",
    "   * **Traps on an unlinked ticket** rather than dropping the continuation on the floor — a `then`\n",
    "   * that silently never runs is the worst failure this could have, and a ticket is unlinked only\n",
    "   * when the capability that made it does not schedule.\n",
    "   *\n",
    "   * The ticket's own `drop` is registered beside the handler, so `Sched.dropAll` can release the\n",
    "   * host's slot rather than merely forgetting the callback.\n",
    "   */\n",
    "  void then(this, fn<void(T)> f) {\n",
    "    // **A bare trap, and it should not be.** This is the one mistake the API invites — `delay` hands\n",
    "    // back a linked ticket and every other capability hands back an unlinked one — so `then` on a\n",
    "    // `readFile` is where a reader arrives, and what they get is *Uncaught RuntimeError: unreachable*.\n",
    "    //\n",
    "    // `trap \"…\"` did not carry its message when this was written — `issues/lang/0147`, which is\n",
    "    // **closed**: wacc emits it and the V8 host prints it, so `wac run` says *trapped: …* today. This\n",
    "    // should say something, and the sentence it should say is the one `design/lang/0014` D7 is about.\n",
    "    // Left as a bare trap only because nobody has written that sentence yet, not because it cannot be\n",
    "    // written.\n",
    "    if (this.sched is null) { trap; }\n",
    "    this.sched!.on(this.id, (i32 id) => { f(this.resolve(id)); }, this.drop);\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Block until the answer is here, and take it. The ticket is spent afterwards.\n",
    "   *\n",
    "   * `const this` because it writes nothing — the spending happens on the host side of the\n",
    "   * resolver. It has to be const to be callable at all from a `const this` method, which\n",
    "   * is where half the capability calls in `packages/sh` and `packages/ssh` live.\n",
    "   */\n",
    "  T wait(const this) {\n",
    "    // **`design/lang/0014` D7.** A ticket that only a continuation can answer cannot be advanced by\n",
    "    // waiting on it — D2 says a wait drives its own chain and runs no unrelated registered work — so\n",
    "    // waiting is a mistake rather than a delay. It used to return whatever the resolver had, which\n",
    "    // for the shape that reaches here is a default: a program that asks for a file size and is told\n",
    "    // zero, with nothing said. `settled` first, because a ticket that already has its answer is\n",
    "    // fine whoever put it there.\n",
    "    if (!this.waitable && !this.settled(this.id)) {\n",
    "      trap \"this ticket is answered by a continuation, so waiting cannot advance it — call core.drain()\";\n",
    "    }\n",
    "    return this.resolve(this.id);\n",
    "  }\n",
    "\n",
    "  /** Whether `wait` would return immediately. Never blocks. */\n",
    "  bool isDone(const this) { return this.settled(this.id); }\n",
    "\n",
    "  /**\n",
    "   * This host ticket as core's `Ticket`, which is what `await` takes (spec ch35).\n",
    "   *\n",
    "   * **A bridge, and a temporary one**: `design/lang/0016` phase 2 has the host hand out `Ticket`s\n",
    "   * itself and deletes `Pending`, and this with it. Until then a `wait` on the result blocks on the\n",
    "   * host, and a linked ticket is also answered by `core.drain()`'s `waitAny`, so several awaits on\n",
    "   * host work still advance together.\n",
    "   */\n",
    "  Ticket<T> ticket(this) {\n",
    "    Ticket<T> t;\n",
    "    // **An answer already here settles the ticket now.** Registering it instead would leave it to\n",
    "    // whoever dispatches the scheduler — a `drain` on a command line, and in a page, where the host\n",
    "    // says when an answer arrives and has already said it, nobody: a page awaiting the clock waited\n",
    "    // for ever.\n",
    "    if (this.settled(this.id)) {\n",
    "      t.resolve(this.resolve(this.id));\n",
    "      return t;\n",
    "    }\n",
    "    if (this.sched is not null) {\n",
    "      this.sched!.on(this.id, (i32 id) => { if (!t.done) { t.resolve(this.resolve(id)); } }, this.drop);\n",
    "    }\n",
    "    t.drive = () => {\n",
    "      if (this.sched is not null) { this.sched!.detach(this.id); }\n",
    "      if (!t.done) { t.resolve(this.wait()); }\n",
    "      return true;\n",
    "    };\n",
    "    return t;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Stop caring. **Detach, not abort**: the host may already be inside the work and\n",
    "   * generally cannot be interrupted. What this guarantees is that the answer is discarded.\n",
    "   */\n",
    "  void cancel(const this) { this.drop(this.id); }\n",
    "}\n",
    "\n",
    "/**\n",
    " * A file that may not have been there. `bytes` is empty when `ok` is false.\n",
    " *\n",
    " * The static exists so the *host* can build one. A struct has no constructor JavaScript\n",
    " * can reach, and without this every application had to re-export a maker of its own —\n",
    " * ceremony that had nothing to do with counting words.\n",
    " */\n",
    "export struct FileResult {\n",
    "  bool ok;\n",
    "  u8[] bytes;\n",
    "  /** The host's own sentence, which is the only text worth showing a person. */\n",
    "  string error;\n",
    "  /**\n",
    "   * Which `FAULT_*` this was — `FAULT_NONE` when `ok`.\n",
    "   *\n",
    "   * The message cannot be branched on: \"No such file or directory (os error 2)\" from Deno, \"ENOENT: no\n",
    "   * such file or directory\" from Node and a `NotFoundError` from the Origin Private File System are\n",
    "   * three spellings of one fact. A program that wanted to say what GNU says about a missing file had to\n",
    "   * parse English or print the host's sentence, and nine programs in `packages/sh` printed the\n",
    "   * sentence. The mutating side has had a category since `Change` existed; this is the same one, on the\n",
    "   * side that reads. wac-mono 0062.\n",
    "   */\n",
    "  i32 fault;\n",
    "\n",
    "  FileResult of(bool ok, u8[] bytes, string error, i32 fault) {\n",
    "    return FileResult(ok, bytes, error, fault);\n",
    "  }\n",
    "}\n",
    "\n",
    "\n",
    "/**\n",
    " * What a child program wrote, once it has finished.\n",
    " *\n",
    " * Both streams, because a shell needs them apart: a program's diagnostics go to the terminal\n",
    " * even when its output is piped into the next stage, and one buffer cannot say which was which.\n",
    " */\n",
    "export struct Captured {\n",
    "  u8[] out;\n",
    "  u8[] err;\n",
    "  /**\n",
    "   * Whether `out` is **all** of what the child wrote, or as much as would fit.\n",
    "   *\n",
    "   * A frame's output is held in this program's memory rather than draining anywhere, so on the\n",
    "   * JavaScript hosts it is capped at 8 MiB, and at the cap `write` starts answering false.\n",
    "   *\n",
    "   * **The native runtime does not cap it**, which is a difference rather than a simplification and is\n",
    "   * why this field exists rather than a constant: its frame is a `Vec` that grows, so the same applet\n",
    "   * answers in full there and this is always `false`. A caller that must not be handed a short answer\n",
    "   * reads this field; a caller that must not be handed an unbounded one cannot learn that here, and\n",
    "   * `issues/system/0252a` is which of the two behaviours should win. From inside the child that is indistinguishable\n",
    "   * from the reader going away, which is exactly what `box yes` is written to stop on: `while\n",
    "   * (cli.write(block)) {}`. So an applet that fills the buffer exits **cleanly**, believing its pipe\n",
    "   * closed, and hands back a short answer that looks complete.\n",
    "   *\n",
    "   * That is the wrong-answer shape this repository keeps removing, and it was measurable: `boxsh -c\n",
    "   * 'seq 1 1500000 | wc -c'` printed 8323568 where bash prints 10888896, with nothing said.\n",
    "   *\n",
    "   * A full buffer is a fact about **this program's memory**; a closed pipe is a fact about the\n",
    "   * **reader**. The child cannot tell them apart and does not need to — the *caller* can, because it\n",
    "   * is the one holding the buffer, and this is where it finds out. `packages/box`'s `boxRun` turns it\n",
    "   * into a failed command with a message, which is the honest answer: we could not run this, rather\n",
    "   * than here is a number that is not the answer.\n",
    "   */\n",
    "  bool truncated;\n",
    "\n",
    "  Captured of(u8[] out, u8[] err, bool truncated) { return Captured(out, err, truncated); }\n",
    "}\n",
    "\n",
    "\n",
    "\n",
    "/**\n",
    " * What every host can do, synchronously or made to look so.\n",
    " *\n",
    " * Deno, Node and a browser all provide these, which is what makes an application that\n",
    " * uses only `Core` portable without qualification.\n",
    " */\n",
    "export struct Core {\n",
    "  /** Wall clock, milliseconds since the epoch. Moves backwards; do not measure with it. */\n",
    "  fn<Pending<i64>()> nowMillis;\n",
    "  /** Monotonic nanoseconds from an arbitrary origin. For measuring, never for dating. */\n",
    "  fn<Pending<i64>()> monotonicNanos;\n",
    "  /**\n",
    "   * A ticket that settles once the given milliseconds have passed, resolving to the\n",
    "   * monotonic nanoseconds at which it did — so `.wait()` is a sleep that tells you how far\n",
    "   * it overshot.\n",
    "   *\n",
    "   * **For a deadline, use `Cli.waitAny`'s `millis` instead.** This was originally built to\n",
    "   * be that: a timer ticket in the `waitAny` list, whichever lands first wins. It works, and\n",
    "   * it is the wrong shape — the ticket costs a ring slot, cannot be written inline (there\n",
    "   * would be nothing left to cancel), and has to be disposed of on every path or the ring\n",
    "   * fills up and the next call stops the program. `Atomics.wait` already takes a timeout, so\n",
    "   * the deadline needs no ticket, no slot and no cleanup at all.\n",
    "   *\n",
    "   * What is left is sleeping, which this is good at and which `waitAny` cannot express: a\n",
    "   * retry backoff, a poll interval, a deliberate pause. It stays in `Core` because a clock\n",
    "   * is not authority and all three hosts have one.\n",
    "   */\n",
    "  fn<Pending<i64>(i32)> sleepMillis;\n",
    "  /**\n",
    "   * Cryptographically secure random bytes, from one byte to a megabyte.\n",
    "   *\n",
    "   * The ceiling is the capability's rather than any host's, and asking for more is a fault instead\n",
    "   * of a short answer: a caller that wanted two megabytes of key material and silently received one\n",
    "   * is the worse failure. The floor of the *implementation* is a host detail that leaked once —\n",
    "   * Web Crypto refuses more than 65,536 bytes in a single call, so two of the three hosts threw on\n",
    "   * everything above that while the third chunked and did not (0122). `example/entropy.wac` walks\n",
    "   * the range on both hosts, one byte past that cap included.\n",
    "   */\n",
    "  fn<Pending<u8[]>(i32)> randomBytes;\n",
    "  /** A line of output. */\n",
    "  fn<void(string)> log;\n",
    "  /** A line of output on the error channel. */\n",
    "  fn<void(string)> warn;\n",
    "\n",
    "  /**\n",
    "   * Block until one of these calls has an answer, and say which — for at most `millis`.\n",
    "   *\n",
    "   * Takes the `id` of each ticket and returns its index in the list. Every id is accepted\n",
    "   * whatever its `Pending<T>`: a relay waits on a `recv` and an `accept` together, and\n",
    "   * their types differ.\n",
    "   *\n",
    "   * **This is the capability the ring exists for.** Overlapping two reads is a\n",
    "   * convenience; waiting on whichever of two *sockets* speaks first is the difference\n",
    "   * between a program being writable and not. `nc`, an SSH relay and a shell all need it,\n",
    "   * and `isDone` alone does not give it to them — polling `isDone` in a loop is a spin,\n",
    "   * which burns a core to avoid parking.\n",
    "   *\n",
    "   * `millis` is the deadline, and **-1 means wait as long as it takes**:\n",
    "   *\n",
    "   *     i32 w = core.waitAny([r.id, a.id], -1);   // until one of them answers\n",
    "   *     i32 w = core.waitAny([r.id], 5000);       // ...or five seconds, whichever first\n",
    "   *     i32 w = core.waitAny([click.id, file.id], 0);   // which is ready right now\n",
    "   *\n",
    "   * **When several are ready, the answer is the first of them in the list you passed** — not the one\n",
    "   * that finished first. Both hosts scan the caller's order and return the first settled ticket:\n",
    "   * `packages/platform/host/call.ts` is `for (const t of tickets) if (isDone(b, t)) return t;`, and\n",
    "   * `native/src/tickets.rs` says why — *\"first in the caller's list rather than first to finish, so the\n",
    "   * answer does not depend on how the threads were scheduled\"*, which is `design/system/0001` D12.\n",
    "   *\n",
    "   * **It is not a statement about when work finishes.** A ticket the host has not marked ready yet is\n",
    "   * not ready, so a 1ms timer that has been descheduled loses to a 2ms one that has not — and no\n",
    "   * tie-break can change that, because there is no tie. `issues/system/0202` was filed on that\n",
    "   * observation and asked which policy to adopt; the policy was already here, and what it saw was the\n",
    "   * other thing. `packages/platform/test/wac/scheduled_test.wac` asserts the tie-break by asking twice\n",
    "   * with the list reversed, which is what separates position from completion.\n",
    "   *\n",
    "   * **Returns -1 when the time ran out**, and also for an empty list, which is the same\n",
    "   * statement: nothing settled. That is how a silent peer is survivable — see\n",
    "   * `example/patience.wac` — and it is why there is no `recvWithin`. A deadline belongs to\n",
    "   * the wait rather than to each capability, so this one parameter bounds `connect`,\n",
    "   * `accept`, `readFile` or a child's `exitCode` without any of them knowing about it.\n",
    "   *\n",
    "   * The deadline **costs nothing**: no opcode, no slot, no ticket to dispose of, because\n",
    "   * `Atomics.wait` takes a timeout and the wait is already in this worker's own memory. An\n",
    "   * earlier design passed a timer ticket in the list instead; it worked, and every caller\n",
    "   * had to remember to cancel the loser or lose a slot for good. `core.sleepMillis` remains\n",
    "   * for *sleeping*, which is a different thing from a deadline.\n",
    "   *\n",
    "   * Blocking, and it reaches no further than this worker's own memory: the wait is on the\n",
    "   * completion counter the host bumps, so it takes no slot and cannot deadlock the ring\n",
    "   * however many tickets are outstanding.\n",
    "   *\n",
    "   * **In `Core` rather than `Cli`**, which it was not at first and should have been. It grants\n",
    "   * nothing — it cannot start work, only notice that some has finished — and it is the same in\n",
    "   * every host, which is what `Core` means. Keeping it beside the filesystem left an\n",
    "   * interactive page unable to wait on a click *or* a dropped file, and that is exactly the\n",
    "   * question this exists to answer.\n",
    "   */\n",
    "  fn<i32(i32[], i32)> waitAny;\n",
    "\n",
    "  /**\n",
    "   * Whether the user has asked to interrupt what is running — `^C`, and nothing else.\n",
    "   *\n",
    "   * **The seam design/system/0001 step 5 was missing, and it is on `Core` rather than on the shell.**\n",
    "   * A signal here is cooperative: `kill` writes on a row in the process table and the receiver\n",
    "   * collects it at its next check point. That reaches a shell *between* commands and cannot reach a\n",
    "   * running one, because a running applet is inside `dispatch` and the shell's check points are not\n",
    "   * executing. An applet is handed `Core`, `Cli`, `Fs` and `Args` and never a `Page` or a `Conn`, so\n",
    "   * whatever it polls must be one of those four.\n",
    "   *\n",
    "   * **Only a host that owns the keyboard can answer yes, and today none does.** Under Deno, Node and\n",
    "   * wasmtime the terminal belongs to whatever started the program — over ssh, to `sshd` on the far\n",
    "   * side of an encrypted socket — so those answer *no*. The one that answered yes was std's `Page` on\n",
    "   * the browser host, which is gone (design/system/0011 step 7); a `packages/web` terminal hands its\n",
    "   * shell an interrupt of its own, `Shell.askInterrupt`. `issues/system/0363a` is whether this goes.\n",
    "   *\n",
    "   * Reading clears it, so two callers do not both act on one `^C`.\n",
    "   *\n",
    "   * `i32` because that is what crosses; `interrupted()` is the read.\n",
    "   */\n",
    "  fn<i32()> askInterrupt;\n",
    "\n",
    "  /**\n",
    "   * End the program now with this status, abandoning whatever is left — `Sys.exit` (spec ch07).\n",
    "   * Does not return: the host unwinds the program to the call of its `main`.\n",
    "   */\n",
    "  fn<void(i32)> exit;\n",
    "\n",
    "  /**\n",
    "   * The world\\'s scheduler — where a continuation registered with `then` waits its turn.\n",
    "   *\n",
    "   * **A program never names this.** It reaches it through `delay`, `drain` and `dropAll` below, which\n",
    "   * read as what they are: things this world can do. The scheduler is a value the host builds at\n",
    "   * start-up and hands over with the rest of the capabilities, which is what keeps \"no ambient\n",
    "   * anything\" true — a program given no world cannot schedule.\n",
    "   *\n",
    "   * A field rather than a funcref, unlike everything else here, because the methods below are wac\n",
    "   * code over it rather than host calls. The host has only to construct it.\n",
    "   */\n",
    "  Sched sched;\n",
    "\n",
    "  /**\n",
    "   * A ticket that settles after `millis`, already able to carry a continuation.\n",
    "   *\n",
    "   * `sleepMillis` is the ticket; the only thing added is where its continuations go. So\n",
    "   * `core.delay(500).wait()` is the sleep it always was, and `core.delay(500).then(f)` is the same\n",
    "   * ticket with a continuation on it.\n",
    "   */\n",
    "  Pending<i64> delay(const this, i32 millis) {\n",
    "    return this.sleepMillis(millis);\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Take back the continuation put on the ticket with this id, if it still has one.\n",
    "   *\n",
    "   * **The counterpart of `then` for work that is abandoned rather than finished.** A continuation\n",
    "   * that re-arms needs nothing from this — `run` unregisters a handler before running it — so this is\n",
    "   * for a caller giving up: a relay dropping a connection takes back the reads outstanding on that\n",
    "   * connection's other sockets, which would otherwise fire against a closed handle. The ticket's own\n",
    "   * `drop` runs, so the host's slot is released rather than leaked.\n",
    "   *\n",
    "   * **On `Core` and taking an id, rather than on `Pending<T>`**, and not for the reason this once\n",
    "   * gave: `issues/lang/0292c` claimed a method on that struct could not be added at all, and closed\n",
    "   * as not a bug — it was a duplicate member, because `cancel` was already there.\n",
    "   *\n",
    "   * The real reason is `const`. The obvious home is inside `Pending.cancel`, which drops the host's\n",
    "   * ticket and should plainly take the continuation off with it. But that method is `const this` —\n",
    "   * load-bearing, since it is called from the const methods that hold most of `packages/sh` and\n",
    "   * `packages/ssh` — and detaching writes to a `Sched` the whole program shares:\n",
    "   *\n",
    "   *     error: a non-const reference cannot be taken from a const one\n",
    "   *       |     if (this.sched is not null) { this.sched!.off(this.id); }\n",
    "   *       |                                              ^\n",
    "   *\n",
    "   * So the two halves of *stop caring* are split by who may write: the ticket's own half is const\n",
    "   * and lives on `Pending`, and the scheduler's half is not and lives here. A caller that wants\n",
    "   * both does `p.cancel()` and `core.cancel(p.id)`, which is worth a single call one day and needs\n",
    "   * a mutable `Pending` to have one.\n",
    "   */\n",
    "  bool cancel(this, i32 id) { return this.sched.off(id); }\n",
    "\n",
    "  /**\n",
    "   * Take a continuation back **without** abandoning its ticket — `Sched.detach`.\n",
    "   *\n",
    "   * `cancel` is for giving up; this is for taking over. A caller that is about to resolve a ticket\n",
    "   * itself has to unregister first or the answer is delivered twice, and it must not let the ticket\n",
    "   * be dropped on the way out or there is nothing left to resolve.\n",
    "   */\n",
    "  bool detach(this, i32 id) { return this.sched.detach(id); }\n",
    "\n",
    "  /**\n",
    "   * Run continuations until none are outstanding. Answers how many ran.\n",
    "   *\n",
    "   * **The program says when.** There is no second stack here — a park in `waitAny` runs nothing at\n",
    "   * all — so a continuation can only run inside a call that dispatches, and this is that call. A\n",
    "   * `main` that schedules and returns without draining leaves work outstanding, which the host\n",
    "   * treats as an error; `dropAll` is how a program says it meant to.\n",
    "   */\n",
    "  i32 drain(this) { return this.drainWithin(0 - 1); }\n",
    "\n",
    "  /**\n",
    "   * `drain`, bounded: ready continuations first, then one round of the host's — a continuation whose\n",
    "   * ticket has settled runs, one still waiting goes back in order, and when none could run one\n",
    "   * `waitAny` answers whichever host ticket is first, which may settle a ticket a continuation waits\n",
    "   * on. Answers how many host answers it dispatched, which is what it answered before continuations\n",
    "   * were queued here. `millis` below zero is no bound.\n",
    "   */\n",
    "  i32 drainWithin(this, i32 millis) { return this.drainUntil(millis, null); }\n",
    "\n",
    "  /**\n",
    "   * `drainWithin`, stopping as soon as `until` has settled — how a program's `async` `main` is run\n",
    "   * with its unawaited work alongside (`Sys.__wacSettle`). Null is no such stop.\n",
    "   */\n",
    "  i32 drainUntil(this, i32 millis, TicketBase? until) {\n",
    "    bool bounded = millis >= 0;\n",
    "    i64 deadline = 0 as i64;\n",
    "    if (bounded) { deadline = this.monotonicNanos().wait() + millisToNanos(millis); }\n",
    "    i32 ran = 0;\n",
    "    while (true) {\n",
    "      if (until is not null && until!.done) { return ran; }\n",
    "      Queue<Continuation> later;\n",
    "      bool moved = false;\n",
    "      while (true) {\n",
    "        Continuation? c = this.sched.queued.pop();\n",
    "        if (c is null) { break; }\n",
    "        // One a `wait` already ran past does nothing when called, and is not work left.\n",
    "        if (!c!.current()) { continue; }\n",
    "        TicketBase? on = c!.t;\n",
    "        if (on is null || on!.done) {\n",
    "          c!.call();\n",
    "          moved = true;\n",
    "        } else {\n",
    "          later.push(c!);\n",
    "        }\n",
    "      }\n",
    "      while (true) {\n",
    "        Continuation? back = later.pop();\n",
    "        if (back is null) { break; }\n",
    "        this.sched.queued.push(back!);\n",
    "      }\n",
    "      if (moved) { continue; }\n",
    "      if (this.sched.pending() == 0) { return ran; }\n",
    "      i32 budget = 0 - 1;\n",
    "      if (bounded) {\n",
    "        i64 left = deadline - this.monotonicNanos().wait();\n",
    "        if (left <= 0 as i64) { return ran; }\n",
    "        budget = (left / (1000000 as i64)) as! i32;\n",
    "      }\n",
    "      i32 one = this.sched.runOne(this, budget);\n",
    "      if (one == 0) { return ran; }\n",
    "      ran = ran + one;\n",
    "    }\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * `drain`, for at most `millis` — and answers how many ran, so what is left is `outstanding()`.\n",
    "   *\n",
    "   * The budget bounds the whole call rather than each wait, which is the only reading that is any use:\n",
    "   * a bound per wait is `n` bounds for `n` continuations, and none at all once a handler re-arms.\n",
    "   *\n",
    "   * **What is left over is still outstanding**, so a program that leaves after a partial drain gets the\n",
    "   * same error as one that never drained. Running out of time is not a decision; `dropAll` is.\n",
    "   */\n",
    "  i32 drainFor(this, i32 millis) { return this.drainWithin(millis); }\n",
    "\n",
    "  /**\n",
    "   * Abandon every outstanding continuation, releasing each ticket. Answers how many there were.\n",
    "   *\n",
    "   * Not `const this`, like `drain` and unlike everything else here: a scheduler reached through a\n",
    "   * `const` receiver is const too, and both of these write to it. That is the aliasing rule doing its\n",
    "   * job — a `Core` held const cannot quietly run somebody\\'s continuations.\n",
    "   */\n",
    "  i32 dropAll(this) {\n",
    "    i32 queued = this.sched.queued.len();\n",
    "    while (this.sched.queued.pop() is not null) { }\n",
    "    return this.sched.dropAll() + queued;\n",
    "  }\n",
    "\n",
    "  /** How much work is outstanding — the question the host asks when `main` returns. */\n",
    "  i32 outstanding(this) { return this.sched.pending() + this.sched.liveQueued(); }\n",
    "\n",
    "  /**\n",
    "   * Whether the user has asked to interrupt. Call it once per *block* of work, never per byte:\n",
    "   * every opcode parks the worker, so this is a round trip.\n",
    "   *\n",
    "   *     while (cli.write(block)) { if (core.interrupted()) { return 130; } }\n",
    "   *\n",
    "   * 130 is `128 + SIGINT`, which is what a shell reports for a program a `^C` ended.\n",
    "   */\n",
    "  bool interrupted(const this) { return this.askInterrupt() != 0; }\n",
    "\n",
    "  Core of(\n",
    "    fn<Pending<i64>()> nowMillis,\n",
    "    fn<Pending<i64>()> monotonicNanos,\n",
    "    fn<Pending<i64>(i32)> sleepMillis,\n",
    "    fn<Pending<u8[]>(i32)> randomBytes,\n",
    "    fn<void(string)> log,\n",
    "    fn<void(string)> warn,\n",
    "    fn<i32(i32[], i32)> waitAny,\n",
    "    fn<i32()> askInterrupt,\n",
    "    fn<void(i32)> exit,\n",
    "    Sched sched\n",
    "  ) {\n",
    "    // **Linked here, once, rather than by every caller.** These four are the only capabilities\n",
    "    // `Core` answers with a ticket, and `Core` is the thing that dispatches — so a ticket it handed\n",
    "    // out arrives able to carry a continuation. `then` on an unlinked ticket is a bare trap, and\n",
    "    // requiring `core.randomBytes(8).linkedTo(core).then(f)` made the world ask the caller to hand\n",
    "    // it back something it already had.\n",
    "    // The program's own queue is the schedule target where no `schedule` statement is in force\n",
    "    // (`§wac-schedule-default-is8g8z4`) — the first world's, which is the host's: a `Core` a test\n",
    "    // builds afterwards must not take the program's continuations away from it.\n",
    "    if (__wacScheduleTarget() is null) { __wacSetScheduleTarget(sched.queued.push); }\n",
    "    return Core(() => nowMillis().on(sched),\n",
    "                () => monotonicNanos().on(sched),\n",
    "                (i32 ms) => sleepMillis(ms).on(sched),\n",
    "                (i32 n) => randomBytes(n).on(sched),\n",
    "                log, warn, waitAny, askInterrupt, exit, sched);\n",
    "  }\n",
    "}\n",
    "\n",
    "/** What a path is, if it is anything. Everything is zero or false when `exists` is false. */\n",
    "/**\n",
    " * Why a filesystem change did not happen, in a form a program can act on.\n",
    " *\n",
    " * **Integers rather than an enum**, which is the opposite of `Read` above and for a reason that\n",
    " * survives asking: a fault is *compared* (`rm -f` wants to know whether it was merely absent), and a\n",
    " * wac enum is a reference type with no `==` — payload-less variants allocate, so even `is` would be\n",
    " * false between two `NotFound`s. `ERR_*` in `packages/http` and `GRANT_*` below are the same shape\n",
    " * for the same reason. If enums ever compare by value, this becomes one.\n",
    " *\n",
    " * A category *and* the host's message, because neither replaces the other: the category is what a\n",
    " * program branches on, and the message is what a person reads. Matching the message's words to\n",
    " * recover the category — which is what an applet had to do before this existed — is a guess about\n",
    " * three operating systems.\n",
    " */\n",
    "export i32 FAULT_NONE() { return 0; }\n",
    "export i32 FAULT_NOT_FOUND() { return 1; }\n",
    "export i32 FAULT_DENIED() { return 2; }\n",
    "export i32 FAULT_EXISTS() { return 3; }\n",
    "export i32 FAULT_NOT_EMPTY() { return 4; }\n",
    "/** The host said something this world has no category for; the message is all there is. */\n",
    "export i32 FAULT_OTHER() { return 5; }\n",
    "/**\n",
    " * The host cannot express this name, so the operation was never attempted.\n",
    " *\n",
    " * Not the same as absent, and the difference is visible from a shell: `ls` in a directory holding a file\n",
    " * whose name is not valid UTF-8 lists `bad-\\ufffd-name`, and every attempt to open *that* answers \"no such\n",
    " * file or directory\" — a file you can see and cannot touch, with the blame on whoever typed it.\n",
    " *\n",
    " * Measured on Deno, which is where this world mostly runs: `Deno.readDir` replaces the invalid bytes with\n",
    " * U+FFFD, and `Deno.stat` of the name it just handed you fails `NotFound`. There is no byte-oriented path\n",
    " * in that API, so the file is genuinely unnameable from here — this is not a conversion this repository can fix by\n",
    " * changing a signature, which is what wac-mono 0065 assumed at first. Node's `fs` takes a `Buffer` and\n",
    " * could do it; the Deno host cannot, and says so.\n",
    " */\n",
    "export i32 FAULT_NOT_REPRESENTABLE() { return 6; }\n",
    "\n",
    "/**\n",
    " * The program was not given this capability.\n",
    " *\n",
    " * Not an operating-system failure, which is why it is not `FAULT_DENIED`: that one is the file saying no,\n",
    " * and this one is the program never having been handed the file. A caller wants to say different things\n",
    " * about them, and until this existed it could not tell them apart — a withheld filesystem and a\n",
    " * `chmod 000` were the same category with different sentences.\n",
    " *\n",
    " * **`faultWords` has a phrase for it, and used not to.** The argument for having none was that the host's\n",
    " * own sentence — \"filesystem read not granted to this application\" — says what no errno phrase can, and a\n",
    " * caller falling back to the message would print exactly the right thing. That holds only where there *is*\n",
    " * a message: `Change` and `FileResult` carry one, and **`Stat` does not**. So `stat: cannot tell — ` was\n",
    " * what a program printed for the answer this category exists to give, with nothing after the dash.\n",
    " */\n",
    "export i32 FAULT_NOT_GRANTED() { return 7; }\n",
    "\n",
    "/**\n",
    " * A directory where a file was wanted.\n",
    " *\n",
    " * The eighth, and the argument against it was that this taxonomy is not errno granularity. What\n",
    " * overruled it: a program *branches* on this. `cat` on a directory and `cat` on a missing file are\n",
    " * different mistakes and every real tool says so, and wac-mono 0067 recorded the question when\n",
    " * `Fs.readFile` had to answer `FAULT_OTHER` for it. Without a category the host's own sentence was the\n",
    " * only information, so a read of a directory reached the output as \"Is a directory (os error 21)\" — an\n",
    " * errno, no filename, and a different sentence per runtime.\n",
    " */\n",
    "export i32 FAULT_IS_DIR() { return 8; }\n",
    "\n",
    "/**\n",
    " * **We have not written this.** Not the file's fault, not the build's, and not the host's.\n",
    " *\n",
    " * The ninth, and it exists because the closest available word was reaching users as a lie. `Fs.chmod`\n",
    " * on a host mount is not implemented and said so in its *message* — while answering `FAULT_DENIED`,\n",
    " * because that was the nearest category. `packages/sh` renders a fault as `faultWords` gives it, so\n",
    " * \"we have not written this\" arrived as `chmod: cannot access 'o': Permission denied`, which blames\n",
    " * the file for something the file did not do. GNU succeeds there: `chmod` wants ownership, not read.\n",
    " *\n",
    " * `faultWords` deliberately has **no phrase** for it, which is not an oversight but the mechanism:\n",
    " * every caller already spells the empty case as `words == \"\" ? f.error : words`, so the *message* is\n",
    " * what reaches the user — and the message is the only thing that can say **what** is unimplemented.\n",
    " * A category with fixed words would say less than the sentence it replaced.\n",
    " *\n",
    " * So why a category at all, if it prints the message either way? Because a caller can **branch** on\n",
    " * it, which is the same argument `FAULT_IS_DIR` won on. `FAULT_OTHER` means \"the host said something\n",
    " * no category covers\" — a real failure, out there. This one means the request never reached a host.\n",
    " * A program deciding whether to try another route needs to tell those apart, and until now could not.\n",
    " *\n",
    " * wac-mono 0117.\n",
    " */\n",
    "export i32 FAULT_UNSUPPORTED() { return 9; }\n",
    "\n",
    "/**\n",
    " * A file where a directory was wanted — `ENOTDIR`, the other half of `FAULT_IS_DIR`.\n",
    " *\n",
    " * The tenth, and it is the one the taxonomy could least afford to be without, because **every operation\n",
    " * can hit it**: any path with a `/` in it walks components, and a component that turns out to be a file\n",
    " * fails this way. `FAULT_IS_DIR` is one operation on one path; this is `f/g` for every `f` that is not a\n",
    " * directory, and it had no category at all — so `cat f/g` said `Not a directory (os error 20)` and\n",
    " * `mkdir f/g` said `Not a directory (os error 20): mkdir '/abs/path/f/g'`, an errno and the *host's*\n",
    " * absolute path, in a world whose first claim is that a session cannot see the host it runs on.\n",
    " *\n",
    " * It is a genuinely different answer from absence, which is what it was arriving as. GNU distinguishes\n",
    " * them everywhere — `cat: f/g: Not a directory` against `cat: f/g: No such file or directory` — and a\n",
    " * person needs to: one means fix the name, the other means `f` is not what you thought it was.\n",
    " *\n",
    " * **`stat` is the exception, and deliberately.** `test -e f/g` is *false* in bash rather than an error,\n",
    " * so a stat that hit this still answers \"nothing there\". It now carries the category alongside — see\n",
    " * `statFault` in `host/faults.ts` — so `ls` and `cd` can say which absence it was without `test`\n",
    " * changing its mind.\n",
    " */\n",
    "export i32 FAULT_NOT_A_DIR() { return 10; }\n",
    "\n",
    "/**\n",
    " * The filesystem will not take a write at all — `EROFS`.\n",
    " *\n",
    " * The eleventh, and it was found the same way `FAULT_NOT_A_DIR` was, one layer down: `packages/fs`'s\n",
    " * synthesised backing answers this for `/dev` and `/proc` and had to say it in its *message*, as\n",
    " * `FAULT_DENIED` with the words \"read-only file system\". That worked only for as long as callers\n",
    " * printed the message — the moment `reasonOf` started preferring the category's phrase, which is the\n",
    " * whole point of having categories, a write to `/dev/zero` began saying `Permission denied` and the\n",
    " * one useful fact was gone.\n",
    " *\n",
    " * It is a different answer from `FAULT_DENIED` in the way that matters to whoever reads it: nothing\n",
    " * about this file or this user refused, and no `chmod` will help. `strerror(EROFS)` is \"Read-only file\n",
    " * system\" and that is what `faultWords` says, because it is what bash prints when a redirection lands\n",
    " * on a read-only mount.\n",
    " */\n",
    "export i32 FAULT_READ_ONLY() { return 11; }\n",
    "\n",
    "/**\n",
    " * The name is longer than the host will take — `ENAMETOOLONG`.\n",
    " *\n",
    " * Found by hand, not by a differential: no corpus script has a three-hundred-character filename, so\n",
    " * every two-host comparison agreed, and what they agreed on was `File name too long (os error 36)` —\n",
    " * the operating system's sentence with its errno still attached, where GNU prints the same words and\n",
    " * nothing else. The two hosts matching each other is exactly why this survived; they were both wrong\n",
    " * in the same way, which is the failure a two-host differential cannot see and a real tool can.\n",
    " */\n",
    "export i32 FAULT_NAME_TOO_LONG() { return 12; }\n",
    "\n",
    "/**\n",
    " * A symbolic link that leads back to itself — `ELOOP`.\n",
    " *\n",
    " * The other half of the same find, and the same shape: `cat loop` said \"Too many levels of symbolic\n",
    " * links (os error 40)\" on both hosts where GNU says it without the errno. A filesystem that can make\n",
    " * links can make this one, and `packages/fs` grew `linkStat` this week, so it is reachable now in a\n",
    " * way it was not when the fault table was written.\n",
    " */\n",
    "export i32 FAULT_LOOP() { return 13; }\n",
    "\n",
    "/**\n",
    " * The filesystem will not take any more — `ENOSPC`.\n",
    " *\n",
    " * The one of the three that is **not** the same on both hosts, and the reason is the runtime rather\n",
    " * than the code: Deno refuses `/dev/full` at `open` for want of `--allow-all`, so a JavaScript host\n",
    " * answers `FAULT_NOT_GRANTED` and never reaches the write; the wasmtime host opens it and the write\n",
    " * fails, which is the only place in this repository where `outputError` carries a real reason. Both\n",
    " * answers are true about their own runtime, and the category is what lets a program tell them apart\n",
    " * from each other and from a full disk.\n",
    " */\n",
    "export i32 FAULT_NO_SPACE() { return 14; }\n",
    "\n",
    "/**\n",
    " * The three a *socket* needs, and the reason they are here rather than folded into `FAULT_OTHER`.\n",
    " *\n",
    " * Every code above this line is about a filesystem, and so is `fault_of` in both native hosts: it\n",
    " * maps `NotFound`, `PermissionDenied`, `IsADirectory` and seven more, and everything else falls to\n",
    " * `FAULT_OTHER`. The network capability inherited that vocabulary, so `Socket.fault` could say \"you\n",
    " * were not granted this\" and otherwise only \"something went wrong\" -- a refused connection, a host\n",
    " * with no route to it and one that never answered were one category.\n",
    " *\n",
    " * **They are three answers a person acts on differently**, which is the argument\n",
    " * `packages/tor/src/socks5.wac` already makes for the SOCKS reply codes it maps: \"Connection refused\"\n",
    " * and \"not allowed by ruleset\" send someone to look in different places, and collapsing both to a\n",
    " * general failure sends them nowhere. `issues/system/0255c` is the consumer.\n",
    " */\n",
    "export i32 FAULT_REFUSED() { return 15; }\n",
    "/** Nothing at that address, or no route to it -- `EHOSTUNREACH` and `ENETUNREACH`. */\n",
    "export i32 FAULT_UNREACHABLE() { return 16; }\n",
    "/** It never answered. Distinct from refused: a refusal is an answer. */\n",
    "export i32 FAULT_TIMED_OUT() { return 17; }\n",
    "\n",
    "/**\n",
    " * A fault in the words the real tools use, or `\"\"` where the category has none to give.\n",
    " *\n",
    " * One table, because there were four: `sh` had one for a `Change` and another for a `FileResult`, `box`\n",
    " * had a third, and a fourth was about to be written for `Stat`. Four copies of a phrase list drift, and\n",
    " * the drift is invisible — each one is only read when something has already gone wrong. The `sh` and `box`\n",
    " * copies had already diverged: one of them had no phrase for `FAULT_NOT_REPRESENTABLE` and said the host's\n",
    " * English instead, which is the exact failure the category was added to prevent.\n",
    " *\n",
    " * The words are GNU's, deliberately, because that is what our differential tests compare against and what\n",
    " * a person reading a shell's output expects: `No such file or directory`, not `os error 2`. The\n",
    " * capability layer is the right home for them — a fault number is meaningless without them, and every\n",
    " * struct that carries one is declared here.\n",
    " *\n",
    " * `\"\"` for `FAULT_OTHER` and `FAULT_NONE`: the first means the host had something to say that no category\n",
    " * covers, so the caller should print *its* message rather than a category's, and the second is not a\n",
    " * failure at all. Callers spell that as `words == \"\" ? f.error : words`, which is the shape all four\n",
    " * copies already had.\n",
    " */\n",
    "export string faultWords(i32 fault) {\n",
    "  if (fault == FAULT_NOT_FOUND()) { return \"No such file or directory\"; }\n",
    "  if (fault == FAULT_DENIED()) { return \"Permission denied\"; }\n",
    "  if (fault == FAULT_EXISTS()) { return \"File exists\"; }\n",
    "  if (fault == FAULT_NOT_EMPTY()) { return \"Directory not empty\"; }\n",
    "  // Not GNU's words, because GNU has none for this: a filesystem it can name every file in has no reason\n",
    "  // to. Saying the host cannot express the name is the true sentence, and it beats \"No such file or\n",
    "  // directory\" for a file the caller has just seen in `ls`. wac-mono 0065.\n",
    "  if (fault == FAULT_NOT_REPRESENTABLE()) { return \"cannot be named on this host\"; }\n",
    "  // Also not GNU's, for the same reason: a program the operating system runs was granted everything the\n",
    "  // operating system has, so GNU never had to say this. It is the sentence a caller most needs, because it\n",
    "  // is the one failure that is nothing to do with the file.\n",
    "  if (fault == FAULT_NOT_GRANTED()) { return \"Not granted to this application\"; }\n",
    "  // Capitalised, like the rest here and like `strerror`, which is where GNU's wording comes from.\n",
    "  if (fault == FAULT_IS_DIR()) { return \"Is a directory\"; }\n",
    "  // `strerror(ENOTDIR)`, and GNU prints exactly this and nothing else — no errno, no path beyond the one\n",
    "  // the user typed. Compared against `/bin/cat`, `/bin/mkdir` and the rest in `box/test/notdir.test.ts`.\n",
    "  if (fault == FAULT_NOT_A_DIR()) { return \"Not a directory\"; }\n",
    "  // `strerror(EROFS)`, which is what bash prints for a redirection onto a read-only mount.\n",
    "  if (fault == FAULT_READ_ONLY()) { return \"Read-only file system\"; }\n",
    "  // The next three are `strerror` too, and each is what GNU prints with no errno after it: compared\n",
    "  // against `cat`, `wc` and a redirection in `native_hostfs`, on both hosts.\n",
    "  if (fault == FAULT_NAME_TOO_LONG()) { return \"File name too long\"; }\n",
    "  if (fault == FAULT_LOOP()) { return \"Too many levels of symbolic links\"; }\n",
    "  if (fault == FAULT_NO_SPACE()) { return \"No space left on device\"; }\n",
    "  // `strerror`'s words for ECONNREFUSED, EHOSTUNREACH and ETIMEDOUT, so a program that prints a\n",
    "  // socket failure says what `nc` and `curl` say.\n",
    "  if (fault == FAULT_REFUSED()) { return \"Connection refused\"; }\n",
    "  if (fault == FAULT_UNREACHABLE()) { return \"No route to host\"; }\n",
    "  if (fault == FAULT_TIMED_OUT()) { return \"Connection timed out\"; }\n",
    "  // `FAULT_UNSUPPORTED` falls through to `\"\"` on purpose — see its own comment. The message says what\n",
    "  // is unimplemented, and no fixed phrase could.\n",
    "  return \"\";\n",
    "}\n",
    "\n",
    "/**\n",
    " * Why a failed `Change` failed, in the words the tool this world imitates uses.\n",
    " *\n",
    " * A fault the world has a *category* for gets the category's phrase; anything else keeps the host's own\n",
    " * message, which is then the only thing that knows. That distinction is what the fault numbers are for:\n",
    " * the host's words differ per platform and per runtime — `File exists (os error 17): mkdir '/tmp/x'`\n",
    " * under Deno, `EEXIST: file already exists, mkdir '/tmp/x'` under Node, `already exists` in a browser —\n",
    " * while what happened does not.\n",
    " *\n",
    " * **Here rather than in `packages/sh`, which is where it was.** `sh`'s builtins had it and `box`'s\n",
    " * applets did not, and they are the same programs: `mkdir` is a builtin of one and an applet of the\n",
    " * other, so the same failure printed GNU's four words through the shell and an errno with the host's\n",
    " * absolute path through the applet. Two applets had gone further and inlined a *one-row* copy of the\n",
    " * table — `c.fault == FAULT_EXISTS() ? \"File exists\" : c.message` — which is the drift `faultWords`\n",
    " * exists to stop, one row at a time. It belongs beside the phrases, where anything holding a fault can\n",
    " * reach it.\n",
    " */\n",
    "export string reasonOf(Change c) {\n",
    "  string words = faultWords(c.fault);\n",
    "  return words == \"\" ? c.message : words;\n",
    "}\n",
    "\n",
    "/** The same, for a read that failed: `FileResult` carries its host sentence as `error`. */\n",
    "export string readReason(FileResult f) {\n",
    "  string words = faultWords(f.fault);\n",
    "  return words == \"\" ? f.error : words;\n",
    "}\n",
    "\n",
    "/**\n",
    " * The same, for a program that did not do what was asked — and the **killed** case is why it exists.\n",
    " *\n",
    " * Every caller writes the same phrase by hand: `e.error + string.fromBytes(e.stderr)`. It is right for\n",
    " * the two ordinary outcomes and renders the third as nothing at all. `error` is empty whenever the\n",
    " * program started, and a child killed by a signal writes no `stderr` before it dies — so an\n",
    " * out-of-memory kill prints as a sentence that stops after the dash. A reason with no cause in it is\n",
    " * what `issues/system/0142` is a page of.\n",
    " *\n",
    " * Takes no status, because `std` has no integer formatter and the caller has the number anyway.\n",
    " */\n",
    "export string execReason(Exec r) {\n",
    "  if (!r.ran()) { return r.error; }\n",
    "  if (r.signalled()) {\n",
    "    return \"killed by a signal, having written nothing — on a shared machine the usual cause is memory\";\n",
    "  }\n",
    "  string said = string.fromBytes(r.stderr);\n",
    "  return said.len() > 0 ? said : \"exited non-zero and said nothing\";\n",
    "}\n",
    "\n",
    "/** What a filesystem change answered. */\n",
    "/**\n",
    " * What a host program did: `Cli.exec`'s answer.\n",
    " *\n",
    " * **`status` is an exit code, not a fault.** A program that ran and exited non-zero is a different\n",
    " * fact from a program that could not be started, and every differential oracle in this repository\n",
    " * asserts on the first constantly — the interesting case for `openssl`, `python3` or `git` is\n",
    " * usually the input the reference implementation *rejects*. So a refusal to start is reported in\n",
    " * `error`, which is empty whenever the program ran at all, whatever it then did.\n",
    " *\n",
    " * `stdout` and `stderr` are bytes and stay separate. Bytes because a compressor's output is not\n",
    " * text and a lossy decode would corrupt exactly the differential it was fetched for; separate\n",
    " * because merging them makes a warning indistinguishable from an answer.\n",
    " *\n",
    " * `issues/system/0165`.\n",
    " */\n",
    "export struct Exec {\n",
    "  /**\n",
    "   * The exit code, when the program ran. Meaningless when `error` is non-empty.\n",
    "   *\n",
    "   * **`-1` means the child died by a signal rather than exiting**, and it is a real value rather than\n",
    "   * an absence: a signalled process has no exit code at all, so all four hosts write `code ?? -1`.\n",
    "   * It is safe as a sentinel because a POSIX status is eight bits — no child that *exited* can\n",
    "   * produce it — which is the one thing that saves it from being a sentinel drawn from the value's own\n",
    "   * range. Read it through `signalled()` rather than by comparing, so the convention has a name.\n",
    "   *\n",
    "   * `ran()` is still true for such a child: it started, and a signal is how it ended.\n",
    "   */\n",
    "  i32 status;\n",
    "  u8[] stdout;\n",
    "  u8[] stderr;\n",
    "  /**\n",
    "   * Why it could not be started, and **empty when it was** — including when it then failed.\n",
    "   *\n",
    "   * `FAULT_NOT_GRANTED`'s message appears here too: a build without `--allow-run` is told it was\n",
    "   * not granted, rather than being handed a plausible-looking empty answer.\n",
    "   */\n",
    "  string error;\n",
    "\n",
    "  Exec of(i32 status, u8[] stdout, u8[] stderr, string error) {\n",
    "    return Exec(status, stdout, stderr, error);\n",
    "  }\n",
    "\n",
    "  /** Whether the program started. Says nothing about whether it succeeded — read `status` for that. */\n",
    "  bool ran(const this) { return this.error.len() == 0; }\n",
    "\n",
    "  /** Whether it ran **and** exited zero, which is what most callers mean by \"it worked\". */\n",
    "  bool ok(const this) { return this.ran() && this.status == 0; }\n",
    "\n",
    "  /**\n",
    "   * Whether it started and was **killed** rather than exiting — see `status`.\n",
    "   *\n",
    "   * Worth a name because the alternative is every caller writing `status == 0 - 1`, and because the\n",
    "   * two facts a caller usually wants to separate are \"it failed\" and \"it was killed\": an out-of-memory\n",
    "   * kill and a program that exited non-zero are the same `!ok()` and very different problems. The\n",
    "   * signal *number* is not carried — the hosts do not report it — so this says that it happened and\n",
    "   * not which one.\n",
    "   */\n",
    "  bool signalled(const this) { return this.ran() && this.status == 0 - 1; }\n",
    "}\n",
    "\n",
    "export struct Change {\n",
    "  /** `FAULT_NONE` when it worked. */\n",
    "  i32 fault;\n",
    "  /** The host's own words, and empty when it worked. */\n",
    "  string message;\n",
    "\n",
    "  Change of(i32 fault, string message) { return Change(fault, message); }\n",
    "\n",
    "  bool ok(const this) { return this.fault == FAULT_NONE(); }\n",
    "\n",
    "  /**\n",
    "   * Whether the thing was simply not there — the case `rm -f` is allowed to ignore.\n",
    "   *\n",
    "   * Before this, `remove` answered a message and `rm -f` had to ask `stat` first, which is both an\n",
    "   * extra call and a race: a file can vanish between the two. Asking the failure itself cannot race\n",
    "   * with anything.\n",
    "   *\n",
    "   * **`FAULT_NOT_A_DIR` counts, and this is what GNU does.** `rm -f f/g` where `f` is a file exits 0\n",
    "   * and says nothing, exactly as `rm -f nosuch` does, because both mean \"there is nothing at that\n",
    "   * path\". Ours failed with a diagnostic — first because `ENOTDIR` had no category at all and landed in\n",
    "   * `FAULT_OTHER`, then, once it had one, because this method still named only the one. The `-f` in\n",
    "   * `rm -rf build/x/y` is written for precisely this: a path whose middle turned out not to be there.\n",
    "   */\n",
    "  bool absent(const this) {\n",
    "    return this.fault == FAULT_NOT_FOUND() || this.fault == FAULT_NOT_A_DIR();\n",
    "  }\n",
    "}\n",
    "\n",
    "export struct Stat {\n",
    "  bool exists;\n",
    "  bool isFile;\n",
    "  bool isDir;\n",
    "  i64 size;\n",
    "  /** Milliseconds since the epoch, or 0 where the host does not say. */\n",
    "  i64 modifiedMillis;\n",
    "  /**\n",
    "   * Whether the path itself is a symbolic link.\n",
    "   *\n",
    "   * **Always false from `stat`**, which follows links and therefore describes what one leads to.\n",
    "   * `linkStat` is the one that answers this. Both exist because both questions are real: `find`\n",
    "   * wants to know whether to descend into what a name leads to, and `tar` wants to know whether the\n",
    "   * name is a link before it stores anything.\n",
    "   */\n",
    "  bool isSymlink;\n",
    "\n",
    "  /**\n",
    "   * Whether the owner-execute bit is set.\n",
    "   *\n",
    "   * **One bit, not a mode**, for the reason `Cli.setExecutable` gives. It is what distinguishes git's\n",
    "   * `100644` from its `100755`, and building a tree from a working tree cannot tell them apart without it\n",
    "   * — every blob was recorded as `100644`, which made a commit of an executable record a mode change\n",
    "   * nobody asked for. issues/system/0132.\n",
    "   *\n",
    "   * **False where the host has no mode bits**, which is a true answer rather than a stand-in: a browser's\n",
    "   * OPFS does not have them, so nothing there is executable and saying so is correct.\n",
    "   */\n",
    "  bool isExecutable;\n",
    "\n",
    "  /**\n",
    "   * Why this is not an answer, or `FAULT_NONE` when it is.\n",
    "   *\n",
    "   * **Absence is an answer, not a fault.** A path that is simply not there gives `exists = false` with\n",
    "   * `FAULT_NONE`, because \"there is nothing here\" is what `stat` was asked. A fault means the question\n",
    "   * could not be *reached*: `FAULT_NOT_GRANTED` when the world has no read capability, `FAULT_DENIED`\n",
    "   * when it has one and the operating system refused anyway, and\n",
    "   * `FAULT_NOT_REPRESENTABLE` for a name this host cannot express — a file `ls` has just listed, whose\n",
    "   * name came back from `readDir` with an invalid byte replaced, so every path built from it fails.\n",
    "   *\n",
    "   * Before this field, both of those arrived as `exists = false`: `test -e` said no about a file that is\n",
    "   * there, and a program with no read grant could not tell \"absent\" from \"not allowed to look\". wac-mono\n",
    "   * 0065 left this open on the grounds that giving `Stat` a fault changes every caller. It does, and the\n",
    "   * callers are better for it — a caller that only wants existence still reads `exists`, and one that\n",
    "   * reports to a person now has something true to say.\n",
    "   *\n",
    "   * So: **check `fault` before trusting `exists`.**\n",
    "   *\n",
    "   * ## The exception, which is `FAULT_NOT_A_DIR`\n",
    "   *\n",
    "   * There is one fault here that does *not* mean the question went unreached: `f/g` where `f` is a\n",
    "   * file. The host is certain, `exists = false` is exactly right, and the extra thing to say is which\n",
    "   * kind of nothing it is. Every real tool distinguishes them — `cat: f/g: Not a directory` against\n",
    "   * `cat: f/g: No such file or directory` — and bash's `test -e f/g` is nonetheless plain *false*\n",
    "   * rather than an error, so a caller that only wanted existence must not start failing.\n",
    "   *\n",
    "   * So this one rides along with the facts intact, and `answered` is what draws the line. `statFault`\n",
    "   * in `host/faults.ts` decides which faults reach a `Stat` at all, and `faults_agree.test.ts` holds\n",
    "   * the two ends together.\n",
    "   */\n",
    "  i32 fault;\n",
    "\n",
    "  /** The permission bits, `0644` and the like, with set-id and sticky above them — 0 where the host has none. */\n",
    "  i32 mode;\n",
    "\n",
    "  /**\n",
    "   * Who owns it, by name, in a store that keeps owners (`MemoryStore`) — and `\"\"` from the host, which does not\n",
    "   * track owners for a program: its owners are numbers in somebody else's user table.\n",
    "   */\n",
    "  string owner;\n",
    "\n",
    "  /** A host's answer, which carries no owner. */\n",
    "  Stat of(bool exists, bool isFile, bool isDir, i64 size, i64 modifiedMillis, bool isSymlink,\n",
    "          bool isExecutable, i32 fault, i32 mode) {\n",
    "    return Stat(exists, isFile, isDir, size, modifiedMillis, isSymlink, isExecutable, fault, mode, \"\");\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Whether `exists`, `isFile` and `isDir` can be trusted.\n",
    "   *\n",
    "   * Not `fault == FAULT_NONE()`, which is what it was: `FAULT_NOT_A_DIR` is a fault whose facts are\n",
    "   * *sound* — see the field above — and every caller here treats a false answer as \"the question could\n",
    "   * not be reached\", which for that one would be untrue. `test -e f/g` would have begun exiting 2 with\n",
    "   * a diagnostic where bash says false.\n",
    "   *\n",
    "   * The list is short and belongs in one place rather than spelled out at each of the five call sites,\n",
    "   * which is the whole reason this method exists.\n",
    "   */\n",
    "  bool answered(this) {\n",
    "    return this.fault == FAULT_NONE() || this.fault == FAULT_NOT_A_DIR();\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * This `Stat`'s fault in a real tool's words, or `otherwise` where the category has none.\n",
    "   *\n",
    "   * The fallback is the caller's because it depends on what the caller already knows, and there were\n",
    "   * **four** of these written out separately — the shell's `ls` said `\"Permission denied\"` for a\n",
    "   * directory it could not list, the `ls` applet said the same thing a different way, `cd` and the\n",
    "   * `stat` applet hard-coded `\"No such file or directory\"` and `\"not found\"`, and `packages/sh` had a\n",
    "   * `statReason` saying `\"cannot be examined\"`. Four spellings of `words == \"\" ? something : words`,\n",
    "   * which is how the `ls` builtin came to say GNU's sentence for an absence and the `ls` applet an\n",
    "   * invented one, for the same fault, in the same binary.\n",
    "   *\n",
    "   * Three of those fallbacks were right for their call site; the fourth (`\"not found\"`) was a phrase no\n",
    "   * real tool prints. Passing it in keeps that judgement where it belongs and the lookup in one place.\n",
    "   */\n",
    "  string words(this, string otherwise) {\n",
    "    string found = faultWords(this.fault);\n",
    "    return found == \"\" ? otherwise : found;\n",
    "  }\n",
    "}\n",
    "\n",
    "/**\n",
    " * The command line, the standard streams and the filesystem. Absent in a browser, which\n",
    " * is the honest reason this is not part of `Core`.\n",
    " *\n",
    " * `readStdin` and `write` need no grant, for the same reason `arg` does not: what the\n",
    " * user pipes in and what the program prints are the user's own doing, not a reach into\n",
    " * anything they did not offer. The filesystem is different and is gated.\n",
    " */\n",
    "/**\n",
    " * A socket, or why there isn't one.\n",
    " *\n",
    " * A handle rather than a current-socket, unlike `openInput` and `openOutput`. Those are\n",
    " * one-at-a-time because the transforms take `fn<u8[]()>`, which has no parameter to\n",
    " * carry a handle *in* — not because wac cannot pass context beside a funcref, which it\n",
    " * can;\n",
    " * an `i32` in a struct has no such problem, and a server needs a listener and a\n",
    " * connection open at the same time, so a current-socket could not express it.\n",
    " */\n",
    "export struct HostSocket {\n",
    "  i32 handle;      // negative when `error` is set\n",
    "  string error;\n",
    "  /**\n",
    "   * Who is at the other end, for a socket that came from `accept`. Empty otherwise.\n",
    "   *\n",
    "   * The address only — `127.0.0.1`, or an IPv6 address without brackets — because the port a client\n",
    "   * dialled *from* is of no use to anyone and would invite string parsing at every call site.\n",
    "   *\n",
    "   * A server could not previously log who connected, rate-limit by source, or refuse a non-loopback\n",
    "   * peer. That last one is the check that makes a bind to every interface survivable, and it was not\n",
    "   * expressible: the address exists on the host side and was dropped at the boundary. wac-mono 0025.\n",
    "   */\n",
    "  string peer;\n",
    "\n",
    "  /**\n",
    "   * This socket's own port: what `listen` bound, what `connect` dialled *from*, what an accepted\n",
    "   * socket is served on. Zero when the host does not say.\n",
    "   *\n",
    "   * It exists because port 0 was useless without it. Asking the kernel for a free port is how a server\n",
    "   * avoids a clash it cannot predict — and `listen` answered with a handle alone, so a program that\n",
    "   * asked for 0 got one and could never learn which port it had, which is the same as not being able\n",
    "   * to ask. `platform/test/listen.test.ts` had a comment saying exactly that, above three hardcoded\n",
    "   * port numbers, and one of them collided with another agent's suite run and blocked a push.\n",
    "   */\n",
    "  i32 port;\n",
    "\n",
    "  /**\n",
    "   * Declared here rather than left to bindgen, because the host builds these.\n",
    "   *\n",
    "   * bindgen emits a constructor for a struct that has none, and its name carries the `$` that marks\n",
    "   * a generated identifier — so relying on it means the host reaches for a name no wac source\n",
    "   * mentions. Two lines here and the capability world states its own construction API.\n",
    "   */\n",
    "  HostSocket of(i32 handle, string error, string peer, i32 port, i32 fault) {\n",
    "    return HostSocket(handle, error, peer, port, fault);\n",
    "  }\n",
    "\n",
    "  /** Whether the peer is this machine — the check a server on every interface needs. */\n",
    "  /**\n",
    "   * Why it failed, when `handle` is negative: one of the `FAULT_*` codes, and `FAULT_NONE` on success.\n",
    "   *\n",
    "   * **`FileResult` and `Change` have carried a category for a long time and this did not**, so the one\n",
    "   * refusal a program most needs to tell from an ordinary failure -- \"you were not granted the\n",
    "   * network\" against \"nothing is listening there\" -- was the one with only English to go on. The\n",
    "   * hosts do not even agree on the English: `wacland` says \"network access not granted to this\n",
    "   * application\" and the V8 host says \"Not granted to this application\", so\n",
    "   * `packages/platform/example/probe.wac` matched `\"ot granted\"` with the first letter dropped to\n",
    "   * catch both. That is what this field removes. `issues/system/0238c`.\n",
    "   *\n",
    "   * The same mistake made with `FileResult.error` reported `failed` under both native hosts while the\n",
    "   * confinement was working, which is the worst direction for a program that reports what it may do.\n",
    "   */\n",
    "  i32 fault;\n",
    "\n",
    "  bool fromLoopback(const this) {\n",
    "    return this.peer == \"127.0.0.1\" || this.peer == \"::1\" || this.peer == \"localhost\";\n",
    "  }\n",
    "}\n",
    "\n",
    "/**\n",
    " * One datagram, **and who sent it**, in a single answer.\n",
    " *\n",
    " * The pairing is the whole reason this is a struct rather than two calls. A datagram socket serves\n",
    " * many peers at once, so bytes and sender only mean something together: with `receiveFrom` answering\n",
    " * the payload and a separate `senderOf` answering the address, two datagrams arriving between the two\n",
    " * calls would hand a program one datagram's bytes with another's sender. That is not a race it could\n",
    " * detect — both halves are well-formed, and for QUIC the connection id inside the packet would be the\n",
    " * only clue that the address is wrong. Answering both at once makes the mistake unspellable.\n",
    " *\n",
    " * `peer` is the address alone, as `Socket.peer` is, and `port` is the peer's — *unlike* `Socket.port`,\n",
    " * which is this end's. A reply goes back to exactly this pair, which is why the sender's port is kept\n",
    " * here when a stream socket had no use for it.\n",
    " */\n",
    "export struct Datagram {\n",
    "  u8[] bytes;\n",
    "  /** The sender's address: `127.0.0.1`, or an IPv6 address without brackets. */\n",
    "  string peer;\n",
    "  /** The sender's port. `sendTo(handle, peer, port, …)` is the reply. */\n",
    "  i32 port;\n",
    "  /** Why there is no datagram. Empty on success, and `bytes` is then the payload — which may be empty. */\n",
    "  string error;\n",
    "\n",
    "  /** Declared rather than generated, for the reason `Socket.of` gives: the host builds these. */\n",
    "  Datagram of(u8[] bytes, string peer, i32 port, string error) {\n",
    "    return Datagram(bytes, peer, port, error);\n",
    "  }\n",
    "}\n",
    "\n",
    "/**\n",
    " * A spawned worker, or why there isn't one.\n",
    " *\n",
    " * The handle goes to `recv`, `send`, `waitAny` and `closeSocket` exactly as a socket's does.\n",
    " * That is the point of the design: a child is not a new kind of thing, so a shell running\n",
    " * `a | b` reads one handle and writes another, and watching a child beside a socket is\n",
    " * `waitAny` over two handles that happen to have different origins.\n",
    " */\n",
    "/**\n",
    " * What a spawned child may do, for `Cli.spawn`.\n",
    " *\n",
    " * Bit flags, combined with `|`. The host intersects them with its own grants, so these are a\n",
    " * request rather than an instruction and a parent can never widen what it was given.\n",
    " *\n",
    " * There is deliberately no flag for standard input and output: a child always has those, they\n",
    " * are how a parent talks to it at all, and they reach nothing the parent did not hand over.\n",
    " */\n",
    "export static i32 GRANT_NONE = 0;\n",
    "/** `readFile`, `stat`, `readDir`, `openInput` on a path. */\n",
    "export static i32 GRANT_READ = 1;\n",
    "/** `writeFile`, `mkdir`, `remove`, `rename`, `openOutput` to a path. */\n",
    "export static i32 GRANT_WRITE = 2;\n",
    "/** `connect`, `listen`, `accept` — the child's own sockets, not the parent's. */\n",
    "export static i32 GRANT_NET = 4;\n",
    "/** `env`, which reports every variable unset without it. */\n",
    "export static i32 GRANT_ENV = 8;\n",
    "\n",
    "/**\n",
    " * Running a host program — `Cli.exec`.\n",
    " *\n",
    " * **Bit 16, and added late on purpose.** `Cli.spawn`'s note says there is no bit for this and that a\n",
    " * loaded module which could `exec` would hold the one authority the narrowing exists for. That was\n",
    " * right while the *host* decided grants: nothing could pass it on, so `load_module` hard-coded\n",
    " * `run: false`. With the built-in program holding every capability and deciding what it hands on, the\n",
    " * bit is how it hands this one on — a test runner granting its own oracle the right to spawn, and\n",
    " * nothing else getting it by default. `issues/system/0264c`.\n",
    " */\n",
    "export static i32 GRANT_RUN = 16;\n",
    "/**\n",
    " * Every grant there is: \"narrow nothing\", which is not the same as \"everything\".\n",
    " *\n",
    " * A `spawn` or a `load` asking for this gets the intersection with what the caller holds, so a program\n",
    " * built with no grants hands over none of them whatever it asks. It is the honest spelling for a\n",
    " * caller that means \"as much as I have\": `GRANT_NONE` is the other honest one, and a hand-written\n",
    " * `GRANT_READ | GRANT_WRITE | GRANT_NET | GRANT_ENV` is a fourth thing to keep in step every time a\n",
    " * bit is added.\n",
    " */\n",
    "export i32 GRANT_ALL() { return GRANT_READ | GRANT_WRITE | GRANT_NET | GRANT_ENV | GRANT_RUN; }\n",
    "\n",
    "/**\n",
    " * Which of a child's standard streams are its parent's own, rather than queues the parent reads.\n",
    " *\n",
    " * **Flags in one `i32` rather than a bool each**, which is what `grants` two arguments earlier\n",
    " * already does. Two reasons beyond consistency: they are one question — *which of this child's\n",
    " * streams am I standing in for* — and a capability may not have seven parameters,\n",
    " * `issues/lang/0291c`.\n",
    " */\n",
    "export static i32 INHERIT_NONE = 0;\n",
    "/** `Cli.openFile`'s `how`: read it. */\n",
    "static i32 OPEN_READ = 0;\n",
    "/** `Cli.openFile`'s `how`: write it, created if absent and emptied if not. */\n",
    "static i32 OPEN_WRITE = 1;\n",
    "/** `Cli.openFile`'s `how`: write after what is there, created if absent. */\n",
    "static i32 OPEN_APPEND = 2;\n",
    "/**\n",
    " * The child reads this program's own standard input instead of the queue `send` fills.\n",
    " *\n",
    " * It *streams*, so `yes | sh -c 'head -1'` does not buffer without bound, and it is *shared*, so\n",
    " * `cat; cat` prints one line as it does in every real shell — a parent cannot know how much a child\n",
    " * read, and with this it does not have to.\n",
    " */\n",
    "export static i32 INHERIT_IN = 1;\n",
    "/**\n",
    " * The child writes this program's own output streams instead of queues the parent relays.\n",
    " *\n",
    " * **Without it the order between the two streams is lost**, because two queues record nothing about\n",
    " * which write came first: a diagnostic written between two lines of output arrives after both, so\n",
    " * `echo one; nope; echo two` gave `one two` and then the complaint. `issues/system/0282c`, and it was\n",
    " * a race rather than a fixed reordering — 11 runs in 20.\n",
    " *\n",
    " * **For a launcher, not for a shell.** A parent that wants the bytes — a pipeline, a redirection, a\n",
    " * capture — has to be the one holding them; with this they go straight past it, and `seq 1 3 | wc -l`\n",
    " * printed `1 2 3` and counted `0`. Pass it when the program's whole job is to *be* the thing it\n",
    " * started, which is what `wac <prog.wasm>` is.\n",
    " */\n",
    "export static i32 INHERIT_OUT = 2;\n",
    "/**\n",
    " * **Not a stream: the child outlives its ticket.** A `Pending<Child>` owns its child — dropping it\n",
    " * uncollected stops the child, as `closeSocket` on the handle does — so a child nobody can reach is not\n",
    " * something a program makes by accident. This flag asks for exactly that: fire-and-forget, a child that\n",
    " * runs on with no one holding it. Shares the `inherit` mask because it is a choice about the child made\n",
    " * at the same moment, and a capability may not grow a seventh parameter. `issues/system/0312b`.\n",
    " */\n",
    "export static i32 DETACHED = 4;\n",
    "\n",
    "/**\n",
    " * How many host calls one worker may have outstanding at once.\n",
    " *\n",
    " * Every unsettled `Pending<T>` holds one call slot until it is collected or cancelled, so this is the\n",
    " * ceiling on how many handles a program can watch: watching N sockets means N outstanding `recv`s, plus\n",
    " * one for an `accept` and one for whatever it writes with. Exceeding it does not degrade into slowness —\n",
    " * the extra submission parks, and the calls holding the slots cannot complete, so it deadlocks.\n",
    " *\n",
    " * Stated here rather than transcribed into each program, because it has already changed twice (four,\n",
    " * sixteen, 128) and every copy of the old number becomes a limit nobody can explain.\n",
    " * `test/wac/slots_test.wac` fails if this and `host/layout.ts` disagree.\n",
    " */\n",
    "export static i32 CALL_SLOTS = 128;\n",
    "\n",
    "/**\n",
    " * Standard input's handle, so that `waitAny` can watch it beside a socket and a child.\n",
    " *\n",
    " * Reserved rather than allocated: a host's handle counter starts past the reserved ones, so this\n",
    " * can never name anything else. `test/wac/handles_test.wac` is what holds the hosts to that.\n",
    " */\n",
    "export static i32 STDIN = 0;\n",
    "\n",
    "/**\n",
    " * The handle a **child** reads and writes to reach its parent's filesystem — the other end of\n",
    " * `Child.fsHandle`, seen from inside the child.\n",
    " *\n",
    " * Reserved in the same way and for the same reason as `STDIN`, and it has to be a fixed number\n",
    " * because there is nothing to tell a child what its own number would be: a program that starts and\n",
    " * wants its parent's filesystem asks on this handle or does not ask at all. `Fs.overParent` is the\n",
    " * only caller, and `recv(PARENT_FS)` on a program that was not spawned answers nothing — which is\n",
    " * how a program can tell the difference without a capability to ask with.\n",
    " */\n",
    "export static i32 PARENT_FS = 1;\n",
    "\n",
    "export struct HostChild {\n",
    "  /**\n",
    "   * The child's handle, or a negative number and an `error`.\n",
    "   *\n",
    "   * Two negatives, and the difference is the caller's whole decision:\n",
    "   *\n",
    "   *   -1  this program exists and would not start — `packages/sh` reports 126, as a shell does for\n",
    "   *       a file that is not executable\n",
    "   *   -2  **this world has no `spawn` at all**, so nothing was attempted and nothing is wrong with\n",
    "   *       the program. A caller with another route should take it\n",
    "   *\n",
    "   * Without the second, a world that cannot spawn made every spawnable name *fail* rather than fall\n",
    "   * through: in the browser shell, `WACPATH=/b` with a file named `wc` in it reported\n",
    "   * \"no handler for capability 27\" and exit 126, hiding `packages/box`'s own `wc`, which was sitting\n",
    "   * right there and works. A missing capability is not a broken program.\n",
    "   */\n",
    "  i32 handle;\n",
    "  /**\n",
    "   * The child's *error* stream, as a handle of its own — `recv(errHandle)` reads it.\n",
    "   *\n",
    "   * A program has two output streams and a handle carries one, so a child needs two. Without this\n",
    "   * they were merged: a shell running `cat nosuch | wc -c` counted the error message, because the\n",
    "   * child's complaint arrived on the same handle as its output, and `cat nosuch` alone printed to\n",
    "   * *standard output*. Both are wrong in the same way, and a second handle rather than a second\n",
    "   * capability keeps everything that already works on handles working — `waitAny` most of all, which\n",
    "   * is what lets a parent watch a child's two streams and a socket together.\n",
    "   *\n",
    "   * Negative when `handle` is: there is nothing to read from a child that never started.\n",
    "   */\n",
    "  i32 errHandle;\n",
    "  /**\n",
    "   * The child's **filesystem channel**, as a handle of its own — the third stream, and the one that\n",
    "   * makes a child able to see anything but what its parent sends it.\n",
    "   *\n",
    "   * A spawned child is a separate instance with its own memory, which is the confinement `spawnSelf`\n",
    "   * exists to provide. It is also why a child could not see its parent's *filesystem*: a session\n",
    "   * booted on an image holds that image in wac memory, and there is no route from one instance's\n",
    "   * memory to another's. So a spawned stage got `Fs.onHost` — the machine — and a sealed session\n",
    "   * could not spawn at all without unsealing itself. That is wac-mono 0116.\n",
    "   *\n",
    "   * The route is a channel rather than a copy. The child asks and the parent answers, on this handle:\n",
    "   * `recv(fsHandle)` in the parent reads a request, `send(fsHandle, …)` answers it, and\n",
    "   * `packages/fs`'s `Backing.Remote` is the other end. Which means the parent's filesystem stays the\n",
    "   * only one there is — the child's writes are the parent's writes, its permissions are checked\n",
    "   * against the parent's `user`, and the mounts it sees are whatever the parent has mounted, because\n",
    "   * nothing has been duplicated.\n",
    "   *\n",
    "   * **It is a handle so that `waitAny` can watch it beside the child's output**, which is what a\n",
    "   * parent serving a child while relaying its bytes actually needs. A parent that does not serve it\n",
    "   * leaves the child parked on a request; a parent that does not *want* to serve it should not pass\n",
    "   * `PARENT_FS` to the child in the first place.\n",
    "   *\n",
    "   * Negative when `handle` is, and on a host with no spawn at all.\n",
    "   */\n",
    "  i32 fsHandle;\n",
    "  string error;\n",
    "\n",
    "  /** As `Socket.of`: the host builds these, so the constructor is declared rather than generated. */\n",
    "  HostChild of(i32 handle, i32 errHandle, i32 fsHandle, string error) {\n",
    "    return HostChild(handle, errHandle, fsHandle, error);\n",
    "  }\n",
    "\n",
    "  /** Whether this world can spawn at all. False says nothing about the program. */\n",
    "  bool unavailable(const this) { return this.handle == -2; }\n",
    "}\n",
    "\n",
    "/**\n",
    " * A module this program has instantiated and may call the exports of.\n",
    " *\n",
    " * **The other half of `spawn`, and deliberately not a replacement for it.** `spawn` hands over a\n",
    " * *program*: an argument vector, two streams, an exit code, on its own thread, and `closeSocket` stops\n",
    " * it wherever it is. This hands over a module's *functions*, in this program's own world, on this\n",
    " * program's own thread — so an export that loops forever hangs the caller, and nothing here can stop\n",
    " * it. Anything unbounded or untrusted is `spawn`'s.\n",
    " *\n",
    " * Its world is the caller's, undiminished: see `load` for why there is no grant argument.\n",
    " *\n",
    " * It exists because four commands needed it and no wac program could express them: `wac test` calls a\n",
    " * module's `test*` exports and has to survive one of them trapping, and `covdump`, `tracestat` and\n",
    " * `ctcompare` read the counters through `__cov_init`, `__cov_len`, `__cov_get` and `__cov_hash`.\n",
    " * Every host already did this internally — `host/driver.ts`'s `asAppModule`, `native/v8`'s\n",
    " * `run_tests` — and none of them offered it. `issues/system/0240c`.\n",
    " *\n",
    " * **Which exports there are is not a capability.** A module carries its own manifest, and the manifest\n",
    " * lists every non-`$bind$` export with its parameters and return type — so a caller reads the names\n",
    " * from the bytes it already has (`manifestIn` in `packages/wacc/src/manifest.wac`) and the host\n",
    " * dispatches on the signature it finds there. Nothing has to describe a module to the host that the\n",
    " * module does not already say about itself.\n",
    " */\n",
    "export struct LoadedModule {\n",
    "  /**\n",
    "   * The module, or why not.\n",
    "   *\n",
    "   *   >= 0  a handle for `call` and `unload`\n",
    "   *    -1   this world can load and this module could not be — `error` says why\n",
    "   *    -2   **this world has no `load` at all**, so nothing was attempted\n",
    "   *\n",
    "   * The same two negatives `Child` uses, for the same reason it uses them: a caller that reads -2 has\n",
    "   * a host without the capability and should fall through to whatever it would have done, where -1 is\n",
    "   * a real failure about this module.\n",
    "   */\n",
    "  i32 handle;\n",
    "  /** The host's own sentence, empty when `handle` is not negative. */\n",
    "  string error;\n",
    "\n",
    "  /** Whether this world can load a module at all. False says nothing about the module. */\n",
    "  bool unavailable(const this) { return this.handle == -2; }\n",
    "\n",
    "  LoadedModule of(i32 handle, string error) { return LoadedModule(handle, error); }\n",
    "}\n",
    "\n",
    "/**\n",
    " * What one call to a loaded module's export answered.\n",
    " *\n",
    " * **A trap is a value here, and that is the point.** 389 of this repository's 2553 test exports are\n",
    " * `test_traps_*` — a test that passes *by* trapping — and no wac program can catch one. Without a\n",
    " * status for it, a caller learns about such a test by dying with it.\n",
    " *\n",
    " * The signatures a call accepts are a **closed set**: `void f()`, `i32 f()`, `i32 f(i32)`, and\n",
    " * `i32`- or `string`-returning `f(Core?, Cli?)`. That is every shape the four commands need. Anything\n",
    " * else answers `status == 3` rather than being marshalled — widening the set is a decision about the\n",
    " * boundary, and answering plainly is what stops it being made by accident.\n",
    " */\n",
    "export struct CallResult {\n",
    "  /**\n",
    "   * 0 returned, 1 **trapped**, 2 no such export, 3 a signature this cannot call.\n",
    "   *\n",
    "   * Distinct rather than merged because the remedies differ: 2 is a typo or a module built without\n",
    "   * the export, and 3 is a request to widen the boundary.\n",
    "   */\n",
    "  i32 status;\n",
    "  /**\n",
    "   * A `string`-returning export's answer, or, when `status` is 1, what the trap said.\n",
    "   *\n",
    "   * **Empty when it said nothing**, which is an engine trap: a bounds check, a null dereference, a\n",
    "   * bare `trap;`. Only `trap \"...\"` writes a sentence. This field is the answer to \"did it say why\",\n",
    "   * and `status` is already the answer to \"did it trap\" -- so the engine's own word for the\n",
    "   * instruction does not go here. It used to, and one host had to invent that word to match another.\n",
    "   */\n",
    "  string text;\n",
    "  /** An `i32`-returning export's answer, and 0 for every other shape. */\n",
    "  i32 value;\n",
    "\n",
    "  /** It returned. Says nothing about *what*: a failing test returns a report. */\n",
    "  bool ok(const this) { return this.status == 0; }\n",
    "  /** It trapped, which for a `test_traps_*` export is the pass. */\n",
    "  bool trapped(const this) { return this.status == 1; }\n",
    "\n",
    "  CallResult of(i32 status, string text, i32 value) { return CallResult(status, text, value); }\n",
    "}\n",
    "\n",
    "export struct Cli {\n",
    "  fn<Pending<i32>()> argCount;\n",
    "  /**\n",
    "   * One argument, **as bytes**.\n",
    "   *\n",
    "   * Not a `string`, and that is the whole of wac-mono 0065. An argument is bytes on every system this\n",
    "   * targets, and a capability that called it text forced a conversion at the boundary — `TextDecoder`\n",
    "   * one way, `TextEncoder` the other — so a name that is not valid UTF-8 came back as replacement\n",
    "   * characters. It was silent: `cat $(printf '\\xff\\xfe')` named a file nobody had asked about, and a\n",
    "   * program using the argument as a path would have opened the wrong one.\n",
    "   *\n",
    "   * A caller that wants text says so: `string.fromBytes(cli.arg(0).wait())`. That is one call longer and\n",
    "   * it is honest about where the interpretation happens — the alternative was a clever codec smuggling\n",
    "   * bytes through a type that should not have been there.\n",
    "   */\n",
    "  fn<Pending<u8[]>(i32)> arg;\n",
    "  /**\n",
    "   * One environment value, as bytes. Null when the variable is unset, which is not the same as empty.\n",
    "   *\n",
    "   * Bytes for the same reason as `arg`: an environment value is not text on any system here, and this is\n",
    "   * how a path in `$HOME` or `$WACPATH` survives being one.\n",
    "   */\n",
    "  fn<Pending<u8[]?>(string)> env;\n",
    "\n",
    "  /** All of standard input, to the end. Empty when there is none. */\n",
    "  fn<Pending<u8[]>()> readStdin;\n",
    "  /**\n",
    "   * Exactly these bytes on standard output — no newline, no encoding.\n",
    "   *\n",
    "   * `log` is for lines of text; this is for a program whose output *is* bytes. Without it\n",
    "   * nothing could emit binary, which ruled out every compressor and encoder as a filter.\n",
    "   *\n",
    "   * Answers with whether the write succeeded, which most callers discard. The type is not\n",
    "   * for them: `fn<bool(u8[])>` is the shape every streaming transform in this repo takes\n",
    "   * for its sink, so `write` can be handed to one directly instead of through an adapter\n",
    "   * — and `fn<bool(u8[])>` has no spare parameter, so an adapter has nowhere to keep one.\n",
    "   */\n",
    "  fn<bool(u8[])> write;\n",
    "  /**\n",
    "   * Exactly these bytes on standard error, with the same shape and the same absence of a grant.\n",
    "   *\n",
    "   * `warn` is the program talking about itself: a diagnostic *line*, which is what every applet in\n",
    "   * `packages/box` wants and what it should keep using. This is the program passing bytes through,\n",
    "   * and the two are different jobs rather than one with a redundant spelling.\n",
    "   *\n",
    "   * `packages/ssh` is why it exists. A remote command's two streams arrive interleaved and tagged,\n",
    "   * in the order the command wrote them, and with only `warn` the client could reproduce standard\n",
    "   * output exactly and standard error not at all: emitting per packet inserted a newline at every\n",
    "   * boundary, so it had to buffer to the end, which lost the ordering — and mangled anything that\n",
    "   * was not valid UTF-8, since `warn` takes a string. wac-mono issue 0014.\n",
    "   *\n",
    "   * No grant, for the reason `write` has none: what a program prints is the user's own doing.\n",
    "   */\n",
    "  fn<bool(u8[])> writeErr;\n",
    "\n",
    "  fn<Pending<FileResult>(string)> readFile;\n",
    "  /**\n",
    "   * **Answers a `Change`**: a fault category and the host's message. A `bool` could say that a write\n",
    "   * failed and never why, and a bare message could say why to a person but not to a program.\n",
    "   *\n",
    "   * That mattered more than it looks. `rm -f` could only suppress every failure or none, because\n",
    "   * \"no such file\" and \"permission denied\" arrived as the same `false`; `find` could report that a\n",
    "   * directory was unreadable but not that it was a mount point rather than a typo; and every\n",
    "   * `writeFile` diagnostic in this repo was the applet's guess at what had gone wrong. The message\n",
    "   * is the host's own, which is the only one that knows.\n",
    "   */\n",
    "  fn<Pending<Change>(string, u8[])> writeFile;\n",
    "  /** What a path is. `exists` is false where the filesystem was not granted. */\n",
    "  fn<Pending<Stat>(string)> stat;\n",
    "  /**\n",
    "   * `stat` without following the last component: the link, not its target.\n",
    "   *\n",
    "   * A separate capability rather than a flag on `stat`, and rather than making `stat` stop\n",
    "   * following, because every caller in this repo wants the followed answer — `find` and `du` ask\n",
    "   * \"is this a directory I should walk into\", and that is a question about the target. Doing both\n",
    "   * syscalls inside `stat` would have doubled the cost of every directory walk to serve the one\n",
    "   * applet that cares.\n",
    "   *\n",
    "   * `tar` is that applet: its header says symbolic links are refused, and until this existed it\n",
    "   * could not tell one from the thing it points at, so a link to a directory was archived as the\n",
    "   * directory and a cycle grew the path until something trapped.\n",
    "   *\n",
    "   * A host with no links answers exactly as `stat` does, `isSymlink` false — that is true rather\n",
    "   * than a stand-in, since the Origin Private File System has none.\n",
    "   */\n",
    "  fn<Pending<Stat>(string)> linkStat;\n",
    "  /** Names within a directory, or null if it is not one — or not permitted. */\n",
    "  fn<Pending<string[]?>(string)> readDir;\n",
    "\n",
    "  /**\n",
    "   * Making, unmaking and moving. All three answer a `Change`, as `writeFile` does.\n",
    "   *\n",
    "   * `writeFile` alone cannot express a safe update: it truncates and then fills, so a\n",
    "   * reader arriving in between sees a half-written file, and a crash leaves one. With\n",
    "   * `rename` an application can write beside the target and move it into place, which on\n",
    "   * every filesystem this runs on is atomic. That is why these are one tier rather than\n",
    "   * three conveniences — see `applets/cp.wac`, which does exactly that.\n",
    "   *\n",
    "   * `parents` and `recursive` are `mkdir -p` and `rm -r`. Both default to nothing: a\n",
    "   * caller has to ask for the recursive form, because the recursive form is the one that\n",
    "   * can destroy something it was not pointed at.\n",
    "   */\n",
    "  fn<Pending<Change>(string, bool)> mkdir;\n",
    "  fn<Pending<Change>(string, bool)> remove;\n",
    "  fn<Pending<Change>(string, string)> rename;\n",
    "\n",
    "  /**\n",
    "   * Make a file executable, or stop it being one.\n",
    "   *\n",
    "   * **One bit rather than a mode, and that is a decision rather than a shortcut** —\n",
    "   * issues/system/0132. Three reasons, in the order they mattered:\n",
    "   *\n",
    "   *   - git's two regular-file modes, `100644` and `100755`, differ only in this bit. Symlink and\n",
    "   *     gitlink are entry *kinds*, not permissions. Nothing in this repository needs the rest of a\n",
    "   *     POSIX mode, and a surface that promised one would be promising something no caller wants.\n",
    "   *   - a browser's OPFS has no mode bits at all. With one bit the browser host answers\n",
    "   *     `FAULT_UNSUPPORTED` — the capability is present and the *backing* refuses, which is a\n",
    "   *     distinction this vocabulary can make since 0117. A general `chmod(path, mode)` there would be\n",
    "   *     unanswerable rather than merely unsupported.\n",
    "   *   - widening later is additive; narrowing later removes something callers depend on. The cheaper\n",
    "   *     mistake to make is the narrow one.\n",
    "   *\n",
    "   * `Stat.isExecutable` is the reading half, and the two together are what let a checkout produce a\n",
    "   * working tree `git status` calls clean.\n",
    "   */\n",
    "  fn<Pending<Change>(string, bool)> setExecutable;\n",
    "\n",
    "  /**\n",
    "   * Set a file's permission bits — `issues/system/0296c`.\n",
    "   *\n",
    "   * **The widening `setExecutable` above was written narrow against.** Its note gives three reasons for\n",
    "   * one bit, and the third is that *\"widening later is additive; narrowing later removes something\n",
    "   * callers depend on\"* — this is that widening, and the two reasons for the narrow form still hold, so\n",
    "   * it stays: git wants exactly the execute bit, and a caller who wants that should say so rather than\n",
    "   * computing a mode.\n",
    "   *\n",
    "   * `mode` is the low twelve bits, as `chmod(2)` takes them: `0o755`, `0o600`, and the three\n",
    "   * set-user/group/sticky bits above them. Nothing here interprets symbolic forms — `u+x` is the\n",
    "   * *shell's* spelling, and `applets/chmod.wac` is what turns one into a number.\n",
    "   *\n",
    "   * **A host with no modes answers `FAULT_UNSUPPORTED`**, as it does for `setExecutable`: a browser's\n",
    "   * OPFS has no permission bits, so the capability is present and the backing refuses. That is the\n",
    "   * distinction this vocabulary has had since `0117`, and it is why a general mode is answerable here\n",
    "   * rather than merely absent.\n",
    "   *\n",
    "   * What this was wanted for: a test cannot make a directory unreadable, so it cannot ask what `find`\n",
    "   * and `du` do with one — `box.test.ts` builds that fixture with `Deno.chmod` and could not be\n",
    "   * written in wac at all.\n",
    "   */\n",
    "  fn<Pending<Change>(string, i32)> chmod;\n",
    "\n",
    "  /**\n",
    "   * Streaming input: `openInput` chooses the source, `readChunk` pulls from it.\n",
    "   *\n",
    "   * Everything else here answers with the whole of something, which is fine for a\n",
    "   * filename and wrong for a pipe — `cat` of a large file held it entirely in memory, and\n",
    "   * so did every filter. These two are the incremental half.\n",
    "   *\n",
    "   * `openInput(\"\")` selects standard input, which is also where a program starts, so an\n",
    "   * applet that only ever filters need not call it at all. A path selects that file\n",
    "   * instead, and the previous source is closed.\n",
    "   *\n",
    "   * There is one current input rather than a handle per file because the transforms take\n",
    "   * `fn<u8[]()>`, which has no parameter to carry a handle in. That is a choice in those\n",
    "   * packages, not a limit of the language — wac can pass context beside a funcref, and a\n",
    "   * transform taking `fn<[i32]>` could be handed a real file handle. Worth knowing\n",
    "   * before anyone repeats the design: `recv(handle)` is what it looks like done that way,\n",
    "   * and standard input has a handle now precisely so `waitAny` can watch it.\n",
    "   *\n",
    "   * `readChunk` answers with an empty array at end of input, and with at most\n",
    "   * `CHUNK` bytes otherwise. A short chunk does not mean the end.\n",
    "   *\n",
    "   * `openInput` answers with a `Change`: `FAULT_NONE` when the source was selected, and a\n",
    "   * category with the host's words when it was not.\n",
    "   *\n",
    "   * **A `Change` and not a bare message**, which is what this used to be, for the reason\n",
    "   * `openOutput` was changed first: a message alone cannot be translated. `readFile` carries a\n",
    "   * fault and its callers print what GNU prints; this carried the host's sentence, so\n",
    "   * `cat missing` said `No such file or directory (os error 2): open '/tmp/x'` where the whole-file\n",
    "   * path said `No such file or directory` — the same failure, worded two ways in one program,\n",
    "   * depending on whether the applet happened to stream. That is the drift `faultWords` exists to\n",
    "   * end, and it survived in the streaming half until a differential test against `cat` caught it.\n",
    "   */\n",
    "  fn<Pending<Change>(string)> openInput;\n",
    "  /**\n",
    "   * The next piece of the current input, as a ticket — `Data`, `End` or `Failed`.\n",
    "   *\n",
    "   * **A ticket because a world that cannot block answers it later.** It was `fn<Chunk()>`, answered\n",
    "   * on the spot, which is all a host with threads to park ever needed; a page has none, and its\n",
    "   * input is a queue another worker fills. A program awaits it — `await cli.readChunk().ticket()` —\n",
    "   * and a host that has the bytes already hands back a ticket that is settled.\n",
    "   *\n",
    "   * One at a time all the same: it acts on the *current* stream, which the world keeps in order, so\n",
    "   * two in flight is not a faster read but an undefined one. The capabilities worth several at once\n",
    "   * are the ones that *name their target*: `readFile(path)`, `stat(path)`, `recv(handle)`.\n",
    "   *\n",
    "   * `write` stays a plain call. Writing never has to wait for an answer: a host with threads blocks\n",
    "   * inside it, and a page hands the bytes on.\n",
    "   */\n",
    "  fn<Pending<Read>()> readChunk;\n",
    "  /**\n",
    "   * Why the last `write` or `writeErr` answered false: the empty string when the other end simply\n",
    "   * went away, and the host's message when the write itself failed.\n",
    "   *\n",
    "   * One question for both streams rather than two, because no caller has ever needed to know *which*\n",
    "   * stream failed — a program asks this to decide between exiting 0 and reporting a real failure, and\n",
    "   * that decision is the same either way. If one ever does need to tell them apart, that is the point\n",
    "   * to split it, and the split will be visible rather than guessed at.\n",
    "   *\n",
    "   * A closed pipe is an answer rather than an error — `yes | head -1` ends that way and should exit\n",
    "   * 0 — so the two have to be distinguishable. Without this a full disk and a departed reader were\n",
    "   * the same `false`, and every filter treated both as \"my work here is done\".\n",
    "   */\n",
    "  fn<Pending<string>()> outputError;\n",
    "\n",
    "  /**\n",
    "   * Where `write` goes. `openOutput(\"\")` is standard output, which is where it starts.\n",
    "   *\n",
    "   * The mirror of `openInput`, and for the same reason: without it a program could not\n",
    "   * produce more output to a *file* than fits in memory, because `writeFile` takes the\n",
    "   * whole of it at once. `cp` of a file larger than memory needed this; so would `split`,\n",
    "   * or any filter told to write somewhere other than a pipe.\n",
    "   *\n",
    "   * A path truncates that file and makes it the destination of every subsequent `write`.\n",
    "   * Opening another output closes the previous one, and so does opening `\"\"` — which is\n",
    "   * how a program that has finished writing a file knows the bytes are there, since\n",
    "   * `rename` over a file still open would move it half-written. `cp` does exactly that.\n",
    "   *\n",
    "   * **Answers a `Change`**, so a caller can tell *which* failure it was rather than only that the\n",
    "   * sentence came from the host. It used to answer a bare string, and the host's sentence reached the\n",
    "   * user: `sh`'s streaming redirection reported `No such file or directory (os error 2): open\n",
    "   * '/tmp/…/sub/out'` where bash says `sub/out: No such file or directory`. Every other call that\n",
    "   * changes something — `writeFile`, `mkdir`, `remove`, `rename` — has carried a fault category since\n",
    "   * wac-mono 0062, and this one was left behind because nothing had needed to word its failure yet.\n",
    "   */\n",
    "  fn<Pending<Change>(string)> openOutput;\n",
    "\n",
    "\n",
    "  /**\n",
    "   * The network. `--allow-net`, and nothing without it.\n",
    "   *\n",
    "   * `connect` resolves and dials; `listen` binds an address and a port, and `accept` blocks until\n",
    "   * someone arrives. `recv` answers with at most `CHUNK` bytes and with an empty array when the\n",
    "   * peer has closed — a short read means nothing, exactly as it does for a file.\n",
    "   *\n",
    "   * **`listen` takes the address to bind, and it is not optional.** It used to take a port alone and\n",
    "   * the host bound `0.0.0.0`, so every server written on this platform was reachable from every\n",
    "   * interface and no program could ask for loopback. For most servers that is a deployment surprise;\n",
    "   * for `packages/tor`'s SOCKS proxy it is the difference between serving the person at the keyboard\n",
    "   * and running an open proxy that sources strangers' traffic out of somebody else's exit node. Every\n",
    "   * other SOCKS implementation binds loopback for that reason, so the safe configuration was not only\n",
    "   * unavailable, it was the one people would assume they already had.\n",
    "   *\n",
    "   * `\"127.0.0.1\"` is loopback, `\"0.0.0.0\"` is every interface, and the empty string means *every\n",
    "   * interface* as well — the old behaviour, spelled out rather than defaulted into. A caller has to\n",
    "   * write one of them, which is the point: the surprising one is now a thing somebody typed.\n",
    "   *\n",
    "   * Watching two sockets at once is `waitAny` below, over the ids of two tickets in flight.\n",
    "   * This comment used to say there was no way to do that and that \"when something needs it,\n",
    "   * that is the shape to add\" — it was left behind when the shape was added, twenty lines\n",
    "   * further down, and contradicting it.\n",
    "   */\n",
    "  fn<Pending<HostSocket>(string, i32)> connect;\n",
    "  fn<Pending<HostSocket>(string, i32)> listen;\n",
    "  fn<Pending<HostSocket>(i32)> accept;\n",
    "  fn<Pending<Read>(i32)> recv;\n",
    "  fn<Pending<bool>(i32, u8[])> send;\n",
    "  fn<void(i32)> closeSocket;\n",
    "\n",
    "  /**\n",
    "   * **Say \"that is all\" without saying \"goodbye\"**: end the outbound direction and keep reading.\n",
    "   *\n",
    "   * `closeSocket` stops the socket both ways, so a client that used it to signal end-of-input could\n",
    "   * never receive the answer. That is the exchange every request/response protocol over a raw socket\n",
    "   * needs — the server reads to the end and only then replies — and until 2026-08-20 there was no\n",
    "   * call for it. `issues/system/0215`.\n",
    "   *\n",
    "   * The argument was already written one capability over: `closeFeed` says *\"a program that reads to\n",
    "   * the end before answering — `wc` is the obvious one — needs the end to arrive while it is still\n",
    "   * running, and killing it instead means it never speaks.\"* The same sentence, and the same example\n",
    "   * program, for a socket instead of a child. `closeFeed` is the child case and this is the socket\n",
    "   * one; a handle is a handle everywhere else, and this is the one place the two differ, because a\n",
    "   * child has a standard input to end and a socket has a direction.\n",
    "   *\n",
    "   * **A separate call rather than a flag on `closeSocket`**, deliberately. A host that did not know\n",
    "   * about a new argument would read it as an ordinary close, so the program would hang waiting for a\n",
    "   * reply that the host had just made unreachable — where an unrecognised call fails and says so.\n",
    "   *\n",
    "   * After this, `send` on the handle is over; `recv` keeps working until the peer closes its own\n",
    "   * side. Under `--allow-net` with everything else here: the authority is \"speak to something that\n",
    "   * is not this process\", and stopping speaking is not a second question.\n",
    "   */\n",
    "  fn<void(i32)> closeSend;\n",
    "\n",
    "  /**\n",
    "   * **A file as a stream of its own**, in the socket's handle space: `recv` reads it, `send` writes it and\n",
    "   * `closeFile` ends it. `how` is `OPEN_READ`, `OPEN_WRITE` (created or truncated) or `OPEN_APPEND` (created or\n",
    "   * added to). Any number may be open at once, so this is what `Files.openRead` and `openWrite` stand on.\n",
    "   */\n",
    "  fn<Pending<HostSocket>(string, i32)> openFile;\n",
    "  /** The end of a file `openFile` opened. What was written is the file's once this answers; `false` if it was not. */\n",
    "  fn<Pending<bool>(i32)> closeFile;\n",
    "  /**\n",
    "   * The end of this program's output (`toErr` false) or its diagnostic output: a reader sees the end while the\n",
    "   * program goes on. `false` if the host could not close it.\n",
    "   */\n",
    "  fn<Pending<bool>(bool)> closeOutput;\n",
    "\n",
    "  /**\n",
    "   * Datagrams, under the same one `--allow-net` grant.\n",
    "   *\n",
    "   * The authority is \"speak to something that is not this process\", and the transport does not change\n",
    "   * what that means: a program that may open a TCP connection may send a UDP packet, and one that may\n",
    "   * not may do neither. A second grant would be a second question with the same answer.\n",
    "   *\n",
    "   * Every field above this is *stream* — `connect`, `listen`, `accept`, `recv`, `send` — and QUIC needs\n",
    "   * none of them. A QUIC server answers many peers from one socket, and a connection is identified by\n",
    "   * its connection id rather than by an address, so a peer may legitimately move mid-connection. A\n",
    "   * connected socket represents neither: not one socket for many peers, and not one peer at changing\n",
    "   * addresses. That is `design/system/0007`, and this is its first step.\n",
    "   *\n",
    "   * `bindDatagram` takes an address and a port exactly as `listen` does, with the same rule that the\n",
    "   * address is not optional — `\"127.0.0.1\"` for loopback, `\"0.0.0.0\"` or `\"\"` for every interface — and\n",
    "   * answers a `Socket` whose `port` is what the kernel bound, so `bindDatagram(addr, 0)` is usable.\n",
    "   * The handle goes to `receiveFrom`, `sendTo`, `waitAny` and `closeSocket` like any other.\n",
    "   *\n",
    "   * There is no `connect` for datagrams and no `accept`. The peer is named on every `sendTo` and\n",
    "   * arrives with every `receiveFrom`, which is what makes one socket serve many.\n",
    "   */\n",
    "  fn<Pending<HostSocket>(string, i32)> bindDatagram;\n",
    "  /** One datagram with its sender — see `Datagram` for why those are one answer and not two. */\n",
    "  fn<Pending<Datagram>(i32)> receiveFrom;\n",
    "  /** A datagram to a peer named in this call, which is the half that makes one socket serve many. */\n",
    "  fn<Pending<bool>(i32, string, i32, u8[])> sendTo;\n",
    "\n",
    "\n",
    "  /**\n",
    "   * Start a child on `prog`, with `args` as its arguments.\n",
    "   *\n",
    "   * `prog` is a **program's bytes**: since 2026-08-21 a wasm module carrying its own `wac.manifest`\n",
    "   * runs on every host — the two native ones and, through `host/driver.ts`, Deno and Node — and the\n",
    "   * JavaScript hosts also accept the worker bundle they used to require. So one artefact is a program\n",
    "   * everywhere, which is what `issues/system/0144` was open on: before it, a program that read a file\n",
    "   * and ran it worked under `wac` and failed under Deno, and `packages/sh` searching `$WACPATH` was\n",
    "   * where that split showed up first.\n",
    "   *\n",
    "   * Running a *program* is therefore two steps, read it and spawn it, which is why there is no\n",
    "   * registry of launchable things here: the capability is \"run this\", and where the code\n",
    "   * came from is the caller's business and the filesystem's.\n",
    "   *\n",
    "   * The child talks through its handle. What it writes arrives at `recv(handle)`; what\n",
    "   * `send(handle, bytes)` carries becomes its standard input; `closeSocket(handle)` stops\n",
    "   * it. `exitCode(handle)` waits for it to finish.\n",
    "   *\n",
    "   * **`closeSocket` stops it wherever it is**, and this is a guarantee rather than a request: a\n",
    "   * child that is computing and not writing stops too. That took a runtime change on the host with\n",
    "   * no JavaScript in it — a wasm guest leaves a loop only when it decides to, so the engine ticks an\n",
    "   * epoch and the child traps on the next check (issue 0123). Before it, the three JavaScript hosts\n",
    "   * terminated a worker and the native one finished the child's queues and let the thread run, which\n",
    "   * is the same thing for every program that writes and nothing at all for one that does not.\n",
    "   *\n",
    "   * **And the handle stays askable afterwards.** `exitCode` on a stopped child answers **-1** — \"no\n",
    "   * status of its own\" — on every host, because stopping something and then finding out it is gone\n",
    "   * is one operation in two halves and a supervisor needs both. All four hosts used to drop the\n",
    "   * child at `closeSocket`: two threw, one silently read the call as the *other* meaning of\n",
    "   * `exitCode` and set the caller's own status to the handle number.\n",
    "   *\n",
    "   * **What \"stops it\" means differs between the hosts, and the weaker one is the contract.** The\n",
    "   * JavaScript host terminates the worker outright; the native runtime finishes all three of the\n",
    "   * child's queues, so the child stops at its *next write*, which answers false. Every program in this\n",
    "   * repo writes, so the two are the same to watch — `kill %1` on a background `seq` ends it on both —\n",
    "   * but a child that computed without writing would keep going on one host and not the other. Depend\n",
    "   * on the streams ending, not on the instant. wac-mono 0123.\n",
    "   *\n",
    "   * **`grants` is what the child may do beyond those streams**, as `GRANT_*` flags — and it\n",
    "   * is a *ceiling of the parent's own*, intersected by the host rather than trusted.\n",
    "   *\n",
    "   * **The four are independent on three hosts out of four.** In a page, `GRANT_WRITE` without\n",
    "   * `GRANT_READ` yields nothing: reaching a file to write it means walking directory handles from the\n",
    "   * root, and holding the root handle *is* the read capability on the Origin Private File System.\n",
    "   * Deno and Node have a path-based open and can give a child `write` without `read`; a page cannot,\n",
    "   * and the child finds out as a `FAULT_NOT_GRANTED` from its first write rather than being told at\n",
    "   * spawn. Named here because \"intersected by the host\" reads as four separate switches, and on one\n",
    "   * host two of them are one. A parent\n",
    "   * built without `--allow-net` cannot hand `GRANT_NET` to anyone; asking is not an error, and\n",
    "   * the child simply finds the capability denied. `GRANT_NONE` is the honest default and what\n",
    "   * every example passes.\n",
    "   *\n",
    "   *     cli.spawn(source, args, GRANT_NONE, \"\", INHERIT_NONE, false)   // fed; nothing else\n",
    "   *     cli.spawn(source, args, GRANT_READ | GRANT_NET, dir, INHERIT_IN, false)  // ...if the parent has both\n",
    "   *\n",
    "   * This is the reason to prefer spawning a worker to spawning a process. What the child may\n",
    "   * do is the *parent's* choice; `--allow-run=/bin/sh` cannot express it at any granularity,\n",
    "   * because there the child inherits the operating system's authority instead. A shell served\n",
    "   * over a socket can be given one directory and no network.\n",
    "   *\n",
    "   * Flags rather than a struct because no capability takes a struct *parameter* anywhere in\n",
    "   * this world — every one of them returns structs — so this would have been the first, and a\n",
    "   * bitmask needs nothing from the boundary that is not already exercised.\n",
    "   *\n",
    "   * **The confinement is this language's, not the runtime's.** A wac child cannot reach\n",
    "   * past what it was handed because wac has no ambient anything. Arbitrary JavaScript in a\n",
    "   * worker can: it inherits the process's permissions, and dropping them needs an unstable\n",
    "   * Deno flag that would appear in the shebang of every program that spawns. So this is a\n",
    "   * composition and concurrency primitive rather than a sandbox. See wac-mono issue 0015.\n",
    "   *\n",
    "   * `cwd` is where the child's relative paths resolve from, and what its own `cwd()` reports. Empty\n",
    "   * means \"wherever the host already was\", which is what a program with no opinion wants. A shell\n",
    "   * has an opinion: without this, `cd sub; prog f` looked in the wrong place, because a spawned\n",
    "   * program inherited the *host's* directory rather than the shell's. `pushChild` took a directory\n",
    "   * from the start for exactly this reason and `spawn` did not.\n",
    "   *\n",
    "   * **`inherit` says which of the child's standard streams are this program's own** rather than\n",
    "   * queues — `INHERIT_IN`, `INHERIT_OUT`, either, both, or `INHERIT_NONE`. What each buys is on the\n",
    "   * constants; the shape of the argument is worth a word here.\n",
    "   *\n",
    "   * `INHERIT_NONE` is the ordinary case, and a shell wants it: a child fed from a pipeline, a\n",
    "   * redirection or a here-document gets exactly the bytes its parent chose, and its output comes\n",
    "   * back on `Child.handle` for the parent to do something with. Inheriting is for a program standing\n",
    "   * in for the one it started.\n",
    "   *\n",
    "   * **It was two bools until 2026-08-29**, and `INHERIT_OUT` is the one that was missing: a parent\n",
    "   * relaying two queues cannot know which stream was written first, so `echo one; nope; echo two`\n",
    "   * put the complaint after both lines. `issues/system/0282c`.\n",
    "   */\n",
    "  fn<Pending<HostChild>(u8[], u8[][], i32, string, i32, bool)> spawn;\n",
    "\n",
    "  /**\n",
    "   * **This same program again, as a child**, with these arguments and at most these grants.\n",
    "   *\n",
    "   * `spawn` needs a worker bundle from somewhere, and somewhere is a filesystem — which is fine on a\n",
    "   * command line and impossible in a browser tab, where there is no directory of programs and\n",
    "   * nothing to have put one there. So a page could spawn and had nothing to spawn, and\n",
    "   * `packages/box`'s applets ran *inside* the shell's own wasm instance with no boundary at all.\n",
    "   *\n",
    "   * Every built program already carries its own worker bundle: the launcher holds it as a string,\n",
    "   * because that is how it started the program in the first place. So \"run me again\" needs no file,\n",
    "   * no path and no grant of its own — the code is already here, and the argument is what decides\n",
    "   * which program it becomes. `box sort` is `box` with `sort` as its first argument, which is exactly\n",
    "   * what a multi-call binary is; a shell that can say that has sixty real programs instead of sixty\n",
    "   * function calls.\n",
    "   *\n",
    "   * The child runs `main`, never `page`, even when the program has both. A page is the top-level\n",
    "   * thing a person opened; a child is a program with a handle, and there is nowhere for it to draw.\n",
    "   *\n",
    "   * Grants are a ceiling of the parent's own, as with `spawn`: a shell that may read hands its\n",
    "   * children reading, and a program granted nothing cannot widen itself by spawning. `cwd` is where\n",
    "   * the child's relative paths resolve from, empty for the host's own directory, and `inherit` is the\n",
    "   * mask `spawn` takes: `INHERIT_IN` hands over this program's own standard input rather than a queue,\n",
    "   * and `DETACHED` lets the child outlive its ticket — see `spawn` above for both.\n",
    "   *\n",
    "   * **`serveFs` is a promise to answer the child's filesystem questions**, on `Child.fsHandle`. It\n",
    "   * is not a grant — it widens nothing, since what the child can reach is whatever this program's\n",
    "   * own `Fs` will answer — it is a statement about what this program is *going to do*, and the child\n",
    "   * needs it because the alternative is waiting for an answer that is never coming. False ends the\n",
    "   * child's end of the channel before it starts, so a program built on `Fs.overParent` finds out\n",
    "   * immediately and falls back to the host, and every spawner that predates this goes on behaving\n",
    "   * exactly as it did. A parent that passes true and then does not serve parks its child, which is\n",
    "   * the one failure this cannot make safe and the reason it is stated rather than assumed.\n",
    "   */\n",
    "  fn<Pending<HostChild>(u8[][], i32, string, i32, bool)> spawnSelf;\n",
    "\n",
    "  /**\n",
    "   * End a spawned worker's standard input without stopping it.\n",
    "   *\n",
    "   * Distinct from `closeSocket`, which stops the child outright. A program that reads to the\n",
    "   * end before answering — `wc` is the obvious one — needs the end to arrive while it is\n",
    "   * still running, and killing it instead means it never speaks.\n",
    "   */\n",
    "  fn<void(i32)> closeFeed;\n",
    "\n",
    "  /** Wait for a spawned worker to finish. Negative if it failed to run at all. */\n",
    "  fn<Pending<i32>(i32)> exitCode;\n",
    "  /**\n",
    "   * Where relative paths are resolved from, as the host sees it.\n",
    "   *\n",
    "   * A *read*, and nothing more: there is no `chdir`, because a mutable working directory is\n",
    "   * ambient state — it changes what every relative path in the program means, from anywhere, and\n",
    "   * that is the shape this world exists to avoid. A program that wants to move around keeps its\n",
    "   * own idea of where it is and passes whole paths, which is what `packages/sh` does.\n",
    "   *\n",
    "   * It is here because a program cannot otherwise answer \"where am I\", and the first thing\n",
    "   * anybody types into a new shell is `pwd`. Under Deno and Node it is the process's directory;\n",
    "   * in a browser it is `/`, the root of the Origin Private File System, because that is the\n",
    "   * honest answer rather than a fiction.\n",
    "   */\n",
    "  fn<Pending<string>()> cwd;\n",
    "\n",
    "  /**\n",
    "   * Run a program *inside* this one: the world a child sees, pushed and then popped.\n",
    "   *\n",
    "   * `pushChild` says what the next stretch of work is called and was given, what it reads, where\n",
    "   * its relative paths resolve from, and that its output is to be kept rather than written. `popChild` ends that and\n",
    "   * answers with what it wrote. Between the two, `arg` and `argCount` answer from `argv`,\n",
    "   * `readChunk` returns `stdin` and then end of input, `Core.log`, `write` and `Core.warn`\n",
    "   * accumulate, and every path is taken relative to `cwd`.\n",
    "   *\n",
    "   * **The last argument says the child reads the *real* standard input** rather than the bytes handed\n",
    "   * over. A shell that runs a command in process has to have bytes to give it, and to have them it must\n",
    "   * read its own input to the end — which at a terminal never comes, so `seq 1 3` hung a shell that\n",
    "   * could not spawn (wac-mono 0110). With it set, `readChunk` and `readStdin` reach past the frame to\n",
    "   * the process's own input, exactly as they do when nothing is pushed; the output is still captured,\n",
    "   * which is what the frame is for.\n",
    "   *\n",
    "   * `argv` is in the layout `box` uses — the program's own name first — because an applet that\n",
    "   * reads its arguments positionally rather than through a parser is reading that layout already.\n",
    "   * `Core.log` is captured along with `write` for the same kind of reason: it is where thirty of\n",
    "   * those applets send their output, so a capture that took only `write` would lose most of them\n",
    "   * silently. That is exactly what the first working version of this did.\n",
    "   *\n",
    "   * **Why this exists.** A shell has to run a program and keep its output, and when this was\n",
    "   * written it could not do that by handing the program a different `Cli`: there were no closures,\n",
    "   * so a substitute capability had nowhere to put what it collected.\n",
    "   *\n",
    "   * **That stopped being true on 2026-08-16.** Lambdas capture by reference — `spec/cases/0191`,\n",
    "   * and `spec/cases/0193 a capability can be faked with lambdas` is the case named for exactly\n",
    "   * this — so a substitute `Cli` whose `write` is a lambda closing over a `Buf` is writable now.\n",
    "   * Whether this should therefore go is `issues/system/0327a`; it is a decision about a shipped\n",
    "   * capability rather than a comment fix, and the argument below is the record of why it was\n",
    "   * built. `packages/sh` therefore had its own small\n",
    "   * `cat`, `wc`, `grep` and nine more — implementations that existed only because the real ones\n",
    "   * could not be called. With this, `packages/box`'s applets run in the shell unchanged, and one\n",
    "   * `grep` serves both.\n",
    "   *\n",
    "   * **Why a scope rather than a `chdir`.** `cwd` above refuses to be settable because a mutable\n",
    "   * working directory changes what every relative path in a program means. This does not\n",
    "   * contradict that: it is a *child's* view, bounded by a matching `popChild`, and what the\n",
    "   * parent's own paths mean is unchanged before and after. That is also the honest fix for\n",
    "   * something `spawn` gets wrong today — a spawned program inherits the host's directory rather\n",
    "   * than the shell's, so `cd sub; prog f` looks in the wrong place.\n",
    "   *\n",
    "   * Nesting is a stack, so a program that runs a program that runs a program is fine. A\n",
    "   * `popChild` with nothing pushed answers with two empty arrays rather than failing: the\n",
    "   * caller has nothing to clean up, and there is no state to corrupt.\n",
    "   *\n",
    "   * This is *not* isolation. The child is the same wasm instance with the same authority; it can\n",
    "   * still open any file the parent could. A real boundary is `spawn`, which is a separate worker\n",
    "   * with its own grants — and which a browser cannot do yet.\n",
    "   */\n",
    "  fn<Pending<bool>(string[], u8[], string, bool)> pushChild;\n",
    "  fn<Pending<Captured>()> popChild;\n",
    "\n",
    "  /**\n",
    "   * Run a program on the host, to completion, and hand back what it said.\n",
    "   *\n",
    "   * The capability `spawn` is repeatedly mistaken for. `spawn` starts another **wasm module** and\n",
    "   * `spawnSelf` starts an applet of this one; neither runs `/usr/bin/gunzip`. This does, which is why\n",
    "   * it is a separate capability rather than an overload: a host that will start a confined wasm\n",
    "   * module must be able to refuse a host binary without refusing both, and in a browser it always\n",
    "   * does. Granted by `--allow-run`.\n",
    "   *\n",
    "   * `args` are arguments, **not a shell line**. They are passed as an argument vector, so a value\n",
    "   * containing a space, a quote or a semicolon arrives whole and is never re-split or interpreted.\n",
    "   * A caller who wants a shell asks for one by name: `exec(\"/bin/sh\", [\"-c\", line], ...)`.\n",
    "   *\n",
    "   * `stdin` is handed over and then closed, so a program that reads to the end — which is most\n",
    "   * oracles — sees the end.\n",
    "   *\n",
    "   * **Buffered, and that is measured rather than a simplification.** Of the 107 host-side test files\n",
    "   * that spawn a process, not one reads a child's output while still writing to it; the fifteen that\n",
    "   * keep a child alive start a *server* and then talk to it over a socket, which is `connect`. So\n",
    "   * there is no streaming form here, and adding one should wait for a caller that needs it.\n",
    "   * `issues/system/0165` records the count.\n",
    "   *\n",
    "   * `env` is `NAME=value` strings, and a name given twice takes the last value. A string with no\n",
    "   * `=` in it is ignored rather than being a fault: there is nothing it could mean.\n",
    "   *\n",
    "   * **`clearEnv` is the whole of `issues/system/0198`**, which is why this parameter exists at all\n",
    "   * rather than only the four the runner wanted. False — what `Cli.exec` passes — *adds* `env` to\n",
    "   * everything this process holds, and that inheritance is an authority nobody declared: a program\n",
    "   * refused `--allow-env` can still read `HOME` by running `printenv`, so `--allow-run` confers\n",
    "   * `--allow-env`. True hands the child exactly `env` and nothing else, which is the shape\n",
    "   * `issues/system/0182` argued for — total, so that what you pass is what it gets and passing\n",
    "   * nothing means nothing.\n",
    "   *\n",
    "   * It is not the default **yet**, and the reason is a count rather than a doubt: 342 call sites,\n",
    "   * many of them oracles that read `PATH` or reach the network through a proxy variable, and every\n",
    "   * one of them needs its own answer to \"which of these did it actually need\". Flipping the default\n",
    "   * is that sweep, not this parameter. `Cli.exec` is where it flips.\n",
    "   *\n",
    "   * **Removing a named variable is still not expressible**, and `clearEnv` is not it: a caller who\n",
    "   * wants everything *except* one name has to name what stays, and nothing here can enumerate the\n",
    "   * environment — `Cli.env` answers one name at a time. `packages/wactest/src/childenv.wac`'s\n",
    "   * `withoutEnv` uses a shell's `unset` for that, and has to.\n",
    "   *\n",
    "   * `inherit` sends the child's stdout and stderr to this program's own, and then `Exec.stdout` and\n",
    "   * `Exec.stderr` come back **empty**: the bytes went somewhere else, and reporting them in both\n",
    "   * places would be a copy the caller cannot ask not to have. `status` still arrives. It is what a\n",
    "   * runner wants — a lane that shows its output as it runs, rather than three minutes of silence and\n",
    "   * then everything — and it is the nearest thing here to streaming: incremental output, without a\n",
    "   * caller having to read it. What it is *not* is capturable — an inherited stream goes to the real\n",
    "   * file descriptor, so `pushChild`'s capture does not see it.\n",
    "   */\n",
    "  fn<Pending<Exec>(string, string[], u8[], string[], bool, bool, string)> execWithIn;\n",
    "\n",
    "  /**\n",
    "   * `execWithIn` with no directory — the child runs wherever this program is.\n",
    "   *\n",
    "   * **The capability is the wider one and this is a method over it**, which is the same arrangement\n",
    "   * `exec` below already has with this. It means the thirty-five callers that do not care where the\n",
    "   * child runs are unchanged, and a host still implements exactly one of the three.\n",
    "   */\n",
    "  Pending<Exec> execWith(const this, string path, string[] args, u8[] stdin, string[] env,\n",
    "                         bool clearEnv, bool inherit) {\n",
    "    return this.execWithIn(path, args, stdin, env, clearEnv, inherit, \"\");\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * `execWith` with nothing added, nothing cleared and buffered output — what almost every caller\n",
    "   * wants: 342 call sites in 154 files, and the ones that do not are a test runner and the fixtures\n",
    "   * that need a child's environment to be theirs rather than the machine's.\n",
    "   *\n",
    "   * A method rather than a second capability, so that there is one thing for a host to implement and\n",
    "   * one payload on the bridge. It is also **where the default flips** when `issues/system/0198` is\n",
    "   * closed: the second `false` below becomes `true`, and the call sites that were relying on\n",
    "   * inheritance fail here rather than in six hosts.\n",
    "   */\n",
    "  Pending<Exec> exec(const this, string path, string[] args, u8[] stdin) {\n",
    "    return this.execWith(path, args, stdin, string[](), false, false);\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Instantiate `module` and answer a handle to call its exports through — `issues/system/0240c`.\n",
    "   *\n",
    "   * **`grants` narrows, and cannot widen.** Asking for more than this program holds ends where every\n",
    "   * other over-ask ends: at the host, which serves what the build granted. So the module gets the\n",
    "   * intersection, exactly as a spawned child does.\n",
    "   *\n",
    "   * **This argument was left out once, and that was wrong.** The reasoning was that a loaded module\n",
    "   * shares the caller's world and there is nowhere to enforce a narrowing: true of the *launcher*,\n",
    "   * which cannot tell this module's calls from its loader's, and false of the world the module is\n",
    "   * *handed*, which is built here. `wac test --allow-read` handed a test the command's write\n",
    "   * capability and a test wrote a file to disk; the native host failed the same test. `issues/system/0242c`.\n",
    "   *\n",
    "   * What makes handing over a narrowed world sufficient is the argument `spawn` makes for itself:\n",
    "   * **the isolation is the language's, not the runtime's.** A wac module reaches only what it was\n",
    "   * given, because wac has no ambient anything. That would not hold for arbitrary JavaScript, and a\n",
    "   * loaded module is a wac module.\n",
    "   *\n",
    "   * **Not `Pending`, because nothing crosses to a host.** Driving a module and calling one of its\n",
    "   * exports both finish before the call returns. Every other field here answers a ticket because it\n",
    "   * asks the launcher something; these three do not ask anybody.\n",
    "   *\n",
    "   * **On this thread.** See `LoadedModule`: nothing can stop a running export, so an export that loops\n",
    "   * forever hangs the caller.\n",
    "   */\n",
    "  fn<LoadedModule(u8[], i32)> load;\n",
    "\n",
    "  /**\n",
    "   * Call `name` on a loaded module, and answer what it did — including trapping.\n",
    "   *\n",
    "   * `arg` is passed to a signature that takes one `i32` and ignored by every other shape in the set.\n",
    "   * One field rather than a vector because the set is closed and one is all of it: `__cov_get(i)` is\n",
    "   * the only member that takes anything at all.\n",
    "   *\n",
    "   * A trap does not end the caller and does not poison the handle: the next `call` on the same module\n",
    "   * runs. That is what lets a runner take a file's tests in order when one of them is meant to trap —\n",
    "   * and it is safe for the same reason `test_traps_*` has always been able to run beside its\n",
    "   * neighbours, which is that wac has no module-level state for a trap to leave behind.\n",
    "   */\n",
    "  fn<CallResult(i32, string, i32)> call;\n",
    "\n",
    "  /**\n",
    "   * Let a loaded module go.\n",
    "   *\n",
    "   * `void`, and forgiving of a handle that is not one: a caller tidying up after a failure should not\n",
    "   * have to know how far it got. Not required for correctness — a program that exits releases\n",
    "   * everything — but a runner that loads a module per file would otherwise hold every one of them.\n",
    "   */\n",
    "  fn<void(i32)> unload;\n",
    "\n",
    "  /**\n",
    "   * Would the engine accept these bytes as a module? \"\" if it would, and why not if it would not.\n",
    "   *\n",
    "   * **Compiles and stops there**, which is the whole difference from `load` and the reason this is\n",
    "   * its own field rather than a flag on it. `load` wants a `wac.manifest` section, instantiates, and\n",
    "   * builds a world out of the exports — three things that can fail for reasons that are nothing to do\n",
    "   * with the bytes being a well-formed module. A program asking \"did the compiler emit something the\n",
    "   * engine will take\" is asking about the *bytes*.\n",
    "   *\n",
    "   * **The question only a host can answer**, and so the one thing about modules that stayed on this\n",
    "   * side of `issues/system/0257c`'s line. wac has no `WebAssembly.validate`, so\n",
    "   * `packages/wacc/test/wac/corpusemit_test.wac` used to run each module it emitted — a fork per\n",
    "   * module, 142s of the 193s it took — and `wac validate` was a host command for want of this.\n",
    "   *\n",
    "   * **Not `Pending`, for `load`'s reason:** nothing crosses to a launcher. The engine is here.\n",
    "   *\n",
    "   * A host with no engine to ask answers a refusal, as every unsupported capability does. That is not\n",
    "   * the same as \"these bytes are bad\", so the sentence has to say which — `FAULT_UNSUPPORTED`'s words\n",
    "   * rather than a bare \"rejected\".\n",
    "   */\n",
    "  fn<string(u8[])> validated;\n",
    "\n",
    "\n",
    "  /** Where this `Cli`'s tickets send their continuations — as `Core.of` does for its four. */\n",
    "  Sched sched;\n",
    "\n",
    "  Cli of(\n",
    "    fn<Pending<i32>()> argCount,\n",
    "    fn<Pending<u8[]>(i32)> arg,\n",
    "    fn<Pending<u8[]?>(string)> env,\n",
    "    fn<Pending<u8[]>()> readStdin,\n",
    "    fn<bool(u8[])> write,\n",
    "    fn<bool(u8[])> writeErr,\n",
    "    fn<Pending<FileResult>(string)> readFile,\n",
    "    fn<Pending<Change>(string, u8[])> writeFile,\n",
    "    fn<Pending<Stat>(string)> stat,\n",
    "    fn<Pending<Stat>(string)> linkStat,\n",
    "    fn<Pending<string[]?>(string)> readDir,\n",
    "    fn<Pending<Change>(string, bool)> mkdir,\n",
    "    fn<Pending<Change>(string, bool)> remove,\n",
    "    fn<Pending<Change>(string, string)> rename,\n",
    "    fn<Pending<Change>(string, bool)> setExecutable,\n",
    "    fn<Pending<Change>(string, i32)> chmod,\n",
    "    fn<Pending<Change>(string)> openInput,\n",
    "    fn<Pending<Read>()> readChunk,\n",
    "    fn<Pending<string>()> outputError,\n",
    "    fn<Pending<Change>(string)> openOutput,\n",
    "    fn<Pending<HostSocket>(string, i32)> connect,\n",
    "    fn<Pending<HostSocket>(string, i32)> listen,\n",
    "    fn<Pending<HostSocket>(i32)> accept,\n",
    "    fn<Pending<Read>(i32)> recv,\n",
    "    fn<Pending<bool>(i32, u8[])> send,\n",
    "    fn<void(i32)> closeSocket,\n",
    "    fn<void(i32)> closeSend,\n",
    "    fn<Pending<HostSocket>(string, i32)> openFile,\n",
    "    fn<Pending<bool>(i32)> closeFile,\n",
    "    fn<Pending<bool>(bool)> closeOutput,\n",
    "    fn<Pending<HostSocket>(string, i32)> bindDatagram,\n",
    "    fn<Pending<Datagram>(i32)> receiveFrom,\n",
    "    fn<Pending<bool>(i32, string, i32, u8[])> sendTo,\n",
    "    fn<Pending<HostChild>(u8[], u8[][], i32, string, i32, bool)> spawn,\n",
    "    fn<Pending<HostChild>(u8[][], i32, string, i32, bool)> spawnSelf,\n",
    "    fn<void(i32)> closeFeed,\n",
    "    fn<Pending<i32>(i32)> exitCode,\n",
    "    fn<Pending<string>()> cwd,\n",
    "    fn<Pending<bool>(string[], u8[], string, bool)> pushChild,\n",
    "    fn<Pending<Captured>()> popChild,\n",
    "    fn<Pending<Exec>(string, string[], u8[], string[], bool, bool, string)> execWithIn,\n",
    "    fn<LoadedModule(u8[], i32)> load,\n",
    "    fn<CallResult(i32, string, i32)> call,\n",
    "    fn<void(i32)> unload,\n",
    "    fn<string(u8[])> validated,\n",
    "    Sched sched\n",
    "  ) {\n",
    "    return Cli(\n",
    "      () => argCount().on(sched), (i32 a0) => arg(a0).on(sched),\n",
    "      (string a0) => env(a0).on(sched), () => readStdin().on(sched), write, writeErr,\n",
    "      (string a0) => readFile(a0).on(sched), (string a0, u8[] a1) => writeFile(a0, a1).on(sched),\n",
    "      (string a0) => stat(a0).on(sched), (string a0) => linkStat(a0).on(sched),\n",
    "      (string a0) => readDir(a0).on(sched), (string a0, bool a1) => mkdir(a0, a1).on(sched),\n",
    "      (string a0, bool a1) => remove(a0, a1).on(sched),\n",
    "      (string a0, string a1) => rename(a0, a1).on(sched),\n",
    "      (string a0, bool a1) => setExecutable(a0, a1).on(sched),\n",
    "      (string a0, i32 a1) => chmod(a0, a1).on(sched),\n",
    "      (string a0) => openInput(a0).on(sched), () => readChunk().on(sched), () => outputError().on(sched),\n",
    "      (string a0) => openOutput(a0).on(sched), (string a0, i32 a1) => connect(a0, a1).on(sched),\n",
    "      (string a0, i32 a1) => listen(a0, a1).on(sched), (i32 a0) => accept(a0).on(sched),\n",
    "      (i32 a0) => recv(a0).on(sched), (i32 a0, u8[] a1) => send(a0, a1).on(sched), closeSocket,\n",
    "      closeSend, (string a0, i32 a1) => openFile(a0, a1).on(sched), (i32 a0) => closeFile(a0).on(sched),\n",
    "      (bool a0) => closeOutput(a0).on(sched),\n",
    "      (string a0, i32 a1) => bindDatagram(a0, a1).on(sched),\n",
    "      (i32 a0) => receiveFrom(a0).on(sched),\n",
    "      (i32 a0, string a1, i32 a2, u8[] a3) => sendTo(a0, a1, a2, a3).on(sched),\n",
    "      (u8[] a0, u8[][] a1, i32 a2, string a3, i32 a4, bool a5) =>\n",
    "        owned(spawn(a0, a1, a2, a3, a4, a5).on(sched), (a4 & DETACHED) != 0, closeSocket),\n",
    "      (u8[][] a0, i32 a1, string a2, i32 a3, bool a4) =>\n",
    "        owned(spawnSelf(a0, a1, a2, a3, a4).on(sched), (a3 & DETACHED) != 0, closeSocket),\n",
    "      closeFeed, (i32 a0) => exitCode(a0).on(sched), () => cwd().on(sched),\n",
    "      (string[] a0, u8[] a1, string a2, bool a3) => pushChild(a0, a1, a2, a3).on(sched),\n",
    "      () => popChild().on(sched),\n",
    "      (string a0, string[] a1, u8[] a2, string[] a3, bool a4, bool a5, string a6) => execWithIn(a0, a1, a2, a3, a4, a5, a6).on(sched),\n",
    "      load, call, unload, validated, sched\n",
    "    );\n",
    "  }\n",
    "}\n",
    "\n",
    "/**\n",
    " * A spawn's ticket, owning its child (spec ch44; `issues/system/0312b`): dropped while it still holds an\n",
    " * uncollected child, it stops that child, as `closeSocket` on the handle does. `detached` leaves it be.\n",
    " * A ticket already collected answers `settled` false and so stops nothing — the handle is the caller's\n",
    " * by then. Done here, where every host's `Cli` is built, so no host has to know.\n",
    " */\n",
    "Pending<HostChild> owned(Pending<HostChild> p, bool detached, fn<void(i32)> closeSocket) {\n",
    "  if (detached) { return p; }\n",
    "  fn<void(i32)> stop = (i32 id) => {\n",
    "    if (p.settled(id)) {\n",
    "      HostChild c = p.resolve(id);\n",
    "      if (c.handle >= 0) { closeSocket(c.handle); }\n",
    "    }\n",
    "    p.drop(id);\n",
    "  };\n",
    "  return Pending<HostChild>(p.id, p.resolve, p.settled, stop, p.sched, p.waitable);\n",
    "}\n",
    "\n",
    "// ── Sys ─────────────────────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "/**\n",
    " * The authority a program is handed on its `main` (spec ch07, ch44): every effect on the world is\n",
    " * a method reached through one.\n",
    " *\n",
    " * **Built on `Core` and `Cli`**, the two faces the hosts construct, and holding them is how a program\n",
    " * reaches the parts of the host ch44 has not yet given a `Sys` form — directories, processes, the\n",
    " * environment, the terminal, datagrams (its \"Open\" section). That is also the limit of `run`'s\n",
    " * narrowing: the methods here refuse what `held` lacks, and a callee reaching past them to `cli`\n",
    " * holds what the host granted the program.\n",
    " */\n",
    "export struct Sys {\n",
    "  Core core;\n",
    "  Cli cli;\n",
    "  /** The line to this program's parent, which `files` asks once whether the parent serves it files. */\n",
    "  ParentLine parent;\n",
    "\n",
    "  /** The `Sys` a program's `main` is handed — by the program adapter (`wacc/src/program.wac`), or a world of its own. */\n",
    "  Sys __wacOf(Core core, Cli cli) { return Sys(core, cli, ParentLine.on(cli)); }\n",
    "\n",
    "  /** The program's arguments, in order, without its own name. Needs no grant. */\n",
    "  string[] args(const this) {\n",
    "    i32 n = this.cli.argCount().wait();\n",
    "    string[] out = string[].defaulted(n);\n",
    "    for (i32 i = 0; i < n; i++) { out[i] = string.fromBytes(this.cli.arg(i).wait()); }\n",
    "    return out;\n",
    "  }\n",
    "\n",
    "  /** A line on the program's output. */\n",
    "  void log(const this, string line) { this.core.log(line); }\n",
    "\n",
    "  /** A line on the program's diagnostic output. */\n",
    "  void warn(const this, string line) { this.core.warn(line); }\n",
    "\n",
    "  /** Wall-clock time, in milliseconds since the epoch. */\n",
    "  Ticket<i64> nowMillis(const this) { return this.core.nowMillis().ticket(); }\n",
    "\n",
    "  /** Nanoseconds from an arbitrary origin, never decreasing within a run. */\n",
    "  Ticket<i64> monotonicNanos(const this) { return this.core.monotonicNanos().ticket(); }\n",
    "\n",
    "  /** Settles after at least `ms` milliseconds. */\n",
    "  async void sleepMillis(const this, i32 ms) { await this.core.sleepMillis(ms).ticket(); }\n",
    "\n",
    "  /** `n` random bytes. */\n",
    "  Ticket<u8[]> randomBytes(const this, i32 n) { return this.core.randomBytes(n).ticket(); }\n",
    "\n",
    "  /** A file's bytes. A missing file, a directory or a missing grant is an `Err`. */\n",
    "  async Result<u8[], string> readFile(const this, string path) {\n",
    "    FileResult f = await this.cli.readFile(path).ticket();\n",
    "    if (!f.ok) { return Result.Err(f.error); }\n",
    "    return Result.Ok(f.bytes);\n",
    "  }\n",
    "\n",
    "  /** Write `bytes` to a file, replacing it. A missing grant is an `Err`. */\n",
    "  async Result<void, string> writeFile(const this, string path, u8[] bytes) {\n",
    "    Change c = await this.cli.writeFile(path, bytes).ticket();\n",
    "    if (!c.ok()) { return Result.Err(c.message); }\n",
    "    return Result.Ok();\n",
    "  }\n",
    "\n",
    "  /** This program's output (spec ch44). Needs no grant. */\n",
    "  Output stdout(this) {\n",
    "    Cli cli = this.cli;\n",
    "    HostWait wait = this.core.waitAny;\n",
    "    return Output((u8[] b) => hostWrite(cli, false, b), () => hostTicket(cli.closeOutput(false), wait, outputClosedOf));\n",
    "  }\n",
    "\n",
    "  /** This program's diagnostic output. Needs no grant. */\n",
    "  Output stderr(this) {\n",
    "    Cli cli = this.cli;\n",
    "    HostWait wait = this.core.waitAny;\n",
    "    return Output((u8[] b) => hostWrite(cli, true, b), () => hostTicket(cli.closeOutput(true), wait, outputClosedOf));\n",
    "  }\n",
    "\n",
    "  /** This program's input. Needs no grant. */\n",
    "  Input stdin(this) {\n",
    "    Cli cli = this.cli;\n",
    "    HostWait wait = this.core.waitAny;\n",
    "    return Input(() => hostChunk(cli, wait), () => hostReadAll(cli, wait), nothingToClose);\n",
    "  }\n",
    "\n",
    "  /** The clocks. Needs no grant. */\n",
    "  Clock clock(this) { return Clock(this.core); }\n",
    "\n",
    "  /** Random bytes. Needs no grant. */\n",
    "  Random random(this) { return Random(this.core); }\n",
    "\n",
    "  /**\n",
    "   * Whether the user has asked to interrupt (`^C`) since the last time this asked — answered by whoever owns the\n",
    "   * keyboard, so only a page says yes; Deno, Node and the native hosts own none and always say no. Needs no grant.\n",
    "   * A long loop asks once per block of work and stops with 130, as a shell reports a program `^C` ended.\n",
    "   */\n",
    "  bool interrupted(const this) { return this.core.interrupted(); }\n",
    "\n",
    "  /** The environment. Each operation answers `NotGranted` when the host withheld it. */\n",
    "  Env env(this) { return Env(this.cli, this.core.waitAny); }\n",
    "\n",
    "  /**\n",
    "   * The files this program was given: what its parent serves when it was spawned with a composed `Files` (spec ch44\n",
    "   * `§wac-std-files-served-t5h2mzr`), and otherwise the host's, where each operation answers `NotGranted` when the host\n",
    "   * withheld it.\n",
    "   */\n",
    "  Files files(this) {\n",
    "    if (this.parent.serves()) { return parentFiles(this.parent); }\n",
    "    return Files.host(this.cli, this.core.waitAny);\n",
    "  }\n",
    "\n",
    "  /** The network. Each operation answers `NotGranted` when the host withheld it. */\n",
    "  Net net(this) { return Net(this.cli, this.core.waitAny); }\n",
    "\n",
    "  /** Starting other programs, this one included. Each operation answers `NotGranted` when the host withheld it. */\n",
    "  Procs procs(this) { return Procs(this.cli, this.core.waitAny); }\n",
    "\n",
    "  /** Loading wasm modules into this instance. */\n",
    "  Modules modules(this) { return Modules(this.cli); }\n",
    "\n",
    "  /** End the program now with status `code`, abandoning whatever is left. */\n",
    "  never exit(const this, i32 code) {\n",
    "    this.core.exit(code);\n",
    "    trap;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Run the continuations nobody awaited. Work that can never run — a continuation waiting on a ticket\n",
    "   * nothing will settle — leaves this waiting too, and a program waiting on nothing that can move is hung.\n",
    "   */\n",
    "  /**\n",
    "   * `drain` for at most `millis`, answering how many continuations ran — none is how a server tells it was\n",
    "   * idle. What is left over stays outstanding.\n",
    "   */\n",
    "  i32 drainFor(this, i32 millis) { return this.core.drainFor(millis); }\n",
    "\n",
    "  async void drain(this) {\n",
    "    this.core.drain();\n",
    "    if (this.core.outstanding() > 0) {\n",
    "      Ticket<void> stuck;\n",
    "      await stuck;\n",
    "    }\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Run the program until `t` settles, with the work it left unawaited alongside — the program\n",
    "   * adapter's wait on an `async` main. False, having said so, when nothing can move it.\n",
    "   */\n",
    "  bool __wacSettle(this, TicketBase t) {\n",
    "    this.core.sched.yielded = false;\n",
    "    this.core.drainUntil(0 - 1, t);\n",
    "    // **A host that cannot wait is yielded to, not reported as a hang**: the program is still running,\n",
    "    // and the host settles again once an answer has arrived (`__wacYielded`, design `system/0015`).\n",
    "    if (!t.done && !this.core.sched.yielded) {\n",
    "      this.warn(\"main cannot finish: nothing that can run will settle what it waits on\");\n",
    "    }\n",
    "    return t.done;\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Learn, without waiting, whether this program's parent serves it files — the program adapter's first step for an\n",
    "   * `async` `main` (`ParentLine.greet`).\n",
    "   */\n",
    "  async void __wacGreet(this) { await this.parent.greet(); }\n",
    "\n",
    "  /** Whether the last `__wacSettle` stopped because the host cannot wait, rather than because nothing could run. */\n",
    "  bool __wacYielded(const this) { return this.core.sched.yielded; }\n",
    "\n",
    "  /** `main` answered an `Err`: say why, and exit 1. */\n",
    "  i32 __wacFailed(const this, string why) {\n",
    "    this.warn(why == \"\" ? \"main answered an error\" : \"error: \" + why);\n",
    "    return 1;\n",
    "  }\n",
    "}\n",
    "\n",
    "\n",
    "// ── Faults (design/system/0013, spec ch44) ───────────────────────────────────────────────────────\n",
    "//\n",
    "// Each way a capability can fail is a type of its own, and a capability's error is the union of the ones\n",
    "// it can raise, so the signature says what can go wrong and a `match` on it must cover it. Every fault\n",
    "// carries the host's own sentence. The aliases below name the sets the handles share.\n",
    "\n",
    "/** No such file, directory or host. */\n",
    "export struct NotFound {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "/** The world refused: permissions, ownership. */\n",
    "export struct Denied {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "export struct Exists {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "export struct NotEmpty {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "export struct IsDir {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "export struct NotADir {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "export struct ReadOnly {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "export struct NameTooLong {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "/** Too many symbolic links. */\n",
    "export struct Loop {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "export struct NoSpace {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "/** A name this host cannot spell. */\n",
    "export struct NotRepresentable {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "/** Nothing is listening there. */\n",
    "export struct Refused {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "export struct Unreachable {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "export struct TimedOut {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "/** The reader of this program's output or diagnostic output has gone — `yes | head`. */\n",
    "export struct OutputClosed {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "/** The other end of a socket has gone. */\n",
    "export struct PeerClosed {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "/** This program was not given that authority. */\n",
    "export struct NotGranted {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "/** This host does not provide the capability. A capability it lacks answers this, and never traps. */\n",
    "export struct Unsupported {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "/** A failure no category above names, with whatever the host said. */\n",
    "export struct Other {\n",
    "  string message;\n",
    "  /** The host's sentence (spec ch23 `§wac-interp-union-member-m3vq8ke`: a union of faults converts through this). */\n",
    "  string [toString](const this) { return this.message; }\n",
    "}\n",
    "\n",
    "/** Reading a file or opening it to read. */\n",
    "export type ReadFault = union<NotFound, Denied, IsDir, NotADir, NameTooLong, Loop, NotRepresentable, NotGranted,\n",
    "                              Unsupported, Other>;\n",
    "/** Writing a file or opening it to write. */\n",
    "export type WriteFault = union<NotFound, Denied, IsDir, NotADir, NameTooLong, Loop, NotRepresentable, NoSpace,\n",
    "                               ReadOnly, NotGranted, Unsupported, Other>;\n",
    "/** Looking at a path without changing it: `stat`, `readDir`. */\n",
    "export type LookFault = union<NotFound, Denied, NotADir, NameTooLong, Loop, NotRepresentable, NotGranted,\n",
    "                              Unsupported, Other>;\n",
    "/** Making a directory. */\n",
    "export type MkdirFault = union<Exists, NotFound, Denied, NotADir, NameTooLong, Loop, NotRepresentable, NoSpace,\n",
    "                               ReadOnly, NotGranted, Unsupported, Other>;\n",
    "/** Removing or renaming. */\n",
    "export type MoveFault = union<NotFound, Denied, IsDir, NotADir, NotEmpty, Exists, NameTooLong, Loop,\n",
    "                              NotRepresentable, NoSpace, ReadOnly, NotGranted, Unsupported, Other>;\n",
    "/** Changing a file's mode. */\n",
    "export type ModeFault = union<NotFound, Denied, NotADir, NameTooLong, Loop, NotRepresentable, ReadOnly,\n",
    "                              NotGranted, Unsupported, Other>;\n",
    "/** Writing to this program's output or diagnostic output. */\n",
    "export type OutputFault = union<OutputClosed, NoSpace, Unsupported, Other>;\n",
    "/** What any capability with no category of its own can answer. */\n",
    "export type HostFault = union<Unsupported, Other>;\n",
    "/** Asking the host something that needs a grant and nothing else can go wrong with. */\n",
    "export type GrantedFault = union<NotGranted, Unsupported, Other>;\n",
    "\n",
    "ReadFault readFault(i32 code, string m) {\n",
    "  if (code == FAULT_NOT_FOUND()) { return NotFound(m); }\n",
    "  if (code == FAULT_DENIED()) { return Denied(m); }\n",
    "  if (code == FAULT_IS_DIR()) { return IsDir(m); }\n",
    "  if (code == FAULT_NOT_A_DIR()) { return NotADir(m); }\n",
    "  if (code == FAULT_NAME_TOO_LONG()) { return NameTooLong(m); }\n",
    "  if (code == FAULT_LOOP()) { return Loop(m); }\n",
    "  if (code == FAULT_NOT_REPRESENTABLE()) { return NotRepresentable(m); }\n",
    "  if (code == FAULT_NOT_GRANTED()) { return NotGranted(m); }\n",
    "  if (code == FAULT_UNSUPPORTED()) { return Unsupported(m); }\n",
    "  return Other(m);\n",
    "}\n",
    "\n",
    "WriteFault writeFault(i32 code, string m) {\n",
    "  if (code == FAULT_NO_SPACE()) { return NoSpace(m); }\n",
    "  if (code == FAULT_READ_ONLY()) { return ReadOnly(m); }\n",
    "  return readFault(code, m);\n",
    "}\n",
    "\n",
    "LookFault lookFault(i32 code, string m) {\n",
    "  if (code == FAULT_NOT_FOUND()) { return NotFound(m); }\n",
    "  if (code == FAULT_DENIED()) { return Denied(m); }\n",
    "  if (code == FAULT_NOT_A_DIR()) { return NotADir(m); }\n",
    "  if (code == FAULT_NAME_TOO_LONG()) { return NameTooLong(m); }\n",
    "  if (code == FAULT_LOOP()) { return Loop(m); }\n",
    "  if (code == FAULT_NOT_REPRESENTABLE()) { return NotRepresentable(m); }\n",
    "  if (code == FAULT_NOT_GRANTED()) { return NotGranted(m); }\n",
    "  if (code == FAULT_UNSUPPORTED()) { return Unsupported(m); }\n",
    "  return Other(m);\n",
    "}\n",
    "\n",
    "MkdirFault mkdirFault(i32 code, string m) {\n",
    "  if (code == FAULT_EXISTS()) { return Exists(m); }\n",
    "  if (code == FAULT_NO_SPACE()) { return NoSpace(m); }\n",
    "  if (code == FAULT_READ_ONLY()) { return ReadOnly(m); }\n",
    "  return lookFault(code, m);\n",
    "}\n",
    "\n",
    "MoveFault moveFault(i32 code, string m) {\n",
    "  if (code == FAULT_IS_DIR()) { return IsDir(m); }\n",
    "  if (code == FAULT_NOT_EMPTY()) { return NotEmpty(m); }\n",
    "  return mkdirFault(code, m);\n",
    "}\n",
    "\n",
    "ModeFault modeFault(i32 code, string m) {\n",
    "  if (code == FAULT_READ_ONLY()) { return ReadOnly(m); }\n",
    "  return lookFault(code, m);\n",
    "}\n",
    "\n",
    "HostFault hostFault(string m) { return Other(m); }\n",
    "\n",
    "// ── The standard streams ─────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "/**\n",
    " * Somewhere this program writes: its output, its diagnostic output, a file opened to write, or a child's input.\n",
    " *\n",
    " * A write whose reader has gone answers `OutputClosed`, and an `OutputClosed` that reaches `main` unhandled ends\n",
    " * the program quietly with status 0 — `yes | head` (spec ch44 `§wac-std-output-closed-c9dspr3`).\n",
    " */\n",
    "/** The host's wait-for-any: block until one of `ids` answers, for at most `millis`; its index, or -1. */\n",
    "export type HostWait = fn<i32(i32[], i32)>;\n",
    "\n",
    "/**\n",
    " * The host's answer `p` as a ticket core can wait on beside others and cancel (design/system/0013): it\n",
    " * carries the host's id, `wait` and a release, so `Ticket.any` over several asks the host once and `cancel`\n",
    " * gives the host its slot back. `f` turns what the host answers into what the handle answers, so a handle's\n",
    " * operation is this ticket itself and not a machine parked on it. **Temporary with `Pending`**: step 6 has\n",
    " * the host's imports make these directly.\n",
    " */\n",
    "Ticket<U> hostTicket<T, U>(Pending<T> p, HostWait wait, fn<U(T)> f) {\n",
    "  Ticket<U> t;\n",
    "  i32 id = p.id;\n",
    "  if (p.settled(id)) {\n",
    "    t.resolve(f(p.resolve(id)));\n",
    "    return t;\n",
    "  }\n",
    "  Sched? s = p.sched;\n",
    "  if (s is not null) { s!.on(id, (i32 k) => { if (!t.done) { t.resolve(f(p.resolve(k))); } }, p.drop); }\n",
    "  t.hostId = id;\n",
    "  t.waitHost = wait;\n",
    "  t.release = () => {\n",
    "    if (s is not null) { s!.off(id); } else { p.drop(id); }\n",
    "  };\n",
    "  t.drive = () => {\n",
    "    if (s is not null) { s!.detach(id); }\n",
    "    if (!t.done) { t.resolve(f(p.wait())); }\n",
    "    return true;\n",
    "  };\n",
    "  return t;\n",
    "}\n",
    "\n",
    "export struct Output {\n",
    "  fn<Ticket<Result<void, OutputFault>>(u8[])> write;\n",
    "  /**\n",
    "   * No more (`§wac-std-close-r4v8ndq`): whoever reads it sees the end, and a file holds what was written once this\n",
    "   * answers — a browser commits a file only here.\n",
    "   */\n",
    "  fn<Ticket<Result<void, OutputFault>>()> close;\n",
    "\n",
    "  /** `text` and a newline. */\n",
    "  Ticket<Result<void, OutputFault>> line(const this, string text) { return this.write((text + \"\\n\").toBytes()); }\n",
    "}\n",
    "\n",
    "/** Somewhere this program reads: its input, a file opened to read, or a child's output. */\n",
    "export struct Input {\n",
    "  /** The next bytes, or the end (`§wac-std-input-u7m2rjd`). Never `Read.Failed`: a failure is the `Err`. */\n",
    "  fn<Ticket<Result<Read, HostFault>>()> chunk;\n",
    "  /** Everything up to the end. */\n",
    "  fn<Ticket<Result<u8[], HostFault>>()> readAll;\n",
    "  /** Done reading: a file's handle goes back to the host. This program's input and a child's output need nothing. */\n",
    "  fn<Ticket<Result<void, HostFault>>()> close;\n",
    "}\n",
    "\n",
    "async Result<void, OutputFault> hostWrite(Cli cli, bool toErr, u8[] bytes) {\n",
    "  bool went = toErr ? cli.writeErr(bytes) : cli.write(bytes);\n",
    "  if (went) { return Result.Ok(); }\n",
    "  // `outputError` tells a departed reader (\"\") from a real failure (its sentence).\n",
    "  string why = await cli.outputError().ticket();\n",
    "  if (why == \"\") { return Result.Err(OutputClosed(toErr ? \"the diagnostic output's reader has gone\" : \"the output's reader has gone\")); }\n",
    "  return Result.Err(Other(why));\n",
    "}\n",
    "\n",
    "Result<Read, HostFault> readOf(Read c) {\n",
    "  match (c) {\n",
    "    Failed(why): { return Result.Err(Other(why)); }\n",
    "    default: { return Result.Ok(c); }\n",
    "  }\n",
    "}\n",
    "\n",
    "Ticket<Result<Read, HostFault>> hostChunk(Cli cli, HostWait wait) { return hostTicket(cli.readChunk(), wait, readOf); }\n",
    "\n",
    "Result<u8[], HostFault> allOf(u8[] b) { return Result.Ok(b); }\n",
    "\n",
    "Ticket<Result<u8[], HostFault>> hostReadAll(Cli cli, HostWait wait) { return hostTicket(cli.readStdin(), wait, allOf); }\n",
    "\n",
    "async Result<void, HostFault> nothingToClose() { return Result.Ok(); }\n",
    "\n",
    "Result<void, OutputFault> outputClosedOf(bool went) {\n",
    "  if (!went) { return Result.Err(Other(\"the output could not be closed\")); }\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "// ── Time, randomness, the environment ────────────────────────────────────────────────────────────\n",
    "\n",
    "/** The clocks (spec ch44 `§wac-std-time-mzn6gvc`). Needs no grant. */\n",
    "export struct Clock {\n",
    "  Core core;\n",
    "\n",
    "  /** Wall-clock time, in milliseconds since the epoch. */\n",
    "  Ticket<Result<i64, union<Unsupported>>> nowMillis(const this) { return hostTicket(this.core.nowMillis(), this.core.waitAny, timeOf); }\n",
    "  /** Nanoseconds from an arbitrary origin, never decreasing within a run. */\n",
    "  Ticket<Result<i64, union<Unsupported>>> monotonicNanos(const this) {\n",
    "    return hostTicket(this.core.monotonicNanos(), this.core.waitAny, timeOf);\n",
    "  }\n",
    "  /** Settles after at least `ms` milliseconds. */\n",
    "  Ticket<Result<void, union<Unsupported>>> sleepMillis(const this, i32 ms) {\n",
    "    return hostTicket(this.core.sleepMillis(ms), this.core.waitAny, sleptOf);\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * What `t` answers, or `TimedOut` when it has not answered within `millis` (spec ch44\n",
    "   * `§wac-std-within-8mdio9r`) — a negative `millis` sets no deadline. Whichever loses is cancelled here, so a\n",
    "   * deadline never leaves the host holding a slot. `Unsupported` is a capability's already, so the error is\n",
    "   * `t`'s with `TimedOut` beside it.\n",
    "   */\n",
    "  Ticket<Result<A, union<E, TimedOut, Unsupported>>> within<A, E>(this, Ticket<Result<A, E>> t, i32 millis) {\n",
    "    // **Driven, not `async`**, as `Ticket.any` is: settled from `Ticket.first` over `t` and the timer, so it\n",
    "    // builds no machine — and `parts` lets a `wait` find the host work beneath it, so a `within` inside a\n",
    "    // `Ticket.any` is waited on together with the rest.\n",
    "    Ticket<Result<A, union<E, TimedOut, Unsupported>>> out;\n",
    "    Ticket<Result<void, union<Unsupported>>>? timer = null;\n",
    "    TicketBase[] racing = [t];\n",
    "    if (millis >= 0) {\n",
    "      timer = this.sleepMillis(millis);\n",
    "      racing = [t, timer!];\n",
    "    }\n",
    "    Ticket<i32> w = Ticket.first(racing);\n",
    "    fn<void()> settle = () => {\n",
    "      if (out.done || !w.done) { return; }\n",
    "      if (w.value() == 1) {\n",
    "        t.cancel();\n",
    "        if (timer!.value().isErr()) { out.resolve(Result.Err(Unsupported(\"this host has no timer to bound a wait by\"))); }\n",
    "        else { out.resolve(Result.Err(TimedOut(\"no answer within \\{millis}ms\"))); }\n",
    "        return;\n",
    "      }\n",
    "      if (timer is not null) { timer!.cancel(); }\n",
    "      Result<A, union<E, TimedOut, Unsupported>> r = match (t.value()) { Ok(a): Result.Ok(a), Err(e): Result.Err(e) };\n",
    "      out.resolve(r);\n",
    "    };\n",
    "    w.whenSettled(settle);\n",
    "    TicketBase[] under = [w];\n",
    "    out.parts = under;\n",
    "    out.drive = () => {\n",
    "      bool moved = w.advance();\n",
    "      settle();\n",
    "      return moved;\n",
    "    };\n",
    "    settle();\n",
    "    return out;\n",
    "  }\n",
    "\n",
    "}\n",
    "\n",
    "Result<i64, union<Unsupported>> timeOf(i64 v) { return Result.Ok(v); }\n",
    "Result<void, union<Unsupported>> sleptOf(i64 v) { return Result.Ok(); }\n",
    "\n",
    "/** Random bytes. Needs no grant. */\n",
    "export struct Random {\n",
    "  Core core;\n",
    "\n",
    "  Ticket<Result<u8[], union<Unsupported>>> bytes(const this, i32 n) { return hostTicket(this.core.randomBytes(n), this.core.waitAny, bytesOk); }\n",
    "}\n",
    "\n",
    "Result<u8[], union<Unsupported>> bytesOk(u8[] b) { return Result.Ok(b); }\n",
    "\n",
    "/** The environment's variables and the directory relative paths resolve from. */\n",
    "export struct Env {\n",
    "  Cli cli;\n",
    "  HostWait wait;\n",
    "\n",
    "  /**\n",
    "   * A variable's value, `Ok(null)` when it is not set (`§wac-std-env-unset-r4c8tqb`).\n",
    "   *\n",
    "   * **Not yet able to say `NotGranted`**: the hosts answer a withheld environment as an unset variable, and\n",
    "   * which it was is `issues/system/0261c`, which the host half of design/system/0013 settles.\n",
    "   */\n",
    "  Ticket<Result<u8[]?, GrantedFault>> get(const this, string name) { return hostTicket(this.cli.env(name), this.wait, envOf); }\n",
    "\n",
    "  /** Where relative paths resolve from. */\n",
    "  Ticket<Result<string, HostFault>> cwd(const this) { return hostTicket(this.cli.cwd(), this.wait, cwdOf); }\n",
    "}\n",
    "\n",
    "Result<u8[]?, GrantedFault> envOf(u8[]? v) { return Result.Ok(v); }\n",
    "Result<string, HostFault> cwdOf(string v) { return Result.Ok(v); }\n",
    "\n",
    "// ── Files ────────────────────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "/**\n",
    " * A filesystem, as a value built from functions (spec ch44 `§wac-std-files-compose-h6vq3ne`).\n",
    " *\n",
    " * A backing is a constructor: the host's own, `readOnly` over any `Files`, `mounted` routing each path to the\n",
    " * mount that owns it — and, outside std, `packages/fs`'s trees held in memory, generated `/proc` and `/dev`,\n",
    " * and images. Each operation is a field, so a backing supplies exactly the functions and nothing branches on\n",
    " * which backing it is.\n",
    " */\n",
    "export struct Files {\n",
    "  fn<Ticket<Result<u8[], ReadFault>>(string)> readFile;\n",
    "  fn<Ticket<Result<void, WriteFault>>(string, u8[])> writeFile;\n",
    "  /** The file to read a piece at a time; `close` it when done. */\n",
    "  fn<Ticket<Result<Input, ReadFault>>(string)> openRead;\n",
    "  /** The file, created or emptied, to write a piece at a time; what was written is there once `close` answers. */\n",
    "  fn<Ticket<Result<Output, WriteFault>>(string)> openWrite;\n",
    "  /** The same, writing after what is there — created if it is not. */\n",
    "  fn<Ticket<Result<Output, WriteFault>>(string)> openAppend;\n",
    "  fn<Ticket<Result<Stat, LookFault>>(string)> stat;\n",
    "  /** `stat` of a symbolic link itself rather than what it names. */\n",
    "  fn<Ticket<Result<Stat, LookFault>>(string)> linkStat;\n",
    "  fn<Ticket<Result<string[], LookFault>>(string)> readDir;\n",
    "  fn<Ticket<Result<void, MkdirFault>>(string, bool)> mkdir;\n",
    "  fn<Ticket<Result<void, MoveFault>>(string, bool)> remove;\n",
    "  fn<Ticket<Result<void, MoveFault>>(string, string)> rename;\n",
    "  fn<Ticket<Result<void, ModeFault>>(string, i32)> chmod;\n",
    "  fn<Ticket<Result<void, ModeFault>>(string, bool)> setExecutable;\n",
    "  /** Give a file to another owner, which is root's to do — `Unsupported` on the host, whose owners are not names. */\n",
    "  fn<Ticket<Result<void, ModeFault>>(string, string)> chown;\n",
    "  /**\n",
    "   * The `GRANT_*` bits a spawned child can be handed instead of these files: `GRANT_READ | GRANT_WRITE` for the\n",
    "   * host's own, `GRANT_READ` read-only, and 0 for anything composed, which the parent has to serve.\n",
    "   */\n",
    "  i32 hostGrants;\n",
    "  /**\n",
    "   * Who these files act as: the owner of what they create and the name each permission check is against. `\"\"` for\n",
    "   * the host's, whose owners are not names; the name for `store.asUser(name)`; and the parent's for files a parent\n",
    "   * serves, which is how a spawned `whoami` knows the session it runs in.\n",
    "   */\n",
    "  string user;\n",
    "\n",
    "  /** The host's filesystem, under whatever grants the host gave this program. */\n",
    "  Files host(Cli cli, HostWait wait) {\n",
    "    return Files(\n",
    "      (string p) => hostTicket(cli.readFile(p), wait, readOfFile),\n",
    "      (string p, u8[] b) => hostTicket(cli.writeFile(p, b), wait, writtenOf),\n",
    "      (string p) => hostTicket(cli.openFile(p, OPEN_READ), wait, (HostSocket s) => openedToRead(cli, wait, p, s)),\n",
    "      (string p) => hostTicket(cli.openFile(p, OPEN_WRITE), wait, (HostSocket s) => openedToWrite(cli, wait, p, s)),\n",
    "      (string p) => hostTicket(cli.openFile(p, OPEN_APPEND), wait, (HostSocket s) => openedToWrite(cli, wait, p, s)),\n",
    "      (string p) => hostTicket(cli.stat(p), wait, (Stat s) => statOf(s, p)),\n",
    "      (string p) => hostTicket(cli.linkStat(p), wait, (Stat s) => statOf(s, p)),\n",
    "      (string p) => hostReadDir(cli, wait, p),\n",
    "      (string p, bool parents) => hostTicket(cli.mkdir(p, parents), wait, madeOf),\n",
    "      (string p, bool recursive) => hostTicket(cli.remove(p, recursive), wait, movedOf),\n",
    "      (string from, string to) => hostTicket(cli.rename(from, to), wait, movedOf),\n",
    "      (string p, i32 mode) => hostTicket(cli.chmod(p, mode), wait, modeOf),\n",
    "      (string p, bool on) => hostTicket(cli.setExecutable(p, on), wait, modeOf),\n",
    "      (string p, string owner) => hostChown(p),\n",
    "      GRANT_READ | GRANT_WRITE, \"\");\n",
    "  }\n",
    "\n",
    "  /** The same files, every change answering `NotGranted`. */\n",
    "  Files readOnly(this) {\n",
    "    return Files(this.readFile, (string p, u8[] b) => refusedWrite(p), this.openRead,\n",
    "                 (string p) => refusedOpen(p), (string p) => refusedOpen(p), this.stat, this.linkStat, this.readDir,\n",
    "                 (string p, bool parents) => refusedMkdir(p), (string p, bool r) => refusedMove(p),\n",
    "                 (string from, string to) => refusedMove(from), (string p, i32 mode) => refusedMode(p),\n",
    "                 (string p, bool on) => refusedMode(p), (string p, string owner) => refusedMode(p),\n",
    "                 this.hostGrants & GRANT_READ, this.user);\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * The same files, every read answering `NotGranted` — what `--allow-write` without `--allow-read` holds. A\n",
    "   * change still lands; what is there cannot be looked at, its existence included.\n",
    "   */\n",
    "  Files writeOnly(this) {\n",
    "    return Files((string p) => refusedRead(p), this.writeFile, (string p) => refusedOpenRead(p), this.openWrite,\n",
    "                 this.openAppend, (string p) => refusedLook(p), (string p) => refusedLook(p),\n",
    "                 (string p) => refusedList(p), this.mkdir, this.remove, this.rename, this.chmod, this.setExecutable,\n",
    "                 this.chown, this.hostGrants & GRANT_WRITE, this.user);\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * The same files, a relative path starting at `dir` — a shell's current directory. `.` and `..` are taken out\n",
    "   * before the path goes on, and an absolute path goes on as it is. A child handed this is told `dir` when it is\n",
    "   * spawned, so the host's grants carry over.\n",
    "   */\n",
    "  Files relativeTo(this, string dir) {\n",
    "    Files f = this;\n",
    "    return Files(\n",
    "      (string p) => f.readFile(pathFrom(dir, p)),\n",
    "      (string p, u8[] b) => f.writeFile(pathFrom(dir, p), b),\n",
    "      (string p) => f.openRead(pathFrom(dir, p)),\n",
    "      (string p) => f.openWrite(pathFrom(dir, p)),\n",
    "      (string p) => f.openAppend(pathFrom(dir, p)),\n",
    "      (string p) => f.stat(pathFrom(dir, p)),\n",
    "      (string p) => f.linkStat(pathFrom(dir, p)),\n",
    "      (string p) => f.readDir(pathFrom(dir, p)),\n",
    "      (string p, bool parents) => f.mkdir(pathFrom(dir, p), parents),\n",
    "      (string p, bool r) => f.remove(pathFrom(dir, p), r),\n",
    "      (string from, string to) => f.rename(pathFrom(dir, from), pathFrom(dir, to)),\n",
    "      (string p, i32 mode) => f.chmod(pathFrom(dir, p), mode),\n",
    "      (string p, bool on) => f.setExecutable(pathFrom(dir, p), on),\n",
    "      (string p, string owner) => f.chown(pathFrom(dir, p), owner),\n",
    "      f.hostGrants, f.user);\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Each path to the mount whose `at` is its longest prefix, with that prefix taken off — `/` mounted last is\n",
    "   * everything else. A rename across two mounts is `Other`, as a rename across two devices is. A listing has the\n",
    "   * mount points directly under it among its names, as a directory holding a mount point does. The user is the\n",
    "   * root mount's, `\"\"` when nothing is mounted at `/`.\n",
    "   */\n",
    "  Files mounted(Mount[] mounts) {\n",
    "    return Files(\n",
    "      (string p) => mountOf(mounts, p).files.readFile(innerOf(mounts, p)),\n",
    "      (string p, u8[] b) => mountOf(mounts, p).files.writeFile(innerOf(mounts, p), b),\n",
    "      (string p) => mountOf(mounts, p).files.openRead(innerOf(mounts, p)),\n",
    "      (string p) => mountOf(mounts, p).files.openWrite(innerOf(mounts, p)),\n",
    "      (string p) => mountOf(mounts, p).files.openAppend(innerOf(mounts, p)),\n",
    "      (string p) => mountOf(mounts, p).files.stat(innerOf(mounts, p)),\n",
    "      (string p) => mountOf(mounts, p).files.linkStat(innerOf(mounts, p)),\n",
    "      (string p) => mountedReadDir(mounts, p),\n",
    "      (string p, bool parents) => mountOf(mounts, p).files.mkdir(innerOf(mounts, p), parents),\n",
    "      (string p, bool r) => mountOf(mounts, p).files.remove(innerOf(mounts, p), r),\n",
    "      (string from, string to) => mountedRename(mounts, from, to),\n",
    "      (string p, i32 mode) => mountOf(mounts, p).files.chmod(innerOf(mounts, p), mode),\n",
    "      (string p, bool on) => mountOf(mounts, p).files.setExecutable(innerOf(mounts, p), on),\n",
    "      (string p, string owner) => mountOf(mounts, p).files.chown(innerOf(mounts, p), owner),\n",
    "      0, rootUser(mounts));\n",
    "  }\n",
    "}\n",
    "\n",
    "/** One mount of `Files.mounted`: `files` answers every path under `at`. */\n",
    "export struct Mount {\n",
    "  string at;\n",
    "  Files files;\n",
    "}\n",
    "\n",
    "/** The user of the mount at `/`, or `\"\"`. */\n",
    "string rootUser(Mount[] mounts) {\n",
    "  for (i32 i = 0; i < mounts.len(); i++) {\n",
    "    if (mounts[i].at == \"/\" || mounts[i].at == \"\") { return mounts[i].files.user; }\n",
    "  }\n",
    "  return \"\";\n",
    "}\n",
    "\n",
    "/** `p` from `dir`: as it is when absolute, else after `dir`, with `.` and `..` taken out either way. */\n",
    "string pathFrom(string dir, string p) {\n",
    "  if (p.len() > 0 && p.slice(0, 1) == \"/\") { return normalPath(p); }\n",
    "  if (p == \"\") { return normalPath(dir); }\n",
    "  return normalPath(dir + \"/\" + p);\n",
    "}\n",
    "\n",
    "/**\n",
    " * `p` without `.`, `..` or repeated slashes. An absolute path stays absolute and `..` stops at its root; a relative\n",
    " * one keeps the `..`s it starts with, so the view beneath can resolve them.\n",
    " */\n",
    "string normalPath(string p) {\n",
    "  bool absolute = p.len() > 0 && p.slice(0, 1) == \"/\";\n",
    "  string[] parts = pathParts(p);\n",
    "  string[] kept = string[].filled(parts.len(), \"\");\n",
    "  i32 n = 0;\n",
    "  for (i32 i = 0; i < parts.len(); i++) {\n",
    "    string part = parts[i];\n",
    "    if (part == \".\") { continue; }\n",
    "    if (part == \"..\") {\n",
    "      if (n > 0 && kept[n - 1] != \"..\") { n = n - 1; continue; }\n",
    "      if (absolute) { continue; }\n",
    "    }\n",
    "    kept[n] = part;\n",
    "    n = n + 1;\n",
    "  }\n",
    "  string out = absolute ? \"/\" : \"\";\n",
    "  for (i32 i = 0; i < n; i++) { out = out + (i > 0 ? \"/\" : \"\") + kept[i]; }\n",
    "  return out == \"\" ? \".\" : out;\n",
    "}\n",
    "\n",
    "/** The non-empty components of a path. */\n",
    "string[] pathParts(string p) {\n",
    "  i32 count = 0;\n",
    "  i32 from = 0;\n",
    "  for (i32 i = 0; i <= p.len(); i++) {\n",
    "    if (i < p.len() && p.slice(i, i + 1) != \"/\") { continue; }\n",
    "    if (i > from) { count = count + 1; }\n",
    "    from = i + 1;\n",
    "  }\n",
    "  string[] out = string[].filled(count, \"\");\n",
    "  i32 k = 0;\n",
    "  from = 0;\n",
    "  for (i32 i = 0; i <= p.len(); i++) {\n",
    "    if (i < p.len() && p.slice(i, i + 1) != \"/\") { continue; }\n",
    "    if (i > from) {\n",
    "      out[k] = p.slice(from, i);\n",
    "      k = k + 1;\n",
    "    }\n",
    "    from = i + 1;\n",
    "  }\n",
    "  return out;\n",
    "}\n",
    "\n",
    "// ── A store in memory ────────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "/**\n",
    " * One file or directory in a `MemoryStore`, as `entries` lists it and `restore` takes it back — a directory's\n",
    " * entry comes before anything in it.\n",
    " */\n",
    "export struct StoreEntry {\n",
    "  /** Absolute; the root is `/`. */\n",
    "  string path;\n",
    "  bool isDir;\n",
    "  /** A file's bytes; empty for a directory. */\n",
    "  u8[] data;\n",
    "  i32 mode;\n",
    "  string owner;\n",
    "  i64 modifiedMillis;\n",
    "}\n",
    "\n",
    "/** A node of the store: a directory's names, or a file's bytes, and who may do what to it. */\n",
    "struct StoreNode {\n",
    "  bool isDir;\n",
    "  Map<string, i32> names;\n",
    "  Buf data;\n",
    "  i32 mode;\n",
    "  string owner;\n",
    "  i64 mtime;\n",
    "\n",
    "  void setMode(this, i32 mode) { this.mode = mode; }\n",
    "  void setOwner(this, string owner) { this.owner = owner; }\n",
    "  void replace(this, u8[] b, i64 now) {\n",
    "    this.data = Buf.create();\n",
    "    this.data.pushAll(b);\n",
    "    this.mtime = now;\n",
    "  }\n",
    "  void append(this, u8[] b, i64 now) {\n",
    "    this.data.pushAll(b);\n",
    "    this.mtime = now;\n",
    "  }\n",
    "  void touch(this, i64 now) { this.mtime = now; }\n",
    "}\n",
    "\n",
    "/**\n",
    " * **Files that live in this program's memory, with owners** (spec ch44 `§wac-std-memory-store-p4k7wzn`).\n",
    " *\n",
    " * One tree, and `asUser` a `Files` acting as one person on it: what that view creates is theirs, and every\n",
    " * operation is checked against the mode for them — owner bits for the owner, the last three for everybody\n",
    " * else, and no groups, because there is no group table. `\"root\"` is exempt. What is checked is the file or\n",
    " * directory touched, not the directories on the way to it.\n",
    " *\n",
    " * The clock stamps each change, and a host with no clock stamps 0.\n",
    " */\n",
    "export struct MemoryStore {\n",
    "  /** Every node ever made, the root first; a removed one is left unreachable rather than moved. */\n",
    "  Vec<StoreNode> nodes;\n",
    "  Clock clock;\n",
    "\n",
    "  /** An empty store: a root directory, `0755`, owned by root. */\n",
    "  MemoryStore create(Clock clock) {\n",
    "    Vec<StoreNode> nodes = Vec.create();\n",
    "    nodes.push(storeDir(\"root\", 0 as i64));\n",
    "    return MemoryStore(nodes, clock);\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * A store holding `entries` — what `entries` gave, or the same shape from an image. `Err` when an entry's\n",
    "   * directory is not before it, when a path comes twice, or when the first entry is not the root directory.\n",
    "   */\n",
    "  Result<MemoryStore, Other> restore(Clock clock, StoreEntry[] entries) {\n",
    "    if (entries.len() == 0 || normalPath(entries[0].path) != \"/\" || !entries[0].isDir) {\n",
    "      return Result.Err(Other(\"the first entry must be the root directory\"));\n",
    "    }\n",
    "    Vec<StoreNode> nodes = Vec.create();\n",
    "    MemoryStore store = MemoryStore(nodes, clock);\n",
    "    nodes.push(StoreNode(true, Map.create(hashString, stringEq), Buf.create(), entries[0].mode, entries[0].owner,\n",
    "                         entries[0].modifiedMillis));\n",
    "    for (i32 i = 1; i < entries.len(); i++) {\n",
    "      StoreEntry e = entries[i];\n",
    "      string p = normalPath(e.path);\n",
    "      i32 parent = store.find(storeParent(p));\n",
    "      if (parent < 0 || !nodes.get(parent).isDir) {\n",
    "        return Result.Err(Other(p + \": its directory is not before it\"));\n",
    "      }\n",
    "      if (nodes.get(parent).names.has(storeBase(p))) { return Result.Err(Other(p + \": listed twice\")); }\n",
    "      Buf held = Buf.create();\n",
    "      if (!e.isDir) { held.pushAll(e.data); }\n",
    "      nodes.push(StoreNode(e.isDir, Map.create(hashString, stringEq), held, e.mode, e.owner, e.modifiedMillis));\n",
    "      nodes.get(parent).names.set(storeBase(p), nodes.len() - 1);\n",
    "    }\n",
    "    return Result.Ok(store);\n",
    "  }\n",
    "\n",
    "  /** Every file and directory, each directory before what is in it and names in byte order — what `restore` takes. */\n",
    "  StoreEntry[] entries(this) {\n",
    "    Vec<StoreEntry> out = Vec.create();\n",
    "    this.listInto(out, 0, \"/\");\n",
    "    StoreEntry[] all = StoreEntry[].filled(out.len(), StoreEntry(\"\", false, u8[](), 0, \"\", 0 as i64));\n",
    "    for (i32 i = 0; i < out.len(); i++) { all[i] = out.get(i); }\n",
    "    return all;\n",
    "  }\n",
    "\n",
    "  void listInto(this, Vec<StoreEntry> out, i32 node, string path) {\n",
    "    StoreNode n = this.nodes.get(node);\n",
    "    out.push(StoreEntry(path, n.isDir, n.isDir ? u8[]() : n.data.bytes(), n.mode, n.owner, n.mtime));\n",
    "    if (!n.isDir) { return; }\n",
    "    string[] names = sortedNames(n.names.keys());\n",
    "    for (i32 i = 0; i < names.len(); i++) {\n",
    "      this.listInto(out, n.names.getOr(names[i], 0), (path == \"/\" ? \"/\" : path + \"/\") + names[i]);\n",
    "    }\n",
    "  }\n",
    "\n",
    "  /** This store as `user` sees it. A relative path is from the root; `relativeTo` gives it somewhere else to start. */\n",
    "  Files asUser(this, string user) {\n",
    "    MemoryStore st = this;\n",
    "    return Files(\n",
    "      (string p) => memRead(st, user, p),\n",
    "      (string p, u8[] b) => memWrite(st, user, p, b),\n",
    "      (string p) => memOpenRead(st, user, p),\n",
    "      (string p) => memOpenWrite(st, user, p, true),\n",
    "      (string p) => memOpenWrite(st, user, p, false),\n",
    "      (string p) => memStat(st, p),\n",
    "      (string p) => memStat(st, p),\n",
    "      (string p) => memReadDir(st, user, p),\n",
    "      (string p, bool parents) => memMkdir(st, user, p, parents),\n",
    "      (string p, bool r) => memRemove(st, user, p, r),\n",
    "      (string from, string to) => memRename(st, user, from, to),\n",
    "      (string p, i32 mode) => memChmod(st, user, p, mode),\n",
    "      (string p, bool on) => memSetExecutable(st, user, p, on),\n",
    "      (string p, string owner) => memChown(st, user, p, owner),\n",
    "      0, user);\n",
    "  }\n",
    "\n",
    "  /** The node at an absolute normal path, or `STORE_NONE` / `STORE_NOT_A_DIR`. */\n",
    "  i32 find(const this, string p) {\n",
    "    string[] parts = pathParts(p);\n",
    "    i32 at = 0;\n",
    "    for (i32 i = 0; i < parts.len(); i++) {\n",
    "      if (!this.nodes.get(at).isDir) { return STORE_NOT_A_DIR; }\n",
    "      i32 next = this.nodes.get(at).names.getOr(parts[i], 0 - 1);\n",
    "      if (next < 0) { return STORE_NONE; }\n",
    "      at = next;\n",
    "    }\n",
    "    return at;\n",
    "  }\n",
    "\n",
    "  /** Whether `user` may do `want` — 4 read, 2 write, 1 execute — to a node. */\n",
    "  bool may(const this, string user, i32 node, i32 want) {\n",
    "    if (user == \"root\") { return true; }\n",
    "    const StoreNode n = this.nodes.get(node);\n",
    "    i32 bits = n.owner == user ? (n.mode >> 6) & 7 : n.mode & 7;\n",
    "    return (bits & want) == want;\n",
    "  }\n",
    "}\n",
    "\n",
    "static i32 STORE_NONE = 0 - 1;\n",
    "static i32 STORE_NOT_A_DIR = 0 - 2;\n",
    "\n",
    "StoreNode storeDir(string owner, i64 now) {\n",
    "  return StoreNode(true, Map.create(hashString, stringEq), Buf.create(), 493, owner, now);   // 0755\n",
    "}\n",
    "\n",
    "StoreNode storeFile(string owner, i64 now) {\n",
    "  return StoreNode(false, Map.create(hashString, stringEq), Buf.create(), 420, owner, now);  // 0644\n",
    "}\n",
    "\n",
    "/** The directory above an absolute normal path: `/a/b` gives `/a`, and `/a` gives `/`. */\n",
    "string storeParent(string p) {\n",
    "  i32 cut = 0;\n",
    "  for (i32 i = 0; i < p.len(); i++) { if (p.slice(i, i + 1) == \"/\") { cut = i; } }\n",
    "  return cut == 0 ? \"/\" : p.slice(0, cut);\n",
    "}\n",
    "\n",
    "/** The last component: `/a/b` gives `b`, and `/` gives `\"\"`. */\n",
    "string storeBase(string p) {\n",
    "  i32 cut = 0;\n",
    "  for (i32 i = 0; i < p.len(); i++) { if (p.slice(i, i + 1) == \"/\") { cut = i; } }\n",
    "  return p.slice(cut + 1, p.len());\n",
    "}\n",
    "\n",
    "/** The names, sorted by their bytes. */\n",
    "string[] sortedNames(string[] names) {\n",
    "  for (i32 i = 1; i < names.len(); i++) {\n",
    "    string v = names[i];\n",
    "    i32 j = i - 1;\n",
    "    while (j >= 0 && bytesAfter(names[j], v)) {\n",
    "      names[j + 1] = names[j];\n",
    "      j = j - 1;\n",
    "    }\n",
    "    names[j + 1] = v;\n",
    "  }\n",
    "  return names;\n",
    "}\n",
    "\n",
    "bool bytesAfter(string a, string b) {\n",
    "  u8[] x = a.toBytes();\n",
    "  u8[] y = b.toBytes();\n",
    "  i32 n = x.len() < y.len() ? x.len() : y.len();\n",
    "  for (i32 i = 0; i < n; i++) {\n",
    "    if (x[i] != y[i]) { return x[i] > y[i]; }\n",
    "  }\n",
    "  return x.len() > y.len();\n",
    "}\n",
    "\n",
    "async i64 storeNow(Clock clock) {\n",
    "  match (await clock.nowMillis()) {\n",
    "    Ok(t): { return t; }\n",
    "    Err(e): { return 0 as i64; }\n",
    "  }\n",
    "}\n",
    "\n",
    "string noSuchFile(string p) { return p + \": No such file or directory\"; }\n",
    "string notADirectory(string p) { return p + \": Not a directory\"; }\n",
    "string permissionDenied(string p) { return p + \": Permission denied\"; }\n",
    "string notPermitted(string p) { return p + \": Operation not permitted\"; }\n",
    "\n",
    "async Result<u8[], ReadFault> memRead(MemoryStore st, string user, string path) {\n",
    "  string p = normalPath(\"/\" + path);\n",
    "  i32 node = st.find(p);\n",
    "  if (node == STORE_NOT_A_DIR) { return Result.Err(NotADir(notADirectory(p))); }\n",
    "  if (node < 0) { return Result.Err(NotFound(noSuchFile(p))); }\n",
    "  if (st.nodes.get(node).isDir) { return Result.Err(IsDir(p + \": Is a directory\")); }\n",
    "  if (!st.may(user, node, 4)) { return Result.Err(Denied(permissionDenied(p))); }\n",
    "  return Result.Ok(st.nodes.get(node).data.bytes());\n",
    "}\n",
    "\n",
    "/**\n",
    " * The file a write goes to — made, owned by `user`, when it is not there — or why not. `empty` truncates an\n",
    " * existing one, as `writeFile` and `openWrite` do and `openAppend` does not.\n",
    " */\n",
    "async Result<i32, WriteFault> memFileToWrite(MemoryStore st, string user, string p, bool empty) {\n",
    "  i32 parent = st.find(storeParent(p));\n",
    "  if (parent == STORE_NOT_A_DIR) { return Result.Err(NotADir(notADirectory(p))); }\n",
    "  if (parent < 0) { return Result.Err(NotFound(noSuchFile(p))); }\n",
    "  if (!st.nodes.get(parent).isDir) { return Result.Err(NotADir(notADirectory(p))); }\n",
    "  i64 now = await storeNow(st.clock);\n",
    "  i32 existing = p == \"/\" ? 0 : st.nodes.get(parent).names.getOr(storeBase(p), 0 - 1);\n",
    "  if (existing >= 0) {\n",
    "    if (st.nodes.get(existing).isDir) { return Result.Err(IsDir(p + \": Is a directory\")); }\n",
    "    if (!st.may(user, existing, 2)) { return Result.Err(Denied(permissionDenied(p))); }\n",
    "    if (empty) { st.nodes.get(existing).replace(u8[](), now); }\n",
    "    return Result.Ok(existing);\n",
    "  }\n",
    "  if (!st.may(user, parent, 2)) { return Result.Err(Denied(permissionDenied(p))); }\n",
    "  st.nodes.push(storeFile(user, now));\n",
    "  st.nodes.get(parent).names.set(storeBase(p), st.nodes.len() - 1);\n",
    "  st.nodes.get(parent).touch(now);\n",
    "  return Result.Ok(st.nodes.len() - 1);\n",
    "}\n",
    "\n",
    "async Result<void, WriteFault> memWrite(MemoryStore st, string user, string path, u8[] b) {\n",
    "  string p = normalPath(\"/\" + path);\n",
    "  match (await memFileToWrite(st, user, p, true)) {\n",
    "    Ok(node): {\n",
    "      st.nodes.get(node).append(b, st.nodes.get(node).mtime);\n",
    "      return Result.Ok();\n",
    "    }\n",
    "    Err(e): { return Result.Err(e); }\n",
    "  }\n",
    "}\n",
    "\n",
    "async Result<Output, WriteFault> memOpenWrite(MemoryStore st, string user, string path, bool empty) {\n",
    "  string p = normalPath(\"/\" + path);\n",
    "  match (await memFileToWrite(st, user, p, empty)) {\n",
    "    Ok(node): {\n",
    "      bool[] shut = bool[].filled(1, false);\n",
    "      return Result.Ok(Output((u8[] b) => memAppend(st, node, p, shut, b), () => memShut(shut)));\n",
    "    }\n",
    "    Err(e): { return Result.Err(e); }\n",
    "  }\n",
    "}\n",
    "\n",
    "/** A write through an open file goes to the node it opened, wherever its name has gone since, as on a host. */\n",
    "async Result<void, OutputFault> memAppend(MemoryStore st, i32 node, string p, bool[] shut, u8[] b) {\n",
    "  if (shut[0]) { return Result.Err(OutputClosed(p + \": closed\")); }\n",
    "  i64 now = await storeNow(st.clock);\n",
    "  st.nodes.get(node).append(b, now);\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "async Result<void, OutputFault> memShut(bool[] shut) {\n",
    "  shut[0] = true;\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "async Result<Input, ReadFault> memOpenRead(MemoryStore st, string user, string path) {\n",
    "  match (await memRead(st, user, path)) {\n",
    "    Ok(b): {\n",
    "      bool[] state = bool[].filled(2, false);\n",
    "      return Result.Ok(Input(() => memChunk(b, state), () => memRest(b, state), () => memShutRead(state)));\n",
    "    }\n",
    "    Err(e): { return Result.Err(e); }\n",
    "  }\n",
    "}\n",
    "\n",
    "/**\n",
    " * What was in the file when it was opened, in one piece and then the end. `state` is whether that piece has gone\n",
    " * and whether the file was closed.\n",
    " */\n",
    "async Result<Read, HostFault> memChunk(u8[] b, bool[] state) {\n",
    "  if (state[1]) { return Result.Err(Other(\"read after close\")); }\n",
    "  if (state[0] || b.len() == 0) { return Result.Ok(Read.End); }\n",
    "  state[0] = true;\n",
    "  return Result.Ok(Read.Data(b));\n",
    "}\n",
    "\n",
    "async Result<u8[], HostFault> memRest(u8[] b, bool[] state) {\n",
    "  if (state[1]) { return Result.Err(Other(\"read after close\")); }\n",
    "  bool gone = state[0];\n",
    "  state[0] = true;\n",
    "  return Result.Ok(gone ? u8[]() : b);\n",
    "}\n",
    "\n",
    "async Result<void, HostFault> memShutRead(bool[] state) {\n",
    "  state[1] = true;\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "async Result<Stat, LookFault> memStat(MemoryStore st, string path) {\n",
    "  string p = normalPath(\"/\" + path);\n",
    "  i32 node = st.find(p);\n",
    "  if (node == STORE_NOT_A_DIR) { return Result.Err(NotADir(notADirectory(p))); }\n",
    "  if (node < 0) { return Result.Err(NotFound(noSuchFile(p))); }\n",
    "  StoreNode n = st.nodes.get(node);\n",
    "  return Result.Ok(Stat(true, !n.isDir, n.isDir, n.data.len as i64, n.mtime, false, (n.mode & 64) != 0, FAULT_NONE(),\n",
    "                        n.mode, n.owner));\n",
    "}\n",
    "\n",
    "async Result<string[], LookFault> memReadDir(MemoryStore st, string user, string path) {\n",
    "  string p = normalPath(\"/\" + path);\n",
    "  i32 node = st.find(p);\n",
    "  if (node == STORE_NOT_A_DIR) { return Result.Err(NotADir(notADirectory(p))); }\n",
    "  if (node < 0) { return Result.Err(NotFound(noSuchFile(p))); }\n",
    "  if (!st.nodes.get(node).isDir) { return Result.Err(NotADir(notADirectory(p))); }\n",
    "  if (!st.may(user, node, 4)) { return Result.Err(Denied(permissionDenied(p))); }\n",
    "  return Result.Ok(sortedNames(st.nodes.get(node).names.keys()));\n",
    "}\n",
    "\n",
    "async Result<void, MkdirFault> memMkdir(MemoryStore st, string user, string path, bool parents) {\n",
    "  string p = normalPath(\"/\" + path);\n",
    "  i64 now = await storeNow(st.clock);\n",
    "  string[] parts = pathParts(p);\n",
    "  i32 at = 0;\n",
    "  for (i32 i = 0; i < parts.len(); i++) {\n",
    "    bool last = i == parts.len() - 1;\n",
    "    i32 next = st.nodes.get(at).names.getOr(parts[i], 0 - 1);\n",
    "    if (next >= 0) {\n",
    "      if (!st.nodes.get(next).isDir) {\n",
    "        if (last) { return Result.Err(Exists(p + \": File exists\")); }\n",
    "        return Result.Err(NotADir(notADirectory(p)));\n",
    "      }\n",
    "      if (last && !parents) { return Result.Err(Exists(p + \": File exists\")); }\n",
    "      at = next;\n",
    "      continue;\n",
    "    }\n",
    "    if (!last && !parents) { return Result.Err(NotFound(noSuchFile(p))); }\n",
    "    if (!st.may(user, at, 2)) { return Result.Err(Denied(permissionDenied(p))); }\n",
    "    st.nodes.push(storeDir(user, now));\n",
    "    st.nodes.get(at).names.set(parts[i], st.nodes.len() - 1);\n",
    "    st.nodes.get(at).touch(now);\n",
    "    at = st.nodes.len() - 1;\n",
    "  }\n",
    "  if (parts.len() == 0 && !parents) { return Result.Err(Exists(\"/: File exists\")); }\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "async Result<void, MoveFault> memRemove(MemoryStore st, string user, string path, bool recursive) {\n",
    "  string p = normalPath(\"/\" + path);\n",
    "  if (p == \"/\") { return Result.Err(Denied(\"/: the root cannot be removed\")); }\n",
    "  i32 parent = st.find(storeParent(p));\n",
    "  if (parent == STORE_NOT_A_DIR) { return Result.Err(NotADir(notADirectory(p))); }\n",
    "  if (parent < 0) { return Result.Err(NotFound(noSuchFile(p))); }\n",
    "  if (!st.nodes.get(parent).isDir) { return Result.Err(NotADir(notADirectory(p))); }\n",
    "  i32 node = st.nodes.get(parent).names.getOr(storeBase(p), 0 - 1);\n",
    "  if (node < 0) { return Result.Err(NotFound(noSuchFile(p))); }\n",
    "  if (st.nodes.get(node).isDir && st.nodes.get(node).names.len() > 0 && !recursive) {\n",
    "    return Result.Err(NotEmpty(p + \": Directory not empty\"));\n",
    "  }\n",
    "  if (!st.may(user, parent, 2)) { return Result.Err(Denied(permissionDenied(p))); }\n",
    "  i64 now = await storeNow(st.clock);\n",
    "  st.nodes.get(parent).names.remove(storeBase(p));\n",
    "  st.nodes.get(parent).touch(now);\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "async Result<void, MoveFault> memRename(MemoryStore st, string user, string fromPath, string toPath) {\n",
    "  string from = normalPath(\"/\" + fromPath);\n",
    "  string to = normalPath(\"/\" + toPath);\n",
    "  if (from == \"/\" || to == \"/\") { return Result.Err(Denied(\"/: the root cannot be moved\")); }\n",
    "  i32 fromParent = st.find(storeParent(from));\n",
    "  if (fromParent < 0 || !st.nodes.get(fromParent).isDir) {\n",
    "    return fromParent == STORE_NONE ? Result.Err(NotFound(noSuchFile(from))) : Result.Err(NotADir(notADirectory(from)));\n",
    "  }\n",
    "  i32 node = st.nodes.get(fromParent).names.getOr(storeBase(from), 0 - 1);\n",
    "  if (node < 0) { return Result.Err(NotFound(noSuchFile(from))); }\n",
    "  i32 toParent = st.find(storeParent(to));\n",
    "  if (toParent < 0 || !st.nodes.get(toParent).isDir) {\n",
    "    return toParent == STORE_NONE ? Result.Err(NotFound(noSuchFile(to))) : Result.Err(NotADir(notADirectory(to)));\n",
    "  }\n",
    "  if (to.len() > from.len() && to.slice(0, from.len() + 1) == from + \"/\") {\n",
    "    return Result.Err(Other(to + \": a directory cannot move inside itself\"));\n",
    "  }\n",
    "  i32 existing = st.nodes.get(toParent).names.getOr(storeBase(to), 0 - 1);\n",
    "  if (existing >= 0 && existing != node) {\n",
    "    bool fromDir = st.nodes.get(node).isDir;\n",
    "    bool toDir = st.nodes.get(existing).isDir;\n",
    "    if (!fromDir && toDir) { return Result.Err(IsDir(to + \": Is a directory\")); }\n",
    "    if (fromDir && !toDir) { return Result.Err(NotADir(notADirectory(to))); }\n",
    "    if (toDir && st.nodes.get(existing).names.len() > 0) { return Result.Err(NotEmpty(to + \": Directory not empty\")); }\n",
    "  }\n",
    "  if (!st.may(user, fromParent, 2) || !st.may(user, toParent, 2)) { return Result.Err(Denied(permissionDenied(from))); }\n",
    "  i64 now = await storeNow(st.clock);\n",
    "  st.nodes.get(fromParent).names.remove(storeBase(from));\n",
    "  st.nodes.get(toParent).names.set(storeBase(to), node);\n",
    "  st.nodes.get(fromParent).touch(now);\n",
    "  st.nodes.get(toParent).touch(now);\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "/** The node whose mode or owner is changing, when `user` may change it: its owner, or root. */\n",
    "Result<i32, ModeFault> memOwned(MemoryStore st, string user, string p) {\n",
    "  i32 node = st.find(p);\n",
    "  if (node == STORE_NOT_A_DIR) { return Result.Err(NotADir(notADirectory(p))); }\n",
    "  if (node < 0) { return Result.Err(NotFound(noSuchFile(p))); }\n",
    "  if (user != \"root\" && st.nodes.get(node).owner != user) { return Result.Err(Denied(notPermitted(p))); }\n",
    "  return Result.Ok(node);\n",
    "}\n",
    "\n",
    "async Result<void, ModeFault> memChmod(MemoryStore st, string user, string path, i32 mode) {\n",
    "  match (memOwned(st, user, normalPath(\"/\" + path))) {\n",
    "    Ok(node): {\n",
    "      st.nodes.get(node).setMode(mode & 4095);\n",
    "      return Result.Ok();\n",
    "    }\n",
    "    Err(e): { return Result.Err(e); }\n",
    "  }\n",
    "}\n",
    "\n",
    "/** The three execute bits move together, following read as `chmod +x` does: `0640` becomes `0750`. */\n",
    "async Result<void, ModeFault> memSetExecutable(MemoryStore st, string user, string path, bool on) {\n",
    "  match (memOwned(st, user, normalPath(\"/\" + path))) {\n",
    "    Ok(node): {\n",
    "      i32 mode = st.nodes.get(node).mode;\n",
    "      st.nodes.get(node).setMode(on ? mode | ((mode & 292) >> 2) : mode & ~73);\n",
    "      return Result.Ok();\n",
    "    }\n",
    "    Err(e): { return Result.Err(e); }\n",
    "  }\n",
    "}\n",
    "\n",
    "/** Root's alone: a user who could give files away could hide one behind somebody else's name. */\n",
    "async Result<void, ModeFault> memChown(MemoryStore st, string user, string path, string owner) {\n",
    "  string p = normalPath(\"/\" + path);\n",
    "  if (user != \"root\") { return Result.Err(Denied(notPermitted(p))); }\n",
    "  match (memOwned(st, user, p)) {\n",
    "    Ok(node): {\n",
    "      st.nodes.get(node).setOwner(owner);\n",
    "      return Result.Ok();\n",
    "    }\n",
    "    Err(e): { return Result.Err(e); }\n",
    "  }\n",
    "}\n",
    "\n",
    "/** The mount owning `p`: the longest `at` that prefixes it at a path boundary. A table with no `/` and no match traps. */\n",
    "Mount mountOf(Mount[] mounts, string p) {\n",
    "  i32 best = 0 - 1;\n",
    "  for (i32 i = 0; i < mounts.len(); i++) {\n",
    "    string at = mounts[i].at;\n",
    "    bool under = at == \"/\" || p == at || (p.len() > at.len() && p.slice(0, at.len()) == at && p.slice(at.len(), at.len() + 1) == \"/\");\n",
    "    if (under && (best < 0 || at.len() > mounts[best].at.len())) { best = i; }\n",
    "  }\n",
    "  if (best < 0) { trap \"no mount answers \" + p; }\n",
    "  return mounts[best];\n",
    "}\n",
    "\n",
    "/** `p` as the mount owning it sees it. */\n",
    "string innerOf(Mount[] mounts, string p) {\n",
    "  string at = mountOf(mounts, p).at;\n",
    "  if (at == \"/\") { return p; }\n",
    "  string rest = p.slice(at.len(), p.len());\n",
    "  return rest == \"\" ? \"/\" : rest;\n",
    "}\n",
    "\n",
    "/** What the mount owning `p` lists there, with the mounts directly under `p` added — sorted, each name once. */\n",
    "async Result<string[], LookFault> mountedReadDir(Mount[] mounts, string p) {\n",
    "  string dir = p != \"/\" && p.len() > 1 && p.slice(p.len() - 1, p.len()) == \"/\" ? p.slice(0, p.len() - 1) : p;\n",
    "  string prefix = dir == \"/\" ? \"/\" : dir + \"/\";\n",
    "  Vec<string> extra = Vec.create();\n",
    "  for (Mount m in mounts) {\n",
    "    string at = m.at;\n",
    "    if (at == \"/\" || at.len() <= prefix.len() || at.slice(0, prefix.len()) != prefix) { continue; }\n",
    "    string rest = at.slice(prefix.len(), at.len());\n",
    "    if (rest.indexOf(\"/\") < 0) { extra.push(rest); }\n",
    "  }\n",
    "  string[] own = string[]();\n",
    "  match (await mountOf(mounts, dir).files.readDir(innerOf(mounts, dir))) {\n",
    "    Ok(names): { own = names; }\n",
    "    // A directory that exists only because something is mounted under it lists its mount points.\n",
    "    Err(e): { if (extra.len() == 0) { return Result.Err(e); } }\n",
    "  }\n",
    "  Vec<string> all = Vec.fromArray(own);\n",
    "  for (i32 i = 0; i < extra.len(); i++) {\n",
    "    bool seen = false;\n",
    "    for (i32 k = 0; k < own.len(); k++) { if (own[k] == extra.get(i)) { seen = true; } }\n",
    "    if (!seen) { all.push(extra.get(i)); }\n",
    "  }\n",
    "  return Result.Ok(sortedNames(all.toArray()));\n",
    "}\n",
    "\n",
    "async Result<void, MoveFault> mountedRename(Mount[] mounts, string from, string to) {\n",
    "  if (mountOf(mounts, from).at != mountOf(mounts, to).at) {\n",
    "    return Result.Err(Other(\"cannot rename \" + from + \" to \" + to + \": they are on different mounts\"));\n",
    "  }\n",
    "  return await mountOf(mounts, from).files.rename(innerOf(mounts, from), innerOf(mounts, to));\n",
    "}\n",
    "\n",
    "async Result<u8[], ReadFault> refusedRead(string p) { return Result.Err(NotGranted(p + \": write-only\")); }\n",
    "async Result<Input, ReadFault> refusedOpenRead(string p) { return Result.Err(NotGranted(p + \": write-only\")); }\n",
    "async Result<Stat, LookFault> refusedLook(string p) { return Result.Err(NotGranted(p + \": write-only\")); }\n",
    "async Result<string[], LookFault> refusedList(string p) { return Result.Err(NotGranted(p + \": write-only\")); }\n",
    "async Result<void, WriteFault> refusedWrite(string p) { return Result.Err(NotGranted(p + \": read-only\")); }\n",
    "async Result<Output, WriteFault> refusedOpen(string p) { return Result.Err(NotGranted(p + \": read-only\")); }\n",
    "async Result<void, MkdirFault> refusedMkdir(string p) { return Result.Err(NotGranted(p + \": read-only\")); }\n",
    "async Result<void, MoveFault> refusedMove(string p) { return Result.Err(NotGranted(p + \": read-only\")); }\n",
    "async Result<void, ModeFault> refusedMode(string p) { return Result.Err(NotGranted(p + \": read-only\")); }\n",
    "async Result<void, ModeFault> hostChown(string p) {\n",
    "  return Result.Err(Unsupported(p + \": the host's owners are not names, so a file cannot be given to one\"));\n",
    "}\n",
    "\n",
    "Result<u8[], ReadFault> readOfFile(FileResult f) {\n",
    "  if (!f.ok) { return Result.Err(readFault(f.fault, f.error)); }\n",
    "  return Result.Ok(f.bytes);\n",
    "}\n",
    "\n",
    "Result<Input, ReadFault> openedToRead(Cli cli, HostWait wait, string p, HostSocket s) {\n",
    "  if (s.handle < 0) { return Result.Err(readFault(s.fault, s.error)); }\n",
    "  i32 h = s.handle;\n",
    "  bool[] shut = bool[].filled(1, false);\n",
    "  return Result.Ok(Input(() => hostTicket(cli.recv(h), wait, readOf), () => streamAll(cli, h),\n",
    "                         () => closeReadOnce(cli, wait, h, p, shut)));\n",
    "}\n",
    "\n",
    "/** Closing twice is not an error (`§wac-std-close-r4v8ndq`), so the second asks the host nothing. */\n",
    "Ticket<Result<void, HostFault>> closeReadOnce(Cli cli, HostWait wait, i32 h, string p, bool[] shut) {\n",
    "  if (shut[0]) { return nothingToClose(); }\n",
    "  shut[0] = true;\n",
    "  return hostTicket(cli.closeFile(h), wait, (bool went) => readClosedOf(went, p));\n",
    "}\n",
    "\n",
    "Result<void, HostFault> readClosedOf(bool went, string p) {\n",
    "  if (!went) { return Result.Err(Other(p + \": was not open\")); }\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "/**\n",
    " * A failed write says only that it failed: `send` answers a bool, so the host's reason does not reach here yet\n",
    " * (design/system/0013 step 5 gives the reason in the same call).\n",
    " */\n",
    "Result<Output, WriteFault> openedToWrite(Cli cli, HostWait wait, string p, HostSocket s) {\n",
    "  if (s.handle < 0) { return Result.Err(writeFault(s.fault, s.error)); }\n",
    "  i32 h = s.handle;\n",
    "  bool[] shut = bool[].filled(1, false);\n",
    "  return Result.Ok(Output((u8[] b) => writeUnlessClosed(cli, wait, h, p, shut, b), () => closeWriteOnce(cli, wait, h, p, shut)));\n",
    "}\n",
    "\n",
    "Ticket<Result<void, OutputFault>> writeUnlessClosed(Cli cli, HostWait wait, i32 h, string p, bool[] shut, u8[] b) {\n",
    "  if (shut[0]) { return writeAfterClose(p); }\n",
    "  return hostTicket(cli.send(h, b), wait, (bool went) => fileWrittenOf(went, p));\n",
    "}\n",
    "\n",
    "/** A write after `close` is `OutputClosed` (`§wac-std-close-r4v8ndq`): the handle is the host's again. */\n",
    "async Result<void, OutputFault> writeAfterClose(string p) { return Result.Err(OutputClosed(p + \": closed\")); }\n",
    "\n",
    "async Result<void, OutputFault> closedAlready() { return Result.Ok(); }\n",
    "\n",
    "Ticket<Result<void, OutputFault>> closeWriteOnce(Cli cli, HostWait wait, i32 h, string p, bool[] shut) {\n",
    "  if (shut[0]) { return closedAlready(); }\n",
    "  shut[0] = true;\n",
    "  return hostTicket(cli.closeFile(h), wait, (bool went) => fileClosedOf(went, p));\n",
    "}\n",
    "\n",
    "Result<void, OutputFault> fileWrittenOf(bool went, string p) {\n",
    "  if (!went) { return Result.Err(Other(p + \": the write failed\")); }\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "Result<void, OutputFault> fileClosedOf(bool went, string p) {\n",
    "  if (!went) { return Result.Err(Other(p + \": what was written could not be kept\")); }\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "Result<void, WriteFault> writtenOf(Change c) {\n",
    "  if (!c.ok()) { return Result.Err(writeFault(c.fault, c.message)); }\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "Result<Stat, LookFault> statOf(Stat s, string p) {\n",
    "  if (s.fault != FAULT_NONE()) { return Result.Err(lookFault(s.fault, s.words(p))); }\n",
    "  if (!s.exists) { return Result.Err(NotFound(p + \": No such file or directory\")); }\n",
    "  return Result.Ok(s);\n",
    "}\n",
    "\n",
    "/**\n",
    " * **A machine rather than a host ticket**, because a failure takes a second call: `readDir` answers null for\n",
    " * every failure and `stat` says which. So cancelling one leaves the host its slot until it answers.\n",
    " */\n",
    "async Result<string[], LookFault> hostReadDir(Cli cli, HostWait wait, string p) {\n",
    "  string[]? names = await cli.readDir(p).ticket();\n",
    "  if (names is null) {\n",
    "    Stat s = await cli.stat(p).ticket();\n",
    "    if (s.fault != FAULT_NONE()) { return Result.Err(lookFault(s.fault, s.words(p))); }\n",
    "    if (!s.exists) { return Result.Err(NotFound(p + \": No such file or directory\")); }\n",
    "    if (!s.isDir) { return Result.Err(NotADir(p + \": Not a directory\")); }\n",
    "    // **A directory that is there and will not list is a refusal.** The host's `readDir` answers no reason,\n",
    "    // and for something `stat` finds to be a directory the one that happens is a permission — `chmod 000 d;\n",
    "    // ls d` is GNU's \"cannot open directory 'd': Permission denied\". As `Other` this had no category, and\n",
    "    // every caller printed \"cannot be listed\", a phrase no real tool prints.\n",
    "    return Result.Err(Denied(p + \": cannot be listed\"));\n",
    "  }\n",
    "  return Result.Ok(names!);\n",
    "}\n",
    "\n",
    "Result<void, MkdirFault> madeOf(Change c) {\n",
    "  if (!c.ok()) { return Result.Err(mkdirFault(c.fault, c.message)); }\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "Result<void, MoveFault> movedOf(Change c) {\n",
    "  if (!c.ok()) { return Result.Err(moveFault(c.fault, c.message)); }\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "Result<void, ModeFault> modeOf(Change c) {\n",
    "  if (!c.ok()) { return Result.Err(modeFault(c.fault, c.message)); }\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "// ── Files served to a child ──────────────────────────────────────────────────────────────────────\n",
    "\n",
    "/*\n",
    " * A child handed a composed `Files` asks its parent for each operation on the parent channel, and the parent answers out\n",
    " * of the one `Files` there is (spec ch44 `§wac-std-files-served-t5h2mzr`), so a child's writes are its parent's and\n",
    " * what it may do is what that `Files` allows. Both ends are here because both are std: a frame is a u32 length and\n",
    " * that many bytes, a question is an opcode and its arguments, and an answer is a result — 0 and the value, or 1, a\n",
    " * `FAULT_*` code and the message. The parent answers one question at a time, in the order asked, so a child's\n",
    " * questions take turns and each answer is the oldest question's.\n",
    " */\n",
    "\n",
    "static i32 ASK_HELLO = 32;\n",
    "static i32 ASK_READ_FILE = 33;\n",
    "static i32 ASK_WRITE_FILE = 34;\n",
    "static i32 ASK_OPEN_READ = 35;\n",
    "static i32 ASK_OPEN_WRITE = 36;\n",
    "static i32 ASK_OPEN_APPEND = 37;\n",
    "static i32 ASK_STAT = 38;\n",
    "static i32 ASK_LINK_STAT = 39;\n",
    "static i32 ASK_READ_DIR = 40;\n",
    "static i32 ASK_MKDIR = 41;\n",
    "static i32 ASK_REMOVE = 42;\n",
    "static i32 ASK_RENAME = 43;\n",
    "static i32 ASK_CHMOD = 44;\n",
    "static i32 ASK_SET_EXECUTABLE = 45;\n",
    "static i32 ASK_CHOWN = 46;\n",
    "static i32 ASK_CHUNK = 47;\n",
    "static i32 ASK_READ_ALL = 48;\n",
    "static i32 ASK_CLOSE_READ = 49;\n",
    "static i32 ASK_WRITE = 50;\n",
    "static i32 ASK_CLOSE_WRITE = 51;\n",
    "\n",
    "/** What the parent answers `ASK_HELLO` with, so a channel speaking anything else is not mistaken for this one. */\n",
    "string servedHello() { return \"wac files 1\"; }\n",
    "\n",
    "/** `OutputClosed` on the wire; it has no `FAULT_*` code because no host operation answers it. */\n",
    "static i32 WIRE_OUTPUT_CLOSED = 100;\n",
    "\n",
    "/** Every fault a `Files` operation answers. */\n",
    "type FilesFault = union<NotFound, Denied, Exists, NotEmpty, IsDir, NotADir, ReadOnly, NameTooLong, Loop, NoSpace,\n",
    "                        NotRepresentable, NotGranted, Unsupported, OutputClosed, Other>;\n",
    "\n",
    "i32 wireCode(FilesFault e) {\n",
    "  if (e is NotFound) { return FAULT_NOT_FOUND(); }\n",
    "  if (e is Denied) { return FAULT_DENIED(); }\n",
    "  if (e is Exists) { return FAULT_EXISTS(); }\n",
    "  if (e is NotEmpty) { return FAULT_NOT_EMPTY(); }\n",
    "  if (e is IsDir) { return FAULT_IS_DIR(); }\n",
    "  if (e is NotADir) { return FAULT_NOT_A_DIR(); }\n",
    "  if (e is ReadOnly) { return FAULT_READ_ONLY(); }\n",
    "  if (e is NameTooLong) { return FAULT_NAME_TOO_LONG(); }\n",
    "  if (e is Loop) { return FAULT_LOOP(); }\n",
    "  if (e is NoSpace) { return FAULT_NO_SPACE(); }\n",
    "  if (e is NotRepresentable) { return FAULT_NOT_REPRESENTABLE(); }\n",
    "  if (e is NotGranted) { return FAULT_NOT_GRANTED(); }\n",
    "  if (e is Unsupported) { return FAULT_UNSUPPORTED(); }\n",
    "  if (e is OutputClosed) { return WIRE_OUTPUT_CLOSED; }\n",
    "  return FAULT_OTHER();\n",
    "}\n",
    "\n",
    "OutputFault outputFault(i32 code, string m) {\n",
    "  if (code == WIRE_OUTPUT_CLOSED) { return OutputClosed(m); }\n",
    "  if (code == FAULT_NO_SPACE()) { return NoSpace(m); }\n",
    "  if (code == FAULT_UNSUPPORTED()) { return Unsupported(m); }\n",
    "  return Other(m);\n",
    "}\n",
    "\n",
    "HostFault hostFaultOf(i32 code, string m) {\n",
    "  if (code == FAULT_UNSUPPORTED()) { return Unsupported(m); }\n",
    "  return Other(m);\n",
    "}\n",
    "\n",
    "void putWireString(Buf out, string s) {\n",
    "  u8[] b = s.toBytes();\n",
    "  out.pushU32(b.len() as@ u32);\n",
    "  out.pushAll(b);\n",
    "}\n",
    "\n",
    "void putWireBytes(Buf out, u8[] b) {\n",
    "  out.pushU32(b.len() as@ u32);\n",
    "  out.pushAll(b);\n",
    "}\n",
    "\n",
    "void putWireI64(Buf out, i64 v) {\n",
    "  for (i32 i = 0; i < 8; i++) { out.push((((v >> (i * 8)) & 255 as i64) as! i32) as@ u8); }\n",
    "}\n",
    "\n",
    "void putFault(Buf out, FilesFault e) {\n",
    "  out.push(1);\n",
    "  out.pushU32(wireCode(e) as@ u32);\n",
    "  putWireString(out, \"\\{e}\");\n",
    "}\n",
    "\n",
    "void putStat(Buf out, Stat s) {\n",
    "  out.push(s.exists ? 1 : 0);\n",
    "  out.push(s.isFile ? 1 : 0);\n",
    "  out.push(s.isDir ? 1 : 0);\n",
    "  putWireI64(out, s.size);\n",
    "  putWireI64(out, s.modifiedMillis);\n",
    "  out.push(s.isSymlink ? 1 : 0);\n",
    "  out.push(s.isExecutable ? 1 : 0);\n",
    "  out.pushU32(s.fault as@ u32);\n",
    "  out.pushU32(s.mode as@ u32);\n",
    "  putWireString(out, s.owner);\n",
    "}\n",
    "\n",
    "/** A frame's body, read from the front; running off the end marks it `bad` rather than trapping. */\n",
    "struct WireReader {\n",
    "  u8[] data;\n",
    "  i32 at;\n",
    "  bool bad;\n",
    "  string why;\n",
    "\n",
    "  i32 byte(this) {\n",
    "    if (this.bad || this.at >= this.data.len()) { this.bad = true; return 0; }\n",
    "    i32 v = this.data[this.at] as i32;\n",
    "    this.at++;\n",
    "    return v;\n",
    "  }\n",
    "\n",
    "  i32 u32(this) {\n",
    "    i32 a = this.byte();\n",
    "    i32 b = this.byte();\n",
    "    i32 c = this.byte();\n",
    "    i32 d = this.byte();\n",
    "    return a | (b << 8) | (c << 16) | (d << 24);\n",
    "  }\n",
    "\n",
    "  i64 i64(this) {\n",
    "    i64 v = 0 as i64;\n",
    "    for (i32 i = 0; i < 8; i++) { v = v | ((this.byte() as i64) << (i * 8)); }\n",
    "    return v;\n",
    "  }\n",
    "\n",
    "  u8[] bytes(this) {\n",
    "    i32 n = this.u32();\n",
    "    if (this.bad || n < 0 || this.at + n > this.data.len()) { this.bad = true; return u8[](); }\n",
    "    u8[] b = u8[].filled(n, 0);\n",
    "    b.copyFrom(this.data, this.at, 0, n);\n",
    "    this.at = this.at + n;\n",
    "    return b;\n",
    "  }\n",
    "\n",
    "  string text(this) { return string.fromBytes(this.bytes()); }\n",
    "\n",
    "  bool flag(this) { return this.byte() == 1; }\n",
    "\n",
    "  Stat stat(this) {\n",
    "    bool exists = this.flag();\n",
    "    bool isFile = this.flag();\n",
    "    bool isDir = this.flag();\n",
    "    i64 size = this.i64();\n",
    "    i64 mtime = this.i64();\n",
    "    bool isSymlink = this.flag();\n",
    "    bool isExecutable = this.flag();\n",
    "    i32 fault = this.u32();\n",
    "    i32 mode = this.u32();\n",
    "    string owner = this.text();\n",
    "    return Stat(exists, isFile, isDir, size, mtime, isSymlink, isExecutable, fault, mode, owner);\n",
    "  }\n",
    "\n",
    "  /** Whether the answer is an `Err`; `code` and `message` read the fault after it. */\n",
    "  bool failed(this) { return this.byte() != 0; }\n",
    "}\n",
    "\n",
    "WireReader brokenReader(string why) { return WireReader(u8[](), 0, true, why); }\n",
    "\n",
    "/** One end of a framed conversation on a handle. */\n",
    "struct WireLine {\n",
    "  Cli cli;\n",
    "  i32 handle;\n",
    "  /** Bytes received and not yet a whole frame. */\n",
    "  Buf held;\n",
    "  bool broken;\n",
    "\n",
    "  WireLine on(Cli cli, i32 handle) { return WireLine(cli, handle, Buf.create(), false); }\n",
    "\n",
    "  /** Send `body` as one frame. */\n",
    "  async bool put(this, Buf body) {\n",
    "    if (this.broken) { return false; }\n",
    "    Buf framed = Buf.create();\n",
    "    framed.pushU32(body.len as@ u32);\n",
    "    framed.pushAll(body.bytes());\n",
    "    bool went = await this.cli.send(this.handle, framed.bytes()).ticket();\n",
    "    if (!went) { this.broken = true; }\n",
    "    return went;\n",
    "  }\n",
    "\n",
    "  /** The next whole frame, reading as many chunks as it takes; `bad` when the line ended first. */\n",
    "  async WireReader next(this) {\n",
    "    while (!this.broken) {\n",
    "      WireReader whole = this.take();\n",
    "      if (!whole.bad) { return whole; }\n",
    "      Read c = await this.cli.recv(this.handle).ticket();\n",
    "      match (c) {\n",
    "        Data(bytes): { this.held.pushAll(bytes); }\n",
    "        End: { this.broken = true; }\n",
    "        Failed(why): { this.broken = true; }\n",
    "      }\n",
    "    }\n",
    "    return brokenReader(\"the parent channel has ended\");\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * `next`, giving up when `stop` settles first: the read in flight is withdrawn and the line is broken. What a\n",
    "   * parent serving a child's files waits on, so that stopping the child also ends the serving rather than\n",
    "   * leaving a read of a dead channel registered.\n",
    "   */\n",
    "  async WireReader nextUnless(this, HostWait wait, TicketBase stop) {\n",
    "    while (!this.broken) {\n",
    "      WireReader whole = this.take();\n",
    "      if (!whole.bad) { return whole; }\n",
    "      Ticket<Read> got = recvTicket(this.cli, wait, this.handle);\n",
    "      i32 won = await Ticket.first([got, stop]);\n",
    "      if (won != 0) {\n",
    "        got.cancel();\n",
    "        this.broken = true;\n",
    "      } else {\n",
    "        match (got.value()) {\n",
    "          Data(bytes): { this.held.pushAll(bytes); }\n",
    "          End: { this.broken = true; }\n",
    "          Failed(why): { this.broken = true; }\n",
    "        }\n",
    "      }\n",
    "    }\n",
    "    return brokenReader(\"the parent channel has ended\");\n",
    "  }\n",
    "\n",
    "  /** The same, waiting synchronously — for the one question a program asks before it can have a scheduler running. */\n",
    "  WireReader nextNow(this) {\n",
    "    while (!this.broken) {\n",
    "      WireReader whole = this.take();\n",
    "      if (!whole.bad) { return whole; }\n",
    "      Read c = this.cli.recv(this.handle).wait();\n",
    "      match (c) {\n",
    "        Data(bytes): { this.held.pushAll(bytes); }\n",
    "        End: { this.broken = true; }\n",
    "        Failed(why): { this.broken = true; }\n",
    "      }\n",
    "    }\n",
    "    return brokenReader(\"the parent channel has ended\");\n",
    "  }\n",
    "\n",
    "  /** A whole frame off the front of `held`, or a `bad` reader when there is not one yet. */\n",
    "  WireReader take(this) {\n",
    "    if (this.held.len < 4) { return brokenReader(\"short\"); }\n",
    "    i32 n = this.held.get(0) as i32 | (this.held.get(1) as i32 << 8) | (this.held.get(2) as i32 << 16)\n",
    "          | (this.held.get(3) as i32 << 24);\n",
    "    if (n < 0) {\n",
    "      this.broken = true;\n",
    "      return brokenReader(\"a frame longer than two gigabytes\");\n",
    "    }\n",
    "    if (this.held.len < 4 + n) { return brokenReader(\"short\"); }\n",
    "    u8[] body = u8[].filled(n, 0);\n",
    "    u8[] all = this.held.bytes();\n",
    "    body.copyFrom(all, 4, 0, n);\n",
    "    this.held.dropFront(4 + n);\n",
    "    return WireReader(body, 0, false, \"\");\n",
    "  }\n",
    "}\n",
    "\n",
    "Buf wireAsk(i32 op) {\n",
    "  Buf b = Buf.create();\n",
    "  b.push(op as@ u8);\n",
    "  return b;\n",
    "}\n",
    "\n",
    "// ── The child's end ──\n",
    "\n",
    "/**\n",
    " * A child's line to its parent: one question in flight at a time, the next waiting on `turn`. `served` is 0 until\n",
    " * `Sys.files` has asked, then 1 when the parent answers files and 2 when it does not.\n",
    " */\n",
    "struct ParentLine {\n",
    "  WireLine line;\n",
    "  Ticket<bool> turn;\n",
    "  i32 served;\n",
    "  /** Who the parent's files act as, from its answer to the hello. */\n",
    "  string user;\n",
    "\n",
    "  ParentLine on(Cli cli) {\n",
    "    Ticket<bool> open;\n",
    "    open.resolve(true);\n",
    "    return ParentLine(WireLine.on(cli, PARENT_FS), open, 0, \"\");\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Ask the parent whether it serves files, **without waiting** — what the program adapter does before an `async`\n",
    "   * `main`, so that `serves` already knows by the time a program asks. A page cannot wait for the parent's\n",
    "   * answer, and asking it the first time `files()` was called waited: every spawned applet in the browser\n",
    "   * terminal trapped there.\n",
    "   */\n",
    "  async void greet(this) {\n",
    "    if (this.served != 0) { return; }\n",
    "    if (!(await this.line.put(wireAsk(ASK_HELLO)))) {\n",
    "      this.served = 2;\n",
    "      return;\n",
    "    }\n",
    "    WireReader r = await this.line.next();\n",
    "    string said = r.text();\n",
    "    this.served = !r.bad && said == servedHello() ? 1 : 2;\n",
    "    if (this.served == 1) { this.user = r.text(); }\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Whether the parent serves files — asked once, the first time, and remembered. An `async` program has already\n",
    "   * asked (`greet`); a synchronous one asks here, waiting for the answer.\n",
    "   */\n",
    "  bool serves(this) {\n",
    "    if (this.served == 0) {\n",
    "      Buf hello = wireAsk(ASK_HELLO);\n",
    "      Buf framed = Buf.create();\n",
    "      framed.pushU32(hello.len as@ u32);\n",
    "      framed.pushAll(hello.bytes());\n",
    "      bool asked = this.line.cli.send(PARENT_FS, framed.bytes()).wait();\n",
    "      WireReader r = asked ? this.line.nextNow() : brokenReader(\"not spawned\");\n",
    "      string said = r.text();\n",
    "      this.served = !r.bad && said == servedHello() ? 1 : 2;\n",
    "      if (this.served == 1) { this.user = r.text(); }\n",
    "    }\n",
    "    return this.served == 1;\n",
    "  }\n",
    "\n",
    "  /** Ask `question` when the questions before it have their answers, and answer what the parent says. */\n",
    "  async WireReader ask(this, Buf question) {\n",
    "    Ticket<bool> before = this.turn;\n",
    "    Ticket<bool> mine;\n",
    "    this.turn = mine;\n",
    "    await before;\n",
    "    WireReader r = brokenReader(\"the parent channel has ended\");\n",
    "    if (await this.line.put(question)) { r = await this.line.next(); }\n",
    "    mine.resolve(true);\n",
    "    return r;\n",
    "  }\n",
    "}\n",
    "\n",
    "/** The `Files` a child's parent serves. Composed in the parent, so a grandchild is served it in turn. */\n",
    "Files parentFiles(ParentLine l) {\n",
    "  return Files(\n",
    "    (string p) => askRead(l, p),\n",
    "    (string p, u8[] b) => askWrite(l, p, b),\n",
    "    (string p) => askOpenRead(l, p),\n",
    "    (string p) => askOpenWrite(l, ASK_OPEN_WRITE, p),\n",
    "    (string p) => askOpenWrite(l, ASK_OPEN_APPEND, p),\n",
    "    (string p) => askStat(l, ASK_STAT, p),\n",
    "    (string p) => askStat(l, ASK_LINK_STAT, p),\n",
    "    (string p) => askReadDir(l, p),\n",
    "    (string p, bool parents) => askMkdir(l, p, parents),\n",
    "    (string p, bool r) => askMove(l, ASK_REMOVE, p, \"\", r),\n",
    "    (string from, string to) => askMove(l, ASK_RENAME, from, to, false),\n",
    "    (string p, i32 mode) => askMode(l, ASK_CHMOD, p, mode, false, \"\"),\n",
    "    (string p, bool on) => askMode(l, ASK_SET_EXECUTABLE, p, 0, on, \"\"),\n",
    "    (string p, string owner) => askMode(l, ASK_CHOWN, p, 0, false, owner),\n",
    "    0, l.user);\n",
    "}\n",
    "\n",
    "string lineGone(WireReader r) { return \"the parent did not answer: \" + r.why; }\n",
    "\n",
    "async Result<u8[], ReadFault> askRead(ParentLine l, string p) {\n",
    "  Buf q = wireAsk(ASK_READ_FILE);\n",
    "  putWireString(q, p);\n",
    "  WireReader r = await l.ask(q);\n",
    "  if (r.failed()) { return Result.Err(readFault(r.u32(), r.text())); }\n",
    "  u8[] b = r.bytes();\n",
    "  if (r.bad) { return Result.Err(Other(lineGone(r))); }\n",
    "  return Result.Ok(b);\n",
    "}\n",
    "\n",
    "async Result<void, WriteFault> askWrite(ParentLine l, string p, u8[] b) {\n",
    "  Buf q = wireAsk(ASK_WRITE_FILE);\n",
    "  putWireString(q, p);\n",
    "  putWireBytes(q, b);\n",
    "  WireReader r = await l.ask(q);\n",
    "  if (r.failed()) { return Result.Err(writeFault(r.u32(), r.text())); }\n",
    "  if (r.bad) { return Result.Err(Other(lineGone(r))); }\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "async Result<Input, ReadFault> askOpenRead(ParentLine l, string p) {\n",
    "  Buf q = wireAsk(ASK_OPEN_READ);\n",
    "  putWireString(q, p);\n",
    "  WireReader r = await l.ask(q);\n",
    "  if (r.failed()) { return Result.Err(readFault(r.u32(), r.text())); }\n",
    "  i32 id = r.u32();\n",
    "  if (r.bad) { return Result.Err(Other(lineGone(r))); }\n",
    "  return Result.Ok(Input(() => askChunk(l, id), () => askReadAll(l, id), () => askCloseRead(l, id)));\n",
    "}\n",
    "\n",
    "async Result<Read, HostFault> askChunk(ParentLine l, i32 id) {\n",
    "  Buf q = wireAsk(ASK_CHUNK);\n",
    "  q.pushU32(id as@ u32);\n",
    "  WireReader r = await l.ask(q);\n",
    "  if (r.failed()) { return Result.Err(hostFaultOf(r.u32(), r.text())); }\n",
    "  bool more = r.flag();\n",
    "  u8[] b = more ? r.bytes() : u8[]();\n",
    "  if (r.bad) { return Result.Err(Other(lineGone(r))); }\n",
    "  if (!more) { return Result.Ok(Read.End); }\n",
    "  return Result.Ok(Read.Data(b));\n",
    "}\n",
    "\n",
    "async Result<u8[], HostFault> askReadAll(ParentLine l, i32 id) {\n",
    "  Buf q = wireAsk(ASK_READ_ALL);\n",
    "  q.pushU32(id as@ u32);\n",
    "  WireReader r = await l.ask(q);\n",
    "  if (r.failed()) { return Result.Err(hostFaultOf(r.u32(), r.text())); }\n",
    "  u8[] b = r.bytes();\n",
    "  if (r.bad) { return Result.Err(Other(lineGone(r))); }\n",
    "  return Result.Ok(b);\n",
    "}\n",
    "\n",
    "async Result<void, HostFault> askCloseRead(ParentLine l, i32 id) {\n",
    "  Buf q = wireAsk(ASK_CLOSE_READ);\n",
    "  q.pushU32(id as@ u32);\n",
    "  WireReader r = await l.ask(q);\n",
    "  if (r.failed()) { return Result.Err(hostFaultOf(r.u32(), r.text())); }\n",
    "  if (r.bad) { return Result.Err(Other(lineGone(r))); }\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "async Result<Output, WriteFault> askOpenWrite(ParentLine l, i32 op, string p) {\n",
    "  Buf q = wireAsk(op);\n",
    "  putWireString(q, p);\n",
    "  WireReader r = await l.ask(q);\n",
    "  if (r.failed()) { return Result.Err(writeFault(r.u32(), r.text())); }\n",
    "  i32 id = r.u32();\n",
    "  if (r.bad) { return Result.Err(Other(lineGone(r))); }\n",
    "  return Result.Ok(Output((u8[] b) => askOutput(l, ASK_WRITE, id, b), () => askOutput(l, ASK_CLOSE_WRITE, id, u8[]())));\n",
    "}\n",
    "\n",
    "async Result<void, OutputFault> askOutput(ParentLine l, i32 op, i32 id, u8[] b) {\n",
    "  Buf q = wireAsk(op);\n",
    "  q.pushU32(id as@ u32);\n",
    "  if (op == ASK_WRITE) { putWireBytes(q, b); }\n",
    "  WireReader r = await l.ask(q);\n",
    "  if (r.failed()) { return Result.Err(outputFault(r.u32(), r.text())); }\n",
    "  if (r.bad) { return Result.Err(Other(lineGone(r))); }\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "async Result<Stat, LookFault> askStat(ParentLine l, i32 op, string p) {\n",
    "  Buf q = wireAsk(op);\n",
    "  putWireString(q, p);\n",
    "  WireReader r = await l.ask(q);\n",
    "  if (r.failed()) { return Result.Err(lookFault(r.u32(), r.text())); }\n",
    "  Stat s = r.stat();\n",
    "  if (r.bad) { return Result.Err(Other(lineGone(r))); }\n",
    "  return Result.Ok(s);\n",
    "}\n",
    "\n",
    "async Result<string[], LookFault> askReadDir(ParentLine l, string p) {\n",
    "  Buf q = wireAsk(ASK_READ_DIR);\n",
    "  putWireString(q, p);\n",
    "  WireReader r = await l.ask(q);\n",
    "  if (r.failed()) { return Result.Err(lookFault(r.u32(), r.text())); }\n",
    "  i32 n = r.u32();\n",
    "  if (r.bad || n < 0) { return Result.Err(Other(lineGone(r))); }\n",
    "  string[] names = string[].filled(n, \"\");\n",
    "  for (i32 i = 0; i < n; i++) { names[i] = r.text(); }\n",
    "  if (r.bad) { return Result.Err(Other(lineGone(r))); }\n",
    "  return Result.Ok(names);\n",
    "}\n",
    "\n",
    "async Result<void, MkdirFault> askMkdir(ParentLine l, string p, bool parents) {\n",
    "  Buf q = wireAsk(ASK_MKDIR);\n",
    "  putWireString(q, p);\n",
    "  q.push(parents ? 1 : 0);\n",
    "  WireReader r = await l.ask(q);\n",
    "  if (r.failed()) { return Result.Err(mkdirFault(r.u32(), r.text())); }\n",
    "  if (r.bad) { return Result.Err(Other(lineGone(r))); }\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "/** `remove` (`p`, `recursive`) and `rename` (`p` to `to`). */\n",
    "async Result<void, MoveFault> askMove(ParentLine l, i32 op, string p, string to, bool recursive) {\n",
    "  Buf q = wireAsk(op);\n",
    "  putWireString(q, p);\n",
    "  if (op == ASK_RENAME) { putWireString(q, to); } else { q.push(recursive ? 1 : 0); }\n",
    "  WireReader r = await l.ask(q);\n",
    "  if (r.failed()) { return Result.Err(moveFault(r.u32(), r.text())); }\n",
    "  if (r.bad) { return Result.Err(Other(lineGone(r))); }\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "/** `chmod` (`mode`), `setExecutable` (`on`) and `chown` (`owner`). */\n",
    "async Result<void, ModeFault> askMode(ParentLine l, i32 op, string p, i32 mode, bool on, string owner) {\n",
    "  Buf q = wireAsk(op);\n",
    "  putWireString(q, p);\n",
    "  if (op == ASK_CHMOD) { q.pushU32(mode as@ u32); }\n",
    "  if (op == ASK_SET_EXECUTABLE) { q.push(on ? 1 : 0); }\n",
    "  if (op == ASK_CHOWN) { putWireString(q, owner); }\n",
    "  WireReader r = await l.ask(q);\n",
    "  if (r.failed()) { return Result.Err(modeFault(r.u32(), r.text())); }\n",
    "  if (r.bad) { return Result.Err(Other(lineGone(r))); }\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "// ── The parent's end ──\n",
    "\n",
    "/** A read of `handle` as a ticket the host answers — one that `cancel` withdraws. */\n",
    "Ticket<Read> recvTicket(Cli cli, HostWait wait, i32 handle) { return hostTicket(cli.recv(handle), wait, sameRead); }\n",
    "\n",
    "Read sameRead(Read r) { return r; }\n",
    "\n",
    "/** The streams a served child has open, by the number it was given; a closed one keeps its number. */\n",
    "struct ServedStreams {\n",
    "  Vec<Input> reads;\n",
    "  Vec<bool> readOpen;\n",
    "  Vec<Output> writes;\n",
    "  Vec<bool> writeOpen;\n",
    "}\n",
    "\n",
    "/**\n",
    " * Answer a child's questions out of `files` until its channel ends — which is the child exiting — or `stop` settles,\n",
    " * which is the child being stopped; then close what it left open. Runs as this program's scheduler does: nothing else\n",
    " * has to drive it.\n",
    " */\n",
    "async void serveFiles(Cli cli, HostWait wait, i32 handle, Files files, Ticket<bool> stop) {\n",
    "  WireLine line = WireLine.on(cli, handle);\n",
    "  ServedStreams open = ServedStreams(Vec.create(), Vec.create(), Vec.create(), Vec.create());\n",
    "  bool going = true;\n",
    "  while (going) {\n",
    "    WireReader q = await line.nextUnless(wait, stop);\n",
    "    if (q.bad) {\n",
    "      going = false;\n",
    "    } else {\n",
    "      Buf a = await answerQuestion(files, open, q);\n",
    "      going = await line.put(a);\n",
    "    }\n",
    "  }\n",
    "  for (i32 i = 0; i < open.reads.len(); i++) {\n",
    "    if (open.readOpen.get(i)) { await open.reads.get(i).close(); }\n",
    "  }\n",
    "  for (i32 i = 0; i < open.writes.len(); i++) {\n",
    "    if (open.writeOpen.get(i)) { await open.writes.get(i).close(); }\n",
    "  }\n",
    "}\n",
    "\n",
    "async Buf answerQuestion(Files files, ServedStreams open, WireReader q) {\n",
    "  i32 op = q.byte();\n",
    "  Buf a = Buf.create();\n",
    "  if (op == ASK_HELLO) {\n",
    "    putWireString(a, servedHello());\n",
    "    putWireString(a, files.user);\n",
    "  } else if (op == ASK_READ_FILE) {\n",
    "    match (await files.readFile(q.text())) {\n",
    "      Ok(b): { a.push(0); putWireBytes(a, b); }\n",
    "      Err(e): { putFault(a, e); }\n",
    "    }\n",
    "  } else if (op == ASK_WRITE_FILE) {\n",
    "    string p = q.text();\n",
    "    putDone(a, (await files.writeFile(p, q.bytes())).err());\n",
    "  } else if (op == ASK_OPEN_READ) {\n",
    "    match (await files.openRead(q.text())) {\n",
    "      Ok(in): {\n",
    "        open.reads.push(in);\n",
    "        open.readOpen.push(true);\n",
    "        a.push(0);\n",
    "        a.pushU32((open.reads.len() - 1) as@ u32);\n",
    "      }\n",
    "      Err(e): { putFault(a, e); }\n",
    "    }\n",
    "  } else if (op == ASK_OPEN_WRITE || op == ASK_OPEN_APPEND) {\n",
    "    string p = q.text();\n",
    "    Result<Output, WriteFault> opened = op == ASK_OPEN_WRITE ? await files.openWrite(p) : await files.openAppend(p);\n",
    "    match (opened) {\n",
    "      Ok(out): {\n",
    "        open.writes.push(out);\n",
    "        open.writeOpen.push(true);\n",
    "        a.push(0);\n",
    "        a.pushU32((open.writes.len() - 1) as@ u32);\n",
    "      }\n",
    "      Err(e): { putFault(a, e); }\n",
    "    }\n",
    "  } else if (op == ASK_STAT || op == ASK_LINK_STAT) {\n",
    "    string p = q.text();\n",
    "    Result<Stat, LookFault> s = op == ASK_STAT ? await files.stat(p) : await files.linkStat(p);\n",
    "    match (s) {\n",
    "      Ok(st): { a.push(0); putStat(a, st); }\n",
    "      Err(e): { putFault(a, e); }\n",
    "    }\n",
    "  } else if (op == ASK_READ_DIR) {\n",
    "    match (await files.readDir(q.text())) {\n",
    "      Ok(names): {\n",
    "        a.push(0);\n",
    "        a.pushU32(names.len() as@ u32);\n",
    "        for (i32 i = 0; i < names.len(); i++) { putWireString(a, names[i]); }\n",
    "      }\n",
    "      Err(e): { putFault(a, e); }\n",
    "    }\n",
    "  } else if (op == ASK_MKDIR) {\n",
    "    string p = q.text();\n",
    "    putDone(a, (await files.mkdir(p, q.flag())).err());\n",
    "  } else if (op == ASK_REMOVE) {\n",
    "    string p = q.text();\n",
    "    putDone(a, (await files.remove(p, q.flag())).err());\n",
    "  } else if (op == ASK_RENAME) {\n",
    "    string from = q.text();\n",
    "    putDone(a, (await files.rename(from, q.text())).err());\n",
    "  } else if (op == ASK_CHMOD) {\n",
    "    string p = q.text();\n",
    "    putDone(a, (await files.chmod(p, q.u32())).err());\n",
    "  } else if (op == ASK_SET_EXECUTABLE) {\n",
    "    string p = q.text();\n",
    "    putDone(a, (await files.setExecutable(p, q.flag())).err());\n",
    "  } else if (op == ASK_CHOWN) {\n",
    "    string p = q.text();\n",
    "    putDone(a, (await files.chown(p, q.text())).err());\n",
    "  } else if (op == ASK_CHUNK || op == ASK_READ_ALL || op == ASK_CLOSE_READ) {\n",
    "    await answerRead(open, op, q.u32(), a);\n",
    "  } else if (op == ASK_WRITE || op == ASK_CLOSE_WRITE) {\n",
    "    i32 id = q.u32();\n",
    "    await answerWrite(open, op, id, op == ASK_WRITE ? q.bytes() : u8[](), a);\n",
    "  } else {\n",
    "    putFault(a, Unsupported(\"this parent does not know question \\{op}\"));\n",
    "  }\n",
    "  return a;\n",
    "}\n",
    "\n",
    "/** The answer to a question with nothing to answer but whether it worked: `e` is its fault, or null. */\n",
    "void putDone(Buf a, FilesFault? e) {\n",
    "  if (e is null) { a.push(0); } else { putFault(a, e!); }\n",
    "}\n",
    "\n",
    "async void answerRead(ServedStreams open, i32 op, i32 id, Buf a) {\n",
    "  if (id < 0 || id >= open.reads.len() || !open.readOpen.get(id)) {\n",
    "    putFault(a, Other(\"no stream \\{id} is open to read\"));\n",
    "    return;\n",
    "  }\n",
    "  Input in = open.reads.get(id);\n",
    "  if (op == ASK_CHUNK) {\n",
    "    match (await in.chunk()) {\n",
    "      Ok(c): {\n",
    "        a.push(0);\n",
    "        match (c) {\n",
    "          Data(b): { a.push(1); putWireBytes(a, b); }\n",
    "          default: { a.push(0); }\n",
    "        }\n",
    "      }\n",
    "      Err(e): { putFault(a, e); }\n",
    "    }\n",
    "  } else if (op == ASK_READ_ALL) {\n",
    "    match (await in.readAll()) {\n",
    "      Ok(b): { a.push(0); putWireBytes(a, b); }\n",
    "      Err(e): { putFault(a, e); }\n",
    "    }\n",
    "  } else {\n",
    "    open.readOpen.set(id, false);\n",
    "    putDone(a, (await in.close()).err());\n",
    "  }\n",
    "}\n",
    "\n",
    "async void answerWrite(ServedStreams open, i32 op, i32 id, u8[] b, Buf a) {\n",
    "  if (id < 0 || id >= open.writes.len() || !open.writeOpen.get(id)) {\n",
    "    putFault(a, OutputClosed(\"no stream \\{id} is open to write\"));\n",
    "    return;\n",
    "  }\n",
    "  Output out = open.writes.get(id);\n",
    "  if (op == ASK_WRITE) {\n",
    "    putDone(a, (await out.write(b)).err());\n",
    "  } else {\n",
    "    open.writeOpen.set(id, false);\n",
    "    putDone(a, (await out.close()).err());\n",
    "  }\n",
    "}\n",
    "\n",
    "// ── Sockets ──────────────────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "/** Opening a connection. */\n",
    "export type ConnectFault = union<Refused, Unreachable, TimedOut, NotFound, NotGranted, Unsupported, Other>;\n",
    "/** Listening on a port or binding a datagram socket. */\n",
    "export type BindFault = union<Denied, Exists, NotGranted, Unsupported, Other>;\n",
    "/** Reading or writing a connection. */\n",
    "export type SocketFault = union<PeerClosed, TimedOut, Unsupported, Other>;\n",
    "\n",
    "ConnectFault connectFault(i32 code, string m) {\n",
    "  if (code == FAULT_REFUSED()) { return Refused(m); }\n",
    "  if (code == FAULT_UNREACHABLE()) { return Unreachable(m); }\n",
    "  if (code == FAULT_TIMED_OUT()) { return TimedOut(m); }\n",
    "  if (code == FAULT_NOT_FOUND()) { return NotFound(m); }\n",
    "  if (code == FAULT_NOT_GRANTED()) { return NotGranted(m); }\n",
    "  if (code == FAULT_UNSUPPORTED()) { return Unsupported(m); }\n",
    "  return Other(m);\n",
    "}\n",
    "\n",
    "BindFault bindFault(i32 code, string m) {\n",
    "  if (code == FAULT_DENIED()) { return Denied(m); }\n",
    "  if (code == FAULT_EXISTS()) { return Exists(m); }\n",
    "  if (code == FAULT_NOT_GRANTED()) { return NotGranted(m); }\n",
    "  if (code == FAULT_UNSUPPORTED()) { return Unsupported(m); }\n",
    "  return Other(m);\n",
    "}\n",
    "\n",
    "/** The network (spec ch44). Each operation answers `NotGranted` when the host withheld it. */\n",
    "export struct Net {\n",
    "  Cli cli;\n",
    "  HostWait wait;\n",
    "\n",
    "  /** A connection to `host:port`. */\n",
    "  Ticket<Result<Socket, ConnectFault>> connect(this, string host, i32 port) {\n",
    "    Cli cli = this.cli;\n",
    "    HostWait wait = this.wait;\n",
    "    return hostTicket(cli.connect(host, port), wait, (HostSocket s) => connectedOf(cli, wait, s));\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Listen on `addr:port` — `\"127.0.0.1\"` for loopback, `\"0.0.0.0\"` for every interface; the address is not\n",
    "   * optional, so the surprising one is something somebody typed. Port 0 asks the host for any free one.\n",
    "   */\n",
    "  Ticket<Result<Listener, BindFault>> listen(this, string addr, i32 port) {\n",
    "    Cli cli = this.cli;\n",
    "    HostWait wait = this.wait;\n",
    "    return hostTicket(cli.listen(addr, port), wait, (HostSocket s) => listeningOf(cli, wait, addr, s));\n",
    "  }\n",
    "\n",
    "  /** A datagram socket on `addr:port`, which one socket uses to talk to many peers. */\n",
    "  Ticket<Result<Datagrams, BindFault>> bindDatagram(this, string addr, i32 port) {\n",
    "    Cli cli = this.cli;\n",
    "    HostWait wait = this.wait;\n",
    "    return hostTicket(cli.bindDatagram(addr, port), wait, (HostSocket s) => boundOf(cli, wait, s));\n",
    "  }\n",
    "}\n",
    "\n",
    "Result<Socket, ConnectFault> connectedOf(Cli cli, HostWait wait, HostSocket s) {\n",
    "  if (s.handle < 0) { return Result.Err(connectFault(s.fault, s.error)); }\n",
    "  return Result.Ok(Socket(cli, wait, s.handle, s.peer, s.port));\n",
    "}\n",
    "\n",
    "Result<Listener, BindFault> listeningOf(Cli cli, HostWait wait, string addr, HostSocket s) {\n",
    "  if (s.handle < 0) { return Result.Err(bindFault(s.fault, s.error)); }\n",
    "  return Result.Ok(Listener(cli, wait, s.handle, addr + \":\" + \"\\{s.port}\", s.port));\n",
    "}\n",
    "\n",
    "Result<Datagrams, BindFault> boundOf(Cli cli, HostWait wait, HostSocket s) {\n",
    "  if (s.handle < 0) { return Result.Err(bindFault(s.fault, s.error)); }\n",
    "  return Result.Ok(Datagrams(cli, wait, s.handle, s.port));\n",
    "}\n",
    "\n",
    "Result<Socket, HostFault> acceptedOf(Cli cli, HostWait wait, HostSocket s) {\n",
    "  if (s.handle < 0) { return Result.Err(Other(s.error)); }\n",
    "  return Result.Ok(Socket(cli, wait, s.handle, s.peer, s.port));\n",
    "}\n",
    "\n",
    "Result<Read, SocketFault> recvOf(Read c) {\n",
    "  match (c) {\n",
    "    Failed(why): { return Result.Err(Other(why)); }\n",
    "    default: { return Result.Ok(c); }\n",
    "  }\n",
    "}\n",
    "\n",
    "/** A listening socket. */\n",
    "export struct Listener {\n",
    "  Cli cli;\n",
    "  HostWait wait;\n",
    "  i32 handle;\n",
    "  /** `\"0.0.0.0:8080\"`. */\n",
    "  string addr;\n",
    "  /** The port bound — what the host chose when 0 was asked for. */\n",
    "  i32 port;\n",
    "\n",
    "  /**\n",
    "   * The next connection. `Err` only when the listener itself cannot go on (spec ch44 `§wac-std-accept-tkafecv`):\n",
    "   * a connection that ends before it is accepted is never reported.\n",
    "   */\n",
    "  Ticket<Result<Socket, HostFault>> accept(this) {\n",
    "    Cli cli = this.cli;\n",
    "    HostWait wait = this.wait;\n",
    "    return hostTicket(cli.accept(this.handle), wait, (HostSocket s) => acceptedOf(cli, wait, s));\n",
    "  }\n",
    "\n",
    "  void close(this) { this.cli.closeSocket(this.handle); }\n",
    "}\n",
    "\n",
    "/** One connection (spec ch44 `§wac-std-socket-gs9parx`). */\n",
    "export struct Socket {\n",
    "  Cli cli;\n",
    "  HostWait wait;\n",
    "  i32 handle;\n",
    "  /** The other end's address, and its port. */\n",
    "  string peer;\n",
    "  i32 port;\n",
    "\n",
    "  /** The next bytes, or the end. */\n",
    "  Ticket<Result<Read, SocketFault>> recv(this) { return hostTicket(this.cli.recv(this.handle), this.wait, recvOf); }\n",
    "\n",
    "  /** Send `bytes`; a peer that has gone is `PeerClosed`, an ordinary fault a server handles. */\n",
    "  Ticket<Result<void, SocketFault>> send(this, u8[] bytes) {\n",
    "    string peer = this.peer;\n",
    "    return hostTicket(this.cli.send(this.handle, bytes), this.wait, (bool went) => sentOf(went, peer));\n",
    "  }\n",
    "\n",
    "  /** No more from this side; reading goes on. */\n",
    "  void closeSend(this) { this.cli.closeSend(this.handle); }\n",
    "\n",
    "  void close(this) { this.cli.closeSocket(this.handle); }\n",
    "\n",
    "  /** Whether the other end is this machine. */\n",
    "  bool fromLoopback(const this) { return this.peer == \"127.0.0.1\" || this.peer == \"::1\" || this.peer == \"localhost\"; }\n",
    "}\n",
    "\n",
    "Result<void, SocketFault> sentOf(bool went, string peer) {\n",
    "  if (!went) { return Result.Err(PeerClosed(peer + \": the connection has closed\")); }\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "/** A datagram socket: no connection, the peer named on every send and arriving with every receive. */\n",
    "export struct Datagrams {\n",
    "  Cli cli;\n",
    "  HostWait wait;\n",
    "  i32 handle;\n",
    "  i32 port;\n",
    "\n",
    "  Ticket<Result<Datagram, HostFault>> receive(this) { return hostTicket(this.cli.receiveFrom(this.handle), this.wait, datagramOf); }\n",
    "\n",
    "  Ticket<Result<void, union<Unreachable, Unsupported, Other>>> sendTo(this, string host, i32 port, u8[] bytes) {\n",
    "    return hostTicket(this.cli.sendTo(this.handle, host, port, bytes), this.wait, (bool went) => sentToOf(went, host, port));\n",
    "  }\n",
    "\n",
    "  void close(this) { this.cli.closeSocket(this.handle); }\n",
    "}\n",
    "\n",
    "Result<Datagram, HostFault> datagramOf(Datagram d) {\n",
    "  if (d.error != \"\") { return Result.Err(Other(d.error)); }\n",
    "  return Result.Ok(d);\n",
    "}\n",
    "\n",
    "Result<void, union<Unreachable, Unsupported, Other>> sentToOf(bool went, string host, i32 port) {\n",
    "  if (!went) { return Result.Err(Unreachable(host + \":\" + \"\\{port}: the datagram was not sent\")); }\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "// ── Processes and modules ────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "/** Starting a program. */\n",
    "export type SpawnFault = union<NotGranted, Unsupported, Other>;\n",
    "\n",
    "SpawnFault spawnFault(i32 handle, string m) {\n",
    "  if (handle == 0 - 2) { return Unsupported(m); }\n",
    "  if (m == faultWords(FAULT_NOT_GRANTED())) { return NotGranted(m); }\n",
    "  return Other(m);\n",
    "}\n",
    "\n",
    "/**\n",
    " * What a spawned child or a loaded module is handed (spec ch44 `§wac-std-spawn-grants-ykmq5tw`): each handle the\n",
    " * parent's own or narrowed from it, so a child never holds more than its parent.\n",
    " */\n",
    "export struct Authority {\n",
    "  Files? files;\n",
    "  Net? net;\n",
    "  Env? env;\n",
    "  Procs? procs;\n",
    "\n",
    "  /** Nothing at all. */\n",
    "  Authority none() { return Authority(null, null, null, null); }\n",
    "\n",
    "  /** The `GRANT_*` bits this is, for the host — and whether `files` is composed and must be served instead. */\n",
    "  i32 grants(const this) {\n",
    "    i32 g = 0;\n",
    "    if (this.files is not null) { g = g | this.files!.hostGrants; }\n",
    "    if (this.net is not null) { g = g | GRANT_NET; }\n",
    "    if (this.env is not null) { g = g | GRANT_ENV; }\n",
    "    if (this.procs is not null) { g = g | GRANT_RUN; }\n",
    "    return g;\n",
    "  }\n",
    "\n",
    "  bool composedFiles(const this) { return this.files is not null && this.files!.hostGrants == 0; }\n",
    "}\n",
    "\n",
    "/** How a child is started. */\n",
    "export struct Launch {\n",
    "  /** Where its relative paths resolve; `\"\"` for this program's own. */\n",
    "  string cwd;\n",
    "  /** It reads this program's input rather than a queue this program writes. */\n",
    "  bool inheritIn;\n",
    "  /** It writes this program's output and diagnostic output rather than queues this program reads. */\n",
    "  bool inheritOut;\n",
    "  /** Dropping its `Child` does not stop it (spec ch44 `§wac-std-child-drop-n2r5vxe`). */\n",
    "  bool detached;\n",
    "\n",
    "  /** Here, its streams queues, stopped when dropped. */\n",
    "  Launch plain() { return Launch(\"\", false, false, false); }\n",
    "\n",
    "  i32 flags(const this) {\n",
    "    return (this.inheritIn ? INHERIT_IN : 0) | (this.inheritOut ? INHERIT_OUT : 0) | (this.detached ? DETACHED : 0);\n",
    "  }\n",
    "}\n",
    "\n",
    "/**\n",
    " * The environment a host program gets from `Procs.exec`: a base — this program's own, or none — with variables set over\n",
    " * it (spec ch44 `§wac-std-child-env-k3w8tqa`).\n",
    " */\n",
    "export struct ChildEnv {\n",
    "  /** The base is empty rather than this program's own environment. */\n",
    "  bool clean;\n",
    "  /** `NAME=value`, each name once. */\n",
    "  string[] pairs;\n",
    "\n",
    "  /** This program's own environment, unchanged. */\n",
    "  ChildEnv inherited() { return ChildEnv(false, string[]()); }\n",
    "  /** No variables at all. */\n",
    "  ChildEnv empty() { return ChildEnv(true, string[]()); }\n",
    "\n",
    "  /** This environment with `name` set to `value`, replacing any value it had. */\n",
    "  ChildEnv set(const this, string name, string value) {\n",
    "    string prefix = name + \"=\";\n",
    "    i32 kept = 0;\n",
    "    for (i32 i = 0; i < this.pairs.len(); i++) {\n",
    "      if (!namedBy(this.pairs[i], prefix)) { kept++; }\n",
    "    }\n",
    "    string[] next = string[].filled(kept + 1, \"\");\n",
    "    i32 at = 0;\n",
    "    for (i32 i = 0; i < this.pairs.len(); i++) {\n",
    "      if (!namedBy(this.pairs[i], prefix)) { next[at] = this.pairs[i]; at++; }\n",
    "    }\n",
    "    next[kept] = prefix + value;\n",
    "    return ChildEnv(this.clean, next);\n",
    "  }\n",
    "}\n",
    "\n",
    "/** Whether `pair` is `NAME=…` for the `NAME=` that is `prefix`. */\n",
    "bool namedBy(string pair, string prefix) {\n",
    "  return pair.len() >= prefix.len() && pair.slice(0, prefix.len()) == prefix;\n",
    "}\n",
    "\n",
    "/** Starting other programs (spec ch44). */\n",
    "export struct Procs {\n",
    "  Cli cli;\n",
    "  HostWait wait;\n",
    "\n",
    "  /** Start the compiled module `wasm` with `args`, holding `given`. */\n",
    "  Ticket<Result<Child, SpawnFault>> spawn(this, u8[] wasm, string[] args, Authority given, Launch how) {\n",
    "    Cli cli = this.cli;\n",
    "    HostWait wait = this.wait;\n",
    "    Files? served = given.composedFiles() ? given.files : null;\n",
    "    return hostTicket(cli.spawn(wasm, bytesOf(args), given.grants(), how.cwd, how.flags(), served is not null), wait,\n",
    "                      (HostChild k) => childOf(cli, wait, k, served));\n",
    "  }\n",
    "\n",
    "  /** Start another instance of this program — its `main`, with `args` — holding `given`. Needs the grant as `spawn` does. */\n",
    "  Ticket<Result<Child, SpawnFault>> spawnSelf(this, string[] args, Authority given, Launch how) {\n",
    "    Cli cli = this.cli;\n",
    "    HostWait wait = this.wait;\n",
    "    Files? served = given.composedFiles() ? given.files : null;\n",
    "    return hostTicket(cli.spawnSelf(bytesOf(args), given.grants(), how.cwd, how.flags(), served is not null), wait,\n",
    "                      (HostChild k) => childOf(cli, wait, k, served));\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Run a program of the host's — `program` found on its path — to the end, with `input` as its standard input.\n",
    "   * Its output comes back whole unless `how.inheritOut`, when it went to this program's own.\n",
    "   */\n",
    "  Ticket<Result<Exec, SpawnFault>> exec(this, string program, string[] args, u8[] input, ChildEnv env, Launch how) {\n",
    "    return hostTicket(this.cli.execWithIn(program, args, input, env.pairs, env.clean, how.inheritOut, how.cwd), this.wait, ranOf);\n",
    "  }\n",
    "}\n",
    "\n",
    "/** The started child — and, when it was handed a composed `Files`, this program serving it from now until it ends. */\n",
    "Result<Child, SpawnFault> childOf(Cli cli, HostWait wait, HostChild k, Files? served) {\n",
    "  if (k.handle < 0) { return Result.Err(spawnFault(k.handle, k.error)); }\n",
    "  if (served is null) { return Result.Ok(Child(cli, wait, k.handle, k.errHandle, null, null)); }\n",
    "  Ticket<bool> stopping;\n",
    "  return Result.Ok(Child(cli, wait, k.handle, k.errHandle, serveFiles(cli, wait, k.fsHandle, served!, stopping), stopping));\n",
    "}\n",
    "\n",
    "Result<Exec, SpawnFault> ranOf(Exec r) {\n",
    "  if (!r.ran()) { return Result.Err(r.error == faultWords(FAULT_NOT_GRANTED()) ? NotGranted(r.error) : Other(r.error)); }\n",
    "  return Result.Ok(r);\n",
    "}\n",
    "\n",
    "/**\n",
    " * Why a composed `Files` cannot be handed to a loaded module: it runs on this thread, so a question it asked could\n",
    " * only be answered after it returned.\n",
    " */\n",
    "Unsupported composedRefused() {\n",
    "  return Unsupported(\"a Files built in this program cannot be handed to a module, which runs on this program's own \"\n",
    "                     + \"thread and so cannot be served; spawn it instead\");\n",
    "}\n",
    "\n",
    "u8[][] bytesOf(string[] args) {\n",
    "  u8[][] out = u8[][].defaulted(args.len());\n",
    "  for (i32 i = 0; i < args.len(); i++) { out[i] = args[i].toBytes(); }\n",
    "  return out;\n",
    "}\n",
    "\n",
    "/** A running child (spec ch44). */\n",
    "export struct Child {\n",
    "  Cli cli;\n",
    "  HostWait wait;\n",
    "  i32 handle;\n",
    "  i32 errHandle;\n",
    "  /** This program answering the child's file questions, when it was handed a composed `Files`; done once the child is. */\n",
    "  Ticket<void>? serving;\n",
    "  /** Settled by `stop`, which ends the serving as well as the child. */\n",
    "  Ticket<bool>? stopServing;\n",
    "\n",
    "  /** What it writes to its output, unless that was inherited. */\n",
    "  Input output(this) {\n",
    "    Cli cli = this.cli;\n",
    "    HostWait wait = this.wait;\n",
    "    i32 h = this.handle;\n",
    "    return Input(() => hostTicket(cli.recv(h), wait, readOf), () => streamAll(cli, h), nothingToClose);\n",
    "  }\n",
    "\n",
    "  /** What it writes to its diagnostic output, unless that was inherited. */\n",
    "  Input errors(this) {\n",
    "    Cli cli = this.cli;\n",
    "    HostWait wait = this.wait;\n",
    "    i32 h = this.errHandle;\n",
    "    return Input(() => hostTicket(cli.recv(h), wait, readOf), () => streamAll(cli, h), nothingToClose);\n",
    "  }\n",
    "\n",
    "  /** Its input, unless inherited. Closing it ends the child's input without stopping the child. */\n",
    "  Output input(this) {\n",
    "    Cli cli = this.cli;\n",
    "    HostWait wait = this.wait;\n",
    "    i32 h = this.handle;\n",
    "    return Output((u8[] b) => hostTicket(cli.send(h, b), wait, fedOf), () => endFeed(cli, h));\n",
    "  }\n",
    "\n",
    "  /** Its status when it ends — and, when this program serves it files, once the serving has ended too. */\n",
    "  Ticket<Result<i32, HostFault>> exit(this) {\n",
    "    Ticket<Result<i32, HostFault>> code = hostTicket(this.cli.exitCode(this.handle), this.wait, exitedOf);\n",
    "    if (this.serving is null) { return code; }\n",
    "    return exitAfterServing(code, this.serving!);\n",
    "  }\n",
    "\n",
    "  /**\n",
    "   * Stop it now — and the serving of its files with it. The serving is driven to its end here rather than left to\n",
    "   * the scheduler: a program that stops a child and then finishes would otherwise finish with that serving's read\n",
    "   * of the dead channel still registered, which the JavaScript hosts refuse (`stoppedserved_probe.wac`).\n",
    "   */\n",
    "  void stop(this) {\n",
    "    this.cli.closeSocket(this.handle);\n",
    "    Ticket<bool>? s = this.stopServing;\n",
    "    if (s is null || s!.settled()) { return; }\n",
    "    s!.resolve(true);\n",
    "    Ticket<void>? serving = this.serving;\n",
    "    if (serving is not null) { serving!.wait(); }\n",
    "  }\n",
    "}\n",
    "\n",
    "async Result<i32, HostFault> exitAfterServing(Ticket<Result<i32, HostFault>> code, Ticket<void> serving) {\n",
    "  Result<i32, HostFault> status = await code;\n",
    "  await serving;\n",
    "  return status;\n",
    "}\n",
    "\n",
    "Result<i32, HostFault> exitedOf(i32 code) {\n",
    "  if (code < 0) { return Result.Err(Other(\"the child did not run to an end\")); }\n",
    "  return Result.Ok(code);\n",
    "}\n",
    "\n",
    "async Result<u8[], HostFault> streamAll(Cli cli, i32 h) {\n",
    "  u8[] all = u8[]();\n",
    "  while (true) {\n",
    "    Read c = await cli.recv(h).ticket();\n",
    "    match (c) {\n",
    "      Data(bytes): {\n",
    "        u8[] grown = u8[].filled(all.len() + bytes.len(), 0);\n",
    "        grown.copyFrom(all, 0, 0, all.len());\n",
    "        grown.copyFrom(bytes, 0, all.len(), bytes.len());\n",
    "        all = grown;\n",
    "      }\n",
    "      End: { return Result.Ok(all); }\n",
    "      Failed(why): { return Result.Err(Other(why)); }\n",
    "    }\n",
    "  }\n",
    "}\n",
    "\n",
    "async Result<void, OutputFault> endFeed(Cli cli, i32 h) {\n",
    "  cli.closeFeed(h);\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "Result<void, OutputFault> fedOf(bool went) {\n",
    "  if (!went) { return Result.Err(OutputClosed(\"the child's input has closed\")); }\n",
    "  return Result.Ok();\n",
    "}\n",
    "\n",
    "/** Loading wasm modules into this instance (spec ch44 `§wac-std-module-same-thread-q8d2kzm`). */\n",
    "export struct Modules {\n",
    "  Cli cli;\n",
    "\n",
    "  /** Load `wasm`, holding `given`. It runs on this thread when called. */\n",
    "  Result<Module, union<Unsupported, Other>> load(this, u8[] wasm, Authority given) {\n",
    "    if (given.composedFiles()) { return Result.Err(composedRefused()); }\n",
    "    LoadedModule m = this.cli.load(wasm, given.grants());\n",
    "    if (m.handle == 0 - 2) { return Result.Err(Unsupported(m.error)); }\n",
    "    if (m.handle < 0) { return Result.Err(Other(m.error)); }\n",
    "    return Result.Ok(Module(this.cli, m.handle));\n",
    "  }\n",
    "\n",
    "  /** Whether `wasm` is a module this engine accepts; the engine's sentence when not. */\n",
    "  Result<void, union<Unsupported, Other>> validate(this, u8[] wasm) {\n",
    "    string why = this.cli.validated(wasm);\n",
    "    if (why == \"\") { return Result.Ok(); }\n",
    "    if (why == faultWords(FAULT_UNSUPPORTED())) { return Result.Err(Unsupported(why)); }\n",
    "    return Result.Err(Other(why));\n",
    "  }\n",
    "}\n",
    "\n",
    "/** A loaded module. */\n",
    "export struct Module {\n",
    "  Cli cli;\n",
    "  i32 handle;\n",
    "\n",
    "  /** Call the export `name` with `arg`. A trap is an answer (`CallResult.trapped`), not a fault. */\n",
    "  Result<CallResult, HostFault> call(this, string name, i32 arg) { return Result.Ok(this.cli.call(this.handle, name, arg)); }\n",
    "\n",
    "  void unload(this) { this.cli.unload(this.handle); }\n",
    "}\n"
  ] as string[];
  i32 total = 0;
  for (i32 i = 0; i < lines.len(); i++) { total = total + lines[i].toBytes().len(); }
  u8[] all = u8[].filled(total, 0);
  i32 at = 0;
  for (i32 i = 0; i < lines.len(); i++) {
    u8[] b = lines[i].toBytes();
    all.copyFrom(b, 0, at, b.len());
    at = at + b.len();
  }
  return string.fromBytes(all);
}

/** `core`'s files, in the order `coreSource` carries them. */
export string[] coreFileNames() {
  return ["core/read.wac", "core/result.wac", "core/hash.wac", "core/map.wac", "core/vec.wac", "core/buf.wac", "core/text.wac", "core/operators.wac", "core/ticket.wac", "core/number.wac", "core/hypothetical.wac"] as string[];
}

/**
 * The line of `coreSource` each of `core`'s files starts on, counting from 1 — so a line of the
 * module can be reported as the file and line a reader has open.
 */
export i32[] coreFileStarts() {
  return [1, 23, 90, 175, 394, 598, 886, 1241, 1304, 1965, 2139] as i32[];
}

/**
 * Every name `core` exports, read from its declarations — so a check with no files in hand can still
 * say *no such export* about a name `core` does not have.
 */
export string[] coreExports() {
  return ["Read", "Result", "flatten", "hashBytes", "bytesEq", "hashString", "stringEq", "hashI32", "i32Eq", "hashI64", "i64Eq", "Map", "Vec", "Buf", "toString", "markup.text", "markup.element", "markup.fragment", "markup.component", "markup.snapshot", "operators.add", "operators.subtract", "operators.multiply", "operators.divide", "operators.remainder", "operators.negate", "operators.equal", "operators.notEqual", "operators.lessThan", "operators.lessThanOrEqual", "operators.greaterThan", "operators.greaterThanOrEqual", "operators.not", "operators.bitwiseNot", "operators.bitwiseAnd", "operators.bitwiseOr", "operators.bitwiseXor", "operators.shiftLeft", "operators.shiftRight", "operators.unsignedShiftRight", "operators.addAssign", "operators.subtractAssign", "operators.multiplyAssign", "operators.divideAssign", "operators.remainderAssign", "operators.bitwiseAndAssign", "operators.bitwiseOrAssign", "operators.bitwiseXorAssign", "operators.shiftLeftAssign", "operators.shiftRightAssign", "operators.unsignedShiftRightAssign", "operators.preIncrement", "operators.postIncrement", "operators.preDecrement", "operators.postDecrement", "operators.addFromLeft", "operators.subtractFromLeft", "operators.multiplyFromLeft", "operators.divideFromLeft", "operators.remainderFromLeft", "operators.equalFromLeft", "operators.notEqualFromLeft", "operators.lessThanFromLeft", "operators.lessThanOrEqualFromLeft", "operators.greaterThanFromLeft", "operators.greaterThanOrEqualFromLeft", "operators.bitwiseAndFromLeft", "operators.bitwiseOrFromLeft", "operators.bitwiseXorFromLeft", "operators.shiftLeftFromLeft", "operators.shiftRightFromLeft", "operators.unsignedShiftRightFromLeft", "Continuation", "TicketBase", "Stuck", "Ticket", "Values", "AnyValue", "Queue", "Step", "Coroutine", "Generator", "AsyncGenerator", "__wacOrReady", "__wacMachine", "__wacScheduleTarget", "__wacSetScheduleTarget", "NumberLiteral", "fromNumber", "NotANumber", "NotAnInteger", "OutOfRange", "numberLiteralToF64", "numberLiteralToF32", "numberLiteralToI64", "numberLiteralToI32", "literalValue", "hypothetical"] as string[];
}

/**
 * The exports of `core` that are symbols — `toString`, `markup.text` — so a check of one file can
 * know a member named `[markup.text]` is named by one, with no files in hand to read it from.
 */
export string[] coreSymbols() {
  return ["toString", "markup.text", "markup.element", "markup.fragment", "markup.component", "markup.snapshot", "operators.add", "operators.subtract", "operators.multiply", "operators.divide", "operators.remainder", "operators.negate", "operators.equal", "operators.notEqual", "operators.lessThan", "operators.lessThanOrEqual", "operators.greaterThan", "operators.greaterThanOrEqual", "operators.not", "operators.bitwiseNot", "operators.bitwiseAnd", "operators.bitwiseOr", "operators.bitwiseXor", "operators.shiftLeft", "operators.shiftRight", "operators.unsignedShiftRight", "operators.addAssign", "operators.subtractAssign", "operators.multiplyAssign", "operators.divideAssign", "operators.remainderAssign", "operators.bitwiseAndAssign", "operators.bitwiseOrAssign", "operators.bitwiseXorAssign", "operators.shiftLeftAssign", "operators.shiftRightAssign", "operators.unsignedShiftRightAssign", "operators.preIncrement", "operators.postIncrement", "operators.preDecrement", "operators.postDecrement", "operators.addFromLeft", "operators.subtractFromLeft", "operators.multiplyFromLeft", "operators.divideFromLeft", "operators.remainderFromLeft", "operators.equalFromLeft", "operators.notEqualFromLeft", "operators.lessThanFromLeft", "operators.lessThanOrEqualFromLeft", "operators.greaterThanFromLeft", "operators.greaterThanOrEqualFromLeft", "operators.bitwiseAndFromLeft", "operators.bitwiseOrFromLeft", "operators.bitwiseXorFromLeft", "operators.shiftLeftFromLeft", "operators.shiftRightFromLeft", "operators.unsignedShiftRightFromLeft", "fromNumber"] as string[];
}

/**
 * The default type arguments `core` and `std` declare, as `Name|count|d0;d1;…` lines — read here, once,
 * so `lowerTypeDefaults` need not lex the whole of both on every compile (spec ch19).
 */
export string builtinTypeDefaults() {
  return "Result|2|;union" + "\n";
}

/**
 * The enums `core` and then `std` declare, as `Name|V1|V2|` lines — `enumVariantsIn` from `scans.wac`,
 * run here once, so `lowerUnqualifiedVariants` need not parse both on every compile.
 */
export string builtinEnumVariants() {
  return "Read|Data|End|Failed|\nResult|Ok|Err|\nStep|Waiting|Yielded|Done|\n";
}

/** The names of `core`'s variadic functions and methods, as `|a|b|` — `variadicCalleesIn` from `scans.wac`. */
export string builtinVariadicCallees() {
  return "|all|any|anyWithIndex|";
}

/**
 * Does this specifier name a module inside the compiler rather than a file on disk? Only the two
 * names do: a path below either is refused, since a package is named whole (`§wac-no-subpath-wqatc72`).
 */
export bool isBuiltinSpec(string spec) { return spec == "core" || spec == "std"; }
