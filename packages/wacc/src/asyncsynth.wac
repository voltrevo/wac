// Spellings for the names an `async` lowering writes and the reader did not — `design/lang/0014`
// step 4.
//
// Every later phase learns what a token says by reading `tokenText`, which reads bytes out of the
// source. So a node the rewrite invents — `Ticket`, `.park`, the machine's own state variable —
// still needs a span, and the span has to point at real bytes. The answer is to append the spellings
// once to the source and point synthetic tokens into them.
//
// **Behind a `//`, and that is not cosmetic.** `Lexed`'s own note says to lex again for a second
// parse, so a source carrying this tail can be re-lexed, and an uncommented tail would come back as a
// line of code the second time round. As a comment the lexer skips it, while `tokenText` reads
// the bytes underneath — which is the whole trick, and it is why the tail is *appended* rather than
// held beside the source. A separate buffer would need every `tokenText` in the compiler to know
// about it.
//
// **The spans are honest about what they are.** A synthetic token takes the line and column of the
// `async` that produced it: a diagnostic about lowered code then points
// at the word the reader wrote, which is the closest thing to true available. Pointing into a
// comment at the end of the file would be worse than useless.
//
// **The suspension slots are generated, one per `await`.** A machine with three awaits needs three
// places to keep the ticket it is suspended at, and they must be distinct names because they are
// distinct types. So the tail is built for a file rather than fixed, and a file is asked for as many
// as its largest async function needs.

import { Lexed, tokenStride } from "./lex.wac";
import { kIdent, kInt, kAssign, kVoid } from "./kinds.wac";

/** The names that do not depend on the function being lowered. */
string[] fixedWords() {
  return [
                  "Ticket", "value", "Step", "Waiting", "Yielded", "Done", "Coroutine", "TicketBase",
                  "never", "__wacState", "__wacRes", "__wacMachine", "__wacOrReady",
                  "__wacSetScheduleTarget", "=", "i32", "bool", "void", "__wacStepFn",
                  "Ok", "Err", "Result", "__wacTryV", "__wacTryE", "Generator", "AsyncGenerator", "start",
                  "__wacNext", "__wacCurrent", "step", "__wacIsDone", "__wacYieldedOf",
                  "__wacScheduleTarget"
  ] as string[];
}

/** Index of each fixed word. A caller names it rather than counting. */
/** `Ticket` — core's, which a value-reading `await`'s slot holds (spec ch35). */
export i32 synthTicket()     { return 0; }
export i32 synthValue()      { return 1; }
/** core's `Step` and its variants — what a machine's step answers (ch36). */
export i32 synthStep()       { return 2; }
export i32 synthWaiting()    { return 3; }
export i32 synthYielded()    { return 4; }
export i32 synthDone()       { return 5; }
export i32 synthCoroutine()  { return 6; }
export i32 synthTicketBase() { return 7; }
export i32 synthNever()      { return 8; }
export i32 synthState()      { return 9; }
/** The cell a machine keeps its result in, so a step after `Done` can answer `Done` again. */
export i32 synthRes()        { return 10; }
/** core's `__wacMachine<R>`, whose static `start` runs an `async` call's coroutine and wraps it. */
export i32 synthMachine()    { return 11; }
/** core's `__wacOrReady`: what an `await` waits on, a bare one's being a ticket already settled. */
export i32 synthOrReady()    { return 12; }
export i32 synthTargetSet()  { return 13; }
/** `=`. An `Assign` holds its operator's **token index**, which the emitter reads the kind out of —
 *  so a made-up one has to be a real token spelling a real `=`, not a sentinel. */
export i32 synthAssign()     { return 14; }
export i32 synthI32()        { return 15; }
export i32 synthBool()       { return 16; }
export i32 synthVoid()       { return 17; }
/** Holds the step lambda: a lambda is typed by the declaration it initialises. */
export i32 synthStepFn()     { return 18; }
/** `try e` in a machine's body, as the `match` it becomes: the variants, the enum, the bindings. */
export i32 synthOk()         { return 19; }
export i32 synthErr()        { return 20; }
export i32 synthResult()     { return 21; }
export i32 synthTryV()       { return 22; }
export i32 synthTryE()       { return 23; }
/** What calling a generator answers, and an async generator (ch36). */
export i32 synthGenerator()  { return 24; }
export i32 synthAsyncGenerator() { return 25; }
export i32 synthStartName()  { return 26; }
/** What `for … in` over a generator steps it with, and `for await` an async one (ch36). */
export i32 synthNextName()   { return 27; }
export i32 synthCurrentName() { return 28; }
export i32 synthStepCall()   { return 29; }
export i32 synthIsDoneName() { return 30; }
export i32 synthYieldedName() { return 31; }
/** core's read of the schedule target, which a coroutine starts out running under. */
export i32 synthTargetGet()  { return 32; }

/** How many words come before the generated suspension slots. */
export i32 synthFixedCount() { return 33; }

/**
 * The ticket slot for await number `k` — what a value-reading `await` suspended on, read back with
 * `value()` once the machine resumes.
 */
export i32 synthSlot(i32 k) { return synthFixedCount() + 2 * k; }

/**
 * The temporary for await number `k` when it sat inside a larger expression: `(await t) * 2`
 * becomes `X __wacAwK = await t;` and then `__wacAwK * 2`.
 */
export i32 synthAw(i32 k) { return synthFixedCount() + 2 * k + 1; }

/**
 * The name an `async` lambda's parameter `k` is renamed to — `issues/lang/0294c`.
 *
 * **The parameter is renamed so that its cell can keep the written name.** A machine puts the whole
 * body inside `__wacStep`, so every mention of a parameter becomes a capture, and a lambda's
 * parameter captured by an inner lambda emits a module the engine rejects (`issues/lang/0296c`: a
 * cell is keyed by the position of a *declaration* and a parameter has none). Giving the cell the
 * written name and the parameter a synthetic one turns the capture into an ordinary hoisted local:
 *
 *     async (string p) => { … p … }
 *     (string __wacArg0) => { string[] p = string[].filled(1, __wacArg0); … p[0] … }
 *
 * The substitution that rewrites `p` to `p[0]` is then the one already there for locals, and nothing
 * shadows anything: `__wacArg0` is read exactly once, in the fill.
 */
export i32 synthArg(i32 ups, i32 k) { return synthFixedCount() + 2 * (ups < 0 ? 0 : ups) + k; }

/**
 * The numeral `k`, as an index into `synthWords(ups, states, args)`.
 *
 * **Numerals are generated too, and that is not fussiness.** `IntLit` reads its value out of the
 * token's text, so every number the machine writes down needs its own spelling: the `1` of `T[].defaulted(1)`,
 * the `0` of `x[0]`, and one per state for `__wacState[0] = k;`. A machine with `ups` suspensions has
 * states `0..ups`, so the tail carries numerals up to `ups + 1` and a wrong count here would be a
 * silently wrong state number rather than a failure.
 *
 * **Last in the tail, and that is load-bearing**: `synthTokens` decides a word is an `IntLit` by
 * being at or past the first numeral, so anything appended after them would be lexed as a number.
 * The argument names sit before them for exactly that reason.
 */
export i32 synthNum(i32 ups, i32 args, i32 k) {
  return synthArg(ups, args < 0 ? 0 : args) + k;
}

/** `0`, for indexing a cell. */
export i32 synthZero(i32 ups, i32 args) { return synthNum(ups, args, 0); }
/** `1`, for the `T[].defaulted(1)` that makes one. */
export i32 synthOne(i32 ups, i32 args) { return synthNum(ups, args, 1); }

/**
 * How many numerals a body needs.
 *
 * **Sized from the *states*, not the suspensions.** Every state the flattening allocates is written
 * down as `__wacState[0] = k;`, and a loop turns one statement into three states — so tying this to
 * the number of `await`s was right only while the machine was linear. It stopped being right the
 * moment a suspension could sit inside a loop, and what it produced was a token index past the end
 * of the tail: a trap inside the compiler, reported as `wac.wac trapped`.
 */
export i32 synthNumCount(i32 states) { return (states < 0 ? 0 : states) + 2; }

/**
 * Every spelling the tail carries, for a file needing `ups` suspension slots.
 *
 * One list, because the byte offsets are walked from it rather than written down: a table of
 * hand-counted offsets is right until somebody adds a word in the middle.
 */
export string[] synthWords(i32 ups, i32 states, i32 args) {
  string[] fixed = fixedWords();
  i32 n = ups < 0 ? 0 : ups;
  i32 a = args < 0 ? 0 : args;
  i32 nums = synthNumCount(states);
  string[] out = string[].defaulted(fixed.len() + 2 * n + a + nums);
  for (i32 i = 0; i < fixed.len(); i++) { out[i] = fixed[i]; }
  for (i32 i = 0; i < n; i++) {
    out[fixed.len() + 2 * i] = "__wacUp" + synthDecimal(i);
    out[fixed.len() + 2 * i + 1] = "__wacAw" + synthDecimal(i);
  }
  for (i32 i = 0; i < a; i++) { out[fixed.len() + 2 * n + i] = "__wacArg" + synthDecimal(i); }
  for (i32 i = 0; i < nums; i++) { out[fixed.len() + 2 * n + a + i] = synthDecimal(i); }
  return out;
}

/** Decimal, without pulling `packages/fmt` into the compiler's own dependencies. */
string synthDecimal(i32 n) {
  if (n == 0) { return "0"; }
  string out = "";
  i32 v = n;
  while (v > 0) {
    out = string.fromCodepoint(48 + v % 10) + out;
    v = v / 10;
  }
  return out;
}

/** The marker the tail opens with, so the tail can recognise its own work. */
string synthMarker() { return "// wac:async-synth "; }

/** A source with the tail appended, or the same bytes when it is already there. */
export u8[] synthSource(u8[] src, i32 ups, i32 states, i32 args) {
  if (synthBase(src) >= 0) { return src; }
  string tail = "\n" + synthMarker();
  string[] w = synthWords(ups, states, args);
  for (i32 i = 0; i < w.len(); i++) {
    if (i > 0) { tail = tail + " "; }
    tail = tail + w[i];
  }
  u8[] add = (tail + "\n").toBytes();
  u8[] out = u8[].filled(src.len() + add.len(), 0);
  for (i32 i = 0; i < src.len(); i++) { out[i] = src[i]; }
  for (i32 i = 0; i < add.len(); i++) { out[src.len() + i] = add[i]; }
  return out;
}

/**
 * Where the first word sits in `src`, or -1 when the tail is not there.
 *
 * Searched for rather than remembered, so `synthSource` is idempotent and a source that has been
 * through it twice — which `Lexed`'s re-lex note makes possible — is not extended twice.
 */
export i32 synthBase(u8[] src) {
  u8[] m = synthMarker().toBytes();
  if (src.len() < m.len()) { return 0 - 1; }
  for (i32 at = src.len() - m.len(); at >= 0; at--) {
    bool hit = true;
    for (i32 j = 0; j < m.len(); j++) {
      if (src[at + j] != m[j]) { hit = false; break; }
    }
    if (hit) { return at + m.len(); }
  }
  return 0 - 1;
}

/**
 * Byte offset of word `which` within a source the tail has been appended to, or -1.
 *
 * Walked from the base rather than indexed, because the words have different lengths and one space
 * between them — the same reason the list above is the single source of the offsets.
 */
export i32 synthOffset(u8[] src, i32 ups, i32 states, i32 args, i32 which) {
  i32 at = synthBase(src);
  if (at < 0) { return 0 - 1; }
  string[] w = synthWords(ups, states, args);
  if (which < 0 || which >= w.len()) { return 0 - 1; }
  for (i32 i = 0; i < which; i++) { at = at + w[i].toBytes().len() + 1; }
  return at;
}

/**
 * `lexed` with one token per word appended, spanning `line`/`col`.
 *
 * The tokens go on the end, so every index the parser already handed to the AST still means what it
 * meant. `"0"` is lexed as an integer rather than an identifier, because an `IntLit` reads its value
 * out of its token and a kind mismatch there would be a silent zero somewhere else.
 */
export Lexed synthTokens(Lexed lexed, u8[] src, i32 ups, i32 states, i32 args, i32 line, i32 col) {
  string[] w = synthWords(ups, states, args);
  i32 stride = tokenStride();
  // **The parser's own appended tokens come along** — a `kSymName` is an index the AST already holds,
  // so the words go after those rather than over them.
  i32 have = lexed.tokenCount + lexed.synthCount;
  i32[] out = i32[].filled((have + w.len()) * stride, 0);
  for (i32 i = 0; i < have * stride; i++) { out[i] = lexed.tokens[i]; }
  for (i32 i = 0; i < w.len(); i++) {
    i32 at = (have + i) * stride;
    // **The kind matters and is not always `kIdent`.** An `IntLit` reads its value out of the
    // token, an `Assign` reads its operator's kind out of one, and `void` is its own kind rather
    // than an identifier — each of those would be wrong *silently* if this were uniform.
    i32 k = kIdent();
    if (i >= synthNum(ups, args, 0)) { k = kInt(); }
    else if (i == synthAssign()) { k = kAssign(); }
    else if (i == synthVoid()) { k = kVoid(); }
    out[at] = k;
    out[at + 1] = synthOffset(src, ups, states, args, i);
    out[at + 2] = w[i].toBytes().len();
    out[at + 3] = line;
    out[at + 4] = col;
  }
  return Lexed(out, have + w.len(), lexed.errors, lexed.errorCount, 0, lexed.parsed);
}

/**
 * What token `t` says.
 *
 * **A second copy of `emit.wac`'s `tokenTextOf`, and it has to be.** The emitter imports the async
 * lowering to run it, so the lowering cannot import the emitter back — and the rewrite has to compare
 * a name against the ones it is hoisting, which is a question about text rather than about token
 * indices: two different tokens spell the same name, and the same token index means different things
 * in different files.
 */
export string synthTextAt(u8[] src, Lexed lexed, i32 t) {
  if (t < 0 || t >= lexed.tokenCount) { return ""; }
  i32 at = t * tokenStride();
  i32 start = lexed.tokens[at + 1];
  i32 len = lexed.tokens[at + 2];
  if (start < 0 || len < 0 || start + len > src.len()) { return ""; }
  u8[] out = u8[].filled(len, 0);
  for (i32 i = 0; i < len; i++) { out[i] = src[start + i]; }
  return string.fromBytes(out);
}

/** The token index of word `which`, given the count before they were appended. */
export i32 synthTok(i32 firstSynthTok, i32 which) { return firstSynthTok + which; }
