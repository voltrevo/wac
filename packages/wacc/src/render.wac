// A diagnostic a person can read, from the wire a program can parse.
//
// `diagnoseFiles` answers `file\tline\tcol\tphase\tmessage\tnote\thint\twidth\tseverity\tcontextStart`
// per line, because a boundary carries strings rather than structures. Ten fields, and the count is
// worth keeping right: this sentence said eight when there were nine, and **counting them is how
// `issues/lang/0232a` found that there was nowhere to put the reference's `contextStart`** — a
// diagnostic rendered two source lines short of the spec's clause because a number had no field.
//
// The wire is positional and deliberately ragged at the end: an error stops at `width`, a warning
// carries `severity`, and only a diagnostic whose span runs across lines carries `contextStart`. An
// absent field reads as empty, so a row that has nothing to say about one is a row that does not
// mention it — which is what keeps adding a field from rewriting every diagnostic in the repository.
//
// `packages/wacc/tools/wireDiagnostics.ts` turns it back into the reference's `DiagError`, which
// `wacDiag` prints
//
//     error: return type does not match the function's
//       --> main.wac:1:28
//        |
//      1 | export i32 main() { return "no"; }
//        |                            ^ expected i32, found string
//        = help: use a cast if the conversion is meant: `as!` is checked, `as~` takes the nearest value
//
// while `example/wacc.wac` — the compiler as a program, and what the `wac` binary dispatches —
// printed the wire itself: tab-separated fields, to a person. Both halves of the toolchain are
// the compiler; only one of them was usable at the point where it matters most, which is when
// something is wrong.
//
// **The same output, not a similar one.** `test/wac/renderdiag_test.wac` compares this against `wacDiag`
// over the spec's refused programs, character for character, because "the binary explains itself
// too" is a claim about the text — a renderer that dropped the annotation, or put the caret one
// column off, would still look like a diagnostic.

import { numText } from "./emit.wac";

/** One tab-separated field, or "" past the end. */
string field(string line, i32 want) {
  i32 at = 0;
  i32 n = 0;
  string cur = "";
  for (i32 i = 0; i < line.len(); i++) {
    if (line.slice(i, i + 1) == "\t") {
      if (n == want) { return cur; }
      n = n + 1;
      cur = "";
      continue;
    }
    cur = cur + line.slice(i, i + 1);
  }
  return n == want ? cur : "";
}

/**
 * The lines of a text, which is where a diagnostic's own line comes from.
 *
 * **Sliced between the newlines rather than accumulated a character at a time.** `cur = cur + ch`
 * allocates a new string per character, so building one line of `n` characters costs `n²/2` character
 * copies — invisible on source, where lines are short, and the whole cost on a file that has no
 * newlines at all. A 75 KB wasm module offered to the compiler as source is exactly that: one line.
 * `issues/system/0239c`.
 */
string[] linesOf(string text) {
  i32 count = 1;
  for (i32 i = 0; i < text.len(); i++) {
    if (text.slice(i, i + 1) == "\n") { count = count + 1; }
  }
  string[] out = string[count](fill: "");
  i32 n = 0;
  i32 start = 0;
  for (i32 i = 0; i < text.len(); i++) {
    if (text.slice(i, i + 1) == "\n") {
      out[n] = text.slice(start, i);
      n = n + 1;
      start = i + 1;
    }
  }
  out[n] = text.slice(start, text.len());
  return out;
}

/** A non-negative number, or 0 for anything that is not one. */
i32 numOf(string s) {
  i32 v = 0;
  for (i32 i = 0; i < s.len(); i++) {
    string ch = s.slice(i, i + 1);
    if (ch < "0" || ch > "9") { return 0; }
    v = v * 10 + (ch.toBytes()[0] - 48);
  }
  return s == "" ? 0 : v;
}

string repeat(string s, i32 n) {
  string out = "";
  for (i32 i = 0; i < n; i++) { out = out + s; }
  return out;
}

/** The source of `path`, or "" — a diagnostic about a file nobody passed still says what is wrong. */
string sourceFor(string[] paths, string[] sources, string path) {
  for (i32 i = 0; i < paths.len() && i < sources.len(); i++) {
    if (paths[i] == path) { return sources[i]; }
  }
  return "";
}

/**
 * The whole of `diagnoseFiles`'s answer, rendered.
 *
 * Blank when there is nothing wrong, so a caller can print it or not on that alone. Diagnostics are
 * separated by a blank line, which is `wacDiag`'s `join("\n\n")`.
 */
export string renderDiagnostics(string wire, string[] paths, string[] sources) {
  string out = "";
  i32 shown = 0;
  // **The source is split once per file, not once per diagnostic.** `renderOne` used to do its own
  // `linesOf(sourceFor(...))`, so a file with N diagnostics walked its whole source N times — and the
  // walk was itself quadratic in the length of a line. Together that is the reason a 75 KB wasm module
  // handed to the compiler as source burned 90 s of CPU and printed nothing: the diagnostics were all
  // found quickly and the *rendering* never finished, which is also why a run killed part-way had
  // written zero bytes. Measured on prefixes of one: 2 KB took 513 ms and 16 KB took 34 s, while the
  // diagnostic count only doubled — the cost was in the rendering, not the parsing.
  // `issues/system/0239c`.
  //
  // One entry is enough rather than a map: diagnostics arrive grouped by file, so this misses only at
  // a boundary, and the common case is one file anyway.
  string lastFile = "";
  string[] lastLines = string[1](fill: "");
  string[] lines = linesOf(wire);
  for (i32 i = 0; i < lines.len(); i++) {
    string cur = lines[i];
    if (cur == "") { continue; }
    string file = field(cur, 0);
    if (file != lastFile || shown == 0) {
      lastLines = linesOf(sourceFor(paths, sources, file));
      lastFile = file;
    }
    if (shown > 0) { out = out + "\n\n"; }
    out = out + renderOne(cur, lastLines);
    shown = shown + 1;
  }
  return out;
}

/**
 * A line number right-aligned in `digits` columns — `wacDiag`'s `String(ln).padStart(digits)`.
 *
 * Invisible until a diagnostic prints more than one line: the caret's own number is what `digits` was
 * measured from, so padding it is a no-op. A context line above it can be shorter — line 9 above line
 * 10 — and that is the case the padding is for.
 */
string gutter(i32 n, i32 digits) {
  string t = numText(n);
  return t.len() >= digits ? t : repeat(" ", digits - t.len()) + t;
}

/** One diagnostic, laid out the way `compiler/wacDiag.ts` lays one out. */
string renderOne(string line, string[] srcLines) {
  string file = field(line, 0);
  i32 lineNo = numOf(field(line, 1));
  i32 col = numOf(field(line, 2));
  // **The phase decides the word.** `warn` is a diagnostic that must not read as a refusal — the
  // program compiles — so it says so rather than being printed as an error with a softer message.
  // `issues/lang/0126`.
  bool isWarning = field(line, 8) == "warning";
  string message = field(line, 4);
  string note = field(line, 5);
  string hint = field(line, 6);
  // **`0` means not measured**, which `diagnoseFiles` emits precisely so a measurement can tell that
  // from a genuine width of 1. Either way one caret is what gets drawn.
  i32 width = numOf(field(line, 7));
  if (width <= 0) { width = 1; }
  // **Where to start printing, which is not how wide the span is.** `§wac-diag-multiline-ic7x2hq`
  // shows the lines above the caret — a caret under `3.14` says nothing about which call it is an
  // argument to — and only the checker knows which construct the diagnostic came from, so the number
  // crosses the wire rather than being inferred here. `0` or absent means the caret's line alone,
  // which is what `wacDiag` gets from an unset `contextStart`. `issues/lang/0232a`.
  i32 from = numOf(field(line, 9));

  // The gutter is as wide as the line number: one space either side of the digits.
  i32 digits = numText(lineNo).len();
  if (digits < 1) { digits = 1; }
  string pad = repeat(" ", digits + 2);
  string arrowPad = repeat(" ", digits + 1);

  string text = lineNo >= 1 && lineNo <= srcLines.len() ? srcLines[lineNo - 1] : "";

  string out = (isWarning ? "warning: " : "error: ") + message + "\n";
  out = out + arrowPad + "--> " + file + ":" + numText(lineNo) + ":" + numText(col) + "\n";
  out = out + pad + "|\n";
  i32 firstLine = from > 0 && from < lineNo ? from : lineNo;
  for (i32 ln = firstLine; ln < lineNo; ln++) {
    string above = ln >= 1 && ln <= srcLines.len() ? srcLines[ln - 1] : "";
    out = out + " " + gutter(ln, digits) + " | " + above + "\n";
  }
  out = out + " " + gutter(lineNo, digits) + " | " + text + "\n";
  out = out + pad + "| " + repeat(" ", col > 0 ? col - 1 : 0) + repeat("^", width);
  if (note != "") { out = out + " " + note; }
  if (hint != "") { out = out + "\n" + pad + "= help: " + hint; }
  return out;
}
