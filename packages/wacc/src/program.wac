// A program's entry, as a host starts it — spec ch07.
//
// To the language `main` is an ordinary name. Building a *program* is what gives it a contract: no
// parameters or one `Sys`, answering `void`, `never`, `i32` or a `Result` of `void` or `i32`, any of them
// `async`. The hosts start a program by calling `main(Core, Cli)` and reading an `i32`, so a `main` in any
// other permitted shape is renamed and the entry gains an adapter in the host's: it makes the `Sys`,
// settles an `async` answer with the program's unawaited work running alongside, and turns a `Result`
// into a status.
//
// Text in, text out, so every route that builds a program — `wac build`, `wac run`, the spec probe —
// gets the same entry by calling one function before it compiles.

import { Lexed, lex, tokenStride } from "./lex.wac";
import { endsWith, startsWith } from "./path.wac";
import { P, parseProgram } from "./parse.wac";
import { Decl, DeclKind, ImportItem, Param, Program, Ty, TyKind } from "./ast.wac";
import { lowerNamespaces, lowerNamespacesForDeclarations } from "./namespaces.wac";
import { Res } from "./path.wac";

export struct ProgramEntry {
  /** Why this entry cannot be built as a program, or `""`. */
  string why;
  /** The entry's source as a build compiles it: unchanged, or renamed with the adapter appended. */
  string source;
}

// What `main` answers, once `async` is set aside — numbers, since an enum has no `==`.
i32 NOTHING() { return 0; }
i32 NEVER() { return 1; }
i32 STATUS() { return 2; }
i32 OK_NOTHING() { return 3; }
i32 OK_STATUS() { return 4; }

/** `text`, the entry of a program build, checked for `main`'s shape and given the adapter it needs. */
export ProgramEntry programEntry(string text) {
  u8[] src = text.toBytes();
  Lexed lexed = lex(src);
  P p = P.create(src, lexed);
  Program prog = parseProgram(p);
  // A file that does not parse is the checker's to report, and one with no `main` is a library: a
  // named export is what `wac run` calls in it.
  if (p.errorCount > 0) { return ProgramEntry("", text); }
  bool haveCore = false;
  bool haveCli = false;
  bool haveSys = false;
  bool haveTicket = false;
  for (i32 di = 0; di < prog.decls.len(); di++) {
    match (prog.decls[di].kind) {
      Import(pathTok, prefixTok, items): {
        for (i32 ii = 0; ii < items.len(); ii++) {
          ImportItem it = items[ii];
          string local = progText(src, lexed, it.aliasTok);
          if (local == "Core") { haveCore = true; }
          if (local == "Cli") { haveCli = true; }
          if (local == "Sys") { haveSys = true; }
          if (local == "Ticket") { haveTicket = true; }
        }
      }
      default: { }
    }
  }
  for (i32 di = 0; di < prog.decls.len(); di++) {
    match (prog.decls[di].kind) {
      Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
        if (!exported || progText(src, lexed, nameTok) != "main") { continue; }
        return shaped(text, src, lexed, nameTok, returnType, params, isAsync,
                      haveCore, haveCli, haveSys, haveTicket);
      }
      default: { }
    }
  }
  return ProgramEntry("", text);
}

ProgramEntry shaped(string text, u8[] src, Lexed lexed, i32 nameTok, Ty returnType, Param[] params,
                    bool isAsync, bool haveCore, bool haveCli, bool haveSys, bool haveTicket) {
  string[] pts = string[].defaulted(params.len());
  for (i32 i = 0; i < params.len(); i++) { pts[i] = spell(src, lexed, params[i].type); }
  bool takesSys = pts.len() == 1 && pts[0] == "Sys";
  // **The adapter's own `main`** is the one shape left that names `Core` and `Cli` — this entry was
  // already adapted, and adapting is idempotent. The parameter names are ones no program writes.
  if (pts.len() == 2 && pts[0] == "Core" && pts[1] == "Cli"
      && progText(src, lexed, params[0].nameTok) == "__wacCore") {
    return ProgramEntry("", text);
  }
  if (pts.len() > 0 && !takesSys) {
    return ProgramEntry("a program's `main` takes no parameters or one `Sys`, and this one takes ("
                        + joined(pts) + ")", text);
  }
  string ret = spell(src, lexed, returnType);
  i32 a = NOTHING();
  if (ret == "void") { a = NOTHING(); }
  else if (ret == "never") { a = NEVER(); }
  else if (ret == "i32") { a = STATUS(); }
  else if (ret == "Result<void>" || startsWith(ret, "Result<void, ")) { a = OK_NOTHING(); }
  else if (ret == "Result<i32>" || startsWith(ret, "Result<i32, ")) { a = OK_STATUS(); }
  else {
    return ProgramEntry("a program's `main` answers `void`, `never`, `i32`, or a `Result` of `void` or `i32`, "
                        + "and this one answers `" + ret + "`", text);
  }
  // A `main` the hosts can already call is left alone.
  bool plain = !takesSys && !isAsync && (a == NOTHING() || a == NEVER() || a == STATUS());
  if (plain) { return ProgramEntry("", text); }

  // `export` out and `__wacMain` in, so the module's `main` is the adapter's. Blanked rather than cut,
  // so every position before the name keeps its column.
  i32 at = tokStart(lexed, nameTok);
  i32 ex = exportBefore(src, lexed, nameTok);
  string head = ex >= 0 ? text.slice(0, ex) + "      " + text.slice(ex + 6, at) : text.slice(0, at);
  string out = head + "__wacMain" + text.slice(at + 4, text.len());

  string call = "__wacMain(" + (takesSys ? "__wacSys" : "") + ")";
  string body = "";
  if (isAsync) {
    body = body + "  Ticket<" + ret + "> __wacT = " + call + ";\n"
         + "  if (!__wacSys.__wacSettle(__wacT)) { return 1; }\n";
    call = "__wacT.value()";
  }
  if (a == NOTHING()) { body = body + "  " + call + ";\n  return 0;\n"; }
  else if (a == NEVER()) { body = body + "  " + call + ";\n"; }
  else if (a == STATUS()) { body = body + "  return " + call + ";\n"; }
  else {
    string ok = a == OK_STATUS() ? "Ok(v): { return v; }" : "Ok(_): { return 0; }";
    string err = errArm(ret);
    body = body + "  match (" + call + ") {\n    " + ok + "\n    " + err + "\n  }\n";
  }

  string imports = "";
  string names = (haveCore ? "" : "Core, ") + (haveCli ? "" : "Cli, ") + (haveSys ? "" : "Sys, ");
  if (names != "") { imports = imports + "import { " + names.slice(0, names.len() - 2) + " } from \"std\";\n"; }
  if (isAsync && !haveTicket) { imports = imports + "import { Ticket } from \"core\";\n"; }
  out = out + "\n\n// wac:program — the entry as a host starts it (packages/wacc/src/program.wac).\n" + imports
      + "export i32 main(Core __wacCore, Cli __wacCli) {\n"
      + "  Sys __wacSys = Sys.__wacOf(__wacCore, __wacCli);\n" + body + "}\n";
  return ProgramEntry("", out);
}

/**
 * The `Err` arm of the adapter's `match`: what the program failed with, as text, and status 1.
 *
 * **From the error type as it is written by now**, which is after a left-out one was gathered —
 * `Result<i32>` reaches here as `Result<i32, union<string, Malformed>>`. This said `"\{e}"` for
 * every `Result<i32>`, from when a left-out error type meant `string`; once it meant a gathered
 * `union`, every such `main` stopped building — *text from a union<string>, which has no
 * `[toString]`* — and spec ch07's own `Result<i32>` example only looked met because a build that
 * fails exits 1 too. A member that is a string or a number is shown; any other is named.
 */
string errArm(string ret) {
  string e = errorTypeOf(ret);
  if (e == "string") { return "Err(e): { return __wacSys.__wacFailed(e); }"; }
  if (isTextPrimitive(e)) { return "Err(e): { return __wacSys.__wacFailed(\"\\{e}\"); }"; }
  if (startsWith(e, "union<") && endsWith(e, ">")) {
    string[] ms = topLevelParts(e.slice(6, e.len() - 1));
    // One alternative is that alternative (spec ch18), so there is nothing to tell apart.
    if (ms.len() == 1 && ms[0] == "string") { return "Err(e): { return __wacSys.__wacFailed(e); }"; }
    if (ms.len() == 1 && isTextPrimitive(ms[0])) { return "Err(e): { return __wacSys.__wacFailed(\"\\{e}\"); }"; }
    string arms = "";
    for (i32 i = 0; i < ms.len(); i++) {
      string m = ms[i];
      string bare = startsWith(m, "const ") ? m.slice(6, m.len()) : m;
      string shown = bare == "string" ? "e" : isTextPrimitive(bare) ? "\"\\{e}\"" : "\"" + bare + "\"";
      arms = arms + m + ": " + shown + ", ";
    }
    if (arms == "") { return "Err(_): { return __wacSys.__wacFailed(\"\"); }"; }
    return "Err(e): { return __wacSys.__wacFailed(match (e) { " + arms + "}); }";
  }
  // Not known yet — the route reached here before the default was gathered — so the emitter, which
  // will know it, converts whatever union it turns out to be.
  if (e == "" || e == "union") { return "Err(e): { return __wacSys.__wacFailed(\"\\{e}\"); }"; }
  // A single written type: named, since this adapter cannot know whether it has a conversion.
  return "Err(e): { return __wacSys.__wacFailed(\"" + e + "\"); }";
}

/** The error type of `Result<T, E>` as written, or "" when there is none. */
string errorTypeOf(string ret) {
  if (!startsWith(ret, "Result<") || !endsWith(ret, ">")) { return ""; }
  string[] ps = topLevelParts(ret.slice(7, ret.len() - 1));
  return ps.len() == 2 ? ps[1] : "";
}

bool isTextPrimitive(string t) {
  return t == "i32" || t == "i64" || t == "u32" || t == "u64" || t == "i8" || t == "i16" || t == "u8"
      || t == "u16" || t == "f32" || t == "f64" || t == "bool";
}

/** `a, b<c, d>, e` split at the commas outside any `<…>` or `(…)`, each trimmed of its leading space. */
string[] topLevelParts(string s) {
  u8[] b = s.toBytes();
  i32 n = s.len() == 0 ? 0 : 1;
  i32 depth = 0;
  for (i32 i = 0; i < b.len(); i++) {
    i32 ch = b[i] as i32;
    if (ch == 60 || ch == 40) { depth = depth + 1; }          // `<` `(`
    if (ch == 62 || ch == 41) { depth = depth - 1; }          // `>` `)`
    if (ch == 44 && depth == 0) { n = n + 1; }                // `,`
  }
  string[] out = string[].filled(n, "");
  i32 k = 0;
  i32 from = 0;
  depth = 0;
  for (i32 i = 0; i <= b.len(); i++) {
    bool cut = i == b.len();
    if (!cut) {
      i32 ch = b[i] as i32;
      if (ch == 60 || ch == 40) { depth = depth + 1; }
      if (ch == 62 || ch == 41) { depth = depth - 1; }
      cut = ch == 44 && depth == 0;
    }
    if (!cut) { continue; }
    string part = s.slice(from, i);
    while (part.len() > 0 && part.slice(0, 1) == " ") { part = part.slice(1, part.len()); }
    if (k < n) { out[k] = part; k = k + 1; }
    from = i + 1;
  }
  return out;
}

/** A type as written, with `, ` between arguments. */
string spell(u8[] src, Lexed lexed, Ty t) {
  match (t.kind) {
    TypeOf(e): { return "type(…)"; }
    TypeofExpr(e): { return "typeof(…)"; }
    Prim(tok): { return progText(src, lexed, tok); }
    Named(tok, args): {
      string s = progText(src, lexed, tok);
      if (args.len() == 0) { return s; }
      string[] ws = string[].defaulted(args.len());
      for (i32 i = 0; i < args.len(); i++) { ws[i] = spell(src, lexed, args[i]); }
      return s + "<" + joined(ws) + ">";
    }
    Arr(elem): { return spell(src, lexed, elem) + "[]"; }
    Nullable(inner): { return spell(src, lexed, inner) + "?"; }
    Funcref(r, ps): {
      string[] ws = string[].defaulted(ps.len());
      for (i32 i = 0; i < ps.len(); i++) { ws[i] = spell(src, lexed, ps[i]); }
      return "fn<" + spell(src, lexed, r) + "(" + joined(ws) + ")>";
    }
    TupleOf(ms): {
      string[] ws = string[].defaulted(ms.len());
      for (i32 i = 0; i < ms.len(); i++) { ws[i] = spell(src, lexed, ms[i]); }
      return "(" + joined(ws) + ")";
    }
  }
}

string joined(string[] xs) {
  string out = "";
  for (i32 i = 0; i < xs.len(); i++) { out = out + (i > 0 ? ", " : "") + xs[i]; }
  return out;
}

i32 tokStart(Lexed lexed, i32 t) { return lexed.tokens[t * tokenStride() + 1]; }

/** The byte offset of the `export` that begins the declaration whose name is `nameTok`, or -1. */
i32 exportBefore(u8[] src, Lexed lexed, i32 nameTok) {
  for (i32 t = nameTok - 1; t >= 0; t--) {
    string s = progText(src, lexed, t);
    if (s == "export") { return tokStart(lexed, t); }
    if (s == ";" || s == "}" || s == "{") { return -1; }
  }
  return -1;
}



/**
 * `programEntry` applied to the entry among `sources` — what a program build compiles. `why` is the
 * refusal, if there is one, and `source` is unused: the sources are in `sources`.
 */
export ProgramGraph programGraph(string[] paths, string[] sources, string entry) {
  string[] out = string[].defaulted(sources.len());
  string why = "";
  for (i32 i = 0; i < sources.len(); i++) {
    out[i] = sources[i];
    if (i < paths.len() && paths[i] == entry) {
      ProgramEntry pe = programEntry(sources[i]);
      out[i] = pe.source;
      why = pe.why;
    }
  }
  return ProgramGraph(why, out);
}

export struct ProgramGraph {
  string why;
  string[] sources;
}

/** A token's text. Local rather than the emitter's `tokenTextOf`, which links through this file. */
string progText(u8[] src, Lexed lexed, i32 t) {
  if (t < 0) { return ""; }
  i32 start = lexed.tokens[t * tokenStride() + 1];
  i32 len = lexed.tokens[t * tokenStride() + 2];
  u8[] out = u8[].filled(len, 0);
  for (i32 i = 0; i < len; i++) { out[i] = src[start + i]; }
  return string.fromBytes(out);
}

// ---- Tests — spec ch47 ----

/**
 * `text` as the parser is handed it in a build: with its namespaces lowered away (spec ch03), which is
 * the step before anything else reads a source. Without it a test file importing a namespace member —
 * `import { html.p } from "core"`, which every JSX test does — did not parse here, so a directory run
 * found no tests in it and dropped the file without a word. A build lowers again, and lowering a
 * lowered text changes nothing.
 */
string asParsed(string text) {
  string[] lowered = lowerNamespaces(string[].filled(1, "test.wac"), string[].filled(1, text), Res.empty());
  return lowered[0];
}

/**
 * A test file as a test build compiles it: every exported `test*` that takes a `Sys` or is `async` is
 * renamed and given an adapter taking `(Core, Cli)`, which the runner can call, that makes the `Sys`
 * and settles an `async` answer — "a test may take the capabilities it needs as parameters, as `main`
 * does" (ch47). The `Sys` is made from the run's own `Core` and `Cli`, so it holds only what the run
 * granted. Idempotent: the adapters take `Core` and `Cli`, which this leaves alone.
 */
export string testEntry(string text0) {
  if (text0.indexOf("Sys") < 0 && text0.indexOf("async") < 0) { return text0; }
  string text = asParsed(text0);
  u8[] src = text.toBytes();
  Lexed lexed = lex(src);
  P p = P.create(src, lexed);
  Program prog = parseProgram(p);
  if (p.errorCount > 0) { return text; }
  bool haveCore = false;
  bool haveCli = false;
  bool haveSys = false;
  bool haveTicket = false;
  for (i32 di = 0; di < prog.decls.len(); di++) {
    match (prog.decls[di].kind) {
      Import(pathTok, prefixTok, items): {
        for (i32 ii = 0; ii < items.len(); ii++) {
          string local = progText(src, lexed, items[ii].aliasTok);
          if (local == "Core") { haveCore = true; }
          if (local == "Cli") { haveCli = true; }
          if (local == "Sys") { haveSys = true; }
          if (local == "Ticket") { haveTicket = true; }
        }
      }
      default: { }
    }
  }
  // Renamed back to front, so each earlier offset is still where the source says it is.
  string out = text;
  string adapters = "";
  bool anyAsync = false;
  i32 n = 0;
  for (i32 di = prog.decls.len() - 1; di >= 0; di--) {
    match (prog.decls[di].kind) {
      Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
        string name = progText(src, lexed, nameTok);
        if (!exported || typeParams.len() > 0 || !isTestName(name)) { continue; }
        bool takesSys = params.len() == 1 && spell(src, lexed, params[0].type) == "Sys";
        if (!takesSys && !isAsync) { continue; }
        if (params.len() > 1 || (params.len() == 1 && !takesSys)) { continue; }
        string ret = spell(src, lexed, returnType);
        string impl = "__wacTest" + indexText(di);
        i32 at = tokStart(lexed, nameTok);
        i32 ex = exportBefore(src, lexed, nameTok);
        i32 len = lexed.tokens[nameTok * tokenStride() + 2];
        // `export` out and the impl's name in; blanked rather than cut, so columns hold before it.
        out = (ex >= 0 ? out.slice(0, ex) + "      " + out.slice(ex + 6, at) : out.slice(0, at))
            + impl + out.slice(at + len, out.len());
        string call = impl + "(" + (takesSys ? "__wacSys" : "") + ")";
        string bodyText = "  Sys __wacSys = Sys.__wacOf(__wacCore, __wacCli);\n";
        if (isAsync) {
          anyAsync = true;
          bodyText = bodyText + "  Ticket<" + ret + "> __wacT = " + call + ";\n"
                   + "  if (!__wacSys.__wacSettle(__wacT)) { trap \"the test's ticket never settled\"; }\n";
          call = "__wacT.value()";
        }
        bodyText = bodyText + (ret == "void" ? "  " + call + ";\n" : "  return " + call + ";\n");
        adapters = "export " + ret + " " + written(name) + "(Core __wacCore, Cli __wacCli) {\n" + bodyText + "}\n"
                 + adapters;
        n++;
      }
      default: { }
    }
  }
  if (n == 0) { return text; }
  string imports = "";
  string names = (haveCore ? "" : "Core, ") + (haveCli ? "" : "Cli, ") + (haveSys ? "" : "Sys, ");
  if (names != "") { imports = imports + "import { " + names.slice(0, names.len() - 2) + " } from \"std\";\n"; }
  if (anyAsync && !haveTicket) { imports = imports + "import { Ticket } from \"core\";\n"; }
  return out + "\n\n// wac:test — each test as the runner calls it (packages/wacc/src/program.wac).\n"
       + imports + adapters;
}

/** A name as source spells it: itself, or `@"…"` when it is a verbatim name the lexer unquoted. */
export string written(string name) {
  u8[] b = name.toBytes();
  bool plain = b.len() > 0 && !(b[0] >= '0' && b[0] <= '9');
  for (i32 i = 0; i < b.len(); i++) {
    bool ok = (b[i] >= 'a' && b[i] <= 'z') || (b[i] >= 'A' && b[i] <= 'Z') || (b[i] >= '0' && b[i] <= '9') || b[i] == '_';
    if (!ok) { plain = false; }
  }
  return plain ? name : "@\"" + name + "\"";
}

/** Whether an export's name — plain or verbatim — makes it a test: it begins with `test`. */
export bool isTestName(string name) {
  string bare = name.len() > 3 && name.slice(0, 2) == "@\"" ? name.slice(2, name.len() - 1) : name;
  return bare.len() >= 4 && bare.slice(0, 4) == "test";
}

string indexText(i32 n) {
  if (n == 0) { return "0"; }
  string out = "";
  i32 v = n;
  while (v > 0) { out = string.fromBytes(u8[].filled(1, (48 + v % 10) as@ u8)) + out; v = v / 10; }
  return out;
}

/** One exported test as its source declares it — for the aggregate a directory run builds. */
export struct DeclaredTest {
  /** As written: `test_x`, or `@"test: x"`. */
  string name;
  /** The parameter list, verbatim — `Core core, Cli cli`, or empty. */
  string params;
  /** The parameter names alone, comma-separated — what a wrapper passes on. */
  string args;
  bool isVoid;
}

/** The exported, non-generic, synchronous `test*` functions `text` declares, in order. */
export DeclaredTest[] declaredTests(string text0) {
  string text = lowerNamespacesForDeclarations(string[].filled(1, "test.wac"), string[].filled(1, text0), Res.empty())[0];
  u8[] src = text.toBytes();
  Lexed lexed = lex(src);
  P p = P.create(src, lexed);
  Program prog = parseProgram(p);
  i32 n = 0;
  for (i32 di = 0; di < prog.decls.len(); di++) {
    match (prog.decls[di].kind) {
      Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
        if (exported && typeParams.len() == 0 && !isAsync && isTestName(progText(src, lexed, nameTok))) { n++; }
      }
      default: { }
    }
  }
  DeclaredTest[] out = DeclaredTest[].filled(n, DeclaredTest("", "", "", false));
  i32 k = 0;
  for (i32 di = 0; di < prog.decls.len(); di++) {
    match (prog.decls[di].kind) {
      Func(nameTok, returnType, params, body, exported, typeParams, isAsync): {
        string name = progText(src, lexed, nameTok);
        if (!exported || typeParams.len() > 0 || isAsync || !isTestName(name)) { continue; }
        string ps = "";
        string passOn = "";
        for (i32 i = 0; i < params.len(); i++) {
          string pn = progText(src, lexed, params[i].nameTok);
          ps = ps + (i > 0 ? ", " : "") + spell(src, lexed, params[i].type) + " " + pn;
          passOn = passOn + (i > 0 ? ", " : "") + pn;
        }
        out[k] = DeclaredTest(written(name), ps, passOn, spell(src, lexed, returnType) == "void");
        k++;
      }
      default: { }
    }
  }
  return out;
}
