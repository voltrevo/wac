// Token kinds, as integers.
//
// The numbering is the declaration order of `TokenKind` in the reference lexer's
// union (`compiler/wacLex.ts`). The test harness derives the same order from
// that file at run time rather than hardcoding it, so a change to the union fails the
// differential test loudly instead of silently comparing the wrong names — which is
// exactly what happened when `enum` and `match` were added to the language and every
// kind after them shifted by two.
//
// Every one of these is a zero-argument function because wac has no module-level
// constants. A 85-variant enum therefore costs 85 declarations, which is the
// clearest measurement so far of that gap. wac now *has* enums — this file is a
// candidate for becoming one, once an enum can be used where an i32 is expected.
//
// `from` is absent as of 2026-08-02: it stopped being a keyword in the reference, so
// that `slice(a, from, to)` can name its argument, and every kind after it moved down
// by one. The differential test is what said so, exactly as the note above predicts.
//
// The keyword kinds `kImport`(5)..`kMatch`(32) are contiguous and `parse.wac` tests that
// range rather than listing them, to decide whether a token is a keyword. Keep it so:
// inserting a non-keyword into the middle of that block would silently make `atKeyword`
// wrong, and nothing else here depends on the ordering.
//
// The numbering stops mirroring the reference at 84: `kJsxText` is wac's own, because JSX is a wacc
// feature and the reference has no token for it. Everything up to `kEof`(83) is still the reference's
// order exactly, which is what the differential compares — so a kind added here goes *after* `kEof`,
// never into the middle.
//
// dead-exports: exempt — the numbering mirrors `TokenKind`'s declaration order in the reference lexer,
// so the completeness of this table is the contract rather than a convenience. Two of these have no
// caller and both should stay: `kBool` because a boolean literal lexes as the keyword `true` or `false`
// and never as a `bool` token, and `kindCount` because it states how many kinds there are — the
// reference's 84 plus wac's own. Deleting either would renumber every kind after it and silently
// misalign the differential test that derives these names from `compiler/wacLex.ts` at run time.


/** `int` */
export i32 kInt() { return 0; }

/** `float` */
export i32 kFloat() { return 1; }

/** `string` */
export i32 kString() { return 2; }

/** `bool` */
export i32 kBool() { return 3; }

/** `ident` */
export i32 kIdent() { return 4; }

/** `import` */
export i32 kImport() { return 5; }

/** `export` */
export i32 kExport() { return 6; }

/** `struct` */
export i32 kStruct() { return 7; }

/** `const` */
export i32 kConst() { return 8; }

/** `this` */
export i32 kThis() { return 9; }

/** `override` */
export i32 kOverride() { return 10; }

/** `if` */
export i32 kIf() { return 11; }

/** `else` */
export i32 kElse() { return 12; }

/** `while` */
export i32 kWhile() { return 13; }

/** `for` */
export i32 kFor() { return 14; }

/** `do` */
export i32 kDo() { return 15; }

/** `switch` */
export i32 kSwitch() { return 16; }

/** `case` */
export i32 kCase() { return 17; }

/** `default` */
export i32 kDefault() { return 18; }

/** `break` */
export i32 kBreak() { return 19; }

/** `continue` */
export i32 kContinue() { return 20; }

/** `return` */
export i32 kReturn() { return 21; }

/** `trap` */
export i32 kTrap() { return 22; }

/** `true` */
export i32 kTrue() { return 23; }

/** `false` */
export i32 kFalse() { return 24; }

/** `null` */
export i32 kNull() { return 25; }

/** `is` */
export i32 kIs() { return 26; }

/** `not` */
export i32 kNot() { return 27; }

/** `as` */
export i32 kAs() { return 28; }

/** `void` */
export i32 kVoid() { return 29; }

/** `fn` */
export i32 kFn() { return 30; }

/** `enum` */
export i32 kEnum() { return 31; }

/** `match` */
export i32 kMatch() { return 32; }

/** `as!` */
export i32 kAsBang() { return 33; }

/** `as~` */
export i32 kAsTilde() { return 34; }

/** `as@` */
export i32 kAsAt() { return 35; }

/** `+` */
export i32 kPlus() { return 36; }

/** `-` */
export i32 kMinus() { return 37; }

/** `*` */
export i32 kStar() { return 38; }

/** `/` */
export i32 kSlash() { return 39; }

/** `%` */
export i32 kPercent() { return 40; }

/** `=` */
export i32 kAssign() { return 41; }

/** `==` */
export i32 kEq() { return 42; }

/** `!=` */
export i32 kNe() { return 43; }

/** `<` */
export i32 kLt() { return 44; }

/** `<=` */
export i32 kLe() { return 45; }

/** `>` */
export i32 kGt() { return 46; }

/** `>=` */
export i32 kGe() { return 47; }

/** `&&` */
export i32 kAndAnd() { return 48; }

/** `||` */
export i32 kOrOr() { return 49; }

/** `!` */
export i32 kBang() { return 50; }

/** `&` */
export i32 kAnd() { return 51; }

/** `|` */
export i32 kOr() { return 52; }

/** `^` */
export i32 kCaret() { return 53; }

/** `~` */
export i32 kTilde() { return 54; }

/** `<<` */
export i32 kShl() { return 55; }

/** `>>` */
export i32 kShr() { return 56; }

/** `>>>` */
export i32 kShrU() { return 57; }

/** `+=` */
export i32 kPlusEq() { return 58; }

/** `-=` */
export i32 kMinusEq() { return 59; }

/** `*=` */
export i32 kStarEq() { return 60; }

/** `/=` */
export i32 kSlashEq() { return 61; }

/** `%=` */
export i32 kPercentEq() { return 62; }

/** `&=` */
export i32 kAndEq() { return 63; }

/** `|=` */
export i32 kOrEq() { return 64; }

/** `^=` */
export i32 kCaretEq() { return 65; }

/** `<<=` */
export i32 kShlEq() { return 66; }

/** `>>=` */
export i32 kShrEq() { return 67; }

/** `>>>=` */
export i32 kShrUEq() { return 68; }

/** `++` */
export i32 kInc() { return 69; }

/** `--` */
export i32 kDec() { return 70; }

/** `(` */
export i32 kLparen() { return 71; }

/** `)` */
export i32 kRparen() { return 72; }

/** `{` */
export i32 kLbrace() { return 73; }

/** `}` */
export i32 kRbrace() { return 74; }

/** `[` */
export i32 kLbrack() { return 75; }

/** `]` */
export i32 kRbrack() { return 76; }

/** `;` */
export i32 kSemi() { return 77; }

/** `:` */
export i32 kColon() { return 78; }

/** `,` */
export i32 kComma() { return 79; }

/** `.` */
export i32 kDot() { return 80; }

/** `?` */
export i32 kQuestion() { return 81; }

/** `@` */
export i32 kAt() { return 82; }

/** `eof` */
export i32 kEof() { return 83; }

// A run of text between an element's tags — **the first kind the reference does not have**, and the
// first token whose span is not wac source. Inside an element's children nothing starts a string, a
// character literal or a comment, so `it's here` is nine characters of text rather than an
// unterminated character literal that eats the closing tag. `issues/lang/0108`.
/** `jsx text` */
export i32 kJsxText() { return 84; }


/** How many kinds there are, for bounds checks and table sizing. */
export i32 kindCount() { return 85; }

/**
 * How a token kind is spelled, for a diagnostic that has to name one.
 *
 * Generated from the doc comments above rather than written a second time — each kind already
 * records its spelling next to its number, and a table that repeated them would be a table that
 * could disagree with them. The classes (`int`, `ident`, `string`) name what was wanted rather than
 * a literal, which is what the parser means when it asks for one.
 */
export string kindName(i32 kind) {
  if (kind == 0) { return "int"; }
  if (kind == 1) { return "float"; }
  if (kind == 2) { return "string"; }
  if (kind == 3) { return "bool"; }
  if (kind == 4) { return "ident"; }
  if (kind == 5) { return "import"; }
  if (kind == 6) { return "export"; }
  if (kind == 7) { return "struct"; }
  if (kind == 8) { return "const"; }
  if (kind == 9) { return "this"; }
  if (kind == 10) { return "override"; }
  if (kind == 11) { return "if"; }
  if (kind == 12) { return "else"; }
  if (kind == 13) { return "while"; }
  if (kind == 14) { return "for"; }
  if (kind == 15) { return "do"; }
  if (kind == 16) { return "switch"; }
  if (kind == 17) { return "case"; }
  if (kind == 18) { return "default"; }
  if (kind == 19) { return "break"; }
  if (kind == 20) { return "continue"; }
  if (kind == 21) { return "return"; }
  if (kind == 22) { return "trap"; }
  if (kind == 23) { return "true"; }
  if (kind == 24) { return "false"; }
  if (kind == 25) { return "null"; }
  if (kind == 26) { return "is"; }
  if (kind == 27) { return "not"; }
  if (kind == 28) { return "as"; }
  if (kind == 29) { return "void"; }
  if (kind == 30) { return "fn"; }
  if (kind == 31) { return "enum"; }
  if (kind == 32) { return "match"; }
  if (kind == 33) { return "as!"; }
  if (kind == 34) { return "as~"; }
  if (kind == 35) { return "as@"; }
  if (kind == 36) { return "+"; }
  if (kind == 37) { return "-"; }
  if (kind == 38) { return "*"; }
  if (kind == 39) { return "/"; }
  if (kind == 40) { return "%"; }
  if (kind == 41) { return "="; }
  if (kind == 42) { return "=="; }
  if (kind == 43) { return "!="; }
  if (kind == 44) { return "<"; }
  if (kind == 45) { return "<="; }
  if (kind == 46) { return ">"; }
  if (kind == 47) { return ">="; }
  if (kind == 48) { return "&&"; }
  if (kind == 49) { return "||"; }
  if (kind == 50) { return "!"; }
  if (kind == 51) { return "&"; }
  if (kind == 52) { return "|"; }
  if (kind == 53) { return "^"; }
  if (kind == 54) { return "~"; }
  if (kind == 55) { return "<<"; }
  if (kind == 56) { return ">>"; }
  if (kind == 57) { return ">>>"; }
  if (kind == 58) { return "+="; }
  if (kind == 59) { return "-="; }
  if (kind == 60) { return "*="; }
  if (kind == 61) { return "/="; }
  if (kind == 62) { return "%="; }
  if (kind == 63) { return "&="; }
  if (kind == 64) { return "|="; }
  if (kind == 65) { return "^="; }
  if (kind == 66) { return "<<="; }
  if (kind == 67) { return ">>="; }
  if (kind == 68) { return ">>>="; }
  if (kind == 69) { return "++"; }
  if (kind == 70) { return "--"; }
  if (kind == 71) { return "("; }
  if (kind == 72) { return ")"; }
  if (kind == 73) { return "{"; }
  if (kind == 74) { return "}"; }
  if (kind == 75) { return "["; }
  if (kind == 76) { return "]"; }
  if (kind == 77) { return ";"; }
  if (kind == 78) { return ":"; }
  if (kind == 79) { return ","; }
  if (kind == 80) { return "."; }
  if (kind == 81) { return "?"; }
  if (kind == 82) { return "@"; }
  if (kind == 83) { return "eof"; }
  if (kind == 84) { return "jsx text"; }
  return "something else";
}
