// What each error code says, in English.
//
// This is the first thing in the package to *consume* a code rather than count one, and writing it
// found two things immediately. The codes were not unique — four of them named two different errors
// each, which no position-comparing oracle could ever have noticed. And `report` carries a code and a
// position and nothing else, so none of these messages can say `expected i32, found f64`: the
// operands are not there to say it with. `spec/spec/errors.md` wants `annotation` and `hint` fields
// too, and those need a diagnostic that carries its operands, which is the next thing to build.
//
// So what follows is the rule that was broken, phrased as the reference phrases it where the spec
// quotes the wording, and plainly where it does not. It is deliberately the *rule* and never a guess
// at the values involved — a message that invents `expected i32` when it does not know is worse than
// one that omits it.

/**
 * The lex-phase codes — `err*` in `lex.wac`, and a third space again: 1–7, which is why the phase
 * column has to say which space a number came from.
 */
export string lexMessage(i32 code) {
  if (code == 1) { return "unexpected character"; }
  // **"literal", because three other places say so.** `spec/spec/errors.md`'s
  // `§wac-diag-lex-unterm-str-m9fk2wq` block shows `unterminated string literal`, `compiler/wacLex.ts`
  // pushes that string, and `packages/wacc/test/specCases.json` records it as the case's expected
  // message. This said "unterminated string" until 2026-08-18 and nothing caught it: the differentials
  // compare lex and parse errors by *position*, not by text.
  if (code == 2) { return "unterminated string literal"; }
  if (code == 3) { return "unknown escape"; }
  if (code == 4) { return "unterminated block comment"; }
  if (code == 5) { return "unterminated character literal"; }
  if (code == 6) { return "empty character literal"; }
  if (code == 7) { return "character literal holds more than one character"; }
  return "the lexer refused this";
}

/** The parse-phase codes, which are a separate space from the checker's — `perr*` in `parse.wac`. */
export string parseMessage(i32 code) {
  if (code == 20) { return "unexpected token"; }
  if (code == 21) { return "expected a type"; }
  if (code == 22) { return "expected an expression"; }
  if (code == 23) { return "this cannot be assigned to"; }
  if (code == 24) { return "this cannot appear at the top level of a file"; }
  if (code == 25) { return "expected a field name"; }
  if (code == 26) { return "expected a method name"; }
  if (code == 27) { return "expected a brace after the struct name"; }
  if (code == 28) { return "a function type cannot be used as an array element type"; }
  if (code == 29) { return "a module specifier must be a quoted path"; }
  return "the parser refused this";
}

/** The check-phase codes — `err*` in `check.wac`. */
/**
 * What a warning says. Separate from `checkMessage` because the two are separate channels: a code
 * that is not an error must not be reachable by asking the error table for it.
 */
export string warnMessage(i32 code) {
  if (code == 200) { return "this is never null, so the test is always false"; }
  if (code == 201) { return "these types share no ancestor, so the test is always false"; }
  if (code == 202) { return "these types share no ancestor, so this cast always traps"; }
  return "";
}

export string checkMessage(i32 code) {
  if (code == 1) { return "return type does not match the function's"; }
  if (code == 2) { return "not every path returns a value"; }
  if (code == 3) { return "initialiser does not match the declared type"; }
  if (code == 4) { return "operands have mismatched types"; }
  if (code == 5) { return "argument does not match the parameter's type"; }
  if (code == 6) { return "condition must be bool"; }
  if (code == 7) { return "these types cannot be compared"; }
  if (code == 8) { return "field does not match the declared type"; }
  if (code == 9) { return "a nullable value cannot be assigned to a non-null type"; }
  if (code == 10) { return "cannot assign to const variable"; }
  if (code == 11) { return "cannot assign to a field of a const value"; }
  if (code == 12) { return "cannot write through const reference"; }
  if (code == 13) { return "no such static method"; }
  if (code == 14) { return "no such method"; }
  if (code == 15) { return "a non-const reference cannot be taken from a const one"; }
  if (code == 16) { return "wrong cast operator for these types"; }
  if (code == 17) { return "duplicate parameter name"; }
  if (code == 18) { return "array element does not match the element type"; }
  if (code == 19) { return "wrong number of arguments to a builtin"; }
  if (code == 20) { return "argument of the wrong type to a builtin"; }
  if (code == 21) { return "this method overrides one and does not say `override`"; }
  if (code == 22) { return "this method says `override` and overrides nothing"; }
  if (code == 23) { return "increment needs an integer"; }
  if (code == 24) { return "shift needs integer operands"; }
  if (code == 25) { return "wrong number of arguments to the constructor"; }
  if (code == 26) { return "a packed type cannot be used in this position"; }
  if (code == 27) { return "a string's characters cannot be written to"; }
  if (code == 28) { return "this type has no default value"; }
  if (code == 29) { return "a struct cannot hold a non-null field of its own type"; }
  if (code == 30) { return "this cast goes down the hierarchy and must be checked"; }
  if (code == 31) { return "there is no loop here to break out of or continue"; }
  if (code == 32) { return "wrong number of arguments"; }
  if (code == 33) { return "a packed type cannot be nullable"; }
  if (code == 34) { return "a module-level const must be computable at compile time"; }
  if (code == 35) { return "undefined name"; }
  if (code == 36) { return "void cannot be used as a type here"; }
  if (code == 37) { return "a return with a value in a void function, or without one where a value is wanted"; }
  if (code == 38) { return "this operator does not take an operand of that kind"; }
  if (code == 39) { return "no such field"; }
  if (code == 40) { return "a nullable value must be unwrapped before it is used"; }
  if (code == 41) { return "an index must be an integer"; }
  if (code == 42) { return "the two branches of a ternary have unrelated types"; }
  if (code == 43) { return "this operator needs a reference"; }
  if (code == 44) { return "a switch subject must be an integer or a string"; }
  // Both halves, because the code carries both: a name the struct does not have, and a field left
  // out. The headline said only the first, so a construction missing `y` was reported as though `y`
  // were misspelled — and a component, which is a named construction with a tag for a name, said it
  // about an attribute the reader had not written at all.
  if (code == 45) { return "a named construction names each field of the struct exactly once"; }
  if (code == 46) { return "this cast is between one type and itself"; }
  if (code == 47) { return "this is not something that can be called"; }
  if (code == 48) { return "a method is not a value; call it or take it as a funcref"; }
  if (code == 49) { return "a type name is not a value"; }
  if (code == 50) { return "float literal out of range for its type"; }
  if (code == 51) { return "no variant of that name"; }
  if (code == 52) { return "unknown module"; }
  if (code == 53) { return "a generic that instantiates itself for ever"; }
  if (code == 54) { return "an enum method cannot be named after one of its variants"; }
  if (code == 55) { return "this name is already imported or declared in this file"; }
  if (code == 77) { return "no file was supplied at that path"; }
  if (code == 56) { return "that file does not export this name"; }
  if (code == 57) { return "undefined type"; }
  if (code == 58) { return "match does not cover every variant"; }
  if (code == 59) { return "duplicate case for the same variant"; }
  if (code == 60) { return "else arm is unreachable — all variants are covered"; }
  if (code == 61) { return "binding collides with the matched subject"; }
  if (code == 62) { return "match requires a non-null value"; }
  if (code == 63) { return "match arms have incompatible types"; }
  if (code == 64) { return "duplicate name at file scope"; }
  if (code == 65) { return "duplicate member in this struct"; }
  if (code == 66) { return "a character literal must hold exactly one character"; }
  if (code == 67) { return "a switch cannot have two defaults"; }
  if (code == 68) { return "this closing tag names a different element"; }
  if (code == 69) { return "this attribute is written twice"; }
  if (code == 70) { return "this tag names a struct that cannot render"; }
  if (code == 71) { return "which instantiation of this generic enum is not known here"; }
  if (code == 72) { return "match requires an enum value"; }
  if (code == 73) { return "nothing here wants a function, so this lambda has no type"; }
  if (code == 74) { return "this lambda's parameters do not match the function type wanted"; }
  if (code == 75) { return "a method with its own type parameters cannot be called yet"; }
  if (code == 76) { return "this case binds a different number of names than the variant has"; }
  return "this program was refused";
}

/**
 * The `= help:` line, where a rule has advice worth giving.
 *
 * Different in kind from the annotation: the annotation is data from the site — the values this
 * particular program used — and this is advice about the *rule*, which is the same every time it is
 * broken. So it lives here and needs nothing from the hundred-odd call sites, which is why it costs
 * a table rather than a sweep.
 *
 * Empty for most codes on purpose. A hint that restates the message is noise, and the reader has
 * already read the message.
 */
export string hintFor(i32 code) {
  if (code == 1) { return "use a cast if the conversion is meant: `as!` is checked, `as~` takes the nearest value"; }
  if (code == 2) { return "add a return at the end, or make every branch return"; }
  if (code == 3) { return "use `as!` for a checked conversion or `as~` for the nearest value"; }
  if (code == 6) { return "use a comparison, such as `x != 0`"; }
  if (code == 9) { return "unwrap it with `!` once you have checked it is not null"; }
  if (code == 10) { return "drop the `const`, or bind a separate local for the value that changes"; }
  if (code == 12) { return "take the parameter without `const` if it is meant to be written through"; }
  if (code == 16) { return "`as` converts without loss, `as!` checks at runtime, `as~` takes the nearest value"; }
  if (code == 30) { return "use `as!` — a cast down the hierarchy has to be checked"; }
  if (code == 33) { return "store the packed value in a wider type, or drop the `?`"; }
  if (code == 40) { return "unwrap it with `!`, or test it with `is null` first"; }
  if (code == 29) { return "quote it — `core` included, since D5 removed the one bare spelling"; }
  if (code == 46) { return "the cast can be removed"; }
  if (code == 50) { return "use `f64` if the value does not fit an `f32`"; }
  if (code == 55) { return "rename one of them with `as`"; }
  if (code == 77) { return "supply the file, or check the path — `core` and `std` are the only trees that need none"; }
  if (code == 56) { return "import it from the file that declares it — importing does not re-export"; }
  if (code == 57) { return "import the type, or check the spelling"; }
  if (code == 58) { return "add the missing arms, or an `else`"; }
  if (code == 60) { return "remove the `else` — every variant is already covered"; }
  if (code == 62) { return "unwrap the subject with `!`, or test it with `is null` first"; }
  // Added where the help is real. A hint that only restates the message is worse than none: it
  // costs a line of everybody's terminal and teaches nothing, and the percentage it moves is a
  // measurement of itself.
  if (code == 4) { return "cast one side, or change what the other was declared as"; }
  if (code == 13) { return "a static is called on the type — check the spelling, or call it on a value"; }
  if (code == 15) { return "take a copy, or declare the destination `const` too"; }
  if (code == 19) { return "check the builtin's parameters — they are fixed"; }
  if (code == 20) { return "check the builtin's parameters — they are fixed"; }
  if (code == 24) { return "shift a whole number by a whole number"; }
  if (code == 32) { return "check the declaration for how many it takes"; }
  if (code == 34) { return "build it from literals, or move it into a function"; }
  if (code == 38) { return "check what the operand is — the operator wants another kind"; }
  if (code == 64) { return "rename one of them"; }
  if (code == 65) { return "rename one of them"; }
  // A second round, chosen the same way: each of these says something the message does not, and the
  // ones that would only have restated it were left alone. Counted over the spec's refused corpus
  // rather than guessed at — `waccx.test.ts` reports the percentage and holds a floor under it.
  if (code == 22) { return "check the parent declares it, with the same parameters"; }
  if (code == 26) { return "a packed type is an array's element type — a variable or parameter is `i32`"; }
  if (code == 28) { return "give one: `T[n](fill: v)` — a reference has no zero to start from"; }
  if (code == 29) { return "make the field nullable with `?` — a value of it has to end somewhere"; }
  if (code == 31) { return "a `break` inside a `switch` leaves the switch, and there is no loop here"; }
  if (code == 47) { return "only a function, a funcref or a method is callable"; }
  return "";
}

/**
 * Help for a *parse* diagnostic, where there is any.
 *
 * Only two of these have anything to say. "unexpected token" is the parser's way of saying it has
 * no idea, and a hint under it would be filler — which is why the numbers this moves are smaller
 * than the count of parse diagnostics suggests they could be.
 */
export string parseHintFor(i32 code) {
  if (code == 21) { return "a type is a name like `i32`, `string`, or one this file declares"; }
  if (code == 25) { return "a field is `type name;` — the name comes after the type"; }
  return "";
}
