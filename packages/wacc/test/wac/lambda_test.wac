// Lambdas: they lex, they parse, they are typed against their target, and they run.
//
// `design/lang/0002` tier two. A lambda is hoisted into an ordinary function, so it lands inside
// `count` and the wrapper families cover it for free; the expression site emits the same
// `{funcref, env}` pair a named function reference does.
//
// **Why the wrong programs are listed by their message.** Before `checkLambda` existed, a lambda had
// no signature, so `assignable` compared against unknown — and unknown is compatible with
// everything. All five wrong programs below were *accepted*: wrong arity, wrong return type, wrong
// parameter type, an undeclared name in the body, and one assigned to an `i32`. Each now has its own
// diagnostic, and asserting which one is what stops them collapsing back into a single vague
// refusal, or into silence.
//
// ## Host-side until 2026-08-18, `issues/system/0161`
//
// The TypeScript compiled each program with `wacBind` and called `f()` on the module. A run reaches
// `main` and nothing else, so every case that asks for an *answer* gets a `main` appended that calls
// what the case names — and every expected answer here is 42 or smaller, which is the only reason
// the exit status can carry it (`issues/system/0184`: it is eight bits).
//
// The cases that only ask whether the checker objects need no module at all: `diagnoseGraph` answers
// in this process.
//
// **Not heavy either, and 7s rather than the 10s it claimed.** Same argument as `packages/box/test/
// bin.test.ts`: the lane is for what is *resident* — the files in it hold about a gigabyte each and say
// so — and sixty small programs emitted and run is seven seconds of ordinary work. Excluding it meant
// the lambda cases ran on no push at all, which is a poor trade for 3% of a suite.

import { T } from "../../../wactest/src/assert.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { joined, splitLines, contains, startsWith } from "../../../wactest/src/strings.wac";
import { Core, Cli } from "../../../platform/src/platform.wac";
import { diagnoseGraph, lambdaReportFiles } from "../../src/api.wac";
import { Corpus, loadCorpus } from "./corpus_probe.wac";
import { closureOf } from "./source_probe.wac";
import { Ran, runEmitted, runEmittedOne, scratchDir } from "./artifacts_probe.wac";

const string ENTRY = "/m.wac";

/** Every diagnostic's message, in order — field 4 of the wire. */
string[] messagesOf(string src) {
  string[] lines = splitLines(diagnoseGraph(string[](ENTRY), string[](src), ENTRY));
  string[] out = string[lines.len()](fill: "");
  for (i32 i = 0; i < lines.len(); i++) {
    i32 from = 0;
    i32 seen = 0;
    for (i32 c = 0; c <= lines[i].len(); c++) {
      if (c < lines[i].len() && lines[i].slice(c, c + 1) != "\t") { continue; }
      if (seen == 4) { out[i] = lines[i].slice(from, c); c = lines[i].len() + 1; }
      seen = seen + 1;
      from = c + 1;
    }
  }
  return out;
}

/** Run `src` with a `main` that returns `call`, and check the answer. */
void answers(T t, Cli cli, string dir, string what, string src, string call, i32 want) {
  string whole = src + "\nexport i32 main() { return " + call + "; }\n";
  Ran r = runEmittedOne(cli, ENTRY, whole, dir, "lambda.wasm");
  if (!r.ok) { t.fail(what + ": did not build — " + r.error); return; }
  // Named, because a case that *traps* rather than answering wrongly arrives as a bare runtime
  // error and says nothing about which of these produced it.
  if (r.trapped) { t.fail(what + ": trapped — " + r.stderr); return; }
  t.eqI32(r.status, want, what + ": answered " + itoa(r.status) + ", want " + itoa(want));
}

/** The same, for the common shape where `f()` is the thing to call and 42 is the answer. */
void answers42(T t, Cli cli, string dir, string what, string src) {
  answers(t, cli, dir, what, src, "f()", 42);
}

export string test_a_correct_lambda_checks_clean_in_both_body_forms_and_when_it_captures() {
  // Each of these exercises something the checker had to be taught separately. The parameters have
  // to be in scope for the body; the body's own locals have to be *collected* before it is walked,
  // which the enclosing function's pass does not do because a lambda is an expression; `return` has
  // to answer to the target's return type rather than the enclosing function's; and a lambda has to
  // be able to sit inside a lambda without the inner one's return type escaping when it finishes.
  T t = T.create();
  string[] what = string[](
    "zero-arg expression body", "one typed parameter", "block body", "two parameters",
    "a void lambda with an empty body", "capturing an enclosing local",
    "a local declared inside the body", "a lambda inside a lambda",
    "a parameter shadowing an outer local");
  string[] src = string[](
    "export i32 f() { fn[i32()] g = () => 42; return g(); }",
    "export i32 f() { fn[i32(i32)] g = (i32 a) => a + 1; return g(1); }",
    "export i32 f() { fn[i32(i32)] g = (i32 a) => { return a + 1; }; return g(1); }",
    "export i32 f() { fn[i32(i32,i32)] g = (i32 a, i32 b) => a + b; return g(1, 2); }",
    "export i32 f() { fn[void()] g = () => { }; g(); return 0; }",
    "export i32 f() { i32 n = 1; fn[i32()] g = () => n + 1; return g(); }",
    "export i32 f() { fn[i32()] g = () => { i32 x = 2; return x; }; return g(); }",
    "export i32 f() { fn[i32()] g = () => { fn[i32()] h = () => 2; return h(); }; return g(); }",
    "export i32 f() { i32 a = 5; fn[i32(i32)] g = (i32 a) => a + 1; return g(1) + a; }");
  for (i32 i = 0; i < src.len(); i++) {
    string[] ds = messagesOf(src[i]);
    t.eqI32(ds.len(), 0, what[i] + ": refused a correct lambda — " + joined(ds, "; "));
  }
  return t.report();
}

export string test_the_shapes_that_look_like_a_lambda_and_are_not() {
  // **The direction that matters for a lookahead.** `(` opens a lambda and a group, and only the
  // token after the matching `)` tells them apart — so the risk is a parenthesised expression read
  // as a parameter list. Each of these has a `(` that must stay a group; if `atLambda` said yes to
  // one, it would fail to parse rather than fail to check.
  T t = T.create();
  string[] what = string[](
    "a parenthesised expression", "a parenthesised cast, the shape issues/lang/0113 was about",
    "a struct literal in parentheses", "nested groups",
    "a call whose argument is parenthesised", "comparisons next to the arrow's characters");
  string[] src = string[](
    "export i32 f(i32 n) { return (n + 1) * 2; }",
    // `i64 cap`, so the cast is a real one: `(cap as~ i32)` where `cap` is already an `i32` is a
    // cast between a type and itself, which wac refuses on its own account.
    "export bool f(i32 n, i64 cap) { return n < 0 || n > (cap as~ i32); }",
    "struct P { i32 x; }\nexport i32 f() { return (P { x: 1 }).x; }",
    "export i32 f(i32 n) { return ((n)); }",
    "i32 g(i32 a) { return a; }\nexport i32 f(i32 n) { return g((n)); }",
    // `>=` must not lex as `=` `>`, and `==` must not become `=` `>` either.
    "export bool f(i32 a, i32 b) { return a >= b == (a > b); }");
  for (i32 i = 0; i < src.len(); i++) {
    string[] ds = messagesOf(src[i]);
    t.eqI32(ds.len(), 0, what[i] + ": refused legal code — " + joined(ds, "; "));
  }
  return t.report();
}

export string test_every_wrong_lambda_gets_its_own_diagnostic_not_a_shared_one() {
  // All five were accepted before `checkLambda`. Asserting the *message* rather than merely "some
  // error" is the point: a single catch-all refusal would satisfy a count-only test while telling
  // whoever hit it nothing, and three of these are reported by machinery wired up separately — the
  // signature comparison, the body walk, and `c.lambdaReturn`.
  T t = T.create();
  string[] what = string[]("wrong arity", "wrong parameter type", "wrong return type",
                           "undeclared name in the body", "assigned to a non-funcref");
  string[] src = string[](
    "export i32 f() { fn[i32(i32)] g = () => 42; return g(1); }",
    "export i32 f() { fn[i32(i32)] g = (f64 a) => 1; return g(1); }",
    "export i32 f() { fn[i32()] g = () => \"x\"; return g(); }",
    "export i32 f() { fn[i32()] g = () => nope; return g(); }",
    "export i32 f() { i32 g = () => 42; return g; }");
  string[] expect = string[]("parameters do not match", "parameters do not match", "return type",
                             "undefined name", "nothing here wants a function");
  for (i32 i = 0; i < src.len(); i++) {
    string[] ds = messagesOf(src[i]);
    t.isTrue(ds.len() > 0, what[i] + ": accepted a program that cannot work");
    bool found = false;
    for (i32 j = 0; j < ds.len(); j++) { if (contains(ds[j], expect[i])) { found = true; } }
    t.isTrue(found, what[i] + ": expected a message containing \"" + expect[i] + "\", got " +
                    joined(ds, "; "));
  }
  return t.report();
}

export string test_a_lambda_whose_target_is_imported_is_not_refused_for_having_no_target() {
  // **`typeNone()` is `""`, so "nothing wanted a funcref here" and "nothing could say what was
  // wanted" arrive spelled the same** — and they need opposite answers. The first is the one
  // diagnostic a lambda cannot get any other way, since unknown is assignable to everything. The
  // second happens whenever a file is checked *without its imports*, which rung 3 does to every
  // `.wac` file in the repository and requires silence for.
  T t = T.create();
  string want = "nothing here wants a function";
  string[] quietWhat = string[]("a static on an imported generic",
                                "a construction of an imported struct",
                                "a method on an imported type");
  string[] quiet = string[](
    "import { Pending } from \"./elsewhere.wac\";\n" +
    "Pending<i32> r(i32 v) { return Pending.of(0, (i32 id) => v, (i32 id) => true, (i32 id) => { }); }",
    "import { Core } from \"./elsewhere.wac\";\n" +
    "Core c(Core parent) { return Core(parent.a, (string line) => { }, parent.b); }",
    "import { Sink } from \"./elsewhere.wac\";\nvoid s(Sink k) { k.onEach((i32 n) => n + 1); }");
  for (i32 i = 0; i < quiet.len(); i++) {
    string[] ds = messagesOf(quiet[i]);
    i32 n = 0;
    for (i32 j = 0; j < ds.len(); j++) { if (contains(ds[j], want)) { n = n + 1; } }
    t.eqI32(n, 0, quietWhat[i] + ": invented a diagnostic about a program that compiles");
  }

  // And the other direction, which is what stops the fix above being "stop reporting this ever".
  // Every one of these names a slot, and the slot is not a funcref.
  string[] loudWhat = string[]("a local of the wrong type", "an argument to a function this file has",
                               "a field of a struct this file has");
  string[] loud = string[](
    "export i32 f() { i32 g = () => 42; return g; }",
    "void t(i32 n) { } export void f() { t(() => 42); }",
    "struct S { i32 v; } export S f() { return S(() => 42); }");
  for (i32 i = 0; i < loud.len(); i++) {
    string[] ds = messagesOf(loud[i]);
    i32 n = 0;
    for (i32 j = 0; j < ds.len(); j++) { if (contains(ds[j], want)) { n = n + 1; } }
    t.isTrue(n > 0, loudWhat[i] + ": accepted a lambda where the slot is not a funcref — " +
                    joined(ds, "; "));
  }
  return t.report();
}

export string test_two_lambdas_in_one_program_stay_two_functions() {
  // **The failure this whole design is arranged against.** A lambda is found by a position key
  // rather than by counting during emission, precisely so the walk and the emitter cannot disagree
  // about which is which. If they did, both of these would answer the same thing — and it would
  // compile, which is what makes the bug quiet.
  T t = T.create();
  string src = "export i32 f() {\n  fn[i32()] a = () => 1;\n  fn[i32()] b = () => 2;\n" +
               "  return a() * 10 + b();\n}\n";
  t.eqStr(diagnoseGraph(string[](ENTRY), string[](src), ENTRY), "", "the checker objected");
  return t.report();
}

export string test_a_lambda_runs_in_every_position_that_can_hold_one(Core core, Cli cli) {
  // **The answer, not the acceptance.** Everything above asserted that wacc did not object; these
  // run the module and check what it computes, which is the only thing that says the wrapper index
  // was right. A wrong one is not a compile error — it is a call to a different function.
  T t = T.create();
  string dir = scratchDir(cli);
  string[] what = string[](
    "zero arguments", "one parameter", "two parameters", "a block body with a local",
    "called more than once", "passed as an argument", "stored in a struct field",
    "one arm of a ternary", "a lambda inside a lambda", "returned from a function",
    "a module constant's initialiser", "assigned over an existing local",
    "a shadowed name around a lambda", "a float signature");
  string[] src = string[](
    "export i32 f() { fn[i32()] g = () => 42; return g(); }",
    "export i32 f() { fn[i32(i32)] g = (i32 a) => a + 1; return g(41); }",
    "export i32 f() { fn[i32(i32,i32)] g = (i32 a, i32 b) => a * b; return g(6, 7); }",
    "export i32 f() { fn[i32(i32)] g = (i32 a) => { i32 t = a * 2; return t + 2; }; return g(20); }",
    // Twice, because a wrapper that consumed something it should not would work once.
    "export i32 f() { fn[i32(i32)] g = (i32 a) => a + a; return g(10) + g(11); }",
    "i32 use(fn[i32(i32)] h) { return h(21); } export i32 f() { return use((i32 a) => a * 2); }",
    "struct H { fn[i32()] on; } export i32 f() { H h = H(() => 42); return h.on(); }",
    // Two lambdas that must stay distinct: the wrong wrapper index gives 0.
    "export i32 f() { bool p = true; fn[i32()] g = p ? () => 42 : () => 0; return g(); }",
    "export i32 f() { fn[i32()] g = () => { fn[i32()] h = () => 42; return h(); }; return g(); }",
    "fn[i32()] mk() { return () => 42; } export i32 f() { return mk()(); }",
    // **A module-level constant**, whose initialiser is emitted in `__wac_start` rather than in any
    // function body. The walk did not visit constants at all.
    "const fn[i32()] ANSWER = () => 42;\nexport i32 f() { fn[i32()] g = ANSWER; return g(); }",
    // **Assigned to a local that already exists** — the last position with no wanted type.
    "export i32 f() { fn[i32()] g = () => 1; g = () => 42; return g(); }",
    // Shadowing, which is what makes the scope a stack rather than a table.
    "export i32 f() { i32 n = 1; { i32 n2 = 2; } fn[i32(i32)] g = (i32 n) => n * 42; return g(n); }",
    // A non-i32 signature, so the hoisted function's type is not the one every other row shares.
    "export i32 f() { fn[f64(f64)] g = (f64 x) => x * 2.0; return (g(21.0) as~ i32); }");
  for (i32 i = 0; i < src.len(); i++) { answers42(t, cli, dir, what[i], src[i]); }
  return t.report();
}

export string test_a_lambda_can_be_passed_to_a_method_and_where_it_still_cannot(Core core, Cli cli) {
  // **`issues/lang/0141`.** A lambda has no type of its own, so every position holding one must say
  // what it wants — and a method call did not. Both shapes, because they resolve differently: an
  // instance method's receiver is a *value* and its type comes from the walk's scope, while a
  // static's receiver is a *type name* and is its own answer.
  T t = T.create();
  string dir = scratchDir(cli);
  answers(t, cli, dir, "a lambda to a static and to an instance method",
    "struct Box {\n  i32 v;\n  Box make(fn[i32()] g) { return Box(g()); }\n" +
    "  i32 apply(this, fn[i32(i32)] g) { return g(this.v); }\n}\n" +
    "i32 plain(fn[i32()] g) { return g(); }\n" +
    "export i32 f() {\n  i32 a = plain(() => 1);\n  Box b = Box.make(() => 2);\n" +
    "  i32 c = b.apply((i32 x) => x + 3);\n  return a + b.v + c;\n}", "f()", 8);

  // **A generic static, which the checker now types.** `Slot.of` returns the owner instantiated, so
  // the wanted type of the call *is* the instantiation and `T` can be read straight off it.
  string generic = "struct Slot<T> {\n  T v;\n" +
                   "  Slot<T> of(T seed, fn[T(i32)] make) { return Slot<T>(make(0)); }\n}\n" +
                   "export i32 f() { Slot<i32> s = Slot.of(1, (i32 k) => k + 41); return s.v; }";
  string[] ds = messagesOf(generic);
  t.eqI32(ds.len(), 0,
          "the checker no longer types a lambda to a generic static: " + joined(ds, "; "));

  // **And it runs**, with a capture through it — the shape `issues/lang/0137` needs.
  answers(t, cli, dir, "a capturing lambda through a generic static",
    "struct Slot<T> {\n  T v;\n" +
    "  Slot<T> of(T seed, fn[T(i32)] make) { return Slot<T>(make(2)); }\n}\n" +
    "export i32 f() {\n  i32 base = 40;\n  Slot<i32> s = Slot.of(0, (i32 k) => k + base);\n" +
    "  return s.v;\n}", "f()", 42);
  return t.report();
}

/** The report's lambda lines, with the `promoted:` trailer dropped. */
string[] lambdaLines(string src) {
  string[] all = splitLines(lambdaReportFiles(string[](ENTRY), string[](src + "\n"), ENTRY));
  i32 n = 0;
  for (i32 i = 0; i < all.len(); i++) { if (!startsWith(all[i], "promoted:")) { n = n + 1; } }
  string[] out = string[n](fill: "");
  i32 at = 0;
  for (i32 i = 0; i < all.len(); i++) {
    if (startsWith(all[i], "promoted:")) { continue; }
    out[at] = all[i];
    at = at + 1;
  }
  return out;
}

/** `signature|[$cap$N=]captures` → the captures, with the struct name stripped. */
string capturesOf(string line) {
  i32 bar = line.indexOf("|");
  if (bar < 0) { return ""; }
  string rest = line.slice(bar + 1, line.len());
  if (!startsWith(rest, "$cap$")) { return rest; }
  i32 eq = rest.indexOf("=");
  return eq < 0 ? rest : rest.slice(eq + 1, rest.len());
}

export string test_what_a_lambda_captures_and_what_it_does_not() {
  T t = T.create();
  string[] what = string[](
    "nothing, when it reads nothing outside", "an enclosing local",
    "an enclosing parameter, which is a local like any other", "not its own parameter",
    "not its own local", "not a function it calls", "two of them, in the order read",
    "a name it assigns to", "once, however often it is read",
    "through a nested lambda, for both of them");
  string[] src = string[](
    "export i32 f() { fn[i32()] g = () => 42; return g(); }",
    "export i32 f() { i32 n = 1; fn[i32()] g = () => n + 1; return g(); }",
    "export i32 f(i32 p) { fn[i32()] g = () => p * 2; return g(); }",
    "export i32 f() { fn[i32(i32)] g = (i32 a) => a + 1; return g(1); }",
    "export i32 f() { fn[i32()] g = () => { i32 t = 2; return t; }; return g(); }",
    "i32 h() { return 1; } export i32 f() { fn[i32()] g = () => h(); return g(); }",
    "export i32 f() { i32 a = 1; string s = \"x\"; fn[i32()] g = () => a + s.len(); return g(); }",
    "export i32 f() { i32 n = 1; fn[void()] g = () => { n = 5; }; g(); return n; }",
    "export i32 f() { i32 n = 1; fn[i32()] g = () => n + n; return g(); }",
    // **Capture is transitive, and this is the case that proves it.** The outer lambda never reads
    // `a` itself — only the lambda inside it does. It still has to carry `a`.
    "export i32 f() { i32 a = 1; fn[i32()] g = () => { i32 b = 2; fn[i32()] h = () => a + b; " +
    "return h(); }; return g(); }");
  // One expected capture set per lambda line, joined with `;` where a case has two.
  string[] want = string[]("", "n:i32", "p:i32", "", "", "", "a:i32,s:string", "n:i32", "n:i32",
                           "a:i32;a:i32,b:i32");

  for (i32 i = 0; i < src.len(); i++) {
    string[] lines = lambdaLines(src[i]);
    string[] got = string[lines.len()](fill: "");
    for (i32 j = 0; j < lines.len(); j++) { got[j] = capturesOf(lines[j]); }
    t.eqStr(joined(got, ";"), want[i], what[i] + ": captured the wrong set");

    // **A struct exactly when it is needed.** One generated for a lambda that captures nothing is a
    // type the module carries and never names; one missing where there are captures is a field read
    // that was never stored — and `NOSTRUCT` is what the probe says when the registration did not
    // happen.
    for (i32 j = 0; j < lines.len(); j++) {
      i32 bar = lines[j].indexOf("|");
      string rest = bar < 0 ? "" : lines[j].slice(bar + 1, lines[j].len());
      bool hasStruct = startsWith(rest, "$cap$");
      t.eqStr(hasStruct ? "struct" : "none", got[j] != "" ? "struct" : "none",
              what[i] + ": line " + itoa(j) + " capture struct disagrees with its captures");
      t.isFalse(contains(lines[j], "NOSTRUCT"),
                what[i] + ": the capture struct was not registered");
    }
  }
  return t.report();
}

export string test_a_lambda_that_captures_runs_and_reads_what_it_captured(Core core, Cli cli) {
  T t = T.create();
  string dir = scratchDir(cli);
  string[] what = string[](
    "one local", "two captures, in the order read", "a capture beside its own parameter",
    "called more than once", "a struct, reached through the capture", "a string",
    "escaping as an argument", "through a nested lambda");
  string[] src = string[](
    "export i32 f() { i32 n = 41; fn[i32()] g = () => n + 1; return g(); }",
    "export i32 f() { i32 a = 40; i32 b = 2; fn[i32()] g = () => a + b; return g(); }",
    // The receiver is local 0 and the parameter is local 1, so a lambda that mixed them up would
    // answer with the wrong one.
    "export i32 f() { i32 n = 40; fn[i32(i32)] g = (i32 k) => n + k; return g(2); }",
    "export i32 f() { i32 n = 21; fn[i32()] g = () => n; return g() + g(); }",
    "struct P { i32 v; } export i32 f() { P p = P(42); fn[i32()] g = () => p.v; return g(); }",
    "export i32 f() { string s = \"abcd\"; fn[i32()] g = () => s.len() * 10 + 2; return g(); }",
    "i32 use(fn[i32()] h) { return h(); } export i32 f() { i32 n = 42; return use(() => n); }",
    "export i32 f() { i32 a = 42; fn[i32()] g = () => { fn[i32()] h = () => a; return h(); }; " +
    "return g(); }");
  for (i32 i = 0; i < src.len(); i++) { answers42(t, cli, dir, what[i], src[i]); }
  return t.report();
}

export string test_capture_is_by_reference_a_write_on_either_side_is_seen(Core core, Cli cli) {
  // **The decided semantics, and the thing cells exist for.** `design/lang/0002` chose capture by
  // reference including primitives, so a captured local lives in a one-field cell that the lambda
  // and the enclosing function both hold. Every one of these answered 1 instead of 42 while capture
  // was a copy.
  T t = T.create();
  string dir = scratchDir(cli);
  string[] what = string[](
    "the lambda writes, the caller sees it", "the caller writes, the lambda sees it", "both write",
    "a counter, called repeatedly", "compound assignment inside", "increment inside",
    "two closures over one local");
  string[] src = string[](
    "export i32 f() { i32 n = 0; fn[void()] g = () => { n = 42; }; g(); return n; }",
    "export i32 f() { i32 n = 0; fn[i32()] g = () => n; n = 42; return g(); }",
    "export i32 f() { i32 n = 0; fn[void()] g = () => { n = n + 2; }; n = 40; g(); return n; }",
    "export i32 f() { i32 n = 0; fn[void()] tick = () => { n = n + 1; }; tick(); tick(); tick(); " +
    "return n * 14; }",
    "export i32 f() { i32 n = 40; fn[void()] g = () => { n += 2; }; g(); return n; }",
    // `++` is its own emission path, and it was the last one still writing to a slot that no longer
    // holds the value.
    "export i32 f() { i32 n = 41; fn[void()] g = () => { n++; }; g(); return n; }",
    // **The one that proves it is a shared cell rather than two copies that happen to agree.**
    "export i32 f() { i32 n = 0; fn[void()] inc = () => { n = n + 21; }; fn[i32()] get = () => n; " +
    "inc(); inc(); return get(); }");
  for (i32 i = 0; i < src.len(); i++) { answers42(t, cli, dir, what[i], src[i]); }
  return t.report();
}

export string test_a_captured_local_whose_type_is_an_array_or_a_nullable(Core core, Cli cli) {
  // **The cell's name used to be its type with a prefix**, so the cell for a `u8[]` was
  // `$cell$u8[]` — which every name-to-type path in the emitter reads as *array of `$cell$u8`*.
  // Invisible to every case above because `i32`, `bool`, `string` and structs have no suffix the
  // type grammar owns.
  T t = T.create();
  string dir = scratchDir(cli);
  string[] what = string[]("a byte array", "an i32 array, written through", "an array of arrays",
                           "a nullable array", "written by one lambda, read by another");
  string[] src = string[](
    "export i32 f() { u8[] b = u8[](40, 2); fn[i32()] g = () => b[0] + b[1]; return g(); }",
    "export i32 f() { i32[] a = i32[](1); fn[void()] g = () => { a[0] = 42; }; g(); return a[0]; }",
    "export i32 f() { u8[][] b = u8[][](u8[](42)); fn[i32()] g = () => b[0][0]; return g(); }",
    "export i32 f() { u8[]? b = u8[](42); fn[i32()] g = () => { if (b is null) { return 0; } " +
    "return b![0]; }; return g(); }",
    "export i32 f() { u8[] b = u8[](0); fn[void()] w = () => { b[0] = 42; }; " +
    "fn[i32()] r = () => b[0]; w(); return r(); }");
  for (i32 i = 0; i < src.len(); i++) { answers42(t, cli, dir, what[i], src[i]); }
  return t.report();
}

export string test_writing_through_a_captured_array_or_struct_from_either_side(Core core, Cli cli) {
  // **Reading a captured name and writing *through* one are different paths, and only the read was
  // right.** Half of these trapped or would not load; the other half — `s.v = 42`, `a[0] += 2`,
  // `a[0]++` — answered the old value and reported success.
  T t = T.create();
  string dir = scratchDir(cli);
  string[] what = string[](
    "array element, written inside", "array element, written outside", "array element, compound",
    "array element, increment", "struct field, written inside", "struct field, written outside",
    "struct field, compound", "a mutating method on a captured receiver",
    "an element of a captured array of arrays");
  string[] src = string[](
    "export i32 f() { i32[] a = i32[](1); fn[void()] g = () => { a[0] = 42; }; g(); return a[0]; }",
    "export i32 f() { i32[] a = i32[](1); fn[i32()] g = () => a[0]; a[0] = 42; return g(); }",
    "export i32 f() { i32[] a = i32[](40); fn[void()] g = () => { a[0] += 2; }; g(); return a[0]; }",
    "export i32 f() { i32[] a = i32[](41); fn[void()] g = () => { a[0]++; }; g(); return a[0]; }",
    "struct S { i32 v; } export i32 f() { S s = S(1); fn[void()] g = () => { s.v = 42; }; g(); " +
    "return s.v; }",
    "struct S { i32 v; } export i32 f() { S s = S(1); fn[i32()] g = () => s.v; s.v = 42; " +
    "return g(); }",
    "struct S { i32 v; } export i32 f() { S s = S(40); fn[void()] g = () => { s.v += 2; }; g(); " +
    "return s.v; }",
    // A method that mutates was the one shape that always worked — it is a *read* of the receiver.
    "struct S { i32 v; void set(this, i32 n) { this.v = n; } } export i32 f() { S s = S(1); " +
    "fn[void()] g = () => { s.set(42); }; g(); return s.v; }",
    "export i32 f() { i32[][] a = i32[][](i32[](1)); fn[void()] g = () => { a[0][0] = 42; }; g(); " +
    "return a[0][0]; }");
  for (i32 i = 0; i < src.len(); i++) { answers42(t, cli, dir, what[i], src[i]); }
  return t.report();
}

export string test_a_captured_parameter_gets_its_cell_at_entry(Core core, Cli cli) {
  // A captured *local* becomes a cell at its `Var`. A parameter has no `Var` — it arrives already in
  // its slot — so the cell is built at entry from the incoming value and bound to a new local of the
  // same name.
  T t = T.create();
  string dir = scratchDir(cli);
  string[] what = string[]("read", "written through the lambda", "beside a captured local",
                           "a method's parameter");
  string[] src = string[](
    "export i32 f(i32 q) { fn[i32()] g = () => q * 2; return g(); }",
    "export i32 f(i32 q) { fn[void()] g = () => { q = q + 21; }; g(); return q; }",
    "export i32 f(i32 q) { i32 n = 21; fn[i32()] g = () => q + n; return g(); }",
    // A method's parameter, where slot 0 is the receiver — so an entry cell built at the wrong
    // offset would capture `this` instead.
    "struct S { i32 v; i32 m(this, i32 q) { fn[i32()] g = () => q * 2; return g(); } }\n" +
    "export i32 f(i32 q) { return S(1).m(q); }");
  for (i32 i = 0; i < src.len(); i++) { answers(t, cli, dir, what[i], src[i], "f(21)", 42); }
  return t.report();
}

export string test_which_declarations_must_become_cells() {
  // **The mapping `design/lang/0002` calls the missing link.** A capture whose declaration is missing
  // from this list would be copied rather than shared.
  T t = T.create();
  string[] what = string[]("one captured local", "not the local next to it",
                           "both, when both are captured", "nothing, for a captured parameter");
  string[] src = string[](
    "export i32 f() {\n  i32 n = 41;\n  fn[i32()] g = () => n + 1;\n  return g();\n}",
    "export i32 f() {\n  i32 keep = 1;\n  i32 n = 41;\n  fn[i32()] g = () => n;\n" +
    "  return g() + keep;\n}",
    "export i32 f() {\n  i32 a = 40;\n  i32 b = 2;\n  fn[i32()] g = () => a + b;\n  return g();\n}",
    "export i32 f(i32 p) {\n  fn[i32()] g = () => p;\n  return g();\n}");
  string[] want = string[]("2:3", "3:3", "2:3 3:3", "");
  for (i32 i = 0; i < src.len(); i++) {
    string[] lines = splitLines(lambdaReportFiles(string[](ENTRY), string[](src[i] + "\n"), ENTRY));
    string last = lines.len() == 0 ? "" : lines[lines.len() - 1];
    t.isTrue(startsWith(last, "promoted:"), what[i] + ": no promotion line — " + last);
    if (!startsWith(last, "promoted:")) { continue; }
    string got = last.slice(9, last.len());
    // A leading space where there is anything to name.
    if (startsWith(got, " ")) { got = got.slice(1, got.len()); }
    t.eqStr(got, want[i], what[i] + ": promoted the wrong declarations");
  }
  return t.report();
}

export string test_a_lambda_in_a_module_that_also_imports_a_real_package(Core core, Cli cli) {
  // **The case every other test in this file misses — `issues/lang/0138`.** They compile one small
  // file. A lambda only broke once the module *also* contained the nine string builtins, because two
  // numberings disagreed about where a hoisted lambda goes: `assignGlobals` numbers every registered
  // function consecutively and the builtins are registered, while `count` included the lambdas and
  // put them first. It surfaced as functions with nothing to do with lambdas failing to validate.
  T t = T.create();
  Corpus c = loadCorpus(cli, "lambda_test");
  t.isTrue(c.ok, "the corpus loaded — " + c.error);
  if (!c.ok) { return t.report(); }

  // `Vec` brings strings and a good deal else with it; the point is a module large enough to have
  // the string builtins in it, not this particular import.
  //
  // **`itoa` is here for the closure, not for the program.** `Vec` moved into the built-in tree
  // (`design/lang/0009` D4), and a built-in is not a file the corpus holds — the compiler injects
  // it. So `closureOf`, which is a text scan over supplied keys, cannot resolve `"core/vec.wac"`
  // against anything and answers *one file*, and the guard below fires. It was right to fire: what
  // it protects is that this test compiles a program with a real package around it rather than a
  // lambda on its own, and after the move `Vec` alone no longer demonstrates that. `itoa` is an
  // ordinary file in `packages/`, so it resolves, and it is called so that nothing drops it.
  string entry = ".cache/_lambda0138.wac";
  string src = "import { Vec } from \"core/vec.wac\";\n" +
               "import { itoa } from \"../packages/fmt/src/itoa.wac\";\n" +
               "export i32 f() {\n  Vec<i32> v = Vec.create();\n  v.push(20);\n  i32 n = 1;\n" +
               "  fn[i32()] g = () => n + 21;\n  n = n + 0;\n" +
               "  return v.get(0) + g() + itoa(n).len() - 1;\n}\n" +
               "export i32 main() { return f(); }\n";
  string[] all = string[c.paths.len() + 1](fill: "");
  string[] allSrc = string[c.paths.len() + 1](fill: "");
  for (i32 i = 0; i < c.paths.len(); i++) { all[i] = c.paths[i]; allSrc[i] = c.sources[i]; }
  all[c.paths.len()] = entry;
  allSrc[c.paths.len()] = src;

  // **The closure, not the corpus — 8.2s to a fraction of it.** `runEmitted` type-checks every file it
  // is handed before emitting, so passing the whole repository to compile one program that imports
  // `Vec` checked five hundred files to answer a question about nine string builtins. This test was
  // the whole of `lambda_test.wac`'s cost: every other test in the file is 60-150ms.
  //
  // **`/`-prefixed keys**, because `resolved` answers with a leading slash — the same recipe
  // `selfhostemit_test.wac` records, and passing plain paths resolves every import to a key that is
  // not in the table, which comes back as the entry alone.
  string[] keys = string[all.len()](fill: "");
  for (i32 i = 0; i < all.len(); i++) { keys[i] = "/" + all[i]; }
  i32[] near = closureOf(keys, allSrc, all.len() - 1);
  t.isTrue(near.len() >= 2,
           "the closure is " + itoa(near.len()) + " file(s) — the `fmt` import did not resolve, so " +
           "this would be testing a lambda with no package around it");
  if (near.len() < 2) { return t.report(); }
  string[] paths = string[near.len()](fill: "");
  string[] sources = string[near.len()](fill: "");
  for (i32 i = 0; i < near.len(); i++) { paths[i] = all[near[i]]; sources[i] = allSrc[near[i]]; }

  Ran r = runEmitted(cli, paths, sources, entry, scratchDir(cli), "lambda0138.wasm", 0,
                     string[0](fill: ""));
  t.isTrue(r.ok, "it built and ran — " + r.error);
  if (!r.ok) { return t.report(); }
  t.isFalse(r.trapped, "it did not trap — " + r.stderr);
  t.eqI32(r.status, 42, "answered " + itoa(r.status) + ", want 42");
  return t.report();
}

export string test_a_captured_funcref_is_callable_and_calling_one_counts_as_reading_it(
    Core core, Cli cli) {
  // **`() => { f(42); }` over a captured `f` did nothing at all.** No trap, no invalid module, no
  // diagnostic: the lambda ran and did nothing. Tier two shipped that way because nothing called a
  // captured funcref until a continuation did — which is exactly what `Pending.then` is.
  T t = T.create();
  string dir = scratchDir(cli);
  string[] what = string[]("a captured local funcref", "a captured funcref parameter",
                           "through a captured receiver as well", "inside a generic");
  string[] src = string[](
    "export i32 f() { i32 seen = 0; fn[void(i32)] g = (i32 v) => { seen = v; }; " +
    "fn[void()] w = () => { g(42); }; w(); return seen; }",
    "void give(fn[void(i32)] g) { fn[void()] w = () => { g(42); }; w(); }\n" +
    "export i32 f() { i32 seen = 0; give((i32 v) => { seen = v; }); return seen; }",
    // The shape `then` has: a method's lambda calling the callback it was handed, through `this`.
    "struct B { i32 v; B of(i32 v) { return B(v); } " +
    "void give(const this, fn[void(i32)] g) { fn[void()] w = () => { g(this.v); }; w(); } }\n" +
    "export i32 f() { i32 seen = 0; B b = B.of(42); b.give((i32 v) => { seen = v; }); return seen; }",
    "struct B<T> { T v; B<T> of(T v) { return B(v); } " +
    "void give(const this, fn[void(T)] g) { fn[void()] w = () => { g(this.v); }; w(); } }\n" +
    "export i32 f() { i32 seen = 0; B<i32> b = B.of(42); b.give((i32 v) => { seen = v; }); " +
    "return seen; }");
  for (i32 i = 0; i < src.len(); i++) { answers42(t, cli, dir, what[i], src[i]); }
  return t.report();
}

export string test_a_lambda_captures_the_receiver_and_it_is_the_callers(Core core, Cli cli) {
  // **`this` is an ordinary local called `this`** everywhere in the emitter, and the walk was the
  // one place that made an exception of it. The module was **invalid** rather than declined, which
  // is the part worth a test.
  T t = T.create();
  string dir = scratchDir(cli);
  string[] what = string[]("reads a field", "calls a method",
                           "writes through it, and the caller sees it",
                           "two lambdas over one receiver");
  string[] src = string[](
    "struct S { i32 v; S create(i32 v) { return S(v); } " +
    "fn[i32()] reader(const this) { return () => this.v; } }\n" +
    "export i32 f() { S s = S.create(42); fn[i32()] r = s.reader(); return r(); }",
    "struct S { i32 v; S create(i32 v) { return S(v); } i32 get(const this) { return this.v; } " +
    "fn[i32()] reader(const this) { return () => this.get(); } }\n" +
    "export i32 f() { S s = S.create(42); fn[i32()] r = s.reader(); return r(); }",
    // **The receiver is shared, not copied** — the caller's object is the one that changed.
    "struct C { i32 n; C create() { return C(0); } void bump(this, i32 by) { this.n = this.n + by; } " +
    "fn[void(i32)] adder(this) { return (i32 by) => { this.bump(by); }; } }\n" +
    "export i32 f() { C c = C.create(); fn[void(i32)] add = c.adder(); add(40); add(2); return c.n; }",
    "struct C { i32 n; C create() { return C(0); } " +
    "fn[void(i32)] adder(this) { return (i32 by) => { this.n = this.n + by; }; } " +
    "fn[i32()] reader(const this) { return () => this.n; } }\n" +
    "export i32 f() { C c = C.create(); fn[void(i32)] add = c.adder(); fn[i32()] read = c.reader(); " +
    "add(42); return read(); }");
  for (i32 i = 0; i < src.len(); i++) { answers42(t, cli, dir, what[i], src[i]); }
  return t.report();
}

export string test_a_lambda_handed_to_a_funcref_rather_than_a_declared_function(Core core, Cli cli) {
  // **The walk types a lambda from the slot it is going into**, and it knew three sources: a
  // declared function's parameter, a method's parameter, a struct field. Not a *funcref*. A named
  // function argument was fine, which is what kept it hidden.
  T t = T.create();
  string dir = scratchDir(cli);
  string[] what = string[]("a local funcref", "two arguments, one a lambda", "a funcref field",
                           "a funcref a method handed back");
  string[] src = string[](
    "export i32 f() { i32 seen = 0; fn[void(fn[void(i32)])] run = (fn[void(i32)] h) => { h(42); }; " +
    "run((i32 n) => { seen = n; }); return seen; }",
    "export i32 f() { i32 seen = 0; fn[void(i32, fn[void(i32)])] reg = " +
    "(i32 id, fn[void(i32)] h) => { h(id); }; reg(42, (i32 n) => { seen = n; }); return seen; }",
    // The shape every capability in this repository has: a funcref in a struct field.
    "struct Caps { fn[void(fn[void(i32)])] each; }\n" +
    "export i32 f() { i32 seen = 0; Caps c = Caps((fn[void(i32)] h) => { h(42); }); " +
    "c.each((i32 n) => { seen = n; }); return seen; }",
    "struct S { i32 v; S create() { return S(0); } " +
    "fn[void(i32, fn[void(i32)])] link(const this) { return (i32 id, fn[void(i32)] h) => { h(id); }; } }\n" +
    "export i32 f() { S s = S.create(); i32 seen = 0; fn[void(i32, fn[void(i32)])] reg = s.link(); " +
    "reg(42, (i32 n) => { seen = n; }); return seen; }");
  for (i32 i = 0; i < src.len(); i++) { answers42(t, cli, dir, what[i], src[i]); }
  return t.report();
}

export string test_a_lambda_inside_a_generic_once_per_instantiation(Core core, Cli cli) {
  // **A generic is emitted once per instantiation** — `issues/lang/0142` — so a lambda written in
  // one is not one hoisted function but N. The walk keyed lambdas by line and column, which name one
  // expression per *template*.
  T t = T.create();
  string dir = scratchDir(cli);
  string[] what = string[]("the reproduction", "two instantiations", "capture inside a generic",
                           "capture typed by the parameter",
                           "a generic called only from inside a lambda",
                           "a generic struct's method");
  string[] call = string[]("f()", "two()", "caps()", "byType()", "onlyInside()", "methods()");
  string[] src = string[](
    "T pick<T>(T a, T b) { fn[bool()] first = () => true; return first() ? a : b; }\n" +
    "export i32 f() { return pick(42, 0); }",
    // Two instantiations of one generic: the case a position key cannot tell apart.
    "T pick<T>(T a, T b) { fn[bool()] first = () => true; return first() ? a : b; }\n" +
    "export i32 two() { i32 a = pick(40, 0); i64 b = pick(2 as i64, 0 as i64); " +
    "return a + (b as~ i32); }",
    "i32 addBase<T>(T v, i32 base) { fn[i32()] get = () => base; return get(); }\n" +
    "export i32 caps() { i32 base = 42; return addBase(1, base); }",
    "T held<T>(T v) { fn[T()] get = () => v; return get(); }\n" +
    "export i32 byType() { i32 a = held(40); string b = held(\"xx\"); return a + b.len(); }",
    // **A generic called only from inside a lambda**, discovered by a walk that had no `Lambda` arm.
    "T id<T>(T v) { return v; }\n" +
    "export i32 onlyInside() { fn[i32()] get = () => id(42); return get(); }",
    "struct Cell<T> {\n  T v;\n  Cell<T> of(T v) { return Cell(v); }\n" +
    "  T get(const this) { fn[bool()] yes = () => true; return yes() ? this.v : this.v; }\n}\n" +
    "export i32 methods() { Cell<i32> a = Cell.of(40); Cell<i64> b = Cell.of(2 as i64); " +
    "return a.get() + (b.get() as~ i32); }");
  for (i32 i = 0; i < src.len(); i++) { answers(t, cli, dir, what[i], src[i], call[i], 42); }
  return t.report();
}

export string test_a_method_may_declare_its_own_type_parameters_and_a_call_says_what_is_missing(
    Core core, Cli cli) {
  // **The syntax parses; the call does not work yet.** `Pending<U> then<U>(fn[U(T)] f)` is the shape
  // the promise API wants for chaining, and `map<U>(…)` used to answer `unexpected token` at the `<`.
  // What is missing is inference and monomorphisation, so a *call* is refused and the refusal names
  // the feature.
  T t = T.create();
  string dir = scratchDir(cli);
  string decl = "struct Box<T> {\n  T v;\n  Box<T> of(T v) { return Box(v); }\n" +
                "  Box<U> map<U>(const this, fn[U(T)] f) { return Box.of(f(this.v)); }\n}\n";

  // Declaring one is harmless: nothing is emitted for a method nobody calls, so the module loads.
  answers(t, cli, dir, "declaring a generic method changes no unrelated answer",
          decl + "export i32 f() { Box<i32> a = Box.of(21); return a.v * 2; }", "f()", 42);

  // Calling one is refused, by name.
  string call = decl + "export i32 f() { Box<i32> a = Box.of(21); " +
                "Box<string> b = a.map((i32 n) => \"xx\"); return b.v.len(); }\n";
  string[] ds = messagesOf(call);
  bool named = false;
  for (i32 i = 0; i < ds.len(); i++) { if (contains(ds[i], "its own type parameters")) { named = true; } }
  t.isTrue(ds.len() > 0,
           "a generic method can be called now — good news, and this test is what needs updating");
  t.isTrue(named, "the refusal does not name the feature: " + joined(ds, "; "));
  return t.report();
}

export string test_a_generic_taking_a_funcref_parameter_is_still_declined(Core core, Cli cli) {
  // **Not part of `issues/lang/0142` and not fixed by it.** `T twice<T>(T v, fn[T(T)] f)` has no
  // lambda in it at all — the funcref arrives as a parameter. Pinned here so the two are not
  // confused: a lambda *inside* a generic works now, a funcref *parameter* of one does not.
  T t = T.create();
  string src = "T twice<T>(T v, fn[T(T)] f) { return f(f(v)); }\n" +
               "export i32 viaParam() { fn[i32(i32)] inc = (i32 n) => n + 21; return twice(0, inc); }\n";
  Ran r = runEmittedOne(cli, ENTRY, src + "export i32 main() { return viaParam(); }\n",
                        scratchDir(cli), "genfnparam.wasm");
  t.isFalse(r.ok && !r.trapped && r.status == 42,
            "a generic with a funcref parameter works now — good news, and this test is what " +
            "needs updating");
  return t.report();
}
