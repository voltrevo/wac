// Rung 3: what we say about a program, and what we must not say.
//
// `src/check.wac` decides a subset of what a full checker decides, so this slice has two
// obligations and they are not the same one: what a rule owns must be **caught**, and what it does
// not own must be **silent** — where "this program is wrong and we say nothing" is a pass. That is
// what being a subset means, and it is why every test here carries two lists rather than one.
//
// ## It had a second opinion until 2026-08-28
//
// The lists were always written by hand, but the TypeScript reference cross-checked them: it was
// asked `checkpos` for each program in the *caught* list and answered `line:col` per diagnostic, so
// `assertSound` could require every position we reported to be one it reported, and `assertComplete`
// could require the reverse where a slice claims completeness. The *quiet* list never consulted it
// — that is a claim about us alone, and asking would have invited the merge the split prevents.
//
// The reference is deleted. What is gone is the **position**: a diagnostic that drifts to the wrong
// line, or one we report where nothing is wrong but the program is rejected for another reason,
// now passes. What is kept is the corpus and the caught/quiet split, which was the load-bearing
// part. See `bootstrap/MIGRATION.md`.
//
// Positions are still what `ours` produces, because the messages are numeric codes and a position
// is what a reader needs to find the complaint.

import { T } from "../../../wactest/src/assert.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { checkCodeMessage, dumpTypeErrors } from "../../src/api.wac";


/**
 * One complaint, as `line:col code — the checker's own sentence`.
 *
 * **Because the number alone was read in the wrong code space.** `dumpTypeErrors` answers
 * `(code, line, col)` triples and every one of them is a *checker* code; the parser has its own space
 * starting at the same numbers, and 20 is `errBuiltinArg` here and `perrExpected` there. A complaint
 * printed as `95:48` sent a reader to `parse.wac`, and `issues/lang/0149` is the day that cost —
 * filed as "a parse error from a file that compiles" about a false alarm on
 * `string.fromBytes(bytes)`.
 */
export string complaint(string path, i32 code, i32 line, i32 col) {
  return path + ": " + itoa(line) + ":" + itoa(col) + " code " + itoa(code) + " — " +
         checkCodeMessage(code);
}

/** Ours, as `line:col` strings. `(code, line, col)` triples in, positions out. */
export string[] ours(string src) {
  i32[] flat = dumpTypeErrors(src.toBytes());
  i32 n = flat.len() / 3;
  string[] out = string[n](fill: "");
  for (i32 i = 0; i < n; i++) {
    out[i] = itoa(flat[i * 3 + 1]) + ":" + itoa(flat[i * 3 + 2]);
  }
  return out;
}

/**
 * Ours, minus `errMissingImportFile` (77), and how many of those there were.
 *
 * For a test whose program imports a file it deliberately does not supply. Since
 * `issues/lang/0157` the single-file checker refuses such an import — correctly, and the reference
 * says the same — so a test about what else the checker says has to set that one aside. Not folded
 * into `ours`, which is also used to count what a rejection program *caught*: dropping a code there
 * would quietly lower recall.
 *
 * `countOut[0]` is how many were dropped, so a caller can assert the rule is still firing. A filter
 * that hides a diagnostic looks exactly like a checker that stopped producing it.
 */
export string[] oursBesidesMissingImports(string src, i32[] countOut) {
  i32[] flat = dumpTypeErrors(src.toBytes());
  i32 n = flat.len() / 3;
  string[] out = string[n](fill: "");
  i32 kept = 0;
  countOut[0] = 0;
  for (i32 i = 0; i < n; i++) {
    if (flat[i * 3] == 77) { countOut[0] = countOut[0] + 1; continue; }
    out[kept] = itoa(flat[i * 3 + 1]) + ":" + itoa(flat[i * 3 + 2]);
    kept = kept + 1;
  }
  string[] trimmed = string[kept](fill: "");
  for (i32 i = 0; i < kept; i++) { trimmed[i] = out[i]; }
  return trimmed;
}

/** Ours, joined — for a message that has to show what we said. */
export string oursJoined(string src) { return joinedWith(ours(src), ", "); }

export string joinedWith(string[] all, string sep) {
  string out = "";
  for (i32 i = 0; i < all.len(); i++) { out = i == 0 ? all[i] : out + sep + all[i]; }
  return out;
}

/**
 * Silent: this program is not this rule's to report, and we invent nothing for it.
 *
 * **A claim about us alone**, which is why it never consulted the reference even when there was
 * one — consulting it here would invite the merge the two-list split exists to prevent.
 */
export void assertQuiet(T t, string src, string what) {
  string[] mine = ours(src);
  t.eqI32(mine.len(), 0, what + ": we invented " + itoa(mine.len()) + " diagnostic(s) at " +
                         joinedWith(mine, ", ") + " in " + src);
}

/**
 * Not silent: this program is wrong in a way this rule owns, and we say so.
 *
 * **The position is no longer checked**, and was until 2026-08-28. The reference answered
 * `checkpos` for each program and `assertSound` required every position we reported to be one it
 * reported; `assertComplete` required the reverse for the slices that claim completeness. Both are
 * gone with it, and what is left is that we report *something*. A diagnostic that drifts to the
 * wrong line now passes here. See `bootstrap/MIGRATION.md`.
 */
export void assertCaught(T t, string src, string what) {
  t.isTrue(ours(src).len() > 0, what + ": this program is wrong and we said nothing — " + src);
}

/**
 * The shape most of rung 3's tests have: a list this rule owns, and a list it does not.
 *
 * **Two lists rather than one filtered on the message.** A subset checker has two obligations and
 * they are not the same one: what the rule owns must be caught, and what it does not own must be
 * silent — where "this program is wrong and we say nothing" is a *pass*. Splitting them was forced.
 * A single list saying "this is wrong, so we must report" folds both together and makes `i32 ==
 * string` a failure for being correctly quiet.
 *
 * The lists were always written by hand; the reference cross-checked the first one's positions and
 * never saw the second. So the split survives the reference and only the positions are gone.
 */
export void caughtAndQuiet(T t, string[] caught, string[] quiet, string what) {
  for (i32 i = 0; i < caught.len(); i++) { assertCaught(t, caught[i], what); }
  for (i32 i = 0; i < quiet.len(); i++) {
    string[] mine = ours(quiet[i]);
    t.eqI32(mine.len(), 0,
            quiet[i] + " is not this rule's to report, and we said " + joinedWith(mine, ", "));
  }
}
