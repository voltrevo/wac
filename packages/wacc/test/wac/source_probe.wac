// Reading and writing wac source, for the tests that generate a program.
//
// Two jobs that kept being written again: working out what a file imports, and turning a file's text
// back into a wac string literal so a generated driver can carry it.
//
// **The closure is scanned for, not parsed.** It only has to be a superset of what the compiler
// needs — a name it cannot resolve is one the compiler reports on anyway — and a scan does not
// depend on the parser under test.

import { Buf } from "../../../bytes/src/buf.wac";

/** The most files one entry's import closure is expected to reach. */
const i32 CLOSURE_CAP = 512;

/** `/a/b/c.wac` → `/a/b`. */
export string dirOf(string path) {
  for (i32 i = path.len() - 1; i >= 0; i--) {
    if (path.slice(i, i + 1) == "/") { return path.slice(0, i); }
  }
  return "";
}

/** `/a/b` + `../c.wac` → `/a/c.wac`. A `..` that climbs past the root is dropped, as it is in JS. */
export string resolved(string dir, string rel) {
  string joinedPath = dir + "/" + rel;
  string[] parts = string[64](fill: "");
  i32 n = 0;
  i32 from = 0;
  for (i32 i = 0; i <= joinedPath.len(); i++) {
    if (i < joinedPath.len() && joinedPath.slice(i, i + 1) != "/") { continue; }
    string part = joinedPath.slice(from, i);
    from = i + 1;
    if (part == "" || part == ".") { continue; }
    if (part == "..") { if (n > 0) { n = n - 1; } continue; }
    if (n >= parts.len()) { return ""; }
    parts[n] = part;
    n = n + 1;
  }
  string out = "";
  for (i32 i = 0; i < n; i++) { out = out + "/" + parts[i]; }
  return out;
}

/** Where `path` sits in `paths`, or -1. */
export i32 indexOfPath(string[] paths, string path) {
  for (i32 i = 0; i < paths.len(); i++) {
    if (paths[i] == path) { return i; }
  }
  return -1;
}

/**
 * `entry` and everything it imports, transitively.
 *
 * By scanning for `from "…"` rather than by parsing, which is what the TypeScript did: the closure
 * only has to be a superset of what the checker needs, and a name it cannot resolve is one the
 * checker will report on anyway.
 *
 * **`keys` must be `/`-prefixed**, because `resolved` above rebuilds every path as `/a/b/c.wac`: hand
 * this `packages/abi/src/abi.wac` and no import will ever match, so every answer is the entry alone.
 * It fails as a *short closure* rather than as an error, and the caller then sees the compiler say
 * "an import of a file that was not supplied" about a file it thought it had supplied. Callers pass
 * `"/" + path`; `coverage_test.wac` did not, and its `>= 20` assertion is what noticed.
 *
 * **A built-in is not in it, and that is right.** `"core/option.wac"` names a module inside the
 * compiler (`design/lang/0009` D4), so it resolves against nothing here and is skipped — and the
 * compiler injects it, so the closure being without it is correct rather than short. What is *not*
 * safe is treating the size of the answer as "how many packages this program pulls in": a caller
 * that asserts a count is asserting how many *supplied files* it reached, and an import that moved
 * into the tree lowers it without the program getting any smaller. `lambda_test.wac` was written
 * that way and its guard fired when `Vec` moved, which is the guard doing its job.
 */
export i32[] closureOf(string[] keys, string[] sources, i32 entry) {
  i32[] found = i32[CLOSURE_CAP]();
  i32 n = 0;
  i32[] queue = i32[CLOSURE_CAP]();
  i32 head = 0;
  i32 tail = 0;
  queue[tail] = entry;
  tail = tail + 1;

  while (head < tail) {
    i32 at = queue[head];
    head = head + 1;
    bool seen = false;
    for (i32 i = 0; i < n; i++) { if (found[i] == at) { seen = true; } }
    if (seen) { continue; }
    if (n >= CLOSURE_CAP) { break; }
    found[n] = at;
    n = n + 1;

    string src = sources[at];
    string dir = dirOf(keys[at]);
    i32 i = 0;
    while (i + 6 < src.len()) {
      if (src.slice(i, i + 6) != "from \"") { i = i + 1; continue; }
      i32 close = i + 6;
      while (close < src.len() && src.slice(close, close + 1) != "\"") { close = close + 1; }
      string rel = src.slice(i + 6, close);
      i = close + 1;
      i32 next = indexOfPath(keys, resolved(dir, rel));
      if (next < 0 || tail >= CLOSURE_CAP) { continue; }
      queue[tail] = next;
      tail = tail + 1;
    }
  }
  i32[] out = i32[n]();
  for (i32 i = 0; i < n; i++) { out[i] = found[i]; }
  return out;
}


/**
 * A wac string literal for a chunk of text, escaping the four escapes this emitter knows.
 *
 * Through a `Buf`: this is handed tens of kilobytes and `out = out + c` in a loop is quadratic.
 */
export string literalOf(string text) {
  u8[] b = text.toBytes();
  Buf out = Buf.withCapacity(b.len() + 16);
  out.push('"');
  for (i32 i = 0; i < b.len(); i++) {
    i32 c = b[i];
    if (c == '\\') { out.push('\\'); out.push('\\'); }
    else if (c == '"') { out.push('\\'); out.push('"'); }
    else if (c == '\n') { out.push('\\'); out.push('n'); }
    else if (c == '\t') { out.push('\\'); out.push('t'); }
    else { out.push(c); }
  }
  out.push('"');
  return string.fromBytes(out.take());
}


/**
 * `text` as one or more wac string literals, joined by `+`.
 *
 * Chunked at 3,000 bytes because a literal is one `array.new_fixed` and an engine caps how many
 * elements that may have, while concatenation has no such limit.
 *
 * **The boundary backs off a continuation byte**, so a multi-byte character is never split between
 * two literals. Without that, a chunk could end mid-character and the two halves are each invalid
 * UTF-8 — which the two compilers do not agree about. wacc keeps the bytes; the reference decodes
 * through JavaScript and each stray byte comes back as U+FFFD, so three bytes become nine and the
 * embedded text grows by six. `fixpointemit_test.wac` then reports that the stages *emit* different
 * bytes, naming a compiler source file, when the emitters agree exactly and it is this line that
 * differs.
 *
 * That made the test a lottery rather than a check. Any edit anywhere in `ast.wac` or `kinds.wac`
 * shifts every later byte, so whether a boundary lands inside one of the box-drawing and em-dash
 * characters in their prose is decided by the size of an unrelated change. It came up on
 * `issues/lang/0088`, where adding one enum variant moved the 9,000 boundary one byte into a `─` and
 * cost an afternoon aimed at the variant.
 */
export string chunkedLiteral(string text) {
  u8[] raw = text.toBytes();
  Buf out = Buf.create();
  i32 at = 0;
  bool first = true;
  while (at < raw.len()) {
    i32 to = at + 3000 < raw.len() ? at + 3000 : raw.len();
    // A continuation byte is 10xxxxxx, so walk back to the lead byte and let the whole character
    // start the next chunk. At most three steps, and `to > at` keeps the loop advancing.
    while (to < raw.len() && to > at && (raw[to] & 192) == 128) { to = to - 1; }
    if (!first) { out.pushAll(" +\n    ".toBytes()); }
    out.pushAll(literalOf(text.slice(at, to)).toBytes());
    first = false;
    at = to;
  }
  if (first) { out.pushAll("\"\"".toBytes()); }   // an empty file is still a literal
  return string.fromBytes(out.take());
}
