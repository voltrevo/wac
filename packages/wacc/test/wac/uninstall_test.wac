// `wac uninstall` removes what an install wrote, and nothing else.
//
// `[§wac-cli-uninstall-7kq3mvp]`
//
// **There is one uninstaller now, and this file used to exist because there were two.** Until
// 2026-08-26 the layout was written down twice — TypeScript in `tools/install.ts` behind a
// `wac:uninstall` task, and the command itself — so the fourth case here was a differential: two
// identical fake installs, one taken away with each, compared entry for entry. It found a real bug
// once, an `~/.wac/env` surviving and erroring on every login.
//
// The operator retired the task rather than the differential, which removes the reason for both.
// `design/lang/0009` D1 wanted the subcommand precisely because a Deno program under `tools/` needs
// the checkout that somebody who *installed* the command does not have — so the task was the copy
// that could not be used, and keeping a test to prove the unusable copy still agreed would have made
// it an oracle. That is the arrangement CLAUDE.md names in as many words.
//
// What is left asks what the command does rather than who it matches, and `survivors` is where the
// list lives: the three files an install writes, the cache under `--keep-cache` and without it, and
// two files it must never touch.
//
// Nothing here installs anything real: `install()` shells out to a release `cargo build`, which is a
// minute of work already covered by `tools/seedFresh.test.ts`. What is worth checking is the file
// arrangement, which is milliseconds — the same argument `tools/install.test.ts` makes, and the same
// fake install, so that a change to the layout has one more place to be made rather than a place
// nobody finds.

import { T } from "../../../wactest/src/assert.wac";
import { binaryPath, freshDir, madeDir, scratch } from "../../../wactest/src/host.wac";
import { onlyEnv } from "../../../wactest/src/childenv.wac";
import { joined } from "../../../wactest/src/strings.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { Change, Cli, Core, Exec, FileResult } from "std/platform.wac";

/** `$WAC_HOME` as `tools/install.test.ts`'s `fakeInstall` leaves it, plus a profile that sources it. */
string fakeInstall(Cli cli, T t, string dir) {
  string home = dir + "/.wac";
  string whyDir1 = madeDir(cli, home + "/bin");
  t.isTrue(whyDir1 == "", whyDir1);
  string whyDir2 = madeDir(cli, home + "/cache/git");
  t.isTrue(whyDir2 == "", whyDir2);
  cli.writeFile(home + "/bin/wac", "#!/bin/sh\n".toBytes()).wait();
  cli.writeFile(home + "/env", "# env\n".toBytes()).wait();
  cli.writeFile(home + "/install.json5", "{}\n".toBytes()).wait();
  cli.writeFile(home + "/cache/git/keepme", "a fetched pack\n".toBytes()).wait();
  // The things D1 says an uninstall must never touch, put where it is working.
  cli.writeFile(home + "/wac.json5", "{}\n".toBytes()).wait();
  cli.writeFile(home + "/notes.txt", "mine\n".toBytes()).wait();
  Change p = cli.writeFile(
      dir + "/.bashrc",
      ("export PS1='$ '\n. \"" + home + "/env\"    # wac\nalias l=ls\n").toBytes()).wait();
  t.isTrue(p.ok(), "could not write the fixture profile — " + p.message);
  return home;
}

/** Whether a path is there at all — a file or a directory, since both are removed here. */
bool present(Cli cli, string path) {
  return cli.stat(path).wait().exists;
}

/** Every difference between what survived and what should have. */
string[] survivors(Cli cli, string home, bool cacheKept) {
  string[] wrong = string[8](fill: "");
  i32 n = 0;
  string[] ours = string[]("bin/wac", "env", "install.json5");
  for (i32 i = 0; i < ours.len(); i++) {
    if (present(cli, home + "/" + ours[i])) { wrong[n] = ours[i] + " survived"; n = n + 1; }
  }
  bool cache = present(cli, home + "/cache/git/keepme");
  if (cache != cacheKept) {
    wrong[n] = cacheKept ? "--keep-cache was given and the cache went anyway" : "the cache survived";
    n = n + 1;
  }
  string[] theirs = string[]("wac.json5", "notes.txt");
  for (i32 i = 0; i < theirs.len(); i++) {
    if (!present(cli, home + "/" + theirs[i])) {
      wrong[n] = theirs[i] + " was removed and is not ours"; n = n + 1;
    }
  }
  string[] out = string[n](fill: "");
  for (i32 i = 0; i < n; i++) { out[i] = wrong[i]; }
  return out;
}

/** "" when the profile has our line gone and everything else kept, or what went wrong. */
string profileState(Cli cli, string dir) {
  FileResult f = cli.readFile(dir + "/.bashrc").wait();
  if (!f.ok) { return "the profile itself was removed"; }
  string text = string.fromBytes(f.bytes);
  if (text.indexOf("# wac") >= 0) { return "the marked line survived"; }
  if (text.indexOf("alias l=ls") < 0) { return "somebody else's line went with it"; }
  return "";
}

/** A fresh fixture under `root`, returning its `$WAC_HOME`. */
string fixture(Cli cli, T t, string dir) {
  cli.remove(dir, true).wait();
  Change made = cli.mkdir(dir, true).wait();
  t.isTrue(made.ok(), "could not make " + dir + " — " + made.message);
  return fakeInstall(cli, t, dir);
}

export string test_the_subcommand_removes_what_an_install_wrote(Core core, Cli cli) {
  T t = T.create();
  string dir = scratch(cli, "uninstall-bin");
  string home = fixture(cli, t, dir);

  Exec r = onlyEnv(cli, string[]("WAC_HOME", "HOME"), string[](home, dir),
                   binaryPath(cli), string[]("uninstall"));
  t.isTrue(r.ran(), "the command did not run — " + r.error);
  if (!r.ran()) { return t.report(); }
  t.eqI32(r.status, 0, "wac uninstall failed: " + string.fromBytes(r.stderr));

  string[] wrong = survivors(cli, home, false);
  t.eqI32(wrong.len(), 0, joined(wrong, "; "));
  t.eqStr(profileState(cli, dir), "", "the profile line");
  // It has to say what it left behind, or a person cannot tell "removed" from "found nothing".
  t.isTrue(string.fromBytes(r.stdout).indexOf("other entr") >= 0,
           "it did not say what it left in place: " + string.fromBytes(r.stdout));
  cli.remove(dir, true).wait();
  return t.report();
}

export string test_keep_cache_keeps_the_cache_and_nothing_else(Core core, Cli cli) {
  T t = T.create();
  string dir = scratch(cli, "uninstall-keep");
  string home = fixture(cli, t, dir);

  Exec r = onlyEnv(cli, string[]("WAC_HOME", "HOME"), string[](home, dir),
                   binaryPath(cli), string[]("uninstall", "--keep-cache"));
  t.isTrue(r.ran() && r.status == 0,
           "wac uninstall --keep-cache failed: " + string.fromBytes(r.stderr));
  string[] wrong = survivors(cli, home, true);
  t.eqI32(wrong.len(), 0, joined(wrong, "; "));
  cli.remove(dir, true).wait();
  return t.report();
}

export string test_removing_nothing_says_so_rather_than_failing(Core core, Cli cli) {
  // Running it twice is ordinary — it is what somebody does when they are not sure whether the
  // first one worked — so the second must not be an error, and must not read like one either.
  T t = T.create();
  string dir = scratch(cli, "uninstall-twice");
  string whyDir = freshDir(cli, dir);
  t.isTrue(whyDir == "", whyDir);
  Exec r = onlyEnv(cli, string[]("WAC_HOME", "HOME"), string[](dir + "/.wac", dir),
                   binaryPath(cli), string[]("uninstall"));
  t.isTrue(r.ran(), "the command did not run — " + r.error);
  if (!r.ran()) { return t.report(); }
  t.eqI32(r.status, 0, "uninstalling nothing was an error: " + string.fromBytes(r.stderr));
  t.isTrue(string.fromBytes(r.stdout).indexOf("nothing to remove") >= 0,
           "it did not say there was nothing: " + string.fromBytes(r.stdout));
  cli.remove(dir, true).wait();
  return t.report();
}
