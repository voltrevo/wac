// An import naming a file nobody supplied is refused by the checker, at the import.
//
//     wac test --allow-read packages/wacc/test/wac/missingimport_test.wac
//
// It was caught one phase later, by the linker, through a sentinel: `blockedFiles` answered *"an
// import of a file that was not supplied"* with **no position and no file name**, inferred from
// `emit.wac`'s `linkFailure` reading `starts[0] == 1`. Every checker entry point — including the
// files-based one, which has the whole map — reported nothing, so a caller that asked the checker was
// told the program was fine. The reference refuses it: `file not found in programs map: 'b.wac'`.
// `issues/lang/0157`.
//
// The controls are the point. A rule that refuses an unresolvable import must not touch the two trees
// that resolve without a file on disk — `core` and `std` ship inside the compiler — nor a relative
// import the caller did supply. `isBuiltinSpec` is the existing predicate for the first, which is why
// this rule needed no new notion of what a built-in is.

import { T } from "../../../wactest/src/assert.wac";
import { dumpTypeErrors, dumpTypeErrorsFiles, blockedFiles } from "../../src/api.wac";
import { itoa } from "../../../fmt/src/itoa.wac";

/** The code of the first diagnostic, or -1 — a row is `code, line, col`. */
i32 firstCode(i32[] out) { return out.len() >= 3 ? out[0] : -1; }

i32 nOf(i32[] out) { return out.len() / 3; }

export string test_an_import_of_a_file_nobody_supplied_is_refused_when_checked_alone() {
  T t = T.create();
  string main = "import { foo } from \"./b.wac\";\nexport i32 f() { return foo(); }\n";
  i32[] single = dumpTypeErrors(main.toBytes());
  t.isTrue(nOf(single) > 0, "single-source: " + itoa(nOf(single)) + " diagnostics");
  // **The files-based entry point is still silent, and the second half of `issues/lang/0157` is still
  // open — but no longer for the reason the issue gave.** `issues/lang/0175a` threaded the `Res`, so
  // the resolution here *is* the linker's own now, and the obvious rule — resolve, then refuse a
  // specifier whose key no supplied file has — was written, tested, and reverted the same day.
  //
  // It false-alarms, and on the cases the issue named: `mappedspec_test.wac` lost
  // `a_mapped_subdir_cannot_import_outside_itself` and `projectspec_test.wac` lost two, with
  // *"no file was supplied at that path"* about imports that are fine. A plain `./a.wac` **inside** a
  // mapped checkout has no entry in the mapping table — the table is keyed by importer and specifier,
  // and the reader only recorded the mapping that got it there — so it resolves by path arithmetic to
  // a key the graph does not hold. Membership in `paths` is therefore not a sound test for "nobody
  // supplied this", and that is a design question rather than a missing line.
  i32[] files = dumpTypeErrorsFiles(string[]("/main.wac"), string[](main), "/main.wac");
  t.eqI32(nOf(files), 0, "the files-based entry point now reports this — if that is deliberate, read " +
                         "issues/lang/0157 first: the same change refused three correct programs");
  return t.report();
}

export string test_a_supplied_relative_import_is_accepted() {
  T t = T.create();
  i32[] out = dumpTypeErrorsFiles(
    string[]("/main.wac", "/b.wac"),
    string[]("import { foo } from \"./b.wac\";\nexport i32 f() { return foo(); }\n",
             "export i32 foo() { return 1; }\n"), "/main.wac");
  t.eqI32(nOf(out), 0, "a supplied relative import is refused — " + itoa(nOf(out)) + " diagnostics");
  return t.report();
}

/** `core` and `std` resolve without a file on disk, and neither may be caught by this rule. */
export string test_the_builtin_trees_are_not_missing_files() {
  T t = T.create();
  i32[] core = dumpTypeErrors(
    ("import { Vec } from \"core/vec.wac\";\nexport i32 f() { return 1; }\n").toBytes());
  t.eqI32(nOf(core), 0, "a core import is refused — " + itoa(nOf(core)) + " diagnostics");
  i32[] std = dumpTypeErrors(
    ("import { Core, Cli } from \"std/platform.wac\";\nexport i32 f() { return 1; }\n").toBytes());
  t.eqI32(nOf(std), 0, "a std import is refused — " + itoa(nOf(std)) + " diagnostics");
  return t.report();
}

/** And a file this repository actually has, through the files entry point, stays clean. */
export string test_a_real_two_file_program_is_unaffected() {
  T t = T.create();
  i32[] out = dumpTypeErrorsFiles(
    string[]("/main.wac", "/lib.wac"),
    string[]("import { E, add } from \"/lib.wac\";\n" +
             "import { Core, Cli } from \"std/platform.wac\";\n" +
             "export i32 f() { E e = E.A; return add(1, 2); }\n",
             "export enum E { A, B }\nexport i32 add(i32 a, i32 b) { return a + b; }\n"),
    "/main.wac");
  t.eqI32(nOf(out), 0, "a two-file program with a std import is refused — " + itoa(nOf(out)) +
                       " diagnostics");
  return t.report();
}

/**
 * A *mistyped* built-in path is refused too, which it was not before.
 *
 * There is no io.wac in the core tree — it is `hash`, `map`, `option`, `result`, `vec` — and this was
 * silent, because the rule that answers for the built-in trees is membership rather than a prefix.
 * Found by writing this file's control wrongly, which is the cheapest way to find a rule's edge.
 */
export string test_a_mistyped_builtin_path_is_refused() {
  T t = T.create();
  i32[] out = dumpTypeErrors(
    ("import { Read } from \"core/io.wac\";\nexport i32 f() { return 1; }\n").toBytes());
  t.isTrue(nOf(out) > 0, "a core path with no file behind it is accepted");
  i32[] std = dumpTypeErrors(
    ("import { Core } from \"std/nope.wac\";\nexport i32 f() { return 1; }\n").toBytes());
  t.isTrue(nOf(std) > 0, "a std path with no file behind it is accepted");
  return t.report();
}

// ── And the emitter's own sentence names the file now ────────────────────────────────────────────
//
// `issues/lang/0157`'s complaint about the emitter half was that it is *"caught one phase later, with
// **no position and no file name*** — `blockedFiles` inferred the message from the absence of any other
// sentinel and could name nothing. The path is in hand at the line that decides it: `linkFiles` reads
// each queued file's source and finds none. It records the key now, through `filePaths`, which is
// already an out-parameter the caller discards on failure.
//
// Still not a *position* — that is the checker's half and still open — but "which file" is most of what
// a reader needs and it was free.
export string test_the_emitter_names_the_file_it_could_not_find() {
  T t = T.create();
  string main = "import { foo } from \"./b.wac\";\nexport i32 f() { return foo(); }\n";
  string why = blockedFiles(string[]("/main.wac"), string[](main), "/main.wac");
  t.isTrue(why != "", "the emitter accepted an import of a file nobody supplied");
  t.isTrue(why.indexOf("not supplied") >= 0, "refused for another reason — " + why);
  // **The key, not the specifier.** `./b.wac` from `/main.wac` resolves to `/b.wac`, and the resolved
  // key is what the caller's map is keyed by — so it is the thing to go looking for.
  t.isTrue(why.indexOf("/b.wac") >= 0, "did not name the file — " + why);
  return t.report();
}

/**
 * And who asked, and how they spelled it.
 *
 * **The three together are what a reader needs and what a *position* would need.** The key says what to
 * go looking for, the importer says which file to open, and the specifier as written is the string to
 * find in it — which is how a token can be located without resolving anything, and resolution is the
 * step that cannot be redone soundly inside a mapped checkout. `issues/lang/0157`.
 */
export string test_it_names_the_importer_and_the_specifier() {
  T t = T.create();
  // Two files, and the *second* one has the bad import — so the importer named cannot be the entry by
  // accident.
  string why = blockedFiles(
      string[]("/app/main.wac", "/app/lib.wac"),
      string[]("import { x } from \"./lib.wac\";\nexport i32 f() { return x(); }\n",
               "import { y } from \"../shared/util.wac\";\nexport i32 x() { return y(); }\n"),
      "/app/main.wac");
  t.isTrue(why.indexOf("/shared/util.wac") >= 0, "did not name the key — " + why);
  t.isTrue(why.indexOf("/app/lib.wac") >= 0, "did not name the importer — " + why);
  t.isTrue(why.indexOf("../shared/util.wac") >= 0, "did not name the specifier as written — " + why);
  return t.report();
}

/** A deeper path, so the name is not just the specifier echoed back. */
export string test_and_it_names_a_nested_one() {
  T t = T.create();
  string why = blockedFiles(string[]("/main.wac"), string[](
      "import { foo } from \"./sub/deep/gone.wac\";\nexport i32 f() { return foo(); }\n"),
      "/main.wac");
  t.isTrue(why.indexOf("/sub/deep/gone.wac") >= 0, "did not name the nested file — " + why);
  return t.report();
}
