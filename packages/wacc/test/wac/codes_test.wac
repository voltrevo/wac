// **Error codes, checked by value.** `issues/system/0005`'s largest single finding.
//
// Sixteen of wacc's twenty surviving mutants are error-code constants: replace `errUnexpectedChar`'s
// body with `return 0` and the whole suite stays green. The reason is written in `lexcodes_test.wac`
// already — "the wac side reports codes rather than messages, so the mapping is checked by the order
// they occur in" — so positions and counts are compared against the reference and the codes are not.
// Two distinct errors could share a code, or every code could be zero, and nothing would notice.
//
// That matters more than it sounds. A code is the one field wacc uses to say *what went wrong*;
// `diag.wac` turns it into the sentence a person reads, and the rungs that compare diagnostics
// against the reference compare position and order. So the field the message is derived from is the
// field nothing checks.
//
// ## Why a table of programs rather than asserting the constants
//
// Asserting `errUnexpectedChar() == 1` would kill the mutants and prove nothing: it restates the
// constant. What is worth pinning is the **mapping** — this program produces that code — because that
// is what a reader of a diagnostic depends on and what a mutant silently breaks.
//
// So each row below is the smallest program that provokes one diagnostic, and the assertion is which
// code came out. A mutant that returns 0 from any of these constants makes some row report 0.
//
// ## And the property that catches the shared-code mistake
//
// A table alone cannot see two *different* faults sharing one code, because each row only looks at
// its own. One test asserts the codes across the whole table are distinct, which is the shape
// `one code, two faults` describes: a shared code makes a message name one rule while the other fault
// is what happened.
//
// ## Host-side until 2026-08-18, `issues/system/0161`
//
// `wacBind` becomes an import. The three dumps are `api.wac`'s, called in process, so there is no
// host anywhere in this file — which suits it, since what it measures is a constant inside the
// compiler and every layer between would only be somewhere for the answer to be laundered.
//
// The codes stay written as numbers rather than read from the constants, for the reason the
// host-side version gave: reading them back from `errUndefinedName()` would make this table agree
// with whatever the constant says, **including with a mutant that made it zero** — which is the
// entire failure being closed here. The constant's name is in a comment beside each, so a reader can
// find the declaration without the test being able to follow it.

import { T } from "../../../wactest/src/assert.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { dumpErrors, dumpParseErrors, dumpTypeErrors } from "../../src/api.wac";

/** The code of the first diagnostic a dump reports, or -1 when it reported none. */
i32 firstCode(i32[] out) { return out.len() >= 3 ? out[0] : -1; }

/**
 * Lexer rows. `dumpErrors` reports the lexer's first and then the parser's, so a row here has to be
 * something `lex` itself refuses — an unterminated literal, an unknown escape — rather than merely a
 * character the parser then chokes on. `@` is the latter: it lexes fine and fails at code 20.
 */
string[] lexWhat() {
  return string[](
    "a string with no closing quote",
    "an escape that is not one at all",
    "a Unicode escape naming no codepoint");
}
string[] lexSrc() {
  return string[](
    "export i32 f() { string s = \"oops; return 0; }",
    "export i32 f() { string s = \"a\\qb\"; return 0; }",
    "export i32 f() { string s = \"\\u{110000}\"; return 0; }");
}
// errUnterminatedString, errUnknownEscape, errBadUnicodeEscape
i32[] lexCode() { return i32[](2, 3, 8); }

string[] parseWhat() {
  return string[]("a type name where a type must be", "nothing where an expression must be");
}
string[] parseSrc() {
  return string[](
    "export i32 f() { 3 x = 1; return x; }",
    "export i32 f() { return 1 + ; }");
}
i32[] parseCode() { return i32[](20, 22); }   // perrExpected, perrBadPrimary

string[] checkWhat() {
  return string[](
    "a name nothing declares",
    "assigning to a const variable",
    "a call with the wrong number of arguments",
    "a field the struct does not have",
    "a match on something that is not an enum",
    "an arm binding more names than the variant has");
}
string[] checkSrc() {
  return string[](
    "export i32 f() { return nope; }",
    "export i32 f() { const i32 k = 1; k = 2; return k; }",
    "void g(i32 a) {} export i32 f() { g(); return 0; }",
    "struct S { i32 v; } export i32 f() { S s = S(1); return s.w; }",
    "export i32 f(i32 n) { match (n) { else: { return 0; } } return 1; }",
    "enum E { A, C(i32 p) } export i32 f(E e) { " +
    "return match (e) { case A: 0, case C(p, q): q }; }");
}
// errUndefinedName, errConstVariable, errCallArity, errNoSuchField, errMatchNotEnum, errArmBindArity
i32[] checkCode() { return i32[](35, 10, 32, 39, 72, 76); }

export string test_each_lexer_diagnostic_carries_the_code_it_is_supposed_to() {
  T t = T.create();
  string[] what = lexWhat();
  string[] src = lexSrc();
  i32[] code = lexCode();
  for (i32 i = 0; i < what.len(); i++) {
    t.eqI32(firstCode(dumpErrors(src[i].toBytes())), code[i], what[i] + ": " + src[i]);
  }
  return t.report();
}

export string test_each_parser_diagnostic_carries_the_code_it_is_supposed_to() {
  T t = T.create();
  string[] what = parseWhat();
  string[] src = parseSrc();
  i32[] code = parseCode();
  for (i32 i = 0; i < what.len(); i++) {
    t.eqI32(firstCode(dumpParseErrors(src[i].toBytes())), code[i], what[i] + ": " + src[i]);
  }
  return t.report();
}

export string test_each_checker_diagnostic_carries_the_code_it_is_supposed_to() {
  T t = T.create();
  string[] what = checkWhat();
  string[] src = checkSrc();
  i32[] code = checkCode();
  for (i32 i = 0; i < what.len(); i++) {
    t.eqI32(firstCode(dumpTypeErrors(src[i].toBytes())), code[i], what[i] + ": " + src[i]);
  }
  return t.report();
}

export string test_and_the_codes_within_one_phase_are_distinct() {
  // The property a per-row table cannot see. Two faults sharing a code means a reader gets a sentence
  // naming one rule when the other is what happened — and the row for each would still pass, because
  // each row only ever looks at its own answer.
  T t = T.create();
  string[] phases = string[]("lex", "parse", "check");
  for (i32 p = 0; p < phases.len(); p++) {
    string[] what = p == 0 ? lexWhat() : (p == 1 ? parseWhat() : checkWhat());
    i32[] code = p == 0 ? lexCode() : (p == 1 ? parseCode() : checkCode());
    for (i32 i = 0; i < code.len(); i++) {
      for (i32 j = i + 1; j < code.len(); j++) {
        if (code[i] != code[j]) { continue; }
        t.fail(phases[p] + ": \"" + what[j] + "\" and \"" + what[i] + "\" both report code " +
               itoa(code[i]));
      }
    }
  }
  return t.report();
}

export string test_a_program_with_nothing_wrong_reports_nothing_in_every_phase() {
  // The control. Without it, a compiler that reported code 1 for everything would pass every row
  // above that happens to expect 1 — and a compiler that reported *nothing* would fail them all,
  // which is the direction that already fails loudly. This is the other direction.
  T t = T.create();
  string fine = "export i32 f() { i32 x = 1; return x + 1; }";
  t.eqI32(dumpErrors(fine.toBytes()).len(), 0, "the lexer");
  t.eqI32(dumpParseErrors(fine.toBytes()).len(), 0, "the parser");
  t.eqI32(dumpTypeErrors(fine.toBytes()).len(), 0, "the checker");
  return t.report();
}

/**
 * Each literal form escapes its own delimiter, and only its own — `design/lang/0013` D1.
 *
 * Not rows in the table above, because these two provoke a code that already has a row there and
 * that table's other property is that its codes are distinct. What is being pinned here is not the
 * mapping but the *set*: which spellings the lexer admits.
 *
 * `"\\'"` was accepted by wacc and refused by the reference. `packages/wacc/src/lex.wac` carried the
 * character form's seven-entry table on the string check — copied, and present since this lexer's
 * first commit, `aedec3b7`. The decoded value is right either way, so nothing downstream could
 * notice: it was a missing diagnostic, which is the kind of defect a differential finds and a suite
 * with one implementation in it does not.
 *
 * **Both directions, because a rule that removes spellings is half-tested by the half that still
 * compiles.** `'\\"'` is the other half, and it was legal for the same reason and by the same table.
 * Neither appears anywhere in this repository, which is what made the change cost nothing.
 *
 * And the two that must keep working, so this cannot pass by refusing escapes generally.
 */
export string test_each_literal_form_escapes_its_own_delimiter_and_only_its_own() {
  T t = T.create();

  t.eqI32(firstCode(dumpErrors("export i32 f() { string s = \"it\\'s\"; return 0; }".toBytes())), 3,
          "a single quote escaped inside a string is not an escape there");
  t.eqI32(firstCode(dumpErrors("export i32 f() { return '\\\"'; }".toBytes())), 3,
          "a double quote escaped inside a character literal is not an escape there");

  t.eqI32(firstCode(dumpErrors("export i32 f() { string s = \"say \\\"hi\\\"\"; return 0; }".toBytes())),
          -1, "a double quote escaped inside a string still is one");
  t.eqI32(firstCode(dumpErrors("export i32 f() { return '\\''; }".toBytes())), -1,
          "a single quote escaped inside a character literal still is one");
  return t.report();
}

/**
 * `\u{H…H}` spells any character, and its bounds are `string.fromCodepoint`'s.
 *
 * `design/lang/0013` D2. One escape that can spell any character, validated so it cannot produce
 * invalid UTF-8 — which is what step 3 leans on, since forbidding raw control characters is only
 * reasonable once every character has a spelling.
 *
 * **The bounds are deliberately the runtime's**, `§wac-str-fromcp-trap-h6qw2np`: a negative value,
 * one above `0x10FFFF`, or a surrogate in `0xD800..0xDFFF` traps there and is refused here. One rule
 * rather than two that drift, and a literal cannot express what the equivalent call would refuse.
 *
 * **Both directions, and the boundaries on both sides of each edge.** A rule stated as "at most
 * 10FFFF, not a surrogate" is three edges, and a test that only names the bad side passes against an
 * implementation that refuses everything. `D7FF` and `E000` sit either side of the surrogate block;
 * `10FFFF` is the top and `110000` is one past it.
 *
 * Values are checked by `charlit_test`-style execution elsewhere; what this file owns is the code.
 */
export string test_a_unicode_escape_is_bounded_by_what_fromCodepoint_accepts() {
  T t = T.create();

  string[] refused = string[](
    "\\u{110000}",     // one past the top
    "\\u{D800}",       // the first surrogate
    "\\u{DFFF}",       // the last surrogate
    "\\u{}",           // no digits
    "\\u{1234567}",    // seven, and seven cannot be in range
    "\\u{XY}",         // not hex
    "\\u41");          // no braces at all
  for (i32 i = 0; i < refused.len(); i++) {
    string src = "export i32 f() { string s = \"" + refused[i] + "\"; return 0; }";
    t.eqI32(firstCode(dumpErrors(src.toBytes())), 8, "refused: " + refused[i]);
  }

  string[] taken = string[](
    "\\u{0}",          // the bottom
    "\\u{7F}",         // one byte
    "\\u{D7FF}",       // just below the surrogates
    "\\u{E000}",       // just above them
    "\\u{10FFFF}",     // the top
    "\\u{10ffff}");    // and lowercase hex is the same value
  for (i32 i = 0; i < taken.len(); i++) {
    string src = "export i32 f() { string s = \"" + taken[i] + "\"; return 0; }";
    t.eqI32(firstCode(dumpErrors(src.toBytes())), 0 - 1, "taken: " + taken[i]);
  }
  return t.report();
}

/**
 * A character literal in a byte is a codepoint in a byte, and that is its own fault.
 *
 * **A plain number is not this rule.** `u8[](300)` truncating to `44` is deliberate and has a clause
 * of its own — `spec/spec/arrays.md`'s `[§wac-arr-i8-lit-trunc-i9g6kol]`, *"the fixed-element form
 * takes `i32` values too, and truncates them the same way a write does"* — so a byte array can be
 * written as a literal list. A first version of this test refused those too; the spec's acceptance
 * corpus and `spec/tour.wac` both said no within a minute of each other.
 *
 * Separate from the range rule above and given its own code, because the range check **cannot see
 * it**: `'é'` is 233, a `u8` holds 0..255, and 233 fits. What is wrong is that the two mean different
 * things — é encodes as the two bytes 195 169, so no byte can equal `'é'` and `b[0] == 'é'` is a
 * comparison that can never be true. It said nothing at all before this.
 *
 * A message reading "out of range" would have been false, which is why it is not that code.
 *
 * `'A'` is 65 and stays legal: codepoint and byte coincide below 128, which is what every
 * byte-scanning loop in this repository relies on — this compiler's own lexer, `packages/sh`'s, the
 * JSON parser. Those loops are right by ASCII accident, and the accident is now checked.
 */
export string test_a_character_literal_above_ascii_cannot_be_written_into_a_byte() {
  T t = T.create();

  string[] refused = string[](
    "export i32 f() { return u8[]('é')[0]; }",
    "export i32 f() { return u8[]('\u{1F600}')[0]; }",
    "export i32 f() { return i8[]('é')[0]; }",
    "export i32 f() { return u8[1](fill: 'é')[0]; }");
  for (i32 i = 0; i < refused.len(); i++) {
    t.eqI32(firstCode(dumpTypeErrors(refused[i].toBytes())), 209, "refused: " + refused[i]);
  }

  // 127 is the last codepoint that is also a byte, and 128 is the first that is not.
  t.eqI32(firstCode(dumpTypeErrors("export i32 f() { return u8[]('\u{7F}')[0]; }".toBytes())),
          0 - 1, "the last ASCII codepoint is still a byte");
  t.eqI32(firstCode(dumpTypeErrors("export i32 f() { return u8[]('\u{80}')[0]; }".toBytes())),
          209, "and the first non-ASCII one is not");

  // A wider packed element is not making this claim: `i16[]('é')` is a codepoint in something that
  // can hold it, and the rule this test states is about bytes.
  t.eqI32(firstCode(dumpTypeErrors("export i32 f() { return i16[]('é')[0]; }".toBytes())),
          0 - 1, "a 16-bit element is not a byte");

  // **The two spellings that are not an element slot**, and the comparison is the one
  // `design/lang/0013` leads with — the case that reads as correct code. Both operands of `==` type
  // as `i32`, because a packed read widens, so the width has to come from the array's type.
  t.eqI32(firstCode(dumpTypeErrors(
            "export bool f() { u8[] b = \"é\".toBytes(); return b[0] == 'é'; }".toBytes())),
          209, "a byte compared against a codepoint can never be equal");
  t.eqI32(firstCode(dumpTypeErrors(
            "export bool f() { u8[] b = \"é\".toBytes(); return 'é' == b[0]; }".toBytes())),
          209, "and the same written the other way round");
  t.eqI32(firstCode(dumpTypeErrors(
            "export i32 f() { u8[] b = u8[1](); b[0] = 'é'; return b[0]; }".toBytes())),
          209, "storing a codepoint into a byte");

  // And the ASCII comparison every byte-scanning loop here is built on stays legal.
  t.eqI32(firstCode(dumpTypeErrors(
            "export bool f() { u8[] b = u8[1](); return b[0] == 'A'; }".toBytes())),
          0 - 1, "comparing a byte against an ASCII codepoint is what the loops do");
  return t.report();
}
