// Swapping a literal for a compound literal of the same family does not change what a ternary means.
//
//     wac test --allow-read --allow-write --allow-run --allow-env \
//       packages/wacc/test/wac/ternarybranches_test.wac
//
// `b ? 1 : "a"` is refused and `b ? 1 + 1 : "a"` was accepted, and so was every other pair like it —
// six of them, each a direct form that reports once beside a compound form that reported nothing.
// `1 + 1` is an integer literal exactly as `1` is (`litFamily`), so the two programs are the same
// program to the language and the checker owes them the same answer. `issues/lang/0246a`.
//
// **The oracle is the pair, not the reference.** The reference refuses all twelve, but it counts
// differently — two diagnostics for `b ? "a" : 1` where wacc gives one, because wacc suppresses the
// second complaint about a fault it has already named and the reference does not (`issues/lang/0238a`).
// So "agrees with the reference on the number" is the wrong claim to hold here, while "agrees with
// *itself* about the same program written two ways" is exactly right and is immune to that difference.
//
// **Pinned at one rather than at "more than zero"**, because the way this rule breaks is by speaking
// twice. Four literal guards decide branch agreement and they interlock: the fix had to move two of
// them together, and moving them made a third arm live for pairs it had never seen. A `> 0` assertion
// passes just as happily on two.

import { T } from "../../../wactest/src/assert.wac";
import { dumpTypeErrors } from "../../src/api.wac";

i32 diagsFor(string src) { return dumpTypeErrors(src.toBytes()).len() / 3; }

/** The direct form of each pair, and its compound twin. */
string[] pairNames() {
  return string[](
    "an integer against a string literal",
    "an integer against a string sum",
    "a string literal against an integer",
    "a bool literal against an integer",
    "a named string against an integer",
    "a float against a string literal");
}

string[] directForms() {
  return string[](
    "export i32 f(bool b) { i32 n = b ? 1 : \"a\"; return n; }\n",
    "export i32 f(bool b) { i32 n = b ? 1 : \"a\" + \"b\"; return n; }\n",
    "export i32 f(bool b) { i32 n = b ? \"a\" : 1; return n; }\n",
    "export i32 f(bool b) { i32 n = b ? true : 1; return n; }\n",
    "export i32 f(bool b, string s) { i32 n = b ? s : 1; return n; }\n",
    "export i32 f(bool b) { i32 n = b ? 1.5 : \"a\"; return n; }\n");
}

string[] compoundForms() {
  return string[](
    "export i32 f(bool b) { i32 n = b ? 1 + 1 : \"a\"; return n; }\n",
    "export i32 f(bool b) { i32 n = b ? 1 + 1 : \"a\" + \"b\"; return n; }\n",
    "export i32 f(bool b) { i32 n = b ? \"a\" : 1 + 1; return n; }\n",
    "export i32 f(bool b) { i32 n = b ? true : 1 + 1; return n; }\n",
    "export i32 f(bool b, string s) { i32 n = b ? s : 1 + 1; return n; }\n",
    "export i32 f(bool b) { i32 n = b ? 1.5 + 1.5 : \"a\"; return n; }\n");
}

/**
 * Each pair, both halves, one diagnostic each.
 *
 * The direct column is what the rule already did and the compound column is what `0246a` was: six
 * rows of 1 beside six rows of 0. Asserting them together rather than in two tests is deliberate — a
 * fix that silenced the direct form would satisfy an equality check on its own.
 */
export string test_a_compound_branch_answers_as_its_direct_twin_does() {
  T t = T.create();
  string[] name = pairNames();
  string[] direct = directForms();
  string[] compound = compoundForms();
  t.eqI32(name.len(), direct.len(), "the name and direct lists disagree in length");
  t.eqI32(name.len(), compound.len(), "the name and compound lists disagree in length");
  if (name.len() != direct.len() || name.len() != compound.len()) { return t.report(); }
  for (i32 i = 0; i < direct.len(); i++) {
    t.eqI32(1, diagsFor(direct[i]), name[i] + ", written directly");
    t.eqI32(1, diagsFor(compound[i]), name[i] + ", written as a sum");
  }
  return t.report();
}

/**
 * And the pairs that agree, which is what a careless widening refuses.
 *
 * Every one of these is a compound literal in a branch, and every one is an ordinary program: two
 * integer sums, a sum against a named `i32`, a float sum against a named `f64`, two string literals,
 * and the plain literal pair the whole rule exists to leave alone. If the fix reads "a compound
 * literal in a branch is suspicious" rather than "it is a literal of its family", these fail.
 */
export string test_the_compound_branches_that_agree_are_accepted() {
  T t = T.create();
  string[] name = string[](
    "two integer sums", "an integer sum against a named i32",
    "a float sum against a named f64", "two string literals",
    "a plain integer literal pair", "a ternary of sums inside an i64 slot",
    "a sum against a nullable, which is the null rule's business");
  string[] src = string[](
    "export i32 f(bool b) { i32 n = b ? 1 + 1 : 2 + 2; return n; }\n",
    "export i32 f(bool b, i32 x) { i32 n = b ? 1 + 1 : x; return n; }\n",
    "export f64 f(bool b, f64 d) { f64 v = b ? 1.5 + 1.5 : d; return v; }\n",
    "export i32 f(bool b) { string s = b ? \"a\" : \"b\"; return s.len(); }\n",
    "export i32 f(bool b) { i32 n = b ? 1 : 2; return n; }\n",
    "export i64 f(bool b) { i64 n = b ? 1 + 1 : 2 + 2; return n; }\n",
    "export i32 f(bool b, i32? q) { i32? n = b ? 1 + 1 : q; return n is null ? 0 : n!; }\n");
  for (i32 i = 0; i < src.len(); i++) {
    t.eqI32(0, diagsFor(src[i]), name[i] + ": refused a legal program");
  }
  return t.report();
}
