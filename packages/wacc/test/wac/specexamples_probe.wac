// Every example in the specification, run against the compiler in this tree.
//
//     wac run --allow-read --allow-write --allow-run packages/wacc/test/wac/specexamples_probe.wac [dir] [report]
//
// `dir` is the specification, `spec/next` by default; `report` is where the verdicts are written,
// `spec/next/_drafting/STATUS.md` by default. It compiles in this process, through `../../src/api.wac`,
// so it measures the compiler's *source*, not the seed baked into the binary — and it spawns the binary
// only to run a module it emitted, as `cases_test.wac` does and for the same reason: a wac program
// cannot instantiate bytes it has just made.
//
// ## What a verdict means
//
// Each fence is one or more *variants* — the program as written, then one per `// ERROR:` block,
// uncommented. The program as written must meet every expectation; each `// ERROR:` variant must be
// refused. A fence is **met** when all of that holds, **missed** when any part does not, and
// **unsupported** when it asks for something this probe cannot yet do — said with the reason, and
// counted, never folded into either of the others.

import { Change, Cli, Core, FileResult, Exec } from "std/platform.wac";
import { Vec } from "core/vec.wac";
import { itoa, utoa64 } from "../../../fmt/src/itoa.wac";
import { startsWith, endsWith, trimmed, splitLines } from "../../../wactest/src/strings.wac";
import { diagnoseFilesIn, wireHasErrors, blockedFilesIn, emitFilesSelfDescribingIn,
         importSpecsFor } from "../../src/api.wac";
import { renderDiagnostics } from "../../src/render.wac";
import { Res } from "../../src/path.wac";
import { Expectation, Variant, Fence, fencesIn, indexFrom } from "./specexamples.wac";

/** What happened to one fence. */
struct Verdict {
  Fence fence;
  /** `"met"`, `"missed"` or `"unsupported"`. */
  string state;
  string why;
}

export i32 main(Core core, Cli cli) {
  string root = cli.cwd().wait();
  string dir = "spec/next";
  string report = "spec/next/_drafting/STATUS.md";
  i32 argc = cli.argCount().wait();
  if (argc > 0) { dir = string.fromBytes(cli.arg(0).wait()); }
  if (argc > 1) { report = string.fromBytes(cli.arg(1).wait()); }

  string[] docs = markdownUnder(cli, dir);
  if (docs.len() == 0) { core.warn("no markdown under " + dir + " — is the cwd the repository?"); return 2; }
  string scratch = root + "/.cache/specexamples";
  cli.mkdir(scratch, true).wait();

  Vec<Verdict> all = Vec.create();
  i32 n = 0;
  for (i32 d = 0; d < docs.len(); d++) {
    FileResult r = cli.readFile(docs[d]).wait();
    if (!r.ok) { core.warn("cannot read " + docs[d]); continue; }
    Fence[] fences = fencesIn(docs[d], string.fromBytes(r.bytes));
    for (i32 f = 0; f < fences.len(); f++) {
      if (fences[f].fragment) { continue; }
      n = n + 1;
      all.push(judge(cli, scratch, fences[f], n));
    }
  }
  cli.remove(scratch, true).wait();

  Verdict[] vs = all.toArray();
  string text = render(dir, docs, vs);
  Change wrote = cli.writeFile(report, text.toBytes()).wait();
  if (!wrote.ok()) { core.warn("could not write " + report); }
  i32 met = count(vs, "met");
  i32 missed = count(vs, "missed");
  i32 unsup = count(vs, "unsupported");
  core.log(itoa(vs.len()) + " examples: " + itoa(met) + " met, " + itoa(missed) + " missed, " + itoa(unsup)
           + " unsupported — " + report);
  return 0;
}

i32 count(Verdict[] vs, string state) {
  i32 n = 0;
  for (i32 i = 0; i < vs.len(); i++) { if (vs[i].state == state) { n = n + 1; } }
  return n;
}

/** `.md` files under `dir`, recursively, skipping directories whose name begins with `_`. Sorted. */
string[] markdownUnder(Cli cli, string dir) {
  Vec<string> out = Vec.create();
  walk(cli, dir, out);
  string[] xs = out.toArray();
  for (i32 i = 1; i < xs.len(); i++) {
    string v = xs[i];
    i32 j = i - 1;
    while (j >= 0 && xs[j] > v) { xs[j + 1] = xs[j]; j = j - 1; }
    xs[j + 1] = v;
  }
  return xs;
}

void walk(Cli cli, string dir, Vec<string> out) {
  string[]? entries = cli.readDir(dir).wait();
  if (entries is null) { return; }
  string[] es = entries!;
  for (i32 i = 0; i < es.len(); i++) {
    string name = es[i];
    if (startsWith(name, "_") || startsWith(name, ".")) { continue; }
    string path = dir + "/" + name;
    if (endsWith(name, ".md")) { out.push(path); continue; }
    string[]? sub = cli.readDir(path).wait();
    if (!(sub is null)) { walk(cli, path, out); }
  }
}

// ── Judging ──────────────────────────────────────────────────────────────────────────────────────

Verdict judge(Cli cli, string scratch, Fence fence, i32 n) {
  if (fence.error != "") { return Verdict(fence, "missed", "unreadable: " + fence.error); }
  Variant base = fence.variants[0];
  Res res = resolutionFor(base.paths, base.sources);
  string[] wacPaths = wacOnly(base.paths, base.paths);
  string[] wacSources = wacOnly(base.paths, base.sources);

  for (i32 e = 0; e < fence.expects.len(); e++) {
    Expectation x = fence.expects[e];
    if (x.command != "" && !commandSupported(x.command)) {
      return Verdict(fence, "unsupported", "an expectation about `" + x.command + "`");
    }
    string why = meets(cli, scratch, fence, x, wacPaths, wacSources, res, n * 100 + e);
    if (why != "") { return Verdict(fence, "missed", why); }
  }

  // Each `// ERROR:` block, uncommented alone, must be refused.
  for (i32 v = 1; v < fence.variants.len(); v++) {
    Variant var = fence.variants[v];
    string[] ps = wacOnly(var.paths, var.paths);
    string[] ss = wacOnly(var.paths, var.sources);
    string wire = diagnoseFilesIn(ps, ss, resolutionFor(var.paths, var.sources), fence.entry);
    if (!wireHasErrors(wire)) {
      return Verdict(fence, "missed", "line " + itoa(var.errorLine) + " uncommented is accepted — ERROR: "
                     + var.reason);
    }
  }
  return Verdict(fence, "met", "");
}

/** `(wac build)`, `(wac run …)` are builds; `wac check` checks differently and is not modelled yet. */
bool commandSupported(string c) {
  return startsWith(c, "wac build") || startsWith(c, "wac run");
}

/** Why `x` does not hold, or "". */
string meets(Cli cli, string scratch, Fence fence, Expectation x, string[] paths, string[] sources, Res res,
             i32 id) {
  string wire = diagnoseFilesIn(paths, sources, res, fence.entry);
  bool refused = wireHasErrors(wire);
  if (x.kind == "refused") { return refused ? "" : "accepted, and it must be refused"; }
  if (refused) { return "refused: " + firstDiagnostic(wire, paths, sources); }
  string blocked = blockedFilesIn(paths, sources, res, fence.entry);
  if (blocked != "") { return "checked, but the emitter declined: " + blocked; }
  if (x.kind == "emits") { return ""; }

  u8[] wasm = emitFilesSelfDescribingIn(paths, sources, res, fence.entry, "example.wasm", 0);
  if (wasm.len() == 0) { return "emitted nothing"; }
  string path = scratch + "/ex" + itoa(id) + ".wasm";
  Change wrote = cli.writeFile(path, wasm).wait();
  if (!wrote.ok()) { return "could not write " + path; }

  Vec<string> argv = Vec.create();
  argv.push(path);
  if (x.kind == "answers" || x.kind == "traps") {
    argv.push(x.call);
    for (i32 a = 0; a < x.args.len(); a++) { argv.push(cliArg(x.args[a])); }
  } else if (x.command != "") {
    // `wac run main.wac first second`: what follows the entry is the program's.
    string[] words = wordsOfCmd(x.command);
    for (i32 w = 3; w < words.len(); w++) { argv.push(words[w]); }
  }
  Exec r = cli.exec(cli.cwd().wait() + "/native/v8/target/release/wac", argv.toArray(), u8[0]()).wait();
  if (!r.ran()) { return "the binary did not run: " + r.error; }
  string out = string.fromBytes(r.stdout);
  string err = string.fromBytes(r.stderr);
  bool trapped = err.indexOf(" trapped") >= 0;

  if (x.kind == "traps") { return trapped ? "" : "answered " + trimmed(out) + ", and it must trap"; }
  if (trapped) { return "trapped: " + trimmed(err); }
  if (x.kind == "answers") {
    // One trailing newline is the binary's, and the rest is the value's: a string answer may end in one.
    string got = endsWith(out, "\n") ? out.slice(0, out.len() - 1) : out;
    return sameValue(got, x.value) ? "" : x.call + " answered " + got + ", wanted " + x.value;
  }
  if (x.kind == "exits") {
    return itoa(r.status) == x.value ? "" : "exited " + itoa(r.status) + ", wanted " + x.value;
  }
  if (x.kind == "prints") {
    string[] got = splitLines(out);
    string want = "";
    for (i32 i = 0; i < x.lines.len(); i++) { want = want + x.lines[i] + "\n"; }
    string have = "";
    for (i32 i = 0; i < got.len(); i++) { have = have + got[i] + "\n"; }
    return have == want ? "" : "printed `" + trimmed(have) + "`, wanted `" + trimmed(want) + "`";
  }
  return "unknown expectation " + x.kind;
}

string[] wordsOfCmd(string s) {
  Vec<string> out = Vec.create();
  i32 from = 0;
  for (i32 i = 0; i <= s.len(); i++) {
    if (i < s.len() && s.slice(i, i + 1) != " ") { continue; }
    if (i > from) { out.push(s.slice(from, i)); }
    from = i + 1;
  }
  return out.toArray();
}

string firstDiagnostic(string wire, string[] paths, string[] sources) {
  string rendered = renderDiagnostics(wire, paths, sources);
  string[] ls = splitLines(rendered);
  string out = "";
  for (i32 i = 0; i < ls.len() && i < 3; i++) { out = out + (i == 0 ? "" : " | ") + trimmed(ls[i]); }
  return out;
}

/** The `.wac` entries of `xs`, keyed by `paths`. Manifests are read for resolution, not compiled. */
string[] wacOnly(string[] paths, string[] xs) {
  Vec<string> out = Vec.create();
  for (i32 i = 0; i < paths.len(); i++) { if (endsWith(paths[i], ".wac")) { out.push(xs[i]); } }
  return out.toArray();
}

// ── Values ───────────────────────────────────────────────────────────────────────────────────────

/** A wac literal as the binary's argument reader takes it: strings unquoted, lists bare, hex in decimal. */
string cliArg(string lit) {
  string t = trimmed(lit);
  if (startsWith(t, "\"") && endsWith(t, "\"")) { return unescape(t.slice(1, t.len() - 1)); }
  if (startsWith(t, "[") && endsWith(t, "]")) {
    string inner = t.slice(1, t.len() - 1);
    string out = "";
    string[] parts = splitTop(inner);
    for (i32 i = 0; i < parts.len(); i++) { out = out + (i == 0 ? "" : ",") + cliArg(parts[i]); }
    return out;
  }
  if (startsWith(t, "0x") || startsWith(t, "-0x")) { return hexToDecimal(t); }
  return t;
}

string[] splitTop(string s) {
  Vec<string> out = Vec.create();
  i32 depth = 0;
  bool quoted = false;
  i32 from = 0;
  for (i32 i = 0; i < s.len(); i++) {
    string c = s.slice(i, i + 1);
    if (quoted) { if (c == "\\") { i = i + 1; } else if (c == "\"") { quoted = false; } continue; }
    if (c == "\"") { quoted = true; }
    else if (c == "[" || c == "(") { depth = depth + 1; }
    else if (c == "]" || c == ")") { depth = depth - 1; }
    else if (c == "," && depth == 0) { out.push(trimmed(s.slice(from, i))); from = i + 1; }
  }
  if (trimmed(s.slice(from, s.len())) != "") { out.push(trimmed(s.slice(from, s.len()))); }
  return out.toArray();
}

string unescape(string s) {
  string out = "";
  for (i32 i = 0; i < s.len(); i++) {
    string c = s.slice(i, i + 1);
    if (c == "\\" && i + 1 < s.len()) {
      string d = s.slice(i + 1, i + 2);
      i = i + 1;
      if (d == "n") { out = out + "\n"; }
      else if (d == "t") { out = out + "\t"; }
      else if (d == "r") { out = out + "\r"; }
      else if (d == "0") { out = out + string.fromBytes(u8[](0)); }
      else if (d == "u" && i + 1 < s.len() && s.slice(i + 1, i + 2) == "{") {
        i32 close = indexFrom(s, "}", i);
        out = out + codepointText(s.slice(i + 2, close));
        i = close;
      }
      else { out = out + d; }
      continue;
    }
    out = out + c;
  }
  return out;
}

/** The UTF-8 text of the code point written in hex. */
string codepointText(string hex) {
  i32 cp = 0;
  for (i32 i = 0; i < hex.len(); i++) {
    string c = hex.slice(i, i + 1);
    i32 d = "0123456789abcdef".indexOf(c);
    if (d < 0) { d = "0123456789ABCDEF".indexOf(c); }
    cp = cp * 16 + d;
  }
  if (cp < 0x80) { return string.fromBytes(u8[](cp)); }
  if (cp < 0x800) { return string.fromBytes(u8[]((0xC0 | (cp >> 6)), (0x80 | (cp & 0x3F)))); }
  if (cp < 0x10000) {
    return string.fromBytes(u8[]((0xE0 | (cp >> 12)), (0x80 | ((cp >> 6) & 0x3F)),
                                 (0x80 | (cp & 0x3F))));
  }
  return string.fromBytes(u8[]((0xF0 | (cp >> 18)), (0x80 | ((cp >> 12) & 0x3F)),
                               (0x80 | ((cp >> 6) & 0x3F)), (0x80 | (cp & 0x3F))));
}

string hexToDecimal(string t) {
  bool neg = startsWith(t, "-");
  string digits = t.slice(neg ? 3 : 2, t.len());
  u64 v = 0;
  u64 sixteen = 16;
  for (i32 i = 0; i < digits.len(); i++) {
    string c = digits.slice(i, i + 1);
    if (c == "_") { continue; }
    i32 d = "0123456789abcdef".indexOf(c);
    if (d < 0) { d = "0123456789ABCDEF".indexOf(c); }
    v = v * sixteen + (d as! u64);
  }
  string s = utoa64(v);
  return neg ? "-" + s : s;
}

/** Whether what the binary printed is the value the expectation wrote. */
bool sameValue(string got, string want) {
  string w = trimmed(want);
  if (got == w) { return true; }
  if (startsWith(w, "\"") && endsWith(w, "\"")) { return got == unescape(w.slice(1, w.len() - 1)); }
  if (startsWith(w, "'") && endsWith(w, "'") && w.len() == 3) {
    return got == itoa(w.toBytes()[1]);
  }
  if (startsWith(w, "0x") || startsWith(w, "-0x")) { return got == hexToDecimal(w); }
  // A float written `12.0` may print as `12`.
  if (endsWith(w, ".0") && got == w.slice(0, w.len() - 2)) { return true; }
  if (endsWith(got, ".0") && w == got.slice(0, got.len() - 2)) { return true; }
  return false;
}

// ── Resolution ───────────────────────────────────────────────────────────────────────────────────

/**
 * Project roots and package mappings, from the fence's own `wac.json5` files: each `.wac` file's
 * project is the nearest directory above it with a manifest, and a package a manifest imports maps to
 * the `exports` of the `deps/<name>/` checkout the fence supplies.
 */
Res resolutionFor(string[] paths, string[] sources) {
  Vec<string> manifestDirs = Vec.create();
  Vec<string> manifestTexts = Vec.create();
  for (i32 i = 0; i < paths.len(); i++) {
    if (paths[i] == "wac.json5") { manifestDirs.push("."); manifestTexts.push(sources[i]); }
    else if (endsWith(paths[i], "/wac.json5")) {
      manifestDirs.push(paths[i].slice(0, paths[i].len() - 10));
      manifestTexts.push(sources[i]);
    }
  }
  string[] wp = wacOnly(paths, paths);
  string[] ws = wacOnly(paths, sources);
  string[] roots = string[wp.len()](fill: "");
  Vec<string> from = Vec.create();
  Vec<string> spec = Vec.create();
  Vec<string> to = Vec.create();
  for (i32 i = 0; i < wp.len(); i++) {
    i32 best = -1;
    for (i32 m = 0; m < manifestDirs.len(); m++) {
      string d = manifestDirs.get(m);
      bool inside = d == "." || startsWith(wp[i], d + "/");
      if (inside && (best < 0 || d.len() > manifestDirs.get(best).len() || manifestDirs.get(best) == ".")) {
        if (best < 0 || d != ".") { best = m; }
      }
    }
    if (best < 0) { continue; }
    roots[i] = manifestDirs.get(best);
    string[] specs = importSpecsFor(wp[i], ws[i].toBytes());
    for (i32 s = 0; s < specs.len(); s++) {
      string target = packageTarget(manifestTexts.get(best), specs[s], manifestDirs, manifestTexts);
      if (target != "") { from.push(wp[i]); spec.push(specs[s]); to.push(target); }
    }
  }
  return Res(roots, from.toArray(), spec.toArray(), to.toArray(), "");
}

/** Where package `name` resolves for a project whose manifest is `manifest`, or "". */
string packageTarget(string manifest, string name, Vec<string> dirs, Vec<string> texts) {
  if (indexFrom(manifest, name + ":", 0) < 0 && indexFrom(manifest, "\"" + name + "\":", 0) < 0) { return ""; }
  string depDir = "deps/" + name;
  for (i32 m = 0; m < dirs.len(); m++) {
    if (dirs.get(m) != depDir) { continue; }
    string e = jsonString(texts.get(m), "exports");
    if (e == "") { return ""; }
    if (startsWith(e, "./")) { e = e.slice(2, e.len()); }
    return depDir + "/" + e;
  }
  return "";
}

/** The string value of `key` in a small JSON5 object — enough for the manifests examples write. */
string jsonString(string text, string key) {
  i32 k = indexFrom(text, key, 0);
  if (k < 0) { return ""; }
  i32 q = indexFrom(text, "\"", k + key.len());
  if (q < 0) { return ""; }
  i32 e = indexFrom(text, "\"", q + 1);
  if (e < 0) { return ""; }
  return text.slice(q + 1, e);
}

// ── The report ───────────────────────────────────────────────────────────────────────────────────

string render(string dir, string[] docs, Verdict[] vs) {
  string out = "# Status of the examples in " + dir + "\n\n";
  out = out + "Generated by `packages/wacc/test/wac/specexamples_probe.wac` — do not edit by hand.\n\n";
  out = out + "**" + itoa(vs.len()) + " examples: " + itoa(count(vs, "met")) + " met, "
        + itoa(count(vs, "missed")) + " missed, " + itoa(count(vs, "unsupported")) + " unsupported.**\n\n";
  out = out + "| document | examples | met | missed | unsupported |\n|---|---:|---:|---:|---:|\n";
  for (i32 d = 0; d < docs.len(); d++) {
    i32 total = 0; i32 met = 0; i32 missed = 0; i32 unsup = 0;
    for (i32 i = 0; i < vs.len(); i++) {
      if (vs[i].fence.doc != docs[d]) { continue; }
      total = total + 1;
      if (vs[i].state == "met") { met = met + 1; }
      else if (vs[i].state == "missed") { missed = missed + 1; }
      else { unsup = unsup + 1; }
    }
    if (total == 0) { continue; }
    out = out + "| " + docs[d] + " | " + itoa(total) + " | " + itoa(met) + " | " + itoa(missed) + " | "
          + itoa(unsup) + " |\n";
  }
  out = out + "\n## Missed\n\n";
  for (i32 i = 0; i < vs.len(); i++) {
    if (vs[i].state != "missed") { continue; }
    out = out + "- `" + vs[i].fence.doc + ":" + itoa(vs[i].fence.line) + "`" + tagList(vs[i].fence.tags) + " — "
          + oneLine(vs[i].why) + "\n";
  }
  out = out + "\n## Unsupported\n\n";
  for (i32 i = 0; i < vs.len(); i++) {
    if (vs[i].state != "unsupported") { continue; }
    out = out + "- `" + vs[i].fence.doc + ":" + itoa(vs[i].fence.line) + "` — " + oneLine(vs[i].why) + "\n";
  }
  return out;
}

string tagList(string[] tags) {
  if (tags.len() == 0) { return ""; }
  string out = " (";
  for (i32 i = 0; i < tags.len(); i++) { out = out + (i == 0 ? "" : ", ") + tags[i]; }
  return out + ")";
}

string oneLine(string s) {
  string out = "";
  for (i32 i = 0; i < s.len() && i < 300; i++) {
    string c = s.slice(i, i + 1);
    out = out + (c == "\n" ? " " : c);
  }
  return out;
}
