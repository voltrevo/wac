// A Git-mapped specifier resolves from the lockfile and the cache — `design/lang/0009` D9-D11.
//
// `[§wac-import-mapped-6np2rkq]` `[§wac-cli-update-2rq7knp]`
//
// **wacc only, and that is a decision rather than a gap.** Resolving a mapping means reading a
// manifest, a lockfile and a checkout cache; D11 says package policy does not get a second
// implementation, and `compiler/README.md` records the reference's omission in the table a reader
// consults to tell "the reference disagrees" from "the reference does not have that". The reference
// exists to build the first `wacc.wasm` from a cold checkout, and that compile has no dependencies
// by construction — every import in this repository is relative or built-in.
//
// **Nothing here touches the network.** The cache is a directory this test fills in, which is what
// the resolution reads: D10 makes `wac update` the explicit operation and forbids an ordinary
// command from advancing a pin because a branch moved, so `wac build` fetching would be the same
// mistake in a different place. That also makes this test fast and offline.

import { T } from "../../../wactest/src/assert.wac";
import { binaryPath, scratch } from "../../../wactest/src/host.wac";
import { withEnv } from "../../../wactest/src/childenv.wac";
import { contains } from "../../../wactest/src/strings.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { escapeRepo } from "../../../wacpkg/src/cache.wac";
import { Change, Cli, Core, Exec, FileResult } from "std/platform.wac";

const string REPO = "https://example.invalid/dep.git";
const string COMMIT = "0123456789abcdef0123456789abcdef01234567";

/** One file, with its directory made first. */
bool put(Cli cli, string path, string text) {
  i32 cut = -1;
  for (i32 i = 0; i < path.len(); i++) { if (path.slice(i, i + 1) == "/") { cut = i; } }
  if (cut > 0) { cli.mkdir(path.slice(0, cut), true).wait(); }
  return cli.writeFile(path, text.toBytes()).wait().ok();
}

/** `wac <cmd> …` with `$WAC_HOME` pointed at the fixture's cache. */
Exec wacc(Cli cli, string home, string dir, string cmd, string entry) {
  return withEnv(cli, string[]("WAC_HOME"), string[](home),
                 "/bin/sh",
                 string[]("-c", "cd " + dir + " && exec " + binaryPath(cli) + " " + cmd + " " + entry));
}

/** A project that maps `dep/` at `subdir: "src"`, with the manifest written but no lock yet. */
string project(Cli cli, T t, string dir) {
  t.isTrue(put(cli, dir + "/wac.json5",
               "{\n  imports: {\n    \"dep/\": { git: \"" + REPO +
               "\", ref: \"main\", subdir: \"src\" },\n  },\n}\n"), "the manifest");
  t.isTrue(put(cli, dir + "/src/main.wac",
               "import { two } from \"dep/lib.wac\";\n" +
               "export i32 main() { return two() + 5; }\n"), "the entry");
  return dir;
}

/** The lockfile pinning `dep/` to a commit. */
bool lockAt(Cli cli, string dir, string commit) {
  return put(cli, dir + "/wac.lock",
             "{\n  imports: {\n    \"dep/\": {\n      git: \"" + REPO + "\",\n" +
             "      ref: \"main\",\n      subdir: \"src\",\n      commit: \"" + commit + "\",\n" +
             "    },\n  },\n}\n");
}

/** The dependency's own checkout, where `cachePath` says it goes. */
bool checkout(Cli cli, string home, string commit, string body) {
  return put(cli, home + "/cache/git/" + escapeRepo(REPO) + "/" + commit + "/src/lib.wac", body);
}

/** Any file in the dependency's checkout, by its repository-relative path. */
bool checkoutFile(Cli cli, string home, string commit, string rel, string body) {
  return put(cli, home + "/cache/git/" + escapeRepo(REPO) + "/" + commit + "/" + rel, body);
}

export string test_a_mapped_specifier_resolves_from_the_lock_and_the_cache(Core core, Cli cli) {
  T t = T.create();
  string dir = scratch(cli, "mapped-ok");
  string home = dir + "-home";
  cli.remove(dir, true).wait();
  cli.remove(home, true).wait();
  cli.mkdir(dir, true).wait();
  project(cli, t, dir);
  t.isTrue(lockAt(cli, dir, COMMIT), "the lockfile");
  t.isTrue(checkout(cli, home, COMMIT, "export i32 two() { return 2; }\n"), "the checkout");

  Exec r = wacc(cli, home, dir, "run", "src/main.wac");
  t.isTrue(r.ran(), "wac did not run — " + r.error);
  if (r.ran()) {
    // `two()` came from the mapped dependency; 5 is the entry's own. The answer is the evidence
    // that the *right* file was found, which "it compiled" would not be.
    t.eqI32(r.status, 7, "answered " + itoa(r.status) + ", want 7: " + string.fromBytes(r.stderr));
  }
  cli.remove(dir, true).wait();
  cli.remove(home, true).wait();
  return t.report();
}

export string test_a_mapping_with_no_lock_entry_says_to_update(Core core, Cli cli) {
  // D10: an ordinary command does not fetch and does not invent a pin. The refusal has to name the
  // command that would fix it, or the reader is left with "cannot read dep/lib.wac" and no idea
  // that a lockfile is the missing thing.
  T t = T.create();
  string dir = scratch(cli, "mapped-nolock");
  string home = dir + "-home";
  cli.remove(dir, true).wait();
  cli.remove(home, true).wait();
  cli.mkdir(dir, true).wait();
  project(cli, t, dir);
  t.isTrue(checkout(cli, home, COMMIT, "export i32 two() { return 2; }\n"), "the checkout");

  Exec r = wacc(cli, home, dir, "check", "src/main.wac");
  t.isTrue(r.ran(), "wac did not run — " + r.error);
  if (r.ran()) {
    string said = string.fromBytes(r.stderr) + string.fromBytes(r.stdout);
    t.isTrue(r.status != 0, "a mapping with no lock entry was accepted: " + said);
    t.isTrue(contains(said, "wac update"), "it did not name the command to run: " + said);
    t.isTrue(contains(said, "dep/"), "it did not name the mapping: " + said);
  }
  cli.remove(dir, true).wait();
  cli.remove(home, true).wait();
  return t.report();
}

export string test_a_commit_that_is_not_in_the_cache_says_where_it_looked(Core core, Cli cli) {
  // **The canary for the first case.** A resolution that fell back to *anything* — the working
  // directory, the project root, the first checkout it found — would pass that test and this one,
  // so this pins a lock to a commit nothing has fetched and requires the refusal. Naming the path
  // is what separates a wrong commit from a wrong subdir from an empty cache, which are three
  // different things to do about it.
  T t = T.create();
  string dir = scratch(cli, "mapped-nocache");
  string home = dir + "-home";
  cli.remove(dir, true).wait();
  cli.remove(home, true).wait();
  cli.mkdir(dir, true).wait();
  project(cli, t, dir);
  t.isTrue(lockAt(cli, dir, "89abcdef0123456789abcdef0123456789abcdef"), "a lock on another commit");
  t.isTrue(checkout(cli, home, COMMIT, "export i32 two() { return 2; }\n"), "the other commit's checkout");

  Exec r = wacc(cli, home, dir, "check", "src/main.wac");
  t.isTrue(r.ran(), "wac did not run — " + r.error);
  if (r.ran()) {
    string said = string.fromBytes(r.stderr) + string.fromBytes(r.stdout);
    t.isTrue(r.status != 0, "a commit that is not in the cache was accepted: " + said);
    t.isTrue(contains(said, "wac update"), "it did not name the command to run: " + said);
    t.isTrue(contains(said, "89abcdef"), "it did not say which commit it wanted: " + said);
  }
  cli.remove(dir, true).wait();
  cli.remove(home, true).wait();
  return t.report();
}

export string test_two_mappings_at_one_commit_are_one_module(Core core, Cli cli) {
  // **D8, through the half that mappings make reachable.** Identity is the repository, the resolved
  // commit and the repository-relative path — so a file reached through two different mapping
  // *names* at the same commit is one module, and in wac that is load-bearing: types are nominal,
  // so two modules would be two `Two`s and passing one where the other is wanted would not compile.
  //
  // **What this case can and cannot catch, because it is weaker than it looks.** The key a mapped
  // file is filed under *is* the path it is read from, and that path is `cachePath(repo, commit)`
  // plus the repository-relative part — so identity is the D8 triple by construction, not by a
  // canonicalisation step that could be got wrong. I went looking for a mutation that would make
  // this case fail and there is not one: anything that changes the key changes where the file is
  // read from, so it fails as "not in the cache" rather than as two types with one name.
  //
  // So this guards the *construction* — that the cache layout is what the module is keyed by —
  // rather than an independent rule. It would catch somebody adding a per-mapping component to the
  // cache path, or keying by the specifier as written. It would not catch a canonicalisation bug,
  // because there is no canonicalisation to have a bug in. Worth saying, because a case named after
  // D8 that cannot fail for D8's reason is exactly the kind of test that reads as coverage.
  T t = T.create();
  string dir = scratch(cli, "mapped-onemodule");
  string home = dir + "-home";
  cli.remove(dir, true).wait();
  cli.remove(home, true).wait();
  cli.mkdir(dir, true).wait();

  // Two names, one repository, one commit, one subdir — D9 permits this: the names do not overlap.
  t.isTrue(put(cli, dir + "/wac.json5",
               "{\n  imports: {\n" +
               "    \"one/\": { git: \"" + REPO + "\", ref: \"main\", subdir: \"src\" },\n" +
               "    \"two/\": { git: \"" + REPO + "\", ref: \"main\", subdir: \"src\" },\n" +
               "  },\n}\n"), "a manifest with two names for one repository");
  t.isTrue(put(cli, dir + "/wac.lock",
               "{\n  imports: {\n" +
               "    \"one/\": { git: \"" + REPO + "\", ref: \"main\", subdir: \"src\", commit: \"" + COMMIT + "\" },\n" +
               "    \"two/\": { git: \"" + REPO + "\", ref: \"main\", subdir: \"src\", commit: \"" + COMMIT + "\" },\n" +
               "  },\n}\n"), "both pinned to one commit");
  t.isTrue(put(cli, home + "/cache/git/" + escapeRepo(REPO) + "/" + COMMIT + "/src/lib.wac",
               "export struct Two { i32 v; i32 get(const this) { return this.v; } }\n" +
               "export Two make() { return Two(2); }\n"), "the checkout");
  // One file reaches it as `one/`, the other as `two/`, and a value crosses between them.
  t.isTrue(put(cli, dir + "/src/a.wac",
               "import { Two, make } from \"one/lib.wac\";\n" +
               "export Two mk() { return make(); }\n"), "a");
  t.isTrue(put(cli, dir + "/src/b.wac",
               "import { Two } from \"two/lib.wac\";\n" +
               "export i32 take(Two x) { return x.get(); }\n"), "b");
  t.isTrue(put(cli, dir + "/src/main.wac",
               "import { mk } from \"./a.wac\";\n" +
               "import { take } from \"./b.wac\";\n" +
               "export i32 main() { return take(mk()) + 5; }\n"), "main");

  Exec r = wacc(cli, home, dir, "run", "src/main.wac");
  t.isTrue(r.ran(), "wac did not run — " + r.error);
  if (r.ran()) {
    t.eqI32(r.status, 7,
            "answered " + itoa(r.status) + ", want 7 — one repository at one commit is one module " +
            "however many mappings name it: " + string.fromBytes(r.stderr));
  }
  cli.remove(dir, true).wait();
  cli.remove(home, true).wait();
  return t.report();
}

export string test_update_is_the_only_command_that_reaches_the_network(Core core, Cli cli) {
  // `[§wac-cli-update-2rq7knp]` — the half of D10 that can be checked without a network.
  //
  // **What this asserts is a refusal, and that is the point.** `wac update` fetching is exercised
  // against a real repository by hand and cannot be a suite test: it needs the network, a remote
  // that stays up, and eight megabytes. What *can* be pinned here is the property that makes the
  // rest reproducible — a mapped import whose commit is not in the cache is a **compile error
  // naming `update`**, not a compile that quietly goes online. A `wac build` that fetched would
  // pass every other case in this file.
  //
  // The stronger version of this claim is structural rather than testable: the fetcher is a separate
  // payload in the binary, so there is no code path from compiling to a socket at all. A test can
  // only show the behaviour; `native/v8/build.rs` is where the absence lives.
  T t = T.create();
  string dir = scratch(cli, "mapped-offline");
  string home = dir + "-home";
  cli.remove(dir, true).wait();
  cli.remove(home, true).wait();
  cli.mkdir(dir, true).wait();
  cli.mkdir(home, true).wait();
  project(cli, t, dir);
  t.isTrue(lockAt(cli, dir, COMMIT), "a lock naming a commit nothing has fetched");

  Exec r = wacc(cli, home, dir, "build", "src/main.wac -o " + dir + "/out");
  t.isTrue(r.ran(), "wac did not run — " + r.error);
  if (r.ran()) {
    string said = string.fromBytes(r.stderr) + string.fromBytes(r.stdout);
    t.isTrue(r.status != 0, "a build with an unfetched commit succeeded: " + said);
    t.isTrue(contains(said, "wac update"),
             "the refusal did not name the command that fetches: " + said);
  }
  cli.remove(dir, true).wait();
  cli.remove(home, true).wait();
  return t.report();
}

/**
 * `wac update` caches where the *compiler* looks, and says so when it cannot tell where that is.
 *
 * **The defect this guards.** `fetch.wac` takes the cache root as `arg(1)` and defaults it to the
 * literal `.wac`, which is right for running it as a program from a checkout. As a command it left
 * the fetched tree in `./.wac` while the compiler read `$WAC_HOME` — so `wac update` said *1
 * fetched*, a second `wac update` said *nothing to fetch; already locked*, and `wac run` said *not in
 * the cache — run `wac update`*. Three truthful messages and no way out.
 *
 * **What this case actually covers, which is less than that.** It drives the branch that resolves
 * `$WAC_HOME` and asserts the refusal when there is none to resolve. The end-to-end property — that
 * a fetched tree lands where a later `wac run` finds it — needs the network, so it is checked by
 * hand rather than here: `wac update` then `wac run` against `github.com/voltrevo/wac` answers 3.
 * Saying which half is guarded matters, because a green case here is not that demonstration.
 */
export string test_update_caches_where_the_compiler_looks(Core core, Cli cli) {
  T t = T.create();
  string dir = scratch(cli, "updatehome");
  cli.remove(dir, true).wait();
  Change made = cli.mkdir(dir, true).wait();
  t.isTrue(made.ok(), "could not make " + dir + " — " + made.message);
  if (!made.ok()) { return t.report(); }
  project(cli, t, dir);

  // Neither variable set, so there is no cache root to derive. Empty rather than absent is the
  // spelling `withEnv` can express, and `wac_home` treats them the same for exactly this reason.
  Exec r = withEnv(cli, string[]("WAC_HOME", "HOME"), string[]("", ""),
                   "/bin/sh",
                   string[]("-c", "cd " + dir + " && exec " + binaryPath(cli) + " update"));
  t.isTrue(r.ran(), "wac did not run — " + r.error);
  if (r.ran()) {
    string said = string.fromBytes(r.stderr) + string.fromBytes(r.stdout);
    t.isTrue(r.status != 0, "update with no WAC_HOME and no HOME was accepted: " + said);
    t.isTrue(contains(said, "nowhere to cache"),
             "update did not say it had nowhere to cache — " + said);
  }

  // And it must not have quietly made one beside the project, which is the old behaviour.
  FileResult stray = cli.readFile(dir + "/.wac/cache").wait();
  t.isFalse(stray.ok, "update created a cache inside the project rather than under $WAC_HOME");
  cli.remove(dir, true).wait();
  return t.report();
}

/**
 * A mapped `subdir` confines what its code may import — `issues/lang/0169a`, D7 as settled.
 *
 * You mapped `src`. The rest of that repository is not part of what you took, and code inside `src`
 * must not be able to reach it. **The subdir is not the `@/` search boundary** — a dependency's `@/`
 * means its own repository's root, because that is what its author wrote against — so this cannot be
 * done by stopping the walk. It is a rule about the resolved path.
 *
 * **One case per specifier form, and that is the point rather than thoroughness for its own sake.**
 * When this was found, `@/outside/bad.wac` and `../outside/bad.wac` both reached, so a fix aimed at
 * `@/` alone would have gone green over an open hole. They are checked together here so that a fix
 * has to be where every form meets the filesystem.
 */
export string test_a_mapped_subdir_cannot_import_outside_itself(Core core, Cli cli) {
  T t = T.create();
  string dir = scratch(cli, "confine");
  cli.remove(dir, true).wait();
  Change made = cli.mkdir(dir, true).wait();
  t.isTrue(made.ok(), "could not make " + dir + " — " + made.message);
  if (!made.ok()) { return t.report(); }
  string home = dir + "/home";
  project(cli, t, dir);
  t.isTrue(lockAt(cli, dir, COMMIT), "the lock");

  // A manifest at the *repository* root, so `@/` inside the dependency means that root and the
  // escape is expressible at all. Without it these cases would pass for the wrong reason.
  t.isTrue(checkoutFile(cli, home, COMMIT, "wac.json5", "{}\n"), "the dependency's manifest");
  t.isTrue(checkoutFile(cli, home, COMMIT, "outside/bad.wac",
                        "export i32 bad() { return 66; }\n"), "the file outside the subdir");
  t.isTrue(checkoutFile(cli, home, COMMIT, "src/inside.wac",
                        "export i32 good() { return 2; }\n"), "a file inside it");

  string[] escapes = string[]("@/outside/bad.wac", "../outside/bad.wac");
  for (i32 i = 0; i < escapes.len(); i++) {
    t.isTrue(checkoutFile(cli, home, COMMIT, "src/lib.wac",
                          "import { bad } from \"" + escapes[i] + "\";\n" +
                          "export i32 two() { return bad(); }\n"), "lib importing " + escapes[i]);
    Exec r = wacc(cli, home, dir, "run", "src/main.wac");
    t.isTrue(r.ran(), "wac did not run — " + r.error);
    if (r.ran()) {
      string said = string.fromBytes(r.stderr) + string.fromBytes(r.stdout);
      // 71 is `bad() + 5`. Seeing it means the dependency reached out of the subdir it was mapped at.
      t.isTrue(r.status != 71, escapes[i] + " reached outside the mapped subdir");
      t.isTrue(r.status != 0, escapes[i] + " was accepted — " + said);
      t.isTrue(contains(said, "outside"),
               "the refusal did not say the import leaves the mapping — " + said);
    }
  }

  // **And the half that must keep working.** Confining is only correct if it does not also break an
  // ordinary import within the mapped directory.
  t.isTrue(checkoutFile(cli, home, COMMIT, "src/lib.wac",
                        "import { good } from \"@/src/inside.wac\";\n" +
                        "export i32 two() { return good(); }\n"), "lib importing inside the subdir");
  Exec ok = wacc(cli, home, dir, "run", "src/main.wac");
  t.isTrue(ok.ran(), "wac did not run — " + ok.error);
  if (ok.ran()) {
    t.eqI32(ok.status, 7, "an import inside the mapped subdir was refused: " +
                          string.fromBytes(ok.stderr));
  }
  cli.remove(dir, true).wait();
  return t.report();
}

/**
 * A confined dependency may still import a built-in — GitHub `voltrevo/wac#24`.
 *
 * **The other half of the case above, and it was open.** Confinement is a rule about the *filesystem*:
 * a dependency may not reach source outside what you mapped. `core` and `std` are not on the
 * filesystem at all — the compiler carries their text — so the containment test was being asked of a
 * path in the compiler's embedded base against a directory in the Git cache, which cannot pass. The
 * report is a real external one: `packages/json` was unusable as a Git dependency because
 * `value.wac` imports `core/map.wac`, while `packages/crypto` worked, so whether a package could be
 * *used* depended on whether its own import closure happened to cross a provider boundary.
 *
 * **Four combinations, because the issue asks for both providers from both mapping kinds** and the two
 * mapping kinds do different path arithmetic — `whole/lib/x.wac` appends the suffix to nothing,
 * `part/x.wac` appends it to `lib`. Distinct values summing to 15, so a file that did not run is named
 * by the arithmetic rather than by a bare failure.
 *
 * `core/result.wac` is one of the two deliberately: it imports `./option.wac`, *relatively*, from
 * inside the embedded tree. A fix that skipped the check for a built-in specifier but let the built-in
 * file inherit the importer's confinement would pass the `core/option.wac` row and fail this one, and
 * that is the fix I wrote first.
 */
export string test_a_mapped_dependency_may_import_a_builtin(Core core, Cli cli) {
  T t = T.create();
  string dir = scratch(cli, "mapped-builtin");
  string home = dir + "-home";
  cli.remove(dir, true).wait();
  cli.remove(home, true).wait();
  cli.mkdir(dir, true).wait();

  t.isTrue(put(cli, dir + "/wac.json5",
               "{\n  imports: {\n" +
               "    \"whole/\": { git: \"" + REPO + "\", ref: \"main\" },\n" +
               "    \"part/\": { git: \"" + REPO + "\", ref: \"main\", subdir: \"lib\" },\n" +
               "  },\n}\n"), "one whole-repository mapping and one subdir mapping");
  t.isTrue(put(cli, dir + "/wac.lock",
               "{\n  imports: {\n" +
               "    \"whole/\": { git: \"" + REPO + "\", ref: \"main\", commit: \"" + COMMIT + "\" },\n" +
               "    \"part/\": { git: \"" + REPO + "\", ref: \"main\", subdir: \"lib\", commit: \"" +
               COMMIT + "\" },\n" +
               "  },\n}\n"), "both pinned to one commit");

  // `core/result.wac` reaches `./option.wac` from inside the embedded tree; `core/option.wac` does
  // not reach anything. Both rows are needed and they fail for different reasons.
  t.isTrue(checkoutFile(cli, home, COMMIT, "lib/c1.wac",
                        "import { Result } from \"core/result.wac\";\n" +
                        "export i32 c1() { Result<i32, bool> r = Result.Ok(1); return r.orElse(0); }\n"),
           "a dependency file importing core/result.wac");
  t.isTrue(checkoutFile(cli, home, COMMIT, "lib/c2.wac",
                        "import { Option } from \"core/option.wac\";\n" +
                        "export i32 c2() { Option<i32> o = Option.Some(2); return o.orElse(0); }\n"),
           "a dependency file importing core/option.wac");
  t.isTrue(checkoutFile(cli, home, COMMIT, "lib/s1.wac",
                        "import { Cli } from \"std/platform.wac\";\n" +
                        "export i32 s1(Cli c) { return 4; }\n"),
           "a dependency file importing std/platform.wac");
  t.isTrue(checkoutFile(cli, home, COMMIT, "lib/s2.wac",
                        "import { Cli } from \"std/platform.wac\";\n" +
                        "export i32 s2(Cli c) { return 8; }\n"),
           "a second dependency file importing std/platform.wac");

  // `c1` and `s1` through the whole repository; `c2` and `s2` through the subdir.
  t.isTrue(put(cli, dir + "/src/main.wac",
               "import { c1 } from \"whole/lib/c1.wac\";\n" +
               "import { s1 } from \"whole/lib/s1.wac\";\n" +
               "import { c2 } from \"part/c2.wac\";\n" +
               "import { s2 } from \"part/s2.wac\";\n" +
               "import { Cli, Core } from \"std/platform.wac\";\n" +
               "export i32 main(Core core, Cli cli) { return c1() + c2() + s1(cli) + s2(cli); }\n"),
           "an entry reaching both providers through both mapping kinds");

  Exec r = wacc(cli, home, dir, "run", "src/main.wac");
  t.isTrue(r.ran(), "wac did not run — " + r.error);
  if (r.ran()) {
    t.eqI32(r.status, 15,
            "answered " + itoa(r.status) + ", want 15 — a mapped dependency may import core and " +
            "std, from a whole-repository mapping and from a subdir one: " +
            string.fromBytes(r.stderr));
  }
  cli.remove(dir, true).wait();
  cli.remove(home, true).wait();
  return t.report();
}

/**
 * A whole-repository mapping and a `subdir` one land on the same file, and it is one module — D8.
 *
 * **The spelling the existing case cannot reach.** `test_two_mappings_at_one_commit_are_one_module`
 * above uses two names with the *same* `subdir`, and says of itself that it guards the construction
 * rather than a rule: both names do identical arithmetic, so nothing could make them differ. These
 * two do *different* arithmetic — `whole/lib/x.wac` appends the suffix to nothing, `part/x.wac`
 * appends it to `lib` — and have to meet at one path. That is `locate`'s half of D9 and D8's
 * identity in the same case.
 *
 * A value crosses between them, so agreement is not about paths looking alike: wac's types are
 * nominal, and two modules would be two `Item`s that cannot be passed to one another.
 *
 * `design/lang/0009`'s D8 note asks for four spellings; with this one and
 * `projectspec_test.wac`'s relative-against-`@/` case, three of the four are asserted. The fourth —
 * two mappings at *different* commits being two modules — is the negative half and is still open.
 */
export string test_a_whole_repo_and_a_subdir_mapping_meet_at_one_module(Core core, Cli cli) {
  T t = T.create();
  string dir = scratch(cli, "mapped-twoshapes");
  string home = dir + "-home";
  cli.remove(dir, true).wait();
  cli.remove(home, true).wait();
  cli.mkdir(dir, true).wait();

  // `whole/` takes the repository; `part/` takes `lib` out of the same commit. D9 permits both: the
  // names do not overlap, which is the only thing it forbids.
  t.isTrue(put(cli, dir + "/wac.json5",
               "{\n  imports: {\n" +
               "    \"whole/\": { git: \"" + REPO + "\", ref: \"main\" },\n" +
               "    \"part/\": { git: \"" + REPO + "\", ref: \"main\", subdir: \"lib\" },\n" +
               "  },\n}\n"), "one whole-repository mapping and one subdir mapping");
  t.isTrue(put(cli, dir + "/wac.lock",
               "{\n  imports: {\n" +
               "    \"whole/\": { git: \"" + REPO + "\", ref: \"main\", commit: \"" + COMMIT + "\" },\n" +
               "    \"part/\": { git: \"" + REPO + "\", ref: \"main\", subdir: \"lib\", commit: \"" +
               COMMIT + "\" },\n" +
               "  },\n}\n"), "both pinned to one commit");
  t.isTrue(put(cli, home + "/cache/git/" + escapeRepo(REPO) + "/" + COMMIT + "/lib/item.wac",
               "export struct Item { i32 v; i32 get(const this) { return this.v; } }\n" +
               "export Item make() { return Item(4); }\n"), "the one file, under lib/");

  // The two specifiers are spelled differently and resolve to the same path.
  t.isTrue(put(cli, dir + "/src/a.wac",
               "import { Item, make } from \"whole/lib/item.wac\";\n" +
               "export Item mk() { return make(); }\n"), "reached through the whole repository");
  t.isTrue(put(cli, dir + "/src/b.wac",
               "import { Item } from \"part/item.wac\";\n" +
               "export i32 take(Item x) { return x.get(); }\n"), "reached through the subdir");
  t.isTrue(put(cli, dir + "/src/main.wac",
               "import { mk } from \"./a.wac\";\n" +
               "import { take } from \"./b.wac\";\n" +
               "export i32 main() { return take(mk()) + 3; }\n"), "main");

  Exec r = wacc(cli, home, dir, "run", "src/main.wac");
  t.isTrue(r.ran(), "wac did not run — " + r.error);
  if (r.ran()) {
    t.eqI32(r.status, 7,
            "answered " + itoa(r.status) + ", want 7 — a whole-repository mapping and a subdir " +
            "mapping that land on one file are one module: " + string.fromBytes(r.stderr));
  }
  cli.remove(dir, true).wait();
  cli.remove(home, true).wait();
  return t.report();
}

/**
 * Two mappings at **different** commits are two modules — D8's negative half.
 *
 * **The half that can actually fail for D8's reason**, which is why the design note asks for it. The
 * three positive spellings all assert that two routes meet; each of them passes as long as the key is
 * the path, and the key *is* the path by construction. This one asserts they do **not** meet, and it
 * is the only one a canonicalisation that over-merged would break: fold the commit out of the key —
 * anything that keys a mapped file by repository and path alone — and these two become one module,
 * this program compiles, and a value from one commit is passed to a function expecting the other's
 * type.
 *
 * wac's types are nominal, so two modules mean two `Item`s and the program must be refused. The
 * assertion is on the refusal rather than on a number, because there is no number a wrong answer
 * would produce — it would compile and run.
 */
export string test_two_mappings_at_different_commits_are_two_modules(Core core, Cli cli) {
  T t = T.create();
  string dir = scratch(cli, "mapped-twocommits");
  string home = dir + "-home";
  string other = "89abcdef0123456789abcdef0123456789abcdef";
  cli.remove(dir, true).wait();
  cli.remove(home, true).wait();
  cli.mkdir(dir, true).wait();

  t.isTrue(put(cli, dir + "/wac.json5",
               "{\n  imports: {\n" +
               "    \"old/\": { git: \"" + REPO + "\", ref: \"v1\" },\n" +
               "    \"new/\": { git: \"" + REPO + "\", ref: \"v2\" },\n" +
               "  },\n}\n"), "two names for one repository at two refs");
  t.isTrue(put(cli, dir + "/wac.lock",
               "{\n  imports: {\n" +
               "    \"old/\": { git: \"" + REPO + "\", ref: \"v1\", commit: \"" + COMMIT + "\" },\n" +
               "    \"new/\": { git: \"" + REPO + "\", ref: \"v2\", commit: \"" + other + "\" },\n" +
               "  },\n}\n"), "pinned to two different commits");

  // The *same* declaration in both checkouts. Identical source, so nothing but the commit
  // distinguishes them — which is the whole point: if the commit is not part of the identity, these
  // are one type.
  string decl = "export struct Item { i32 v; i32 get(const this) { return this.v; } }\n" +
                "export Item make() { return Item(4); }\n";
  t.isTrue(put(cli, home + "/cache/git/" + escapeRepo(REPO) + "/" + COMMIT + "/item.wac", decl),
           "the old checkout");
  t.isTrue(put(cli, home + "/cache/git/" + escapeRepo(REPO) + "/" + other + "/item.wac", decl),
           "the new checkout");

  t.isTrue(put(cli, dir + "/src/main.wac",
               "import { make } from \"old/item.wac\";\n" +
               "import { Item } from \"new/item.wac\";\n" +
               "export i32 main() { Item x = make(); return x.get(); }\n"),
           "a value from one commit into the other's type");

  Exec r = wacc(cli, home, dir, "run", "src/main.wac");
  t.isTrue(r.ran(), "wac did not run — " + r.error);
  if (r.ran()) {
    string said = string.fromBytes(r.stderr) + string.fromBytes(r.stdout);
    t.isTrue(r.status != 0,
             "two commits were treated as one module: a value from " + COMMIT.slice(0, 8) +
             " was accepted as the type from " + other.slice(0, 8) + " — " + said);
    // 4 is what it answers if they *are* merged, which is the specific wrong outcome.
    t.isTrue(r.status != 4, "the two commits merged into one module and the program ran — " + said);
  }
  cli.remove(dir, true).wait();
  cli.remove(home, true).wait();
  return t.report();
}
