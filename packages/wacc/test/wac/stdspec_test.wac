// `std` — the capability half of the built-in trees, `design/lang/0009` D4.
//
// `[§wac-std-reserved-5kt8nqw]` `[§wac-std-no-root-2vp6xmk]` `[§wac-std-imports-core-7hn3qrz]`
//
// **These cases ask wacc only**, which was a finding when there were two compilers and is simply
// the situation now. `std` could never be asked of the TypeScript reference: it carried none of
// this tree, since `std/platform.wac` uses lambdas and that frontend had none — 129 parse errors,
// every one cascading from the single `(i32 id) => …` at line 286. So the reference's half of the
// differential was its *refusal*, and that case is deleted with it, along with the neighbouring
// comparison in `projectspec_test.wac`.
//
// The cases are the three that can each be wrong in a way the others would not catch:
//
//   1. the specifier resolves at all, out of the compiler rather than off the disk;
//   2. **a real `std/platform.wac` on disk does not win** — which is the whole of the reservation,
//      and the only case that separates "reserved" from "resolved like any other relative path";
//   3. a bare `std` is refused by *naming the file to write*, not by `cannot read std` — the tree
//      has no root module, so the specifier is neither a file nor a built-in and the reader would
//      otherwise fall through to path arithmetic and report a sentence about a file.

import { T } from "../../../wactest/src/assert.wac";
import { binaryPath, putFile, scratch } from "../../../wactest/src/host.wac";
import { contains } from "../../../wactest/src/strings.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { Change, Cli, Core, Exec } from "std/platform.wac";

/**
 * `wac <cmd> <args…>` **with the working directory inside the fixture**, which is the whole point.
 *
 * `cli.exec` inherits this process's directory, and the suite runs at the repository root — where
 * `std/platform.wac` and `core/` are real files at exactly the paths the built-in specifiers name.
 * So a compiler that had never served `std` from inside itself, and simply read the path off disk,
 * passed every case here. It did: the gatherer in `example/wacc.wac` was missing `stdFile` for a day
 * and nothing went red until somebody ran `wac` in a directory of their own.
 *
 * Running through `sh -c 'cd … && …'` is what makes these cases able to fail.
 */
Exec wacc(Cli cli, string dir, string cmd, string[] args) {
  string line = "cd " + dir + " && exec " + binaryPath(cli) + " " + cmd;
  for (i32 i = 0; i < args.len(); i++) { line = line + " '" + args[i] + "'"; }
  return cli.exec("/bin/sh", string[]("-c", line), u8[0]()).wait();
}

/** `deno run -A harness/<tool>.ts <args…>`, from the repository root. */
/** One file, with its directory made first. */
/**
 * One implementation, in `wactest/src/host.wac`.
 *
 * These four lines were in five test files, byte for byte, and each threw away the `mkdir`'s answer. Not
 * silently — `writeFile` then failed too and the `bool` carried that — so the failure was *misattributed*
 * rather than lost: "could not write x" where the cause was the directory above it.
 *
 * What this buys is one implementation instead of five, and a `putFile` that names the real cause for
 * anything written from here on. The `bool` is kept because 53 call sites assert on it, and it drops the
 * reason at this boundary — so the misattribution is fixed for a caller that asks `putFile` directly and
 * not for these. `issues/system/0229`.
 */
bool put(Cli cli, string path, string text) { return putFile(cli, path, text) == ""; }

export string test_a_std_specifier_resolves_out_of_the_compiler(Core core, Cli cli) {
  T t = T.create();
  string dir = scratch(cli, "stdspec-one");
  cli.remove(dir, true).wait();
  Change made = cli.mkdir(dir, true).wait();
  t.isTrue(made.ok(), "could not make " + dir + " — " + made.message);
  if (!made.ok()) { return t.report(); }

  // No manifest and no `std/` directory: nothing on disk answers for this specifier, which is the
  // point — the text comes out of the compiler the way `core`'s does.
  t.isTrue(put(cli, dir + "/main.wac",
               "import { Cli, Core } from \"std/platform.wac\";\n" +
               "export i32 main(Core core, Cli cli) { return 7; }\n"), "wrote main");

  Exec w = wacc(cli, dir, "run", string[]("main.wac"));
  t.isTrue(w.ran(), "wac did not run — " + w.error);
  if (w.ran()) {
    t.eqI32(w.status, 7, "wacc answered " + itoa(w.status) + ", want 7 — " +
                         string.fromBytes(w.stderr));
  }
  cli.remove(dir, true).wait();
  return t.report();
}

export string test_a_projects_own_std_directory_does_not_shadow_the_builtin(Core core, Cli cli) {
  T t = T.create();
  string dir = scratch(cli, "stdspec-shadow");
  cli.remove(dir, true).wait();
  Change made = cli.mkdir(dir, true).wait();
  t.isTrue(made.ok(), "could not make " + dir + " — " + made.message);
  if (!made.ok()) { return t.report(); }

  t.isTrue(put(cli, dir + "/main.wac",
               "import { Cli, Core } from \"std/platform.wac\";\n" +
               "export i32 main(Core core, Cli cli) { return 7; }\n"), "wrote main");
  // **A decoy at exactly the specifier's path.** It declares neither `Cli` nor `Core`, so if the
  // resolver preferred the file the program would not compile at all — which is what makes 7 an
  // answer about *which* module was reached rather than about arithmetic that happened to agree.
  t.isTrue(put(cli, dir + "/std/platform.wac",
               "export i32 decoy() { return 999; }\n"), "wrote the decoy");

  Exec w = wacc(cli, dir, "run", string[]("main.wac"));
  t.isTrue(w.ran(), "wac did not run — " + w.error);
  if (w.ran()) {
    t.eqI32(w.status, 7, "a std/ directory beside the entry won: wacc answered " + itoa(w.status) +
                         " — " + string.fromBytes(w.stderr));
  }
  cli.remove(dir, true).wait();
  return t.report();
}

export string test_a_bare_std_names_the_file_to_write_instead(Core core, Cli cli) {
  T t = T.create();
  string dir = scratch(cli, "stdspec-root");
  cli.remove(dir, true).wait();
  Change made = cli.mkdir(dir, true).wait();
  t.isTrue(made.ok(), "could not make " + dir + " — " + made.message);
  if (!made.ok()) { return t.report(); }

  t.isTrue(put(cli, dir + "/main.wac",
               "import { Core } from \"std\";\n" +
               "export i32 main(Core core) { return 1; }\n"), "wrote main");

  Exec w = wacc(cli, dir, "run", string[]("main.wac"));
  t.isTrue(w.ran(), "wac did not run — " + w.error);
  if (w.ran()) {
    string said = string.fromBytes(w.stderr);
    t.isTrue(w.status != 1 || contains(said, "no root module"),
             "a bare \"std\" did not say it has no root module — " + said);
    // **The wrong answer this exists to keep out.** `cannot read std` is a sentence about a file,
    // for a word that was never going to be one; a reader who gets it goes looking on disk.
    t.isTrue(!contains(said, "cannot read std"),
             "a bare \"std\" fell through to path arithmetic — " + said);
    t.isTrue(contains(said, "std/platform.wac"),
             "the refusal did not name a file that would work — " + said);
  }
  cli.remove(dir, true).wait();
  return t.report();
}
