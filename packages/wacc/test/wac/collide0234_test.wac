// Declaring a struct a library uses internally breaks the library. `issues/lang/0234a`.
//
//     wac test --allow-read --allow-write --allow-run --allow-env \
//       packages/wacc/test/wac/collide0234_test.wac
//
// **This pins a bug, deliberately.** One file declares `export struct Arm` and never uses it; a second
// imports a function from it and also imports `packages/wacc/src/api.wac`. `wac check` reports the
// program clean and `wac build` declines it, five levels from the cause. When the bug is fixed this
// test fails and points here, which is the whole reason it asserts the broken answer rather than
// hoping someone notices.
//
// **Why it writes files and runs the binary.** The in-process route cannot express it: a four-source
// imitation of the shape — a library file declaring the struct, a second reading a member of it, the
// colliding declaration and an entry importing both — is clean on `dumpTypeErrorsFiles`,
// `blockedFiles` and `emitDeclineFiles` alike, with and without the collision. The ingredient is
// wacc's real graph, where `parse.wac` is walked before `ast.wac` and so resolves `Arm` against a
// declaration table that does not contain the real one yet.
//
// **And the control is the point**: the same program with the struct renamed builds and runs. Without
// it this test would pass just as well against a compiler that refused everything.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli, Exec, Change } from "std/platform.wac";
import { wacBinary } from "../../../wactest/src/built.wac";

/** The two files, with `name` as the colliding struct. Returns false if anything could not be written. */
bool writeTree(Cli cli, string dir, string name) {
  cli.mkdir(dir, true).wait();
  Change a = cli.writeFile(dir + "/one.wac",
      ("export struct " + name + " { i32 x; }\nexport i32 one() { return 1; }\n").toBytes()).wait();
  if (a.fault != 0) { return false; }
  // `../..` from `.cache/<dir>/` back to the repository root, then into the compiler's own source.
  return cli.writeFile(dir + "/agg.wac",
      ("import { one } from \"./one.wac\";\n" +
       "import { dumpTypeErrors } from \"../../packages/wacc/src/api.wac\";\n" +
       "export i32 main() { return one() + " +
       "dumpTypeErrors(\"export i32 g() { return 1; }\".toBytes()).len(); }\n").toBytes())
      .wait().fault == 0;
}

string buildIn(Cli cli, string dir) {
  Exec r = cli.exec("/bin/sh",
    string[]("-c", "cd '" + dir + "' && '" + wacBinary(cli) + "' build agg.wac -o m 2>&1"),
    u8[0]()).wait();
  return string.fromBytes(r.stdout) + string.fromBytes(r.stderr);
}

string checkIn(Cli cli, string dir) {
  Exec r = cli.exec("/bin/sh",
    string[]("-c", "cd '" + dir + "' && '" + wacBinary(cli) + "' check agg.wac 2>&1"),
    u8[0]()).wait();
  return string.fromBytes(r.stdout) + string.fromBytes(r.stderr);
}

/**
 * The bug, asserted as it behaves today.
 *
 * `Arm` is one of three `ast.wac` exports that do this — `Param` and `Stmt` are the others, and the
 * six that do not are `Case`, `Expr`, `Ty`, `Decl`, `Method` and `Program`. One name is enough here:
 * what is being pinned is that the class exists, not its membership, which `issues/lang/0234a`
 * records.
 */
export string test_a_colliding_struct_name_breaks_the_library_it_never_names(Core core, Cli cli) {
  T t = T.create();
  string dir = cli.cwd().wait() + "/.cache/collide0234";
  cli.remove(dir, true).wait();
  t.isTrue(writeTree(cli, dir, "Arm"), "wrote the tree");

  // The checker sees nothing, which is half of why this is hard to diagnose in the wild.
  string checked = checkIn(cli, dir);
  t.isTrue(checked.indexOf("no diagnostics") >= 0,
      "the checker reported something — has 0234a been fixed? " + checked);

  string built = buildIn(cli, dir);
  t.isTrue(built.indexOf("cannot emit") >= 0,
      "the build succeeded — 0234a may be fixed, in which case delete this test and close it: " + built);
  // The cascade is what makes it diagnosable at all; it arrived with `issues/lang/0170a`.
  t.isTrue(built.indexOf("untyped member") >= 0,
      "the decline no longer ends at `untyped member` — the cause may have moved: " + built);
  cli.remove(dir, true).wait();
  return t.report();
}

/** The control: rename the struct and the identical program builds. */
export string test_the_same_program_with_the_struct_renamed_builds(Core core, Cli cli) {
  T t = T.create();
  string dir = cli.cwd().wait() + "/.cache/collide0234-ok";
  cli.remove(dir, true).wait();
  t.isTrue(writeTree(cli, dir, "Zork"), "wrote the tree");
  string built = buildIn(cli, dir);
  t.isTrue(built.indexOf("cannot emit") < 0,
      "a name the compiler does not declare was refused too, so the collision is not what matters: "
      + built);
  cli.remove(dir, true).wait();
  return t.report();
}
