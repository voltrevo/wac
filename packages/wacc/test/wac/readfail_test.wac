// A file the reader cannot open is named *and* attributed to the import that asked for it.
//
//     wac test --allow-read --allow-write --allow-run --allow-env packages/wacc/test/wac/readfail_test.wac
//
// This is the message a person actually gets, and it said less than the compiler knew:
//
//     before   wacc: cannot read shared/gone.wac
//     after    wacc: cannot read shared/gone.wac (app/lib.wac imports it as "../shared/gone.wac")
//
// The importer and the specifier are in scope where `gather` queues a path and gone by the time the
// read fails two hundred lines later, so the walk carries them — the same shape as `linkFiles`'s queue
// and for the same reason. `issues/lang/0157`.
//
// **The emitter's version of this refusal was fixed first and is the one nobody sees.** `wac build`
// reaches it only when `gather` succeeded and the linker resolved to a different key; the common case
// fails here, in the reader, which is why this message was worth more than that one.

import { T } from "../../../wactest/src/assert.wac";
import { Exec, ChildEnv, Env, Files, Launch, Procs, Sys } from "std";
import { wacBinary } from "../../../wactest/src/built.wac";
import { putFile } from "../../../wactest/src/host.wac";
import { flatten } from "core";

/**
 * A two-file project whose *second* file imports something that is not there.
 *
 * **The reason, not a `bool`.** This built `dir + "/app"` with an unchecked `mkdir` and answered
 * whether the *write* worked, so a directory that could not be made was reported to the reader as
 * "wrote the tree" failing — the wrong half of the fixture, on a test whose whole subject is a
 * message naming the right thing. `putFile` makes the directory above and names either cause, which
 * is why there is no `mkdir` here any more rather than a checked one. `issues/system/0229`.
 */
string writeTree(Files fs, string dir) {
  string why = putFile(fs, dir + "/app/main.wac", "// A comment naming \"../shared/gone.wac\" before the real import, so a search for the text\n" +
      "// cannot take the easy one.\n" +
      "import { helper } from \"./lib.wac\";\nexport i32 f() { return helper(); }\n");
  if (why != "") { return why; }
  return putFile(fs, dir + "/app/lib.wac", "import { missing } from \"../shared/gone.wac\";\n" +
      "export i32 helper() { return missing(); }\n");
}

string checkIn(Env env, Procs procs, string dir, string entry) {
  auto rRan = flatten(procs.exec("/bin/sh", ["-c", "cd '" + dir + "' && '" + wacBinary(env) + "' check " + entry + " 2>&1"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  return string.fromBytes(r!.stdout) + string.fromBytes(r!.stderr);
}

export string test_a_file_that_cannot_be_read_names_the_import_that_asked(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = flatten(env.cwd().wait()).unwrap() + "/.cache/readfail";
  fs.remove(dir, true).wait();
  string whyTree = writeTree(fs, dir);
  t.isTrue(whyTree == "", whyTree);
  string said = checkIn(env, procs, dir, "app/main.wac");
  t.isTrue(said.indexOf("cannot read") >= 0, "did not refuse — " + said);
  t.isTrue(said.indexOf("shared/gone.wac") >= 0, "did not name the file — " + said);
  // **The importer is the second file, not the entry** — so naming it cannot be an accident of
  // printing whatever was being compiled.
  t.isTrue(said.indexOf("app/lib.wac") >= 0, "did not name the importer — " + said);
  t.isTrue(said.indexOf("../shared/gone.wac") >= 0, "did not name the specifier — " + said);
  fs.remove(dir, true).wait();
  return t.report();
}

/**
 * And the entry file itself, which has no importer to name.
 *
 * The control: a sentence that always appends "(x imports it as …)" would be wrong here, and this is
 * the one file in any program that nothing asked for.
 */
export string test_the_entry_file_itself_is_named_alone(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = flatten(env.cwd().wait()).unwrap() + "/.cache/readfail-entry";
  fs.remove(dir, true).wait();
  string whyTree = writeTree(fs, dir);
  t.isTrue(whyTree == "", whyTree);
  string said = checkIn(env, procs, dir, "app/nosuch.wac");
  t.isTrue(said.indexOf("cannot read") >= 0, "did not refuse — " + said);
  t.isTrue(said.indexOf("imports it as") < 0, "invented an importer for the entry — " + said);
  fs.remove(dir, true).wait();
  return t.report();
}
