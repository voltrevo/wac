// Rung 5, the whole claim: **stage 2 equals stage 3**.
//
// `test/wac/fixpointemit_test.wac` puts one source file through both stages. This puts *the
// compiler* through them. Stage A is `wacc` built by the reference; stage B is `wacc` built by stage
// A; and stage C is what stage B produces when it is asked to compile `wacc`. If B and C are the
// same bytes, the compiler reproduces itself, which is what a bootstrap means and what nothing short
// of running it can show.
//
// The awkward part is the boundary: `emitFiles(string[], string[], string)` cannot be called from a
// host on a module emitted here by hand. It does not have to be — the driver is wac, so it builds
// those arrays itself. Every source in the entry's import closure is embedded in it as chunked
// string literals, and the driver hands them to `emitFiles` from inside the module.
//
// Three things are compared, and the third ties this to the rest of the suite: the bytes stage B
// produces must equal the bytes the *test* gets from `emitFiles` directly, which is the number
// `test/wac/selfemit_test.wac` and the corpus test are measuring all along.
//
//
// **9.4s warm, and it is two compilers.** Re-measured 2026-08-19 with `core.monotonicNanos()` either
// side of each phase, which is the only way to tell these apart — the earlier split in this header had
// gone three-fold stale without anything failing:
//
//     driver         16ms      assembling 1.4 MB of literals
//     stage A        10ms      cached; 6797ms when a wacc source changes and the reference re-runs
//     stage B emit 1943ms      compiling that driver
//     stage B run  5201ms      one emit of wacc (~1.9s) plus `blockedFiles` over it (~3.3s)
//     direct       1844ms      the third opinion
//
// **`fold` used to emit the compiler twice.** It was `wholeLen() + wholeSum() + blockedLen()`, and the
// first two each call `whole()` — so stage B compiled wacc twice and then checked it, 7109ms. Taken
// from one emit it is 5201ms, and the three numbers are the same: a compiler that answered differently
// between two emits of one input is the defect this test exists to catch.
//
// The floor fell too, and not from anything here: `wac test` on one file used to recompile the file's
// whole graph every run — 5.9s for anything importing `api.wac` — until a lone file's module was
// cached like a directory's (`issues/system/0204`).
//
// So most of it was one process, and **stage A is a pure function of the driver and the reference** —
// the driver carries every wacc source as a literal, so its checksum moves when any of them does.
// Those three answers are cached under `.cache`, keyed on that checksum, on `compiler/`'s newest
// mtime and on the binary's. Cold — a wacc source changed, `compiler/` changed, or the host was
// rebuilt — it costs what it always did, which is the run where this test has something to say.
//
// **Stage A only.** Stage B is recomputed every run whatever the cache holds: a differential with one
// remembered side is still a differential, and one with two is nothing. Canaried three ways — a wacc
// source's *content*, the reference's mtime, and a poisoned cache file, which fails the comparison
// rather than passing it.
// ## Host-side until 2026-08-18, `issues/system/0161`
//
// The reference answers through `referenceRun.ts <driver> <export…>`, which prints a whole `i32`;
// ours answers through `wac <module.wasm> fold`, which prints one too. The three answers still fold
// into one checksum, and the two canaries — that stage A declines nothing and emits something
// substantial — ride along in the same reference process.
//
// **The driver's own closure, not the whole corpus.** The reference parses *every* file it is given,
// so handing it the repository meant every corpus file had to be parseable by it, and a wacc-only
// feature anywhere in the tree failed this while naming a file the driver never imports.
// `issues/lang/0139`.
//
// **It is back in the regular lane, and that is what the one-compile change bought.** It was declared
// heavy at 26s because the driver was compiled four times, once per byte of the fold, and the reference
// was asked three separate questions about a module that embeds the whole compiler as string literals.
// One compile and one reference process is 10s, measured — and a self-host differential that runs on
// every push is worth more than a fuzz sweep that does, which is the trade: `packages/gzip`'s 2,700
// corrupted streams took the heavy slot this gave up, and kept a 24-case sample in the regular lane.

import { T } from "../../../wactest/src/assert.wac";
import { itoa, atoi } from "../../../fmt/src/itoa.wac";
import { trimmed, splitLines } from "../../../wactest/src/strings.wac";
import { Buf } from "../../../bytes/src/buf.wac";
import { Core, Cli, Exec, Change, Stat, FileResult } from "std/platform.wac";
import { emitFiles, emitFilesSelfDescribing } from "../../src/api.wac";
import { Corpus, loadCorpus } from "./corpus_probe.wac";
import { Ran, runModule, wasRejected, scratchDir } from "./artifacts_probe.wac";
import { closureOf, literalOf, chunkedLiteral } from "./source_probe.wac";

const string ENTRY = "packages/wacc/src/api.wac";
const string DRIVER = ".cache/_selfhost.wac";

/** The same checksum the driver computes, so the two can be compared at all. */
i32 checksum(u8[] b) {
  i32 h = 7;
  for (i32 i = 0; i < b.len(); i++) { h = (h * 31 + b[i]) & 2147483647; }
  return h;
}

/**
 * A driver carrying every source in wacc's closure, folded into one export and with **no `main`**.
 *
 * No `main` is what makes one compile enough: `wac <module.wasm> fold` calls the named export and
 * prints the whole word, and a module with a `main` never reaches that path — the arguments go to
 * `main`, whose answer is an eight-bit exit status (`issues/system/0184`). This used to be compiled
 * once per byte of the fold: four compiles of the whole compiler, for what one gives.
 *
 * The closure is embedded rather than imported because the point is that *stage B* builds the file
 * table and calls `emitFiles` on it — a driver that imported these would be asking the linker the
 * question instead.
 */
string driverFor(string[] paths, string[] sources) {
  Buf out = Buf.create();
  out.pushAll("import { emitFiles, blockedFiles } from \"../packages/wacc/src/api.wac\";\n\n".toBytes());
  for (i32 i = 0; i < paths.len(); i++) {
    out.pushAll(("string src" + itoa(i) + "() { return ").toBytes());
    out.pushAll(chunkedLiteral(sources[i]).toBytes());
    out.pushAll("; }\n\n".toBytes());
  }
  out.pushAll(("i32 sumBytes(u8[] b) {\n" +
               "  i32 h = 7;\n" +
               "  for (i32 i = 0; i < b.len(); i++) { h = (h * 31 + b[i]) & 2147483647; }\n" +
               "  return h;\n" +
               "}\n\n").toBytes());

  Buf fill = Buf.create();
  for (i32 i = 0; i < paths.len(); i++) {
    fill.pushAll(("  ps[" + itoa(i) + "] = " + literalOf(paths[i]) + ";\n" +
                  "  ss[" + itoa(i) + "] = src" + itoa(i) + "();\n").toBytes());
  }
  string filled = string.fromBytes(fill.take());
  string decl = "  string[] ps = string[" + itoa(paths.len()) + "]();\n" +
                "  string[] ss = string[" + itoa(paths.len()) + "]();\n";

  out.pushAll(("u8[] whole() {\n" + decl + filled +
               "  return emitFiles(ps, ss, " + literalOf(ENTRY) + ");\n}\n\n" +
               "export i32 wholeLen() { return whole().len(); }\n" +
               "export i32 wholeSum() { return sumBytes(whole()); }\n" +
               "export i32 blockedLen() {\n" + decl + filled +
               "  return blockedFiles(ps, ss, " + literalOf(ENTRY) + ").len();\n}\n\n" +
               // **One emit, not two.** `wholeLen()` and `wholeSum()` each call `whole()`, so a `fold`
               // written as `wholeLen() + wholeSum() + blockedLen()` compiled the entire compiler
               // twice and then checked it a third time — 7109ms of stage B on 2026-08-19, measured
               // with `core.monotonicNanos()` either side. The three numbers are the same taken from
               // one emit, and a compiler that answered differently is the defect this test exists to
               // catch, so nothing is lost by asking once. The exports stay: the reference is asked for
               // `wholeLen` separately, as the canary that stage A emitted something substantial.
               "export i32 fold() {\n" +
               "  u8[] w = whole();\n" +
               "  i32 s = 7;\n" +
               "  s = s * 31 + w.len();\n" +
               "  s = s * 31 + sumBytes(w);\n" +
               "  s = s * 31 + blockedLen();\n" +
               "  return s;\n" +
               "}\n").toBytes());
  return string.fromBytes(out.take());
}

const string STAGE_A = ".cache/_selfhost_stageA.txt";

/**
 * What produced stage A's answers: the driver, and the compiler that runs it.
 *
 * The driver carries every one of wacc's sources as string literals, so its checksum moves whenever
 * any of them does — one number covering the whole input. The other half is the *reference*, which is
 * `compiler/` and `harness/referenceRun.ts`: its newest modification time, by the rule
 * `tools/seedFresh.test.ts` uses for the seed. Both halves matter and neither implies the other.
 *
 * The binary is in there too, and it is the half a source walk cannot see: stage B is emitted by the
 * seed inside `wac` and *run* by its runtime, so a rebuilt host can change this test's answer with
 * every source in the repository untouched.
 */
string stageAKey(Cli cli, u8[] driver) {
  i64 newest = 0 as i64;
  Stat run = cli.stat("harness/referenceRun.ts").wait();
  if (run.exists) { newest = run.modifiedMillis; }
  Stat bin = cli.stat(cli.cwd().wait() + "/native/v8/target/release/wac").wait();
  if (bin.exists && bin.modifiedMillis > newest) { newest = bin.modifiedMillis; }
  string[]? names = cli.readDir("compiler").wait();
  if (names is null) { return ""; }
  string[] here = names!;
  for (i32 i = 0; i < here.len(); i++) {
    Stat f = cli.stat("compiler/" + here[i]).wait();
    if (f.exists && f.modifiedMillis > newest) { newest = f.modifiedMillis; }
  }
  // An empty key is "cannot say", and a cache that cannot say is not read or written.
  if (newest == (0 as i64)) { return ""; }
  return itoa(checksum(driver)) + ":" + itoa((newest / (1000 as i64)) as! i32);
}

/**
 * Stage A's three answers, from `.cache` when the key still holds.
 *
 * **5.7s of this test's 9.2s was this one process**, measured 2026-08-19: deno starting, the
 * reference compiling a 1.4 MB driver, and three exports that each re-derive a whole compiler. It is
 * a pure function of the driver and the reference, so it is cached — and stage B, the half this test
 * is actually about, is recomputed on every run whatever the cache says. A differential where one
 * side is remembered is still a differential; one where *both* sides are remembered is nothing, which
 * is why the cache holds stage A alone.
 *
 * Cold — a wacc source changed, or `compiler/` did — it costs exactly what it always did, which is
 * the run where this test has something to say.
 */
i32[] cachedStageA(Cli cli, string key, i32 want, i32[] okOut) {
  okOut[0] = 0;
  if (key == "") { return i32[want](); }
  FileResult f = cli.readFile(STAGE_A).wait();
  if (!f.ok) { return i32[want](); }
  string[] lines = splitLines(string.fromBytes(f.bytes));
  if (lines.len() < want + 1) { return i32[want](); }
  if (trimmed(lines[0]) != key) { return i32[want](); }
  i32[] out = i32[want]();
  for (i32 i = 0; i < want; i++) { out[i] = atoi(trimmed(lines[i + 1])); }
  okOut[0] = 1;
  return out;
}

void writeStageA(Cli cli, string key, i32[] said) {
  if (key == "") { return; }
  string body = key + "\n";
  for (i32 i = 0; i < said.len(); i++) { body = body + itoa(said[i]) + "\n"; }
  cli.writeFile(STAGE_A, body.toBytes()).wait();
}

/**
 * Stage A's answers to several exports, one line each, in **one** process.
 *
 * The driver carries the whole compiler as string literals, so the reference compiles it once per
 * process — and this test asks it three things. Asking for them together is the difference between
 * one of those compiles and three.
 */
i32[] referenceAnswers(Cli cli, string exports, i32 want, i32[] okOut) {
  okOut[0] = 0;
  Exec r = cli.exec("deno", string[]("run", "-A", "harness/referenceRun.ts", DRIVER, exports),
                    u8[0]()).wait();
  if (!r.ran() || r.status != 0) { return i32[want](); }
  string[] lines = splitLines(string.fromBytes(r.stdout));
  i32[] out = i32[want]();
  i32 n = 0;
  for (i32 i = 0; i < lines.len() && n < want; i++) {
    if (trimmed(lines[i]).len() == 0) { continue; }
    out[n] = atoi(trimmed(lines[i]));
    n = n + 1;
  }
  // Fewer lines than exports means one of them trapped part way, which is not the same as a run that
  // answered — the caller checks this before reading the values.
  if (n == want) { okOut[0] = 1; }
  return out;
}

export string test_rung_5_wacc_compiled_by_wacc_compiles_wacc_to_the_same_bytes(
    Core core, Cli cli) {
  T t = T.create();
  Corpus c = loadCorpus(cli, "selfhostemit_test");
  t.isTrue(c.ok, "the corpus loaded — " + c.error);
  if (!c.ok) { return t.report(); }

  i32 entryAt = -1;
  for (i32 i = 0; i < c.paths.len(); i++) { if (c.paths[i] == ENTRY) { entryAt = i; } }
  t.isTrue(entryAt >= 0, ENTRY + " is in the corpus");
  if (entryAt < 0) { return t.report(); }

  // One of wacc's sources reaches outside its own directory, and a file the driver does not carry is
  // a module that refuses to link rather than one that is wrong.
  // **`/`-prefixed keys**, because `resolved` always answers with a leading slash — it was written
  // for `corpuscheck_test.wac`, whose map is keyed that way. Passing plain corpus paths resolves
  // every import to a key that is not in the table, and the closure comes back as the entry alone.
  string[] keys = string[c.paths.len()](fill: "");
  for (i32 i = 0; i < c.paths.len(); i++) { keys[i] = "/" + c.paths[i]; }
  i32[] near = closureOf(keys, c.sources, entryAt);
  t.isTrue(near.len() >= 8, "only " + itoa(near.len()) + " sources in wacc's closure");
  if (near.len() < 8) { return t.report(); }

  string[] cp = string[near.len()](fill: "");
  string[] cs = string[near.len()](fill: "");
  for (i32 i = 0; i < near.len(); i++) { cp[i] = c.paths[near[i]]; cs[i] = c.sources[near[i]]; }

  // The driver joins the map wacc compiles from, and the disk, where the reference looks.
  string[] paths = string[near.len() + 1](fill: "");
  string[] sources = string[near.len() + 1](fill: "");
  for (i32 i = 0; i < near.len(); i++) { paths[i] = cp[i]; sources[i] = cs[i]; }
  paths[near.len()] = DRIVER;

  string dir = scratchDir(cli);
  // **Built once.** It is 1.4 MB of generated source and was built twice — once to write for the
  // reference and once to hand to stage B — for a string that is the same both times.
  string driver = driverFor(cp, cs);
  Change wrote = cli.writeFile(DRIVER, driver.toBytes()).wait();
  t.eqI32(wrote.fault, 0, "the driver was written to " + DRIVER);
  if (wrote.fault != 0) { return t.report(); }

  // **The canaries, before the comparison.** A stage that declined the whole compiler would emit an
  // eight-byte header, and two eight-byte headers agree about nothing at all.
  i32[] ok = i32[1]();
  string key = stageAKey(cli, driver.toBytes());
  i32[] said = cachedStageA(cli, key, 3, ok);
  if (ok[0] != 1) {
    said = referenceAnswers(cli, "blockedLen,wholeLen,fold", 3, ok);
    if (ok[0] == 1) { writeStageA(cli, key, said); }
  }
  t.eqI32(ok[0], 1, "the reference ran the driver and answered all three");
  if (ok[0] != 1) { cli.remove(DRIVER, false).wait(); return t.report(); }
  i32 blocked = said[0];
  t.eqI32(blocked, 0,
          "stage A declines wacc itself (" + itoa(blocked) + " characters of reason), so both " +
          "stages would be compared on an empty module");
  t.isTrue(said[1] >= 100000,
           "stage A emitted only " + itoa(said[1]) + " bytes for the whole compiler");
  i32 theirs = said[2];

  sources[near.len()] = driver;
  u8[] wasm = emitFilesSelfDescribing(paths, sources, DRIVER, "selfhost.wasm", 0);
  Ran r = runModule(cli, wasm, dir, "selfhost.wasm", string[]("fold"));
  cli.remove(DRIVER, false).wait();
  if (!r.ok || wasRejected(r) || r.trapped) {
    t.fail("stage B did not run — " + (r.ok ? r.stderr : r.error));
    return t.report();
  }
  // Said nothing is not answered zero: an empty stdout parses as 0, which is a fold a broken driver
  // could plausibly return.
  t.isTrue(trimmed(r.stdout).len() > 0, "stage B printed nothing — stderr " + r.stderr);
  i32 mine = atoi(trimmed(r.stdout));

  t.eqI32(mine, theirs,
          "wacc compiled by wacc does not reproduce wacc: stage B=" + itoa(mine) + ", stage A=" +
          itoa(theirs) + ", folded over wholeLen, wholeSum and blockedLen");

  // **And the third opinion.** What this test gets from `emitFiles` directly is what every other
  // test in this package measures, and stage B's answer has to be that same module — so the fold is
  // recomputed here from the bytes rather than trusted to agree by having been derived the same way.
  u8[] direct = emitFiles(c.paths, c.sources, ENTRY);
  i32 here = 7;
  here = here * 31 + direct.len();
  here = here * 31 + checksum(direct);
  here = here * 31 + 0;                      // `blockedLen`, asserted zero above
  t.eqI32(here, theirs,
          "the module this test emits directly is not the one the stages agree on: " + itoa(here) +
          " against " + itoa(theirs) + " (" + itoa(direct.len()) + " bytes, checksum " +
          itoa(checksum(direct)) + ")");
  return t.report();
}
