// A std fault alias imported alone converts to text — through `wac check`, the route a program takes.
//
// `type SpawnFault = union<NotGranted, Unsupported, Other>`: a file that imported the alias and none of the three
// had none of them declared, because `closeOverSignatures` followed fields, methods, functions and statics and not
// an alias's body — so `"\{e}"` on a `SpawnFault` was *no conversion to text*. In process the corpus harness does
// not expand std's aliases at all, which is why this is a test of the command rather than a case.

import { T } from "../../../wactest/src/assert.wac";
import { binaryPath, freshDir, scratch } from "../../../wactest/src/host.wac";
import { ChildEnv, Env, Exec, Files, Launch, Sys } from "std";
import { flatten } from "core";

export string test_a_std_fault_alias_imported_alone_converts_to_text(Sys sys) {
  T t = T.create();
  Env env = sys.env();
  Files fs = sys.files();
  string dir = scratch(env, "stdalias");
  string why = freshDir(fs, dir);
  t.isTrue(why == "", why);
  if (why != "") { return t.report(); }
  fs.writeFile(dir + "/main.wac",
               ("import { SpawnFault } from \"std\";\n" +
                "string said(SpawnFault e) { return \"\\{e}\"; }\n" +
                "export i32 main() { return 0; }\n").toBytes()).wait();
  Exec r = flatten(sys.procs().exec(binaryPath(env), ["check", dir + "/main.wac"], u8[](), ChildEnv.inherited(),
                                    Launch.plain()).wait()).unwrap();
  string said = string.fromBytes(r.stdout) + string.fromBytes(r.stderr);
  t.isTrue(r.status == 0 && said.indexOf("no diagnostics") >= 0, "the alias converts: " + said);
  return t.report();
}
