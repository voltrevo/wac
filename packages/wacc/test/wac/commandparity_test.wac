// The `wac` command through three hosts, compared on stdout, stderr and exit code.
//
// **The first thing `issues/system/0230a` asks for, and the reason it asks for it first.** The
// operator ruled option 2 on 2026-08-21: the shared thing is the *wac program*, and Deno, Node and
// the native binary are hosts that hand it argv and capabilities. Under that ruling the two hosts
// cannot drift by construction — but "cannot drift" is a claim about a build, and this is the
// measurement. That issue's own words: *"Without it, 'shared semantics' is a claim, and the two
// loaders in 0229a are what a claim like that looks like after a few months."*
//
// `packages/wacc/example/wacc.wac` is the program. The native binary embeds it as a payload; the Deno
// and Node hosts get it through `packages/platform/build.ts`. All three parse the same argv in the same
// wac code, so what this file can still catch is the part *outside* the program: how a host reports an
// exit status, what it does with a stream, and whether a capability answers the same way.
//
// ## Except for `run`, where it is comparing two implementations rather than one
//
// **`run` is the first subcommand to live in the wac program rather than in a host**, moved there on
// 2026-08-22 under `issues/system/0230a` option 2 once `spawn` could start a module on every host
// (`issues/system/0144`). The native binary still answers `run` in Rust, *before* the payload sees it —
// so for those five rows the native column is `build_and_call` in `native/v8/src/main.rs` and the other
// two are `cmd == "run"` in `wacc.wac`. Two implementations of one command, held to the same output.
//
// That is the evidence step 4 of that issue asks for before either is deleted, and it is why the two
// were made to agree on their *usage* text as well: `wac run` with no entry says `run`'s own line on
// all three, and an unknown flag is named rather than becoming the entry, which took a change on each
// side. Four of the eleven rows exist only because the first attempt at each disagreed.
//
// **They still differ in one way no assertion here covers**: the Rust `run` instantiates the module in
// its own process, so the program writes to the real streams, while the wac `run` spawns it and relays.
// Same bytes on each stream and the same status; not the same thing to a program that wants a terminal.
//
// ## What is compared, and what is deliberately not
//
// Eleven invocations covering the five subcommands the program has, each side's stdout and stderr
// concatenated, and the exit code. Not compared: timing, and the module bytes `build` writes — those
// have their own tests (`bindgenwac_test.wac` holds the two *generators* to the same bytes, which is a
// different claim from two hosts running one generator). **Worth adding and not here yet:** the three
// hosts' `build` output is byte-identical for one entry, measured by hand 2026-08-22, and nothing
// pins it.
//
// ## What it costs, measured 2026-08-22
//
// **9.3s warm** — up from 2–3s, for three hosts instead of two and eleven cases instead of six, five of
// which compile and run a program rather than only checking one. The build is the only expensive part
// and is paid by `builtByDeno`, which keys on the closure of `wacc.wac`, `compiler/`, `build.ts` and
// `packages/platform/host/`; under it, `build.ts` keys its own work on the content of every file it
// reads, so a rebuild after an unrelated change is a copy and a runtime start. The first run after
// `wacc.wac` changes pays two real builds, about 40s each when this was written. No lane declaration at
// that cost — and the number is dated because `issues/system/0230c` is what happens to costs that are
// not.
//
// **The canary is a successful invocation**, and it is not decoration. Writing this by hand first, in
// a shell that does not word-split an unquoted variable, every case became `wac "check src/main.wac"`
// — one unknown command, six times — and all six "agreed" on exit 2 with identical output. A
// differential whose cases have collapsed into one reports perfect agreement. So the first row must be
// exit 0, and a run where every row is the same non-zero code is a broken harness rather than a green
// result.

import { T } from "../../../wactest/src/assert.wac";
import { Change, Cli, Core, Exec, FileResult, Stat } from "std/platform.wac";
import { builtByDeno, wacBinary } from "../../../wactest/src/built.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { joined } from "../../../wactest/src/strings.wac";

const string ENTRY = "packages/wacc/example/wacc.wac";

string scratch(Cli cli, string name) {
  string dir = cli.cwd().wait() + "/.cache/parity-" + name;
  cli.remove(dir, true).wait();
  cli.mkdir(dir + "/src", true).wait();
  return dir;
}

/** One file, and the write is checked: a fixture that failed to appear is not a disagreement. */
bool put(T t, Cli cli, string path, string text) {
  Change c = cli.writeFile(path, text.toBytes()).wait();
  t.isTrue(c.ok(), "could not write " + path + " — " + c.message);
  return c.ok();
}

/** What one host said. */
struct Said {
  i32 status;
  string out;
}

/**
 * Run `argv` through a host, from `dir`, and take everything it said.
 *
 * A shell line because the working directory has to be the project's — `Cli.execWith` passes argv and
 * an environment and not a cwd, which `issues/system/0231c` prices — and `exec` at the front so the
 * status is the command's own rather than a shell's copy of it.
 */
Said say(Cli cli, string dir, string command, string[] argv) {
  string line = "cd " + dir + " && exec " + command;
  for (i32 i = 0; i < argv.len(); i++) { line = line + " " + argv[i]; }
  Exec r = cli.exec("/bin/sh", string[]("-c", line), u8[0]()).wait();
  if (!r.ran()) { return Said(-1, "the host did not start: " + r.error); }
  return Said(r.status, string.fromBytes(r.stdout) + string.fromBytes(r.stderr));
}

/** The invocations, as argument vectors. */
string[][] cases() {
  return string[][](
    string[]("check", "src/main.wac"),        // the canary: this one must succeed
    string[]("check", "src/bad.wac"),         // a type error, with a span and a caret
    string[]("check", "src/missing.wac"),     // a file that is not there
    string[]("nonsense", "src/main.wac"),     // an unknown subcommand, so the usage line
    string[]("bindgen", "src/lib.wac"),       // TypeScript glue
    string[]("bindgen", "src/lib.wac", "--js"),
    // **`run`, which is the first subcommand to live in the wac program rather than in a host.**
    // `issues/system/0230a` option 2 moved it there once `spawn` could start a module everywhere
    // (`issues/system/0144`), and the native binary still answers it in Rust — so for `run` these
    // rows compare *two implementations of one command*, not one implementation through two hosts.
    // That is the evidence step 4 of that issue wants before either is deleted.
    string[]("run", "src/hello.wac"),         // it runs, and its output is the program's
    string[]("run", "src/seven.wac"),         // ...and the exit code is the program's, not 0 or 1
    string[]("run", "src/hello.wac", "--", "--allow-read"),   // past `--`, a grant is an argument
    string[]("run", "--nonsense", "src/hello.wac"),           // an unknown flag, named
    string[]("run"));                                         // no entry, so `run`'s own usage line
}

/**
 * The two hosts answer the same thing for the same command line.
 *
 * `@/` is in the fixture on purpose: it is what `issues/system/0229a` was about, and the resolution it
 * needs happens in the wac program rather than in either host — so a host that handed the program a
 * different view of the project would show up here rather than in a report from outside.
 */
export string test_the_three_hosts_answer_the_same_command_the_same_way(Core core, Cli cli) {
  T t = T.create();
  string dir = scratch(cli, "hosts");
  bool wrote = put(t, cli, dir + "/wac.json5", "{}\n")
    && put(t, cli, dir + "/src/lib.wac", "export i32 two() { return 2; }\n")
    && put(t, cli, dir + "/src/main.wac",
           "import { two } from \"@/src/lib.wac\";\nexport i32 main() { return two(); }\n")
    && put(t, cli, dir + "/src/bad.wac", "export i32 f() { return \"no\"; }\n")
    // For `run`: one that says something and succeeds, and one whose exit code is neither 0 nor the
    // 1 and 2 every failure here uses — so a forwarded status cannot be confused with a diagnosis.
    && put(t, cli, dir + "/src/hello.wac",
           "import { Core } from \"std/platform.wac\";\n" +
           "export i32 main(Core core) { core.log(\"ran\"); return 0; }\n")
    && put(t, cli, dir + "/src/seven.wac", "export i32 main() { return 7; }\n");
  if (!wrote) { cli.remove(dir, true).wait(); return t.report(); }

  string native = wacBinary(cli);
  t.isTrue(cli.stat(native).wait().isFile, "the native binary is built: " + native);
  string[] grants = string[]("--allow-read", "--allow-write", "--allow-run", "--allow-env",
                             "--allow-net");
  string deno = builtByDeno(cli, ENTRY, "wac-deno-cli", grants, "deno", false);
  // **Node is the third host and not an afterthought.** It is the same wac program through a
  // different runtime, and the only thing that differs underneath is how a worker is made — so if a
  // difference between hosts is ever going to appear anywhere, this is a column that would show it
  // at no extra risk of a false alarm. Its `run` goes through `host/childWasmNode.ts` where Deno's
  // goes through `host/childWasm.ts`, which is the one place the two are not literally one file.
  string node = builtByDeno(cli, ENTRY, "wac-node-cli", grants, "node", false);
  t.isTrue(cli.stat(deno).wait().isFile, "the Deno-hosted command was built: " + deno);
  t.isTrue(cli.stat(node).wait().isFile, "the Node-hosted command was built: " + node);
  if (!cli.stat(deno).wait().isFile || !cli.stat(node).wait().isFile
      || !cli.stat(native).wait().isFile) {
    cli.remove(dir, true).wait();
    return t.report();
  }

  string[][] table = cases();
  i32 agreed = 0;
  i32 zeroes = 0;
  i32 sevens = 0;
  for (i32 i = 0; i < table.len(); i++) {
    Said n = say(cli, dir, native, table[i]);
    Said d = say(cli, dir, deno, table[i]);
    // A built Node program is not executable by itself; `node` runs it, as `spawn_test.wac` does.
    Said j = say(cli, dir, "node " + node, table[i]);
    string what = joined(table[i], " ");
    t.eqI32(d.status, n.status, "exit codes differ, deno vs native, for `wac " + what + "`");
    t.eqStr(d.out, n.out, "output differs, deno vs native, for `wac " + what + "`");
    t.eqI32(j.status, n.status, "exit codes differ, node vs native, for `wac " + what + "`");
    t.eqStr(j.out, n.out, "output differs, node vs native, for `wac " + what + "`");
    if (d.status == n.status && d.out == n.out && j.status == n.status && j.out == n.out) {
      agreed = agreed + 1;
    }
    if (n.status == 0) { zeroes = zeroes + 1; }
    if (n.status == 7) { sevens = sevens + 1; }
  }

  // **The canary.** A clean check has to succeed, or the cases have collapsed into one — see the
  // header. Five of these eleven exit 0: two `bindgen`s, one `check`, and the two `run`s of a program
  // that returns 0.
  t.eqI32(zeroes, 5, "five of these eleven succeed on the native host; a different count means the " +
                     "argument vectors did not arrive as vectors");
  // **And one exits 7**, which no failure path here produces: it is `src/seven.wac`'s own return
  // value carried back through a spawn and out of the process. A `run` that reported its own success
  // instead of the program's would read as 0 and every other assertion would still pass.
  t.eqI32(sevens, 1, "`run src/seven.wac` forwards the program's exit code, not its own");
  t.eqI32(agreed, table.len(),
          "all three hosts agreed on " + itoa(agreed) + " of " + itoa(table.len()));
  cli.remove(dir, true).wait();
  return t.report();
}
