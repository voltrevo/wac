// Rung 5's tracker: how much of `wacc` can `wacc` compile?
//
// The ladder's last rung is the bootstrap — this compiler compiling its own source — and the useful
// version of that question is not yes or no but *how far*. This reports how many of wacc's own
// sources produce a whole module, so the number moves as the emitter grows rather than staying at
// "no" until the day it becomes "yes".
//
// What it asserts is the same invariant the corpus test asserts, on the sources that matter most: a
// module this emitter produces validates, and a file it declines is declined **by name**. The count
// is asserted only as a floor, so a slot that adds a feature cannot quietly lose one.
//
//
// **2.6s: sixteen entries out of five hundred files, built.** Measured 2026-08-18, and it was 6.4s
// with the same assertions. It already avoided the obvious waste — `runModule` rather than
// `runEmitted`, so the graph is not type-checked sixteen times to answer a question about the
// emitter — and the sentence here used to say the rest was the emitting. It was not. Split:
//
//     emit    3577ms      ← `emitFilesSelfDescribing` is *three* front ends
//     run      101ms        the sixteen modules, written out and loaded by the binary
//     blocked 2688ms      ← a fourth
//
// `emitFilesSelfDescribing` is `emitLinked` plus `manifestFiles`, and `manifestFiles` derives the
// bind types and the export signatures with a front end each; `blockedFiles` built another. Four
// walks of the same graph, three of them for answers the first walk already had. `buildFiles`
// returns them together (`issues/lang/0129`) and is what `example/wacc.wac` uses for a real build,
// so this now costs one front end per entry — which is the emitting, and now really is.
// ## Host-side until 2026-08-17, `issues/system/0161`
//
// The TypeScript asked `WebAssembly.validate`. Nothing in wac validates bytes without running them,
// so the module is written out and the binary is asked to load it: a module the engine refuses says
// `rejected by the engine`, and one that loads but has no `main` says `no struct Core in the
// manifest` — which is a **pass** here, since it got far enough to be read. `wasRejected` is that
// distinction and it rests on the binary's words rather than on a status, because a rejected module,
// a trapping one and one answering 1 all exit 1 (`issues/system/0184`).
//
// **Through `runModule` rather than `runEmitted`**, because that one type-checks the whole graph
// first. This emits fifteen entries out of five hundred-odd files, and the question is about the
// emitter — checking the same graph fifteen times would be paying a large cost to answer something
// else.

import { T } from "../../../wactest/src/assert.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { joined } from "../../../wactest/src/strings.wac";
import { Core, Cli } from "std/platform.wac";
import { buildFiles, manifestWire, describeSeparator } from "../../src/api.wac";
import { Built } from "../../src/emit.wac";
import { withManifestSection } from "../../src/manifest.wac";
import { Corpus, loadCorpus, waccSources } from "./corpus_probe.wac";
import { Ran, runModule, wasRejected, scratchDir } from "./artifacts_probe.wac";

/** `packages/wacc/src/emit.wac` → `emit.wac`, for a message and for a filename. */
string baseName(string path) {
  for (i32 i = path.len() - 1; i >= 0; i--) {
    if (path.slice(i, i + 1) == "/") { return path.slice(i + 1, path.len()); }
  }
  return path;
}

export string test_rung_5_how_much_of_wacc_can_wacc_compile(Core core, Cli cli) {
  T t = T.create();
  Corpus c = loadCorpus(cli, "selfemit_test");
  t.isTrue(c.ok, "the corpus loaded — " + c.error);
  if (!c.ok) { return t.report(); }

  string[] own = waccSources(c);
  t.isTrue(own.len() >= 8, "found wacc's sources: " + itoa(own.len()));
  if (own.len() < 8) { return t.report(); }

  string dir = scratchDir(cli);
  i32 whole = 0;
  i32 invalid = 0;
  string[] declined = string[own.len()](fill: "");
  i32 nDeclined = 0;
  string[] rejected = string[own.len()](fill: "");
  i32 nRejected = 0;

  // **One front end per entry, which is what `buildFiles` exists for** — `issues/lang/0129`, and the
  // same call `packages/wac/src/wac.wac` makes for a real build. This loop used to ask four
  // times over: `emitFilesSelfDescribing` is an emit plus `manifestFiles`, which builds
  // `bindTypesLinked` and `exportSigsLinked` as two more, and `blockedFiles` below was a fourth. The
  // blocked answer is the first field of the description this already has.
  for (i32 i = 0; i < own.len(); i++) {
    string name = baseName(own[i]);
    Built b = buildFiles(c.paths, c.sources, own[i]);
    string sep = describeSeparator();
    i32 firstAt = b.described.indexOf(sep);
    string blocked = firstAt < 0 ? b.described : b.described.slice(0, firstAt);
    string rest = firstAt < 0 ? "" : b.described.slice(firstAt + sep.len(), b.described.len());
    i32 secondAt = rest.indexOf(sep);
    string sigs = secondAt < 0 ? rest : rest.slice(0, secondAt);
    string types = secondAt < 0 ? "" : rest.slice(secondAt + sep.len(), rest.len());
    // **The split has to be checked, because nothing below can check it.** `blocked` is empty for
    // every one of wacc's sources today, so a split that answered `""` whatever it was given would
    // leave `whole` at its full count and this test green — the same shape as reading the blocked
    // answer from a call that was never made. Two separators is what a description that parsed looks
    // like; a front end that failed produces `sep + sep` and still has them.
    t.isTrue(firstAt >= 0 && secondAt >= 0,
             name + ": the description did not carry two separators — " +
             itoa(b.described.len()) + " bytes");
    // Self-describing, as before: the module carries its own manifest, which is what lets the binary
    // load it as one artefact. `manifestWire` is `manifestFiles` given the metadata rather than
    // re-deriving it.
    u8[] wasm = withManifestSection(b.wasm, manifestWire(b.wasm, types, sigs, own[i], name, 0));
    Ran r = runModule(cli, wasm, dir, "selfemit_" + name + ".wasm", string[0](fill: ""));
    if (!r.ok || wasRejected(r)) {
      invalid = invalid + 1;
      rejected[nRejected] = name + (r.ok ? " — " + r.stderr : " — " + r.error);
      nRejected = nRejected + 1;
      continue;
    }
    string why = blocked;
    if (why == "") {
      whole = whole + 1;
    } else {
      declined[nDeclined] = name + " — " + why;
      nDeclined = nDeclined + 1;
    }
  }

  // The same invariant as the corpus, on the files that decide the last rung.
  string[] badNames = string[nRejected](fill: "");
  for (i32 i = 0; i < nRejected; i++) { badNames[i] = rejected[i]; }
  t.eqI32(invalid, 0,
          itoa(invalid) + " of wacc's own sources produced a module the engine refused — the " +
          "emittability walk approved something the emitter cannot do: " + joined(badNames, "; "));

  // A floor rather than an equality: this is meant to rise, and a slot that adds a feature must not
  // quietly lose one.
  string[] whyNot = string[nDeclined](fill: "");
  for (i32 i = 0; i < nDeclined; i++) { whyNot[i] = declined[i]; }
  t.eqI32(whole, own.len(),
          "only " + itoa(whole) + " of wacc's " + itoa(own.len()) + " sources compile whole: " +
          joined(whyNot, "; "));
  return t.report();
}
