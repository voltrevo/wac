// The compiler as a program, run as one.
//
// `example/wacc.wac` is what a `wac` binary dispatches (`design/lang/0003` step 4): it reads the
// entry, walks the imports with `src/files.wac`, and calls the same `emitFiles` the library exposes.
// What has to stay true is that going the long way round changes nothing — same input, same module,
// byte for byte — because the moment those differ, "wacc can build this repository by itself" stops
// being one claim and becomes two.
//
// Run as a *subprocess*, not by calling `emitFiles` here: the point is the whole path, including
// reading files through a capability and writing the result. A test that called the library directly
// would pass for a program whose argument handling or file walk was broken.
//
// ## Host-side until 2026-08-18, `issues/system/0161`
//
// `buildApp` becomes `wac build`, and the distinction matters more here than in most of these ports.
// **The program is built from the current sources rather than being the `wac` binary itself.** The
// binary carries a prebuilt seed, so running `wac compile` directly would compare the seed against
// today's library — a real question, and a different one, which `tools/wac/seedfresh_test.wac` already
// asks. Building `example/wacc.wac` first keeps this file's claim about the *program*.
//
// The last case needs a JavaScript host, because what it asserts is that the generated glue **runs**.
// `../gluerun.ts` is that host: it imports the module and calls three things. Not an oracle — it
// compares nothing — but generated JavaScript is only text until something executes it, and a
// generator that dropped a cast it needed would still read like JavaScript.

import { T } from "../../../wactest/src/assert.wac";
import { Exec, Change, Stat, ChildEnv, Env, Files, Launch, Output, Procs, Sys } from "std";
import { itoa } from "../../../fmt/src/itoa.wac";
import { emitFiles, pruneForBuild } from "../../src/api.wac";
import { Pruned } from "../../src/reach.wac";
import { Res } from "../../src/path.wac";
import { Graph, graphOf } from "./graph.wac";
import { freshDir, madeDir } from "../../../wactest/src/host.wac";
import { wacBinary } from "../../../wactest/src/built.wac";
import { flatten } from "core";

static string SOURCE = "packages/wac/src/wac.wac";
static string GLUERUN = "packages/wacc/test/gluerun.ts";

string freshScratch(T t, Env env, Files fs, string name) {
  string dir = flatten(env.cwd().wait()).unwrap() + "/.cache/" + name;
  string why = freshDir(fs, dir);
  t.isTrue(why == "", why);
  return dir;
}

/**
 * The newest modification time among everything the built program is made of.
 *
 * The program's own import graph, walked the way the program walks it — and the binary that compiles
 * it, which is the input a source walk cannot see: `wac` carries a prebuilt seed, so a rebuilt binary
 * can turn the same sources into a different module. `issues/system/0160` is what missing that costs.
 */
i64 newestInput(Env env, Files fs) {
  i64 newest = 0 as i64;
  Stat? bin = flatten(fs.stat(wacBinary(env)).wait()).ok();
  if ((bin is not null)) { newest = bin!.modifiedMillis; }
  Graph g = graphOf(fs, SOURCE);
  for (i32 i = 0; i < g.paths.len(); i++) {
    Stat? s = flatten(fs.stat(g.paths[i]).wait()).ok();
    if ((s is not null) && s!.modifiedMillis > newest) { newest = s!.modifiedMillis; }
  }
  return newest;
}

/**
 * `example/wacc.wac` built into a module — **once for the file, and once per change after that.**
 *
 * The docstring here used to say it was cached and reused, and it was not: each of the four tests
 * below called this with its own `scratch` directory, which `scratch` had just emptied, so the file
 * built the same program four times. About two seconds each, which was most of the 9.6s this file
 * cost and made it the second-largest test in the `wac` lane.
 *
 * Now it really is cached, in a directory of its own that nothing empties, and the freshness rule is
 * the one `tools/wac/seedfresh_test.wac` uses for the seed: mtimes. Older than any of its inputs — the
 * import graph or the binary that compiles it — and it is built again. It does **not** cover a
 * `.cache` entry corrupted by something else writing there, which is why the build writes to a name
 * of its own rather than sharing one with any other test file.
 */
string buildProgram(T t, Env env, Files fs, Procs procs) {
  // **Not `scratch("waccprog")`, and the name is the whole reason.** The first test below asks for a
  // scratch directory by that name and `scratch` empties what it is given, so a cache that lived
  // there was deleted by the first test and rebuilt by it every run — which is what the first
  // version of this did, silently and at full price.
  string dir = flatten(env.cwd().wait()).unwrap() + "/.cache/waccprog-built";
  string whyDir1 = madeDir(fs, dir);
  t.isTrue(whyDir1 == "", whyDir1);
  string stem = dir + "/wacc";
  string wasm = stem + ".wasm";
  Stat? have = flatten(fs.stat(wasm).wait()).ok();
  if ((have is not null) && have!.modifiedMillis > newestInput(env, fs)) { return wasm; }
  auto rRan = flatten(procs.exec(wacBinary(env), [
                             "build", SOURCE, "-o", stem, "--allow-read", "--allow-write",
                             "--quiet"
                    ], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null), "the wac binary ran — " + "\{rRan.isErr() ? "\{rRan.err()!}" : ""}");
  t.eqI32(r!.status, 0, "building " + SOURCE + " — " + string.fromBytes(r!.stderr));
  return (r is not null) && r!.status == 0 ? wasm : "";
}

/** Run the built program with `args`. */
Exec runProgram(Env env, Procs procs, string program, string[] args) {
  string[] argv = string[].filled(args.len() + 1, "");
  argv[0] = program;
  for (i32 i = 0; i < args.len(); i++) { argv[1 + i] = args[i]; }
  return flatten(procs.exec(wacBinary(env), argv, u8[](), ChildEnv.inherited(), Launch.plain()).wait()).unwrap();
}

/** The import graph of `entry`, walked the way the program walks it. */

export string test_the_program_compiles_what_the_library_compiles_byte_for_byte(Sys sys) {
  Output out = sys.stdout();
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = freshScratch(t, env, fs, "waccprog");
  string program = buildProgram(t, env, fs, procs);
  if (program == "") { return t.report(); }

  string entry = "packages/json/src/json.wac";
  string wasmOut = dir + "/out.wasm";
  Exec r = runProgram(env, procs, program, ["compile", entry, wasmOut]);
  t.eqI32(r.status, 0, "compile failed: " + string.fromBytes(r.stderr) +
                       string.fromBytes(r.stdout));
  if (r.status != 0) { return t.report(); }

  // The same program through the library — the graph a build compiles, which is what reachability
  // retains of the import graph (spec ch05).
  Graph g = graphOf(fs, entry);
  t.isTrue(g.ok, "the import graph — " + g.error);
  if (!g.ok) { return t.report(); }
  Pruned pruned = pruneForBuild(g.paths, g.sources, Res.empty(), entry);
  u8[] want = emitFiles(pruned.paths, pruned.sources, entry);
  auto gotRead = flatten(fs.readFile(wasmOut).wait());
  u8[]? got = gotRead.ok();
  t.isTrue((got is not null), "the program wrote a module — " + "\{gotRead.isErr() ? "\{gotRead.err()!}" : ""}");
  if ((got is null)) { return t.report(); }

  t.eqI32(got!.len(), want.len(), "the program and the library wrote different sizes");
  if (got!.len() == want.len()) {
    i32 first = -1;
    for (i32 i = 0; i < want.len() && first < 0; i++) {
      if (got![i] != want[i]) { first = i; }
    }
    t.eqI32(first, -1, first < 0 ? "" :
            "byte " + itoa(first) + " differs: " + itoa(got![first] as i32) + " vs " +
            itoa(want[first] as i32));
  }
  out.line("    program: " + itoa(got!.len()) + " bytes for " + entry +
           ", identical to the library's");
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_it_names_the_file_it_cannot_read(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  // A missing import used to be discoverable only as whatever the checker said about the hole it
  // left, which points at the file that *imported* it. The walk stops and says which path.
  T t = T.create();
  string dir = freshScratch(t, env, fs, "waccprog-missing");
  string program = buildProgram(t, env, fs, procs);
  if (program == "") { return t.report(); }

  fs.writeFile(dir + "/main.wac",
                ("import { x } from \"./gone.wac\";\nexport i32 f() { return x; }\n").toBytes())
     .wait();
  Exec r = runProgram(env, procs, program, ["check", dir + "/main.wac"]);
  t.isTrue(r.status != 0, "a missing import compiled");
  t.isTrue(string.fromBytes(r.stderr).indexOf("gone.wac") >= 0,
           "did not name the file: " + string.fromBytes(r.stderr));
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_check_refuses_a_program_the_checker_refuses_and_says_where(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = freshScratch(t, env, fs, "waccprog-bad");
  string program = buildProgram(t, env, fs, procs);
  if (program == "") { return t.report(); }

  fs.writeFile(dir + "/bad.wac", "export i32 f() { return \"no\"; }\n".toBytes()).wait();
  Exec r = runProgram(env, procs, program, ["check", dir + "/bad.wac"]);
  t.isTrue(r.status != 0, "a type error passed the check");
  t.isTrue(string.fromBytes(r.stderr).indexOf("bad.wac") >= 0,
           "no file in the diagnostic: " + string.fromBytes(r.stderr));
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_bindgen_the_program_writes_glue_and_the_glue_runs(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  // **The last piece of the toolchain that only existed in TypeScript.** `waccx bindgen` wrote glue
  // and the `wac` binary could not, which is a tooling-parity gap rather than a missing language
  // feature — `src/bindgen.wac` closes it, and `test/wac/bindgenwac_test.wac` holds the two generators to
  // the same text byte for byte.
  //
  // Here the assertion is the *running*, not the reading: a generator that dropped a cast it needed
  // would still look like JavaScript. `.js` and imported as such, which is the browser's rule and the
  // reason the JavaScript mode exists at all.
  T t = T.create();
  string dir = freshScratch(t, env, fs, "waccprog-glue");
  string program = buildProgram(t, env, fs, procs);
  if (program == "") { return t.report(); }

  // **A callback with a parameter, because that branch was the one JavaScript mode got wrong.**
  // `apply` makes the generator emit a dispatcher — `$cbd0` — and the dispatcher was the only place
  // that built its parameter annotations by hand instead of through the mode-aware helper, so
  // `--js` wrote `($slot, a0: unknown) =>` and Node refused the file. GitHub issue 23. Everything
  // else here already exercised structs, strings and methods, and none of them reach that branch.
  //
  // **Three arities, because that issue's acceptance criteria ask for them and because the bug lived
  // in a `join`:** one parameter, two, and none. The nilary case is the one that would pass either
  // way — `raw` is empty, so there is no annotation to get wrong — and it is here so that the next
  // person changing this loop finds out whether they broke the empty case as well.
  fs.writeFile(dir + "/m.wac",
    ("struct Point { i32 x; i32 y; i32 sum(const this) { return this.x + this.y; } }\n" +
     "export Point origin(i32 x, i32 y) { return Point(x, y); }\n" +
     "export string greet(string who) { return \"hi \" + who; }\n" +
     "export i32 apply(fn<i32(i32)> f, i32 x) { return f(x); }\n" +
     "export i32 pair(fn<i32(i32, i32)> g, i32 a, i32 b) { return g(a, b); }\n" +
     "export i32 nilary(fn<i32()> h) { return h(); }\n").toBytes()).wait();

  Exec js = runProgram(env, procs, program, ["bindgen", dir + "/m.wac", "--js"]);
  t.eqI32(js.status, 0, "bindgen failed: " + string.fromBytes(js.stderr) +
                        string.fromBytes(js.stdout));
  if (js.status != 0) { return t.report(); }

  auto ranRan = flatten(procs.exec("deno", ["run", "-A", GLUERUN, dir + "/m.wac.js"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? ran = ranRan.ok();
  t.isTrue((ran is not null), "deno ran — " + "\{ranRan.isErr() ? "\{ranRan.err()!}" : ""}");
  t.eqI32(ran!.status, 0, "the glue did not answer: " + string.fromBytes(ran!.stderr));

  // TypeScript by default, which is the other half of the same generator.
  Exec ts = runProgram(env, procs, program, ["bindgen", dir + "/m.wac"]);
  t.eqI32(ts.status, 0, "bindgen --ts failed: " + string.fromBytes(ts.stderr));
  auto textRead = flatten(fs.readFile(dir + "/m.wac.ts").wait());
  u8[]? text = textRead.ok();
  t.isTrue((text is not null), "the TypeScript glue was written — " + "\{textRead.isErr() ? "\{textRead.err()!}" : ""}");
  if ((text is not null)) {
    string tsGlue = string.fromBytes(text!);
    t.isTrue(tsGlue.indexOf(": number") >= 0, "the TypeScript mode emitted no annotations");
    // And the dispatcher's own parameters are still annotated there, which is the half of the fix
    // that is easy to lose: making `--js` stop emitting a type must not stop `--ts` emitting one.
    t.isTrue(tsGlue.indexOf("a0: unknown") >= 0,
             "the TypeScript mode dropped the callback dispatcher's annotation");
  }
  // The JavaScript glue must carry no type at all — asserted on the text as well as by running it,
  // because a runtime that tolerated the annotation would leave the file wrong for the others.
  auto jsTextRead = flatten(fs.readFile(dir + "/m.wac.js").wait());
  u8[]? jsText = jsTextRead.ok();
  t.isTrue((jsText is not null), "the JavaScript glue was written — " + "\{jsTextRead.isErr() ? "\{jsTextRead.err()!}" : ""}");
  if ((jsText is not null)) {
    t.isTrue(string.fromBytes(jsText!).indexOf(": unknown") < 0,
             "the JavaScript mode emitted a TypeScript annotation: " +
             string.fromBytes(jsText!).slice(0, 400));
  }
  fs.remove(dir, true).wait();
  return t.report();
}

/**
 * A `main` answering `Result<i32>` builds, runs, exits 1 on an `Err`, and says what it failed with.
 *
 * The adapter wrote `"\{e}"` for every `Result<i32>`, from when a left-out error type meant `string`.
 * Gathered, it is a `union`, which has no text conversion: the build failed with *text from a
 * union<string>, which has no `[toString]`*, under both `wac build` and `wac run` — while
 * `spec/_status/MET` listed spec ch07's own `Result<i32>` example as met, by a probe route that runs
 * the adapter in-process. So this drives the command, and asserts the output as well as the status.
 */
export string test_a_result_main_with_a_gathered_error_builds_and_says_what_failed(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = freshScratch(t, env, fs, "resultmain");
  string src =
      "import { Sys } from \"std\";\nimport { Result } from \"core\";\n" +
      "struct Malformed { string why; }\n" +
      "Result<i32, Malformed> parse(i32 k) { if (k == 1) { return Result.Err(Malformed(\"bad\")); } return Result.Ok(k); }\n" +
      "export Result<i32> main(Sys sys) {\n" +
      "  i32 n = try parse(sys.args().len() + 1);\n" +
      "  if (n > 5) { return Result.Err(\"too many\"); }\n" +
      "  return Result.Ok(n);\n}\n";
  auto wrote = flatten(fs.writeFile(dir + "/main.wac", src.toBytes()).wait());
  t.isTrue(wrote.isOk(), "wrote the program");
  auto rRan = flatten(procs.exec(wacBinary(env), ["run", dir + "/main.wac"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  string said = string.fromBytes(r!.stdout) + string.fromBytes(r!.stderr);
  t.isTrue((r is not null), "wac ran — " + "\{rRan.isErr() ? "\{rRan.err()!}" : ""}");
  t.isTrue(said.indexOf("cannot emit") < 0, "it builds — " + said);
  t.eqI32(r!.status, 1, "an Err exits 1 — " + said);
  t.isTrue(said.indexOf("Malformed") >= 0, "and names what it failed with — " + said);
  return t.report();
}
