// The negative half of the corpus: 41 ill-typed programs that must all be refused — 34 single-file,
// and 7 that are only ill-typed across an import boundary.
//
//     wac test --allow-read --allow-write --allow-run --allow-env packages/wacc/test/wac/illtyped_test.wac
//
// **Why this file exists at all.** `issues/lang/0170a` found four programs — `s[0] - 1`, `i32 n = s[0]`,
// `b ? s : 1`, `p.v()` — that wacc checked clean, built with exit 0, and left their exported function
// *out of the module*. The reference refuses all fourteen; wacc refused ten. That is exactly the
// disagreement the corpus differential exists to find, and it never saw them, because the corpus is
// this repository's own files plus `spec/cases/*.wac` and **every one of those is meant to compile**.
// A checker's corpus with no ill-typed programs in it cannot measure what the checker fails to refuse.
//
// So the issue's own conclusion — "fourteen files like the ones above, with the expected refusal
// recorded, would have caught all four and would catch the next one … probably the highest-yield
// single addition here" — is this file. The four are fixed; what this adds is that they cannot go back
// to being silent without a test saying so.
//
// **Two questions per program**, because the failure mode is passing one and failing the other: does
// the checker refuse it, and does the emitter decline anything. A program answering no to both builds
// with its exported function missing, which is the shape `issues/lang/0155` and the export-parity net
// in `emit.wac` are the other guards against. Measured 2026-08-21: **34 of 34 refused by the checker**,
// 0 silent in both. The last four are a *type name* where a value belongs, and three of them were
// silent until `issues/lang/0235a`: only a struct was refused, so `x < i32`, `x < E` and `x < string`
// checked clean and the emitter caught them later as `unresolved name i32`, without a position.

import { T } from "../../../wactest/src/assert.wac";
import { dumpTypeErrors, dumpTypeErrorsFiles, blockedFiles } from "../../src/api.wac";

string[] names() {
  return string[](
    "a01 s - 1", "a02 s[0] - 1", "a03 i32 n = s[0]", "a04 b ? s : 1", "a05 p + 1 (struct)",
    "a06 s < 1", "a07 a(1) (i32 called)", "a08 p.v() (field as method)", "a09 a[0] (i32 indexed)",
    "a10 -s", "a11 a.nope", "a12 g(1,2) for g(i32)", "a13 b + 1 (bool)", "a14 return s from i32",
    // A **type name** where a value belongs. Only the struct case was refused: the other three
    // checked clean and the emitter caught them later as `unresolved name i32`, with no position.
    // The reference refuses all four. `issues/lang/0235a`.
    "a15 x < i32 (primitive)", "a16 x < E (enum)", "a17 x < string", "a18 x < P (struct)",
    // Bitwise and shift on something that is not an integer. All four checked clean; two of them
    // emitted a module the engine refuses. `issues/lang/0236a`.
    "a19 1.5 & 2.5", "a20 x & 1.5", "a21 \"a\" << 1", "a22 x << \"a\"",
    // `++`/`--` in value position. The *operand* was checked — `q++` on a bool is refused — and the
    // expression's own type was never computed, so what it produced could go anywhere. Four spellings
    // because the missing arm served all four: postfix, prefix, decrement, and an argument rather than
    // an initialiser. `issues/lang/0242a`.
    "a23 string s = x++", "a24 string s = ++x", "a25 string s = x--", "a26 g(x++) for g(string)",
    // An **all-literal `match` expression in a slot no literal of that family can inhabit**.
    // `spec/spec/enums.md` §enum-match-expr-4wnq7bk has the arms unifying *"exactly as a ternary's two
    // branches are … and by the same code"*, and `litFamily` implemented that for the ternary and not
    // for the match — so the identical program was refused with `?:` and accepted with `match`. Every
    // family, because the arm serves them all. `issues/lang/0243a`.
    "a27 int arms -> string", "a28 int arms -> bool", "a29 string arms -> i32",
    "a30 bool arms -> i32", "a31 int arms -> f64",
    // A **bare `null`** where a type is required. `spec/spec/types.md`: *"`null` is a keyword literal
    // with no type of its own … the compiler infers the type from context"* — and `null is null` has no
    // context to infer from. The rules were there and keyed on a type the operand does not have, so all
    // three reached the emitter, which declined the module with the reason *"null"*. The reference
    // refuses all three by name. `issues/lang/0249a`.
    "a32 null is null", "a33 null is not null", "a34 null!");
}

string[] programs() {
  return string[](
    "export i32 f(string s) { return s - 1; }\n",
    "export i32 f(string s) { return s[0] - 1; }\n",
    "export i32 f(string s) { i32 n = s[0]; return n; }\n",
    "export i32 f(string s, bool b) { return b ? s : 1; }\n",
    "struct P { i32 v; }\nexport i32 f(P p) { return p + 1; }\n",
    "export i32 f(string s) { return s < 1 ? 1 : 0; }\n",
    "export i32 f(i32 a) { return a(1); }\n",
    "struct P { i32 v; }\nexport i32 f(P p) { return p.v(); }\n",
    "export i32 f(i32 a) { return a[0]; }\n",
    "export i32 f(string s) { return -s; }\n",
    "export i32 f(i32 a) { return a.nope; }\n",
    "i32 g(i32 x) { return x; }\nexport i32 f() { return g(1, 2); }\n",
    "export i32 f(bool b) { return b + 1; }\n",
    "export i32 f(string s) { return s; }\n",
    "export bool f(i32 x) { return x < i32; }\n",
    "enum E { A, B }\nexport bool f(i32 x) { return x < E; }\n",
    "export bool f(i32 x) { return x < string; }\n",
    "struct P { i32 v; }\nexport bool f(i32 x) { return x < P; }\n",
    "export f64 f() { return 1.5 & 2.5; }\n",
    "export i32 f(i32 x) { return x & 1.5; }\n",
    "export string f() { return \"a\" << 1; }\n",
    "export i32 f(i32 x) { return x << \"a\"; }\n",
    "export i32 f(i32 x) { string s = x++; return s.len(); }\n",
    "export i32 f(i32 x) { string s = ++x; return s.len(); }\n",
    "export i32 f(i32 x) { string s = x--; return s.len(); }\n",
    "i32 g(string s) { return s.len(); }\nexport i32 f(i32 x) { return g(x++); }\n",
    "enum E { A, B }\nexport i32 f(E e) { string s = match (e) { case A: 1, else: 2 }; return s.len(); }\n",
    "enum E { A, B }\nexport i32 f(E e) { bool z = match (e) { case A: 1, else: 2 }; return z ? 1 : 0; }\n",
    "enum E { A, B }\nexport i32 f(E e) { i32 n = match (e) { case A: \"x\", else: \"y\" }; return n; }\n",
    "enum E { A, B }\nexport i32 f(E e) { i32 n = match (e) { case A: true, else: false }; return n; }\n",
    "enum E { A, B }\nexport f64 f(E e) { f64 d = match (e) { case A: 1, else: 2 }; return d; }\n",
    "export bool f() { return null is null; }\n",
    "export bool f() { return null is not null; }\n",
    "export i32 f() { return null!; }\n");
}

export string test_every_ill_typed_program_here_is_refused_by_the_checker() {
  T t = T.create();
  string[] name = names();
  string[] src = programs();
  // The lists are parallel, and a case added to one and not the other would be skipped in silence —
  // which is the failure this whole file is about.
  t.eqI32(name.len(), src.len(), "the name and program lists disagree in length");
  if (name.len() != src.len()) { return t.report(); }
  for (i32 i = 0; i < src.len(); i++) {
    i32 diags = dumpTypeErrors(src[i].toBytes()).len() / 3;
    // **The count, not the code.** Which rule fires is the checker's business and several of these
    // draw two; that a wrongly-typed program is refused *at all* is the claim, and it is the one that
    // was false for four of them.
    t.isTrue(diags > 0, name[i] + ": accepted an ill-typed program");
  }
  return t.report();
}

/**
 * The four that were silent, named for what they are.
 *
 * A loop failing on "a02" says less than a test whose name is the reason. These are the four the issue
 * measured as `check` clean, `wac build` exit 0, and the exported function absent — two filed
 * separately as `issues/lang/0159` and `0165`, and two never filed at all.
 */
export string test_the_four_that_used_to_build_with_the_function_missing() {
  T t = T.create();
  string[] name = string[]("indexing a string then subtracting (0159)",
                           "initialising an i32 from a string index",
                           "a ternary whose branches are a string and an i32",
                           "calling a field as a method (0165)");
  string[] all = programs();
  string[] src = string[](all[1], all[2], all[3], all[7]);
  for (i32 i = 0; i < src.len(); i++) {
    i32 diags = dumpTypeErrors(src[i].toBytes()).len() / 3;
    t.isTrue(diags > 0, name[i] + ": silent again");
  }
  return t.report();
}

/**
 * And the pair taken together, which is the durable claim.
 *
 * Not that every program is declined by the emitter — seven are not, and that is right: the checker
 * refuses them first and `example/wacc.wac` checks before it emits. What this holds is weaker and
 * harder to lose: **no program here is accepted by both.** A row that goes silent in both is a module
 * built with its exported function missing and an exit code of 0, whatever the mechanism was.
 */
export string test_no_program_here_is_accepted_by_both_the_checker_and_the_emitter() {
  T t = T.create();
  string[] name = names();
  string[] src = programs();
  for (i32 i = 0; i < src.len(); i++) {
    i32 diags = dumpTypeErrors(src[i].toBytes()).len() / 3;
    string blocked = blockedFiles(string[]("/m.wac"), string[](src[i]), "/m.wac");
    t.isTrue(diags > 0 || blocked != "",
        name[i] + ": the checker and the emitter both accepted it, so a build writes a module with "
        + "no `f` in it and exits 0");
  }
  return t.report();
}

/**
 * A refused unary reports **once**, not once per rule that notices the consequence.
 *
 * `~s` in an `i32` function drew two diagnostics: the operand rule that refused it, and a slot rule
 * comparing the `i32` return type against the type `typeOfExpr` had handed back for `~s` — its
 * *operand's* type, invented for an expression already refused. Moving the same expression into a
 * `string` function dropped it to one, which is what identified the mechanism. `issues/lang/0238a`.
 *
 * **The count is the assertion, and it has to be.** Every other test in this file asks `diags > 0`,
 * which was true before the fix and after it, so nothing here could hold this. The mutation corpus
 * cannot either: its 19 count-disagreements are binary and initialiser shapes, and re-running it after
 * this fix moved the number not at all — it contains no unary in a mismatched slot.
 */
export string test_a_refused_unary_reports_once() {
  T t = T.create();
  string[] name = string[]("~ on a string", "unary - on a bool", "unary - on a string");
  string[] src = string[](
    "export i32 f(string s) { return ~s; }\n",
    "export i32 f(bool b) { return -b; }\n",
    "export i32 f(string s) { return -s; }\n");
  for (i32 i = 0; i < src.len(); i++) {
    i32 diags = dumpTypeErrors(src[i].toBytes()).len() / 3;
    t.eqI32(diags, 1, name[i] + ": one fault, and this many diagnostics");
  }
  // The control: the same expression where the slot agrees was always one, so a fix that simply
  // silenced the second rule everywhere would pass the rows above and fail nothing.
  i32 ok = dumpTypeErrors("export string f(string s) { return ~s; }\n".toBytes()).len() / 3;
  t.eqI32(ok, 1, "the matching-slot control");
  return t.report();
}

/**
 * A string in an arithmetic operator is reported **once**, by whichever rule can see it.
 *
 * Two rules overlapped: the operand rule (*"a string is a number for exactly one operator"*) and the
 * mismatch rule, both keyed on a string beside a non-string in an arithmetic operator. `s % 2` drew
 * both. The mismatch is suppressed where the operand rule spoke — and only there, which is narrower
 * than "not `+`": the operand rule reads `typeOfExpr`, empty for a string *literal*, so it never fires
 * for `n * "a"` and the mismatch rule is the only thing that catches it. `issues/lang/0238a`.
 *
 * **`n * "a"` is the row that matters most.** A first attempt keyed the suppression on the operator
 * alone and made that program compile — caught by the mutation sweep's *recall*, while its
 * count-disagreement number called the same change an improvement. Two instruments disagreeing is what
 * made it visible, so the row is here to keep it visible.
 */
export string test_a_string_in_an_arithmetic_operator_reports_once() {
  T t = T.create();
  string[] name = string[](
    "s % 2", "s * 2", "s & 1", "n * a-literal", "s + 1 (mismatch is the whole complaint)",
    "1 + a-literal (two literals)");
  string[] src = string[](
    "export i32 f(string s) { return s % 2; }\n",
    "export i32 f(string s) { return s * 2; }\n",
    "export i32 f(string s) { return s & 1; }\n",
    "export i32 f(i32 n) { return n * \"a\"; }\n",
    "export string f(string s) { return s + 1; }\n",
    "export string f() { return 1 + \"a\"; }\n");
  for (i32 i = 0; i < src.len(); i++) {
    i32 diags = dumpTypeErrors(src[i].toBytes()).len() / 3;
    t.eqI32(diags, 1, name[i] + ": one fault, and this many diagnostics");
  }
  // The control that stops all of the above being satisfied by a rule that refuses concatenation:
  // `s + "b"` is an ordinary program.
  i32 ok = dumpTypeErrors("export string f(string s) { return s + \"b\"; }\n".toBytes()).len() / 3;
  t.eqI32(ok, 0, "refused a valid concatenation");
  return t.report();
}

/**
 * A bitwise operator on operands that **differ** reports once, and the mismatch is the complaint.
 *
 * `& | ^` are in *both* rule sets: the bitwise block demands integers, and the same-type block demands
 * the two agree. `%` is only in the second, which is why `issues/lang/0238a` fixed `s % 2` and left
 * `a & b` at two — one fault, reported as a mismatch and as an operand of the wrong kind, both at the
 * operator. The reference reports one, and which one depends on the pair:
 *
 *     i32 & bool     type mismatch in '&': i32 and bool          the operands differ
 *     i32 & f64      type mismatch in '&': i32 and f64           the operands differ
 *     f64 & f64      '&' requires i32 or i64, got f64            they agree and are not integers
 *
 * So the mismatch wins where the two differ, and the kind rule is the whole complaint where they
 * agree. That is `issues/lang/0238a`'s own rule read the other way round — its question is whether the
 * second diagnostic rests on something invented, and here the operand rule adds nothing a reader of
 * *"i32 and bool"* does not already have.
 *
 * **The `f64 & f64` row is the control and is not a formality.** Suppressing the kind rule whenever the
 * bitwise block fires would pass every row above and lose the only diagnostic that program gets, which
 * is the failure this file has recorded twice — see `n * "a"` above, where a suppression keyed on the
 * operator alone made an ill-typed program compile.
 */
/**
 * A component tag and the named construction it desugars to say the **same** thing.
 *
 * `checkJsxComponent` states the rule it is built on: *"The field rules are named construction's …
 * because the desugaring **is** a named construction, and two sets of rules for one construct would
 * differ the first time either moved."* Either moved. `Card { p: a }` for a nullable `a` into a
 * non-null field is reported, and `<Card p={a} />` was not, because the JSX path has its own
 * `assignable` call rather than the construction check's.
 *
 * **wacc is its own oracle here, and it has to be**: the reference has no JSX at all — it answers
 * *expected expression, found '<'* — so the rung-3 differentials cannot see this family, which is why
 * a divergence could sit in it. What can be checked is that one construct written two ways gets one
 * answer, which is the property the comment above claims and the only one that does not need a second
 * compiler.
 */
/**
 * A JSX attribute and a JSX child refuse a **nullable** as they refuse any other wrong type.
 *
 * `spec/spec/jsx.md` has an attribute's value being a `string` and a child being a `Node`, and both
 * slots checked it with `assignable` alone — which answers *true* for `string?` into `string` by
 * design, that being what `nullableIntoNonNull` exists to report separately. So `<div class={s}>` for
 * a `string? s` and `<div>{kid}</div>` for a `Node? kid` were accepted, while an `i32` in either
 * position was refused. The value that might not be there is the one case a slot most needs to catch.
 *
 * **The `i32` rows are why this is a gap and not a slot that checks nothing**, and the well-typed rows
 * are why the fix is not "refuse everything": four controls for two claims.
 */
/**
 * A `match` expression's arms unify **exactly as a ternary's branches do**, which the spec requires.
 *
 * `spec/spec/enums.md` §enum-match-expr-4wnq7bk: the arms unify *"exactly as a ternary's two branches
 * are … and by the same code"*. It was not the same code. The ternary learned to unify a nullability
 * difference (`P` with `P?` is a `P?`) and a subtype pair (`Sub` with `Base` is a `Base`) on
 * 2026-08-25; the match kept requiring the arms to be *equal*, and unknown is silent — so
 * `P r = c ? a : b;` was refused and the identical `match` was accepted.
 *
 * **wacc is its own oracle**, as for JSX: `§enum-*` is a wacc-only clause family, so no rung-3
 * differential covers it and a divergence can sit here indefinitely. The property that needs no second
 * compiler is the one the spec states — one rule, two spellings, one answer.
 */
export string test_a_match_expression_unifies_its_arms_like_a_ternary() {
  T t = T.create();
  const string NULLABLE_DECL = "struct P { i32 x; }\nenum E { A, B }\n";
  i32 tern1 = dumpTypeErrors((NULLABLE_DECL +
    "export i32 f(bool c, P a, P? b) { P r = c ? a : b; return r.x; }\n").toBytes()).len() / 3;
  i32 match1 = dumpTypeErrors((NULLABLE_DECL +
    "export i32 f(E e, P a, P? b) { P r = match (e) { case A: a, else: b }; return r.x; }\n").toBytes()).len() / 3;
  t.isTrue(tern1 > 0, "the ternary stopped refusing a nullable arm in a non-null slot");
  t.eqI32(match1, tern1, "a match and a ternary disagree about a nullable arm");

  const string SUB_DECL = "struct Base { i32 b; }\nstruct Sub : Base { i32 s; }\nenum E { A, B }\n";
  i32 tern2 = dumpTypeErrors((SUB_DECL +
    "export i32 f(bool c, Sub a, Base b) { Sub r = c ? a : b; return r.s; }\n").toBytes()).len() / 3;
  i32 match2 = dumpTypeErrors((SUB_DECL +
    "export i32 f(E e, Sub a, Base b) { Sub r = match (e) { case A: a, else: b }; return r.s; }\n").toBytes()).len() / 3;
  t.isTrue(tern2 > 0, "the ternary stopped refusing a parent arm in a child slot");
  t.eqI32(match2, tern2, "a match and a ternary disagree about a subtype pair");

  // The controls, both spellings: the same programs where the slot *is* the common type are ordinary,
  // so neither fix can be "refuse a match whose arms differ".
  i32 okTern = dumpTypeErrors((SUB_DECL +
    "export i32 f(bool c, Sub a, Base b) { Base r = c ? a : b; return r.b; }\n").toBytes()).len() / 3;
  i32 okMatch = dumpTypeErrors((SUB_DECL +
    "export i32 f(E e, Sub a, Base b) { Base r = match (e) { case A: a, else: b }; return r.b; }\n").toBytes()).len() / 3;
  t.eqI32(okTern, 0, "a ternary widening to the parent was refused");
  t.eqI32(okMatch, 0, "a match widening to the parent was refused");
  return t.report();
}

export string test_a_jsx_attribute_and_child_refuse_a_nullable() {
  T t = T.create();
  const string HEAD = "import { Attr, Node } from \"core\";\n";
  i32 attrNull = dumpTypeErrors((HEAD + "export Node f(string? s) { return <div class={s}></div>; }\n").toBytes()).len() / 3;
  i32 kidNull = dumpTypeErrors((HEAD + "export Node f(Node? kid) { return <div>{kid}</div>; }\n").toBytes()).len() / 3;
  t.isTrue(attrNull > 0, "a nullable string in an attribute was accepted");
  t.isTrue(kidNull > 0, "a nullable Node as a child was accepted");
  // The slots do check — an `i32` in either is refused — so the rows above are a gap rather than a
  // position nothing looks at.
  i32 attrWrong = dumpTypeErrors((HEAD + "export Node f(i32 n) { return <div class={n}></div>; }\n").toBytes()).len() / 3;
  i32 kidWrong = dumpTypeErrors((HEAD + "export Node f(i32 kid) { return <div>{kid}</div>; }\n").toBytes()).len() / 3;
  t.isTrue(attrWrong > 0, "an i32 attribute was accepted, so this slot checks nothing");
  t.isTrue(kidWrong > 0, "an i32 child was accepted, so this slot checks nothing");
  // ...and the ordinary programs stay ordinary.
  i32 attrOk = dumpTypeErrors((HEAD + "export Node f(string s) { return <div class={s}></div>; }\n").toBytes()).len() / 3;
  i32 kidOk = dumpTypeErrors((HEAD + "export Node f(Node kid) { return <div>{kid}</div>; }\n").toBytes()).len() / 3;
  t.eqI32(attrOk, 0, "a string attribute was refused");
  t.eqI32(kidOk, 0, "a Node child was refused");
  return t.report();
}

export string test_a_component_tag_and_its_construction_agree() {
  T t = T.create();
  const string DECL =
    "import { Attr, Node } from \"core\";\n" +
    "struct P { i32 x; }\n" +
    "struct Card {\n" +
    "  P p;\n" +
    "  Node render(const this, Node[] kids) { return <section class=\"card\"></section>; }\n" +
    "}\n";
  // A nullable into the non-null field, both ways round.
  i32 viaJsx = dumpTypeErrors((DECL + "export Node f(P? a) { return <Card p={a} />; }\n").toBytes()).len() / 3;
  i32 viaNamed = dumpTypeErrors((DECL + "export Node f(P? a) { return Card { p: a }.render(Node[]()); }\n").toBytes()).len() / 3;
  t.isTrue(viaNamed > 0, "the named construction stopped reporting a nullable field");
  t.eqI32(viaJsx, viaNamed, "the tag and the construction disagree about the same program");
  // The control, both ways: a `P` in that field is an ordinary program and neither spelling may
  // complain. Without it, a rule that refused every component attribute would satisfy the row above.
  i32 okJsx = dumpTypeErrors((DECL + "export Node f(P a) { return <Card p={a} />; }\n").toBytes()).len() / 3;
  i32 okNamed = dumpTypeErrors((DECL + "export Node f(P a) { return Card { p: a }.render(Node[]()); }\n").toBytes()).len() / 3;
  t.eqI32(okJsx, 0, "a well-typed component tag was refused");
  t.eqI32(okNamed, 0, "a well-typed named construction was refused");
  return t.report();
}

export string test_a_bitwise_operator_on_mismatched_operands_reports_once() {
  T t = T.create();
  string[] name = string[](
    "i32 & bool", "i32 | f64", "i32 ^ bool", "i32 & f64", "bool | i32");
  string[] src = string[](
    "export i32 f(i32 a, bool b) { return a & b; }\n",
    "export i32 f(i32 a, f64 b) { return a | b; }\n",
    "export i32 f(i32 a, bool b) { return a ^ b; }\n",
    "export i32 f(i32 a, f64 b) { return a & b; }\n",
    "export i32 f(bool a, i32 b) { return a | b; }\n");
  for (i32 i = 0; i < src.len(); i++) {
    i32 diags = dumpTypeErrors(src[i].toBytes()).len() / 3;
    t.eqI32(diags, 1, name[i] + ": one fault, and this many diagnostics");
  }
  // **Both operands wrong and agreeing**: the kind rule is the only thing that can speak, so it must.
  i32 agree = dumpTypeErrors("export f64 f(f64 a, f64 b) { return a & b; }\n".toBytes()).len() / 3;
  t.eqI32(agree, 1, "two f64s in `&` — the operand rule is the whole complaint and went quiet");
  i32 bools = dumpTypeErrors("export bool f(bool a, bool b) { return a & b; }\n".toBytes()).len() / 3;
  t.isTrue(bools > 0, "two bools in `&` drew nothing at all");
  // And an ordinary program, so none of the above is satisfied by refusing bitwise outright.
  i32 fine = dumpTypeErrors("export i32 f(i32 a, i32 b) { return (a & b) | (a ^ b); }\n".toBytes()).len() / 3;
  t.eqI32(fine, 0, "refused a valid bitwise expression");
  return t.report();
}

/**
 * **Two duplicate-declaration rules, reported where the duplicate is written.**
 *
 * Both came out of walking the diagnostic codes for ones no generated program reaches, and comparing
 * their positions against the reference. `errDuplicateElse` reported at the match's *subject* — the
 * one part of the statement that is fine — and now reports at the second `else`, agreeing with the
 * reference; `packages/wacc/test/wac/typecheck_test.wac`'s `WRONG()` carries that case and is what
 * keeps it agreeing.
 *
 * **`errDuplicateBinding` is deliberately not in that list, and this test is why.** We point at the
 * second `v`; the reference points at `case`, ten columns earlier. That is a real divergence and the
 * reference is the oracle, but it is the oracle for *whether* a program is wrong rather than for
 * where the reader should look, and "the duplicate binding" is a better answer than "the arm". So
 * the position is asserted here instead — the same arrangement, and for the same reason, as the
 * nullable-array case in `typecheck_test.wac`.
 *
 * The columns are derived from the source rather than written down, because a magic column number is
 * a test that stops meaning anything the first time the program is reworded.
 */
export string test_a_duplicate_binding_and_a_duplicate_else_report_at_the_duplicate() {
  T t = T.create();

  string bindHead = "enum E { A(i32 x, i32 y), B } export i32 f(E e) { match (e) { case A(v, ";
  string bindSrc = bindHead + "v): { return v; } else: { return 0; } } return 0; }\n";
  i32[] bind = dumpTypeErrors(bindSrc.toBytes());
  t.eqI32(bind.len() / 3, 1, "one duplicate binding, and this many diagnostics");
  if (bind.len() >= 3) {
    t.eqI32(bind[2], bindHead.len() + 1,
            "the duplicate binding is reported away from the second `v`");
  }

  string elseHead =
      "enum E { A, B } export i32 f(E e) { match (e) { case A: { return 1; } else: { return 2; } ";
  string elseSrc = elseHead + "else: { return 3; } } return 0; }\n";
  i32[] dup = dumpTypeErrors(elseSrc.toBytes());
  t.isTrue(dup.len() >= 3, "a second `else` drew nothing at all");
  if (dup.len() >= 3) {
    t.eqI32(dup[2], elseHead.len() + 1, "the second `else` is reported away from the `else`");
  }

  // And one `else` is not a duplicate, so that neither of the above is satisfied by refusing `else`.
  i32 fine = dumpTypeErrors(
      ("enum E { A, B } export i32 f(E e) { match (e) { case A: { return 1; } else: { return 2; } }"
       + " return 0; }\n").toBytes()).len() / 3;
  t.eqI32(fine, 0, "refused a match with a single else arm");
  return t.report();
}

/**
 * **Two duplicates the reference refuses while parsing, so no differential can carry them.**
 *
 * A duplicate method and a second `default:` are both refused by the reference — *"switch may have at
 * most one 'default' clause"* at the second `default`, and the same shape for the method — and both at
 * the column we report. But it refuses them in its **parser**, and `typecheck_test.wac`'s `WRONG()`
 * compares against its **checker**, which stays silent. Put them in that list and the assertion
 * becomes "we invent a diagnostic here", which is the opposite of what is true.
 *
 * That is the same split that took a character literal out of the list, and it is worth stating once
 * more because the failure is silent in the useful direction: a rule the reference implements
 * somewhere else reads exactly like a rule it does not implement at all.
 *
 * `spec/spec/naming.md` line 50 makes the duplicate method an error in as many words, and the switch
 * grammar in `spec/spec/control.md` carries a single `default`.
 */
export string test_a_duplicate_method_and_a_second_default_are_refused() {
  T t = T.create();

  string methodHead = "struct P { i32 v; i32 m(this) { return 1; } ";
  string methodSrc = methodHead + "i32 m(this) { return 2; } }\nexport i32 f(P p) { return p.m(); }\n";
  i32[] dupMethod = dumpTypeErrors(methodSrc.toBytes());
  t.isTrue(dupMethod.len() >= 3, "a struct with the same method twice drew nothing at all");
  if (dupMethod.len() >= 3) {
    t.eqI32(dupMethod[2], methodHead.len() + 1,
            "the duplicate method is reported away from the second declaration");
  }

  string switchHead = "export i32 f(i32 n) { switch (n) { default: { return 1; } ";
  string switchSrc = switchHead + "default: { return 2; } } return 0; }\n";
  i32[] twoDefaults = dumpTypeErrors(switchSrc.toBytes());
  t.isTrue(twoDefaults.len() >= 3, "a switch with two defaults drew nothing at all");
  if (twoDefaults.len() >= 3) {
    t.eqI32(twoDefaults[2], switchHead.len() + 1,
            "the second `default` is reported away from the second `default`");
  }

  // One of each, so that neither assertion above is satisfied by refusing the construct outright.
  i32 okMethod = dumpTypeErrors(
      ("struct P { i32 v; i32 m(this) { return 1; } }\nexport i32 f(P p) { return p.m(); }\n")
          .toBytes()).len() / 3;
  t.eqI32(okMethod, 0, "refused a struct with one method");
  i32 okSwitch = dumpTypeErrors(
      ("export i32 f(i32 n) { switch (n) { case 1: { return 1; } default: { return 2; } } return 0; }\n")
          .toBytes()).len() / 3;
  t.eqI32(okSwitch, 0, "refused a switch with one default");
  return t.report();
}

// ---------------------------------------------------------------------------------------------
// The two-file half.
//
// **Everything above is single-file, and that is a bound on what it can measure.** `issues/lang/0180a`
// is a program the fourteen above cannot express: an imported function passed where an `i32` belongs.
// wacc checked it clean and the engine refused the module —
//
//     Compiling function #1:"f" failed: call[0] expected type i32, found struct.new of type (ref 29)
//
// — because the import walk declares the imported name as a *typeless name* so that a single-file
// check calls it unknown rather than undefined, and `isDeclaredName` was the only thing telling that
// placeholder apart from a local. `typeOfExpr`'s `Ident` arm asked it and returned unknown, shadowing
// the signature `declareModule` had already recorded. The identical program with a **local** function
// was refused correctly, which is what named the import as the whole difference. The fix is a second
// bit on the names table; the two shapes that changed what the one bit *says* both false-alarmed on
// working code, which is the more useful half of `issues/lang/0180a`.
//
// The same argument as the header applies one dimension over: wacc's negative corpora were all
// single-file, so a whole class of its silence — names that arrive through an import — had nothing
// looking at it. Measured 2026-08-21: **7 of 7 refused by the checker**, and with the fix reverted
// b01 and b02 go silent in both tests — which is the canary for the row that motivated the half.
// b03 to b07 were already refused by other rules, which is the argument for the half rather than
// for the one row: five of the seven exercise paths nobody had asked about across an import.

string[] names2() {
  return string[](
    "b01 take(MESSAGE), imported funcref as i32", "b02 i32 x = MESSAGE, imported",
    "b03 dbl(s) for imported dbl(i32)", "b04 return imported i32 from a string function",
    "b05 dbl(1, 2) for imported dbl(i32)", "b06 p.v() for an imported struct's field",
    "b07 fn[i32(string)] g = imported dbl(i32)");
}

/** The imported file for each row, parallel to `names2`. */
string[] libs2() {
  return string[](
    "export i32 MESSAGE() { return 4; }\n",
    "export i32 MESSAGE() { return 4; }\n",
    "export i32 dbl(i32 n) { return n * 2; }\n",
    "export i32 one() { return 1; }\n",
    "export i32 dbl(i32 n) { return n * 2; }\n",
    "export struct P { i32 v; }\n",
    "export i32 dbl(i32 n) { return n * 2; }\n");
}

/** The entry for each row, which imports from `./lib.wac` and misuses what it got. */
string[] imps2() {
  return string[](
    "import { MESSAGE } from \"./lib.wac\";\ni32 take(i32 n) { return n; }\n" +
      "export i32 f() { return take(MESSAGE); }\n",
    "import { MESSAGE } from \"./lib.wac\";\nexport i32 f() { i32 x = MESSAGE; return x; }\n",
    "import { dbl } from \"./lib.wac\";\nexport i32 f(string s) { return dbl(s); }\n",
    "import { one } from \"./lib.wac\";\nexport string f() { return one(); }\n",
    "import { dbl } from \"./lib.wac\";\nexport i32 f() { return dbl(1, 2); }\n",
    "import { P } from \"./lib.wac\";\nexport i32 f(P p) { return p.v(); }\n",
    // **The signature is compared now, which it was not.** Before `issues/lang/0180a` an imported
    // name had no type at all, so no funcref declaration could disagree with it; the message names
    // both sides — `expected fn(string) -> i32, found fn(i32) -> i32`.
    "import { dbl } from \"./lib.wac\";\nexport i32 f() { fn[i32(string)] g = dbl; return 0; }\n");
}

export string test_every_two_file_ill_typed_program_is_refused_by_the_checker() {
  T t = T.create();
  string[] name = names2();
  string[] lib = libs2();
  string[] imp = imps2();
  t.eqI32(name.len(), lib.len(), "the name and lib lists disagree in length");
  t.eqI32(name.len(), imp.len(), "the name and entry lists disagree in length");
  if (name.len() != lib.len() || name.len() != imp.len()) { return t.report(); }
  for (i32 i = 0; i < imp.len(); i++) {
    i32 diags = dumpTypeErrorsFiles(
        string[]("/imp.wac", "/lib.wac"), string[](imp[i], lib[i]), "/imp.wac").len() / 3;
    t.isTrue(diags > 0, name[i] + ": checked clean across the import boundary");
  }
  return t.report();
}

/**
 * And the same pair claim as the single-file half: nothing here is accepted by both.
 *
 * The control that matters is the row's *well-typed* twin — `take(MESSAGE())` with the call — which
 * must still check clean, or the rule above is just refusing every imported name.
 */
export string test_no_two_file_program_here_is_accepted_by_both() {
  T t = T.create();
  string[] name = names2();
  string[] lib = libs2();
  string[] imp = imps2();
  string[] paths = string[]("/imp.wac", "/lib.wac");
  for (i32 i = 0; i < imp.len(); i++) {
    i32 diags = dumpTypeErrorsFiles(paths, string[](imp[i], lib[i]), "/imp.wac").len() / 3;
    string blocked = blockedFiles(paths, string[](imp[i], lib[i]), "/imp.wac");
    t.isTrue(diags > 0 || blocked != "", name[i] + ": accepted by both, so a build writes a module "
        + "the engine will not load or one with no `f` in it");
  }
  // **The well-typed twin of b01**, which is the canary for the whole half: with the call parentheses
  // it is an ordinary program and must be silent. A guard that refused an imported function *used*
  // would pass every assertion above and break every program in this repository.
  string good = "import { MESSAGE } from \"./lib.wac\";\ni32 take(i32 n) { return n; }\n" +
                "export i32 f() { return take(MESSAGE()); }\n";
  i32 goodDiags = dumpTypeErrorsFiles(paths, string[](good, libs2()[0]), "/imp.wac").len() / 3;
  t.eqI32(goodDiags, 0, "refused the well-typed twin of b01");
  return t.report();
}
