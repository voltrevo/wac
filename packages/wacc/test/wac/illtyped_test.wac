// The negative half of the corpus: 29 ill-typed programs that must all be refused — 22 single-file,
// and 7 that are only ill-typed across an import boundary.
//
//     wac test --allow-read --allow-write --allow-run --allow-env packages/wacc/test/wac/illtyped_test.wac
//
// **Why this file exists at all.** `issues/lang/0170a` found four programs — `s[0] - 1`, `i32 n = s[0]`,
// `b ? s : 1`, `p.v()` — that wacc checked clean, built with exit 0, and left their exported function
// *out of the module*. The reference refuses all fourteen; wacc refused ten. That is exactly the
// disagreement the corpus differential exists to find, and it never saw them, because the corpus is
// this repository's own files plus `spec/cases/*.wac` and **every one of those is meant to compile**.
// A checker's corpus with no ill-typed programs in it cannot measure what the checker fails to refuse.
//
// So the issue's own conclusion — "fourteen files like the ones above, with the expected refusal
// recorded, would have caught all four and would catch the next one … probably the highest-yield
// single addition here" — is this file. The four are fixed; what this adds is that they cannot go back
// to being silent without a test saying so.
//
// **Two questions per program**, because the failure mode is passing one and failing the other: does
// the checker refuse it, and does the emitter decline anything. A program answering no to both builds
// with its exported function missing, which is the shape `issues/lang/0155` and the export-parity net
// in `emit.wac` are the other guards against. Measured 2026-08-21: **22 of 22 refused by the checker**,
// 0 silent in both. The last four are a *type name* where a value belongs, and three of them were
// silent until `issues/lang/0235a`: only a struct was refused, so `x < i32`, `x < E` and `x < string`
// checked clean and the emitter caught them later as `unresolved name i32`, without a position.

import { T } from "../../../wactest/src/assert.wac";
import { dumpTypeErrors, dumpTypeErrorsFiles, blockedFiles } from "../../src/api.wac";

string[] names() {
  return string[](
    "a01 s - 1", "a02 s[0] - 1", "a03 i32 n = s[0]", "a04 b ? s : 1", "a05 p + 1 (struct)",
    "a06 s < 1", "a07 a(1) (i32 called)", "a08 p.v() (field as method)", "a09 a[0] (i32 indexed)",
    "a10 -s", "a11 a.nope", "a12 g(1,2) for g(i32)", "a13 b + 1 (bool)", "a14 return s from i32",
    // A **type name** where a value belongs. Only the struct case was refused: the other three
    // checked clean and the emitter caught them later as `unresolved name i32`, with no position.
    // The reference refuses all four. `issues/lang/0235a`.
    "a15 x < i32 (primitive)", "a16 x < E (enum)", "a17 x < string", "a18 x < P (struct)",
    // Bitwise and shift on something that is not an integer. All four checked clean; two of them
    // emitted a module the engine refuses. `issues/lang/0236a`.
    "a19 1.5 & 2.5", "a20 x & 1.5", "a21 \"a\" << 1", "a22 x << \"a\"",
    // `++`/`--` in value position. The *operand* was checked — `q++` on a bool is refused — and the
    // expression's own type was never computed, so what it produced could go anywhere. Four spellings
    // because the missing arm served all four: postfix, prefix, decrement, and an argument rather than
    // an initialiser. `issues/lang/0242a`.
    "a23 string s = x++", "a24 string s = ++x", "a25 string s = x--", "a26 g(x++) for g(string)");
}

string[] programs() {
  return string[](
    "export i32 f(string s) { return s - 1; }\n",
    "export i32 f(string s) { return s[0] - 1; }\n",
    "export i32 f(string s) { i32 n = s[0]; return n; }\n",
    "export i32 f(string s, bool b) { return b ? s : 1; }\n",
    "struct P { i32 v; }\nexport i32 f(P p) { return p + 1; }\n",
    "export i32 f(string s) { return s < 1 ? 1 : 0; }\n",
    "export i32 f(i32 a) { return a(1); }\n",
    "struct P { i32 v; }\nexport i32 f(P p) { return p.v(); }\n",
    "export i32 f(i32 a) { return a[0]; }\n",
    "export i32 f(string s) { return -s; }\n",
    "export i32 f(i32 a) { return a.nope; }\n",
    "i32 g(i32 x) { return x; }\nexport i32 f() { return g(1, 2); }\n",
    "export i32 f(bool b) { return b + 1; }\n",
    "export i32 f(string s) { return s; }\n",
    "export bool f(i32 x) { return x < i32; }\n",
    "enum E { A, B }\nexport bool f(i32 x) { return x < E; }\n",
    "export bool f(i32 x) { return x < string; }\n",
    "struct P { i32 v; }\nexport bool f(i32 x) { return x < P; }\n",
    "export f64 f() { return 1.5 & 2.5; }\n",
    "export i32 f(i32 x) { return x & 1.5; }\n",
    "export string f() { return \"a\" << 1; }\n",
    "export i32 f(i32 x) { return x << \"a\"; }\n",
    "export i32 f(i32 x) { string s = x++; return s.len(); }\n",
    "export i32 f(i32 x) { string s = ++x; return s.len(); }\n",
    "export i32 f(i32 x) { string s = x--; return s.len(); }\n",
    "i32 g(string s) { return s.len(); }\nexport i32 f(i32 x) { return g(x++); }\n");
}

export string test_every_ill_typed_program_here_is_refused_by_the_checker() {
  T t = T.create();
  string[] name = names();
  string[] src = programs();
  // The lists are parallel, and a case added to one and not the other would be skipped in silence —
  // which is the failure this whole file is about.
  t.eqI32(name.len(), src.len(), "the name and program lists disagree in length");
  if (name.len() != src.len()) { return t.report(); }
  for (i32 i = 0; i < src.len(); i++) {
    i32 diags = dumpTypeErrors(src[i].toBytes()).len() / 3;
    // **The count, not the code.** Which rule fires is the checker's business and several of these
    // draw two; that a wrongly-typed program is refused *at all* is the claim, and it is the one that
    // was false for four of them.
    t.isTrue(diags > 0, name[i] + ": accepted an ill-typed program");
  }
  return t.report();
}

/**
 * The four that were silent, named for what they are.
 *
 * A loop failing on "a02" says less than a test whose name is the reason. These are the four the issue
 * measured as `check` clean, `wac build` exit 0, and the exported function absent — two filed
 * separately as `issues/lang/0159` and `0165`, and two never filed at all.
 */
export string test_the_four_that_used_to_build_with_the_function_missing() {
  T t = T.create();
  string[] name = string[]("indexing a string then subtracting (0159)",
                           "initialising an i32 from a string index",
                           "a ternary whose branches are a string and an i32",
                           "calling a field as a method (0165)");
  string[] all = programs();
  string[] src = string[](all[1], all[2], all[3], all[7]);
  for (i32 i = 0; i < src.len(); i++) {
    i32 diags = dumpTypeErrors(src[i].toBytes()).len() / 3;
    t.isTrue(diags > 0, name[i] + ": silent again");
  }
  return t.report();
}

/**
 * And the pair taken together, which is the durable claim.
 *
 * Not that every program is declined by the emitter — seven are not, and that is right: the checker
 * refuses them first and `example/wacc.wac` checks before it emits. What this holds is weaker and
 * harder to lose: **no program here is accepted by both.** A row that goes silent in both is a module
 * built with its exported function missing and an exit code of 0, whatever the mechanism was.
 */
export string test_no_program_here_is_accepted_by_both_the_checker_and_the_emitter() {
  T t = T.create();
  string[] name = names();
  string[] src = programs();
  for (i32 i = 0; i < src.len(); i++) {
    i32 diags = dumpTypeErrors(src[i].toBytes()).len() / 3;
    string blocked = blockedFiles(string[]("/m.wac"), string[](src[i]), "/m.wac");
    t.isTrue(diags > 0 || blocked != "",
        name[i] + ": the checker and the emitter both accepted it, so a build writes a module with "
        + "no `f` in it and exits 0");
  }
  return t.report();
}

/**
 * A refused unary reports **once**, not once per rule that notices the consequence.
 *
 * `~s` in an `i32` function drew two diagnostics: the operand rule that refused it, and a slot rule
 * comparing the `i32` return type against the type `typeOfExpr` had handed back for `~s` — its
 * *operand's* type, invented for an expression already refused. Moving the same expression into a
 * `string` function dropped it to one, which is what identified the mechanism. `issues/lang/0238a`.
 *
 * **The count is the assertion, and it has to be.** Every other test in this file asks `diags > 0`,
 * which was true before the fix and after it, so nothing here could hold this. The mutation corpus
 * cannot either: its 19 count-disagreements are binary and initialiser shapes, and re-running it after
 * this fix moved the number not at all — it contains no unary in a mismatched slot.
 */
export string test_a_refused_unary_reports_once() {
  T t = T.create();
  string[] name = string[]("~ on a string", "unary - on a bool", "unary - on a string");
  string[] src = string[](
    "export i32 f(string s) { return ~s; }\n",
    "export i32 f(bool b) { return -b; }\n",
    "export i32 f(string s) { return -s; }\n");
  for (i32 i = 0; i < src.len(); i++) {
    i32 diags = dumpTypeErrors(src[i].toBytes()).len() / 3;
    t.eqI32(diags, 1, name[i] + ": one fault, and this many diagnostics");
  }
  // The control: the same expression where the slot agrees was always one, so a fix that simply
  // silenced the second rule everywhere would pass the rows above and fail nothing.
  i32 ok = dumpTypeErrors("export string f(string s) { return ~s; }\n".toBytes()).len() / 3;
  t.eqI32(ok, 1, "the matching-slot control");
  return t.report();
}

/**
 * A string in an arithmetic operator is reported **once**, by whichever rule can see it.
 *
 * Two rules overlapped: the operand rule (*"a string is a number for exactly one operator"*) and the
 * mismatch rule, both keyed on a string beside a non-string in an arithmetic operator. `s % 2` drew
 * both. The mismatch is suppressed where the operand rule spoke — and only there, which is narrower
 * than "not `+`": the operand rule reads `typeOfExpr`, empty for a string *literal*, so it never fires
 * for `n * "a"` and the mismatch rule is the only thing that catches it. `issues/lang/0238a`.
 *
 * **`n * "a"` is the row that matters most.** A first attempt keyed the suppression on the operator
 * alone and made that program compile — caught by the mutation sweep's *recall*, while its
 * count-disagreement number called the same change an improvement. Two instruments disagreeing is what
 * made it visible, so the row is here to keep it visible.
 */
export string test_a_string_in_an_arithmetic_operator_reports_once() {
  T t = T.create();
  string[] name = string[](
    "s % 2", "s * 2", "s & 1", "n * a-literal", "s + 1 (mismatch is the whole complaint)",
    "1 + a-literal (two literals)");
  string[] src = string[](
    "export i32 f(string s) { return s % 2; }\n",
    "export i32 f(string s) { return s * 2; }\n",
    "export i32 f(string s) { return s & 1; }\n",
    "export i32 f(i32 n) { return n * \"a\"; }\n",
    "export string f(string s) { return s + 1; }\n",
    "export string f() { return 1 + \"a\"; }\n");
  for (i32 i = 0; i < src.len(); i++) {
    i32 diags = dumpTypeErrors(src[i].toBytes()).len() / 3;
    t.eqI32(diags, 1, name[i] + ": one fault, and this many diagnostics");
  }
  // The control that stops all of the above being satisfied by a rule that refuses concatenation:
  // `s + "b"` is an ordinary program.
  i32 ok = dumpTypeErrors("export string f(string s) { return s + \"b\"; }\n".toBytes()).len() / 3;
  t.eqI32(ok, 0, "refused a valid concatenation");
  return t.report();
}

// ---------------------------------------------------------------------------------------------
// The two-file half.
//
// **Everything above is single-file, and that is a bound on what it can measure.** `issues/lang/0180a`
// is a program the fourteen above cannot express: an imported function passed where an `i32` belongs.
// wacc checked it clean and the engine refused the module —
//
//     Compiling function #1:"f" failed: call[0] expected type i32, found struct.new of type (ref 29)
//
// — because the import walk declares the imported name as a *typeless name* so that a single-file
// check calls it unknown rather than undefined, and `isDeclaredName` was the only thing telling that
// placeholder apart from a local. `typeOfExpr`'s `Ident` arm asked it and returned unknown, shadowing
// the signature `declareModule` had already recorded. The identical program with a **local** function
// was refused correctly, which is what named the import as the whole difference. The fix is a second
// bit on the names table; the two shapes that changed what the one bit *says* both false-alarmed on
// working code, which is the more useful half of `issues/lang/0180a`.
//
// The same argument as the header applies one dimension over: wacc's negative corpora were all
// single-file, so a whole class of its silence — names that arrive through an import — had nothing
// looking at it. Measured 2026-08-21: **7 of 7 refused by the checker**, and with the fix reverted
// b01 and b02 go silent in both tests — which is the canary for the row that motivated the half.
// b03 to b07 were already refused by other rules, which is the argument for the half rather than
// for the one row: five of the seven exercise paths nobody had asked about across an import.

string[] names2() {
  return string[](
    "b01 take(MESSAGE), imported funcref as i32", "b02 i32 x = MESSAGE, imported",
    "b03 dbl(s) for imported dbl(i32)", "b04 return imported i32 from a string function",
    "b05 dbl(1, 2) for imported dbl(i32)", "b06 p.v() for an imported struct's field",
    "b07 fn[i32(string)] g = imported dbl(i32)");
}

/** The imported file for each row, parallel to `names2`. */
string[] libs2() {
  return string[](
    "export i32 MESSAGE() { return 4; }\n",
    "export i32 MESSAGE() { return 4; }\n",
    "export i32 dbl(i32 n) { return n * 2; }\n",
    "export i32 one() { return 1; }\n",
    "export i32 dbl(i32 n) { return n * 2; }\n",
    "export struct P { i32 v; }\n",
    "export i32 dbl(i32 n) { return n * 2; }\n");
}

/** The entry for each row, which imports from `./lib.wac` and misuses what it got. */
string[] imps2() {
  return string[](
    "import { MESSAGE } from \"./lib.wac\";\ni32 take(i32 n) { return n; }\n" +
      "export i32 f() { return take(MESSAGE); }\n",
    "import { MESSAGE } from \"./lib.wac\";\nexport i32 f() { i32 x = MESSAGE; return x; }\n",
    "import { dbl } from \"./lib.wac\";\nexport i32 f(string s) { return dbl(s); }\n",
    "import { one } from \"./lib.wac\";\nexport string f() { return one(); }\n",
    "import { dbl } from \"./lib.wac\";\nexport i32 f() { return dbl(1, 2); }\n",
    "import { P } from \"./lib.wac\";\nexport i32 f(P p) { return p.v(); }\n",
    // **The signature is compared now, which it was not.** Before `issues/lang/0180a` an imported
    // name had no type at all, so no funcref declaration could disagree with it; the message names
    // both sides — `expected fn(string) -> i32, found fn(i32) -> i32`.
    "import { dbl } from \"./lib.wac\";\nexport i32 f() { fn[i32(string)] g = dbl; return 0; }\n");
}

export string test_every_two_file_ill_typed_program_is_refused_by_the_checker() {
  T t = T.create();
  string[] name = names2();
  string[] lib = libs2();
  string[] imp = imps2();
  t.eqI32(name.len(), lib.len(), "the name and lib lists disagree in length");
  t.eqI32(name.len(), imp.len(), "the name and entry lists disagree in length");
  if (name.len() != lib.len() || name.len() != imp.len()) { return t.report(); }
  for (i32 i = 0; i < imp.len(); i++) {
    i32 diags = dumpTypeErrorsFiles(
        string[]("/imp.wac", "/lib.wac"), string[](imp[i], lib[i]), "/imp.wac").len() / 3;
    t.isTrue(diags > 0, name[i] + ": checked clean across the import boundary");
  }
  return t.report();
}

/**
 * And the same pair claim as the single-file half: nothing here is accepted by both.
 *
 * The control that matters is the row's *well-typed* twin — `take(MESSAGE())` with the call — which
 * must still check clean, or the rule above is just refusing every imported name.
 */
export string test_no_two_file_program_here_is_accepted_by_both() {
  T t = T.create();
  string[] name = names2();
  string[] lib = libs2();
  string[] imp = imps2();
  string[] paths = string[]("/imp.wac", "/lib.wac");
  for (i32 i = 0; i < imp.len(); i++) {
    i32 diags = dumpTypeErrorsFiles(paths, string[](imp[i], lib[i]), "/imp.wac").len() / 3;
    string blocked = blockedFiles(paths, string[](imp[i], lib[i]), "/imp.wac");
    t.isTrue(diags > 0 || blocked != "", name[i] + ": accepted by both, so a build writes a module "
        + "the engine will not load or one with no `f` in it");
  }
  // **The well-typed twin of b01**, which is the canary for the whole half: with the call parentheses
  // it is an ordinary program and must be silent. A guard that refused an imported function *used*
  // would pass every assertion above and break every program in this repository.
  string good = "import { MESSAGE } from \"./lib.wac\";\ni32 take(i32 n) { return n; }\n" +
                "export i32 f() { return take(MESSAGE()); }\n";
  i32 goodDiags = dumpTypeErrorsFiles(paths, string[](good, libs2()[0]), "/imp.wac").len() / 3;
  t.eqI32(goodDiags, 0, "refused the well-typed twin of b01");
  return t.report();
}
