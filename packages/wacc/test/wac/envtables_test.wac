// Every table one cursor indexes is the same length as the others.
//
// `Env` keeps its function table as **eight parallel arrays and a cursor**. `addFunc` guards the
// cursor, and until 2026-08-25 it guarded it against *one* of the eight — so the invariant that
// actually mattered ("`funcCount` is in bounds for everything it indexes") was enforced by the
// arrays happening to be declared with the same number in them.
//
// They stopped happening to. `issues/system/0257c` made `wac` one program containing the compiler,
// the shell and box's applets, which took the command from 44 files to 218 and past the old cap of
// 4096. Six of the eight were raised together — they sit in one block in `Env.create()`, and were
// found by matching that block's *type signature*. `funcRecv` and `funcMethodGeneric` are declared
// ninety fields later, so they were not in the block, and were not raised.
//
// The failure is what makes this test worth having rather than a comment. There is no diagnostic: the
// guard passes, the write to `funcRecv[funcCount - 1]` in `collectInstances` has no check of its own,
// and the compile dies as `array element access out of bounds` — an engine trap, which
// `issues/lang/0254c` says arrives with **no message at all**. Three hosts print `wac: … trapped` and
// stop. Finding which of a hundred and fifty fields did it took a compile under a JavaScript host to
// get a stack trace with a name in it.
//
// So: assert the shape directly, where a mismatch costs a millisecond and names both arrays. This is
// the same lesson as `bindtables_test.wac` — a fixed table that quietly stopped being big enough —
// but about *agreement between* tables rather than the size of one.

import { T } from "../../../wactest/src/assert.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { Env } from "../../src/emit.wac";
import { emitDeclineFiles } from "../../src/api.wac";

/**
 * The eight arrays `funcCount` indexes, by name, so a failure says which one disagreed.
 *
 * Kept as a literal list rather than derived: the language has no reflection, and a derived list
 * would be derived from the same declaration the test is checking. Adding a ninth array indexed by
 * `funcCount` means adding it here and to `addFunc`'s guard — which is the point of both.
 */
export string test_every_table_the_function_cursor_indexes_is_the_same_length() {
  T t = T.create();
  Env env = Env.create();
  i32 want = env.funcs.len();
  t.eqI32(env.funcReturns.len(), want, "funcReturns is as long as funcs");
  t.eqI32(env.funcParamAt.len(), want, "funcParamAt is as long as funcs");
  t.eqI32(env.funcParamCount.len(), want, "funcParamCount is as long as funcs");
  t.eqI32(env.funcOk.len(), want, "funcOk is as long as funcs");
  t.eqI32(env.funcIndex.len(), want, "funcIndex is as long as funcs");
  // The two that drifted. Named separately in the message because "a parallel array is short" is
  // useless and "funcRecv is short" is the whole diagnosis.
  t.eqI32(env.funcRecv.len(), want, "funcRecv is as long as funcs");
  t.eqI32(env.funcMethodGeneric.len(), want, "funcMethodGeneric is as long as funcs");
  return t.report();
}

/**
 * And that the table is big enough for the largest program in this repository.
 *
 * `wac` itself is the largest, and the number below is a floor rather than a measurement — the
 * point is that the table is not sized just above what happens to be here today. A program that
 * needs more gets `the emitter ran out of room for functions`, which is a sentence rather than a
 * trap, and that is the behaviour `addFunc` now guarantees for all eight.
 */
export string test_and_it_is_big_enough_for_the_largest_program_here() {
  T t = T.create();
  Env env = Env.create();
  i32 got = env.funcs.len();
  if (got < 16384) {
    t.fail("the function table holds " + itoa(got) + ", which is under the 16384 the unified " +
           "`wac` command needed — see issues/system/0257c");
  }
  return t.report();
}

/**
 * `pair<A, B>` at every ordered pair of `n` struct types: `n * n` instantiations of one generic function,
 * and only `n` structs and no arrays — so what fills up is the instantiation table and nothing else.
 */
string manyInstantiations(i32 n) {
  string src = "i32 pair<A, B>(A a, B b) { return 1; }\n";
  for (i32 i = 0; i < n; i++) { src = src + "struct S" + itoa(i) + " { i32 v; }\n"; }
  src = src + "export i32 main() {\n  i32 t = 0;\n";
  for (i32 i = 0; i < n; i++) {
    for (i32 j = 0; j < n; j++) {
      src = src + "  t = t + pair<S" + itoa(i) + ", S" + itoa(j) + ">(S" + itoa(i) + "(1), S" + itoa(j) + "(2));\n";
    }
  }
  return src + "  return t;\n}\n";
}

/**
 * **The instantiation table grows; a large program is not a wrong one.** It was a fixed 512, and a module
 * naming more was declined — *"the emitter ran out of room for generic instantiations"* — about a program
 * with nothing wrong in it. A desktop page that carries box's shell reached it. The lambda capture tables
 * already double when full, and this one does too.
 *
 * 34 × 34 = 1156 is past the old size by more than twice, so a table sized just above today's programs would not
 * pass by accident.
 */
export string test_a_module_with_more_instantiations_than_the_table_starts_with_builds() {
  T t = T.create();
  // The decline's reason, not the module's length: a declined module still has bytes.
  t.eqStr(emitDeclineFiles(["/t/many.wac"], [manyInstantiations(34)], "/t/many.wac"), "",
          "1156 instantiations of one generic function: the emitter declined the module");
  return t.report();
}

/**
 * **The lambda tables, the same.** Eleven arrays are indexed by a lambda's number, and four of them are declared
 * far from the other seven: `capNames`, `capTypes` and `lambdaCapCount` after the walk's scope, `lambdaWrites` after
 * `assignedCount`. `lambdaWrites` is written with no check of its own, so one left short is the engine trap the
 * function table's straggler was.
 */
export string test_every_table_a_lambda_number_indexes_is_the_same_length() {
  T t = T.create();
  Env env = Env.create();
  i32 want = env.lambdaParams.len();
  t.eqI32(env.lambdaBodies.len(), want, "lambdaBodies is as long as lambdaParams");
  t.eqI32(env.lambdaSigs.len(), want, "lambdaSigs is as long as lambdaParams");
  t.eqI32(env.lambdaLine.len(), want, "lambdaLine is as long as lambdaParams");
  t.eqI32(env.lambdaCol.len(), want, "lambdaCol is as long as lambdaParams");
  t.eqI32(env.lambdaInst.len(), want, "lambdaInst is as long as lambdaParams");
  t.eqI32(env.lambdaFile.len(), want, "lambdaFile is as long as lambdaParams");
  t.eqI32(env.capNames.len(), want, "capNames is as long as lambdaParams");
  t.eqI32(env.capTypes.len(), want, "capTypes is as long as lambdaParams");
  t.eqI32(env.lambdaCapCount.len(), want, "lambdaCapCount is as long as lambdaParams");
  t.eqI32(env.lambdaWrites.len(), want, "lambdaWrites is as long as lambdaParams");
  return t.report();
}

/** `n` lambdas in one function, each passed where a `fn<i32(i32)>` is wanted. */
string manyLambdas(i32 n) {
  string src = "i32 apply(fn<i32(i32)> f, i32 x) { return f(x); }\nexport i32 main() {\n  i32 s = 0;\n";
  for (i32 i = 0; i < n; i++) { src = src + "  s = s + apply((i32 x) => x + " + itoa(i) + ", 1);\n"; }
  return src + "  return s;\n}\n";
}

/**
 * **More lambdas than the old 1024 in one module builds.** wac-desktop — the desktop, its apps, `web` and the
 * shell, one module — reached 1024 on 2026-11-01 and was declined: *"the emitter ran out of room for lambdas in one
 * module"*, about a program with nothing wrong in it. 1100 is past the old size, so a table left at it fails here.
 */
export string test_a_module_with_more_than_1024_lambdas_builds() {
  T t = T.create();
  t.eqStr(emitDeclineFiles(["/t/lambdas.wac"], [manyLambdas(1100)], "/t/lambdas.wac"), "",
          "1100 lambdas in one module: the emitter declined it");
  return t.report();
}
