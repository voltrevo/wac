// The productions in the spec are the productions the parser has.
//
//     wac test --allow-read --allow-run --allow-write packages/wacc/test/wac/specproductions_test.wac
//
// `spec/spec/grammar.md` is the formal grammar and `CONTRIBUTING` says the spec is the source of
// truth. It has drifted twice: `issues/lang/closed/0020` found four productions behind the parser
// in July, and `0320a` found four more in September — type parameters missing from `func_decl` and
// `method_decl`, `async` missing from `func_decl`, and written type arguments missing from
// `primary_expr`'s call form.
//
// Its keyword block has a guard for exactly this reason — `[§wac-grammar-keywords-h4mq7wn]`, *"a
// test asserts that, because this block has drifted from the implementation three times"* — and
// `speckeywords_test.wac` is that guard. This is the same idea one level up, and it is written in
// its shape deliberately.
//
// ## Both directions, and they are not symmetrical
//
// - **In the parser and not the production** — the drift both issues found. A reader who writes
//   what the file describes writes less than the language has, and a reader who takes the file as a
//   specification for a *parser* builds one that rejects working code.
// - **In the production and not the parser** — rarer and worse in a different way, because a
//   documented construct that does not exist cannot be discovered by using it: the program simply
//   fails and the reader believes their own mistake. This half is not hypothetical either. While
//   fixing `0320a` I *removed* `method_decl`'s `[ "async" ]`, having measured a method with one as
//   `expected a type` — through a seed three commits behind the sources, which does not fail, it
//   answers as of a few commits ago. This test's first run put it back.
//
// The negative rows carry the second direction: a construct the parser refuses, and the token its
// production must therefore not mention. Two of the three are things something in the tree actively
// wants — `for … in` is `issues/lang/open/0322a` and `default:` for a match arm is what
// `vision/DECISIONS.md` renames `else:` to — which is the situation the direction exists for. A
// wanted construct is exactly the one somebody writes into the grammar before the parser has it.
//
// ## What this can and cannot see
//
// It is a **list of samples**, not an EBNF checker. It knows nothing about productions it has no
// probe for, and a construct nobody thought to add is exactly what it will miss — which is the same
// limit `speckeywords_test.wac` records for its own weaker direction. What it does give is that
// each construct somebody has already been wrong about stays checked, and the list is cheap to
// extend: a probe, an expectation, and the token the production must carry.
//
// A probe is `wac check`ed rather than built. Parsing is the question, and `export async i32 f()`
// reaches the emitter and fails there — an emit failure is not a parse failure and must not read as
// one.

import { T } from "../../../wactest/src/assert.wac";
import { binaryPath, scratch } from "../../../wactest/src/host.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { Core, Cli, Exec, FileResult, Change } from "std/platform.wac";

/**
 * One construct: a program that settles whether the parser has it, and the token that says whether
 * the production does.
 *
 * `parses` is what the compiler is expected to answer. When it is true the production must mention
 * `token`; when it is false the production must not. Both directions from one table, because a
 * table with only the true rows is how the second kind of drift gets in.
 */
struct Probe {
  const string what;
  const string production;
  const string token;
  const string program;
  const bool parses;
}

const Probe[] PROBES = Probe[](
  Probe("a generic function", "func_decl", "type_params",
        "T first<T>(T[] xs) { return xs[0]; }", true),
  Probe("async on a free function", "func_decl", "\"async\"",
        "export async i32 f() { return 1; }", true),
  Probe("a generic method", "method_decl", "type_params",
        "struct S { i32 n; U pick<U>(const this, U a) { return a; } }", true),
  // This row did catch the mistake made while fixing 0320a, on its first run, and the mistake was
  // the opposite of the one expected: `method_decl` *does* take an `async`, and I had removed it.
  Probe("async on a method", "method_decl", "\"async\"",
        "struct S { i32 n; async i32 f(this) { return this.n; } }", true),
  Probe("written type arguments at a call", "primary_expr", "type_args",
        "T zero<T>() { return 0; }\nexport i32 f() { return zero<i32>(); }", true),
  // `await` was a keyword with no production at all — the only one of the thirty-one in the fence
  // that no rule mentioned, found by reading the keyword list against the rules rather than by
  // anything here. Its home is `unary_expr`, which `parse.wac` settles: the `await` branch recurses
  // into `parseUnary`, so it binds tighter than any binary operator and looser than postfix.
  Probe("await on an expression", "unary_expr", "\"await\"",
        "struct P { i32 v; }\nasync i32 g(P p) { return p.v; }\n"
          + "export async i32 f(P p) { return await g(p); }", true),

  // The other direction. Each of these is refused today, so its production must stay silent about
  // it — and each is a construct somebody has a reason to reach for, which is what makes the row
  // worth having rather than a list of things nobody would write.
  Probe("iterating with `for … in`", "for_stmt", "\"in\"",
        "export i32 f() { i32 s = 0; i32[] xs = i32[](1); for (i32 x in xs) { s = s + x; } return s; }",
        false),
  Probe("`default:` as a match arm", "match_arm", "\"default\"",
        "enum E { A, B }\nexport i32 f(E e) { i32 r = 0; match (e) { case A: { r = 1; } default: { r = 2; } } return r; }",
        false),
  Probe("a `static` method", "method_decl", "\"static\"",
        "struct S { i32 n; static i32 z() { return 0; } }", false),
);

string read(Cli cli, string path) {
  FileResult r = cli.readFile(path).wait();
  return r.ok ? string.fromBytes(r.bytes) : "";
}

/**
 * The text of one production: from the line that opens it to the `;` that ends it.
 *
 * A production may wrap — `func_decl` does — so this cannot be one line, and it ends at a `;`
 * rather than at a blank line because the EBNF comment that follows some of them contains neither.
 *
 * **Outside quotes**, which is the whole of the difficulty. `for_stmt` has two `";"` *tokens* in it
 * and stopping at the first character would have returned a fifth of the production. Truncation is
 * dangerous in one direction only, and it is the direction the negative rows use: a production cut
 * short does not mention anything, so a `parses: false` row would pass by having read almost none
 * of the text it was asserting about.
 */
string production(string grammar, string name) {
  i32 at = grammar.indexOf("\n" + name + " ");
  if (at < 0) { at = grammar.indexOf("\n" + name + "="); }
  if (at < 0) { return ""; }
  string rest = grammar.slice(at + 1, grammar.len());

  bool quoted = false;
  for (i32 i = 0; i < rest.len(); i++) {
    string c = rest[i];
    if (c == "\"") { quoted = !quoted; continue; }
    if (c == ";" && !quoted) { return rest.slice(0, i + 1); }
  }
  return "";
}

export string test_every_construct_somebody_was_wrong_about_stays_checked(Core core, Cli cli) {
  T t = T.create();

  string grammar = read(cli, "spec/spec/grammar.md");
  t.isTrue(grammar.len() > 4000, "spec/spec/grammar.md read as " + itoa(grammar.len()) + " bytes");
  if (grammar.len() == 0) { return t.report(); }

  // The extractor, on the production that would catch it stopping at a quoted `;`. `for_update` is
  // past two of them, so a reader that did would return neither it nor the closing `block ;`.
  string forStmt = production(grammar, "for_stmt");
  t.isTrue(forStmt.indexOf("for_update") >= 0 && forStmt.indexOf("block ;") >= 0,
    "the production reader stopped early — `for_stmt` came back as `" + forStmt + "`");

  string dir = scratch(cli, "specproductions");
  cli.remove(dir, true).wait();
  Change made = cli.mkdir(dir, true).wait();
  t.isTrue(made.ok(), "could not make " + dir + " — " + made.message);
  if (!made.ok()) { return t.report(); }

  string wac = binaryPath(cli);

  for (i32 i = 0; i < PROBES.len(); i++) {
    Probe p = PROBES[i];

    string path = dir + "/p.wac";
    cli.writeFile(path, p.program.toBytes()).wait();
    Exec r = cli.exec(wac, string[]("check", path), u8[0]()).wait();
    bool parsed = r.ran() && r.status == 0;

    // First that the probe still measures what it was written to measure. A probe that stopped
    // parsing for an unrelated reason would otherwise quietly agree with a production that had
    // dropped the token.
    t.eqBool(parsed, p.parses,
      p.what + ": `wac check` " + (parsed ? "accepted" : "refused") + " the probe, expected the "
        + (p.parses ? "opposite — the construct may have been removed" : "opposite — it may have been added"));
    if (parsed != p.parses) { continue; }

    string text = production(grammar, p.production);
    t.isTrue(text != "", "no production named `" + p.production + "` in grammar.md");
    if (text == "") { continue; }

    bool mentions = text.indexOf(p.token) >= 0;
    if (p.parses) {
      t.isTrue(mentions,
        p.what + ": the parser accepts it and `" + p.production + "` does not mention " + p.token
          + " — the spec is behind, as in issues/lang/0020 and 0320a");
    } else {
      t.isTrue(!mentions,
        p.what + ": `" + p.production + "` mentions " + p.token + " and the parser refuses it — the "
          + "spec documents a construct that does not exist, which a reader meets as their own bug");
    }
  }

  return t.report();
}
