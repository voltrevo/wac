// The `wac` command line, checked by running it.
//
// **In wac rather than in a `.test.ts`**, which is where these started life earlier tonight: the suite
// is moving off Deno (`issues/system/0161`) and a new host-side test is work somebody has to undo. The
// binary is driven through `Cli.exec`, the same way `selfhost_test.wac` beside this drives it.
//
// What is asserted here is the *surface*: the usage text naming every command the binary dispatches,
// and each of those commands answering rather than being a word in a string. The behaviour behind them
// — grants, trap messages — is in the files named after those subjects.

import { Cli, Core, Exec } from "std/platform.wac";
import { T } from "../../../wactest/src/assert.wac";

/** The binary running this test. */
string binary(Cli cli) { return cli.cwd().wait() + "/native/v8/target/release/wac"; }

/** Run it and answer stdout and stderr together — a usage line goes to stderr. */
string say(Cli cli, string[] args) {
  Exec r = cli.exec(binary(cli), args, u8[0]()).wait();
  if (!r.ran()) { return "the binary would not start: " + r.error; }
  return string.fromBytes(r.stdout) + string.fromBytes(r.stderr);
}

bool holds(string haystack, string needle) { return haystack.indexOf(needle) >= 0; }

/** Whether a byte is one a command name is made of, so a name can be matched whole. */
bool wordByte(string c) {
  return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "_";
}

/**
 * Whether the usage names `cmd` **as a word**, not as a substring of one.
 *
 * `holds(out, "sh")` was true because the usage says *"the shell, sealed unless granted"* — measured: two
 * substring hits, one of them inside `shell`. So the `sh` assertion would have survived the command being
 * removed, and `run` is worse: nine substring hits against seven real ones. A usage check that cannot
 * fail is the shape `issues/system/0190` is about, one layer along.
 */
bool namesCommand(string usage, string cmd) {
  i32 at = 0;
  while (at <= usage.len() - cmd.len()) {
    i32 hit = usage.slice(at, usage.len()).indexOf(cmd);
    if (hit < 0) { return false; }
    i32 start = at + hit;
    i32 end = start + cmd.len();
    bool leftOk = start == 0 || !wordByte(usage.slice(start - 1, start));
    bool rightOk = end >= usage.len() || !wordByte(usage.slice(end, end + 1));
    if (leftOk && rightOk) { return true; }
    at = start + 1;
  }
  return false;
}

/**
 * Every command the binary dispatches is named in its usage.
 *
 * **`sh` is no longer conditional.** It was, because `native/v8/seed/sh.wasm` is gitignored and no task
 * produced it, so the test was green or red per checkout — `issues/system/0190`. `deno task seed` builds
 * all three payloads since 2026-08-20 (`issues/system/0216a`), so every build dispatches `sh` and
 * `update`, and a build that does not is one whose seed is stale. The message says so, because "run
 * `deno task seed`" is the whole remedy and a reader should not have to find that out.
 *
 * Matched **as words**: see `namesCommand`. As substrings these assertions were close to vacuous.
 */
export string test_the_usage_names_every_command(Core core, Cli cli) {
  T t = T.create();
  string out = say(cli, string[]());
  string[] always = string[]("check", "compile", "build", "bindgen", "run", "test", "sh", "update");
  for (i32 i = 0; i < always.len(); i++) {
    t.isTrue(namesCommand(out, always[i]),
             "the usage does not name `" + always[i] + "` — if this build has a stale seed, " +
             "`deno task seed` writes all three payloads");
  }
  // **Two canaries, because the matcher can fail in both directions.** A matcher that says yes to
  // everything satisfies every line above; one that says yes only to whole words is the point of it.
  // `est` occurs three times in this usage — inside `test`, `latest`, `requesting` — and never as a
  // word, so it is the case the old substring check got wrong and this one has to.
  t.isTrue(!namesCommand(out, "frobnicate"), "the usage check matches a command that does not exist");
  t.isTrue(holds(out, "est"), "`est` should be present as a substring, or this canary proves nothing");
  t.isTrue(!namesCommand(out, "est"), "the usage check matches a substring — it was doing that for `sh`");
  return t.report();
}

/**
 * The flags a command cannot be used without.
 *
 * `-o` is how `build` says where to write, and `--allow-run` is a grant of its own that appeared in none
 * of the lines listing the other four — a flag missing from the usage is a flag nobody finds.
 */
export string test_the_usage_names_the_flags_that_matter(Core core, Cli cli) {
  T t = T.create();
  string out = say(cli, string[]());
  t.isTrue(holds(out, "-o"), "the usage does not name `-o`");
  string[] lines = splitLines(out);
  for (i32 i = 0; i < lines.len(); i++) {
    if (!holds(lines[i], "--allow-read")) { continue; }
    t.isTrue(holds(lines[i], "--allow-run"),
             "a usage line lists grants and not --allow-run: " + lines[i]);
  }
  return t.report();
}

/** Each of the compiler's four commands answers, rather than being a word in a usage string. */
export string test_every_command_in_the_usage_is_answered(Core core, Cli cli) {
  T t = T.create();
  string[] commands = string[]("check", "compile", "build", "bindgen");
  for (i32 i = 0; i < commands.len(); i++) {
    string out = say(cli, string[](commands[i], "no-such-file.wac"));
    t.isTrue(!holds(out, "unknown command"),
             "`wac " + commands[i] + "` is in the usage and is not a command: " + out);
  }
  return t.report();
}

string[] splitLines(string s) {
  u8[] b = s.toBytes();
  i32 n = 1;
  for (i32 i = 0; i < b.len(); i++) { if (b[i] == '\n') { n = n + 1; } }
  string[] out = string[n](fill: "");
  i32 at = 0;
  i32 start = 0;
  for (i32 i = 0; i <= b.len(); i++) {
    if (i < b.len() && b[i] != '\n') { continue; }
    out[at] = s.slice(start, i);
    at = at + 1;
    start = i + 1;
  }
  return out;
}
