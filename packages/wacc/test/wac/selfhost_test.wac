// The compiler compiles itself, and doing it again changes nothing.
//
// `wac task seed` is `wac build packages/wac/src/wac.wac` followed by `cargo build`: the
// binary compiling its own compiler, with no JavaScript host in the loop. That is only true while
// wacc can build wacc, and only *useful* while the result is stable — a compiler that produced a
// different compiler each time would still work and would make every artefact unreproducible.
//
// **3.0s, two builds of the compiler.** Measured 2026-08-18. `wac task seed` does the same thing and
// checks the same property; this is the version that runs in the suite, so a fixed point that stops
// holding fails a push rather than waiting for somebody to reseed.
//
// So this asserts the fixed point. Compile wacc with the seed the binary carries, then compile it
// again with the same binary, and require the two to be byte-identical.
//
// **Not a round trip.** Both builds use the *embedded* seed, so this does not prove the new compiler
// can build itself — that is what actually running `wac task seed` and then this test again shows,
// and the sequence is: seed, run the suite, seed again. What it does catch is the failure that would
// otherwise be found by a stale artefact months later: a wacc whose output depends on something
// other than its input.
//
// This test is itself the thing it is about. It runs under `wac test`, which is the binary, and it
// reaches the compiler through `Cli.exec` — so a repository where the goal has been reached still
// has one file that needs `--allow-run` and it is this one. `issues/system/0165`.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli, Exec, Change, FileResult, Stat, Pending } from "std/platform.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { equal } from "../../../bytes/src/slice.wac";
import { madeDir } from "../../../wactest/src/host.wac";

const string ENTRY = "packages/wac/src/wac.wac";

/** The first `/agent-…/` segment of `cwd`, or "" — several agents share this filesystem. */
string agentDir(Cli cli) {
  string cwd = cli.cwd().wait();
  u8[] b = cwd.toBytes();
  for (i32 i = 0; i + 7 < b.len(); i++) {
    if (b[i] != '/') { continue; }
    if (cwd.slice(i + 1, i + 7) != "agent-") { continue; }
    i32 end = i + 7;
    while (end < b.len() && b[end] != '/') { end = end + 1; }
    return cwd.slice(i + 1, end);
  }
  return "";
}

/** Where to put the two builds, named for this agent so two runs cannot overwrite each other. */
string workDir(Cli cli) {
  string who = agentDir(cli);
  return "/tmp/wac-selfhost" + (who == "" ? "" : "-" + who);
}

/** The binary running this test — the same one that would run `wac task seed`. */
string binary(Cli cli) { return cli.cwd().wait() + "/native/v8/target/release/wac"; }

/**
 * Start a compile of wacc to `stem`, without waiting for it.
 *
 * `[§wac-cli-build-nocache-2wq9nk4]`
 *
 * **`--no-cache`, and this test is the reason the flag exists.** `wac build` remembers what it built
 * (`issues/system/0204`), keyed on the compiler, the sources, the grants and the output's base *name* —
 * and both builds here share all four, because the name is deliberately the same and only the directory
 * differs. So a warm cache answers the second from disk, and this test becomes one artefact compared
 * with itself: measured at **194 ms** against the 3 s of two compiler builds documented above, still
 * passing, and still passing when its cache entry was replaced with a different valid module. `0204`
 * predicted exactly that before the cache was written.
 */
Pending<Exec> submitBuild(Cli cli, string stem) {
  return cli.exec(binary(cli),
                  string[]("build", ENTRY, "-o", stem, "--allow-read", "--allow-write", "--no-cache"),
                  u8[0]());
}

/** A message on one line, because a report that stops at the first newline loses the rest. */
string oneLine(string s) {
  string out = "";
  for (i32 i = 0; i < s.len(); i++) {
    string c = s.slice(i, i + 1);
    out = out + (c == "\n" || c == "\r" ? " | " : c);
  }
  return out;
}

/**
 * Its error, or "".
 *
 * **Flattened, because the interesting part was below the fold.** A gate on 2026-08-19 failed here with
 * `wac build exited 1: wac: packages/wac/src/wac.wac trapped` and nothing after it: the build's
 * stderr was in the message all along, and the report shows a failure's first line. A trap the compiler
 * wrote a reason for is exactly what `issues/system/0203` needs the next time this happens.
 */
string built(Pending<Exec> p) {
  Exec r = p.wait();
  if (!r.ran()) { return "the binary would not start: " + r.error; }
  if (r.status != 0) {
    return "wac build exited " + itoa(r.status) + ": " + oneLine(string.fromBytes(r.stderr))
           + " -- and stdout: " + oneLine(string.fromBytes(r.stdout));
  }
  // **The flag is checked rather than trusted.** `--no-cache` coming off the command line above would
  // not fail anything — it would make both builds fast and the comparison vacuous — so the one
  // observable that distinguishes a compile from a lookup is asserted here, where both builds pass.
  if (string.fromBytes(r.stdout).indexOf("from cache") >= 0) {
    return "this build was answered from the build cache, so the comparison is one artefact against "
           + "itself rather than two compiles: " + oneLine(string.fromBytes(r.stdout));
  }
  return "";
}

u8[] read(Cli cli, string path) {
  FileResult r = cli.readFile(path).wait();
  if (!r.ok) { return u8[0](); }
  return r.bytes;
}

/**
 * Two builds of the compiler, byte for byte — **at the same time**.
 *
 * The two must be given the same output *name*, because the name goes into the manifest and the
 * manifest is embedded in the module: building to `a` and `b` would differ in exactly those bytes and
 * prove nothing. What this file used to conclude from that is that they had to be built **in turn** to
 * one path, with the first copied aside — and the name is not the path. Two builds of `wacc` into two
 * directories are byte-identical, so they can be started together: 13.0s of
 * this test became 7.0s, and the fixed point is still two fresh builds in one run rather than a cached
 * artefact compared against a new one.
 *
 * **What a difference now means is one of two things**, and the assertions say so: either the compiler
 * is not a fixed point, which is the defect this exists for, or an output *path* reached the artefact,
 * which would be a new one. Before, the second was impossible by construction and also untested.
 */
export string test_the_compiler_builds_itself_to_a_fixed_point(Core core, Cli cli) {
  T t = T.create();
  Stat bin = cli.stat(binary(cli)).wait();
  t.isTrue(bin.exists, "the binary under test is where `wac task seed` writes it: " + binary(cli));
  if (!bin.exists) { return t.report(); }

  string work = workDir(cli);
  Change made = cli.mkdir(work, true).wait();
  t.isTrue(made.ok(), "a working directory: " + made.message);
  if (!made.ok()) { return t.report(); }

  // Same name, two directories: `wacc` either way, which is what the manifest records.
  string whyDir1 = madeDir(cli, work + "/one");
  t.isTrue(whyDir1 == "", whyDir1);
  string whyDir2 = madeDir(cli, work + "/two");
  t.isTrue(whyDir2 == "", whyDir2);
  Pending<Exec> pOne = submitBuild(cli, work + "/one/wacc");
  Pending<Exec> pTwo = submitBuild(cli, work + "/two/wacc");
  string first = built(pOne);
  string second = built(pTwo);
  t.eqStr(first, "", "the compiler compiles itself");
  t.eqStr(second, "", "and does it again");
  if (first != "" || second != "") { return t.report(); }

  u8[] wasmOne = read(cli, work + "/one/wacc.wasm");
  // A floor, so a build that wrote nothing cannot pass by matching another empty file.
  t.isTrue(wasmOne.len() > 100000,
           "the module is a compiler, not a stub — " + itoa(wasmOne.len()) + " bytes");

  u8[] wasmTwo = read(cli, work + "/two/wacc.wasm");
  t.eqI32(wasmTwo.len(), wasmOne.len(), "the two modules are the same size");
  // **One comparison, not two.** This compared the manifests separately when `wac build` wrote one
  // beside the module; the manifest is a section *inside* the module now, so comparing the modules
  // compares it too, and a second check over the same bytes would only look like more evidence.
  t.isTrue(equal(wasmOne, wasmTwo),
           "either the compiler is not a fixed point — building it twice gave different bytes — or the "
           + "output path reached the artefact, which the two directories would then be recording");

  Change gone = cli.remove(work, true).wait();
  if (!gone.ok()) { core.warn("selfhost: could not remove " + work + " — " + gone.message); }
  return t.report();
}
