// Two walks in the compiler that must not multiply by the size of the program.
//
// `issues/lang/0398b`: building box's shell took 66 s against 6 s in August, and a third of it was the
// checker scanning every source of the graph once per type name, a fifth the emitter walking every
// variant once per field once per named instance. Each was linear on its own and the product was the
// cost. Neither changes an answer, so nothing else here can see them come back.
//
// A wall-clock bound would flake on a loaded machine, so each test is a ratio of two runs made back to
// back, differing only in the thing the walk multiplies by: with the walk linear the two are close.

import { T } from "../../../wactest/src/assert.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { diagnoseFiles, emitFiles, lowerSources } from "../../src/api.wac";
import { Res } from "../../src/path.wac";
import { lex } from "../../src/lex.wac";
import { synthSource, synthTokens } from "../../src/asyncsynth.wac";
import { Core } from "std";

/** `parts` as one string, copied once — `out = out + part` would be the cost being measured. */
string joinedParts(string[] parts, i32 n) {
  i32 total = 0;
  for (i32 i = 0; i < n; i++) { total = total + parts[i].toBytes().len(); }
  u8[] out = u8[].filled(total, 0);
  i32 at = 0;
  for (i32 i = 0; i < n; i++) {
    u8[] b = parts[i].toBytes();
    out.copyFrom(b, 0, at, b.len());
    at = at + b.len();
  }
  return string.fromBytes(out);
}

i32 millis(i64 nanos) { return (nanos / (1000000 as i64)) as! i32; }

/** An entry naming `n` struct types in signatures, importing one name from `/t/lib.wac`. */
string namingEntry(i32 n) {
  string[] parts = string[].filled(2 * n + 1, "");
  parts[0] = "import { Lib } from \"./lib.wac\";\n";
  for (i32 i = 0; i < n; i++) {
    parts[1 + 2 * i] = "struct S" + itoa(i) + " { i32 v; }\n";
    parts[2 + 2 * i] = "i32 f" + itoa(i) + "(S" + itoa(i) + " a, Lib l) { return a.v; }\n";
  }
  return joinedParts(parts, 2 * n + 1);
}

/** `/t/lib.wac`: its one declaration, then `kb` kilobytes of comment. */
string libWithComment(i32 kb) {
  string line = "// filler filler filler filler filler filler filler filler filler filler filler filler\n";
  i32 n = kb * 1024 / line.len() + 1;
  string[] parts = string[].filled(n + 1, line);
  parts[0] = "export struct Lib { i32 x; }\n";
  return joinedParts(parts, n + 1);
}

i64 timeCheck(Core core, string entry, string lib) {
  i64 t0 = core.monotonicNanos().wait();
  diagnoseFiles(["/t/m.wac", "/t/lib.wac"], [entry, lib], "/t/m.wac");
  return core.monotonicNanos().wait() - t0;
}

// **The checker reads the graph's `export type` names once, not once per type name.** Until the view of
// every file is built, each named type asks whether some file declares it as a `type`, and that was a
// search of every source's whole text. Beside a 1 MB file, doubling the names checked from 300 to 600
// costs about 1.3× when the file is read once — reading a megabyte is a cost both runs pay — and
// about 2× when it is read once per name, which is what it was: 6.2 s against 3.1.
//
// Not a megabyte against one line, which is what this compared first: once the rest of the compiler
// got faster, merely lexing the megabyte outweighed checking the names, and a correct checker failed.
export string test_a_large_imported_file_is_not_rescanned_per_type_name(Core core) {
  T t = T.create();
  string big = libWithComment(1024);
  string fewer = namingEntry(300);
  string more = namingEntry(600);
  timeCheck(core, fewer, big);
  i64 a = timeCheck(core, fewer, big);
  i64 b = timeCheck(core, more, big);
  // **The best of three**, because a loaded machine only ever adds time: one slow run of either
  // side was enough to read as a ratio the code does not have.
  for (i32 k = 0; k < 2; k++) {
    i64 a2 = timeCheck(core, fewer, big);
    i64 b2 = timeCheck(core, more, big);
    if (a2 < a) { a = a2; }
    if (b2 < b) { b = b2; }
  }
  t.isTrue(b * (5 as i64) < a * (8 as i64),
           "beside a 1 MB file: " + itoa(millis(a)) + " ms checking 300 named types, "
           + itoa(millis(b)) + " ms checking 600");
  return t.report();
}

/**
 * An enum of 2,000 variants, a struct of 400 fields, and 200 functions — each naming `Box<i32>`, or
 * when `named` is false doing the same with a bare `i32`, so the two differ only in the instance.
 */
string instanceProgram(bool named) {
  string[] parts = string[].filled(2000 + 400 + 200 + 3, "");
  i32 n = 0;
  parts[n] = "struct Box<T> { T v; }\nenum Many {\n"; n++;
  for (i32 i = 0; i < 2000; i++) { parts[n] = "  V" + itoa(i) + "(i32 x),\n"; n++; }
  parts[n] = "}\nstruct Wide {\n"; n++;
  for (i32 i = 0; i < 400; i++) { parts[n] = "  i32 w" + itoa(i) + ";\n"; n++; }
  parts[n] = "}\n"; n++;
  for (i32 i = 0; i < 200; i++) {
    parts[n] = named
        ? "export i32 f" + itoa(i) + "() { Box<i32> b = Box<i32>(" + itoa(i) + "); return b.v; }\n"
        : "export i32 f" + itoa(i) + "() { i32 b = " + itoa(i) + "; return b; }\n";
    n++;
  }
  return joinedParts(parts, n);
}

i64 timeEmit(Core core, string src) {
  i64 t0 = core.monotonicNanos().wait();
  emitFiles(["/t/m.wac"], [src], "/t/m.wac");
  return core.monotonicNanos().wait() - t0;
}

// **Naming an instance looks at its own variants, not at every variant once per field.** Registering
// `Box<i32>`'s array fields walks every field of the program, and asked `enumOf` — a walk of every
// variant — about each. The two programs are the same size; only one names the instance. It was
// 3,408 ms against 112.
export string test_naming_an_instance_does_not_walk_every_variant_per_field(Core core) {
  T t = T.create();
  string bare = instanceProgram(false);
  string named = instanceProgram(true);
  timeEmit(core, bare);
  i64 a = timeEmit(core, bare);
  i64 b = timeEmit(core, named);
  // **The best of three**, because a loaded machine only ever adds time: one slow run of either
  // side was enough to read as a ratio the code does not have.
  for (i32 k = 0; k < 2; k++) {
    i64 a2 = timeEmit(core, bare);
    i64 b2 = timeEmit(core, named);
    if (a2 < a) { a = a2; }
    if (b2 < b) { b = b2; }
  }
  t.isTrue(b < a * (3 as i64),
           "200 functions beside 2,000 variants and 400 fields: " + itoa(millis(a))
           + " ms with `i32`, " + itoa(millis(b)) + " ms with `Box<i32>`");
  return t.report();
}

/** `/t/lib.wac`: `export struct P`, then `decls` functions. */
string declsLib(i32 decls) {
  string[] parts = string[].filled(decls + 1, "");
  parts[0] = "export struct P { i32 v; }\n";
  for (i32 i = 0; i < decls; i++) {
    parts[1 + i] = "export i32 g" + itoa(i) + "() { return " + itoa(i) + "; }\n";
  }
  return joinedParts(parts, decls + 1);
}

/** 300 functions naming the imported `P` four times each, or when `named` is false `i32` instead. */
string importingEntry(bool named) {
  string[] parts = string[].filled(301, "");
  parts[0] = "import { P, g1 } from \"./lib.wac\";\nexport i32 h() { return g1(); }\n";
  for (i32 i = 0; i < 300; i++) {
    parts[1 + i] = named
        ? "export i32 f" + itoa(i) + "(P a, P b) { P c = P(1); P d = a; return c.v + d.v + b.v; }\n"
        : "export i32 f" + itoa(i) + "(i32 a, i32 b) { i32 c = 1; i32 d = a; return c + d + b; }\n";
  }
  return joinedParts(parts, 301);
}

i64 timeEmitTwo(Core core, string entry, string lib) {
  i64 t0 = core.monotonicNanos().wait();
  emitFiles(["/t/m.wac", "/t/lib.wac"], [entry, lib], "/t/m.wac");
  return core.monotonicNanos().wait() - t0;
}

// **Resolving a name does not walk every declaration.** The emitter found a name's key by walking
// every declaration of the module, up to four times when the name came from another file, and every new
// declaration walked them all again to see whether its key was taken. So the same entry cost twice as
// much beside a file of 8,000 functions as beside one of 4,000, though the entry calls one of them and
// the rest are pruned: 231 ms against 111. Found through an index, the two are the same.
export string test_resolving_a_name_does_not_walk_every_declaration(Core core) {
  T t = T.create();
  string fewer = declsLib(4000);
  string more = declsLib(8000);
  string entry = importingEntry(false);
  timeEmitTwo(core, entry, fewer);
  timeEmitTwo(core, entry, more);
  i64 a = timeEmitTwo(core, entry, fewer);
  i64 b = timeEmitTwo(core, entry, more);
  // **The best of three**, because a loaded machine only ever adds time: one slow run of either
  // side was enough to read as a ratio the code does not have.
  for (i32 k = 0; k < 2; k++) {
    i64 a2 = timeEmitTwo(core, entry, fewer);
    i64 b2 = timeEmitTwo(core, entry, more);
    if (a2 < a) { a = a2; }
    if (b2 < b) { b = b2; }
  }
  t.isTrue(b * (2 as i64) < a * (3 as i64),
           "the same entry: " + itoa(millis(a)) + " ms beside 4,000 declarations, " + itoa(millis(b))
           + " ms beside 8,000");
  return t.report();
}

/** `n` structs, each with a method using another — no type defaults anywhere. */
string manyStructs(i32 n) {
  string[] parts = string[].filled(n, "");
  for (i32 i = 0; i < n; i++) {
    parts[i] = "struct S" + itoa(i) + " { i32 v; i32 get(this) { return this.v; } }\n";
  }
  return joinedParts(parts, n);
}

i64 timeLower(Core core, string src) {
  i64 t0 = core.monotonicNanos().wait();
  lowerSources(["/t/m.wac"], [src], Res.empty());
  return core.monotonicNanos().wait() - t0;
}

// **Lowering reads a source once, however many types it declares.** Asking whether a file declares
// a type with a default argument found each `struct` by copying the rest of the text and searching it
// again, for `enum ` too, to the end — so a file of many structs cost the square of its length, and
// `std`, embedded in every build, is such a file. Doubling the structs should double the time; it took
// 4.2× (376 ms against 1,595 at 3,000 and 6,000). The sizes are large enough that a linear pass takes
// tens of milliseconds, since at 18 ms a busy gate once read a correct pass as 2.7×.
export string test_lowering_reads_a_source_once_however_many_types_it_declares(Core core) {
  T t = T.create();
  string fewer = manyStructs(6000);
  string more = manyStructs(12000);
  timeLower(core, fewer);
  timeLower(core, more);
  i64 a = timeLower(core, fewer);
  i64 b = timeLower(core, more);
  // **The best of three**, because a loaded machine only ever adds time: one slow run of either
  // side was enough to read as a ratio the code does not have.
  for (i32 k = 0; k < 2; k++) {
    i64 a2 = timeLower(core, fewer);
    i64 b2 = timeLower(core, more);
    if (a2 < a) { a = a2; }
    if (b2 < b) { b = b2; }
  }
  t.isTrue(b < a * (3 as i64),
           "lowering 6,000 structs: " + itoa(millis(a)) + " ms; 12,000: " + itoa(millis(b)) + " ms");
  return t.report();
}

/** `/t/lib.wac` with one `type` declaration, `P` and 4,000 functions. */
string typedLib() {
  string[] parts = string[].filled(4002, "");
  parts[0] = "export struct P { i32 v; }\n";
  parts[1] = "export type Q = i32;\n";
  for (i32 i = 0; i < 4000; i++) {
    parts[2 + i] = "export i32 g" + itoa(i) + "() { return " + itoa(i) + "; }\n";
  }
  return joinedParts(parts, 4002);
}

/** An entry importing `k` of lib's functions, then naming `P` 2,400 times. */
string manyImports(i32 k) {
  string[] names = string[].filled(k, "");
  for (i32 i = 0; i < k; i++) { names[i] = ", g" + itoa(i); }
  string[] parts = string[].filled(601, "");
  parts[0] = "import { P, Q" + joinedParts(names, k) + " } from \"./lib.wac\";\n"
             + "export i32 h() { Q q = g1(); return q; }\n";
  for (i32 i = 0; i < 600; i++) {
    parts[1 + i] = "export i32 f" + itoa(i) + "(P a, P b) { P c = P(1); P d = a; return c.v + d.v + b.v; }\n";
  }
  return joinedParts(parts, 601);
}

// **Asking whether a name is a `type` does not walk every import.** In a program with any `type`
// declaration — `std` has several — each type name the emitter met that was not one walked every import
// of the graph for a renaming of it. Importing three times as many names should cost what the extra
// import lines cost and no more; it cost a share of every type name.
export string test_asking_whether_a_name_is_a_type_does_not_walk_every_import(Core core) {
  T t = T.create();
  string lib = typedLib();
  string fewer = manyImports(1000);
  string more = manyImports(3000);
  timeEmitTwo(core, fewer, lib);
  timeEmitTwo(core, more, lib);
  i64 a = timeEmitTwo(core, fewer, lib);
  i64 b = timeEmitTwo(core, more, lib);
  // **The best of three**, because a loaded machine only ever adds time: one slow run of either
  // side was enough to read as a ratio the code does not have.
  for (i32 k = 0; k < 2; k++) {
    i64 a2 = timeEmitTwo(core, fewer, lib);
    i64 b2 = timeEmitTwo(core, more, lib);
    if (a2 < a) { a = a2; }
    if (b2 < b) { b = b2; }
  }
  t.isTrue(b * (4 as i64) < a * (5 as i64),
           "naming `P` 2,400 times: " + itoa(millis(a)) + " ms importing 1,000 names, " + itoa(millis(b))
           + " ms importing 3,000");
  return t.report();
}

i64 timeSynth(Core core, i32 states) {
  u8[] src = "i32 f() { return 0; }\n".toBytes();
  u8[] tailed = synthSource(src, 4, states, 2);
  i64 t0 = core.monotonicNanos().wait();
  synthTokens(lex(src), tailed, 4, states, 2, 1, 1);
  return core.monotonicNanos().wait() - t0;
}

// **The async lowering's tail of spellings is placed in one walk, not one walk per word.** Each word's
// token needs its byte offset in the tail, and that was asked of `synthOffset` once per word — which
// rebuilt the whole list of words and summed the lengths of every word before it. A file's tail carries
// a numeral per state, so the cost was the square of its states: `std` has enough that this was a
// tenth of checking a one-line program that imports it. Doubling the states should double the work.
export string test_placing_the_async_tail_does_not_rebuild_it_per_word(Core core) {
  T t = T.create();
  timeSynth(core, 1500);
  i64 a = timeSynth(core, 1500);
  i64 b = timeSynth(core, 3000);
  for (i32 k = 0; k < 2; k++) {
    i64 a2 = timeSynth(core, 1500);
    i64 b2 = timeSynth(core, 3000);
    if (a2 < a) { a = a2; }
    if (b2 < b) { b = b2; }
  }
  t.isTrue(b < a * (3 as i64),
           "placing the tail: " + itoa(millis(a)) + " ms for 1,500 states, " + itoa(millis(b))
           + " ms for 3,000");
  return t.report();
}

/** `/t/lib.wac` with `n` structs, each with a function taking it, and `/t/other.wac` with `n` structs and some bulk each. */
string[] reachedTypes(i32 n) {
  string pad = "// filler filler filler filler filler filler filler filler filler filler filler filler filler filler\n";
  string bulk = joinedParts(string[].filled(24, pad), 24);
  string[] lib = string[].filled(n, "");
  string[] other = string[].filled(n, "");
  string[] names = string[].filled(n, "");
  for (i32 i = 0; i < n; i++) {
    lib[i] = "export struct S" + itoa(i) + " { i32 v; }\nexport i32 f" + itoa(i) + "(S" + itoa(i) + " a) { return a.v; }\n";
    other[i] = "export struct O" + itoa(i) + " { i32 v; }\n" + bulk;
    names[i] = (i == 0 ? "" : ", ") + "f" + itoa(i);
  }
  return ["import { " + joinedParts(names, n) + " } from \"./lib.wac\";\nimport { O0 } from \"./other.wac\";\n"
          + "export i32 main() { return 0; }\n", joinedParts(lib, n), joinedParts(other, n)] as string[];
}

i64 timeReached(Core core, string[] texts) {
  i64 t0 = core.monotonicNanos().wait();
  diagnoseFiles(["/t/m.wac", "/t/lib.wac", "/t/other.wac"], texts, "/t/m.wac");
  return core.monotonicNanos().wait() - t0;
}

// **Whether a reached type is declared by another file is asked of an index, not of every file.** For
// each type a signature reaches, the checker walked the declarations of every other file in the closure
// — copying each one's whole text, `std` and `core` included — to see whether the name was ambiguous.
// The product of reached types and closure size: 6% of checking `packages/box`. Here both double, so
// the work should double; it took 2.9 times as long.
export string test_a_reached_type_is_not_looked_for_in_every_file(Core core) {
  T t = T.create();
  string[] fewer = reachedTypes(200);
  string[] more = reachedTypes(400);
  timeReached(core, fewer);
  timeReached(core, more);
  i64 a = timeReached(core, fewer);
  i64 b = timeReached(core, more);
  for (i32 k = 0; k < 2; k++) {
    i64 a2 = timeReached(core, fewer);
    i64 b2 = timeReached(core, more);
    if (a2 < a) { a = a2; }
    if (b2 < b) { b = b2; }
  }
  t.isTrue(b * (2 as i64) < a * (5 as i64),
           "200 reached types: " + itoa(millis(a)) + " ms; 400: " + itoa(millis(b)) + " ms");
  return t.report();
}
