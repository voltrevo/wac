// More files than the linker's tables used to hold.
//
// `linkFiles` accepts up to 1024 files — `seen` and `queue` are both that size and it refuses past
// them. The tables its callers handed it were half that, and the writes were *guarded* rather than
// checked: `if (starts.len() > sn)`, `if (filePaths.len() > sn - 1)`. So a program with more than 512
// files linked, compiled, and ran correctly, while every line past the cut was attributed to
// whichever file happened to be last in the table.
//
// It cost nothing visible because nothing here is near the limit — `packages/box` is the largest at
// 170 — which is exactly why this generates its own program rather than using one. The symptom is not
// a crash or a wrong answer: `total()` was right the whole time. It is that a coverage report, or any
// diagnostic whose line lands past the cut, names the wrong file and says so with complete
// confidence. `issues/lang/0130`.
//
// Kept deliberately just past the boundary rather than at 600, because the cost is compiling the
// generated program and the interesting question is only whether the table stops early.
//
// ## Host-side until 2026-08-18, `issues/system/0161`
//
// `total()` answers 156,520, which an exit status cannot carry — it is eight bits
// (`issues/system/0184`) — so the driver compares inside the module and returns 7. The answer is
// still asserted; it is the *channel* that changed.

import { T } from "../../../wactest/src/assert.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { joined, splitLines, has } from "../../../wactest/src/strings.wac";
import { Buf } from "../../../bytes/src/buf.wac";
import { Core, Cli } from "std/platform.wac";
import { blockedFiles, covTableFiles, emitFilesSelfDescribing } from "../../src/api.wac";
import { Ran, runModule, scratchDir } from "./artifacts_probe.wac";

const i32 N = 560;   // past 512, and cheap enough to compile in a test
const string ENTRY = "/many/main.wac";

/** The `n`th tab-separated field of a line, or `""`. */
string field(string line, i32 n) {
  i32 from = 0;
  i32 seen = 0;
  for (i32 i = 0; i <= line.len(); i++) {
    if (i < line.len() && line.slice(i, i + 1) != "\t") { continue; }
    if (seen == n) { return line.slice(from, i); }
    seen = seen + 1;
    from = i + 1;
  }
  return "";
}

/** The last tab-separated field, which is the file a coverage row names. */
string lastField(string line) {
  i32 last = 0;
  for (i32 i = 0; i < line.len(); i++) { if (line.slice(i, i + 1) == "\t") { last = i + 1; } }
  return line.slice(last, line.len());
}

export string test_more_files_than_the_linkers_tables_used_to_hold(Core core, Cli cli) {
  T t = T.create();
  string[] paths = string[N + 1](fill: "");
  string[] sources = string[N + 1](fill: "");
  for (i32 i = 0; i < N; i++) {
    paths[i] = "/many/f" + itoa(i) + ".wac";
    // A branch, so each file contributes a coverage point that has to be attributed to it.
    sources[i] = "export i32 v" + itoa(i) + "(i32 x) {\n  if (x > 0) { return " + itoa(i) +
                 "; }\n  return 0;\n}\n";
  }
  // Through a `Buf`: five hundred imports and five hundred calls concatenated one at a time is
  // quadratic, and this file exists because five hundred is the interesting number.
  Buf head = Buf.create();
  Buf calls = Buf.create();
  for (i32 i = 0; i < N; i++) {
    head.pushAll(("import { v" + itoa(i) + " } from \"./f" + itoa(i) + ".wac\";\n").toBytes());
    if (i > 0) { calls.pushAll(" + ".toBytes()); }
    calls.pushAll(("v" + itoa(i) + "(1)").toBytes());
  }
  i32 want = (N - 1) * N / 2;
  paths[N] = ENTRY;
  sources[N] = string.fromBytes(head.take()) + "\nexport i32 total() { return " +
               string.fromBytes(calls.take()) + "; }\n" +
               "export i32 main() { return total() == " + itoa(want) + " ? 7 : 0; }\n";

  t.eqStr(blockedFiles(paths, sources, ENTRY), "",
          "declined a " + itoa(N + 1) + "-file program");

  // **Emitted and run directly, because the type check of this program costs eight seconds.**
  // `runEmitted` calls `diagnoseGraph` first, which is the right default — a caller wants to be told
  // *why* a program did not compile rather than watching an emit produce nothing. Measured here on
  // 2026-08-18: `blockedFiles` 167ms, `diagnoseGraph` **8135ms**, the emit 200ms, the run 15ms.
  //
  // The cost is the entry's **import count**, not the file count: 560 files whose entry imports ten of
  // them check in 5ms, and twelve hundred files with ten imports in 8ms, while 560 imports in one file
  // is 6.4 seconds and 600 is nineteen. `issues/lang/0158` carries the curve. No real program is near
  // it — the largest import list in this repository is `packages/box/src/box.wac` at 65 — so this test
  // is the only thing that reaches the wall, and it reaches it to ask a question about the *linker*.
  //
  // `blockedFiles` above already answers "does it compile", at 167ms, and a program that emitted
  // nothing fails `r.ok` below. So nothing is unchecked; what is skipped is being told the same thing
  // twice, the second time slowly.
  u8[] wasm = emitFilesSelfDescribing(paths, sources, ENTRY, "manyfiles.wasm", 0);
  Ran r = runModule(cli, wasm, scratchDir(cli), "manyfiles.wasm", string[0](fill: ""));
  t.isTrue(r.ok, "it built and ran — " + r.error);
  if (!r.ok) { return t.report(); }
  t.eqI32(r.status, 7, "total() is not " + itoa(want) + " — stderr: " + r.stderr);

  // What was actually broken: which file each counter belongs to.
  string[] rows = splitLines(covTableFiles(paths, sources, ENTRY));
  string[] named = string[rows.len()](fill: "");
  i32 nNamed = 0;
  for (i32 i = 0; i < rows.len(); i++) {
    string file = lastField(rows[i]);
    bool seen = false;
    for (i32 k = 0; k < nNamed; k++) { if (named[k] == file) { seen = true; } }
    if (!seen) { named[nNamed] = file; nNamed = nNamed + 1; }
  }
  string first = "";
  i32 missing = 0;
  for (i32 i = 0; i < paths.len(); i++) {
    bool seen = false;
    for (i32 k = 0; k < nNamed; k++) { if (named[k] == paths[i]) { seen = true; } }
    if (seen) { continue; }
    if (missing == 0) { first = paths[i]; }
    missing = missing + 1;
  }
  t.eqI32(nNamed, N + 1,
          itoa(rows.len()) + " coverage points name " + itoa(nNamed) + " distinct files, not " +
          itoa(N + 1) + " — " + itoa(missing) + " file(s) got none, first " + first +
          ". The line table stopped early and their counters were credited to another file.");
  return t.report();
}

// ── And past the linker's queue, which used to blame the caller ───────────────────────────────────
//
// `linkFiles` has five room guards — one on the file table, two on the walk's queue, two on the edge
// table — and `linkFailure` reads a sentinel, `starts[0] == 1`, to tell "out of room" from "a file
// nobody supplied". **Nothing in `emit.wac` ever wrote `starts[0]`.** So the message
// *"more import edges than the linker was given room for"* was unreachable, and all five guards
// answered *"an import of a file that was not supplied"* — a claim about the caller's map, for a
// program whose every file was supplied.
//
// Measured before: an entry importing 1024 files emitted **8 bytes** — a bare wasm header — with
// `diagnoseFiles` clean and that sentence as the only explanation. `issues/lang/0179a`.
//
// Two of the five also *dropped an edge and carried on*, which is worse than refusing: the module
// comes out with a name resolved to nothing, and that is `issues/lang/0130`'s shape.
export string test_past_the_queue_the_refusal_names_the_limit(Core core, Cli cli) {
  T t = T.create();
  // One more than the queue holds. The queue is one entry per file *to visit*, so an entry importing
  // n files queues n + 1.
  i32 n = 1024;
  string[] paths = string[n + 1](fill: "");
  string[] sources = string[n + 1](fill: "");
  string entry = "";
  for (i32 i = 0; i < n; i++) {
    paths[i] = "/f" + itoa(i) + ".wac";
    sources[i] = "export i32 g" + itoa(i) + "() { return " + itoa(i) + "; }\n";
    entry = entry + "import { g" + itoa(i) + " } from \"./f" + itoa(i) + ".wac\";\n";
  }
  paths[n] = "/main.wac";
  sources[n] = entry + "export i32 main() { return g0(); }\n";

  string why = blockedFiles(paths, sources, "/main.wac");
  t.isTrue(why != "", "a program past the linker's queue was accepted");
  t.isTrue(why.indexOf("queue") >= 0, "did not name the queue — " + why);
  t.isTrue(why.indexOf("1024") >= 0, "did not name the limit — " + why);
  // **The old sentence is the assertion that matters.** Naming a limit is only an improvement if it
  // has stopped blaming the file map.
  t.isTrue(why.indexOf("not supplied") < 0, "still blames the caller's map — " + why);
  return t.report();
}

/** And a program inside the limit still links, which is what says the guard is a guard. */
export string test_and_inside_the_queue_it_links(Core core, Cli cli) {
  T t = T.create();
  i32 n = 200;
  string[] paths = string[n + 1](fill: "");
  string[] sources = string[n + 1](fill: "");
  string entry = "";
  for (i32 i = 0; i < n; i++) {
    paths[i] = "/f" + itoa(i) + ".wac";
    sources[i] = "export i32 g" + itoa(i) + "() { return " + itoa(i) + "; }\n";
    entry = entry + "import { g" + itoa(i) + " } from \"./f" + itoa(i) + ".wac\";\n";
  }
  paths[n] = "/main.wac";
  sources[n] = entry + "export i32 main() { return g0(); }\n";
  t.eqStr(blockedFiles(paths, sources, "/main.wac"), "", "a 201-file program was refused");
  return t.report();
}
