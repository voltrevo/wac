// The specification's examples, read as programs.
//
// `spec/next` is written so that its examples are the definition: a ` ```wac ` fence is a whole program,
// its first lines say what happens to it, and every `// ERROR:` line beneath is a separate claim that
// uncommenting it, and nothing else, makes the program refused. `spec/next/README.md` states the
// conventions; this reads them, and nothing here is a second statement of them.
//
// It reads the fences, and judges each one against the compiler in this tree: compiled in this process,
// through `../../src/api.wac`, and run by the binary only where a module has to be run.
//
// **A fence this cannot read is reported, never skipped.** An unreadable fence counted as met would
// let a typo in an expectation pass as a language that agrees with the spec.

import { Change, Cli, FileResult, Exec } from "std";
import { Vec } from "core";
import { itoa, utoa64 } from "../../../fmt/src/itoa.wac";
import { startsWith, endsWith, trimmed, splitKeepingEmpty, splitLines } from "../../../wactest/src/strings.wac";
import { diagnoseFilesIn, wireHasErrors, blockedFilesIn, emitFilesSelfDescribingIn,
         importSpecsFor } from "../../src/api.wac";
import { renderDiagnostics } from "../../src/render.wac";
import { Res } from "../../src/path.wac";

/** One thing a fence says must happen. */
export struct ExExpect {
  /** `"emits"`, `"refused"`, `"answers"`, `"traps"`, `"exits"` or `"prints"`. */
  string kind;
  /** The export called by `answers` and `traps`. */
  string call;
  /** Its arguments, as written: wac literals. */
  string[] args;
  /** `answers`' value, or `exits`' status, as written. */
  string value;
  /** `prints`' lines. */
  string[] lines;
  /** For an expectation about one command — `(wac build)` — the command and its words; empty otherwise. */
  string command;
}

/** A program variant: the fence as written, or with one `// ERROR:` block uncommented. */
export struct ExVariant {
  /** 0 for the fence as written; otherwise the line, in the markdown file, of the `// ERROR:` it tests. */
  i32 errorLine;
  /** The reason the `// ERROR:` line gives. Empty for the fence as written. */
  string reason;
  string[] paths;
  string[] sources;
}

/** One fence. */
export struct ExFence {
  /** The markdown file, relative to the repository. */
  string doc;
  /** The line of the opening ` ```wac `. */
  i32 line;
  bool fragment;
  ExExpect[] expects;
  /** The fence as written, then one variant per `// ERROR:` block. */
  ExVariant[] variants;
  /** The file names, as the fence marks them, with `<dep>/` rewritten to `deps/dep/`. */
  string entry;
  /** Tags placed below the fence, before the next one. */
  string[] tags;
  /** Why this fence could not be read. Empty when it was. */
  string error;
}

/** Every fence in one markdown document. */
export ExFence[] exampleFences(string doc, string text) {
  string[] lines = splitKeepingEmpty(text);
  Vec<ExFence> out = Vec.create();
  i32 i = 0;
  while (i < lines.len()) {
    if (trimmed(lines[i]) != "```wac") { i = i + 1; continue; }
    i32 open = i;
    i32 j = i + 1;
    while (j < lines.len() && trimmed(lines[j]) != "```") { j = j + 1; }
    string[] body = string[].filled(j - open - 1, "");
    for (i32 k = open + 1; k < j; k++) { body[k - open - 1] = lines[k]; }
    // Tags belong to the fence above them, up to the next fence.
    i32 next = j + 1;
    while (next < lines.len() && !startsWith(trimmed(lines[next]), "```")) { next = next + 1; }
    Vec<string> tags = Vec.create();
    for (i32 k = j + 1; k < next; k++) { collectTags(lines[k], tags); }
    out.push(readFence(doc, open + 1, body, tags.toArray()));
    i = j + 1;
  }
  return out.toArray();
}

/** Tags written `[§name]` on one line. */
void collectTags(string line, Vec<string> into) {
  i32 at = 0;
  while (true) {
    i32 s = exIndexFrom(line, "[§", at);
    if (s < 0) { return; }
    i32 e = exIndexFrom(line, "]", s);
    if (e < 0) { return; }
    into.push(line.slice(s + 3, e));       // "§" is two bytes
    at = e + 1;
  }
}

ExFence readFence(string doc, i32 line, string[] body, string[] tags) {
  if (body.len() > 0 && startsWith(trimmed(body[0]), "// fragment")) {
    return ExFence(doc, line, true, ExExpect[](), ExVariant[](), "", tags, "");
  }
  Vec<ExExpect> expects = Vec.create();
  string err = "";
  i32 k = 0;
  while (k < body.len() && startsWith(body[k], "// expect")) {
    string e = body[k];
    k = k + 1;
    // `prints` takes the comment lines after it as its output.
    Vec<string> printed = Vec.create();
    if (e.indexOf(": prints") >= 0) {
      while (k < body.len() && startsWith(body[k], "// ") && !startsWith(body[k], "// expect")
             && !startsWith(body[k], "// ----")) {
        printed.push(body[k].slice(3, body[k].len()));
        k = k + 1;
      }
    }
    ExExpect? x = exParseExpect(e, printed.toArray());
    if (x is null) { err = "cannot read `" + e + "`"; } else { expects.push(x!); }
  }
  if (expects.len() == 0 && err == "") { err = "no `// expect:` line and not a fragment"; }

  // The rest is the program: one file, or several marked `// ---- name ----`.
  Vec<string> paths = Vec.create();
  Vec<string> sources = Vec.create();
  Vec<i32> starts = Vec.create();        // the markdown line each file's first line sits on
  string cur = "";
  string curPath = "main.wac";
  i32 curStart = line + 1 + k;
  bool marked = false;
  for (i32 m = k; m < body.len(); m++) {
    string l = body[m];
    if (startsWith(l, "// ---- ") && endsWith(trimmed(l), " ----")) {
      if (marked || trimmed(cur) != "") {
        paths.push(curPath); sources.push(cur); starts.push(curStart);
      }
      string name = trimmed(l);
      curPath = exDepPath(name.slice(8, name.len() - 5));
      cur = "";
      curStart = line + 1 + m + 1;
      marked = true;
      continue;
    }
    cur = cur + l + "\n";
  }
  paths.push(curPath); sources.push(cur); starts.push(curStart);

  string entry = "main.wac";
  if (paths.len() == 1) { entry = paths.get(0); }
  for (i32 q = 0; q < expects.len(); q++) {
    // `(wac build app/main.wac)` names the entry.
    string c = expects.get(q).command;
    string[] words = exWordsOf(c);
    for (i32 w = 2; w < words.len(); w++) {
      if (endsWith(words[w], ".wac") && words[1] != "run") { entry = words[w]; }
    }
  }

  string[] ps = paths.toArray();
  string[] ss = sources.toArray();
  Vec<ExVariant> variants = Vec.create();
  variants.push(ExVariant(0, "", ps, ss));
  for (i32 f = 0; f < ss.len(); f++) {
    addErrorVariants(ps, ss, f, starts.get(f), variants);
  }
  return ExFence(doc, line, false, expects.toArray(), variants.toArray(), entry, tags, err);
}

/** `<geometry>/src/lib.wac` as a path a compiler can hold: `deps/geometry/src/lib.wac`. */
export string exDepPath(string p) {
  if (startsWith(p, "<")) {
    i32 e = p.indexOf(">");
    if (e > 0) { return "deps/" + p.slice(1, e) + p.slice(e + 1, p.len()); }
  }
  return p;
}

/**
 * One variant per `// ERROR:` block in file `f`: the block is the comment lines after it, at its
 * indentation, up to a line that is not one; uncommenting means removing the `// ` after the
 * indentation.
 */
void addErrorVariants(string[] paths, string[] sources, i32 f, i32 firstLine, Vec<ExVariant> into) {
  string[] ls = splitKeepingEmpty(sources[f]);
  for (i32 i = 0; i < ls.len(); i++) {
    string t = trimmed(ls[i]);
    if (!startsWith(t, "// ERROR")) { continue; }
    string indent = ls[i].slice(0, ls[i].indexOf("//"));
    string reason = trimmed(t.slice(8, t.len()));
    if (startsWith(reason, ":")) { reason = trimmed(reason.slice(1, reason.len())); }
    string[] changed = string[].filled(ls.len(), "");
    for (i32 j = 0; j < ls.len(); j++) { changed[j] = ls[j]; }
    i32 j = i + 1;
    while (j < ls.len() && startsWith(ls[j], indent + "// ") && !startsWith(trimmed(ls[j]), "// ERROR")) {
      changed[j] = indent + ls[j].slice(indent.len() + 3, ls[j].len());
      j = j + 1;
    }
    string text = "";
    for (i32 k = 0; k < changed.len(); k++) {
      text = text + changed[k];
      if (k + 1 < changed.len()) { text = text + "\n"; }
    }
    string[] ss = string[].filled(sources.len(), "");
    for (i32 k = 0; k < sources.len(); k++) { ss[k] = k == f ? text : sources[k]; }
    into.push(ExVariant(firstLine + i, reason, paths, ss));
  }
}

/** `// expect: answers f(1, 2) = 3`, `// expect (wac build): refused`, … — or null. */
export ExExpect? exParseExpect(string line, string[] printed) {
  string rest = trimmed(line.slice(9, line.len()));      // after "// expect"
  string command = "";
  if (startsWith(rest, "(")) {
    i32 e = rest.indexOf(")");
    if (e < 0) { return null; }
    command = rest.slice(1, e);
    rest = trimmed(rest.slice(e + 1, rest.len()));
  }
  if (!startsWith(rest, ":")) { return null; }
  rest = trimmed(rest.slice(1, rest.len()));
  string[] none = string[]();
  if (rest == "emits" || rest == "refused") { return ExExpect(rest, "", none, "", none, command); }
  if (rest == "prints") { return ExExpect("prints", "", none, "", printed, command); }
  if (startsWith(rest, "exits ")) {
    return ExExpect("exits", "", none, trimmed(rest.slice(6, rest.len())), none, command);
  }
  if (startsWith(rest, "traps ")) {
    string c = trimmed(rest.slice(6, rest.len()));
    return ExExpect("traps", callName(c), exCallArgs(c), "", none, command);
  }
  if (startsWith(rest, "answers ")) {
    string c = trimmed(rest.slice(8, rest.len()));
    i32 eq = topLevelEquals(c);
    if (eq < 0) { return null; }
    string lhs = trimmed(c.slice(0, eq));
    return ExExpect("answers", callName(lhs), exCallArgs(lhs), trimmed(c.slice(eq + 1, c.len())), none,
                       command);
  }
  return null;
}

/** The `=` separating a call from its answer: outside quotes and brackets. */
i32 topLevelEquals(string s) {
  i32 depth = 0;
  bool quoted = false;
  for (i32 i = 0; i < s.len(); i++) {
    string c = s.slice(i, i + 1);
    if (quoted) {
      if (c == "\\") { i = i + 1; } else if (c == "\"") { quoted = false; }
      continue;
    }
    if (c == "\"") { quoted = true; }
    else if (c == "(" || c == "[") { depth = depth + 1; }
    else if (c == ")" || c == "]") { depth = depth - 1; }
    else if (c == "=" && depth == 0) { return i; }
  }
  return -1;
}

string callName(string c) {
  i32 p = c.indexOf("(");
  return trimmed(p < 0 ? c : c.slice(0, p));
}

/** The arguments in `f(a, [b, c], "d")`, split at top-level commas. */
export string[] exCallArgs(string c) {
  i32 p = c.indexOf("(");
  if (p < 0) { return string[](); }
  string inner = c.slice(p + 1, exLastIndex(c, ")"));
  Vec<string> out = Vec.create();
  i32 depth = 0;
  bool quoted = false;
  i32 from = 0;
  for (i32 i = 0; i < inner.len(); i++) {
    string ch = inner.slice(i, i + 1);
    if (quoted) {
      if (ch == "\\") { i = i + 1; } else if (ch == "\"") { quoted = false; }
      continue;
    }
    if (ch == "\"") { quoted = true; }
    else if (ch == "(" || ch == "[") { depth = depth + 1; }
    else if (ch == ")" || ch == "]") { depth = depth - 1; }
    else if (ch == "," && depth == 0) { out.push(trimmed(inner.slice(from, i))); from = i + 1; }
  }
  string last = trimmed(inner.slice(from, inner.len()));
  if (last != "" || out.len() > 0) { out.push(last); }
  return out.toArray();
}

export string[] exWordsOf(string s) {
  Vec<string> out = Vec.create();
  i32 from = 0;
  for (i32 i = 0; i <= s.len(); i++) {
    if (i < s.len() && s.slice(i, i + 1) != " ") { continue; }
    if (i > from) { out.push(s.slice(from, i)); }
    from = i + 1;
  }
  return out.toArray();
}

/** Where `needle` first occurs in `s` at or after `from`, or -1. */
export i32 exIndexFrom(string s, string needle, i32 from) {
  if (from >= s.len()) { return -1; }
  i32 at = s.slice(from, s.len()).indexOf(needle);
  return at < 0 ? -1 : at + from;
}

/** Where `needle` last occurs in `s`, or -1. */
export i32 exLastIndex(string s, string needle) {
  i32 found = -1;
  i32 at = exIndexFrom(s, needle, 0);
  while (at >= 0) { found = at; at = exIndexFrom(s, needle, at + 1); }
  return found;
}

/** What happened to one fence. */
export struct ExVerdict {
  ExFence fence;
  /** `"met"`, `"missed"` or `"unsupported"`. */
  string state;
  string why;
}

/** `.md` files under `dir`, recursively, skipping directories whose name begins with `_`. Sorted. */
export string[] exampleDocs(Cli cli, string dir) {
  Vec<string> out = Vec.create();
  walk(cli, dir, out);
  string[] xs = out.toArray();
  for (i32 i = 1; i < xs.len(); i++) {
    string v = xs[i];
    i32 j = i - 1;
    while (j >= 0 && xs[j] > v) { xs[j + 1] = xs[j]; j = j - 1; }
    xs[j + 1] = v;
  }
  return xs;
}

void walk(Cli cli, string dir, Vec<string> out) {
  string[]? entries = cli.readDir(dir).wait();
  if (entries is null) { return; }
  string[] es = entries!;
  for (i32 i = 0; i < es.len(); i++) {
    string name = es[i];
    if (startsWith(name, "_") || startsWith(name, ".")) { continue; }
    string path = dir + "/" + name;
    if (endsWith(name, ".md")) { out.push(path); continue; }
    string[]? sub = cli.readDir(path).wait();
    if (!(sub is null)) { walk(cli, path, out); }
  }
}

// ── Judging ──────────────────────────────────────────────────────────────────────────────────────

export ExVerdict judgeExample(Cli cli, string scratch, ExFence fence, i32 n) {
  if (fence.error != "") { return ExVerdict(fence, "missed", "unreadable: " + fence.error); }
  ExVariant base = fence.variants[0];
  Res res = resolutionFor(base.paths, base.sources);
  string[] wacPaths = wacOnly(base.paths, base.paths);
  string[] wacSources = wacOnly(base.paths, base.sources);

  for (i32 e = 0; e < fence.expects.len(); e++) {
    ExExpect x = fence.expects[e];
    if (x.command != "" && !commandSupported(x.command)) {
      return ExVerdict(fence, "unsupported", "an expectation about `" + x.command + "`");
    }
    string why = meets(cli, scratch, fence, x, wacPaths, wacSources, res, n * 100 + e);
    if (why != "") { return ExVerdict(fence, "missed", why); }
  }

  // Each `// ERROR:` block, uncommented alone, must be refused.
  for (i32 v = 1; v < fence.variants.len(); v++) {
    ExVariant var = fence.variants[v];
    string[] ps = wacOnly(var.paths, var.paths);
    string[] ss = wacOnly(var.paths, var.sources);
    string wire = diagnoseFilesIn(ps, ss, resolutionFor(var.paths, var.sources), fence.entry);
    if (!wireHasErrors(wire)) {
      return ExVerdict(fence, "missed", "line " + itoa(var.errorLine) + " uncommented is accepted — ERROR: "
                     + var.reason);
    }
  }
  return ExVerdict(fence, "met", "");
}

/** `(wac build)`, `(wac run …)` are builds; `wac check` checks differently and is not modelled yet. */
bool commandSupported(string c) {
  return startsWith(c, "wac build") || startsWith(c, "wac run");
}

/** Why `x` does not hold, or "". */
string meets(Cli cli, string scratch, ExFence fence, ExExpect x, string[] paths, string[] sources, Res res,
             i32 id) {
  string wire = diagnoseFilesIn(paths, sources, res, fence.entry);
  bool refused = wireHasErrors(wire);
  if (x.kind == "refused") { return refused ? "" : "accepted, and it must be refused"; }
  if (refused) { return "refused: " + firstDiagnostic(wire, paths, sources); }
  string blocked = blockedFilesIn(paths, sources, res, fence.entry);
  if (blocked != "") { return "checked, but the emitter declined: " + blocked; }
  if (x.kind == "emits") { return ""; }

  u8[] wasm = emitFilesSelfDescribingIn(paths, sources, res, fence.entry, "example.wasm", 0);
  if (wasm.len() == 0) { return "emitted nothing"; }
  string path = scratch + "/ex" + itoa(id) + ".wasm";
  Change wrote = cli.writeFile(path, wasm).wait();
  if (!wrote.ok()) { return "could not write " + path; }

  Vec<string> argv = Vec.create();
  argv.push(path);
  if (x.kind == "answers" || x.kind == "traps") {
    argv.push(x.call);
    for (i32 a = 0; a < x.args.len(); a++) { argv.push(cliArg(x.args[a])); }
  } else if (x.command != "") {
    // `wac run main.wac first second`: what follows the entry is the program's.
    string[] words = wordsOfCmd(x.command);
    for (i32 w = 3; w < words.len(); w++) { argv.push(words[w]); }
  }
  Exec r = cli.exec(cli.cwd().wait() + "/native/v8/target/release/wac", argv.toArray(), u8[]()).wait();
  if (!r.ran()) { return "the binary did not run: " + r.error; }
  string out = string.fromBytes(r.stdout);
  string err = string.fromBytes(r.stderr);
  bool trapped = err.indexOf(" trapped") >= 0;

  if (x.kind == "traps") { return trapped ? "" : "answered " + trimmed(out) + ", and it must trap"; }
  if (trapped) { return "trapped: " + trimmed(err); }
  if (x.kind == "answers") {
    // One trailing newline is the binary's, and the rest is the value's: a string answer may end in one.
    string got = endsWith(out, "\n") ? out.slice(0, out.len() - 1) : out;
    return sameValue(got, x.value) ? "" : x.call + " answered " + got + ", wanted " + x.value;
  }
  if (x.kind == "exits") {
    return itoa(r.status) == x.value ? "" : "exited " + itoa(r.status) + ", wanted " + x.value;
  }
  if (x.kind == "prints") {
    string[] got = splitLines(out);
    string want = "";
    for (i32 i = 0; i < x.lines.len(); i++) { want = want + x.lines[i] + "\n"; }
    string have = "";
    for (i32 i = 0; i < got.len(); i++) { have = have + got[i] + "\n"; }
    return have == want ? "" : "printed `" + trimmed(have) + "`, wanted `" + trimmed(want) + "`";
  }
  return "unknown expectation " + x.kind;
}

string[] wordsOfCmd(string s) {
  Vec<string> out = Vec.create();
  i32 from = 0;
  for (i32 i = 0; i <= s.len(); i++) {
    if (i < s.len() && s.slice(i, i + 1) != " ") { continue; }
    if (i > from) { out.push(s.slice(from, i)); }
    from = i + 1;
  }
  return out.toArray();
}

string firstDiagnostic(string wire, string[] paths, string[] sources) {
  string rendered = renderDiagnostics(wire, paths, sources);
  string[] ls = splitLines(rendered);
  string out = "";
  for (i32 i = 0; i < ls.len() && i < 3; i++) { out = out + (i == 0 ? "" : " | ") + trimmed(ls[i]); }
  return out;
}

/** The `.wac` entries of `xs`, keyed by `paths`. Manifests are read for resolution, not compiled. */
string[] wacOnly(string[] paths, string[] xs) {
  Vec<string> out = Vec.create();
  for (i32 i = 0; i < paths.len(); i++) { if (endsWith(paths[i], ".wac")) { out.push(xs[i]); } }
  return out.toArray();
}

// ── Values ───────────────────────────────────────────────────────────────────────────────────────

/** A wac literal as the binary's argument reader takes it: strings unquoted, lists bare, hex in decimal. */
string cliArg(string lit) {
  string t = trimmed(lit);
  if (startsWith(t, "\"") && endsWith(t, "\"")) { return unescape(t.slice(1, t.len() - 1)); }
  if (startsWith(t, "[") && endsWith(t, "]")) {
    string inner = t.slice(1, t.len() - 1);
    string out = "";
    string[] parts = splitTop(inner);
    for (i32 i = 0; i < parts.len(); i++) { out = out + (i == 0 ? "" : ",") + cliArg(parts[i]); }
    return out;
  }
  if (startsWith(t, "0x") || startsWith(t, "-0x")) { return hexToDecimal(t); }
  return t;
}

string[] splitTop(string s) {
  Vec<string> out = Vec.create();
  i32 depth = 0;
  bool quoted = false;
  i32 from = 0;
  for (i32 i = 0; i < s.len(); i++) {
    string c = s.slice(i, i + 1);
    if (quoted) { if (c == "\\") { i = i + 1; } else if (c == "\"") { quoted = false; } continue; }
    if (c == "\"") { quoted = true; }
    else if (c == "[" || c == "(") { depth = depth + 1; }
    else if (c == "]" || c == ")") { depth = depth - 1; }
    else if (c == "," && depth == 0) { out.push(trimmed(s.slice(from, i))); from = i + 1; }
  }
  if (trimmed(s.slice(from, s.len())) != "") { out.push(trimmed(s.slice(from, s.len()))); }
  return out.toArray();
}

string unescape(string s) {
  string out = "";
  for (i32 i = 0; i < s.len(); i++) {
    string c = s.slice(i, i + 1);
    if (c == "\\" && i + 1 < s.len()) {
      string d = s.slice(i + 1, i + 2);
      i = i + 1;
      if (d == "n") { out = out + "\n"; }
      else if (d == "t") { out = out + "\t"; }
      else if (d == "r") { out = out + "\r"; }
      else if (d == "0") { out = out + string.fromBytes([0] as u8[]); }
      else if (d == "u" && i + 1 < s.len() && s.slice(i + 1, i + 2) == "{") {
        i32 close = exIndexFrom(s, "}", i);
        out = out + codepointText(s.slice(i + 2, close));
        i = close;
      }
      else { out = out + d; }
      continue;
    }
    out = out + c;
  }
  return out;
}

/** The UTF-8 text of the code point written in hex. */
string codepointText(string hex) {
  i32 cp = 0;
  for (i32 i = 0; i < hex.len(); i++) {
    string c = hex.slice(i, i + 1);
    i32 d = "0123456789abcdef".indexOf(c);
    if (d < 0) { d = "0123456789ABCDEF".indexOf(c); }
    cp = cp * 16 + d;
  }
  if (cp < 0x80) { return string.fromBytes([cp as@ u8]); }
  if (cp < 0x800) { return string.fromBytes([((0xC0 | (cp >> 6)) as@ u8), ((0x80 | (cp & 0x3F)) as@ u8)]); }
  if (cp < 0x10000) {
    return string.fromBytes([
                                 ((0xE0 | (cp >> 12)) as@ u8), ((0x80 | ((cp >> 6) & 0x3F)) as@ u8),
                                 ((0x80 | (cp & 0x3F)) as@ u8)
    ]);
  }
  return string.fromBytes([
                               ((0xF0 | (cp >> 18)) as@ u8), ((0x80 | ((cp >> 12) & 0x3F)) as@ u8),
                               ((0x80 | ((cp >> 6) & 0x3F)) as@ u8), ((0x80 | (cp & 0x3F)) as@ u8)
  ]);
}

string hexToDecimal(string t) {
  bool neg = startsWith(t, "-");
  string digits = t.slice(neg ? 3 : 2, t.len());
  u64 v = 0;
  u64 sixteen = 16;
  for (i32 i = 0; i < digits.len(); i++) {
    string c = digits.slice(i, i + 1);
    if (c == "_") { continue; }
    i32 d = "0123456789abcdef".indexOf(c);
    if (d < 0) { d = "0123456789ABCDEF".indexOf(c); }
    v = v * sixteen + (d as! u64);
  }
  string s = utoa64(v);
  return neg ? "-" + s : s;
}

/** Whether what the binary printed is the value the expectation wrote. */
bool sameValue(string got, string want) {
  string w = trimmed(want);
  if (got == w) { return true; }
  if (startsWith(w, "\"") && endsWith(w, "\"")) { return got == unescape(w.slice(1, w.len() - 1)); }
  if (startsWith(w, "'") && endsWith(w, "'") && w.len() == 3) {
    return got == itoa(w.toBytes()[1] as i32);
  }
  if (startsWith(w, "0x") || startsWith(w, "-0x")) { return got == hexToDecimal(w); }
  // A float written `12.0` may print as `12`.
  if (endsWith(w, ".0") && got == w.slice(0, w.len() - 2)) { return true; }
  if (endsWith(got, ".0") && w == got.slice(0, got.len() - 2)) { return true; }
  return false;
}

// ── Resolution ───────────────────────────────────────────────────────────────────────────────────

/**
 * Project roots and package mappings, from the fence's own `wac.json5` files: each `.wac` file's
 * project is the nearest directory above it with a manifest, and a package a manifest imports maps to
 * the `exports` of the `deps/<name>/` checkout the fence supplies.
 */
Res resolutionFor(string[] paths, string[] sources) {
  Vec<string> manifestDirs = Vec.create();
  Vec<string> manifestTexts = Vec.create();
  for (i32 i = 0; i < paths.len(); i++) {
    if (paths[i] == "wac.json5") { manifestDirs.push("."); manifestTexts.push(sources[i]); }
    else if (endsWith(paths[i], "/wac.json5")) {
      manifestDirs.push(paths[i].slice(0, paths[i].len() - 10));
      manifestTexts.push(sources[i]);
    }
  }
  string[] wp = wacOnly(paths, paths);
  string[] ws = wacOnly(paths, sources);
  string[] roots = string[].filled(wp.len(), "");
  Vec<string> from = Vec.create();
  Vec<string> spec = Vec.create();
  Vec<string> to = Vec.create();
  for (i32 i = 0; i < wp.len(); i++) {
    i32 best = -1;
    for (i32 m = 0; m < manifestDirs.len(); m++) {
      string d = manifestDirs.get(m);
      bool inside = d == "." || startsWith(wp[i], d + "/");
      if (inside && (best < 0 || d.len() > manifestDirs.get(best).len() || manifestDirs.get(best) == ".")) {
        if (best < 0 || d != ".") { best = m; }
      }
    }
    if (best < 0) { continue; }
    roots[i] = manifestDirs.get(best);
    string[] specs = importSpecsFor(wp[i], ws[i].toBytes());
    for (i32 s = 0; s < specs.len(); s++) {
      string target = packageTarget(manifestTexts.get(best), specs[s], manifestDirs, manifestTexts);
      if (target != "") { from.push(wp[i]); spec.push(specs[s]); to.push(target); }
    }
  }
  return Res(roots, from.toArray(), spec.toArray(), to.toArray(), "");
}

/** Where package `name` resolves for a project whose manifest is `manifest`, or "". */
string packageTarget(string manifest, string name, Vec<string> dirs, Vec<string> texts) {
  if (exIndexFrom(manifest, name + ":", 0) < 0 && exIndexFrom(manifest, "\"" + name + "\":", 0) < 0) { return ""; }
  string depDir = "deps/" + name;
  for (i32 m = 0; m < dirs.len(); m++) {
    if (dirs.get(m) != depDir) { continue; }
    string e = jsonString(texts.get(m), "exports");
    if (e == "") { return ""; }
    if (startsWith(e, "./")) { e = e.slice(2, e.len()); }
    return depDir + "/" + e;
  }
  return "";
}

/** The string value of `key` in a small JSON5 object — enough for the manifests examples write. */
string jsonString(string text, string key) {
  i32 k = exIndexFrom(text, key, 0);
  if (k < 0) { return ""; }
  i32 q = exIndexFrom(text, "\"", k + key.len());
  if (q < 0) { return ""; }
  i32 e = exIndexFrom(text, "\"", q + 1);
  if (e < 0) { return ""; }
  return text.slice(q + 1, e);
}

/**
 * An example's name in `MET`: its document and its place among that document's examples, counting only
 * programs. A fence moved within a document renames the ones after it, which the next status run records.
 */
export string exampleKey(string doc, i32 ordinal) { return doc + "#" + itoa(ordinal); }

/** Every example under `dir`, judged, with its key — what both the status program and the test walk. */
export struct ExJudged {
  string[] keys;
  ExVerdict[] verdicts;
  string[] docs;
}

export ExJudged judgeAll(Cli cli, string dir) {
  string[] docs = exampleDocs(cli, dir);
  string scratch = cli.cwd().wait() + "/.cache/specexamples";
  cli.mkdir(scratch, true).wait();
  Vec<string> keys = Vec.create();
  Vec<ExVerdict> all = Vec.create();
  i32 n = 0;
  for (i32 d = 0; d < docs.len(); d++) {
    FileResult r = cli.readFile(docs[d]).wait();
    if (!r.ok) { continue; }
    ExFence[] fences = exampleFences(docs[d], string.fromBytes(r.bytes));
    i32 ordinal = 0;
    for (i32 f = 0; f < fences.len(); f++) {
      if (fences[f].fragment) { continue; }
      ordinal = ordinal + 1;
      n = n + 1;
      keys.push(exampleKey(docs[d], ordinal));
      all.push(judgeExample(cli, scratch, fences[f], n));
    }
  }
  cli.remove(scratch, true).wait();
  return ExJudged(keys.toArray(), all.toArray(), docs);
}
