// Merkleization against Ethereum's `ssz_generic` vectors.
//
// 754 of the 1,217 cases need no schema, because the case *name* carries the type:
// `uint_128_max`, `bitvec_513_random`, `bitlist_512_lengthy_3`, `vec_uint256_5_zero`. Those are driven
// here. The remaining 463 are `containers`, handled in `container_test.wac`.
//
// The interesting parameter in every case is the **limit**, not the data. A `Bitlist[512]` holding
// fifteen bits merkleizes over a tree sized for 512 bits, so an implementation that pads to the data
// it was given produces a root that is wrong for every short value and right for every full one. The
// `_zero` and `_lengthy` cases at each width are what separate those two implementations, which is why
// the counts below are asserted per type rather than in total.
//
// ## What the move changed
//
// The host-side version read the case names with a regex. There is none here — `packages/regex` would
// be a dependency this test does not otherwise need, and the four shapes are prefixes with a number in
// them, which `numberAt` reads directly. That is a real difference and worth the sentence it costs:
// the per-type counts below are what catch a name reader that stops matching, and they were already
// doing that job for the regex.
//
// The branch tests changed more, and `test/oracle.ts` says why.
//
// Host-side until 2026-08-17. `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { Lines, checkDeno, hex } from "../../../wactest/src/oracle.wac";
import { Loaded, json, member, memberText, memberArray } from "../../../wactest/src/fixtures.wac";
import { Core, Cli } from "../../../platform/src/platform.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { JsonValue, JsonArray } from "../../../json/src/value.wac";
import { decoded } from "../../../codec/src/hex.wac";
import { hashPair, zeroHash, merkleize, rootBasic, rootBasicVector, rootBitvector, rootBitlist,
         bitlistLength, floorLog2, subtreeIndex, isValidMerkleBranch,
         isValidNormalizedMerkleBranch } from "../../src/merkle.wac";

const string MANIFEST = "packages/ssz/test/fixtures.json";
const string ORACLE = "packages/ssz/test/oracle.ts";

// ── Reading a case name ───────────────────────────────────────────────────────

/** The decimal number starting at `from`, and `-1` when there is not one there. */
i32 numberAt(u8[] name, i32 from) {
  i32 v = 0;
  i32 digits = 0;
  for (i32 i = from; i < name.len(); i++) {
    if (name[i] < '0' || name[i] > '9') { break; }
    v = v * 10 + (name[i] - '0');
    digits = digits + 1;
  }
  return digits == 0 ? -1 : v;
}

bool startsWith(u8[] name, string prefix) {
  u8[] p = prefix.toBytes();
  if (name.len() < p.len()) { return false; }
  for (i32 i = 0; i < p.len(); i++) {
    if (name[i] != p[i]) { return false; }
  }
  return true;
}

/** Bytes per element, for the basic types `basic_vector` is parameterised over; `-1` for others. */
i32 elementSize(string ty) {
  if (ty == "bool") { return 1; }
  if (ty == "uint8") { return 1; }
  if (ty == "uint16") { return 2; }
  if (ty == "uint32") { return 4; }
  if (ty == "uint64") { return 8; }
  if (ty == "uint128") { return 16; }
  if (ty == "uint256") { return 32; }
  return -1;
}

/** The offset of the first byte after the next `_` at or after `from`, or `-1`. */
i32 afterUnderscore(u8[] name, i32 from) {
  for (i32 i = from; i < name.len(); i++) {
    if (name[i] == '_') { return i + 1; }
  }
  return -1;
}

/**
 * The root this case's type implies, or `null` when the name is not one this test drives.
 *
 * A `null` is not a failure: `containers` is driven elsewhere, and a `vec_` over a type with no fixed
 * element size is not a shape this reader knows. It *is* what the per-type counts guard, because a
 * name reader that quietly stopped matching would answer `null` everywhere and pass.
 */
u8[]? rootFor(string ty, string caseName, u8[] ssz) {
  if (ty == "uints" || ty == "boolean") { return rootBasic(ssz); }
  u8[] name = caseName.toBytes();
  if (startsWith(name, "bitvec_")) {
    i32 n = numberAt(name, 7);
    return n < 0 ? null : rootBitvector(ssz, n);
  }
  if (startsWith(name, "bitlist_")) {
    i32 n = numberAt(name, 8);
    if (n < 0) { return null; }
    // A refusal comes back as `null` and is compared as an empty root, which no case's root can be.
    u8[]? r = rootBitlist(ssz, n);
    return r is null ? u8[0]() : r!;
  }
  if (startsWith(name, "vec_")) {
    i32 numAt = afterUnderscore(name, 4);
    if (numAt < 0) { return null; }
    i32 size = elementSize(caseName.slice(4, numAt - 1));
    i32 count = numberAt(name, numAt);
    if (size < 0 || count < 0) { return null; }
    // ceil(N * sizeof(T) / 32) — the chunks a *full* vector of this type occupies.
    return rootBasicVector(ssz, (count * size + 31) / 32);
  }
  return null;
}

/** The five types this test drives, and how many cases each must contribute. */
string[] countedTypes() {
  return string[]("uints", "boolean", "bitvector", "bitlist", "basic_vector");
}
i32[] countedWant() { return i32[](48, 2, 54, 450, 200); }

export string test_every_schema_free_case_merkleizes_to_ethereums_root(Core core, Cli cli) {
  T t = T.create();
  Loaded f = json(core, cli, "ssz", "ssz_generic_valid", MANIFEST);
  t.isTrue(f.ok, f.error);
  if (!f.ok) { return t.report(); }
  JsonArray? cases = memberArray(f.doc, "cases");
  t.isTrue(!(cases is null), "the fixture has no `cases` array");
  if (cases is null) { return t.report(); }

  string[] types = countedTypes();
  i32[] want = countedWant();
  i32[] seen = i32[types.len()]();
  i32 reported = 0;
  for (i32 i = 0; i < cases!.len(); i++) {
    JsonValue c = cases!.get(i);
    string ty = memberText(c, "type");
    string caseName = memberText(c, "case");
    u8[]? got = rootFor(ty, caseName, decoded(memberText(c, "ssz")));
    if (got is null) { continue; }
    for (i32 k = 0; k < types.len(); k++) {
      if (types[k] == ty) { seen[k] = seen[k] + 1; }
    }
    string gotHex = hex(got!);
    if (gotHex != memberText(c, "root") && reported < 8) {
      reported = reported + 1;
      t.fail(ty + "/" + caseName + "\n    got  " + gotHex + "\n    want " +
             memberText(c, "root"));
    }
  }
  // Per type, so a name reader that stops matching shows up as a gap rather than as a pass.
  for (i32 k = 0; k < types.len(); k++) {
    t.eqI32(seen[k], want[k], "drove " + itoa(seen[k]) + " " + types[k] + " cases");
  }
  return t.report();
}

export string test_the_limit_is_what_fixes_the_tree_not_the_datas_length() {
  T t = T.create();
  // The property that separates a correct merkleizer from one that pads to its input. Two chunks of
  // real data under limits of 2, 4 and 8 must give three different roots; an implementation ignoring
  // the limit gives one.
  u8[] data = u8[64]();
  data[0] = 1;
  data[32] = 2;
  string a = hex(merkleize(data, 2));
  string b = hex(merkleize(data, 4));
  string c = hex(merkleize(data, 8));
  t.isTrue(a != b && b != c && a != c, "limits 2/4/8 did not give three distinct roots");
  // And a limit below the data must not truncate it — the tree grows to hold what it was given.
  t.eqStr(hex(merkleize(data, 1)), a, "a limit smaller than the data changed the root");
  return t.report();
}

export string test_zerohash_is_the_padded_subtree_it_stands_in_for() {
  T t = T.create();
  // The optimisation and the thing it replaces must agree, or every short value is wrong.
  u8[] expect = u8[32]();
  for (i32 d = 0; d < 6; d++) {
    t.eqStr(hex(zeroHash(d)), hex(expect), "zeroHash(" + itoa(d) + ") is not that depth's subtree");
    expect = hashPair(expect, expect);
  }
  // An empty value under a limit is exactly the zero subtree.
  t.eqStr(hex(merkleize(u8[0](), 8)), hex(zeroHash(3)),
          "merkleizing nothing under a limit of 8 is not zeroHash(3)");
  return t.report();
}

export string test_a_bitlists_delimiter_is_measured_not_merkleized() {
  T t = T.create();
  // `Bitlist` length comes from the highest set bit of the last byte, and that bit is not data.
  // Eight zero bits are `00 01`: a zero byte, then the delimiter alone in the next.
  u8[][] cases = u8[][6](fill: u8[0]());
  cases[0] = u8[](0x01);
  cases[1] = u8[](0x02);
  cases[2] = u8[](0x03);
  cases[3] = u8[](0xff);
  cases[4] = u8[](0x00, 0x01);
  cases[5] = u8[](0xff, 0x01);
  i32[] bits = i32[](0, 1, 1, 7, 8, 8);
  for (i32 i = 0; i < cases.len(); i++) {
    t.eqI32(bitlistLength(cases[i]), bits[i], "bitlistLength(" + hex(cases[i]) + ")");
  }
  // No delimiter at all is malformed, not empty.
  t.eqI32(bitlistLength(u8[](0x00)), -1, "a zero final byte was accepted");
  t.eqI32(bitlistLength(u8[0]()), -1, "an empty bitlist was accepted");
  // Over the limit is a refusal.
  t.isTrue(rootBitlist(u8[](0xff), 3) is null, "seven bits were accepted into a Bitlist[3]");
  return t.report();
}

// ── Merkle branches ───────────────────────────────────────────────────────────
//
// `ssz_generic` has no branch vectors, so the tree here is built rather than fetched — and building it
// with this package's own merkleizer would be a symmetric oracle. The host-side version solved that by
// building the tree with Web Crypto and handing it *in*; every value the wac branch check saw came
// from a digest sharing no code with `packages/crypto`.
//
// The shape here is the mirror image and the property is the same. wac builds the tree with `hashPair`
// and then **sends every internal node it computed** to `test/oracle.ts`, which recomputes each one
// with Web Crypto and reports the ones that disagree. So the tree the branch assertions run against is
// still certified by an independent digest; what changed is the direction of travel, which is what
// makes it one process instead of one call per node.

/** Every level of a tree over `leaves`, bottom-up, with each internal node offered to `lines`. */
u8[][][] tree(u8[][] leaves, Lines lines) {
  u8[][][] levels = u8[][][8](fill: u8[][0](fill: u8[0]()));
  levels[0] = leaves;
  i32 n = 1;
  while (levels[n - 1].len() > 1) {
    u8[][] level = levels[n - 1];
    u8[][] next = u8[][level.len() / 2](fill: u8[0]());
    for (i32 i = 0; i < level.len(); i = i + 2) {
      next[i / 2] = hashPair(level[i], level[i + 1]);
      lines.add("hashpair " + hex(level[i]) + " " + hex(level[i + 1]) + " " + hex(next[i / 2]));
    }
    levels[n] = next;
    n = n + 1;
  }
  u8[][][] out = u8[][][n](fill: u8[][0](fill: u8[0]()));
  for (i32 i = 0; i < n; i++) { out[i] = levels[i]; }
  return out;
}

/** The sibling at each level on the path to `index`, bottom-up — which is what a branch is. */
u8[] branchFor(u8[][][] levels, i32 index) {
  i32 depth = levels.len() - 1;
  u8[] out = u8[depth * 32]();
  i32 i = index;
  for (i32 d = 0; d < depth; d++) {
    u8[] sibling = levels[d][i ^ 1];
    for (i32 k = 0; k < 32; k++) { out[d * 32 + k] = sibling[k]; }
    i = i / 2;
  }
  return out;
}

/** Eight distinct 32-byte leaves, differing in byte `at`. */
u8[][] eightLeaves(i32 at) {
  u8[][] leaves = u8[][8](fill: u8[0]());
  for (i32 i = 0; i < 8; i++) {
    u8[] l = u8[32]();
    l[at] = i + 1;
    leaves[i] = l;
  }
  return leaves;
}

u8[] concat(u8[] a, u8[] b) {
  u8[] out = u8[a.len() + b.len()]();
  for (i32 i = 0; i < a.len(); i++) { out[i] = a[i]; }
  for (i32 i = 0; i < b.len(); i++) { out[a.len() + i] = b[i]; }
  return out;
}

u8[] prefixOf(u8[] a, i32 n) {
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = a[i]; }
  return out;
}

export string test_isvalidmerklebranch_accepts_every_position_and_rejects_perturbations(
    Core core, Cli cli) {
  T t = T.create();
  Lines lines = Lines.create();
  u8[][] leaves = eightLeaves(0);
  u8[][][] levels = tree(leaves, lines);
  u8[] root = levels[levels.len() - 1][0];

  for (i32 i = 0; i < 8; i++) {
    u8[] branch = branchFor(levels, i);
    t.isTrue(isValidMerkleBranch(leaves[i], branch, 3, i as! u64, root),
             "a correct branch for leaf " + itoa(i) + " was rejected");
    // The index is what picks the side at each level, so a wrong one must fail — this is the check
    // that would pass if the implementation hashed in a fixed order.
    t.isFalse(isValidMerkleBranch(leaves[i], branch, 3, (i ^ 1) as! u64, root),
              "leaf " + itoa(i) + "'s branch verified at index " + itoa(i ^ 1) +
              ": the side bits are ignored");
    // A flipped byte anywhere in the branch must fail.
    u8[] tampered = concat(branch, u8[0]());
    tampered[0] = tampered[0] ^ 1;
    t.isFalse(isValidMerkleBranch(leaves[i], tampered, 3, i as! u64, root),
              "a tampered branch verified for leaf " + itoa(i));
  }
  // A branch of the wrong length is a malformed proof, not a shorter one.
  t.isFalse(isValidMerkleBranch(leaves[0], prefixOf(branchFor(levels, 0), 64), 3, 0 as! u64, root),
            "a two-node branch verified at depth 3");
  checkDeno(t, cli, ORACLE, lines, "the tree the branches were checked against");
  return t.report();
}

export string test_the_normalized_branch_check_requires_the_surplus_nodes_to_be_zero(
    Core core, Cli cli) {
  T t = T.create();
  Lines lines = Lines.create();
  u8[][] leaves = eightLeaves(31);
  u8[][][] levels = tree(leaves, lines);
  u8[] root = levels[levels.len() - 1][0];
  i32 index = 5;
  i32 gindex = 8 + index;                        // depth 3, so floorlog2 = 3 and subtree index = 5
  t.eqI32(floorLog2(gindex as! u64), 3, "floorLog2 disagrees about the depth");
  t.eqI32(subtreeIndex(gindex as! u64) as! i32, index, "subtreeIndex disagrees");

  u8[] branch = branchFor(levels, index);
  t.isTrue(isValidNormalizedMerkleBranch(leaves[index], branch, gindex as! u64, root),
           "an exact-length normalized branch was rejected");
  // A branch longer than the gindex needs is legitimate when the surplus is zero — that is how a
  // fork moves a field deeper without changing the proof's wire format.
  t.isTrue(isValidNormalizedMerkleBranch(leaves[index], concat(u8[64](), branch), gindex as! u64,
                                         root),
           "a zero-padded normalized branch was rejected");
  // Non-zero surplus must be refused, not trimmed. Accepting it would let a prover hang an unrelated
  // subtree below the field being proved, which is why the spec returns false here.
  u8[] junk = u8[64]();
  junk[7] = 1;
  t.isFalse(isValidNormalizedMerkleBranch(leaves[index], concat(junk, branch), gindex as! u64, root),
            "a normalized branch with non-zero surplus nodes was accepted");
  // Too short to address the depth is a refusal.
  t.isFalse(isValidNormalizedMerkleBranch(leaves[index], prefixOf(branch, 64), gindex as! u64, root),
            "a branch shorter than the gindex's depth was accepted");
  checkDeno(t, cli, ORACLE, lines, "the tree the branches were checked against");
  return t.report();
}
