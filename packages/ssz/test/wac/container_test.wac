// Container merkleization against Ethereum's `ssz_generic` container vectors.
//
// 303 of the 463 container cases: `SingleFieldTestStruct`, `SmallTestStruct`, `FixedTestStruct`,
// `VarTestStruct`, `ComplexTestStruct`, `BitsStruct`. The other 160 are `ProgressiveTestStruct` and
// `ProgressiveBitsStruct`, which merkleize under the progressive-list scheme — a different algorithm
// that an Altair light client does not use. Out of scope and said so in the README, not skipped
// quietly.
//
// The layouts below are transcribed from `consensus-specs/tests/formats/ssz_generic/README.md`, which
// is where the generator's own definitions live, rather than remembered. `ComplexTestStruct` is the
// one that matters: seven fields, four of them variable, one nested container, a vector of fixed
// containers and a vector of *variable* containers. If offsets are read wrong, that is the case that
// says so.
//
// Host-side until 2026-08-17. `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { hex } from "../../../wactest/src/oracle.wac";
import { Loaded, json, memberText, memberArray } from "../../../wactest/src/fixtures.wac";
import { Core, Cli } from "../../../platform/src/platform.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { JsonValue, JsonArray } from "../../../json/src/value.wac";
import { decoded } from "../../../codec/src/hex.wac";
import { hashTreeRoot, isFixed, fixedSize } from "../../src/container.wac";
import { Schema } from "./schema.wac";

const string MANIFEST = "packages/ssz/test/fixtures.json";

/** The six classic structs, and the schema they live in. */
struct Layouts {
  Schema s;
  i32 singleField;
  i32 small;
  i32 fixed;
  i32 varStruct;
  i32 complex;
  i32 bits;
  i32 vecFixed4;
  i32 vecVar2;
  i32 bitvector8;
  i32 bitvector9;
}

Layouts layouts() {
  Schema s = Schema.create();
  i32 byte = s.basic(1);
  i32 uint8 = byte;
  i32 uint16 = s.basic(2);
  i32 uint32 = s.basic(4);
  i32 uint64 = s.basic(8);

  i32 singleField = s.container(i32[](byte));
  i32 small = s.container(i32[](uint16, uint16));
  i32 fixed = s.container(i32[](uint8, uint64, uint32));
  i32 varStruct = s.container(i32[](uint16, s.list(uint16, 1024), uint8));
  i32 complex = s.container(i32[](
    uint16,
    s.list(uint16, 128),
    uint8,
    s.list(byte, 256),                            // ByteList[256]
    varStruct,
    s.vector(fixed, 4),
    s.vector(varStruct, 2)));
  i32 bits = s.container(i32[](
    s.bitlist(5),
    s.bitvector(2),
    s.bitvector(1),
    s.bitlist(6),
    s.bitvector(8)));
  // Named separately because the classification test asks about them directly.
  i32 vecFixed4 = s.vector(fixed, 4);
  i32 vecVar2 = s.vector(varStruct, 2);
  i32 bitvector8 = s.bitvector(8);
  i32 bitvector9 = s.bitvector(9);
  return Layouts(s, singleField, small, fixed, varStruct, complex, bits, vecFixed4, vecVar2,
                 bitvector8, bitvector9);
}

/** The struct name a case belongs to — `VarTestStruct_lengthy_4` is a `VarTestStruct` case. */
string structOf(string name) {
  string[] markers = string[]("_zero", "_max", "_nil", "_one", "_lengthy", "_random");
  i32 cut = name.len();
  for (i32 m = 0; m < markers.len(); m++) {
    i32 at = indexOf(name, markers[m]);
    if (at >= 0 && at < cut) { cut = at; }
  }
  return name.slice(0, cut);
}

/** The first offset of `needle` in `haystack`, or `-1`. */
i32 indexOf(string haystack, string needle) {
  u8[] h = haystack.toBytes();
  u8[] n = needle.toBytes();
  if (n.len() == 0 || n.len() > h.len()) { return -1; }
  for (i32 i = 0; i + n.len() <= h.len(); i++) {
    bool same = true;
    for (i32 j = 0; j < n.len(); j++) {
      if (h[i + j] != n[j]) { same = false; break; }
    }
    if (same) { return i; }
  }
  return -1;
}

/** The struct index for a name, or `-1` for the two progressive structs. */
i32 rootTypeFor(Layouts l, string name) {
  if (name == "SingleFieldTestStruct") { return l.singleField; }
  if (name == "SmallTestStruct") { return l.small; }
  if (name == "FixedTestStruct") { return l.fixed; }
  if (name == "VarTestStruct") { return l.varStruct; }
  if (name == "ComplexTestStruct") { return l.complex; }
  if (name == "BitsStruct") { return l.bits; }
  return -1;
}

export string test_the_classic_ssz_generic_containers_merkleize_to_ethereums_roots(
    Core core, Cli cli) {
  T t = T.create();
  Loaded f = json(core, cli, "ssz", "ssz_generic_valid", MANIFEST);
  t.isTrue(f.ok, f.error);
  if (!f.ok) { return t.report(); }
  JsonArray? cases = memberArray(f.doc, "cases");
  t.isTrue(!(cases is null), "the fixture has no `cases` array");
  if (cases is null) { return t.report(); }

  Layouts l = layouts();
  i32[] types = l.s.t();
  i32[] fields = l.s.f();
  string[] names = string[]("SingleFieldTestStruct", "SmallTestStruct", "FixedTestStruct",
                            "VarTestStruct", "ComplexTestStruct", "BitsStruct");
  i32[] want = i32[](21, 21, 21, 80, 80, 80);
  i32[] seen = i32[names.len()]();
  i32 reported = 0;

  for (i32 i = 0; i < cases!.len(); i++) {
    JsonValue c = cases!.get(i);
    if (memberText(c, "type") != "containers") { continue; }
    string name = structOf(memberText(c, "case"));
    i32 ty = rootTypeFor(l, name);
    if (ty < 0) { continue; }                     // the two progressive structs
    for (i32 k = 0; k < names.len(); k++) {
      if (names[k] == name) { seen[k] = seen[k] + 1; }
    }
    u8[]? got = hashTreeRoot(types, fields, ty, decoded(memberText(c, "ssz")));
    string gotHex = got is null ? "(refused)" : hex(got!);
    if (gotHex != memberText(c, "root") && reported < 6) {
      reported = reported + 1;
      t.fail(memberText(c, "case") + "\n    got  " + gotHex + "\n    want " +
             memberText(c, "root"));
    }
  }
  for (i32 k = 0; k < names.len(); k++) {
    t.eqI32(seen[k], want[k], "drove " + itoa(seen[k]) + " " + names[k] + " cases");
  }
  return t.report();
}

export string test_fixed_and_variable_are_classified_the_way_the_offsets_depend_on() {
  T t = T.create();
  // `isFixed` decides whether a field is inline or behind an offset, so getting it wrong corrupts
  // every serialization that contains the type. Sizes are from the layouts, computed by hand.
  Layouts l = layouts();
  i32[] types = l.s.t();
  i32[] fields = l.s.f();
  string[] names = string[]("SingleFieldTestStruct", "SmallTestStruct", "FixedTestStruct",
                            "VarTestStruct", "ComplexTestStruct", "BitsStruct",
                            "Vector[FixedTestStruct, 4]", "Vector[VarTestStruct, 2]",
                            "Bitvector[8]", "Bitvector[9]");
  i32[] idx = i32[](l.singleField, l.small, l.fixed, l.varStruct, l.complex, l.bits,
                    l.vecFixed4, l.vecVar2, l.bitvector8, l.bitvector9);
  //                                     VarTestStruct has a List, so variable; BitList makes
  //                                     BitsStruct variable too.
  bool[] fixedWant = bool[](true, true, true, false, false, false, true, false, true, true);
  i32[] sizeWant = i32[](1, 4, 1 + 8 + 4, 0, 0, 0, 4 * 13, 0, 1, 2);

  for (i32 i = 0; i < names.len(); i++) {
    t.eqBool(isFixed(types, fields, idx[i]), fixedWant[i], names[i] + ": isFixed");
    if (fixedWant[i]) {
      t.eqI32(fixedSize(types, fields, idx[i]), sizeWant[i], names[i] + ": fixedSize");
    }
  }
  return t.report();
}

export string test_malformed_offsets_are_refused_not_decoded(Core core, Cli cli) {
  T t = T.create();
  // Every one of these is a real serialization with one thing changed, so the only difference between
  // accepting and refusing is the check being tested. The invalid vectors are not vendored yet (they
  // need this decoder to exist first), so these are built by hand from a valid case.
  Loaded f = json(core, cli, "ssz", "ssz_generic_valid", MANIFEST);
  t.isTrue(f.ok, f.error);
  if (!f.ok) { return t.report(); }
  JsonArray? cases = memberArray(f.doc, "cases");
  t.isTrue(!(cases is null), "the fixture has no `cases` array");
  if (cases is null) { return t.report(); }

  Layouts l = layouts();
  i32[] types = l.s.t();
  i32[] fields = l.s.f();

  u8[] good = u8[0]();
  for (i32 i = 0; i < cases!.len() && good.len() == 0; i++) {
    JsonValue c = cases!.get(i);
    if (memberText(c, "type") != "containers") { continue; }
    if (structOf(memberText(c, "case")) != "VarTestStruct") { continue; }
    string ssz = memberText(c, "ssz");
    if (ssz.len() > 20) { good = decoded(ssz); }
  }
  t.isTrue(good.len() > 0, "no VarTestStruct case to perturb");
  if (good.len() == 0) { return t.report(); }
  t.isFalse(hashTreeRoot(types, fields, l.varStruct, good) is null,
            "the unmodified case was refused, so the negatives below prove nothing");

  // VarTestStruct is uint16, offset(4), uint8 — so the offset sits at bytes 2..6 and must be 7.
  t.eqI32(readOffset(good), 7, "expected the fixed part to be 7 bytes");

  // The offsets have to be chosen so that *only* the offset check can reject them. `B` is a
  // `List[uint16, 1024]`, so any offset leaving an odd number of bytes is refused by the element-size
  // check instead — which is how the first version of this test passed while the offset check was
  // removed. Parity-preserving offsets (same parity as the 7-byte fixed part) close that escape.
  i32[] candidates = i32[](good.len() + 1, 1, 3, 5, 9, 11, 13);
  string[] why = string[]("past the end", "before the fixed part", "before the fixed part",
                          "before the fixed part", "after it", "after it", "after it");
  i32 usable = 0;
  for (i32 i = 0; i < candidates.len(); i++) {
    i32 v = candidates[i];
    if (v > good.len() + 1) { continue; }
    if (v != good.len() + 1 && (good.len() - v) % 2 != 0) { continue; }
    usable = usable + 1;
    t.isTrue(hashTreeRoot(types, fields, l.varStruct, withOffset(good, v)) is null,
             "an offset " + why[i] + " (" + itoa(v) + ") was accepted");
  }
  t.isTrue(usable >= 3,
           "only " + itoa(usable) + " usable offsets for a " + itoa(good.len()) + "-byte case");
  // Truncated below the fixed part cannot even hold the offsets.
  u8[] short = u8[5]();
  for (i32 i = 0; i < 5; i++) { short[i] = good[i]; }
  t.isTrue(hashTreeRoot(types, fields, l.varStruct, short) is null,
           "a container shorter than its fixed part was accepted");
  return t.report();
}

/** The little-endian u32 offset at bytes 2..6. */
i32 readOffset(u8[] b) {
  return b[2] | (b[3] << 8) | (b[4] << 16) | (b[5] << 24);
}

u8[] withOffset(u8[] good, i32 v) {
  u8[] b = u8[good.len()]();
  for (i32 i = 0; i < good.len(); i++) { b[i] = good[i]; }
  b[2] = v & 0xff;
  b[3] = (v >> 8) & 0xff;
  b[4] = (v >> 16) & 0xff;
  b[5] = (v >> 24) & 0xff;
  return b;
}
