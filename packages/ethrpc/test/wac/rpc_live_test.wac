// The RPC client against a real node.
//
// `anvil` is a whole Ethereum execution client — it parses the JSON-RPC, keeps a real state trie, and
// answers the same shapes a public endpoint does. Everything else in this repo that touches Ethereum
// is tested against *recorded* answers; this is the one place the request goes out over a socket and a
// node on the other end decides what comes back.
//
// It is skipped when anvil is absent, and **says so with the path it looked in** — a skip that prints
// nothing reads as coverage, which is the failure `packages/tls/test/wac/openssl.wac` was written to
// stop.
//
// ## Host-side until 2026-08-18, `issues/system/0161`
//
// What kept it here was not the node but the *shape*: `Cli.exec` runs a child to completion, and a
// node has to still be running while the test talks to it. `packages/wactest/src/daemon.wac` is that
// missing half — `exec`, `connect` and `listen` arranged so a test can hold a child open — and
// `anvil_probe.wac` is this package's use of it. `appRunner` is replaced by `wac run --allow-net`.

import { T } from "../../../wactest/src/assert.wac";
import { Exec, Clock, Env, Files, Net, Output, Procs, Sys } from "std";
import { Port, freePortOr, freePort } from "../../../wactest/src/daemon.wac";
import { Node, anvil, anvilPath, haveAnvil, runExample, stopAnvil } from "./anvil_probe.wac";

static string ENTRY = "packages/ethrpc/example/blocknumber.wac";

string trimmedEnd(string s) {
  i32 n = s.len();
  while (n > 0 && (s.slice(n - 1, n) == "\n" || s.slice(n - 1, n) == " ")) { n = n - 1; }
  return s.slice(0, n);
}

export string test_ethrpc_asks_a_real_node_for_its_block_number_over_a_real_socket(Sys sys) {
  Output err = sys.stderr();
  Clock clock = sys.clock();
  Env env = sys.env();
  Files fs = sys.files();
  Net net = sys.net();
  Procs procs = sys.procs();
  T t = T.create();
  if (!haveAnvil(env, fs)) {
    err.line("ethrpc live test: skipped — anvil not found at \{anvilPath(env)}");
    return t.report();
  }
  Node node = anvil(clock, env, fs, net, procs);
  t.isTrue(node.ok(), "anvil came up — \{node.why}");
  if (!node.ok()) { return t.report(); }

  Exec r = runExample(env, procs, ENTRY, ["127.0.0.1", "\{node.port}"]);
  t.eqI32(r.status, 0, "exit \{r.status}: \{string.fromBytes(r.stderr)}");
  // anvil starts at block zero and mines on demand, so the answer is `0x0` — checked exactly, because
  // "some hex string" would pass for an error message that happened to start with 0x.
  t.eqStr(trimmedEnd(string.fromBytes(r.stdout)), "0x0", "the block number");

  // And with nothing listening on that port, it must say so rather than printing an empty answer.
  Port deadPort = freePortOr(net);
  i32 dead = deadPort.port;
  t.isTrue(dead > 0, "a port nothing is listening on — \{deadPort.error}");
  if (dead > 0) {
    Exec bad = runExample(env, procs, ENTRY, ["127.0.0.1", "\{dead}"]);
    t.eqI32(bad.status, 1, "a refused connection should fail: \{string.fromBytes(bad.stdout)}");
    t.isTrue(string.fromBytes(bad.stderr).indexOf("blocknumber:") >= 0,
             "the refusal does not name the program: \{string.fromBytes(bad.stderr)}");
  }

  stopAnvil(fs, procs, node);
  return t.report();
}
