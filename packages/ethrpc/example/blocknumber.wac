// The smallest thing that asks a node a question: `eth_blockNumber`, printed.
//
// Its job is to be the first program in this repo that talks to a chain at all — everything above it
// verifies what a node says, and until this existed nothing could ask. Run it against a local anvil:
//
//     wac task app:build packages/ethrpc/example/blocknumber.wac --allow-net -o blocknumber
//     ./blocknumber 127.0.0.1 8545
import { Result } from "core";
import { Sys, Net, Output } from "std";
import { call } from "../src/rpc.wac";
import { JsonValue } from "../../json/src/value.wac";

export Result<i32, string> main(Sys sys) {
  string[] argv = sys.args();
  Output out = sys.stdout();
  Net net = sys.net();
  i32 n = argv.len();
  string host = n > 0 ? argv[0] : "127.0.0.1";
  i32 port = n > 1 ? atoiOr(argv[1], 8545) : 8545;

  JsonValue number = match (call(net, host, port, "eth_blockNumber", "[]")) {
    Ok(v): v,
    Err(e): return Result.Err("blocknumber: \{e}"),
  };
  out.line(string.fromBytes(number.bytes() ?? u8[]()));
  return Result.Ok(0);
}

i32 atoiOr(string s, i32 fallback) {
  u8[] b = s.toBytes();
  if (b.len() == 0) { return fallback; }
  i32 n = 0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] < '0' || b[i] > '9') { return fallback; }
    n = n * 10 + (b[i] as i32 - '0');
  }
  return n;
}
