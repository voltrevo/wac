// `eth_getProof` and `eth_getBlockByNumber`, shaped into what `packages/mpt` verifies.
//
// The node answers JSON with hex strings in it; the verifier wants byte arrays and a state root. This is
// the whole of the translation, and it is deliberately the only place that knows both shapes: everything
// above works in bytes and nothing above should have to know that `0x` exists.
//
// **A short hex string is not padded and a malformed one is refused.** `0x` prefixes are optional in the
// spec's own examples and mandatory in practice; an odd number of digits is a node bug and is rejected
// rather than guessed at, because guessing means a nibble-shifted 32-byte root that verifies against
// nothing and looks like a bad proof.

import { Net } from "std";
import { call } from "./rpc.wac";
import { Result } from "core";
import { JsonValue } from "../../json/src/value.wac";
import { memberData, hexArray, fromHexData } from "./jsonhex.wac";
import { encode as hexOf } from "../../codec/src/hex.wac";
import { headerOf, Header } from "./header.wac";
import { keccak256 } from "../../crypto/src/keccak.wac";

/** A proof, in the shape `packages/mpt` takes. */
export struct Proof {
  /** The state root the proofs are against — see the README on where this may and may not come from. */
  u8[] stateRoot;
  /** The account trie's nodes, root first. */
  u8[][] accountNodes;
  /** The storage trie's nodes for the first slot asked about. */
  u8[][] storageNodes;
  /**
   * A slot's nodes, for a call that asked about several.
   *
   * `eth_getProof` takes a list of slots and answers about all of them against one account proof and one
   * root, so asking one slot at a time is a round trip and an account walk per slot — and worse, each
   * answer is about whatever block was latest when *that* call arrived. Resolving an ENS name's owner and
   * resolver is two slots of one contract, which is the case this exists for.
   */
  u8[][][] slots;

  Proof of(u8[] stateRoot, u8[][] accountNodes, u8[][] storageNodes) {
    u8[][][] one = u8[][][].filled(1, u8[][].filled(0, u8[]()));
    one[0] = storageNodes;
    return Proof(stateRoot, accountNodes, storageNodes, one);
  }

  Proof many(u8[] stateRoot, u8[][] accountNodes, u8[][][] slots) {
    u8[][] first = slots.len() > 0 ? slots[0] : u8[][].filled(0, u8[]());
    return Proof(stateRoot, accountNodes, first, slots);
  }
}

/**
 * `eth_getProof` for one slot, plus the state root of the block it is proved against.
 *
 * Two calls. The root comes out of a header this re-encodes and hashes, so `expectedHash` — 32 bytes from
 * anywhere the caller trusts — anchors it. Pass an empty array and the check is against the node's own
 * `hash` field, which proves the node is internally consistent and nothing more.
 *
 * **An anchor selects the block, rather than being checked against whatever `latest` is now.** A caller
 * with a trusted hash for block N wants the state at block N: asking for `latest` and then comparing its
 * header to N's hash fails the moment a new block arrives, which on a live chain is every twelve seconds.
 * So a hash is looked up with `eth_getBlockByHash` and the proof is taken *at that block's number*. The
 * anchored path therefore answers about the past, deliberately — that is what having a trusted hash means.
 */
export Result<Proof, string> proofOf(Net net, string host, i32 port, string address, string slot, u8[] expectedHash) {
  string[] one = [slot];
  return proofOfSlots(net, host, port, address, one, expectedHash);
}

/**
 * The same, for several slots of one account — one round trip, one account proof, one root.
 *
 * The slots come back in the order asked for, in `slots`. Anything else is a node answering a different
 * question from the one put to it, and is refused rather than matched up by key: a caller that indexes by
 * position and a node that reorders is a silent mix-up between two slots of the same contract.
 */
export Result<Proof, string> proofOfSlots(Net net, string host, i32 port, string address, string[] slots, u8[] expectedHash) {
  bool anchored = expectedHash.len() == 32;
  string where = anchored
    ? "[\"0x\{string.fromBytes(hexOf(expectedHash))}\",false]"
    : "[\"latest\",false]";
  JsonValue block = try call(net, host, port, anchored ? "eth_getBlockByHash" : "eth_getBlockByNumber", where);
  if (block.isNull()) { return failed("this node does not have the block you anchored to"); }

  // **The root comes out of a header that was re-encoded and hashed**, not straight out of the JSON. With
  // an `expectedHash` from somewhere else that makes the root trustworthy; without one it catches a node
  // whose block does not hash to the hash it reported, which is a bug rather than a lie.
  Header h = try headerOf(block, expectedHash);
  u8[] root = h.stateRoot;
  if (root.len() != 32) { return failed("the block has no usable stateRoot"); }

  // The proof has to be about the same block as the root, which is the whole point: `latest` here with an
  // anchored root above would verify a fresh trie against an old root and report every slot as absent.
  u8[] number = block.member("number")?.bytes() ?? u8[]();
  string at = anchored ? "\"\{string.fromBytes(number)}\"" : "\"latest\"";
  if (anchored && number.len() == 0) { return failed("the block has no number"); }

  string list = "";
  for (i32 i = 0; i < slots.len(); i++) {
    list = list + (i > 0 ? "," : "") + "\"" + slots[i] + "\"";
  }
  string params = "[\"\{address}\",[\{list}],\{at}]";
  JsonValue got = try call(net, host, port, "eth_getProof", params);

  u8[][] accountNodes = hexArray(got.member("accountProof") ?? JsonValue.Null);

  // **The proof has to be about the block the root came from**, and the first node is where that is
  // checkable: an account proof's root node hashes to the state root by definition. Checking it here turns
  // an unreadable failure three layers down — "node 0 hashes to X, but its parent named Y", which sends
  // the reader into the trie code — into the sentence that is actually true.
  //
  // It is not hypothetical. **anvil answers `eth_getProof` with the latest state whatever block is asked
  // for**, so every anchored proof against an older block arrives inconsistent; a real node either serves
  // the block or refuses. Either way the caller learns which, here, instead of downstream.
  if (accountNodes.len() == 0) { return failed("the node answered with no account proof"); }
  u8[] proofRoot = keccak256(accountNodes[0]);
  for (i32 i = 0; i < 32; i++) {
    if (proofRoot[i] != root[i]) {
      return failed(anchored
        ? "the node answered with a proof for a different block than the one anchored to — it may not "
          + "serve historical proofs"
        : "the node's proof does not match the state root of the block it sent");
    }
  }
  JsonValue storageProof = got.member("storageProof") ?? JsonValue.Null;
  match (storageProof) {
    Array(items): {
      if (items.len() != slots.len()) {
        return failed("asked about \{slots.len()} slot(s) and got "
                      + "\{items.len()} storage proofs");
      }
      u8[][][] out = u8[][][].filled(slots.len(), u8[][].filled(0, u8[]()));
      for (i32 i = 0; i < slots.len(); i++) {
        JsonValue entry = items.get(i);
        // The key each answer is about, checked against the slot asked for at that position. A node that
        // reordered them would otherwise hand a caller the resolver where it asked for the owner, and
        // both are addresses of the same shape.
        u8[] key = memberData(entry, "key");
        u8[] want = fromHexData(slots[i].toBytes());
        if (key.len() != want.len()) { return failed("a storage proof is about a slot of another size"); }
        for (i32 j = 0; j < key.len(); j++) {
          if (key[j] != want[j]) { return failed("the node answered about a slot that was not asked for"); }
        }
        out[i] = hexArray(entry.member("proof") ?? JsonValue.Null);
      }
      return Result.Ok(Proof.many(root, accountNodes, out));
    }
    default: { return failed("the answer has no storageProof array"); }
  }
}

Result<Proof, string> failed(string why) { return Result.Err(why); }
