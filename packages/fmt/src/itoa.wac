// Integer to decimal string, and back.
//
// Interpolation does the first job: `"\{n}"` is the decimal of any integer, through core's `toString`,
// and is what new code should write. `itoa`, `itoa64` and `utoa64` stay because `tools/` and other
// callers still name them; each is that interpolation. They used to be digit loops, written when wac
// had no number-to-string conversion — and the hand-written copies of them around the repository had
// drifted at the minimum values (`issues/system/0325a`).

/** Decimal representation of `n`, with a leading `-` when negative. */
export string itoa(i32 n) { return "\{n}"; }

/** Decimal representation of a 64-bit `n`, with a leading `-` when negative. */
export string itoa64(i64 n) { return "\{n}"; }

/** Decimal representation of `n`. Never signed — a u64 has no negative values. */
export string utoa64(u64 n) { return "\{n}"; }

/**
 * Leading digits only, zero when there are none — a command line is not a parser.
 *
 * The sign is read, which one copy of this did not: a leading `-` failed the digit test on the first
 * character and the answer was 0. It surfaced in `box`'s `seq` as `seq 10 -3 1` refusing a step of zero
 * it had invented itself, and the same shape was still in `packages/sh` until this became one function.
 * A caller for which `-5` is a *flag* has to strip the sign itself before asking.
 */
export i32 atoi(string s) {
  u8[] b = s.toBytes();
  return atoiSpan(b, 0, b.len()).value as~ i32;
}

/** What `atoiSpan` found: the number, where it stopped, and whether there were any digits at all. */
export struct Scanned {
  i64 value;
  /** The first byte not consumed — `start` when there was no number. */
  i32 end;
  /** False when there were no digits, which `value` 0 alone cannot say. */
  bool any;
}

/**
 * The decimal integer at the front of `src[start..end)`, an optional sign then digits, and where it
 * stopped — for a scanner holding bytes that carries on from the end (`issues/lang/0351a`). A sign with
 * no digit after it is no number and is not consumed.
 */
export Scanned atoiSpan(u8[] src, i32 start, i32 end) {
  i32 at = start;
  bool negative = false;
  if (at < end && (src[at] == '-' || src[at] == '+')) {
    negative = src[at] == '-';
    at = at + 1;
  }
  i32 from = at;
  i64 v = 0;
  while (at < end && src[at] >= '0' && src[at] <= '9') {
    v = v * 10 + (src[at] - '0') as i64;
    at = at + 1;
  }
  if (at == from) { return Scanned(0, start, false); }
  return Scanned(negative ? 0 - v : v, at, true);
}
