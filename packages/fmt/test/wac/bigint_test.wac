// The bignum against the host's `BigInt`.
//
// This is where the arithmetic underneath `ftoa` is actually verified. A wrong carry or a
// mis-normalised limb count would not necessarily show up as a wrong string — it would show up as
// one digit too many, which is exactly how the first version's bug presented, and by then the cause
// is several layers down.
//
// ## What the move changed
//
// `BigInt` is asked once per test rather than once per operation. The operands travel as a u64 and a
// shift, because that is the only shape `bigops.wac` could build one from across the bindgen boundary
// and is the shape the oracle protocol inherited.
//
// **`BIGINT` below is the whole oracle, and it only answers.** It was a TypeScript file shared with
// the float tests, which took this file's limbs and did the comparing; since 2026-10-27 the script
// says what `BigInt` makes of each question, in hex, and `agree` compares in wac
// (`packages/wactest/src/inline.wac`). Our side spells its limbs the same way — `valueHex` — so the
// comparison is of values, and a `FixedBig` with a spare zero limb is not a different number.
//
// `bigops.wac` itself is no longer needed to *reach* the operations — `FixedBig` is an ordinary
// struct here — but `dump` is still the encoding `valueHex` reads, so it is imported rather than
// rewritten. It stays for `cov.ts` too.
//
// Host-side until 2026-08-17. `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { Rng } from "../../../wactest/src/rng.wac";
import { hex } from "../../../wactest/src/oracle.wac";
import { Asked, agree } from "../../../wactest/src/inline.wac";
import { Sys } from "std";
import { shiftTest, mulTest, sumTest, subTest, cmpTest, addTest } from "../bigops.wac";

/**
 * Two draws as one 64-bit value, high half first.
 *
 * A free function rather than a method: `Rng` comes from `packages/wactest/src/rng.wac` now and a wac
 * struct's methods cannot be extended from another file. The draw order is the high half then the low,
 * which is what the copy this replaces did — reversing it would give the same distribution and a
 * different corpus. `issues/system/0220`.
 */
u64 next64(Rng r) {
  u64 hi = r.next() as u64;
  u64 lo = r.next() as u64;
  return (hi << 32) | lo;
}

/**
 * What `BigInt` says, one line for each question, as `toString(16)`. An operand is `<hex16> <shift>`:
 * `shift x`, `mul x <m> <times>` (x·m^times), `sum x y`, `sub x y` — refused when x < y, a negative a
 * `FixedBig` cannot hold — and `cmp x y`, which is -1, 0 or 1.
 */
static string BIGINT =
  "const L = (await new Response(Deno.stdin.readable).text()).split(String.fromCharCode(10)).filter((l) => l.length > 0);\n" +
  "const say = (k, a) => {\n" +
  "  const x = BigInt('0x' + a[0]) << BigInt(a[1]);\n" +
  "  if (k === 'shift') return x.toString(16);\n" +
  "  if (k === 'mul') return (x * BigInt(a[2]) ** BigInt(a[3])).toString(16);\n" +
  "  const y = BigInt('0x' + a[2]) << BigInt(a[3]);\n" +
  "  if (k === 'sum') return (x + y).toString(16);\n" +
  "  if (k === 'sub') return x < y ? 'refused: the minuend is the smaller' : (x - y).toString(16);\n" +
  "  if (k === 'cmp') return String(x < y ? -1 : x > y ? 1 : 0);\n" +
  "  return 'no such question: ' + k;\n" +
  "};\n" +
  "console.log(L.map((l) => { const [k, ...a] = l.split(' '); return say(k, a); }).concat(['DONE ' + L.length]).join(String.fromCharCode(10)));\n";

/** Limbs — little-endian bytes — as the number they are, spelled the way `BigInt.toString(16)` is. */
string valueHex(u8[] limbs) {
  u8[] be = u8[].filled(limbs.len(), 0);
  for (i32 i = 0; i < limbs.len(); i++) { be[i] = limbs[limbs.len() - 1 - i]; }
  string h = hex(be);
  i32 at = 0;
  while (at < h.len() - 1 && h.slice(at, at + 1) == "0") { at = at + 1; }
  return h.len() == 0 ? "0" : h.slice(at, h.len());
}

/** A u64 as sixteen hex digits, big-endian, which is how an operand travels. */
string u64Hex(u64 v) {
  string digits = "0123456789abcdef";
  string out = "";
  u64 x = v;
  for (i32 i = 0; i < 16; i++) {
    i32 nib = (x % 16) as~ i32;
    out = digits.slice(nib, nib + 1) + out;
    x = x / 16;
  }
  return out;
}

/**
 * `shiftLeft` across every limb boundary.
 *
 * 31/32/33 is where a word-shift plus a bit-shift interact, which is the part that is easy to get
 * wrong and impossible to notice from a length check.
 */
export async string test_fixedbig_shift_left_across_every_limb_boundary(Sys sys) {
  T t = T.create();
  i32[] shifts = [0, 1, 7, 31, 32, 33, 63, 64, 65, 95, 96, 127, 200, 500, 971, 1074];
  u64[] values = [
                       1, 3, 0xFF, 0xFFFFFFFF, 0x100000000, 0x1FFFFFFFFFFFFF,
                       0xFFFFFFFFFFFFFFFF
  ];
  Asked asked = Asked.create();
  for (i32 v = 0; v < values.len(); v++) {
    for (i32 s = 0; s < shifts.len(); s++) {
      asked.add("shift \{u64Hex(values[v])} \{shifts[s]}",
                valueHex(shiftTest(values[v], shifts[s])));
    }
  }
  await agree(t, sys.procs(), BIGINT, asked, "shiftLeft");
  return t.report();
}

/**
 * `mulSmall` carries through many multiplications.
 *
 * Repeated ×10 is what the scaling and digit loops do, up to ~340 times for a subnormal, so the
 * carry chain has to hold over a long run.
 */
export async string test_fixedbig_mul_small_carries(Sys sys) {
  T t = T.create();
  u64[] v = [1, 1, 1, 3, 0x1FFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, 1, 7];
  i32[] bits = [0, 0, 0, 52, 52, 0, 100, 0];
  u32[] mul = [10, 10, 10, 10, 10, 10, 4, 2];
  i32[] times = [1, 19, 340, 17, 17, 30, 3, 100];
  Asked asked = Asked.create();
  for (i32 i = 0; i < v.len(); i++) {
    asked.add("mul " + u64Hex(v[i]) + " \{bits[i]} \{mul[i] as@ i32} \{times[i]}",
              valueHex(mulTest(v[i], bits[i], mul[i], times[i])));
  }
  await agree(t, sys.procs(), BIGINT, asked, "mulSmall");
  return t.report();
}

export async string test_fixedbig_random_add_subtract_and_compare(Sys sys) {
  T t = T.create();
  Rng rng = Rng(0x5BD1E995);
  Asked asked = Asked.create();
  for (i32 i = 0; i < 4000; i++) {
    u64 a = next64(rng);
    u64 b = next64(rng);
    i32 ashift = rng.upto(600);
    i32 bshift = rng.upto(600);
    asked.add("sum \{u64Hex(a)} \{ashift} \{u64Hex(b)} \{bshift}",
              valueHex(sumTest(a, ashift, b, bshift)));
    // `sub` requires the minuend to be the larger, which is the contract — so the *order* is decided
    // here, by asking the operation being tested which way round they go. That is not circular: the
    // comparison itself is asked on the next line, so a wrong `cmp` shows up there and a wrong order
    // shows up as the subtraction the oracle refuses.
    i32 order = cmpTest(a, ashift, b, bshift);
    if (order >= 0) {
      asked.add("sub \{u64Hex(a)} \{ashift} \{u64Hex(b)} \{bshift}",
                valueHex(subTest(a, ashift, b, bshift)));
    } else {
      asked.add("sub \{u64Hex(b)} \{bshift} \{u64Hex(a)} \{ashift}",
                valueHex(subTest(b, bshift, a, ashift)));
    }
    asked.add("cmp \{u64Hex(a)} \{ashift} \{u64Hex(b)} \{bshift}", "\{order}");
  }
  await agree(t, sys.procs(), BIGINT, asked, "add, subtract and compare");
  return t.report();
}

/**
 * Subtraction that borrows across many zero limbs.
 *
 * `2^n - 1` turns every limb below the top into `0xFFFFFFFF`, so the borrow has to run the whole
 * length. An off-by-one in the borrow shows up here and nowhere else.
 */
export async string test_fixedbig_subtraction_that_borrows_across_zero_limbs(Sys sys) {
  T t = T.create();
  i32[] bits = [32, 33, 64, 96, 128, 500, 1024];
  Asked asked = Asked.create();
  for (i32 i = 0; i < bits.len(); i++) {
    asked.add("sub 0000000000000001 \{bits[i]} 0000000000000001 0",
              valueHex(subTest(1, bits[i], 1, 0)));
  }
  await agree(t, sys.procs(), BIGINT, asked, "borrowing subtraction");
  return t.report();
}

export async string test_fixedbig_zero_and_equality_edge_cases(Sys sys) {
  T t = T.create();
  Asked asked = Asked.create();
  asked.add("sum 0000000000000000 0 0000000000000000 0", valueHex(sumTest(0, 0, 0, 0)));
  asked.add("sub 0000000000000005 0 0000000000000005 0", valueHex(subTest(5, 0, 5, 0)));
  asked.add("cmp 0000000000000000 0 0000000000000000 0", "\{cmpTest(0, 0, 0, 0)}");
  asked.add("cmp 0000000000000001 0 0000000000000000 0", "\{cmpTest(1, 0, 0, 0)}");
  asked.add("cmp 0000000000000000 0 0000000000000001 0", "\{cmpTest(0, 0, 1, 0)}");
  // The same magnitude reached two ways: 2^32 shifted 32, and 1 shifted 64. Both operands stay
  // inside u64, and they compare equal only if the limb count is normalised after every operation.
  asked.add("cmp 0000000100000000 32 0000000000000001 64", "\{cmpTest(0x100000000, 32, 1, 64)}");
  asked.add("cmp ffffffffffffffff 0 0000000000000001 64", "\{cmpTest(0xFFFFFFFFFFFFFFFF, 0, 1, 64)}");
  await agree(t, sys.procs(), BIGINT, asked, "zero and equality");
  // And `5 - 5` normalises to zero rather than to a one-limb zero, which the limb dump shows
  // directly and the oracle cannot: `00000000` and `` are the same number, and `valueHex` spells both `0`.
  t.eqI32(subTest(5, 0, 5, 0).len(), 0, "5 - 5 normalises to no limbs at all");
  return t.report();
}

/**
 * `add` agrees with `setSum`, in both orders — two implementations of one sum in one file.
 *
 * `bigint.wac` has `add` (in place) and `setSum` (into a third), and their loops are near copies: the
 * same carry, the same `i < n` guards, the same limb count taken as a max. A change made to one and
 * not the other is invisible to every existing test, because `setSum` is what the random sweep above
 * drives and `add` is reached only through `mulU64` with a multiplier above 2^32 — where the operand
 * is always the longer of the two, so half of `add`'s arms never run.
 *
 * The interesting direction is `this` longer than `o`, which is the one its caller cannot produce.
 */
export string test_fixedbig_add_in_place_agrees_with_the_three_operand_sum() {
  T t = T.create();
  // Shifts chosen so each pair has a longer and a shorter side, and one pair of equal length.
  i32[] lshift = [0, 300, 64, 500, 0, 128];
  i32[] rshift = [300, 0, 64, 32, 0, 96];
  u64 x = 0xFFFFFFFFFFFFFFFF;
  u64 y = 0x0123456789ABCDEF;
  i32 longer = 0;
  for (i32 i = 0; i < lshift.len(); i++) {
    t.eqBytes(addTest(x, lshift[i], y, rshift[i]), sumTest(x, lshift[i], y, rshift[i]),
              "add and setSum disagree with shifts \{lshift[i]} and \{rshift[i]}");
    // And the other way round, which is addition being commutative and also the arm swap.
    t.eqBytes(addTest(y, rshift[i], x, lshift[i]), sumTest(x, lshift[i], y, rshift[i]),
              "add is not commutative at shifts \{lshift[i]} and \{rshift[i]}");
    if (lshift[i] > rshift[i]) { longer = longer + 1; }
  }
  // Said out loud: without a case where the receiver is the longer operand this test would pass while
  // measuring only the shape `mulU64` already produces.
  t.isTrue(longer >= 2, "only \{longer} cases put the longer value on the left");

  // A carry that runs off the end of the shorter operand and keeps going through the longer one.
  t.eqBytes(addTest(0xFFFFFFFFFFFFFFFF, 128, 1, 0), sumTest(0xFFFFFFFFFFFFFFFF, 128, 1, 0),
            "a carry into the high limbs disagrees");
  t.eqBytes(addTest(0, 0, 0, 0), sumTest(0, 0, 0, 0), "zero plus zero");
  return t.report();
}
