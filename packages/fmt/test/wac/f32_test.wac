// f32 formatting and parsing.
//
// JavaScript has no f32, so `String(x)` is not the oracle it was for doubles. Instead the two
// defining properties are checked directly: the output must read back as the same f32, and no
// shorter decimal may do so. That is what "shortest round-tripping" means, and checking it this way
// is stronger than comparing against another implementation's opinion.
//
// **The reading back is the host's, deliberately.** `Number(s)` then `Math.fround` is a parser that
// is not ours, so a formatter and a parser wrong in opposite ways cannot agree their way past it.
// The last test here does use ours for both and says so — it is about the pair composing, and it is
// separate for that reason.
//
// Floats travel to the oracle as their **bits**, because a decimal spelling of the input would be the
// very thing under test.
//
// **`FROUND` below is the whole oracle, and it only answers.** It was a TypeScript file shared by the
// four float tests, which took this file's answers and did the comparing; since 2026-10-27 the
// script says what `Math.fround` and `toPrecision` say for each question and `agree` compares in wac
// (`packages/wactest/src/inline.wac`). Counting our significant digits moved here with it.
//
// Host-side until 2026-08-17. `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { Rng } from "../../../wactest/src/rng.wac";
import { hex } from "../../../wactest/src/oracle.wac";
import { Asked, agree } from "../../../wactest/src/inline.wac";
import { Sys } from "std";
import { Buf } from "core";
import { ftoa32, ftoa32Bytes } from "../../src/ftoa.wac";
import { atof32Span } from "../../src/atof.wac";

/**
 * What `Math.fround` says, one line for each question: `read <text>` is the bits of
 * `Math.fround(Number(text))`, as eight hex digits; `shorter <bits8> <n>` is the first
 * `x.toPrecision(p)` with `p < n` that reads back as the f32 `x` those bits name, or `none`.
 */
static string FROUND =
  "const L = (await new Response(Deno.stdin.readable).text()).split(String.fromCharCode(10)).filter((l) => l.length > 0);\n" +
  "const v = new DataView(new ArrayBuffer(4));\n" +
  "const bits = (x) => { v.setFloat32(0, x); return v.getUint32(0).toString(16).padStart(8, '0'); };\n" +
  "const shorter = (h, n) => {\n" +
  "  v.setUint32(0, parseInt(h, 16)); const x = v.getFloat32(0);\n" +
  "  for (let p = 1; p < n; p++) { const s = x.toPrecision(p); if (Object.is(Math.fround(Number(s)), x)) return s; }\n" +
  "  return 'none';\n" +
  "};\n" +
  "const say = (k, a) => {\n" +
  "  if (k === 'read') return bits(Math.fround(Number(a[0])));\n" +
  "  if (k === 'shorter') return shorter(a[0], Number(a[1]));\n" +
  "  return 'no such question: ' + k;\n" +
  "};\n" +
  "console.log(L.map((l) => { const [k, ...a] = l.split(' '); return say(k, a); }).concat(['DONE ' + L.length]).join(String.fromCharCode(10)));\n";

/**
 * Significant digits in a decimal: no sign, point, exponent or padding.
 *
 * Trailing zeros are exponent, not information — 8324640000000 carries six significant digits, and
 * counting thirteen made the shortest check reject a correct answer.
 */
i32 significantDigits(string s) {
  u8[] b = s.toBytes();
  Buf digits = Buf.create();
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] == 'e' || b[i] == 'E') { break; }
    if (b[i] >= '0' && b[i] <= '9') { digits.push(b[i]); }
  }
  u8[] d = digits.take();
  i32 from = 0;
  i32 to = d.len();
  while (from < to && d[from] == '0') { from = from + 1; }
  while (to > from && d[to - 1] == '0') { to = to - 1; }
  return to == from ? 1 : to - from;
}

string fmt(f32 x) { return string.fromBytes(ftoa32Bytes(x)); }
f32 parse32(string s) { return atof32Span(s.toBytes(), 0, s.len()); }

/** The four bytes of an f32, big-endian, as hex — the form the oracle reads. */
string bits32(f32 x) {
  u32 b = f32.toBits(x);
  u8[] out = u8[].filled(4, 0);
  out[0] = (((b >> 24) & 255) as@ i32) as@ u8;
  out[1] = (((b >> 16) & 255) as@ i32) as@ u8;
  out[2] = (((b >> 8) & 255) as@ i32) as@ u8;
  out[3] = ((b & 255) as@ i32) as@ u8;
  return hex(out);
}

f32 ofBits(u32 b) { return f32.fromBits(b); }

bool isFinite32(f32 x) {
  u32 b = f32.toBits(x);
  return ((b >> 23) & 255) != 255;
}

bool isNan32(f32 x) {
  u32 b = f32.toBits(x);
  return ((b >> 23) & 255) == 255 && (b & 8388607) != 0;
}

export string test_f32_specials_and_zeros() {
  T t = T.create();
  t.eqStr(fmt(ofBits(0x7FC00000)), "NaN", "NaN");
  t.eqStr(fmt(ofBits(0x7F800000)), "Infinity", "Infinity");
  t.eqStr(fmt(ofBits(0xFF800000)), "-Infinity", "-Infinity");
  t.eqStr(fmt(ofBits(0)), "0", "zero");
  t.eqStr(fmt(ofBits(0x80000000)), "0", "negative zero prints as zero");
  return t.report();
}

/**
 * Output round-trips and is shortest.
 *
 * Two properties, asked separately. Round-tripping alone would be satisfied by printing the exact
 * value, which is never what is wanted — so the second question is whether any decimal with fewer
 * significant digits than ours also reads back, and the answer we expect is `none`.
 */
export async string test_f32_output_round_trips_and_is_shortest(Sys sys) {
  T t = T.create();
  Rng rng = Rng(0x1F123BB5);
  Asked asked = Asked.create();
  i32 checked = 0;
  for (i32 i = 0; i < 6000; i++) {
    f32 x = ofBits(rng.next());
    if (!isFinite32(x)) { continue; }
    string s = fmt(x);
    asked.add("read \{s}", bits32(x));
    asked.add("shorter \{bits32(x)} \{significantDigits(s)}", "none");
    checked = checked + 1;
  }
  t.isTrue(checked > 4000, "only \{checked} finite values were drawn");
  await agree(t, sys.procs(), FROUND, asked, "\{checked} f32 values, round-tripped and minimal");
  return t.report();
}

/**
 * The string spelling and the bytes spelling agree.
 *
 * `ftoa32` and `ftoa32Bytes` differ only in `Buf.toStr()` against `Buf.bytes()`, and until this test
 * nothing had ever called the first — `wac task dead` found it, and `packages/fmt/README.md` lists
 * it as the package's f32 API. Both now go through `writeF32`, so this is what would notice if one
 * of them stopped.
 */
export string test_f32_the_string_and_bytes_spellings_agree() {
  T t = T.create();
  u32[] named = [
                      0, 0x80000000, 0x7FC00000, 0x7F800000, 0xFF800000, 0x3DCCCCCD, 1,
                      0x7F7FFFFF
  ];
  i32 checked = 0;
  for (i32 i = 0; i < named.len(); i++) {
    f32 x = ofBits(named[i]);
    t.eqStr(string.fromBytes(ftoa32Bytes(x)), ftoa32(x), "bits \{bits32(x)}");
    checked = checked + 1;
  }
  Rng rng = Rng(0x2545F491);
  for (i32 i = 0; i < 2000; i++) {
    f32 x = ofBits(rng.next());
    if (isNan32(x)) { continue; }
    t.eqStr(string.fromBytes(ftoa32Bytes(x)), ftoa32(x), "bits \{bits32(x)}");
    checked = checked + 1;
  }
  t.isTrue(checked > 1500, "only \{checked} values agreed through both spellings");
  return t.report();
}

export string test_f32_the_boundary_values() {
  T t = T.create();
  t.eqStr(fmt(ofBits(1)), "1e-45", "the smallest subnormal");
  t.eqStr(fmt(ofBits(0x00800000)), "1.1754944e-38", "the smallest normal");
  t.eqStr(fmt(ofBits(0x7F7FFFFF)), "3.4028235e+38", "the largest finite");
  t.eqStr(fmt(ofBits(0x3F800000)), "1", "one");
  t.eqStr(fmt(ofBits(0x3DCCCCCD)), "0.1", "a tenth");
  t.eqStr(fmt(ofBits(0x3F000000)), "0.5", "a half");
  return t.report();
}

/**
 * Parsing is correctly rounded, not doubly rounded.
 *
 * Parsing to f64 and narrowing rounds twice and disagrees near f32 boundaries, so the result is
 * compared against the host's `Math.fround` of the *exact* decimal — which JavaScript computes in one
 * step from the string.
 */
export async string test_f32_parsing_is_correctly_rounded(Sys sys) {
  T t = T.create();
  string[] cases = [
    "0", "-0", "1", "-1", "0.1", "0.2", "3.14159265358979",
    "1e-45", "7e-46", "1.1754944e-38", "3.4028235e38", "3.4028236e38",
    "1e39", "-1e39", "1e-50", "16777216", "16777217", "16777218",
    "1.00000005960464477539062", "0.999999940395355224609375",
    "123456789012345678901234567890", "2.5e-324"
  ];
  Asked asked = Asked.create();
  for (i32 i = 0; i < cases.len(); i++) {
    asked.add("read \{cases[i]}", bits32(parse32(cases[i])));
  }
  await agree(t, sys.procs(), FROUND, asked, "correctly-rounded parsing");
  return t.report();
}

/**
 * Parse and format are inverse over random values.
 *
 * **This one is symmetric on purpose** — both halves are ours, so it says the pair composes and
 * nothing about whether either is right. The tests above are what say that, through a parser that is
 * not ours.
 */
export string test_f32_parse_and_format_are_inverse() {
  T t = T.create();
  Rng rng = Rng(0x9E3779B1);
  i32 checked = 0;
  for (i32 i = 0; i < 4000; i++) {
    f32 x = ofBits(rng.next());
    if (!isFinite32(x)) { continue; }
    checked = checked + 1;
    string s = fmt(x);
    t.eqStr(bits32(parse32(s)), bits32(x), "round trip through \"\{s}\"");
  }
  t.isTrue(checked > 2500, "only \{checked} values survived format-then-parse");
  return t.report();
}
