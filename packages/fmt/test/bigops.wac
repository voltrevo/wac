// Exports the bignum's operations across the bindgen boundary so the host can
// compare them against its own BigInt. A `FixedBig` is a GC reference and cannot cross,
// so each entry point builds one from primitives and dumps the limbs as bytes.
//
// This is a test fixture, not part of the library.

import { FixedBig } from "../src/bigint.wac";

// Return the bignum as bytes, little-endian, so the host can rebuild it exactly.
u8[] dump(FixedBig b) {
  u8[] out = u8[b.n * 4]();
  for (i32 i = 0; i < b.n; i++) {
    u32 v = b.limbs[i];
    out[i * 4]     = (v & (255 as@ u32)) as@ i32;
    out[i * 4 + 1] = ((v >> (8 as@ u32)) & (255 as@ u32)) as@ i32;
    out[i * 4 + 2] = ((v >> (16 as@ u32)) & (255 as@ u32)) as@ i32;
    out[i * 4 + 3] = ((v >> (24 as@ u32)) & (255 as@ u32)) as@ i32;
  }
  return out;
}

export u8[] shiftTest(u64 v, i32 bits) {
  FixedBig b = FixedBig.fromU64(v);
  b.shiftLeft(bits);
  return dump(b);
}

export u8[] mulTest(u64 v, i32 bits, u32 m, i32 times) {
  FixedBig b = FixedBig.fromU64(v);
  b.shiftLeft(bits);
  for (i32 i = 0; i < times; i++) { b.mulSmall(m); }
  return dump(b);
}

export u8[] sumTest(u64 a, i32 ashift, u64 b, i32 bshift) {
  FixedBig x = FixedBig.fromU64(a); x.shiftLeft(ashift);
  FixedBig y = FixedBig.fromU64(b); y.shiftLeft(bshift);
  FixedBig z = FixedBig.zero();
  z.setSum(x, y);
  return dump(z);
}

/**
 * `x.add(y)` in place, which is a different function from `setSum` and has a different caller.
 *
 * `add` is reached only from `mulU64`, and there `this` is always the *shorter* operand — the scratch
 * it is handed has been shifted left 32. So the two arms that handle `this` being longer had never
 * run: `issues/system/0205` listed `bigint.wac:162` and `:167`. A seam is the only way to them, since
 * no caller in the package can be the other shape.
 */
export u8[] addTest(u64 a, i32 ashift, u64 b, i32 bshift) {
  FixedBig x = FixedBig.fromU64(a); x.shiftLeft(ashift);
  FixedBig y = FixedBig.fromU64(b); y.shiftLeft(bshift);
  x.add(y);
  return dump(x);
}

export u8[] subTest(u64 a, i32 ashift, u64 b, i32 bshift) {
  FixedBig x = FixedBig.fromU64(a); x.shiftLeft(ashift);
  FixedBig y = FixedBig.fromU64(b); y.shiftLeft(bshift);
  x.sub(y);
  return dump(x);
}

export i32 cmpTest(u64 a, i32 ashift, u64 b, i32 bshift) {
  FixedBig x = FixedBig.fromU64(a); x.shiftLeft(ashift);
  FixedBig y = FixedBig.fromU64(b); y.shiftLeft(bshift);
  return x.cmp(y);
}
