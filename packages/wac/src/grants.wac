// The world `wac sh` hands the shell: sealed unless the command line asked otherwise.
//
// **This is the part of `issues/system/0257c` step 4 that is not wiring.** `sh` was a payload the
// native binary embedded, and `run_shell` in `native/v8/src/main.rs` served it a world built in Rust:
// no grants by default, and `--allow-read`/`--allow-write`/`--allow-net`/`--allow-env`/`--allow-run`
// *intersected* with what the payload carried. Dispatching `sh` inside the one `wac` program removes
// that step — a callee shares its caller's capabilities, so the shell would silently inherit
// everything the command was granted, which for the seed build is read, write, env and net.
//
// That would be a widening nobody asked for. `wac sh` on its own is sealed, and the whole argument of
// this system is that a program reaches only what it was handed; a command that gets a filesystem
// because the *compiler* needed one is the opposite of that.
//
// So `wac sh` runs the shell as a **spawned child of this program**, handed an `Authority` of what was
// asked for and nothing else — `null` for the rest — and the host enforces it, as it enforces any child's
// grants. The sealed default is then the host's behaviour on every host, and the child cannot reach what
// it was not handed however the shell is written.
//
// **The intersection is free here, which is the nice part.** A grant passed on is a handle this program
// holds, so a `wac` that was never granted net has nothing to hand a `wac sh --allow-net`. The ceiling
// enforces itself.
//
// The other commands narrow the same way without a spawn: each is handed the handles it uses, and its
// files narrowed to what `forCommand` says — `check` gets them read-only, so it cannot write whatever this
// program could.

import { Authority, Env, Files, Net, Procs } from "std";

/** What the command line asked for, which is all `sh` gets. */
export struct Asked {
  bool read;
  bool write;
  bool net;
  bool env;
  bool run;

  Asked none() { return Asked(false, false, false, false, false); }

  /** Whether any filesystem was asked for. */
  bool anyFs(const this) { return this.read || this.write; }
}

/**
 * Read the leading `--allow-*` flags, stopping at the first thing that is not one.
 *
 * Returns how many were consumed as well as what they said, because the caller has to know where
 * the shell's own arguments begin. An unknown `--allow-` word is *not* consumed: `sh` passes the
 * rest to the shell, and a mistyped grant should reach the shell's own argument handling and be
 * complained about there rather than being silently accepted as nothing.
 */
export struct Parsed {
  Asked asked;
  i32 at;
  string bad;
}

/** The `GRANT_*` bits a module's manifest declares, as what they ask for. */
export Asked askedOfBits(i32 bits) {
  return Asked((bits & 1) != 0, (bits & 2) != 0, (bits & 4) != 0, (bits & 8) != 0, (bits & 16) != 0);
}

/**
 * `fs` narrowed to what `a` asked for: as it is for read and write, read-only or write-only for one, and
 * neither for none — a value that refuses every operation, which is what a command not handed files holds.
 */
export Files filesFor(Files fs, Asked a) {
  if (a.read && a.write) { return fs; }
  if (a.read) { return fs.readOnly(); }
  if (a.write) { return fs.writeOnly(); }
  return fs.readOnly().writeOnly();
}

/** Exactly what `a` asked for out of these handles, `null` for the rest — what a child is handed. */
export Authority authorityOf(Asked a, Files fs, Net net, Env env, Procs procs) {
  return Authority(a.anyFs() ? filesFor(fs, a) : null, a.net ? net : null, a.env ? env : null, a.run ? procs : null);
}

/** What `a` asked for out of `all`, `null` for the rest — never more than `all` holds. */
export Authority within(Authority all, Asked a) {
  return Authority(a.anyFs() && (all.files is not null) ? filesFor(all.files!, a) : null, a.net ? all.net : null,
                   a.env ? all.env : null, a.run ? all.procs : null);
}

export Parsed askedFrom(string[] argv, i32 from) {
  Asked a = Asked.none();
  i32 i = from;
  while (i < argv.len()) {
    string w = argv[i];
    if (w == "--allow-read") { a.read = true; }
    else if (w == "--allow-write") { a.write = true; }
    else if (w == "--allow-net") { a.net = true; }
    else if (w == "--allow-env") { a.env = true; }
    else if (w == "--allow-run") { a.run = true; }
    else if (w.len() > 8 && w.slice(0, 8) == "--allow-") { return Parsed(a, i, w); }
    else { return Parsed(a, i, ""); }
    i = i + 1;
  }
  return Parsed(a, i, "");
}

/**
 * What each command needs, which is less than the program holds.
 *
 * **One program means one manifest, and the manifest is the union.** Three payloads each carried
 * their own grants and only the fetcher's had `--allow-net`; now the seed is built with net because
 * `wac update` clones, so a `wac check` that asks for nothing at all is running inside a program that
 * could open a socket. Nothing exploits that — but "a program reaches only what it was handed" is the
 * whole argument of this system, and the binary handing itself more than the command needs is exactly
 * the shape the system is against.
 *
 * So the command narrows itself on the way in. The four compiler commands cannot reach the network or
 * start a process, whatever the binary was built with.
 *
 * **`run` and `test` keep everything, and that is not laziness.** Their `--allow-*` flags govern the
 * *program they start*, not this one, and a child cannot be handed what its parent does not hold — so
 * narrowing here would silently make `wac test --allow-net` unable to grant net. The flags are already
 * the narrowing for those two; `runprog.wac` and `testrun.wac` own it.
 */
export Asked forCommand(Command cmd) {
  // **No default** (issue 0337a): every command is an arm, so a command added to the enum without a
  // line here does not compile — where a fall-through gave it every grant, silently, and the only signal
  // was that nothing went wrong.
  match (cmd) {
    // Reading sources, and `$WAC_HOME` to find a mapped import in the cache. `check` writes nothing —
    // it is the one command whose whole output is a sentence.
    Check: { return Asked(true, false, false, true, false); }
    // `audit` reads the sources it reports on and writes nothing: the same as `check`. It had no line
    // until 2026-10-22, and so held every grant through the default this table no longer has.
    Audit: { return Asked(true, false, false, true, false); }
    // ...and these three write a module, a manifest or a `.gen.ts` beside it.
    Compile: { return Asked(true, true, false, true, false); }
    Bindgen: { return Asked(true, true, false, true, false); }
    Build: { return Asked(true, true, false, true, false); }
    // `app` is a build that writes an executable instead of a module: the same three, and the
    // executable bit is part of writing a file rather than a capability of its own.
    App: { return Asked(true, true, false, true, false); }
    // Reading the modules it is asked about, and nothing default: `Modules.validate` is the engine answering
    // in this process, so there is no program to start and no file to write.
    Validate: { return Asked(true, false, false, false, false); }
    // `app-run` reads one file and starts what is inside it, and the grants the program gets are the
    // ones its own manifest declares — `runBytes` reads them from the module rather than passing on
    // what this command holds. It keeps everything for the same reason `run` does: a child cannot be
    // handed what its parent does not hold, so narrowing here would cap what a built program declared.
    AppRun: { return Asked(true, true, true, true, true); }
    // **`task` keeps everything, for the same reason `run` and `test` do**: it starts a command line
    // out of `tasks.json5`, and a child cannot be handed what its parent does not hold — so narrowing
    // here would decide, on behalf of every task, what tasks are allowed to be. `packages/wac/src/tasks.wac`
    // sets out why the grants are one set rather than one per task, and the narrowing that is real is
    // the caller's: `wac task` intersects with what this process already holds and cannot widen it.
    Task: { return Asked(true, true, true, true, true); }
    // The one command that reaches the network, which `design/lang/0009` D10 makes deliberate. Not
    // `run`: an ordinary build is offline by construction, and this is what keeps it that way even
    // though the two now live in one program.
    Update: { return Asked(true, true, true, true, false); }
    // Installing and removing an installation both read a few files, write `$WAC_HOME` and the
    // profiles, and ask where `$WAC_HOME` is. Neither reaches the network and neither starts a
    // program, and saying so is the point of this table: `self install` copies a binary that has
    // already been built, so it needs no compiler, no toolchain and no fetch.
    Self: { return Asked(true, true, false, true, false); }
    // `run` and `test`: their flags grant the program they start, which is the narrowing for them.
    Run: { return Asked(true, true, true, true, true); }
    Test: { return Asked(true, true, true, true, true); }
  }
}

/** Every command `wac` answers, by the word that names it on the command line — `commandNamed`. */
export enum Command { Check, Audit, Compile, Bindgen, Build, App, Validate, AppRun, Task, Update, Self, Run, Test }

/** The command `word` names, or null for a word that names none — where a typo becomes "unknown command". */
export Command? commandNamed(string word) {
  if (word == "check") { return Command.Check; }
  if (word == "audit") { return Command.Audit; }
  if (word == "compile") { return Command.Compile; }
  if (word == "bindgen") { return Command.Bindgen; }
  if (word == "build") { return Command.Build; }
  if (word == "app") { return Command.App; }
  if (word == "validate") { return Command.Validate; }
  if (word == "app-run") { return Command.AppRun; }
  if (word == "task") { return Command.Task; }
  if (word == "update") { return Command.Update; }
  if (word == "self") { return Command.Self; }
  if (word == "run") { return Command.Run; }
  if (word == "test") { return Command.Test; }
  return null;
}
