// `wac` — the command, as a program.
//
//     wac check   main.wac          # type-check it and its imports; say what is wrong
//     wac compile main.wac [out]    # write the module, `main.wasm` beside it by default
//     wac build   main.wac -o stem  # ...and the manifest a native host reads, in the module
//     wac bindgen main.wac [--js]   # main.wac.ts — the glue a host calls the module through
//     wac run     main.wac [args…]  # compile and run it, with no file in between
//     wac test    path [path…]      # a file or a directory of `*_test.wac`
//     wac prog.wasm [args…]         # run a built module, under the grants its manifest declares
//
// **This is the whole command, and that is the point of where it lives.** It opened "the compiler, as
// a program" and sat in `packages/wacc/example/`, which made the compiler's example *be* the unified
// command — so `sh` and `update` looked like things a host could not have, when the truth was that
// the command was built out of the compiler and carried what the compiler carried.
// `issues/system/0257c` is the operator's ruling: `wac` contains the compiler plus more, and every
// host's binary runs this same program. What a host may implement is *running a module*, because that
// is the engine doing engine work; everything else comes through here.
//
// `build` also takes `--coverage`: a counter per branch point, and `<stem>.cov` saying what each is.
// `--trace` is the other instrumented build — an ordered journal rather than counts, with
// `<stem>.trace` naming each site. `wac ctcompare` is what reads one.
//                                    #    --quiet for the success line, --allow-* for the grants
//
// A TypeScript CLI (`waccx`) did the same job until it was retired, and this was never a port for
// its own sake: it is what the `wac` binary dispatches. The wasmtime host already runs `packages/sh` and
// every one of box's applets over a real filesystem, so a compiler that is itself a wac program needs
// no JavaScript anywhere in the path — design/lang/0003 step 4.
//
// **The compiler does no I/O and this does no compiling.** `emitFiles` and its neighbours take paths
// and sources, which is what lets them run in a browser; `src/files.wac` says which files a program
// is made of; and reading them is here, where the capabilities are. Each half is testable without
// the other.

import { Exec, GRANT_ENV, GRANT_NET, GRANT_READ, GRANT_RUN, GRANT_WRITE, Stat, Sys, Clock, Env, Files, Input, Modules, Net, Output, Procs, Random, Authority, ChildEnv, Launch } from "std";
import { Read, Vec, flatten } from "core";
import { atoi } from "../../fmt/src/itoa.wac";
import { bindTypesFilesIn, bindgenDeclinedFilesIn, bindgenWire, blockedFilesIn, buildFilesIn,
         capReachFiles,
         covTableFilesIn, describeSeparator, diagnoseGraphIn, exportSigsFilesIn, missingImportFilesIn,
         wireHasErrors, pruneForBuild,
         emitFilesCoveredIn, emitFilesTraced, emitFilesTracedSlots, traceTableFiles,
         manifestWire } from "../../wacc/src/api.wac";
import { Built } from "../../wacc/src/emit.wac";
import { Pruned } from "../../wacc/src/reach.wac";
import { ProgramGraph, programGraph, testEntry } from "../../wacc/src/program.wac";
import { field, linesOf } from "../../wacc/src/text.wac";
import { cellAt, cells, hollowWhy, manifestIn, withManifestSection } from "../../wacc/src/manifest.wac";
// The test runner, which used to be 800 lines of this file — `issues/system/0257c`.
import { grantAfterEntry, grantsBefore, programArgs, runModule, spawnWith }
         from "./runprog.wac";
import { appRun, writeApp } from "./app.wac";
import { aggregatePath, aggregateSource, beside, flagValue, importable, noTrailingSlash, runTests,
         sigsWithCounters,
         commonDir, isDirAt, testTargets, withoutIgnored } from "./testrun.wac";
import { renderDiagnostics } from "../../wacc/src/render.wac";
import { importSpecs } from "../../wacc/src/files.wac";
import { Res, normalisePath, resolveFrom, resolveFromAt, resolveFromIn } from "../../wacc/src/path.wac";
import { MANIFEST_NAME, candidateRoots, dirOf, isProjectSpecifier } from "../../wacpkg/src/root.wac";
import { Gathered, ReadCache, Sources, exactly, gather, gatherRoots, gatherWith, projectRootAbs, resOf, wacHomeOf } from "./sources.wac";
import { Manifest, Match, Located, readManifest, manifestWhy, matchSpecifier, locate,
         M_OK } from "../../wacpkg/src/manifest.wac";
import { Lock, LockEntry, readLock } from "../../wacpkg/src/lock.wac";
import { JsonObject, JsonValue } from "../../json/src/value.wac";
import { parse } from "../../json/src/json.wac";
import { cachePath } from "../../wacpkg/src/cache.wac";
import { Task, tasksFile, tasksIn, commandOf, hasTask, listing, nearest } from "./tasks.wac";
import { fetchAll } from "../../wacpkg/src/fetch.wac";
import { Shell } from "../../sh/src/exec.wac";
import { shellMain } from "../../sh/src/entry.wac";
import { wireBox } from "../../box/src/shrun.wac";
import { reason } from "../../fs/src/words.wac";
import { Asked, Command, Parsed, askedFrom, askedOfBits, authorityOf, commandNamed, filesFor, forCommand, within } from "./grants.wac";
import { Counters, Digest, Exercise, agreeLine, compareJournals, digest, read } from "./counters.wac";

/** The three answers `Built.described` folds together. */
struct Described {
  /** Why the emitter gave up, empty when it did not. */
  string blocked;
  /** `name\tret\tparams` per exported function — `exportSigsFiles`'s format. */
  string sigs;
  /** The bind-type wire — `bindTypesFiles`'s format. */
  string types;
}

/**
 * `blocked`, `sigs` and `types`, split on `describeSeparator()`.
 *
 * Two separators, three parts, and a part may be empty — a graph with nothing blocked and nothing
 * exported produces `sep + sep`. The separator is a whole line that neither half can emit, which is
 * what makes splitting on it safe: signature lines are `name\tret\tparams` and bind-type lines start
 * with a one-letter tag, so neither can contain it.
 *
 * A string that does not carry two separators is not one of these, and the honest answer to that is
 * the empty parts rather than a guess: `blockedOf` said nothing, so nothing is blocked, and a
 * manifest built from no signatures is a manifest a host will refuse loudly.
 */
Described describedParts(string described) {
  string sep = describeSeparator();
  i32 first = described.indexOf(sep);
  if (first < 0) { return Described(described, "", ""); }
  string blocked = described.slice(0, first);
  string rest = described.slice(first + sep.len(), described.len());
  i32 second = rest.indexOf(sep);
  if (second < 0) { return Described(blocked, rest, ""); }
  return Described(blocked, rest.slice(0, second), rest.slice(second + sep.len(), rest.len()));
}

/**
 * A 64-bit FNV-1a over the pieces of a build, as sixteen hex digits.
 *
 * The same construction the host uses for `test_module_key` and `$WAC_COMPILER_ID`, so that a reader
 * comparing the two caches is comparing like with like. **64 bits and not `core/hash.wac`'s 32**: a
 * collision here does not lose a lookup, it serves a *different program's module*, and 32 bits is one
 * birthday away from that at a few tens of thousands of entries.
 */
struct Fnv {
  i64 h;
  Fnv start() { return Fnv(0xcbf29ce484222325); }
  void eat(this, string s) {
    u8[] b = s.toBytes();
    for (i32 i = 0; i < b.len(); i++) {
      this.h = this.h ^ (b[i] as i64);
      this.h = this.h * 0x100000001b3;
    }
    // A length after each piece, so that eating "ab" then "c" differs from "a" then "bc" — without it
    // two different file sets with the same concatenation share a key.
    this.h = this.h ^ (b.len() as i64);
    this.h = this.h * 0x100000001b3;
  }
  string hex(const this) {
    string out = "";
    for (i32 i = 15; i >= 0; i--) {
      i64 nib = (this.h >> ((i * 4) as i64)) & 15;
      i32 d = nib as! i32;
      out = out + "0123456789abcdef".slice(d, d + 1);
    }
    return out;
  }
}

/**
 * How many built artefacts to keep. See `sweepBuildCache` for why this is a number and not "plenty".
 *
 * `$WAC_BUILD_CACHE_KEEP` overrides it, which is the only way to test the bound: proving it evicts
 * otherwise costs sixty-five real builds of real programs, and a test that slow is a test nobody runs.
 * The same reason `$WAC_TESTMOD_DIR` exists on the host's side of this.
 */
/**
 * Whether to keep the generated test aggregate — `WAC_KEEP_AGGREGATE=1`.
 *
 * **Documented and not implemented, until now.** `docs/development.md` describes this variable and
 * three issues cite it as the way they measured something, but nothing in this program read it: the
 * flag belonged to the Rust host's `test`, and `issues/system/0257c` moved the command into the wac
 * program without it. What survived the move was neither behaviour — the aggregate was kept
 * unconditionally on every path but one, which is GitHub wac#27.
 *
 * Any non-empty value that is not `0` counts, because a caller who writes `WAC_KEEP_AGGREGATE=yes`
 * means yes, and a debugging switch that silently ignores its own value is worse than one that is
 * generous about it.
 */
bool keepAggregate(Env env) {
  u8[]? set = flatten(env.get("WAC_KEEP_AGGREGATE").wait()).orElse(null);
  if ((set is null) || set!.len() == 0) { return false; }
  return string.fromBytes(set!) != "0";
}

i32 keepBuilds(Env env) {
  u8[]? set = flatten(env.get("WAC_BUILD_CACHE_KEEP").wait()).orElse(null);
  if ((set is null) || set!.len() == 0) { return 64; }
  // `atoi` answers 0 for anything that is not a number, and 0 is a legitimate bound — "keep none" is
  // how a caller turns the cache off — so a malformed value is taken at its word rather than guessed at.
  return atoi(string.fromBytes(set!));
}

/**
 * Bound the build cache: keep the newest `keepBuilds()` entries and delete the rest.
 *
 * **A number with a reason.** These are whole programs rather than the test lane's aggregates — box's
 * shell is about a megabyte — so sixty-four is roughly 60 MB. `issues/system/0136` is the day this
 * filesystem filled and the reason an unbounded cache is not an option: a directory that only ever
 * grows is a disk that only ever shrinks.
 *
 * **Newest by write time, not by use.** The host's own module cache touches an entry when it hits, so
 * its bound is least-recently-*used*; there is no `utime` in this world, so this one is
 * least-recently-*written*. The difference would matter if the working set were near the bound — a
 * program built once and used daily would age out — and at sixty-four against the handful of
 * applications this repository builds, it is not near it. Worth knowing before raising the traffic.
 */
void sweepBuildCache(Env env, Files fs, string dir) {
  string[]? names = flatten(fs.readDir(dir).wait()).ok();
  if (names is null) { return; }
  i32 n = names!.len();
  i32 keep = keepBuilds(env);
  if (n <= keep) { return; }
  // Ages in the same order as the names, so the two can be sorted together.
  i64[] when = i64[].filled(n, 0);
  for (i32 i = 0; i < n; i++) {
    Stat? s = flatten(fs.stat("\{dir}/\{names![i]}").wait()).ok();
    when[i] = (s is not null) ? s!.modifiedMillis : (0 as i64);
  }
  // Selection sort, newest first: `n` is bounded by the entries in one directory and this runs only
  // on the write that crosses the bound, so the shape of the sort is not worth more than its clarity.
  for (i32 i = 0; i < n; i++) {
    i32 best = i;
    for (i32 j = i + 1; j < n; j++) { if (when[j] > when[best]) { best = j; } }
    if (best != i) {
      i64 tw = when[i]; when[i] = when[best]; when[best] = tw;
      string tn = names![i]; names![i] = names![best]; names![best] = tn;
    }
  }
  for (i32 i = keep; i < n; i++) { fs.remove("\{dir}/\{names![i]}", false).wait(); }
}

/**
 * Where this build's artefact would be cached, or `""` when it must not be.
 *
 * `issues/system/0204`. The key is everything that changes the bytes written: the compiler, the entry,
 * every source's content, the grants — they go *into* the manifest — and the output's base name, which
 * is in the manifest too, so two destinations are two artefacts.
 *
 * **`""` for anything that is not a plain build.** A coverage or traced build writes a table beside the
 * module that would have to be cached with it; `wac build` without `-o` writes elsewhere; and without
 * `$WAC_HOME` there is nowhere to put it. Each of those is a miss forever rather than a wrong hit.
 *
 * **The compiler's identity comes from the host** — a wac program cannot hash the seed it is running
 * inside. Absent it, this answers `""` rather than keying on nothing, because an entry that cannot say
 * which compiler made it is the stale hit this whole cache has to avoid.
 *
 * **`--no-cache` is neither read nor write**, and it exists because a build that has to prove something
 * about the compiler cannot be answered from disk. `packages/wacc/test/wac/selfhost_test.wac` builds
 * wacc twice and requires byte equality; served from cache that is one file compared with itself, which
 * `issues/system/0204` predicted before this cache existed and which measured 194 ms against a
 * documented 3 s once it did. `bootstrap.sh` has the same shape in its fixpoint loop, in the steady
 * state where consecutive rounds run the same compiler over the same sources.
 *
 * **And an unvalidated command line gets no hit.** The lookup happens above the dispatch, where the
 * sources are already gathered and the flags are not yet checked — so a hit used to return 0 before
 * `unknownFlag` ever ran, and `wac build --nonsense` succeeded silently on a warm cache while failing
 * correctly on a cold one. Refusing to key a command line the program has not accepted keeps the two
 * answers the same; the caller still gets the ordinary error, one compile later.
 */
string buildCachePath(string[] argv, Env env, i32 argc, string cmd, string entry, string[] paths, string[] texts, string stem, string target) {
  // **`test` is cacheable too, and keyed on what the caller named.** `issues/system/0204` gave the
  // native `wac test` a module cache and it lived in the host path only `run` reaches now — measured
  // after the move, `packages/box/test/wac` was 18s cold and 7s warm where a hit is about one.
  //
  // The key cannot use `entry`: for a directory that is the generated aggregate, whose *name* carries
  // the clock so two runs never collide, so every run would miss. `target` is what the caller typed
  // and is stable, and the aggregate's own text is in the key anyway through `texts` — so the same
  // directory with the same sources answers the same key, and one file changing changes it.
  if (cmd == "test") {
    if (target == "") { return ""; }
  } else if (cmd == "run") {
    // **`run` compiles and throws the module away, which is the one command that did it every time.**
    // Measured 2026-08-27: `wac run tools/wac/map.wac --check` was 1608, 1612, 1614 ms over three
    // consecutive runs — 1146 ms of that the compile, for sources that had not changed. It is also the
    // command tests reach for when they drive a tool, so the cost lands inside other people's runtimes:
    // `tools/wac/map_test.wac` was the most expensive doc check at 1777 ms and 73% of it was this.
    //
    // There is no stem to key on and none is needed: `run` writes no file, so the entry and the sources
    // are the whole of what decides the bytes.
  } else if (cmd == "app") {
    // **`app` caches, and its key is *smaller* than `build`'s.** `build` has to eat the output's base
    // name because that name goes into the manifest, so two destinations are two artefacts. `wac app`
    // takes its manifest name from the entry — `writeApp` uses `baseName(stem(entry))` — so the
    // destination never reaches the bytes, and two builds of one entry to two names are byte-identical.
    // Measured: 246065 bytes both. `issues/system/0283c`.
    //
    // The key below already says so, since only `build` eats `stem`. What was missing was this arm:
    // every `wac app` was a full compile, including the identical one a moment earlier — and that is
    // the command this repository distributes with and the one the suite now builds programs with.
    if (stem == "") { return ""; }
  } else if (cmd != "build" || stem == "") {
    return "";
  }
  if (hasFlag(argv, argc, "--coverage") || hasFlag(argv, argc, "--trace")) { return ""; }
  if (hasFlag(argv, argc, "--no-cache")) { return ""; }
  // **`run`'s flags stop at the entry.** `unknownFlag` scans the whole command line, which is right for
  // `build` and `test` and wrong here: everything after the entry is the *program's*. Asking the wide
  // question turned the cache off for exactly the invocations that most want it — measured, `wac run
  // p.wac` was 814 ms then 91 ms, and `wac run p.wac --check` was 803 ms then 822 ms, because `--check`
  // read as a flag this command does not have. The run arm below refuses a genuinely unknown flag
  // *before* the entry, with a message naming it, so nothing is let through by narrowing this.
  string unknown = unknownFlagFor(argv, argc, cmd);
  if (unknown != "") { return ""; }
  // **A bound of zero turns the cache off, lookup included.** Sweeping to nothing is not the same as
  // being off: entries written before still answer, so a caller who set this because they suspect a
  // stale hit would go on getting hits until the first build swept them away. Measured — a self-build
  // that should have recompiled came back in 160 ms with the bound at zero.
  if (keepBuilds(env) <= 0) { return ""; }
  string home = wacHomeOf(env);
  if (home == "") { return ""; }
  u8[]? id = flatten(env.get("WAC_COMPILER_ID").wait()).orElse(null);
  if ((id is null) || id!.len() == 0) { return ""; }

  Fnv h = Fnv.start();
  h.eat("wac-build 1");
  h.eat(string.fromBytes(id!));
  h.eat(cmd);
  h.eat(cmd == "test" ? target : entry);
  h.eat(cmd == "build" ? "\{baseName(stem)}.wasm" : "");
  // A bitmask, not a list — `grantsIn` answers the five bits that go into the manifest.
  //
  // **`run` counts only the grants written before the entry**, because that is what it obeys: a
  // `--allow-read` after the entry is one of the program's own arguments (`grantAfterEntry` refuses the
  // ambiguous spelling, and after `--` it is deliberate). Keying on `grantsIn` would let
  // `wac run p.wac -- --allow-net` and `wac run --allow-net p.wac` share an entry, and they must not.
  h.eat("\{cmd == "run" ? grantsBefore(argv, argc, entry) : grantsIn(argv, argc)}");
  for (i32 i = 0; i < paths.len(); i++) {
    // **The aggregate's path is replaced, its text is not.** It is `.cache/wac-aggregate-<clock>`,
    // different on every run and the same file every time; hashing the name would make the key
    // unrepeatable, and dropping the text would make it stand for less than it claims.
    h.eat(paths[i] == entry && cmd == "test" ? "<entry>" : paths[i]);
    h.eat(texts[i]);
  }
  return "\{home}/cache/build/\{h.hex()}.wasm";
}

/**
 * Each of `paths` as it was read, where `readPaths` has it, and as `texts` has it otherwise. A rewrite keeps lines
 * where they were — lowering is careful to — so a diagnostic's line and column still point into the text as read.
 * What a rewrite appended — a test's or a program's adapter — is kept after it, so a diagnostic in generated code
 * still shows the line it is about.
 */
string[] asWritten(string[] paths, string[] texts, string[] readPaths, string[] readTexts) {
  string[] out = string[].filled(paths.len(), "");
  for (i32 i = 0; i < paths.len(); i++) {
    out[i] = texts[i];
    for (i32 k = 0; k < readPaths.len(); k++) {
      if (readPaths[k] == paths[i]) { out[i] = readTexts[k] + appendedPast(texts[i], readTexts[k]); }
    }
  }
  return out;
}

/** The lines of `text` past as many as `read` has, starting on a line of their own. */
string appendedPast(string text, string read) {
  i32 lines = 0;
  for (i32 i = 0; i < read.len(); i++) { if (read.slice(i, i + 1) == "\n") { lines = lines + 1; } }
  i32 seen = 0;
  for (i32 i = 0; i < text.len(); i++) {
    if (text.slice(i, i + 1) != "\n") { continue; }
    seen = seen + 1;
    if (seen == lines) { return (read.len() > 0 && read.slice(read.len() - 1, read.len()) != "\n" ? "\n" : "") + text.slice(i + 1, text.len()); }
  }
  return "";
}

/**
 * A missing import rendered where it was written, or `""` when it cannot be located.
 *
 * `parts` is `key\tfrom\tspec` from `missingImportFilesIn`. The specifier is found in the importing
 * file's source **by string comparison** — quoted, so a word appearing in prose cannot match — and the
 * line and column come from counting to it. Nothing is resolved here, which is the whole reason this is
 * possible at all. `issues/lang/0157`.
 */
string positionedMissingImport(string parts, string[] paths, string[] texts) {
  string key = fieldOf(parts, 0);
  string from = fieldOf(parts, 1);
  string spec = fieldOf(parts, 2);
  if (key == "" || from == "" || spec == "") { return ""; }
  i32 at = -1;
  for (i32 i = 0; i < paths.len(); i++) { if (paths[i] == from) { at = i; } }
  if (at < 0) { return ""; }
  string src = texts[at];
  // Quoted, so `./b.wac` written in a comment above the import does not win the search.
  i32 hit = src.indexOf("\"\{spec}\"");
  if (hit < 0) { return ""; }
  i32 line = 1;
  i32 col = 1;
  for (i32 i = 0; i < hit; i++) {
    if (src.slice(i, i + 1) == "\n") { line = line + 1; col = 1; } else { col = col + 1; }
  }
  // The wire `render.wac` reads: file, line, col, phase, message, note, hint, width.
  string wire = "\{from}\t\{line}\t\{col}\tlink\t"
      + "no file was supplied at that path\t\{key}\t"
      + "supply the file, or check the path — `core` and `std` are the only trees that need none\t"
      + "\{spec.len() + 2}\n";
  return renderDiagnostics(wire, paths, texts);
}

/** One tab-separated field of `line`, or `""`. */
string fieldOf(string line, i32 n) {
  i32 seen = 0;
  string cur = "";
  for (i32 i = 0; i < line.len(); i++) {
    string ch = line.slice(i, i + 1);
    if (ch == "\t") {
      if (seen == n) { return cur; }
      seen = seen + 1;
      cur = "";
      continue;
    }
    cur = cur + ch;
  }
  return seen == n ? cur : "";
}

/** The arrays the API wants: exactly `n` long, since it walks their whole length. */
/**
 * What this compiler answers, as the reader sees it first.
 *
 * **Four commands and one flag were missing from it** — `bindgen`, `-o`, the grants and `--coverage` —
 * so the command that writes a host's glue was undiscoverable and every `build` needed a flag the
 * usage did not mention. `packages/wacc/test/wac/cli_test.wac` holds this against the dispatch and against
 * spec/cli/wac.md; the host adds its own commands after these, since each side lists what it
 * implements.
 */

string usage() {
  return "usage: wac check|compile|bindgen <entry.wac> [out]   # --js for bindgen's glue, --script without exports\n"
       + "       wac build <entry.wac> -o <stem> [--coverage|--trace [--trace-slots n]] [--quiet]\n"
       + "                [--allow-read] [--allow-write] [--allow-net] [--allow-env] [--allow-run]\n"
       + "       wac run [--allow-read] [--allow-write] [--allow-net] [--allow-env] [--allow-run]\n"
       + "                <entry.wac> [args…]   compile and run it, with no file in between;\n"
       + "                a grant goes before the entry, and after `--` an argument is the\n"
       + "                program's, whatever it looks like\n"
       + "       wac test [--allow-read] [--allow-write] [--allow-net] [--allow-env] [--allow-run]\n"
       // The flags this actually takes, which is what the native binary was printing *after* this
       // block because these two lines were narrower than the truth — so `wac --help` listed `run`
       // and `test` twice, with two different accounts of `test`. Reported against an external
       // project on 2026-08-25. One list, and it is this one.
       + "                [--coverage] [--filter <name>] [--ignore <path,…>] [--quiet] [path…]\n"
       + "                run `test*()` exports; paths may be files or directories\n"
       // **These two were the host's lines**, printed after this block by `native/v8/src/main.rs`
       // under `if SHELL.is_some()` and `if UPDATE.is_some()` — because they were payloads it
       // embedded and this program knew nothing about them. `issues/system/0257c` moved the
       // commands here, so the usage moves with them: one list, printed by whichever host runs
       // this, instead of a list that was right only on the binary that happened to carry them.
       + "       wac audit <entry.wac> [--verbose]   what each dependency can reach, and through\n"
       + "                what — wac has no ambient authority, so a file handed no capability has none\n"
       + "       wac sh  [--allow-read] [--allow-write] [--allow-net] [--allow-env] [--allow-run]\n"
       + "                [-c script]           the shell, sealed unless granted\n"
       // `sh-child` is named because the dispatcher accepts it, as the comment further down says every
       // command must be: it is what `wac sh` starts, holding only what was granted, and not for typing.
       + "       wac sh-child [-c script]       the shell itself, as `wac sh` runs it in a sealed child\n"
       + "       wac update [project]           resolve and fetch what wac.lock does not cover,\n"
       + "                and write the lock — the only command that reaches the network\n"
       // Printed by the host until 2026-08-26, appended after this block because the command lived
       // there. It is the program's now, so its line is too — `issues/system/0257c`.
       + "       wac task [name] [-- args…]     run a task from tasks.json5, or list them\n"
       + "       wac self install --from PATH   put that command under $WAC_HOME and on PATH\n"
       + "       wac self uninstall [--keep-cache]   take it away again\n"
       // Appended by the host after this block until 2026-08-26, because `app` was the host's
       // command and this program knew nothing about it. It is here now, and so is the command —
       // which is what makes this the whole list rather than most of it.
       + "       wac app [--allow-…] <entry.wac> -o <dest>   an executable that runs itself — one\n"
       + "                file, needing a `wac` on the machine that runs it\n"
       // **The five the dispatcher accepted and this did not name.** The comment above claimed this
       // was "the whole list rather than most of it" and it was short by `validate`, `app-run`,
       // `covdump`, `ctcompare` and `tracestat` — each with a usage string of its own, reachable,
       // and invisible to anyone reading `--help`. Reported as GitHub wac#29, which names two of
       // them; the other three came from asking the dispatcher instead of the report.
       //
       // `commandsdrift_test.wac` now derives the accepted set from this file and requires every one
       // to appear here, because a list maintained beside a dispatcher is a list that drifts — twice
       // already, per the two comments above about the host printing lines this block did not.
       + "       wac validate <module.wasm> […]   load each module and say whether the engine\n"
       + "                accepts it, without running anything\n"
       + "       wac covdump <module.wasm> [export|export:<cases>]…   the coverage a built module\n"
       + "                recorded; `wac tracestat <module.wasm>` is the same for a --trace build\n"
       + "       wac ctcompare <a.wasm> <b.wasm> [--all]   compare two builds for constant-time\n"
       + "                differences\n"
       // Named rather than hidden, and marked rather than advertised: it is a real command a reader
       // will meet in the first two lines of any `wac app` output, so leaving it out of the list
       // makes that file look like it calls something that does not exist.
       + "       wac app-run <file> [args…]     runs a `wac app` executable — normally invoked for\n"
       + "                you by the two lines at the top of one, rather than typed";
}

/**
 * The usage for one command, for when the command is known and its entry is not.
 *
 * `wac run` on its own used to print the whole block, which is four commands' worth of flags to
 * answer a question about one. The native binary already printed the single line; this is the same
 * line, so the two hosts agree on it — `commandparity_test.wac` has the case.
 */
string usageFor(string cmd) {
  if (cmd == "run") {
    return "usage: wac run [--allow-read] [--allow-write] [--allow-net] [--allow-env] "
         + "[--allow-run] <entry.wac> [args…]";
  }
  return usage();
}

/**
 * The arguments that are not flags: the entry, and for `compile` the output path after it.
 *
 * **The entry used to be whatever was at argument 1**, so `wac build --allow-read p.wac` answered
 * *cannot read --allow-read* — a sentence about a file, about a command line. `wac run` takes its
 * grants before the entry and this took them after, so the two commands excluded each other's order.
 * They overlap now: a flag is a flag wherever it is written, and the entry is the first thing that is
 * not one. `issues/system/0177`.
 *
 * `-o` is the one flag carrying a value, and skipping the flag without its value would leave the stem
 * looking like the entry — which is the same class of mistake one level along.
 */
/**
 * Every argument, in order, flags included.
 *
 * `positionals` drops flags, which is what the compiler's subcommands want and exactly wrong for
 * `sh`: the shell reads its own command line, and the `--allow-*` words in front of it have to be
 * counted rather than removed so the shell is told where its arguments begin.
 */
string[] allArgs(string[] argv, i32 argc) {
  string[] out = string[].filled(argc, "");
  for (i32 i = 0; i < argc; i++) { out[i] = argv[i]; }
  return out;
}

/**
 * Whether this flag is followed by a value rather than standing alone.
 *
 * **Skipping the flag without its value leaves the value looking like the entry.**
 * `--filter passes src/x_test.wac` reported *cannot read passes* — a sentence about a file, about a
 * pattern, which is `issues/system/0177`'s mistake one level along. Two things need the same answer
 * now: finding the positional arguments, and finding where a command's own flags stop.
 */
bool takesValue(string flag) {
  return flag == "-o" || flag == "--trace-slots" || flag == "--filter" || flag == "--ignore"
      || flag == "--from";
}

string[] positionals(string[] argv, i32 argc) {
  string[] out = string[].filled(argc, "");
  i32 n = 0;
  i32 i = 1;
  while (i < argc) {
    string a = argv[i];
    // **Three flags carry a value**, and skipping the flag without its value leaves the value looking
    // like the entry. `--filter passes src/x_test.wac` reported *cannot read passes* — a sentence
    // about a file, about a pattern — which is `issues/system/0177`'s mistake one level along.
    if (takesValue(a)) {
      i = i + 2;
      continue;
    }
    if (a.len() > 0 && a.slice(0, 1) == "-") { i = i + 1; continue; }
    out[n] = a;
    n = n + 1;
    i = i + 1;
  }
  return exactly(out, n);
}

/**
 * The grants a `build` was asked for, as the bitmask `platform.wac` uses.
 *
 * The same four flags `deno task app:native` takes, and they mean the same thing: whoever packages
 * the program chooses what it may do, and the person running it cannot quietly widen that. A flag
 * this does not recognise is not silently ignored — see `unknownFlag`.
 *
 * **From 1, not from 2.** Argument 1 was the entry by position, so nothing looked there for a flag —
 * and once the entry stopped being positional, a grant written first was read by nobody and the
 * artefact came out sealed with no complaint. Every scan below starts where the arguments start.
 */
i32 grantsIn(string[] argv, i32 argc) {
  i32 bits = 0;
  for (i32 i = 1; i < argc; i++) {
    string a = argv[i];
    if (a == "--allow-read") { bits = bits | 1; }
    if (a == "--allow-write") { bits = bits | 2; }
    if (a == "--allow-net") { bits = bits | 4; }
    if (a == "--allow-env") { bits = bits | 8; }
    // Running a host program — `Cli.exec`. Its own bit and its own grant, not `write`'s: a build
    // that may start a confined wasm module must be able to refuse a host binary without refusing
    // both. `issues/system/0165`.
    if (a == "--allow-run") { bits = bits | 16; }
  }
  return bits;
}

/** Whether an argument is there at all. */
bool hasFlag(string[] argv, i32 argc, string flag) {
  for (i32 i = 1; i < argc; i++) {
    if (argv[i] == flag) { return true; }
  }
  return false;
}

/** The first argument that looks like a flag and is not one, or "". */
/**
 * The flags a command takes, in the order its usage line names them.
 *
 * **One list per command, because the shared one was wrong in both directions.** Until 2026-08-29
 * `unknownFlag` held a single set — every `--allow-*`, `--quiet`, `--js`, `--coverage`, `--trace`,
 * `--trace-slots`, `--no-cache` — and two arms consulted it. So `wac app --coverage` was accepted and
 * came out instrumented with no table to read it (`issues/system/0274c`), and `wac check --nonsense`
 * exited **0**, because `check` never asked at all. Nine commands validated nothing.
 *
 * The table is shaped like `forCommand` in `grants.wac` deliberately: both answer a per-command
 * question about the command line, and having one of them be a table and the other a shared list is
 * how the two drift. This one is the flags; that one is the authority.
 *
 * **An empty list means the command takes no flags**, which is a real answer and not a gap — `wac
 * covdump` takes export names and `wac validate` takes modules. `run`, `task`, `sh` and `app-run`
 * have flags of their own *and* pass a tail to somebody else; `flagStop` is where that tail begins.
 */
string[] flagsFor(string cmd) {
  if (cmd == "build") {
    return [
                    "--allow-read", "--allow-write", "--allow-net", "--allow-env", "--allow-run",
                    "-o", "--quiet", "--coverage", "--trace", "--trace-slots", "--no-cache"
    ];
  }
  if (cmd == "test") {
    return [
                    "--allow-read", "--allow-write", "--allow-net", "--allow-env", "--allow-run",
                    // **`--quiet` rather than `--verbose`, since 2026-08-29.** A run says which
                    // tests it ran and how long each took, the way `deno test` and `cargo test` do;
                    // the flag is for the caller that wants only the tally, which is the suite.
                    "--coverage", "--filter", "--ignore", "--quiet"
    ];
  }
  // The grants and the destination, and nothing that needs a second command to finish — which is the
  // whole of `issues/system/0274c`.
  if (cmd == "app") {
    return [
                    "--allow-read", "--allow-write", "--allow-net", "--allow-env", "--allow-run",
                    "-o"
    ];
  }
  // The grants govern the *program* these two start rather than this process, which is why they are
  // the only flags either takes: everything else on the line belongs to whatever is being run.
  if (cmd == "run") {
    return ["--allow-read", "--allow-write", "--allow-net", "--allow-env", "--allow-run"];
  }
  if (cmd == "sh") {
    return [
                    "--allow-read", "--allow-write", "--allow-net", "--allow-env", "--allow-run",
                    "-c"
    ];
  }
  // `--js` asks for the glue rather than the bindings, so it is `bindgen`'s alone: on `check` or
  // `compile` it was accepted and read by nobody.
  if (cmd == "bindgen") { return ["--js", "--script", "--quiet"]; }
  if (cmd == "compile") { return ["--quiet"]; }
  if (cmd == "audit") { return ["--verbose"]; }
  if (cmd == "ctcompare") { return ["--all"]; }
  if (cmd == "self") { return ["--from", "--no-profile", "--keep-cache"]; }
  // `check` says one sentence about one file. `validate`, `covdump`, `tracestat`, `update`, `task`
  // and `app-run` take arguments and no flags.
  return string[].filled(0, "");
}

/**
 * Where a command's own arguments stop and somebody else's begin.
 *
 * **Four commands hand a tail on**, and scanning past it would report the *program's* flag as this
 * one's. `run` was the case that proved it: `unknownFlag` scanned the whole line, so `wac run p.wac
 * --check` read `--check` as a flag `run` does not have, which turned the build cache off for
 * exactly the invocations that most want it — 814 ms against 91. The rule is per command because the
 * boundary is: `run`'s tail starts at the entry, `sh`'s after `-c`, `task`'s at `--`, and
 * `app-run`'s after the file.
 */
i32 flagStop(string[] argv, i32 argc, string cmd) {
  if (cmd != "run" && cmd != "sh" && cmd != "task" && cmd != "app-run") { return argc; }
  i32 i = 1;
  while (i < argc) {
    string a = argv[i];
    // **`task` has two boundaries and needs both.** `--` is one, for the explicit form. The task
    // *name* is the other, and leaving it out broke `wac task gen:core --check` — a spelling
    // `CLAUDE.md` documents and the doc lane runs — by reading `--check` as a flag `wac task` does
    // not have. Everything after the name belongs to the command the task names, exactly as
    // everything after `run`'s entry belongs to the program.
    if (cmd == "task" && a == "--") { return i; }
    // The script and the module are the tail's first element rather than a flag's value, so the stop
    // is *after* them: `-c` and its script are both this command's, everything following is not.
    if (cmd == "sh" && a == "-c") { return i + 2 < argc ? i + 2 : argc; }
    if (takesValue(a)) { i = i + 2; continue; }
    if (a.len() > 0 && a.slice(0, 1) == "-") { i = i + 1; continue; }
    // The first argument that is not a flag: `run` and `app-run` take one and pass the rest on.
    return i + 1;
  }
  return argc;
}

/**
 * The first flag on the line that `cmd` does not take, or `""`.
 *
 * Reports the flag by name so the caller can say which one, and pairs with `flagsFor` for the *did
 * mean* half — a refusal that lists what the command does take is the difference between being told
 * no and being told where to go.
 */
string unknownFlagFor(string[] argv, i32 argc, string cmd) {
  string[] ok = flagsFor(cmd);
  i32 stop = flagStop(argv, argc, cmd);
  for (i32 i = 1; i < stop; i++) {
    string a = argv[i];
    if (a.len() < 1 || a.slice(0, 1) != "-") { continue; }
    // A negative number is an argument, not a flag: `-1` reaching this as an unknown flag would be a
    // refusal about arithmetic.
    if (a.len() > 1 && a.slice(1, 2) >= "0" && a.slice(1, 2) <= "9") { continue; }
    bool found = false;
    for (i32 j = 0; j < ok.len(); j++) { if (a == ok[j]) { found = true; } }
    if (!found) { return a; }
  }
  return "";
}

/**
 * The whole refusal for a flag `cmd` does not take.
 *
 * **A misspelt grant is a different mistake from an unknown flag**, and saying so is not `sh`'s
 * privilege. `wac sh --allow-everything` has always answered *is not a grant — read, write, net, env,
 * run*, because its own parser reads grant words; every other command answered *unknown flag*, which
 * is true and unhelpful — the reader mistyped one of five words, not one of eleven flags.
 *
 * The distinction is on the *word*, not on the command: `--allow-everything` is nobody's grant, while
 * `--allow-read` is a real one that `wac check` simply does not take, and those two want different
 * sentences.
 */
string flagRefusal(string cmd, string flag) {
  if (flag.len() > 8 && flag.slice(0, 8) == "--allow-" && !isGrantWord(flag)) {
    return "wac: '\{flag}' is not a grant — read, write, net, env, run";
  }
  return "wac: unknown flag '\{flag}' — \{flagsWord(cmd)}";
}

/** Whether this is one of the five grants, whatever command it was written on. */
bool isGrantWord(string flag) {
  return flag == "--allow-read" || flag == "--allow-write" || flag == "--allow-net"
      || flag == "--allow-env" || flag == "--allow-run";
}

/** What to print after naming a flag a command does not take. */
string flagsWord(string cmd) {
  string[] ok = flagsFor(cmd);
  if (ok.len() == 0) { return "`wac \{cmd}` takes no flags"; }
  string list = "";
  for (i32 i = 0; i < ok.len(); i++) { list = list + (list == "" ? "" : ", ") + ok[i]; }
  return "`wac \{cmd}` takes \{list}";
}

/**
 * The number after `--trace-slots`, or 0 for the compiler's own size.
 *
 * **A journal a caller can size is why this exists.** The default is 2^22 events, and a routine that
 * produces more cannot be checked for secret dependence at all — the routines that overflow being
 * exactly the ones designed to be expensive. A KDF's cost is the function rather than a parameter of
 * it: one bcrypt hash is 8.2 million events. `wac tracestat` reports what a run *wanted*, so the
 * second attempt is sized rather than doubled. `issues/lang/0059`.
 */
i32 traceSlots(string[] argv, i32 argc) {
  for (i32 i = 1; i + 1 < argc; i++) {
    if (argv[i] != "--trace-slots") { continue; }
    u8[] d = argv[i + 1].toBytes();
    if (d.len() == 0) { return 0; }
    i32 v = 0;
    for (i32 k = 0; k < d.len(); k++) {
      if (d[k] < 48 || d[k] > 57) { return 0; }
      v = v * 10 + (d[k] as i32 - 48);
    }
    return v;
  }
  return 0;
}

/** The value after `-o`, or "". */
string outStem(string[] argv, i32 argc) {
  for (i32 i = 1; i + 1 < argc; i++) {
    if (argv[i] == "-o") {
      return argv[i + 1];
    }
  }
  return "";
}

/** What the manifest calls the module it sits beside: the stem's own name, without its directory. */
string baseName(string path) {
  i32 at = -1;
  for (i32 i = 0; i < path.len(); i++) {
    if (path.slice(i, i + 1) == "/") { at = i; }
  }
  return at < 0 ? path : path.slice(at + 1, path.len());
}

/** `path.wac` without its extension, which is what the generated names are built on. */
string stem(string entry) {
  i32 n = entry.len();
  return n > 4 && entry.slice(n - 4, n) == ".wac" ? entry.slice(0, n - 4) : entry;
}

/** Several lines as one, for a warning that names them all. */
string oneLine(string text) {
  string out = "";
  for (i32 i = 0; i < text.len(); i++) {
    string ch = text.slice(i, i + 1);
    if (ch == "\n") {
      if (i + 1 < text.len()) { out = out + "; "; }
      continue;
    }
    out = out + ch;
  }
  return out;
}

/** `path.wac` becomes `path.wasm`; anything else gains `.wasm`. */
string wasmBeside(string entry) {
  i32 n = entry.len();
  if (n > 4 && entry.slice(n - 4, n) == ".wac") { return "\{entry.slice(0, n - 4)}.wasm"; }
  return "\{entry}.wasm";
}

/**
 * Store a built module under its key, if there is a key and it is worth storing.
 *
 * **Written beside and moved into place**, because three agents share this machine and a reader that
 * catches a half-written entry gets a truncated module rather than a miss. `rename` is atomic on
 * every filesystem this runs on — `std/platform.wac` says so where it explains why `rename` is in
 * the same tier as `writeFile` — so a concurrent build sees the old entry or the new one and never
 * part of either.
 *
 * `distinct` is the temporary name's disambiguator, since this world has no pid: two builds racing on
 * one key are building the same program, and what distinguishes them is where each was asked to put
 * it. For `build` that is the output stem; for `test` there is no output, and the aggregate's own
 * path serves — it carries the clock, so no two runs share one.
 *
 * A failure to store is not a failure to build: the artefact the caller asked for is already made,
 * and the next run simply compiles again. Nothing here reports.
 */
void rememberBuild(Env env, Files fs, string cachePath, u8[] whole, string distinct) {
  if (cachePath == "") { return; }
  string cacheDir = dirOf(cachePath);
  fs.mkdir(cacheDir, true).wait();
  Fnv u = Fnv.start();
  u.eat(distinct);
  string tmp = "\{cachePath}.tmp\{u.hex()}";
  auto wroteTmp = flatten(fs.writeFile(tmp, whole).wait());
  if (wroteTmp.isOk()) {
    auto moved = flatten(fs.rename(tmp, cachePath).wait());
    if (moved.isErr()) { fs.remove(tmp, false).wait(); }
  }
  sweepBuildCache(env, fs, cacheDir);
}

export async i32 main(Sys sys) {
  string[] argv = sys.args();
  Input stdin = sys.stdin();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Clock clock = sys.clock();
  Random rnd = sys.random();
  Env env = sys.env();
  Files fs = sys.files();
  Net net = sys.net();
  Procs procs = sys.procs();
  Modules mods = sys.modules();
  // Everything this program holds — what `run`, `test` and the counters commands hand on from, and never
  // more than: each takes what a manifest or a flag asks for out of this.
  Authority held = Authority(fs, net, env, procs);
  i32 argc = argv.len();
  if (argc < 1) {
    err.line(usage());
    return 2;
  }
  string cmd = argv[0];

  // **Asking for help is not an error.** The native binary used to translate this on the way out —
  // it ran the program for its usage block and then exited 0 if the caller had said `--help`, because
  // the program had no way to tell it apart from a mistake. With the binary handing every argument
  // over unchanged, the distinction is this program's to make, and it is the same one every tool
  // makes: a usage block somebody asked for is the answer, and the same block at somebody who
  // mistyped is a refusal. spec/cli/wac.md `[§wac-cli-usage-3nkq8wj]`.
  if (cmd == "--help" || cmd == "-h" || cmd == "help") {
    err.line(usage());
    return 0;
  }

  // **A module is a program, and that is decided by what the first argument *is*.** `wac prog.wasm`
  // is the most basic thing this command does and it worked only on the native binary until
  // 2026-08-22 — the other two printed the usage block at somebody holding a built program.
  // `issues/system/0230a`: the hosts should differ in what they are, not in what they answer.
  //
  // Before the command check on purpose, exactly as the native binary orders it: a name ending in
  // `.wasm` is a program *claim* whether or not the file is there, so a mistyped path is reported as
  // a missing file rather than reaching the compiler and coming back as "unknown command
  // 'prog.wasm'" — a message about the wrong thing entirely.
  if (cmd.len() > 5 && cmd.slice(cmd.len() - 5, cmd.len()) == ".wasm") {
    return await runModule(argv, err, fs, net, env, procs, argc, cmd);
  }

  // **The commands that validated nothing at all.** `build`, `app`, `run` and `test` each check their
  // own flags further down, at the point they have the entry; these nine had no check anywhere, so
  // `wac check --nonsense x.wac` exited **0** and `wac audit --js` was read by nobody.
  //
  // Here rather than in each arm because there is nothing to wait for: none of them needs the entry
  // resolved to know what flags it takes. And it is gated on a *known command* so that ordering stays
  // right — `wac frobnicate --x` is an unknown command, and reporting the flag first would answer the
  // second question.
  if (cmd == "check" || cmd == "compile" || cmd == "bindgen" || cmd == "audit"
      || cmd == "validate" || cmd == "covdump" || cmd == "tracestat" || cmd == "ctcompare"
      || cmd == "update" || cmd == "task" || cmd == "app-run" || cmd == "self"
      || cmd == "sh") {
    string early = unknownFlagFor(argv, argc, cmd);
    if (early != "") {
      err.line(flagRefusal(cmd, early));
      return 2;
    }
  }

  // **`validate` needs the engine and nothing else**, so it is up here with the other two commands
  // that skip the compile. It was the host's until 2026-08-26 for want of `Cli.validated`, which is
  // the one thing about a module only a host can answer — see that field's note. The command around
  // it is a loop and a count, which is what a command is.
  if (cmd == "validate") {
    if (argc < 2) {
      err.line("usage: wac validate <module.wasm> […]");
      return 2;
    }
    i32 bad = 0;
    for (i32 i = 1; i < argc; i++) {
      string path = argv[i];
      auto fRead = await fs.readFile(path);
      u8[]? f = fRead.ok();
      if (f is null) {
        // **Unreadable counts as rejected**, so one missing path does not hide the verdict on the
        // others — the caller asked about a list and gets an answer about the whole list.
        out.line("unreadable " + path + " — " + reason(fRead.err()!));
        bad = bad + 1;
        continue;
      }
      if (mods.validate(f!).isErr()) {
        out.line("rejected \{path}");
        bad = bad + 1;
      }
    }
    out.line("\{argc - 1} module(s): \{bad} rejected");
    return bad > 0 ? 1 : 0;
  }

  // **`app-run` needs no compiler and asks for none**, which is why it is up here with the module
  // case rather than below the shared compile: the module it runs is already built and glued to the
  // end of the file it was pointed at. A build of this program carrying only a shell can still run a
  // `wac app` executable, and that was true when the command lived in the host too.
  if (cmd == "app-run") {
    if (argc < 2) {
      err.line("usage: wac app-run <file> [args…]");
      err.line("       normally run for you by the first two lines of a `wac app` executable");
      return 2;
    }
    string appPath = argv[1];
    // Argument 0 for the program is the first thing after the file, exactly as `run` counts: the
    // artefact's own path is how it was found, not something it was told.
    string[] rest = string[].filled(argc - 2 < 0 ? 0 : argc - 2, "");
    for (i32 i = 2; i < argc; i++) { rest[i - 2] = argv[i]; }
    return await appRun(err, env, fs, net, procs, argc, appPath, rest);
  }

  // **The shell and the fetcher, in this program rather than beside it.** `issues/system/0257c`:
  // these were separate payloads the native binary embedded, so `wac sh` and `wac update` were
  // things only that host had — not because a host is required to implement them, but because the
  // command was three modules and the other hosts carried one. Dispatched here they are neither.
  //
  // `shellMain`'s last argument is where in argv to start, which is why this costs three lines: the
  // shell was already written to be someone else's subcommand. `wireBox` is what the
  // native ships — the shell with box's applets — and are the reason this pulls in a large graph.
  // **Sealed unless the command line asks, which is `run_shell`'s rule moved into the program.**
  // `packages/wac/src/grants.wac` says why at length; the short version is that a callee shares its
  // caller's capabilities, so a shell dispatched in here would inherit whatever the *compiler* was
  // granted. So the shell runs as a child of this program, handed exactly what was asked for — the host
  // enforces it — and it cannot widen: what it is handed is what this program holds.
  if (cmd == "sh") {
    Parsed p = askedFrom(argv, 1);
    if (p.bad != "") {
      err.line("wac: \{p.bad} is not a grant — read, write, net, env, run");
      return 2;
    }
    string[] childArgs = string[].filled(argc - p.at + 1, "");
    childArgs[0] = "sh-child";
    for (i32 i = p.at; i < argc; i++) { childArgs[i - p.at + 1] = argv[i]; }
    match (await procs.spawnSelf(childArgs, authorityOf(p.asked, fs, net, env, procs), Launch("", true, true, false))) {
      Ok(kid): { return (await kid.exit()).orElse(1); }
      Err(e): {
        err.line("wac: the shell would not start — \{e}");
        return 1;
      }
    }
  }
  // **The shell itself, in the child `wac sh` started** — over exactly the handles it was handed. Its files
  // are the host's under those grants, and with none a path answers *Not granted*, as the native binary's
  // sealed shell always has. The applets run in process: spawning one would re-enter this dispatcher,
  // which is not multi-call, so a stage would arrive here as a command.
  if (cmd == "sh-child") {
    Shell sh = Shell.create(sys);
    wireBox(sh, sys.random());
    return await shellMain(argv, sh, 1);
  }
  // `$WAC_HOME` rather than `fetch.wac`'s own `.wac` default: the compiler reads the cache from
  // there, so defaulting to a relative directory puts a fetched tree where nothing looks for it —
  // `wac update` says *1 fetched* and `wac run` says *not in the cache*, both truthfully.
  // **`ctcompare`, the last row of `issues/system/0257c`'s table.** Two traced runs and where they
  // first differ — the comparison happens where the modules are, because a real journal is about 1.6
  // million events for `x25519Base` and shipping both out as text to learn one number costs tens of
  // megabytes. `packages/wac/src/counters.wac` has the reading and the comparing.
  if (cmd == "ctcompare") {
    bool all = false;
    string[] both = string[].filled(2, "");
    i32 seen = 0;
    for (i32 i = 1; i < argc; i++) {
      string a = argv[i];
      if (a == "--all") { all = true; continue; }
      // Any other `--` word is a flag this command does not have, and saying so beats reading it as a
      // path and reporting that a file called `--vebose` cannot be read.
      if (a.len() > 2 && a.slice(0, 2) == "--") {
        err.line(flagRefusal("ctcompare", a));
        return 2;
      }
      if (seen < 2) { both[seen] = a; }
      seen = seen + 1;
    }
    if (seen < 2) {
      err.line("usage: wac ctcompare [--all] <a.wasm> <b.wasm>");
      return 2;
    }
    // **Both journals folded first, and read only if the folds disagree.** A `Cli.call` carries one
    // `i32` and costs ~1.6µs, so fetching `p256PublicKey`'s 8.19 million events a slot at a time was
    // 13s a comparison and `constanttime_test.wac` makes about sixteen — most of the suite's critical
    // path, twice over, to print one line saying nothing had changed. `digest` asks the module to fold
    // its own journal: four calls, whatever it recorded.
    //
    // The fold is a hash, so agreement is a 2^-32 coincidence away from being wrong, and that is
    // stated where it is decided — `emitCoverageHelpers` in `packages/wacc/src/emit.wac`. Every
    // *divergence* is still read out slot by slot below, which is the half a caller acts on.
    Digest da = await digest(argv, fs, mods, held, both[0]);
    if (da.error != "") { err.line("wac: \{da.error}"); return 1; }
    Digest db = await digest(argv, fs, mods, held, both[1]);
    if (db.error != "") { err.line("wac: \{db.error}"); return 1; }
    if (da.used == db.used && da.want == db.want && da.hash == db.hash) {
      out.line(agreeLine(da.used, da.want, db.used, db.want));
      return 0;
    }

    Exercise[] none = Exercise[].filled(0, Exercise("", 0 - 1));
    Counters ca = await read(argv, fs, mods, held, both[0], none, true);
    if (ca.error != "") { err.line("wac: \{ca.error}"); return 1; }
    Counters cb = await read(argv, fs, mods, held, both[1], none, true);
    if (cb.error != "") { err.line("wac: \{cb.error}"); return 1; }
    if (ca.values.len() < 2 || cb.values.len() < 2) {
      err.line("wac: a journal is at least two slots; got \{ca.values.len()}" +
                " and \{cb.values.len()}");
      return 1;
    }
    string[] lines = compareJournals(ca.values, cb.values, all);
    for (i32 i = 0; i < lines.len(); i++) { out.line(lines[i]); }
    return 0;
  }

  // **`covdump`, moved out of the host** for `issues/system/0257c`'s reason: reading a counter table
  // is a command, not the engine running a module. `<index>\t<count>` per counter and then how many —
  // per counter in index order, because that is what the table is keyed by: `covTableFiles`' `i`th row
  // describes counter `i`, and a test asserting "the loop ran three times" needs the pair. The
  // aggregated report `--coverage` prints answers a different question and cannot say how often.
  //
  // Written once before `issues/system/0263c` was found and reverted, because a loaded module could not
  // use `Cli` at all: this command runs a module *with its declared world*, so it was the first thing to
  // notice. That is fixed, and this is the same thirty lines.
  if (cmd == "covdump") {
    if (argc < 2) {
      err.line("usage: wac covdump <module.wasm> [export|export:<cases>]…");
      return 2;
    }
    // **Parsed before anything runs, so a bad count is a usage error rather than a missing export.**
    // Left to the call, `sweep:many` comes back as "no export named sweep:many" — a message about the
    // module, naming a fault in the command line.
    Exercise[] also = Exercise[].filled(argc, Exercise("", 0 - 1));
    i32 n = 0;
    for (i32 i = 2; i < argc; i++) {
      string a = argv[i];
      i32 colon = a.indexOf(":");
      if (colon < 0) { also[n] = Exercise(a, 0 - 1); n = n + 1; continue; }
      string count = a.slice(colon + 1, a.len());
      i32 cases = atoi(count);
      // `atoi` answers 0 for anything it cannot read, and 0 is also a count nobody can mean — a sweep
      // of no cases calls nothing — so one test covers both.
      if (cases <= 0) {
        err.line("wac: \{a} — `\{count}` is not a case count; a sweep is " +
                  "`name:<n>` for some n above zero");
        return 2;
      }
      also[n] = Exercise(a.slice(0, colon), cases);
      n = n + 1;
    }
    Exercise[] asked = Exercise[].filled(n, Exercise("", 0 - 1));
    asked.copyFrom(also, 0, 0, n);

    Counters c = await read(argv, fs, mods, held, argv[1], asked, false);
    if (c.error != "") { err.line("wac: \{c.error}"); return 1; }
    for (i32 i = 0; i < c.values.len(); i++) {
      out.line("\{i}\t\{c.values.get(i)}");
    }
    out.line("\{c.values.len()} counter(s)");
    // **After the table, and it does not change the status.** A mistyped export is worth saying and
    // the counters that were collected are still the answer; the run printed a table, which is what
    // this command was asked for.
    for (i32 i = 0; i < c.missing.len(); i++) {
      err.line("wac: the module exports no \{c.missing.get(i)}");
    }
    return 0;
  }

  // **`tracestat`, moved out of the host.** `issues/system/0257c`'s rule: a host may implement
  // running a module and must not implement the command surface. Reading a journal's size is a
  // command — `native/v8/src/main.rs` did it by instantiating the module by hand through V8, a second
  // engine driver beside the one the program already goes through.
  //
  // `events` is what was recorded, `wanted` is what happened whether or not there was room, and
  // `slots` is the room there was. They differ exactly when the journal overflowed, and `wanted` is
  // the number to pass to `--trace-slots` to make the next run fit — which is why it is reported
  // rather than left for a caller to double and try again.
  if (cmd == "tracestat") {
    if (argc < 2) {
      err.line("usage: wac tracestat <module.wasm>");
      return 2;
    }
    Counters c = await read(argv, fs, mods, held, argv[1], Exercise[].filled(0, Exercise("", 0 - 1)), false);
    if (c.error != "") { err.line("wac: \{c.error}"); return 1; }
    if (c.values.len() < 2) {
      err.line("wac: a journal is at least two slots; got \{c.values.len()}");
      return 1;
    }
    i32 cursor = c.values.get(0);
    out.line("events \{(cursor > 0 ? cursor : 0) / 2}" +
             " wanted \{c.values.get(c.values.len() - 1)}" +
             " slots \{c.values.len()}");
    return 0;
  }

  // **`wac task` — the named commands in `tasks.json5`.** What `deno task` was, without needing a
  // JavaScript host to look a name up in a table. `packages/wac/src/tasks.wac` says why, and why the
  // grants are one set rather than seventy-eight.
  if (cmd == "task") {
    u8[]? f = (await fs.readFile(tasksFile())).ok();
    if (f is null) {
      err.line("wac: no \{tasksFile()} here — `wac task` runs the named commands a project "
                + "keeps in one, and this directory has none");
      return 1;
    }
    Task[] tasks = tasksIn(f!);
    if (tasks.len() == 0) {
      err.line("wac: \{tasksFile()} has no tasks in it, or does not parse");
      return 1;
    }
    // **No name lists them**, which is what `deno task` did and what 942 references in this tree have
    // trained everyone to expect.
    if (argc < 2) {
      out.line("usage: wac task <name>\n\n\{listing(tasks)}");
      return 0;
    }
    string want = argv[1];
    if (!hasTask(tasks, want)) {
      string near = nearest(tasks, want);
      err.line("wac: no task `" + want + "` in " + tasksFile()
                + (near == "" ? " — `wac task` lists them" : " — did you mean `\{near}`?"));
      return 1;
    }
    // Handed to the shell this program already carries, with the arguments after the name appended so
    // `wac task test packages/json` reaches the runner the way `wac task test packages/json` did.
    string line = commandOf(tasks, want);
    for (i32 i = 2; i < argc; i++) {
      line = line + " '\{argv[i]}'";
    }
    // **`execWith(..., inherit)` rather than `exec`.** A task's output belongs on the terminal as it
    // happens: `wac task test` is a four-minute suite, and `exec` buffers, so the first version of
    // this ran everything correctly and printed nothing at all — `wac task map` exited 0 in silence
    // and looked like it had worked. Inheriting costs the capture, which a task runner has no use
    // for; the status is what it reports on.
    auto ran = await procs.exec("/bin/sh", ["-c", line], u8[](), ChildEnv.inherited(), Launch("", true, true, false));
    Exec? r = ran.ok();
    if (r is null) {
      err.line("wac: task `\{want}` did not start — \{ran.err()!}");
      return 1;
    }
    return r!.status;
  }

  if (cmd == "self") { return selfCommand(argv, err, out, env, filesFor(fs, forCommand(Command.Self)), argc); }

  if (cmd == "update") {
    // **A bare `update` means the project you are in, not the directory you are in.** Every other
    // project-aware command discovers it — `wac check main.wac` from `src/` finds the manifest one
    // level up, because `projectRootAbs` walks to the nearest ancestor holding one. `update` alone
    // read `.` literally and answered *"wac.json5 could not be read, so . is not a project"* from a
    // directory whose project the command beside it had just found. GitHub wac#30.
    //
    // The same walk rather than a second one: it already stops at the filesystem root for an
    // absolute path, and resolving the working directory first is what makes the boundary absolute.
    // An explicitly named project keeps its exact meaning — `wac update ..` still means `..`, and a
    // path that is not a project still says so, which is the diagnostic somebody may be relying on.
    string dir = ".";
    if (argc > 1) {
      dir = argv[1];
    } else {
      string here = normalisePath((await env.cwd()).orElse("."));
      // A *file* in it: `candidateRoots` starts from the directory holding what it is given, so `.` would
      // skip this directory's own manifest.
      string found = await projectRootAbs(fs, here, "./x.wac");
      // Empty means no manifest anywhere above, and then `.` is the right thing to report on: the
      // message names what the user is in rather than a root that was never found.
      if (found != "") { dir = found; }
    }
    string home = argc > 2 ? argv[2] : wacHomeOf(env);
    if (home == "") {
      err.line("wac: neither WAC_HOME nor HOME is set, so there is nowhere to cache a fetch");
      return 2;
    }
    return fetchAll(err, out, clock, rnd, env, fs, net, dir, home);
  }


  // **After the module check, because a module is a complete invocation on its own.** This guard was
  // first, so `wac prog.wasm` — one argument — printed the usage block without ever looking at what
  // that argument was. The command is known even when nothing else is, so say what *it* takes — and
  // an unknown one is named rather than answered with the usage block (spec ch45).
  bool knownCmd = cmd == "check" || cmd == "compile" || cmd == "build" || cmd == "bindgen" || cmd == "run"
      || cmd == "test" || cmd == "app" || cmd == "audit";
  if (argc < 2 && !knownCmd) {
    err.line(unknownCommand(cmd));
    return 2;
  }
  // `wac check` alone checks the project it is run in (spec ch06) — it needs no path.
  if (argc < 2 && cmd != "check") {
    err.line(usageFor(cmd));
    return 2;
  }
  // **Normalised once, here, because every later use has to agree with every other.** The map is
  // keyed by resolved paths and `resolveFrom` collapses `.` and `..`; the entry reached
  // `diagnoseGraphRendered` and the emitter as typed, so `wac test ./a/b.wac` built a map keyed
  // `a/b.wac` and then asked about `./a/b.wac` — "an import of a file that was not supplied", about
  // a file that was. `issues/lang/0134`.
  //
  // A leading `./` is what tab completion produces, so the spelling most likely to be typed was the
  // one that did not work.
  string[] pos = positionals(argv, argc);
  // **The command is checked before the entry is read.** This test used to sit after the graph was
  // gathered and the diagnostics printed, so a line with two mistakes in it was answered about the
  // wrong one: `wacc chekc nope.wac` reported *cannot read nope.wac* and exited 1, diagnosing the
  // typo you did not make and giving a compile-failure code for a usage mistake. Whether a usage
  // error is reported as one should not depend on an unrelated path happening to exist.
  // An unknown command is named even with nothing after it — `wac frobnicate` is a typo, not a
  // request for the usage block.
  if (cmd != "check" && cmd != "compile" && cmd != "build" && cmd != "bindgen" && cmd != "run"
      && cmd != "test" && cmd != "app" && cmd != "audit") {
    err.line(unknownCommand(cmd));
    return 2;
  }
  if (pos.len() < 1 && cmd != "check") {
    err.line(usageFor(cmd));
    return 2;
  }
  string entry = pos.len() > 0 ? normalisePath(pos[0]) : "";

  // **A second path is refused rather than dropped.** `wac test a_test.wac b_test.wac` ran only the
  // first and reported `2 passed` over it, and `wac check ok.wac broken.wac` printed "no
  // diagnostics" and exited 0 while never opening the second file. A caller building a list of
  // files gets a green run covering a fraction of them, which reads exactly like a real one — the
  // failure mode where silence and success are the same output.
  //
  // Only these four. `run` takes its trailing positionals as the program's own arguments, and
  // `bindgen` takes an output path as the second, so both are refusing something they mean.
  // **`test` is not in this list, and that is the point of `issues/system/0272b`.** It documents the
  // plural — `wac test [path…]` — and a caller that has one exists: `tools/runTests.wac` chunks a
  // large directory into lists of twelve and hands each list to one run. Refusing the list made the
  // old silent wrong answer loud, which was worth doing, but the answer it should give is every path.
  // `testTargets` is where the list becomes a walk.
  if ((cmd == "build" || cmd == "audit") && pos.len() > 1) {
    err.line("wac \{cmd}: takes one path, given \{pos.len()} — `\{pos[0]}"
              + "` and `\{pos[1]}`. Run it once per path, or name a directory.");
    return 2;
  }



  // **The command narrows itself to what it needs.** `packages/wac/src/grants.wac` says why at
  // length: unifying the commands unified their grants, so the seed is built with `--allow-net`
  // because `wac update` clones, and every `wac check` was running inside a program that could open
  // a socket. Rebinding `cli` here means every path below this line — the graph walk, the emitter's
  // I/O, the cache, the test runner — sees only the narrowed one, rather than each having to
  // remember.
  //
  // `run` and `test` are unchanged by this: their flags grant the program they *start*, and a child
  // cannot be handed what its parent does not hold.
  // A word with no command is refused here rather than handed every grant (issue 0337a).
  Command? known = commandNamed(cmd);
  if (known is null) {
    err.line(unknownCommand(cmd));
    return 2;
  }
  // **Each command holds what `forCommand` says and no more**: its files narrowed to that, and the other
  // handles passed only to the commands that use them.
  fs = filesFor(fs, forCommand(known!));

  if (cmd == "check") {
    string[] given = string[].filled(pos.len(), "");
    for (i32 i = 0; i < pos.len(); i++) { given[i] = normalisePath(pos[i]); }
    return await checkCommand(err, out, env, fs, given);
  }

  // **A directory becomes one generated entry, before anything is compiled.** `wac test <dir>` walks
  // for `*_test.wac` and writes an aggregate that imports every one of them and re-exports its tests;
  // from here down the command is the single-file command, compiling that file. `issues/system/0192`
  // is why one build rather than one per file: `packages/box`'s sixteen files were 40.9s as sixteen
  // builds and 11.1s as one, and the difference is all compilation.
  //
  // The walk is not a *test* of anything, so a directory with no `*_test.wac` in it says so here
  // rather than failing to read a file nobody named.
  string[] walked = string[].filled(0, "");
  // **What the caller typed**, kept because `entry` is about to stop being it: a directory target is
  // rewritten to the generated aggregate, and a message naming that names a file nobody asked about.
  string target = entry;
  // The aggregate this run generated, or "" — the one thing that has to be cleaned up on every way
  // out of this function. See where it is removed, below `gather`. GitHub wac#27.
  string generated = "";
  // How many the `--ignore` list took out, which the summary reports: "there were none" and "you
  // excluded them all" are different answers to the same count.
  i32 ignoredCount = 0;
  // **A named file is not a way around `--ignore`.** The walk below is where the exclusion list is
  // applied, and one file that is not a directory does not go through it — so
  // `wac test --ignore a_test.wac a_test.wac` ran the file, contradicting the sentence above it. A
  // caller building a target list and an ignore list from one source must get the same answer for a
  // file as for the directory holding it; the alternative is an exclusion that works or not depending
  // on how the caller happened to spell the target.
  bool severalOrDir = cmd == "test" && (pos.len() > 1 || (await isDirAt(fs, entry)));
  if (cmd == "test" && !severalOrDir
      && withoutIgnored([entry], flagValue(argv, argc, "--ignore")).len() == 0) {
    // The walk's own spelling for a run that excluded everything, in the one-file shape: `0 ok`
    // rather than nothing at all, because "excluded" and "no tests here" are different answers and
    // the exit code cannot tell them apart.
    out.line("1 file: 0 ok, 1 not run (--ignore)");
    return 0;
  }
  if (severalOrDir) {
    string[] asked = string[].filled(pos.len(), "");
    for (i32 i = 0; i < pos.len(); i++) { asked[i] = normalisePath(pos[i]); }
    string[] found = await testTargets(fs, asked);
    walked = withoutIgnored(found, flagValue(argv, argc, "--ignore"));
    ignoredCount = found.len() - walked.len();
    if (walked.len() == 0) {
      // **Said differently when `--ignore` is what emptied it.** "No tests under src" is a wrong
      // answer when there were some and this run excluded every one, and it sends the reader looking
      // for a naming mistake that is not there. The native command's distinction, and its wording.
      if (ignoredCount > 0) {
        err.line("wac: --ignore excluded all \{ignoredCount} test file(s) under \{entry}");
      } else {
        err.line("wac: no tests under "
                  + (pos.len() == 1 ? entry : "\{pos.len()} path(s), the first being \{entry}")
                  + " — a test file is named `*_test.wac` and exports "
                  + "`test*()` answering a string, empty for a pass");
      }
      return 1;
    }
    string aggregate = "";
    string[] texts = string[].filled(walked.len(), "");
    // **Serial on purpose, and measured rather than assumed.** Every read here is independent, so this
    // loop reads like the obvious place to launch them all and collect afterwards — `Pending` starts
    // the work when it is made, so it would not even need `async`. Measured over
    // `packages/box/test/wac`: 37 files, 303 KB, **5.5 ms**, against about 21 s for the `wac test` run
    // that follows. Concurrency here buys 0.026% of the command, and costs a second array and a second
    // loop to say the same thing. If you are here to make this concurrent, measure the walk you have
    // rather than this one — the number that would justify it is minutes, not milliseconds.
    for (i32 i = 0; i < walked.len(); i++) {
      auto oneRead = flatten(fs.readFile(walked[i]).wait());
      u8[]? one = oneRead.ok();
      if (one is null) {
        err.line("wac: cannot read \{walked[i]} — \{oneRead.isErr() ? "\{oneRead.err()!}" : ""}");
        return 1;
      }
      texts[i] = string.fromBytes(one!);
    }
    // **Two places the aggregate can live, and the imports it carries decide which.**
    //
    // `.cache/` is the ordinary one: the file is scratch, it is already ignored, and every import is
    // `../` and then the path as the project spells it. That needs the walked files to be *under* the
    // project, and a directory somewhere else has no relative name from `.cache/` — an absolute import
    // is read relative to the importer, so there is nothing to emit. `wac test /tmp/somewhere` was
    // refused for that reason once `test` became the program's, and it had worked before, because the
    // host built its aggregate in a temporary directory of its own. `beside` is the way back: put the
    // aggregate *in* the walked directory, where every file the walk found is at or below it and the
    // `../` is not needed at all.
    string up = "../";
    string[] imports = importable(env, walked);
    // **Files in a project of their own go `beside` too.** A directory with its own `wac.json5` is a
    // project nothing outside it may reach into, so an aggregate in this project's `.cache/` importing
    // `packages/web/test/wac/page_test.wac` was refused — *reaches a file inside the nested project*
    // — and the suite, which runs `wac test` from the repository's root, could not run that package's
    // tests at all. Written beside them, the aggregate is inside their project and imports them there.
    if (imports.len() > 0 && walked.len() > 0) {
      Files tfs = fs;
      string here = normalisePath(flatten(env.cwd().wait()).unwrap());
      string theirs = await projectRootAbs(tfs, here, walked[0]);
      // `./x.wac`, not `.`: the search starts from the directory holding the path it is given, and `.`
      // skipped this project's own manifest — every project with one looked like a stranger to its own
      // tests, and the aggregate went beside them (`aggregate_test.wac`).
      if (theirs != await projectRootAbs(tfs, here, "./x.wac")) { imports = string[](); }
    }
    if (imports.len() == 0) {
      // **`beside` needs one directory, and several paths do not name one.** One target *is* the
      // directory that was walked; several have to be asked for the deepest directory they are all
      // at or below. Two unrelated trees have none, and that is refused rather than guessed at —
      // picking the first would emit `../` imports from a place the caller did not name.
      string dir = pos.len() == 1 ? noTrailingSlash(entry) : commonDir(walked);
      if (dir == "") {
        err.line("wac test: several paths outside this project with no directory above them all — "
                  + "the aggregate has nowhere to go. Run one path, or a directory holding them.");
        return 1;
      }
      imports = beside(dir, walked);
      up = "";
      aggregate = dir == "" ? baseName(aggregatePath(clock, fs)) : "\{dir}/\{baseName(aggregatePath(clock, fs))}";
    } else {
      // **`.cache/` is made, not assumed.** A fresh project has never built anything, so the directory
      // the aggregate goes in does not exist and `writeFile` answered "No such file or directory" —
      // naming a path the caller had not chosen, for a file they did not know existed. Reported against
      // an external project on 2026-08-25.
      auto made = flatten(fs.mkdir(".cache", true).wait());
      if (made.isErr()) {
        err.line("wac: cannot make .cache for the test aggregate — \{made.isErr() ? "\{made.err()!}" : ""}");
        return 1;
      }
      aggregate = aggregatePath(clock, fs);
    }
    auto wrote = flatten(fs.writeFile(aggregate, aggregateSource(imports, texts, up).toBytes()).wait());
    if (wrote.isErr()) {
      err.line("wac: cannot write the aggregate \{aggregate} — \{wrote.isErr() ? "\{wrote.err()!}" : ""}");
      return 1;
    }
    entry = aggregate;
    generated = aggregate;
  }

  Sources src = await gather(fs, env, entry, cmd != "check" && cmd != "audit");
  // **The aggregate is scratch, and this is the only place that has to know it.** `gather` has its
  // bytes now and every later use of `entry` is as a *name* — a cache key, a diagnostic, a report
  // heading — so nothing below reads the file again and it can go here, once, instead of at the
  // thirty-odd ways out of this function.
  //
  // It used to go beside the run, after `runTests` answered. That covered a first run and nothing
  // default: a second run writes a fresh aggregate, hits the build cache and returns before reaching it,
  // and a compile failure returns earlier still — so `.cache/` grew by one file per invocation, which
  // is the shape `issues/system/0136` is about. Reported as GitHub wac#27.
  //
  // Best effort, and deliberately not checked: a run that answered is not made wrong by a file that
  // outlived it, and a message about failing to delete scratch would be noise over the test report.
  if (generated != "" && !keepAggregate(env)) { fs.remove(generated, false).wait(); }
  if (generated != "" && keepAggregate(env)) {
    err.line("wac: kept the generated aggregate at \{generated} (WAC_KEEP_AGGREGATE)");
  }
  if (src.missing != "" || src.why != "") {
    err.line(src.why != "" ? "wacc: \{src.why}" : "wacc: cannot read \{src.missing}");
    return 1;
  }
  string[] paths = exactly(src.paths, src.n);
  string[] texts = exactly(src.texts, src.n);
  // As read, for quoting a diagnostic's line: what follows rewrites the texts — adapters, and the pruning a build
  // does on lowered text — and a line quoted from those is one nobody wrote (`nsimport_test.wac`).
  string[] readPaths = paths;
  string[] readTexts = texts;
  Res res = resOf(src);
  // **A test takes capabilities as `main` does** (spec ch47): one taking `Sys`, or `async`, is
  // compiled behind an adapter the runner can call — `testEntry`, which leaves every other file alone.
  if (cmd == "test") {
    for (i32 i = 0; i < paths.len(); i++) {
      string pi = paths[i];
      if (pi.len() > 9 && pi.slice(pi.len() - 9, pi.len()) == "_test.wac") { texts[i] = testEntry(texts[i]); }
    }
  }
  // **Building a program gives `main` its contract** — spec ch07 — and, for a `main` the hosts
  // cannot call as written, the adapter they can. `compile` makes a plain module and leaves it alone.
  if (cmd == "build" || cmd == "run") {
    ProgramGraph pg = programGraph(paths, texts, entry);
    if (pg.why != "") {
      err.line("wacc: cannot build \{entry} as a program — \{pg.why}");
      return 1;
    }
    texts = pg.sources;
  }

  // **The artefact this build would write, if it has been written before.** `issues/system/0204`:
  // `wac build` compiled from source every time, and the box tests that build an application and run
  // it pay ~2 s of that per run — which is what stops the rest of `issues/system/0161` converting.
  //
  // Above the compile and below the gather, because the sources *are* the key: there is no way to know
  // a build is a repeat without reading what it reads. Gathering is the cheap half.
  // **Read before the cache is asked, because it decides whether the cache may answer.** `WAC_PROFILE`
  // turns on an instrumented build without `--coverage` on the command line — see `covered` below —
  // and `buildCachePath` only knows about the flag. A hit would serve the *plain* module to a run
  // whose whole purpose is the counters, and the profile would come back empty rather than wrong,
  // which is the kind of empty that reads as "this entry has no tests".
  string profileDir = "";
  if (cmd == "test") {
    u8[]? want = flatten(env.get("WAC_PROFILE").wait()).orElse(null);
    if (!(want is null) && want!.len() > 0) { profileDir = string.fromBytes(want!); }
  }
  string cachePath = profileDir != ""
                   ? ""
                   : buildCachePath(argv, env, argc, cmd, entry, paths, texts, outStem(argv, argc), target);
  if (cachePath != "") {
    u8[]? hit = (await fs.readFile(cachePath)).ok();
    // **A cached `run` is spawned, not written.** Like `test`'s hit and for the same reason: the module
    // carries its own manifest, so there is nothing to reconstruct and no file the caller asked for.
    // The grants passed to `spawn` are read from the command line rather than from the module, because
    // they are a *ceiling* intersected with what this process holds — the cached bytes only have to be
    // the same program, and the key already says they are.
    if ((hit is not null) && hit!.len() > 8 && cmd == "run") {
      string badFlagRun = unknownFlagFor(argv, argc, "run");
      if (badFlagRun != "") {
        err.line(flagRefusal("run", badFlagRun));
        return 2;
      }
      string misplacedRun = grantAfterEntry(argv, argc, entry);
      if (misplacedRun != "") {
        err.line("wac: \{misplacedRun} after the entry is a program argument, not a grant — write "
                  + "it before \{entry}, or after `--` if the program wants the string");
        return 2;
      }
      return await spawnWith(err, held, grantsBefore(argv, argc, entry), hit!, programArgs(argv, argc, entry), entry);
    }
    if ((hit is not null) && hit!.len() > 8 && cmd == "test") {
      // **A cached test module is run, not written.** `build`'s hit ends in a file because the file is
      // what was asked for; `test`'s hit ends in the tests, and the module carries its own manifest so
      // there is nothing else to reconstruct. `covTable` is empty by construction: `buildCachePath`
      // refuses a `--coverage` line, and `WAC_PROFILE` turns that on.
      string cachedManifest = manifestIn(hit!);
      if (cachedManifest != "") {
        string badFlagHit = unknownFlagFor(argv, argc, "test");
        if (badFlagHit != "") {
          err.line(flagRefusal("test", badFlagHit));
          return 2;
        }
        return runTests(err, out, clock, fs, mods, target, hit!, cachedManifest, within(held, askedOfBits(grantsIn(argv, argc))), flagValue(argv, argc, "--filter"), walked, ignoredCount, target, "", !hasFlag(argv, argc, "--quiet"), profileDir);
      }
    }
    // **An `app` hit is the module plus two shell lines**, which is all an app is — so this rebuilds
    // the artefact rather than writing the module, and the grants come off the command line exactly
    // as the miss below reads them. `issues/system/0283c`.
    if ((hit is not null) && hit!.len() > 8 && cmd == "app") {
      string appBad = unknownFlagFor(argv, argc, "app");
      if (appBad != "") { err.line(flagRefusal("app", appBad)); return 2; }
      string appDest = outStem(argv, argc);
      if (appDest != "") {
        i32 g = grantsIn(argv, argc);
        string w = "";
        if ((g & GRANT_READ) != 0) { w = w + (w == "" ? "" : " ") + "--allow-read"; }
        if ((g & GRANT_WRITE) != 0) { w = w + (w == "" ? "" : " ") + "--allow-write"; }
        if ((g & GRANT_NET) != 0) { w = w + (w == "" ? "" : " ") + "--allow-net"; }
        if ((g & GRANT_ENV) != 0) { w = w + (w == "" ? "" : " ") + "--allow-env"; }
        if ((g & GRANT_RUN) != 0) { w = w + (w == "" ? "" : " ") + "--allow-run"; }
        return writeApp(err, env, fs, hit!, appDest, w);
      }
    }
    if ((hit is not null) && hit!.len() > 8 && cmd != "test" && cmd != "app") {
      string stemHit = outStem(argv, argc);
      auto wroteHit = await fs.writeFile("\{stemHit}.wasm", hit!);
      if (wroteHit.isErr()) {
        err.line("wacc: cannot write \{stemHit}.wasm — \{"\{wroteHit.isErr() ? "\{wroteHit.err()!}" : ""}"}");
        return 1;
      }
      // **A hit says so.** This printed the line a real build prints, so nothing downstream could tell
      // a compile from a lookup — which is how a determinism test came to pass without compiling
      // anything. `--no-cache` is the way to refuse one; naming it here is what lets a caller *check*
      // that it worked, rather than trusting that it did.
      if (!hasFlag(argv, argc, "--quiet")) {
        out.line("\{stemHit}.wasm: \{hit!.len()} bytes from cache, "
                 + "\{src.n} file(s) unchanged");
      }
      return 0;
    }
  }

  // Diagnostics first for either command: compiling a program the checker refuses would write a
  // module built from a tree nobody approved.
  //
  // **Rendered, not the wire.** This printed `file\tline\tcol\tphase\t…` at a person until
  // `src/render.wac` — the compiler could build this repository and could not say what was wrong
  // with a file. `test/wac/renderdiag_test.wac` holds it to the layout `waccx` prints.
  //
  // **Every file, not just the entry.** One checking pass walks only the entry's bodies, so a type
  // error in an imported file was silent — and the emitter, which compiles every body, wrote a
  // module that failed validation with a wasm-level mismatch in place of a source line
  // (`issues/lang/0118`). That is as true of `compile` as of `check`: writing a module nobody
  // approved is the thing the diagnostics are here to prevent.
  // **Printed together, decided on separately** — `issues/lang/0126`. This returned 1 whenever the
  // rendered string was non-empty, which is right for errors and refuses a program that merely warns.
  // So the wire is taken once, rendered for the reader, and asked whether anything in it was an
  // error. One pass: rendering and deciding from the same string is what stops this being the second
  // whole-graph walk `issues/lang/0133` was about.
  //
  // **A build compiles what its entry reaches, and nothing else** — spec ch05. A declaration no
  // export of the entry names is dropped before it is checked, and a file no retained declaration
  // needs is not compiled at all, so a missing one is an error exactly when something needs it.
  // `check` and `audit` are questions about the whole source and keep every file (ch06).
  if (cmd != "check" && cmd != "audit") {
    Pruned pruned = pruneForBuild(paths, texts, res, entry);
    paths = pruned.paths;
    texts = pruned.sources;
    res = pruned.res;
  }
  string wire = diagnoseGraphIn(paths, texts, res, entry);
  string diags = wire == "" ? "" : renderDiagnostics(wire, paths, asWritten(paths, texts, readPaths, readTexts));
  if (diags != "") { err.line(diags); }
  if (wireHasErrors(wire)) { return 1; }

  // **`audit` stops here for the same reason `check` does**: it is a question about the source, and
  // emitting a module to answer it would be a minute of work for a table that does not depend on one.
  // It runs *after* the diagnostics above on purpose — an audit of a graph that does not type-check is
  // an audit of something nobody can build, and the reader should be told which problem they have.
  if (cmd == "audit") {
    return auditReport(err, out, src, entry, hasFlag(argv, argc, "--verbose"));
  }

  // **One front end for the whole build**, which is what `buildFiles` exists for — `issues/lang/0129`
  // made that call and this was the caller still not using it.
  //
  // What this used to do was ask four separate questions of four separate front ends: `blockedFiles`
  // for what the emitter declines, `emitFiles` for the module, and — inside `manifestFiles` below —
  // `bindTypesLinked` and `exportSigsLinked` for the boundary. Each takes `(paths, sources, entry)`
  // and builds its own, because this compiler does no I/O and holds nothing between calls. With
  // `diagnoseGraph` above that is **five whole-graph walks to produce one module**, and it is why
  // `wac build` on this compiler took 4.7 s while the same emit under a host that calls the library
  // directly took 0.5 s. The browser's bootstrap page has always shown the honest number.
  //
  // `Built.described` carries all three of the answers the walks were for, separated by
  // `describeSeparator()`, in the order `describeFiles` documents: blocked, signatures, bind types.
  //
  // **An instrumented module is a different module**, and asking for one is the build's decision:
  // `emitFilesCovered` writes a counter per branch point, and `covTableFiles` says what each counter
  // is. Both or neither — a table without the counters describes a module that does not exist. That
  // path keeps the separate calls, because there is no folded form of it and a coverage build is
  // something a person waits for on purpose.
  // **`WAC_PROFILE` asks for the same instrumented build without the flag**, because the thing that
  // sets it is not typing a command line: `tools/mutate.ts` runs `wac test <entry>` and then reads the
  // per-test line map to decide which tests a mutation could possibly reach. A profile is a coverage
  // build read per test rather than once, so it needs the counters for the same reason and gets them
  // the same way. `test` only — a `build` that quietly emitted a different module because a variable
  // was set in the shell would be a build whose output does not follow from its arguments.
  bool covered = hasFlag(argv, argc, "--coverage") || profileDir != "";
  // **`--trace` is the other instrumented build**, and it is the same three exports meaning something
  // default: a journal of `(site, value)` in the order events happened rather than a count per point.
  // `wac ctcompare` reads it. The two cannot be asked for together — they are one counter array, and a
  // build that tried to be both would answer whichever question was asked last.
  bool traced = hasFlag(argv, argc, "--trace");
  if (covered && traced) {
    err.line("wacc: --coverage and --trace are one counter array; ask for one of them");
    return 2;
  }
  string blocked = "";
  string sigs = "";
  string types = "";
  u8[] wasm = u8[]();
  if (covered || traced) {
    // **`*In` where the callee reads `res`, plain where it does not.** `blockedFilesIn`,
    // `exportSigsFilesIn` and `bindTypesFilesIn` pass the carrier through to the linker, so a
    // `@/` or a mapped import resolves the same way it did when the graph was gathered — that is
    // `design/lang/0009` D7. The traced emitters have no `In` variant yet and build a `Res.empty()`
    // of their own, so a traced build of a program using either feature resolves from nothing.
    blocked = blockedFilesIn(paths, texts, res, entry);
    i32 slots = traceSlots(argv, argc);
    wasm = covered ? emitFilesCoveredIn(paths, texts, res, entry)
                   : (slots > 0 ? emitFilesTracedSlots(paths, texts, entry, slots)
                                : emitFilesTraced(paths, texts, entry));
    sigs = exportSigsFilesIn(paths, texts, res, entry);
    types = bindTypesFilesIn(paths, texts, res, entry);
  } else {
    Built built = buildFilesIn(paths, texts, res, entry);
    Described parts = describedParts(built.described);
    blocked = parts.blocked;
    sigs = parts.sigs;
    types = parts.types;
    wasm = built.wasm;
  }
  // **What the emitter declines is not a diagnostic**, and saying so is the difference between a
  // module that is missing a function and a message about which one. Answered from the shared front
  // end rather than from one of its own; the module beside it is discarded unread when this fires,
  // which is the one case where folding the walks does work that used to be skipped.
  if (blocked != "") {
    // **One decline can be pointed at, so it is.** A missing import is the one refusal the linker can
    // locate: it knows the key, the file that asked and the specifier as written — and the specifier is
    // what makes a position findable *by comparison*, without resolving anything, which is the step
    // that cannot be redone soundly inside a mapped checkout. `issues/lang/0157`.
    string parts = missingImportFilesIn(paths, texts, res, entry);
    if (parts != "") {
      string shown = positionedMissingImport(parts, paths, texts);
      if (shown != "") { err.line(shown); return 1; }
    }
    err.line("wacc: cannot emit \{entry} — \{blocked}");
    return 1;
  }

  // **A module with no sections is not a module.** `blocked` above is the emitter *declining*, with a
  // reason in words. This is the emitter answering with the eight-byte header and nothing after it, which
  // has happened: `issues/lang/0154` reaches it, and the build reported `73846 bytes from 72 file(s)` and
  // exited 0, because the manifest section appended to a bare header makes the file look substantial. The
  // size line is the one number a person checks, and it agreed with the failure.
  //
  // So: nothing written, and a non-zero exit. `issues/lang/0155`.
  if (wasm.len() <= 8) {
    err.line("wacc: the emitter produced no code for \{entry} — \{wasm.len()}" +
              " bytes is the wasm header and no sections at all, so nothing was written. Nothing was " +
              "declined either, which is what makes this a defect in the emitter rather than in the " +
              "program: issues/lang/0154 is the one known way to reach it.");
    return 1;
  }

  // **`bindgen` writes the glue a host calls the module through**, beside the entry — `main.wac.ts`,
  // or `main.wac.js` with `--js`, since a browser cannot import TypeScript. What it cannot bind is
  // reported rather than skipped: a caller told `makeP(i32) -> P` was declined can change the
  // signature, and one handed glue missing a function finds out at the call site.
  if (cmd == "bindgen") {
    // `--script` is the JavaScript as a classic script, exporting nothing — for a worker made from a
    // page's own text, which may not be a module.
    bool script = hasFlag(argv, argc, "--script");
    bool js = script || hasFlag(argv, argc, "--js");
    string declined = bindgenDeclinedFilesIn(paths, texts, res, entry);
    if (declined != "") {
      err.line("wacc bindgen: not bound yet — \{oneLine(declined)}");
    }
    // From the metadata already in hand: `bindgenFiles` would build two more front ends to derive
    // exactly these two strings.
    string glue = bindgenWire(wasm, sigs, types, script ? "script" : js ? "js" : "ts");
    // **The positional output the usage line has always advertised.** `wac check|compile|bindgen
    // <entry.wac> [out]` — `compile` reads `pos[1]` twelve lines down and this did not, so a caller
    // who wrote one was handed `main.gen.ts` beside the entry and no word about the path they asked
    // for. Reported against an external project on 2026-08-25, with "the help text and actual
    // interface should agree" — they agree by the interface catching up, because `compile` already
    // does this and two commands on one usage line should not mean two things.
    // `vecs.wac` binds as `vecs.wac.ts` — the module's own name with the host's extension
    // (spec ch48).
    string dest = pos.len() > 1 ? pos[1] : entry + (js ? ".js" : ".ts");
    // **A generic the entry exports is said where it will be read** (spec ch48
    // `§wac-bind-generic-warns-cg9p295`): not refused — `export { Pair };` is ordinary code for wac
    // importers — but not bound either, and a host author finds that out here rather than at a call.
    string xs = types;
    while (xs.len() > 0) {
      i32 nl = xs.indexOf("\n");
      string ln = nl < 0 ? xs : xs.slice(0, nl);
      xs = nl < 0 ? "" : xs.slice(nl + 1, xs.len());
      if (ln.len() < 2 || ln.slice(0, 2) != "X\t") { continue; }
      string rest = ln.slice(2, ln.len());
      i32 tab = rest.indexOf("\t");
      if (tab < 0) { continue; }
      err.line("warning: \{rest.slice(0, tab)} is exported but generic, so it is not in \{dest}"
                + "\n  = help: export an instantiation by name: export { \{rest.slice(tab + 1, rest.len())} };");
    }
    auto wroteGlue = await fs.writeFile(dest, glue.toBytes());
    if (wroteGlue.isErr()) {
      err.line("wacc: cannot write \{dest} — \{"\{wroteGlue.isErr() ? "\{wroteGlue.err()!}" : ""}"}");
      return 1;
    }
    if (!hasFlag(argv, argc, "--quiet")) {
      out.line("\{dest}: \{bindSummary(glue)}");
    }
    return 0;
  }

  // **`build` is `compile` plus the boundary.** A native host cannot run a module without knowing
  // which `$bind$` export builds `Core` and in what order its funcrefs go, so an application is a
  // module *and* a manifest — `deno task app:native` in one command, which is what lets this binary
  // produce the artefact it is itself made of.
  // **`test` — one file, and it runs where `load` runs.** `issues/system/0230a` step 5.
  //
  // The whole of it is: the module is already compiled by the lines above, so wrap it in its manifest,
  // load it, and call every `test*` the manifest declares. `Cli.load` is what made that expressible
  // (`issues/system/0240c`) — before it, a wac program could start a *program* and not call a
  // *function*, and a test is a function.
  //
  // **One file, not a directory, and the summary says so by not being printed.** `wac test <dir>` on
  // the native binary walks for `*_test.wac`, builds one aggregate module for the whole directory and
  // prints `N files: …` as well. That aggregate is the part still to come; a caller naming one file
  // gets the same output from either host today, which is what `commandparity_test.wac` holds.
  //
  // `--coverage` is not here and is not silently ignored: the counters are reached through
  // `__cov_init`/`__cov_len`/`__cov_get`, which `call` accepts — three of its four shapes — so this is
  // work rather than a gap in the boundary.
  if (cmd == "test") {
    string badFlag = unknownFlagFor(argv, argc, "test");
    if (badFlag != "") {
      err.line(flagRefusal("test", badFlag));
      return 2;
    }
    // **`--coverage` for one file.** The shared compile above has already emitted an instrumented
    // module when it was asked for, so the whole of it here is: initialise the counters before the
    // tests, read them after, and pair them with the table. A *directory* under `--coverage` is still
    // the native command's alone, and for its reason rather than mine: the counters are per module and
    // the table is written beside it, so one aggregate would report the first file's positions for all
    // of them. That path needs a build per file, which this command does not do yet.
    i32 grants = grantsIn(argv, argc);
    string manifest = manifestWire(wasm, types, sigsWithCounters(sigs, covered || traced), entry,
                                  "\{baseName(stem(entry))}.wasm", grants);
    u8[] wholeTest = withManifestSection(wasm, manifest);
    // **Remembered before the tests run, not after.** What is cached is the *build*, and whether the
    // tests pass is not a property of it — a failing suite recompiled from scratch on every run would
    // be the case that most wants the cache. `cachePath` is already "" for a `--coverage` or profiling
    // line, and for a warned program the diagnostics pass above has returned.
    rememberBuild(env, fs, cachePath, wholeTest, entry);
    i32 code = runTests(err, out, clock, fs, mods, entry, wholeTest, manifest, within(held, askedOfBits(grants)), flagValue(argv, argc, "--filter"), walked, ignoredCount, target, covered ? covTableFilesIn(paths, texts, res, entry) : "", !hasFlag(argv, argc, "--quiet"), profileDir);
    // The aggregate is already gone — removed below `gather`, which is the one place that covers
    // every way out of this function rather than only this one. GitHub wac#27.
    return code;
  }

  // **`run`, and it lives here rather than in a host — `issues/system/0230a`, option 2.**
  //
  // The operator ruled that the shared thing is *this program* and that Deno, Node and the native
  // binary are hosts handing it argv and capabilities. `run` was that issue's own example of what only
  // a host could do — "the compiler writes a module and cannot instantiate one" — and it stopped being
  // true when every host learnt to start a module from bytes on 2026-08-21 (`issues/system/0144`). So
  // the *dispatch* is here and the *instantiation* is a capability, which is what lets one
  // implementation serve three hosts instead of one host having a command the others lack.
  //
  // **The grants are a ceiling, not a request.** `spawn` intersects what is asked with what this
  // process holds, so `wac run --allow-read` from a build without read gives the child a denied
  // capability rather than an error — the same rule as every other spawn, and the reason a host cannot
  // widen what a program may do.
  //
  // The native binary still answers `run` in Rust, before this program sees it, and that is deliberate
  // for now: `commandparity_test.wac` compares the two, and agreement measured is what has to come
  // before deleting either. Step 4 of that issue's order.
  if (cmd == "run") {
    string badFlag = unknownFlagFor(argv, argc, "run");
    if (badFlag != "") {
      err.line(flagRefusal("run", badFlag));
      return 2;
    }
    string misplaced = grantAfterEntry(argv, argc, entry);
    if (misplaced != "") {
      err.line("wac: \{misplaced} after the entry is a program argument, not a grant — write it "
                + "before \{entry}, or after `--` if the program wants the string");
      return 2;
    }
    i32 grants = grantsBefore(argv, argc, entry);
    // **With its manifest**, because that is what a host reads to build the world the module imports.
    // The name inside it is the entry's own stem: nothing is written to disk, so there is no file for
    // it to be wrong about, and a program that reports its own name should not report a temporary one.
    u8[] whole = withManifestSection(
      wasm, manifestWire(wasm, types, sigsWithCounters(sigs, covered || traced), entry,
                         "\{baseName(stem(entry))}.wasm", grants));

    // `true` for the input, so the program reads the terminal or the pipe this command was given —
    // which is what the native `run` does by instantiating in its own process. `false` for the
    // filesystem channel: this is not a program that answers `Fs.overParent` questions.
    // Stored before the spawn rather than after: the wait below does not return until the child is
    // done, and a program that runs for a minute should not have to finish before the next run gets
    // a hit.
    rememberBuild(env, fs, cachePath, whole, entry);

    return await spawnWith(err, held, grants, whole, programArgs(argv, argc, entry), entry);
  }

  // **`app` is `build` with a different thing written**, and it goes here for that reason: the shared
  // compile above has already produced `wasm`, and the only two questions left are what bytes go on
  // the front and what the file's mode is. Its own dispatch rather than a flag on `build` because the
  // output is not a module — `-o thing.wasm` and `-o thing` mean the same to `build` and very
  // different things to somebody handed the result.
  if (cmd == "app") {
    // **A flag this command cannot finish is refused rather than half-honoured.** `unknownFlag` below
    // is one list shared by every command, so `app` accepted `--coverage`, `--trace`, `--trace-slots`
    // and `--js` — while the message it prints on a rejected flag names only the five grants, so it
    // advertised five and took nine. `--coverage` was the one that mattered: `covered` is decided in
    // the shared compile above, so the module really did come out instrumented, and then this arm
    // wrote only the executable. The `.cov` table naming the counters is written by `build`'s arm, and
    // `covdump` refuses an app anyway — *is not a wasm module*, because of the two lines on the front.
    // So the whole of the feature was the instrumentation overhead.
    //
    // Refused rather than completed because completing it is three decisions, not a patch: what writes
    // the table, how `covdump` reads past the preamble, and how a *running* app dumps its counters.
    // `wac build --coverage` answers all three today and is what to reach for. `issues/system/0274c`.
    string bad = unknownFlagFor(argv, argc, "app");
    if (bad != "") {
      // **`--coverage` gets its own sentence**, because it is the one somebody types on purpose. The
      // generic refusal would list what `app` takes and leave them to guess that the answer is a
      // different command; this names it.
      if (bad == "--coverage" || bad == "--trace" || bad == "--trace-slots") {
        err.line("wac: `wac app` does not take '\{bad}' — it writes an executable, and the "
                  + "table that flag's counters need is written by `wac build --coverage`");
      } else {
        err.line(flagRefusal("app", bad));
      }
      return 2;
    }
    string dest = outStem(argv, argc);
    if (dest == "") {
      err.line("usage: wac app [--allow-read] [--allow-write] [--allow-net] [--allow-env] "
                + "[--allow-run] <entry.wac> -o <dest>");
      err.line("       ./<dest> runs it, and needs the `wac` command on the machine that does");
      return 2;
    }
    i32 appGrants = grantsIn(argv, argc);
    // The grants as words, for the line this prints: `--allow-read --allow-write` reads back as what
    // was typed, where a bitmask would be a number the caller has to decode to check their own build.
    string words = "";
    if ((appGrants & GRANT_READ) != 0) { words = words + (words == "" ? "" : " ") + "--allow-read"; }
    if ((appGrants & GRANT_WRITE) != 0) { words = words + (words == "" ? "" : " ") + "--allow-write"; }
    if ((appGrants & GRANT_NET) != 0) { words = words + (words == "" ? "" : " ") + "--allow-net"; }
    if ((appGrants & GRANT_ENV) != 0) { words = words + (words == "" ? "" : " ") + "--allow-env"; }
    if ((appGrants & GRANT_RUN) != 0) { words = words + (words == "" ? "" : " ") + "--allow-run"; }
    // **The sealed module is what is remembered**, not the file written from it: an app is that module
    // behind two shell lines, so a hit rebuilds the artefact with `writeApp` exactly as a miss does.
    // Storing the finished file instead would put the preamble in the cache, and the preamble is the
    // one part that costs nothing. `issues/system/0283c`.
    u8[] sealed = withManifestSection(wasm, manifestWire(wasm, types, sigs, entry,
                                                        "\{baseName(stem(entry))}.wasm",
                                                        appGrants));
    rememberBuild(env, fs, cachePath, sealed, dest);
    return writeApp(err, env, fs, sealed, dest, words);
  }

  if (cmd == "build") {
    string bad = unknownFlagFor(argv, argc, "build");
    if (bad != "") {
      err.line(flagRefusal("build", bad));
      return 2;
    }
    string stem = outStem(argv, argc);
    if (stem == "") {
      err.line("usage: wac build <entry.wac> -o <stem> [--allow-read] [--allow-write] [--allow-net] [--allow-env] [--allow-run]");
      return 2;
    }
    string wasmName = "\{baseName(stem)}.wasm";
    // Two more front ends, if this were `manifestFiles`: it derives `bindTypes` and `exportSigs`
    // from the sources, and both are already here.
    //
    // **`sigsWithCounters`, because an instrumented build has four exports no source names.**
    // `issues/system/0243c` added that call for `wac test --coverage` and stopped there, so
    // `wac build --coverage` wrote a module exporting `__cov_init`, `__cov_len` and `__cov_get` and a
    // manifest listing neither — and a manifest that "claims to describe the module's callable
    // surface" is that issue's own phrase. Measured: a `--coverage` build's manifest held `twice` and
    // `main` while the module held those two plus the three, so `cli.call(h, "__cov_get", i)` answered
    // *no export named __cov_get* against a module that exports it.
    //
    // That is what keeps `covdump`, `tracestat` and `ctcompare` in Rust — the last row of
    // `issues/system/0257c`'s table, and `issues/system/0230a`. It was recorded there as `Cli.load`
    // refusing manifest-less modules, which is a different thing and not what these commands are
    // handed: every test that feeds them uses `wac build`.
    //
    // `traced` as well as `covered`: the two are one counter array meaning different things, and both
    // inject the same three exports.
    string manifest = manifestWire(wasm, types, sigsWithCounters(sigs, covered || traced), entry,
                                  wasmName, grantsIn(argv, argc));
    u8[] whole = withManifestSection(wasm, manifest);
    // **A build that emitted no code used to report success** — `issues/lang/0155`. The artefact had
    // one section, `wac.manifest`, listing fifty exports the module did not contain, and it *validates*
    // because a module made of a custom section is legal wasm. So the engine check the native host runs
    // after a build had nothing to say, and what a reader got was a file with the magic number, the
    // version and a manifest they would believe.
    //
    // Checked here rather than in a host, so every host refuses it — and before the write, so there is
    // no artefact to believe.
    // `sigs` is one export per line, so its line count is what the manifest promises. Counted here
    // rather than passed as a string: `hollowWhy` walks bytes and has no business parsing a table.
    i32 promised = 0;
    for (i32 i = 0; i < sigs.len(); i++) { if (sigs.slice(i, i + 1) == "\n") { promised = promised + 1; } }
    string hollow = hollowWhy(whole, promised);
    if (hollow != "") {
      err.line("wacc: cannot build \{entry} — \{hollow}" +
                ". This is a compiler fault rather than a fault in the program: please report it with " +
                "the entry that produced it.");
      return 1;
    }
    auto wroteWasm = await fs.writeFile("\{stem}.wasm", whole);
    if (wroteWasm.isErr()) {
      err.line("wacc: cannot write \{stem}.wasm — \{"\{wroteWasm.isErr() ? "\{wroteWasm.err()!}" : ""}"}");
      return 1;
    }
    // Remembered under the key computed before the compile. A failure to write the cache is not a
    // failure to build: the artefact the caller asked for is already on disk, and the next run simply
    // compiles again.
    //
    // **A build that warned is not remembered.** A hit returns above the diagnostics pass, so an entry
    // for a warned program would make its warning print once and never again — the same source and the
    // same command line saying two different things, decided by whether anybody had built it before.
    // spec/cli/wac.md `[§wac-cli-usage-3nkq8wj]` is explicit that warnings are *"not held back … or
    // suppressed on a command that also writes a file"*, so the cache must not be the thing that holds
    // them back. Declining to store is the cheap half of the choice: the alternative is keeping the
    // rendered diagnostics beside the artefact, which is a second file to write, evict and validate for
    // a case worth fixing rather than caching. A warned program pays full price every build, and any
    // `diags` still here is a warning — `wireHasErrors` returned above.
    if (diags == "") { rememberBuild(env, fs, cachePath, whole, stem); }
    // **Inside the module, and only there.** A `.json` went beside it until 2026-08-20, because the
    // wasmtime host predated the section and took a manifest path as its argument. Both hosts read the
    // section now (`native/manifest`), so the pair was a second copy of one thing with nothing left
    // reading it — and a manifest that can be separated from its module is one that can be swapped.
    // `index\tline\tcol\tkind\tfile` per counter, in counter order — what turns a count into a
    // position. Beside the module because whoever runs it is who needs it.
    if (covered) {
      auto wroteCov = await fs.writeFile("\{stem}.cov", covTableFilesIn(paths, texts, res, entry).toBytes());
      if (wroteCov.isErr()) {
        err.line("wacc: cannot write \{stem}.cov — \{"\{wroteCov.isErr() ? "\{wroteCov.err()!}" : ""}"}");
        return 1;
      }
    }
    // The same table for a traced build, under its own suffix. Both or neither, for the reason above:
    // a table without the module it describes names positions in a program that was not built.
    if (traced) {
      auto wroteTrace = await fs.writeFile("\{stem}.trace",
                                       traceTableFiles(paths, texts, entry).toBytes());
      if (wroteTrace.isErr()) {
        err.line("wacc: cannot write \{stem}.trace — \{"\{wroteTrace.isErr() ? "\{wroteTrace.err()!}" : ""}"}");
        return 1;
      }
    }
    // **Quiet is about the *success* line only.** A build that fails still says why, on the stream a
    // caller reads for that — `wac run` compiles into a temporary file and then runs the program,
    // and a compiler announcing the file it wrote would land in the middle of that program's output.
    if (!hasFlag(argv, argc, "--quiet")) {
      out.line("\{stem}.wasm: \{whole.len()} bytes from \{src.n} file(s)");
    }
    return 0;
  }

  string dest = pos.len() > 1 ? pos[1] : wasmBeside(entry);
  auto wrote = await fs.writeFile(dest, wasm);
  if (wrote.isErr()) {
    err.line("wacc: cannot write \{dest} — \{wrote.isErr() ? "\{wrote.err()!}" : ""}");
    return 1;
  }
  out.line("\{dest}: \{wasm.len()} bytes from \{src.n} file(s)");
  return 0;
}

/**
 * Remove what `wac task wac:install` put under `$WAC_HOME`, and the line it added to a profile.
 *
 * **In the program, because it is a command and not engine work.** `issues/system/0257c` puts the
 * command surface here; this was 59 lines of Rust doing filesystem calls the program can already
 * make, which is the definition of a row that moves.
 *
 * The rules are the host's, kept exactly: a profile line is one containing `# wac`, the three files
 * are `bin/wac`, `env` and `install.json5`, `bin/` goes only if it empties, the cache stays with
 * `--keep-cache`, and `$WAC_HOME` itself goes only if nothing is left in it — otherwise the count is
 * reported, because removing a directory somebody else is using is not this command's business.
 */
/**
 * `wac audit <entry.wac>` — which files can reach a host capability, and through what.
 *
 * **The question a person running somebody else's code asks**, and one wac can answer where most
 * languages cannot: there is no ambient authority here, so a file that is never handed a `Cli` or a
 * `Core` cannot perform an effect however its body is written. `capReachFiles` does the analysis and
 * its header states the rule and the two things it does not model; this is the report.
 *
 * **Grouped by where the code came from, because that is the unit of trust.** A reader does not
 * choose files, they choose dependencies — `wac update` writes a lock and every file of a package
 * arrived together on one decision. So the default output is one line per dependency plus one for
 * the project, and `--verbose` is the file-by-file table underneath it (spec ch49).
 *
 * `design/system/0003` is the destination this is for: an Ethereum-centric distribution is a program
 * holding keys, and *what can this reach* is the question its operator has to be able to answer
 * without reading the closure.
 */
i32 auditReport(Output err, Output out, const Sources src, string entry, bool verbose) {
  string table = capReachFiles(src.paths, src.texts);
  if (table == "") {
    err.line("wac audit: the analysis answered nothing, which is a bug rather than a clean program");
    return 1;
  }
  string[] rows = linesOf(table);

  // **One line per dependency, and the project last** (spec ch49): a dependency is the files
  // under one package's directory — the `confine` the walk recorded for each — named by the import
  // that brought it in, and the project is `./`. `std` and `core` are the platform the program runs
  // on, not code anybody chose, and are left out of the count.
  i32 cap = src.n + 1;
  i32 lastSlash = 0 - 1;
  for (i32 k = 0; k < entry.len(); k++) { if (entry.slice(k, k + 1) == "/") { lastSlash = k; } }
  string entryDir = lastSlash > 0 ? entry.slice(0, lastSlash) : "";
  string[] gKey = string[].filled(cap, "");
  string[] gName = string[].filled(cap, "");
  string[] gList = string[].filled(cap, "");
  i32[] gFiles = i32[].filled(cap, 0);
  i32[] gReach = i32[].filled(cap, 0);
  i32 gN = 0;
  i32 read = 0;
  i32 reaches = 0;
  string truncated = "";
  for (i32 r = 0; r < rows.len(); r++) {
    if (rows[r] == "") { continue; }
    if (rows[r].slice(0, 1) == "#") {
      if (field(rows[r], 1).indexOf("TRUNCATED") >= 0) { truncated = field(rows[r], 1); }
      continue;
    }
    string path = field(rows[r], 0);
    if (isBuiltinPath(path)) { continue; }
    string status = field(rows[r], 1);
    string via = field(rows[r], 2);
    string rootType = field(rows[r], 3);
    string dir = confineOf(src, path);
    i32 g = 0 - 1;
    for (i32 k = 0; k < gN; k++) { if (gKey[k] == dir) { g = k; } }
    if (g < 0) {
      if (gN >= cap) { continue; }
      g = gN;
      gKey[g] = dir;
      gName[g] = dir == "" ? "./" : packageNamed(src, dir);
      gN = gN + 1;
    }
    // A file is named from where its group starts: a dependency's directory, or the entry's own.
    string from = dir != "" ? dir : entryDir;
    string shown = from != "" && path.len() > from.len() + 1 && path.slice(0, from.len() + 1) == "\{from}/"
      ? path.slice(from.len() + 1, path.len()) : path;
    gFiles[g] = gFiles[g] + 1;
    read = read + 1;
    string why = via == "" ? "" : via + (rootType != "" && rootType != via ? ", via \{rootType}" : "");
    if (status == "reaches") {
      gReach[g] = gReach[g] + 1;
      reaches = reaches + 1;
      gList[g] = gList[g] + (gList[g] == "" ? "" : ", ") + shown + " (" + why + ")";
    }
    if (verbose) {
      out.line((status == "reaches" ? "  reaches  " : "  sealed   ") + path + (why == "" ? "" : "   (\{why})"));
    }
  }
  if (verbose) { out.line(""); }

  i32 width = 0;
  for (i32 g = 0; g < gN; g++) { if (gName[g].len() > width) { width = gName[g].len(); } }
  // The project last, after the dependencies it chose.
  for (i32 pass = 0; pass < 2; pass++) {
    for (i32 g = 0; g < gN; g++) {
      if ((gKey[g] == "") != (pass == 1)) { continue; }
      string name = gName[g];
      while (name.len() < width) { name = name + " "; }
      out.line(name + " (\{gFiles[g]}" + (gFiles[g] == 1 ? " file" : " files") + "): "
               + (gReach[g] == 0 ? "sealed" : "reaches — \{gList[g]}"));
    }
  }
  // **The denominator, and it is the point** (`§wac-cli-audit-denominator-2wq7knx`): every report
  // says how much it read, including when nothing reaches — and a bound that was hit is said too,
  // because a table cut short that says `sealed` is the one failure this must not have.
  out.line("\{read}" + (read == 1 ? " file" : " files") + " read, \{reaches} reach, "
           + "\{read - reaches} sealed");
  if (truncated != "") {
    err.line("wac audit: \{truncated}");
    return 1;
  }
  return 0;
}

/** Whether `path` is the platform's own code — `std` and `core`, bundled or on disk. */
bool isBuiltinPath(string path) {
  return path == "core" || path == "std" || (path.len() > 4 && path.slice(0, 4) == "std/")
      || (path.len() > 5 && path.slice(0, 5) == "core/");
}

/** The package directory a file arrived under, or "" for the project's own. */
string confineOf(const Sources src, string path) {
  for (i32 i = 0; i < src.n; i++) {
    if (src.paths[i] == path) { return i < src.confine.len() ? src.confine[i] : ""; }
  }
  return "";
}

/** The name a project imported the package in `dir` by — the import whose module sits there. */
string packageNamed(const Sources src, string dir) {
  for (i32 m = 0; m < src.mapN; m++) {
    string to = src.mapTo[m];
    if (to.len() > dir.len() && to.slice(0, dir.len() + 1) == "\{dir}/") { return src.mapSpec[m]; }
  }
  return dir;
}

/**
 * `wac self install` and `wac self uninstall` — the command acting on its own installation.
 *
 * **`self`, rather than a bare `install`.** `wac update` is the *package* updater — a bare `update`
 * means the project you are in, and it reads `wac.json5` — so the namespace already mixes project
 * verbs with toolchain verbs. A plain `wac install` would land on that line and read, to anybody
 * arriving from npm or cargo, as "install this project's dependencies". `self` keeps the two apart
 * and leaves the name free for the packages that will want it.
 *
 * **It was `wac task wac:install` until 2026-08-28**, which is a task, which needs the command to
 * exist in order to install the command. That was circular at exactly the moment it was needed, and
 * `bootstrap.sh` is what replaces the half that built.
 */
i32 selfCommand(string[] argv, Output err, Output out, Env env, Files fs, i32 argc) {
  string sub = argc > 1 ? argv[1] : "";
  if (sub == "install") { return installCommand(argv, err, out, env, fs, argc); }
  if (sub == "uninstall") { return uninstallCommand(argv, err, out, env, fs, argc); }
  err.line("usage: wac self install --from PATH");
  err.line("       wac self uninstall [--keep-cache]");
  if (sub != "") { err.line("wac: unknown subcommand \{sub}"); }
  return 2;
}

/**
 * Put an already-built command under `$WAC_HOME` and on `PATH`.
 *
 * **It installs, and does not build.** `bootstrap.sh` builds — from source, through the ladder — and
 * hands the result here. Splitting them is what lets one script serve three hosts: what differs
 * between a native binary and a JavaScript file with a shebang is entirely in the building.
 *
 * **`--from` rather than the running program's own path.** Learning where you are is a capability
 * wac does not have, and adding one means editing `std/platform.wac`, whose text is carried inside
 * `packages/wacc/src/coretext.wac` — so it changes the compiler's bytes, and the seed's. That is a
 * large blast radius for a convenience, and the caller that matters already knows the path because
 * it just built the file. See `bootstrap/MIGRATION.md`.
 */
i32 installCommand(string[] argv, Output err, Output out, Env env, Files fs, i32 argc) {
  string from = "";
  bool editProfiles = true;
  for (i32 i = 2; i < argc; i++) {
    string a = argv[i];
    if (a == "--no-profile") { editProfiles = false; }
    else if (a == "--from" && i + 1 < argc) { from = argv[i + 1]; i++; }
    else {
      err.line("usage: wac self install --from PATH [--no-profile]");
      err.line("wac: unknown argument \{a}");
      return 2;
    }
  }
  if (from == "") {
    err.line("usage: wac self install --from PATH [--no-profile]");
    err.line("wac: --from names the command to install, and is required");
    return 2;
  }

  string home = wacHomeOf(env);
  if (home == "") {
    err.line("wac: neither WAC_HOME nor HOME is set, so there is nowhere to install to");
    return 2;
  }

  u8[]? got = flatten(fs.readFile(from).wait()).ok();
  if (got is null) {
    err.line("wac: cannot read \{from}");
    return 1;
  }

  // **The directories first**, because writing a file into a directory that is not there fails in a
  // way that names the file rather than the directory.
  fs.mkdir("\{home}/bin", true).wait();
  fs.mkdir("\{home}/cache/git", true).wait();

  auto put = flatten(fs.writeFile("\{home}/bin/wac", got!).wait());
  if (put.isErr()) {
    err.line("wac: cannot write \{home}/bin/wac");
    return 1;
  }
  fs.setExecutable("\{home}/bin/wac", true).wait();

  // Sourced from a shell profile. Guarded so that sourcing it twice does not put the directory on
  // `PATH` twice.
  fs.writeFile("\{home}/env",
    ("# Written by `wac self install`. Sourced from a shell profile.\n"
     + "case \":${PATH}:\" in\n"
     + "  *\":\{home}/bin:\"*) ;;\n"
     + "  *) PATH=\"\{home}/bin:${PATH}\" ; export PATH ;;\n"
     + "esac\n").toBytes()).wait();

  fs.writeFile("\{home}/install.json5",
    ("{\n"
     + "  // Written by `wac self install`.\n"
     + "  home: \"\{home}\",\n"
     + "  from: \"\{from}\",\n"
     + "  bytes: \{got!.len()},\n"
     + "}\n").toBytes()).wait();

  i32 lines = 0;
  if (editProfiles) {
    u8[]? h = flatten(env.get("HOME").wait()).orElse(null);
    if (!(h is null) && h!.len() > 0) {
      string hd = string.fromBytes(h!);
      lines = ensureProfileLine(fs, hd, home);
    }
  }

  out.line("wac: installed \{got!.len()} bytes at \{home}/bin/wac");
  if (lines > 0) {
    out.line("     and a line in your shell profile — open a new shell, or `. \{home}/env`");
  } else {
    out.line("     put \{home}/bin on PATH, or `. \{home}/env`");
  }
  return 0;
}

/**
 * Add `. "$home/env"` to the first shell profile that exists, unless one is already there.
 *
 * The mirror of `removeProfileLine`, and it uses the same rule to recognise its own line: one
 * carrying `# wac`. Answers 1 if it wrote one and 0 if it did not, so the caller can say which.
 */
i32 ensureProfileLine(Files fs, string hd, string home) {
  string[] profiles = ["\{hd}/.bashrc", "\{hd}/.zshrc", "\{hd}/.profile"];
  for (i32 i = 0; i < profiles.len(); i++) {
    u8[]? got = flatten(fs.readFile(profiles[i]).wait()).ok();
    if (got is null) { continue; }
    string text = string.fromBytes(got!);
    if (holds(text, "# wac")) { return 0; }
    string sep = text.len() > 0 && text.slice(text.len() - 1, text.len()) != "\n" ? "\n" : "";
    auto put = flatten(fs.writeFile(profiles[i],
      "\{text}\{sep}. \"\{home}/env\"    # wac\n".toBytes()).wait());
    if (put.isOk()) { return 1; }
  }
  return 0;
}

i32 uninstallCommand(string[] argv, Output err, Output out, Env env, Files fs, i32 argc) {
  bool keepCache = false;
  // **From 2, not 1.** `self` is argument 0 and `uninstall` is argument 1, so the flags start after
  // both. A loop from 1 reads its own subcommand name as an unknown flag and refuses.
  for (i32 i = 2; i < argc; i++) {
    string a = argv[i];
    if (a == "--keep-cache") { keepCache = true; }
    else {
      err.line("usage: wac self uninstall [--keep-cache]");
      err.line("wac: unknown argument \{a}");
      return 2;
    }
  }
  string home = wacHomeOf(env);
  if (home == "") {
    err.line("wac: neither WAC_HOME nor HOME is set, so there is nowhere to uninstall from");
    return 2;
  }
  string went = "";
  i32 wentN = 0;

  u8[]? h = flatten(env.get("HOME").wait()).orElse(null);
  if (!(h is null) && h!.len() > 0) {
    string hd = string.fromBytes(h!);
    i32 lines = 0;
    string[] profiles = ["\{hd}/.bashrc", "\{hd}/.zshrc", "\{hd}/.profile"];
    for (i32 i = 0; i < profiles.len(); i++) { lines = lines + removeProfileLine(fs, profiles[i]); }
    if (lines > 0) { went = went + (wentN > 0 ? ", " : "") + "\{lines} profile line(s)"; wentN++; }
  }

  string[] named = ["bin/wac", "env", "install.json5"];
  for (i32 i = 0; i < named.len(); i++) {
    auto gone = flatten(fs.remove("\{home}/\{named[i]}", false).wait());
    if (gone.isOk()) { went = went + (wentN > 0 ? ", " : "") + named[i]; wentN++; }
  }
  // Only when it empties, which is what we want — a `bin` holding anything else is not ours.
  fs.remove("\{home}/bin", false).wait();
  if (!keepCache) {
    auto gone = flatten(fs.remove("\{home}/cache", true).wait());
    if (gone.isOk()) { went = went + (wentN > 0 ? ", " : "") + "cache"; wentN++; }
  }
  string[]? left = flatten(fs.readDir(home).wait()).ok();
  if (!(left is null)) {
    if (left!.len() == 0) { fs.remove(home, false).wait(); }
    else {
      went = went + (wentN > 0 ? ", " : "") + "(\{left!.len()} other entr"
           + (left!.len() == 1 ? "y" : "ies") + " left in " + home + ")";
      wentN++;
    }
  }
  // The host printed the list bare — `println!("{}", went.join(", "))` — and this is a differential
  // against a command people have in their shell history, so the wording is not mine to improve.
  out.line(wentN == 0 ? "nothing to remove" : went);
  return 0;
}

/** Whether `hay` holds `needle`. Local because this file wants one substring test and no dependency. */
bool holds(string hay, string needle) {
  if (needle.len() == 0) { return true; }
  if (needle.len() > hay.len()) { return false; }
  for (i32 i = 0; i + needle.len() <= hay.len(); i++) {
    if (hay.slice(i, i + needle.len()) == needle) { return true; }
  }
  return false;
}

/**
 * A profile line is one carrying `# wac`, and the count of those removed. The host's rule exactly,
 * including the join: `kept.join("\n")` there, so a file ending in a newline keeps its trailing
 * empty line and one that does not, does not.
 */
i32 removeProfileLine(Files fs, string profile) {
  u8[]? got = flatten(fs.readFile(profile).wait()).ok();
  if (got is null) { return 0; }
  string text = string.fromBytes(got!);
  string kept = "";
  i32 dropped = 0;
  i32 keptN = 0;
  i32 at = 0;
  while (at <= text.len()) {
    i32 nl = at;
    while (nl < text.len() && text.slice(nl, nl + 1) != "\n") { nl++; }
    string line = text.slice(at, nl);
    if (holds(line, "# wac")) { dropped++; }
    else {
      kept = kept + (keptN > 0 ? "\n" : "") + line;
      keptN++;
    }
    if (nl >= text.len()) { break; }
    at = nl + 1;
  }
  if (dropped == 0) { return 0; }
  auto wrote = flatten(fs.writeFile(profile, kept.toBytes()).wait());
  return wrote.isOk() ? dropped : 0;
}

/** What the glue binds, as a person reads it: `2 classes, 1 function` (spec ch48). */
string bindSummary(string glue) {
  i32 classes = 0;
  i32 functions = 0;
  i32 at = 0;
  while (at < glue.len()) {
    i32 nl = glue.slice(at, glue.len()).indexOf("\n");
    string ln = nl < 0 ? glue.slice(at, glue.len()) : glue.slice(at, at + nl);
    if (ln.len() > 13 && ln.slice(0, 13) == "export class ") { classes++; }
    if (ln.len() > 16 && ln.slice(0, 16) == "export function ") { functions++; }
    if (nl < 0) { break; }
    at = at + nl + 1;
  }
  return "\{classes}" + (classes == 1 ? " class, " : " classes, ")
       + "\{functions}" + (functions == 1 ? " function" : " functions");
}

/**
 * An unknown command, named, with every command there is (spec ch45 `§wac-cli-usage-3nkq8wj`) —
 * the whole list, so the one a reader meant is in it whichever it was.
 */
string unknownCommand(string cmd) {
  return "wac: unknown command '\{cmd}' — the commands are check, compile, build, run, test, app, "
       + "bindgen, audit, update, sh, task, self, validate, covdump, ctcompare, tracestat and app-run, "
       + "or a module `name.wasm` to run";
}

/** `no diagnostics`, or how many errors and warnings the wire holds — `2 error(s), 1 warning(s)`. */
string diagnosticCount(string wire) {
  i32 errors = 0;
  i32 warnings = 0;
  string rest = wire;
  while (rest.len() > 0) {
    i32 nl = rest.indexOf("\n");
    string ln = nl < 0 ? rest : rest.slice(0, nl);
    rest = nl < 0 ? "" : rest.slice(nl + 1, rest.len());
    if (ln == "") { continue; }
    if (ln.len() >= 8 && ln.slice(ln.len() - 8, ln.len()) == "\twarning") { warnings++; } else { errors++; }
  }
  if (errors == 0 && warnings == 0) { return "no diagnostics"; }
  if (warnings == 0) { return "\{errors} error(s)"; }
  if (errors == 0) { return "\{warnings} warning(s)"; }
  return "\{errors} error(s), \{warnings} warning(s)";
}

/**
 * `wac check [files…]` — spec ch06. With files, each is a root and everything they import is
 * checked in full (`§wac-check-files-2ncb9c8`); with none, every `.wac` file under the project's
 * `wac.json5` is a root, less what its `check.exclude` names (`§wac-check-project-x9xt4fg`,
 * `§wac-check-exclude-2ixx2cu`). One graph, merged from every root, checked once — and, like every
 * command, it ends by saying how much it read.
 */
async i32 checkCommand(Output err, Output out, Env env, Files fs, string[] given) {
  // **It always says what it read** (spec ch45 `§wac-cli-check-4mkq8wp`) — after errors and
  // warnings as much as after nothing, since the count is the part that cannot otherwise be seen.
  string[] roots = given;
  // **A directory stands for the files beneath it** (spec ch06 `§wac-check-dir-r4kq7zm`). It was read as
  // a file, and `wac check .` answered ": 1 file(s), no diagnostics" having checked nothing at all.
  if (given.len() > 0) {
    Vec<string> expanded = Vec.create();
    string here = flatten(env.cwd().wait()).unwrap();
    // An index, not `for (string g in given)`: that loop around an `await` in an `async` function is
    // emitted as a call the engine refuses (`issues/lang/0420c`).
    for (i32 gi = 0; gi < given.len(); gi++) {
      string g = given[gi];
      // Asked of the absolute path: `.` itself did not stat as a directory, so `wac check .` was read as
      // a file named `.` and answered ": 1 file(s), no diagnostics".
      string asked = g.len() > 0 && g.slice(0, 1) == "/" ? g : normalisePath("\{here}/\{g}");
      Stat? st = flatten(fs.stat(asked).wait()).ok();
      if (st is not null && st!.isDir) {
        string why = await rootsBeneath(env, fs, g, expanded);
        if (why != "") {
          err.line("wac check: " + why);
          return 1;
        }
      } else {
        expanded.push(g);
      }
    }
    roots = expanded.toArray();
    if (roots.len() == 0) {
      out.line("\{given[0] == "" ? "." : given[0]}: 0 file(s), no diagnostics");
      return 0;
    }
  }
  // `given` is normalised, which spells `.` as "".
  string first = given.len() > 0 && given[0] == "" ? "." : (given.len() > 0 ? given[0] : "");
  string label = given.len() == 1 ? first : (given.len() > 1 ? "\{first} and \{given.len() - 1} more" : "");
  if (given.len() == 0) {
    // **The project this is run in**: the nearest `wac.json5` at or above the working directory.
    string dir = ".";
    bool found = false;
    for (i32 up = 0; up < 32 && !found; up++) {
      if ((await fs.stat("\{dir}/\{MANIFEST_NAME()}")).isOk()) { found = true; } else { dir = dir == "." ? ".." : "\{dir}/.."; }
    }
    // **No manifest anywhere above: the working directory is the project.** The README's own example
    // runs `wac check` over a lone file with no `wac.json5`, and expects it checked; refusing for want
    // of one would answer a question about source with a usage error.
    if (!found) { dir = "."; }
    u8[]? mf = flatten(fs.readFile("\{dir}/\{MANIFEST_NAME()}").wait()).ok();
    Manifest m = readManifest(found && (mf is not null) ? mf! : "{}".toBytes());
    if (!m.ok) {
      err.line("wac check: " + dir + "/" + MANIFEST_NAME() + " — " + manifestWhy(m.code)
                + (m.detail == "" ? "" : " (\{m.detail})"));
      return 1;
    }
    Vec<string> found2 = Vec.create();
    discoverWac(fs, dir, "", m.checkExclude, found2);
    roots = found2.toArray();
    label = dir;
    if (roots.len() == 0) {
      out.line("\{label}: 0 file(s), no diagnostics");
      return 0;
    }
  }
  // **One graph from every root**, each file once: two roots that share an import share its check.
  Gathered g = await gatherRoots(fs, env, roots);
  if (g.error != "") {
    err.line("wacc: \{g.error}");
    return 1;
  }
  string[] paths = g.paths;
  string[] texts = g.texts;
  Sources first = g.first;
  Res res = g.res;
  string wire = diagnoseGraphIn(paths, texts, res, normalisePath(roots[0]));
  string diags = renderDiagnostics(wire, paths, texts);
  if (diags != "") { err.line(diags); }
  out.line("\{label}: \{paths.len()} file(s), \{diagnosticCount(wire)}");
  return wireHasErrors(wire) ? 1 : 0;
}

/**
 * Every `.wac` file under `dir` — the project's own: not inside a `.`-directory, `node_modules` or
 * `target`, nor inside a nested project (a directory with its own `wac.json5`), nor matching an
 * exclusion. `rel` is the path below the project directory, which is what an exclusion is matched
 * against.
 */
/**
 * The `.wac` files beneath directory `arg`, as project discovery finds them — spec ch06
 * `§wac-check-dir-r4kq7zm` — into `out`, spelled relative to the working directory where they are under
 * it. The project's exclusions apply, matched from the project's directory, so the nearest `wac.json5` at
 * or above `arg` is found first; with none, `arg` is the project. Answers why it could not, or "".
 */
async string rootsBeneath(Env env, Files fs, string arg, Vec<string> out) {
  string cwd = flatten(env.cwd().wait()).unwrap();
  string abs = normalisePath(arg.len() > 0 && arg.slice(0, 1) == "/" ? arg : "\{cwd}/\{arg}");
  string proj = abs;
  bool found = false;
  for (i32 up = 0; up < 64 && !found; up++) {
    if ((await fs.stat("\{proj}/\{MANIFEST_NAME()}")).isOk()) { found = true; }
    else {
      i32 cut = 0 - 1;
      for (i32 k = 0; k < proj.len(); k++) { if (proj.slice(k, k + 1) == "/") { cut = k; } }
      if (cut <= 0) { break; }
      proj = proj.slice(0, cut);
    }
  }
  string[] exclude = string[]();
  if (found) {
    u8[]? mf = flatten(fs.readFile("\{proj}/\{MANIFEST_NAME()}").wait()).ok();
    Manifest m = readManifest(mf is not null ? mf! : "{}".toBytes());
    if (!m.ok) {
      return proj + "/" + MANIFEST_NAME() + " — " + manifestWhy(m.code) + (m.detail == "" ? "" : " (\{m.detail})");
    }
    exclude = m.checkExclude;
  } else {
    proj = abs;
  }
  string rel = abs == proj ? "" : abs.slice(proj.len() + 1, abs.len());
  Vec<string> found2 = Vec.create();
  discoverWac(fs, proj, rel, exclude, found2);
  for (i32 i = 0; i < found2.len(); i++) {
    string p = found2.get(i);
    out.push(p.len() > cwd.len() + 1 && p.slice(0, cwd.len() + 1) == "\{cwd}/" ? p.slice(cwd.len() + 1, p.len()) : p);
  }
  return "";
}

void discoverWac(Files fs, string dir, string rel, string[] exclude, Vec<string> out) {
  string here = rel == "" ? dir : "\{dir}/\{rel}";
  string[]? names = flatten(fs.readDir(here).wait()).ok();
  if (names is null) { return; }
  string[] sorted = names!;
  for (i32 i = 1; i < sorted.len(); i++) {
    string v = sorted[i];
    i32 j = i - 1;
    while (j >= 0 && sorted[j] > v) { sorted[j + 1] = sorted[j]; j = j - 1; }
    sorted[j + 1] = v;
  }
  for (i32 i = 0; i < sorted.len(); i++) {
    string name = sorted[i];
    if (name == "" || name.slice(0, 1) == "." || name == "node_modules" || name == "target") { continue; }
    string sub = rel == "" ? name : "\{rel}/\{name}";
    string full = "\{dir}/\{sub}";
    Stat? st = flatten(fs.stat(full).wait()).ok();
    if ((st is not null && st!.isDir)) {
      if (flatten(fs.stat("\{full}/\{MANIFEST_NAME()}").wait()).isOk()) { continue; }
      discoverWac(fs, dir, sub, exclude, out);
      continue;
    }
    if (name.len() < 5 || name.slice(name.len() - 4, name.len()) != ".wac") { continue; }
    bool skip = false;
    for (i32 e = 0; e < exclude.len(); e++) { if (globMatches(exclude[e].slice(2, exclude[e].len()), sub)) { skip = true; } }
    if (!skip) { out.push(dir == "." ? sub : full); }
  }
}

/** A `check.exclude` pattern against a project-relative path: `**` spans directories, `*` does not. */
bool globMatches(string pat, string path) {
  if (pat == "") { return path == ""; }
  if (pat.len() >= 2 && pat.slice(0, 2) == "**") {
    string rest = pat.slice(2, pat.len());
    if (rest.len() > 0 && rest.slice(0, 1) == "/") { rest = rest.slice(1, rest.len()); }
    for (i32 i = 0; i <= path.len(); i++) {
      if (globMatches(rest, path.slice(i, path.len()))) { return true; }
    }
    return false;
  }
  if (pat.slice(0, 1) == "*") {
    string rest = pat.slice(1, pat.len());
    for (i32 i = 0; i <= path.len(); i++) {
      if (globMatches(rest, path.slice(i, path.len()))) { return true; }
      if (i < path.len() && path.slice(i, i + 1) == "/") { return false; }
    }
    return false;
  }
  if (path.len() == 0 || pat.slice(0, 1) != path.slice(0, 1)) { return false; }
  return globMatches(pat.slice(1, pat.len()), path.slice(1, path.len()));
}
