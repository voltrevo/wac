// `wac build --trace` and `wac ctcompare` — the pair that makes a constant-time question answerable.
//
// A traced build records an *ordered journal* of `(site, value)`: every branch taken and every array
// index, in the order they happened. Two runs that differ only in a secret must produce the same
// journal, and where they do not is where the secret was observed. That is the question
// `packages/crypto`'s constant-time tests ask, and until these two commands existed it could only be
// asked from JavaScript — a TypeScript harness instantiated the module and walked the journal in
// process.
//
// **The comparison is the command, and that is the whole design.** `covdump` can already print a
// traced module's counter array, because a trace reuses the same three exports and only changes what
// the array means. Printing it is the wrong wire for it: `p256PublicKey` produces about three million
// events, so a caller would parse tens of megabytes twice to learn one number. `ctcompare` walks both
// journals where the modules are and answers in one line, in about half a second.
//
// The hash in each name is the spec claim it checks — `[§wac-cli-ctcompare-6knq4wp]` in
// spec/cli/wac.md. A wac export cannot hold the bracketed spelling, so the suffix carries it.
//
// **The two programs must differ only in their data.** Both drivers here are the same source with one
// constant changed, because `main`'s own points are in the journal too: a pair written with different
// *shapes* — a loop in one and two assignments in the other — parts at event 1, which is the driver
// and not the routine. That cost a measurement before it was noticed.

import { T } from "../../../wactest/src/assert.wac";
import { binaryPath, freshDir, scratch } from "../../../wactest/src/host.wac";
import { contains, startsWith, trimmed, splitLines } from "../../../wactest/src/strings.wac";
import { Exec, execReason, ChildEnv, Env, Files, Launch, Procs, Sys } from "std";
import { flatten } from "core";

/**
 * A program whose secret decides an array index and nothing else.
 *
 * One branch point per run either way, so counting branches calls it uniform — which is the whole
 * reason indices are recorded.
 */
string indexed(i32 secret) {
  return "static u8[] SBOX = [3, 1, 4, 1, 5, 9, 2, 6];\n" +
         "export i32 main() {\n" +
         "  i32 secret = \{secret};\n" +
         "  return SBOX[secret & 7] as i32;\n" +
         "}\n";
}

/** A program that reads its secret and cannot leak it: the work is the same either way. */
string uniform(i32 secret) {
  return "export i32 main() {\n" +
         "  i32 secret = \{secret};\n" +
         "  i32 acc = 0;\n" +
         "  for (i32 i = 0; i < 8; i++) { acc = acc + (secret & 1); }\n" +
         "  return acc;\n" +
         "}\n";
}

/** A program whose secret decides a branch. */
string branching(i32 secret) {
  return "export i32 main() {\n" +
         "  i32 secret = \{secret};\n" +
         "  if (secret > 10) { return 1; }\n" +
         "  return 0;\n" +
         "}\n";
}

/**
 * Two index events whose values are swapped — the same numbers, in the other order.
 *
 * **Written against the hash, and it is the case a plausible one passes.** `wac ctcompare` compares
 * two journals by asking each module to fold its own into one number (`__cov_hash`), because fetching
 * `p256PublicKey`'s 8.19 million events a slot at a time cost 13s a comparison. A fold that adds, or
 * xors, or counts, agrees here: both journals hold `{siteA, siteB, 2, 5}` and differ only in which
 * site got which value. That is exactly the divergence a constant-time test is looking for, so a hash
 * blind to order would report every leak of this shape as `same`.
 */
string swapped(bool other) {
  return "static u8[] SBOX = [3, 1, 4, 1, 5, 9, 2, 6];\n" +
         "export i32 main() {\n" +
         "  return SBOX[" + (other ? "5" : "2") + "] as i32 + SBOX[" + (other ? "2" : "5") + "] as i32;\n" +
         "}\n";
}

/** Build one traced module, answering the stem or the empty string. */
string built(T t, Env env, Files fs, Procs procs, string dir, string name, string src) {
  string entry = "\{dir}/\{name}.wac";
  auto wrote = flatten(fs.writeFile(entry, src.toBytes()).wait());
  t.isTrue(wrote.isOk(), "\{name}: writing the source — \{wrote.isErr() ? "\{wrote.err()!}" : ""}");
  if (wrote.isErr()) { return ""; }
  auto rRan = flatten(procs.exec(binaryPath(env), ["build", entry, "--trace", "-o", "\{dir}/\{name}", "--quiet"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null) && r!.status == 0,
           "\{name}: the traced build — \{(r is null ? "\{rRan.err()!}" : execReason(r!))}");
  return ((r is not null) && r!.status == 0) ? "\{dir}/\{name}" : "";
}

/** `ctcompare`, with its whole answer trimmed. */
string compared(T t, Env env, Procs procs, string a, string b, bool all) {
  string[] argv = all ? ["ctcompare", "--all", "\{a}.wasm", "\{b}.wasm"]
                      : ["ctcompare", "\{a}.wasm", "\{b}.wasm"];
  auto rRan = flatten(procs.exec(binaryPath(env), argv, u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null) && r!.status == 0,
           "ctcompare ran — \{(r is null ? "\{rRan.err()!}" : execReason(r!))}");
  return ((r is not null) && r!.status == 0) ? trimmed(string.fromBytes(r!.stdout)) : "<did not run>";
}

/** The `kind` and `line` of one site, out of the table the build wrote beside the module. */
string siteAt(Files fs, string stem, i32 site) {
  auto fRead = flatten(fs.readFile("\{stem}.trace").wait());
  u8[]? f = fRead.ok();
  if ((f is null)) { return "<no table: \{fRead.isErr() ? "\{fRead.err()!}" : ""}>"; }
  string[] rows = splitLines(string.fromBytes(f!));
  string want = "\{site}\t";
  for (string row in rows) {
    if (startsWith(row, want)) {
      // index, line, col, kind, file
      string[] parts = string[].filled(5, "");
      i32 n = 0;
      string cur = "";
      for (i32 k = 0; k < row.len(); k++) {
        if (row.slice(k, k + 1) == "\t") {
          if (n < 5) { parts[n] = cur; n = n + 1; }
          cur = "";
        } else {
          cur = cur + row.slice(k, k + 1);
        }
      }
      if (n < 5) { parts[n] = cur; n = n + 1; }
      return n >= 4 ? "\{parts[3]}@\{parts[1]}" : "<short row>";
    }
  }
  return "<no such site>";
}

export string test_a_secret_dependent_index_is_found_where_no_branch_differs_6knq4wp(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = scratch(env, "ctcompare-index");
  string whyDir = freshDir(fs, dir);
  t.isTrue(whyDir == "", whyDir);
  string a = built(t, env, fs, procs, dir, "a", indexed(1));
  string b = built(t, env, fs, procs, dir, "b", indexed(2));
  if (a == "" || b == "") { fs.remove(dir, true).wait(); return t.report(); }

  string said = compared(t, env, procs, a, b, false);
  t.isTrue(startsWith(said, "differs "), "the index leak was not found: \{said}");

  // Both runs stand at the *same* point with different values, which is what an index leak is and
  // what a branch counter cannot see. `--all` names the site, and the table says it is an index.
  string all = compared(t, env, procs, a, b, true);
  t.isTrue(startsWith(all, "site "), "--all did not name a site: \{all}");
  if (startsWith(all, "site ")) {
    // `site <i> <site> <va> <vb>`
    string[] f = splitLines(all);
    string row = f.len() > 0 ? f[0] : "";
    i32 sp = 0;
    string[] parts = string[].filled(5, "");
    i32 n = 0;
    string cur = "";
    for (i32 k = 0; k <= row.len(); k++) {
      string c = k < row.len() ? row.slice(k, k + 1) : " ";
      if (c == " ") { if (cur.len() > 0 && n < 5) { parts[n] = cur; n = n + 1; } cur = ""; }
      else { cur = cur + c; }
    }
    t.eqI32(n, 5, "a site line has five fields: \{row}");
    if (n == 5) {
      t.eqStr(siteAt(fs, a, atoiOf(parts[2])), "index@4", "the site the table names");
    }
  }
  fs.remove(dir, true).wait();
  return t.report();
}

/** The `n`th whitespace-separated word of a line. */
string word(string line, i32 n) {
  i32 at = 0;
  string cur = "";
  for (i32 i = 0; i <= line.len(); i++) {
    string c = i < line.len() ? line.slice(i, i + 1) : " ";
    if (c == " " || c == "\n" || c == "\t") {
      if (cur.len() > 0) { if (at == n) { return cur; } at = at + 1; }
      cur = "";
    } else { cur = cur + c; }
  }
  return "";
}

/** Digits to an integer; -1 when it is not one. */
i32 atoiOf(string s) {
  u8[] b = s.toBytes();
  if (b.len() == 0) { return -1; }
  i32 v = 0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] < 48 || b[i] > 57) { return -1; }
    v = v * 10 + (b[i] as i32 - 48);
  }
  return v;
}

export string test_a_routine_that_does_not_look_at_its_secret_says_same_6knq4wp(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  // **The canary for every other case here.** A comparison that finds a divergence everywhere is not
  // a check, and both of the leaks in this file are one line away from this program.
  T t = T.create();
  string dir = scratch(env, "ctcompare-uniform");
  string whyDir = freshDir(fs, dir);
  t.isTrue(whyDir == "", whyDir);
  string a = built(t, env, fs, procs, dir, "a", uniform(0));
  string b = built(t, env, fs, procs, dir, "b", uniform(255));
  if (a == "" || b == "") { fs.remove(dir, true).wait(); return t.report(); }
  // **`same 24`, not `same`.** The count is the difference between agreement and a comparison of two
  // empty journals — a mistyped export calls nothing, records nothing, and matches perfectly. Both
  // forms are asserted, and the number is asserted to be a number greater than nothing.
  string said = compared(t, env, procs, a, b, false);
  t.isTrue(startsWith(said, "same "), "two runs that observe nothing: \{said}");
  t.isTrue(atoiOf(said.slice(5, said.len())) > 0,
           "`same` over no events at all is not agreement: \{said}");
  // And `--all` says so out loud rather than printing nothing, which is what a command that never ran
  // also prints.
  t.isTrue(startsWith(compared(t, env, procs, a, b, true), "same "), "--all on an identical pair");
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_a_secret_dependent_branch_parts_the_two_runs_6knq4wp(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = scratch(env, "ctcompare-branch");
  string whyDir = freshDir(fs, dir);
  t.isTrue(whyDir == "", whyDir);
  string a = built(t, env, fs, procs, dir, "a", branching(1));
  string b = built(t, env, fs, procs, dir, "b", branching(100));
  if (a == "" || b == "") { fs.remove(dir, true).wait(); return t.report(); }

  t.isTrue(startsWith(compared(t, env, procs, a, b, false), "differs "),
           "the branch leak was not found");
  // A branch leak is a *split*: the two runs are at different points, not at one point with different
  // values. `--all` stops there, because past it the journals are not aligned.
  string all = compared(t, env, procs, a, b, true);
  t.isTrue(startsWith(all, "split "), "a branch leak should be a split, got: \{all}");
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_two_journals_holding_the_same_numbers_in_a_different_order_differ_6knq4wp(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = scratch(env, "ctcompare-order");
  string whyDir = freshDir(fs, dir);
  t.isTrue(whyDir == "", whyDir);
  string a = built(t, env, fs, procs, dir, "a", swapped(false));
  string b = built(t, env, fs, procs, dir, "b", swapped(true));
  if (a == "" || b == "") { fs.remove(dir, true).wait(); return t.report(); }

  // Same length, same cursor, same event total, same numbers — everything the comparison checks as a
  // plain integer agrees, so this reaches the hash and nothing else can answer it.
  string said = compared(t, env, procs, a, b, false);
  t.isTrue(startsWith(said, "differs "),
           "two journals differing only in the order of their events: \{said}");
  // And it is a `site`, not a `split`: both runs are at the same point holding different values,
  // which is the shape of an index leak and what `--all` is for.
  string all = compared(t, env, procs, a, b, true);
  t.isTrue(startsWith(all, "site "), "an index leak should be a site, got: \{all}");
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_a_module_with_no_journal_is_an_error_not_an_empty_comparison_6knq4wp(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  // An uninstrumented module has no counters, and answering `same` for a pair of them would report
  // every routine in the repository as constant-time.
  T t = T.create();
  string dir = scratch(env, "ctcompare-plain");
  string whyDir = freshDir(fs, dir);
  t.isTrue(whyDir == "", whyDir);
  string entry = "\{dir}/p.wac";
  fs.writeFile(entry, "export i32 main() { return 0; }\n".toBytes()).wait();
  auto bRan = flatten(procs.exec(binaryPath(env), ["build", entry, "-o", "\{dir}/p", "--quiet"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? b = bRan.ok();
  t.isTrue((b is not null) && b!.status == 0, "the plain build — \{string.fromBytes(b!.stderr)}");
  if ((b is null) || b!.status != 0) { fs.remove(dir, true).wait(); return t.report(); }

  auto rRan = flatten(procs.exec(binaryPath(env), ["ctcompare", "\{dir}/p.wasm", "\{dir}/p.wasm"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null), "ctcompare ran — \{rRan.isErr() ? "\{rRan.err()!}" : ""}");
  if ((r is not null)) {
    t.eqI32(r!.status, 1, "an uninstrumented module compared as though it had a journal");
    t.isTrue(contains(string.fromBytes(r!.stderr), "no counters"),
             "the message names the cause: \{string.fromBytes(r!.stderr)}");
  }

  auto usageRan = flatten(procs.exec(binaryPath(env), ["ctcompare"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? usage = usageRan.ok();
  t.isTrue((usage is not null) && usage!.status == 2, "no arguments is a usage error");
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_tracestat_reports_what_a_run_wanted_so_the_next_one_can_fit_6knq4wp(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  // **The overflow has to be reported as a number, not as a flag.** A journal that filled up is the
  // normal case for anything expensive, and "it did not fit" leaves a caller doubling and retrying;
  // `wanted` says exactly how large the next attempt has to be. `--trace-slots` is the other half.
  T t = T.create();
  string dir = scratch(env, "ctcompare-slots");
  string whyDir = freshDir(fs, dir);
  t.isTrue(whyDir == "", whyDir);

  // 40 iterations is more than eight slots can hold and far less than the default.
  const string SRC = "export i32 main() {\n" +
    "  i32 acc = 0;\n" +
    "  for (i32 i = 0; i < 40; i++) { acc = acc + i; }\n" +
    "  return acc;\n" +
    "}\n";
  string entry = "\{dir}/p.wac";
  fs.writeFile(entry, SRC.toBytes()).wait();

  auto smallRan = flatten(procs.exec(binaryPath(env), ["build", entry, "--trace", "--trace-slots", "8", "-o", "\{dir}/small", "--quiet"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? small = smallRan.ok();
  t.isTrue((small is not null) && small!.status == 0,
           "the small build — \{string.fromBytes(small!.stderr)}");
  if ((small is null) || small!.status != 0) { fs.remove(dir, true).wait(); return t.report(); }

  auto rRan = flatten(procs.exec(binaryPath(env), ["tracestat", "\{dir}/small.wasm"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null) && r!.status == 0, "tracestat ran — \{string.fromBytes(r!.stderr)}");
  if ((r is null) || r!.status != 0) { fs.remove(dir, true).wait(); return t.report(); }
  string said = trimmed(string.fromBytes(r!.stdout));
  i32 events = atoiOf(word(said, 1));
  i32 wanted = atoiOf(word(said, 3));
  i32 slots = atoiOf(word(said, 5));
  t.eqI32(slots, 8, "the size is the caller's: \{said}");
  t.isTrue(wanted > events, "it should have overflowed: \{said}");
  t.isTrue(wanted > 40, "one point per iteration at least: \{said}");

  // Sized from what the first run reported, the second fits — and `events` and `wanted` agree, which
  // is the whole claim.
  auto bigRan = flatten(procs.exec(binaryPath(env), [
             "build", entry, "--trace", "--trace-slots", "\{2 * wanted + 8}",
             "-o", "\{dir}/big", "--quiet"
    ], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? big = bigRan.ok();
  t.isTrue((big is not null) && big!.status == 0, "the resized build — \{string.fromBytes(big!.stderr)}");
  if ((big is not null) && big!.status == 0) {
    auto r2Ran = flatten(procs.exec(binaryPath(env), ["tracestat", "\{dir}/big.wasm"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
    Exec? r2 = r2Ran.ok();
    string said2 = trimmed(string.fromBytes(r2!.stdout));
    t.eqI32(atoiOf(word(said2, 1)), atoiOf(word(said2, 3)),
            "the resized journal did not fit what the first run asked for: \{said2}");
    t.eqI32(atoiOf(word(said2, 3)), wanted, "the two runs counted different events: \{said2}");
  }

  auto usageRan = flatten(procs.exec(binaryPath(env), ["tracestat"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? usage = usageRan.ok();
  t.isTrue((usage is not null) && usage!.status == 2, "no arguments is a usage error");
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_coverage_and_trace_cannot_be_asked_for_together_6knq4wp(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  // They are one counter array meaning two things, so a build that tried to be both would answer
  // whichever question was asked last — silently, and only when someone read the numbers.
  T t = T.create();
  string dir = scratch(env, "ctcompare-both");
  string whyDir = freshDir(fs, dir);
  t.isTrue(whyDir == "", whyDir);
  string entry = "\{dir}/p.wac";
  fs.writeFile(entry, "export i32 main() { return 0; }\n".toBytes()).wait();
  auto rRan = flatten(procs.exec(binaryPath(env), ["build", entry, "--coverage", "--trace", "-o", "\{dir}/p", "--quiet"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null), "the build was attempted — \{rRan.isErr() ? "\{rRan.err()!}" : ""}");
  if ((r is not null)) {
    t.isTrue(r!.status != 0, "it built both ways, which it must not");
    t.isTrue(contains(string.fromBytes(r!.stderr), "one counter array"),
             "the refusal says why: \{string.fromBytes(r!.stderr)}");
  }
  fs.remove(dir, true).wait();
  return t.report();
}
