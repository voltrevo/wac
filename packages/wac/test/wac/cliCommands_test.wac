// `wac check`, `wac compile`, `wac bindgen` — the three the compiler inside the binary handles.
//
// These claims had their own spec section and were tested against `wacx` — the reference toolchain
// run through Deno — over an in-memory filesystem with no process involved. `wacx` is retired, so
// they move onto the command people type and are driven by spawning it against real files. That is
// not the same test written twice: the binary's answers differ from `wacx`'s in three places, and
// each difference was found by running it rather than by reading the old test.
//
//   - `check` on a clean file prints a summary. `wacx` printed nothing.
//   - `bindgen` writes `<name>.wac.ts`, as `wacx` did and spec ch48 says; it wrote `<stem>.gen.ts`
//     for a while.
//   - A usage error is exit 2. `wacx` used 1 for both usage and compile failures.
//
// The old wording survived a copy-paste review of the same page twice, which is the argument for
// making the spec's examples spawn something.
//
// The hash in each name is the spec claim it checks, in spec/cli/wac.md — `[§wac-cli-check-4mkq8wp]`,
// `[§wac-cli-compile-9wkn3pq]`, `[§wac-cli-bindgen-5tqm7wn]` and `[§wac-cli-usage-3nkq8wj]`. A wac
// export cannot hold the bracketed spelling, so the suffix carries it.

import { T } from "../../../wactest/src/assert.wac";
import { binaryPath, scratch } from "../../../wactest/src/host.wac";
import { contains } from "../../../wactest/src/strings.wac";
import { Exec, Stat, ChildEnv, Env, Files, Launch, Procs, Sys } from "std";
import { flatten } from "core";

string MATH() { return "export i32 gcd(i32 a, i32 b) { return b == 0 ? a : gcd(b, a % b); }\n"; }
string BAD()  { return "export i32 f() { return \"x\"; }\n"; }
string MAIN() { return "import { f } from \"./lib.wac\";\nexport i32 g() { return f(); }\n"; }
// Two structs that share no ancestor, so `a is B` is always false — a warning and not an error.
string WARN() {
  return "struct A { i32 x; }\nstruct B { i32 y; }\n"
       + "export i32 f(A a) { return a is B ? 1 : 0; }\n";
}

struct Dir {
  bool ok;
  string path;
  string what;
}

Dir workspace(Env env, Files fs, string name) {
  string dir = scratch(env, "cli-\{name}");
  auto made = flatten(fs.mkdir(dir, true).wait());
  if (made.isErr()) { return Dir(false, "", "a working directory: \{made.isErr() ? "\{made.err()!}" : ""}"); }
  string[] names = ["math.wac", "bad.wac", "main.wac", "lib.wac", "warn.wac"];
  string[] texts = [MATH(), BAD(), MAIN(), BAD(), WARN()];
  for (i32 i = 0; i < names.len(); i++) {
    auto w = flatten(fs.writeFile("\{dir}/\{names[i]}", texts[i].toBytes()).wait());
    if (w.isErr()) { return Dir(false, "", "\{names[i]}: \{w.isErr() ? "\{w.err()!}" : ""}"); }
  }
  return Dir(true, dir, "");
}

struct Ran {
  bool started;
  i32 status;
  string out;
}

/** Run the binary in `dir`, with output joined the way a terminal shows it. */
Ran wac(Env env, Procs procs, string dir, string[] args) {
  string[] argv = string[].filled(args.len(), "");
  for (i32 i = 0; i < args.len(); i++) {
    // Entries are named relative to the workspace, so the messages quote a short path and the
    // assertions below are about the name rather than about where the test happens to write.
    argv[i] = endsWithWac(args[i]) ? "\{dir}/\{args[i]}" : args[i];
  }
  auto rRan = flatten(procs.exec(binaryPath(env), argv, u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  if ((r is null)) { return Ran(false, -1, "\{rRan.isErr() ? "\{rRan.err()!}" : ""}"); }
  return Ran(true, r!.status, string.fromBytes(r!.stdout) + string.fromBytes(r!.stderr));
}

bool endsWithWac(string s) { return s.len() > 4 && s.slice(s.len() - 4, s.len()) == ".wac"; }

string joined(string[] xs) {
  string out = "";
  for (i32 i = 0; i < xs.len(); i++) { out = out + (i == 0 ? "" : " ") + xs[i]; }
  return out;
}

export string test_check_reports_and_writes_nothing_4mkq8wp(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  Dir d = workspace(env, fs, "check");
  t.isTrue(d.ok, d.what);
  if (!d.ok) { return t.report(); }

  Ran clean = wac(env, procs, d.path, ["check", "math.wac"]);
  t.isTrue(clean.started, "the binary started");
  if (!clean.started) { return t.report(); }
  t.eqI32(clean.status, 0, "a valid file exits 0 — \{clean.out}");
  // **It says something.** How many files were read is the part you cannot otherwise see, and
  // silence does not distinguish "checked and clean" from "did not look".
  t.isTrue(contains(clean.out, "no diagnostics"), "and says so — got \"\{clean.out}\"");
  t.isTrue(contains(clean.out, "math.wac"), "naming the entry");
  // Nothing written: `check` is the command you run when you do not want an artefact.
  Stat? wasm = flatten(fs.stat("\{d.path}/math.wasm").wait()).ok();
  t.isFalse((wasm is not null), "check wrote no module");

  Ran broken = wac(env, procs, d.path, ["check", "bad.wac"]);
  t.eqI32(broken.status, 1, "a broken file exits 1");
  t.isTrue(contains(broken.out, "bad.wac"), "and names the file — got \"\{broken.out}\"");

  // The error is in the *imported* file, which is only reached by walking the graph. Naming
  // `main.wac` here would be an entry parsed alone and reported as if it were the whole program.
  Ran graph = wac(env, procs, d.path, ["check", "main.wac"]);
  t.eqI32(graph.status, 1, "an error in an import exits 1");
  t.isTrue(contains(graph.out, "lib.wac"),
           "and names the imported file, not the entry — got \"\{graph.out}\"");

  Ran missing = wac(env, procs, d.path, ["check", "nope.wac"]);
  t.eqI32(missing.status, 1, "a missing file exits 1");
  t.isTrue(contains(missing.out, "nope.wac"), "and names the path — got \"\{missing.out}\"");
  return t.report();
}

export string test_compile_writes_a_module_and_bindgen_writes_the_glue_9wkn3pq_5tqm7wn(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  Dir d = workspace(env, fs, "compile");
  t.isTrue(d.ok, d.what);
  if (!d.ok) { return t.report(); }

  Ran c = wac(env, procs, d.path, ["compile", "math.wac"]);
  t.eqI32(c.status, 0, "compile exits 0 — \{c.out}");
  t.isTrue(contains(c.out, "math.wasm"), "and prints what it wrote — got \"\{c.out}\"");
  u8[]? wasm = flatten(fs.readFile("\{d.path}/math.wasm").wait()).ok();
  t.isTrue((wasm is not null), "the module is there");
  if ((wasm is not null)) {
    // The magic number, so this is a real module rather than a stray string with the right name.
    t.isTrue(wasm!.len() > 4, "and is not empty");
    if (wasm!.len() > 4) {
      t.eqI32(wasm![0] as i32, 0, "\\0");
      t.eqI32(wasm![1] as i32, 'a', "a");
      t.eqI32(wasm![2] as i32, 's', "s");
      t.eqI32(wasm![3] as i32, 'm', "m");
    }
  }

  Ran b = wac(env, procs, d.path, ["bindgen", "math.wac"]);
  t.eqI32(b.status, 0, "bindgen exits 0 — \{b.out}");
  // `math.wac.ts`, and what it bound — spec ch48.
  t.isTrue(contains(b.out, "math.wac.ts: 0 classes, "), "and prints the path and a summary — got \"\{b.out}\"");
  u8[]? glue = flatten(fs.readFile("\{d.path}/math.wac.ts").wait()).ok();
  t.isTrue((glue is not null), "the glue is there");
  if ((glue is not null)) {
    t.isTrue(contains(string.fromBytes(glue!), "gcd"),
             "and wraps the exported function by name");
  }
  return t.report();
}

export string test_warnings_are_shown_and_do_not_change_the_exit_code_3nkq8wj(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  Dir d = workspace(env, fs, "warn");
  t.isTrue(d.ok, d.what);
  if (!d.ok) { return t.report(); }

  // A warning nobody sees is not a warning, so they are not held back for `check` — and a warning
  // that failed a build would be an error under a softer name.
  Ran r = wac(env, procs, d.path, ["check", "warn.wac"]);
  t.eqI32(r.status, 0, "a warning still exits 0 — \{r.out}");
  t.isTrue(contains(r.out, "warning"), "and is printed — got \"\{r.out}\"");
  return t.report();
}

export string test_usage_and_unknown_commands_3nkq8wj(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  Dir d = workspace(env, fs, "usage");
  t.isTrue(d.ok, d.what);
  if (!d.ok) { return t.report(); }

  Ran none = wac(env, procs, d.path, string[]());
  t.eqI32(none.status, 2, "no arguments is a usage error");
  t.isTrue(contains(none.out, "usage:"), "and prints usage");

  Ran help = wac(env, procs, d.path, ["--help"]);
  t.eqI32(help.status, 0, "--help is not an error");

  // `compile` rather than `check`: `wac check` alone checks the project it is run in (spec ch06).
  Ran noEntry = wac(env, procs, d.path, ["compile"]);
  t.eqI32(noEntry.status, 2, "a command with no entry is a usage error");

  Ran unknown = wac(env, procs, d.path, ["frobnicate", "math.wac"]);
  t.eqI32(unknown.status, 2, "an unknown command is a usage error");
  t.isTrue(contains(unknown.out, "frobnicate"), "and names it — got \"\{unknown.out}\"");

  // **The command is validated before the entry is read.** Mistype both and the old order told you
  // about the file: `wac chekc nope.wac` answered *cannot read nope.wac* at exit 1, diagnosing the
  // typo you did not make and giving a compile-failure code for a usage mistake. Reading the entry
  // first is what made a usage error depend on whether an unrelated path happened to exist.
  Ran both = wac(env, procs, d.path, ["chekc", "nope.wac"]);
  t.eqI32(both.status, 2, "a mistyped command with a missing entry is still a usage error");
  t.isTrue(contains(both.out, "chekc"),
           "and names the command rather than the path — got \"\{both.out}\"");
  return t.report();
}
