// `wac check` in its three forms — spec ch06 — driven through the command.
//
// `wac check` alone answered with the usage block until 2026-10-02, and the spec probe counted that
// exit 2 as the refusal its examples expected: every `(wac check): refused` was met by a command that
// never read the fence. So each case here asserts the count line, which only a run that checked
// something prints.

import { T } from "../../../wactest/src/assert.wac";
import { binaryPath, scratch } from "../../../wactest/src/host.wac";
import { contains } from "../../../wactest/src/strings.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { Clock, Exec, ChildEnv, Env, Files, Launch, Procs, Sys } from "std";
import { flatten } from "core";
import { Gathered, ReadCache, gatherRoots, gatherWith } from "../../src/sources.wac";

void put(Files fs, string path, string text) {
  i32 cut = 0 - 1;
  for (i32 k = 0; k < path.len(); k++) { if (path.slice(k, k + 1) == "/") { cut = k; } }
  if (cut > 0) { fs.mkdir(path.slice(0, cut), true).wait(); }
  fs.writeFile(path, text.toBytes()).wait();
}

/** `wac check <args>` run from `dir`. */
Exec checkIn(Env env, Procs procs, string dir, string args) {
  return flatten(procs.exec("/bin/sh", ["-c", "cd \{dir} && exec \{binaryPath(env)} check \{args}"], u8[](), ChildEnv.inherited(), Launch.plain()).wait()).unwrap();
}

string said(Exec r) { return string.fromBytes(r.stdout) + string.fromBytes(r.stderr); }

string fresh(Env env, Files fs, string name) {
  string dir = "\{flatten(env.cwd().wait()).unwrap()}/.cache/\{name}";
  fs.remove(dir, true).wait();
  fs.mkdir(dir, true).wait();
  return dir;
}

export string test_alone_it_checks_every_project_file_less_its_exclusions_x9xt4fg_2ixx2cu(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = fresh(env, fs, "checkproject-project");
  put(fs, "\{dir}/wac.json5", "{ check: { exclude: [\"./fixtures/**\"] } }\n");
  put(fs, "\{dir}/main.wac", "export i32 zero() { return 0; }\n");
  put(fs, "\{dir}/src/unused.wac", "export i32 one() { return 1; }\n");
  put(fs, "\{dir}/fixtures/invalid.wac", "i32 broken() { return nonexistent(); }\n");
  Exec clean = checkIn(env, procs, dir, "");
  t.eqI32(clean.status, 0, "the excluded fixture is not discovered — \{said(clean)}");
  t.isTrue(contains(said(clean), ".: 2 file(s), no diagnostics"), "and the two project files are — \{said(clean)}");

  // An unreached file outside the exclusion is checked, which is what makes it a project check.
  put(fs, "\{dir}/src/unused.wac", "i32 broken() { return nonexistent(); }\n");
  Exec bad = checkIn(env, procs, dir, "");
  t.eqI32(bad.status, 1, "an unreached broken file is diagnosed — \{said(bad)}");
  t.isTrue(contains(said(bad), "1 error(s)"), "and counted — \{said(bad)}");
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_files_are_roots_and_turn_discovery_off_2ncb9c8_km2e8t2(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = fresh(env, fs, "checkproject-files");
  put(fs, "\{dir}/wac.json5", "{}\n");
  put(fs, "\{dir}/src/lib.wac", "export i32 answer() { return 42; }\n");
  put(fs, "\{dir}/src/other.wac", "export i32 other() { return 1; }\n");
  put(fs, "\{dir}/src/neighbour.wac", "i32 broken() { return nonexistent(); }\n");
  Exec two = checkIn(env, procs, dir, "src/lib.wac src/other.wac");
  t.eqI32(two.status, 0, "two roots, and the broken neighbour is not discovered — \{said(two)}");
  t.isTrue(contains(said(two), "2 file(s), no diagnostics"), "both roots counted — \{said(two)}");
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_with_no_manifest_the_directory_is_the_project(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  // The README's own example runs `wac check` over a lone file with no `wac.json5`.
  T t = T.create();
  // **Outside the repository**, because the repository has a `wac.json5` at its root: a directory under
  // it with none of its own is inside that project, so `.cache/` cannot stand for "no manifest" any more.
  string dir = scratch(env, "checkproject-bare");
  fs.remove(dir, true).wait();
  fs.mkdir(dir, true).wait();
  put(fs, "\{dir}/main.wac", "i32 unused() { return nonexistent(); }\nexport i32 used() { return 0; }\n");
  Exec r = checkIn(env, procs, dir, "");
  t.eqI32(r.status, 1, "diagnosed, not a usage error — \{said(r)}");
  t.isTrue(contains(said(r), "1 file(s), 1 error(s)"), "and it says what it read — \{said(r)}");
  fs.remove(dir, true).wait();
  return t.report();
}

/** A project of `k` files that each import `big.wac`, which is `lines` lines of comment and one struct. */
string importers(Env env, Files fs, string name, i32 k, i32 lines) {
  string dir = fresh(env, fs, name);
  put(fs, "\{dir}/wac.json5", "{}\n");
  u8[] line = "// filler filler filler filler filler filler filler filler filler filler\n".toBytes();
  u8[] head = "export struct Lib { i32 x; }\n".toBytes();
  u8[] big = u8[].filled(head.len() + lines * line.len(), 0);
  big.copyFrom(head, 0, 0, head.len());
  for (i32 i = 0; i < lines; i++) { big.copyFrom(line, 0, head.len() + i * line.len(), line.len()); }
  fs.writeFile("\{dir}/big.wac", big).wait();
  for (i32 i = 0; i < k; i++) {
    put(fs, "\{dir}/u\{i}.wac", "import { Lib } from \"./big.wac\";\nexport i32 f\{i}(Lib l) { return l.x; }\n");
  }
  return dir;
}

/** The project's `.wac` files, as `wac check` would find them: `big.wac` and its `k` importers. */
string[] rootsOf(string dir, i32 k) {
  string[] roots = string[].filled(k + 1, "");
  roots[0] = "\{dir}/big.wac";
  for (i32 i = 0; i < k; i++) { roots[i + 1] = "\{dir}/u\{i}.wac"; }
  return roots;
}

// **A project check reads each file once.** Checking a project gathered each discovered file's closure
// on its own, so a file every other file imports was read and scanned once per importer: checking
// `packages/box` read 8,630 files to find 423, `bytes/src/slice.wac` 117 times.
//
// **Counted, not timed, since 2026-10-28.** This compared what a large shared file added to the check at
// ten importers and at eighty — a difference of two timings, measured one after the other — and failed
// gates on correct code under load even with a 3× bar. What it guards is how many times a file is read,
// so it counts the reads `wac check`'s own gathering (`gatherRoots`) makes, and the canary gathers each
// root on its own to show the count moves when the cache is not shared.
export string test_a_project_check_reads_a_shared_file_once(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  T t = T.create();
  for (i32 k in [10, 80]) {
    string dir = importers(env, fs, "checkproject-reads-\{k}", k, 10);
    string[] roots = rootsOf(dir, k);
    Gathered g = gatherRoots(fs, env, roots).wait().unwrap();
    t.eqStr(g.error, "", "\{k} importers: gathered");
    t.eqI32(g.paths.len(), k + 1, "\{k} importers: the files the project holds");
    t.eqI32(g.reads, k + 1, "\{k} importers: reads, one per file — the shared one is not read per importer");
    if (k == 10) {
      // The canary: each root through its own cache reads `big.wac` once per importer.
      i32 alone = 0;
      for (string root in roots) {
        ReadCache own = ReadCache.create();
        gatherWith(fs, env, root, false, own).wait().unwrap();
        alone = alone + own.reads;
      }
      t.eqI32(alone, 2 * k + 1, "the canary: gathered root by root, the shared file is read once per importer");
    }
    fs.remove(dir, true).wait();
  }
  return t.report();
}

/**
 * **Every root resolves its imports, not only the first.** A project check gathers each discovered
 * file's closure through one cache, and resolved the whole graph against the *first* root's mapping
 * table — so a nested project, entered by its directory, was found for the first file that imported it
 * and for no other. Its namespaced items were then left as written and did not parse. In this
 * repository that was 950 errors over fifteen pages that each check clean on their own
 * (`import { html.button } from "../../web"`).
 *
 * Two roots, each importing a namespace member from one nested project: both must check clean.
 */
export string test_every_root_resolves_a_nested_projects_namespace(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = scratch(env, "checkproject-nested");
  fs.remove(dir, true).wait();
  fs.mkdir(dir, true).wait();
  put(fs, "\{dir}/wac.json5", "{}\n");
  put(fs, "\{dir}/lib/wac.json5", "{ exports: './src/lib.wac' }\n");
  put(fs, "\{dir}/lib/src/lib.wac", "export * as shapes from \"./shapes.wac\";\n");
  put(fs, "\{dir}/lib/src/shapes.wac", "export i32 sides() { return 4; }\n");
  put(fs, "\{dir}/a.wac", "import { shapes.sides } from \"./lib\";\nexport i32 a() { return sides(); }\n");
  put(fs, "\{dir}/b.wac", "import { shapes.sides } from \"./lib\";\nexport i32 b() { return sides(); }\n");
  Exec r = checkIn(env, procs, dir, "");
  t.eqI32(r.status, 0, "both roots check clean — \{said(r)}");
  t.isTrue(contains(said(r), "no diagnostics"), "and it says so — \{said(r)}");
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_a_directory_argument_checks_what_is_beneath_it_r4kq7zm(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = fresh(env, fs, "checkproject-dir");
  put(fs, "\{dir}/wac.json5", "{ check: { exclude: [\"./lib/fixtures/**\"] } }\n");
  put(fs, "\{dir}/elsewhere.wac", "i32 broken() { return nonexistent(); }\n");
  put(fs, "\{dir}/lib/a.wac", "export i32 a() { return 1; }\n");
  put(fs, "\{dir}/lib/more/b.wac", "export i32 b() { return 2; }\n");
  put(fs, "\{dir}/lib/fixtures/bad.wac", "i32 broken() { return nonexistent(); }\n");
  Exec named = checkIn(env, procs, dir, "lib");
  t.eqI32(named.status, 0, "a directory, less the project's exclusions — \{said(named)}");
  t.isTrue(contains(said(named), "lib: 2 file(s), no diagnostics"), "both files beneath it — \{said(named)}");
  // `.` is the spelling the spec gives for "this directory", and was read as a file named `.`.
  Exec here = checkIn(env, procs, "\{dir}/lib", ".");
  t.eqI32(here.status, 0, "`.` from inside it — \{said(here)}");
  t.isTrue(contains(said(here), ".: 2 file(s), no diagnostics"), "the same two files — \{said(here)}");
  fs.remove(dir, true).wait();
  return t.report();
}

/**
 * A file reached by climbing out of the working directory and back in is one module, not two.
 *
 * From `pkgs/a`, `../b/b.wac` importing `../a/src/one.wac` joined to `../a/src/one.wac`, where the
 * entry's own import said `src/one.wac`: one file, two keys, two copies of `P`, and `wac check .` in
 * `packages/json` reported a method missing from an enum it had declared.
 */
export string test_a_file_reached_from_above_the_working_directory_is_one_module(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = fresh(env, fs, "checkproject-climb");
  put(fs, "\{dir}/wac.json5", "{}\n");
  put(fs, "\{dir}/pkgs/a/src/one.wac", "export struct P { i32 x; }\n");
  put(fs, "\{dir}/pkgs/b/b.wac", "import { P } from \"../a/src/one.wac\";\nexport P make() { return P(1); }\n");
  put(fs, "\{dir}/pkgs/a/main.wac",
      "import { P } from \"./src/one.wac\";\nimport { make } from \"../b/b.wac\";\n" +
      "export i32 x() { P p = make(); return p.x; }\n");
  Exec r = checkIn(env, procs, "\{dir}/pkgs/a", "main.wac");
  t.eqI32(r.status, 0, "one P — \{said(r)}");
  t.isTrue(contains(said(r), "main.wac: 3 file(s), no diagnostics"), "three files, each once — \{said(r)}");
  fs.remove(dir, true).wait();
  return t.report();
}
