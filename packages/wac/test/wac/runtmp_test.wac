// A concurrent run's working directory is not swept out from under it.
//
// `wac run` and `wac test` build into `$TMPDIR/wac-run-…` and remove it on the way out; a run killed
// before that leaves one behind, and a hundred of them once filled a disk (`issues/system/0136`). So
// there is a sweep — and until 2026-08-25 it swept **by liveness**, removing any `wac-run-<pid>` whose
// `/proc/<pid>` was missing.
//
// **That is sound in one PID namespace and wrong wherever several share a `/tmp`.** A container runner
// gives each its own pids, so a foreign namespace's live pid 4 is absent from ours and its directory —
// in use, being written into — was removed. GitHub issue 22 reported it against this repository's own
// agent environment: "concurrent commands each saw PID 4 and removed/corrupted one another's working
// directory". The name carries a timestamp now so two namespaces cannot pick one directory, and the
// sweep asks *age*, which is the same fact everywhere.
//
// This drives the half that a normal environment can still see: a directory named for a pid that is
// not running, freshly made, is left alone. Under the old rule it was exactly the thing to delete.

import { T } from "../../../wactest/src/assert.wac";
import { binaryPath } from "../../../wactest/src/host.wac";
import { Change, Exec, Stat, ChildEnv, Env, Files, Launch, Procs, Sys } from "std";
import { flatten } from "core";

/**
 * A `wac-run-<digits>` name that no process owns and no other checkout will pick.
 *
 * **All digits after the prefix, and that is the whole point.** The rule this guards against skipped
 * any name whose tail was not a pid, so a planted `wac-run-…-notapid-agent-c` would have survived it
 * too and the test would have passed against the bug. It has to look exactly like what that rule
 * would delete.
 *
 * Above `pid_max` — Linux caps it at 4194304 — so no process can own it however the namespaces are
 * arranged, and offset by the checkout's own name so two agents running this at once do not share a
 * directory.
 */
string plantedDir(Env env) {
  string cwd = flatten(env.cwd().wait()).unwrap();
  // A character's position in a fixed alphabet, not `cwd.indexOf(ch)` — that answers where the
  // character first appears in the path, which is a number about the path's shape rather than about
  // the character, and two checkouts differing in one letter can share it.
  string alphabet = "abcdefghijklmnopqrstuvwxyz0123456789-_/.";
  i32 h = 0;
  for (i32 i = 0; i < cwd.len(); i++) {
    h = (h * 31 + alphabet.indexOf(cwd.slice(i, i + 1)) + 2) % 900000;
  }
  return "/tmp/wac-run-\{90000000 + h}";
}

export string test_a_fresh_run_directory_of_anothers_is_left_alone(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string planted = plantedDir(env);
  fs.remove(planted, true).wait();
  auto made = flatten(fs.mkdir(planted, true).wait());
  t.isTrue(made.isOk(), "planted \{planted} — \{made.isErr() ? "\{made.err()!}" : ""}");
  if (made.isErr()) { return t.report(); }
  auto wrote = flatten(fs.writeFile("\{planted}/in-use.txt", "another run is writing here\n".toBytes()).wait());
  t.isTrue(wrote.isOk(), "and put a file in it — \{wrote.isErr() ? "\{wrote.err()!}" : ""}");

  // Any command that builds sweeps first; `--help` does not, so this runs something.
  auto rRan = flatten(procs.exec(binaryPath(env), ["run"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null), "the binary ran — \{rRan.isErr() ? "\{rRan.err()!}" : ""}");

  Stat? after = flatten(fs.stat(planted).wait()).ok();
  t.isTrue((after is not null && after!.isDir),
           "a freshly made `wac-run-` directory whose pid is not running was swept — that is the "
           + "liveness rule, and it deletes live directories wherever /tmp is shared across PID "
           + "namespaces. See the header.");
  fs.remove(planted, true).wait();
  return t.report();
}
