// `wac sh` is sealed unless the command line asked, and the narrowing cannot widen.
//
// `issues/system/0257c` moves `sh` from a payload the native binary embedded into the one `wac`
// program. `native/v8/src/main.rs`'s `run_shell` served the shell a world built in Rust — no grants
// by default, and `--allow-*` intersected with what the payload carried. A callee in wac shares its
// caller's capabilities, so without `packages/wac/src/grants.wac` the shell would inherit whatever
// the compiler was granted, and `wac sh` would quietly stop being sealed.
//
// **This is a refusal test, so it needs a canary.** "The shell could not read the file" is what a
// broken narrowing and a working one both look like from outside; what distinguishes them is that
// the *granted* case can. Every denial below is paired with the same call through a `Cli` that asked
// for the capability, against the real host — so a narrowing that refused everything unconditionally
// would fail here rather than pass.

import { T } from "../../../wactest/src/assert.wac";
import { Cli, Core, FAULT_NOT_GRANTED, FAULT_NONE } from "std/platform.wac";
import { Asked, Parsed, askedFrom, forCommand, narrowed } from "../../src/grants.wac";

/** The flags are read in order and stop at the first word that is not one. */
export string test_the_grant_flags_are_read_and_the_rest_is_the_shells() {
  T t = T.create();
  string[] argv = string[5](fill: "");
  argv[0] = "sh"; argv[1] = "--allow-read"; argv[2] = "--allow-net"; argv[3] = "-c"; argv[4] = "ls";
  Parsed p = askedFrom(argv, 1);
  t.eqBool(p.asked.read, true, "--allow-read was read");
  t.eqBool(p.asked.net, true, "--allow-net was read");
  t.eqBool(p.asked.write, false, "--allow-write was not asked for");
  t.eqBool(p.asked.env, false, "--allow-env was not asked for");
  t.eqBool(p.asked.run, false, "--allow-run was not asked for");
  t.eqI32(p.at, 3, "the shell's own arguments begin at `-c`");
  t.eqStr(p.bad, "", "nothing was rejected");
  return t.report();
}

/**
 * An unknown grant is reported rather than consumed.
 *
 * `--allow-evrything` silently doing nothing is the failure this rules out: the session would come
 * up sealed, the user would believe it was not, and the first refusal would look like a bug in the
 * shell.
 */
export string test_a_misspelled_grant_is_named() {
  T t = T.create();
  string[] argv = string[3](fill: "");
  argv[0] = "sh"; argv[1] = "--allow-evrything"; argv[2] = "-c";
  Parsed p = askedFrom(argv, 1);
  t.eqStr(p.bad, "--allow-evrything", "the misspelled grant is handed back to be complained about");
  return t.report();
}

/** A word that is not a grant at all ends the flags without being an error. */
export string test_the_flags_end_at_the_first_ordinary_word() {
  T t = T.create();
  string[] argv = string[3](fill: "");
  argv[0] = "sh"; argv[1] = "-c"; argv[2] = "--allow-read";
  Parsed p = askedFrom(argv, 1);
  t.eqI32(p.at, 1, "the flags ended at `-c`");
  t.eqBool(p.asked.read, false, "`--allow-read` after the script is the script's word, not a grant");
  t.eqStr(p.bad, "", "and it is not an error");
  return t.report();
}

/**
 * The filesystem: refused when sealed, and — the canary — answered when asked for.
 *
 * **The file is written by the test, through a granted `Cli`, at an absolute path.** The first
 * version read `wac.json5` from the working directory on the grounds that every host runs from the
 * repository root; there is no such file, so the canary failed with `FAULT_NOT_FOUND` and would have
 * reported the narrowing broken if there had been one. A refusal test whose canary depends on the
 * layout of the checkout is measuring the checkout.
 */
export string test_a_sealed_world_refuses_the_filesystem_and_a_granted_one_does_not(Core core,
                                                                                    Cli cli) {
  T t = T.create();
  string path = "/tmp/wac-grants-canary.txt";

  // Written through a world granted write, which is the first half of the canary: if this fails the
  // rest of the test is about a file that is not there.
  Asked writing = Asked.none();
  writing.write = true;
  Cli writer = narrowed(cli, writing);
  t.eqI32(writer.writeFile(path, "sealed".toBytes()).wait().fault, FAULT_NONE(),
          "a world granted write reaches the filesystem");

  Cli sealed = narrowed(cli, Asked.none());
  t.eqI32(sealed.readFile(path).wait().fault, FAULT_NOT_GRANTED(),
          "a sealed world refuses a read with the code the hosts use");
  t.eqBool(sealed.stat(path).wait().exists, false, "and will not say whether a path exists");
  string[]? listed = sealed.readDir("/tmp").wait();
  t.eqBool(listed is null, true, "and lists no directory");

  // The second half. Same call, same file, through a `Cli` that asked — this must succeed, or the
  // three assertions above are measuring nothing.
  Asked reading = Asked.none();
  reading.read = true;
  Cli reader = narrowed(cli, reading);
  t.eqI32(reader.readFile(path).wait().fault, FAULT_NONE(),
          "a world granted read reaches the file, so the refusals above are the narrowing");
  t.eqStr(string.fromBytes(reader.readFile(path).wait().bytes), "sealed",
          "and reads back what the granted writer put there");

  // Reading was asked for and writing was not: the grants are separate, not one switch.
  t.eqI32(reader.writeFile(path, "no".toBytes()).wait().fault, FAULT_NOT_GRANTED(),
          "read does not carry write with it");
  return t.report();
}

/** The network and the environment, refused the same way and for the same reason. */
export string test_a_sealed_world_refuses_the_network_and_the_environment(Core core, Cli cli) {
  T t = T.create();
  Cli sealed = narrowed(cli, Asked.none());
  t.eqI32(sealed.connect("127.0.0.1", 9).wait().fault, FAULT_NOT_GRANTED(),
          "a sealed world refuses to connect");
  u8[]? path = sealed.env("PATH").wait();
  t.eqBool(path is null, true,
           "and answers null for an environment variable, which is what `Cli.env`'s type says " +
           "`no value` is — see issues/system/0256c on the hosts disagreeing about this");
  return t.report();
}

/**
 * Narrowing cannot widen, which is the property that makes the flags safe.
 *
 * `run_shell` had to check the asked-for grants against the payload's manifest, because a flag that
 * widened would be a hole. This cannot: what it passes on is the capability *this program* was
 * handed, so narrowing twice is still narrow.
 */
export string test_narrowing_a_narrowed_world_does_not_widen_it(Core core, Cli cli) {
  T t = T.create();
  Cli sealed = narrowed(cli, Asked.none());
  Asked everything = Asked(true, true, true, true, true);
  Cli asked = narrowed(sealed, everything);
  t.eqI32(asked.readFile("/tmp/wac-grants-canary.txt").wait().fault, FAULT_NOT_GRANTED(),
          "asking for everything from a sealed world still gets nothing");
  return t.report();
}

/**
 * Each command asks for what it needs, and the four compiler commands cannot reach the network.
 *
 * The table, asserted rather than described: unifying the commands unified their grants, so the seed
 * is built with `--allow-net` because `wac update` clones, and without this a `wac check` runs inside
 * a program that could open a socket. `run` and `test` keep everything on purpose — their flags grant
 * the program they *start*, and a child cannot be handed what its parent does not hold.
 */
export string test_each_command_asks_for_what_it_needs() {
  T t = T.create();
  t.eqBool(forCommand("check").net, false, "check cannot reach the network");
  t.eqBool(forCommand("check").write, false, "check writes nothing — its whole output is a sentence");
  t.eqBool(forCommand("check").read, true, "but it reads sources");
  t.eqBool(forCommand("build").net, false, "build cannot reach the network");
  t.eqBool(forCommand("build").run, false, "and cannot start a process");
  t.eqBool(forCommand("build").write, true, "it writes a module");
  t.eqBool(forCommand("compile").net, false, "nor compile");
  t.eqBool(forCommand("bindgen").net, false, "nor bindgen");
  t.eqBool(forCommand("update").net, true, "update is the one command that reaches the network");
  // `run` and `test` hold everything, because their flags are the narrowing for the child.
  t.eqBool(forCommand("test").net, true, "test keeps net so `--allow-net` can grant it");
  t.eqBool(forCommand("run").run, true, "and run keeps spawn for the program it starts");
  return t.report();
}

/**
 * ...and the policy is enforced, not merely tabulated.
 *
 * **The canary is conditional on this test's own world**, which is the honest shape here: if the
 * suite ran without `--allow-net` then *everything* is refused and the assertion below would pass
 * for the wrong reason. So the ambient capability is measured first, and the canary only runs when
 * there is a capability to narrow. A connection *refused* is not a connection *not granted*, and
 * telling those apart is the whole point of `FAULT_NOT_GRANTED` existing.
 */
export string test_a_build_cannot_open_a_socket(Core core, Cli cli) {
  T t = T.create();
  Cli building = narrowed(cli, forCommand("build"));
  t.eqI32(building.connect("127.0.0.1", 9).wait().fault, FAULT_NOT_GRANTED(),
          "a `wac build` is refused the network by the command's own policy");

  i32 ambient = cli.connect("127.0.0.1", 9).wait().fault;
  if (ambient == FAULT_NOT_GRANTED()) {
    // Nothing to narrow, so nothing was proved above beyond the shape. Said out loud rather than
    // passed quietly: a refusal test whose canary could not run has measured less than it looks.
    return t.report();
  }
  Cli updating = narrowed(cli, forCommand("update"));
  t.eqBool(updating.connect("127.0.0.1", 9).wait().fault != FAULT_NOT_GRANTED(), true,
           "`wac update` keeps the network this world has, so the refusal above is the policy");
  return t.report();
}
