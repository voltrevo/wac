// `wac sh` is sealed unless the command line asked, and the narrowing cannot widen.
//
// `issues/system/0257c` moves `sh` from a payload the native binary embedded into the one `wac`
// program. `native/v8/src/main.rs`'s `run_shell` served the shell a world built in Rust — no grants
// by default, and `--allow-*` intersected with what the payload carried. A callee in wac shares its
// caller's capabilities, so without `packages/wac/src/grants.wac` the shell would inherit whatever
// the compiler was granted, and `wac sh` would quietly stop being sealed.
//
// **This is a refusal test, so it needs a canary.** "The shell could not read the file" is what a
// broken narrowing and a working one both look like from outside; what distinguishes them is that
// the *granted* case can. Every denial below is paired with the same call through handles that asked
// for the capability — so a narrowing that refused everything unconditionally would fail here rather
// than pass.

import { T } from "../../../wactest/src/assert.wac";
import { Authority, Files, MemoryStore, NotGranted, Sys } from "std";
import { Asked, Command, Parsed, askedFrom, authorityOf, commandNamed, filesFor, forCommand, within } from "../../src/grants.wac";

/** The flags are read in order and stop at the first word that is not one. */
export string test_the_grant_flags_are_read_and_the_rest_is_the_shells() {
  T t = T.create();
  string[] argv = string[].filled(5, "");
  argv[0] = "sh"; argv[1] = "--allow-read"; argv[2] = "--allow-net"; argv[3] = "-c"; argv[4] = "ls";
  Parsed p = askedFrom(argv, 1);
  t.eqBool(p.asked.read, true, "--allow-read was read");
  t.eqBool(p.asked.net, true, "--allow-net was read");
  t.eqBool(p.asked.write, false, "--allow-write was not asked for");
  t.eqBool(p.asked.env, false, "--allow-env was not asked for");
  t.eqBool(p.asked.run, false, "--allow-run was not asked for");
  t.eqI32(p.at, 3, "the shell's own arguments begin at `-c`");
  t.eqStr(p.bad, "", "nothing was rejected");
  return t.report();
}

/**
 * An unknown grant is reported rather than consumed.
 *
 * `--allow-evrything` silently doing nothing is the failure this rules out: the session would come
 * up sealed, the user would believe it was not, and the first refusal would look like a bug in the
 * shell.
 */
export string test_a_misspelled_grant_is_named() {
  T t = T.create();
  string[] argv = string[].filled(3, "");
  argv[0] = "sh"; argv[1] = "--allow-evrything"; argv[2] = "-c";
  Parsed p = askedFrom(argv, 1);
  t.eqStr(p.bad, "--allow-evrything", "the misspelled grant is handed back to be complained about");
  return t.report();
}

/** A word that is not a grant at all ends the flags without being an error. */
export string test_the_flags_end_at_the_first_ordinary_word() {
  T t = T.create();
  string[] argv = string[].filled(3, "");
  argv[0] = "sh"; argv[1] = "-c"; argv[2] = "--allow-read";
  Parsed p = askedFrom(argv, 1);
  t.eqI32(p.at, 1, "the flags ended at `-c`");
  t.eqBool(p.asked.read, false, "`--allow-read` after the script is the script's word, not a grant");
  t.eqStr(p.bad, "", "and it is not an error");
  return t.report();
}

/**
 * The filesystem: refused when sealed, and — the canary — answered when asked for.
 *
 * Over a store in memory rather than the disk: what is measured is `filesFor`'s narrowing, and the store
 * answers every operation that was not refused, so a narrowing that refused everything would fail here.
 */
export async string test_a_sealed_world_refuses_the_filesystem_and_a_granted_one_does_not(Sys sys) {
  T t = T.create();
  Files store = MemoryStore.create(sys.clock()).asUser("root");
  string path = "/canary.txt";

  // Written through files granted write, the first half of the canary: if this fails the rest of the test
  // is about a file that is not there.
  Asked writing = Asked.none();
  writing.write = true;
  t.isTrue((await filesFor(store, writing).writeFile(path, "sealed".toBytes())).isOk(),
           "files granted write reach the store");

  Files sealed = filesFor(store, Asked.none());
  match (await sealed.readFile(path)) {
    Ok(b): { t.fail("sealed files read the canary"); }
    Err(e): { t.isTrue(e is NotGranted, "sealed files refuse a read as NotGranted"); }
  }
  t.isTrue((await sealed.stat(path)).isErr(), "and will not say whether a path exists");
  t.isTrue((await sealed.readDir("/")).isErr(), "and list no directory");
  t.isTrue((await sealed.writeFile(path, "x".toBytes())).isErr(), "and write nothing");

  // The second half: the same call on the same file, through files that asked — this must succeed, or the
  // assertions above are measuring nothing.
  Asked reading = Asked.none();
  reading.read = true;
  Files reader = filesFor(store, reading);
  t.eqStr(string.fromBytes((await reader.readFile(path)).orElse(u8[]())), "sealed",
          "files granted read reach the canary, so the refusals above are the narrowing");
  // Reading was asked for and writing was not: the grants are separate, not one switch.
  match (await reader.writeFile(path, "no".toBytes())) {
    Ok(v): { t.fail("read carried write with it"); }
    Err(e): { t.isTrue(e is NotGranted, "read does not carry write with it"); }
  }
  return t.report();
}

/** The network, the environment and running programs: not handed to a child that did not ask. */
export string test_a_sealed_child_is_handed_no_network_environment_or_programs(Sys sys) {
  T t = T.create();
  Authority sealed = authorityOf(Asked.none(), sys.files(), sys.net(), sys.env(), sys.procs());
  t.isTrue(sealed.files is null, "no files");
  t.isTrue(sealed.net is null, "no network");
  t.isTrue(sealed.env is null, "no environment");
  t.isTrue(sealed.procs is null, "no programs");
  t.eqI32(sealed.grants(), 0, "and so no grant bits for the host");
  Authority all = authorityOf(Asked(true, true, true, true, true), sys.files(), sys.net(), sys.env(), sys.procs());
  t.isTrue((all.files is not null) && (all.net is not null) && (all.env is not null) && (all.procs is not null),
           "the canary: asking for everything is handed everything this program holds");
  return t.report();
}

/**
 * Narrowing cannot widen, which is the property that makes the flags safe.
 *
 * What is passed on is a handle *this program* holds, so narrowing twice is still narrow: asking a sealed
 * authority for everything gets nothing.
 */
export string test_narrowing_a_narrowed_world_does_not_widen_it(Sys sys) {
  T t = T.create();
  Authority sealed = authorityOf(Asked.none(), sys.files(), sys.net(), sys.env(), sys.procs());
  Authority asked = within(sealed, Asked(true, true, true, true, true));
  t.isTrue((asked.files is null) && (asked.net is null) && (asked.env is null) && (asked.procs is null),
           "asking for everything from a sealed authority still gets nothing");
  return t.report();
}

/**
 * Each command asks for what it needs, and the four compiler commands cannot reach the network.
 *
 * The table, asserted rather than described: unifying the commands unified their grants, so the seed
 * is built with `--allow-net` because `wac update` clones, and without this a `wac check` runs inside
 * a program that could open a socket. `run` and `test` keep everything on purpose — their flags grant
 * the program they *start*, and a child cannot be handed what its parent does not hold.
 */
export string test_each_command_asks_for_what_it_needs() {
  T t = T.create();
  t.eqBool(forCommand(Command.Check).net, false, "check cannot reach the network");
  t.eqBool(forCommand(Command.Check).write, false, "check writes nothing — its whole output is a sentence");
  t.eqBool(forCommand(Command.Check).read, true, "but it reads sources");
  t.eqBool(forCommand(Command.Build).net, false, "build cannot reach the network");
  t.eqBool(forCommand(Command.Build).run, false, "and cannot start a process");
  t.eqBool(forCommand(Command.Build).write, true, "it writes a module");
  t.eqBool(forCommand(Command.Compile).net, false, "nor compile");
  t.eqBool(forCommand(Command.Bindgen).net, false, "nor bindgen");
  t.eqBool(forCommand(Command.Update).net, true, "update is the one command that reaches the network");
  // `run` and `test` hold everything, because their flags are the narrowing for the child.
  t.eqBool(forCommand(Command.Test).net, true, "test keeps net so `--allow-net` can grant it");
  t.eqBool(forCommand(Command.Run).run, true, "and run keeps spawn for the program it starts");
  // `audit` answers what a program's dependencies can reach by reading their sources; it reaches nothing
  // itself. It had no line and took the default, which was every grant.
  t.eqBool(forCommand(Command.Audit).net, false, "audit cannot reach the network");
  t.eqBool(forCommand(Command.Audit).run, false, "nor start a process");
  t.eqBool(forCommand(Command.Audit).write, false, "nor write");
  return t.report();
}

/**
 * **A command word the table does not know is no command** (issue 0337a): there is no default to fall
 * into, so a command added to the dispatcher without a line here is a compile error in `forCommand`'s
 * `match`, and a word nobody added is refused where it is read.
 */
export string test_an_unknown_command_word_is_no_command() {
  T t = T.create();
  t.isTrue(commandNamed("fmt") is null, "`fmt` is no command");
  t.isTrue(commandNamed("") is null, "nor is nothing");
  string[] all = ["check", "compile", "bindgen", "build", "app", "audit", "validate", "app-run", "task", "update",
                  "self", "run", "test"];
  for (string w in all) { t.isTrue(commandNamed(w) is not null, w + " is a command"); }
  return t.report();
}

/** ...and the policy is enforced, not merely tabulated: what a command hands on is what the table says. */
export string test_a_build_cannot_open_a_socket(Sys sys) {
  T t = T.create();
  // What a build hands on has no network in it, whatever this program holds; the canary is that `update`'s
  // does, out of the same handles.
  Authority building = authorityOf(forCommand(Command.Build), sys.files(), sys.net(), sys.env(), sys.procs());
  t.isTrue(building.net is null, "a `wac build` holds no network by the command's own policy");
  Authority updating = authorityOf(forCommand(Command.Update), sys.files(), sys.net(), sys.env(), sys.procs());
  t.isTrue(updating.net is not null, "`wac update` keeps the network this program has, so the refusal above is the policy");
  return t.report();
}
