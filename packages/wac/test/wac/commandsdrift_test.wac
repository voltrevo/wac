// Every command the dispatcher accepts is named in `wac --help`. GitHub wac#29.
//
//     wac test --allow-read --allow-run --allow-env packages/wac/test/wac/commandsdrift_test.wac
//
// ## Why a derived test rather than a longer usage block
//
// The command surface is two lists: an if-chain of `cmd == "…"` arms, and the string `usage()`
// returns. Nothing tied them together, and they had drifted three times by the time this was
// written — twice with the native host printing lines the block did not have (`issues/system/0257c`
// moved `sh`, `update`, `uninstall` and `app` into the program, and the usage moved after them), and
// once the other way, with `validate`, `app-run`, `covdump`, `ctcompare` and `tracestat` accepted
// and unnamed.
//
// wac#29 reports two of those five. The other three came from asking the dispatcher rather than the
// report, which is the argument for deriving the set here: a test that pins today's list is the same
// kind of thing that was already wrong, and would need editing by whoever adds the sixth.
//
// ## What it does not claim
//
// It reads one file with a fixed pattern, so it is only as good as that pattern — see
// `test_the_derivation_found_the_commands_it_must_find`, which is the floor. That floor is a
// *named set* rather than a count, because "found at least one" would pass on a pattern that
// matched a single arm, and the failure this guards against is a pattern that stops matching a
// spelling somebody changes.
//
// It also does not check the *other* direction — a usage line for a command the dispatcher does not
// accept. That is the harmless direction and naming it here is cheaper than a second scan.

import { T } from "../../../wactest/src/assert.wac";
import { Cli, Core, Exec, FAULT_NONE, FileResult } from "std/platform.wac";
import { contains } from "../../../wactest/src/strings.wac";
import { binaryPath } from "../../../wactest/src/host.wac";
import { itoa } from "../../../fmt/src/itoa.wac";

const string SOURCE = "packages/wac/src/wac.wac";

/** Every `cmd == "…"` the dispatcher tests, in the order it tests them, without duplicates. */
string[] acceptedCommands(string src) {
  string[] found = string[64](fill: "");
  i32 n = 0;
  string needle = "cmd == \"";
  i32 at = 0;
  while (at < src.len()) {
    i32 rel = src.slice(at, src.len()).indexOf(needle);
    if (rel < 0) { break; }
    i32 start = at + rel + needle.len();
    i32 endRel = src.slice(start, src.len()).indexOf("\"");
    if (endRel < 0) { break; }
    string name = src.slice(start, start + endRel);
    at = start + endRel;
    // `--help` and `-h` are flags the dispatcher happens to compare the same way; they are not
    // commands and there is nothing for the list to say about them.
    if (name == "--help" || name == "-h" || name == "help" || name == "") { continue; }
    bool seen = false;
    for (i32 i = 0; i < n; i++) { if (found[i] == name) { seen = true; } }
    if (!seen && n < found.len()) { found[n] = name; n = n + 1; }
  }
  string[] out = string[n](fill: "");
  for (i32 i = 0; i < n; i++) { out[i] = found[i]; }
  return out;
}

export string test_the_derivation_found_the_commands_it_must_find(Core core, Cli cli) {
  T t = T.create();
  // **The floor, and it is a set rather than a count.** If the pattern stops matching — the arms are
  // rewritten as a `switch`, or the spacing changes — this fails here, saying so, instead of the
  // test below passing vacuously over an empty list.
  FileResult raw = cli.readFile(SOURCE).wait();
  t.eqI32(raw.fault, FAULT_NONE(), "could not read " + SOURCE);
  if (raw.fault != FAULT_NONE()) { return t.report(); }
  string[] cmds = acceptedCommands(string.fromBytes(raw.bytes));
  t.isTrue(cmds.len() >= 12, "only " + itoa(cmds.len()) + " commands derived from " + SOURCE);
  string[] must = string[]("check", "build", "run", "test", "update", "app", "validate", "sh");
  for (i32 i = 0; i < must.len(); i++) {
    bool got = false;
    for (i32 j = 0; j < cmds.len(); j++) { if (cmds[j] == must[i]) { got = true; } }
    t.isTrue(got, "the derivation missed `" + must[i] + "`, so its pattern no longer matches");
  }
  return t.report();
}

export string test_every_accepted_command_is_named_in_the_usage_block(Core core, Cli cli) {
  T t = T.create();
  FileResult raw = cli.readFile(SOURCE).wait();
  t.eqI32(raw.fault, FAULT_NONE(), "could not read " + SOURCE);
  if (raw.fault != FAULT_NONE()) { return t.report(); }
  string[] cmds = acceptedCommands(string.fromBytes(raw.bytes));

  Exec r = cli.exec(binaryPath(cli), string[]("--help"), u8[0]()).wait();
  t.isTrue(r.ran(), "wac --help did not run — " + r.error);
  if (!r.ran()) { return t.report(); }
  string help = string.fromBytes(r.stdout) + string.fromBytes(r.stderr);
  t.isTrue(help.len() > 200, "the help output is too short to be the usage block");

  string missing = "";
  for (i32 i = 0; i < cmds.len(); i++) {
    // Two spellings count as named: its own line, `wac <cmd>`, and a share of the combined first
    // line, `wac check|compile|bindgen`. Anything looser would be met by the word turning up inside
    // a flag — `run` is in `--allow-run` on six lines.
    bool named = contains(help, "wac " + cmds[i]) || contains(help, "|" + cmds[i]);
    if (!named) { missing = missing + " " + cmds[i]; }
  }
  t.eqStr(missing, "", "the dispatcher accepts commands `wac --help` does not name —" + missing);
  return t.report();
}

/**
 * A flag a command does not take is refused, and a misspelt *grant* says which mistake it was.
 *
 * **Three shapes, and the difference between them is the point.** `--allow-everything` is nobody's
 * grant, so the reader mistyped one of five words; `--allow-read` is a real grant that `check` simply
 * does not take, so they mistyped which command; `--nonsense` is neither. Collapsing the first into
 * the second is what the code did until 2026-08-29 everywhere except `wac sh`, whose own parser reads
 * grant words and always said so.
 *
 * **And nine commands refused nothing at all.** `wac check --nonsense x.wac` exited **0** — the flag
 * lists lived in `unknownFlag`, `unknownFlagBefore` and `unknownTestFlag`, and only four arms
 * consulted any of them. `flagsFor(cmd)` is one table now, which is what makes a per-command answer
 * possible to assert.
 */
export string test_a_flag_a_command_does_not_take_is_refused(Core core, Cli cli) {
  T t = T.create();
  string prog = "/tmp/wac-flagshape.wac";
  FileResult had = cli.readFile(prog).wait();
  if (!had.ok) {
    cli.writeFile(prog, ("import { Core } from \"std/platform.wac\";\n"
                       + "export i32 main(Core core) { return 0; }\n").toBytes()).wait();
  }

  // A word that is no grant of ours, on a command that does take grants.
  Exec a = cli.exec(binaryPath(cli), string[]("build", "--allow-everything", prog, "-o", "/tmp/wac-flagshape-out"), u8[0]()).wait();
  t.eqI32(a.status, 2, "an invented grant should exit 2: " + string.fromBytes(a.stderr));
  t.isTrue(contains(string.fromBytes(a.stderr), "is not a grant"),
           "an invented grant should say so: " + string.fromBytes(a.stderr));

  // A real grant, on a command that has none. Not the same mistake, and not the same sentence.
  Exec b = cli.exec(binaryPath(cli), string[]("check", "--allow-read", prog), u8[0]()).wait();
  t.eqI32(b.status, 2, "a grant `check` does not take should exit 2: " + string.fromBytes(b.stderr));
  t.isTrue(contains(string.fromBytes(b.stderr), "unknown flag"),
           "a real grant on the wrong command is an unknown flag: " + string.fromBytes(b.stderr));
  t.isTrue(!contains(string.fromBytes(b.stderr), "is not a grant"),
           "...and must not be called an invented one: " + string.fromBytes(b.stderr));

  // Neither. The refusal names what the command *does* take, which the old fixed string could not.
  Exec c = cli.exec(binaryPath(cli), string[]("audit", "--nonsense", prog), u8[0]()).wait();
  t.eqI32(c.status, 2, "an unknown flag should exit 2: " + string.fromBytes(c.stderr));
  t.isTrue(contains(string.fromBytes(c.stderr), "--verbose"),
           "the refusal should say what `audit` takes: " + string.fromBytes(c.stderr));

  // **A tail is not this command's to judge.** `wac task map --check` is the spelling `CLAUDE.md`
  // documents and the doc lane runs: `--check` belongs to the task, not to `wac task`. Making the
  // task *name* end the flag scan is what was missing — the first version stopped only at `--`, so a
  // documented invocation started answering *unknown flag* and the doc lane went red.
  //
  // Asserted against a task that does not exist, so this stays a question about argument boundaries
  // rather than about whatever the tree's tasks happen to do.
  Exec tail = cli.exec(binaryPath(cli), string[]("task", "no-such-task", "--check"), u8[0]()).wait();
  t.isTrue(!contains(string.fromBytes(tail.stderr), "unknown flag"),
           "`--check` after a task name is the task's: " + string.fromBytes(tail.stderr));
  t.isTrue(contains(string.fromBytes(tail.stderr), "no-such-task"),
           "and the refusal is about the task: " + string.fromBytes(tail.stderr));

  // ...while a flag *before* the name is still this command's, and it has none.
  Exec before = cli.exec(binaryPath(cli), string[]("task", "--nonsense"), u8[0]()).wait();
  t.isTrue(contains(string.fromBytes(before.stderr), "unknown flag"),
           "a flag before the task name is `wac task`'s: " + string.fromBytes(before.stderr));

  // **The canary.** `check` took no flag check at all until this table existed, and exited 0 on
  // anything — so a test that only asserted refusals would have passed on the broken build by
  // never reaching a command that answered. This is the same command with nothing wrong.
  Exec ok = cli.exec(binaryPath(cli), string[]("check", prog), u8[0]()).wait();
  t.eqI32(ok.status, 0, "the same command without a flag should succeed: " + string.fromBytes(ok.stderr));

  cli.remove(prog, false).wait();
  return t.report();
}
