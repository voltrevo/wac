// `wac build` remembers what it built, and a hit is the bytes a fresh build would have written.
//
//     wac test --allow-read --allow-write --allow-run --allow-env packages/wac/test/wac/buildcache_test.wac
//
// `[§wac-cli-build-cache-7pk3mq9]` `[§wac-cli-build-nocache-2wq9nk4]`
//
// `issues/system/0204`. `wac build` compiled from source every time — box's shell is about five
// seconds of it — and the tests that build an application and run it pay that per run, which is what
// stops the rest of `issues/system/0161` converting off TypeScript.
//
// **The claim is byte equality, not speed.** A cache that is merely fast is a cache nobody can trust:
// the failure mode is serving a module built from something else, silently, and `issues/lang/0241c`
// cost two wrong diagnoses to exactly that three days ago. So the oracle here is a cold build and a
// warm one compared byte for byte, and a perturbed source that must *not* match.
//
// **The subject is the checkout's command, not the binary's seed.** The binary carries a *seed* — the
// compiler as it was when the seed was last built — so a plain `wac build` here would test the compiler
// this change is not in. The checkout's own `wac.wac` is built to a module and *that* is what every case
// runs: the seed compiles it and does not answer for it, which is what makes these cases able to fail.
//
// **Built once, rather than compiled inside every case.** Until 2026-08-29 each build went through
// `wac run … wac.wac`, which compiles the command before running it — and since every case points
// `$WAC_HOME` at a fresh directory, that compile was cold six times over. The file was 102s of the
// suite's 520s and this was essentially all of it: 10.7s a compile, and `test_the_directory_is_bounded`
// paid it three times over at 33.9s, because with the bound at two the compile's *own* cache entry was
// evicted by the very builds that case was making. The module is produced by an ordinary `wac build`,
// so the build cache decides when it is stale — keyed on the compiler and on every source, which is the
// only staleness check here that cannot be wrong about which compiler is under test. **102.2s to 6.6s**,
// and the floor is one compile of `wac.wac` on the first run after the compiler changes.
//
// **The saving is not the evidence that it still works.** Nothing here would have gone red if the module
// being run were the binary's seed rather than the checkout's — the seed also caches, and every case
// would have gone on passing while testing a compiler nobody had edited. So the check was made
// deliberately: `cacheKey` was cut to `return ""` in `packages/wac/src/wac.wac` and five of the six cases
// failed. The sixth is the warning one, which is what a compiler with no cache *should* do.
//
// The bound is exercised through `$WAC_BUILD_CACHE_KEEP` because proving eviction otherwise costs
// sixty-five real builds; the cache directory is `$WAC_HOME`'s, so each case gets a home of its own.
//
// **Each home holds only what its own case put there**, which is why the counts below are totals. While
// the command was compiled per case there was an entry for *it* in every home, so a total could not be
// asserted: each case measured the *change* across its own build, and to find its own entry it matched
// on the length of the bytes it had just written. Both of those are gone, and the count a case asserts
// is now a statement about the cache rather than about what else happened to be running.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli, Exec, FileResult } from "std/platform.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { wacBinary } from "../../../wactest/src/built.wac";
import { freshDir, madeDir, putFile } from "../../../wactest/src/host.wac";

const string WACC = "packages/wac/src/wac.wac";

/** Where the checkout's command is built to; `.wasm` beside it is what these cases run. */
string runnerStem(Cli cli) { return cli.cwd().wait() + "/.cache/buildcache-runner/wac"; }

/**
 * Build the checkout's command as a module, and answer why not.
 *
 * Called by every case rather than once, because a wac test file is a set of exported functions with
 * nowhere to put a value between them. It costs what a cache hit costs — 0.3s against the 10.7s of the
 * compile it replaces — and asking `wac build` every time is the point: a hand-rolled freshness check
 * would need this file to know `wac.wac`'s import graph, and a wrong list there does not fail, it
 * silently certifies the cache using a compiler nobody built.
 *
 * The grants are the ones the old `wac run` line passed, and they are baked into the manifest here
 * instead — `wac <module>.wasm` runs under the grants its manifest declares, so this is the same
 * program with the same authority, reached without a compile.
 */
string runnerWhyNot(Cli cli) {
  // **The directory, because `wac build -o dir/stem` does not create `dir`.** Every case here
  // depended on it already existing, which it does after any earlier run — so this file passed on
  // every machine that had run it before and would have failed on a fresh clone. It went red when
  // the directory went away for unrelated reasons, and the message said nothing about a directory
  // this file was supposed to own: `wacc: cannot write …/wac.wasm — No such file or directory`.
  //
  // `madeDir` rather than `freshDir`: the point of building here is that it is a *cache hit* —
  // 0.3s against 10.7s — and emptying the directory first would throw that away every run.
  string whyDir = madeDir(cli, cli.cwd().wait() + "/.cache/buildcache-runner");
  if (whyDir != "") { return whyDir; }
  Exec r = cli.execWith(wacBinary(cli),
      string[]("build", WACC, "-o", runnerStem(cli), "--quiet",
               "--allow-read", "--allow-write", "--allow-env", "--allow-run"),
      u8[0](), string[0](fill: ""), false, false).wait();
  if (!r.ran()) { return "could not run " + wacBinary(cli) + " — " + r.error; }
  if (r.status != 0) {
    return "building " + WACC + " as a module failed: " + string.fromBytes(r.stderr);
  }
  return "";
}

/**
 * One `wac build` of `entry` to `stem`, under `home`, with an optional keep override and one extra
 * flag — `""` for neither.
 *
 * **One function where there were three.** They differed in which of those two they took, and the
 * grant one differed from the flag one in nothing at all: both appended a single argument after
 * `--quiet`. `--allow-read` and `--no-cache` are the same shape of thing to a command line.
 */
i32 build(Cli cli, string home, string keep, string entry, string stem, string flag) {
  string[] args = flag == ""
      ? string[](runnerStem(cli) + ".wasm", "build", entry, "-o", stem, "--quiet")
      : string[](runnerStem(cli) + ".wasm", "build", entry, "-o", stem, "--quiet", flag);
  string[] env = keep == "" ? string[]("WAC_HOME=" + home)
                            : string[]("WAC_HOME=" + home, "WAC_BUILD_CACHE_KEEP=" + keep);
  Exec r = cli.execWith(wacBinary(cli), args, u8[0](), env, false, false).wait();
  return r.ran() ? r.status : 0 - 1;
}

/**
 * The one entry in `home`'s build cache, or `""` if there is not exactly one.
 *
 * A case that poisons an entry has to name it, and while the command was compiled per case this had to
 * *guess*: it took whichever file matched the length of the bytes the build had just written, because
 * the compile's own entry — a much larger module — was sitting in the same directory. Now there is one
 * file and the guess is a count.
 */
string onlyEntry(Cli cli, string home) {
  string[]? names = cli.readDir(home + "/cache/build").wait();
  if ((names is null) || names!.len() != 1) { return ""; }
  return home + "/cache/build/" + names![0];
}

i32 entriesIn(Cli cli, string dir) {
  string[]? names = cli.readDir(dir).wait();
  return names is null ? 0 : names!.len();
}

u8[] bytesOf(Cli cli, string path) {
  FileResult r = cli.readFile(path).wait();
  return r.ok ? r.bytes : u8[0]();
}

export string test_a_repeat_build_is_the_same_bytes_and_no_second_entry(Core core, Cli cli) {
  T t = T.create();
  string dir = cli.cwd().wait() + "/.cache/buildcache-same";
  t.isTrue(freshDir(cli, dir) == "", "the fixture directory could not be made");
  string home = dir + "/home";
  string entry = dir + "/p.wac";
  t.isTrue(putFile(cli, entry, "export i32 f() { return 1; }\n") == "", "could not write the program");

  string why = runnerWhyNot(cli);
  t.isTrue(why == "", why);

  t.eqI32(entriesIn(cli, home + "/cache/build"), 0, "a fresh home already had entries in it");
  t.eqI32(build(cli, home, "", entry, dir + "/out", ""), 0, "the cold build failed");
  u8[] cold = bytesOf(cli, dir + "/out.wasm");
  t.isTrue(cold.len() > 8, "the cold build wrote nothing");
  t.eqI32(entriesIn(cli, home + "/cache/build"), 1, "the cold build did not remember what it built");

  t.eqI32(build(cli, home, "", entry, dir + "/out", ""), 0, "the warm build failed");
  t.eqBytes(bytesOf(cli, dir + "/out.wasm"), cold,
      "the cache served bytes a fresh build would not have written");
  t.eqI32(entriesIn(cli, home + "/cache/build"), 1,
      "the second build wrote another entry, so the key is not stable across runs");

  // **And the hit is real, which byte equality alone cannot show.** A fresh compile is deterministic,
  // so "cold and warm agree" is equally true of a cache that stores and never reads. Overwriting the
  // one entry with something recognisable and building again is what distinguishes them: the build
  // must hand back the marker, because the only way to produce it is to have read the cache.
  string mine = onlyEntry(cli, home);
  t.isTrue(mine != "", "this build's own entry is not in the cache");
  if (mine != "") {
    string marker = "not a module, but longer than a header";
    t.isTrue(putFile(cli, mine, marker) == "", "could not overwrite the cache entry");
    t.eqI32(build(cli, home, "", entry, dir + "/out", ""), 0, "the build after poisoning failed");
    t.eqBytes(bytesOf(cli, dir + "/out.wasm"), marker.toBytes(),
        "the build did not read the cache — it recompiled, so every `wac build` still pays full price "
        + "and the saving this issue is about is not there");
  }

  cli.remove(dir, true).wait();
  return t.report();
}

export string test_a_changed_source_is_a_miss(Core core, Cli cli) {
  T t = T.create();
  string dir = cli.cwd().wait() + "/.cache/buildcache-miss";
  t.isTrue(freshDir(cli, dir) == "", "the fixture directory could not be made");
  string home = dir + "/home";
  string entry = dir + "/p.wac";
  t.isTrue(putFile(cli, entry, "export i32 f() { return 1; }\n") == "", "could not write the program");
  string why = runnerWhyNot(cli);
  t.isTrue(why == "", why);
  t.eqI32(build(cli, home, "", entry, dir + "/out", ""), 0, "the first build failed");
  u8[] first = bytesOf(cli, dir + "/out.wasm");

  t.isTrue(putFile(cli, entry, "export i32 f() { return 1; }\nexport i32 g() { return 2; }\n") == "",
      "could not rewrite the program");
  t.eqI32(build(cli, home, "", entry, dir + "/out", ""), 0, "the second build failed");
  u8[] second = bytesOf(cli, dir + "/out.wasm");

  t.isTrue(second.len() != first.len(),
      "an edited source produced the same artefact — the cache is keyed on something that did not "
      + "change with it, which is the stale hit this cache exists to avoid");
  t.eqI32(entriesIn(cli, home + "/cache/build"), 2, "the edit did not produce another entry");

  cli.remove(dir, true).wait();
  return t.report();
}

export string test_the_directory_is_bounded(Core core, Cli cli) {
  T t = T.create();
  string dir = cli.cwd().wait() + "/.cache/buildcache-bound";
  t.isTrue(freshDir(cli, dir) == "", "the fixture directory could not be made");
  string home = dir + "/home";
  string why = runnerWhyNot(cli);
  t.isTrue(why == "", why);
  for (i32 i = 0; i < 4; i++) {
    string entry = dir + "/p" + itoa(i) + ".wac";
    t.isTrue(putFile(cli, entry, "export i32 f() { return " + itoa(i) + "; }\n") == "",
        "could not write program " + itoa(i));
    t.eqI32(build(cli, home, "2", entry, dir + "/out" + itoa(i), ""), 0,
        "build " + itoa(i) + " failed");
  }
  t.eqI32(entriesIn(cli, home + "/cache/build"), 2,
      "four builds with a bound of two left a directory that only grows — `issues/system/0136` is the "
      + "day that filled this disk");

  // And zero turns it off, which is the switch a caller needs when a cache is the thing under suspicion.
  string off = dir + "/off";
  t.eqI32(build(cli, off, "0", dir + "/p0.wac", dir + "/outoff", ""), 0, "the build with keep=0 failed");
  t.eqI32(entriesIn(cli, off + "/cache/build"), 0, "keep=0 still wrote an entry");

  cli.remove(dir, true).wait();
  return t.report();
}

/**
 * A build's **grants** are part of what it is, so they are part of the key.
 *
 * This is the case where a wrong hit would not merely be stale but *wrong about capabilities*: the
 * grants are baked into the manifest by `wac build`, which is what makes them unforgeable by editing
 * the file afterwards. A cache that keyed on the sources alone would hand a program built
 * `--allow-read` to a build that asked for nothing — and the module would run with a capability
 * nobody granted it.
 *
 * Four builds to **one destination**, because the output's name is in the manifest too: varying both at
 * once is how the first version of this check managed to report a nondeterministic compiler.
 */
export string test_a_grant_is_part_of_the_key(Core core, Cli cli) {
  T t = T.create();
  string dir = cli.cwd().wait() + "/.cache/buildcache-grants";
  t.isTrue(freshDir(cli, dir) == "", "the fixture directory could not be made");
  string home = dir + "/home";
  string entry = dir + "/g.wac";
  t.isTrue(putFile(cli, entry,
      "import { Core, Cli } from \"std/platform.wac\";\n"
      + "export i32 main(Core core, Cli cli) { core.log(\"hi\"); return 0; }\n") == "",
      "could not write the program");
  string out = dir + "/gx";
  string why = runnerWhyNot(cli);
  t.isTrue(why == "", why);

  t.eqI32(build(cli, home, "", entry, out, ""), 0, "the ungranted build failed");
  u8[] plain = bytesOf(cli, out + ".wasm");
  i32 afterPlain = entriesIn(cli, home + "/cache/build");

  t.eqI32(build(cli, home, "", entry, out, "--allow-read"), 0, "the granted build failed");
  u8[] granted = bytesOf(cli, out + ".wasm");
  t.isTrue(granted.len() != plain.len() || !sameBytes(granted, plain),
      "asking for `--allow-read` produced the same bytes as asking for nothing. Two readings, and the "
      + "next assertion tells them apart: either the manifest is not carrying grants at all — in which "
      + "case this test can say nothing about the key — or the cache served the ungranted entry to the "
      + "granted build, which is the capability bug this case exists for");
  t.isTrue(entriesIn(cli, home + "/cache/build") > afterPlain,
      "the grant did not produce its own entry — the key does not see grants");

  // And asking again for *no* grant gets the ungranted module back, not whichever was cached last.
  t.eqI32(build(cli, home, "", entry, out, ""), 0, "the second ungranted build failed");
  t.eqBytes(bytesOf(cli, out + ".wasm"), plain,
      "the cache served the granted module to a build that asked for nothing — a program would run "
      + "with a capability nobody gave it");

  cli.remove(dir, true).wait();
  return t.report();
}

/** Byte equality without an assertion, for a claim that is about two lengths first. */
bool sameBytes(u8[] a, u8[] b) {
  if (a.len() != b.len()) { return false; }
  for (i32 i = 0; i < a.len(); i++) { if (a[i] != b[i]) { return false; } }
  return true;
}

// **A build that has to prove something about the compiler must not be answered from disk.**
//
// `issues/system/0204` argued `wac build` should never be cached, and the reason it gave was this:
// `packages/wacc/test/wac/selfhost_test.wac` builds the compiler twice and requires the two artefacts
// to be byte-identical, so a content-keyed cache turns it into *"these bytes equal themselves"* — a
// test that cannot fail, still passing, with nobody told. The cache was built anyway, and the
// prediction was exactly right: with a warm cache that test ran in **194 ms** against a documented 3 s
// of two compiler builds, and it still passed after its cache entry was replaced with a *different
// valid module* — certifying as a fixed point an artefact the compiler had not produced.
//
// So the cache keeps its default and the determinism tests say what they need. `--no-cache` is neither
// read nor write: a caller asking for a real build gets one, and the poisoned entry it did not read is
// still poisoned afterwards, which is how this says "did not write" without a second run to count.
export string test_no_cache_neither_reads_nor_writes(Core core, Cli cli) {
  T t = T.create();
  string dir = cli.cwd().wait() + "/.cache/buildcache-nocache";
  t.isTrue(freshDir(cli, dir) == "", "the fixture directory could not be made");
  string home = dir + "/home";
  string entry = dir + "/p.wac";
  t.isTrue(putFile(cli, entry, "export i32 f() { return 1; }\n") == "", "could not write the program");

  string why = runnerWhyNot(cli);
  t.isTrue(why == "", why);

  t.eqI32(build(cli, home, "", entry, dir + "/out", ""), 0, "the cold build failed");
  u8[] cold = bytesOf(cli, dir + "/out.wasm");
  t.isTrue(cold.len() > 8, "the cold build wrote nothing");

  string ent = onlyEntry(cli, home);
  t.isTrue(ent != "", "this build's own entry is not in the cache");
  if (ent == "") { return t.report(); }

  string marker = "not a module, but longer than a header";
  t.isTrue(putFile(cli, ent, marker) == "", "could not overwrite the cache entry");

  // **The control, and it is not optional.** If the poisoned entry were *not* served, the assertion
  // below would pass on a cache that never hits, and say nothing about the flag.
  t.eqI32(build(cli, home, "", entry, dir + "/out", ""), 0, "the control build failed");
  t.isTrue(sameBytes(bytesOf(cli, dir + "/out.wasm"), marker.toBytes()),
      "the control build did not read the cache, so this test cannot say anything about --no-cache");

  t.eqI32(build(cli, home, "", entry, dir + "/out", "--no-cache"), 0,
      "`wac build --no-cache` did not build — an unknown flag is refused, which is what this looks "
      + "like before the flag exists");
  u8[] fresh = bytesOf(cli, dir + "/out.wasm");
  t.isTrue(fresh.len() > 8 && fresh[0] == 0 && fresh[1] == 'a' && fresh[2] == 's' && fresh[3] == 'm',
      "`--no-cache` was served the poisoned entry rather than compiling — so a determinism test "
      + "asking for a real build would be comparing the cache with itself");

  FileResult still = cli.readFile(ent).wait();
  t.isTrue(still.ok && sameBytes(still.bytes, marker.toBytes()),
      "`--no-cache` wrote its result to the cache, so it is a half-measure: the next ordinary build "
      + "would hit an entry this run created");

  cli.remove(dir, true).wait();
  return t.report();
}

/** One `wac build` under `home`, answering everything it printed. */
string outputOf(Cli cli, string home, string entry, string stem) {
  Exec r = cli.execWith(wacBinary(cli),
      string[](runnerStem(cli) + ".wasm", "build", entry, "-o", stem),
      u8[0](), string[]("WAC_HOME=" + home), false, false).wait();
  if (!r.ran()) { return "(did not run: " + r.error + ")"; }
  return string.fromBytes(r.stdout) + string.fromBytes(r.stderr);
}

// **A warning survives the cache, because a warning nobody sees is not a warning.**
//
// `spec/cli/wac.md` `[§wac-cli-usage-3nkq8wj]` says warnings print and do not change the exit code,
// and *"are not held back for `check` or suppressed on a command that also writes a file"*. A hit
// returns above the diagnostics pass, so the first build of a warned program printed its warning and
// every later one did not — the same source and the same command line saying two different things,
// decided by whether anybody had built it before. That is the shape of the flag bug in this file's
// neighbour test, arriving at a documented clause rather than at an error message.
//
// **Fixed by not storing a build that warned**, rather than by replaying the text: a warned program
// recompiles every time, which costs a little and cannot go quietly wrong. The alternative — keeping
// the diagnostics beside the artefact — is a second file to write, evict and validate, for a case the
// repository would rather fix than cache.
export string test_a_warning_is_not_swallowed_by_a_hit(Core core, Cli cli) {
  T t = T.create();
  string dir = cli.cwd().wait() + "/.cache/buildcache-warn";
  t.isTrue(freshDir(cli, dir) == "", "the fixture directory could not be made");
  string home = dir + "/home";
  string entry = dir + "/w.wac";
  // Two structs with no ancestor in common: `is` between them is always false, and legal.
  t.isTrue(putFile(cli, entry,
      "struct A { i32 v; }\nstruct B { i32 w; }\n"
      + "export i32 main() {\n  A x = A(1);\n  if (x is B) { return 1; }\n  return 0;\n}\n") == "",
      "could not write the program");
  string why = runnerWhyNot(cli);
  t.isTrue(why == "", why);

  string cold = outputOf(cli, home, entry, dir + "/w");
  t.isTrue(cold.indexOf("warning") >= 0,
      "the cold build printed no warning, so this test is not about what it thinks: " + cold);

  string warm = outputOf(cli, home, entry, dir + "/w");
  t.isTrue(warm.indexOf("warning") >= 0,
      "the second build of the same source printed no warning — the cache answered above the "
      + "diagnostics pass, so a documented clause holds only until somebody builds the program "
      + "once: " + warm);

  cli.remove(dir, true).wait();
  return t.report();
}
