// Three writes, alternating streams, for `interleave_test.wac`.
//
// The middle one goes to standard error and the two around it to standard output, so the only thing
// this program can tell you is whether the order between the two streams survived. Nothing here is
// slow or large on purpose: the bug it exists for is a race between two queues, and a race is
// clearest when there is nothing else happening.

import { Sys, Output } from "std";

export i32 main(Sys sys) {
  Output err = sys.stderr();
  Output out = sys.stdout();
  out.write("one\n".toBytes());
  err.line("mid");
  out.write("two\n".toBytes());
  return 0;
}
