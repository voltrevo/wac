// Two reads in flight at once — what the ticket surface is actually for.
//
// `readFile` returns before the read has happened. Both are running while this program is
// between the two lines, and `wait()` collects whichever it asks for.

import { Cli, Core, FileResult, Pending } from "../src/platform.wac";

export i32 main(Core core, Cli cli) {
  if (cli.argCount().wait() < 2) {
    core.warn("usage: overlap <file> <file>");
    return 2;
  }

  Pending<FileResult> a = cli.readFile(string.fromBytes(cli.arg(0).wait()));
  Pending<FileResult> b = cli.readFile(string.fromBytes(cli.arg(1).wait()));

  // Nothing has been waited for yet. Both reads are in the host's hands.
  //
  // **This line has two legal answers and which one you get is a race.** `isDone` is documented as
  // "whether `wait` would return immediately", and no host promises *when* a read completes.
  //
  // Measured, and the measurement is the point: on an idle machine Deno says "one finished already"
  // every time and the native runtime says "both still running" every time, which looks exactly like
  // a property of each host — and under load Deno says "both still running" too. It is a race, not a
  // difference between the two, and the first version of this comment recorded the idle answers as a
  // rule. A stable observation is not a guarantee.
  //
  // Which makes it the clearest thing in this repo to point at for design/0001's D12: in a
  // deterministic mode this answer would be the scheduler's rather than the machine's load.
  core.log(a.isDone() || b.isDone() ? "one finished already" : "both still running");

  FileResult ra = a.wait();
  FileResult rb = b.wait();
  if (!ra.ok || !rb.ok) {
    core.warn("overlap: " + (ra.ok ? rb.error : ra.error));
    return 1;
  }
  core.log(itoa(ra.bytes.len()) + " + " + itoa(rb.bytes.len()) + " bytes");
  return 0;
}

/** Decimal, without pulling `fmt` in for a demonstration. */
string itoa(i32 n) {
  if (n == 0) { return "0"; }
  i32 v = n;
  u8[] digits = u8[12](fill: 0);
  i32 at = 12;
  while (v > 0) { at--; digits[at] = '0' + (v % 10); v = v / 10; }
  u8[] used = u8[12 - at](fill: 0);
  used.copyFrom(digits, at, 0, 12 - at);
  return string.fromBytes(used);
}
