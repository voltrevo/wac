// Life, seeded from a file you drop — so the pattern is yours rather than one we chose.
//
//   wac run --allow-read --allow-write --allow-run packages/web/tools/build.wac \
//       packages/platform/example/life.wac .cache/life --page ./packages/web
//
// Conway's rule is four lines. What makes this worth a page is the seed: drop any file and its bytes
// become the starting grid, one bit per cell. A photograph, a wasm module, this page's own source —
// each gives a pattern nobody has seen, and the interesting part is how *unalike* they look after
// twenty generations. Structured files settle into gliders and blocks quickly; compressed ones churn
// for hundreds of steps, because high entropy is what "random soup" means and a `.zip` is as close to
// soup as a real file gets.
//
// ## What this is not
//
// **It proves nothing, and that is on purpose.** Everything else in this repository is measured
// against something that would disagree — bash, OpenSSL, real git. This is here because a system you
// can only read about is less convincing than one you can play with, and a demonstration that is
// honestly a toy is better than one dressed up as evidence.
//
// The one real claim it makes is incidental: the timer below runs a cellular automaton over 128×96
// cells every 60 ms, in WebAssembly compiled from wac, and the millisecond counter is not decoration.
//
// It is a component (`packages/web`'s `view.wac`): the grid is kept across renders, a timer and a file
// watcher start once from an effect, and another effect paints the canvas, named by a `ref`, after each
// render that changed it.

import { ElementEvent, Node, Page, Picked, Ref, State, Ui, html.a, html.b, html.button, html.canvas, html.code, html.div, html.footer, html.h1, html.input, html.p, html.span, html.style } from "../../web";

static string SOURCE =
  "https://github.com/voltrevo/wac/blob/master/packages/platform/example/life.wac";

static string STYLE =
  ":root { --ink: #f7f9f9; --slab: #fff; --line: #dbe4e3; --text: #0b1a1d;" +
  "        --dim: #5b7073; --key: #0e8c78; }" +
  "@media (prefers-color-scheme: dark) {" +
  "  :root { --ink: #0b1416; --slab: #101f23; --line: #1e363c; --text: #dce8e7;" +
  "          --dim: #8ba3a4; --key: #46d9c0; } }" +
  "body { background: var(--ink); color: var(--text); }" +
  "#tool { max-width: 44rem; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }" +
  "h1 { font-size: 1.35rem; margin: 0 0 .3rem; letter-spacing: -0.02em; }" +
  "p.sub { margin: 0 0 1.2rem; color: var(--dim); font-size: .95rem; }" +
  "canvas { width: 100%; image-rendering: pixelated; border: 1px solid var(--line);" +
  "         border-radius: 6px; background: #101f23; display: block; }" +
  "#row { display: flex; gap: .7rem; align-items: center; flex-wrap: wrap; margin: .9rem 0; }" +
  "button { font: inherit; font-size: .88rem; padding: .3rem .8rem; cursor: pointer;" +
  "         color: var(--text); background: var(--slab); border: 1px solid var(--line);" +
  "         border-radius: 5px; }" +
  "button:hover { border-color: var(--key); color: var(--key); }" +
  "input[type=file] { font: inherit; font-size: .85rem; color: var(--dim); }" +
  "code { font-family: ui-monospace, monospace; font-size: .9em; }" +
  ".dim { color: var(--dim); font-size: .88rem; }" +
  "footer { margin-top: 1.6rem; font-size: .85rem; color: var(--dim); }" +
  "footer a { color: var(--key); }";

static i32 W = 128;
static i32 H = 96;
/** Each cell is this many screen pixels square, so the canvas is 512×384. */
static i32 SCALE = 4;

/** Neighbours of `(x, y)` that are alive, with the edges wrapped. */
i32 around(u8[] cells, i32 x, i32 y) {
  i32 n = 0;
  for (i32 dy = -1; dy <= 1; dy++) {
    for (i32 dx = -1; dx <= 1; dx++) {
      if (dx == 0 && dy == 0) { continue; }
      // Wrapped rather than clipped: a glider that walks off the edge coming back on the other side
      // is the behaviour people expect from this, and clipping makes the borders die in a way that
      // looks like a bug in the rule.
      i32 nx = (x + dx + W) % W;
      i32 ny = (y + dy + H) % H;
      n = n + cells[ny * W + nx] as i32;
    }
  }
  return n;
}

/** One generation, written into `next`. */
void step(u8[] cells, u8[] next) {
  for (i32 y = 0; y < H; y++) {
    for (i32 x = 0; x < W; x++) {
      i32 n = around(cells, x, y);
      i32 alive = cells[y * W + x] as i32;
      // B3/S23, which is the whole of Conway's rule.
      next[y * W + x] = (alive == 1 ? (n == 2 || n == 3) : (n == 3)) ? 1 : 0;
    }
  }
}

/** The grid, as pixels: living cells in the accent, dead in the background. */
void paint(u8[] cells, u8[] rgba) {
  for (i32 y = 0; y < H; y++) {
    for (i32 x = 0; x < W; x++) {
      bool on = cells[y * W + x] == 1;
      for (i32 sy = 0; sy < SCALE; sy++) {
        for (i32 sx = 0; sx < SCALE; sx++) {
          i32 at = (((y * SCALE + sy) * (W * SCALE)) + (x * SCALE + sx)) * 4;
          rgba[at] = on ? 70 : 16;
          rgba[at + 1] = on ? 217 : 31;
          rgba[at + 2] = on ? 192 : 35;
          rgba[at + 3] = 255;
        }
      }
    }
  }
}

/**
 * Fill the grid from `seed`'s bits, one bit per cell, repeating if the file is short.
 *
 * A file shorter than 1,536 bytes tiles rather than leaving the rest dead, because a mostly-empty
 * grid dies in two generations and looks like the page is broken.
 */
void sow(u8[] cells, u8[] seed) {
  if (seed.len() == 0) { return; }
  for (i32 i = 0; i < W * H; i++) {
    i32 byte = seed[(i / 8) % seed.len()] as i32;
    cells[i] = ((byte >> (i % 8)) & 1) as@ u8;
  }
}

/**
 * The simulation, kept from one render to the next: the grid, its scratch copy and its pixels are
 * buffers rewritten in place, not state — a render shows them, and `shown` says when they changed.
 */
struct Grid { u8[] cells; u8[] next; u8[] rgba; u8[] seed; i32 gen; i32 live; i32 ms; }

Grid fresh() {
  // Something to watch before anything is dropped: this page's own title, which is as arbitrary a
  // seed as any and makes the first frame non-empty.
  Grid g = Grid(u8[].filled(W * H, 0), u8[].filled(W * H, 0), u8[].filled(W * SCALE * H * SCALE * 4, 0),
                "wac: life, seeded from whatever you give it".toBytes(), 0, 0, 0);
  sow(g.cells, g.seed);
  return g;
}

/** Each file dropped or picked, for as long as the page lives: its bytes become the seed. */
async void seeds(Page page, Grid g, State<string> note, State<i32> shown) {
  while (true) {
    Picked f = await page.nextFile();
    if (!f.ok) {
      note.set("could not read it: \{f.error}");
      continue;
    }
    g.seed = f.bytes;
    sow(g.cells, g.seed);
    g.gen = 0;
    note.set("\{f.name} — \{f.bytes.len()} bytes of seed");
    shown.update((i32 n) => n + 1);
  }
}

Node Life(Ui ui, Page page) {
  auto running = ui.state(true);
  auto note = ui.state("or drop one anywhere on this page");
  auto shown = ui.state(0);
  Grid g = ui.memo<Grid>("", () => fresh());
  Ref c = ui.ref();
  // Once: a generation every 60 ms while running, and a new seed whenever a file arrives.
  ui.effect("", () => {
    seeds(page, g, note, shown);
    return ui.every(60, () => {
      if (!running.get()) { return; }
      f64 began = page.now();
      step(g.cells, g.next);
      for (i32 i = 0; i < W * H; i++) { g.cells[i] = g.next[i]; }
      g.ms = (page.now() - began) as~ i32;
      g.gen = g.gen + 1;
      i32 live = 0;
      for (i32 i = 0; i < W * H; i++) { live = live + g.cells[i] as i32; }
      g.live = live;
      shown.update((i32 n) => n + 1);
    });
  });
  // After every render that changed the grid, the canvas shows it.
  ui.effect("\{shown.get()}", () => {
    paint(g.cells, g.rgba);
    c.element()!.pixels(W * SCALE, H * SCALE, g.rgba);
    return () => { };
  });
  return <div id="tool">
    <style>{STYLE}</style>
    <h1>life, from a file you drop</h1>
    <p class="sub">Conway’s rule over 128×96 cells, in wac. Drop any file and its bytes become the
      seed, one bit per cell — a photograph and a <code>.zip</code> behave completely differently,
      because a compressed file is the closest thing on your disk to random soup. This one proves
      nothing; it is here to be played with.</p>
    <canvas ref={c} id="c"></canvas>
    <div id="row">
      <button id="go" onclick={(ElementEvent e) => { running.update((bool r) => !r); }}>{running.get() ? "pause" : "run"}</button>
      <button id="again" onclick={(ElementEvent e) => {
        sow(g.cells, g.seed);
        g.gen = 0;
        shown.update((i32 n) => n + 1);
      }}>re-seed</button>
      <input type="file" id="f"/>
      <span id="note" class="dim">{note.get()}</span>
    </div>
    <p class="dim">generation <b id="gen">{g.gen}</b>, <b id="live">{g.live}</b> alive,
      <span id="ms">{g.ms}</span> ms a step</p>
    <footer>The rule, the rendering and this page are wac. <a href={SOURCE}>source</a>.</footer>
  </div>;
}

export async i32 main(Page page) {
  page.title("wac: life, from a file you drop");
  page.mount((Ui ui) => Life(ui, page));
  return 0;
}
