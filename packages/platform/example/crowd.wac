// How many host calls a program may have in flight, measured rather than quoted.
//
//   crowd [n] [millis]
//
// Arm `n` calls without collecting any, then wait for them all, and print what it cost. The calls are
// sleeps of `millis`, so they settle on their own and the whole run takes about one `millis` whatever `n`
// is — which is the answer: **there is no ceiling**, on any host.
//
//     crowd 1000 200                           # on the Deno host, 2026-10-30
//     crowd: arming 1000 calls of 200ms
//     crowd: armed 250 so far...
//     crowd: armed 500 so far...
//     crowd: armed 750 so far...
//     crowd: armed 1000, collected 1000, elapsed 225ms
//
// There was one until `issues/system/0373d`. On the JavaScript hosts every unsettled ticket held one of
// the bridge's 128 slots until it was collected, and this program existed to make that legible: past 128
// settled-but-uncollected calls it was refused by name (`all 128 call slots hold answers that were never
// taken`), and past 128 calls that never settle — a `recv` on a peer that never speaks — it parked with
// no error at all, which is what stopped servers (wac-mono issue 0091, and 0373d). Programs sized
// themselves against `CALL_SLOTS` to stay under it. Now a call holds a slot only while its request or its
// answer is crossing, as the native hosts never held one at all, and the arming loop below simply runs.

import { Sys, Clock, Output, Unsupported } from "std";
import { Result, Ticket, flatten } from "core";

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Clock clock = sys.clock();
  i32 argc = argv.len();
  i32 n = argc > 0 ? atoi(argv[0].toBytes()) : 1000;
  i32 ms = argc > 1 ? atoi(argv[1].toBytes()) : 200;
  if (n < 1) {
    err.line("usage: crowd [n] [millis]");
    return 2;
  }

  err.line("crowd: arming \{n} calls of \{ms}ms");

  i64 started = flatten(clock.nowMillis().wait()).unwrap();

  // Armed first, collected second, on purpose. Interleaving them would never have more than one call
  // outstanding and would measure nothing — the question is what happens when the arming outruns the
  // collecting, which is the shape every program that watches many handles at once has.
  Ticket<Result<void, union<Unsupported>>>?[] live = Ticket<Result<void, union<Unsupported>>>?[].defaulted(n);
  i32 armed = 0;
  while (armed < n) {
    // Said as it goes, every quarter of the way, so a run that does stop says how far it got.
    if (armed % (n / 4 > 0 ? n / 4 : 1) == 0 && armed > 0) {
      err.line("crowd: armed \{armed} so far...");
    }
    live[armed] = clock.sleepMillis(ms);
    armed = armed + 1;
  }

  i32 collected = 0;
  while (collected < n) {
    Ticket<Result<void, union<Unsupported>>>? p = live[collected];
    if (p is not null) { p!.wait(); }
    collected = collected + 1;
  }

  i64 elapsed = flatten(clock.nowMillis().wait()).unwrap() - started;
  err.line("crowd: armed \{armed}, collected \{collected}" +
            ", elapsed \{elapsed as~ i32}ms");
  return 0;
}

/** Digits only; anything else is zero, which the caller sees as a usage error. */
i32 atoi(u8[] b) {
  i32 v = 0;
  for (i32 i = 0; i < b.len(); i++) {
    i32 d = b[i] as i32 - '0';
    if (d < 0 || d > 9) { return 0; }
    v = v * 10 + d;
  }
  return v;
}

