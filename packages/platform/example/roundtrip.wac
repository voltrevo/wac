// The filesystem, wherever it happens to be.
//
//   roundtrip <text>
//
// Write a file, stat it, read it back, list the directory, rename it, and remove it — printing
// what each step answered. On Deno and Node that is the real filesystem. In a browser it is the
// Origin Private File System, which is the same nine capabilities behind a very different
// implementation, and this is what says so out loud:
//
//   wac task app:build packages/platform/example/roundtrip.wac --target browser -o page/index.html
//   box httpd -8080 page -x
//   http://127.0.0.1:8080/?a=hello
//
// The interesting line is `rename`. OPFS has no rename, so the browser world does a copy and a
// delete — the one place where a capability is *weaker* in a page rather than absent, and the
// only kind of difference this program cannot show you, since a non-atomic rename looks exactly
// like an atomic one until two of them race.

import { Stat, Sys, Files, Output } from "std";
import { flatten } from "core";
import { reason } from "../../fs/src/words.wac";

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Files fs = sys.files();
  string text = argv.len() > 0 ? argv[0] : "round trip";
  string a = "roundtrip.txt";
  string b = "roundtrip.moved";

  // A previous run's files, if the store persists — which in a browser it does, across reloads
  // and across visits, and that is worth seeing rather than tidying away silently.
  Stat? before = flatten(fs.stat(a).wait()).ok();
  if ((before is not null)) { out.line("note: \{a} was already here from an earlier run"); }
  fs.remove(a, false).wait();
  fs.remove(b, false).wait();

  auto wrote = flatten(fs.writeFile(a, text.toBytes()).wait());
  if (wrote.isErr()) {
    err.line("roundtrip: cannot write \{a}: \{wrote.err()!}");
    return 1;
  }
  out.line("wrote \{a}");

  // `stat` can fail to be an answer at all — no read capability, or a name this host cannot express —
  // and that is a different thing from "there is nothing there". Printing it is the point of the
  // example: run this built with no grants and the line says so instead of claiming the file vanished
  // one statement after it was written. wac-mono 0065.
  match (flatten(fs.stat(a).wait())) {
    Ok(s): { out.line("stat: exists=yes isFile=\{yn(s.isFile)} size=\{s.size as~ i32}"); }
    // In the category's words rather than the host's, which spell one refusal two ways.
    Err(e): { out.line("stat: cannot tell — \{reason(e)}"); }
  }

  auto backRead = flatten(fs.readFile(a).wait());
  u8[]? back = backRead.ok();
  if ((back is null)) {
    err.line("roundtrip: cannot read back: \{backRead.err()!}");
    return 1;
  }
  string got = string.fromBytes(back!);
  out.line("read: \{got}");
  out.line(got == text ? "same bytes back" : "DIFFERENT: wrote \{text}, read \{got}");

  string[]? names = flatten(fs.readDir(".").wait()).ok();
  out.line("readDir: " + (names is null ? "not a directory" : "\{names!.len()} entries, " +
    (contains(names!, a) ? "including \{a}" : "but not \{a}")));

  // Not atomic in a browser. Everything else here behaves identically on all three hosts.
  auto moving = flatten(fs.rename(a, b).wait());
  if (moving.isErr()) {
    err.line("roundtrip: cannot rename: \{moving.err()!}");
    return 1;
  }
  Stat? moved = flatten(fs.stat(b).wait()).ok();
  Stat? gone = flatten(fs.stat(a).wait()).ok();
  out.line("rename: \{b} exists=\{yn((moved is not null))}, \{a} exists=\{yn((gone is not null))}");

  fs.remove(b, false).wait();
  out.line("removed, \{b} exists=\{yn(flatten(fs.stat(b).wait()).isOk())}");
  return 0;
}

string yn(bool b) { return b ? "yes" : "no"; }

bool contains(string[] names, string want) {
  for (string name in names) { if (name == want) { return true; } }
  return false;
}

