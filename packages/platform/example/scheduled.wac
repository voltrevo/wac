//
// Lambdas — `design/lang/0002` — which the reference compiler does not have. The marker is not a
// skip: the corpus tests that read it assert the two front ends genuinely disagree here.
//
// Work that finishes later, and what a program can do about it.
//
//   scheduled drain      run the continuations before leaving
//   scheduled leave      do not — which the host reports as an error
//   scheduled abandon    say you meant it
//   scheduled budget     drain for half a second, and abandon what that did not reach
//   scheduled linked     a `Core` ticket that is not a timer, and a `Cli` ticket linked by hand
//
// **Nothing here names a scheduler.** `delay` hands back a ticket that can carry a continuation,
// `then` puts one on it, and `drain` runs them — things this world can do, reached through the
// `Core` it was given. A program handed no world can schedule nothing, which is the same rule every
// other capability follows.
//
// **`then` returns immediately and the continuation runs inside `drain`.** There is no second stack
// here: a park in `waitAny` runs nothing at all, so a continuation can only run inside a call that
// dispatches. That is why `drain` is written by the program rather than happening to it, and why a
// program blocked anywhere else stalls its continuations until it gets there.

import { Cli, Core, Sys, Output } from "std";

export i32 main(Sys sys) {
  // **Still `Core`'s scheduler**, because that is the subject: `then`, `outstanding`, `dropAll` and
  // `drainFor` on a ticket count have no `std` spelling, and they go with `Core` (design/system/0013
  // step 6) rather than being imitated here.
  Core core = sys.core;
  Cli cli = sys.cli;
  string[] argv = sys.args();
  Output out = sys.stdout();
  string how = argv.len() > 0 ? argv[0] : "drain";

  // Two tickets, each with a continuation. Both return now; neither has run.
  i32 done = 0;
  core.delay(1).then((i64 at) => { done = done + 1; out.line("first"); });
  core.delay(2).then((i64 at) => { done = done + 1; out.line("second"); });
  out.line("scheduled \{core.outstanding()}, ran \{done}");

  if (how == "drain") {
    // Runs them here, on this stack, in the order the host answered.
    i32 ran = core.drain();
    out.line("drained \{ran}, ran \{done}");
    return 0;
  }

  if (how == "linked") {
    // **Every capability's ticket arrives able to dispatch.** `Core.of` has always linked the four
    // `Core` hands out; `Cli.of` links its thirty-one the same way, so neither of these says where
    // its continuation should run. A ticket made by the program itself is the one case that still
    // does — `Pending.linkedTo` is for those, and `packages/platform/test/wac/sched_test.wac` has one.
    core.randomBytes(8).then((u8[] b) => { out.line("random \{b.len()}"); });
    cli.cwd().then((string d) => { out.line("and a Cli ticket, linked by its capability"); });
    out.line("drained \{core.drain()}");
    return 0;
  }

  if (how == "budget") {
    // A minute away, so nothing but the clock can decide whether it runs.
    core.delay(60000).then((i64 at) => { done = done + 1; out.line("much later"); });
    i32 ran = core.drainFor(500);
    // The two above ran; this one did not, and is still outstanding — a budget that ran out is not a
    // decision, so leaving now would be the same error as never draining.
    out.line("budget ran \{ran}, left \{core.outstanding()}");
    out.line("abandoned \{core.dropAll()}");
    return 0;
  }

  if (how == "abandon") {
    // **Meaning it.** Each ticket's own `drop` is called, so the host's slots go back.
    out.line("abandoned \{core.dropAll()}");
    return 0;
  }

  // ...and leaving with work outstanding is an error the host reports, because the answer this
  // program asked for would otherwise never arrive and nothing would say so.
  out.line("leaving");
  return 0;
}

