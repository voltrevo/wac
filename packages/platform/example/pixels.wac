// Pixels, a pointer, and a frame you can keep.
//
//   wac run --allow-read --allow-write --allow-run packages/web/tools/build.wac \
//       packages/platform/example/pixels.wac .cache/pixels --page ./packages/web
//
// Everything a raster application needs, and it is three capabilities: a canvas's `pixels` blits a
// buffer wac filled, an event's `x` and `y` say where in that buffer the pointer is, and
// `download` hands the frame back as a file. The canvas is named by a `ref`, and drawn in an effect
// once the render that made it has been applied.
//
// It used to accept a dropped file too, and hand it straight back as `.copy`. That was coverage
// wearing a demonstration's clothes — `nextFile` arrived in the same commit as the raster
// capabilities, and this was the page that happened to have a `Page` profile plumbed. A fractal
// viewer has no use for a file you give it. It lives in `box/example/hash.wac` now, where a
// dropped file is the first thing anyone reaches for.
//
// The picture is a Mandelbrot set, which is here because it is the honest demonstration: 38400
// pixels, each an iteration loop, recomputed on every zoom, in compiled code fast enough that the
// page never notices. A drawing API would have made this the slow way to do it.

import { ElementEvent, Node, Page, Ref, Ui, html.b, html.button, html.canvas, html.dd, html.div, html.dl, html.dt, html.footer, html.h1, html.a, html.p, html.style } from "../../web";

static string STYLE =
  ":root { --ink: #f7f9f9; --slab: #fff; --line: #dbe4e3; --text: #0b1a1d;" +
  "        --dim: #5b7073; --key: #0e8c78; }" +
  "@media (prefers-color-scheme: dark) {" +
  "  :root { --ink: #0b1416; --slab: #101f23; --line: #1e363c; --text: #dce8e7;" +
  "          --dim: #8ba3a4; --key: #46d9c0; } }" +
  "body { background: var(--ink); color: var(--text); }" +
  "#tool { max-width: 34rem; margin: 0 auto; padding: 2rem 1.25rem 4rem; }" +
  "h1 { font-size: 1.35rem; margin: 0 0 .3rem; letter-spacing: -0.02em; }" +
  "p.sub { margin: 0 0 1.2rem; color: var(--dim); font-size: .95rem; }" +
  "canvas { display: block; width: 100%; height: auto; image-rendering: pixelated;" +
  "         border: 1px solid var(--line); border-radius: 6px; cursor: crosshair;" +
  "         background: var(--slab); }" +
  "#bar { display: flex; gap: .5rem; flex-wrap: wrap; margin: .8rem 0 .5rem; }" +
  "button { font: inherit; font-size: .88rem; padding: .3rem .8rem; cursor: pointer;" +
  "         color: var(--text); background: var(--slab); border: 1px solid var(--line);" +
  "         border-radius: 5px; }" +
  "button:hover { border-color: var(--key); color: var(--key); }" +
  "dl { display: grid; grid-template-columns: max-content 1fr; gap: .4rem 1.1rem;" +
  "     margin: .9rem 0 0; align-items: baseline; font-size: .9rem; }" +
  "dt { color: var(--dim); font-size: .74rem; letter-spacing: .09em;" +
  "     text-transform: uppercase; }" +
  "dd { margin: 0; font-family: ui-monospace, monospace;" +
  "     font-variant-numeric: tabular-nums; }" +
  "footer { margin-top: 2rem; font-size: .85rem; color: var(--dim); }" +
  "footer a { color: var(--key); }";

static i32 W = 480;
static i32 H = 300;
static i32 MAX = 160;

/** Where this page came from. A demonstration nobody can rebuild is a screenshot. */
static string SOURCE =
  "https://github.com/voltrevo/wac-mono/blob/master/packages/platform/example/README.md#pixelswac";

/** Where the picture looks, in fixed point: thousandths of a unit in the complex plane. */
struct Frame { i32 spanX; i32 centreX; i32 centreY; }

Frame home() { return Frame(3500, 0 - 700, 0); }

Node Pixels(Ui ui, Page page) {
  auto at = ui.state(home());
  auto pos = ui.state("move over it");
  auto ms = ui.state("—");
  Ref c = ui.ref();
  Frame f = at.get();
  // Drawn after each render that changed the view, once the canvas exists. The timing is on the page
  // because it is the answer to the obvious question about a fractal recomputed on every click, and the
  // number that makes the case for compiling.
  ui.effect("\{f.spanX} \{f.centreX} \{f.centreY}", () => {
    f64 began = page.now();
    c.element()!.pixels(W, H, picture(f.spanX, f.centreX, f.centreY));
    f64 took = page.now() - began;
    ms.set("\{took as~ i32} ms  ·  \{W * H} pixels");
    return () => { };
  });
  return <div id="tool">
    <style>{STYLE}</style>
    <h1>pixels</h1>
    <p class="sub">Every pixel is an iteration loop in wac, compiled to WebAssembly and blitted in
      one call. <b>Click the picture</b> to centre there and zoom.</p>
    <canvas ref={c} id="c"
            onclick={(ElementEvent e) => {
              // The point under the cursor becomes the centre, and the view halves. This is what an
              // event's `x` and `y` are for — without them the only zoom possible is the middle of the
              // picture, which is the least interesting part of any fractal.
              Frame g = at.get();
              i32 spanY = g.spanX * H / W;
              at.set(Frame(g.spanX / 2, g.centreX - g.spanX / 2 + e.x * g.spanX / W, g.centreY - spanY / 2 + e.y * spanY / H));
            }}
            onpointermove={(ElementEvent e) => {
              // The escape count under the cursor, which is the check that x and y are the *canvas's*
              // coordinates rather than the page's — an off-by-a-scroll would show up here at once.
              Frame g = at.get();
              i32 n = escapes(e.x, e.y, g.spanX, g.centreX, g.centreY);
              pos.set("x=\{e.x} y=\{e.y} escapes at " + (n >= MAX ? "never (inside)" : "\{n}"));
            }}></canvas>
    <div id="bar">
      <button id="in" onclick={(ElementEvent e) => { at.update((Frame g) => Frame(g.spanX / 2, g.centreX, g.centreY)); }}>zoom in</button>
      <button id="out" onclick={(ElementEvent e) => { at.update((Frame g) => Frame(g.spanX * 2, g.centreX, g.centreY)); }}>zoom out</button>
      <button id="reset" onclick={(ElementEvent e) => { at.set(home()); }}>reset</button>
      <button id="save" onclick={(ElementEvent e) => { Frame g = at.get(); page.download("mandelbrot.ppm", ppm(g.spanX, g.centreX, g.centreY)); }}>download PPM</button>
    </div>
    <dl>
      <dt>pointer</dt><dd id="pos">{pos.get()}</dd>
      <dt>view</dt><dd id="view">{"span \{thousandths(f.spanX)}  centre \{thousandths(f.centreX)}, \{thousandths(f.centreY)}"}</dd>
      <dt>drawn in</dt><dd id="ms">{ms.get()}</dd>
    </dl>
    <footer>Every pixel here is wac. <a href={SOURCE}>source, and how to build it yourself</a>.</footer>
  </div>;
}

export async i32 main(Page page) {
  page.title("wac: pixels");
  page.mount((Ui ui) => Pixels(ui, page));
  return 0;
}

/** Fixed point, printed as a decimal — the view is in thousandths of a unit. */
string thousandths(i32 v) {
  bool neg = v < 0;
  i32 x = neg ? 0 - v : v;
  return (neg ? "-" : "") + "\{x / 1000}." + pad3(x % 1000);
}

string pad3(i32 v) {
  string s = "\{v}";
  if (v < 10) { return "00\{s}"; }
  if (v < 100) { return "0\{s}"; }
  return s;
}

/** The picture: a buffer filled here and handed over in one call, whatever is in it. */
u8[] picture(i32 spanX, i32 centreX, i32 centreY) {
  u8[] rgba = u8[].filled(W * H * 4, 0);
  for (i32 py = 0; py < H; py++) {
    for (i32 px = 0; px < W; px++) {
      i32 n = escapes(px, py, spanX, centreX, centreY);
      i32 at = (py * W + px) * 4;
      if (n >= MAX) {
        rgba[at] = 20; rgba[at + 1] = 20; rgba[at + 2] = 30;
      } else {
        // A cheap ramp: blue into orange, so the bands are visible without a palette table.
        rgba[at] = ((n * 255 / MAX) as@ u8);
        rgba[at + 1] = ((n * 140 / MAX) as@ u8);
        rgba[at + 2] = (255 - (n * 200 / MAX)) as@ u8;
      }
      rgba[at + 3] = 255;
    }
  }
  return rgba;
}

/**
 * How long the point at this pixel takes to escape, up to `MAX`.
 *
 * Fixed point in thousandths, because the whole of this runs in i32 and a scaled integer says
 * what it means where a float would invite the question of which precision.
 */
i32 escapes(i32 px, i32 py, i32 spanX, i32 centreX, i32 centreY) {
  i32 spanY = spanX * H / W;
  i32 cx = centreX - spanX / 2 + px * spanX / W;
  i32 cy = centreY - spanY / 2 + py * spanY / H;
  i32 zx = 0;
  i32 zy = 0;
  for (i32 i = 0; i < MAX; i++) {
    i32 xx = zx * zx / 1000;
    i32 yy = zy * zy / 1000;
    if (xx + yy > 4000) { return i; }
    i32 nx = xx - yy + cx;
    zy = 2 * zx * zy / 1000 + cy;
    zx = nx;
  }
  return MAX;
}

/** The same image as a PPM, which is a header and then the bytes — no encoder needed. */
u8[] ppm(i32 spanX, i32 centreX, i32 centreY) {
  string head = "P6\n\{W} \{H}\n255\n";
  u8[] h = head.toBytes();
  u8[] out = u8[].filled(h.len() + W * H * 3, 0);
  out.copyFrom(h, 0, 0, h.len());
  i32 at = h.len();
  for (i32 py = 0; py < H; py++) {
    for (i32 px = 0; px < W; px++) {
      i32 n = escapes(px, py, spanX, centreX, centreY);
      out[at] = (n >= MAX ? 20 : (n * 255 / MAX)) as@ u8;
      out[at + 1] = (n >= MAX ? 20 : (n * 140 / MAX)) as@ u8;
      out[at + 2] = (n >= MAX ? 30 : 255 - (n * 200 / MAX)) as@ u8;
      at = at + 3;
    }
  }
  return out;
}

