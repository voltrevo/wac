// A page: draw something, then answer what the user does.
//
//   wac run --allow-read --allow-write --allow-run packages/web/tools/build.wac \
//       packages/platform/example/counter.wac .cache/counter --page ./packages/web
//
// The program is a loop that waits — `await page.nextEvent()` hands control back to the browser until
// something happens — so its state is ordinary locals.

import { Event, Page } from "../../web";
import { html.b, html.button, html.div, html.input, html.p } from "core";

export async i32 main(Page page) {
  page.title("counter");
  page.render(
    <div>
      <p>Clicks: <b id="n">0</b></p>
      <button id="up">+1</button>
      <button id="down">-1</button>
      <p><input id="echo" placeholder="type here"/></p>
      <p id="said"></p>
    </div>
  );
  page.on("button", "click");
  page.on("#echo", "input");
  i32 n = 0;
  while (true) {
    Event e = await page.nextEvent();
    if (e.kind == "input") {
      page.setText("said", e.value == "" ? "" : "you typed: \{e.value}");
    } else if (e.id == "up") {
      n += 1;
      page.setText("n", "\{n}");
    } else if (e.id == "down") {
      n -= 1;
      page.setText("n", "\{n}");
    }
  }
}
