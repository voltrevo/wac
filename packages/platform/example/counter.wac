// A page: a component, its state, and handlers that change it.
//
//   wac run --allow-read --allow-write --allow-run packages/web/tools/build.wac \
//       packages/platform/example/counter.wac .cache/counter --page ./packages/web
//
// `Counter` is a function of `Ui` (`packages/web`'s `view.wac`): `ui.state` keeps a value from one
// render to the next, and setting it renders the component again. A handler is a closure that sets
// state; the page follows.

import { ElementEvent, Node, Page, Ui, html.b, html.button, html.div, html.input, html.p } from "../../web";

Node Counter(Ui ui) {
  auto n = ui.state(0);
  auto said = ui.state("");
  return <div>
    <p>Clicks: <b id="n">{n.get()}</b></p>
    <button id="up" onclick={(ElementEvent e) => { n.update((i32 x) => x + 1); }}>+1</button>
    <button id="down" onclick={(ElementEvent e) => { n.update((i32 x) => x - 1); }}>-1</button>
    <p><input id="echo" placeholder="type here"
              oninput={(ElementEvent e) => { said.set(e.value == "" ? "" : "you typed: \{e.value}"); }}/></p>
    <p id="said">{said.get()}</p>
  </div>;
}

export async i32 main(Page page) {
  page.title("counter");
  page.mount((Ui ui) => Counter(ui));
  return 0;
}
