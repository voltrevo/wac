// A page that runs modules from its own disk (design/system/0015): `child.wasm`, `plain.wasm` and `load.wasm`, which
// are `spawnchild.wac`, `spawnplain.wac` and `spawnload.wac` built and put in the page's storage by the live test in
// `packages/web/test/spawn_live.test.ts`, each started with `procs().spawn` and its output shown as it was written.

import { Sys, Authority, Launch } from "std";
import { Node, Page, State, Ui, html.pre } from "../../web";

export async i32 main(Page page) {
  page.mount((Ui ui) => shows(ui, page));
  return 0;
}

Node shows(Ui ui, Page page) {
  auto shown = ui.state("starting");
  ui.effect("", () => {
    run(page.sys, shown);
    return () => { };
  });
  return <pre id="out">{shown.get()}</pre>;
}

async void run(Sys sys, State<string> shown) {
  string child = await ran(sys, "child.wasm", false, Authority(sys.files(), null, null, null));
  string plain = await ran(sys, "plain.wasm", false, Authority(sys.files(), null, null, null));
  // Writing this page's own streams instead — the page's console — as `wac run` has the program it starts do.
  string inherited = await ran(sys, "child.wasm", true, Authority(sys.files(), null, null, null));
  // Handed nothing: it may not read the page's storage, however it asks.
  string bare = await ran(sys, "child.wasm", false, Authority.none());
  // A module that loads another and calls it.
  string loads = await ran(sys, "load.wasm", false, Authority(sys.files(), null, null, null));
  shown.set("\{child}\n\{plain}\n\{inherited}\n\{bare}\n\{loads}");
}

/**
 * What the module in `file` wrote, its errors, and its status — or why it did not run. `inherit`: it writes this
 * page's own streams, so there is nothing here to read but its status.
 */
async string ran(Sys sys, string file, bool inherit, Authority given) {
  u8[] module;
  match (await sys.files().readFile(file)) {
    Ok(b): { module = b; }
    Err(e): { return "no module: \{e}"; }
  }
  match (await sys.procs().spawn(module, ["one", "two"], given, Launch("", false, inherit, false))) {
    Ok(child): {
      string out = "";
      match (await child.output().readAll()) {
        Ok(b): { out = string.fromBytes(b); }
        Err(e): { out = "output: \{e}"; }
      }
      string err = "";
      match (await child.errors().readAll()) {
        Ok(b): { err = string.fromBytes(b); }
        Err(e): { err = "errors: \{e}"; }
      }
      string code = "";
      match (await child.exit()) {
        Ok(c): { code = "\{c}"; }
        Err(e): { code = "\{e}"; }
      }
      return "\{out}err: \{err}exit: \{code}";
    }
    Err(e): { return "did not start: \{e}"; }
  }
}
