// A program that reports what it is allowed to do, for testing what a child is granted.
//
// It attempts one capability of each kind and prints the outcome, so running it directly and
// running it as a spawned child can be compared without reading any host code.
//
//   probe                  ->  read=ok net=ok        (built with --allow-read --allow-net)
//   runner probe.worker.js  ->  read=denied net=denied

import { NotGranted, Sys, Files, Net, Output } from "std";
import { flatten } from "core";

export i32 main(Sys sys) {
  Output out = sys.stdout();
  Files fs = sys.files();
  Net net = sys.net();
  // A file that certainly exists when run from the repository root. A denial and a missing
  // file are deliberately not distinguished by the world, so the *fault* is what says which —
  // and either way the answer is "not readable", which is what a caller acts on.
  //
  // **The fault, not the sentence.** Reading the message is what this program used to do, and the
  // four hosts spell one refusal two ways — "filesystem read not granted to this application" on
  // the JavaScript hosts against "Not granted to this application" on both native ones. A
  // `contains` looking for lowercase "not granted" therefore reported `failed` under `wacland` and
  // `wacv8`: the confinement was working and the program said it was not. `NotGranted` is the type
  // that exists for exactly this.
  auto f = flatten(fs.readFile("README.md").wait());
  string read = f.isOk() ? "ok" : (f.err()! is NotGranted ? "denied" : "failed");

  // Port 1 is privileged and nothing is listening, so a *grant* failure and a connection
  // failure differ in their fault rather than in whether they failed.
  auto s = flatten(net.connect("127.0.0.1", 1).wait());
  string said = s.isOk() ? "ok" : (s.err()! is NotGranted ? "denied" : "failed");
  if (s.isOk()) { s.unwrap().close(); }

  out.line("read=\{read} net=\{said}");
  return 0;
}
