// A program that reports what it is allowed to do, for testing what a child is granted.
//
// It attempts one capability of each kind and prints the outcome, so running it directly and
// running it as a spawned child can be compared without reading any host code.
//
//   probe                  ->  read=ok net=ok        (built with --allow-read --allow-net)
//   runner probe.worker.js  ->  read=denied net=denied

import { Cli, Core, FAULT_NOT_GRANTED, FileResult, Socket } from "std/platform.wac";

export i32 main(Core core, Cli cli) {
  // A file that certainly exists when run from the repository root. A denial and a missing
  // file are deliberately not distinguished by the world, so the *message* is what says
  // which — and either way the answer is "not readable", which is what a caller acts on.
  FileResult f = cli.readFile("README.md").wait();
  // **The fault, not the sentence.** Reading `error` is what this program used to do, and the four
  // hosts spell one refusal two ways — "filesystem read not granted to this application" on the
  // JavaScript hosts against "Not granted to this application" on both native ones. A `contains`
  // looking for lowercase "not granted" therefore reported `failed` under `wacland` and `wacv8`: the
  // confinement was working and the program said it was not. `FileResult.fault` is the field that
  // exists for exactly this, and its own docstring says why the message cannot be branched on.
  string read = f.ok ? "ok" : (f.fault == FAULT_NOT_GRANTED() ? "denied" : "failed");

  // Port 1 is privileged and nothing is listening, so a *grant* failure and a connection
  // failure differ in their message rather than in whether they failed.
  // **And the fault is what says which, since `issues/system/0238c`.** This read `s.error` and matched
  // `"ot granted"` -- the leading letter dropped so that "not granted" and "Not granted" both hit,
  // because the hosts spell one refusal two ways. `Socket` carries a category now, exactly as
  // `FileResult` and `Change` always have, and the two branches below are the same line.
  Socket s = cli.connect("127.0.0.1", 1).wait();
  string net = s.handle < 0 ? (s.fault == FAULT_NOT_GRANTED() ? "denied" : "failed") : "ok";
  if (s.handle >= 0) { cli.closeSocket(s.handle); }

  core.log("read=" + read + " net=" + net);
  return 0;
}
