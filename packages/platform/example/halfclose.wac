// Saying "that is all" without saying "goodbye": a socket's outbound direction ended on its own.
//
//   wac run --allow-net packages/platform/example/halfclose.wac
//   server saw "hello" then End
//   client read back "world"
//   both directions independent
//
// `Socket.close` stops a socket both ways, so a client that used it to signal end-of-input could never
// receive the answer — which is the exchange every request/response protocol over a raw socket needs,
// where the server reads to the end and only then replies. `Socket.closeSend` ends one direction and
// leaves the other alone. `issues/system/0215`.
//
// **Both ends are in this one program**, which is what makes it comparable across hosts: no peer to
// arrange, no port to pass in, and the only thing a run could differ on — the ephemeral port — is
// never printed. It binds `0`, accepts its own connection, and asks the two questions that together
// say the direction was ended rather than the socket:
//
//   1. the *server* side reaches `End`, so the FIN arrived and `wc`-shaped programs would answer;
//   2. the *client* side still reads, so the reply has a way back.
//
// Either one alone is passed by a wrong implementation. A `closeSend` that did nothing fails the
// first and a `closeSend` that closed both directions fails the second, which is why this prints two
// lines rather than a verdict.
//
// The accept is submitted *before* the connect and waited on after, because a host is free to
// complete them in either order and a program that waits on `accept` first would deadlock against a
// host that has not dialled yet.

import { Sys, Net, Output, Socket, Listener } from "std";
import { flatten } from "core";

export i32 main(Sys sys) {
  Output err = sys.stderr();
  Output out = sys.stdout();
  Net net = sys.net();
  auto srvBind = flatten(net.listen("127.0.0.1", 0).wait());
  if (srvBind.isErr()) { err.line("listen: \{srvBind.err()!}"); return 1; }
  Listener? srv = srvBind.ok();
  auto accepting = srv!.accept();

  auto cDial = flatten(net.connect("127.0.0.1", srv!.port).wait());
  if (cDial.isErr()) { err.line("connect: \{cDial.err()!}"); return 1; }
  Socket? c = cDial.ok();
  auto accepted = flatten(accepting.wait());
  if (accepted.isErr()) { err.line("accept: \{accepted.err()!}"); return 1; }
  Socket a = accepted.unwrap();

  c!.send("hello".toBytes()).wait();
  c!.closeSend();

  // The server side sees the bytes and then the end of them, while the client is still connected.
  string got = "";
  bool reading = true;
  while (reading) {
    auto heard = flatten(a.recv().wait());
    if (heard.isErr()) { err.line("server recv: \{heard.err()!}"); return 1; }
    match (heard.unwrap()) {
      Data(b): { got = got + string.fromBytes(b); }
      End: { reading = false; }
      Failed(e): { err.line("server recv: \{e}"); return 1; }
    }
  }
  out.line("server saw \"\{got}\" then End");

  // And the answer travels the direction that was left open.
  a.send("world".toBytes()).wait();
  a.close();
  string back = "";
  reading = true;
  while (reading) {
    match (flatten(c!.recv().wait())) {
      Ok(got): {
        match (got) {
          Data(b): { back = back + string.fromBytes(b); }
          default: { reading = false; }
        }
      }
      Err(e): { err.line("client recv: \{e}"); return 1; }
    }
  }
  out.line("client read back \"\{back}\"");

  c!.close();
  srv!.close();
  if (got != "hello" || back != "world") { return 2; }
  out.line("both directions independent");
  return 0;
}
