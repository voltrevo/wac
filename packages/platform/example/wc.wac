// A word-count application, entire. There is no TypeScript in this directory.
//
// `wac run --allow-read packages/platform/example/wc.wac -- <file>`
//
// Two things are worth noticing. It reads a file with what looks like an ordinary function
// call — behind that call the host is doing `await Deno.readFile` on another thread while
// this one is parked — and it can reach nothing it was not handed, so `main`'s two
// parameters are the complete list of what it can do.

import { Sys, Clock, Env, Files, Input, Output } from "std";
import { flatten } from "core";

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Input stdin = sys.stdin();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Clock clock = sys.clock();
  Env env = sys.env();
  Files fs = sys.files();
  // No argument means standard input, as `wc` has always meant it. That this works at all
  // is the difference between a file-to-file tool and something you can put in a pipe.
  u8[] data = u8[]();
  string label = "";
  if (argv.len() < 1) {
    data = flatten(stdin.readAll().wait()).orElse(u8[]());
  } else {
    label = argv[0];
    auto fRead = flatten(fs.readFile(label).wait());
    u8[]? f = fRead.ok();
    if ((f is null)) {
      err.line("wc: \{label}: \{fRead.isErr() ? "\{fRead.err()!}" : ""}");
      return 1;
    }
    data = f!;
  }

  i64 startedAt = flatten(clock.monotonicNanos().wait()).unwrap();
  Counts c = count(data);
  i64 tookNanos = flatten(clock.monotonicNanos().wait()).unwrap() - startedAt;

  string line = "\{c.lines} \{c.words} \{c.bytes}";
  out.line(label == "" ? line : "\{line} \{label}");

  // Unset and empty are different things, which is why the capability returns `string?`.
  u8[]? verboseRaw = flatten(env.get("WC_VERBOSE").wait()).orElse(null);
  string? verbose = verboseRaw is null ? null : string.fromBytes(verboseRaw!);
  if (verbose is null) { return 0; }
  out.line("counted in \{(tookNanos / 1000) as~ i32}us");
  return 0;
}

struct Counts { i32 lines; i32 words; i32 bytes; }

Counts count(u8[] data) {
  i32 lines = 0;
  i32 words = 0;
  bool inWord = false;
  for (i32 i = 0; i < data.len(); i++) {
    // A packed element already reads as an i32, which is what a character literal is.
    i32 b = data[i] as i32;
    if (b == '\n') { lines++; }
    bool space = b == ' ' || b == '\n' || b == '\t' || b == '\r';
    if (space) { inWord = false; }
    else if (!inWord) { inWord = true; words++; }
  }
  return Counts(lines, words, data.len());
}

