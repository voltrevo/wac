// Two programs, piped together, with no shell involved.
//
//   pipe <worker.js> <argsA> <argsB>
//
// Standard input goes to the first child, its output becomes the second child's input, and
// the second child's output goes to standard output. What a shell's `|` does, except that
// the plumbing is a wac program and both stages run inside this process as workers.
//
//   wac task app:build packages/box/src/box.wac --worker -o box.worker.js
//   printf 'b\na\nb\n' | pipe box.worker.js sort uniq      ->  a  b
//
// Three streams are live at once — standard input, and one per child — and each has its own
// `async` leg forwarding it to the next. None of them asks which kind of stream it reads, because
// there is nothing to ask: standard input, a child's output and a socket are each an `Input`, and
// a child's input is an `Output` exactly as standard output is. That is the property being
// demonstrated, more than the pipeline itself.
//
// Note the deadlock this cannot have. A shell pipeline needs an OS buffer between the stages,
// and a stage that stops reading while the one before it keeps writing wedges both. Here the
// three reads are in flight together, so a slow second stage parks its own leg rather than the
// first child, and the ring supplies the backpressure.
//
// It does need a slot per live read, plus one per write. Two stages is a handful of `CALL_SLOTS`,
// which is why the number rather than the constant is what this line used to carry, and it went
// on saying sixteen after the ring had 128. When the ring *did* have four, four of four is why a
// third stage was not something this could grow.

import { Authority, Child, Input, Launch, Sys, Files, Output, Procs } from "std";
import { Ticket } from "core";

export async i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Files fs = sys.files();
  Procs procs = sys.procs();
  if (argv.len() < 3) {
    err.line("usage: pipe <worker.js> <argsA> <argsB>");
    return 2;
  }
  string path = argv[0];

  auto progRead = await fs.readFile(path);
  if (progRead.isErr()) {
    err.line("pipe: \{path}: \{progRead.err()!}");
    return 1;
  }
  u8[] source = progRead.unwrap();

  // The same bundle twice, differing only in argv. Nothing stops them being different
  // programs — one bundle just makes the example short.
  auto spawnedA = await procs.spawn(source, argsOf(argv[1]), Authority.none(), Launch.plain());
  auto spawnedB = await procs.spawn(source, argsOf(argv[2]), Authority.none(), Launch.plain());
  if (spawnedA.isErr() || spawnedB.isErr()) {
    err.line("pipe: \{spawnedA.isErr() ? "\{spawnedA.err()!}" : "\{spawnedB.err()!}"}");
    return 1;
  }
  Child a = spawnedA.unwrap();
  Child b = spawnedB.unwrap();

  // stdin -> a -> b -> stdout, every leg at once, until each source ends. Each source's end is
  // passed on rather than ending the pipeline: `sort` emits nothing until its input closes, so a
  // stage's own end is the only thing that finishes it.
  Ticket<void> intoA = forward(err, "input", sys.stdin(), a.input(), true);
  Ticket<void> intoB = forward(err, "first stage", a.output(), b.input(), true);
  Ticket<void> intoOut = forward(err, "second stage", b.output(), out, false);
  await intoA;
  await intoB;
  await intoOut;

  auto ca = await a.exit();
  auto cb = await b.exit();
  a.stop();
  b.stop();
  i32 codeA = ca.isOk() ? ca.unwrap() : 1;
  i32 codeB = cb.isOk() ? cb.unwrap() : 1;
  // A pipeline's status is its last stage's, as in a shell.
  return codeB != 0 ? codeB : (codeA != 0 ? codeA : 0);
}

/**
 * A stage's argv, where empty means none.
 *
 * A stage that takes no arguments still needs a placeholder on the command line, and passing
 * `""` through as an argument is not the same thing: `wc ""` reads a file called nothing and
 * reports that it cannot, which is how this example first failed.
 */
string[] argsOf(string s) {
  return s == "" ? string[]() : [s];
}

/**
 * Everything `from` says, written to `to`, and then — when `closing` — `to` closed.
 *
 * A failed read ends the leg the way its end does, and says so: a pipeline that loses a stage to a
 * broken pipe and reports success is the reason a read has three outcomes.
 */
async void forward(Output err, string label, Input from, Output to, bool closing) {
  while (true) {
    auto got = await from.chunk();
    if (got.isErr()) {
      err.line("pipe: \{label}: \{got.err()!}");
      break;
    }
    bool over = false;
    match (got.unwrap()) {
      Data(bytes): {
        auto wrote = await to.write(bytes);
        if (wrote.isErr()) { err.line("pipe: \{label}: \{wrote.err()!}"); over = true; }
      }
      End: { over = true; }
      Failed(why): { err.line("pipe: \{label}: \{why}"); over = true; }
    }
    if (over) { break; }
  }
  if (closing) { await to.close(); }
}
