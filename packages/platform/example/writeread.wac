// Can a socket be written to while a read on it is still outstanding?
//
//   writeread [port]
//
// The question comes from wac-mono issue 0089: a Tor relay carries downloads and truncates uploads
// after about six cells, reporting that the far end closed when nothing had. The two directions
// differ in exactly one way — a download reads one socket and writes another, an upload writes a
// socket that already has a `recv` in flight — so this asks that question with no Tor in the picture
// at all.
//
// The shape is the one `relayd.wac` uses for a stream:
//
//   1. connect to a peer that will never send anything
//   2. issue `recv` and keep the ticket
//   3. `send` on the same handle, repeatedly
//   4. ask whether that `recv` has settled, and if so with what — by racing it against a timer
//
// A second argument, `drain`, makes the peer **read** what is sent to it. That is the one way the
// first version of this differed from a relay's stream socket: there the target is a real server that
// consumes, here it was a socket nobody ever read from, so the bytes sat in a buffer. If a read only
// ends once the peer has consumed, the difference matters and the first version could not have seen
// it.
//
// A `recv` that settles as `End` here, with the peer still connected and holding the connection open,
// would mean a handle may not have a read and a write in flight together — which nothing in
// `platform.wac` says, and which would make the relay's behaviour a platform matter rather than a Tor
// one. A `recv` that stays pending means the platform is fine and the fault is the relay's.
//
// Either answer is worth having in one place, which is why this is an example rather than a scratch
// file: it is the smallest program that distinguishes them.

import { Clock, Sys, Net, Output, Socket, Listener, Unsupported } from "std";
import { Read, Result, Ticket, TicketBase, flatten } from "core";

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Net net = sys.net();
  Clock clock = sys.clock();
  i32 port = argv.len() > 0 ? parsePort(argv[0].toBytes()) : 18099;
  if (port <= 0) {
    err.line("writeread: the argument must be a port");
    return 2;
  }

  auto listenerBind = flatten(net.listen("127.0.0.1", port).wait());
  Listener? listener = listenerBind.ok();
  if (listener is null) {
    err.line("writeread: listen: \{listenerBind.isErr() ? "\{listenerBind.err()!}" : ""}");
    return 1;
  }

  // The accept has to be outstanding before the connect, or the connect has nobody to talk to.
  auto incoming = listener!.accept();
  auto clientDial = flatten(net.connect("127.0.0.1", listener!.port).wait());
  Socket? client = clientDial.ok();
  if (client is null) {
    err.line("writeread: connect: \{clientDial.isErr() ? "\{clientDial.err()!}" : ""}");
    return 1;
  }
  auto accepted = flatten(incoming.wait());
  if (accepted.isErr()) {
    err.line("writeread: accept: \{accepted.err()!}");
    return 1;
  }
  Socket server = accepted.unwrap();
  out.line("writeread: connected on port \{listener!.port}");

  // The peer — `server` — never sends and never closes. So a `recv` on `client` should stay pending
  // for as long as that holds, and anything else is the thing being looked for.
  auto pending = client!.recv();

  if (settledWithin(clock, pending, 200)) {
    err.line("writeread: the read settled before anything was written — the peer is not silent");
    return 1;
  }
  out.line("writeread: the read is outstanding and the peer is silent, as expected");

  // Now write, in the same shape a relay forwards cells: several sends, one after another, with that
  // read still in flight. 498 bytes each, which is a relay cell's payload.
  u8[] payload = u8[].filled(498, 0);
  for (i32 i = 0; i < 498; i++) { payload[i] = ((i * 7 + 13) & 0xFF) as@ u8; }

  // Whether the peer consumes. Both ends are in this process, so the read can be driven by hand
  // rather than hoped for.
  bool drain = argv.len() > 1 &&
               argv[1] == "drain";
  if (drain) { out.line("writeread: the peer will read what it is sent"); }

  i32 sent = 0;
  for (i32 i = 0; i < 20; i++) {
    if (flatten(client!.send(payload).wait()).isErr()) {
      err.line("writeread: send \{i} failed");
      break;
    }
    sent = sent + 1;
    if (drain) {
      // Consume it, exactly as a server on the far side of a relay's stream would. The read is
      // waited on rather than polled: the bytes are already there.
      auto got = flatten(server.recv().wait());
      if (got.isErr()) { err.line("writeread: the peer's read failed: \{got.err()!}"); }
      else {
        match (got.unwrap()) {
          Data(bytes): { }
          End: { err.line("writeread: the peer's own read ended"); }
          Failed(why): { err.line("writeread: the peer's read failed: \{why}"); }
        }
      }
    }
    // After each send, ask whether the outstanding read has settled — a question about *now*, not a
    // wait, so the timer it races is zero.
    if (settledWithin(clock, pending, 0)) {
      out.line("writeread: the read settled after \{sent} sends (" +
               "\{sent * 498} bytes)");
      auto heard = flatten(pending.wait());
      if (heard.isErr()) {
        err.line("writeread: VERDICT failed — \{heard.err()!}");
        return 4;
      }
      match (heard.unwrap()) {
        Data(bytes): {
          out.line("writeread: VERDICT data — \{bytes.len()}" +
                   " bytes, so the peer spoke after all");
          return 0;
        }
        End: {
          err.line("writeread: VERDICT End — a write ended a read on the same handle, with the " +
                    "peer still connected. This is the platform, not the caller.");
          return 3;
        }
        Failed(why): {
          err.line("writeread: VERDICT failed — \{why}");
          return 4;
        }
      }
    }
  }

  // Give it a moment: a read broken by a write might settle a little after the write rather than
  // during it, and a poll that only ever ran between sends would miss that.
  if (settledWithin(clock, pending, 1000)) {
    auto heard = flatten(pending.wait());
    if (heard.isErr()) {
      err.line("writeread: VERDICT failed, late — \{heard.err()!}");
      return 4;
    }
    match (heard.unwrap()) {
      Data(bytes): {
        out.line("writeread: VERDICT data — \{bytes.len()} bytes, late");
        return 0;
      }
      End: {
        err.line("writeread: VERDICT End, shortly after the writes — the platform, not the caller.");
        return 3;
      }
      Failed(why): {
        err.line("writeread: VERDICT failed, late — \{why}");
        return 4;
      }
    }
  }

  out.line("writeread: VERDICT still pending after \{sent} sends (" +
           "\{sent * 498} bytes). A write does not disturb a read on the same handle.");
  // The read is still outstanding, and nothing wants its answer now.
  pending.cancel();
  client!.close();
  server.close();
  listener!.close();
  return 0;
}

/**
 * Whether `t` settles within `millis`, raced against a timer that is cancelled whichever wins — so
 * asking leaves nothing holding a slot, and `t` itself is left running to be asked again.
 */
bool settledWithin(Clock clock, TicketBase t, i32 millis) {
  if (t.settled()) { return true; }
  Ticket<Result<void, union<Unsupported>>> timer = clock.sleepMillis(millis);
  Ticket<i32> race = Ticket.first([t, timer]);
  bool won = race.wait().orElse(1) == 0;
  timer.cancel();
  return won;
}

i32 parsePort(u8[] text) {
  if (text.len() == 0) { return -1; }
  i32 v = 0;
  for (i32 i = 0; i < text.len(); i++) {
    if (text[i] < 48 || text[i] > 57) { return -1; }
    v = v * 10 + (text[i] as i32 - 48);
    if (v > 65535) { return -1; }
  }
  return v;
}

