// Wait on two sockets and report whichever speaks first.
//
// This is the shape `nc`, an SSH relay and a shell all need and none could express before:
// two `recv` calls in flight, and a park until *either* answers. Polling `settled` in a loop
// would spin a core to avoid it.
//
//   whichever <port> <port>
//
// Connects to both, waits, and prints which index answered and what it said. Then does it
// again for the other one, so the second answer is not lost.

import { Sys, Net, Other, Output, PeerClosed, Socket, TimedOut, Unsupported } from "std";
import { Read, Result, Stuck, Ticket, flatten } from "core";

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Net net = sys.net();
  if (argv.len() < 2) {
    err.line("usage: whichever <port> <port>");
    return 2;
  }
  auto aDial = flatten(net.connect("127.0.0.1", atoi(argv[0])).wait());
  Socket? a = aDial.ok();
  auto bDial = flatten(net.connect("127.0.0.1", atoi(argv[1])).wait());
  Socket? b = bDial.ok();
  if (a is null || b is null) {
    err.line("whichever: \{(a is null ? "\{aDial.isErr() ? "\{aDial.err()!}" : ""}" : "\{bDial.isErr() ? "\{bDial.err()!}" : ""}")}");
    return 1;
  }

  // Both reads are in flight from here. Neither has been waited for.
  auto ra = a!.recv();
  auto rb = b!.recv();

  Ticket<i32> race = Ticket.first([ra, rb]);
  auto won = race.wait();
  if (won.isErr()) {
    err.line("whichever: \{won.err()!}");
    return 1;
  }
  i32 first = won.unwrap();
  out.line("first=\{first} said=\{said(flatten(first == 0 ? ra.wait() : rb.wait()))}");

  // And the other one, which was never cancelled and is still running.
  i32 second = first == 0 ? 1 : 0;
  out.line("second=\{second} said=" + said(flatten(second == 0 ? ra.wait() : rb.wait())));

  a!.close();
  b!.close();
  return 0;
}

/**
 * What a socket said, in a line — including when it said nothing.
 *
 * `recv` answers a `Read`, so this has to name all three cases, and that is the point worth showing:
 * "the peer closed" and "the connection failed" are different events, and a relay that treats the
 * second as the first reports success over a truncated stream.
 */
string said(Result<Read, union<Other, PeerClosed, Stuck, TimedOut, Unsupported>> got) {
  if (got.isErr()) { return "(failed: \{got.err()!})"; }
  match (got.unwrap()) {
    Data(bytes): { return trim(bytes); }
    End: { return "(closed)"; }
    Failed(why): { return "(failed: \{why})"; }
  }
}

string trim(u8[] b) {
  i32 n = b.len();
  while (n > 0 && (b[n - 1] == '\n' || b[n - 1] == '\r')) { n--; }
  u8[] out = u8[].filled(n, 0);
  out.copyFrom(b, 0, 0, n);
  return string.fromBytes(out);
}

i32 atoi(string s) {
  u8[] b = s.toBytes();
  i32 n = 0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] < '0' || b[i] > '9') { return n; }
    n = n * 10 + (b[i] as i32 - '0');
  }
  return n;
}

