// A page with files: a note that is still there after a reload.
//
//   wac run --allow-read --allow-write --allow-run packages/web/tools/build.wac \
//       packages/platform/example/notes.wac .cache/notes --page ./packages/web --grant read,write
//
// Built with `--grant read,write`, a page's `page.sys` reaches the browser's Origin Private File System —
// storage that belongs to the page's origin and survives a reload. `readFile` and `writeFile` are the
// two calls a program on a command line makes, awaited the same way; what answers them is the browser.
// A handler cannot wait, so it starts an `async` function, and that sets state when its answer comes.

import { ElementEvent, Node, Page, State, Ui, html.button, html.div, html.p, html.span, html.textarea } from "../../web";
import { Sys } from "std";

static string FILE = "notes.txt";

async void load(Sys sys, State<string> text, State<string> said) {
  match (await sys.readFile(FILE)) {
    Ok(bytes): {
      text.set(string.fromBytes(bytes));
      said.set("read \{bytes.len()} bytes");
    }
    Err(why): { said.set("nothing saved yet"); }
  }
}

async void save(Sys sys, string text, State<string> said) {
  match (await sys.writeFile(FILE, text.toBytes())) {
    Ok(): { said.set("saved \{text.len()} bytes"); }
    Err(why): { said.set("could not save: \{why}"); }
  }
}

Node Notes(Ui ui, Sys sys) {
  auto text = ui.state("");
  auto said = ui.state("");
  // Once, after the first render: the note as it was saved.
  ui.effect("", () => {
    load(sys, text, said);
    return () => { };
  });
  return <div>
    <p><textarea id="text" rows="8" cols="60" value={text.get()}
                 oninput={(ElementEvent e) => { text.set(e.value); }}></textarea></p>
    <p><button id="save" onclick={(ElementEvent e) => { save(sys, text.get(), said); }}>save</button> <span id="said">{said.get()}</span></p>
  </div>;
}

export async i32 main(Page page) {
  page.title("notes");
  Sys sys = page.sys;
  page.mount((Ui ui) => Notes(ui, sys));
  return 0;
}
