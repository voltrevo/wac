// A test runner, in wac — the whole of what `wac test` does to one file, in forty lines.
//
//     runner <module.wasm>
//
// The module is built with `wac build`; the names come out of its own manifest; a test that traps
// passes when it is called `test_traps_*`, which is the convention the host used to own.

import { Authority, CallResult, Module, Sys, Files, Modules, Output } from "std";
import { flatten } from "core";
import { JsonObject, JsonValue } from "../../json/src/value.wac";
import { parse } from "../../json/src/json.wac";
import { manifestIn } from "../../wacc/src/manifest.wac";

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Files fs = sys.files();
  Modules mods = sys.modules();
  auto fRead = flatten(fs.readFile(argv[0]).wait());
  if (fRead.isErr()) { err.line("cannot read: \{fRead.isErr() ? "\{fRead.err()!}" : ""}"); return 1; }

  // Everything this program holds, which is what `wac test` hands a test file.
  auto loaded = mods.load(fRead.unwrap(), Authority(fs, sys.net(), sys.env(), sys.procs()));
  if (loaded.isErr()) { err.line("load: \{loaded.err()!}"); return 1; }
  Module m = loaded.unwrap();

  i32 passed = 0;
  i32 failed = 0;
  string[] names = testExports(fRead.unwrap());
  for (i32 i = 0; i < names.len(); i++) {
    string name = names[i];
    auto called = m.call(name, 0);
    if (called.isErr()) { failed = failed + 1; out.line("FAIL \{name} — \{called.err()!}"); continue; }
    CallResult c = called.unwrap();
    bool wantsTrap = name.len() > 11 && name.slice(0, 11) == "test_traps_";
    if (c.trapped()) {
      // A trap is a value, so the runner decides what it means instead of dying with it.
      if (wantsTrap) { passed = passed + 1; out.line("ok   \{name} (trapped)"); }
      else { failed = failed + 1; out.line("FAIL \{name} — trapped: \{c.text}"); }
    } else if (c.text == "") {
      passed = passed + 1;
      out.line("ok   \{name}");
    } else {
      failed = failed + 1;
      out.line("FAIL \{name} — \{c.text}");
    }
  }
  m.unload();
  out.line("\{passed} passed, \{failed} failed");
  return failed == 0 ? 0 : 3;
}

/** Every `test*` export the module declares, read from the manifest it carries. */
string[] testExports(u8[] wasm) {
  JsonValue? doc = parse(manifestIn(wasm).toBytes()).ok();
  if (doc is null) { return string[].filled(0, ""); }
  JsonObject root = JsonObject.create();
  match (doc!) { Object(o): { root = o; } default: { return string[].filled(0, ""); } }
  JsonValue? xs = root.getStr("exports");
  if (xs is null) { return string[].filled(0, ""); }
  string[] out = string[].filled(256, "");
  i32 n = 0;
  match (xs!) {
    Array(items): {
      for (i32 i = 0; i < items.len(); i++) {
        match (items.get(i)) {
          Object(e): {
            JsonValue? nm = e.getStr("name");
            if (nm is null) { continue; }
            match (nm!) {
              Str(bytes): {
                string s = string.fromBytes(bytes);
                if (s.len() > 4 && s.slice(0, 4) == "test" && n < 256) { out[n] = s; n = n + 1; }
              }
              default: { }
            }
          }
          default: { }
        }
      }
    }
    default: { }
  }
  string[] exact = string[].filled(n, "");
  for (i32 i = 0; i < n; i++) { exact[i] = out[i]; }
  return exact;
}
