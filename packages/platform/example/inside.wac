// Running a program inside another one, with a world of its own.
//
//   inside <a writable directory>
//
// A shell needs this and little else does: something has to run `grep`, keep what it printed, and
// hand it to the next stage. A program's world is the handles it is given — an `Input`, two
// `Output`s, a `Files` — so the caller builds the child's world as values and passes them in:
// bytes for its input, a `Kept` for each output stream, and its files `relativeTo` the directory it
// stands in. There used to be a host frame for this (`pushChild`/`popChild`), from before closures,
// when a substitute capability had nowhere to put what it collected; `issues/system/0327a`.
//
// The "child" here is `shout`, an ordinary function in this file. That is the point worth seeing:
// it reads its standard input, writes its output, complains on its error stream and opens a
// file by a relative path — all the things a program does, none of them written for this — and it
// is the *caller* that decides what those mean. `packages/box`'s sixty applets are wired into
// `packages/sh` this way, unchanged.
//
// What it is not is isolation: `shout` runs with everything this program was granted. A real
// boundary is `spawn`, a separate worker with its own grants, which a browser cannot do yet
// (issue 0030).

import { Sys, Files, Input, Output } from "std";
import { Kept } from "../src/stream.wac";
import { bytesInput } from "../../fs/src/trees.wac";
import { flatten } from "core";

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Files fs = sys.files();
  if (argv.len() < 1) {
    err.line("usage: inside <a writable directory>");
    return 2;
  }
  string dir = argv[0];

  // Something for the child to find by a *relative* name, which is the whole of the cwd claim.
  fs.writeFile("\{dir}/note.txt", "from the file\n".toBytes()).wait();

  // The world the child sees: its name and arguments, its standard input, and where it stands.
  Kept said = Kept.create();
  Kept moaned = Kept.create();
  i32 status = shout(["shout", "-x", "note.txt"], bytesInput("from stdin\n".toBytes()), moaned.out, said.out,
                     fs.relativeTo(dir));

  // None of the child's output reached this terminal; all of it came back here.
  out.line("status \{status}");
  out.line("out   \{oneLine(said.bytes())}");
  out.line("err   \{oneLine(moaned.bytes())}");
  return 0;
}

/**
 * The child: reads its input, reads a file it was told about, and writes both back loudly.
 *
 * Nothing here knows it is a child. It asks for its arguments, its input and a file by name, the
 * same as any program — which is what makes running it inside another one possible at all.
 */
i32 shout(string[] argv, Input stdin, Output err, Output out, Files fs) {
  // `argv[0]` is its own name and `argv[1]` its first argument, the layout `box` uses.
  bool loud = argv.len() > 1 && argv[1] == "-x";
  string named = argv[2];

  u8[] input = flatten(stdin.readAll().wait()).orElse(u8[]());
  out.write(upper(input));

  auto fRead = flatten(fs.readFile(named).wait());
  u8[]? f = fRead.ok();
  if ((f is null)) {
    // Goes to the child's own error stream, not this terminal's.
    err.line("shout: \{named}: \{fRead.isErr() ? "\{fRead.err()!}" : ""}");
    return 1;
  }
  out.write(loud ? upper(f!) : f!);

  out.line("read \{f!.len()} bytes");
  err.line("shout: nothing wrong, just talking");
  return 0;
}

u8[] upper(u8[] b) {
  u8[] out = u8[].filled(b.len(), 0);
  for (i32 i = 0; i < b.len(); i++) {
    out[i] = b[i] >= 'a' && b[i] <= 'z' ? b[i] - 32 : b[i];
  }
  return out;
}

/** Newlines shown as `\n`, so a multi-line capture is one line of output to compare. */
string oneLine(u8[] b) {
  string out = "";
  for (i32 i = 0; i < b.len(); i++) {
    out = out + (b[i] == 10 ? "\\n" : string.fromCodepoint(b[i] as i32));
  }
  return out;
}

