// The conformance program for a host: what a runtime must be able to do, as a program rather than prose.
//
// design/0001 step 2a, wac-mono 0087. It exists to be run on **every** host — the three JavaScript ones
// and the native one — and to say the same thing on each. That is the arrival test in miniature: not
// "the runtime compiles" but "the same program observes the same behaviour through a different host".
//
// The stages grow with the runtime, and each says what it checked rather than only that it passed. A
// stage that a host cannot reach at all stops the program there, which is the point — 0087's criteria
// are things a half-built host fails on rather than skips.
//
// ## The stages
//
//   1. **output** — `log` and `warn` reach two different streams.
//   2. **arguments** — argv crosses as bytes, in order. *(needs a ticket table)*
//   3. **two in flight, out of order** — two requests submitted, the later one collected first.
//   4. **`waitAny` with a deadline** — nothing ready, and it returns on time rather than hanging.
//   5. **spawn** — a child instance, waited for alongside one of this program's own tickets.
//
// Stages 2 to 5 are 0087's "done when", and they are in the order a host acquires them. A host that
// resolved every ticket immediately would pass the types and fail stage 3, which is why the out-of-order
// clause is in the criteria rather than a single request.

import { Child, Cli, Core, FAULT_NOT_GRANTED, FileResult, GRANT_ENV, GRANT_NONE, GRANT_READ, Pending } from "std/platform.wac";
import { Read } from "core";

export i32 main(Core core, Cli cli) {
  // **This program is also its own child.** Stage 5 spawns another instance of this very module and
  // waits for it, so `main` has to be a multi-call entry — the same shape `packages/box`'s `sh.wac`
  // uses, and for the same reason: a spawned bundle re-enters `main`, and something has to say which
  // half it is. A child prints one line and exits with a status its parent can check for.
  if (cli.argCount().wait() > 0 && string.fromBytes(cli.arg(0).wait()) == "--child") {
    core.log("wacland: I am the child");
    return 7;
  }
  // And whether it may read the environment, which is stage 6's *second* question. A separate arm
  // because the two are separate grants, and asking only about reading tests only the bit the
  // encodings happen to agree on.
  if (cli.argCount().wait() > 0 && string.fromBytes(cli.arg(0).wait()) == "--canenv") {
    u8[]? v = cli.env("WACLAND_PROBE").wait();
    core.log("wacland: child env=" + (v is null ? "denied" : string.fromBytes(v!)));
    return 0;
  }
  // The other half of being a child: report whether this world may read, which is stage 6's question.
  if (cli.argCount().wait() > 0 && string.fromBytes(cli.arg(0).wait()) == "--canread") {
    FileResult f = cli.readFile("/etc/hostname").wait();
    // **The fault, not the prose.** This grepped `f.error` for "not granted", which made the answer
    // depend on a host's *wording*: the wasmtime host says "this program was not granted reading" and
    // the V8 host says "Not granted to this application", so the same refusal read as `denied` on one
    // and `failed` on the other. `FAULT_NOT_GRANTED` is what both actually set, and what
    // `platform.wac` derives its own sentence from. `issues/system/0169`.
    core.log("wacland: child read=" +
             (f.ok ? "ok" : (f.fault == FAULT_NOT_GRANTED() ? "denied" : "failed")));
    return 0;
  }
  // Stage 1. Both streams, because a host that wired `warn` to standard output would look right in a
  // terminal and be wrong to everything that reads one of the two.
  core.log("wacland: stage 1 output");
  core.warn("wacland: stage 1 warn");

  // Stage 2 onwards need a `Pending<T>`, which is the ticket table. A host without one traps here with
  // the name of the capability it has not got — see the native runtime's `NotImplemented`.
  i32 n = cli.argCount().wait();
  core.log("wacland: stage 2 argCount " + itoa(n));
  for (i32 i = 0; i < n; i++) {
    core.log("wacland: stage 2 arg " + itoa(i) + " " + string.fromBytes(cli.arg(i).wait()));
  }

  // Stage 3. **Two requests in flight, completing out of the order they were asked for.**
  //
  // 0087's first criterion, and the one a host cannot fake: a runtime that resolved every ticket as it
  // was submitted would pass every type check here and make every program that overlaps requests
  // silently sequential. The long sleep is asked for *first*, so a host that answers in submission
  // order gets index 0 and fails.
  Pending<i64> slow = core.sleepMillis(120);
  Pending<i64> quick = core.sleepMillis(10);
  i32 first = core.waitAny(i32[](slow.id, quick.id), -1);
  core.log("wacland: stage 3 first " + itoa(first));
  // And each resolves its *own* value, which is what says the two tickets are separate rather than one
  // completion arriving twice.
  core.log("wacland: stage 3 quick " + itoa64(quick.wait()));
  core.log("wacland: stage 3 slow " + itoa64(slow.wait()));

  // Stage 4. A deadline with nothing ready, which must come back rather than hang.
  Pending<i64> never = core.sleepMillis(10000);
  i32 late = core.waitAny(i32[](never.id), 30);
  core.log("wacland: stage 4 timeout " + itoa(late));
  // Cancelling says "discard the answer", not "stop trying" — so the sleep is still running and this
  // program is about to end anyway. Said here because the difference is the whole of what `cancel` is.
  never.cancel();

  // Stage 5. **A child, and a wait over its exit *and* one of this program's own tickets.**
  //
  // 0087's third criterion, and the one it calls the point: "a readiness table that only handles one
  // kind of event fails there and nowhere else". The sleep and the child are two different sorts of
  // thing — a timer the runtime owns, and another wasm instance on another thread — and `waitAny` has
  // to be able to hold both in one list.
  //
  // `GRANT_NONE`, which is what a child that only prints needs. Grants are a ceiling of the parent's
  // own, so asking for more than this program has would not widen it anyway.
  u8[][] childArgv = u8[][1](fill: u8[0]());
  childArgv[0] = "--child".toBytes();
  Child kid = cli.spawnSelf(childArgv, GRANT_NONE, "", false, false).wait();
  if (kid.unavailable()) {
    core.log("wacland: stage 5 no spawn in this world");
    core.log("wacland: reached the end of what is implemented");
    return 0;
  }
  if (kid.handle < 0) {
    core.warn("wacland: stage 5 could not spawn: " + kid.error);
    return 1;
  }
  // The child's output, read back through its handle — bytes crossing between two instances.
  Pending<Read> said = cli.recv(kid.handle);
  Pending<i32> over = cli.exitCode(kid.handle);
  Pending<i64> tick = core.sleepMillis(1000);
  // Both kinds in one list. The child finishes long before the second, so this must answer 0.
  i32 which = core.waitAny(i32[](over.id, tick.id), -1);
  core.log("wacland: stage 5 first " + itoa(which));
  match (said.wait()) {
    case Data(bytes): { core.log("wacland: stage 5 heard " + string.fromBytes(bytes)); }
    case End: { core.log("wacland: stage 5 heard nothing"); }
    case Failed(why): { core.log("wacland: stage 5 read failed " + why); }
  }
  core.log("wacland: stage 5 status " + itoa(over.wait()));
  tick.cancel();

  // Stage 6. **A child gets what its parent granted, and no more.**
  //
  // The design's central claim about `spawn` — grants are "a ceiling of the parent's own, intersected
  // by the host rather than trusted". Asked twice, because one answer proves nothing: a child refused
  // when its parent had nothing to give is not evidence of an intersection. This program is built
  // *with* reading, so the two answers must differ.
  core.log("wacland: stage 6 withheld " + childSays(core, cli, GRANT_NONE));
  core.log("wacland: stage 6 granted " + childSays(core, cli, GRANT_READ));

  // **And the same claim about a different grant.** Reading is bit 1 and every encoding of these
  // flags agrees about bit 1, so asking only about reading cannot tell a host that decodes the
  // higher bits differently from one that does not. `GRANT_ENV` is bit 8.
  core.log("wacland: stage 6 env withheld " + childEnv(core, cli, GRANT_NONE));
  core.log("wacland: stage 6 env granted " + childEnv(core, cli, GRANT_ENV));

  core.log("wacland: reached the end of what is implemented");
  return 0;
}

/** Spawn a child with `grants` and answer what it said about the environment. */
string childEnv(Core core, Cli cli, i32 grants) {
  u8[][] argv = u8[][1](fill: u8[0]());
  argv[0] = "--canenv".toBytes();
  return said(core, cli, argv, grants);
}

/** Spawn a child with `grants` and answer what it said about reading. */
string childSays(Core core, Cli cli, i32 grants) {
  u8[][] argv = u8[][1](fill: u8[0]());
  argv[0] = "--canread".toBytes();
  return said(core, cli, argv, grants);
}

/** The shared half: spawn, drain the child's output, and answer what followed its `=`. */
string said(Core core, Cli cli, u8[][] argv, i32 grants) {
  Child kid = cli.spawnSelf(argv, grants, "", false, false).wait();
  if (kid.handle < 0) { return "no child"; }
  string said = "";
  while (true) {
    match (cli.recv(kid.handle).wait()) {
      case Data(bytes): { said = said + string.fromBytes(bytes); }
      case End: { break; }
      case Failed(why): { break; }
    }
  }
  cli.exitCode(kid.handle).wait();
  // The child's line is `wacland: child <what>=X`; the answer is what follows the `=`.
  u8[] b = said.toBytes();
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] == '=') { return trimEnd(said.slice(i + 1, said.len())); }
  }
  return "silent";
}

/** Without a trailing newline, which the child's `log` added. */
string trimEnd(string s) {
  i32 n = s.len();
  while (n > 0 && s.toBytes()[n - 1] == '\n') { n = n - 1; }
  return s.slice(0, n);
}

/** Whether `haystack` contains `needle`. */
bool contains(string haystack, string needle) {
  u8[] h = haystack.toBytes();
  u8[] n = needle.toBytes();
  if (n.len() == 0) { return true; }
  for (i32 i = 0; i + n.len() <= h.len(); i++) {
    bool same = true;
    for (i32 j = 0; j < n.len(); j++) {
      if (h[i + j] != n[j]) { same = false; break; }
    }
    if (same) { return true; }
  }
  return false;
}

/** An i64 as text. Separate from `itoa` because wac has no overloading and this needs both. */
string itoa64(i64 v) {
  if (v == 0 as i64) { return "0"; }
  string out = "";
  i64 x = v;
  bool negative = x < 0 as i64;
  if (negative) { x = 0 as i64 - x; }
  while (x > 0 as i64) {
    out = string.fromCodepoint('0' + (x % 10 as i64) as! i32) + out;
    x = x / 10 as i64;
  }
  return negative ? "-" + out : out;
}

/** Decimal, without pulling `fmt` in for a conformance program that must build everywhere. */
string itoa(i32 v) {
  if (v == 0) { return "0"; }
  string out = "";
  i32 x = v;
  bool negative = x < 0;
  if (negative) { x = 0 - x; }
  while (x > 0) {
    out = string.fromCodepoint('0' + (x % 10)) + out;
    x = x / 10;
  }
  return negative ? "-" + out : out;
}
