// The conformance program for a host: what a runtime must be able to do, as a program rather than prose.
//
// design/0001 step 2a, wac-mono 0087. It exists to be run on **every** host — the three JavaScript ones
// and the native one — and to say the same thing on each. That is the arrival test in miniature: not
// "the runtime compiles" but "the same program observes the same behaviour through a different host".
//
// The stages grow with the runtime, and each says what it checked rather than only that it passed. A
// stage that a host cannot reach at all stops the program there, which is the point — 0087's criteria
// are things a half-built host fails on rather than skips.
//
// ## The stages
//
//   1. **output** — `log` and `warn` reach two different streams.
//   2. **arguments** — argv crosses as bytes, in order. *(needs a ticket table)*
//   3. **two in flight, out of order** — two requests submitted, the later one collected first.
//   4. **`waitAny` with a deadline** — nothing ready, and it returns on time rather than hanging.
//   5. **spawn** — a child instance, waited for alongside one of this program's own tickets.
//
// Stages 2 to 5 are 0087's "done when", and they are in the order a host acquires them. A host that
// resolved every ticket immediately would pass the types and fail stage 3, which is why the out-of-order
// clause is in the criteria rather than a single request.

import { Cli, Core, Pending } from "../src/platform.wac";

export i32 main(Core core, Cli cli) {
  // Stage 1. Both streams, because a host that wired `warn` to standard output would look right in a
  // terminal and be wrong to everything that reads one of the two.
  core.log("wacland: stage 1 output");
  core.warn("wacland: stage 1 warn");

  // Stage 2 onwards need a `Pending<T>`, which is the ticket table. A host without one traps here with
  // the name of the capability it has not got — see the native runtime's `NotImplemented`.
  i32 n = cli.argCount().wait();
  core.log("wacland: stage 2 argCount " + itoa(n));
  for (i32 i = 0; i < n; i++) {
    core.log("wacland: stage 2 arg " + itoa(i) + " " + string.fromBytes(cli.arg(i).wait()));
  }

  // Stage 3. **Two requests in flight, completing out of the order they were asked for.**
  //
  // 0087's first criterion, and the one a host cannot fake: a runtime that resolved every ticket as it
  // was submitted would pass every type check here and make every program that overlaps requests
  // silently sequential. The long sleep is asked for *first*, so a host that answers in submission
  // order gets index 0 and fails.
  Pending<i64> slow = core.sleepMillis(120);
  Pending<i64> quick = core.sleepMillis(10);
  i32 first = core.waitAny(i32[](slow.id, quick.id), -1);
  core.log("wacland: stage 3 first " + itoa(first));
  // And each resolves its *own* value, which is what says the two tickets are separate rather than one
  // completion arriving twice.
  core.log("wacland: stage 3 quick " + itoa64(quick.wait()));
  core.log("wacland: stage 3 slow " + itoa64(slow.wait()));

  // Stage 4. A deadline with nothing ready, which must come back rather than hang.
  Pending<i64> never = core.sleepMillis(10000);
  i32 late = core.waitAny(i32[](never.id), 30);
  core.log("wacland: stage 4 timeout " + itoa(late));
  // Cancelling says "discard the answer", not "stop trying" — so the sleep is still running and this
  // program is about to end anyway. Said here because the difference is the whole of what `cancel` is.
  never.cancel();

  core.log("wacland: reached the end of what is implemented");
  return 0;
}

/** An i64 as text. Separate from `itoa` because wac has no overloading and this needs both. */
string itoa64(i64 v) {
  if (v == 0 as i64) { return "0"; }
  string out = "";
  i64 x = v;
  bool negative = x < 0 as i64;
  if (negative) { x = 0 as i64 - x; }
  while (x > 0 as i64) {
    out = string.fromCodepoint('0' + (x % 10 as i64) as! i32) + out;
    x = x / 10 as i64;
  }
  return negative ? "-" + out : out;
}

/** Decimal, without pulling `fmt` in for a conformance program that must build everywhere. */
string itoa(i32 v) {
  if (v == 0) { return "0"; }
  string out = "";
  i32 x = v;
  bool negative = x < 0;
  if (negative) { x = 0 - x; }
  while (x > 0) {
    out = string.fromCodepoint('0' + (x % 10)) + out;
    x = x / 10;
  }
  return negative ? "-" + out : out;
}
