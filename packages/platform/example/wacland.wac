// The conformance program for a host: what a runtime must be able to do, as a program rather than prose.
//
// design/0001 step 2a, wac-mono 0087. It exists to be run on **every** host — the three JavaScript ones
// and the native one — and to say the same thing on each. That is the arrival test in miniature: not
// "the runtime compiles" but "the same program observes the same behaviour through a different host".
//
// The stages grow with the runtime, and each says what it checked rather than only that it passed. A
// stage that a host cannot reach at all stops the program there, which is the point — 0087's criteria
// are things a half-built host fails on rather than skips.
//
// ## The stages
//
//   1. **output** — standard output and diagnostic output reach two different streams.
//   2. **arguments** — argv crosses as bytes, in order. *(needs a ticket table)*
//   3. **two in flight, out of order** — two requests submitted, the later one settling first.
//   4. **a deadline** — nothing ready, and the wait returns on time rather than hanging.
//   5. **spawn** — a child instance, waited for alongside one of this program's own tickets.
//
// Stages 2 to 5 are 0087's "done when", and they are in the order a host acquires them. A host that
// resolved every ticket immediately would pass the types and fail stage 3, which is why the out-of-order
// clause is in the criteria rather than a single request.

import { Authority, Child, Launch, NotGranted, Sys, Clock, Env, Files, Output, Procs, TimedOut, Unsupported } from "std";
import { Ticket, flatten } from "core";

export async i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Clock clock = sys.clock();
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  // **This program is also its own child.** Stage 5 spawns another instance of this very module and
  // waits for it, so `main` has to be a multi-call entry — the same shape `packages/box`'s `sh.wac`
  // uses, and for the same reason: a spawned bundle re-enters `main`, and something has to say which
  // half it is. A child prints one line and exits with a status its parent can check for.
  if (argv.len() > 0 && argv[0] == "--child") {
    out.line("wacland: I am the child");
    return 7;
  }
  // And whether it may read the environment, which is stage 6's *second* question. A separate arm
  // because the two are separate grants, and asking only about reading tests only the bit the
  // encodings happen to agree on.
  if (argv.len() > 0 && argv[0] == "--canenv") {
    u8[]? v = (await env.get("WACLAND_PROBE")).orElse(null);
    out.line("wacland: child env=" + (v is null ? "denied" : string.fromBytes(v!)));
    return 0;
  }
  // The other half of being a child: report whether this world may read, which is stage 6's question.
  if (argv.len() > 0 && argv[0] == "--canread") {
    auto f = await fs.readFile("/etc/hostname");
    // **The fault, not the prose.** This grepped the message for "not granted", which made the answer
    // depend on a host's *wording*: the wasmtime host says "this program was not granted reading" and
    // the V8 host says "Not granted to this application", so the same refusal read as `denied` on one
    // and `failed` on the other. `NotGranted` is what both actually answer. `issues/system/0169`.
    out.line("wacland: child read=" + (f.isOk() ? "ok" : (f.err()! is NotGranted ? "denied" : "failed")));
    return 0;
  }
  // Stage 1. Both streams, because a host that wired the diagnostic stream to standard output would
  // look right in a terminal and be wrong to everything that reads one of the two.
  out.line("wacland: stage 1 output");
  err.line("wacland: stage 1 warn");

  // Stage 2 onwards need a ticket table. A host without one traps here with the name of the
  // capability it has not got — see the native runtime's `NotImplemented`.
  i32 n = argv.len();
  out.line("wacland: stage 2 argCount \{n}");
  for (i32 i = 0; i < n; i++) {
    out.line("wacland: stage 2 arg \{i} \{argv[i]}");
  }

  // Stage 3. **Two requests in flight, completing out of the order they were asked for.**
  //
  // 0087's first criterion, and the one a host cannot fake: a runtime that resolved every ticket as it
  // was submitted would pass every type check here and make every program that overlaps requests
  // silently sequential. The long sleep is asked for *first*, so a host that answers in submission
  // order settles index 0 first and fails.
  Ticket<i64> slow = napped(clock, 120);
  Ticket<i64> quick = napped(clock, 10);
  i32 first = await Ticket.first([slow, quick]);
  out.line("wacland: stage 3 first \{first}");
  // And each answers its *own* reading, which is what says the two tickets are separate rather than
  // one completion arriving twice.
  out.line("wacland: stage 3 quick \{await quick}");
  out.line("wacland: stage 3 slow \{await slow}");

  // Stage 4. A deadline with nothing ready, which must come back rather than hang. `-1` is what this
  // line has always printed for "nothing settled".
  // `within` cancels whichever loses — "discard the answer", not "stop trying" — so the sleep is
  // still running and this program is about to end anyway.
  auto late = await clock.within(clock.sleepMillis(10000), 30);
  i32 timedOut = late.isErr() && late.err()! is TimedOut ? -1 : 0;
  out.line("wacland: stage 4 timeout \{timedOut}");

  // Stage 5. **A child, and a wait over its exit *and* one of this program's own tickets.**
  //
  // 0087's third criterion, and the one it calls the point: "a readiness table that only handles one
  // kind of event fails there and nowhere else". The sleep and the child are two different sorts of
  // thing — a timer the runtime owns, and another wasm instance on another thread — and one wait has
  // to be able to hold both.
  //
  // `Authority.none()`, which is what a child that only prints needs. Grants are a ceiling of the
  // parent's own, so asking for more than this program has would not widen it anyway.
  auto spawned = await procs.spawnSelf(["--child"], Authority.none(), Launch.plain());
  if (spawned.isErr() && spawned.err()! is Unsupported) {
    out.line("wacland: stage 5 no spawn in this world");
    out.line("wacland: reached the end of what is implemented");
    return 0;
  }
  if (spawned.isErr()) {
    err.line("wacland: stage 5 could not spawn: \{spawned.err()!}");
    return 1;
  }
  Child kid = spawned.unwrap();
  // The child's output, read back through it — bytes crossing between two instances.
  auto said = kid.output().chunk();
  auto over = kid.exit();
  auto tick = clock.sleepMillis(1000);
  // Both kinds in one wait. The child finishes long before the second, so this must answer 0.
  i32 which = await Ticket.first([over, tick]);
  out.line("wacland: stage 5 first \{which}");
  auto heard = await said;
  if (heard.isErr()) {
    out.line("wacland: stage 5 read failed \{heard.err()!}");
  } else {
    match (heard.unwrap()) {
      Data(bytes): { out.line("wacland: stage 5 heard \{string.fromBytes(bytes)}"); }
      End: { out.line("wacland: stage 5 heard nothing"); }
      Failed(why): { out.line("wacland: stage 5 read failed \{why}"); }
    }
  }
  auto status = await over;
  out.line("wacland: stage 5 status \{status.isOk() ? status.unwrap() : -1}");
  tick.cancel();

  // Stage 6. **A child gets what its parent granted, and no more.**
  //
  // The design's central claim about `spawn` — grants are "a ceiling of the parent's own, intersected
  // by the host rather than trusted". Asked twice, because one answer proves nothing: a child refused
  // when its parent had nothing to give is not evidence of an intersection. This program is built
  // *with* reading, so the two answers must differ.
  out.line("wacland: stage 6 withheld \{await childSays(procs, "--canread", Authority.none())}");
  out.line("wacland: stage 6 granted \{await childSays(procs, "--canread", Authority(fs.readOnly(), null, null, null))}");

  // **And the same claim about a different grant.** Reading is bit 1 and every encoding of these
  // flags agrees about bit 1, so asking only about reading cannot tell a host that decodes the
  // higher bits differently from one that does not. The environment is bit 8.
  out.line("wacland: stage 6 env withheld \{await childSays(procs, "--canenv", Authority.none())}");
  out.line("wacland: stage 6 env granted \{await childSays(procs, "--canenv", Authority(null, null, env, null))}");

  out.line("wacland: reached the end of what is implemented");
  return 0;
}

/** Sleep `ms`, and answer the monotonic reading once it has. */
async i64 napped(Clock clock, i32 ms) {
  await clock.sleepMillis(ms);
  auto at = await clock.monotonicNanos();
  return at.isOk() ? at.unwrap() : -1 as i64;
}

/** Spawn a child holding `given`, drain its output, and answer what followed its `=`. */
async string childSays(Procs procs, string question, Authority given) {
  auto spawned = await procs.spawnSelf([question], given, Launch.plain());
  if (spawned.isErr()) { return "no child"; }
  Child kid = spawned.unwrap();
  auto all = await kid.output().readAll();
  await kid.exit();
  string said = all.isOk() ? string.fromBytes(all.unwrap()) : "";
  // The child's line is `wacland: child <what>=X`; the answer is what follows the `=`.
  u8[] b = said.toBytes();
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] == '=') { return trimEnd(said.slice(i + 1, said.len())); }
  }
  return "silent";
}

/** Without a trailing newline, which the child's `log` added. */
string trimEnd(string s) {
  i32 n = s.len();
  while (n > 0 && s.toBytes()[n - 1] == '\n') { n = n - 1; }
  return s.slice(0, n);
}
