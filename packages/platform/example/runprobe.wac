// Whether this program may run a host program.
//
// `run=ok` when `/bin/sh -c true` ran, and otherwise `run=no` with what the host said.
//
//   runner runprobe.worker.js "" run      ->  ok, if the runner itself may run programs
//
// The child half of `test/wac/spawn_test.wac`'s run-grant case. `probe.wac` reports the other grants
// by their fault; this reports the one distinction that does not depend on how a host words a refusal —
// whether the program ran.

import { ChildEnv, Exec, Launch, Sys } from "std";
import { flatten } from "core";

export i32 main(Sys sys) {
  auto ran = flatten(sys.procs().exec("/bin/sh", ["-c", "true"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  if (ran.isErr()) {
    sys.log("run=no: \{ran.err()!}");
    return 0;
  }
  Exec e = ran.unwrap();
  sys.log(e.status == 0 ? "run=ok" : "run=no: exited \{e.status}");
  return 0;
}
