// A program that runs itself.
//
//   twin              ->  parent, then the child's line, then the child's status
//   twin shout hello  ->  SHOUT: HELLO
//
// `spawnSelf` needs no file and no path: the launcher already has this program's worker bundle,
// because it is what started the program. So "run me again with these arguments" is available to
// every built program, on every host — and it is the only way a *browser tab* can have programs at
// all, since a page has no directory of them to read from.
//
// That makes this the shape of a multi-call binary. `packages/box` is one already: `box sort` is
// `box` deciding from its first argument which of sixty applets it is. A shell that can say
// `spawnSelf(["sort", "-n"])` therefore has sixty real programs — separate workers, own grants,
// concurrent — rather than sixty function calls inside its own instance.
//
// The child runs `main` even when a program also exports `page`. It was spawned, so it has a handle
// and nowhere to draw; `packages/box/example/term.wac` is both a terminal and the programs it runs
// for exactly that reason.

import { Authority, Child, Input, Launch, Sys, Output, Procs, Unsupported } from "std";
import { Read, flatten } from "core";

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Procs procs = sys.procs();
  i32 n = argv.len();

  // With arguments, this *is* the child: shout them and stop. One `main`, two behaviours, chosen by
  // argv — which is what a multi-call program is.
  if (n > 0 && argv[0] == "shout") {
    string said = "";
    for (i32 i = 1; i < n; i++) {
      said = said + (i > 1 ? " " : "") + argv[i];
    }
    out.write("SHOUT: \{upper(said)}\n".toBytes());
    return 0;
  }

  out.line("parent: about to run myself");

  // No source, no path, no grant: the same program, with different arguments. `Authority.none()`
  // because shouting needs nothing — and a child could not have more than this program has anyway.
  auto started = flatten(procs.spawnSelf(["shout", "hello", "twin"], Authority.none(), Launch.plain()).wait());
  if (started.isErr()) {
    auto why = started.err()!;
    if (why is Unsupported) {
      err.line("twin: this world cannot spawn: \{why}");
      return 2;
    }
    err.line("twin: \{why}");
    return 1;
  }
  Child kid = started.unwrap();

  // A child's output is an `Input`, the same as a file's or this program's own. Nothing here knows
  // it is talking to a copy of itself.
  kid.input().close().wait();
  Input heard = kid.output();
  bool reading = true;
  while (reading) {
    auto chunk = flatten(heard.chunk().wait());
    if (chunk.isErr()) {
      err.line("twin: reading the child: \{chunk.err()!}");
      return 1;
    }
    match (chunk.unwrap()) {
      Data(bytes): { flatten(out.write(bytes).wait()).isOk(); }
      End: { reading = false; }
      Failed(why): {
        err.line("twin: reading the child: \{why}");
        return 1;
      }
    }
  }

  auto exited = flatten(kid.exit().wait());
  if (exited.isErr()) {
    err.line("twin: \{exited.err()!}");
    return 1;
  }
  i32 code = exited.unwrap();
  out.line("parent: the child exited \{code}");
  return code;
}

u8[] upperBytes(u8[] b) {
  u8[] out = u8[].filled(b.len(), 0);
  for (i32 i = 0; i < b.len(); i++) {
    out[i] = b[i] >= 'a' && b[i] <= 'z' ? b[i] - 32 : b[i];
  }
  return out;
}

string upper(string s) { return string.fromBytes(upperBytes(s.toBytes())); }

