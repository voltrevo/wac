// Build a wac application into one **native executable**: the program inside a Rust host on V8.
//
//   wac run --allow-read --allow-write --allow-run packages/platform/tools/nativebinary.wac \
//       -- packages/wacc/example/wacc.wac -o wac --allow-read --allow-write
//   ./wac compile main.wac main.wasm          # no Deno on the machine, no wasm beside it
//
// Three ways to make one file, and they differ in what comes along:
//
// | | size | needs |
// | --- | --- | --- |
// | `app:build` | 710 KB | a Deno to run it |
// | `app:binary` | 105 MB | nothing — `deno compile`, so a Deno is *inside* it |
// | this | 67 MB | nothing — `native/v8`, so a V8 and a Rust host are inside it |
//
// The last two run the same engine at the same speed; this one is 38 MB smaller because it carries V8
// without the rest of a runtime, and it is the **primary platform** — `design/lang/0003`.
//
// Two steps and no cleverness: `wac build` for the module and its manifest, then `cargo build` with
// `WAC_SEED_DIR` pointing at them — `native/v8/build.rs` embeds what it finds there, under the name
// `wacc.wasm` whatever program it is.
//
// The grants after the entry are **the program's**, baked in exactly as `app:build` bakes them:
// whoever packages the thing chooses what it may do, and the person running it cannot quietly widen
// that. They are passed through to `wac build` untouched.
//
// ## This was a Deno script until 2026-08-19 — `issues/system/0161`
//
// It needed Deno for one thing: `buildNative`, the module and manifest. `wac build` writes the same
// bytes — measured, `tools/seed.sh` and `issues/system/0214` — so the last reason for a Deno script
// here went with that measurement. What is left is two `exec` calls and a copy.
//
// **It builds into a target directory of its own.** Cargo would otherwise write
// `native/v8/target/release/wac`, which is the binary `wac test` spawns and `deno task seed`
// produces, so packaging a `wc` would leave that path holding a `wc`. Measured 2026-08-19: an
// isolated `CARGO_TARGET_DIR` costs 34s once and 6s after, against 7s shared, for about 713 MB of
// disk that persists on purpose — deleting it between calls would put the 34s on every one.

import { Core, Cli, Exec, Change, FileResult } from "std/platform.wac";
import { itoa } from "../../fmt/src/itoa.wac";

const string CRATE = "native/v8";
const string TARGET = ".cache/nativebin-target";

string root(Cli cli) { return cli.cwd().wait(); }
string binary(Cli cli) { return root(cli) + "/native/v8/target/release/wac"; }

bool isGrant(string a) {
  return a == "--allow-read" || a == "--allow-write" || a == "--allow-net" || a == "--allow-env" ||
         a == "--allow-run";
}

export i32 main(Core core, Cli cli) {
  i32 argc = cli.argCount().wait();
  string entry = "";
  string dest = "";
  string[] grants = string[8](fill: "");
  i32 nGrants = 0;
  for (i32 i = 0; i < argc; i++) {
    string a = string.fromBytes(cli.arg(i).wait());
    if (a == "-o") {
      if (i + 1 < argc) { dest = string.fromBytes(cli.arg(i + 1).wait()); }
      i = i + 1;
    } else if (isGrant(a)) {
      if (nGrants < 8) { grants[nGrants] = a; nGrants = nGrants + 1; }
    } else if (a.len() > 0 && a.slice(0, 1) != "-" && entry == "") {
      entry = a;
    }
  }
  if (entry == "" || dest == "") {
    core.warn("usage: nativebinary <entry.wac> -o <dest> [--allow-read] [--allow-write] " +
              "[--allow-net] [--allow-env] [--allow-run]");
    return 2;
  }

  // The payload goes under `wacc.wasm` whatever program it is, because that is the name `build.rs`
  // looks for. The name is the seed's, not this program's.
  string dir = root(cli) + "/.cache/nativebin-" + itoa(entry.len()) + "-payload";
  cli.remove(dir, true).wait();
  cli.mkdir(dir, true).wait();

  string[] build = string[3 + nGrants + 3](fill: "");
  build[0] = "build";
  build[1] = entry;
  for (i32 i = 0; i < nGrants; i++) { build[2 + i] = grants[i]; }
  build[2 + nGrants] = "-o";
  build[3 + nGrants] = dir + "/wacc";
  build[4 + nGrants] = "--quiet";
  Exec compiled = cli.exec(binary(cli), build, u8[0]()).wait();
  if (!compiled.ran() || compiled.status != 0) {
    core.warn("nativebinary: " + entry + " did not build — " + compiled.error +
              string.fromBytes(compiled.stderr) + string.fromBytes(compiled.stdout));
    cli.remove(dir, true).wait();
    return 1;
  }

  string target = root(cli) + "/" + TARGET;
  cli.mkdir(target, true).wait();
  // `cd` and the two variables are the shell's because `Cli.exec` passes neither a working directory
  // nor an environment. An absolute `CARGO_TARGET_DIR`, because a relative one would be resolved
  // against the crate and land back inside it.
  Exec built = cli.exec("/bin/sh",
    string[]("-c", "cd '" + root(cli) + "/" + CRATE + "' && WAC_SEED_DIR='" + dir +
                   "' CARGO_TARGET_DIR='" + target + "' cargo build --release --quiet"),
    u8[0]()).wait();
  if (!built.ran() || built.status != 0) {
    core.warn("nativebinary: cargo did not build " + CRATE + " — is a Rust toolchain installed?\n" +
              built.error + string.fromBytes(built.stderr));
    cli.remove(dir, true).wait();
    return 1;
  }

  FileResult art = cli.readFile(target + "/release/wac").wait();
  if (!art.ok) {
    core.warn("nativebinary: cargo wrote nothing to copy — " + art.error);
    cli.remove(dir, true).wait();
    return 1;
  }
  Change wrote = cli.writeFile(dest, art.bytes).wait();
  if (!wrote.ok()) {
    core.warn("nativebinary: cannot write " + dest + " — " + wrote.message);
    cli.remove(dir, true).wait();
    return 1;
  }
  cli.setExecutable(dest, true).wait();
  cli.remove(dir, true).wait();

  core.log(dest + "  " + itoa(art.bytes.len() / 1048576) + " MB  native  [" +
           (nGrants == 0 ? "no capabilities" : itoa(nGrants) + " granted") + "]");
  return 0;
}
