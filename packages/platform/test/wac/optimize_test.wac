// `--optimize`: the same program, smaller, and still the same program.
//
// wac-mono 0094, decided 2026-08-11 as **a flag rather than the default** — what a built artifact
// contains stays exactly what the compiler produced unless somebody asks otherwise, because this
// repository debugs by comparing modules and an optimiser in between means every such comparison has
// to say which side of it it is on.
//
// So what this file has to establish is that the flag is worth having and safe to use: the artifact
// gets materially smaller, and the program it contains still answers the same. Size alone would pass
// for a build that dropped the module on the floor.
//
// Host-side until 2026-08-19, `issues/system/0161`. The three builds go through `/bin/sh` with
// `WAC_PROFILE` explicitly cleared or set, because coverage is not a flag on `build.ts` — it is
// `(opts.coverage ?? profiling())`, and `profiling()` reads that variable. The first two need it off
// (an instrumented module is a different size for a different reason) and the third needs it on,
// which is the only way from out here to ask for the combination that must be refused.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli, Exec, Stat } from "../../../platform/src/platform.wac";
import { contains, trimmed } from "../../../wactest/src/strings.wac";
import { itoa } from "../../../fmt/src/itoa.wac";

const string WC = "packages/platform/example/wc.wac";

string root(Cli cli) { return cli.cwd().wait(); }

string scratch(Cli cli, string name) {
  string dir = root(cli) + "/.cache/optimize-" + name;
  cli.remove(dir, true).wait();
  cli.mkdir(dir, true).wait();
  return dir;
}

/** Build `wc.wac`, optionally optimised, with coverage off however this run was started. */
Exec build(Cli cli, string out, bool optimize) {
  return cli.exec("/bin/sh",
    string[]("-c", "unset WAC_PROFILE; exec deno run -A packages/platform/build.ts '" + WC +
             "' --allow-read " + (optimize ? "--optimize " : "") + "-o '" + out + "'"),
    u8[0]()).wait();
}

i64 sizeOf(Cli cli, string path) {
  Stat s = cli.stat(path).wait();
  return s.exists ? s.size : (0 as i64);
}

/** The whitespace-separated fields of one line. */
i32 fieldCount(string s) {
  i32 n = 0;
  bool inWord = false;
  for (i32 i = 0; i < s.len(); i++) {
    string c = s.slice(i, i + 1);
    bool space = c == " " || c == "\t";
    if (!space && !inWord) { n = n + 1; }
    inWord = !space;
  }
  return n;
}

export string test_optimize_makes_a_smaller_artifact_that_answers_the_same(Core core, Cli cli) {
  T t = T.create();
  string dir = scratch(cli, "smaller");
  string plain = dir + "/wc-plain";
  string opt = dir + "/wc-opt";

  Exec bp = build(cli, plain, false);
  Exec bo = build(cli, opt, true);
  t.isTrue(bp.ran() && bp.status == 0, "the plain build — " + string.fromBytes(bp.stderr));
  t.isTrue(bo.ran() && bo.status == 0, "the optimised build — " + string.fromBytes(bo.stderr));
  if (!bp.ran() || bp.status != 0 || !bo.ran() || bo.status != 0) {
    cli.remove(dir, true).wait();
    return t.report();
  }

  i64 before = sizeOf(cli, plain);
  i64 after = sizeOf(cli, opt);
  // Measured at 274 KB -> 222 KB on 2026-08-11, which is the wasm going 93,766 -> 55,143 inside a
  // file that is about half host JavaScript (wac-mono 0129). A tenth is a floor with room under it
  // rather than the figure: what this asserts is that something happened, not how much.
  t.isTrue(before > (0 as i64) && after * (10 as i64) < before * (9 as i64),
           itoa(before as~ i32) + " -> " + itoa(after as~ i32) +
           " bytes is not a saving worth a flag");

  // **And it is still the program.** A build that emitted an empty module would pass the line above.
  Exec rp = cli.exec(plain, string[]("README.md"), u8[0]()).wait();
  Exec ro = cli.exec(opt, string[]("README.md"), u8[0]()).wait();
  t.isTrue(rp.ran() && rp.status == 0, "the plain program ran — " + string.fromBytes(rp.stderr));
  t.isTrue(ro.ran() && ro.status == 0, "the optimised program ran — " + string.fromBytes(ro.stderr));
  if (rp.ran() && ro.ran()) {
    string plainOut = string.fromBytes(rp.stdout);
    t.eqStr(string.fromBytes(ro.stdout), plainOut, "the optimised program answers differently");
    t.eqI32(fieldCount(trimmed(plainOut)), 4, "wc printed " + plainOut);
  }
  cli.remove(dir, true).wait();
  return t.report();
}

export string test_an_optimised_build_is_a_different_artifact_not_a_cache_hit_on_the_plain_one(
    Core core, Cli cli) {
  // The cache key carries the flag and the binaryen version — without that, asking for one after the
  // other hands back whichever was built first, which is the stale-artifact failure `buildCache`
  // exists to prevent and would read here as "--optimize does nothing".
  T t = T.create();
  string dir = scratch(cli, "cachekey");
  string a = dir + "/key-plain";
  string b = dir + "/key-opt";
  Exec ba = build(cli, a, false);
  Exec bb = build(cli, b, true);
  t.isTrue(ba.ran() && ba.status == 0, "the plain build — " + string.fromBytes(ba.stderr));
  t.isTrue(bb.ran() && bb.status == 0, "the optimised build — " + string.fromBytes(bb.stderr));
  if (ba.ran() && ba.status == 0 && bb.ran() && bb.status == 0) {
    i64 sa = sizeOf(cli, a);
    i64 sb = sizeOf(cli, b);
    t.isTrue(sa > (0 as i64) && sb < sa,
             "the two builds are the same file: " + itoa(sa as~ i32) + " and " +
             itoa(sb as~ i32) + " bytes");
  }
  cli.remove(dir, true).wait();
  return t.report();
}

export string test_a_coverage_build_refuses_to_be_optimised(Core core, Cli cli) {
  // Counters are branch-indexed globals and an optimiser may merge or drop the branches they count,
  // so a dump would be renumbered underneath the table that names them — a wrong answer rather than a
  // missing one. Refused at the call rather than discovered in a report nobody could explain.
  T t = T.create();
  string dir = scratch(cli, "refusal");
  Exec r = cli.exec("/bin/sh",
    string[]("-c", "WAC_PROFILE=1 exec deno run -A packages/platform/build.ts '" + WC +
             "' --allow-read --optimize -o '" + dir + "/never'"), u8[0]()).wait();
  t.isTrue(r.ran(), "the build was attempted — " + r.error);
  if (r.ran()) {
    t.isTrue(r.status != 0, "it built anyway, which it must not");
    string said = string.fromBytes(r.stderr) + string.fromBytes(r.stdout);
    t.isTrue(contains(said, "cannot be optimised"), "expected a refusal, got: " + said);
  }
  cli.remove(dir, true).wait();
  return t.report();
}
