// The world, end to end: a wac application with no TypeScript of its own, run on a worker, calling
// capabilities the host answers asynchronously.
//
// The central claim is that an `await` on the main thread is invisible from wac. These tests are what
// makes that a measurement — `readFile` really is `await Deno.readFile`, and the wac side really does
// call it as a function.
//
// **The counts are checked against the system `wc`**, which the TypeScript did not do: it split the
// file in JavaScript and compared against its own arithmetic. Asking coreutils is a real second
// implementation and one process, and it is what the program is named after.
//
// Host-side until 2026-08-19, `issues/system/0161`. `platform.test.ts` keeps the four tests whose
// subject is the bridge itself — `newBridge`, `serveHostCalls` and a `Worker` calling `hostCall` —
// because those drive `host/layout.ts` and `host/call.ts` rather than any wac program.

import { T } from "../../../wactest/src/assert.wac";
import { Cli, Exec, FileResult, ChildEnv, Env, Files, Launch, Procs, Sys } from "std";
import { contains, startsWith, splitLines, trimmed } from "../../../wactest/src/strings.wac";
import { binaryPath, freshDir, madeDir } from "../../../wactest/src/host.wac";
import { builtProgram } from "../../../wactest/src/built.wac";
import { flatten } from "core";

static string WC = "packages/platform/example/wc.wac";
static string HEXDUMP = "packages/platform/example/hexdump.wac";

string root(Env env) { return flatten(env.cwd().wait()).unwrap(); }

string freshScratch(T t, Env env, Files fs, string name) {
  string dir = "\{root(env)}/.cache/world-\{name}";
  string why = freshDir(fs, dir);
  t.isTrue(why == "", why);
  return dir;
}

/** Build one example for the Deno world with the grants named — the `wac build` half of what
 * `deno task app` did in one step until `18e3f616`. */
/**
 * The program, built once and cached — a module rather than an executable.
 *
 * **`builtProgram` rather than `deno run packages/platform/build.ts`.** `design/system/0009` is
 * removing that builder's non-browser targets, and nothing here wanted a *file to hand somebody*: it
 * wanted a program to run, which `wac <module.wasm>` does. The cache is the reason to prefer this
 * over `wac app` to a temporary name — `issues/system/0283c` — and it rebuilds only when the sources
 * or the compiler move.
 *
 * **`name` carries the grants**, because two grant sets are two artefacts and the cache is keyed on
 * the name: `built.wac` says "`name` must distinguish everything that changes the output", and this
 * file builds the same entry twice with different ones.
 */
string built(T t, Env env, Files fs, Procs procs, string entry, string name, string[] grants) {
  string mod = builtProgram(env, fs, procs, entry, name, grants);
  t.isTrue(mod != "", "\{entry} built as \{name}");
  return mod;
}

string[] none() { return string[].filled(0, ""); }

/** The non-empty lines of a stream, which is what the TypeScript's `lines` did. */
string[] lines(u8[] b) {
  string[] all = splitLines(string.fromBytes(b));
  i32 n = 0;
  for (i32 i = 0; i < all.len(); i++) { if (all[i].len() > 0) { n = n + 1; } }
  string[] out = string[].filled(n, "");
  i32 at = 0;
  for (i32 i = 0; i < all.len(); i++) {
    if (all[i].len() > 0) { out[at] = all[i]; at = at + 1; }
  }
  return out;
}

/** The whitespace-separated fields of one line. */
string[] fields(string s) {
  string[] out = string[].filled(8, "");
  i32 n = 0;
  string cur = "";
  for (i32 i = 0; i <= s.len(); i++) {
    string c = i < s.len() ? s.slice(i, i + 1) : " ";
    if (c == " " || c == "\t") {
      if (cur.len() > 0 && n < 8) { out[n] = cur; n = n + 1; }
      cur = "";
    } else {
      cur = cur + c;
    }
  }
  string[] r = string[].filled(n, "");
  for (i32 i = 0; i < n; i++) { r[i] = out[i]; }
  return r;
}

export string test_an_application_written_entirely_in_wac_runs_and_agrees_with_wc(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = freshScratch(t, env, fs, "wc");
  string app = built(t, env, fs, procs, WC, "world-wc-read", ["--allow-read"]);
  if (app == "") {
    fs.remove(dir, true).wait();
    return t.report();
  }

  auto rRan = flatten(procs.exec(binaryPath(env), [app, WC], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null), "the built program ran — \{rRan.isErr() ? "\{rRan.err()!}" : ""}");
  if ((r is null)) { fs.remove(dir, true).wait(); return t.report(); }
  t.eqI32(r!.status, 0, string.fromBytes(r!.stderr));

  // Coreutils is the oracle. `wc < path` rather than `wc path`, so the answer is three numbers and
  // no filename — the same three the example prints, in the same order.
  //
  // **`LC_ALL` is stated rather than inherited, and which one it is matters.** `Cli.exec` hands the
  // child the whole environment, so this used to compare against whatever the image happened to set —
  // `C.UTF-8` here — and the test neither set it nor mentioned it. In the C locale coreutils answers
  // **472 words** where it answers **474** in a UTF-8 one, and `wc.wac` says 474, so changing the
  // image would have failed this with a two-word discrepancy that reads as a bug in our splitting.
  //
  // It is not one. `wc.wac` splits on four ASCII bytes and calls every run between them a word.
  // GNU `wc` additionally drops a run containing no *printable* character, and in the C locale the
  // three bytes of an em-dash are not printable — this file has exactly two standalone `—`, which is
  // the whole of the difference. `test_the_c_locale_accounts_for_its_own_two_words` measures that
  // rather than leaving it as prose. `issues/system/0227a`.
  auto oracleRan = flatten(procs.exec("/bin/sh", ["-c", "LC_ALL=C.UTF-8 wc < '\{WC}'"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? oracle = oracleRan.ok();
  t.isTrue((oracle is not null) && oracle!.status == 0, "the system wc ran — \{oracleRan.isErr() ? "\{oracleRan.err()!}" : ""}");
  if ((oracle is null)) { fs.remove(dir, true).wait(); return t.report(); }

  string[] mine = lines(r!.stdout);
  t.isTrue(mine.len() > 0, "the example printed nothing");
  if (mine.len() == 0) { fs.remove(dir, true).wait(); return t.report(); }
  // Four fields, not three: the example names the file it counted, as `wc` does when given one.
  // The oracle is asked with a redirect so it prints three, and the fourth is checked to be the path
  // rather than skipped — the TypeScript destructured the first three and never looked at it.
  string[] got = fields(mine[0]);
  string[] want = fields(trimmed(string.fromBytes(oracle!.stdout)));
  t.eqI32(got.len(), 4, "three numbers and the name: \{mine[0]}");
  t.eqI32(want.len(), 3, "the system wc said: \{string.fromBytes(oracle!.stdout)}");
  if (got.len() != 4 || want.len() != 3) { fs.remove(dir, true).wait(); return t.report(); }
  t.eqStr(got[0], want[0], "lines");
  t.eqStr(got[1], want[1], "words");
  t.eqStr(got[2], want[2], "bytes");
  t.eqStr(got[3], WC, "the name of the file it counted");
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_a_capability_the_build_withholds_is_a_failure_the_application_can_report(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  // Built with no grants, so the world has no filesystem. The application gets an ordinary failed
  // FileResult rather than an exception, and decides what to do.
  T t = T.create();
  string dir = freshScratch(t, env, fs, "nogrant");
  string app = built(t, env, fs, procs, WC, "world-wc-none", none());
  if (app == "") { fs.remove(dir, true).wait(); return t.report(); }

  auto rRan = flatten(procs.exec(binaryPath(env), [app, WC], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null), "the built program ran — \{rRan.isErr() ? "\{rRan.err()!}" : ""}");
  if ((r is null)) { fs.remove(dir, true).wait(); return t.report(); }
  t.eqI32(r!.status, 1, "the application reported failure");
  string[] err = lines(r!.stderr);
  t.eqI32(err.len(), 1, "one line of complaint: \{string.fromBytes(r!.stderr)}");
  // **`granted`, not `not granted`, and that is a concession rather than a tidy-up.** The hosts word
  // this refusal differently — the JavaScript ones say *filesystem read not granted to this
  // application* and both Rust ones say *Not granted to this application*, which names no capability
  // and is the same string for all five. `issues/system/0284c`. What this case is *for* survives
  // either: the refusal reached the application and the application reported it. Tighten this back
  // to the informative sentence on the day the hosts agree on one.
  t.isTrue(err.len() > 0 && contains(err[0], "granted"),
           "got: \{string.fromBytes(r!.stderr)}");
  t.eqI32(lines(r!.stdout).len(), 0, "and printed no counts");
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_a_missing_file_reaches_the_application_as_its_hosts_message(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = freshScratch(t, env, fs, "missing");
  string app = built(t, env, fs, procs, WC, "world-wc-r", ["--allow-read"]);
  if (app == "") {
    fs.remove(dir, true).wait();
    return t.report();
  }
  auto rRan = flatten(procs.exec(binaryPath(env), [app, "no/such/file"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null), "the built program ran — \{rRan.isErr() ? "\{rRan.err()!}" : ""}");
  if ((r is null)) { fs.remove(dir, true).wait(); return t.report(); }
  t.eqI32(r!.status, 1, string.fromBytes(r!.stderr));
  t.isTrue(contains(string.fromBytes(r!.stderr), "no/such/file"),
           "got: \{string.fromBytes(r!.stderr)}");
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_no_arguments_means_standard_input_as_wc_has_always_meant_it(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = freshScratch(t, env, fs, "stdin");
  string app = built(t, env, fs, procs, WC, "world-wc-none", none());
  if (app == "") { fs.remove(dir, true).wait(); return t.report(); }
  auto rRan = flatten(procs.exec(binaryPath(env), [app], "one two\nthree\n".toBytes(), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null), "the built program ran — \{rRan.isErr() ? "\{rRan.err()!}" : ""}");
  if ((r is null)) { fs.remove(dir, true).wait(); return t.report(); }
  t.eqI32(r!.status, 0, string.fromBytes(r!.stderr));
  t.eqStr(trimmed(string.fromBytes(r!.stdout)), "2 3 14", "counts of the piped text");
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_env_distinguishes_unset_from_empty(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  // An empty value is still *set*, so the timing line appears. A nullable string is what makes the
  // difference expressible at all — it is why `string?` had to cross.
  //
  // Through `/bin/sh`, and since 2026-08-20 that is for the *unset* half only. `Cli.execWith` takes
  // an environment now — `issues/system/0182` — so the set-but-empty run could hand over
  // `WC_VERBOSE=` directly. Removing a name still has no spelling but `unset`, and the two runs have
  // to differ in the variable and in nothing else, so both stay on a shell line. `clearEnv: true`
  // would express the second run exactly and break both: the built program's shebang is
  // `/usr/bin/env -S … deno run`, which needs a `PATH` to find `deno` with.
  T t = T.create();
  string dir = freshScratch(t, env, fs, "env");
  string app = built(t, env, fs, procs, WC, "world-wc-re", ["--allow-read", "--allow-env"]);
  if (app == "") {
    fs.remove(dir, true).wait();
    return t.report();
  }

  auto setRan = flatten(procs.exec("/bin/sh", ["-c", "WC_VERBOSE= exec '\{binaryPath(env)}' '\{app}' '\{WC}'"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? set = setRan.ok();
  t.isTrue((set is not null), "the built program ran — \{setRan.isErr() ? "\{setRan.err()!}" : ""}");
  if ((set is null)) { fs.remove(dir, true).wait(); return t.report(); }
  string[] out = lines(set!.stdout);
  t.eqI32(out.len(), 2, "expected the timing line, got: \{string.fromBytes(set!.stdout)}" +
          string.fromBytes(set!.stderr));
  t.isTrue(out.len() > 1 && startsWith(out[1], "counted in "),
           out.len() > 1 ? "the second line was: \{out[1]}" : "there was no second line");

  // Unset: the same program, the same grant, and nothing in the environment. `sh -c` again so the two
  // runs differ in the variable and in nothing else.
  auto unsetRan = flatten(procs.exec("/bin/sh", ["-c", "unset WC_VERBOSE; exec '\{binaryPath(env)}' '\{app}' '\{WC}'"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? unset = unsetRan.ok();
  t.isTrue((unset is not null), "the built program ran — \{unsetRan.isErr() ? "\{unsetRan.err()!}" : ""}");
  if ((unset is not null)) {
    t.eqI32(lines(unset!.stdout).len(), 1, "unset means absent: \{string.fromBytes(unset!.stdout)}");
  }
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_a_program_can_be_a_filter_stdin_in_exact_bytes_out(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  // The gap that mattered most. `log` appends a newline and assumes text, so nothing could emit
  // binary — every compressor and encoder was a file-to-file tool and could not go in a pipe.
  // `readStdin` and `write` are what change that, and neither needs a grant: what the user pipes in
  // and what the program prints are the user's own doing.
  T t = T.create();
  string dir = freshScratch(t, env, fs, "filter");
  string app = built(t, env, fs, procs, HEXDUMP, "world-hexdump-none", none());
  if (app == "") { fs.remove(dir, true).wait(); return t.report(); }

  auto rRan = flatten(procs.exec(binaryPath(env), [app], "hello, wac".toBytes(), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null), "the built program ran — \{rRan.isErr() ? "\{rRan.err()!}" : ""}");
  if ((r is null)) { fs.remove(dir, true).wait(); return t.report(); }
  t.eqI32(r!.status, 0, string.fromBytes(r!.stderr));
  string text = string.fromBytes(r!.stdout);
  t.isTrue(startsWith(text, "00000000  68 65 6c 6c 6f 2c 20 77 61 63"), text);
  // Exactly one line, ending in a newline — `write` added nothing of its own. Stated as the two
  // facts rather than as `split("\n").length == 2`, which is the JavaScript spelling of them: wac's
  // `splitLines` does not leave an empty element after a trailing newline, so the count alone would
  // be checking a property of the splitter.
  t.eqI32(splitLines(text).len(), 1, "the output was: \{text}");
  t.isTrue(text.len() > 0 && text.slice(text.len() - 1, text.len()) == "\n",
           "it did not end in a newline: \{text}");

  // Bytes, not text: 0x00 and 0xFF survive, which a string-shaped output would mangle.
  auto binaryRan = flatten(procs.exec(binaryPath(env), [app], [0, 255, 128] as u8[], ChildEnv.inherited(), Launch.plain()).wait());
  Exec? binary = binaryRan.ok();
  t.isTrue((binary is not null) && contains(string.fromBytes(binary!.stdout), "00 ff 80"),
           "three raw bytes: \{string.fromBytes(binary!.stdout)}");
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_wc_reads_standard_input_when_given_no_file(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = freshScratch(t, env, fs, "wcstdin");
  string app = built(t, env, fs, procs, WC, "world-wc-none", none());
  if (app == "") { fs.remove(dir, true).wait(); return t.report(); }

  auto fRead = flatten(fs.readFile(WC).wait());
  u8[]? f = fRead.ok();
  t.isTrue((f is not null), "read the example's own source — \{fRead.isErr() ? "\{fRead.err()!}" : ""}");
  if ((f is null)) { fs.remove(dir, true).wait(); return t.report(); }

  auto rRan = flatten(procs.exec(binaryPath(env), [app], f!, ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null), "the built program ran — \{rRan.isErr() ? "\{rRan.err()!}" : ""}");
  if ((r is null)) { fs.remove(dir, true).wait(); return t.report(); }
  t.eqI32(r!.status, 0, string.fromBytes(r!.stderr));

  auto oracleRan = flatten(procs.exec("/bin/sh", ["-c", "wc < '\{WC}'"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? oracle = oracleRan.ok();
  string[] got = fields(trimmed(string.fromBytes(r!.stdout)));
  string[] want = fields(trimmed(string.fromBytes(oracle!.stdout)));
  t.eqI32(got.len(), 3, "three numbers: \{string.fromBytes(r!.stdout)}");
  t.eqI32(want.len(), 3, "the system wc said: \{string.fromBytes(oracle!.stdout)}");
  if (got.len() == 3 && want.len() == 3) {
    t.eqStr(got[0], want[0], "lines");
    t.eqStr(got[1], want[1], "words");
    t.eqStr(got[2], want[2], "bytes");
  }
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_stat_and_readdir_reach_the_application_and_are_gated(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  // A directory of this test's own making, listed against what was put in it. It used to list
  // `packages/platform/src` and expect exactly "platform.wac", which meant adding a second file to
  // this package — `stream.wac` — failed a test about `readDir`. A fixture that changes when the
  // source tree changes is testing the source tree.
  T t = T.create();
  string dir = freshScratch(t, env, fs, "readdir");
  string app = built(t, env, fs, procs, HEXDUMP, "world-hexdump-r", ["--allow-read"]);
  if (app == "") {
    fs.remove(dir, true).wait();
    return t.report();
  }
  string listing = "\{dir}/listing";
  string whyDir1 = madeDir(fs, listing);
  t.isTrue(whyDir1 == "", whyDir1);
  fs.writeFile("\{listing}/one.txt", "1".toBytes()).wait();
  fs.writeFile("\{listing}/two.txt", "2".toBytes()).wait();
  string whyDir2 = madeDir(fs, "\{listing}/sub");
  t.isTrue(whyDir2 == "", whyDir2);

  auto rRan = flatten(procs.exec(binaryPath(env), [app, listing], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null), "the built program ran — \{rRan.isErr() ? "\{rRan.err()!}" : ""}");
  if ((r is null)) { fs.remove(dir, true).wait(); return t.report(); }
  t.eqI32(r!.status, 0, string.fromBytes(r!.stderr));
  string[] got = lines(r!.stdout);
  // Compared as a set rather than sorted, because the order a host lists a directory in is not
  // something either host promises and neither is the subject here.
  t.eqI32(got.len(), 3, "three entries, got: \{string.fromBytes(r!.stdout)}");
  string[] want = ["one.txt", "two.txt", "sub"];
  for (i32 i = 0; i < want.len(); i++) {
    bool found = false;
    for (i32 k = 0; k < got.len(); k++) { if (trimmed(got[k]) == want[i]) { found = true; } }
    t.isTrue(found, "\{want[i]} was not listed: \{string.fromBytes(r!.stdout)}");
  }

  // Without the grant, `stat` reports "does not exist" rather than throwing: an application cannot
  // tell a withheld capability from an absent file, which is the right amount for it to know.
  string bare = built(t, env, fs, procs, HEXDUMP, "world-hexdump-none", none());
  if (bare != "") {
    auto deniedRan = flatten(procs.exec(binaryPath(env), [bare, "packages/platform/src"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
    Exec? denied = deniedRan.ok();
    t.isTrue((denied is not null), "the ungranted build ran — \{deniedRan.isErr() ? "\{deniedRan.err()!}" : ""}");
    if ((denied is not null)) {
      t.eqI32(denied!.status, 1, string.fromBytes(denied!.stderr));
      t.isTrue(contains(string.fromBytes(denied!.stderr), "not found"),
               "got: \{string.fromBytes(denied!.stderr)}");
    }
  }
  fs.remove(dir, true).wait();
  return t.report();
}

// ── The locale the oracle above pins, measured ────────────────────────────────────────────────────
//
// **Pinning an oracle's environment is how a differential is made to agree with a bug**, so the pin
// above owes an account of what it excludes. The account is a quantity: the two locales differ by
// exactly the number of whitespace-delimited runs in the file that contain no ASCII-printable
// character, because that is the class GNU `wc` drops in the C locale and `wc.wac` — which tests four
// byte values and nothing else — keeps.
//
// Counted from the file's own bytes rather than written down as 2, so a comment edit that adds or
// removes an em-dash moves the expectation with it instead of failing.
export string test_the_c_locale_accounts_for_its_own_two_words(Sys sys) {
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  auto fRead = flatten(fs.readFile(WC).wait());
  u8[]? f = fRead.ok();
  t.isTrue((f is not null), "read \{WC} — \{fRead.isErr() ? "\{fRead.err()!}" : ""}");
  if ((f is null)) { return t.report(); }

  auto utf8Ran = flatten(procs.exec("/bin/sh", ["-c", "LC_ALL=C.UTF-8 wc -w < '\{WC}'"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? utf8 = utf8Ran.ok();
  auto cRan = flatten(procs.exec("/bin/sh", ["-c", "LC_ALL=C wc -w < '\{WC}'"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? c = cRan.ok();
  t.isTrue((utf8 is not null) && utf8!.status == 0, "the UTF-8 oracle ran — \{utf8Ran.isErr() ? "\{utf8Ran.err()!}" : ""}");
  t.isTrue((c is not null) && c!.status == 0, "the C oracle ran — \{cRan.isErr() ? "\{cRan.err()!}" : ""}");
  if ((utf8 is null) || (c is null)) { return t.report(); }

  i32 utf8Words = atoi(trimmed(string.fromBytes(utf8!.stdout)));
  i32 cWords = atoi(trimmed(string.fromBytes(c!.stdout)));
  i32 unprintable = runsWithNoPrintable(f!);

  // The invariant, not the numbers: whatever the file says, the gap between the locales is that class
  // of run. If this ever fails, the C locale is dropping something else and the comment above is stale.
  t.eqI32(utf8Words - cWords, unprintable,
      "the two locales differ by \{utf8Words - cWords} words and the file has "
      + "\{unprintable} run(s) with no printable character");
  // And which side ours is on, said once here so the comparison above does not have to imply it.
  t.isTrue(unprintable > 0,
      "this file no longer has an unprintable-only run, so the pinned locale above buys nothing "
      + "and the two oracles now agree — check whether the pin should go");
  return t.report();
}

/** Whitespace-delimited runs holding no byte in `!`..`~` — what GNU `wc` drops in the C locale. */
i32 runsWithNoPrintable(u8[] b) {
  i32 runs = 0;
  bool inRun = false;
  bool printable = false;
  for (i32 i = 0; i < b.len(); i++) {
    i32 x = b[i] as i32;
    bool space = x == ' ' || x == '\n' || x == '\t' || x == '\r';
    if (space) {
      if (inRun && !printable) { runs++; }
      inRun = false;
      printable = false;
      continue;
    }
    inRun = true;
    if (x >= '!' && x <= '~') { printable = true; }
  }
  if (inRun && !printable) { runs++; }
  return runs;
}

/** The oracle answers a number; nothing here needs a general parser. */
i32 atoi(string s) {
  u8[] b = s.toBytes();
  i32 n = 0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] < '0' || b[i] > '9') { continue; }
    n = n * 10 + (b[i] as i32 - '0');
  }
  return n;
}
