// A program is bound for what it declared, and not for what its imports mention.
//
// This is a security property before it is a size one. `native/v8/example/hello.wac` logs one line
// and takes `main(Sys)`; before `issues/lang/0107` it was described by a manifest of 31 structs and
// 51 callback signatures, including `Socket`, `Child`, `Page`, `Picked` and `Event` — a hello-world
// handed a socket, a child-spawner and a window system because `packages/platform` mentions them.
//
// Nothing failed because of it. The extra surface is not reachable from *inside* the module — the
// wasm imports only the capabilities its own program named — so this is about what the host is asked
// to construct and hand over, which is exactly where ambient authority gets in. A test is the only
// thing that keeps a walk from widening again, because widening it breaks nothing.
//
// ## Host-side until 2026-08-18, `issues/system/0161`
//
// `buildNative` was TypeScript that returned the manifest as a value. It is not needed: `wac build
// <entry> -o <stem>` writes a module carrying the manifest a non-JavaScript host reads, and
// reading it off disk is closer to what a host does than being handed the object that produced it.
//
// The manifest is parsed with `packages/json`. That is this repository's own parser reading its own
// build's output, which would be circular if the manifest were the subject — it is not. The subject
// is *which capabilities are named in it*, and a parser that got the file wrong would fail these
// assertions loudly rather than agreeing with a mistake.

import { T } from "../../../wactest/src/assert.wac";
import { Exec, ChildEnv, Env, Files, Launch, Procs, Sys } from "std";
import { JsonValue, JsonArray, JsonObject } from "../../../json/src/value.wac";
import { parse } from "../../../json/src/json.wac";
import { customSection } from "./section.wac";
import { flatten } from "core";

/** The struct names and callback count a built program's manifest declares. */
struct Boundary {
  string[] structs;
  i32 callbacks;
  string error;
}

Boundary manifestOf(Env env, Files fs, Procs procs, string entry, string stem) {
  string wac = "\{flatten(env.cwd().wait()).unwrap()}/native/v8/target/release/wac";
  string out = "\{flatten(env.cwd().wait()).unwrap()}/.cache/declared/\{stem}";
  fs.mkdir("\{flatten(env.cwd().wait()).unwrap()}/.cache/declared", true).wait();
  auto builtRan = flatten(procs.exec(wac, ["build", entry, "-o", out, "--quiet"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? built = builtRan.ok();
  if ((built is null)) { return Boundary(string[].filled(0, ""), -1, "the wac binary did not run"); }
  if (built!.status != 0) {
    return Boundary(string[].filled(0, ""), -1,
                    "\{entry} did not build: \{string.fromBytes(built!.stderr)}");
  }
  auto fRead = flatten(fs.readFile("\{out}.wasm").wait());
  u8[]? f = fRead.ok();
  if ((f is null)) { return Boundary(string[].filled(0, ""), -1, "the build wrote no module: \{fRead.isErr() ? "\{fRead.err()!}" : ""}"); }

  // The manifest is a `wac.manifest` section inside the module — it was a `.json` beside it until
  // 2026-08-20.
  string text = customSection(f!, "wac.manifest");
  if (text.len() == 0) {
    return Boundary(string[].filled(0, ""), -1, "the module carries no `wac.manifest` section");
  }
  JsonValue? doc = parse(text.toBytes()).ok();
  if (doc is null) { return Boundary(string[].filled(0, ""), -1, "the manifest is not JSON"); }
  JsonObject top = match (doc!) { Object(members): members, default: JsonObject.create() };

  JsonValue? structs = top.getStr("structs");
  if (structs is null) { return Boundary(string[].filled(0, ""), -1, "no `structs` in the manifest"); }
  JsonArray items = match (structs!) { Array(a): a, default: JsonArray.create() };
  string[] names = string[].filled(items.len(), "");
  for (i32 i = 0; i < items.len(); i++) {
    JsonObject s = match (items.get(i)) { Object(m): m, default: JsonObject.create() };
    JsonValue? name = s.getStr("name");
    if (name is null) { continue; }
    names[i] = match (name!) { Str(bytes): string.fromBytes(bytes), default: "" };
  }

  JsonValue? callbacks = top.getStr("callbacks");
  i32 n = -1;
  if (callbacks is not null) {
    JsonArray cbs = match (callbacks!) { Array(a): a, default: JsonArray.create() };
    n = cbs.len();
  }
  return Boundary(names, n, "");
}

string[] sorted(string[] all) {
  string[] out = string[].filled(all.len(), "");
  for (i32 i = 0; i < all.len(); i++) { out[i] = all[i]; }
  for (i32 i = 1; i < out.len(); i++) {
    string v = out[i];
    i32 j = i - 1;
    while (j >= 0 && out[j] > v) { out[j + 1] = out[j]; j = j - 1; }
    out[j + 1] = v;
  }
  return out;
}

string joinedWith(string[] all, string sep) {
  string out = "";
  for (i32 i = 0; i < all.len(); i++) { out = i == 0 ? all[i] : out + sep + all[i]; }
  return out;
}

export string test_a_program_handed_sys_is_described_by_the_world(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  Boundary m = manifestOf(env, fs, procs, "native/v8/example/hello.wac", "hello");
  t.eqStr(m.error, "", "the manifest was read");
  if (m.error != "") { return t.report(); }

  // `main(Sys)` — the one authority a program is handed (spec ch07). Since design/system/0013 step 6 a host builds no
  // wac value, and since `issues/lang/0398a` the value `__wacHost` answers crosses opaque: no host reads it, so
  // nothing behind it is described — not the requests in flight, not the continuations nobody awaited. That list was
  // nine structs, and 36 before step 6, every `Pending<T>` a capability answered with among them. Asserted as the
  // *whole* list rather than as an absence, because a rule that only forbids today's capabilities says nothing about
  // the one added next week.
  t.eqStr(joinedWith(sorted(m.structs), ", "), "", "hello.wac's declared boundary");

  // So the boundary is the callbacks: the four calls `__wacHost` takes, and what the module's own closures need —
  // against 51 when every imported file's exports were roots. At least the four, which is what tells this program
  // from the canary below.
  t.isTrue(m.callbacks >= 4 && m.callbacks <= 12,
           "\{m.callbacks} callback signatures");
  return t.report();
}

export string test_and_a_program_that_takes_nothing_is_handed_nothing(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  // The canary. A rule that bound nothing would pass the test above only if hello's list were empty, and a rule
  // that bound everything would hand this program the host: `main()` asked for no authority, so there is no
  // `__WacHost`, no callback and no struct to describe.
  T t = T.create();
  Boundary m = manifestOf(env, fs, procs, "packages/platform/size/none.wac", "none");
  t.eqStr(m.error, "", "the manifest was read");
  if (m.error != "") { return t.report(); }
  t.eqStr(joinedWith(sorted(m.structs), ", "), "", "a program that takes nothing describes no struct");
  t.eqI32(m.callbacks, 0, "and no callback");
  return t.report();
}
