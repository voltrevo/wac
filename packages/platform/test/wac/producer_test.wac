// A built artefact says which compiler made it.
//
// Two compilers built this repository until 2026-08-28 — `WAC_APP_FROM` picked one — and their
// output differed by about a fifth in size (`issues/lang/0107`). Until the marker landed, nothing in
// either artefact recorded which one ran, so "what built this page" was answered by whatever the
// environment happened to be when somebody typed the command, and a page built before the default
// flipped was indistinguishable from one built after. `issues/lang/0103`, criterion 2.
//
// **There is one compiler now, and the marker outlives the choice.** The reference is deleted and
// `WAC_APP_FROM` selects nothing, so the half of this test that asserted the two names *differ* went
// with it — a differential whose other side is gone proves nothing, and keeping it would have made
// the retiree an oracle. What is still worth holding is that an artefact says what built it: a
// module with no `producers` section is one built by something that does not stamp, and that is a
// question somebody will ask about a `.wasm` found on a disk long after this paragraph.
//
// The marker is the standard `producers` custom section rather than anything invented here, so
// `wasm-objdump` and every other tool that already reads it does.
//
// Host-side until 2026-08-19, `issues/system/0161`. The section walk is `./section.wac`, shared with
// `native_manifest_test.wac` — which wanted one too once the manifest stopped being a file beside the
// module. Not borrowed from `packages/wacc/test/wac/wasm_probe.wac`: a test in one package reaching
// into another package's test helpers is a dependency the packages themselves do not have.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Exec, ChildEnv, Env, Files, Launch, Procs, Sys } from "std";
import { joined } from "../../../wactest/src/strings.wac";
import { leb, name } from "./section.wac";
import { freshDir } from "../../../wactest/src/host.wac";
import { flatten } from "core";

string root(Env env) { return flatten(env.cwd().wait()).unwrap(); }

/**
 * Every `processed-by` value in a module's `producers` section, in order.
 *
 * Section id 0 is a custom section and there may be several, so each one's own name is read before
 * anything else is believed about its body.
 */
string[] producedBy(u8[] b) {
  string[] out = string[].filled(8, "");
  i32 found = 0;
  i32[] pos = i32[].filled(1, 0);
  pos[0] = 8;
  while (pos[0] + 1 < b.len()) {
    i32 id = b[pos[0]] as i32;
    pos[0] = pos[0] + 1;
    i32 size = leb(b, pos);
    i32 end = pos[0] + size;
    if (id == 0 && name(b, pos) == "producers") {
      i32 fields = leb(b, pos);
      for (i32 f = 0; f < fields && pos[0] < end; f++) {
        string field = name(b, pos);
        i32 values = leb(b, pos);
        for (i32 v = 0; v < values && pos[0] < end; v++) {
          string value = name(b, pos);
          name(b, pos);                 // the version, which neither compiler has a number for yet
          if (field == "processed-by" && found < 8) { out[found] = value; found = found + 1; }
        }
      }
    }
    pos[0] = end;
  }
  string[] r = string[].filled(found, "");
  for (i32 i = 0; i < found; i++) { r[i] = out[i]; }
  return r;
}

/** Build a program with `WAC_APP_FROM` set as given, and read the marker back. */
string builtBy(T t, Env env, Files fs, Procs procs, string label, string from) {
  string dir = "\{root(env)}/.cache/producer-\{label}";
  string whyDir = freshDir(fs, dir);
  t.isTrue(whyDir == "", whyDir);

  // **A program with no imports**, written here rather than an example from the tree.
  //
  // The subject is the *marker* — which compiler stamped the module — so the program only has to
  // build under both. `hello.wac` cannot: it takes a `Core`, and `packages/platform` is wacc-only now
  // that `Pending.then` is a lambda, which the reference compiler does not have. Using it here would
  // make this test fail for a reason that has nothing to do with what it checks.
  fs.writeFile("\{dir}/stamp.wac", "export i32 main() { return 0; }\n".toBytes()).wait();

  // `unset` rather than leaving it alone, so the default case is the default rather than whatever
  // this run inherited.
  string setting = from.len() == 0 ? "unset WAC_APP_FROM;" : "WAC_APP_FROM='\{from}'";
  auto rRan = flatten(procs.exec("/bin/sh", [
             "-c", "\{setting} exec deno run -A packages/platform/native.ts '\{dir}" +
             "/stamp.wac' -o '\{dir}/hello'"
    ], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null) && r!.status == 0,
           "\{label}: the build — \{string.fromBytes(r!.stderr)}\{string.fromBytes(r!.stdout)}");
  if ((r is null) || r!.status != 0) { fs.remove(dir, true).wait(); return "<did not build>"; }

  auto fRead = flatten(fs.readFile("\{dir}/hello.wasm").wait());
  u8[]? f = fRead.ok();
  t.isTrue((f is not null), "\{label}: the module is there — \{fRead.isErr() ? "\{fRead.err()!}" : ""}");
  string answer = (f is not null) ? joined(producedBy(f!), ",") : "<no module>";
  fs.remove(dir, true).wait();
  return answer;
}

export string test_a_built_module_names_the_compiler_that_made_it(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  t.eqStr(builtBy(t, env, fs, procs, "default", ""), "wacc", "the default is wacc");
  // **And an unrecognised `WAC_APP_FROM` does not quietly build something else.** The variable used
  // to select a compiler and now selects nothing; the risk in a setting that has stopped meaning
  // anything is that it goes on being passed and is read as still working. `reference` is the value
  // that used to do something, so it is the one to ask about — the answer must be the same artefact
  // the default builds, stamped the same way, rather than a build that silently differs.
  t.eqStr(builtBy(t, env, fs, procs, "stale-setting", "reference"), "wacc",
          "WAC_APP_FROM=reference selects nothing now, and must not change what is built");
  return t.report();
}
