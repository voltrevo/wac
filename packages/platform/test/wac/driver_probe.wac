// The smallest program that still needs a host made to run it.
//
// `packages/platform/host/marshal.test.ts` drives this through the generic driver — the manifest
// read at run time — rather than through the glue `wacBindgen` writes. That is `issues/system/0144`:
// the native hosts start a child from a `.wasm` alone and the JavaScript hosts cannot, because their
// conversions are generated per program.
//
// **It asks nothing, and that is the point.** `main` still takes a `Sys`, so running it requires the
// driver to hand `__wacHost` four funcrefs by the signatures the manifest gives it, pass what that
// answers to `main`, and call an export whose signature it read from a string. What it does *not*
// require is the bridge that answers requests.
//
// The arithmetic exists so the answer cannot be the default: a driver that built the world correctly
// and called the wrong export would return 0, which is also what a program that did nothing returns.

import { Sys } from "std";

export i32 main(Sys sys) {
  // Deliberately unused — a program that ignores its world is still handed one.
  i32 answer = 6;
  for (i32 i = 0; i < 6; i++) { answer = answer + i; }
  return answer;   // 6 + 0+1+2+3+4+5 = 21
}
