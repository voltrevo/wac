// The bridge chunks in both directions.
//
// It only chunked responses. A `readFile` of ten megabytes worked and a `writeFile` of two threw
// `request of 2000000 bytes exceeds the 1048576-byte buffer` — so every applet whose output is its
// input died above a megabyte, and `cp` turned that into "cannot write", blaming the destination for
// a limit in the transport.
//
// Sizes straddle the 1MB buffer deliberately: just under, just over, and several multiples, plus an
// exact multiple where the last chunk is empty.
//
// **Driven through `box`**, because the applets are what actually cross a megabyte — `cat` sends the
// whole file out through `write`, `cp` sends it in through `writeFile`, and `gzip | gunzip` exercises
// the request and response halves against each other rather than each against a fixture. This test
// only runs the package; it does not change it.
//
// Host-side until 2026-08-19, `issues/system/0161`.

import { binaryPath } from "../../../wactest/src/host.wac";
import { builtProgram } from "../../../wactest/src/built.wac";
import { T } from "../../../wactest/src/assert.wac";
import { Exec, ChildEnv, Env, Files, Launch, Procs, Sys } from "std";
import { freshDir } from "../../../wactest/src/host.wac";
import { flatten } from "core";

static string BOX = "packages/box/src/box.wac";
static i32 MB = 1048576;

string root(Env env) { return flatten(env.cwd().wait()).unwrap(); }

/** A pattern, not random: a truncation or a doubled chunk would visibly break it. */
u8[] pattern(i32 size) {
  u8[] data = u8[].filled(size, 0);
  for (i32 i = 0; i < size; i++) { data[i] = ((i * 31 + (i >> 13)) & 0xFF) as@ u8; }
  return data;
}

/**
 * Where two byte arrays first differ, or the empty string.
 *
 * The length alone is not enough — a truncation and a doubled chunk can produce the same length —
 * and for a compressor the byte offset is the only useful thing to be told.
 */
string firstDifference(u8[] got, u8[] want) {
  i32 n = got.len() > want.len() ? got.len() : want.len();
  for (i32 i = 0; i < n; i++) {
    if (i >= got.len() || i >= want.len() || got[i] != want[i]) {
      string g = i < got.len() ? "\{got[i] as i32}" : "<end>";
      string w = i < want.len() ? "\{want[i] as i32}" : "<end>";
      return "first difference at byte \{i}: got \{g}, want \{w}" +
             " (lengths \{got.len()} and \{want.len()})";
    }
  }
  return "";
}

export string test_the_bridge_chunks_in_both_directions(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = "\{root(env)}/.cache/chunking";
  string whyDir = freshDir(fs, dir);
  t.isTrue(whyDir == "", whyDir);
  string src = "\{dir}/src.bin";
  string dst = "\{dir}/dst.bin";

  // **`builtProgram` rather than `deno run packages/platform/build.ts`.** `design/system/0009` is
  // removing that builder's non-browser targets. This wanted a program to run, which `wac
  // <module.wasm>` does — and a cached module rather than a `wac app` executable to a temporary
  // name, which could not be cached at all before `issues/system/0283c` and is rebuilt here only
  // when the sources or the compiler move. That matters more here than elsewhere: this case runs the
  // program fifteen times, at up to three megabytes a pass.
  string app = builtProgram(env, fs, procs, BOX, "chunking-box", ["--allow-read", "--allow-write"]);
  t.isTrue(app != "", "box built");
  if (app == "") { fs.remove(dir, true).wait(); return t.report(); }

  i32[] sizes = [MB - 1, MB, MB + 1, 3 * MB, 2 * MB];
  for (i32 k = 0; k < sizes.len(); k++) {
    i32 size = sizes[k];
    u8[] data = pattern(size);
    fs.writeFile(src, data).wait();

    // Out through `write`: the whole file crosses as the request payload.
    auto catRan = flatten(procs.exec(binaryPath(env), [app, "cat", src], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
    Exec? cat = catRan.ok();
    t.isTrue((cat is not null) && cat!.status == 0,
             "cat at \{size} bytes — \{string.fromBytes(cat!.stderr)}");
    if ((cat is not null) && cat!.status == 0) {
      string d = firstDifference(cat!.stdout, data);
      t.eqStr(d, "", "cat at \{size} bytes: \{d}");
    }

    // And through `writeFile`, which is where `cp` was failing.
    fs.remove(dst, false).wait();
    auto cpRan = flatten(procs.exec(binaryPath(env), [app, "cp", src, dst], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
    Exec? cp = cpRan.ok();
    t.isTrue((cp is not null) && cp!.status == 0,
             "cp at \{size}: \{string.fromBytes(cp!.stderr)}");
    if ((cp is not null) && cp!.status == 0) {
      auto backRead = flatten(fs.readFile(dst).wait());
      u8[]? back = backRead.ok();
      t.isTrue((back is not null), "cp at \{size} wrote a file — \{backRead.isErr() ? "\{backRead.err()!}" : ""}");
      if ((back is not null)) {
        string d = firstDifference(back!, data);
        t.eqStr(d, "", "cp at \{size} bytes: \{d}");
      }
    }
  }

  // Both directions at once, through a compressor. `src` is still the last size written above.
  auto dataRead = flatten(fs.readFile(src).wait());
  u8[]? data = dataRead.ok();
  t.isTrue((data is not null), "the source is still there — \{dataRead.isErr() ? "\{dataRead.err()!}" : ""}");
  if ((data is not null)) {
    auto gzRan = flatten(procs.exec(binaryPath(env), [app, "gzip", src], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
    Exec? gz = gzRan.ok();
    t.isTrue((gz is not null) && gz!.status == 0, "gzip ran — \{string.fromBytes(gz!.stderr)}");
    // Compressed, rather than handed back unchanged — a `gzip` that copied its input would round
    // trip perfectly and prove nothing about either direction.
    t.isTrue((gz is not null) && gz!.stdout.len() > 0 && gz!.stdout.len() < data!.len(),
             "gzip made it no smaller: \{gz!.stdout.len()} from " +
             "\{data!.len()}");
    if ((gz is not null) && gz!.status == 0) {
      auto backRan = flatten(procs.exec(binaryPath(env), [app, "gunzip"], gz!.stdout, ChildEnv.inherited(), Launch.plain()).wait());
      Exec? back = backRan.ok();
      t.isTrue((back is not null) && back!.status == 0, "gunzip ran — \{string.fromBytes(back!.stderr)}");
      if ((back is not null) && back!.status == 0) {
        string d = firstDifference(back!.stdout, data!);
        t.eqStr(d, "", "gzip and back at \{data!.len()} bytes: \{d}");
      }
    }
  }
  fs.remove(dir, true).wait();
  return t.report();
}
