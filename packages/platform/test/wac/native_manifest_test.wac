// The manifest a non-JavaScript host reads has to agree with itself.
//
// `native/src/manifest.rs` resolves a funcref field by looking its *type string* up among the
// callbacks — `callback_index(ty)` — so a field spelled one way and a callback spelled another is a
// capability the host cannot wire, and it fails at run time in a program rather than here. Nothing
// checks the spelling from outside, which is what makes the property worth asserting: both sides come
// from the same compiler, and the compiler changed.
//
// It also has to contain the names the host asks for by hand. `main.rs` maps its own `Kind`s onto
// `Pending<i32>`, `Pending<u8[]?>` and the rest, and `Pending<u8[]?>` is the interesting one: the
// emitter collapses it into `Pending<u8[]>`, because a nullable reference and a reference are the
// same wasm type, and records the second spelling as an alias. The manifest carries both names,
// pointing at one type [issue 0106].
//
// Host-side until 2026-08-19, `issues/system/0161`. `native.ts` is run rather than imported, and its
// `.json` is read with `packages/json` — the same route `test/wac/../wacc/test/wac/manifest_test.wac`
// takes to compare the two derivations of this file.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli, Exec } from "std/platform.wac";
import { startsWith, endsWith, joined } from "../../../wactest/src/strings.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { jsonFile, objectOf, strOf, arrayOf } from "../../../wactest/src/jsonfile.wac";
import { JsonValue, JsonObject, JsonArray } from "../../../json/src/value.wac";

string root(Cli cli) { return cli.cwd().wait(); }

/** What `native/src/main.rs` looks up by name, and would return `None` for if it were absent. */
string[] hostNeeds() {
  return string[](
    "Core",
    "Cli",
    "Pending<i32>",
    "Pending<i64>",
    "Pending<bool>",
    "Pending<string>",
    "Pending<u8[]>",
    "Pending<u8[]?>");
}

bool listed(string[] all, string want) {
  for (i32 i = 0; i < all.len(); i++) { if (all[i] == want) { return true; } }
  return false;
}

/** The `name` of every member of an array of objects. */
string[] namesIn(JsonArray items) {
  string[] out = string[items.len()](fill: "");
  for (i32 i = 0; i < items.len(); i++) { out[i] = strOf(objectOf(items.get(i)), "name"); }
  return out;
}

/** The member of an array of objects whose `name` is `want`, or -1. */
i32 indexOfNamed(JsonArray items, string want) {
  for (i32 i = 0; i < items.len(); i++) {
    if (strOf(objectOf(items.get(i)), "name") == want) { return i; }
  }
  return -1;
}

export string test_the_manifest_resolves_its_own_funcref_fields_and_names_what_the_host_asks_for(
    Core core, Cli cli) {
  T t = T.create();
  string dir = root(cli) + "/.cache/nativemanifest";
  cli.remove(dir, true).wait();
  cli.mkdir(dir, true).wait();

  Exec r = cli.exec("deno",
    string[]("run", "-A", "packages/platform/native.ts", "packages/platform/example/wc.wac",
             "--allow-read", "-o", dir + "/wc"), u8[0]()).wait();
  t.isTrue(r.ran() && r.status == 0,
           "native.ts built it — " + string.fromBytes(r.stderr) + string.fromBytes(r.stdout));
  if (!r.ran() || r.status != 0) { cli.remove(dir, true).wait(); return t.report(); }

  JsonObject m = jsonFile(cli, dir + "/wc.json");
  JsonArray callbacks = arrayOf(m, "callbacks");
  JsonArray structs = arrayOf(m, "structs");
  // Asserted, not assumed: an empty manifest satisfies every "no field names a missing dispatcher"
  // check below without describing anything.
  t.isTrue(callbacks.len() > 0, "the manifest lists no callbacks");
  t.isTrue(structs.len() > 0, "the manifest describes no structs");

  string[] callbackTypes = string[callbacks.len()](fill: "");
  for (i32 i = 0; i < callbacks.len(); i++) {
    callbackTypes[i] = strOf(objectOf(callbacks.get(i)), "type");
  }

  string[] unresolved = string[64](fill: "");
  i32 nUnresolved = 0;
  for (i32 i = 0; i < structs.len(); i++) {
    JsonObject s = objectOf(structs.get(i));
    string sname = strOf(s, "name");
    JsonArray fields = arrayOf(s, "fields");
    for (i32 f = 0; f < fields.len(); f++) {
      JsonObject fo = objectOf(fields.get(f));
      string ty = strOf(fo, "type");
      // **An array of funcrefs is an array.** `fn[void(i32)][]` starts with `fn[` too, and the host
      // wires *funcref fields* — a field holding a table of them is the module's own storage and
      // crosses nothing. The compiler made the same mistake in `isFuncrefType`, where it made every
      // module holding such a table invalid; `spec/cases/0196` is that one.
      if (!startsWith(ty, "fn[") || endsWith(ty, "[]")) { continue; }
      if (!listed(callbackTypes, ty) && nUnresolved < 64) {
        unresolved[nUnresolved] = sname + "." + strOf(fo, "name") + ": " + ty;
        nUnresolved = nUnresolved + 1;
      }
    }
  }
  string[] firstFew = string[nUnresolved < 5 ? nUnresolved : 5](fill: "");
  for (i32 i = 0; i < firstFew.len(); i++) { firstFew[i] = unresolved[i]; }
  t.eqI32(nUnresolved, 0,
          itoa(nUnresolved) + " funcref field(s) name a signature the manifest has no dispatcher " +
          "for — the host cannot wire them: " + joined(firstFew, " | "));

  string[] names = namesIn(structs);
  string[] needs = hostNeeds();
  string[] missing = string[needs.len()](fill: "");
  i32 nMissing = 0;
  for (i32 i = 0; i < needs.len(); i++) {
    if (!listed(names, needs[i])) { missing[nMissing] = needs[i]; nMissing = nMissing + 1; }
  }
  string[] gone = string[nMissing](fill: "");
  for (i32 i = 0; i < nMissing; i++) { gone[i] = missing[i]; }
  t.eqI32(nMissing, 0,
          "the manifest does not name " + joined(gone, ", ") + " — main.rs asks for each");

  // **Every enum says how to build it.** `Read` is what `readChunk` answers with, and a host that is
  // not told `$bind$e_Read_Data_new` spells it — which both hosts did until this field existed,
  // making three copies of one convention, two of which keep working wrongly the day it changes
  // [issue 0141]. The check is that the manifest describes enums at all, and names a constructor for
  // each variant.
  i32 at = indexOfNamed(structs, "Read");
  t.isTrue(at >= 0, "the manifest describes no Read, which is what every readChunk answers with");
  if (at >= 0) {
    JsonArray variants = arrayOf(objectOf(structs.get(at)), "variants");
    string[] wanted = string[]("Data", "End", "Failed");
    for (i32 i = 0; i < wanted.len(); i++) {
      i32 v = indexOfNamed(variants, wanted[i]);
      t.isTrue(v >= 0, "Read has no " + wanted[i] + " variant in the manifest");
      if (v < 0) { continue; }
      string make = strOf(objectOf(variants.get(v)), "make");
      t.isTrue(startsWith(make, "$bind$"),
               "Read." + wanted[i] + " names \"" + make + "\", which is not an export");
    }
    // A payload is part of the description too: `Data(u8[] bytes)` is what makes it constructible.
    i32 d = indexOfNamed(variants, "Data");
    if (d >= 0) {
      JsonArray df = arrayOf(objectOf(variants.get(d)), "fields");
      t.eqI32(df.len(), 1, "Read.Data carries " + itoa(df.len()) + " fields, expected one");
      if (df.len() == 1) {
        t.eqStr(strOf(objectOf(df.get(0)), "type"), "u8[]", "Read.Data's payload");
      }
    }
  }

  // The dispatcher naming is a convention shared with `emit.wac` and the Rust host, so it is stated
  // once here rather than trusted three times.
  for (i32 i = 0; i < callbacks.len(); i++) {
    JsonObject c = objectOf(callbacks.get(i));
    t.eqStr(strOf(c, "field"), "cb" + itoa(i), "callback " + itoa(i) + "'s field");
    t.eqStr(strOf(c, "helper"), "$bind$fnref_" + itoa(i), "callback " + itoa(i) + "'s helper");
  }

  cli.remove(dir, true).wait();
  return t.report();
}
