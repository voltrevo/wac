// The manifest a non-JavaScript host reads has to agree with itself.
//
// `native/src/manifest.rs` resolves a funcref field by looking its *type string* up among the
// callbacks — `callback_index(ty)` — so a field spelled one way and a callback spelled another is a
// capability the host cannot wire, and it fails at run time in a program rather than here. Nothing
// checks the spelling from outside, which is what makes the property worth asserting: both sides come
// from the same compiler, and the compiler changed.
//
// It also has to describe what the host looks up by hand, which since design/system/0013 step 6 is one export:
// `__wacHost`, whose four parameters are the host's calls and are bound by their type strings, beside
// `__wacAnswered` and a `main` taking the `__WacHost` it answers.
//
// Host-side until 2026-08-19, `issues/system/0161`. **Built with `wac build`**, which is the producer:
// it writes the module and the `.json` beside it, from `manifest.wac`. That was `deno run native.ts`
// until 2026-08-19, when the two were re-measured as byte-identical and the Deno path stopped being
// the one anything is built with — see `issues/system/0214`. Testing the manifest
// the toolchain actually writes is the point; testing that a second derivation agrees with it was a
// separate file, and it is gone.

import { T } from "../../../wactest/src/assert.wac";
import { Exec, ChildEnv, Env, Files, Launch, Output, Procs, Sys } from "std";
import { startsWith, endsWith, joined } from "../../../wactest/src/strings.wac";
import { jsonFile, strOf, arrayOf } from "../../../wactest/src/jsonfile.wac";
import { customSection } from "./section.wac";
import { JsonValue, JsonObject, JsonArray } from "../../../json/src/value.wac";
import { freshDir } from "../../../wactest/src/host.wac";
import { flatten } from "core";

string root(Env env) { return flatten(env.cwd().wait()).unwrap(); }

bool listed(string[] all, string want) {
  for (i32 i = 0; i < all.len(); i++) { if (all[i] == want) { return true; } }
  return false;
}

/** The `name` of every member of an array of objects. */
string[] namesIn(JsonArray items) {
  string[] out = string[].filled(items.len(), "");
  for (i32 i = 0; i < items.len(); i++) { out[i] = strOf(items.get(i).object()!, "name"); }
  return out;
}

/** The member of an array of objects whose `name` is `want`, or -1. */
i32 indexOfNamed(JsonArray items, string want) {
  for (i32 i = 0; i < items.len(); i++) {
    if (strOf(items.get(i).object()!, "name") == want) { return i; }
  }
  return -1;
}

export string test_the_manifest_resolves_its_own_funcref_fields_and_names_what_the_host_asks_for(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = "\{root(env)}/.cache/nativemanifest";
  string whyDir = freshDir(fs, dir);
  t.isTrue(whyDir == "", whyDir);

  auto rRan = flatten(procs.exec("\{root(env)}/native/v8/target/release/wac", [
             "build", "packages/platform/example/wc.wac",
             "--allow-read", "-o", "\{dir}/wc", "--quiet"
    ], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null) && r!.status == 0,
           "wac build wrote it — \{string.fromBytes(r!.stderr)}\{string.fromBytes(r!.stdout)}");
  if ((r is null) || r!.status != 0) { fs.remove(dir, true).wait(); return t.report(); }

  // **Out of the module**, where the manifest lives as a `wac.manifest` section. It was a `.json`
  // beside it until 2026-08-20 — read `native/manifest` for why that went.
  auto builtRead = flatten(fs.readFile("\{dir}/wc.wasm").wait());
  u8[]? built = builtRead.ok();
  t.isTrue((built is not null), "the build wrote no module — \{builtRead.isErr() ? "\{builtRead.err()!}" : ""}");
  if ((built is null)) { fs.remove(dir, true).wait(); return t.report(); }
  string text = customSection(built!, "wac.manifest");
  t.isTrue(text.len() > 0, "the module carries no `wac.manifest` section");
  if (text.len() == 0) { fs.remove(dir, true).wait(); return t.report(); }
  fs.writeFile("\{dir}/manifest.json", text.toBytes()).wait();
  JsonObject m = jsonFile(fs, "\{dir}/manifest.json");
  JsonArray callbacks = arrayOf(m, "callbacks");
  JsonArray structs = arrayOf(m, "structs");
  // Asserted, not assumed: an empty manifest satisfies every "no field names a missing dispatcher"
  // check below without describing anything.
  t.isTrue(callbacks.len() > 0, "the manifest lists no callbacks");
  // **A program describes no struct** (`issues/lang/0398a`): its boundary is the host ABI, whose one value,
  // `__WacHost`, crosses opaque. The funcref-field property below is checked on a library, which does describe
  // its structs — `test_a_librarys_funcref_fields_name_its_callbacks`.
  t.eqI32(structs.len(), 0, "a program's manifest describes structs");

  string[] callbackTypes = string[].filled(callbacks.len(), "");
  for (i32 i = 0; i < callbacks.len(); i++) {
    callbackTypes[i] = strOf(callbacks.get(i).object()!, "type");
  }

  string[] unresolved = string[].filled(64, "");
  i32 nUnresolved = 0;
  for (i32 i = 0; i < structs.len(); i++) {
    JsonObject s = structs.get(i).object()!;
    string sname = strOf(s, "name");
    JsonArray fields = arrayOf(s, "fields");
    for (i32 f = 0; f < fields.len(); f++) {
      JsonObject fo = fields.get(f).object()!;
      string ty = strOf(fo, "type");
      // **An array of funcrefs is an array.** `fn[void(i32)][]` starts with `fn[` too, and the host
      // wires *funcref fields* — a field holding a table of them is the module's own storage and
      // crosses nothing. The compiler made the same mistake in `isFuncrefType`, where it made every
      // module holding such a table invalid; `spec/cases/0196` is that one.
      if (!startsWith(ty, "fn[") || endsWith(ty, "[]")) { continue; }
      if (!listed(callbackTypes, ty) && nUnresolved < 64) {
        unresolved[nUnresolved] = sname + "." + strOf(fo, "name") + ": " + ty;
        nUnresolved = nUnresolved + 1;
      }
    }
  }
  string[] firstFew = string[].filled(nUnresolved < 5 ? nUnresolved : 5, "");
  for (i32 i = 0; i < firstFew.len(); i++) { firstFew[i] = unresolved[i]; }
  t.eqI32(nUnresolved, 0,
          "\{nUnresolved} funcref field(s) name a signature the manifest has no dispatcher " +
          "for — the host cannot wire them: " + joined(firstFew, " | "));

  // **The host's way in.** `__wacHost` takes the host's four calls, and each is bound by looking its type up among
  // the callbacks — so a parameter spelled one way and a callback spelled another is a program no host can start.
  JsonArray exports = arrayOf(m, "exports");
  i32 make = indexOfNamed(exports, "__wacHost");
  t.isTrue(make >= 0, "the manifest names no `__wacHost` export, which every host calls first");
  if (make >= 0) {
    JsonArray params = arrayOf(exports.get(make).object()!, "params");
    t.eqI32(params.len(), 4, "`__wacHost` takes \{params.len()} parameters, not the host's four calls");
    for (i32 i = 0; i < params.len(); i++) {
      string ty = params.get(i).text()!;
      t.isTrue(listed(callbackTypes, ty), "`__wacHost` parameter \{i} is \{ty}, which no callback describes");
    }
  }
  t.isTrue(indexOfNamed(exports, "__wacAnswered") >= 0, "the manifest names no `__wacAnswered`, which every answer goes through");
  i32 main = indexOfNamed(exports, "main");
  t.isTrue(main >= 0, "the manifest names no `main`");
  if (main >= 0) {
    JsonArray params = arrayOf(exports.get(main).object()!, "params");
    t.isTrue(params.len() == 1 && params.get(0).text()! == "__WacHost", "`main` does not take the `__WacHost`");
  }

  // The dispatcher naming is a convention shared with `emit.wac` and the Rust host, so it is stated
  // once here rather than trusted three times.
  for (i32 i = 0; i < callbacks.len(); i++) {
    JsonObject c = callbacks.get(i).object()!;
    t.eqStr(strOf(c, "field"), "cb\{i}", "callback \{i}'s field");
    t.eqStr(strOf(c, "helper"), "$bind$fnref_\{i}", "callback \{i}'s helper");
  }

  fs.remove(dir, true).wait();
  return t.report();
}

/**
 * A program declaring a name `platform.wac` also declares still runs.
 *
 * The case the check above did not have. It builds `example/wc.wac`, which clashes with nothing — and a
 * clash was the one thing that broke the property: two files declaring `Stat` made the linker qualify
 * `platform.wac`'s, so `Cli.stat`'s signature carried `Stat__std_platform` while the *callback* carried
 * the raw linker key `Stat@1`. Two spellings of one type, `callback_index` matches by string, and the
 * host reported `main wants a Cli and the manifest describes none` — about a manifest that described one.
 * `issues/lang/0162b`.
 *
 * Asserted end to end rather than over the manifest, because the manifest agreeing with itself is what
 * the test above is for; this one asks the question a user asks. `Stat` is the name it cost twenty
 * minutes in `packages/crypto/tools/ct.wac`, and `platform.wac` declares eight more ordinary words —
 * `Change`, `Exec`, `Child`, `Socket`, `Read`, `Captured`, `FileResult`, `Datagram`.
 */
export string test_a_program_declaring_a_name_platform_also_declares_still_runs(Sys sys) {
  Output out = sys.stdout();
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = "\{root(env)}/.cache/nameclash";
  string whyDir = freshDir(fs, dir);
  t.isTrue(whyDir == "", whyDir);

  string src = "import { Output, Sys } from \"std\";\n" +
               "struct Stat { i32 n; }\n" +
               "export i32 main(Sys sys) {\n  Output out = sys.stdout();\n" +
               "  Stat s = Stat(1);\n" +
               "  out.line(\"n=\" + (s.n == 1 ? \"1\" : \"?\"));\n" +
               "  return 0;\n}\n";
  t.isTrue(flatten(fs.writeFile("\{dir}/clash.wac", src.toBytes()).wait()).isOk(), "wrote the fixture");

  auto rRan = flatten(procs.exec("\{root(env)}/native/v8/target/release/wac", ["run", "--allow-read", "\{dir}/clash.wac"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  string said = string.fromBytes(r!.stdout) + string.fromBytes(r!.stderr);
  t.isTrue((r is not null), "wac did not run — \{rRan.isErr() ? "\{rRan.err()!}" : ""}");
  if ((r is not null)) {
    t.eqI32(r!.status, 0, "a struct named like one in platform.wac stopped the program: \{said}");
    t.isTrue(said.indexOf("n=1") >= 0, "the program did not print n=1 — \{said}");
  }

  fs.remove(dir, true).wait();
  return t.report();
}

/**
 * A library's struct with a funcref field, described with a callback the host can bind it by — the property the
 * program above can no longer show, since a program describes no struct. Asserted on a struct that has the field, so
 * an empty manifest cannot satisfy it.
 */
export string test_a_librarys_funcref_fields_name_its_callbacks(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = "\{root(env)}/.cache/nativemanifest-lib";
  string whyDir = freshDir(fs, dir);
  t.isTrue(whyDir == "", whyDir);
  fs.writeFile("\{dir}/lib.wac",
               "export struct Handler { fn<void(i32)> on; i32 n; }\nexport Handler make(i32 n) { return Handler((i32 x) => { }, n); }\n".toBytes()).wait();
  auto rRan = flatten(procs.exec("\{root(env)}/native/v8/target/release/wac", ["build", "\{dir}/lib.wac", "-o", "\{dir}/lib", "--quiet"],
                                 u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null) && r!.status == 0, "wac build wrote it");
  u8[]? built = flatten(fs.readFile("\{dir}/lib.wasm").wait()).ok();
  if ((built is null)) { fs.remove(dir, true).wait(); return t.report(); }
  fs.writeFile("\{dir}/manifest.json", customSection(built!, "wac.manifest").toBytes()).wait();
  JsonObject m = jsonFile(fs, "\{dir}/manifest.json");
  JsonArray callbacks = arrayOf(m, "callbacks");
  JsonArray structs = arrayOf(m, "structs");
  string[] callbackTypes = string[].filled(callbacks.len(), "");
  for (i32 i = 0; i < callbacks.len(); i++) { callbackTypes[i] = strOf(callbacks.get(i).object()!, "type"); }
  i32 checked = 0;
  for (i32 i = 0; i < structs.len(); i++) {
    JsonObject so = structs.get(i).object()!;
    JsonArray fields = arrayOf(so, "fields");
    for (i32 f = 0; f < fields.len(); f++) {
      string ty = strOf(fields.get(f).object()!, "type");
      if (!startsWith(ty, "fn[") || endsWith(ty, "[]")) { continue; }
      checked = checked + 1;
      t.isTrue(listed(callbackTypes, ty), "\{strOf(so, "name")}.\{strOf(fields.get(f).object()!, "name")}: \{ty} has no callback");
    }
  }
  t.eqI32(checked, 1, "funcref fields checked");
  fs.remove(dir, true).wait();
  return t.report();
}
