// Running a program under a bound, in a directory, with an environment of exactly what is named.
//
// Three things the tests here need that `Cli.exec` does not have on its own, and all three are one
// shell line because that is where they belong: `exec` takes a program and arguments, not a working
// directory, and `issues/system/0199` is why a child's `cwd` is not an option either.
//
// **A bound that fired is not an answer.** `timeout` exits 124, which is a real status a program
// could also return, so it is carried as its own field rather than compared as a number — a run that
// hung and a run that answered 124 are different facts and only one of them is a failure of the thing
// under test. `harness/bounded.ts` made the same argument for the same reason.
//
// **And it is asked again.** A machine three agents share loses a race it would win alone, so a first
// bound that fires is retried at three times the length before anyone is told about a hang. That is
// `issues/system/0128`: a fixed wall-clock bound cannot tell a slow start from a dead one, and the
// cost of being wrong in the generous direction is seconds, once.
//
// Not a test file and not discovered as one: `wac test` walks `*_test.wac`.

import { Core, Cli, Exec, Stat, Pending } from "std/platform.wac";
import { quoted } from "../../../wactest/src/childenv.wac";
import { newestInClosure } from "../../../wactest/src/built.wac";
import { itoa, atoi } from "../../../fmt/src/itoa.wac";
import { Buf } from "../../../bytes/src/buf.wac";
import { hex } from "../../../wactest/src/oracle.wac";
import { decoded } from "../../../codec/src/hex.wac";
import { splitLines } from "../../../wactest/src/strings.wac";

/** How long a run gets before the bound is called a hang. Generous on purpose. */
export const i32 DEFAULT_SECONDS = 60;

/** What a bounded run answers: the program's own result, or the fact that it never gave one. */
export struct Ran {
  i32 code;
  string out;
  string err;
  /** `timeout` fired: there is no answer here, and `code` is its 124 rather than the program's. */
  bool hung;
}

/**
 * The environment every case runs in, and nothing else.
 *
 * `env -i` rather than inheriting: `LC_ALL=C` is what makes GNU's messages comparable at all, and a
 * `LANG` left over from the shell that started the suite would undo it. `PATH` and `HOME` are the two
 * the real tools actually need.
 */
string envLine(Cli cli, string home) {
  string path = "/usr/bin:/bin";
  u8[]? p = cli.env("PATH").wait();
  if (p is not null) { path = string.fromBytes(p!); }
  return "env -i LC_ALL=C " + quoted("PATH=" + path) + " " + quoted("HOME=" + home);
}

/**
 * Start a run without waiting for it.
 *
 * **Submitted, not waited for**, which is a thing wac could not do until 2026-08-19: both Rust hosts
 * ran the child to completion inside `exec` and handed back a ticket that was already settled, so
 * three tickets taken before any wait still took three times as long. `issues/system/0211`. It
 * matters here because the three answers a case compares — GNU's, one host's, the other's — are
 * independent runs over three separate trees, so they are three-way concurrent for free.
 */
export Pending<Exec> submit(Cli cli, i32 seconds, string cwd, string home, string prog,
                            string[] args, u8[] stdin) {
  string line = "cd " + quoted(cwd) + " && exec timeout " + itoa(seconds) + " " +
                envLine(cli, home) + " " + quoted(prog);
  for (i32 i = 0; i < args.len(); i++) { line = line + " " + quoted(args[i]); }
  return cli.exec("/bin/sh", string[]("-c", line), stdin);
}

export Ran collect(Pending<Exec> p) {
  Exec r = p.wait();
  if (!r.ran()) { return Ran(-1, "", "the shell did not run — " + r.error, false); }
  return Ran(r.status, string.fromBytes(r.stdout), string.fromBytes(r.stderr), r.status == 124);
}

Ran once(Core core, Cli cli, i32 seconds, string cwd, string home, string prog, string[] args,
         u8[] stdin) {
  return collect(submit(cli, seconds, cwd, home, prog, args, stdin));
}

/**
 * Run it, and ask again at three times the bound if the first attempt did not finish.
 *
 * `refresh` is called between the two attempts, because every case here works over a tree the first
 * attempt may have written to — a retry against a directory the first run half-edited is not the same
 * experiment.
 */
export Ran boundedAgain(Core core, Cli cli, string cwd, string home, string prog, string[] args,
                        u8[] stdin, fn[void()] refresh) {
  Ran first = once(core, cli, DEFAULT_SECONDS, cwd, home, prog, args, stdin);
  if (!first.hung) { return first; }
  refresh();
  return once(core, cli, DEFAULT_SECONDS * 3, cwd, home, prog, args, stdin);
}

/** Whichever of these hung, named — or empty when none did. */
export string hangReport(string what, string[] names, Ran[] runs) {
  string stuck = "";
  for (i32 i = 0; i < runs.len() && i < names.len(); i++) {
    if (runs[i].hung) { stuck = stuck == "" ? names[i] : stuck + " and " + names[i]; }
  }
  if (stuck == "") { return ""; }
  return stuck + " did not finish `" + what + "` within " + itoa(DEFAULT_SECONDS) +
         "s, twice — there is no answer to compare, so nothing below was checked";
}

/**
 * Whether `artifact` is older than any file `entry` is made of, and so has to be built again.
 *
 * The rule `harness/nativeHost.ts` uses for the crate and `tools/seedFresh.test.ts` uses for the
 * seed: mtimes, not content.
 *
 * **It used to ask about the whole tree** — `find packages core spec -name '*.wac' -newer …` — and that
 * was measured on 2026-08-19: touching `packages/tor/src/relay.wac`, which none of these shells
 * imports, took `v8host_test.wac` from 1.5s to **38.9s** because all six of its artefacts were rebuilt.
 * The gate pulls before it runs, so the three files that call this were the top three of every gate log
 * that day at 42–58s each, and they are not slow tests. `issues/system/0217`.
 *
 * `newest` is what `newestFor` answers: the newest mtime among an entry and the files it imports,
 * derived by scanning rather than named by a caller, and taken once per program by the caller. `packages/box/src/bin/sh.wac` reaches 190
 * of the tree's 902 `.wac` files, so four edits in five no longer touch these.
 *
 * What this still does not ask about is the **binary**: an artefact built by an older `wac` is not
 * rebuilt when the host is. That was true of the `find` too, so it is left as it was rather than
 * changed in passing — `wactest/src/built.wac` does check it, and the difference is worth knowing.
 */
export bool stale(Cli cli, string artifact, i64 newest) {
  Stat s = cli.stat(artifact).wait();
  if (!s.isFile) { return true; }
  return newest > s.modifiedMillis;
}

/**
 * `newestInClosure`, and **once per entry rather than once per artefact.**
 *
 * The first version of this took the entry and walked it inside `stale`, which read 190 files six times
 * over for `native_hostfs_test.wac`'s six shells — 9.4s of self CPU in the gate that landed it, where
 * that file had been spending 0.3s. The walk is per *program*, so the callers below take it once and
 * hand the answer to each check.
 */
export i64 newestFor(Cli cli, string entry) { return newestInClosure(cli, entry); }

/**
 * Every script through the **Deno host in one process**, rather than one process each.
 *
 * A built Deno bundle costs 133ms to start, against 17ms for `wacland` and 2ms for bash — measured
 * 2026-08-19 — and these files make about a hundred such runs. `harness/appRunMany.ts` is
 * `harness/appRun.ts`'s worker behind one `exec`: it builds the program once and runs it per request
 * at about 1.25ms. That is what took `native_hostfs.test.ts` from 29s to 9.4s while it was still
 * TypeScript, and `issues/system/0213` is why a wac test could not have it until now.
 *
 * **The comparison is unchanged.** Same entry, same grants, same capability implementations, same
 * environment — `env` is passed explicitly for the same reason `envLine` exists, so a differential
 * runs against a fixed world rather than the suite's.
 *
 * **A batch that does not answer is every case hung, not a silent short answer.** The bound is on the
 * whole call, and a short or missing answer list makes every request `hung` — which puts each case
 * into the caller's existing retry, one process apiece, exactly as before this existed. That is the
 * rule `issues/system/0128` asks for: a bound that fired is a report rather than an answer.
 */
export Ran[] denoBatch(Cli cli, i32 seconds, string entry, string[] grants, string home,
                       string[] cwds, string[][] argvs, u8[][] stdins) {
  u8[] env = joinedNul(envStrings(cli, home));
  string body = "";
  for (i32 i = 0; i < cwds.len(); i++) {
    body = body + "run " + hex(joinedNul(argvs[i])) + " " + hex(cwds[i].toBytes()) + " " +
           hex(stdins[i]) + " " + hex(env) + "\n";
  }

  string line = "exec timeout " + itoa(seconds) + " deno run -A harness/appRunMany.ts " +
                quoted(entry);
  for (i32 i = 0; i < grants.len(); i++) { line = line + " " + quoted(grants[i]); }
  Exec r = cli.exec("/bin/sh", string[]("-c", line), body.toBytes()).wait();

  Ran[] out = Ran[cwds.len()](fill: Ran(0, "", "", false));
  string[] lines = r.ran() ? splitLines(string.fromBytes(r.stdout)) : string[0](fill: "");
  i32 at = 0;
  for (i32 i = 0; i < lines.len() && at < out.len(); i++) {
    if (lines[i].len() < 4 || lines[i].slice(0, 4) != "ran ") { continue; }
    string rest = lines[i].slice(4, lines[i].len());
    i32 sp1 = rest.indexOf(" ");
    if (sp1 < 0) { continue; }
    i32 code = atoi(rest.slice(0, sp1));
    string tail = rest.slice(sp1 + 1, rest.len());
    i32 sp2 = tail.indexOf(" ");
    string outHex = sp2 < 0 ? tail : tail.slice(0, sp2);
    string errHex = sp2 < 0 ? "" : tail.slice(sp2 + 1, tail.len());
    out[at] = Ran(code, string.fromBytes(decoded(outHex)), string.fromBytes(decoded(errHex)), false);
    at = at + 1;
  }
  // Short of a full set of answers is the batch having failed, however it failed: every case goes
  // back to the caller marked hung, and the caller's retry runs it one process at a time.
  if (at != out.len()) {
    string why = r.ran() ? string.fromBytes(r.stderr) : r.error;
    for (i32 i = 0; i < out.len(); i++) {
      out[i] = Ran(124, "", "the batch answered " + itoa(at) + " of " + itoa(out.len()) + " — " + why,
                   true);
    }
  }
  return out;
}

/** The same fixed world `envLine` builds, as `K=V` strings for `appRunMany`. */
string[] envStrings(Cli cli, string home) {
  string path = "/usr/bin:/bin";
  u8[]? p = cli.env("PATH").wait();
  if (p is not null) { path = string.fromBytes(p!); }
  return string[]("LC_ALL=C", "PATH=" + path, "HOME=" + home);
}

/**
 * The strings with a NUL between them, which is the one separator an argument cannot contain.
 *
 * Built as bytes because a string is bytes here, so saying so directly loses nothing.
 *
 * **This said "wac has no escape for a NUL in a string literal", and it has one.** `spec/spec/strings.md`
 * lists `\0` beside `\n`, `\t`, `\\` and `\"` in a tagged example — `[§wac-str-esc-h9qm3v7]`, which
 * asserts each is a single byte — and `"a\0b".toBytes()` is three bytes with a zero in the middle,
 * checked. The code is unchanged because building bytes is the honest shape for a byte separator; only
 * the reason was wrong, and a false claim about the language is worth correcting wherever it sits.
 */
u8[] joinedNul(string[] parts) {
  Buf b = Buf.create();
  u8[] zero = u8[1]();
  for (i32 i = 0; i < parts.len(); i++) {
    if (i > 0) { b.pushAll(zero); }
    b.pushAll(parts[i].toBytes());
  }
  return b.take();
}
