// `deno task app` — build and run — and what happens when the launcher is killed.
//
// It spawns the built artifact as a child, so "kill the launcher" and "stop the application" are two
// different things unless something connects them. Nothing did: `packages/ssh`'s server tests started
// an sshd this way and killed the launcher afterwards, and each run left a server alive. That reached
// 57 orphaned servers and 13,736 zombie children against a container limit of 14,180 process ids, at
// which point unrelated commands began failing with `failed to create new OS thread` — and the tests
// passed the whole time. wac-mono issue 0017.
//
// The child is found by *looking for it in the process table*, which is the only check that answers
// the question. Asserting that the launcher exited proves nothing about what it left behind.
//
// Host-side until 2026-08-19, `issues/system/0161`. `daemon.wac`'s `stop` sends `kill` with no
// signal, which is SIGTERM — the signal the launcher has to forward, and the one the whole test is
// about. A SIGKILL would pass this test by removing the launcher's chance to do the wrong thing.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli, Exec } from "std/platform.wac";
import { contains, splitLines, trimmed } from "../../../wactest/src/strings.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { Daemon, start, stop, logOf } from "../../../wactest/src/daemon.wac";

string root(Cli cli) { return cli.cwd().wait(); }

/**
 * The *application's* command lines, by a marker in its arguments.
 *
 * `app.ts` is excluded, and that exclusion is the whole helper: the launcher's own command line
 * carries the same marker, so matching it made the first version of this test pass in 39
 * milliseconds — the "application" it found was the launcher, and killing the launcher of course made
 * it disappear. The child is the built artifact, which mentions neither `app.ts` nor `deno run`.
 */
string[] processesMatching(Cli cli, string needle) {
  Exec r = cli.exec("ps", string[]("-eo", "args"), u8[0]()).wait();
  if (!r.ran()) { return string[0](fill: ""); }
  string[] all = splitLines(string.fromBytes(r.stdout));
  string[] hit = string[all.len()](fill: "");
  i32 n = 0;
  for (i32 i = 0; i < all.len(); i++) {
    string l = all[i];
    if (contains(l, needle) && !contains(l, "app.ts") && !contains(l, "-eo") &&
        trimmed(l).len() > 0) {
      hit[n] = l;
      n = n + 1;
    }
  }
  string[] out = string[n](fill: "");
  for (i32 i = 0; i < n; i++) { out[i] = hit[i]; }
  return out;
}

/** Wait for a count, or give up — a bounded wait, so a failure is a failure and not a hang. */
bool until(Core core, Cli cli, string needle, bool wantSome, i32 millis) {
  i64 deadline = core.nowMillis().wait() + (millis as i64);
  for (i32 guard = 0; guard < 100000; guard++) {
    i32 n = processesMatching(cli, needle).len();
    if (wantSome ? (n > 0) : (n == 0)) { return true; }
    if (core.nowMillis().wait() >= deadline) { return false; }
    core.sleepMillis(100).wait();
  }
  return false;
}

export string test_killing_deno_task_app_stops_the_application_it_started(Core core, Cli cli) {
  T t = T.create();
  // A marker in the arguments, so the search cannot match another agent's copy of this test.
  string marker = "wac-orphan-probe-" +
                  itoa((core.nowMillis().wait() % (1000000000 as i64)) as~ i32);
  string log = root(cli) + "/.cache/app-" + marker + ".log";
  cli.remove(log, false).wait();

  Daemon d = start(cli,
    "deno run -A packages/platform/app.ts packages/platform/example/waiter.wac -- " + marker, log);
  t.isTrue(d.pid > 0, "the launcher started");
  if (d.pid <= 0) { return t.report(); }

  // The application has to have *started* before killing anything, or the test would pass for the
  // wrong reason: a child that never ran is also a child that is not running afterwards.
  bool started = until(core, cli, marker, true, 60000);
  t.isTrue(started, "the application never appeared in the process table — " + logOf(cli, d));

  // **And what was found is the application, asserted rather than filtered.** The launcher carries
  // the same marker, and a search that matched it would pass this whole test in milliseconds — the
  // thing it killed would disappear because it was the launcher. The built artifact is a
  // self-contained file elsewhere on disk; the launcher's command line names a path in this
  // repository. So the check is that no match does.
  string[] running = processesMatching(cli, marker);
  for (i32 i = 0; i < running.len(); i++) {
    t.isTrue(!contains(running[i], "packages/platform"),
             "that is the launcher, not the application it started: " + running[i]);
  }

  // `stop` is `kill`, which is SIGTERM: the launcher gets its chance to forward it.
  stop(cli, d);

  // And now it should be gone. Given a moment: the launcher forwards the signal, the child gets it,
  // and both of those are asynchronous.
  bool gone = until(core, cli, marker, false, 30000);
  string[] left = processesMatching(cli, marker);
  t.isTrue(gone, itoa(left.len()) + " process(es) outlived the launcher");

  // Whatever happened, do not leave one behind — a failing test that leaks the thing it is about
  // would make the next run of the suite worse.
  cli.exec("/bin/sh", string[]("-c", "pkill -f '" + marker + "' 2>/dev/null; true"), u8[0]()).wait();
  cli.remove(log, false).wait();
  return t.report();
}
