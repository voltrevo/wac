// A child's world as a value: `Frame`, `childCli`, `childCore` — against the host frame it replaces.
//
// The claim is not that `insideValue.wac` works. It is that a child **cannot tell which of the two
// ran it**, so the test is a differential: `example/inside.wac` uses `pushChild`/`popChild` and
// `example/insideValue.wac` uses a substitute capability built from lambdas, the child function is
// copied between them unchanged, and their output must be identical.
//
// That is a real oracle rather than two runs of the same code: the host frame is 250 lines of
// TypeScript in `host/child.ts` written long before closures existed, and nothing in the wac
// implementation was derived from it beyond the behaviours its comments name.
//
// ## Both halves, on both hosts
//
// `build.ts` builds them and the built artefacts run them on the Deno host, which is what the
// TypeScript did. This file used to stop there, and said why: *"Run the same two programs under `wac
// run` and they disagree — the native host does not apply a pushed child's `cwd`… `issues/system/0199`.
// So the stronger test — the same differential with the binary running both halves — is not here and
// would be red. It is worth having and is a second pair of runs in this file on the day 0199 closes."*
//
// **0199 closed and the second pair was added** — `test_the_two_frames_agree_on_the_binary_as_well`
// below — and this header went on describing their absence, which is how a note that names its own
// next step goes stale: the step is taken and the sentence announcing it is not the sentence anybody
// edits. Read the tests rather than this paragraph if the two ever disagree again.
//
// Host-side until 2026-08-19, `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli, Exec, FAULT_NOT_GRANTED, FileResult, Stat } from "std/platform.wac";
import { Frame, Grants, childCliGranted } from "../../src/frame.wac";
import { contains } from "../../../wactest/src/strings.wac";
import { madeDir } from "../../../wactest/src/host.wac";

const string HOST = "packages/platform/example/inside.wac";
const string VALUE = "packages/platform/example/insideValue.wac";

string root(Cli cli) { return cli.cwd().wait(); }

/** What one run said. */
struct Said {
  string out;
  string err;
  i32 status;
  bool ran;
  string error;
}

/**
 * Build one example and run it in a directory of its own.
 *
 * A directory each, because the child opens a file by a relative path and writes it — two runs
 * sharing one would differ for a reason that has nothing to do with which frame served them.
 */
Said run(T t, Cli cli, string name, string entry, u8[] stdin) {
  string dir = root(cli) + "/.cache/frame-" + name;
  cli.remove(dir, true).wait();
  string whyDir1 = madeDir(cli, dir);
  t.isTrue(whyDir1 == "", whyDir1);
  string app = dir + "/app";
  Exec built = cli.exec("deno",
    string[]("run", "-A", "packages/platform/build.ts", entry,
             "--allow-read", "--allow-write", "-o", app), u8[0]()).wait();
  if (!built.ran() || built.status != 0) {
    cli.remove(dir, true).wait();
    return Said("", "", -1, false,
                entry + " did not build — " + string.fromBytes(built.stderr));
  }
  Exec r = cli.exec(app, string[](dir), stdin).wait();
  Said said = Said(string.fromBytes(r.stdout), string.fromBytes(r.stderr), r.status,
                   r.ran(), r.error);
  cli.remove(dir, true).wait();
  return said;
}

export string test_a_substitute_capability_answers_exactly_as_the_host_frame_does(
    Core core, Cli cli) {
  T t = T.create();
  Said host = run(t, cli, "host", HOST, u8[0]());
  Said value = run(t, cli, "value", VALUE, u8[0]());
  t.isTrue(host.ran, "the host-frame program ran — " + host.error);
  t.isTrue(value.ran, "the substitute-frame program ran — " + value.error);
  if (!host.ran || !value.ran) { return t.report(); }

  // Sanity before the comparison: two programs that both failed would agree perfectly.
  t.eqI32(host.status, 0, host.err);
  t.isTrue(contains(host.out, "FROM STDIN"), host.out);

  // The child's arguments, its input, the file it opened by a relative path, `write` and `log` in
  // the order it wrote them, `warn` on the other stream, the status, and `truncated`.
  t.eqStr(value.out, host.out, "the two frames told different stories");
  t.eqStr(value.err, host.err, "and on the other stream");
  t.eqI32(value.status, host.status, "and exited differently");
  return t.report();
}

export string test_a_substitute_capability_does_not_let_the_child_reach_the_real_standard_input(
    Core core, Cli cli) {
  // The same property `test/wac/inside_test.wac` pins for the host frame, and the one a shell depends
  // on: a filter running in process must not swallow the terminal. Here it is `Frame.take` answering
  // from its own bytes rather than the host being asked at all.
  T t = T.create();
  Said value = run(t, cli, "stdin", VALUE, "THE PARENT'S OWN INPUT\n".toBytes());
  t.isTrue(value.ran, "the substitute-frame program ran — " + value.error);
  if (!value.ran) { return t.report(); }
  t.isTrue(contains(value.out, "FROM STDIN"), "the child read its own feed: " + value.out);
  t.isTrue(!contains(value.out, "PARENT"), "the child read the real standard input: " + value.out);
  return t.report();
}

/**
 * The same differential, **run by the binary** — which is the host most things now use.
 *
 * The tests above build each example into a Deno app and run that, which is what the TypeScript did.
 * That makes the comparison blind to a divergence in the *other* host: `issues/system/0199` was
 * invisible for as long as both halves were served by the same one. On the binary the host frame
 * ignored a pushed child's `cwd`, so the child opened `note.txt` against the process directory and
 * found nothing, while the substitute frame — built from lambdas in wac — resolved it correctly. The
 * property this file exists for, *a child cannot tell which of the two frames ran it*, was false there.
 *
 * A directory each, for the reason `run` above gives: the child writes a file by a relative name.
 */
Said runOnBinary(Cli cli, string name, string entry) {
  string dir = root(cli) + "/.cache/framebin-" + name;
  cli.remove(dir, true).wait();
  cli.mkdir(dir, true).wait();
  Exec r = cli.exec(root(cli) + "/native/v8/target/release/wac",
    string[]("run", "--allow-read", "--allow-write", entry, "--", dir), u8[0]()).wait();
  Said said = Said(string.fromBytes(r.stdout), string.fromBytes(r.stderr), r.status,
                   r.ran(), r.error);
  cli.remove(dir, true).wait();
  return said;
}

export string test_the_two_frames_agree_on_the_binary_as_well(Core core, Cli cli) {
  T t = T.create();
  Said host = runOnBinary(cli, "host", HOST);
  Said value = runOnBinary(cli, "value", VALUE);
  t.isTrue(host.ran, "the host-frame program ran — " + host.error);
  t.isTrue(value.ran, "the substitute-frame program ran — " + value.error);
  if (!host.ran || !value.ran) { return t.report(); }

  // Sanity before the comparison, as above: two programs that both failed agree perfectly. The child
  // reading the file by a relative name is the whole point, so its line has to be there.
  t.eqI32(host.status, 0, host.err);
  t.isTrue(contains(host.out, "FROM THE FILE"),
           "the child did not read the file the parent left it — the frame's cwd was ignored: " +
           host.out);

  t.eqStr(value.out, host.out, "the two frames told different stories on the binary");
  t.eqStr(value.err, host.err, "and on the other stream");
  t.eqI32(value.status, host.status, "and exited differently");
  return t.report();
}


/**
 * A frame's child can be given **fewer** capabilities than its parent, and a withheld one answers
 * exactly what a host answers a program that was never granted it.
 *
 * `childCli` hands the parent's authority on untouched, which is right for the shell — a child is as
 * trusted as the shell that spawned it, `issues/system/0028` — and left a frame unable to model the
 * one thing this system is organised around. `childCliGranted` is the other half:
 * `issues/system/0302c`.
 *
 * **Each capability is asked with a control beside it.** A refusal proves nothing on its own: the same
 * failure would appear if the path were wrong, the fixture missing, or the frame's `cwd` unresolved.
 * The pair is what says the grant is doing the work.
 */
export string test_a_withheld_capability_answers_as_a_host_does(Core core, Cli cli) {
  T t = T.create();
  string dir = root(cli) + "/.cache/wac-frame-grants";
  t.isTrue(cli.mkdir(dir, true).wait().ok(), "cannot make " + dir);
  string path = dir + "/subject";
  t.isTrue(cli.writeFile(path, "alpha\n".toBytes()).wait().ok(), "wrote the subject");

  Frame f = Frame.of(string[]("probe"), u8[0](), dir, false);

  // Read: granted reads, withheld refuses with the host's sentence and the fault that names the
  // category — `FAULT_NOT_GRANTED`, not `FAULT_DENIED`. Nothing denied anything; the program was never
  // handed a filesystem, and `issues/system/0193` is where that distinction was drawn.
  Cli all = childCliGranted(f, cli, Grants.everything());
  t.isTrue(all.readFile(path).wait().ok, "with the grant, the read works");
  Cli noRead = childCliGranted(f, cli, Grants(false, true, true));
  FileResult denied = noRead.readFile(path).wait();
  t.isFalse(denied.ok, "without it, the read is refused");
  t.eqStr(denied.error, "Not granted to this application", denied.error);
  t.eqI32(denied.fault, FAULT_NOT_GRANTED(), "and it is not-granted rather than denied");

  // `stat` too, and this is the one worth asking separately: `Stat` says to check `fault` before
  // trusting `exists`, precisely so "there is nothing here" and "I could not look" stay different
  // answers. A withheld `stat` that reported `exists = false` with no fault would be the first of
  // those, and would read as a missing file.
  Stat blind = noRead.stat(path).wait();
  t.eqI32(blind.fault, FAULT_NOT_GRANTED(), "a withheld stat faults rather than answering absent");
  t.isTrue(all.stat(path).wait().exists, "and with the grant it sees the file");
  t.isTrue(noRead.readDir(dir).wait() is null, "a withheld readDir lists nothing");

  // Write: the effect matters as much as the answer. A refusal that returned a fault and made the file
  // anyway would pass on the message alone, which is the failure mode a capability check has.
  Cli noWrite = childCliGranted(f, cli, Grants(true, false, true));
  string made = dir + "/made";
  t.neI32(noWrite.writeFile(made, "x".toBytes()).wait().fault, 0, "a withheld write refuses");
  t.isFalse(cli.stat(made).wait().exists, "and writes nothing");
  t.neI32(noWrite.mkdir(dir + "/sub", false).wait().fault, 0, "and so does mkdir");
  t.isFalse(cli.stat(dir + "/sub").wait().exists, "which also makes nothing");
  t.eqI32(all.writeFile(made, "x".toBytes()).wait().fault, 0, "with the grant the write lands");
  t.isTrue(cli.stat(made).wait().exists, "and the file is there");

  // Env: null, because that is what a host answers, and `issues/system/0261c` is the open question
  // about it — `env` cannot say whether a variable is unset or withheld. Answering anything else here
  // would invent a distinction the capability does not have.
  Cli noEnv = childCliGranted(f, cli, Grants(true, true, false));
  t.isTrue(noEnv.env("PATH").wait() is null, "a withheld env answers null");

  // **Nothing at all**, which is the world a program built with no flags runs in, and the case the
  // three above cannot stand in for: each of them withholds one capability while keeping the others,
  // so none of them asks whether the *combination* holds. `Grants.nothing()` is the shorthand for it
  // and is what `packages/box`'s refusal tests are written against.
  Cli none = childCliGranted(f, cli, Grants.nothing());
  t.isFalse(none.readFile(path).wait().ok, "with nothing granted, the read is refused");
  t.neI32(none.writeFile(dir + "/none", "x".toBytes()).wait().fault, 0, "and so is the write");
  t.isTrue(none.env("PATH").wait() is null, "and the environment is not there");
  t.isFalse(cli.stat(dir + "/none").wait().exists, "and nothing was made");

  cli.remove(dir, true).wait();
  return t.report();
}
