// `waitAny` from a wac program, over two real sockets.
//
// `test/ring.test.ts` covers the transport: submit does not block, completions arrive out of order, a
// spent ticket is refused. What it cannot show is a *wac* program parking on whichever of several
// answers first, which is the whole reason the ring exists — `nc`, an SSH relay and a shell all need
// exactly that, and `isDone` in a loop is a spin, not a wait.
//
// The two listeners answer at different speeds and the client is given them in the *wrong* order on
// purpose: index order and speed order disagree, so a `waitAny` that quietly returned "the first one
// you passed" would pass a test where they agreed.
//
// ## Host-side until 2026-08-18, `issues/system/0161`
//
// The fixtures here are servers, so this needed `packages/wactest/src/daemon.wac` — `Cli.exec` runs a
// child to completion and a listener has to outlive the call. They are `python3` one-liners rather
// than wac programs, and deliberately: a wac listener would put the capability layer on **both** ends
// of a test about the capability layer, and a `waitAny` that mis-paired its tickets could then be
// answered by a matching mistake in the server. Python is not our code.
//
// `buildApp` becomes `wac run --allow-net`.

import { T } from "../../../wactest/src/assert.wac";
import { Exec, ChildEnv, Clock, Env, Files, Launch, Net, Procs, Sys } from "std";
import { Daemon, Port, freePortOr, freePort, logOf, start, stop, waitForLogWithin }
  from "../../../wactest/src/daemon.wac";
import { quoted } from "../../../wactest/src/childenv.wac";
import { madeDir } from "../../../wactest/src/host.wac";
import { flatten } from "core";

static string ENTRY = "packages/platform/example/whichever.wac";

string[] splitLines(string s) {
  if (s == "") { return string[].filled(0, ""); }
  i32 n = 1;
  for (i32 i = 0; i < s.len(); i++) { if (s.slice(i, i + 1) == "\n") { n = n + 1; } }
  string[] out = string[].filled(n, "");
  i32 count = 0;
  i32 at = 0;
  for (i32 i = 0; i <= s.len(); i++) {
    if (i < s.len() && s.slice(i, i + 1) != "\n") { continue; }
    if (i > at) { out[count] = s.slice(at, i); count = count + 1; }
    at = i + 1;
  }
  string[] exact = string[].filled(count, "");
  for (i32 i = 0; i < count; i++) { exact[i] = out[i]; }
  return exact;
}

string joinedWith(string[] all, string sep) {
  string out = "";
  for (i32 i = 0; i < all.len(); i++) { out = i == 0 ? all[i] : out + sep + all[i]; }
  return out;
}

/**
 * Answer once, after `delaySeconds`, then hold the connection open briefly and close.
 *
 * Held open so the *other* recv is still outstanding when the first is collected — that is what makes
 * the second half of the assertion mean anything.
 */
Daemon serveOnce(Procs procs, i32 port, string delaySeconds, string message, string log) {
  string script =
    "import socket,time\n" +
    "s=socket.socket()\n" +
    "s.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1)\n" +
    "s.bind(('127.0.0.1',\{port}))\n" +
    "s.listen(1)\n" +
    "print('listening', flush=True)\n" +
    "c,_=s.accept()\n" +
    "time.sleep(\{delaySeconds})\n" +
    "c.sendall(b'\{message}\\n')\n" +
    "time.sleep(0.9)\n" +
    "c.close()\n" +
    "s.close()\n";
  return start(procs, "python3 -c \{quoted(script)}", log);
}

export string test_waitany_parks_until_whichever_socket_speaks_first(Sys sys) {
  Clock clock = sys.clock();
  Env env = sys.env();
  Files fs = sys.files();
  Net net = sys.net();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = "\{flatten(env.cwd().wait()).unwrap()}/.cache/waitany";
  string whyDir1 = madeDir(fs, dir);
  t.isTrue(whyDir1 == "", whyDir1);

  // `quickFree`/`slowFree` rather than `quick`/`slow`: the daemons below want those names, and one
  // name standing for a `Port` up here and a `Daemon` down there is a name whose type depends on
  // which line you are reading. `issues/lang/0174a`.
  Port quickFree = freePortOr(net);
  Port slowFree = freePortOr(net);
  i32 quickPort = quickFree.port;
  i32 slowPort = slowFree.port;
  t.isTrue((quickPort > 0) && (slowPort > 0) && (quickPort != slowPort),
           "two free ports — \{quickFree.error} \{slowFree.error}");
  if (quickPort <= 0 || slowPort <= 0 || quickPort == slowPort) { return t.report(); }

  Daemon quick = serveOnce(procs, quickPort, "0", "quick", "\{dir}/quick.log");
  Daemon slow = serveOnce(procs, slowPort, "0.4", "slow", "\{dir}/slow.log");
  t.isTrue(quick.ok() && slow.ok(), "both listeners started");
  // **Not `waitForPort`.** These listeners accept exactly once, so a readiness probe that dials
  // them spends the connection the test is about and the client gets a reset. The fixtures say
  // when they are listening instead.
  // **A deadline rather than 400,000 looks.** Reading a log is a syscall, so a bound in *looks* is a
  // bound whose patience shrinks as the machine gets busier — which is exactly when a fixture takes
  // longer to announce itself. It sleeps between looks instead of spinning.
  //
  // **Twenty seconds each, since 2026-08-29, and the argument above is why.** It was five, which is
  // the same instinct stopped one step short: a *deadline* does not shrink with load, but five
  // seconds of it is still a bet about how loaded the machine gets, and three agents share five
  // cores here. Every other wait for a `listening` line in the repository is 20,000; the one
  // exception left was `packages/tls/test/wac/rsa_interop_test.wac`, at 5,000 beside a 20,000, and
  // that asymmetry turned a gate red the same day — `issues/system/0203`'s eleventh entry. This is
  // the same shape before it costs anybody a run: these are *setup* waits, not the thing under test,
  // so the only thing a short one buys is a faster answer when a fixture is genuinely broken.
  bool up = waitForLogWithin(clock, fs, quick, "listening", 20000) &&
            waitForLogWithin(clock, fs, slow, "listening", 20000);
  t.isTrue(up, "both listeners are accepting — quick said: \{logOf(fs, quick)}" +
               " slow said: \{logOf(fs, slow)}");
  if (!up) { stop(procs, quick); stop(procs, slow); return t.report(); }

  // Slow port first, so its ticket is index 0 while the *fast* answer is index 1.
  string wac = "\{flatten(env.cwd().wait()).unwrap()}/native/v8/target/release/wac";
  auto rRan = flatten(procs.exec(wac, [
                                  "run", "--allow-net", ENTRY, "--",
                                  "\{slowPort}", "\{quickPort}"
  ], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  stop(procs, quick);
  stop(procs, slow);

  t.isTrue((r is not null), "the wac binary ran — \{rRan.isErr() ? "\{rRan.err()!}" : ""}");
  if ((r is null)) { return t.report(); }
  t.eqI32(r!.status, 0, string.fromBytes(r!.stderr));
  string[] out = splitLines(string.fromBytes(r!.stdout));
  t.isTrue(out.len() >= 2, "two answers: " + joinedWith(out, " | "));
  if (out.len() < 2) { return t.report(); }
  t.eqStr(out[0], "first=1 said=quick", "wrong first answer: " + joinedWith(out, " | "));
  // The slower ticket was never cancelled and is still collectable afterwards.
  t.eqStr(out[1], "second=0 said=slow", "wrong second answer: " + joinedWith(out, " | "));

  fs.remove(dir, true).wait();
  return t.report();
}
