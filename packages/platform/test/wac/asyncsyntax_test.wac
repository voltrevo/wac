// `async` and `await`, compiled and run — `design/lang/0014`, A2, A3, and D6's loops.
//
// Everything before this file was either a hand lowering (`asyncstate_test.wac`) or a question about
// diagnostics (`async_test.wac`). This is the feature: source that says `await`, lowered by the
// compiler into a flattened state machine, answering the same thing a blocking version answers.
//
// **The oracle is the blocking spelling.** Every case computes its answer twice — once through
// `async`/`await` and once with `.wait()` and no machinery — and compares. An async function that
// returned a plausible zero would pass a test that only checked it ran.
//
// This cut is `wait`-driven and flattens `if`, `while`, `for`, nested blocks, `break` and
// `continue`. `asyncplan_test.wac` holds the shapes it still declines, by name — a suspension in a
// loop *condition*, one nested inside a larger expression, and one whose value is discarded.

import { T } from "../../../wactest/src/assert.wac";
import { Clock, Files, Sys, Unsupported } from "std";
import { Result, Ticket, flatten } from "core";

/** A2, exactly as `design/lang/0014` writes it. */
async i32 fileSize(Files fs, string path) {
  u8[]? f = (await fs.readFile(path)).ok();
  return (f is not null) ? f!.len() : 0 - 1;
}

/** A3 — two awaits, and a branch between them that is not itself a suspension. */
async i32 total(Files fs, string one, string two) {
  u8[]? a = (await fs.readFile(one)).ok();
  if ((a is null)) { return 0 - 1; }
  u8[]? b = (await fs.readFile(two)).ok();
  return a!.len() + b!.len();
}

/** No `await` at all: still a machine, still a ticket — D3 — it simply never suspends. */
async i32 seven() { return 7; }

/** The oracle, with no machinery in it. */
i32 sizeOf(Files fs, string path) {
  u8[]? f = flatten(fs.readFile(path).wait()).ok();
  return (f is not null) ? f!.len() : 0 - 1;
}

export string test_one_await_answers_what_blocking_answers(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  // `[§wac-async-wait-5tqm2wh]` — a plain `.wait()` drives the function's own chain to its answer.
  i32 want = sizeOf(fs, "README.md");
  t.isTrue(want > 0, "the oracle read the file");
  t.eqI32(fileSize(fs, "README.md").wait()!, want, "and so did the async version");
  return t.report();
}

export string test_the_caller_gets_a_ticket_not_a_value(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  // `[§wac-async-decl-h3vq81m]` and `[§wac-async-eager-2rf9kdp]` in the one place both are visible
  // at runtime: the declaration says `i32` and this is a `Ticket<i32>`, outstanding because the
  // eager call stopped at the first await rather than running to the end.
  Ticket<i32> p = fileSize(fs, "README.md");
  t.isFalse(p.settled(), "eager ran the body to its first await and stopped");
  t.eqI32(p.wait()!, sizeOf(fs, "README.md"), "waiting drove the rest");
  t.isTrue(p.settled(), "and it remembers being finished");
  return t.report();
}

export string test_two_awaits_with_a_branch_between_them(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  i32 want = sizeOf(fs, "README.md") + sizeOf(fs, "MERGE.md");
  t.eqI32(total(fs, "README.md", "MERGE.md").wait()!, want, "the sum across two suspensions");
  return t.report();
}

export string test_a_return_from_between_the_awaits_leaves_the_machine(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  // The early `return` is what makes the second `await` conditional. If a `return` in the body only
  // left its own state rather than the whole machine, this would go on to read the second file and
  // answer a sum — so the number here is the test, not the fact that it ran.
  t.eqI32(total(fs, "no-such-file-here.md", "MERGE.md").wait()!, 0 - 1,
          "it stopped at the failure and never read the second file");
  return t.report();
}

export string test_an_async_function_that_never_suspends() {
  T t = T.create();
  Ticket<i32> p = seven();
  // Nothing suspended, so the eager call ran the body to its end — `settled` before anyone waits is
  // the difference between "no awaits" and "one await that happened to be ready".
  t.isTrue(p.settled(), "finished during the call");
  t.eqI32(p.wait()!, 7, "and the answer is there");
  return t.report();
}

export string test_two_async_calls_do_not_share_a_machine(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  // Two calls of one function, both outstanding at once. Every local the machine keeps lives in the
  // call rather than beside the function, and this is what would catch it if one of them did not:
  // the second would overwrite the first's state and both would answer the same file.
  Ticket<i32> a = fileSize(fs, "README.md");
  Ticket<i32> b = fileSize(fs, "MERGE.md");
  t.eqI32(a.wait()!, sizeOf(fs, "README.md"), "the first kept its own path");
  t.eqI32(b.wait()!, sizeOf(fs, "MERGE.md"), "and the second kept its own");
  return t.report();
}

// ── Suspending inside control flow — what the state machine was chosen for ────

/** A `for` whose body suspends: the induction variable and the accumulator cross every await. */
async i32 sumOf(Files fs, string[] paths) {
  i32 total = 0;
  for (i32 i = 0; i < paths.len(); i++) {
    u8[]? f = (await fs.readFile(paths[i])).ok();
    if ((f is null)) { return 0 - 1; }
    total = total + f!.len();
  }
  return total;
}

/** A `while` with `break` and `continue` around a suspension. */
async i32 countReadable(Files fs, string[] paths, i32 stopAt) {
  i32 i = 0;
  i32 seen = 0;
  while (i < paths.len()) {
    u8[]? f = (await fs.readFile(paths[i])).ok();
    i = i + 1;
    if ((f is null)) { continue; }
    seen = seen + 1;
    if (f!.len() >= stopAt) { break; }
  }
  return seen;
}

export string test_a_for_loop_suspends_once_per_iteration(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  string[] ps = ["README.md", "MERGE.md", "CLAUDE.md"];
  i32 want = 0;
  for (i32 i = 0; i < ps.len(); i++) {
    i32 one = sizeOf(fs, ps[i]);
    t.isTrue(one > 0, "the oracle read \{ps[i]}");
    want = want + one;
  }
  // **Three suspensions and three resumptions, all re-entering one loop.** `i` and `total` are
  // captured cells, so they survive; a plain local would reset on resume and this would either loop
  // for ever or answer the first file three times.
  t.eqI32(sumOf(fs, ps).wait()!, want, "the machine summed all three");
  return t.report();
}

export string test_a_return_from_inside_the_loop_leaves_the_machine(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  // Not `break` — a `return` from inside a flattened loop has to leave the *machine*, and the loop's
  // exit state is not where it goes.
  t.eqI32(sumOf(fs, ["README.md", "no-such-file-here.md", "CLAUDE.md"]).wait()!, 0 - 1,
          "it stopped at the failure");
  return t.report();
}

export string test_break_and_continue_survive_the_flattening(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  // After flattening there is no `while` left for these to leave — the only loop is the dispatch,
  // and breaking *that* would resume the machine at whatever state was set. Both become transfers.
  string[] ps = ["no-such-file-here.md", "README.md", "MERGE.md"];
  t.eqI32(countReadable(fs, ps, 1).wait()!, 1,
          "`continue` skipped the missing file and `break` stopped at the first readable one");
  t.eqI32(countReadable(fs, ps, 1000000000).wait()!, 2,
          "and with nothing big enough to break on, both readable files were counted");
  return t.report();
}

export string test_two_loops_in_flight_keep_their_own_counters(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  // Two machines over the same function, both mid-loop. Each iteration's state lives in the call.
  Ticket<i32> a = sumOf(fs, ["README.md"]);
  Ticket<i32> b = sumOf(fs, ["MERGE.md", "CLAUDE.md"]);
  t.eqI32(a.wait()!, sizeOf(fs, "README.md"), "the one-file loop");
  t.eqI32(b.wait()!, sizeOf(fs, "MERGE.md") + sizeOf(fs, "CLAUDE.md"), "and the two-file loop");
  return t.report();
}

// ── Driven by `drain` rather than by a wait — D1's other half ─────────────────

/**
 * Suspends `n` times on a **linked** ticket, writing a digit each time it resumes.
 *
 * A host's ticket is linked, so it is answered by the `waitAny` in `sys.drainFor` as well as by a
 * wait — which is what lets the drain alone finish the machine.
 */
async i32 ticks(Clock clock, i32 n, i32[] log, i32 me) {
  for (i32 i = 0; i < n; i++) {
    await clock.sleepMillis(1);
    log[0] = log[0] * 10 + me;
  }
  return n;
}

export string test_drain_alone_finishes_a_machine(Sys sys) {
  T t = T.create();
  // `[§wac-drain-cs2v9rf]` — registered, so the scheduler alone can finish it.
  i32[] log = i32[].filled(1, 0);
  Ticket<i32> p = ticks(sys.clock(), 2, log, 1);
  t.isFalse(p.settled(), "eager stopped at the first await");
  t.eqI32(sys.drainFor(0 - 1), 2, "two suspensions, two continuations");
  t.isTrue(p.settled(), "and the drain finished it, with nobody waiting");
  t.eqI32(p.wait()!, 2, "the answer was already there");
  return t.report();
}

export string test_two_machines_interleave_under_one_drain(Sys sys) {
  T t = T.create();
  // **The property A1 exists for**, stated as the property rather than as a list of the logs that
  // satisfy it — which is what this was, and it was short.
  //
  // Run to completion one after the other the log reads 1122 or 2211. **Everything else is an
  // interleaving**, and there are four of them: 1212, 2121, 1221 and 2112. Which one appears is
  // decided by whichever 1ms timer the host answers first and by how far each machine gets before
  // the next dispatch — a race, and a busier machine races differently. This accepted the first two
  // and failed on the other two, so it went red under load with a message saying the machines had
  // not interleaved when they had. Measured on 2026-08-30 at load 6.6: pass, fail, pass.
  //
  // The claim is that **neither machine finished before the other started**, so the two serial logs
  // are what to exclude. Written that way it cannot be short again.
  // **Across trials, because one trial is a coin flip.** The property above is real and the single
  // run that asserted it went red on the gate — `issues/lang/0302b` — because under load the two
  // machines *do* sometimes run one after the other. Its own note records the measurement that
  // should have been the warning: "2026-08-30 at load 6.6: pass, fail, pass". A scheduling property
  // asserted once is a lottery, and a lottery in the shared suite is red for whoever draws badly.
  //
  // So this asks whether interleaving happens **at all** in five runs, which is what "these are
  // concurrent" means and what `0302b` disputes about the stronger reading. That issue keeps the
  // stronger claim; this keeps the gate honest about the weaker one.
  i32 interleaved = 0;
  string seen = "";
  for (i32 trial = 0; trial < 5; trial++) {
    i32[] log = i32[].filled(1, 0);
    Ticket<i32> a1 = ticks(sys.clock(), 2, log, 1);
    Ticket<i32> b1 = ticks(sys.clock(), 2, log, 2);
    sys.drainFor(0 - 1);
    seen = seen + (trial == 0 ? "" : " ") + "\{log[0]}";
    if (log[0] != 1122 && log[0] != 2211) { interleaved = interleaved + 1; }
    t.isTrue(a1.settled() && b1.settled(), "both machines finished in trial \{trial}");
  }
  t.isTrue(interleaved > 0,
           "the two machines interleaved at least once in five runs — the logs were \{seen}" +
           ", and 1122 or 2211 is one finishing before the other started. Never interleaving is "
           + "`issues/lang/0302b`");

  i32[] log = i32[].filled(1, 0);
  Ticket<i32> a = ticks(sys.clock(), 2, log, 1);
  Ticket<i32> b = ticks(sys.clock(), 2, log, 2);
  sys.drainFor(0 - 1);
  t.isTrue(a.settled() && b.settled(), "and both finished");
  return t.report();
}

export string test_a_wait_takes_the_continuation_back(Sys sys) {
  T t = T.create();
  // `[§wac-async-once-3jhw8qk]`. Queued *and* waited on. The continuation the wait drove is the one still sitting in the queue, so
  // calling it again must do nothing — or the body would run twice.
  i32[] log = i32[].filled(1, 0);
  Ticket<i32> p = ticks(sys.clock(), 1, log, 7);
  t.eqI32(p.wait()!, 1, "waiting drove it");
  t.eqI32(log[0], 7, "the body ran once, not twice");
  sys.drainFor(0 - 1);
  t.eqI32(log[0], 7, "and draining afterwards resumed nothing a second time");
  return t.report();
}

// ── A4, and how `await` groups ────────────────────────────────────────────────

/**
 * An async function that hands a **ticket** back — `[§wac-async-nested-6bqt3jf]`.
 *
 * Its caller gets a ticket of a ticket: awaiting once passes the first sleep and yields a second
 * one already running, and awaiting that gives its answer. The two awaits mean different things,
 * which is why this is not flattened.
 */
async Ticket<Result<void, union<Unsupported>>> laterStill(Clock clock) {
  await clock.sleepMillis(1);
  return clock.sleepMillis(1);
}

export string test_a_returned_ticket_is_not_flattened(Sys sys) {
  T t = T.create();
  Ticket<Ticket<Result<void, union<Unsupported>>>> outer = laterStill(sys.clock());
  Ticket<Result<void, union<Unsupported>>> inner = outer.wait()!;
  // The inner one is a real ticket, still outstanding — not a value dressed up as one.
  t.isFalse(inner.settled(), "the second sleep is under way, not finished");
  t.isTrue(inner.wait()!.isOk(), "and awaiting it again answers");
  return t.report();
}

/** `async void` — the D5 case: no answer to keep, and a `Ticket<void>` to hand back. */
async void bump(Clock clock, i32[] log) {
  await clock.sleepMillis(1);
  log[0] = log[0] + 1;
}

export string test_an_async_void_function_has_a_ticket_with_no_answer(Sys sys) {
  T t = T.create();
  // Every other return type gets a cell to keep the answer in; `void[].defaulted(1)` is not a thing, so this
  // machine has none — and `Ticket<void>` is settled rather than resolved. That is what
  // `void` being a usable type argument was for.
  i32[] log = i32[].filled(1, 0);
  Ticket<void> p = bump(sys.clock(), log);
  t.eqI32(log[0], 0, "suspended before doing its work");
  t.eqI32(sys.drainFor(0 - 1), 1, "the drain ran its one continuation");
  t.eqI32(log[0], 1, "and the body finished");
  p.wait()!;
  t.isTrue(p.settled(), "the ticket answers nothing and is settled");
  return t.report();
}
