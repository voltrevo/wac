// only: wacc
//
// Lambdas — `design/lang/0002` — which the reference compiler does not have. The marker is not a
// skip: the corpus tests that read it assert the two front ends genuinely disagree here.
//
// `Loop`, driven by a **fake `Core`**. A capability is a struct of `fn[…]` fields, so a `Core` whose
// `waitAny` answers from a script is an ordinary value — which is the same thing `src/frame.wac`
// does for a child's world, and the reason none of this needs a host. What is being tested is the
// dispatch: which handler runs, in what order, what it is handed, and what happens to the ones that
// have not answered yet.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Pending } from "../../src/platform.wac";
import { Loop } from "../../src/loop.wac";
import { Vec } from "../../../std/src/vec.wac";

/**
 * A `Core` whose `waitAny` answers with the indices in `script`, in order, then `-1` for ever.
 *
 * An index rather than a ticket id, because that is what `waitAny` itself answers — the host says
 * *which of the list you gave me*, and reproducing that faithfully is the whole point of a fake.
 *
 * Every other field traps if called: this test is about the loop, and a `Core` that quietly answered
 * a clock or a random would let a test pass for a reason it did not mean to.
 */
Core scripted(Vec<i32> script, Vec<i32> asked) {
  return Core(
    () => { trap; },
    () => { trap; },
    (i32 ms) => { trap; },
    (i32 n) => { trap; },
    (string s) => { trap; },
    (string s) => { trap; },
    (i32[] ids, i32 millis) => {
      // Recorded so a test can assert what the loop actually waited on — the list shrinking as
      // handlers run is the behaviour, not an implementation detail.
      asked.push(ids.len());
      if (script.isEmpty()) { return -1; }
      return script.remove(0);
    },
    () => { trap; },
  );
}

/** Handlers run in the order the host answers, and each is handed its own ticket id. */
export string test_dispatch_in_the_order_answered() {
  T t = T.create();
  Vec<i32> seen = Vec.create();
  Loop l = Loop.create();
  // **Each handler leaves a different mark**, which is the difference between testing dispatch and
  // testing that *something* ran. With three handlers that all did `seen.push(id)` the id came from
  // the ticket and the bodies were interchangeable, so running the wrong one was invisible: a canary
  // that dispatched `handlers.get(0)` every time passed all five tests.
  l.on(100, (i32 id) => { seen.push(1000 + id); });
  l.on(200, (i32 id) => { seen.push(2000 + id); });
  l.on(300, (i32 id) => { seen.push(3000 + id); });

  // The host answers the middle one, then what is left of the first, then the last.
  Vec<i32> script = Vec.create();
  script.push(1);   // 200
  script.push(0);   // 100 — index 0 of what remains
  script.push(0);   // 300
  Vec<i32> asked = Vec.create();

  i32 ran = l.run(scripted(script, asked), -1);
  t.isTrue(ran == 3, "three handlers ran");
  t.isTrue(seen.len() == 3, "three ids collected");
  t.isTrue(seen.get(0) == 2200, "the answered one's own handler ran first");
  t.isTrue(seen.get(1) == 1100, "then the one registered before it, with its own handler");
  t.isTrue(seen.get(2) == 3300, "then the last, with its own");
  t.isTrue(l.pending() == 0, "nothing left outstanding");

  // Each wait saw one fewer ticket, because a handler is unregistered before it runs.
  t.isTrue(asked.len() == 3, "three waits");
  t.isTrue(asked.get(0) == 3 && asked.get(1) == 2 && asked.get(2) == 1, "the list shrank");
  return t.report();
}

/** A handler may register more work, which is what re-arming a read is. */
export string test_a_handler_can_register_more() {
  T t = T.create();
  Vec<i32> seen = Vec.create();
  Loop l = Loop.create();
  i32 rounds = 0;

  // Re-arms itself twice, then stops adding — the shape of a relay reading packet after packet.
  fn[void(i32)] again = (i32 id) => { };
  again = (i32 id) => {
    seen.push(id);
    rounds = rounds + 1;
    if (rounds < 3) { l.on(id + 1, again); }
  };
  l.on(1, again);

  Vec<i32> script = Vec.create();
  script.push(0);
  script.push(0);
  script.push(0);
  i32 ran = l.run(scripted(script, Vec.create()), -1);

  t.isTrue(ran == 3, "the re-armed work ran too");
  t.isTrue(seen.get(0) == 1 && seen.get(1) == 2 && seen.get(2) == 3, "each round saw the new ticket");
  t.isTrue(l.pending() == 0, "and it stopped re-arming");
  return t.report();
}

/** `stop` ends the run without cancelling what is still registered. */
export string test_stop_leaves_the_rest_registered() {
  T t = T.create();
  Loop l = Loop.create();
  i32 ran = 0;
  l.on(10, (i32 id) => { ran = ran + 1; l.stop(); });
  l.on(20, (i32 id) => { ran = ran + 1; });

  Vec<i32> script = Vec.create();
  script.push(0);
  script.push(0);
  i32 answered = l.run(scripted(script, Vec.create()), -1);

  t.isTrue(answered == 1, "the loop returned after the handler that stopped it");
  t.isTrue(ran == 1, "the second handler did not run");
  t.isTrue(l.pending() == 1, "and is still registered");

  // Running again picks it up: stopping is not cancelling.
  Vec<i32> more = Vec.create();
  more.push(0);
  t.isTrue(l.run(scripted(more, Vec.create()), -1) == 1, "the rest ran on the next go");
  t.isTrue(ran == 2, "the second handler ran then");
  return t.report();
}

/** A wait that times out returns what has run so far and keeps the rest. */
export string test_a_deadline_returns_what_ran() {
  T t = T.create();
  Loop l = Loop.create();
  i32 ran = 0;
  l.on(10, (i32 id) => { ran = ran + 1; });
  l.on(20, (i32 id) => { ran = ran + 1; });

  Vec<i32> script = Vec.create();
  script.push(0);           // one answers, then the script runs out and the fake answers -1
  i32 answered = l.run(scripted(script, Vec.create()), 5000);

  t.isTrue(answered == 1, "one handler ran before the deadline");
  t.isTrue(ran == 1, "and only one");
  t.isTrue(l.pending() == 1, "the unanswered ticket is still outstanding");
  return t.report();
}

/**
 * **The type of an answer lives in the closure**, which is why `Loop` needs no type parameters.
 *
 * The handler takes an `i32` and reads a `Pending<string>` it captured. Nothing in `Loop` knows that
 * type, and nothing has to: `wait` is checked where the lambda is written.
 */
export string test_the_handler_carries_the_type() {
  T t = T.create();
  Loop l = Loop.create();
  string got = "";

  Pending<string> answer = Pending.of(7, (i32 id) => "hello", (i32 id) => true, (i32 id) => { });
  l.on(answer.id, (i32 id) => { got = answer.wait(); });

  Vec<i32> script = Vec.create();
  script.push(0);
  l.run(scripted(script, Vec.create()), -1);

  t.isTrue(got == "hello", "the handler read its own ticket's value, at its own type");
  return t.report();
}
