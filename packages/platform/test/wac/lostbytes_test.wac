/**
 * Bytes taken by a reader nobody was waiting for, on both Rust hosts.
 *
 * `issues/system/0307b`. `recv` submits a ticket and hands the reading to a thread. That thread
 * calls `Stream::read`, which **blocks and then drains** — so a caller who gives up does not stop
 * it: the bytes still arrive, are still taken out of the queue, and were then handed to a ticket
 * nobody held and dropped. The next `recv` began after a hole and nothing anywhere said so.
 *
 * A bounded read that expires and is retried is exactly the shape that loses data, and it is the
 * shape `std/platform.wac`'s deadline idiom invites. `packages/tor` reads this way in three places.
 *
 * ## Why the fix declines to *take* the bytes, which took two wrong answers to reach
 *
 * The first version parked them in a map keyed by handle. Two readers are parked on the same queue
 * — the abandoned one and the retry — and when the abandoned one won the race it filed the bytes
 * somewhere the other was never going to look.
 *
 * The second put them back in the queue and notified, which is right and is not enough. Between
 * taking the bytes and returning them there is a window: the writer can finish in it, and the other
 * reader then sees the queue empty *and* done and answers `End` to the guest. Nothing put back
 * afterwards unsays an `End`. That lost the payload about one run in three, and two separate
 * all-green samples said it was fixed before a third disagreed.
 *
 * So `Stream::read_unless` asks whether the ticket is still live **under the same lock as the
 * drain** and leaves the bytes alone if not. `unread` stays as the backstop for the narrower race
 * where the caller gives up between that check and `complete`.
 *
 * A socket has no queue to decline from — its bytes are already off the kernel by the time anything
 * can be asked — so that path keeps a per-handle table, cleared when the handle closes, because a
 * handle is reused the instant it is free (`issues/system/0306b`).
 *
 * ## The shape of the case
 *
 * One program, run twice. `spawnSelf` gives a child whose output is read through the same host
 * `recv` a socket's is, so the parent and the child are the same module told apart by their
 * first argument. The child waits and then writes; the parent lets a short bounded wait expire
 * against an **empty** queue, abandons the ticket, and reads again.
 *
 * **The control arm is what makes this a test rather than a coincidence.** It skips the abandoned
 * read and nothing else. Without it, "the second read saw nothing" has a dull explanation — a child
 * that never wrote, a handle with nothing attached — and the program prints the same line either
 * way. It is the arm that would catch this case rotting into one that cannot fail.
 */
import { T } from "../../../wactest/src/assert.wac";
import { Exec, ChildEnv, Env, Files, Launch, Output, Procs, Sys } from "std";
import { nativeHostWhyNot } from "../../../wactest/src/built.wac";
import { binaryPath, nativeBinaryPath } from "../../../wactest/src/host.wac";
import { contains } from "../../../wactest/src/strings.wac";
import { flatten } from "core";

/**
 * The child sleeps well past the parent's deadline, so the parent is certainly parked on an empty
 * queue when it gives up — the case only exists when the reader has nothing yet and waits.
 */
static string PROGRAM =
  "import { Authority, Child, Clock, Launch, Output, Procs, Sys } from \"std\";\n" +
  "import { Read, flatten } from \"core\";\n" +
  "\n" +
  "export i32 main(Sys sys) {\n" +
  "  Output out = sys.stdout();\n" +
  "  Clock clock = sys.clock();\n" +
  "  string[] argv = sys.args();\n" +
  "  string mode = argv.len() > 0 ? argv[0] : \"\";\n" +
  "  if (mode == \"child\") {\n" +
  "    clock.sleepMillis(400).wait();\n" +
  "    out.write(\"PAYLOAD\".toBytes()).wait();\n" +
  "    return 0;\n" +
  "  }\n" +
  "  Authority all = Authority(sys.files(), sys.net(), sys.env(), sys.procs());\n" +
  "  auto spawned = flatten(sys.procs().spawnSelf([\"child\"], all, Launch.plain()).wait());\n" +
  "  if (spawned.isErr()) { out.line(\"no child: \" + \"\\{spawned.err()!}\"); return 1; }\n" +
  "  Child kid = spawned.unwrap();\n" +
  "  if (mode != \"control\") {\n" +
  "    auto first = kid.output().chunk();\n" +
  "    if (mode == \"late\") { clock.sleepMillis(600).wait(); } else { clock.within(first, 50).wait(); }\n" +
  "    first.cancel();\n" +
  "  }\n" +
  "  string got = \"\";\n" +
  "  bool reading = true;\n" +
  "  while (reading) {\n" +
  "    auto r = flatten(kid.output().chunk().wait());\n" +
  "    if (r.isErr()) { reading = false; out.line(\"failed: \" + \"\\{r.err()!}\"); continue; }\n" +
  "    match (r.unwrap()) {\n" +
  "      Data(b): { got = got + string.fromBytes(b); }\n" +
  "      End: { reading = false; }\n" +
  "      Failed(e): { reading = false; out.line(\"failed: \" + e); }\n" +
  "    }\n" +
  "  }\n" +
  "  out.line(got == \"PAYLOAD\" ? \"VERDICT kept\" : \"VERDICT lost \\\"\" + got + \"\\\"\");\n" +
  "  return 0;\n" +
  "}\n";

/** An abandoned `readStdin` used to take the whole of standard input with it — `0310b`. */
static string STDIN_PROGRAM =
  "import { Authority, Child, Clock, Input, Launch, Output, Procs, Sys } from \"std\";\n" +
  "import { Read, flatten } from \"core\";\n" +
  "\n" +
  "export i32 main(Sys sys) {\n" +
  "  Output out = sys.stdout();\n" +
  "  Clock clock = sys.clock();\n" +
  "  string[] argv = sys.args();\n" +
  "  string mode = argv.len() > 0 ? argv[0] : \"\";\n" +
  "  if (mode == \"child\" || mode == \"childcontrol\" || mode == \"childlate\") {\n" +
  "    Input stdin = sys.stdin();\n" +
  "    if (mode == \"child\" || mode == \"childlate\") {\n" +
  "      auto first = stdin.readAll();\n" +
  "      if (mode == \"childlate\") { clock.sleepMillis(900).wait(); } else { clock.within(first, 50).wait(); }\n" +
  "      first.cancel();\n" +
  "    }\n" +
  "    u8[] got = flatten(stdin.readAll().wait()).orElse(u8[]());\n" +
  "    out.write((\"SAW:\" + string.fromBytes(got)).toBytes()).wait();\n" +
  "    return 0;\n" +
  "  }\n" +
  "\n" +
  "  string kidArg = mode == \"control\" ? \"childcontrol\" : (mode == \"late\" ? \"childlate\" : \"child\");\n" +
  "  Authority all = Authority(sys.files(), sys.net(), sys.env(), sys.procs());\n" +
  "  auto spawned = flatten(sys.procs().spawnSelf([kidArg], all, Launch.plain()).wait());\n" +
  "  if (spawned.isErr()) { out.line(\"no child: \" + \"\\{spawned.err()!}\"); return 1; }\n" +
  "  Child kid = spawned.unwrap();\n" +
  "  clock.sleepMillis(300).wait();\n" +
  "  kid.input().write(\"PAYLOAD\".toBytes()).wait();\n" +
  "  // **Closing the child's input, not half-closing a socket.** The first version used the socket\n" +
  "  // half-close, which does not end a child's input queue, so the child sat in its read waiting for an\n" +
  "  // EOF that never came and the parent sat waiting for output that never came.\n" +
  "  kid.input().close().wait();\n" +
  "\n" +
  "  string got = \"\";\n" +
  "  bool reading = true;\n" +
  "  while (reading) {\n" +
  "    auto r = flatten(kid.output().chunk().wait());\n" +
  "    if (r.isErr()) { reading = false; continue; }\n" +
  "    match (r.unwrap()) {\n" +
  "      Data(b): { got = got + string.fromBytes(b); }\n" +
  "      End: { reading = false; }\n" +
  "      Failed(e): { reading = false; }\n" +
  "    }\n" +
  "  }\n" +
  "  out.line(got == \"SAW:PAYLOAD\" ? \"VERDICT kept\" : \"VERDICT lost \\\"\" + got + \"\\\"\");\n" +
  "  return 0;\n" +
  "}\n";

/** An abandoned `accept` used to orphan the connection it had taken — `0310b`. */
static string ACCEPT_PROGRAM =
  "import { Authority, Clock, Launch, Listener, Net, Output, Socket, Sys } from \"std\";\n" +
  "import { flatten } from \"core\";\n" +
  "import { itoa } from \"../../packages/fmt/src/itoa.wac\";\n" +
  "\n" +
  "export i32 main(Sys sys) {\n" +
  "  Output out = sys.stdout();\n" +
  "  Clock clock = sys.clock();\n" +
  "  Net net = sys.net();\n" +
  "  string[] argv = sys.args();\n" +
  "  string mode = argv.len() > 0 ? argv[0] : \"\";\n" +
  "\n" +
  "  if (mode == \"child\") {\n" +
  "    // The port arrives as the second argument.\n" +
  "    i32 port = 0;\n" +
  "    u8[] p = argv[1].toBytes();\n" +
  "    for (i32 i = 0; i < p.len(); i++) { port = port * 10 + (p[i] as i32 - 48); }\n" +
  "    clock.sleepMillis(300).wait();\n" +
  "    auto dialled = flatten(net.connect(\"127.0.0.1\", port).wait());\n" +
  "    if (dialled.isErr()) { return 1; }\n" +
  "    dialled.unwrap().send(\"HELLO\".toBytes()).wait();\n" +
  "    clock.sleepMillis(2000).wait();\n" +
  "    return 0;\n" +
  "  }\n" +
  "\n" +
  "  auto bound = flatten(net.listen(\"127.0.0.1\", 0).wait());\n" +
  "  if (bound.isErr()) { out.line(\"no listener: \" + \"\\{bound.err()!}\"); return 1; }\n" +
  "  Listener listener = bound.unwrap();\n" +
  "\n" +
  "  string port = itoa(listener.port);\n" +
  "  Authority all = Authority(sys.files(), sys.net(), sys.env(), sys.procs());\n" +
  "  auto spawned = flatten(sys.procs().spawnSelf([\"child\", port], all, Launch.plain()).wait());\n" +
  "  if (spawned.isErr()) { out.line(\"no child: \" + \"\\{spawned.err()!}\"); return 1; }\n" +
  "\n" +
  "  if (mode != \"control\") {\n" +
  "    // Parked on an empty backlog, then given up on — the client dials at 300ms.\n" +
  "    auto first = listener.accept();\n" +
  "    if (mode == \"late\") { clock.sleepMillis(900).wait(); } else { clock.within(first, 50).wait(); }\n" +
  "    first.cancel();\n" +
  "  }\n" +
  "\n" +
  "  // The connection should still be there to accept.\n" +
  "  auto got = flatten(clock.within(listener.accept(), 3000).wait());\n" +
  "  out.line(got.isOk() ? \"VERDICT kept\" : \"VERDICT lost — \" + \"\\{got.err()!}\");\n" +
  "  return 0;\n" +
  "}\n";

/**
 * An abandoned `connect` used to leak the line it had dialled — `0310b`.
 *
 * The third remedy in this family, and the reason the family needed three. The others take
 * something a *later* call wants, so the answer is to hand it on or put it back. Nothing else
 * wants this connection, so the answer is to close it and let the peer find out. Handing it on
 * would be meaningless and leaving it is a handle that never returns and a peer holding a line
 * to nobody — which this sees as a read that never ends.
 *
 * **Still on `Cli`**, alone in this file: through std the abandoned connect is a `Socket` another wait already
 * settled, and `cancel` on a settled ticket does nothing — `issues/system/0370a`. Moving it waits on that.
 */
static string CONNECT_PROGRAM =
  "import { Core, Cli, Pending, HostSocket, Sys } from \"std\";\n" +
  "import { Read } from \"core\";\n" +
  "\n" +
  "export i32 main(Sys sys) {\n  Core core = sys.core;\n  Cli cli = sys.cli;\n" +
  "  i32 n = cli.argCount().wait();\n" +
  "  string mode = n > 0 ? string.fromBytes(cli.arg(0).wait()) : \"\";\n" +
  "\n" +
  "  HostSocket listener = cli.listen(\"127.0.0.1\", 0).wait();\n" +
  "  if (listener.handle < 0) { core.log(\"no listener: \" + listener.error); return 1; }\n" +
  "\n" +
  "  Pending<HostSocket> dialling = cli.connect(\"127.0.0.1\", listener.port);\n" +
  "  if (mode == \"control\") {\n" +
  "    // Collected rather than abandoned, and closed properly — the peer must see the end either way.\n" +
  "    HostSocket mine = dialling.wait();\n" +
  "    if (mine.handle >= 0) { cli.closeSocket(mine.handle); }\n" +
  "  } else {\n" +
  "    // Long enough that the connection is certainly made and the answer is in hand.\n" +
  "    core.delay(400).wait();\n" +
  "    dialling.cancel();\n" +
  "    core.cancel(dialling.id);\n" +
  "  }\n" +
  "\n" +
  "  HostSocket served = cli.accept(listener.handle).wait();\n" +
  "  if (served.handle < 0) { core.log(\"VERDICT lost — nothing arrived: \" + served.error); return 1; }\n" +
  "\n" +
  "  Pending<Read> r = cli.recv(served.handle);\n" +
  "  if (core.waitAny([r.id], 1500) < 0) {\n" +
  "    core.log(\"VERDICT leaked — the peer is still holding the connection open\");\n" +
  "    return 1;\n" +
  "  }\n" +
  "  match (r.wait()) {\n" +
  "    End: { core.log(\"VERDICT kept — the abandoned connection was closed\"); }\n" +
  "    Data(b): { core.log(\"VERDICT odd — data on a connection nobody wrote to\"); }\n" +
  "    Failed(e): { core.log(\"VERDICT kept — the peer went away: \" + e); }\n" +
  "  }\n" +
  "  return 0;\n" +
  "}\n";

/**
 * `readStdin` on the program's **own** input rather than a parent's feed — `0310b`.
 *
 * The cases above go through `spawnSelf`, which hands a child a queue. This one goes through
 * `Procs.exec`, which gives a program real bytes on its own standard input: a different branch
 * with no queue to decline from, and the one that was fixed by reading because nothing here
 * reached it. Only the *late* ordering is reachable — `exec` supplies all of standard input up
 * front, so the first read has certainly landed by the time the caller gives up — and that is
 * exactly the ordering the branch got wrong.
 *
 * It could not be measured on the wasmtime host at all until `issues/system/0313b` was fixed:
 * `Cli.exec` was refused there for every program, so this probe read 0 of 3 on *both* arms and
 * looked like a broken instrument. A bug that hides evidence about other bugs.
 */
static string OWNSTDIN_PROGRAM =
  "import { ChildEnv, Clock, Input, Launch, Output, Sys } from \"std\";\n" +
  "import { flatten } from \"core\";\n" +
  "\n" +
  "export i32 main(Sys sys) {\n" +
  "  Output out = sys.stdout();\n" +
  "  Clock clock = sys.clock();\n" +
  "  string[] argv = sys.args();\n" +
  "  i32 n = argv.len();\n" +
  "  string mode = n > 0 ? argv[0] : \"\";\n" +
  "\n" +
  "  if (mode == \"eater\" || mode == \"eatercontrol\") {\n" +
  "    Input stdin = sys.stdin();\n" +
  "    if (mode == \"eater\") {\n" +
  "      // The bytes are already here — `exec` gave them to us — so this is the give-up-after case.\n" +
  "      auto first = stdin.readAll();\n" +
  "      clock.sleepMillis(250).wait();\n" +
  "      first.cancel();\n" +
  "    }\n" +
  "    u8[] got = flatten(stdin.readAll().wait()).orElse(u8[]());\n" +
  "    out.write((\"SAW:\" + string.fromBytes(got)).toBytes()).wait();\n" +
  "    return 0;\n" +
  "  }\n" +
  "\n" +
  "  if (n < 2) { out.line(\"VERDICT lost — no binary given\"); return 1; }\n" +
  "  string binary = argv[1];\n" +
  "  // **Where this program lives is passed in, not assumed.** The first version computed it, which\n" +
  "  // was true only while the file sat where the standalone probe put it — embedded in a case that\n" +
  "  // writes it somewhere else, the child could never find itself and every arm failed alike.\n" +
  "  if (n < 3) { out.line(\"VERDICT lost — no path given\"); return 1; }\n" +
  "  string self = argv[2];\n" +
  "  string kid = mode == \"control\" ? \"eatercontrol\" : \"eater\";\n" +
  "  auto ran = flatten(sys.procs().exec(binary,\n" +
  "                    [\"run\", \"--allow-read\", \"--allow-write\", \"--allow-run\",\n" +
  "                     \"--allow-env\", \"--allow-net\", self, kid],\n" +
  "                    \"PAYLOAD\".toBytes(), ChildEnv.inherited(), Launch.plain()).wait());\n" +
  "  if (ran.isErr()) { out.line(\"VERDICT lost — the binary did not run: \" + \"\\{ran.err()!}\"); return 1; }\n" +
  "  string said = string.fromBytes(ran.unwrap().stdout) + string.fromBytes(ran.unwrap().stderr);\n" +
  "  out.line(said.indexOf(\"SAW:PAYLOAD\") >= 0\n" +
  "             ? \"VERDICT kept\" : \"VERDICT lost — the child saw \\\"\" + said + \"\\\"\");\n" +
  "  return 0;\n" +
  "}\n";

/** Write the program once and run it under `wac`, both streams together. */
string ran(Procs procs, string binary, string path, string mode) {
  string[] argv = mode == ""
    ? [
               "run", "--allow-read", "--allow-write", "--allow-run", "--allow-env", "--allow-net",
               path
    ]
    : [
               "run", "--allow-read", "--allow-write", "--allow-run", "--allow-env", "--allow-net",
               path, mode
    ];
  auto rRan = flatten(procs.exec(binary, argv, u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  if ((r is null)) { return "the binary did not run — \{rRan.isErr() ? "\{rRan.err()!}" : ""}"; }
  return string.fromBytes(r!.stdout) + string.fromBytes(r!.stderr);
}

string writtenAs(Env env, Files fs, string name, string program) {
  string dir = "\{flatten(env.cwd().wait()).unwrap()}/.cache/lostbytes";
  fs.mkdir(dir, true).wait();
  string path = "\{dir}/\{name}.wac";
  auto wrote = flatten(fs.writeFile(path, program.toBytes()).wait());
  if (wrote.isErr()) { return ""; }
  return path;
}

string written(Env env, Files fs) { return writtenAs(env, fs, "probe", PROGRAM); }

/**
 * How many times the abandoned arm runs, and the number is not a guess.
 *
 * **A single run is not enough, and this was measured rather than assumed.** With the fix backed
 * out of a host, one run of this case passed **3 times in 10** — the loss depends on which of two
 * parked readers wins a race, so a one-shot check would wave a broken host through almost a third
 * of the time. That is not a guard, it is a coin.
 *
 * The defect shows about 7 runs in 10, so requiring *every* one of five to keep the payload misses
 * it with probability 0.3^5, near enough one in three hundred. Raise this if the case is ever seen
 * flapping; do not lower it without re-measuring the rate it is derived from.
 */
static i32 TRIES = 5;

void check(T t, Procs procs, string binary, string path, string host) {
  // The canary first: if the control arm cannot see the payload, the abandoned arm proves nothing.
  string control = ran(procs, binary, path, "control");
  t.isTrue(contains(control, "VERDICT kept"),
           "\{host}: the control arm did not see the payload, so this case cannot fail — \{control}");

  // **Every one of them, and the first failure is the one reported.** Reporting the last would hide
  // a run that lost the payload behind a later one that happened not to.
  string lost = "";
  for (i32 i = 0; i < TRIES; i++) {
    string abandoned = ran(procs, binary, path, "");
    if (!contains(abandoned, "VERDICT kept") && lost == "") { lost = abandoned; }
  }
  t.eqStr(lost, "", "\{host}: a reader was abandoned and its bytes went with it");

  // **And the other order, which is `issues/system/0308b`.** Above, the caller gives up long before
  // the bytes arrive, so the reader declines to take them. Here it gives up *after* they have landed
  // and been filed under a still-live ticket, so `drop` is holding an answer that came off a stream
  // once — and discarded it, 0 of 10 on both hosts, until it learned which handle to give it back
  // to. One run is enough for this one: it was deterministic, not a race.
  string late = ran(procs, binary, path, "late");
  t.isTrue(contains(late, "VERDICT kept"),
           "\{host}: the answer was dropped with the ticket that had already collected it — \{late}");
}

/**
 * The other two capabilities that consume something irreplaceable — `issues/system/0310b`.
 *
 * **Both hosts, in one case, on purpose.** `recv`'s fixes went to both hosts the first time because
 * this file already ran both binaries and a one-host fix failed it immediately. `readStdin` and
 * `accept` had no such case, nothing asked the question, and both were fixed on one host and closed
 * as done — the third time in a day that a fix landed on one host and the other was not checked.
 * These are here so the question is asked by something other than my memory.
 *
 * `readStdin` was 1 of 8 kept on the wasmtime host and 5 of 6 on the v8 one — a rate, so this runs
 * its arm `TRIES` times like the read case above. `accept` was 0 of 8 on both, deterministic, so
 * once is enough for it.
 */
void checkTaken(T t, Procs procs, string binary, string stdinPath, string acceptPath, string host) {
  t.isTrue(contains(ran(procs, binary, stdinPath, "control"), "VERDICT kept"),
           "\{host}: the readStdin control saw nothing, so its case cannot fail");
  string lostIn = "";
  for (i32 i = 0; i < TRIES; i++) {
    string got = ran(procs, binary, stdinPath, "");
    if (!contains(got, "VERDICT kept") && lostIn == "") { lostIn = got; }
  }
  t.eqStr(lostIn, "", "\{host}: an abandoned readStdin took the whole of standard input with it");

  t.isTrue(contains(ran(procs, binary, acceptPath, "control"), "VERDICT kept"),
           "\{host}: the accept control saw nothing, so its case cannot fail");
  string acc = ran(procs, binary, acceptPath, "");
  t.isTrue(contains(acc, "VERDICT kept"),
           "\{host}: an abandoned accept orphaned the connection it had taken — \{acc}");

  // ── The *other* ordering for both, which is the half I first shipped without ──
  //
  // Each of these can be given up on **before** the answer arrives or **after** it is in hand, and
  // the two need different remedies. Declining to take it fixes the first and does nothing for the
  // second; handing it on fixes the second and cannot reach the first, where the retry is already
  // blocked inside the call. `readStdin` and `accept` were each fixed on one ordering, measured
  // 8 of 8, and reported done — and each still lost everything on the other, 0 of 6.
  string lateIn = ran(procs, binary, stdinPath, "late");
  t.isTrue(contains(lateIn, "VERDICT kept"),
           "\{host}: a readStdin given up on after its answer landed lost it — \{lateIn}");
  string lateAcc = ran(procs, binary, acceptPath, "late");
  t.isTrue(contains(lateAcc, "VERDICT kept"),
           "\{host}: an accept given up on after the connection arrived lost it — \{lateAcc}");
}

/** `readStdin` on the process's own input, which needs the binary to exec itself. */
void checkOwnStdin(T t, Procs procs, string binary, string path, string host) {
  auto cRan = flatten(procs.exec(binary, [
                                     "run", "--allow-read", "--allow-write", "--allow-run",
                                     "--allow-env", "--allow-net", path, "control", binary, path
  ], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? c = cRan.ok();
  t.isTrue(contains(string.fromBytes(c!.stdout) + string.fromBytes(c!.stderr), "VERDICT kept"),
           "\{host}: the own-stdin control saw nothing, so its case cannot fail");
  auto aRan = flatten(procs.exec(binary, [
                                     "run", "--allow-read", "--allow-write", "--allow-run",
                                     "--allow-env", "--allow-net", path, "abandon", binary, path
  ], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? a = aRan.ok();
  t.isTrue(contains(string.fromBytes(a!.stdout) + string.fromBytes(a!.stderr), "VERDICT kept"),
           "\{host}: an abandoned readStdin on the program's own input took it with it");
}

/** `connect`, whose remedy is to close rather than to hand on — see `CONNECT_PROGRAM`. */
void checkDialled(T t, Procs procs, string binary, string path, string host) {
  t.isTrue(contains(ran(procs, binary, path, "control"), "VERDICT kept"),
           "\{host}: the connect control did not see the close, so its case cannot fail");
  string got = ran(procs, binary, path, "");
  t.isTrue(contains(got, "VERDICT kept"),
           "\{host}: an abandoned connect left the peer holding the line — \{got}");
}

export string test_bytes_survive_a_reader_whose_caller_stopped_waiting(Sys sys) {
  Output err = sys.stderr();
  Output out = sys.stdout();
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string path = written(env, fs);
  t.isTrue(path != "", "could not write the probe");
  if (path == "") { return t.report(); }

  check(t, procs, binaryPath(env), path, "v8");

  // **Both hosts, because this was in both** — the v8 host had the machinery to hand an unclaimed
  // answer back and spent it on datagrams only, and the wasmtime host had no way to ask. A fix for
  // one host is not a fix.
  string native = nativeBinaryPath(env, fs, t);
  if (native != "") { check(t, procs, native, path, "wasmtime"); }

  // **And the other two capabilities that take something they cannot recreate.** Both hosts again,
  // which is the point: these were fixed on one host and closed as done, and nothing but this case
  // would have asked. `issues/system/0310b`.
  string stdinPath = writtenAs(env, fs, "stdin", STDIN_PROGRAM);
  string acceptPath = writtenAs(env, fs, "accept", ACCEPT_PROGRAM);
  t.isTrue(stdinPath != "" && acceptPath != "", "could not write the other two probes");
  if (stdinPath != "" && acceptPath != "") {
    string dialPath = writtenAs(env, fs, "connect", CONNECT_PROGRAM);
    checkTaken(t, procs, binaryPath(env), stdinPath, acceptPath, "v8");
    checkDialled(t, procs, binaryPath(env), dialPath, "v8");
    if (native != "") {
      checkTaken(t, procs, native, stdinPath, acceptPath, "wasmtime");
      checkDialled(t, procs, native, dialPath, "wasmtime");
    }
    string ownPath = writtenAs(env, fs, "ownstdin", OWNSTDIN_PROGRAM);
    checkOwnStdin(t, procs, binaryPath(env), ownPath, "v8");
    if (native != "") { checkOwnStdin(t, procs, native, ownPath, "wasmtime"); }
    fs.remove(ownPath, false).wait();
    fs.remove(dialPath, false).wait();
    fs.remove(stdinPath, false).wait();
    fs.remove(acceptPath, false).wait();
  }

  fs.remove(path, false).wait();
  return t.report();
}
