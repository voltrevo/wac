// A1 — accept and serve, the program `design/lang/0014` was written for.
//
// Everything else about `async` can be shown with a timer. This cannot: two clients, both accepted
// while the first is still open, both echoed, and **one** `drain` driving all of it. It is the
// criterion the whole design exists to meet, and it uses nearly every part at once — `async void`,
// a `while` loop with a suspension in it, a `match` on what was awaited, an early `return` out of
// the loop, and a second machine started from inside the first one's continuation.
//
// **Not a `linkedTo` in sight, and there used to be one on every line.** The host's capabilities
// handed out tickets with no scheduler, so a machine awaiting one could only be driven by a `wait` —
// never by `drain`, which is what this test needs. A host ticket arrives linked now, so it can be
// dispatched and the program never has to hand the world back something it already had.
//
// **The bug this found was silent.** The lowering's substitution walk returned a `match` unchanged,
// so `echo = bytes` inside an arm went on writing to a name that had become a cell — no diagnostic,
// no crash, just a server that answered nothing and a client that waited for ever. Six controls went
// past before the log said `bytes=0`.

import { T } from "../../../wactest/src/assert.wac";
import { Net, Sys, Socket, Listener } from "std";
import { Read, flatten } from "core";

/**
 * Echo everything one connection sends, until it closes.
 *
 * The `match` is not on `await sock.recv()` directly — a suspension inside a `match` *subject* is one
 * of the shapes this cut declines, as is one inside an arm — so what was awaited is bound first. That
 * is the difference between the design note's sketch and what compiles today, and it is worth seeing.
 */
async void serve(Socket sock, i32[] served) {
  while (true) {
    auto got = await sock.recv();
    u8[] echo = u8[]();
    bool over = got.isErr();
    if (!over) {
      match (got.unwrap()) {
        Data(bytes): { echo = bytes; }
        End: { over = true; }
        Failed(why): { over = true; }
      }
    }
    if (over) { sock.close(); return; }
    auto sent = await sock.send(echo);
    served[0] = served[0] + 1;
  }
}

/** Take `n` connections, starting a server for each — eagerly, and deliberately not awaited. */
async void accepting(Listener listener, i32 n, i32[] served) {
  for (i32 i = 0; i < n; i++) {
    auto took = await listener.accept();
    if (took.isErr()) { return; }
    serve(took.unwrap(), served);
  }
}

string readBack(Socket sock) {
  auto got = flatten(sock.recv().wait());
  string out = "";
  if (got.isErr()) { return out; }
  match (got.unwrap()) { Data(x): { out = string.fromBytes(x); } default: { } }
  return out;
}

export string test_two_clients_are_accepted_and_served_under_one_drain(Sys sys) {
  Net net = sys.net();
  T t = T.create();
  auto lBind = flatten(net.listen("127.0.0.1", 0).wait());
  Listener? l = lBind.ok();
  t.isTrue(l is not null, "bound a loopback listener");
  if (l is null) { return t.report(); }

  i32[] served = i32[].filled(1, 0);
  accepting(l!, 2, served);

  // Both connect before anything is drained, so the second is accepted while the first is open —
  // which is the property, and the reason `accepting` does not wait for `serve`.
  auto aDial = flatten(net.connect("127.0.0.1", l!.port).wait());
  Socket? a = aDial.ok();
  auto bDial = flatten(net.connect("127.0.0.1", l!.port).wait());
  Socket? b = bDial.ok();
  t.isTrue(a is not null && b is not null, "both clients connected");
  if (a is null || b is null) { return t.report(); }
  a!.send("one".toBytes()).wait();
  b!.send("two".toBytes()).wait();

  sys.drainFor(2000);
  t.eqI32(served[0], 2, "both connections were served");
  t.eqStr(readBack(a!), "one", "the first client got its own bytes back");
  t.eqStr(readBack(b!), "two", "and the second got its own");

  // Closing the clients ends both servers, and a drain lets them see it — so nothing is left
  // outstanding when the test returns.
  a!.close();
  b!.close();
  sys.drainFor(2000);
  l!.close();
  return t.report();
}
