// Set or clear the execute bits on a file, from inside a program, so a test can compare hosts.
//
// `setexecutable_test.wac` builds this for the Deno host and the native one and reads the mode each
// leaves behind. **It does nothing but the one capability**: the file and its starting mode are the
// test's to arrange, because a file this program created would carry whatever the umask of whoever
// ran the suite allowed, and "execute follows read" makes the answer depend on that. With the start
// pinned from outside, the expected mode is the same on every machine.
//
// Arguments: the path, then `on` or `off`.

import { Sys, Files } from "std";
import { flatten } from "core";

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Files fs = sys.files();
  string path = argv[0];
  bool on = argv[1] == "on";
  return flatten(fs.setExecutable(path, on).wait()).isOk() ? 0 : 1;
}
