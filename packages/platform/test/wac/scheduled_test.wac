// Work that finishes later: `delay`, `then`, `drain`, `dropAll` — and what leaving without them does.
//
// Driven as a **program**, because the claim is about a program's whole life: that `then` returns
// immediately, that continuations run inside `drain` and nowhere else, and that `main` returning with
// work outstanding is an error the host reports rather than an answer nobody ever gets.
//
// The example prints what it did at each step, so the assertions are about ordering rather than about
// a final number: "scheduled 2, ran 0" before the drain is the whole point of `then` returning now.
//
// ## Host-side until 2026-08-18, `issues/system/0161`
//
// `buildApp` becomes `wac run`. The elapsed-time bound in the budget case is `core.monotonicNanos`,
// which is the same clock the scheduler itself reads — and that is fine here, because what the bound
// catches is a budget in the wrong *unit*: a factor of a million either way makes the run end
// immediately or sit for a minute, and either shows against any clock at all.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli, Exec } from "std/platform.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";

const string ENTRY = "packages/platform/example/scheduled.wac";

struct Ran {
  bool ran;
  i32 status;
  string out;
  string err;
}

Ran run(Cli cli, string how) {
  string wac = cli.cwd().wait() + "/native/v8/target/release/wac";
  Exec r = cli.exec(wac, string[]("run", ENTRY, "--", how), u8[0]()).wait();
  if (!r.ran()) { return Ran(false, -1, "", "the wac binary did not run — " + r.error); }
  return Ran(true, r.status, string.fromBytes(r.stdout), string.fromBytes(r.stderr));
}

string[] splitLines(string s) {
  if (s == "") { return string[0](fill: ""); }
  i32 n = 1;
  for (i32 i = 0; i < s.len(); i++) { if (s.slice(i, i + 1) == "\n") { n = n + 1; } }
  string[] out = string[n](fill: "");
  i32 count = 0;
  i32 at = 0;
  for (i32 i = 0; i <= s.len(); i++) {
    if (i < s.len() && s.slice(i, i + 1) != "\n") { continue; }
    if (i > at) { out[count] = s.slice(at, i); count = count + 1; }
    at = i + 1;
  }
  string[] exact = string[count](fill: "");
  for (i32 i = 0; i < count; i++) { exact[i] = out[i]; }
  return exact;
}

string joinedWith(string[] all, string sep) {
  string out = "";
  for (i32 i = 0; i < all.len(); i++) { out = i == 0 ? all[i] : out + sep + all[i]; }
  return out;
}

string[] sorted(string[] all) {
  string[] out = string[all.len()](fill: "");
  for (i32 i = 0; i < all.len(); i++) { out[i] = all[i]; }
  for (i32 i = 1; i < out.len(); i++) {
    string v = out[i];
    i32 j = i - 1;
    while (j >= 0 && out[j] > v) { out[j + 1] = out[j]; j = j - 1; }
    out[j + 1] = v;
  }
  return out;
}

export string test_then_returns_now_and_the_continuations_run_inside_drain(Core core, Cli cli) {
  T t = T.create();
  Ran r = run(cli, "drain");
  t.isTrue(r.ran, r.err);
  if (!r.ran) { return t.report(); }
  t.eqI32(r.status, 0, r.err);
  // Two things this pins. **`scheduled 2, ran 0`**: `then` registered and returned, and neither
  // continuation had run — a `then` that ran its callback immediately would say `ran 2` here and be
  // `wait` with extra steps. **Both lines before `drained`**: they ran inside that call.
  //
  // **In either order, and that is not laziness.** The two continuations belong to a 1ms and a 2ms
  // delay, and `run` dispatches whichever `waitAny` says is ready. Each capability call runs on its own
  // thread, so which of two overdue timers marks itself ready first is thread scheduling: on a loaded
  // machine this file failed with `second` before `first`, having passed every run before it. The order
  // is the host's answer order, as `example/scheduled.wac` says, and a tie between two simultaneously
  // due timers has no rule — `issues/system/0202`. What the transcript is *for* is that neither ran
  // early and both ran inside the call, and that is asserted position by position.
  string[] lines = splitLines(r.out);
  t.eqI32(lines.len(), 4, r.out);
  if (lines.len() != 4) { return t.report(); }
  t.eqStr(lines[0], "scheduled 2, ran 0", r.out);
  t.eqStr(joinedWith(sorted(string[](lines[1], lines[2])), " "), "first second", r.out);
  t.eqStr(lines[3], "drained 2, ran 2", r.out);
  return t.report();
}

export string test_leaving_with_work_outstanding_is_an_error(Core core, Cli cli) {
  T t = T.create();
  Ran r = run(cli, "leave");
  t.isTrue(r.ran, r.err);
  if (!r.ran) { return t.report(); }
  // The program itself thinks it succeeded — it returned 0 — and the world disagrees, which is the
  // point: the continuation's answer would otherwise never arrive and nothing would say so.
  t.eqStr(joinedWith(splitLines(r.out), "\n"), "scheduled 2, ran 0\nleaving", "the transcript");
  t.isTrue(r.status != 0, "a program that abandons work by accident must not report success");
  t.isTrue(r.err.indexOf("still waiting") >= 0, r.err);
  // And it names both ways out, because the reader's next question is which one they wanted.
  t.isTrue(r.err.indexOf("core.drain()") >= 0, r.err);
  t.isTrue(r.err.indexOf("core.dropAll()") >= 0, r.err);
  return t.report();
}

export string test_a_bounded_drain_runs_what_it_reaches_and_leaves_the_rest(Core core, Cli cli) {
  // **A real clock, which is the point of this one.** The fake `Core` in `test/wac/sched_test.wac`
  // covers the arithmetic, and it shares its unit assumption with the code under test — so a budget in
  // milliseconds compared against a clock in nanoseconds would agree with itself there and pass. Here
  // the clock is the host's: a factor of a million either way and this either runs nothing or waits a
  // minute.
  T t = T.create();
  i64 started = core.monotonicNanos().wait();
  Ran r = run(cli, "budget");
  i64 elapsedMillis = (core.monotonicNanos().wait() - started) / 1000000;
  t.isTrue(r.ran, r.err);
  if (!r.ran) { return t.report(); }
  t.eqI32(r.status, 0, r.err);
  // The two continuations in either order, for the reason the drain case above gives at length.
  string[] lines = splitLines(r.out);
  t.eqI32(lines.len(), 5, r.out);
  if (lines.len() != 5) { return t.report(); }
  t.eqStr(lines[0], "scheduled 2, ran 0", r.out);
  t.eqStr(joinedWith(sorted(string[](lines[1], lines[2])), " "), "first second", r.out);
  t.eqStr(lines[3], "budget ran 2, left 1", r.out);
  t.eqStr(lines[4], "abandoned 1", r.out);
  // And it came back on time. The bound is what is being tested, so the assertion is that it *ended* —
  // a budget in the wrong unit would sit here for the full minute. Loose on both sides: compiling the
  // program dominates this number, and the only wrong answers are "immediately" and "a minute".
  t.isTrue(elapsedMillis < 45000, "a 500ms budget took " + itoa64(elapsedMillis) + "ms");
  return t.report();
}

export string test_a_continuation_on_an_ordinary_capabilitys_ticket(Core core, Cli cli) {
  // **A continuation on a ticket that is not a timer**, which is most of them: `delay` is one
  // capability out of forty and the other thirty-nine answer with a `Pending<T>` too. `waitAny`
  // already takes ticket ids across differing `Pending<T>` — that is the property the whole scheduler
  // stands on — so what was missing was only a way for the ticket to be told which world it belongs
  // to.
  T t = T.create();
  Ran r = run(cli, "linked");
  t.isTrue(r.ran, r.err);
  if (!r.ran) { return t.report(); }
  t.eqI32(r.status, 0, r.err);
  string[] lines = splitLines(r.out);
  t.isTrue(lines.len() >= 5, "five lines: " + joinedWith(lines, " | "));
  if (lines.len() < 5) { return t.report(); }
  t.eqStr(lines[0], "scheduled 2, ran 0", r.out);
  t.eqStr(lines[4], "drained 3", r.out);
  // **The order of the middle three is deliberately not asserted, because it is a race and not a
  // claim.** `randomBytes` is answered by the host at once while the two timers are 1ms and 2ms out —
  // and `then` is followed by a `core.log`, which is itself a round trip, so whether the timers have
  // settled before the drain starts depends on how loaded the box is. Both orders are correct.
  string[] middle = string[](lines[1], lines[2], lines[3]);
  t.eqStr(joinedWith(sorted(middle), ","), "first,random 8,second", r.out);
  return t.report();
}

export string test_dropall_makes_leaving_deliberate(Core core, Cli cli) {
  T t = T.create();
  Ran r = run(cli, "abandon");
  t.isTrue(r.ran, r.err);
  if (!r.ran) { return t.report(); }
  t.eqI32(r.status, 0, r.err);
  t.eqStr(joinedWith(splitLines(r.out), "\n"), "scheduled 2, ran 0\nabandoned 2", "the transcript");
  // Neither continuation ran, which is the difference between abandoning and draining.
  t.isTrue(r.out.indexOf("first") < 0, r.out);
  return t.report();
}
