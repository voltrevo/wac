// A program running inside another one, its world handed to it as values.
//
// Driven through `example/inside.wac`, which is the smallest thing that uses all of it — its own
// argv, its own standard input, its own working directory, and both output streams kept rather
// than written. The assertions are on what the *parent* printed, because the point of the
// capability is that the child printed nothing anybody else can see.
//
// `native_examples_test.wac` runs this same example, and runs it on both hosts — but what it checks
// is that the two hosts *agree*, which two hosts that had both lost the child's standard error would
// also do. What is here is the content: the exact transcript, and the parent's own streams staying
// empty.
//
// Host-side until 2026-08-19, `issues/system/0161`.

import { binaryPath } from "../../../wactest/src/host.wac";
import { builtProgram } from "../../../wactest/src/built.wac";
import { T } from "../../../wactest/src/assert.wac";
import { Exec, ChildEnv, Env, Files, Launch, Procs, Sys } from "std";
import { contains } from "../../../wactest/src/strings.wac";
import { freshDir } from "../../../wactest/src/host.wac";
import { flatten } from "core";

static string INSIDE = "packages/platform/example/inside.wac";

string root(Env env) { return flatten(env.cwd().wait()).unwrap(); }

/** A directory of this test's own, under `.cache` so no walker over the repository sees it appear. */
string freshScratch(T t, Env env, Files fs, string name) {
  string dir = "\{root(env)}/.cache/inside-\{name}";
  string why = freshDir(fs, dir);
  t.isTrue(why == "", why);
  return dir;
}

/**
 * `inside.wac`, built once and cached — a module, run as `wac <module.wasm>`.
 *
 * **`builtProgram` rather than `deno run packages/platform/build.ts`.** `design/system/0009` is
 * removing that builder's non-browser targets, and nothing here wanted a file to hand somebody: it
 * wanted a program to run. The cache is why this is a module rather than a `wac app` executable to a
 * temporary name — `issues/system/0283c` — and it rebuilds only when the sources or the compiler
 * move.
 */
string built(T t, Env env, Files fs, Procs procs) {
  string mod = builtProgram(env, fs, procs, INSIDE, "inside", ["--allow-read", "--allow-write"]);
  t.isTrue(mod != "", "inside.wac built");
  return mod;
}

export string test_a_childs_output_comes_back_to_its_caller_and_goes_nowhere_else(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = freshScratch(t, env, fs, "quiet");
  string app = built(t, env, fs, procs);
  if (app == "") { fs.remove(dir, true).wait(); return t.report(); }

  auto rRan = flatten(procs.exec(binaryPath(env), [app, dir], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null), "the built program ran");
  if ((r is null)) { fs.remove(dir, true).wait(); return t.report(); }
  string out = string.fromBytes(r!.stdout);
  t.eqI32(r!.status, 0, string.fromBytes(r!.stderr));

  // Everything the child wrote, in the order it wrote it: its uppercased input, the file it opened
  // by a name relative to the directory it was handed, then a line of its own.
  const string WANT = "status 0\n" +
    "out   FROM STDIN\\nFROM THE FILE\\nread 14 bytes\\n\n" +
    "err   shout: nothing wrong, just talking\\n\n";
  t.eqStr(out, WANT, "the parent's transcript of its child");

  // And the child's own streams reached neither of the parent's. This is the parent's standard
  // error, which stayed empty while the child was complaining into its buffer.
  t.eqStr(string.fromBytes(r!.stderr), "", "the parent's standard error");
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_a_child_reads_what_it_was_fed_not_the_terminals_standard_input(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = freshScratch(t, env, fs, "stdin");
  string app = built(t, env, fs, procs);
  if (app == "") { fs.remove(dir, true).wait(); return t.report(); }

  // Something on the real standard input that the child must *not* see: a filter running inside a
  // shell that read the terminal would swallow it.
  auto rRan = flatten(procs.exec(binaryPath(env), [app, dir], "THE PARENT'S OWN INPUT\n".toBytes(), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null), "the built program ran");
  if ((r is null)) { fs.remove(dir, true).wait(); return t.report(); }
  string out = string.fromBytes(r!.stdout);

  t.isTrue(contains(out, "FROM STDIN"), "the child read its own feed: \{out}");
  t.isTrue(!contains(out, "PARENT"), "the child read the parent's standard input: \{out}");
  fs.remove(dir, true).wait();
  return t.report();
}
