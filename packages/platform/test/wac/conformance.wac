// Scanning source files for the names they declare, for `conformance_test.wac`.
//
// Hand-written rather than a regex, and that is the point rather than a limitation: every one of
// these is asserted to have found *enough*, because an extraction that quietly matched nothing makes
// the loop it feeds vacuous — which is how a ledger comes to certify a surface it never read. The
// TypeScript this replaces learned that twice, once in each direction: a bracket class that stopped
// at the `]` of `u8[]` reported 20 `Cli` fields where there are 31, and a `SCREAMING_SNAKE` to
// `camelCase` conversion that is right 36 times out of 38 reported two capabilities as missing from a
// runtime that plainly has them. Since design/system/0013 step 6 every side spells a request by its `OP_*`
// name, so there is no conversion left to get wrong.
//
// Not a test file and not discovered as one: `wac test` walks `*_test.wac`.

import { Files } from "std";
import { flatten } from "core";

export string sourceOf(Files fs, string path) {
  u8[]? f = flatten(fs.readFile(path).wait()).ok();
  if ((f is null)) { trap; }
  return string.fromBytes(f!);
}

/** Every line of `text`, without its terminator. */
export string[] linesOf(string text) {
  i32 count = 1;
  u8[] b = text.toBytes();
  for (i32 i = 0; i < b.len(); i++) { if (b[i] == '\n') { count = count + 1; } }
  string[] out = string[].filled(count, "");
  i32 n = 0;
  i32 at = 0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] == '\n') {
      out[n] = text.slice(at, i);
      n = n + 1;
      at = i + 1;
    }
  }
  out[n] = text.slice(at, text.len());
  return out;
}

bool isUpper(i32 c) { return c >= 'A' && c <= 'Z'; }
bool isDigit(i32 c) { return c >= '0' && c <= '9'; }
bool isWordByte(i32 c) {
  return isUpper(c) || isDigit(c) || (c >= 'a' && c <= 'z') || c == '_';
}

/** Trim the given array to its first `n` entries. */
string[] firstOf(string[] all, i32 n) {
  string[] out = string[].filled(n, "");
  for (i32 i = 0; i < n; i++) { out[i] = all[i]; }
  return out;
}

/**
 * The requests std numbers — `export i32 OP_NAME() { return N; }` in `std/platform.wac` — as `NAME=N`. This is
 * the table every host implements, so it is what the rest is compared with.
 */
export string[] requestNumbers(Files fs) {
  string[] lines = linesOf(sourceOf(fs, "std/platform.wac"));
  string[] found = string[].filled(lines.len(), "");
  i32 n = 0;
  for (i32 i = 0; i < lines.len(); i++) {
    string line = lines[i];
    string open = "export i32 OP_";
    if (line.len() <= open.len() || line.slice(0, open.len()) != open) { continue; }
    u8[] b = line.toBytes();
    i32 at = open.len();
    while (at < b.len() && (isUpper(b[at] as i32) || isDigit(b[at] as i32) || b[at] == '_')) { at = at + 1; }
    string name = line.slice(open.len(), at);
    string rest = line.slice(at, line.len());
    string ret = "() { return ";
    if (rest.len() <= ret.len() || rest.slice(0, ret.len()) != ret) { continue; }
    i32 d = ret.len();
    i32 e = d;
    u8[] r = rest.toBytes();
    while (e < r.len() && isDigit(r[e] as i32)) { e = e + 1; }
    if (e == d) { continue; }
    found[n] = name + "=" + rest.slice(d, e);
    n = n + 1;
  }
  return firstOf(found, n);
}

/** The request names alone, in std's order. */
export string[] requests(Files fs) {
  string[] numbered = requestNumbers(fs);
  string[] out = string[].filled(numbered.len(), "");
  for (i32 i = 0; i < numbered.len(); i++) { out[i] = numbered[i].slice(0, numbered[i].indexOf("=")); }
  return out;
}

/**
 * The JavaScript bridge's numbering in `host/ops.ts`, as `NAME=N`.
 *
 * Two spaces, a `SCREAMING_SNAKE` name, a colon, a number and a comma: the shape of one entry in the
 * object literal, and nothing else in that file has it.
 */
export string[] bridgeNumbers(Files fs) {
  string[] lines = linesOf(sourceOf(fs, "packages/platform/host/ops.ts"));
  string[] found = string[].filled(lines.len(), "");
  i32 n = 0;
  for (i32 i = 0; i < lines.len(); i++) {
    string line = lines[i];
    u8[] b = line.toBytes();
    if (b.len() < 5 || b[0] != ' ' || b[1] != ' ' || !isUpper(b[2] as i32)) { continue; }
    i32 at = 2;
    while (at < b.len() && (isUpper(b[at] as i32) || isDigit(b[at] as i32) || b[at] == '_')) { at = at + 1; }
    if (at >= b.len() || b[at] != ':') { continue; }
    i32 name = at;
    at = at + 1;
    if (at >= b.len() || b[at] != ' ') { continue; }
    at = at + 1;
    i32 from = at;
    while (at < b.len() && isDigit(b[at] as i32)) { at = at + 1; }
    if (at == from || at >= b.len() || b[at] != ',' || at + 1 != b.len()) { continue; }
    found[n] = line.slice(2, name) + "=" + line.slice(from, at);
    n = n + 1;
  }
  return firstOf(found, n);
}

/**
 * The requests the wasmtime host answers: every `OP_NAME` that `native/src/main.rs` uses anywhere but in the line
 * declaring it — a match arm, or `op == OP_DROP`. A request with no use there is one this host never serves.
 */
export string[] nativeRequests(Files fs) {
  string src = sourceOf(fs, "native/src/main.rs");
  string[] lines = linesOf(src);
  string[] found = string[].filled(128, "");
  i32 n = 0;
  for (i32 i = 0; i < lines.len(); i++) {
    string line = lines[i];
    if (line.len() >= 9 && line.slice(0, 9) == "const OP_") { continue; }
    u8[] b = line.toBytes();
    i32 at = 0;
    while (at + 3 <= b.len()) {
      i32 hit = line.slice(at, line.len()).indexOf("OP_");
      if (hit < 0) { break; }
      i32 start = at + hit;
      // Not the tail of a longer word: `FAULT_OP_X` is no request.
      if (start > 0 && isWordByte(b[start - 1] as i32)) { at = start + 3; continue; }
      i32 end = start + 3;
      while (end < b.len() && (isUpper(b[end] as i32) || isDigit(b[end] as i32) || b[end] == '_')) { end = end + 1; }
      string name = line.slice(start + 3, end);
      if (name.len() > 0 && !has(firstOf(found, n), name) && n < found.len()) {
        found[n] = name;
        n = n + 1;
      }
      at = end;
    }
  }
  return firstOf(found, n);
}

export bool has(string[] all, string want) {
  for (i32 i = 0; i < all.len(); i++) { if (all[i] == want) { return true; } }
  return false;
}

/** Ascending, so a pinned set can be written down once and stay written. */
export string[] sorted(string[] all) {
  string[] out = string[].filled(all.len(), "");
  for (i32 i = 0; i < all.len(); i++) { out[i] = all[i]; }
  for (i32 i = 1; i < out.len(); i++) {
    string v = out[i];
    i32 k = i - 1;
    while (k >= 0 && out[k] > v) { out[k + 1] = out[k]; k = k - 1; }
    out[k + 1] = v;
  }
  return out;
}

export string joined(string[] all, string sep) {
  string out = "";
  for (i32 i = 0; i < all.len(); i++) { out = out + (i == 0 ? "" : sep) + all[i]; }
  return out;
}
