// The wasmtime host can run a test file at all.
//
// **Every other check on that host compares timestamps, and this failure was in what it does.**
// `tools/wac/seedfresh_test.wac` asks whether the binary is older than its Rust and whether the seed
// is older than the graph it is built from; both were current on 2026-09-01 while `wac test` on that
// host refused **every export of every file** in the repository with *this module was built without
// Core and Cli*. `issues/system/0316b`. No freshness rule can catch that, because nothing was stale.
//
// `nativeHostWhyNot()` answered `""` — nothing wrong — throughout, so the eleven test files that
// consult it did not skip and did not compare. That is the shape worth guarding: `design/system/0001`
// D9 says this host exists to test the claim that a wac program does not depend on one, and a suite
// that never asked it does not test that claim. A green run and a run that never happened look the
// same from here unless something asserts the difference.
//
// **Why it runs a whole `wac test` rather than a program.** `wac run` worked the entire time this was
// broken — a program has the `main` the world was sized from, and that is exactly why the bug reached
// production. The two entry points build the world by different routes, so a probe through the
// working one proves nothing about the other. This drives the route the eleven files use.
//
// **And it reads the count rather than the exit status.** A host that cannot run the file at all and
// one whose test genuinely fails both leave a non-zero status; only the report says which.
// `issues/system/0316b`'s failure printed `0 passed, 6 failed` per file, which is a sentence a status
// cannot carry.

import { Core, Cli, Exec } from "std";
import { T } from "../../../wactest/src/assert.wac";
import { nativeHost, nativeHostWhyNot, requireNativeHost } from "../../../wactest/src/built.wac";
import { binaryPath, freshDir, scratch } from "../../../wactest/src/host.wac";
import { trimmed } from "../../../wactest/src/strings.wac";

string SUBJECT() { return "packages/platform/test/wac/worldarrives_test.wac"; }

export string test_the_wasmtime_host_can_run_a_test_that_takes_a_world(Core core, Cli cli) {
  T t = T.create();
  if (requireNativeHost(cli, t) == "") { return t.report(); }

  Exec r = cli.exec(nativeHost(cli),
                    ["test", "--allow-read", "--allow-write", "--allow-run", SUBJECT()],
                    u8[]()).wait();
  string said = string.fromBytes(r.stdout) + string.fromBytes(r.stderr);
  t.isTrue(r.ran(), "the wasmtime host ran at all");
  if (!r.ran()) { return t.report(); }

  // The sentence itself, named, because it is the one this exists for and a future variant of it
  // would otherwise arrive as an unexplained count.
  t.isTrue(said.indexOf("built without") < 0,
           "the host refused the module's world — `\{SUBJECT()}` takes `Core` and `Cli`, and\n"
           + "  a world sized from something other than the export being called refuses exactly that.\n"
           + "  See issues/system/0316b. It said:\n  \{said}");
  t.isTrue(said.indexOf("1 passed, 0 failed") >= 0,
           "the wasmtime host reported a passing test, rather than:\n  \{said}");
  return t.report();
}

/**
 * An `async` `main` awaiting a `Cli` ticket finishes — **`Core` and `Cli` share one scheduler**.
 *
 * Each has a `sched` field, and the host builds it by calling `Sched.create`. Called once per struct,
 * `cli.readFile(…)` linked its ticket to `Cli`'s scheduler while `main` was run by `Core`'s, which
 * found nothing pending and said *"main cannot finish"*. Every program did, the seed's own `main`
 * included, so nothing at all ran on this host. The v8 host had fixed the same fault in its own
 * construction and the fix was never carried over. `issues/system/0367c`.
 *
 * **Built by the v8 binary and run as a module**, so what is tested is this host and not the seed on
 * it: through `wac run` the seed fails first, and the case would only repeat the test above.
 */
static string AWAITS_CLI =
  "import { Sys, FileResult } from \"std\";\n" +
  "export async i32 main(Sys sys) {\n" +
  "  FileResult f = await sys.cli.readFile(\"awaited.txt\").ticket();\n" +
  "  sys.core.log(f.ok ? \"read: \" + string.fromBytes(f.bytes) : \"read failed\");\n" +
  "  return 0;\n" +
  "}\n";

export string test_an_async_main_awaiting_a_cli_ticket_finishes_on_the_wasmtime_host(Core core, Cli cli) {
  T t = T.create();
  if (requireNativeHost(cli, t) == "") { return t.report(); }
  string dir = scratch(cli, "awaits-cli");
  string fresh = freshDir(cli, dir);
  t.isTrue(fresh == "", fresh);
  if (fresh != "") { return t.report(); }
  t.isTrue(cli.writeFile("\{dir}/main.wac", AWAITS_CLI.toBytes()).wait().ok(), "wrote the program");
  t.isTrue(cli.writeFile("\{dir}/awaited.txt", "here".toBytes()).wait().ok(), "wrote its input");

  Exec made = cli.exec(binaryPath(cli),
                       ["build", "--allow-read", "\{dir}/main.wac", "-o", "\{dir}/main"], u8[]()).wait();
  t.eqI32(made.status, 0, "the v8 binary could not build it: \{string.fromBytes(made.stderr)}");
  if (made.status != 0) { return t.report(); }

  // `cd` so the relative `awaited.txt` is found; a relative path is also the ordinary case.
  Exec r = cli.exec("/bin/sh", ["-c", "cd '\{dir}' && '\{nativeHost(cli)}' ./main.wasm 2>&1"], u8[]()).wait();
  string said = string.fromBytes(r.stdout);
  t.isTrue(said.indexOf("cannot finish") < 0,
           "the wasmtime host ran `main` on a scheduler `Cli`'s tickets are not on:\n  \{said}");
  t.eqStr(trimmed(said), "read: here", "what the program said");
  t.eqI32(r.status, 0, "its status");
  cli.remove(dir, true).wait();
  return t.report();
}
