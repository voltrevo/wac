// Does closing a socket with a read outstanding on it still tell the peer?
//
// **The probe `issues/system/0304b` asks for.** `packages/tor/src/socks.wac` ends a client the way
// every path in that file ends one — cancelling its outstanding read and then closing the socket — and the
// peer never sees the close: it reads the whole response and then waits for an end-of-stream that
// does not arrive. `dird.wac` closes the same way and its peers *do* see `End`, and the one thing
// that differs is the cancelled `recv` outstanding on the socket.
//
// **The answer, and it is not the one the issue was filed on.** Three arms differing only in what is
// outstanding on the server's socket at the moment it closes:
//
//     nothing outstanding    the client sees `End`
//     a live `recv`          the client sees `End`      — and saw nothing until 2026-08-31
//     a cancelled `recv`     the client sees `End`      — likewise
//
// So cancelling is a red herring. `0304b` was filed as "`socks` does not close a client's socket"
// because `socks.wac` cancels before closing and `dird.wac`, whose peers do see `End`, does not —
// and the live-read arm fails identically. What breaks a close is *any* pending read.
//
// **The control is the load-bearing row**, and the first draft of this file did not have one. It
// issued the `recv` in both arms and called the uncancelled one the control, so the control was
// itself "a close behind a live read": both failed, and a control that fails for the same reason as
// the case proves nothing — it reads as a harness that never sees a close at all. Three arms is the
// smallest set that separates "cancel breaks it" from "any outstanding read breaks it".

import { T } from "../../../wactest/src/assert.wac";
import { Clock, Net, Sys, Socket, Listener, TimedOut } from "std";
import { Read, flatten } from "core";

/**
 * Long enough that a loopback close cannot lose a race, short enough that pinning a bug is cheap.
 *
 * Two of the three arms wait this out on every run, so it is 2s of the suite. A close on loopback is
 * immediate when it happens at all — the control proves that in well under a millisecond — so this
 * is three orders of magnitude of margin rather than a guess.
 */
static i32 WAIT_MS = 1000;

/** What is outstanding on the server socket when it is closed. */
static i32 MODE_NO_READ = 0;
static i32 MODE_LIVE_READ = 1;
static i32 MODE_CANCELLED = 2;

/** What the client saw after the server closed. */
struct Saw {
  bool ended;      // the peer's close arrived, as `End` or as a failure
  bool timedOut;   // nothing arrived before the deadline — the symptom `0304b` reports
  string detail;
}

/**
 * Read once, bounded.
 *
 * Bounded because the whole question is whether something arrives, and an unbounded read turns "no"
 * into a hang with no output — `wac test` buffers a file's output until it finishes, which is how
 * `socksnet_test.wac` produced six minutes of nothing.
 */
Saw sawClose(Clock clock, Socket sock) {
  auto got = flatten(clock.within(sock.recv(), WAIT_MS).wait());
  if (got.isErr()) {
    if (got.err()! is TimedOut) { return Saw(false, true, "nothing arrived within \{WAIT_MS}ms"); }
    return Saw(true, false, "failed: \{got.err()!}");
  }
  match (got.unwrap()) {
    Data(got): { return Saw(false, false, "got \{got.len()} byte(s), not a close"); }
    End: { return Saw(true, false, "End"); }
    Failed(why): { return Saw(true, false, "Failed: \{why}"); }
  }
  return Saw(false, false, "unreachable");
}

/**
 * One connection, closed by the server, with `cancelFirst` deciding whether a read was outstanding.
 *
 * The server half issues its `recv` *before* deciding, so the two arms differ in exactly one call
 * rather than in the shape of what ran.
 */
Saw exchange(Net net, Clock clock, T t, i32 mode, string arm) {
  auto listenerBind = flatten(net.listen("127.0.0.1", 0).wait());
  Listener? listener = listenerBind.ok();
  if (listener is null) {
    t.fail("\{arm}: could not listen — \{listenerBind.isErr() ? "\{listenerBind.err()!}" : ""}");
    return Saw(false, false, "no listener");
  }

  auto accepting = listener!.accept();
  auto dialled = flatten(net.connect("127.0.0.1", listener!.port).wait());
  if (dialled.isErr()) {
    t.fail("\{arm}: could not connect to 127.0.0.1:\{listener!.port} — \{dialled.err()!}");
    listener!.close();
    return Saw(false, false, "no client");
  }
  Socket client = dialled.unwrap();

  auto took = flatten(accepting.wait());
  if (took.isErr()) {
    t.fail("\{arm}: accept failed — \{took.err()!}");
    client.close();
    listener!.close();
    return Saw(false, false, "no accept");
  }
  Socket served = took.unwrap();

  // `mode` decides what is outstanding when the close happens, and the first draft got this wrong:
  // it issued the `recv` in *both* arms and called the uncancelled one "the control", so the control
  // was "a close behind a live read" while its message said "no read outstanding". Both failed, and
  // a control that fails for the same reason as the case proves nothing. Three arms, and only the
  // first is a real control.
  if (mode == MODE_NO_READ) {
    // Nothing outstanding at all.
  } else {
    auto pending = served.recv();
    if (mode == MODE_CANCELLED) { pending.cancel(); }
  }
  served.close();

  Saw saw = sawClose(clock, client);
  client.close();
  listener!.close();
  return saw;
}

export string test_a_close_reaches_the_peer_whatever_is_outstanding(Sys sys) {
  Net net = sys.net();
  Clock clock = sys.clock();
  T t = T.create();

  // The control first, so a failure in the case cannot be read as "this harness never sees a close".
  Saw plain = exchange(net, clock, t, MODE_NO_READ, "no read outstanding");
  t.isTrue(plain.ended, "the control: a close with nothing outstanding reaches the peer — " +
                        plain.detail);

  Saw live = exchange(net, clock, t, MODE_LIVE_READ, "a live read outstanding");
  t.isTrue(live.ended, "a close behind a *live* read reaches the peer — \{live.detail}");

  Saw cancelled = exchange(net, clock, t, MODE_CANCELLED, "after a cancel");
  t.isTrue(cancelled.ended, "and so does one behind a cancelled read — \{cancelled.detail}" +
                            ". The two arms agreeing is the finding: cancelling never mattered");

  return t.report();
}

/**
 * Closing a **listener** stops it accepting — the same question one socket kind over.
 *
 * The test above is about a close reaching the peer of an established connection. This is about a
 * close happening at all: `Sock` has three kinds in `native/src/main.rs` — `Listening`, `Open` and
 * `Datagram` — and `Cap::CloseSocket` matched only `Open` until 2026-09-01. So on the wasmtime host
 * closing a listener fell through the `if let` and did nothing: the handle stayed in the table and
 * the port stayed bound. `issues/system/0317b`.
 *
 * **What it cost is worth more than the arm it broke.** `packages/wactest/src/daemon.wac` gets a free
 * port by binding zero and releasing, and its readiness wait dials until something answers. With the
 * listener never released, "is the server up yet?" was answered *yes* by the listener the test had
 * just closed — so `daemon_test.wac` failed two tests saying `something answered on a port nothing is
 * listening on`, and hung a third talking to a server that did not exist. A close that silently does
 * nothing does not look like a close bug from any of those.
 *
 * **The control arm is the point.** Dialling while the listener is open must succeed, or a refusal
 * afterwards proves only that the dial never worked — which is the shape
 * `packages/tor/test/wac/` calls a probe that cannot fail.
 */
export string test_closing_a_listener_stops_it_accepting(Sys sys) {
  Net net = sys.net();
  T t = T.create();
  auto lBind = flatten(net.listen("127.0.0.1", 0).wait());
  Listener? l = lBind.ok();
  t.isTrue(l is not null, "a listener was opened — \{lBind.isErr() ? "\{lBind.err()!}" : ""}");
  if (l is null) { return t.report(); }

  auto upDial = flatten(net.connect("127.0.0.1", l!.port).wait());
  Socket? up = upDial.ok();
  t.isTrue(up is not null,
           "the control arm: dialling it while it is open succeeds, so a refusal below is the close\n"
           + "  rather than a dial that never worked — \{upDial.isErr() ? "\{upDial.err()!}" : ""}");
  if (up is not null) { up!.close(); }

  l!.close();

  auto downDial = flatten(net.connect("127.0.0.1", l!.port).wait());
  Socket? down = downDial.ok();
  if (down is not null) { down!.close(); }
  t.isTrue(down is null,
           "dialling port \{l!.port} after closing its listener was accepted — the listener\n"
           + "  is still there. A readiness probe built on this reads a closed port as a live server.");
  return t.report();
}
