// One program, two substantially different hosts, and the same answer.
//
// design/0001's arrival test in miniature — "load the same image in two substantially different hosts
// and demonstrate the same behaviour in both", where **substantially different means one JavaScript
// host and one that is not** (D9). Two JavaScript hosts satisfy the words and prove nothing: they
// share the transport, the worker model and the event loop. This is the first test in the repo that
// does not.
//
// The program is `example/wacland.wac`, whose stages are 0087's "done when" in the order a host
// acquires them: output, arguments, two requests completing out of order, a `waitAny` that comes back
// on its deadline, a spawned child waited for alongside a ticket of another kind, and a child given
// less than its parent has. Both hosts reach the end, so the comparison is the whole run.
//
// **What is compared and what is not.** Two of the lines carry monotonic nanoseconds, which are a
// measurement rather than an answer — two hosts that agreed on those would be suspicious rather than
// correct, since one of them takes longer to start. So the transcripts are compared with those
// numbers masked, and the *relationships* between them are asserted separately on each host: the
// quick sleep settles before the slow one, and the gap is about what was asked for.
//
// The canary is that the masking is not doing the work: a run with every number masked and no other
// assertion would report agreement between two hosts that printed nothing. So the test also pins the
// exact line count, the stage-3 ordering, and that stage 4 timed out.
//
// ## When the wasmtime host is not there
//
// The case fails, naming the build — `requireNativeHost`. It used to skip the native half loudly, and a
// loud skip is still a gate that passed having compared nothing; `tools/push.sh` builds the host.
//
// Host-side until 2026-08-19, `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { nativeHost, nativeHostWhyNot, requireNativeHost } from "../../../wactest/src/built.wac";
import { Exec, ChildEnv, Env, Files, Launch, Output, Procs, Sys } from "std";
import { contains } from "../../../wactest/src/strings.wac";
import { jsonFile } from "../../../wactest/src/jsonfile.wac";
import { JsonValue, JsonObject, JsonArray } from "../../../json/src/value.wac";
import { customSection } from "./section.wac";
import { freshDir } from "../../../wactest/src/host.wac";
import { flatten } from "core";

static string ENTRY = "packages/platform/example/wacland.wac";
/** The `Cli.execWith` transcript, for the comparison `conformance_test.wac` asks for. */
static string EXEC_PROBE = "packages/platform/test/wac/exec_probe.wac";

string root(Env env) { return flatten(env.cwd().wait()).unwrap(); }

struct Ran {
  i32 code;
  string out;
  string err;
}

/**
 * Run it with the machine's environment plus one name.
 *
 * Stage 6's environment half reads `WACLAND_PROBE`. Added rather than replacing, so the two hosts
 * are asked the same question whatever the shell happened to export.
 *
 * **No shell since 2026-08-20.** This went through `/bin/sh -c` with every word quoted, because
 * "`Cli.exec` takes a program and arguments and not a world" — and `Cli.execWith` now takes the
 * world (`issues/system/0182`). One process instead of two, no quoting to get wrong, and a path
 * containing a space is no longer a thing this has to be careful about.
 */
Ran runIt(Procs procs, string cmd, string[] args) {
  Exec r = flatten(procs.exec(cmd, args, u8[](), ChildEnv(false, ["WACLAND_PROBE=seen"]), Launch("", false, false, false)).wait()).unwrap();
  if (!r.ran()) { return Ran(-1, "", "\{cmd} did not run — \{r.error}"); }
  return Ran(r.status, string.fromBytes(r.stdout), string.fromBytes(r.stderr));
}

/**
 * The native host binary, or `""` — **asked for, not built here.** `issues/system/0208`.
 *
 * The `find` guard this replaces never fired on a `.rs` change: `-o` binds looser than the implicit
 * `-a`, so `-print` lived only in the `Cargo.toml` branch and the `*.rs` branch carried no action.
 * `wac task seed` owns the build; `wac task seed:native` does this crate alone.
 */
string nativeBinary(Env env, Files fs, T t) { return requireNativeHost(env, fs, t); }

string buildOne(Env env, Procs procs, string entry, bool native, string out, string[] grants) {
  if (native) {
    string[] args = string[].filled(4 + grants.len(), "");
    args[0] = "build";
    args[1] = entry;
    for (i32 i = 0; i < grants.len(); i++) { args[2 + i] = grants[i]; }
    args[2 + grants.len()] = "-o";
    args[3 + grants.len()] = out;
    auto rRan = flatten(procs.exec("\{root(env)}/native/v8/target/release/wac", args, u8[](), ChildEnv.inherited(), Launch.plain()).wait());
    Exec? r = rRan.ok();
    if ((r is null) || r!.status != 0) {
      return "wac build: \{string.fromBytes(r!.stderr)}\{string.fromBytes(r!.stdout)}";
    }
    return "";
  }
  string[] head = ["run", "-A", "packages/platform/build.ts", entry];
  string[] args = string[].filled(head.len() + grants.len() + 2, "");
  for (i32 i = 0; i < head.len(); i++) { args[i] = head[i]; }
  for (i32 i = 0; i < grants.len(); i++) { args[head.len() + i] = grants[i]; }
  args[head.len() + grants.len()] = "-o";
  args[head.len() + grants.len() + 1] = out;
  auto rRan = flatten(procs.exec("deno", args, u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  if ((r is null) || r!.status != 0) { return "build.ts: \{string.fromBytes(r!.stderr)}"; }
  return "";
}

string freshScratch(T t, Env env, Files fs, string name) {
  string dir = "\{root(env)}/.cache/native-\{name}";
  string why = freshDir(fs, dir);
  t.isTrue(why == "", why);
  return dir;
}

/** The non-empty lines of `text`. */
string[] linesOf(string text) {
  u8[] b = text.toBytes();
  i32 count = 0;
  i32 at = 0;
  for (i32 i = 0; i <= b.len(); i++) {
    if (i == b.len() || b[i] == '\n') {
      if (i > at) { count = count + 1; }
      at = i + 1;
    }
  }
  string[] out = string[].filled(count, "");
  i32 n = 0;
  at = 0;
  for (i32 i = 0; i <= b.len(); i++) {
    if (i == b.len() || b[i] == '\n') {
      if (i > at) { out[n] = text.slice(at, i); n = n + 1; }
      at = i + 1;
    }
  }
  return out;
}

/** The digits following `after`, or -1 when the marker is not there. */
i64 numberAfter(string text, string after) {
  i32 at = text.indexOf(after);
  if (at < 0) { return -1 as i64; }
  u8[] b = text.toBytes();
  i32 i = at + after.len();
  bool neg = false;
  if (i < b.len() && b[i] == '-') { neg = true; i = i + 1; }
  i64 n = 0 as i64;
  i32 digits = 0;
  while (i < b.len() && b[i] >= '0' && b[i] <= '9') {
    n = n * (10 as i64) + ((b[i] as i32 - '0') as i64);
    digits = digits + 1;
    i = i + 1;
  }
  if (digits == 0) { return -1 as i64; }
  return neg ? -n : n;
}

/** The two lines carrying monotonic nanoseconds, with the number replaced by its name. */
string masked(string out) {
  string text = out;
  string[] markers = ["stage 3 quick ", "stage 3 slow "];
  for (string marker in markers) {
    i32 at = text.indexOf(marker);
    if (at < 0) { continue; }
    i32 from = at + marker.len();
    u8[] b = text.toBytes();
    i32 to = from;
    while (to < b.len() && b[to] >= '0' && b[to] <= '9') { to = to + 1; }
    text = "\{text.slice(0, from)}<nanos>\{text.slice(to, text.len())}";
  }
  return text;
}

bool holds(string[] lines, string want) {
  for (string line in lines) { if (line == want) { return true; } }
  return false;
}

/** Everything the conformance program must have done, whichever host ran it. */
void assertConformant(T t, Ran r, string host) {
  string[] lines = linesOf(r.out);
  t.eqI32(r.code, 0, "\{host} exited \{r.code}: \{r.err}");
  // The line count, so that masking a number cannot hide a stage that never ran.
  t.eqI32(lines.len(), 16, "\{host}: \{r.out}");
  if (lines.len() == 0) { return; }
  t.eqStr(lines[0], "wacland: stage 1 output", host);
  t.isTrue(contains(r.err, "wacland: stage 1 warn"),
           "\{host} put the warning on the wrong stream: \{r.err}");
  t.isTrue(holds(lines, "wacland: stage 2 argCount 2"), "\{host}: \{r.out}");
  t.isTrue(holds(lines, "wacland: stage 2 arg 1 two"), "\{host}: \{r.out}");

  // 0087's first criterion. The *long* sleep is submitted first, so a host that answered in
  // submission order — or that resolved every ticket as it was made — says 0 here.
  t.eqI64(numberAfter(r.out, "stage 3 first "), 1 as i64,
          "\{host} settled the two sleeps in submission order");
  i64 quick = numberAfter(r.out, "stage 3 quick ");
  i64 slow = numberAfter(r.out, "stage 3 slow ");
  t.isTrue(quick < slow, "\{host}: quick \{quick as~ i32} did not settle before slow");
  // Both are monotonic nanoseconds from the host's own origin, so only the *gap* is comparable. 120
  // and 10 were asked for; anything between 50 and 500 ms of separation says the two sleeps really
  // slept for different lengths rather than both returning at once.
  i64 gapMs = (slow - quick) / (1000000 as i64);
  t.isTrue(gapMs > (50 as i64) && gapMs < (500 as i64),
           "\{host}: the sleeps were \{gapMs as~ i32}ms apart");

  // 0087's second criterion: a deadline with nothing ready comes back rather than hanging, and -1 is
  // what `platform.wac` says "nothing settled" is spelled.
  t.isTrue(holds(lines, "wacland: stage 4 timeout -1"), "\{host}: \{r.out}");

  // Stage 6, both halves. **The env half is the one that discriminates**: `GRANT_READ` is bit 1 and
  // every encoding of these flags agrees about bit 1, so a host that decoded the higher bits
  // differently would pass the read half and this whole file. `GRANT_ENV` is bit 8.
  //
  // **A child gets what its parent granted, and no more.** Asked twice on purpose: a child refused
  // when its parent had nothing to give is not evidence of an intersection, so this program is built
  // *with* reading and the two answers must differ. One answer would pass on a host that denied
  // everything and on a host that granted everything.
  t.isTrue(holds(lines, "wacland: stage 6 withheld denied"), "\{host}: \{r.out}");
  t.isTrue(holds(lines, "wacland: stage 6 granted ok"), "\{host}: \{r.out}");
  t.isTrue(holds(lines, "wacland: stage 6 env withheld denied"), "\{host}: \{r.out}");
  t.isTrue(holds(lines, "wacland: stage 6 env granted seen"), "\{host}: \{r.out}");

  // 0087's third criterion, and the one it calls the point: a child spawned, its bytes read back, and
  // its exit waited for *alongside* a ticket of a completely different kind. A readiness table that
  // only handles one sort of event fails here and nowhere else.
  t.isTrue(holds(lines, "wacland: stage 5 first 0"), "\{host} did not wait over both: \{r.out}");
  t.isTrue(holds(lines, "wacland: stage 5 heard wacland: I am the child"), "\{host}: \{r.out}");
  t.isTrue(holds(lines, "wacland: stage 5 status 7"), "\{host}: the child's own status");

  t.eqStr(lines[lines.len() - 1], "wacland: reached the end of what is implemented", host);
}

export string test_the_same_program_says_the_same_thing_on_a_js_host_and_one_that_is_not(Sys sys) {
  Output err = sys.stderr();
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = freshScratch(t, env, fs, "wacland");
  string denoProgram = "\{dir}/wacland-deno";
  // **With reading**, which stage 6 needs: it hands a child `GRANT_NONE` and then `GRANT_READ`, and a
  // parent that could not read either way would prove nothing about the ceiling.
  string why = buildOne(env, procs, ENTRY, false, denoProgram, ["--allow-read", "--allow-env"]);
  t.eqStr(why, "", "the Deno half built");
  if (why != "") { return t.report(); }
  Ran js = runIt(procs, denoProgram, ["one", "two"]);

  // The Deno half on its own, so a failure says which half broke.
  assertConformant(t, js, "deno");

  string native = nativeBinary(env, fs, t);
  if (native == "") { fs.remove(dir, true).wait(); return t.report(); }
  why = buildOne(env, procs, ENTRY, true, "\{dir}/wacland", ["--allow-read", "--allow-env"]);
  t.eqStr(why, "", "the native half built");
  if (why != "") { fs.remove(dir, true).wait(); return t.report(); }
  Ran rs = runIt(procs, native, ["\{dir}/wacland.wasm", "one", "two"]);
  assertConformant(t, rs, "native");

  // And the transcripts are the same, once the two measurements are masked.
  t.eqStr(masked(rs.out), masked(js.out), "the two hosts disagree");
  t.eqStr(rs.err, js.err, "the two hosts disagree about the error stream");
  // The canary for the masking itself: it must not have eaten the whole line.
  t.isTrue(contains(masked(rs.out), "stage 3 quick <nanos>"), masked(rs.out));
  t.isFalse(contains(masked(rs.out), "<nanos><nanos>"), "the mask is too greedy");
  fs.remove(dir, true).wait();
  return t.report();
}

string[] namesOf(JsonArray items) {
  string[] out = string[].filled(items.len(), "");
  for (i32 i = 0; i < items.len(); i++) {
    match (items.get(i)) {
      Object(members): {
        JsonValue? n = members.getStr("name");
        if (n is not null) {
          match (n!) {
            Str(bytes): { out[i] = string.fromBytes(bytes); }
            default: { }
          }
        }
      }
      default: { }
    }
  }
  return out;
}

JsonObject? structNamed(JsonArray structs, string want) {
  for (i32 i = 0; i < structs.len(); i++) {
    match (structs.get(i)) {
      Object(members): {
        JsonValue? n = members.getStr("name");
        if (n is not null) {
          match (n!) {
            Str(bytes): { if (string.fromBytes(bytes) == want) { return members; } }
            default: { }
          }
        }
      }
      default: { }
    }
  }
  return null;
}

JsonArray arrayIn(JsonObject o, string key) {
  JsonValue? v = o.getStr(key);
  if (v is null) { return JsonArray.create(); }
  match (v!) {
    Array(items): { return items; }
    default: { return JsonArray.create(); }
  }
}

string stringIn(JsonObject o, string key) {
  JsonValue? v = o.getStr(key);
  if (v is null) { return ""; }
  match (v!) {
    Str(bytes): { return string.fromBytes(bytes); }
    default: { return ""; }
  }
}

export string test_the_manifest_carries_the_field_order_rather_than_the_runtime_holding_a_copy(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  // The failure this guards is silent and expensive: insert a capability in the middle of `Core` in
  // `platform.wac`, and a runtime with its own idea of the order builds a `Core` whose `log` is the
  // previous field's function. Every call would go somewhere plausible.
  T t = T.create();
  string dir = freshScratch(t, env, fs, "order");
  string why = buildOne(env, procs, ENTRY, true, "\{dir}/order", string[].filled(0, ""));
  t.eqStr(why, "", "the manifest built");
  if (why != "") { return t.report(); }

  // Out of the module's `wac.manifest` section — it was a `.json` beside it until 2026-08-20.
  auto modRead = flatten(fs.readFile("\{dir}/order.wasm").wait());
  u8[]? mod = modRead.ok();
  t.isTrue((mod is not null), "the build wrote no module — \{modRead.isErr() ? "\{modRead.err()!}" : ""}");
  if ((mod is null)) { fs.remove(dir, true).wait(); return t.report(); }
  string text = customSection(mod!, "wac.manifest");
  t.isTrue(text.len() > 0, "the module carries no `wac.manifest` section");
  if (text.len() == 0) { fs.remove(dir, true).wait(); return t.report(); }
  fs.writeFile("\{dir}/order.manifest.json", text.toBytes()).wait();
  JsonObject m = jsonFile(fs, "\{dir}/order.manifest.json");
  JsonArray structs = arrayIn(m, "structs");
  JsonObject? core0 = structNamed(structs, "Core");
  t.isTrue(core0 is not null, "no Core in the manifest");
  if (core0 is null) { fs.remove(dir, true).wait(); return t.report(); }

  JsonArray fields = arrayIn(core0!, "fields");
  t.eqStrArray(namesOf(fields), [
    "nowMillis",
    "monotonicNanos",
    "sleepMillis",
    "randomBytes",
    "log",
    "warn",
    "waitAny",
    // Appended, not inserted, and that is the whole discipline this test enforces: a capability added
    // in the *middle* of `Core` shifts every field after it, and a runtime with its own idea of the
    // order would build a `Core` whose `log` is the previous field's function.
    "askInterrupt",
    // `Sys.exit`'s capability, appended for the same reason.
    "exit",
    // The scheduler, and the one field here a host does not *implement* — it builds it by calling the
    // module's own `Sched.create` and hands it back, which is how a program is given somewhere for
    // its continuations to wait without any host knowing what a continuation is.
    "sched"
  ], "Core's field order");

  // Every *funcref* field names a signature that is in the callback table — the lookup the runtime
  // does when it wires one. A field that is not a funcref is not wired at all: the runtime builds it
  // by calling the module's own `create` and hands it straight back, which is what `Core.sched` is.
  // Checked rather than skipped, because a field that is neither is a manifest nobody can build from.
  JsonArray callbacks = arrayIn(m, "callbacks");
  string[] callbackTypes = string[].filled(callbacks.len(), "");
  for (i32 i = 0; i < callbacks.len(); i++) {
    match (callbacks.get(i)) {
      Object(members): { callbackTypes[i] = stringIn(members, "type"); }
      default: { }
    }
  }
  for (i32 i = 0; i < fields.len(); i++) {
    match (fields.get(i)) {
      Object(f): {
        string name = stringIn(f, "name");
        string ty = stringIn(f, "type");
        if (ty.len() >= 3 && ty.slice(0, 3) == "fn[") {
          bool wired = false;
          for (i32 k = 0; k < callbackTypes.len(); k++) { if (callbackTypes[k] == ty) { wired = true; } }
          t.isTrue(wired, "Core.\{name} wants \{ty}, which is in no callback");
          continue;
        }
        JsonObject? spec = structNamed(structs, ty);
        bool makeable = false;
        if (spec is not null) {
          string[] methods = namesOf(arrayIn(spec!, "methods"));
          for (string method in methods) { if (method == "create") { makeable = true; } }
        }
        t.isTrue(makeable,
                 "Core.\{name} is \{ty}" +
                 ", which is neither a callback nor a struct the module can make");
      }
      default: { }
    }
  }
  fs.remove(dir, true).wait();
  return t.report();
}

/**
 * Running a host program agrees between the two hosts, which nothing had ever asked.
 *
 * `conformance_test.wac`'s ledger carried `EXEC` as a gap for a reason worth quoting: *"one host, and
 * the cost of that came due twice"* — the arithmetic is written three times, and both a deadlock and
 * a ticket that came back already answered were found by writing programs that needed the capability
 * rather than by comparing the implementations. The wasmtime host's copy had never run a host program
 * in any test at all.
 *
 * One module, built once, run by both binaries. The probe reports three verdicts on stderr and lets
 * its grandchild write to stdout, so what is compared is two streams that cannot interleave — and
 * every verdict is a thing the probe could only reach by running something, which is what keeps this
 * from being two hosts agreeing about having lost the capability.
 */
export string test_running_a_host_program_agrees_between_the_two_native_hosts(Sys sys) {
  Output err = sys.stderr();
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = freshScratch(t, env, fs, "exec");
  string out = "\{dir}/probe";
  string why = buildOne(env, procs, EXEC_PROBE, true, out, ["--allow-run"]);
  t.eqStr(why, "", "the probe built");
  if (why != "") { fs.remove(dir, true).wait(); return t.report(); }

  // The V8 host first, and asserted on its own, so a failure says which host broke.
  Ran v8 = runIt(procs, "\{root(env)}/native/v8/target/release/wac", ["\{out}.wasm"]);
  t.eqI32(v8.code, 0, "the probe exited zero on the V8 host: \{v8.out}\{v8.err}");
  t.isTrue(contains(v8.err, "inherit: ran=yes status=0 buffered=0/0"), v8.err);
  t.isTrue(contains(v8.err, "env: ran=yes handed=yes kept-others=yes"), v8.err);
  t.isTrue(contains(v8.err, "cleared: ran=yes only-what-was-passed=yes"), v8.err);
  t.isTrue(contains(v8.out, "from the grandchild"), "the inherited stream: \{v8.out}");

  string native = nativeBinary(env, fs, t);
  if (native == "") { fs.remove(dir, true).wait(); return t.report(); }
  Ran rs = runIt(procs, native, ["\{out}.wasm"]);
  t.eqI32(rs.code, 0, "and on the wasmtime host: \{rs.out}\{rs.err}");
  t.eqStr(rs.err, v8.err, "the two hosts disagree about `execWith`");
  t.eqStr(rs.out, v8.out, "the two hosts disagree about the inherited stream");
  fs.remove(dir, true).wait();
  return t.report();
}
