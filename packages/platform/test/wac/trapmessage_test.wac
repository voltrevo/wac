// What a program says when it traps.
//
//     export i32 main() { trap "the ring is full"; }
//     $ wac run p.wac
//     wac: p.wac trapped: the ring is full
//
// It used to be `Uncaught RuntimeError: unreachable` and nothing else. `trap "…"` is the language's
// way to say why — `spec/spec` has it, the checker checks the message's *type* — and wacc's emitter
// matched the statement without binding its payload, so a program could be refused for writing
// `trap 7` and then have a correct message thrown away. `issues/lang/0147`.
//
// ## Host-side until 2026-08-18, and the fourth case until 2026-08-20 — `issues/system/0161`
//
// Three of the four cases moved first. They drive `wac run` and read what it said, which needs no host.
//
// **The fourth is here now, and the note that kept it away is worth keeping too**, because it is right
// about everything except what follows from it. The message takes a different route through a built
// *application*: a wac `string` is a GC array and opaque to JavaScript, so it comes back through the
// module's staging buffer, which means the **glue** carries it rather than the host. `bindgen` emits a
// `$trapped` guard around each exported wrapper and `host/entry.ts` prints `wac trap: …`. Running the
// same module with `wac p.wasm` takes the interpreter's own path and says `wac: p.wac trapped: …` — a
// different sentence produced by different code, and "asserting one against the other would be a
// translation that changed the subject" was the reason given for leaving it in TypeScript.
//
// That reason is against *replacing* the case, and nobody was proposing to. The subject is the glue and
// the launcher and both stay TypeScript; what moved is the driving, which is `builtByDeno` and an
// `exec` — the same two calls `spawn_test.wac`, `arrival_test.wac` and three others already make. The
// last case asserts the same string against the same artefact as before.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli, Exec, Change } from "std/platform.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { builtByDeno, copyBuilt } from "../../../wactest/src/built.wac";
import { contains } from "../../../wactest/src/strings.wac";

/** Write `program` to `.cache` and run it through `wac run`, both streams together. */
struct Said {
  string text;
  i32 status;
  bool ran;
}

Said run(Cli cli, string name, string program) {
  string dir = cli.cwd().wait() + "/.cache/trapmsg";
  cli.mkdir(dir, true).wait();
  string path = dir + "/" + name + ".wac";
  Change wrote = cli.writeFile(path, program.toBytes()).wait();
  if (wrote.fault != 0) { return Said("could not write " + path, -1, false); }
  string wac = cli.cwd().wait() + "/native/v8/target/release/wac";
  Exec r = cli.exec(wac, string[]("run", path), u8[0]()).wait();
  if (!r.ran()) { return Said("the wac binary did not run — " + r.error, -1, false); }
  cli.remove(path, false).wait();
  return Said(string.fromBytes(r.stdout) + string.fromBytes(r.stderr), r.status, true);
}

export string test_a_trap_with_a_message_says_it(Core core, Cli cli) {
  T t = T.create();
  Said s = run(cli, "literal", "export i32 main() { trap \"the ring is full\"; }\n");
  t.isTrue(s.ran, s.text);
  if (!s.ran) { return t.report(); }
  t.eqI32(s.status, 1, s.text);
  t.isTrue(s.text.indexOf("trapped: the ring is full") >= 0, s.text);
  return t.report();
}

export string test_a_message_the_program_computed_not_only_a_literal(Core core, Cli cli) {
  T t = T.create();
  Said s = run(cli, "computed",
               "export i32 main() { string why = \"ring \" + \"full\"; " +
               "if (1 > 0) { trap why; } return 0; }\n");
  t.isTrue(s.ran, s.text);
  if (!s.ran) { return t.report(); }
  t.isTrue(s.text.indexOf("trapped: ring full") >= 0, s.text);
  return t.report();
}

export string test_a_bare_trap_claims_no_message(Core core, Cli cli) {
  T t = T.create();
  Said s = run(cli, "bare", "export i32 main() { trap; }\n");
  t.isTrue(s.ran, s.text);
  if (!s.ran) { return t.report(); }
  t.eqI32(s.status, 1, s.text);
  t.isTrue(s.text.indexOf("trapped") >= 0, s.text);
  // The colon is the whole assertion: a trap with nothing to say must not invent a message, and
  // "trapped" alone is what that looks like.
  t.isTrue(s.text.indexOf("trapped:") < 0, s.text);
  return t.report();
}

/**
 * **And through the JavaScript host**, where the message takes the staging-buffer route.
 *
 * A program *with capabilities* is the case that matters and the case that works: its exports cross
 * strings, so its glue has a staging buffer to bring one back through. One that crosses none —
 * `export i32 main() { trap "…"; }` — has no buffer and still shows `unreachable` there, which is in
 * `issues/lang/0147` rather than pretended away. So this program takes `Core` and `Cli` and says
 * something first, and both halves are asserted: the line it printed before the trap, and the trap.
 */
export string test_a_built_app_reports_the_message_the_program_gave(Core core, Cli cli) {
  T t = T.create();
  // Under `.cache` — in the tree, because the program imports `packages/platform` by a relative path,
  // but not at the root where every walker over this repository's files sees it appear and vanish. See
  // the note in `tools/wac/roottemp_test.wac` for what that cost.
  string dir = cli.cwd().wait() + "/.cache/trapmsg-app";
  cli.remove(dir, true).wait();
  cli.mkdir(dir, true).wait();
  Change wrote = cli.writeFile(dir + "/p.wac",
    ("import { Cli, Core } from \"std/platform.wac\";\n\n" +
     "export i32 main(Core core, Cli cli) {\n" +
     "  core.log(\"about to fail\");\n  trap \"the ring is full\";\n}\n").toBytes()).wait();
  t.isTrue(wrote.ok(), "could not write the program — " + wrote.message);
  if (!wrote.ok()) { return t.report(); }

  string made = builtByDeno(cli, dir + "/p.wac", "trapmsg-app", string[0](fill: ""), "deno", false);
  t.isTrue(made != "", "the app built");
  if (made == "") { cli.remove(dir, true).wait(); return t.report(); }
  string app = dir + "/p";
  t.isTrue(copyBuilt(cli, made, app, true), "the build copied to " + app);

  Exec r = cli.exec(app, string[0](fill: ""), u8[0]()).wait();
  string said = string.fromBytes(r.stdout) + string.fromBytes(r.stderr);
  t.isTrue(r.ran(), "the app did not run — " + r.error);
  t.isTrue(contains(said, "about to fail"), said);
  // `wac trap: …` rather than `wac: p.wac trapped: …` — the launcher's sentence, not the interpreter's,
  // which is the whole reason this case exists beside the three above.
  t.isTrue(contains(said, "wac trap: the ring is full"), said);

  cli.remove(dir, true).wait();
  return t.report();
}
