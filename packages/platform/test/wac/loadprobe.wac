// Load a module and call one export of each shape, reporting what each answered.
//
// The subject of `load_test.wac`, which builds this for Deno and for Node and compares the two
// outputs against each other and against a fixed expectation. A separate program because the
// capability lives in the *host* a program is built for — the native binary answers -2, and the only
// way to exercise the other two from a wac test is to build one and run it. `issues/system/0240c`.
//
// One line per call, in a fixed order, so a diff says which shape moved.

import { Authority, CallResult, Module, Sys, Files, Modules, Output, Unsupported } from "std";
import { flatten } from "core";

/** Every shape in the closed set, plus the two refusals — in the order the report prints them. */
string[] shapes() {
  return [
                  "test_passes", "test_fails", "test_traps_on_purpose", "test_core_only",
                  "test_no_world", "answer", "twice", "nothing", "no_such_export", "half"
  ];
}

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Files fs = sys.files();
  Modules mods = sys.modules();
  if (argv.len() < 1) {
    err.line("usage: loadprobe <module.wasm>");
    return 2;
  }
  string path = argv[0];
  auto fRead = flatten(fs.readFile(path).wait());
  u8[]? f = fRead.ok();
  if ((f is null)) {
    err.line("loadprobe: cannot read \{path} — \{fRead.isErr() ? "\{fRead.err()!}" : ""}");
    return 1;
  }

  // Holding the files and nothing else: no row of the expectation needs more, and a module is handed
  // what it uses.
  Module m;
  match (mods.load(f!, Authority(fs, null, null, null))) {
    Ok(loaded): { m = loaded; }
    Err(e): {
      // Printed rather than failed: this is the answer on a host that cannot load, and a caller
      // reading it is the whole reason `Unsupported` is distinct from a module that would not load.
      if (e is Unsupported) {
        out.line("unavailable");
        return 0;
      }
      err.line("loadprobe: \{e}");
      return 1;
    }
  }

  string[] names = shapes();
  for (i32 i = 0; i < names.len(); i++) {
    // `21` for every call, so `twice` answering 42 is the argument having arrived rather than a
    // constant that happens to match.
    CallResult c = m.call(names[i], 21).unwrap();
    out.line("\{names[i]} \{c.status} \{c.value} \{c.text}");
  }
  m.unload();

  // **After a trap, and after an unload.** Calling into a module that has been let go is a caller's
  // mistake rather than a crash, and the handle is gone rather than stale — 2, as for any name the
  // module does not have.
  CallResult after = m.call("answer", 0).unwrap();
  out.line("after-unload \{after.status}");
  return 0;
}
