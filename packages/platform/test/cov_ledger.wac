// platform's coverage.
//
//   deno task coverage:platform
//   deno task coverage:platform --verbose
//
// **29 of 75 — 38.7%**, and the shape of this package is why. `src/` holds two files: `frame.wac`
// (379 lines) and `stream.wac` (374). Everything else the package offers is a *declaration* — the
// `Core` and `Cli` capabilities the host implements — and a declaration has no branch points, so the
// package's surface is almost entirely not the sort of thing coverage measures.
//
// Of the two, `stream.wac` contributes nothing at all: its consumer is `packages/box`, which has no
// coverage task. And `frame.wac` — the capability frame a program hands a child — is measured only by
// what this package's own wac tests build.
//
// **The other half of this package's tests are TypeScript**: 6,522 lines of `.test.ts` against 8,913
// of wac. `issues/system/0161` is moving them, and until it does a driver that compiles wac sees one
// side. That is the same distinction as everywhere else in this sweep — see `issues/system/0241b`.
//
// ## What the number is actually about
//
// `childCli`, at seventeen uncovered points. A `Frame` narrows a `Cli`: which of the parent's
// authorities the child gets, and which paths it may reach. Every uncovered arm is a **refusal** — a
// path outside the frame, an authority the parent does not hold, a redirect that will not open.
//
// That is this package's whole subject. *No ambient capabilities* is the principle, the narrowing is
// how it is enforced, and the enforcement is the part with no inputs.

import { Core, Cli } from "std/platform.wac";

import { Pin, Rule, Measured, measure, report, ratchet } from "../../../tools/wac/covledger.wac";

const string EXERCISE = "packages/platform/test/cov_exercise.wac";
const string PREFIX = "packages/platform/";

/** What the tests need: a process to build and spawn children, sockets, and a temp dir. */
string[] grants() {
  return string[]("--allow-read", "--allow-write", "--allow-run", "--allow-env", "--allow-net");
}

Rule[] rules() {
  return Rule[](
    Rule("packages/platform/src/frame.wac", "childCli", "decl", false,
         "**`childCli` — the capability frame a program hands a child — at seventeen uncovered " +
         "points.** A `Frame` narrows a `Cli`: it decides which of the parent's authorities " +
         "the child gets and rewrites the paths it may reach. Every arm here is a *refusal*: a " +
         "path outside the frame, an authority the parent does not hold, a redirect that " +
         "cannot be opened. \n" +
         "That is the package's whole subject — *no ambient capabilities* — and the refusals " +
         "are the part with no inputs. `packages/box` is the consumer that drives them, and " +
         "`box` has no coverage task, so nothing measures the narrowing at all."),
    Rule("packages/platform/src/frame.wac", "childCore", "decl", false,
         "The `Core` half of the same narrowing — see `childCli`."),
    Rule("packages/platform/src/frame.wac", "joinPath", "decl", false,
         "Path joining for shapes the frame's callers do not construct — an absolute path, a " +
         "`..` that escapes, an empty component."),
    Rule("packages/platform/src/frame.wac", "take", "decl", false,
         "`take`'s remaining arms — see the rule over `frame.wac` for the corpus that shapes " +
         "them."),
    Rule("packages/platform/src/frame.wac", "chunkSize", "decl", false,
         "`chunkSize`'s remaining arms — see the rule over `frame.wac` for the corpus that " +
         "shapes them."),
    Rule("packages/platform/src/frame.wac", "write", "decl", false,
         "`write`'s remaining arms — see the rule over `frame.wac` for the corpus that shapes " +
         "them."),
    Rule("packages/platform/src/frame.wac", "redirectOutput", "decl", false,
         "`redirectOutput`'s remaining arms — see the rule over `frame.wac` for the corpus " +
         "that shapes them."),
    Rule("packages/platform/src/frame.wac", "warn", "decl", false,
         "`warn`'s remaining arms — see the rule over `frame.wac` for the corpus that shapes " +
         "them."),
    Rule("packages/platform/src/frame.wac", "readChunk", "decl", false,
         "`readChunk`'s remaining arms — see the rule over `frame.wac` for the corpus that " +
         "shapes them."),
    Rule("packages/platform/src/frame.wac", "readAll", "decl", false,
         "`readAll`'s remaining arms — see the rule over `frame.wac` for the corpus that " +
         "shapes them."),
    Rule("packages/platform/src/frame.wac", "streamPath", "decl", false,
         "`streamPath`'s remaining arms — see the rule over `frame.wac` for the corpus that " +
         "shapes them."),
    Rule("packages/platform/src/frame.wac", "captured", "decl", false,
         "`captured`'s remaining arms — see the rule over `frame.wac` for the corpus that " +
         "shapes them."),
    Rule("packages/platform/src/frame.wac", "Pending<T> rea", "decl", false,
         "`Pending<T> rea`'s remaining arms — see the rule over `frame.wac` for the corpus " +
         "that shapes them.")
  );
}

Pin[] pins() {
  return Pin[0](fill: Pin("", 0, "", true, ""));
}

export i32 main(Core core, Cli cli) {
  bool verbose = false;
  i32 argc = cli.argCount().wait();
  for (i32 i = 0; i < argc; i++) {
    if (string.fromBytes(cli.arg(i).wait()) == "--verbose") { verbose = true; }
  }

  Measured m = measure(core, cli, EXERCISE, grants(), string[0](fill: ""));
  if (m.nPoints == 0) { return 1; }

  report(core, m.points, m.nPoints, m.counts, PREFIX, verbose);
  return ratchet(core, cli, m.points, m.nPoints, m.counts, PREFIX, pins(), rules()) ? 1 : 0;
}
