// platform's coverage.
//
//   wac task coverage:platform
//   wac task coverage:platform --verbose
//
// **`src/` is one file now, `stream.wac`**, and everything else the package offers is a *declaration* —
// the capabilities the host implements — which has no branch points, so the package's surface is almost
// entirely not the sort of thing coverage measures. `frame.wac`, the capability frame a program handed a
// child, was the other file and the one this ledger was about; it went in design/system/0013 step 5,
// when std's `Files`, `Authority` and served files replaced it, and the narrowing it measured is std's
// now.
//
// **The other half of this package's tests are TypeScript**: `issues/system/0161` is moving them, and
// until it does a driver that compiles wac sees one side. That is the same distinction as everywhere
// else in this sweep — see `issues/system/0241b`.

import { Sys, Env, Files, Modules, Output, Procs } from "std";

import { Pin, Rule, Measured, measure, report, ratchet, LedgerFlags, reportPoints } from "../../../tools/wac/covledger.wac";

static string EXERCISE = "packages/platform/test/cov_exercise.wac";
static string PREFIX = "packages/platform/";

/** What the tests need: a process to build and spawn children, sockets, and a temp dir. */
string[] grants() {
  return ["--allow-read", "--allow-write", "--allow-run", "--allow-env", "--allow-net"];
}

Rule[] rules() {
  return Rule[].filled(0, Rule("", "", "", false, ""));
}

Pin[] pins() {
  return Pin[].filled(0, Pin("", 0, "", true, ""));
}

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  Modules mods = sys.modules();
  LedgerFlags flags = LedgerFlags.read(argv);

  Measured m = measure(err, env, fs, procs, EXERCISE, grants(), string[].filled(0, ""));
  if (m.nPoints == 0) { return 1; }

  // `--points` dumps the per-point table instead of the report, unfiltered, so a caller can
  // union this driver's reach with another's — `issues/system/0241b`.
  if (flags.points) { reportPoints(out, m.points, m.nPoints, m.counts); return 0; }
  report(out, m.points, m.nPoints, m.counts, PREFIX, flags.verbose);
  return ratchet(err, out, fs, procs, m.points, m.nPoints, m.counts, PREFIX, pins(), rules()) ? 1 : 0;
}
