// `ts` as a command: read TypeScript, write JavaScript.
//
//     wac run --allow-read packages/ts/src/main.wac path/to/file.ts
//     wac run --allow-read --allow-write packages/ts/src/main.wac in.ts -o out.js
//
// The transform itself is `strip.wac`; this is argv and I/O. It exists so the differential in
// `packages/ts/test/stripDifferential.test.ts` can run the wac transform against TypeScript's own
// and compare — which is `design/system/0009` D5, the check that makes D4's strictness trustworthy.
//
// **Not what the ladder calls.** In the bootstrap there is no `Cli` and no argv: the host reads the
// file and feeds the bytes in, exactly as `bootstrap/drivers/` already does. This is the same
// `strip` behind a command line, for the machines that have one.

import { Sys, Files, Output } from "std";
import { Stripped, strip } from "./strip.wac";
import { Bundled, Import, bundle, importsIn, resolve } from "./bundle.wac";
import { Vec, flatten } from "core";

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Files fs = sys.files();
  i32 argc = argv.len();
  if (argc < 1) {
    err.line("usage: ts [--bundle] <file.ts> [-o <out.js>]");
    err.line("       strips TypeScript's types, leaving JavaScript in the same bytes");
    return 2;
  }

  string input = "";
  string target = "";
  bool doBundle = false;
  for (i32 i = 0; i < argc; i++) {
    string a = argv[i];
    if (a == "--bundle") { doBundle = true; continue; }
    if (a == "-o") {
      if (i + 1 >= argc) { err.line("ts: -o wants a path to write"); return 2; }
      target = argv[i + 1];
      i = i + 1;
      continue;
    }
    if (input == "") { input = a; continue; }
    err.line("ts: unexpected argument '\{a}'");
    return 2;
  }
  if (input == "") { err.line("ts: no input file"); return 2; }

  if (doBundle) { return bundleFrom(err, out, fs, input, target); }

  auto fRead = flatten(fs.readFile(input).wait());
  u8[]? f = fRead.ok();
  if ((f is null)) {
    err.line("ts: cannot read \{input} — \{fRead.isErr() ? "\{fRead.err()!}" : ""}");
    return 1;
  }

  Stripped s = strip(f!);
  if (s.error != "") {
    // The position is the source's, which is the whole point of erasing to spaces: a line and
    // column here name the TypeScript the reader has open.
    err.line("ts: \{input}:\{s.line}:\{s.col}: \{s.error}");
    return 1;
  }

  if (target == "") {
    out.write(s.out);
    return 0;
  }
  auto wrote = flatten(fs.writeFile(target, s.out).wait());
  if (wrote.isErr()) {
    err.line("ts: cannot write \{target} — \{wrote.isErr() ? "\{wrote.err()!}" : ""}");
    return 1;
  }
  return 0;
}

/**
 * Walk the import graph from `entry`, strip every file, and flatten the result.
 *
 * The reading is here rather than in `bundle.wac` on purpose: in the ladder there is no `Cli`, and
 * the host hands the file set in. This is the same `bundle` behind a command line.
 */
i32 bundleFrom(Output err, Output out, Files fs, string entry, string target) {
  Vec<string> paths = Vec.create();
  Vec<u8[]> texts = Vec.create();
  Vec<string> queue = Vec.create();
  queue.push(entry);
  while (queue.len() > 0) {
    string p = queue.get(queue.len() - 1);
    queue.remove(queue.len() - 1);
    bool have = false;
    for (string path in paths) { if (path == p) { have = true; } }
    if (have) { continue; }
    auto fRead = flatten(fs.readFile(p).wait());
    u8[]? f = fRead.ok();
    if ((f is null)) {
      err.line("ts: cannot read \{p} — \{fRead.isErr() ? "\{fRead.err()!}" : ""}");
      return 1;
    }
    Stripped s = strip(f!);
    if (s.error != "") {
      err.line("ts: \{p}:\{s.line}:\{s.col}: \{s.error}");
      return 1;
    }
    paths.push(p);
    texts.push(s.out);
    Import[] imports = importsIn(s.out);
    for (i32 i = 0; i < imports.len(); i++) { queue.push(resolve(p, imports[i].spec)); }
  }

  string[] ps = string[].filled(paths.len(), "");
  u8[][] ts = u8[][].filled(texts.len(), u8[]());
  for (i32 i = 0; i < paths.len(); i++) { ps[i] = paths.get(i); ts[i] = texts.get(i); }

  Bundled b = bundle(ps, ts, entry);
  if (b.error != "") {
    err.line("ts: \{b.error}");
    return 1;
  }
  if (target == "") {
    out.write(b.out);
    return 0;
  }
  auto wrote = flatten(fs.writeFile(target, b.out).wait());
  if (wrote.isErr()) {
    err.line("ts: cannot write \{target} — \{wrote.isErr() ? "\{wrote.err()!}" : ""}");
    return 1;
  }
  return 0;
}
