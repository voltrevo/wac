// Flattening the bridge's module graph into one file.
//
//     wac test --allow-read packages/ts/test/wac/bundle_test.wac
//
// `design/system/0009` step 4. The measurement that matters is whether the graph *can* be
// flattened without renaming — the bundler refuses a top-level name collision rather than merging
// two bindings silently, so a failure here is a worklist and not a wrong answer.

import { T } from "../../../wactest/src/assert.wac";
import { Cli, Core, FileResult } from "std/platform.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { Bundled, bundle } from "../../src/bundle.wac";
import { Stripped, strip } from "../../src/strip.wac";

string[] bridge() {
  return string[](
    "packages/platform/host/deno.ts", "packages/platform/host/provider.ts",
    "packages/platform/host/children.ts", "packages/platform/host/call.ts",
    "packages/platform/host/marshal.ts", "packages/platform/host/faults.ts",
    "packages/platform/host/respond.ts", "packages/platform/host/layout.ts",
    "packages/platform/host/entry.ts", "packages/platform/host/queue.ts",
    "packages/platform/host/child.ts", "packages/platform/host/schedule.ts",
    "packages/platform/host/driver.ts", "packages/platform/host/childLife.ts",
    "packages/platform/host/ops.ts", "packages/platform/host/entropy.ts",
    "packages/platform/host/childWasm.ts"
  );
}

export string test_the_bridge_flattens(Core core, Cli cli) {
  T t = T.create();
  string[] paths = bridge();
  u8[][] texts = u8[][paths.len()](fill: u8[0]());
  for (i32 i = 0; i < paths.len(); i++) {
    FileResult f = cli.readFile(paths[i]).wait();
    if (!f.ok) { t.isTrue(false, "cannot read " + paths[i]); return t.report(); }
    Stripped s = strip(f.bytes);
    if (s.error != "") { t.isTrue(false, paths[i] + ": " + s.error); return t.report(); }
    texts[i] = s.out;
  }
  Bundled b = bundle(paths, texts, "packages/platform/host/deno.ts");

  t.eqStr(b.error, "", "the bridge flattens from deno.ts");
  if (b.error != "") { return t.report(); }
  core.log("   bundled " + itoa(b.out.len() / 1024) + " KB from " + itoa(paths.len()) + " files");
  t.isTrue(b.out.len() > 100000, "and it is the whole bridge, not a fragment");
  string out = string.fromBytes(b.out);
  // Nothing that names another module may survive: a leftover `import` is a runtime failure.
  t.isTrue(out.indexOf("\nimport ") < 0, "no `import` statement survives");
  // The four names that used to collide are all still spelled as their authors wrote them, which is
  // what the IIFE design buys — see `packages/ts/src/bundle.wac`.
  t.isTrue(out.indexOf("CHUNK$") < 0 && out.indexOf("EMPTY$") < 0, "and no source name was renamed");
  return t.report();
}

export string test_two_modules_that_both_declare_a_name() {
  T t = T.create();
  // The case that used to be refused. Each module is its own scope, so `EMPTY` in one is not the
  // `EMPTY` in the other, and neither source name is touched.
  string[] paths = string[]("a.ts", "b.ts");
  u8[][] texts = u8[][2](fill: u8[0]());
  texts[0] = "import { empties } from \"./b.ts\";\nconst EMPTY = \"a\";\nexport const keys = Object.keys(empties());\n".toBytes();
  texts[1] = "const EMPTY = 1;\nexport function empties() { return { EMPTY }; }\n".toBytes();
  Bundled b = bundle(paths, texts, "a.ts");
  t.eqStr(b.error, "", "it bundles rather than refusing");
  if (b.error != "") { return t.report(); }
  string out = string.fromBytes(b.out);
  // **The shorthand keeps its key.** `{ EMPTY }` inside b is b's own `EMPTY`, untouched; renaming
  // the token would have made the object `{ EMPTY$b: … }`, which is the whole reason for IIFEs.
  t.isTrue(out.indexOf("{ EMPTY }") >= 0, "b's shorthand is untouched — got:\n" + out);
  t.isTrue(out.indexOf("EMPTY$") < 0, "and no source name was renamed");
  return t.report();
}

export string test_an_imported_name_is_read_through_its_module() {
  T t = T.create();
  string[] paths = string[]("a.ts", "b.ts");
  u8[][] texts = u8[][2](fill: u8[0]());
  texts[0] = "import { base as b } from \"./b.ts\";\nexport const go = () => b() + 1;\n".toBytes();
  texts[1] = "export function base() { return 1; }\n".toBytes();
  Bundled r = bundle(paths, texts, "a.ts");
  t.eqStr(r.error, "", "it bundles");
  if (r.error != "") { return t.report(); }
  string out = string.fromBytes(r.out);
  t.isTrue(out.indexOf(".base()") >= 0, "the renamed import reads through its module — got:\n" + out);
  t.isTrue(out.indexOf("import") < 0, "and the import statement is gone");
  return t.report();
}

export string test_a_cycle_is_allowed_when_nothing_static_crosses_it() {
  T t = T.create();
  // Mutually recursive modules, each using the other only inside a function.
  string[] paths = string[]("a.ts", "b.ts");
  u8[][] texts = u8[][2](fill: u8[0]());
  texts[0] = "import { fromB } from \"./b.ts\";\nexport function fromA() { return \"A\"; }\nexport const go = () => fromB();\n".toBytes();
  texts[1] = "import { fromA } from \"./a.ts\";\nexport function fromB() { return fromA() + \"B\"; }\n".toBytes();
  Bundled r = bundle(paths, texts, "a.ts");
  t.eqStr(r.error, "", "a cycle used only inside functions is fine");
  return t.report();
}

export string test_a_static_use_across_a_cycle_is_named() {
  T t = T.create();
  // The same cycle, but one module *evaluates* the other's export while initialising.
  string[] paths = string[]("a.ts", "b.ts");
  u8[][] texts = u8[][2](fill: u8[0]());
  texts[0] = "import { fromB } from \"./b.ts\";\nexport function fromA() { return \"A\"; }\nexport const eager = fromB();\n".toBytes();
  texts[1] = "import { fromA } from \"./a.ts\";\nexport function fromB() { return fromA() + \"B\"; }\n".toBytes();
  Bundled r = bundle(paths, texts, "a.ts");
  t.isTrue(r.error != "", "it refuses");
  t.isTrue(r.error.indexOf("fromB") >= 0, "names the symbol");
  t.isTrue(r.error.indexOf("a.ts") >= 0 && r.error.indexOf("b.ts") >= 0, "and both modules");
  t.isTrue(r.error.indexOf("inside a function") >= 0, "and says what to do about it");
  return t.report();
}

export string test_dependencies_come_first() {
  T t = T.create();
  string[] paths = string[]("a.ts", "b.ts");
  u8[][] texts = u8[][2](fill: u8[0]());
  texts[0] = "import { base } from \"./b.ts\";\nconst top = base + 1;\n".toBytes();
  texts[1] = "export const base = 1;\n".toBytes();
  Bundled b = bundle(paths, texts, "a.ts");
  t.eqStr(b.error, "", "it bundles");
  if (b.error != "") { return t.report(); }
  string out = string.fromBytes(b.out);
  t.isTrue(out.indexOf("base = 1") < out.indexOf("top ="), "the dependency is emitted first");
  t.isTrue(out.indexOf("import") < 0, "and the import is gone");
  return t.report();
}

export string test_a_namespace_import_binds_the_module_itself() {
  T t = T.create();
  // **The easiest form under this design, and the hardest one for a bundler that renames.** An
  // IIFE's return value already *is* the namespace object, so there is nothing to construct.
  string[] paths = string[]("a.ts", "b.ts");
  u8[][] texts = u8[][2](fill: u8[0]());
  texts[0] = "import * as lib from \"./b.ts\";\nexport const go = () => lib.base();\n".toBytes();
  texts[1] = "export function base() { return 1; }\n".toBytes();
  Bundled r = bundle(paths, texts, "a.ts");
  t.eqStr(r.error, "", "it bundles");
  if (r.error != "") { return t.report(); }
  string out = string.fromBytes(r.out);
  t.isTrue(out.indexOf("const lib = $m") >= 0, "the namespace binds the module — got:\n" + out);
  t.isTrue(out.indexOf("lib.base()") >= 0, "and uses of it are untouched");
  return t.report();
}

export string test_an_external_import_is_hoisted_not_bundled() {
  T t = T.create();
  // `node:worker_threads` is the runtime's to resolve, not the file set's — and an ESM `import`
  // must be top-level, so it cannot stay inside the IIFE it was written in.
  string[] paths = string[]("a.ts", "b.ts");
  u8[][] texts = u8[][2](fill: u8[0]());
  texts[0] = "import * as wt from \"node:worker_threads\";\nimport { base } from \"./b.ts\";\nexport const go = () => wt.isMainThread && base();\n".toBytes();
  texts[1] = "export function base() { return 1; }\n".toBytes();
  Bundled r = bundle(paths, texts, "a.ts");
  t.eqStr(r.error, "", "it bundles");
  if (r.error != "") { return t.report(); }
  string out = string.fromBytes(r.out);
  i32 imp = out.indexOf("import * as wt from \"node:worker_threads\";");
  t.isTrue(imp >= 0, "the external import survives — got:\n" + out);
  t.isTrue(imp < out.indexOf("const $m"), "and is hoisted above every module");
  return t.report();
}

export string test_a_relative_import_not_in_the_set_is_refused() {
  T t = T.create();
  // **Silence here was a wrong answer, not a missing feature.** An unresolved relative specifier
  // indexed `ns[-1]` for a named import and emitted nothing at all for a namespace one, so the
  // module vanished and the bundle came out *valid* — JavaScript with a free variable where the
  // import had been. It stayed hidden because nothing downstream can tell that apart from code that
  // was always meant to reference a global.
  //
  // It hid a stripper bug for an afternoon: erasing `as lib from "./m.js"` deleted the specifier, so
  // the import walk never queued the file, and this said nothing about the module that was missing.
  string[] paths = string[]("a.ts");
  u8[][] texts = u8[][1](fill: u8[0]());
  texts[0] = "import * as lib from \"./gone.ts\";\nexport const go = () => lib.base();\n".toBytes();
  Bundled r = bundle(paths, texts, "a.ts");
  t.isTrue(r.error != "", "an import of a file that was not supplied is refused");
  t.isTrue(r.error.indexOf("gone.ts") >= 0, "and the message names it — got: " + r.error);

  // The named form takes the same route, and used to be the worse of the two: `ns[-1]` is a trap
  // rather than a wrong answer, so this one failed loudly *somewhere* — just not here.
  u8[][] named = u8[][1](fill: u8[0]());
  named[0] = "import { base } from \"./gone.ts\";\nexport const go = () => base();\n".toBytes();
  Bundled r2 = bundle(paths, named, "a.ts");
  t.isTrue(r2.error != "", "and so is a named import of it");
  return t.report();
}
