// `bootstrap.sh --host deno|nodejs` builds a `wac` that works, on a machine with only that runtime.
//
//     wac test --allow-read --allow-write --allow-run --allow-env packages/ts/test/wac/bootstrap_test.wac
//
// `design/system/0009` step 5. The claim is the whole reason `packages/ts` exists: **a compiler can
// be built from source with no compiler, no cargo, no npm and no network** — five rungs of
// hand-written wasm text build wacc, wacc builds the command and its binding layer, and a bundler
// written in wac turns the TypeScript bridge into the JavaScript that runs it.
//
// ## Why this runs the thing rather than checking its parts
//
// The parts are already checked and were all green while the whole was broken.
// `packages/ts/test/stripDifferential.test.ts` says the bridge bundles and Deno parses it;
// `bundle_test.wac` says modules flatten correctly. Both passed for a bundle whose last line was
// `await` inside a non-async arrow function — *Unexpected reserved word*, three megabytes in.
//
// And a fixed point is not a smoke test. `bootstrap.sh` iterates until two rounds agree, which is a
// claim about **stability**: `f(x) = x` holds for a broken `f` as readily as a working one, and
// `issues/system/0273b` is the day that mattered. So this compiles and runs a program, which is the
// only question a user asks.
//
// ## What it costs, and why it is not smaller
//
// About 45 seconds per host, nearly all of it the ladder. Nothing cheaper covers the claim: the
// expensive steps *are* the claim. A version that reused an artefact built earlier would be testing
// whatever happened to be lying around, which is the failure `issues/system/0160` cost two days.
//
// **Both hosts, because they are different builds and not one build run twice.** Node's launcher is
// `runLauncherNode`, its worker reaches its parent through `worker_threads.parentPort` rather than
// `self`, its network is `host/nodeNet.js`, and its shebang states nothing because Node has no
// permission system. A green Deno run says nothing about any of that.
//
// test-lane: heavy — 90s measured 2026-08-29, two hosts: five ladder rungs, two wacc builds per host,
// three bundles and a compile. 82s of CPU across both, and the ladder is nearly all of it.

import { T } from "../../../wactest/src/assert.wac";
import { Exec, ChildEnv, Env, Files, Launch, Output, Procs, Sys } from "std";
import { contains, trimmed } from "../../../wactest/src/strings.wac";
import { binaryPath, freshDir, scratch } from "../../../wactest/src/host.wac";
import { flatten } from "core";

/**
 * A program whose *transcript* differs between hosts if a file stream is mishandled.
 *
 * It writes a file through `openWrite` and reads it back, under `wac app`, where the program is a child of
 * `app-run` — the shape `issues/system/0277c` broke, when the stream was the redirect `openOutput` made and a
 * spawned child's bytes went to standard output instead. Two hosts that disagree about the file disagree about
 * this transcript, which is the whole mechanism.
 *
 * It reports what it read back rather than asserting anything itself: a probe that judges is a probe
 * that can be wrong twice.
 */
static string PROBE =
  "import { Files, Output, Sys } from \"std\";\n" +
  "import { flatten } from \"core\";\n" +
  "export i32 main(Sys sys) {\n  Files fs = sys.files();\n  Output out = sys.stdout();\n" +
  "  auto opened = flatten(fs.openWrite(\"probe.out\").wait());\n" +
  "  if (opened.isOk()) {\n" +
  "    opened.unwrap().write(\"streamed\\n\".toBytes()).wait();\n" +
  "    opened.unwrap().close().wait();\n" +
  "  }\n" +
  "  auto fRead = flatten(fs.readFile(\"probe.out\").wait());\n" +
  "  out.line(fRead.isOk() ? \"file holds: \" + string.fromBytes(fRead.unwrap()) : \"file: MISSING\");\n" +
  "  return 0;\n" +
  "}\n";

/** A program that only prints, so what is being tested is the command and not a graph. */
static string PROGRAM =
  "import { Output, Sys } from \"std\";\n" +
  "export i32 main(Sys sys) { Output out = sys.stdout(); out.line(\"it compiled and it ran\"); return 0; }\n";

Exec sh(Procs procs, string script) {
  return flatten(procs.exec("/bin/sh", ["-c", script], u8[](), ChildEnv.inherited(), Launch.plain()).wait()).unwrap();
}

/**
 * One host, end to end: build the command, then use it.
 *
 * `runtime` is what has to be on the machine — whose absence makes this a skip rather than a failure
 * — and `host` is what `--host` is given. They differ for Node, where the flag is `nodejs` and the
 * binary is `node`, and that difference is carried rather than derived: getting it wrong would skip
 * silently and read as a pass.
 */
string oneHost(Output out, Env env, Files fs, Procs procs, T t, string host, string runtime) {
  string dir = scratch(env, "bootstrap-\{host}");
  string why = freshDir(fs, dir);
  t.isTrue(why == "", why);
  if (why != "") { return ""; }

  // **Skipped rather than failed where the runtime is absent**, which is the honest answer: this
  // tests what `--host <x>` does, and a machine without `<x>` is not one where that is broken. The
  // native hosts are what such a machine builds, and they have their own tests.
  Exec have = sh(procs, "command -v \{runtime} >/dev/null 2>&1 && echo yes || echo no");
  if (trimmed(string.fromBytes(have.stdout)) != "yes") {
    out.line("   no \{runtime} on this machine — skipping --host \{host}");
    return "";
  }

  // **From a copy of the tracked files, not from this working tree**, because CI builds from a fresh
  // checkout and every working tree is full of leftovers: `.cache/`, two `target/` directories, a
  // seed. Each of the Pages deploy's breaks has been a script that was right here and wrong there.
  string tree = "\{dir}/tree";
  Exec copied = sh(procs, "mkdir -p '\{tree}' && git ls-files -z | tar --null -T - -cf - | tar -xf - -C '\{tree}'");
  t.eqI32(copied.status, 0, "could not copy the tree: \{string.fromBytes(copied.stdout)}");
  if (copied.status != 0) { return ""; }

  // **Decoys where an earlier build would have left a `wac`.** The script starts from the host and
  // nothing else, so a command from before must never be run — the embedding check once asked one,
  // and a wasmtime binary with no v8 binary beside it made every bootstrap refuse a clean tree. Each
  // decoy leaves a mark, so this sees the call even if the script ignores what the decoy answered.
  string mark = "\{dir}/a-leftover-ran";
  string decoy = "#!/bin/sh\necho \"$0\" >> '\{mark}'\nexit 1\n";
  for (string p in ["native/target/release/wac", "native/v8/target/release/wac"]) {
    fs.mkdir("\{tree}/\{p.slice(0, p.len() - 4)}", true).wait();
    auto wrote = flatten(fs.writeFile("\{tree}/\{p}", decoy.toBytes()).wait());
    Exec made = sh(procs, "chmod +x '\{tree}/\{p}'");
    t.isTrue(wrote.isOk() && made.status == 0, "could not plant \{p} — \{wrote.isErr() ? "\{wrote.err()!}" : "chmod failed"}");
  }

  // **Into a directory that does not exist yet**, because that is what CI hands it: `syncDemos.ts`
  // asks for `.cache/wac-deno`, `.cache/` is gitignored, and a fresh checkout has none. Every working
  // tree has one, so a `-o` into an existing directory passed here while the Pages deploy failed on
  // `cp: cannot create regular file` after a complete, correct bootstrap.
  string bin = "\{dir}/not-made-yet/wac";
  Exec built = sh(procs, "cd '\{tree}' && bash bootstrap.sh --host \{host} -o '\{bin}' 2>&1");
  u8[]? ran = flatten(fs.readFile(mark).wait()).ok();
  t.isTrue(ran is null, "\{host}: bootstrap.sh ran a command left over from an earlier build:\n"
                        + (ran is not null ? string.fromBytes(ran!) : ""));
  t.eqI32(built.status, 0,
          "bootstrap.sh --host \{host} failed:\n\{string.fromBytes(built.stdout)}");
  if (built.status != 0) { return ""; }

  // It reached a fixed point rather than merely finishing — the script refuses to write a command
  // that never settles, so this checks the script said so rather than trusting the exit code.
  t.isTrue(contains(string.fromBytes(built.stdout), "fixed point"),
           "\{host}: no fixed point reported:\n\{string.fromBytes(built.stdout)}");

  auto wrote = flatten(fs.writeFile("\{dir}/hello.wac", PROGRAM.toBytes()).wait());
  t.isTrue(wrote.isOk(), "could not write the program — \{wrote.isErr() ? "\{wrote.err()!}" : ""}");
  if (wrote.isErr()) { return ""; }

  // **The question a user asks.** Everything above is machinery; this is whether the artefact is a
  // compiler. `--allow-read` because the program is on disk and the command has no ambient authority.
  Exec ran = sh(procs, "'\{bin}' run --allow-read '\{dir}/hello.wac' 2>&1");
  t.eqI32(ran.status, 0, "\{host}: the built command could not run a program: "
                       + string.fromBytes(ran.stdout));
  t.eqStr(trimmed(string.fromBytes(ran.stdout)), "it compiled and it ran",
          "\{host} printed: \{string.fromBytes(ran.stdout)}");

  sameAnswerOnBothHosts(env, fs, procs, t, host, dir, bin);

  fs.remove(dir, true).wait();
  return "";
}

/**
 * One artefact, two hosts, one transcript — the comparison the tree could not make.
 *
 * **Every host comparison here builds twice.** `packages/platform/test/wac/runtimes_test.wac` and its
 * neighbours build the same program once per target and check the two agree, so a disagreement has
 * two possible causes: the host, and everything the two builders do differently. Holding the
 * *artefact* constant removes the second one.
 *
 * That is not a preference. Six host divergences were found on 2026-08-29 by doing exactly this by
 * hand — `0275c`, `0276c`, `0277c`, `0278c`, `0280c`, `0281c` — and the tests that existed compared
 * two builds and saw none of them. `0277c` is the sharpest: `box cp README.md out` copies through one
 * artefact and writes the file to standard output through the other.
 *
 * **It costs nothing here**, which is why it lives in this file rather than its own. The 45 seconds
 * is the JS-hosted `wac` above; running one more artefact under it is milliseconds.
 *
 * **The canary is not decoration.** Two hosts that had both lost the capability would agree
 * perfectly, and `runtimes_test.wac`'s own header records that happening — a case that "passed for a
 * while while checking the *write* denial and claiming to check the stat". So the transcript is also
 * checked for the line the probe is known to print.
 */
void sameAnswerOnBothHosts(Env env, Files fs, Procs procs, T t, string host, string dir, string jsWac) {
  auto wrote = flatten(fs.writeFile("\{dir}/probe.wac", PROBE.toBytes()).wait());
  t.isTrue(wrote.isOk(), "could not write the probe — \{wrote.isErr() ? "\{wrote.err()!}" : ""}");
  if (wrote.isErr()) { return; }

  // Built **once**, by the binary running this test, and run by both. That is the whole point.
  auto madeRan = flatten(procs.exec(binaryPath(env), [
                                "app", "\{dir}/probe.wac", "--allow-read", "--allow-write",
                                "-o", "\{dir}/probe"
                       ], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? made = madeRan.ok();
  t.eqI32(made!.status, 0, "wac app failed: \{string.fromBytes(made!.stderr)}");
  if (made!.status != 0) { return; }

  // `cd` into the directory so the probe's relative `probe.out` lands somewhere writable, and so both
  // runs stand in the same place — a difference in *where* they ran would read as a host difference.
  string native = "cd '\{dir}' && '\{binaryPath(env)}' app-run ./probe 2>&1";
  // **The JS command is named outright rather than found on PATH.** A `wac app` artefact resolves
  // its runtime with `command -v wac`, and putting the JS one there would decide *both* runs — the
  // point is to name the host each time and keep everything else the same.
  string js = "cd '\{dir}' && '\{jsWac}' app-run ./probe 2>&1";
  Exec a = sh(procs, native);
  Exec b = sh(procs, js);

  string sa = trimmed(string.fromBytes(a.stdout));
  string sb = trimmed(string.fromBytes(b.stdout));
  t.eqStr(sb, sa, "\{host}: the two hosts disagree about what the program did");
  t.eqI32(b.status, a.status, "\{host}: and about its status");
  // The canary. Both hosts losing the stream would agree on a missing file and pass the line above.
  t.isTrue(contains(sa, "file holds: streamed"),
           "neither host streamed the file — the comparison above is worth nothing: \{sa}");
}

export string test_bootstrap_host_deno_builds_a_working_wac(Sys sys) {
  Output out = sys.stdout();
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  oneHost(out, env, fs, procs, t, "deno", "deno");
  return t.report();
}

export string test_bootstrap_host_nodejs_builds_a_working_wac(Sys sys) {
  Output out = sys.stdout();
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  oneHost(out, env, fs, procs, t, "nodejs", "node");
  return t.report();
}
