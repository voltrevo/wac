// Branch coverage for server: the exercises, and nothing else.
//
//   deno task coverage:server
//   deno task coverage:server --verbose
//
// Drives `serve` directly with the same requests the tests use. The routes are most of the branch
// points and the error paths are the rest, so the corpus is the union of "every route" and "every way
// a route can be given something it cannot use".
//
// ## What this file is, after 2026-08-20 — `issues/system/0161`
//
// It was the package's `cov.ts`, which was these exercises plus a copy of the reporting.
// `tools/wac/covreport.wac` is the reporting now, shared, so what is left here is the part that is
// actually about server. It is a program rather than a caller: `covreport` builds *this* with
// `--coverage` and runs its `main`, so the exercises are inside the instrumented module.
//
// **It lives under `test/` on purpose.** `covreport` skips any file with `/test/` in its path, so a
// driver's own branches cannot appear in server's number.

import { handle } from "./probe.wac";

/** 2020-06-15T10:00:00Z, the clock the tests pin so `/time` has one answer. */
const i64 NOW = 1592215200000;

/** One request, with its answer's length folded into the accumulator so nothing is dropped. */
i32 one(string request) {
  return handle(request.toBytes(), NOW).len();
}

/**
 * Every route with each of its methods, then every way a route can be given something it cannot use.
 *
 * `\x7f` is written with `fromCodepoint` because it is a control byte, and a raw one in a source file
 * reads as whitespace to anything that looks at the file rather than at the string.
 */
string[] requests() {
  string DEL = string.fromCodepoint(0x7f);
  return string[](
    // every route, and each of its methods
    "GET / HTTP/1.1\r\nHost: a\r\n\r\n",
    "HEAD / HTTP/1.1\r\nHost: a\r\n\r\n",
    "DELETE / HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /time HTTP/1.1\r\nHost: a\r\n\r\n",
    "POST /time HTTP/1.1\r\nHost: a\r\nContent-Length: 0\r\n\r\n",
    "GET /echo HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /echo?a=1 HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /echo?a=1&b=2&c HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /echo?a=hello+world&b=%41%42 HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /echo?&&a=1&& HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /echo?%22q%22=a%00b HTTP/1.1\r\nHost: a\r\n\r\n",
    "POST /echo HTTP/1.1\r\nHost: a\r\nContent-Length: 0\r\n\r\n",
    "POST /json HTTP/1.1\r\nHost: a\r\nContent-Length: 7\r\n\r\n{\"a\":1}",
    "POST /json HTTP/1.1\r\nHost: a\r\nContent-Length: 4\r\n\r\n{bad",
    "POST /json HTTP/1.1\r\nHost: a\r\nContent-Length: 2\r\n\r\n[]",
    "GET /json HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /b64/aGVsbG8 HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /b64/aGVsbG8gd29ybGQ HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /b64/!!!! HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /b64 HTTP/1.1\r\nHost: a\r\n\r\n",
    "POST /b64/aGk HTTP/1.1\r\nHost: a\r\nContent-Length: 0\r\n\r\n",
    "GET /match/a/abc HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /match/(a)(b)%3F/ab HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /match/(a)(b)%3F/ac HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /match/z/abc HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /match/(%3F%3Da)/x HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /match/(a%7Ca)%2Bb/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa HTTP/1.1\r\nHost: a\r\n\r\n",
    "POST /match/a/b HTTP/1.1\r\nHost: a\r\nContent-Length: 0\r\n\r\n",
    "GET /nope HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /a/b/c/d HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET http://server.invalid/time HTTP/1.1\r\nHost: a\r\n\r\n",
    // keep-alive decisions
    "GET / HTTP/1.0\r\n\r\n",
    "GET / HTTP/1.0\r\nConnection: keep-alive\r\n\r\n",
    "GET / HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n",
    // rejections
    "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n",
    "GET / HTTP/1.1\r\nHost : a\r\n\r\n",
    "GET / HTTP/2.0\r\n\r\n",
    "POST /json HTTP/1.1\r\nHost: a\r\nContent-Length: 99999999\r\n\r\n",
    "GET /" + DEL + " HTTP/1.1\r\nHost: a\r\n\r\n",
    // chunked in, which routes the same as any other body
    "POST /json HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\n\r\n7\r\n{\"a\":1}\r\n0\r\n\r\n");
}

export i32 main() {
  i32 seen = 0;

  string[] rs = requests();
  for (i32 i = 0; i < rs.len(); i++) { seen = seen + one(rs[i]); }

  // **Targets and bodies the corpus above never built.** Each of these was an uncovered branch in
  // `routes.wac` when `issues/system/0205` gave this package a floor, and every one is an ordinary
  // input rather than an unreachable line — see `cov_ledger.wac`.
  string US = string.fromCodepoint(0x1f);       // a control character whose low nibble is >= 10
  string SO = string.fromCodepoint(0x1a);       // and whose high nibble is not
  string[] more = string[](
    // an unparseable request target
    "GET :// HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET %%%% HTTP/1.1\r\nHost: a\r\n\r\n",
    // empty segments, and a path that has none at all
    "GET // HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /echo//a//b HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /b64//aGk HTTP/1.1\r\nHost: a\r\n\r\n",
    // control characters that JSON has to escape as `\u00xx`, both nibble halves
    "GET /echo?q=" + US + SO + " HTTP/1.1\r\nHost: a\r\n\r\n",
    "POST /json HTTP/1.1\r\nHost: a\r\nContent-Length: 8\r\n\r\n{\"a\":" + US + SO + "1}",
    // numbers the JSON writer has to render, which it was only ever handed zero for
    "GET /echo?n=12345&m=-7 HTTP/1.1\r\nHost: a\r\n\r\n",
    "POST /json HTTP/1.1\r\nHost: a\r\nContent-Length: 20\r\n\r\n{\"n\":12345,\"m\":-7}",
    // A match that does not start at 0, which is the only way `writeInt` is handed a non-zero: it
    // writes `"start"` for the regex route, and every request above matched at the first byte.
    "GET /match/b/abc HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /match/c/abcdefghijkl HTTP/1.1\r\nHost: a\r\n\r\n",
    // Control bytes *percent-encoded*, so `pctDecode` produces them and the JSON writer has to escape
    // them as `\u00xx`. A literal control character in the target does not survive the request parser,
    // which is why the first attempt at this covered nothing. `0x1a` and `0x1f` both have a low nibble
    // of ten or more, which is the half of that ternary nothing had reached.
    "GET /echo?q=%1A%1F%0B HTTP/1.1\r\nHost: a\r\n\r\n",
    "GET /match/(.)/a%1Fb HTTP/1.1\r\nHost: a\r\n\r\n");
  for (i32 i = 0; i < more.len(); i++) { seen = seen + one(more[i]); }

  // Every prefix of a request, which is what reaches the `Incomplete` return.
  string full = "POST /json HTTP/1.1\r\nHost: a\r\nContent-Length: 7\r\n\r\n{\"a\":1}";
  for (i32 n = 0; n <= full.len(); n++) { seen = seen + one(full.slice(0, n)); }

  // Pipelined pairs, so `consumed` is exercised with something after it.
  string[] firsts = string[](
    "GET / HTTP/1.1\r\nHost: a\r\n\r\n",
    "POST /json HTTP/1.1\r\nHost: a\r\nContent-Length: 7\r\n\r\n{\"a\":1}");
  for (i32 i = 0; i < firsts.len(); i++) {
    seen = seen + one(firsts[i] + "GET /time HTTP/1.1\r\nHost: a\r\n\r\n");
  }

  return seen;
}
