// Both lookup paths, exposed separately so the threshold in `JsonObject.INDEX_MIN` is a
// measurement rather than a guess.
//
// `scan` and `get` are the same query; the only difference is whether a hash index is built
// and used. Each entry point does `reps` lookups over an object of `n` members so the loop
// is inside wasm and the bindgen crossing is amortised away.

import { JsonValue, JsonObject, numberOf } from "../src/value.wac";

/**
 * An object with `n` members keyed "k0".."k(n-1)".
 *
 * Keys are short and share a prefix, which is the realistic bad case: a scan's early-exit on
 * length never fires, so it compares bytes.
 */
JsonObject build(i32 n) {
  JsonObject o = JsonObject.create();
  for (i32 i = 0; i < n; i++) {
    o.push(("k" + itoaLocal(i)).toBytes(), numberOf(i as f64));
  }
  return o;
}

// A local itoa so the bench does not depend on packages/fmt.
string itoaLocal(i32 v) {
  if (v == 0) { return "0"; }
  string out = "";
  i32 n = v;
  while (n > 0) {
    out = string.fromCodepoint(48 + (n % 10)) + out;
    n = n / 10;
  }
  return out;
}

/** `reps` scans, cycling through every key so the average is over all positions. */
export i32 scanKeys(i32 n, i32 reps) {
  JsonObject o = build(n);
  u8[][] keys = u8[][n]();
  for (i32 i = 0; i < n; i++) { keys[i] = ("k" + itoaLocal(i)).toBytes(); }
  i32 hits = 0;
  for (i32 r = 0; r < reps; r++) {
    JsonValue? v = o.scan(keys[r % n]);
    if (v is not null) { hits++; }
  }
  return hits;
}


/** Forces the indexed path regardless of size, so the crossover can be seen from below. */
export i32 indexedKeys(i32 n, i32 reps) {
  JsonObject o = build(n);
  o.buildIndex();
  u8[][] keys = u8[][n]();
  for (i32 i = 0; i < n; i++) { keys[i] = ("k" + itoaLocal(i)).toBytes(); }
  i32 hits = 0;
  for (i32 r = 0; r < reps; r++) {
    JsonValue? v = o.get(keys[r % n]);
    if (v is not null) { hits++; }
  }
  return hits;
}

/**
 * Just the index build, repeated.
 *
 * The number the steady-state columns hide: an index costs O(n) hashes before it answers
 * anything, and a document looked up once pays that instead of half a scan. This is what makes
 * a threshold worth having rather than always indexing.
 */
export i32 buildOnly(i32 n, i32 reps) {
  JsonObject o = build(n);
  i32 acc = 0;
  for (i32 r = 0; r < reps; r++) {
    o.buildIndex();
    acc = acc + o.len();
  }
  return acc;
}

// ---------------------------------------------------------------------------------------------
// The driver, which was a Deno program beside this file until 2026-09-01 — in git, and not
// named here, since a backticked path to something deleted is what `tools/wac/links_test.wac`
// refuses.
//
// It only ever timed the three exports above and printed a table; the loops it measured were
// already in here, which is what this file's header means by the crossing being amortised away.
// So the port moves the harness and not the measurement, and the numbers are the same numbers.

import { Core, Cli } from "std/platform.wac";

i32 REPS() { return 200000; }
i32 BUILD_REPS() { return 20000; }

/** One of the three measured entry points, by index — see `runOne`'s note in `benchcompile.wac`. */
i32 runOne(i32 which, i32 n, i32 reps) {
  if (which == 0) { return scanKeys(n, reps); }
  if (which == 1) { return indexedKeys(n, reps); }
  return buildOnly(n, reps);
}

/** Best of three, because the fastest run is the one least disturbed by the rest of the box. */
i64 bestOfThree(Core core, i32 which, i32 n, i32 reps) {
  i64 best = 0;
  for (i32 i = 0; i < 3; i++) {
    i64 t0 = core.monotonicNanos().wait();
    i32 sink = runOne(which, n, reps);
    i64 took = core.monotonicNanos().wait() - t0;
    if (sink == 0 - 1) { return 0; }        // never true; keeps the call live
    if (i == 0 || took < best) { best = took; }
  }
  return best;
}

/** Nanoseconds per operation, which is what the table reports. */
i64 perOp(i64 nanos, i32 reps) { return nanos / (reps as i64); }

export i32 main(Core core, Cli cli) {
  i32[] sizes = i32[](2, 4, 8, 12, 16, 24, 32, 64, 128, 256, 1024);

  // Warm up, so the first measured size does not pay for whatever the host does on a first call.
  scanKeys(8, 10000);
  indexedKeys(8, 10000);

  core.log(itoaLocal(REPS()) + " lookups, cycling through every key. ns.\n");
  core.log("| members | scan/lookup | indexed/lookup | index build | break-even lookups |");
  core.log("|---:|---:|---:|---:|---|");

  for (i32 i = 0; i < sizes.len(); i++) {
    i32 n = sizes[i];
    i64 scan = perOp(bestOfThree(core, 0, n, REPS()), REPS());
    i64 indexed = perOp(bestOfThree(core, 1, n, REPS()), REPS());
    i64 build = perOp(bestOfThree(core, 2, n, BUILD_REPS()), BUILD_REPS());
    // How many lookups it takes for the index to repay its own construction.
    i64 saved = scan - indexed;
    string verdict = "never";
    if (saved > 0) { verdict = itoaLocal(((build + saved - 1) / saved) as! i32); }
    core.log("| " + itoaLocal(n) + " | " + itoaLocal(scan as! i32) + " | "
             + itoaLocal(indexed as! i32) + " | " + itoaLocal(build as! i32) + " | "
             + verdict + " |");
  }
  return 0;
}
