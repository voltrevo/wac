  test_valid_documents_are_accepted as iv__valid_documents_are_accepted,
  test_mutations_agree_with_the_host as iv__mutations_agree_with_the_host,
} from "./wac/invalid_test.wac";
import {
  test_every_vendored_case_agrees_with_the_reference as j5__every_vendored_case_agrees_with_the_reference,
  test_the_comparison_can_fail as j5__the_comparison_can_fail,
  test_an_unquoted_non_ascii_name_is_refused_by_name_not_by_accident as j5__an_unquoted_non_ascii_name_is_refused_by_name_not_by_accident,
  test_an_unterminated_block_comment_reports_where_it_opened as j5__an_unterminated_block_comment_reports_where_it_opened,
  test_json5_accepts_every_json_document_with_the_same_tree as j5__json5_accepts_every_json_document_with_the_same_tree,
