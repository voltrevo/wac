// Branch coverage for json: the exercises, and nothing else.
//
//   deno task coverage:json
//   deno task coverage:json --verbose
//
// The exercises are deliberately the same ones the test suite runs — the vendored JSONTestSuite
// corpus, the mutation seeds, the number corpora — because coverage measured against a *different*
// workload tells you about that workload, not about what the tests actually check.
//
// ## This is the driver `issues/system/0221` was filed for
//
// It needs two things the coverage runner could not do. **A directory listing**: the conformance
// corpus is 300-odd files read by name off disk, and `covdump` used to instantiate with no imports at
// all, so an exercise could not hold a `Cli` — the module failed to instantiate rather than being
// refused. **And four traps**: `bounds_test.wac`'s cases each end their function, so all four in one
// `main` would lose three, and they are exports here for `covdump` to call one at a time.
//
// The JSON5 corpus is read and parsed **with this package's own parser**, which is circular only in
// appearance: the file is JSON, we have a JSON parser, and the alternative was a second scanner in a
// coverage driver written to avoid using the thing it measures. Without that corpus the report calls
// the comments, the single-quoted strings and the ECMAScript numbers dead code — the opposite of the
// truth, since `test/wac/json5_test.wac` drives every one of them against the reference.

import { Core, Cli, FileResult } from "std/platform.wac";
import { JsonValue, JsonArray, JsonObject } from "../src/value.wac";
import { parse, canonicalize, canonicalizeJson5, parseNumberValue } from "../src/json.wac";
import { test_hex_digit, test_bytes_equal, test_json_array_growth,
         test_lookup_agrees_across_the_index_threshold, test_push_after_indexing_is_visible,
         test_json_object_lookup, test_tree_shape, test_string_accessors,
         test_string_accessors_handle_utf8, test_member_order_is_source_order,
         test_unescaped_string_contents, test_surrogate_pair_decodes_to_one_scalar,
         test_unpaired_surrogate_becomes_replacement, test_number_keeps_its_source_span,
         test_error_codes_and_positions, test_hand_built_tree_serializes,
         test_hand_built_values_stay_valid_json, test_parsed_numbers_keep_their_span } from "./wac/json_test.wac";
import { test_traps_when_an_array_index_is_past_the_end,
         test_traps_when_an_array_index_is_negative,
         test_traps_when_an_object_index_is_past_the_end,
         test_traps_when_an_object_index_is_negative, test_at_returns_the_element_when_in_range } from "./wac/bounds_test.wac";

import {
  test_the_corpus_is_present_and_complete as cf__the_corpus_is_present_and_complete,
  test_every_valid_document_is_accepted as cf__every_valid_document_is_accepted,
