} from "./wac/json5_test.wac";
import {
  test_exact_cases_match_the_host_bit_for_bit as nu__exact_cases_match_the_host_bit_for_bit,
  test_a_document_that_is_not_a_number_yields_nan as nu__a_document_that_is_not_a_number_yields_nan,
  test_hard_cases_are_exact_too as nu__hard_cases_are_exact_too,
} from "./wac/number_test.wac";
import {
