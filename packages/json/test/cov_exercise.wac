import {
  test_utf8_malformed_sequences_are_rejected as u8__utf8_malformed_sequences_are_rejected,
  test_utf8_a_sequence_cut_off_by_the_end_of_input as u8__utf8_a_sequence_cut_off_by_the_end_of_input,
  test_utf8_a_valid_lead_with_a_bad_later_continuation as u8__utf8_a_valid_lead_with_a_bad_later_continuation,
  test_utf8_well_formed_sequences_at_every_width as u8__utf8_well_formed_sequences_at_every_width,
  test_utf8_multi_byte_content_survives_the_round_trip as u8__utf8_multi_byte_content_survives_the_round_trip,
  test_utf8_random_byte_sequences_agree_with_a_strict_decoder as u8__utf8_random_byte_sequences_agree_with_a_strict_decoder,
  test_utf8_a_hand_built_tree_cannot_produce_invalid_json as u8__utf8_a_hand_built_tree_cannot_produce_invalid_json,
} from "./wac/utf8_test.wac";
const string SUITE = "packages/json/test/jsontestsuite";
const string JSON5 = "packages/json/test/vendor/json5.json";

/** Whether a name ends in `.json`, which is what the corpus directory is filtered by. */
bool isJson(string name) {
  return name.len() > 5 && name.slice(name.len() - 5, name.len()) == ".json";
}

/**
 * Every document in the conformance corpus, through both parsers.
 *
 * The second pass is the superset invariant the tests assert: every JSON document is also JSON5.
 */
i32 corpus(Core core, Cli cli) {
  string[]? entries = cli.readDir(SUITE).wait();
  if (entries is null) {
    core.warn("json coverage: cannot list " + SUITE + " — is --allow-read granted?");
    return 0;
  }
  string[] names = entries!;
  i32 seen = 0;
  for (i32 i = 0; i < names.len(); i++) {
    if (!isJson(names[i])) { continue; }
    FileResult f = cli.readFile(SUITE + "/" + names[i]).wait();
    if (!f.ok) { continue; }
    canonicalize(f.bytes);
    canonicalizeJson5(f.bytes);
    seen = seen + 2;
  }
  return seen;
}

/**
 * The three questions this driver asks of a parsed value, one arm each.
 *
 * An enum match names every variant — `spec/tour.wac`: *"there is no `default` to paper over a variant
 * added later"* — so these exist to say "not that shape, no answer" once rather than at four nesting
 * levels inside the walk below.
 */
JsonObject? objectOf(JsonValue v) {
  match (v) {
    case Object(o): { return o; }
    case Null: { return null; }
    case Bool(b): { return null; }
    case Number(n, raw): { return null; }
    case Str(t): { return null; }
    case Array(a): { return null; }
  }
}

JsonArray? arrayOf(JsonValue v) {
  match (v) {
    case Array(a): { return a; }
    case Null: { return null; }
    case Bool(b): { return null; }
    case Number(n, raw): { return null; }
    case Str(t): { return null; }
    case Object(o): { return null; }
  }
}

u8[]? bytesOf(JsonValue v) {
  match (v) {
    case Str(t): { return t; }
    case Null: { return null; }
    case Bool(b): { return null; }
    case Number(n, raw): { return null; }
    case Array(a): { return null; }
    case Object(o): { return null; }
  }
}

/** The JSON5 corpus: `{ cases: [ { input: "…" } ] }`, walked with our own parser. */
i32 json5Corpus(Cli cli) {
  FileResult f = cli.readFile(JSON5).wait();
  if (!f.ok) { return 0; }
  JsonValue? root = parse(f.bytes);
  if (root is null) { return 0; }
  JsonObject? top = objectOf(root!);
  if (top is null) { return 0; }
  JsonValue? cs = top!.getStr("cases");
  if (cs is null) { return 0; }
  JsonArray? items = arrayOf(cs!);
  if (items is null) { return 0; }
  i32 seen = 0;
  for (i32 i = 0; i < items!.len(); i++) {
    JsonObject? c = objectOf(items!.get(i));
    if (c is null) { continue; }
    JsonValue? inp = c!.getStr("input");
    if (inp is null) { continue; }
    u8[]? text = bytesOf(inp!);
    if (text is null) { continue; }
    canonicalizeJson5(text!);
    seen = seen + 1;
  }
  return seen;
}

/** The number paths, which the corpus barely touches. */
i32 numbers() {
  i32 seen = 0;
  string[] ns = string[](
    "0", "-0", "1", "1.5", "-2.25", "1e5", "1E-5", "1e+5", "0.1",
    "9007199254740993", "1e308", "1e309", "1e-400", "5e-324",
    "123456789012345678901234567890", "0.1234567890123456789012345",
    "1.7976931348623157e308", "2.2250738585072011e-308", "1e23");
  for (i32 i = 0; i < ns.len(); i++) {
    parseNumberValue(ns[i].toBytes());
    canonicalize(ns[i].toBytes());
    seen = seen + 2;
  }
  // The failure paths of `parseNumberValue`, which `number_test.wac` covers and this file once did
  // not — the standing hazard of a second workload written by hand.
  string[] bad = string[]("", "[", "1 2", "01", "-", "1e", "\"1\"", "true", "null", "[1]",
                          "{\"a\":1}");
  for (i32 i = 0; i < bad.len(); i++) { parseNumberValue(bad[i].toBytes()); seen = seen + 1; }
  return seen;
}

/** Escapes and UTF-8, including the paths that reject. */
i32 escapes() {
  i32 seen = 0;
  string[] ss = string[](
    "\"\\u0041\\n\\t\\r\\b\\f\\/\\\\\\\"\"",
    "\"\\ud83d\\ude00\"", "\"\\ud83d\"", "\"\\udc00\"",
    "\"\\ud83dx\"", "\"\\u00e9\"", "\"café 日本 😀\"",
    "\"\\uZZZZ\"", "\"\\u12\"", "\"\\q\"", "\"unterminated", "\"a\tb\"");
  for (i32 i = 0; i < ss.len(); i++) { canonicalize(ss[i].toBytes()); seen = seen + 1; }
  return seen;
}

/** A quoted string around a raw byte sequence: control bytes and malformed UTF-8. */
i32 rawBytes() {
  i32 seen = 0;
  u8[][] bodies = u8[][](
    u8[](0x81), u8[](0xC3), u8[](0xC3, 0x28), u8[](0xC0, 0x80), u8[](0xED, 0xA0, 0x80),
    u8[](0xF5, 0x80, 0x80, 0x80), u8[](0xF4, 0x90, 0x80, 0x80), u8[](0xE0, 0x80, 0x80),
    u8[](0xC2, 0x80), u8[](0xEF, 0xBF, 0xBF), u8[](0xF4, 0x8F, 0xBF, 0xBF), u8[](0x01),
    // A valid lead with a bad *later* continuation byte, which reaches the loop rather than the
    // first range check.
    u8[](0xE6, 0x97, 0x41), u8[](0xF0, 0x9F, 0x41, 0x80), u8[](0xF0, 0x9F, 0x98, 0x41));
  for (i32 i = 0; i < bodies.len(); i++) {
    u8[] b = bodies[i];
    u8[] quoted = u8[b.len() + 2]();
    quoted[0] = 0x22;
    for (i32 k = 0; k < b.len(); k++) { quoted[k + 1] = b[k]; }
    quoted[b.len() + 1] = 0x22;
    canonicalize(quoted);
    seen = seen + 1;
  }
  // Sequences cut off by the end of input, with no closing quote to reject them.
  u8[][] cut = u8[][](u8[](0xC3), u8[](0xE6), u8[](0xE6, 0x97), u8[](0xF0),
                      u8[](0xF0, 0x9F, 0x98));
  for (i32 i = 0; i < cut.len(); i++) {
    u8[] b = cut[i];
    u8[] open = u8[b.len() + 1]();
    open[0] = 0x22;
    for (i32 k = 0; k < b.len(); k++) { open[k + 1] = b[k]; }
    canonicalize(open);
    seen = seen + 1;
  }
  return seen;
}

/** Depth, both inside and past the limit; and containers big enough to grow several times. */
i32 shapes() {
  i32 seen = 0;
  i32[] depths = i32[](1, 399, 400, 500);
  for (i32 i = 0; i < depths.len(); i++) {
    string open = "";
    string close = "";
    for (i32 k = 0; k < depths[i]; k++) { open = open + "["; close = close + "]"; }
    canonicalize((open + close).toBytes());
    seen = seen + 1;
  }
  string arr = "";
  string obj = "";
  for (i32 i = 0; i < 200; i++) {
    string n = itoaLocal(i);
    arr = arr + (i > 0 ? "," : "") + n;
    obj = obj + (i > 0 ? "," : "") + "\"k" + n + "\":" + n;
  }
  canonicalize(("[" + arr + "]").toBytes());
  canonicalize(("{" + obj + "}").toBytes());
  canonicalize("{\"a\":1,\"a\":2}".toBytes());
  return seen + 3;
}

/** Base ten, locally, so this file needs nothing from `packages/fmt`. */
string itoaLocal(i32 n) {
  if (n == 0) { return "0"; }
  string out = "";
  i32 v = n;
  while (v > 0) {
    out = string.fromCodepoint(48 + (v % 10)) + out;
    v = v / 10;
  }
  return out;
}

export i32 main(Core core, Cli cli) {
  i32 seen = corpus(core, cli) + json5Corpus(cli) + numbers() + escapes() + rawBytes() + shapes();

  // The package's own tests, which reach much of `value.wac` — the container accessors, the
  // string-typed edge, lookup by key — that the four exports `json.wac` offers a host cannot.
  seen = seen + test_hex_digit().len();
  seen = seen + test_bytes_equal().len();
  seen = seen + test_json_array_growth().len();
  seen = seen + test_lookup_agrees_across_the_index_threshold().len();
  seen = seen + test_push_after_indexing_is_visible().len();
  seen = seen + test_json_object_lookup().len();
  seen = seen + test_tree_shape().len();
  seen = seen + test_string_accessors().len();
  seen = seen + test_string_accessors_handle_utf8().len();
  seen = seen + test_member_order_is_source_order().len();
  seen = seen + test_unescaped_string_contents().len();
  seen = seen + test_surrogate_pair_decodes_to_one_scalar().len();
  seen = seen + test_unpaired_surrogate_becomes_replacement().len();
  seen = seen + test_number_keeps_its_source_span().len();
  seen = seen + test_error_codes_and_positions().len();
  seen = seen + test_hand_built_tree_serializes().len();
  seen = seen + test_hand_built_values_stay_valid_json().len();
  seen = seen + test_parsed_numbers_keep_their_span().len();
  seen = seen + test_at_returns_the_element_when_in_range().len();

  // ── The 34 tests the exercise was not calling ──
  //
  // Twenty-eight of them take `(Core, Cli)`: this package is measured against Node's `JSON` and
  // against `npm:json5`, so most of its tests spawn a process, and before `issues/system/0221` a
  // coverage driver could call none of them. The 23 that were wired are the ones that needed
  // nothing.
  //
  // The four that expect a trap keep their own named exports below rather than joining this list.
  i32 bad = 0;
  if (cf__the_corpus_is_present_and_complete(core, cli).len() > 0) {
    core.warn("error: FAILED conformance_test test_the_corpus_is_present_and_complete");
    bad = bad + 1;
  }
  if (cf__every_valid_document_is_accepted(core, cli).len() > 0) {
    core.warn("error: FAILED conformance_test test_every_valid_document_is_accepted");
    bad = bad + 1;
  }
  if (cf__every_invalid_document_is_rejected(core, cli).len() > 0) {
    core.warn("error: FAILED conformance_test test_every_invalid_document_is_rejected");
    bad = bad + 1;
  }
  if (cf__accepted_documents_re_serialize_to_the_same_tree(core, cli).len() > 0) {
    core.warn("error: FAILED conformance_test test_accepted_documents_re_serialize_to_the_same_tree");
    bad = bad + 1;
  }
  if (cf__implementation_defined_documents_terminate(core, cli).len() > 0) {
    core.warn("error: FAILED conformance_test test_implementation_defined_documents_terminate");
    bad = bad + 1;
  }
  if (iv__invalid_documents_are_rejected(core, cli).len() > 0) {
    core.warn("error: FAILED invalid_test test_invalid_documents_are_rejected");
    bad = bad + 1;
  }
  if (iv__valid_documents_are_accepted(core, cli).len() > 0) {
    core.warn("error: FAILED invalid_test test_valid_documents_are_accepted");
    bad = bad + 1;
  }
  if (iv__mutations_agree_with_the_host(core, cli).len() > 0) {
    core.warn("error: FAILED invalid_test test_mutations_agree_with_the_host");
    bad = bad + 1;
  }
  if (j5__every_vendored_case_agrees_with_the_reference(core, cli).len() > 0) {
    core.warn("error: FAILED json5_test test_every_vendored_case_agrees_with_the_reference");
    bad = bad + 1;
  }
  if (j5__the_comparison_can_fail(core, cli).len() > 0) {
    core.warn("error: FAILED json5_test test_the_comparison_can_fail");
    bad = bad + 1;
  }
  if (j5__an_unquoted_non_ascii_name_is_refused_by_name_not_by_accident(core, cli).len() > 0) {
    core.warn("error: FAILED json5_test test_an_unquoted_non_ascii_name_is_refused_by_name_not_by_accident");
    bad = bad + 1;
  }
  if (j5__an_unterminated_block_comment_reports_where_it_opened(core, cli).len() > 0) {
    core.warn("error: FAILED json5_test test_an_unterminated_block_comment_reports_where_it_opened");
    bad = bad + 1;
  }
  if (j5__json5_accepts_every_json_document_with_the_same_tree(core, cli).len() > 0) {
    core.warn("error: FAILED json5_test test_json5_accepts_every_json_document_with_the_same_tree");
    bad = bad + 1;
  }
  if (j5__the_json5_tree_is_walkable_and_json_refuses_the_same_document().len() > 0) {
    core.warn("error: FAILED json5_test test_the_json5_tree_is_walkable_and_json_refuses_the_same_document");
    bad = bad + 1;
  }
  if (j5__a_comment_is_not_accepted_by_the_json_parser(core, cli).len() > 0) {
    core.warn("error: FAILED json5_test test_a_comment_is_not_accepted_by_the_json_parser");
    bad = bad + 1;
  }
  if (nu__exact_cases_match_the_host_bit_for_bit(core, cli).len() > 0) {
    core.warn("error: FAILED number_test test_exact_cases_match_the_host_bit_for_bit");
    bad = bad + 1;
  }
  if (nu__a_document_that_is_not_a_number_yields_nan().len() > 0) {
    core.warn("error: FAILED number_test test_a_document_that_is_not_a_number_yields_nan");
    bad = bad + 1;
  }
  if (nu__hard_cases_are_exact_too(core, cli).len() > 0) {
    core.warn("error: FAILED number_test test_hard_cases_are_exact_too");
    bad = bad + 1;
  }
  if (rt__round_trip_matches_the_hosts(core, cli).len() > 0) {
    core.warn("error: FAILED roundtrip_test test_round_trip_matches_the_hosts");
    bad = bad + 1;
  }
  if (rt__negative_zero_keeps_its_sign(core, cli).len() > 0) {
    core.warn("error: FAILED roundtrip_test test_negative_zero_keeps_its_sign");
    bad = bad + 1;
  }
  if (rt__duplicate_object_keys_are_all_retained(core, cli).len() > 0) {
    core.warn("error: FAILED roundtrip_test test_duplicate_object_keys_are_all_retained");
    bad = bad + 1;
  }
  if (rt__deep_nesting_inside_the_depth_limit(core, cli).len() > 0) {
    core.warn("error: FAILED roundtrip_test test_deep_nesting_inside_the_depth_limit");
    bad = bad + 1;
  }
  if (rt__the_depth_limit_rejects_rather_than_exhausting_the_stack().len() > 0) {
    core.warn("error: FAILED roundtrip_test test_the_depth_limit_rejects_rather_than_exhausting_the_stack");
    bad = bad + 1;
  }
  if (tr__every_kind_arrives_with_the_right_tag().len() > 0) {
    core.warn("error: FAILED tree_test test_every_kind_arrives_with_the_right_tag");
    bad = bad + 1;
  }
  if (tr__a_document_that_is_not_json_parses_as_null().len() > 0) {
    core.warn("error: FAILED tree_test test_a_document_that_is_not_json_parses_as_null");
    bad = bad + 1;
  }
  if (tr__scalars_carry_their_values().len() > 0) {
    core.warn("error: FAILED tree_test test_scalars_carry_their_values");
    bad = bad + 1;
  }
  if (tr__containers_are_walkable_in_order_and_with_duplicates().len() > 0) {
    core.warn("error: FAILED tree_test test_containers_are_walkable_in_order_and_with_duplicates");
    bad = bad + 1;
  }
  if (tr__a_tree_handed_back_serializes_to_what_it_came_from().len() > 0) {
    core.warn("error: FAILED tree_test test_a_tree_handed_back_serializes_to_what_it_came_from");
    bad = bad + 1;
  }
  if (tr__the_tree_walks_to_the_same_data_the_host_produces(core, cli).len() > 0) {
    core.warn("error: FAILED tree_test test_the_tree_walks_to_the_same_data_the_host_produces");
    bad = bad + 1;
  }
  if (u8__utf8_malformed_sequences_are_rejected(core, cli).len() > 0) {
    core.warn("error: FAILED utf8_test test_utf8_malformed_sequences_are_rejected");
    bad = bad + 1;
