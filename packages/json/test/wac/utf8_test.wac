// UTF-8 validity inside a JSON string, judged against a strict `TextDecoder`.
//
// This exists because JSONTestSuite does not cover it. Its invalid-UTF-8 documents are all rejected
// for structural reasons — `[\xff]` fails because 0xFF cannot start a value, not because it is not
// UTF-8 — and the cases that would test it (`["\x81"]`, a CESU-8 surrogate) are classified `i_`,
// where either answer conforms. So the corpus passed while the parser accepted every malformed
// sequence there is.
//
// ## What the move changed
//
// The host-side version needed `errorOfBytes` beside `errorOf`, because "passing such bytes through a
// JS string and back re-encodes them (0xC3 becomes C3 83), so the parser would never see the sequence
// under test". Here every document is a `u8[]` and there is one entry point. The two spellings, and
// the paragraph explaining which to reach for, are gone.
//
// Host-side until 2026-08-17. `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { Rng } from "../../../wactest/src/rng.wac";
import { Lines, checkDeno, hex } from "../../../wactest/src/oracle.wac";
import { Core, Cli } from "std/platform.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { Canonical, canonicalize, stringify } from "../../src/json.wac";
import { JsonValue } from "../../src/value.wac";
import { ERR_NONE, ERR_UTF8, ERR_EOF } from "../../src/parse.wac";

/**
 * One byte from a distribution that lands in each interesting UTF-8 range often enough.
 *
 * A free function rather than a method: `Rng` is `packages/wactest/src/rng.wac`'s now, and a wac
 * struct's methods cannot be extended from another file. `issues/system/0220`.
 */
i32 pick(Rng rng) {
  i32 r = rng.upto(100);
  if (r < 30) { return 0x80 + rng.upto(0x40); }   // continuation range
  if (r < 60) { return 0xC0 + rng.upto(0x40); }   // lead range, valid and not
  if (r < 80) { return rng.upto(0x80); }          // ASCII
  return rng.upto(0x100);                          // anything
}

const string ORACLE = "packages/json/test/oracle.ts";

/** A one-string document containing exactly these bytes. */
u8[] doc(u8[] body) {
  u8[] out = u8[body.len() + 2]();
  out[0] = 0x22;
  for (i32 i = 0; i < body.len(); i++) { out[i + 1] = body[i]; }
  out[body.len() + 1] = 0x22;
  return out;
}

export string test_utf8_malformed_sequences_are_rejected(Core core, Cli cli) {
  T t = T.create();
  string[] labels = string[](
    "lone continuation byte", "continuation after ASCII", "truncated two-byte lead",
    "two-byte lead then ASCII", "overlong NUL", "overlong slash", "overlong three-byte",
    "overlong four-byte", "truncated three-byte", "truncated four-byte", "high surrogate U+D800",
    "low surrogate U+DFFF", "past U+10FFFF", "F5 lead", "FE", "FF", "five-byte form");
  u8[][] bodies = u8[][17](fill: u8[0]());
  bodies[0] = u8[](0x81);
  bodies[1] = u8[](0x61, 0xBF);
  bodies[2] = u8[](0xC3);
  bodies[3] = u8[](0xC3, 0x28);
  bodies[4] = u8[](0xC0, 0x80);
  bodies[5] = u8[](0xC0, 0xAF);
  bodies[6] = u8[](0xE0, 0x80, 0x80);
  bodies[7] = u8[](0xF0, 0x80, 0x80, 0x80);
  bodies[8] = u8[](0xE6, 0x97);
  bodies[9] = u8[](0xF0, 0x9F, 0x98);
  bodies[10] = u8[](0xED, 0xA0, 0x80);
  bodies[11] = u8[](0xED, 0xBF, 0xBF);
  bodies[12] = u8[](0xF4, 0x90, 0x80, 0x80);
  bodies[13] = u8[](0xF5, 0x80, 0x80, 0x80);
  bodies[14] = u8[](0xFE);
  bodies[15] = u8[](0xFF);
  bodies[16] = u8[](0xF8, 0x88, 0x80, 0x80, 0x80);

  Lines lines = Lines.create();
  for (i32 i = 0; i < bodies.len(); i++) {
    t.eqI32(canonicalize(doc(bodies[i])).code, ERR_UTF8(),
            labels[i] + ": not rejected as UTF-8");
    // And the oracle agrees these are invalid, so the corpus cannot rot.
    lines.add("utf8valid " + hex(bodies[i]) + " 0");
  }
  checkDeno(t, cli, ORACLE, lines, "the malformed corpus really is malformed");
  return t.report();
}

/**
 * A sequence cut off by the end of input is rejected.
 *
 * Distinct from a sequence followed by a wrong byte: here the string never terminates, so the length
 * check fires rather than the range check. Branch coverage found this path unexercised — every
 * existing case had a closing quote, which supplies a byte for the range check to reject.
 */
export string test_utf8_a_sequence_cut_off_by_the_end_of_input() {
  T t = T.create();
  string[] labels = string[](
    "two-byte lead at EOF", "three-byte lead at EOF", "three-byte, one continuation, at EOF",
    "four-byte lead at EOF", "four-byte, two continuations, at EOF");
  u8[][] cases = u8[][5](fill: u8[0]());
  cases[0] = u8[](0x22, 0xC3);
  cases[1] = u8[](0x22, 0xE6);
  cases[2] = u8[](0x22, 0xE6, 0x97);
  cases[3] = u8[](0x22, 0xF0);
  cases[4] = u8[](0x22, 0xF0, 0x9F, 0x98);
  for (i32 i = 0; i < cases.len(); i++) {
    i32 err = canonicalize(cases[i]).code;
    // Either verdict is defensible — the input is both truncated UTF-8 and an unterminated string —
    // but it must be one of them and never accepted.
    t.isTrue(err == ERR_UTF8() || err == ERR_EOF(),
             labels[i] + ": got code " + itoa(err) + ", want UTF8 or EOF");
  }
  return t.report();
}

/**
 * A valid lead with a bad later continuation byte.
 *
 * The loop that checks continuation bytes after the first. A sequence whose first continuation is in
 * range but whose second is not only reaches it here.
 */
export string test_utf8_a_valid_lead_with_a_bad_later_continuation(Core core, Cli cli) {
  T t = T.create();
  string[] labels = string[]("three-byte, second continuation bad",
                             "four-byte, second continuation bad",
                             "four-byte, third continuation bad");
  u8[][] bodies = u8[][3](fill: u8[0]());
  bodies[0] = u8[](0xE6, 0x97, 0x41);
  bodies[1] = u8[](0xF0, 0x9F, 0x41, 0x80);
  bodies[2] = u8[](0xF0, 0x9F, 0x98, 0x41);
  Lines lines = Lines.create();
  for (i32 i = 0; i < bodies.len(); i++) {
    t.eqI32(canonicalize(doc(bodies[i])).code, ERR_UTF8(), labels[i]);
    lines.add("utf8valid " + hex(bodies[i]) + " 0");
  }
  checkDeno(t, cli, ORACLE, lines, "the host agrees these are malformed");
  return t.report();
}

export string test_utf8_well_formed_sequences_at_every_width(Core core, Cli cli) {
  T t = T.create();
  string[] labels = string[](
    "two-byte, lowest", "two-byte é", "two-byte, highest", "three-byte, lowest", "three-byte 日",
    "just below the surrogates", "just above the surrogates", "three-byte, highest",
    "four-byte, lowest", "four-byte 😀", "four-byte, highest U+10FFFF");
  u8[][] bodies = u8[][11](fill: u8[0]());
  bodies[0] = u8[](0xC2, 0x80);
  bodies[1] = u8[](0xC3, 0xA9);
  bodies[2] = u8[](0xDF, 0xBF);
  bodies[3] = u8[](0xE0, 0xA0, 0x80);
  bodies[4] = u8[](0xE6, 0x97, 0xA5);
  bodies[5] = u8[](0xED, 0x9F, 0xBF);
  bodies[6] = u8[](0xEE, 0x80, 0x80);
  bodies[7] = u8[](0xEF, 0xBF, 0xBF);
  bodies[8] = u8[](0xF0, 0x90, 0x80, 0x80);
  bodies[9] = u8[](0xF0, 0x9F, 0x98, 0x80);
  bodies[10] = u8[](0xF4, 0x8F, 0xBF, 0xBF);
  Lines lines = Lines.create();
  for (i32 i = 0; i < bodies.len(); i++) {
    t.eqI32(canonicalize(doc(bodies[i])).code, ERR_NONE(), labels[i] + ": rejected");
    lines.add("utf8valid " + hex(bodies[i]) + " 1");
  }
  checkDeno(t, cli, ORACLE, lines, "the host agrees these are well-formed");
  return t.report();
}

/** Multi-byte content survives the round trip intact — validation must not disturb what it passes. */
export string test_utf8_multi_byte_content_survives_the_round_trip(Core core, Cli cli) {
  T t = T.create();
  string src = "{\"日本\":\"café 😀\",\"k\":\"ÿĀ\"}";
  Canonical got = canonicalize(src.toBytes());
  t.eqI32(got.code, ERR_NONE(), "the document parses");
  if (!got.ok) { return t.report(); }
  Lines lines = Lines.create();
  lines.add("restringify " + hex(src.toBytes()) + " " + hex(got.text));
  checkDeno(t, cli, ORACLE, lines, "the round trip");
  return t.report();
}


export string test_utf8_random_byte_sequences_agree_with_a_strict_decoder(Core core, Cli cli) {
  T t = T.create();
  Rng rng = Rng(0x6D2B79F5);
  Lines lines = Lines.create();
  i32 checked = 0;
  for (i32 i = 0; i < 4000; i++) {
    i32 len = 1 + rng.upto(5);
    u8[] body = u8[len]();
    bool usable = true;
    for (i32 j = 0; j < len; j++) {
      body[j] = pick(rng);
      // A quote or a backslash would end the string or start an escape, and a control byte has its
      // own error; none of those are this test's subject.
      if (body[j] == 0x22 || body[j] == 0x5C || body[j] < 0x20) { usable = false; }
    }
    if (!usable) { continue; }
    checked = checked + 1;
    lines.add("utf8valid " + hex(body) + " " +
              (canonicalize(doc(body)).code == ERR_NONE() ? "1" : "0"));
  }
  t.isTrue(checked > 1000, "only " + itoa(checked) + " sequences were usable");
  core.log("  " + itoa(checked) + " random sequences compared with the host decoder");
  checkDeno(t, cli, ORACLE, lines, itoa(checked) + " random sequences");
  return t.report();
}

/**
 * The *other* UTF-8 validator — the one on the way out — checked by the one on the way in.
 *
 * This package has two. `parse.wac`'s refuses ill-formed input, and every case above exercises it.
 * `stringify.wac`'s `sequenceLen` decides how many bytes of a string to copy whole while escaping the
 * ASCII, and it is reached only when a tree carries bytes that were never parsed — which is exactly
 * what `stringify`'s doc comment says it is for: "a tree, built by hand or edited after parsing".
 *
 * So the corpus above could not reach it, and `issues/system/0205` listed ten of its arms as
 * uncovered: every `: 0` in the lead-byte table, which is to say **every rejection the validator can
 * make**. A copy of RFC 3629's ranges whose refusals had never once fired.
 *
 * What it must do is documented in the loop: one U+FFFD per ill-formed *byte*, so a caller cannot
 * hand this a tree and get JSON that is not valid UTF-8. That is checked here two ways, and the
 * second is the one that makes it a differential rather than a restatement: **the output goes back
 * through `canonicalize`**, which is the other validator, written from the same RFC by hand and
 * sharing no code with this one. If `sequenceLen` let an ill-formed sequence through, the parser
 * would refuse the document its own package had just produced.
 */
export string test_utf8_a_hand_built_tree_cannot_produce_invalid_json() {
  T t = T.create();
  string[] labels = string[](
    "lone continuation", "truncated two-byte lead", "overlong NUL", "overlong three-byte",
    "E0 with an overlong continuation", "E1 with a bad continuation", "ED as a high surrogate",
    "EE with a bad continuation", "F0 with an overlong continuation", "F1 with a bad continuation",
    "F3 truncated", "F4 past U+10FFFF", "F5 lead", "FF");
  u8[][] bad = u8[][14](fill: u8[0]());
  bad[0]  = u8[](0x81);
  bad[1]  = u8[](0xC3);
  bad[2]  = u8[](0xC0, 0x80);
  bad[3]  = u8[](0xE0, 0x80, 0x80);
  bad[4]  = u8[](0xE0, 0x9F, 0x80);
  bad[5]  = u8[](0xE1, 0x28, 0x80);
  bad[6]  = u8[](0xED, 0xA0, 0x80);
  bad[7]  = u8[](0xEE, 0x28, 0x80);
  bad[8]  = u8[](0xF0, 0x8F, 0x80, 0x80);
  bad[9]  = u8[](0xF1, 0x28, 0x80, 0x80);
  bad[10] = u8[](0xF3, 0x80, 0x80);
  bad[11] = u8[](0xF4, 0x90, 0x80, 0x80);
  bad[12] = u8[](0xF5, 0x80, 0x80, 0x80);
  bad[13] = u8[](0xFF);

  for (i32 i = 0; i < bad.len(); i++) {
    // `a` either side, so a replacement that swallowed a neighbour would show.
    u8[] payload = u8[bad[i].len() + 2]();
    payload[0] = 'a';
    for (i32 k = 0; k < bad[i].len(); k++) { payload[k + 1] = bad[i][k]; }
    payload[payload.len() - 1] = 'z';

    u8[] out = stringify(JsonValue.Str(payload));
    string text = string.fromBytes(out);
    t.isTrue(text.len() >= 4, labels[i] + ": produced nothing");
    t.eqStr(text.slice(0, 2), "\"a", labels[i] + ": the leading byte was disturbed");
    t.eqStr(text.slice(text.len() - 2, text.len()), "z\"",
            labels[i] + ": the trailing byte was disturbed");

    // The other validator's verdict on what the writer produced.
    Canonical back = canonicalize(out);
    t.eqI32(back.code, ERR_NONE(),
            labels[i] + ": the parser refused what the writer produced — " + text);
  }

  // Well-formed sequences at every width pass through untouched, which is what makes the
  // assertions above about the *rejections* rather than about the writer mangling everything.
  u8[][] good = u8[][5](fill: u8[0]());
  good[0] = u8[]('a');
  good[1] = u8[](0xC3, 0xA9);                    // é
  good[2] = u8[](0xE6, 0x97, 0xA5);              // 日
  good[3] = u8[](0xF0, 0x9F, 0x98, 0x80);        // 😀
  // A lead in F1..F3, which is its own row in the table and the only one the emoji above misses:
  // U+40000, in a plane nothing here uses and which is exactly why nothing had encoded one.
  good[4] = u8[](0xF1, 0x80, 0x80, 0x80);
  for (i32 i = 0; i < good.len(); i++) {
    u8[] out = stringify(JsonValue.Str(good[i]));
    t.eqI32(out.len(), good[i].len() + 2, "a well-formed sequence of width " +
            itoa(good[i].len()) + " was rewritten");
    t.eqI32(canonicalize(out).code, ERR_NONE(), "and the parser accepts it");
  }
  return t.report();
}
