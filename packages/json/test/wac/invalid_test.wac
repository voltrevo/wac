// What the parser refuses.
//
// A parser is half defined by what it refuses, and that half is where lenient hand-written parsers
// usually differ from the spec. The oracle is whether `JSON.parse` throws, so agreement is checked on
// the accept/reject decision rather than on any error message.
//
// ## What the move changed
//
// Both halves of every mutation go to the host: `PARSES` for the decision, and the tree question in
// `questions.wac` for the pairs where we accept — because the text legitimately differs (numbers are
// emitted verbatim, `1e2` rather than `100`, and JavaScript hoists integer-like object keys), so a
// parser has to spell both trees one way before they can be compared. Since 2026-10-27 the scripts
// only answer and the comparing is here (`packages/wactest/src/inline.wac`).
//
// The hand-written corpus asks the host as well as us, which is what the host-side version's
// "sanity: the corpus must actually be invalid per the oracle" did — a list of invalid documents that
// quietly acquired a valid one would otherwise assert nothing about that entry.
//
// Host-side until 2026-08-17. `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { Asked, agree } from "../../../wactest/src/inline.wac";
import { Sys } from "std";
import { canonicalize } from "../../src/json.wac";
import { faultOf } from "./faults.wac";
import { Trees, question, sameTrees } from "./questions.wac";

/** Whether `JSON.parse` accepts the document in a question's last word, after a strict decode: 1 or 0. */
static string PARSES =
  "const L = (await new Response(Deno.stdin.readable).text()).split(String.fromCharCode(10)).filter((l) => l.length > 0);\n" +
  "const bytes = (h) => Uint8Array.from(h.match(/../g) ?? [], (x) => parseInt(x, 16));\n" +
  "const ok = (h) => { try { JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(bytes(h))); return '1'; } catch { return '0'; } };\n" +
  "console.log(L.map((l) => ok(l.split(' ').pop())).concat(['DONE ' + L.length]).join(String.fromCharCode(10)));\n";

string oneByte(i32 c) {
  u8[] one = u8[].filled(1, 0);
  one[0] = c as@ u8;
  return string.fromBytes(one);
}

string[] invalid() {
  return [
    // empty and whitespace-only
    "", " ", "\n", "\t",
    // truncated values
    "[", "]", "{", "}", "[1", "[1,", "{\"a\"", "{\"a\":", "{\"a\":1", "\"abc",
    "tru", "fals", "nul", "t", "n",
    // trailing content
    "1 2", "null null", "[] []", "{} {}", "1,", "[1]x", "null;",
    // arrays
    "[,]", "[1,]", "[,1]", "[1,,2]", "[1 2]", "[1:2]",
    // objects
    "{,}", "{\"a\":1,}", "{a:1}", "{'a':1}", "{\"a\" 1}", "{\"a\":1 \"b\":2}",
    "{\"a\":}", "{:1}", "{\"a\":1,,\"b\":2}",
    // numbers JSON does not allow
    "01", "00", "-01", "+1", ".5", "5.", "1.", "-", "-.5", "1e", "1e+", "1e-",
    "1.2.3", "0x10", "1_000", "Infinity", "-Infinity", "NaN", "1d5",
    // strings
    "'single'", "\"a", "\"\\\"", "\"\\q\"", "\"\\u\"", "\"\\u12\"", "\"\\u12g4\"",
    "\"\\uD83D\\uDE0\"",
    // raw control bytes are not allowed unescaped
    "\"a\nb\"", "\"a\tb\"", "\"a\{oneByte(1)}b\"",
    // not JSON at all
    "undefined", "function(){}", "<html>", "//comment", "/*c*/1"
  ];
}

string[] valid() {
  return [
    "null", "true", "false", "0", "-0", "1", "1.5", "1e5", "-1.5e-5",
    "\"\"", "\"a\"", "[]", "{}", "[1,2]", "{\"a\":1}", "{\"a\":[1,{\"b\":null}]}",
    "\"\\u0041\"", "\"\\ud83d\\ude00\"", "  1  ", "[ 1 , 2 ]"
  ];
}

export async string test_invalid_documents_are_rejected(Sys sys) {
  T t = T.create();
  string[] bad = invalid();
  Asked asked = Asked.create();
  for (i32 i = 0; i < bad.len(); i++) {
    t.isTrue(canonicalize(bad[i].toBytes()).isErr(),
             "accepted invalid input \"\{bad[i]}\"");
    // And the corpus really is invalid, which the oracle says rather than this file assuming it: an
    // entry that quietly became valid JSON would make its own assertion above meaningless.
    asked.add(question(bad[i].toBytes()), "0");
  }
  await agree(t, sys.procs(), PARSES, asked, "the invalid corpus really is invalid");
  // **And refused for the right reason**, for the faults no other test names: a document refused
  // only as `isErr()` would pass with every fault reported as `Unexpected`.
  t.eqStr(faultOf(canonicalize("[1,".toBytes())), "end of input", "a document that stops early");
  t.eqStr(faultOf(canonicalize("[01]".toBytes())), "bad number", "a leading zero");
  t.eqStr(faultOf(canonicalize("\"\\q\"".toBytes())), "bad escape", "an escape JSON does not have");
  return t.report();
}

export async string test_valid_documents_are_accepted(Sys sys) {
  T t = T.create();
  string[] good = valid();
  Asked asked = Asked.create();
  for (i32 i = 0; i < good.len(); i++) {
    t.eqStr(canonicalize(good[i].toBytes()).err()?.text() ?? "", "",
            "rejected valid input \"\{good[i]}\"");
    asked.add(question(good[i].toBytes()), "1");
  }
  await agree(t, sys.procs(), PARSES, asked, "the valid corpus really is valid");
  return t.report();
}

/**
 * Mutation fuzz: take valid documents apart a byte at a time and require the accept/reject decision
 * to match the host on every result.
 *
 * This is where a parser that is merely "mostly right" comes apart.
 */
export async string test_mutations_agree_with_the_host(Sys sys) {
  T t = T.create();
  string[] seeds = [
    "{\"a\":1,\"b\":[1,2,3],\"c\":{\"d\":null}}",
    "[true,false,null,1.5,-2e3,\"s\"]",
    "\"\\u0041\\n\\t\\\\\"",
    "[[[1]]]",
    "{\"k\":\"v\"}"
  ];
  string inject = "{}[],:\"\\ 0139aeflnrstuxEN+-.\n\t";
  Asked asked = Asked.create();
  Trees trees = Trees.create();
  i32 checked = 0;

  for (i32 s = 0; s < seeds.len(); s++) {
    string seed = seeds[s];
    for (i32 i = 0; i < seed.len(); i++) {
      checked = checked + one(asked, trees, seed.slice(0, i) + seed.slice(i + 1, seed.len()));   // delete
      for (i32 c = 0; c < inject.len(); c++) {
        string ch = inject.slice(c, c + 1);
        checked = checked + one(asked, trees, seed.slice(0, i) + ch + seed.slice(i, seed.len()));
        checked = checked + one(asked, trees, seed.slice(0, i) + ch + seed.slice(i + 1, seed.len()));
      }
    }
    checked = checked + one(asked, trees, seed.slice(0, seed.len() - 1));
    checked = checked + one(asked, trees, seed + seed);
  }

  sys.log("  \{checked} mutations checked");
  t.isTrue(checked > 5000, "only \{checked} mutations were generated");
  await agree(t, sys.procs(), PARSES, asked, "\{checked} mutations");
  await sameTrees(t, sys.procs(), trees, "\{checked} mutations");
  return t.report();
}

/**
 * One mutation, as the questions it needs.
 *
 * The decision always. The tree only when we accept — `sameTrees` skips a pair when *the host* cannot
 * parse the original, so a pair where the two disagree is reported once, by the decision, rather than
 * twice.
 */
i32 one(Asked asked, Trees trees, string src) {
  u8[]? out = canonicalize(src.toBytes()).ok();
  asked.add(question(src.toBytes()), out is not null ? "1" : "0");
  if (out is not null) { trees.add(out!, src.toBytes()); }
  return 1;
}
