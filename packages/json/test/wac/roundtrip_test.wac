// Differential round-trip: parse and re-serialize in wac, compare against the host's
// `JSON.stringify(JSON.parse(x))`.
//
// The corpus keeps numbers in the form JS would print them, because wac emits a number's original
// source span verbatim (see `stringify.wac`). Number conversion is tested separately in
// `number_test.wac`, where the comparison is on the f64 value rather than its text.
//
// ## The divergences are asserted from both sides
//
// Two of the cases here are deliberate differences from the host, and the host-side version stated
// both halves — ours *and* what JavaScript does — which is what stops a recorded divergence from
// outliving the thing it diverged from. That survives the move: `RESTRINGIFY` is asked what
// JavaScript produces and the claim is the answer this side expects, so `-0` printing as `0` is a
// check rather than a sentence. Since 2026-10-27 the script only answers and `agree` compares in wac
// (`packages/wactest/src/inline.wac`).
//
// Host-side until 2026-08-17. `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { Asked, agree } from "../../../wactest/src/inline.wac";
import { Sys } from "std";
import { canonicalize } from "../../src/json.wac";
import { faultOf } from "./faults.wac";
import { JsonError } from "../../src/parse.wac";
import { Result } from "core";
import { question } from "./questions.wac";

/**
 * `JSON.stringify(JSON.parse(doc))` for the document in each question's last word, or `refused` when a
 * strict decode or the parse throws.
 */
static string RESTRINGIFY =
  "const L = (await new Response(Deno.stdin.readable).text()).split(String.fromCharCode(10)).filter((l) => l.length > 0);\n" +
  "const bytes = (h) => Uint8Array.from(h.match(/../g) ?? [], (x) => parseInt(x, 16));\n" +
  "const again = (h) => { try { return JSON.stringify(JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(bytes(h)))); } catch { return 'refused'; } };\n" +
  "console.log(L.map((l) => again(l.split(' ').pop())).concat(['DONE ' + L.length]).join(String.fromCharCode(10)));\n";

string[] cases() {
  return [
    // scalars
    "null", "true", "false", "0", "1", "-1", "42", "1.5", "-2.25", "\"\"", "\"hello\"",
    // whitespace is not preserved
    "  null  ", "\t[\n1,\n2\n]\r\n",
    // arrays
    "[]", "[1]", "[1,2,3]", "[[[]]]", "[[1,[2,[3]]]]", "[null,true,false]", "[\"a\",\"b\"]",
    "[1,[2],{},{\"k\":[3]}]",
    // objects
    "{}", "{\"a\":1}", "{\"a\":1,\"b\":2}", "{\"nested\":{\"deep\":{\"deeper\":[1,2,3]}}}",
    "{\"\":0}", "{\"a\":[],\"b\":{}}",
    // string escapes that survive a round-trip unchanged
    "\"a\\\"b\"", "\"a\\\\b\"", "\"tab\\there\"", "\"nl\\nhere\"", "\"cr\\rhere\"",
    "\"bs\\bhere\"", "\"ff\\fhere\"", "\"\\u0000\"", "\"\\u001f\"",
    // \/ is a legal escape that JSON.stringify does not re-escape
    "\"a\\/b\"",
    // multi-byte UTF-8 passes through
    "\"café\"", "\"日本語\"", "\"😀\"", "\"\\u00e9\"", "\"\\u65e5\"", "\"\\ud83d\\ude00\"",
    // a realistic document
    "{\"name\":\"wac\",\"tags\":[\"lang\",\"wasm\"],\"version\":{\"major\":0,\"minor\":1}," +
      "\"stable\":false,\"notes\":null}"
  ];
}

export async string test_round_trip_matches_the_hosts(Sys sys) {
  T t = T.create();
  string[] all = cases();
  Asked asked = Asked.create();
  for (i32 i = 0; i < all.len(); i++) {
    Result<u8[], JsonError> got = canonicalize(all[i].toBytes());
    t.eqStr(faultOf(got), "", "unexpected error for \"\{all[i]}\"");
    if (!got.isOk()) { continue; }
    asked.add(question(all[i].toBytes()), string.fromBytes(got.orElse(u8[]())));
  }
  t.eqI32(asked.count(), all.len(), "every case was compared");
  await agree(t, sys.procs(), RESTRINGIFY, asked, "the round trip");
  return t.report();
}

/**
 * Negative zero keeps its sign.
 *
 * JS prints `-0` as `"0"`, losing the sign bit. Emitting the source span verbatim preserves it, which
 * round-trips more information rather than less.
 */
export async string test_negative_zero_keeps_its_sign(Sys sys) {
  T t = T.create();
  Result<u8[], JsonError> got = canonicalize("-0".toBytes());
  t.eqStr(faultOf(got), "", "-0 parses");
  t.eqStr(string.fromBytes(got.orElse(u8[]())), "-0", "and keeps its sign");
  // The other half: the host still loses it, so this is a divergence rather than an old note.
  Asked asked = Asked.create();
  asked.add(question("-0".toBytes()), "0");
  await agree(t, sys.procs(), RESTRINGIFY, asked, "the host still prints -0 as 0");
  return t.report();
}

/**
 * Duplicate object keys are all retained.
 *
 * JS keeps last-wins and collapses to one key. RFC 8259 leaves the behaviour undefined, and a tree
 * that drops members cannot round-trip its input.
 */
export async string test_duplicate_object_keys_are_all_retained(Sys sys) {
  T t = T.create();
  string src = "{\"a\":1,\"a\":2}";
  Result<u8[], JsonError> got = canonicalize(src.toBytes());
  t.eqStr(faultOf(got), "", "the document parses");
  t.eqStr(string.fromBytes(got.orElse(u8[]())), src, "and both members survive");
  Asked asked = Asked.create();
  asked.add(question(src.toBytes()), "{\"a\":2}");
  await agree(t, sys.procs(), RESTRINGIFY, asked, "the host still collapses them");
  return t.report();
}

export async string test_deep_nesting_inside_the_depth_limit(Sys sys) {
  T t = T.create();
  i32[] depths = [1, 10, 100, 399];
  Asked asked = Asked.create();
  for (i32 d = 0; d < depths.len(); d++) {
    string src = repeated("[", depths[d]) + repeated("]", depths[d]);
    Result<u8[], JsonError> got = canonicalize(src.toBytes());
    t.eqStr(faultOf(got), "", "depth \{depths[d]} should parse");
    if (got.isOk()) { asked.add(question(src.toBytes()), string.fromBytes(got.orElse(u8[]()))); }
  }
  await agree(t, sys.procs(), RESTRINGIFY, asked, "deep nesting");
  return t.report();
}

export string test_the_depth_limit_rejects_rather_than_exhausting_the_stack() {
  T t = T.create();
  string src = repeated("[", 500) + repeated("]", 500);
  t.eqStr(faultOf(canonicalize(src.toBytes())), "too deep", "500 deep is refused by the depth limit");
  return t.report();
}

string repeated(string s, i32 times) {
  string out = "";
  for (i32 i = 0; i < times; i++) { out = out + s; }
  return out;
}
