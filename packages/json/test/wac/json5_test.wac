// JSON5, measured against the implementation the format is defined by.
//
// The corpus in `../vendor/json5.json` records what `npm:json5@2.2.3` does with 467 inputs — see
// `../../tools/vendorJson5.ts` for how it is built and, more usefully, for the two shapes it
// deliberately cannot contain. Nothing here decides what JSON5 means; it only checks that this
// package agrees with something that already does.
//
// The last two tests are the other half, and need no vendoring: **JSON5 is a superset of JSON**, so
// for every document the JSON parser accepts, the JSON5 parser has to accept it and produce the same
// tree. The JSONTestSuite corpus already in this directory is ~300 documents of adversarial JSON,
// and running it through the new path costs nothing. That invariant is also the oracle for duplicate
// and index-like member names, which the vendored comparison cannot see.
//
// ## Host-side until 2026-08-18, `issues/system/0161`
//
// **The reference half stayed TypeScript, because it is the reference.** Four of these six tests
// compare this package's two entry points against each other and ask the host nothing at all. The
// first needs `JSON.stringify`'s number spelling, which is a fact about the reference rather than
// about a harness, so it goes through `../oracle.ts` — the same file the other wac tests here use.
//
// **The corpus is served by the oracle rather than read here**, which is the one thing that changed
// shape in the move. Reading `vendor/json5.json` from wac would mean parsing it with the parser
// under test, and a misread would arrive as hundreds of disagreements about JSON5 rather than as one
// about the harness. So `json5corpus` hands over the inputs and `json5cmp` keeps the expected
// answers on the far side entirely: two batches, two processes, and no shared implementation
// between the question and the answer.

import { T } from "../../../wactest/src/assert.wac";
import { Answers, Lines, ask, hex } from "../../../wactest/src/oracle.wac";
import { endsWith, joined } from "../../../wactest/src/strings.wac";
import { Core, Cli, FileResult } from "std";
import { Result } from "core";
import { decoded } from "../../../codec/src/hex.wac";
import { canonicalize, canonicalizeJson5, parse, parseJson5 } from "../../src/json.wac";
import { JsonValue } from "../../src/value.wac";
import { JsonError } from "../../src/parse.wac";

static string ORACLE = "packages/json/test/oracle.ts";
static string DIR = "packages/json/test/jsontestsuite";

/**
 * The oracle, with read access and nothing else.
 *
 * `askDeno` runs it with no grants at all, which is right for the ops that only compute — and this
 * is the one that reads the vendored corpus off disk. Granted here rather than by widening the
 * shared helper: every other caller of it would then be running with a capability none of them
 * needs, and the grant would stop saying anything about who actually uses it.
 */
Answers askOracle(T t, Cli cli, Lines lines, string what) {
  return ask(t, cli, "deno", ["run", "--allow-read", "--no-check", ORACLE], lines, what);
}

/**
 * Inputs where this parser knowingly answers differently, each with the reason.
 *
 * **Every entry is asserted to actually diverge.** A list of exceptions that have quietly been fixed
 * is worse than no list: it goes on excusing a case that now passes, and the next real divergence
 * gets added to it by someone who reads the list as normal. So a case here that agrees with the
 * reference fails the test and asks to be deleted.
 */
string[] knownInputs() {
  return [
    // An unquoted member name outside ASCII. ECMAScript's IdentifierName is a Unicode category
    // question; the tables could be generated but would be linked into every program that parses
    // JSON, so parseKey refuses with ERR_UNSUPPORTED rather than guessing. Quoting the name works.
    "{é:1}",
    "{é:1,b:2}",
    // A \uXXXX escape inside an unquoted member name. Allowed by ECMAScript, refused here for the
    // same reason: deciding whether the escaped character may appear in a name is the Unicode
    // question again, and the answer would be right only for ASCII.
    "{\\u0041:1}",
    "{\\u0041:1,b:2}",
    // The continuation branches. Listed separately because they are reached by different code from
    // the leading-character ones, and until the corpus contained them neither branch ran at all.
    "{aé:1}",
    "{aé:1,b:2}",
    "{a1é:1}",
    "{a1é:1,b:2}",
    "{a\\u0041:1}",
    "{a\\u0041:1,b:2}",
    "{$a\\u0042:1}",
    "{$a\\u0042:1,b:2}"
  ];
}

bool isKnown(string input) {
  string[] known = knownInputs();
  for (i32 i = 0; i < known.len(); i++) { if (known[i] == input) { return true; } }
  return false;
}

export string test_every_vendored_case_agrees_with_the_reference(Core core, Cli cli) {
  T t = T.create();

  // Batch one: the inputs. One request line, one answer per case.
  Lines want = Lines.create();
  want.add("json5corpus");
  Answers got = askOracle(t, cli, want, "the json5 corpus");
  if (!got.ok) { return t.report(); }
  t.isTrue(got.lines.len() > 400,
           "only \{got.lines.len()} corpus cases came back — the corpus is not being read");
  if (got.lines.len() <= 400) { return t.report(); }

  string[] inputs = string[].filled(got.lines.len(), "");
  for (i32 i = 0; i < got.lines.len(); i++) {
    string line = got.lines[i];
    i32 sp = line.indexOf(" ");
    if (sp < 0) {
      t.fail("corpus line \{i} is not `case <hex>`: \{line}");
      return t.report();
    }
    inputs[i] = string.fromBytes(decoded(line.slice(sp + 1, line.len())));
  }

  // Batch two: our answer for each, adjudicated against the vendored one.
  Lines asked = Lines.create();
  for (i32 i = 0; i < inputs.len(); i++) {
    u8[]? ours = canonicalizeJson5(inputs[i].toBytes()).ok();
    asked.add("json5cmp \{i} " + (ours is not null ? "1" : "0") + " " + hex(ours ?? u8[]()));
  }
  Answers verdicts = askOracle(t, cli, asked, "the json5 comparison");
  if (!verdicts.ok) { return t.report(); }
  t.eqI32(verdicts.lines.len(), inputs.len(), "a verdict per case");
  if (verdicts.lines.len() != inputs.len()) { return t.report(); }

  string[] wrong = string[].filled(8, "");
  i32 nWrong = 0;
  i32 divergedAsExpected = 0;
  for (i32 i = 0; i < inputs.len(); i++) {
    string v = verdicts.lines[i];
    if (v == "agree") {
      if (isKnown(inputs[i])) {
        if (nWrong < wrong.len()) {
          wrong[nWrong] = "\"\{inputs[i]}\" is listed as a known divergence but now agrees — " +
                          "delete the entry";
          nWrong = nWrong + 1;
        }
      }
      continue;
    }
    if (isKnown(inputs[i])) { divergedAsExpected = divergedAsExpected + 1; continue; }
    if (nWrong < wrong.len()) {
      i32 sp = v.indexOf(" ");
      wrong[nWrong] = sp < 0 ? v : string.fromBytes(decoded(v.slice(sp + 1, v.len())));
      nWrong = nWrong + 1;
    } else {
      nWrong = nWrong + 1;
    }
  }

  // Every entry in the list above has to have been reached. A known divergence that stopped being
  // one is caught by the `agree` branch; one whose input left the corpus is caught here.
  t.eqI32(divergedAsExpected, knownInputs().len(),
          "the known-divergence list has \{knownInputs().len()} entries and " +
          "\{divergedAsExpected} of them diverged");

  string[] tell = string[].filled(nWrong < wrong.len() ? nWrong : wrong.len(), "");
  for (i32 i = 0; i < tell.len(); i++) { tell[i] = wrong[i]; }
  t.eqI32(nWrong, 0, "\{nWrong} of \{inputs.len()}" +
                     " disagree with npm:json5@2.2.3: " + joined(tell, " | "));
  return t.report();
}

export string test_the_comparison_can_fail(Core core, Cli cli) {
  // Two runs of a parser against a corpus it was tuned on agree perfectly, and so does a comparison
  // that never ran. These are the two answers the loop above can give, forced.
  T t = T.create();
  u8[]? accepted = canonicalizeJson5("{a:1}".toBytes()).ok();
  t.isTrue(accepted is not null, "an unquoted member name is accepted");
  if (accepted is not null) { t.eqStr(string.fromBytes(accepted!), "{\"a\":1}", "the canonical form"); }
  t.isTrue(canonicalizeJson5("{a:1".toBytes()).isErr(), "an unterminated object was accepted");
  return t.report();
}

export string test_an_unquoted_non_ascii_name_is_refused_by_name_not_by_accident(Core core, Cli cli) {
  // The refusal in parseKey is the documented gap, so it has its own fault. Reporting `Unexpected`
  // instead would read as "that is not a name", which is untrue.
  T t = T.create();
  t.eqStr(canonicalizeJson5("{é:1}".toBytes()).err()?.text() ?? "", "unsupported at byte 1",
          "refused as unsupported");
  u8[]? quoted = canonicalizeJson5("{'é':1}".toBytes()).ok();
  t.isTrue(quoted is not null, "the quoted form must still work");
  if (quoted is not null) { t.eqStr(string.fromBytes(quoted!), "{\"é\":1}", "the quoted form's value"); }
  return t.report();
}

export string test_an_unterminated_block_comment_reports_where_it_opened(Core core, Cli cli) {
  T t = T.create();
  // At the opening delimiter, not at the end of the input where the parser noticed.
  t.eqStr(canonicalizeJson5("[1, /* unterminated".toBytes()).err()?.text() ?? "", "open comment at byte 4",
          "refused as an open comment, where it opened");
  return t.report();
}

export string test_json5_accepts_every_json_document_with_the_same_tree(Core core, Cli cli) {
  T t = T.create();
  string[]? entries = cli.readDir(DIR).wait();
  t.isTrue(entries is not null, "the JSONTestSuite corpus is listable");
  if (entries is null) { return t.report(); }

  string[] wrong = string[].filled(8, "");
  i32 nWrong = 0;
  i32 compared = 0;
  string[] names = entries!;
  for (i32 i = 0; i < names.len(); i++) {
    if (!endsWith(names[i], ".json")) { continue; }
    FileResult r = cli.readFile("\{DIR}/\{names[i]}").wait();
    if (!r.ok) { t.fail("cannot read \{names[i]} — \{r.error}"); continue; }
    u8[]? asJson = canonicalize(r.bytes).ok();
    if (asJson is null) { continue; }      // not JSON, so this invariant says nothing
    compared = compared + 1;
    Result<u8[], JsonError> asJson5 = canonicalizeJson5(r.bytes);
    JsonError? refused = asJson5.err();
    if (refused is not null) {
      if (nWrong < wrong.len()) {
        wrong[nWrong] = "\{names[i]}: JSON accepts it, JSON5 rejects it: \{refused!.text()}";
        nWrong = nWrong + 1;
      } else { nWrong = nWrong + 1; }
      continue;
    }
    string a = string.fromBytes(asJson!);
    string b = string.fromBytes(asJson5.unwrap());
    if (a == b) { continue; }
    if (nWrong < wrong.len()) {
      wrong[nWrong] = "\{names[i]}: JSON gives \{a}, JSON5 gives \{b}";
      nWrong = nWrong + 1;
    } else { nWrong = nWrong + 1; }
  }

  t.isTrue(compared >= 90, "only \{compared} documents were compared — the corpus is " +
                           "not being read");
  string[] tell = string[].filled(nWrong < wrong.len() ? nWrong : wrong.len(), "");
  for (i32 i = 0; i < tell.len(); i++) { tell[i] = wrong[i]; }
  t.eqI32(nWrong, 0, "\{nWrong} of \{compared} differ between the two modes: " +
                     joined(tell, " | "));
  return t.report();
}

export string test_a_comment_is_not_accepted_by_the_json_parser(Core core, Cli cli) {
  // The reason this is a second entry point rather than a widening of the first. A file written with
  // comments and read back with `parse` has to fail, or the two ends disagree silently.
  T t = T.create();
  u8[] withComment = "{/*c*/}".toBytes();
  t.isTrue(canonicalize(withComment).isErr(), "the JSON parser accepted a comment");
  u8[]? asJson5 = canonicalizeJson5(withComment).ok();
  t.isTrue(asJson5 is not null, "the JSON5 parser rejected a comment");
  if (asJson5 is not null) {
    t.eqStr(string.fromBytes(asJson5!), "{}",
            "a document that is only a comment inside an object is an empty object");
  }
  return t.report();
}

/**
 * `parseJson5` itself — the entry point that returns a *tree*, which nothing in this package called.
 *
 * Every other test here goes through `canonicalizeJson5`, which parses and then re-serialises, so the
 * tree is compared as text. That is the right check for the vendored corpus and it never touches the
 * function `packages/wacpkg` actually calls: `wac.json5` and `wac.lock` are read with `parseJson5` and
 * walked as a tree. `issues/system/0205` listed `json.wac:39` as an uncovered *entry* — a function
 * nobody called, tested only through a consumer in another package.
 *
 * The tree is walked rather than re-serialised, because that is what its caller does and because a
 * value that arrives with the wrong tag is invisible to a text comparison that happens to agree.
 */
export string test_the_json5_tree_is_walkable_and_json_refuses_the_same_document() {
  T t = T.create();
  string src = "{\n" +
               "  // a comment, which JSON has no room for\n" +
               "  unquoted: 'single quoted',\n" +
               "  nested: { n: 1.5, hex: 0xFF, },\n" +
               "  list: [1, 2, 3,],\n" +
               "}\n";

  JsonValue? doc = parseJson5(src.toBytes()).ok();
  t.isTrue(doc is not null, "JSON5 with comments and unquoted keys did not parse");
  if (doc is null) { return t.report(); }

  t.isTrue(doc!.object() is not null, "the document is not an object");
  t.eqStr(doc!.member("unquoted")?.text() ?? "", "single quoted", "the single-quoted value of the unquoted key");
  t.eqF64(doc!.member("nested")?.member("hex")?.number() ?? 0.0, 255.0, "a hexadecimal number");
  t.eqI32(doc!.member("list")?.array()?.len() ?? 0, 3, "a trailing comma added no element");

  // **And the strict parser refuses it**, which is the whole reason this is a second entry point:
  // "a parser that quietly accepted a comment would let one into a file the other end reads with
  // `parse`". A `parseJson5` that had been wired to the strict parser by mistake would pass every
  // assertion above and fail this one.
  t.isTrue(parse(src.toBytes()).isErr(), "the strict parser accepted a JSON5 document");

  // Every JSON document is a JSON5 one, which is the other half of the claim in the doc comment.
  string plain = "{\"a\":[1,2,{\"b\":null}],\"c\":true}";
  t.isTrue(parseJson5(plain.toBytes()).isOk(), "JSON5 refused a plain JSON document");
  t.isTrue(parse(plain.toBytes()).isOk(), "and the strict parser accepts it too");

  // Not JSON5 either, so the refusal above means "refused" rather than "always refuses".
  t.isTrue(parseJson5("{oops".toBytes()).isErr(), "JSON5 accepted an unterminated object");
  return t.report();
}
