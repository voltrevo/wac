    bad = bad + 1;
  }
  if (ac__an_account_is_read_out_of_the_state_trie_fields_and_all(core, cli).len() > 0) {
    core.warn("error: FAILED account_test test_an_account_is_read_out_of_the_state_trie_fields_and_all");
    bad = bad + 1;
  }
  if (ac__an_address_the_state_has_never_seen_is_proved_absent(core, cli).len() > 0) {
    core.warn("error: FAILED account_test test_an_address_the_state_has_never_seen_is_proved_absent");
    bad = bad + 1;
  }
  if (ac__a_slot_is_read_out_of_the_storage_trie_under_the_root_the_account_gave(core, cli).len() > 0) {
    core.warn("error: FAILED account_test test_a_slot_is_read_out_of_the_storage_trie_under_the_root_the_account_gave");
    bad = bad + 1;
  }
  if (ac__a_slot_that_was_never_written_is_absent_which_is_how_zero_is_stored(core, cli).len() > 0) {
    core.warn("error: FAILED account_test test_a_slot_that_was_never_written_is_absent_which_is_how_zero_is_stored");
    bad = bad + 1;
  }
  if (ac__an_account_with_no_storage_refuses_a_storage_proof_from_another_account(core, cli).len() > 0) {
    core.warn("error: FAILED account_test test_an_account_with_no_storage_refuses_a_storage_proof_from_another_account");
    bad = bad + 1;
  }
  if (ac__the_accounts_own_bytes_are_checked_not_just_the_path_to_them(core, cli).len() > 0) {
    core.warn("error: FAILED account_test test_the_accounts_own_bytes_are_checked_not_just_the_path_to_them");
    bad = bad + 1;
  }
  if (ac__a_slots_stored_value_must_be_canonical_rlp_of_at_most_32_bytes(core, cli).len() > 0) {
    core.warn("error: FAILED account_test test_a_slots_stored_value_must_be_canonical_rlp_of_at_most_32_bytes");
    bad = bad + 1;
  }
  if (ac__an_address_is_twenty_bytes_and_a_slot_key_is_thirty_two(core, cli).len() > 0) {
    core.warn("error: FAILED account_test test_an_address_is_twenty_bytes_and_a_slot_key_is_thirty_two");
    bad = bad + 1;
  }
  if (gp__an_account_with_storage_verifies_against_a_real_state_root(core, cli).len() > 0) {
    core.warn("error: FAILED getproof_test test_an_account_with_storage_verifies_against_a_real_state_root");
    bad = bad + 1;
  }
  if (gp__an_account_that_does_not_exist_is_proved_absent(core, cli).len() > 0) {
    core.warn("error: FAILED getproof_test test_an_account_that_does_not_exist_is_proved_absent");
    bad = bad + 1;
  }
  if (gp__a_funded_account_with_no_storage(core, cli).len() > 0) {
    core.warn("error: FAILED getproof_test test_a_funded_account_with_no_storage");
    bad = bad + 1;
  }
  if (gp__the_clients_roots_are_this_packages_constants(core, cli).len() > 0) {
    core.warn("error: FAILED getproof_test test_the_clients_roots_are_this_packages_constants");
    bad = bad + 1;
  }
  if (gp__a_proof_from_one_account_does_not_verify_against_another(core, cli).len() > 0) {
    core.warn("error: FAILED getproof_test test_a_proof_from_one_account_does_not_verify_against_another");
    bad = bad + 1;
  }
  if (mf__a_leaf_whose_value_is_a_list_is_refused().len() > 0) {
    core.warn("error: FAILED malformed_test test_a_leaf_whose_value_is_a_list_is_refused");
    bad = bad + 1;
  }
  if (mf__a_branch_terminal_that_is_a_list_is_refused().len() > 0) {
    core.warn("error: FAILED malformed_test test_a_branch_terminal_that_is_a_list_is_refused");
    bad = bad + 1;
  }
  if (mf__a_hex_prefix_header_that_is_a_list_is_refused().len() > 0) {
    core.warn("error: FAILED malformed_test test_a_hex_prefix_header_that_is_a_list_is_refused");
    bad = bad + 1;
  }
  if (mf__an_account_field_that_is_a_list_is_refused().len() > 0) {
    core.warn("error: FAILED malformed_test test_an_account_field_that_is_a_list_is_refused");
    bad = bad + 1;
  }
  if (mf__absence_from_an_empty_trie_is_proved_by_no_nodes().len() > 0) {
    core.warn("error: FAILED malformed_test test_absence_from_an_empty_trie_is_proved_by_no_nodes");
    bad = bad + 1;
  }
  if (mf__no_nodes_against_any_other_root_proves_nothing().len() > 0) {
    core.warn("error: FAILED malformed_test test_no_nodes_against_any_other_root_proves_nothing");
    bad = bad + 1;
  }
  if (mf__a_slot_of_an_account_with_no_storage_is_absent().len() > 0) {
    core.warn("error: FAILED malformed_test test_a_slot_of_an_account_with_no_storage_is_absent");
    bad = bad + 1;
  }
  if (pr__the_oracles_keccak256_is_keccak256(core, cli).len() > 0) {
    core.warn("error: FAILED proof_test test_the_oracles_keccak256_is_keccak256");
