  if (pr__a_refusal_names_the_hashes_it_could_not_reconcile(core, cli).len() > 0) {
    core.warn("error: FAILED proof_test test_a_refusal_names_the_hashes_it_could_not_reconcile");
    bad = bad + 1;
  }
  if (pr__every_perturbation_of_a_valid_proof_is_refused(core, cli).len() > 0) {
    core.warn("error: FAILED proof_test test_every_perturbation_of_a_valid_proof_is_refused");
    bad = bad + 1;
  }
  if (pr__a_trie_the_shape_ethereums_actually_are_keccak_keys_32_byte_values_deep_paths(core, cli).len() > 0) {
    core.warn("error: FAILED proof_test test_a_trie_the_shape_ethereums_actually_are_keccak_keys_32_byte_values_deep_paths");
    bad = bad + 1;
  }
  if (bad > 0) { core.warn("mpt: " + itoa(bad) + " test(s) failed under the coverage driver"); }
  return bad;
}
