// Type strings to the descriptor `packages/abi` walks, and the hex either side of it.
//
// One copy, imported by both differential tests. The host-side versions had two — `abi_wac.test.ts`
// and `cast.test.ts` each carried their own `descriptor` and `splitTuple`, and they had already
// drifted: one counted `[` and `]` towards the nesting depth and the other did not, which is the
// difference between splitting `(uint256[2],bool)` correctly and splitting it inside the brackets.
// Neither test could see it, because neither had a case that reached it.
//
// Not a test file and not discovered as one: `wac test` walks `*_test.wac`. `issues/system/0161`.

// The descriptor tags, as these tests believe them.
// `corpus_test.wac`'s last case is what keeps the belief honest.
export const i32 T_UINT = 1;
export const i32 T_BOOL = 2;
export const i32 T_ADDRESS = 3;
export const i32 T_BYTES32 = 4;
export const i32 T_BYTES = 5;
export const i32 T_STRING = 6;
export const i32 T_ARRAY = 7;
export const i32 T_FIXED = 8;
export const i32 T_TUPLE = 9;

// ── Hex ───────────────────────────────────────────────────────────────────────

i32 nibble(i32 c) {
  if (c >= '0' && c <= '9') { return c - '0'; }
  if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
  if (c >= 'A' && c <= 'F') { return c - 'A' + 10; }
  trap;
}

export u8[] unhex(string s) {
  u8[] d = s.toBytes();
  if (d.len() % 2 != 0) { trap; }
  u8[] out = u8[d.len() / 2]();
  for (i32 i = 0; i < out.len(); i++) { out[i] = nibble(d[i * 2]) * 16 + nibble(d[i * 2 + 1]); }
  return out;
}

export string hex(u8[] b) {
  string digits = "0123456789abcdef";
  string out = "";
  for (i32 i = 0; i < b.len(); i++) {
    out = out + digits.slice(b[i] / 16, b[i] / 16 + 1) + digits.slice(b[i] % 16, b[i] % 16 + 1);
  }
  return out;
}

// ── Type strings to descriptors ───────────────────────────────────────────────

/** A growable i32 list, because a descriptor's length is not known until it is built. */
export struct Ints {
  i32[] xs;
  i32 n;

  void push(this, i32 v) {
    if (this.n == this.xs.len()) {
      i32[] bigger = i32[this.xs.len() * 2 + 8]();
      for (i32 i = 0; i < this.n; i++) { bigger[i] = this.xs[i]; }
      this.xs = bigger;
    }
    this.xs[this.n] = v;
    this.n = this.n + 1;
  }

  i32[] take(this) {
    i32[] out = i32[this.n]();
    for (i32 i = 0; i < this.n; i++) { out[i] = this.xs[i]; }
    return out;
  }

  Ints create() { return Ints(i32[16](), 0); }
}

bool startsWith(string s, string p) { return s.len() >= p.len() && s.slice(0, p.len()) == p; }
bool endsWith(string s, string p) {
  return s.len() >= p.len() && s.slice(s.len() - p.len(), s.len()) == p;
}

i32 lastIndexOf(string s, string needle) {
  i32 found = -1;
  i32 at = 0;
  while (at < s.len()) {
    i32 hit = s.slice(at, s.len()).indexOf(needle);
    if (hit < 0) { return found; }
    found = at + hit;
    at = found + 1;
  }
  return found;
}

i32 decimal(string s) {
  i32 v = 0;
  u8[] d = s.toBytes();
  for (i32 i = 0; i < d.len(); i++) {
    if (d[i] < '0' || d[i] > '9') { trap; }
    v = v * 10 + (d[i] - '0');
  }
  return v;
}

/** An ethers type string as the descriptor `packages/abi` walks. */
export void writeDescriptor(Ints out, string type) {
  if (endsWith(type, "]")) {
    i32 open = lastIndexOf(type, "[");
    string inner = type.slice(0, open);
    string size = type.slice(open + 1, type.len() - 1);
    if (size == "") {
      out.push(T_ARRAY);
    } else {
      out.push(T_FIXED);
      out.push(decimal(size));
    }
    writeDescriptor(out, inner);
    return;
  }
  if (startsWith(type, "(")) {
    string[] members = splitTuple(type);
    out.push(T_TUPLE);
    out.push(members.len());
    for (i32 i = 0; i < members.len(); i++) { writeDescriptor(out, members[i]); }
    return;
  }
  if (type == "bool") { out.push(T_BOOL); return; }
  if (type == "address") { out.push(T_ADDRESS); return; }
  if (type == "bytes") { out.push(T_BYTES); return; }
  if (type == "string") { out.push(T_STRING); return; }
  if (type == "bytes32") { out.push(T_BYTES32); return; }
  if (startsWith(type, "uint") || startsWith(type, "int")) { out.push(T_UINT); return; }
  trap;   // no descriptor for this type, which is a gap in this translation rather than in the codec
}

string[] splitTuple(string t) {
  string body = t.slice(1, t.len() - 1);
  string[] out = string[64](fill: "");
  i32 n = 0;
  i32 depth = 0;
  i32 start = 0;
  u8[] b = body.toBytes();
  for (i32 i = 0; i <= b.len(); i++) {
    if (i == b.len() || (b[i] == ',' && depth == 0)) {
      if (i > start) { out[n] = body.slice(start, i); n = n + 1; }
      start = i + 1;
    } else if (b[i] == '(' || b[i] == '[') { depth = depth + 1; }
    else if (b[i] == ')' || b[i] == ']') { depth = depth - 1; }
  }
  string[] exact = string[n](fill: "");
  for (i32 i = 0; i < n; i++) { exact[i] = out[i]; }
  return exact;
}

