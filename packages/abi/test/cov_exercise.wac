// Branch coverage for abi: the package's own tests, and nothing else.
//
//   deno task coverage:abi
//   deno task coverage:abi --verbose
//
// The fifth of the packages `issues/system/0205` records as unmeasured, and the last of the four that
// Ethereum's decode stack rests on — `rlp`, `mpt`, `ssz` and this. All three before it had their
// canonicity rules unexercised, for one reason: their corpora are real data, and real data contains
// nothing the tools that produced it would never emit. ABI has the same shape of rule and its own
// version of the aliasing question, since a dynamic value is reached through an offset a caller wrote.
//
// Unlike the other three this package *does* carry a `strictness_test.wac` and two refusal tests in
// its corpus file, so — as with `packages/mpt`'s `malformed_test.wac` — the question is whether that
// shows up as a smaller first gap.
//
// None of the nine tests expects a trap.

import { Core, Cli } from "std/platform.wac";
import { itoa } from "../../fmt/src/itoa.wac";
import {
  test_a_bool_is_a_padded_zero_or_one_and_nothing_else as al__a_bool_is_a_padded_zero_or_one_and_nothing_else,
  test_an_element_offset_cannot_point_into_the_head_or_past_the_end as al__an_element_offset_cannot_point_into_the_head_or_past_the_end,
  test_a_word_that_cannot_be_an_index_is_refused_rather_than_wrapped as al__a_word_that_cannot_be_an_index_is_refused_rather_than_wrapped,
  test_an_accessor_asked_for_the_wrong_variant_answers_an_empty_default as al__an_accessor_asked_for_the_wrong_variant_answers_an_empty_default,
  test_encoding_a_value_of_the_wrong_shape_says_which_and_where as al__encoding_a_value_of_the_wrong_shape_says_which_and_where,
} from "./wac/aliasing_test.wac";
import {
  test_bytes_another_implementation_produced_round_trip as ca__bytes_another_implementation_produced_round_trip,
} from "./wac/cast_test.wac";
import {
  test_every_case_decodes_to_what_ethers_says_it_means as co__every_case_decodes_to_what_ethers_says_it_means,
  test_and_re_encodes_to_the_bytes_ethers_produced as co__and_re_encodes_to_the_bytes_ethers_produced,
  test_the_nested_cases_are_actually_in_the_corpus as co__the_nested_cases_are_actually_in_the_corpus,
  test_a_malformed_offset_or_length_is_refused as co__a_malformed_offset_or_length_is_refused,
  test_a_value_that_does_not_fit_its_type_is_refused as co__a_value_that_does_not_fit_its_type_is_refused,
  test_the_descriptor_tags_are_what_this_file_thinks as co__the_descriptor_tags_are_what_this_file_thinks,
} from "./wac/corpus_test.wac";
import {
  test_every_malformation_is_refused_and_says_which_rule as st__every_malformation_is_refused_and_says_which_rule,
  test_the_table_of_what_the_real_tools_do_is_still_true as st__the_table_of_what_the_real_tools_do_is_still_true,
} from "./wac/strictness_test.wac";

export i32 main(Core core, Cli cli) {
  i32 bad = 0;
  if (al__encoding_a_value_of_the_wrong_shape_says_which_and_where().len() > 0) {
    core.warn("error: FAILED aliasing_test test_encoding_a_value_of_the_wrong_shape_says_which_and_where");
    bad = bad + 1;
  }
  if (al__an_accessor_asked_for_the_wrong_variant_answers_an_empty_default().len() > 0) {
    core.warn("error: FAILED aliasing_test test_an_accessor_asked_for_the_wrong_variant_answers_an_empty_default");
    bad = bad + 1;
  }
  if (al__a_bool_is_a_padded_zero_or_one_and_nothing_else().len() > 0) {
    core.warn("error: FAILED aliasing_test test_a_bool_is_a_padded_zero_or_one_and_nothing_else");
    bad = bad + 1;
  }
  if (al__an_element_offset_cannot_point_into_the_head_or_past_the_end().len() > 0) {
    core.warn("error: FAILED aliasing_test test_an_element_offset_cannot_point_into_the_head_or_past_the_end");
    bad = bad + 1;
  }
  if (al__a_word_that_cannot_be_an_index_is_refused_rather_than_wrapped().len() > 0) {
    core.warn("error: FAILED aliasing_test test_a_word_that_cannot_be_an_index_is_refused_rather_than_wrapped");
    bad = bad + 1;
  }
  if (ca__bytes_another_implementation_produced_round_trip(core, cli).len() > 0) {
    core.warn("error: FAILED cast_test test_bytes_another_implementation_produced_round_trip");
    bad = bad + 1;
  }
  if (co__every_case_decodes_to_what_ethers_says_it_means(core, cli).len() > 0) {
    core.warn("error: FAILED corpus_test test_every_case_decodes_to_what_ethers_says_it_means");
    bad = bad + 1;
  }
  if (co__and_re_encodes_to_the_bytes_ethers_produced(core, cli).len() > 0) {
    core.warn("error: FAILED corpus_test test_and_re_encodes_to_the_bytes_ethers_produced");
    bad = bad + 1;
  }
  if (co__the_nested_cases_are_actually_in_the_corpus(core, cli).len() > 0) {
    core.warn("error: FAILED corpus_test test_the_nested_cases_are_actually_in_the_corpus");
    bad = bad + 1;
  }
  if (co__a_malformed_offset_or_length_is_refused().len() > 0) {
    core.warn("error: FAILED corpus_test test_a_malformed_offset_or_length_is_refused");
    bad = bad + 1;
  }
  if (co__a_value_that_does_not_fit_its_type_is_refused().len() > 0) {
    core.warn("error: FAILED corpus_test test_a_value_that_does_not_fit_its_type_is_refused");
    bad = bad + 1;
  }
  if (co__the_descriptor_tags_are_what_this_file_thinks().len() > 0) {
    core.warn("error: FAILED corpus_test test_the_descriptor_tags_are_what_this_file_thinks");
    bad = bad + 1;
  }
  if (st__every_malformation_is_refused_and_says_which_rule().len() > 0) {
    core.warn("error: FAILED strictness_test test_every_malformation_is_refused_and_says_which_rule");
    bad = bad + 1;
  }
  if (st__the_table_of_what_the_real_tools_do_is_still_true(core, cli).len() > 0) {
    core.warn("error: FAILED strictness_test test_the_table_of_what_the_real_tools_do_is_still_true");
    bad = bad + 1;
  }
  if (bad > 0) { core.warn("abi: " + itoa(bad) + " test(s) failed under the coverage driver"); }
  return bad;
}
