// The shell in a terminal drawn on pixels — `design/system/0004` step 4's own criterion.
//
//   wac run --allow-read --allow-write --allow-run packages/web/tools/build.wac \
//     packages/box/example/rasterterm.wac .cache/rasterterm --page ./packages/web --grant read,write --spawn applet
//
// `packages/box/example/term.wac` is the same shell in a `<pre>` and an `<input>`, where the browser
// does the wrapping, the scrolling and the caret. This one has a `<canvas>` and does all three
// itself: `Session` is the shell with no page in it, `Grid` is the model the DOM was providing, and
// `Surface` turns it into bytes that `drawPixels` blits.
//
// **This is where the integration lives, not in `packages/raster`.** A renderer that imported a shell
// would be a renderer nobody could use for anything else, and `packages/raster` has no dependencies
// on purpose. A program is allowed to know about both.
//
// All three of the things this said it did not do yet are wired now: PgUp and PgDn move `back` over
// the grid's scrollback, a drag selects, and the caret blinks on a timer waited on beside the keys. Like
// `term.wac` it is a `packages/web` page, and a command runs as a task, so `^C` stops it. What is still
// missing is the end of the selection story — `Grid.selectedText` exists and nothing here calls it,
// so text can be selected and not copied out.

import { Core, Cli, Sys } from "std";
import { Element, ElementEvent, Listen, MOD_CTRL, MOD_META, Node, Page, Ref, Ui, html.canvas, html.style } from "../../web";
import { Ticket, TicketBase } from "core";
import { Scalar, count, decode } from "../../unicode/src/utf8.wac";
import { Grid } from "../../raster/src/grid.wac";
import { Surface, cellHeight, cellWidth } from "../../raster/src/surface.wac";
import { boxApplet } from "../src/shrun.wac";
import { Session } from "../src/lib/session.wac";

/** What a copy of this page started by `spawnSelf` runs — `--spawn applet`, as in `term.wac`. */
export async i32 applet(Sys sys) { return await boxApplet(sys.core, sys.cli); }

static string STYLE = "body { margin: 0; background: #0b0e0f; } canvas { display: block; image-rendering: pixelated; }";

/** Eighty columns is what everything assumes, and twenty-four rows is a terminal. */
i32 COLS() { return 80; }
i32 ROWS() { return 24; }

/** How many scrolled-off lines to keep. A screen is 24, so this is about forty screens. */
i32 SCROLLBACK() { return 1000; }

/** Half a blink, in milliseconds. 500 is what a terminal does and what an eye reads as a caret. */
i32 BLINK() { return 500; }

i32 FG() { return 0xDCE8E7FF; }
i32 BG() { return 0x12181AFF; }

/** Code points from a string, through the decoder this repository already trusts. */
i32[] cps(string s) {
  u8[] bytes = s.toBytes();
  i32[] out = i32[].filled(count(bytes), 0);
  i32 at = 0;
  i32 n = 0;
  while (at < bytes.len() && n < out.len()) {
    Scalar sc = decode(bytes, at);
    if (sc.code < 0) { break; }
    out[n] = sc.code;
    n = n + 1;
    at = at + sc.size;
  }
  return out;
}

/**
 * Redraw the grid from the session's screen, keeping the last `ROWS()` lines.
 *
 * **The whole screen each time, rather than appending.** A shell's output is not a stream of cells —
 * a command can rewrite its line with `\r`, and `Session` hands back the text rather than a diff. So
 * the honest thing is to lay the tail out again, which is cheap at eighty by twenty-four and cannot
 * drift from what the session actually holds. Appending would be faster and would be a second model
 * of the screen, which is the thing that gets out of step.
 */
void relay(Grid g, string screen, string pending) {
  // **The whole session, not the tail that fits.** This used to walk backwards counting newlines and
  // lay out only the last screenful, which is why the grid's scrollback was always empty: lines only
  // reach it by *scrolling off*, and a layout that starts at the last screen boundary never scrolls
  // anything. Laying out everything makes the scrollback fill itself, which is what `drawFrom` reads.
  //
  // It costs a re-layout of the session per redraw. At eighty by twenty-four that is not worth
  // measuring against a keystroke, and the alternative — appending, and keeping a second model of
  // where the cursor is — is the thing the comment below already argues against.
  i32[] all = cps(screen + pending);
  g.scrollbackRows = 0;
  for (i32 r = 0; r < ROWS(); r++) {
    for (i32 c = 0; c < COLS(); c++) { g.cells[r * COLS() + c] = 0; }
  }
  g.curCol = 0;
  g.curRow = 0;
  for (i32 i = 0; i < all.len(); i++) { g.put(all[i]); }
}

/**
 * Draw the grid at `back` and blit only what changed.
 *
 * Shared by the scroll keys and the input path because they must agree: a scroll that redrew the
 * whole canvas and a keystroke that blitted a rectangle would be two ways of putting the same grid
 * on the same screen, and the one used less often is the one that goes wrong. The caret is drawn
 * where the cursor really is, which is off-screen while scrolled back — so it disappears, which is
 * the honest thing for a caret you cannot type at.
 */
void redraw(Element screen, Grid g, Surface surf, i32 back, bool caret) {
  surf.undamage();
  g.drawFrom(surf, 0, 0, FG(), BG(), back);
  if (back == 0 && caret) { g.drawCaret(surf, 0, 0, FG(), BG()); }
  if (surf.damaged()) {
    screen.pixelsIn(surf.dx0, surf.dy0, surf.dx1 - surf.dx0 + 1, surf.dy1 - surf.dy0 + 1, surf.damagedPixels());
  }
}

/**
 * The page, laid out once: one canvas, which the loop below owns. The canvas takes the keys, which is
 * why it has a `tabindex` — a `<canvas>` is not focusable otherwise, and a terminal nobody can type
 * into is a picture of a terminal.
 */
Node Layout(Ui ui, Ref screen) {
  return <canvas ref={screen} id="screen" tabindex="0"><style>{STYLE}</style></canvas>;
}

export async i32 main(Page page) {
  Sys sys = page.sys;
  Core core = sys.core;
  Cli cli = sys.cli;
  Ref at = Ref {};
  page.mount((Ui ui) => Layout(ui, at));
  Element screen = at.element()!;

  Session s = Session.start(core, cli, "rasterterm");
  Grid g = Grid.create(COLS(), ROWS(), SCROLLBACK());
  Surface surf = Surface.create(COLS() * cellWidth(), ROWS() * cellHeight());

  string typed = "";
  // How far the viewport is pushed back, in lines. Zero is the live screen, and typing returns to it:
  // a terminal that stayed scrolled back while you typed would hide what you were doing.
  i32 back = 0;
  // Whether a pointer button is down, so a move without one is not a drag.
  bool dragging = false;
  // Whether the caret is showing this half-blink. Reset to *on* by any activity: a caret that is
  // mid-blink when you press a key looks like a dropped keystroke.
  bool caretOn = true;
  s.say("\{s.prompt()} ");
  relay(g, s.screen, typed);
  g.drawFrom(surf, 0, 0, FG(), BG(), back);
  g.drawCaret(surf, 0, 0, FG(), BG());
  screen.pixels(surf.width, surf.height, surf.pixels);

  screen.listen("keydown", Listen.none());
  screen.listen("click", Listen.none());
  // Selection: a drag over the text. The pointer events carry canvas-relative coordinates, which is
  // what a `Surface` is indexed by, so the cell is a division and nothing more.
  screen.listen("pointerdown", Listen.none());
  screen.listen("pointermove", Listen.none());
  screen.listen("pointerup", Listen.none());

  // **The blink is a timer among the things waited on**: whichever of the next event, the half-blink and
  // a running command comes first. A command runs as a task, as in `term.wac`, so `^C` reaches it.
  Ticket<ElementEvent> next = screen.next();
  Ticket<i64> blink = core.sleepMillis(BLINK()).ticket();
  Ticket<void>? running = null;

  for (;;) {
    TicketBase[] parts = running is null
      ? [next, blink] as TicketBase[]
      : [next, blink, running!] as TicketBase[];
    i32 which = await Ticket.first(parts);
    if (which == 1) {
      blink = core.sleepMillis(BLINK()).ticket();
      // Only where a caret is drawn at all: scrolled back there is none, and blinking one that is
      // not there would redraw the whole screen twice a second for nothing.
      if (back == 0) {
        caretOn = !caretOn;
        if (running is not null) { relay(g, s.showing(), ""); }
        redraw(screen, g, surf, back, caretOn);
      }
      continue;
    }
    if (which == 2) {
      running = null;
      if (s.over()) { return s.code(); }
      s.say("\{s.prompt()} ");
      relay(g, s.screen, typed);
      redraw(screen, g, surf, back, caretOn);
      continue;
    }
    ElementEvent e = await next;
    next = screen.next();
    // **Activity restarts the blink phase, and a bare pointer move is not activity.** Typing, pressing
    // and releasing are activity; moving is only activity while dragging. `issues/system/0178`.
    if (e.kind != "pointermove" || dragging) {
      caretOn = true;
    }
    if (e.kind == "pointerdown") {
      dragging = true;
      g.selectFrom(e.x / cellWidth(), e.y / cellHeight());
      redraw(screen, g, surf, back, caretOn);
      continue;
    }
    if (e.kind == "pointermove") {
      if (!dragging) { continue; }
      g.selectTo(e.x / cellWidth(), e.y / cellHeight());
      redraw(screen, g, surf, back, caretOn);
      continue;
    }
    if (e.kind == "pointerup") {
      dragging = false;
      continue;
    }
    if (e.kind == "keydown") {
      string k = e.value;
      bool ctrl = (e.mods & (MOD_CTRL | MOD_META)) != 0;
      // `^C` while a command runs stops it, through the shell's own interrupt.
      if (ctrl && (k == "c" || k == "C")) {
        if (running is not null) { s.stop(); }
        else { s.say("\{typed}^C\n\{s.prompt()} "); typed = ""; }
        relay(g, s.screen, typed);
        redraw(screen, g, surf, back, caretOn);
        continue;
      }
      // **The scroll keys, before anything that types**: moving the viewport is the one action here
      // that must not touch the session.
      if (k == "PageUp") {
        back = back + ROWS() - 1;
        if (back > g.scrollbackRows) { back = g.scrollbackRows; }
        redraw(screen, g, surf, back, caretOn);
        continue;
      }
      if (k == "PageDown") {
        back = back - (ROWS() - 1);
        if (back < 0) { back = 0; }
        redraw(screen, g, surf, back, caretOn);
        continue;
      }
      // Keys that type nothing — Shift, an arrow, a function key — arrive by name; a character arrives
      // as itself, one code point long.
      bool typesText = !ctrl && cps(k).len() == 1;
      if (k != "Enter" && k != "Backspace" && !typesText) { continue; }
      if (running is not null) { continue; }
      // Any other key is input, and input follows the output: whatever you were reading, you are
      // now writing at the bottom — and the selection goes, as a terminal's does.
      back = 0;
      g.clearSelection();
      if (k == "Enter") {
        // Echo what was typed and run it as a task; the prompt comes back when it ends.
        s.say("\{typed}\n");
        running = s.feedLine(typed);
        typed = "";
      } else if (k == "Backspace") {
        if (typed.len() > 0) { typed = typed.slice(0, typed.len() - 1); }
      } else {
        typed = typed + k;
      }
    } else if (e.kind != "click") {
      continue;
    }

    relay(g, running is null ? s.screen : s.showing(), running is null ? typed : "");
    redraw(screen, g, surf, back, caretOn);
  }
  return 0;
}
