// A desktop, in a tab — design/0001 step 8, and the last of its eight steps to be started.
//
//   deno task app packages/box/example/desk.wac
//
// The design's own sentence: "`Page` has render, events and pixels; a window manager in wac over the
// same system, with the terminal as one window. Deliberately last: windows want something to show."
//
// There is something to show now. A tab holds a real system — `/bin` with sixty-odd programs, `/proc`
// with the process table, `/dev`, users, a shell that spawns its applets as actual children — so a
// window manager over it is showing the machine rather than decorating an empty one.
//
// ## What a window is here
//
// Markup, not pixels. `Page` has `drawPixels` and a terminal drawn that way would mean reimplementing
// text layout, selection, the caret and IME to get something worse than the browser already does. So a
// window is a `<div>` the manager positions, and the terminal's body is the `<pre>` and `<input>` that
// `example/term.wac` already uses.
//
// The manager owns `render` and re-renders the **frame** — which windows exist, where they sit, which
// is on top — while *content* goes through `setText` on a per-window id. That split is the whole of
// why typing does not flicker: a keystroke touches one text node, and only opening, closing or raising
// a window rebuilds the document.
//
// ## The one thing re-rendering costs, and what is done about it
//
// `render` replaces the markup, so the half-typed command in `#cmd` and the caret go with it. Raising a
// window while somebody is typing would eat their line. So the manager reads `#cmd` before it
// re-renders and puts it back after — which is what makes raise-on-click safe to do at all.
//
// ## What is *not* implemented, said rather than approximated
//
// **Dragging.** A window is where the manager put it. Moving one needs `pointermove` while a button is
// held, which is an event per pixel across the bridge, and the honest version of that is a design
// question about coalescing rather than something to bolt on. The positions are a cascade.
//
// **Resizing**, for the same reason, and **minimise**: there is no taskbar to minimise *to* yet.
//
// What is here is: several windows, each showing something live from the same system; raise and focus
// by clicking; close; and a terminal that is the whole terminal — the same `Session` the full-frame
// one uses, so `ls`, `ps`, a pipeline of spawned applets and `^C` all behave as they do everywhere
// else in this repository.

import { Cli, Core, Event, Page } from "../../platform/src/platform.wac";
import { itoa } from "../../fmt/src/itoa.wac";
import { Vec } from "../../std/src/vec.wac";
import { boxApplet } from "../src/shrun.wac";
import { UNKNOWN } from "../src/box.wac";
import { Session } from "../src/lib/session.wac";

/** This program is also its own applets, so the shell in a window can spawn them. */
export i32 main(Core core, Cli cli) { return boxApplet(core, cli); }

/** What a window shows. */
i32 SHELL() { return 0; }
i32 FILES() { return 1; }

/**
 * One window: what it shows, its own session where it is a terminal, and the id its markup carries.
 *
 * **The id is allocated once and never reused**, which is what lets a window be closed without
 * renumbering the others — the alternative is that `cls3` means a different window after every close,
 * and the event that arrives is about whichever window has moved into that slot.
 */
struct Win {
  i32 kind;
  i32 id;
  /** The session this window is a terminal for. Meaningless for a files window. */
  Session sh;
}

string cr() { return string.fromCodepoint(13); }
string intr() { return string.fromCodepoint(3); }
string upArrow() { return string.fromCodepoint(27) + "[A"; }
string downArrow() { return string.fromCodepoint(27) + "[B"; }

/** The window's title, which is also what its bar says. */
string titleOf(Win w) { return w.kind == SHELL() ? "shell " + itoa(w.id) : "files"; }

export i32 page(Core core, Cli cli, Page page) {
  page.title("wac desktop").wait();

  // **One filesystem, and every window is on it.** The first session builds the system — `/dev`,
  // `/proc`, `/bin`, the applets — and every terminal opened afterwards is `Session.startOn` over
  // that same `Fs`. Two terminals each building their own would be two machines that look alike, and
  // a desktop whose windows do not share a disk is a set of pictures.
  Session first = Session.start(core, cli, "desk");
  first.feedLine("mkdir -p /home/wac");
  first.feedLine("seq 1 5 > /home/wac/five");

  // Stacking order, front last. A `Vec` rather than a z-index per window because "which is on top" is
  // an order, and keeping it as one means raising is a move rather than a search for the maximum.
  Vec<Win> wins = Vec.create();
  wins.push(Win(SHELL(), 0, first));
  wins.push(Win(FILES(), 1, first));
  i32 nextId = 2;

  draw(page, wins);
  paint(page, wins);
  // Delegated selectors rather than ids: `render` replaces the elements, and a handler asked for by
  // id would stop firing the moment a window opened. Which window an event is about comes from
  // `Event.id`, which carries the element's own — see `idOf`.
  page.on(".cmd", "keydown").wait();
  page.on(".bar", "mousedown").wait();
  page.on(".cls", "click").wait();
  page.on(".lnch", "click").wait();

  while (true) {
    Event e = page.nextEvent().wait();

    if (e.kind == "click" && e.id == "newterm") {
      // A second shell on the same filesystem, and its own row in the shared process table.
      wins.push(Win(SHELL(), nextId, Session.startOn(core, cli, first.sh.fs, "sh")));
      nextId = nextId + 1;
      redraw(page, wins);
      continue;
    }
    if (e.kind == "click" && e.id == "newfiles") {
      wins.push(Win(FILES(), nextId, first));
      nextId = nextId + 1;
      redraw(page, wins);
      continue;
    }
    if (e.kind == "mousedown" && startsWith(e.id, "bar")) {
      raise(wins, idOf(e.id, 3));
      redraw(page, wins);
      continue;
    }
    if (e.kind == "click" && startsWith(e.id, "cls")) {
      close(wins, idOf(e.id, 3));
      redraw(page, wins);
      continue;
    }
    if (e.kind != "keydown" || !startsWith(e.id, "cmd")) { continue; }

    i32 at = indexOf(wins, idOf(e.id, 3));
    if (at < 0) { continue; }
    Win w = wins.get(at);
    string field = "cmd" + itoa(w.id);

    if (e.value == upArrow() || e.value == downArrow()) {
      page.setValue(field, w.sh.recall(e.value == upArrow())).wait();
      continue;
    }
    if (e.value == intr()) {
      w.sh.interrupt(page.getValue(field).wait());
      page.setValue(field, "").wait();
      paint(page, wins);
      continue;
    }
    if (e.value != cr()) { continue; }

    string line = page.getValue(field).wait();
    page.setValue(field, "").wait();
    w.sh.feedLine(line);
    // Every window, not just this one: a command in one terminal changes what the files windows list
    // and what the *other* terminals would see, because there is one filesystem underneath.
    paint(page, wins);
    if (w.sh.over()) {
      // A shell that exits closes its window rather than the desktop — which is what `exit` means in
      // a terminal on a desktop, and the difference between a window manager and a program with
      // windows drawn on it.
      close(wins, w.id);
      redraw(page, wins);
    }
  }
  return 0;
}

/** Where a window with this id sits in the stack, or -1. */
i32 indexOf(Vec<Win> wins, i32 id) {
  for (i32 i = 0; i < wins.len(); i++) { if (wins.get(i).id == id) { return i; } }
  return -1;
}

/** Forget a window. Its id is not reused — see `Win.id`. */
void close(Vec<Win> wins, i32 id) {
  Vec<Win> left = Vec.create();
  for (i32 i = 0; i < wins.len(); i++) {
    if (wins.get(i).id != id) { left.push(wins.get(i)); }
  }
  replace(wins, left);
}

/** Put this window on top: move it to the end, which is the front. */
void raise(Vec<Win> wins, i32 id) {
  Vec<Win> order = Vec.create();
  for (i32 i = 0; i < wins.len(); i++) {
    if (wins.get(i).id != id) { order.push(wins.get(i)); }
  }
  for (i32 i = 0; i < wins.len(); i++) {
    if (wins.get(i).id == id) { order.push(wins.get(i)); }
  }
  replace(wins, order);
}

/**
 * Make `wins` hold exactly `order`.
 *
 * `Vec` has no truncate, and the caller holds the same object the loop above is reading — so the new
 * order is built beside it and copied back, which also keeps `wins` the one a caller passed in.
 */
void replace(Vec<Win> wins, Vec<Win> order) {
  while (wins.len() > order.len()) { wins.pop(); }
  for (i32 i = 0; i < order.len(); i++) {
    if (i < wins.len()) { wins.set(i, order.get(i)); } else { wins.push(order.get(i)); }
  }
}

/**
 * Rebuild the document: which windows exist, where they sit, which is on top.
 *
 * Every window's markup is emitted in stacking order, so the document order *is* the z-order and no
 * `z-index` is needed — which also means raising is "move it to the end of the list" and nothing else.
 */
void draw(Page page, Vec<Win> wins) {
  string body = "<style>" + css() + "</style><div id=\"desk\">" +
    "<div id=\"launch\">" +
    "  <button class=\"lnch\" id=\"newterm\">+ terminal</button>" +
    "  <button class=\"lnch\" id=\"newfiles\">+ files</button>" +
    "  <span id=\"hint\">one system; every window is on it</span>" +
    "</div>";
  for (i32 i = 0; i < wins.len(); i++) {
    body = body + window(wins.get(i), i, i == wins.len() - 1);
  }
  body = body + "</div>";
  page.render(body).wait();
}

/** One window's markup. `front` gets the accent border, which is the whole of "focused". */
string window(Win w, i32 at, bool front) {
  string id = itoa(w.id);
  // A cascade: no dragging, so the manager decides, and each window sits a little below the last.
  i32 left = 24 + at * 34;
  i32 top = 60 + at * 30;
  string pos = "left: " + itoa(left) + "px; top: " + itoa(top) + "px; " +
    (w.kind == SHELL()
      ? "width: min(58vw, 660px); height: min(58vh, 420px);"
      : "width: min(28vw, 300px); height: min(40vh, 280px);");
  string inner = w.kind == SHELL()
    ? "<div class=\"bod term\">" +
      "  <pre id=\"scr" + id + "\"></pre>" +
      "  <div class=\"line\"><span class=\"ps1\" id=\"ps" + id + "\">$</span>" +
      "    <input class=\"cmd\" id=\"cmd" + id + "\" autocomplete=\"off\" spellcheck=\"false\"" +
      "           autocapitalize=\"off\" autocorrect=\"off\"></div>" +
      "</div>"
    : "<pre class=\"bod\" id=\"files" + id + "\"></pre>";
  return "<div class=\"win" + (front ? " front" : "") + "\" style=\"" + pos + "\">" +
         "  <div class=\"bar\" id=\"bar" + id + "\">" +
         "    <span class=\"ttl\">" + titleOf(w) + "</span>" +
         "    <button class=\"cls\" id=\"cls" + id + "\">&#215;</button>" +
         "  </div>" + inner + "</div>";
}

/**
 * Re-render and put back everything a re-render throws away.
 *
 * `render` replaces the markup, so a half-typed command goes with it. Every terminal's field is read
 * before and restored after — without which clicking a title bar while typing would silently eat the
 * line, in whichever window was being typed in.
 */
void redraw(Page page, Vec<Win> wins) {
  Vec<string> typed = Vec.create();
  for (i32 i = 0; i < wins.len(); i++) {
    Win w = wins.get(i);
    typed.push(w.kind == SHELL() ? page.getValue("cmd" + itoa(w.id)).wait() : "");
  }
  draw(page, wins);
  paint(page, wins);
  for (i32 i = 0; i < wins.len(); i++) {
    Win w = wins.get(i);
    // **Only what was actually read back.** Restoring an empty string to a field is at best a
    // no-op and at worst destructive: a window that has just been *created* had no field to read
    // from, so the saved value is empty, and writing it lands after the element exists — erasing
    // anything typed into the new terminal in between. Measured, not imagined: driving the desktop,
    // the first command typed into a freshly opened terminal disappeared, every time.
    if (w.kind == SHELL() && typed.get(i) != "") {
      page.setValue("cmd" + itoa(w.id), typed.get(i)).wait();
    }
  }
}

/**
 * Everything the windows *show*, from the one system underneath them.
 *
 * The files panes read the filesystem directly rather than running `ls` through a shell: the point of
 * several windows on one system is that they see the same thing, and routing this through a terminal
 * would put its own output in that terminal's scrollback and prove nothing about sharing.
 */
void paint(Page page, Vec<Win> wins) {
  for (i32 i = 0; i < wins.len(); i++) {
    Win w = wins.get(i);
    string id = itoa(w.id);
    if (w.kind == SHELL()) {
      page.setText("scr" + id, w.sh.screen).wait();
      page.setText("ps" + id, w.sh.prompt()).wait();
    } else {
      page.setText("files" + id, listing(w.sh)).wait();
    }
  }
}

/** The shell's working directory, as a files window shows it. */
string listing(Session s) {
  string[]? names = s.sh.fs.readDir(s.sh.cwd);
  if (names is null) { return s.sh.cwd + "\n  (not a directory)\n"; }
  string[] have = names!;
  string out = s.sh.cwd + "\n";
  for (i32 i = 0; i < have.len(); i++) { out = out + "  " + have[i] + "\n"; }
  if (have.len() == 0) { out = out + "  (empty)\n"; }
  return out;
}

bool startsWith(string s, string prefix) {
  u8[] a = s.toBytes();
  u8[] b = prefix.toBytes();
  if (a.len() < b.len()) { return false; }
  for (i32 i = 0; i < b.len(); i++) { if (a[i] != b[i]) { return false; } }
  return true;
}

/** The window id after a fixed-length prefix — `bar12` is 12. Negative when there is not one. */
i32 idOf(string s, i32 from) {
  u8[] b = s.toBytes();
  if (b.len() <= from) { return -1; }
  i32 n = 0;
  for (i32 i = from; i < b.len(); i++) {
    if (b[i] < 48 || b[i] > 57) { return -1; }
    n = n * 10 + (b[i] - 48);
  }
  return n;
}

string css() {
  return
    "#desk, #desk * { box-sizing: border-box; }" +
    "#desk { position: fixed; inset: 0; overflow: hidden; margin: 0;" +
    "        background: #0b0d12; color: #d7dde6;" +
    "        font: 13px/1.6 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }" +
    ".win { position: absolute; display: flex; flex-direction: column; overflow: hidden;" +
    "       background: #06070a; border: 1px solid #232a36; border-radius: 8px;" +
    "       box-shadow: 0 10px 30px rgba(0,0,0,.45); }" +
    ".win.front { border-color: #2f6f66; }" +
    ".bar { display: flex; align-items: center; gap: 8px; padding: 6px 8px 6px 12px;" +
    "       background: #10141c; border-bottom: 1px solid #232a36; cursor: default;" +
    "       user-select: none; }" +
    ".win.front .bar { background: #14201f; }" +
    ".ttl { flex: 1; color: #9fb0c0; font-size: 12px; }" +
    ".cls { background: transparent; border: 0; color: #6b7482; cursor: pointer;" +
    "       font: inherit; font-size: 15px; line-height: 1; padding: 0 4px; }" +
    ".cls:hover { color: #ff8f8f; }" +
    ".bod { flex: 1; margin: 0; padding: 10px 12px; overflow: auto; white-space: pre-wrap;" +
    "       word-break: break-word; scrollbar-width: thin;" +
    "       scrollbar-color: #2b3240 transparent; }" +
    ".term { display: flex; flex-direction: column-reverse; cursor: text; }" +
    ".term pre { margin: 0; white-space: pre-wrap; word-break: break-word; }" +
    ".line { display: flex; align-items: baseline; column-gap: 1ch; }" +
    ".ps1 { color: #5eead4; user-select: none; white-space: pre; }" +
    ".cmd { flex: 1; min-width: 4ch; background: transparent; border: 0; outline: 0;" +
    "       color: inherit; font: inherit; padding: 0;" +
    "       caret-color: #5eead4; caret-shape: block; }" +
    // The launcher: a strip rather than a window, because it is the thing you reach for when there
    // are no windows left and a window you could close would be the wrong shape for that.
    "#launch { position: absolute; inset: 0 0 auto 0; display: flex; align-items: center;" +
    "          gap: 8px; padding: 8px 12px; background: #10141c;" +
    "          border-bottom: 1px solid #232a36; }" +
    ".lnch { background: #14201f; border: 1px solid #2f6f66; border-radius: 5px;" +
    "        color: #9ff3e4; font: inherit; font-size: 12px; padding: 3px 9px; cursor: pointer; }" +
    ".lnch:hover { background: #1b2b29; }" +
    "#hint { color: #5b6472; font-size: 11.5px; margin-left: 4px; }";
}
