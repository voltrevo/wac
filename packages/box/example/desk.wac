// A desktop, in a tab — design/0001 step 8.
//
//   wac run --allow-read --allow-write --allow-run packages/web/tools/build.wac \
//       packages/box/example/desk.wac .cache/desk --page ./packages/web --grant read,write --spawn applet
//
// The design's own sentence: "`Page` has render, events and pixels; a window manager in wac over the
// same system, with the terminal as one window. Deliberately last: windows want something to show."
//
// A tab holds a real system — `/bin` with sixty-odd programs, `/proc` with the process table, `/dev`,
// users, a shell that spawns its applets as processes of their own — so a window manager over it is
// showing the machine rather than decorating an empty one. Like `term.wac` it is a `packages/web` page:
// a worker of its own, no shared memory, every applet a copy of this page started with `--spawn applet`.
//
// ## What a window is here
//
// Markup, not pixels. A terminal drawn on a canvas would mean reimplementing text layout, selection,
// the caret and IME to get something worse than the browser already does. So a window is a `<div>` the
// manager positions, and the terminal's body is a `<pre>` and an `<input>`, as in `term.wac`.
//
// ## Components (`packages/web`'s `view.wac`)
//
// The desktop renders its windows in stacking order, each keyed by its id, so the document order *is* the
// z-order: raising is moving one to the end of the list, and the view moves that one element — a
// half-typed line in another window, or in this one, stays where it was. A window's position is an
// attribute, so a drag renders that window's frame and nothing inside it. A terminal holds its own draft,
// so typing renders that terminal and nothing else; while a command runs it renders on a timer, so output
// shows as it arrives.
//
// ## Every terminal runs at once
//
// A command is started as a task from the key that entered it, so a `yes | head -c 100000000` in one
// window leaves the others typing, `^C` in that window stops it, and a line entered meanwhile waits its
// turn. The windows are one filesystem underneath, so a command ending in one has every files window
// read the disk again.
//
// ## Not implemented, said rather than approximated
//
// **Resizing** and **minimise** — there is no taskbar to minimise *to* yet.

import { Sys } from "std";
import { ElementEvent, MOD_CTRL, Node, Page, State, Ui, html.button, html.div, html.input, html.pre, html.span, html.style } from "../../web";
import { Vec } from "core";
import { boxApplet } from "../src/shrun.wac";
import { Session } from "../src/lib/session.wac";

/** What a copy of this page started by `spawnSelf` runs — `--spawn applet`. */
export async i32 applet(Sys sys) { return await boxApplet(sys); }

/** What a window shows. */
i32 SHELL() { return 0; }
i32 FILES() { return 1; }

/** How often a terminal with a command running is redrawn, in milliseconds. */
static i32 REDRAW_MS = 100;

/**
 * One window: what it shows, the session it shows, its id, and where it is.
 *
 * **The id is allocated once and never reused**, which is what lets a window be closed without
 * renumbering the others: it is the window's `key`, and the suffix of every id its markup carries.
 */
struct Win {
  i32 kind;
  i32 id;
  /** The session this window is a terminal for, or whose working directory a files window lists. */
  Session sh;
  /** Where it is, in desktop pixels. */
  i32 left;
  i32 top;
}

/** The desktop's own bookkeeping, kept across renders: the windows in stacking order, and the drag. */
struct Desktop {
  /** Front last. A list rather than a z-index per window, because "which is on top" is an order. */
  Vec<Win> wins;
  i32 nextId;
  /** Which window is being dragged, and where in its bar the pointer took hold. -1 is "none". */
  i32 dragging;
  i32 grabX;
  i32 grabY;
}

/** The window's title, which is also what its bar says. */
string titleOf(Win w) { return w.kind == SHELL() ? "shell \{w.id}" : "files"; }

/** Whether `e` is `^C`. */
bool isIntr(ElementEvent e) { return (e.mods & MOD_CTRL) != 0 && (e.value == "c" || e.value == "C"); }

export async i32 main(Page page) {
  Sys sys = page.sys;
  page.title("wac desktop");
  // **One filesystem, and every window is on it.** The first session builds the system — `/dev`,
  // `/proc`, `/bin`, the applets — and every terminal opened afterwards is `Session.startOn` over
  // those same files and process table. Two terminals each building their own would be two machines that look alike, and
  // a desktop whose windows do not share a disk is a set of pictures.
  Session first = Session.start(sys, "desk");
  await first.feedLine("mkdir -p /home/wac");
  await first.feedLine("seq 1 5 > /home/wac/five");
  page.mount((Ui ui) => Desk(ui, sys, first));
  return 0;
}

Desktop opening(Session first) {
  Vec<Win> wins = Vec.create();
  wins.push(Win(SHELL(), 0, first, cascadeLeft(0), cascadeTop(0)));
  wins.push(Win(FILES(), 1, first, cascadeLeft(1), cascadeTop(1)));
  return Desktop(wins, 2, 0 - 1, 0, 0);
}

Node Desk(Ui ui, Sys sys, Session first) {
  Desktop d = ui.memo<Desktop>("", () => opening(first));
  auto changed = ui.state(0);
  // Bumped when a command ends anywhere: every files window reads the one disk again.
  auto disk = ui.state(0);
  fn<void()> again = () => { changed.update((i32 n) => n + 1); };
  fn<void(Win)> open = (Win w) => {
    d.wins.push(w);
    d.nextId = d.nextId + 1;
    again();
  };
  fn<void(i32)> close = (i32 id) => {
    i32 at = indexOf(d.wins, id);
    if (at >= 0) { d.wins.remove(at); }
    again();
  };
  Node[] shown = Node[].filled(d.wins.len(), Node.Text(""));
  for (i32 i = 0; i < d.wins.len(); i++) {
    Win w = d.wins.get(i);
    shown[i] = <Window key={"\{w.id}"} w={w} left={w.left} top={w.top} front={i == d.wins.len() - 1} disk={disk.get()}
      ongrab={(i32 id, i32 x, i32 y) => {
        // Pressing a bar raises its window — the end of the list is the front — and takes hold of it.
        i32 at = indexOf(d.wins, id);
        if (at < 0) { return; }
        Win held = d.wins.remove(at);
        d.wins.push(held);
        d.dragging = id;
        d.grabX = x;
        d.grabY = y;
        again();
      }}
      onclose={close}
      onended={(Win done) => {
        disk.update((i32 n) => n + 1);
        // A shell that exits closes its window rather than the desktop — which is what `exit` means
        // in a terminal on a desktop.
        if (done.sh.over()) { close(done.id); }
      }}/>;
  }
  // The move and the release are the desktop's rather than the bar's: a pointer that leaves the bar
  // mid-drag still lands on the desktop, and its coordinates are the desktop's own.
  return <div id="desk"
      onpointermove={(ElementEvent e) => {
        if (d.dragging < 0) { return; }
        i32 at = indexOf(d.wins, d.dragging);
        if (at < 0) { d.dragging = 0 - 1; return; }
        Win moving = d.wins.get(at);
        // Clamped at the top so a window cannot be dragged under the launcher strip and become
        // unreachable — the one place a manager has to say no.
        moving.left = e.x - d.grabX;
        moving.top = e.y - d.grabY < LAUNCH_H() ? LAUNCH_H() : e.y - d.grabY;
        again();
      }}
      onpointerup={(ElementEvent e) => { d.dragging = 0 - 1; }}>
    <style>{STYLE}</style>
    <div id="launch">
      <button class="lnch" id="newterm" onclick={(ElementEvent e) => {
        // A second shell on the same filesystem, and its own row in the shared process table.
        open(Win(SHELL(), d.nextId, Session.startOn(sys, first.sh.fs, first.sh.table, "sh"),
                 cascadeLeft(d.wins.len()), cascadeTop(d.wins.len())));
      }}>+ terminal</button>
      <button class="lnch" id="newfiles" onclick={(ElementEvent e) => {
        open(Win(FILES(), d.nextId, first, cascadeLeft(d.wins.len()), cascadeTop(d.wins.len())));
      }}>+ files</button>
      <span id="hint">one system; every window is on it</span>
    </div>
    {shown}
  </div>;
}

/** Where a window with this id sits in the stack, or -1. */
i32 indexOf(Vec<Win> wins, i32 id) {
  for (i32 i = 0; i < wins.len(); i++) { if (wins.get(i).id == id) { return i; } }
  return -1;
}

/**
 * How tall the launcher strip is, in pixels — the one number the CSS and the manager share.
 *
 * A window may not be dragged above this, or its bar goes under the strip and there is no way to get
 * hold of it again. The cascade starts below it for the same reason.
 */
i32 LAUNCH_H() { return 37; }

/** Where the nth window opens, before anybody drags it. */
i32 cascadeLeft(i32 n) { return 24 + n * 34; }
i32 cascadeTop(i32 n) { return 60 + n * 30; }

/** The style that places one window. */
string placement(i32 kind, i32 left, i32 top) {
  return "left: \{left}px; top: \{top}px; " +
    (kind == SHELL()
      ? "width: min(58vw, 660px); height: min(58vh, 420px);"
      : "width: min(28vw, 300px); height: min(40vh, 280px);");
}

/**
 * One window's frame. `left`, `top` and `front` are attributes of their own, beside `w`, so a drag or
 * a raise is a changed attribute — `w` is the same window throughout — and renders this frame and not
 * what is inside it.
 */
Node Window(Ui ui, Win w, i32 left, i32 top, bool front, i32 disk, fn<void(i32, i32, i32)> ongrab,
            fn<void(i32)> onclose, fn<void(Win)> onended) {
  string id = "\{w.id}";
  Node inner = w.kind == SHELL() ? <Terminal w={w} onended={onended}/> : <Files w={w} disk={disk}/>;
  return <div class={front ? "win front" : "win"} id={"win\{id}"} style={placement(w.kind, left, top)}>
    <div class="bar" id={"bar\{id}"} onpointerdown={(ElementEvent e) => { ongrab(w.id, e.x, e.y); }}>
      <span class="ttl">{titleOf(w)}</span>
      <button class="cls" id={"cls\{id}"} onclick={(ElementEvent e) => { onclose(w.id); }}>×</button>
    </div>
    {inner}
  </div>;
}

/**
 * Run `line`, and then whatever was typed while it ran, in order — type-ahead, as a terminal keeps it.
 * `ahead` is the terminal's own list: `^C` empties it.
 */
async void run(Win w, string line, State<bool> busy, Vec<string> ahead, fn<void(Win)> onended) {
  busy.set(true);
  string next = line;
  while (true) {
    await w.sh.feedLine(next);
    if (w.sh.over() || ahead.len() == 0) { break; }
    next = ahead.remove(0);
  }
  busy.set(false);
  onended(w);
}

/** A terminal: the session's scrollback, its prompt, and the line being typed. */
Node Terminal(Ui ui, Win w, fn<void(Win)> onended) {
  auto draft = ui.state("");
  auto busy = ui.state(false);
  auto tick = ui.state(0);
  Vec<string> ahead = ui.memo<Vec<string>>("", () => Vec.create());
  // While a command runs, render on a timer: its output shows as it arrives.
  ui.effect(busy.get() ? "running" : "idle", () => {
    if (!busy.get()) { return () => { }; }
    return ui.every(REDRAW_MS, () => { tick.update((i32 n) => n + 1); });
  });
  string id = "\{w.id}";
  return <div class="bod term">
    <pre id={"scr\{id}"}>{w.sh.showing()}</pre>
    <div class="line">
      <span class="ps1" id={"ps\{id}"}>{w.sh.prompt()}</span>
      <input class="cmd" id={"cmd\{id}"} autocomplete="off" spellcheck="false" value={draft.get()}
        oninput={(ElementEvent e) => { draft.set(e.value); }}
        onkeydown={(ElementEvent e) => {
          // With a command running, `^C` stops it and drops what was typed ahead, and a line entered
          // meanwhile waits for its prompt.
          if (busy.get()) {
            if (isIntr(e)) {
              w.sh.stop();
              while (ahead.len() > 0) { ahead.pop(); }
            } else if (e.value == "Enter") {
              ahead.push(draft.get());
              draft.set("");
            }
            return;
          }
          if (e.value == "ArrowUp" || e.value == "ArrowDown") {
            draft.set(w.sh.recall(e.value == "ArrowUp"));
            return;
          }
          if (isIntr(e)) {
            w.sh.interrupt(draft.get());
            draft.set("");
            return;
          }
          if (e.value != "Enter") { return; }
          string line = draft.get();
          draft.set("");
          run(w, line, busy, ahead, onended);
        }}></input>
    </div>
  </div>;
}

/**
 * A files window: the session's working directory, read from the one filesystem — directly rather than
 * through `ls`, since the point of several windows on one system is that they see the same thing — and
 * read again whenever `disk` says a command has ended somewhere.
 */
Node Files(Ui ui, Win w, i32 disk) {
  auto text = ui.state("");
  ui.effect("\{disk}", () => {
    show(w.sh, text);
    return () => { };
  });
  return <pre class="bod" id={"files\{w.id}"}>{text.get()}</pre>;
}

async void show(Session s, State<string> text) { text.set(await listing(s)); }

/** The shell's working directory, as a files window shows it. */
async string listing(Session s) {
  string[]? names = (await s.sh.fs.readDir(s.sh.cwd)).ok();
  if (names is null) { return "\{s.sh.cwd}\n  (not a directory)\n"; }
  string[] have = names!;
  string out = "\{s.sh.cwd}\n";
  for (i32 i = 0; i < have.len(); i++) { out = out + "  \{have[i]}\n"; }
  if (have.len() == 0) { out = out + "  (empty)\n"; }
  return out;
}

static string STYLE =
    "#desk, #desk * { box-sizing: border-box; }" +
    "#desk { position: fixed; inset: 0; overflow: hidden; margin: 0;" +
    "        background: #0b0d12; color: #d7dde6;" +
    "        font: 13px/1.6 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }" +
    ".win { position: absolute; display: flex; flex-direction: column; overflow: hidden;" +
    "       background: #06070a; border: 1px solid #232a36; border-radius: 8px;" +
    "       box-shadow: 0 10px 30px rgba(0,0,0,.45); }" +
    ".win.front { border-color: #2f6f66; }" +
    ".bar { display: flex; align-items: center; gap: 8px; padding: 6px 8px 6px 12px;" +
    "       background: #10141c; border-bottom: 1px solid #232a36; cursor: default;" +
    "       user-select: none; }" +
    ".win.front .bar { background: #14201f; }" +
    ".ttl { flex: 1; color: #9fb0c0; font-size: 12px; }" +
    ".cls { background: transparent; border: 0; color: #6b7482; cursor: pointer;" +
    "       font: inherit; font-size: 15px; line-height: 1; padding: 0 4px; }" +
    ".cls:hover { color: #ff8f8f; }" +
    ".bod { flex: 1; margin: 0; padding: 10px 12px; overflow: auto; white-space: pre-wrap;" +
    "       word-break: break-word; scrollbar-width: thin;" +
    "       scrollbar-color: #2b3240 transparent; }" +
    ".term { display: flex; flex-direction: column-reverse; cursor: text; }" +
    ".term pre { margin: 0; white-space: pre-wrap; word-break: break-word; }" +
    ".line { display: flex; align-items: baseline; column-gap: 1ch; }" +
    ".ps1 { color: #5eead4; user-select: none; white-space: pre; }" +
    ".cmd { flex: 1; min-width: 4ch; background: transparent; border: 0; outline: 0;" +
    "       color: inherit; font: inherit; padding: 0;" +
    "       caret-color: #5eead4; caret-shape: block; }" +
    // The launcher: a strip rather than a window, because it is the thing you reach for when there
    // are no windows left and a window you could close would be the wrong shape for that.
    "#launch { position: absolute; inset: 0 0 auto 0; display: flex; align-items: center;" +
    "          gap: 8px; padding: 8px 12px; background: #10141c;" +
    "          border-bottom: 1px solid #232a36; }" +
    ".lnch { background: #14201f; border: 1px solid #2f6f66; border-radius: 5px;" +
    "        color: #9ff3e4; font: inherit; font-size: 12px; padding: 3px 9px; cursor: pointer; }" +
    ".lnch:hover { background: #1b2b29; }" +
    "#hint { color: #5b6472; font-size: 11.5px; margin-left: 4px; }";
