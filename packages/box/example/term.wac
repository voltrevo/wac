// A shell, in a browser tab.
//
//   wac run --allow-read --allow-write --allow-run packages/web/tools/build.wac \
//       packages/box/example/term.wac .cache/term --page ./packages/web --grant read,write --spawn applet
//
// `packages/sh` unchanged: quoting, parameter expansion, command substitution, arithmetic,
// pipelines, redirection, `&&`/`||`, `if`/`while`/`for`/`case`, functions, subshells, globbing.
// It was written for a terminal and tested against GNU bash script for script, and none of that
// is different here — what is different is that its `Cli` reaches the Origin Private File System
// instead of a disk, and its output goes to an element instead of a pipe.
//
// What runs here is the shell's own built-ins — including `cd`, `pwd` and `ls` — and then every
// applet in `packages/box`, wired in with `sh.external = boxRun`: the same code the command-line
// `box` runs, in the page.
//
// **A `packages/web` page** (design/system/0011): the program runs in a worker of its own, nothing in
// it waits for the browser — every capability hands back a ticket and the program `await`s it — and
// there is no `SharedArrayBuffer`, so no cross-origin-isolation headers and no service worker faking
// them.
//
// **Each applet is a process.** `--spawn applet` builds the page so that a copy of it started by
// `spawnSelf` runs `applet` below: `sort` is this same program again with `sort` as its first argument,
// in a worker of its own, streaming to the next stage by messages. A stage that reads a file asks this
// shell over a channel, and the shell answers from the one filesystem — so `cd` here and a file
// written by a pipeline are the same world.
//
// **The command runs while the keyboard is read.** The loop below starts a line as a task and keeps
// taking events while it runs, so `^C` reaches a running `yes | head -c 1000000000` and ends it, as at
// an ssh prompt, and the scrollback shows output as it arrives rather than when the line finishes.
//
// ## Why the terminal is built the way it is
//
// **The scrollback pins itself with CSS, not with a capability.** A terminal has to show the
// newest line, and `setText` cannot scroll anything. Rather than adding a `scrollToEnd`
// capability for one caller, the scroller is `flex-direction: column-reverse`, which anchors it
// to the end — the browser keeps a reversed column scrolled to its bottom for free.
//
// **History is a ring in a local.** Up and Down arrive as `keydown` events, so the whole feature is
// a `string[]` and two integers in `Session` — no state outside the program.
//
// **The line is edited by the browser.** design/0001 step 5 asks for one line discipline for the ssh
// channel and this keyboard, and `packages/tty` is that module — echo, erase, `^U`, `^W`, `^C`, `^D`,
// every rule read off the kernel's own discipline through a pty. This page does not use it: the
// editing happens in an `<input>`, which supplies the block caret, IME composition and paste for
// nothing. Taking the editing over would make `^U` and `^W` work here exactly as over ssh, and would
// make those three our problem. A decision rather than an oversight, written down here.

import { Core, Cli, Sys } from "std";
import { Event, MOD_CTRL, Page, html.a, html.div, html.input, html.label, html.pre, html.span, html.style } from "../../web";
import { Ticket, TicketBase, Vec } from "core";
import { boxApplet } from "../src/shrun.wac";
import { Session } from "../src/lib/session.wac";

/** Where this page came from. A demonstration nobody can rebuild is a screenshot. */
static string SOURCE =
  "https://github.com/voltrevo/wac-mono/blob/master/packages/box/example/README.md#termwac";

static string BANNER =
  "wac sh — packages/sh with every packages/box applet, in a browser tab. Type at the\n" +
  "prompt; `help` lists the sixty programs, Up and Down walk the history, `clear` empties\n" +
  "the screen and ^C stops what is running. / is an Origin Private File System: what you\n" +
  "write survives a reload and is visible to nothing outside this tab.\n" +
  "\n";

/** How often the scrollback is redrawn while a command runs, in milliseconds. */
static i32 REDRAW_MS = 100;

static string STYLE =
  // Tuned to sit inside the website's terminal frame: the same ground, text and accent the page
  // around it uses, so the embed reads as one object rather than a window into another site.
  //
  // The root is a `<label for="cmd">`, which is the whole of click-anywhere-to-type. A page has
  // no way to move focus — there is no `focus` capability and adding one for this would be a
  // capability per widget — but a label focuses its control natively, so clicking dead space in
  // the scrollback puts the keyboard back in the prompt. Dragging still selects: a label focuses
  // on click and does not eat a drag, which is what makes copying output out of here still work.
  // A page with no stylesheet under it is `content-box`, and `#wrap` below is `height: 100%`
  // with padding: those two make the scroller 44px taller than the frame that clips it, which
  // put the prompt below the visible edge — reading as no bottom margin, and as a scrollback
  // that stopped just short of the newest line until a keystroke scrolled the caret into view.
  "  #term, #term * { box-sizing: border-box; }" +
  "  #term { position: fixed; inset: 0; overflow: hidden; display: block; cursor: text;" +
  "          background: #06070a; color: #d7dde6;" +
  "          font: 13px/1.65 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }" +
  "  #term ::selection { background: #1c4b45; color: #eafffb; }" +
  // `column-reverse` is what makes new output stick to the bottom without scripting, and the
  // prompt is inside the scroller rather than below it so that it is the next line of the
  // session rather than a footer bolted to the window. Reversed, so both come first in the
  // markup and render last.
  //
  // On its own the reversal also pins a *short* session to the bottom of the frame, under a
  // screenful of nothing. `justify-content: flex-end` looks like the fix and is a trap: in an
  // overflowing flex scroller, content pushed past the start edge by alignment cannot be
  // scrolled to at all — `scrollHeight` stays equal to `clientHeight` and one `ls` puts the
  // output somewhere the reader cannot reach. `#pad` does the same job as a flex item instead:
  // it takes the free space while there is any, and is 0 tall once there is none, so the
  // overflow is ordinary overflow and scrolls.
  //
  // The bottom padding is a reserved strip for `#src`, which is fixed to the frame rather than
  // sitting in the prompt line: a link floating at the end of the line you are typing on is the
  // one thing here that never looked like a terminal, and reserving the strip is what stops the
  // prompt from ever sliding under it.
  "  #wrap { height: 100%; overflow-y: auto; display: flex;" +
  "          flex-direction: column-reverse; padding: 14px 16px 30px;" +
  // Thin, and visible: scrollback nobody can tell is there is scrollback nobody scrolls.
  "          scrollbar-width: thin; scrollbar-color: #2b3240 transparent; }" +
  "  #pad { flex: 1 1 0; min-height: 0; }" +
  "  #scr { margin: 0; white-space: pre-wrap; word-break: break-word; }" +
  "  #bar { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 1ch; }" +
  "  #ps1 { color: #5eead4; user-select: none; white-space: pre; }" +
  // `caret-shape: block` is the cursor, blinking, sized and positioned by the browser rather
  // than drawn by us. Doing it by hand would mean mirroring the value into a span and tracking
  // the caret index through every arrow key, paste and IME composition — a second implementation
  // of text editing, to be wrong in a different way. Where it is unsupported the caret stays a
  // line, which is the shape it was before.
  //
  // The field is `flex: 1` and not `field-sizing: content`, and that is the whole reason this
  // comment exists. Content sizing is the obvious choice here — it makes prompt, command and
  // cursor one continuous line instead of a text box with a prompt next to it — and it silently
  // costs the block: a field exactly as wide as its text has no cell left for a caret past the
  // last character, so the browser clips the block to a bar. Measured both, zoomed, with
  // `caret: "initial"` screenshots: identical markup, block in one and a bar in the other. The
  // width does not show, because the field is transparent and the line has nothing to its right.
  "  #cmd { flex: 1; min-width: 4ch;" +
  "         background: transparent; border: 0; outline: 0; color: inherit;" +
  "         font: inherit; padding: 0; caret-color: #5eead4; caret-shape: block; }" +
  // A status line rather than part of the prompt: down in the strip `#wrap` reserves for it.
  "  #src { position: fixed; right: 16px; bottom: 7px; color: #6b7482; font-size: 11.5px;" +
  "         text-decoration: none; white-space: nowrap; }" +
  "  #src:hover { color: #5eead4; text-decoration: underline; }";

/**
 * What a copy of this page started by `spawnSelf` runs — `--spawn applet`. Its first argument names the
 * `box` applet, as on a command line.
 */
export async i32 applet(Sys sys) { return await boxApplet(sys.core, sys.cli); }

/** Whether `e` is `^C`. */
bool isIntr(Event e) { return (e.mods & MOD_CTRL) != 0 && (e.value == "c" || e.value == "C"); }

export async i32 main(Page page) {
  Sys sys = page.sys;
  Core core = sys.core;
  Cli cli = sys.cli;
  page.title("wac sh");
  // The root is a `<label for="cmd">`, which is the whole of click-anywhere-to-type: a label focuses its
  // control natively, and dragging still selects, so copying output out of here works.
  page.render(
    <label id="term" for="cmd">
      <style>{STYLE}</style>
      <div id="wrap">
        <div id="pad"></div>
        <div id="bar">
          <span id="ps1">$</span>
          <input id="cmd" autofocus="" autocomplete="off" spellcheck="false"></input>
        </div>
        <pre id="scr"></pre>
      </div>
      <a id="src" href={SOURCE}>source and how to build it</a>
    </label>
  );
  page.on("#cmd", "keydown");

  // One shell for the whole session, so variables and functions persist between commands exactly as
  // they would in a terminal — `Session`, which is the shell, the scrollback and the history with no
  // page in it, shared with `desk.wac`.
  Session s = Session.start(core, cli, "term");
  s.say(BANNER);

  // Open on a session rather than on a prompt with nothing above it, run through the same `runScript`
  // the keyboard reaches. The website prints the same three lines beside the embed, and
  // `packages/box/test/wac/frontpage_test.wac` fails if either drifts from what the shell answers.
  string[] opening = [
    "seq 1 20 | grep 7 | wc -l",
    "echo 'a whole new stack' | gzip -c | wc -c",
    "echo hello | sha256sum"
  ];
  page.setText("ps1", s.prompt());
  for (i32 i = 0; i < opening.len(); i++) {
    await s.feedLine(opening[i]);
    page.setText("scr", s.screen);
  }
  s.say("\n");
  page.setText("scr", s.screen);

  Ticket<Event> next = page.nextEvent();
  Ticket<void>? running = null;
  // **Lines entered while a command runs**, run in order once it ends — type-ahead, as a terminal keeps
  // it. Dropping them was a line the user saw accepted and the shell never ran.
  Vec<string> typedAhead = Vec.create();
  while (true) {
    if (running is not null) {
      // **A command in flight, and the keyboard still read.** Whichever comes first — the command
      // ending, a key, or the redraw timer — and the other two are still there next time round.
      Ticket<i64> tick = core.sleepMillis(REDRAW_MS).ticket();
      TicketBase[] parts = [running!, next, tick] as TicketBase[];
      i32 k = await Ticket.first(parts);
      if (k == 0) {
        running = null;
        page.setText("ps1", s.prompt());
        page.setText("scr", s.screen);
        if (s.over()) {
          page.setText("scr", "\{s.screen}\n[the shell exited \{s.code()}]\n");
          return s.code();
        }
        if (typedAhead.len() > 0) {
          string ahead = typedAhead.get(0);
          typedAhead.remove(0);
          running = s.feedLine(ahead);
          page.setText("scr", s.showing());
        }
      } else if (k == 1) {
        Event e = await next;
        next = page.nextEvent();
        // `^C` ends what is running, through the shell's own interrupt — `$?` is 130 and the next
        // prompt appears, and what was typed ahead goes with it, as in a terminal. A line entered meanwhile
        // waits its turn.
        if (e.kind == "keydown" && isIntr(e)) {
          s.stop();
          while (typedAhead.len() > 0) { typedAhead.pop(); }
        } else if (e.kind == "keydown" && e.value == "Enter") {
          typedAhead.push(await page.getValue("cmd"));
          page.setValue("cmd", "");
        }
      } else {
        page.setText("scr", s.showing());
      }
      continue;
    }

    Event e = await next;
    next = page.nextEvent();
    if (e.kind != "keydown") { continue; }
    if (e.value == "ArrowUp" || e.value == "ArrowDown") {
      page.setValue("cmd", s.recall(e.value == "ArrowUp"));
      continue;
    }
    // **`^C` at a prompt throws away what has been typed and starts a fresh line**, which is what it
    // does at an ssh prompt.
    if (isIntr(e)) {
      s.interrupt(await page.getValue("cmd"));
      page.setValue("cmd", "");
      page.setText("scr", s.screen);
      continue;
    }
    if (e.value != "Enter") { continue; }

    string line = await page.getValue("cmd");
    page.setValue("cmd", "");
    running = s.feedLine(line);
    page.setText("scr", s.showing());
  }
  return 0;
}
