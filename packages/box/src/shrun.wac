// `box`'s applets, as the shell's external commands.
//
//   import { boxRun } from "../src/shrun.wac";
//   Shell sh = Shell.create(core, cli);
//   sh.external = boxRun;
//
// Two lines, and `sort`, `grep`, `sha256sum`, `gzip`, `cut`, `shuf` and fifty more become
// commands you can type. `packages/sh` had its own `cat`, `wc`, `head`, `tail`, `rev`, `sort`,
// `uniq`, `grep`, `tr`, `seq`, `nl` and `printf` — twelve programs that existed only because the
// real ones could not be called, and its own comments said so. They are the fallback now.
//
// ## Why the wiring points this way
//
// `box` depends on `sh` and not the other way round, so `sh` cannot import this table; it takes a
// funcref instead and whoever has both packages hands one to the other. That also keeps `sh`
// testable alone: with nothing wired in, the hook falls through and the shell behaves exactly as
// it did.
//
// ## Why an applet needs no changes
//
// An applet reads `cli.readChunk()` and writes `cli.write(...)`, which are the *process's* streams.
// It is handed a substitute `Cli` instead — `platform`'s `childCli`, built over a `Frame` this
// function holds — so those same capabilities read the bytes we supply and keep what they are given.
// The applet is not compiled differently, does not know, and cannot tell.
//
// **This used to say the opposite**, and it is worth keeping why. There were no closures, so a fake
// capability had nowhere to put what it collected, and `platform` answered with
// `pushChild`/`popChild`: the host held the child's world between two calls. `design/lang/0002` tier
// two landed on 2026-08-16 and the premise stopped being true — `issues/lang/0137`. The two
// implementations still agree byte for byte, which `packages/platform/test/wac/frame_test.wac` is a
// differential for; what changed is that the state is a local this function can see rather than a
// stack inside the host, and that there is no second call to forget.
//
// The one thing that is *not* faithful is isolation. This is the same wasm instance with the same
// authority: an applet run here can open any file the shell could. A real boundary is `spawn`,
// which `sh` tries first — see `trySpawn` — and which a browser cannot do yet.

import { Captured, Cli, Core } from "../../platform/src/platform.wac";
import { Frame, childCli, childCore } from "../../platform/src/frame.wac";
import { Vec } from "core/vec.wac";
import { Args, parseList } from "./lib/args.wac";
import { UNKNOWN, appletNames, dispatch } from "./box.wac";
import { Output } from "../../sh/src/refusal.wac";
import { Fs } from "../../fs/src/fs.wac";

/**
 * Run `argv` as a `box` applet, with `stdin` as its input and `cwd` as where it stands.
 *
 * Matches `Shell.external`, so this is the whole of the integration.
 *
 * `Output.missing()` for a name that is not an applet, because that is what makes the shell say
 * `command not found` and report 127 rather than printing `box`'s usage at somebody who typed a
 * typo. The `UNKNOWN` sentinel exists for exactly this: an applet that ran and failed returns 1,
 * and one that does not exist has to be a different answer.
 */
export Output boxRun(Core core, Cli cli, Fs fs, string cwd, Vec<string> argv, u8[] stdin, bool inheritIn) {
  if (argv.len() == 0) { return Output.missing(); }

  // The applet's own name is `argv[0]` here, where under `box` it is `argv[1]` — `box grep x` and
  // `grep x` in a shell are the same command spelled two ways. `parseList` takes where the
  // arguments begin so both callers use the one parser.
  string[] args = string[argv.len()](fill: "");
  for (i32 i = 0; i < argv.len(); i++) { args[i] = argv.get(i); }
  string name = args[0];
  Args a = parseList(args, 1, name);

  // The world the applet runs in, as a value. It ends when this function returns, which is the
  // difference worth naming: the pair of calls this replaces had to be balanced, and a push left on
  // the stack captured the shell's own output for ever afterwards — a failure that appeared as a
  // terminal gone silent rather than as anything to do with this function. There is nothing to leave.
  //
  // `inheritIn` is the shell saying "this one may read the real standard input" — so it is not handed
  // bytes and the shell never had to read any. Without it a shell that cannot spawn had to drain its own
  // input before starting an applet that might never read one, and at a terminal that never finished
  // (wac-mono 0110).
  //
  // **Where the applet stands.** The frame's `cwd` answers a relative path asked of the *capability*,
  // and an applet asks this filesystem now — so the filesystem has to be told too, or `cat f` after
  // `cd d` looks under the mount root (wac-mono 0109).
  fs.setCwd(cwd);
  Frame f = Frame.of(args, stdin, cwd, inheritIn);
  i32 code = dispatch(childCore(f, core), childCli(f, cli), fs, a, name);
  Captured got = f.captured();

  if (code == UNKNOWN) { return Output.missing(); }
  // **A capture that filled up is a command that did not run, not a short answer.**
  //
  // The applet exited cleanly and believes it did its job: at the cap `cli.write` answers false, and
  // false is what a closed pipe answers, which is what `box yes` is written to stop on. Nothing in
  // the bytes says they are short. So `boxsh -c 'seq 1 1500000 | wc -c'` printed 8323568 where bash
  // prints 10888896 — the wrong number, silently, from a program that reported success.
  //
  // Reported here because this is the layer that knows: the applet cannot tell a full buffer from a
  // gone reader, and the shell cannot see it in the output. `Captured.truncated` is the fact, and the
  // honest answer to it is a failure with a sentence — we could not run this — rather than a number
  // that is not the answer. Status 1, which is what a shell reports for a command that failed.
  if (got.truncated) {
    return Output.refused(
      (name + ": output exceeded what this shell can hold for a command it runs in process; " +
       "run it as a spawned program, where the output streams\n").toBytes(),
      1,
    );
  }
  return Output(got.out, got.err, code, true, false);
}

/**
 * Run one applet as *this program's* `main` would, writing to the real streams.
 *
 * The other half of `Shell.externalSpawnable`. When the shell runs an applet as a child — a worker of
 * its own, through `spawnSelf` — the child starts at `main` with the applet's name as its first
 * argument, and `main` has to know what to do with that. `box.wac`'s already does; a program that
 * *embeds* the shell needs this to do the same thing.
 *
 * No `pushChild` here, unlike `boxRun`: a child's output is already its own, and its `cli.write` goes
 * to the handle its parent reads. Capturing would be capturing from itself.
 *
 * Answers `UNKNOWN` for a name that is not an applet, so a caller can be a shell instead.
 */
export i32 boxApplet(Core core, Cli cli) {
  i32 n = cli.argCount().wait();
  if (n < 1) { return UNKNOWN; }
  string[] args = string[n](fill: "");
  for (i32 i = 0; i < n; i++) { args[i] = string.fromBytes(cli.arg(i).wait()); }
  string name = args[0];
  // **`boxApplet` is the multi-call entry — this program run *as* an applet — so its filesystem is
  // whichever one it actually has**: its parent's if something spawned it and promised to answer,
  // and the host's otherwise. It used to be `Fs.onHost` unconditionally, and said so, which is
  // wac-mono 0116: a stage spawned by a session booted on an image could not see that image and
  // could read the machine the session was running on, so such a session did not spawn at all.
  //
  // The question is asked here rather than passed in because nothing can pass it in. This is `main`
  // for a multi-call binary, reached identically whether a person typed `box sort` on a command line
  // or a sealed shell spawned a pipeline stage; the arguments are the same and only the channel
  // differs. `Fs.fromParentOrHost` is one round trip on a channel that is either answered, ended or
  // absent, and each of the three is a different situation with the same two possible answers.
  // **The name is checked before the channel is**, so a program that is not an applet at all — this
  // same binary invoked as a shell, which is how `sealedsh` and `sh` start — does not pay a round
  // trip to a parent it does not have. `dispatch` would answer `UNKNOWN` a moment later either way;
  // the difference is that building the filesystem is the expensive half.
  if (!isApplet(name)) { return UNKNOWN; }
  return dispatch(core, cli, Fs.fromParentOrHost(cli, 0), parseList(args, 1, name), name);
}

/**
 * Whether `dispatch` has a program of this name.
 *
 * Asked from the one list `appletNames` is, so this cannot drift from what `dispatch` will actually
 * run — a second list of names would be the thing that decides whether a filesystem gets built.
 */
bool isApplet(string name) {
  string[] names = appletNames();
  for (i32 i = 0; i < names.len(); i++) { if (names[i] == name) { return true; } }
  return false;
}

/**
 * Every name `boxRun` answers to, for `Shell.externalNames`.
 *
 * The same list `box`'s own usage prints, so the shell's `help` and `box` with no arguments cannot
 * disagree about what exists.
 */
export string[] boxNames() { return appletNames(); }
