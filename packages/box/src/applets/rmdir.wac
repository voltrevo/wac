// Empty directories removed. Never recursive — that is `rm -r`, and the difference
// between them is the whole reason `rmdir` is a separate command.

import { Change, Cli, Core, reasonOf } from "std/platform.wac";
import { Args } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { missingOperand } from "../lib/operands.wac";
import { Fs } from "../../../fs/src/fs.wac";

export i32 rmdir(Core core, Cli cli, Fs fs, Args a) {
  if (refuseFlags(core, a)) { return 1; }
  if (a.rest.len() < 1) { return missingOperand(core, a.name, ""); }
  i32 code = 0;
  for (i32 i = 0; i < a.rest.len(); i++) {
    Change c = fs.remove(a.rest[i], false);
    if (c.ok()) { continue; }
    // Every category's words, not just this one's. The host's own words differ per platform —
    // "Directory not empty (os error 39)" under Deno, "The object can not be modified in this way." in
    // a browser — and the *category* is the same on both, which is what the fault numbers are for.
    // Issue 0009.
    //
    // This was `c.fault == FAULT_NOT_EMPTY() ? "Directory not empty" : c.message`: a copy of the one
    // row `rmdir` exists to distinguish, with everything else falling through to the host's sentence.
    // So `rmdir nosuch` said `No such file or directory (os error 2): remove '/abs/path/nosuch'` while
    // the shell's builtin `rm`, using the shared table, said GNU's four words for the same fault.
    //
    // And GNU's frame, which this had not got either: `rmdir: failed to remove 'x': …`.
    core.warn(a.name + ": failed to remove '" + a.rest[i] + "': " + reasonOf(c));
    code = 1;
  }
  return code;
}
