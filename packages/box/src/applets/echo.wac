// The arguments, space separated — with `-n` for no trailing newline and `-e` for escapes.
//
// **Both were accepted and ignored.** `echo -n hi` printed "hi\n", which is the one thing the caller
// asked not to happen, and `echo -e 'a\tb'` printed the backslash and the t. Found by asking every
// applet whether each flag the real tool documents actually does anything (wac-mono 0105).
//
// `-n`, `-e` and `-E` are not options in the ordinary sense and are not parsed as ones: coreutils takes
// **every leading argument** that is made only of those letters, and stops at the first thing that is
// not — so `echo -n -e x` has two flags and `echo x -n` prints `x -n`. That is why this reads `a.own`,
// the applet's own arguments raw, rather than `a.flags`, which has already decided what an option is
// and would have swallowed a `-n` from the middle.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";
import { Buf } from "../../../bytes/src/buf.wac";

export i32 echo(Core core, Cli cli, Args a) {
  bool newline = true;
  bool escapes = false;
  i32 from = 0;
  while (from < a.own.len() && isFlagWord(a.own[from])) {
    u8[] b = a.own[from].toBytes();
    for (i32 i = 1; i < b.len(); i++) {
      if (b[i] == 'n') { newline = false; }
      if (b[i] == 'e') { escapes = true; }
      if (b[i] == 'E') { escapes = false; }
    }
    from++;
  }

  Buf out = Buf.create();
  for (i32 i = from; i < a.own.len(); i++) {
    if (i > from) { out.push(' '); }
    if (escapes) {
      if (!expandInto(out, a.own[i].toBytes())) {
        // `\c` stops everything, newline included — the one escape that is not a character.
        cli.write(out.take());
        return 0;
      }
    } else {
      out.pushAll(a.own[i].toBytes());
    }
  }
  if (newline) { out.push(10); }
  cli.write(out.take());
  return 0;
}

/** A leading word made only of `-n`, `-e` and `-E`, which is what coreutils treats as flags. */
bool isFlagWord(string s) {
  u8[] b = s.toBytes();
  if (b.len() < 2 || b[0] != '-') { return false; }
  for (i32 i = 1; i < b.len(); i++) {
    if (b[i] != 'n' && b[i] != 'e' && b[i] != 'E') { return false; }
  }
  return true;
}

/**
 * `-e`'s escapes. False when `\c` was seen, which means stop and print no more.
 *
 * A backslash before anything else is kept as a backslash *and* the character, which is what coreutils
 * does — it is not an error and not a silent drop.
 */
bool expandInto(Buf out, u8[] s) {
  i32 i = 0;
  while (i < s.len()) {
    if (s[i] != 92 || i + 1 >= s.len()) { out.push(s[i]); i++; continue; }
    i32 c = s[i + 1];
    if (c == 92) { out.push(92); i = i + 2; continue; }
    if (c == 'a') { out.push(7); i = i + 2; continue; }
    if (c == 'b') { out.push(8); i = i + 2; continue; }
    if (c == 'c') { return false; }
    if (c == 'e') { out.push(27); i = i + 2; continue; }
    if (c == 'f') { out.push(12); i = i + 2; continue; }
    if (c == 'n') { out.push(10); i = i + 2; continue; }
    if (c == 'r') { out.push(13); i = i + 2; continue; }
    if (c == 't') { out.push(9); i = i + 2; continue; }
    if (c == 'v') { out.push(11); i = i + 2; continue; }
    if (c == '0') {
      // `\0NNN`: up to three octal digits after the zero.
      i32 v = 0;
      i32 k = i + 2;
      i32 digits = 0;
      while (k < s.len() && digits < 3 && s[k] >= '0' && s[k] <= '7') {
        v = v * 8 + (s[k] - '0');
        k++;
        digits++;
      }
      out.push(v & 255);
      i = k;
      continue;
    }
    if (c == 'x') {
      i32 v = 0;
      i32 k = i + 2;
      i32 digits = 0;
      while (k < s.len() && digits < 2 && hexDigit(s[k]) >= 0) {
        v = v * 16 + hexDigit(s[k]);
        k++;
        digits++;
      }
      // `\x` with no digit after it is a literal `\x`, which is what coreutils prints.
      if (digits == 0) { out.push(92); out.push('x'); i = i + 2; continue; }
      out.push(v & 255);
      i = k;
      continue;
    }
    out.push(92);
    out.push(c);
    i = i + 2;
  }
  return true;
}

i32 hexDigit(i32 c) {
  if (c >= '0' && c <= '9') { return c - '0'; }
  if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
  if (c >= 'A' && c <= 'F') { return c - 'A' + 10; }
  return -1;
}
