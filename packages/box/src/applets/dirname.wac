// Everything but the last path component.

import { Output, Files } from "std";
import { Args } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { dirName } from "../lib/path.wac";
import { missingOperand } from "../lib/operands.wac";

export i32 dirname(Output err, Output out, Files fs, Args a) {
  if (refuseFlags(err, a)) { return 1; }
  if (a.rest.len() < 1) { return missingOperand(err, a.name, ""); }
  // **Every operand, not the first.** `dirname a b c` prints three lines in GNU and printed one here,
  // so a loop over a list of paths silently lost all but the first.
  for (i32 i = 0; i < a.rest.len(); i++) {
    out.line(string.fromBytes(dirName(a.rest[i].toBytes())));
  }
  return 0;
}
