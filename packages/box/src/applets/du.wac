// Total bytes under a path — `stat` and `readDir` doing real work together.
//
// **A total that is short is not a total.** An unreadable directory and the depth bound both used to
// contribute zero and leave the exit status at 0, so `du` reported a number that looked like an
// answer and was not. Anything that could not be counted is now said out loud and the status is
// nonzero, while the partial figure is still printed — which is what GNU's does.

import { Cli, Core, Stat } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { itoa, itoa64 } from "../../../fmt/src/itoa.wac";
import { Fs } from "../../../fs/src/fs.wac";

/** As in `find`: a bound rather than a cycle check, because `stat` cannot see a symlink. */
i32 MAX_DEPTH() { return 64; }

/** A subtotal, and whether everything under it was actually counted. */
struct Sum { i64 bytes; bool complete; }

export i32 du(Core core, Cli cli, Fs fs, Args a) {
  if (refuseFlags(core, a)) { return 1; }
  string root = a.rest.len() < 1 ? "." : a.rest[0];
  Stat st = fs.stat(root);
  if (!st.exists) { core.warn(a.name + ": " + root + ": not found"); return 1; }
  if (!st.isDir) {
    core.log(itoa64(st.size) + "\t" + root);
    return 0;
  }
  Sum s = sizeOf(core, cli, fs, a.name, root, 0);
  core.log(itoa64(s.bytes) + "\t" + root);
  return s.complete ? 0 : 1;
}

Sum sizeOf(Core core, Cli cli, Fs fs, string name, string dir, i32 depth) {
  if (depth > MAX_DEPTH()) {
    core.warn(name + ": " + dir + ": deeper than " + itoa(MAX_DEPTH()) +
      " levels, not counting further");
    return Sum(0, false);
  }
  string[]? names = fs.readDir(dir);
  if (names is null) {
    core.warn(name + ": " + dir + ": cannot read directory");
    return Sum(0, false);
  }
  string[] found = names!;
  i64 total = 0;
  bool complete = true;
  for (i32 i = 0; i < found.len(); i++) {
    string path = dir + "/" + found[i];
    Stat st = fs.stat(path);
    if (st.isDir) {
      Sum sub = sizeOf(core, cli, fs, name, path, depth + 1);
      total = total + sub.bytes;
      if (!sub.complete) { complete = false; }
    } else {
      total = total + st.size;
    }
  }
  return Sum(total, complete);
}
