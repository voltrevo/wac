// Every path under a root, depth first.
//
// **A partial answer is reported, never returned quietly.** Two things can cut the walk short — a
// directory that cannot be read, and the depth bound below — and both used to `return` with nothing
// said, so `find` printed an incomplete listing and exited 0. A listing that is silently incomplete
// is worse than an error, because the caller's next step is to act on it: `find | xargs rm` on a
// truncated list deletes the wrong set.

import { Stat, Output, Files } from "std";
import { Args } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { reason } from "../../../fs/src/words.wac";

/**
 * How deep the walk goes.
 *
 * A depth bound rather than a cycle check, because `stat` does not distinguish a symbolic link and a
 * loop through one is otherwise unbounded. Deeper than anything ordinary and still arbitrary, which
 * is why reaching it is now an error rather than a quiet stop — GitHub wac-mono#13, and the real fix
 * is link-aware metadata in `platform` (#25).
 */
i32 MAX_DEPTH() { return 64; }

export async i32 find(Output err, Output out, Files fs, Args a) {
  if (refuseFlags(err, a)) { return 1; }
  string root = a.rest.len() < 1 ? "." : a.rest[0];
  auto looked = await fs.stat(root);
  Stat? st = looked.ok();
  // GNU quotes the path and gives no frame: `find: 'nosuch': No such file or directory`. Same story
  // as `du` next door — an invented phrase for every absence, so a path with no read grant and a path
  // that is genuinely missing were one answer.
  if (st is null) {
    err.line(a.name + ": '" + root + "': " + reason(looked.err()!));
    return 1;
  }
  out.line(root);
  return await walk(err, out, fs, a.name, root, 0) ? 0 : 1;
}

/** False if any part of this subtree could not be listed. */
async bool walk(Output err, Output out, Files fs, string name, string dir, i32 depth) {
  if (depth > MAX_DEPTH()) {
    err.line("\{name}: \{dir}: deeper than \{MAX_DEPTH()}" +
      " levels, not descending (a symlink loop, or a genuinely deep tree)");
    return false;
  }
  string[]? names = (await fs.readDir(dir)).ok();
  if (names is null) {
    err.line("\{name}: \{dir}: cannot read directory");
    return false;
  }
  string[] found = names!;
  bool complete = true;
  for (i32 i = 0; i < found.len(); i++) {
    string path = "\{dir}/\{found[i]}";
    out.line(path);
    Stat? st = (await fs.stat(path)).ok();
    if ((st is not null) && st!.isDir) {
      if (!(await walk(err, out, fs, name, path, depth + 1))) { complete = false; }
    }
  }
  return complete;
}
