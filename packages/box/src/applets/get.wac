// An HTTP GET, to standard output. `box get example.com /path -80 -i`.
//
// The counterpart to `serve`, and the reason `connect` exists.

import { Net, Output, Files } from "std";
import { Args, has } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { fetch } from "../lib/fetch.wac";

export i32 get(Output err, Output out, Net net, Files fs, Args a) {
  if (refuseFlags(err, a)) { return 1; }
  if (a.rest.len() < 1) {
    err.line("usage: \{a.name} <host> [path] [-<port>] [-i]");
    return 2;
  }
  return fetch(err, out, net, a.name, a.rest[0], a.rest.len() > 1 ? a.rest[1] : "/",
               a.hasNum ? a.num : 80, has(a, 'i'));
}
