// Encoded, with a trailing newline. Two characters per byte and no alignment to keep, so
// each chunk encodes on its own and the newline is the only thing left for the end.

import { Input, Output, Files } from "std";
import { Args } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { Span, nextSpan } from "../lib/input.wac";
import { encode as hexencode } from "../../../codec/src/hex.wac";
import { Feed } from "../../../platform/src/stream.wac";

export async i32 hex(Input stdin, Output err, Output out, Files fs, Args a) {
  if (refuseFlags(err, a)) { return 1; }
  i32 at = 0;
  bool opened = false;
  bool failed = false;
  // The feed travels with the span: it changes at an operand boundary, and on anything but a host mount
  // it serves bytes this filesystem handed over rather than pulling on the process's own input.
  Feed fed = Feed.of(u8[]());
  while (true) {
    Span got = await nextSpan(stdin, err, fs, a, at, opened, fed);
    fed = got.fed;
    failed = failed || got.failed;
    if (!got.ok) { return 1; }
    opened = true;
    at = got.at;
    if (!got.more) { break; }
    u8[] chunk = got.bytes;
    out.write(hexencode(chunk));
  }
  out.write(u8[].filled(1, '\n'));
  return failed ? 1 : 0;
}
