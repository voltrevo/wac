// Lines, words and bytes, for each file named, with a total when there is more than one.
//
// Counted a chunk at a time. The only state that has to survive a chunk boundary is `inWord`: a word
// split across two reads is one word, and forgetting that would count it twice — which is the whole
// difficulty of turning a whole-input loop into a streaming one.
//
// ## Two things this got wrong, both by believing a comment
//
// It read the first operand and ignored the rest, so `wc -l *.txt` over twelve files answered about one
// and said nothing (wac-mono 0096). And where it did print, the line above the single-flag paths said
// "one number and no label when exactly one of -l -w -c is asked for, **as the real one does**" — which
// is not what the real one does:
//
//     $ wc -l a.txt          $ wc -l < a.txt
//     3 a.txt                3
//
// The label goes with the *file*, not with the number of columns. Reading from standard input is what
// drops it, because there is no name to print. The comment described `wc -l < f` and the code was written
// to match the comment.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args, has } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { Chunk, Input, openStream, nextChunk, operandAt, operandCount } from "../lib/input.wac";
import { isWordSeparator } from "../lib/words.wac";
import { Scalar, decode, TRUNCATED } from "../../../unicode/src/utf8.wac";
import { isPrintable } from "../../../unicode/src/tables.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { Fs } from "../../../fs/src/fs.wac";
import { Stat } from "../../../platform/src/platform.wac";
import { Feed } from "../../../platform/src/stream.wac";

/** One file's counts. */
struct Counts { i32 lines; i32 words; i32 bytes; }

export i32 wc(Core core, Cli cli, Fs fs, Args a) {
  if (refuseFlags(core, a)) { return 1; }
  i32 files = operandCount(a, 0);
  // No operands means standard input, which is one unnamed pass.
  i32 count = files == 0 ? 1 : files;

  // **The width comes from `stat`, before anything is read**, which is what lets each line be printed as
  // its file is counted rather than all of them at the end.
  //
  // The columns are right-aligned to the digits in the total *byte* count — which is why `wc -l` over two
  // small files still pads to three when they are 408 bytes between them, and only makes sense once you
  // know it is the size being measured. This used to derive that from the counting, so no line could be
  // printed until every file had been read: `wc -l a missing b` printed its complaint about `missing`
  // before `a`'s count, where GNU interleaves them (wac-mono 0112). GNU stats the operands and gets the
  // same number without reading a byte, and so does this now.
  //
  // A file it cannot stat contributes nothing, which is also GNU's answer: `wc -l big missing tiny` pads
  // to the digits of `big` plus `tiny`.
  i32 asked = (has(a, 'l') ? 1 : 0) + (has(a, 'w') ? 1 : 0) + (has(a, 'c') ? 1 : 0);
  // **A `-` operand is standard input, and standard input has no size to stat** — so `wc -` pads to seven
  // exactly as `wc` with no operand does, and prints `-` as the label. The rule was written as "no
  // operands", which was the only way to reach stdin before a lone dash meant it.
  bool fromStdin = files == 0;
  i64 totalSize = 0 as i64;
  for (i32 f = 0; f < files; f++) {
    string path = operandAt(a, f);
    if (path == "") { fromStdin = true; continue; }
    Stat st = fs.stat(path);
    // **Something with no size to take** — a directory, a device — puts the whole run on the fallback
    // width, exactly as standard input does: `wc -l f somedir` pads to seven where `wc -l f g` pads to
    // the digits of their total. Measured, not reasoned about; a missing operand is *not* one of these,
    // because there is nothing there to be unsizeable.
    if (st.exists && !st.isFile) { fromStdin = true; }
    if (st.exists && st.isFile) { totalSize = totalSize + st.size; }
  }
  // Measured one flag combination at a time rather than reasoned about:
  //
  //     wc -l a.txt              ->  `3 a.txt`            one column, one input: no padding at all
  //     wc -lw big.txt           ->  `  6   6 big.txt`    two columns: the width of the total size
  //     wc -l big.txt tiny.txt   ->  `  6 big.txt` …      two inputs: likewise, and a `total` row
  //     printf … | wc -lw        ->  `      2       3`    nothing to stat: seven
  bool single = asked == 1 && count == 1;
  i32 width = single ? 1 : (fromStdin ? 7 : digits(totalSize as! i32));

  Counts total = Counts(0, 0, 0);
  // A file that will not open is reported, skipped, and the status at the end — GNU's rule, and until
  // this it stopped the run, so `wc -l a missing b` printed nothing at all, not even `a`'s count.
  i32 status = 0;
  for (i32 f = 0; f < count; f++) {
    Input in = openStream(core, cli, fs, a, f, -1);
    if (!in.ok) { status = 1; continue; }
    Feed fed = in.fed;
    Counts one = Counts(0, 0, 0);
    bool inWord = false;
    // **A run of non-whitespace is only a word if something in it is printable**, which is GNU's rule
    // and not the obvious one: `printf '\001\002' | wc -w` is 0, and `a \377 b` is *two* words rather
    // than three. Counting every run made `wc -w` disagree with the real one on any input that is not
    // text — and nothing had asked, because every case anyone had written was text.
    //
    // **Both halves of that rule are about code points, not bytes**, and this used to apply them to
    // bytes. The comment here said it was measuring the C locale because "there is no such locale to
    // compare against" for the other one — which was wrong twice over: `locale -a` lists `C.utf8`, and
    // `LC_ALL` on this machine *is* `C.UTF-8`, so the real `wc` every differential runs against was
    // already answering the UTF-8 question. Nothing caught it because no fixture had a byte over 0x7F.
    // On `spec/tour.wac` the two disagreed by 110 words, every one of them a run of `—` or `─` that has
    // no ASCII printable in it (issues/system 0143).
    //
    // So a run is walked as scalars now: `isWordSeparator` for the twenty-three code points GNU ends a
    // word on, and `isPrintable` for whether the run is a word at all. An invalid sequence decodes to
    // `INVALID` with a size of 1 and is neither — which is GNU's answer too, and is what keeps
    // `a \377 b` at two words rather than three.
    bool printable = false;
    // A sequence that runs off the end of a chunk, held until the next one arrives. The whole difficulty
    // of the streaming form, twice over: `inWord` already had to survive a boundary, and now a *character*
    // can straddle one. Left unclassified at end of input, which costs nothing — the bytes of a truncated
    // sequence are never printable, and only a printable makes a run a word.
    u8[] pend = u8[0](fill: 0);
    // A read that fails part way is a different thing from one that never opened, and GNU words the
    // difference in the output as well as in the message: a **directory** gets a row of zeroes, because
    // it was there and was named, while a missing file gets no row at all. Both leave the status at 1.
    bool unread = false;
    while (true) {
      Chunk got = nextChunk(core, cli, fed, a, in.label);
      if (!got.ok) { unread = true; break; }
      if (!got.more) { break; }
      u8[] data = got.bytes;
      one.bytes = one.bytes + data.len();
      i32 i = 0;
      // The held bytes plus enough of this chunk to finish the sequence — at most three, so this is a
      // four-byte copy and not a copy of the chunk.
      if (pend.len() > 0) {
        i32 take = data.len() < 3 ? data.len() : 3;
        u8[] head = u8[pend.len() + take](fill: 0);
        for (i32 k = 0; k < pend.len(); k++) { head[k] = pend[k]; }
        for (i32 k = 0; k < take; k++) { head[pend.len() + k] = data[k]; }
        Scalar sc = decode(head, 0);
        if (sc.code == TRUNCATED()) {
          // A chunk of one or two continuation bytes, which is possible however large the reads are:
          // hold the lot and ask for more.
          pend = head;
          continue;
        }
        i = sc.size - pend.len();
        pend = u8[0](fill: 0);
        if (sc.code == '\n') { one.lines++; }
        if (isWordSeparator(sc.code)) {
          if (inWord && printable) { one.words++; }
          inWord = false;
          printable = false;
        } else {
          inWord = true;
          if (isPrintable(sc.code)) { printable = true; }
        }
      }
      while (i < data.len()) {
        Scalar sc = decode(data, i);
        if (sc.code == TRUNCATED()) {
          u8[] rest = u8[data.len() - i](fill: 0);
          for (i32 k = 0; k < rest.len(); k++) { rest[k] = data[i + k]; }
          pend = rest;
          break;
        }
        i32 cp = sc.code;
        if (cp == '\n') { one.lines++; }
        if (isWordSeparator(cp)) {
          // Counted at the *end* of a run rather than at its start, because whether it is a word is not
          // known until the run is over.
          if (inWord && printable) { one.words++; }
          inWord = false;
          printable = false;
        } else {
          inWord = true;
          if (isPrintable(cp)) { printable = true; }
        }
        i = i + sc.size;
      }
    }
    // The last run, which no space closed.
    if (inWord && printable) { one.words++; }
    // Printed here rather than collected: the width is already known, and a complaint about the next
    // operand must not arrive before this line.
    if (unread) {
      core.log(row(a, Counts(0, 0, 0), in.label, width));
      status = 1;
      continue;
    }
    core.log(row(a, one, in.label, width));
    total.lines = total.lines + one.lines;
    total.words = total.words + one.words;
    total.bytes = total.bytes + one.bytes;
  }

  // A total only when there was more than one file to total, which is the real one's rule. It counts the
  // files that were read, since the ones that were not have no counts to add.
  if (files > 1) { core.log(row(a, total, "total", width)); }
  return status;
}

/** How many characters a count needs, at least one. */
i32 digits(i32 n) {
  i32 d = 1;
  i32 x = n;
  while (x >= 10) { d++; x = x / 10; }
  return d;
}

/** `s` right-aligned in `width`, which is how every column here is printed. */
string pad(string s, i32 width) {
  string out = s;
  for (i32 i = s.toBytes().len(); i < width; i++) { out = " " + out; }
  return out;
}

/**
 * One line of output: the columns asked for, right-aligned in `width`, then the label if there is one.
 *
 * The padding used to be missing, and `test/box.test.ts` compensated by comparing the numbers rather than
 * the text — which is how a *missing filename* then went unnoticed, because the comparison that would have
 * caught it had already been loosened for the padding. Matching the real one exactly is what lets the test
 * compare bytes.
 */
string row(Args a, Counts c, string label, i32 width) {
  bool l = has(a, 'l');
  bool w = has(a, 'w');
  bool b = has(a, 'c');
  string nums = "";
  if (!l && !w && !b) {
    nums = pad(itoa(c.lines), width) + " " + pad(itoa(c.words), width) + " " + pad(itoa(c.bytes), width);
  } else {
    if (l) { nums = pad(itoa(c.lines), width); }
    if (w) { nums = nums == "" ? pad(itoa(c.words), width) : nums + " " + pad(itoa(c.words), width); }
    if (b) { nums = nums == "" ? pad(itoa(c.bytes), width) : nums + " " + pad(itoa(c.bytes), width); }
  }
  return label == "" ? nums : nums + " " + label;
}
