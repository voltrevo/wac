// Start what the system says to start, and reap it — design/0001 step 7's other half.
//
//   init                 # reads /etc/init
//   init /etc/other      # or wherever
//
// Step 7 is "`init`, and a system that boots: something owns the image, starts the daemons, and
// reaps." `sshd -i image` is the first half — one program that owns an image and serves sessions from
// it — and this is the second: a system whose services are **data in the image**, started by a program
// that then waits for them.
//
// ## What a service is here
//
// One line of `/etc/init`, which is a command: the program's name and its arguments, split on spaces.
// Blank lines and `#` comments are skipped. Each line becomes a child through `spawnSelf`, so a
// service is one of this binary's own applets — its own instance, its own grants, actually concurrent.
//
// **The file is the system's, not this program's.** That is the whole point of step 7: what runs at
// boot is something you can `cat`, edit and save in the image, rather than a list compiled into a
// binary. An image with no `/etc/init` starts nothing and says so, which is not an error — a system
// with no services is a system.
//
// ## What this is not, said plainly
//
// **Not a supervisor.** No restart policy, no dependency order, no health checks, no readiness. Those
// are design/0001's own open question — "supervision is named in D8 and in none of the eight steps:
// either it belongs in step 7's definition of done or it is a ninth step" — and this does not settle
// it. What is here is start, wait, report, reap.
//
// **Shutting down is when the last service stops** — the operator, 2026-08-12, answering the question
// this paragraph used to ask. A system is up for as long as something is running in it, and it ends
// when the thing it was running for has ended. That is the whole policy, and it needed no mechanism:
// the loop below already reaps every service and returns, and whoever holds the image writes it on
// the way out, so what a service wrote is there at the next boot. What this program gained was the
// sentence saying so, because a boot that trails off and a boot that finished look identical in a
// log.
//
// **The corollary is the part worth reading twice: a system whose services never exit never shuts
// itself down.** `sshd -i image` is exactly that, and it is the intended shape rather than an
// oversight — a machine sits there. Stopping *that* is whoever started it, from outside.
//
// **The mechanism nobody needs for this stays for the supervisor that will.** `Cli.closeSocket` on a
// child's handle stops it on every host since issue 0123 — a wasmtime guest through an epoch
// deadline, a worker terminated — and `exitCode` then answers -1 rather than throwing. A restart
// policy, a failing service taking the rest down, a shutdown asked for from outside: each of those
// is a supervisor, each needs that mechanism, and none of them is this. design/0001's open question
// about supervision is still open and this does not settle it.
//
// The distinction matters because a "supervisor" that quietly did neither would look like the real
// thing until the first service died.

import { Child, Cli, Core, GRANT_NONE, Pending } from "../../../platform/src/platform.wac";
import { Chan } from "../../../fs/src/remote.wac";
import { serveOn } from "../../../fs/src/serve.wac";
import { argvOf } from "../../../platform/src/stream.wac";
import { Fs } from "../../../fs/src/fs.wac";
import { FileResult, readReason } from "../../../platform/src/platform.wac";
import { Vec } from "core/vec.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { Args } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { Read } from core;

/** One line of `/etc/init`, as words. Empty for a blank line or a comment. */
string[] words(string line) {
  Vec<string> out = Vec.create();
  string word = "";
  u8[] b = line.toBytes();
  for (i32 i = 0; i < b.len(); i++) {
    // A `#` starts a comment wherever it is, which is what every init file this imitates does — and
    // means a service cannot have a `#` in an argument. Said here rather than discovered.
    if (b[i] == '#') { break; }
    if (b[i] == ' ' || b[i] == 9) {
      if (word.len() > 0) { out.push(word); word = ""; }
      continue;
    }
    word = word + string.fromCodepoint(b[i]);
  }
  if (word.len() > 0) { out.push(word); }
  string[] made = string[out.len()](fill: "");
  for (i32 i = 0; i < out.len(); i++) { made[i] = out.get(i); }
  return made;
}

/** The lines of a file, without their newlines. */
Vec<string> lines(u8[] bytes) {
  Vec<string> out = Vec.create();
  string line = "";
  for (i32 i = 0; i < bytes.len(); i++) {
    if (bytes[i] == 10) { out.push(line); line = ""; continue; }
    line = line + string.fromCodepoint(bytes[i]);
  }
  if (line.len() > 0) { out.push(line); }
  return out;
}

export i32 init(Core core, Cli cli, Fs fs, Args a) {
  if (refuseFlags(core, a)) { return 1; }
  string path = a.rest.len() > 0 ? a.rest[0] : "/etc/init";

  FileResult f = fs.readFile(fs.at(path));
  if (!f.ok) {
    // Absent is not a failure: a system with no services is a system. Said out loud, because a boot
    // that started nothing in silence is indistinguishable from one that started everything and lost
    // the output.
    core.warn("init: " + path + ": " + readReason(f) + "; nothing to start");
    return 0;
  }

  Vec<string> all = lines(f.bytes);
  Vec<i32> handles = Vec.create();
  /** Each service's *error* stream, which nothing read — see the relay below. */
  Vec<i32> errs = Vec.create();
  /** Each service's filesystem channel, or null where this program serves none. */
  Vec<Chan?> chans = Vec.create();
  Vec<string> names = Vec.create();
  for (i32 i = 0; i < all.len(); i++) {
    string[] argv = words(all.get(i));
    if (argv.len() == 0) { continue; }
    // `GRANT_NONE`: a service gets what it is given and nothing more, and nothing here has a way to
    // say what it should be given. That is a gap rather than a decision — an `/etc/init` that could
    // name grants per service is the next thing this file wants — and `GRANT_NONE` is the honest
    // floor rather than handing every service everything this program has.
    //
    // **…and the system's filesystem, which is the thing it had none of.** A service started with no
    // grants and no channel had no filesystem at all: `/etc/init` saying `cat /etc/motd` started
    // `cat`, which could not see the image the line was read out of, and exited 1. Every service that
    // touched a file failed, on a system whose whole point is that what boots is data in the image.
    //
    // It asks *this program* now, over the channel wac-mono 0116 built, and this program is itself a
    // spawned applet whose filesystem is the session's — so the question travels the chain and is
    // answered by whoever actually holds the image. Grants stay `GRANT_NONE`: a service needs no
    // capability of its own precisely because it asks.
    bool serve = !fs.isPlainHost();
    Child kid = cli.spawnSelf(argvOf(argv), GRANT_NONE, "", false, serve).wait();
    if (kid.unavailable()) {
      core.warn("init: this world cannot spawn, so no service can start");
      return 1;
    }
    if (kid.handle < 0) {
      core.warn("init: " + argv[0] + ": " + kid.error);
      continue;
    }
    // Nothing feeds a service's input, and a service that waits for one would wait for ever.
    cli.closeFeed(kid.handle);
    handles.push(kid.handle);
    errs.push(kid.errHandle);
    chans.push(serve && kid.fsHandle >= 0 ? Chan.of(cli, kid.fsHandle) : null);
    names.push(argv[0]);
    core.log("init: started " + argv[0]);
  }

  if (handles.len() == 0) {
    core.log("init: nothing to start");
    return 0;
  }

  // **Reaping is the half that makes this init rather than a launcher.** Each service is waited for
  // and its status reported; a child nobody waits for is a row in the process table that never goes.
  //
  // In order rather than by `waitAny`, and the difference is worth stating: `waitAny` would report
  // them as they end, which is what a supervisor wants and what a *restart policy* would need. This
  // has none, so the order it reports in is the order they were started, which is stable and
  // therefore testable. When there is a policy, this loop is what changes.
  i32 worst = 0;
  for (i32 i = 0; i < handles.len(); i++) {
    i32 h = handles.get(i);
    // Whatever the service wrote, before its status — otherwise a service's own words arrive after
    // the line saying it ended.
    i32 eh = errs.get(i);
    // **A service's diagnostics were thrown away.** This read `kid.handle` and never `errHandle`, so
    // when every service was failing for want of a filesystem, all a boot said was "exited 1". For an
    // init system the diagnostics are the part that matters: a service that dies is expected, and a
    // service that dies without saying why is a system you cannot fix.
    //
    // **And all three streams at once**, for the reason `packages/sh` learned: a service blocked on a
    // question this program has not answered writes nothing, so reading its output first would be
    // waiting for a service that is waiting for this loop. The channels of *every* service are in the
    // wait, not just this one's — they were all started before any of them is reaped, and a service
    // further down the list must not be stalled by the one being read.
    bool reading = true;
    bool complaining = eh >= 0;
    Pending<Read> outT = cli.recv(h);
    Pending<Read> errT = complaining ? cli.recv(eh) : outT;
    while (reading || complaining) {
      i32 live = (reading ? 1 : 0) + (complaining ? 1 : 0);
      for (i32 k = 0; k < chans.len(); k++) { if (!(chans.get(k) is null)) { live++; } }
      i32[] ids = i32[live](fill: 0);
      i32[] what = i32[live](fill: -1);
      i32 at = 0;
      if (reading) { ids[at] = outT.id; what[at] = -2; at++; }
      if (complaining) { ids[at] = errT.id; what[at] = -3; at++; }
      for (i32 k = 0; k < chans.len(); k++) {
        if (!(chans.get(k) is null)) { ids[at] = chans.get(k)!.waitId(); what[at] = k; at++; }
      }
      i32 which = core.waitAny(ids, -1);
      if (which < 0) { break; }
      i32 kind = what[which];
      if (kind >= 0) {
        if (!serveOn(chans.get(kind)!, fs)) { chans.set(kind, null); }
      } else if (kind == -2) {
        match (outT.wait()) {
          case Data(bytes): { cli.write(bytes); outT = cli.recv(h); }
          case End: { reading = false; }
          case Failed(why): { reading = false; }
        }
      } else {
        match (errT.wait()) {
          case Data(bytes): { cli.writeErr(bytes); errT = cli.recv(eh); }
          case End: { complaining = false; }
          case Failed(why): { complaining = false; }
        }
      }
    }
    // This service will ask nothing more; the others still might.
    chans.set(i, null);
    i32 code = cli.exitCode(h).wait();
    cli.closeSocket(h);
    if (eh >= 0) { cli.closeSocket(eh); }
    core.log("init: " + names.get(i) + " exited " + itoa(code));
    if (code != 0 && worst == 0) { worst = code; }
  }
  // **The system ends here, and says so.** Every service has stopped, which is the trigger — see the
  // header. Without this line a boot that finished and a boot that was killed part-way through read
  // the same in a log, which is the one thing a shutdown notice is for.
  core.log("init: all services have stopped");
  return worst;
}
