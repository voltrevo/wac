// Soak up all of standard input, *then* write the file.
//
// The applet that only exists because of the atomic write. `box sort f | box sponge f`
// works where `box sort f > f` cannot: the shell truncates `f` before `sort` has read it,
// and this does not touch the target until every byte has arrived.

import { Change, Cli, Core, reasonOf } from "std/platform.wac";
import { Args } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { Input, openStream } from "../lib/input.wac";
import { streamAtomic } from "../lib/safe.wac";
import { Fs } from "../../../fs/src/fs.wac";
import { Feed } from "../../../platform/src/stream.wac";

export i32 sponge(Core core, Cli cli, Fs fs, Args a) {
  if (refuseFlags(core, a)) { return 1; }
  if (a.rest.len() < 1) { core.warn("usage: " + a.name + " <file>"); return 2; }
  Input in = openStream(core, cli, fs, a, 1, -1);   // index 1: the file is the destination
  if (!in.ok) { return 1; }
  Feed fed = in.fed;
  Change wrote = streamAtomic(core, cli, fs, fed, a.rest[0]);
  if (wrote.ok()) { return 0; }
  core.warn(a.name + ": " + a.rest[0] + ": " + reasonOf(wrote));
  return 1;
}
