// Standard input to a socket and the socket back to standard output, both at once.
//
//   box nc host 80
//   box nc -8080 -l          # listen instead, and serve one connection
//
// **The applet that could not be written until `waitAny` existed.** A relay has to watch
// two sources: the socket, and standard input. Waiting on either one alone means the other
// is blocked — read the socket first and a client that speaks first is never heard; read
// stdin first and a server that greets you is never printed. Polling both with `isDone`
// spins a core to avoid parking.
//
// Standard input is handle 0, so both sides are the same primitive: two `recv` calls in
// flight and a park on whichever answers. That is the whole loop, and it is why stdin was
// given a handle rather than a second ticket-returning read of its own.

import { HostFault, Input, Net, Output, Socket, SocketFault, Listener } from "std";
import { Args, has } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { atoi } from "../../../fmt/src/itoa.wac";
import { Read, Result, Ticket, flatten } from "core";

export async i32 nc(Input stdin, Output err, Output out, Net net, Args a) {
  if (refuseFlags(err, a)) { return 1; }
  Socket? opened = has(a, 'l') ? await accepted(err, net, a) : await dialled(err, net, a);
  if (opened is null) { return 1; }
  Socket peer = opened!;

  Ticket<Result<Read, SocketFault>> fromPeer = peer.recv();
  Ticket<Result<Read, HostFault>> fromUser = stdin.chunk();
  bool userDone = false;

  while (true) {
    i32 which = userDone ? 0 : await Ticket.first([fromPeer, fromUser]);

    if (which == 0) {
      match (await fromPeer) {
        Ok(r): {
          match (r) {
            Data(bytes): { await out.write(bytes); fromPeer = peer.recv(); continue; }
            End: { }                        // the peer closed; we are done
            Failed(why): { err.line("\{a.name}: \{why}"); peer.close(); return 1; }
          }
        }
        Err(e): { err.line("\{a.name}: \{e}"); peer.close(); return 1; }
      }
      break;
    }

    match (await fromUser) {
      Ok(r): {
        match (r) {
          Data(bytes): {
            if ((await peer.send(bytes)).isErr()) { fromPeer.cancel(); break; }
            fromUser = stdin.chunk();
          }
          // Our input ended; keep printing what the peer sends until it closes.
          End: { userDone = true; }
          Failed(why): { err.line("\{a.name}: \{why}"); peer.close(); return 1; }
        }
      }
      Err(e): { err.line("\{a.name}: \{e}"); peer.close(); return 1; }
    }
  }

  // **The read still out on whichever side did not end is abandoned**, not left: a peer that closes before
  // our input does leaves a `chunk` nobody will collect, and a host that counts what a finished program
  // left waiting calls the run unfinished. A settled one ignores the cancel.
  fromUser.cancel();
  peer.close();
  return 0;
}

/** `nc host port`, or `nc host -port`. */
async Socket? dialled(Output err, Net net, Args a) {
  if (a.rest.len() < 1) {
    err.line("usage: \{a.name} <host> <port>   |   \{a.name} -<port> -l");
    return null;
  }
  i32 port = !a.hasNum && a.rest.len() > 1 ? atoi(a.rest[1]) : a.num;
  match (await net.connect(a.rest[0], port)) {
    Ok(s): { return s; }
    Err(e): {
      err.line("\{a.name}: \{a.rest[0]}: \{e}");
      return null;
    }
  }
}

/** `nc -<port> -l`: bind, take one connection, relay it. */
async Socket? accepted(Output err, Net net, Args a) {
  Listener l;
  match (await net.listen("", a.num)) {
    Ok(bound): { l = bound; }
    Err(e): {
      err.line("\{a.name}: \{a.num}: \{e}");
      return null;
    }
  }
  err.line("\{a.name}: listening on port \{l.port}");
  auto took = await l.accept();
  l.close();
  if (took.isErr()) { err.line("\{a.name}: accept: \{took.err()!}"); }
  return took.ok();
}
