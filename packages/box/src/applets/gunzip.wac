// Decompress standard input, or a file, to standard output.
//
// `gunzipStream` pulls its input through `fn<Read()>` from deep inside its loop, and input in this world is
// awaited — a page's arrives later — so the applet awaits all of it and hands the transform a reader
// over what it has (`readerOf`). The output still streams as it is produced.

import { Input, Output, Files } from "std";
import { Args } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { Opened, openStream } from "../lib/input.wac";
import { readerOf } from "../../../platform/src/stream.wac";
import { flatten } from "core";
import { gunzipStream } from "../../../gzip/src/inflate.wac";

export async i32 gunzip(Input stdin, Output err, Output out, Files fs, Args a) {
  if (refuseFlags(err, a)) { return 1; }
  Opened in = await openStream(stdin, err, fs, a, 0);
  if (!in.ok) { return 1; }
  u8[] all = await in.fed.rest();
  return gunzipStream(readerOf(all), (u8[] b) => flatten(out.write(b).wait()).isOk());
}
