// An empty file where there was none.
//
// The real `touch` also updates the modification time of one that exists, which this
// cannot: the world can write a file's contents but not its metadata. Rewriting the file
// to move its mtime would be worse than not moving it, so an existing path is left
// exactly alone and the applet says so here rather than pretending.

import { Change, Cli, Core, reasonOf, Stat } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { missingOperand } from "../lib/operands.wac";
import { Fs } from "../../../fs/src/fs.wac";

export i32 touch(Core core, Cli cli, Fs fs, Args a) {
  if (refuseFlags(core, a)) { return 1; }
  if (a.rest.len() < 1) { return missingOperand(core, a.name, "file"); }
  i32 code = 0;
  for (i32 i = 0; i < a.rest.len(); i++) {
    Stat st = fs.stat(a.rest[i]);
    if (st.exists) { continue; }
    Change c = fs.writeFile(a.rest[i], u8[0]());
    if (c.ok()) { continue; }
    // GNU's frame: `touch: cannot touch 'f/g': Not a directory`. This said `touch: f/g: …`, which is
    // the shape most of these applets had before anything compared them against the real tool.
    core.warn(a.name + ": cannot touch '" + a.rest[i] + "': " + reasonOf(c));
    code = 1;
  }
  return code;
}
