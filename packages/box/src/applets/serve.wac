// An HTTP server. `box serve -8080`, or port 8080 by default.
//
// `packages/server`'s `serve(input, now)` is a pure state machine — bytes in, a response
// and a consumed count out — which is exactly the shape a socket wants and is why this
// applet is thirty lines. Nothing in that package knows a socket exists.
//
// **One connection at a time**, because the world has no `poll`: `accept` blocks, then
// the connection is served to its end before the next is taken. That is the honest limit
// of a synchronous capability world and it is written here rather than hidden.

import { Clock, Net, Output, Listener, Socket } from "std";
import { Args, has } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { concat } from "../lib/bytes.wac";
import { Served, serve as handle } from "../../../server/src/serve.wac";
import { Read, flatten } from "core";
import { slice } from "../../../bytes/src/slice.wac";

export i32 serve(Output err, Clock clock, Net net, Args a) {
  if (refuseFlags(err, a)) { return 1; }
  i32 port = a.num == 0 ? 8080 : a.num;
  auto lBind = flatten(net.listen("", port).wait());
  Listener? l = lBind.ok();
  if (l is null) { err.line("\{a.name}: \{port}: \{lBind.isErr() ? "\{lBind.err()!}" : ""}"); return 1; }
  err.line("\{a.name}: listening on port \{port}");

  bool once = has(a, 'o');
  while (true) {
    auto took = flatten(l!.accept().wait());
    Socket? c = took.ok();
    if (c is null) { err.line("\{a.name}: accept: \{took.isErr() ? "\{took.err()!}" : ""}"); break; }
    connection(err, clock, c!);
    c!.close();
    if (once) { break; }
  }
  l!.close();
  return 0;
}

/** One connection, to its end: read, answer, repeat while it wants to be kept alive. */
void connection(Output err, Clock clock, Socket sock) {
  u8[] buffered = u8[]();
  while (true) {
    Served s = handle(buffered, flatten(clock.nowMillis().wait()).unwrap());
    if (!s.ready) {
      match (flatten(sock.recv().wait())) {
        Ok(r): {
          match (r) {
            Data(bytes): { buffered = concat(buffered, bytes); }
            End: { return; }
            Failed(why): { err.line("serve: \{why}"); return; }
          }
        }
        Err(e): { err.line("serve: \{e}"); return; }
      }
      continue;
    }
    if (flatten(sock.send(s.response).wait()).isErr()) { return; }
    if (!s.keepAlive) { return; }
    buffered = slice(buffered, s.consumed, buffered.len());
  }
}
