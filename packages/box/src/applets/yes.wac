// The argument, forever. `y` when there is none.
//
// Not a joke entry: it is the only applet that never terminates, which makes it the one
// that shows `write` reporting a closed pipe. `yes | head -3` ends because `head` exits
// and the next write fails — without that answer this would spin.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { Fs } from "../../../fs/src/fs.wac";

export i32 yes(Core core, Cli cli, Fs fs, Args a) {
  if (refuseFlags(core, a)) { return 1; }
  string line = a.rest.len() > 0 ? a.rest[0] : "y";
  for (i32 i = 1; i < a.rest.len(); i++) { line = line + " " + a.rest[i]; }
  u8[] one = (line + "\n").toBytes();

  // A block of them, so the cost is one host call per few thousand lines rather than per
  // line. The bridge is a round trip; `yes` is the only applet where that dominates.
  i32 per = 4096;
  u8[] block = u8[one.len() * per](fill: 0);
  for (i32 i = 0; i < per; i++) { block.copyFrom(one, 0, i * one.len(), one.len()); }

  // **`^C` ends it**, which is design/system/0001 step 5's own criterion and the first thing in this
  // system that stops a *running* command. A signal cannot reach here the way `kill` reaches a shell:
  // this applet is inside `dispatch`, so the shell's check points are not executing, and an applet is
  // handed `Core`, `Cli`, `Fs` and `Args` and never a `Page`. So it asks the capability.
  //
  // Once per *block* rather than once per line: every opcode parks the worker, so this is a round
  // trip, and a block is already 4096 lines. 130 is `128 + SIGINT`, which is what a shell reports for
  // a program a `^C` ended.
  //
  // Only a host that owns the keyboard ever answers yes — a page does, Deno and wasmtime do not, and
  // say so. So this costs one extra host call per 4096 lines everywhere and does something in one.
  while (cli.write(block)) {
    if (core.interrupted()) { return 130; }
  }
  return 0;
}
