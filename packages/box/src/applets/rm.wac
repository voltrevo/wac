// Files removed; `-r` for a directory and everything under it, `-f` to say nothing
// about what was not there.
//
// **`-f` means "ignore what is already gone", not "ignore everything".** It used to mean the
// second, because `remove` answered `bool` and a missing file was indistinguishable from a
// permission denied — so `rm -f` on a file it could not delete said nothing and exited 0, and the
// file was still there. `remove` answers a `Change` now: a fault category beside the message, so
// `-f` ignores `absent()` and nothing else, in one call with nothing to race against.

import { Change, Cli, Core, reasonOf } from "std/platform.wac";
import { Args, has } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { missingOperand } from "../lib/operands.wac";
import { Fs } from "../../../fs/src/fs.wac";

export i32 rm(Core core, Cli cli, Fs fs, Args a) {
  if (refuseFlags(core, a)) { return 1; }
  bool force = has(a, 'f');
  if (a.rest.len() < 1) {
    if (force) { return 0; }
    return missingOperand(core, a.name, "");
  }
  // `-R` is GNU's own second spelling of `-r`, not a second flag.
  bool recursive = has(a, 'r') || has(a, 'R');
  i32 code = 0;
  for (i32 i = 0; i < a.rest.len(); i++) {
    Change c = fs.remove(a.rest[i], recursive);
    if (c.ok()) { continue; }
    // The only fault `-f` forgives. Everything else — denied, a non-empty directory, a disk that
    // is full — happened to a file that was there, and `-f` does not get to hide that.
    if (force && c.absent()) { continue; }
    core.warn(a.name + ": " + a.rest[i] + ": " + reasonOf(c));
    code = 1;
  }
  return code;
}
