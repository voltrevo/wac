// Lines wrapped at a width, eighty by default: `fold -w 40`, or `fold -40`.

import { Input, Output, Files } from "std";
import { Args, badNumberMessage } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { Reader } from "../lib/input.wac";
import { Line, Sink, emitTo, nextLine } from "../../../platform/src/stream.wac";
import { slice } from "../../../bytes/src/slice.wac";

export async i32 fold(Input stdin, Output err, Output out, Files fs, Args a) {
  if (refuseFlags(err, a)) { return 1; }
  if (a.badNum != "") { err.line(badNumberMessage(a)); return 1; }
  i32 width = a.hasNum ? a.num : 80;
  // **A width of zero never finishes.** `end = start + 0` leaves `start` where it was, so the inner loop
  // emits an empty line for ever — on a pipe that is an out-of-memory kill rather than a hang, which is
  // how it was found. A negative width folded nothing at all, silently. GNU refuses both, in these words.
  if (width <= 0) {
    err.line("\{a.name}: invalid number of columns: '\{width}'");
    return 1;
  }


  Sink sink = Sink.to(out);
  Reader r = await Reader.create(stdin, err, fs, a, 0, sink);
  while (true) {
    Line l = await r.next(stdin, err, fs, a);
    if (!l.ok) { sink.flush(); return r.broken || r.failed ? 1 : 0; }
    u8[] line = l.bytes;
    if (line.len() == 0) { emitTo(sink, line, l.nl); continue; }
    i32 start = 0;
    while (start < line.len()) {
      i32 end = start + width < line.len() ? start + width : line.len();
      // Only the piece that ends the line keeps the line's own terminator.
      emitTo(sink, slice(line, start, end), end < line.len() ? true : l.nl);
      start = end;
    }
  }
  return 0;
}
