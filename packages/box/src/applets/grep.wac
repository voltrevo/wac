// Lines matching a pattern. `-i` ignores case, `-v` inverts, `-n` numbers, `-c` counts.
//
// A bad pattern is a *user* error and is reported as one — the only applet where the input
// can be wrong in a way that is nobody's bug.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args, has } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { Feed, Line, Lines, Sink, nextLine } from "../../../platform/src/stream.wac";
import { Input, openStream, operandCount } from "../lib/input.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { search, slotCount } from "../../../regex/src/regex.wac";
import { Compiled } from "../../../regex/src/compile.wac";
import { compileExtended, compileExtendedIgnoreCase } from "../../../regex/src/posix.wac";
import { compileBasic, compileBasicIgnoreCase } from "../../../regex/src/basic.wac";
import { Program, BUDGET, NO_MATCH } from "../../../regex/src/program.wac";

export i32 grep(Core core, Cli cli, Args a) {
  if (refuseFlags(core, a)) { return 1; }
  if (a.rest.len() < 1) { core.warn("usage: " + a.name + " [-cEinqv] <pattern> [file]"); return 2; }
  // **Basic unless `-E`**, which is what `grep` is. This compiled every pattern as *extended*, so
  // `grep 'a|b'` matched a-or-b where GNU matches the three characters `a|b` — a wrong answer with
  // nothing said about it, in the tool most likely to be handed a pattern (wac-mono 0104).
  bool extended = has(a, 'E');
  u8[] pattern = a.rest[0].toBytes();
  Compiled got = has(a, 'i')
    ? (extended ? compileExtendedIgnoreCase(pattern) : compileBasicIgnoreCase(pattern))
    : (extended ? compileExtended(pattern) : compileBasic(pattern));
  // **The reason, not "bad pattern".** `grep '\(ab\)\1'` is a pattern GNU accepts and this engine
  // cannot run, and calling it bad told the caller to go and fix something that was already right.
  // Where GNU refuses too the words are GNU's; where the gap is ours the sentence says so.
  if (got.program is null) { core.warn(a.name + ": " + got.why); return 2; }
  Program p = got.program!;

  i32[] caps = i32[slotCount(p)](fill: 0);
  bool invert = has(a, 'v');
  bool number = has(a, 'n');
  bool countOnly = has(a, 'c');
  // **`-q` was accepted and ignored**, so `grep -q x` printed every matching line and read the whole
  // input. Two things wrong at once: the output the caller asked to be silent, and the reading — GNU
  // stops at the first match, which is the only thing that makes `seq 1 100000 | grep -q 5` finish
  // rather than counting to a hundred thousand. `packages/sh`'s grep has always done both; measuring
  // this package against its corpus is what found the difference (wac-mono 0103).
  bool quiet = has(a, 'q');
  i32 matches = 0;
  Sink out = Sink.create(cli);

  // Every file named, and **the name in front of every line when there is more than one**, which is what
  // makes `grep pattern *.c` usable and is what the real one does. It used to search the first file and
  // say nothing about the others (wac-mono 0096). `-c` counts per file the same way.
  i32 files = operandCount(a, 1);
  i32 count = files == 0 ? 1 : files;
  bool label = files > 1;
  for (i32 f = 0; f < count; f++) {
    Input in = openStream(core, cli, a, 1 + f);
    if (!in.ok) { return 1; }
    string where = label ? in.label + ":" : "";
    i32 n = 0;
    i32 here = 0;
    Lines s = Lines.create();
    Feed fed = Feed.fromStdin(cli);
    while (true) {
      Line l = nextLine(s, fed);
      if (!l.ok) { break; }
      n++;
    i32 found = search(p, l.bytes, 0, caps, 1000000);
    // Three answers, not two. `BUDGET` means the engine gave up backtracking on this line, and
    // testing `!= NO_MATCH()` counted that as a match — so a pathological pattern reported hits it
    // had never found, and `grep -c` counted them. Exiting 2 is what the real one does when it
    // cannot answer, and it is the only honest status: neither "matched" nor "did not match" is
    // known.
      if (found == BUDGET()) {
        core.warn(a.name + ": " + itoa(n) + ": pattern too expensive on this line, giving up");
        return 2;
      }
      bool hit = found != NO_MATCH();
      if (hit == invert) { continue; }
      matches++;
      here++;
      // The status is the whole answer, so there is nothing left to read once there is one.
      if (quiet) { out.flush(); return 0; }
      if (countOnly) { continue; }
      string text = string.fromBytes(l.bytes);
      // Buffered: a pattern that matches most of a large file is one host call per line otherwise, and
      // each is a park and a wake. Issue 0039.
      if (!out.line(where + (number ? itoa(n) + ":" + text : text))) { break; }
    }
    // `-c` prints a count for each file, with the name in front when there is more than one.
    if (countOnly) { out.line(where + itoa(here)); }
  }
  out.flush();
  return matches > 0 ? 0 : 1;
}
