// The same GET, into a file. `box wget example.com /path out.html`.
//
// A few lines different from `get`, and they are the point: the fetch writes to whatever `Output` it is
// handed, so given the file's it is unchanged and does not know. Closing that is what finishes the file.

import { Files, Net, Output } from "std";
import { Args } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { fetch } from "../lib/fetch.wac";
import { reason } from "../../../fs/src/words.wac";

export async i32 wget(Output err, Files fs, Net net, Args a) {
  if (refuseFlags(err, a)) { return 1; }
  if (a.rest.len() < 3) {
    err.line("usage: \{a.name} <host> <path> <outfile> [-<port>]");
    return 2;
  }
  string path = a.rest[2];
  // The response streams into the file on every backing: `openWrite` gives an `Output` per file, so the
  // body is never held whole, and a memory image takes it the way a disk does.
  Output to;
  match (await fs.openWrite(path)) {
    Ok(o): { to = o; }
    Err(e): { err.line("\{a.name}: \{path}: \{reason(e)}"); return 1; }
  }
  i32 code = fetch(err, to, net, a.name, a.rest[0], a.rest[1], a.num == 0 ? 80 : a.num, false);
  match (await to.close()) {
    Ok(v): { }
    Err(e): { err.line("\{a.name}: \{path}: \{e}"); return 1; }
  }
  if (code == 0) { err.line("\{a.name}: saved \{path}"); }
  return code;
}
