// A file or directory moved. A rename within a filesystem, which is why this needs no
// read grant at all — nothing is copied through the program.

import { Change, Cli, Core, reasonOf } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";
import { refuseFlags } from "../lib/flags.wac";
import { missingAfter, missingOperand } from "../lib/operands.wac";
import { Fs } from "../../../fs/src/fs.wac";

export i32 mv(Core core, Cli cli, Fs fs, Args a) {
  if (refuseFlags(core, a)) { return 1; }
  if (a.rest.len() == 0) { return missingOperand(core, a.name, "file"); }
  // GNU names the one it *did* get, which is the difference between "you forgot both" and "you forgot
  // where to put it" — and the second is the mistake people actually make.
  if (a.rest.len() < 2) { return missingAfter(core, a.name, "destination file operand", a.rest[0]); }
  Change c = fs.rename(a.rest[0], a.rest[1]);
  if (c.ok()) { return 0; }
  // GNU's frame: `mv: cannot move 'f' to 'nosuch/x': …`.
  //
  // This named `a.rest[0]` — the **source** — for a failure that is almost always the destination's:
  // `mv f f/g` reported `mv: f: Not a directory` about a file that is perfectly fine and said nothing
  // about `f/g`, which is the operand at fault. Naming both is what GNU does and is the only version of
  // this line that cannot mislead, since a `rename` failure can come from either end.
  core.warn(a.name + ": cannot move '" + a.rest[0] + "' to '" + a.rest[1] + "': " + reasonOf(c));
  return 1;
}
