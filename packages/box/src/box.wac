// A busybox-shaped application: one program, many applets, chosen by the first argument.
//
//   box grep -i wac README.md
//   cat README.md | box sort -u | box wc -l
//   box gzip data | box gunzip | box sha256sum
//   box serve -8080
//
// This file is the dispatcher and nothing else. One applet per file under `applets/`, so
// finding one takes no thought: it is `applets/<name>.wac`, always. The shared parts —
// argument parsing, line splitting, byte and number helpers, the line reader, the atomic
// write — are under `lib/`.
//
// The imports below are the table of contents. wac has no re-export, so this is the one
// place that has to know every applet exists, which is the right place for it.
//
// Many of these are a few lines over a package from this monorepo: `gzip`, `zstd`, `json`,
// `sha256sum`, `date`, `serve` and `get` are all thin. That is the point of them — those
// packages were written to be called from TypeScript through bindgen and needed no change
// at all to become the inside of a program.
//
// **A multicall binary weakens the permission story**, and that is worth saying rather
// than hiding. `box`'s grants are the *union* of what its applets need, so running `box
// echo` carries the filesystem *and network* access `box cp` and `box get` would want. One
// applet per file means each could also be built alone, with only what it needs — `bin/`
// does exactly that for four of them, and measures what it saves.

import { Sys, Clock, Env, Files, Input, Net, Output, Procs, Random } from "std";
import { Args, parseArgs } from "./lib/args.wac";

import { base32 } from "./applets/base32.wac";
import { base64 } from "./applets/base64.wac";
import { basename } from "./applets/basename.wac";
import { whoami } from "./applets/whoami.wac";
import { id } from "./applets/id.wac";
import { cat } from "./applets/cat.wac";
import { chmod } from "./applets/chmod.wac";
import { cp } from "./applets/cp.wac";
import { crc32 } from "./applets/crc32.wac";
import { fsdump } from "./applets/fsdump.wac";
import { cut } from "./applets/cut.wac";
import { date } from "./applets/date.wac";
import { diff } from "./applets/diff.wac";
import { dirname } from "./applets/dirname.wac";
import { du } from "./applets/du.wac";
import { echo } from "./applets/echo.wac";
import { find } from "./applets/find.wac";
import { fold } from "./applets/fold.wac";
import { get } from "./applets/get.wac";
import { gets } from "./applets/gets.wac";
import { grep } from "./applets/grep.wac";
import { gunzip } from "./applets/gunzip.wac";
import { gzip } from "./applets/gzip.wac";
import { head } from "./applets/head.wac";
import { hex } from "./applets/hex.wac";
import { init } from "./applets/init.wac";
import { httpd } from "./applets/httpd.wac";
import { json } from "./applets/json.wac";
import { ls } from "./applets/ls.wac";
import { mkdir } from "./applets/mkdir.wac";
import { mv } from "./applets/mv.wac";
import { nc } from "./applets/nc.wac";
import { nl } from "./applets/nl.wac";
import { paste } from "./applets/paste.wac";
import { ps } from "./applets/ps.wac";
import { rev } from "./applets/rev.wac";
import { rm } from "./applets/rm.wac";
import { rmdir } from "./applets/rmdir.wac";
import { seq } from "./applets/seq.wac";
import { serve } from "./applets/serve.wac";
import { sha256sum } from "./applets/sha256sum.wac";
import { sha512sum } from "./applets/sha512sum.wac";
import { shuf } from "./applets/shuf.wac";
import { sort } from "./applets/sort.wac";
import { split } from "./applets/split.wac";
import { sponge } from "./applets/sponge.wac";
import { stat } from "./applets/stat.wac";
import { strings } from "./applets/strings.wac";
import { tac } from "./applets/tac.wac";
import { tail } from "./applets/tail.wac";
import { tar } from "./applets/tar.wac";
import { tee } from "./applets/tee.wac";
import { touch } from "./applets/touch.wac";
import { tr } from "./applets/tr.wac";
import { uniq } from "./applets/uniq.wac";
import { unzstd } from "./applets/unzstd.wac";
import { urldecode } from "./applets/urldecode.wac";
import { urlencode } from "./applets/urlencode.wac";
import { uuid } from "./applets/uuid.wac";
import { wc } from "./applets/wc.wac";
import { wget } from "./applets/wget.wac";
import { yes } from "./applets/yes.wac";
import { zstd } from "./applets/zstd.wac";
import { appletHelp } from "./lib/flags.wac";

export async i32 main(Sys sys) {
  return await boxMain(sys.args(), sys.stdin(), sys.stderr(), sys.stdout(), sys.clock(), sys.random(), sys.env(),
                       sys.files(), sys.net(), sys.procs(), sys.interrupted);
}

/** `box` over exactly these handles: an applet by name, or the usage. */
export async i32 boxMain(string[] argv, Input stdin, Output err, Output out, Clock clock, Random rnd, Env env,
                         Files fs, Net net, Procs procs, fn<bool()> interrupted) {
  if (argv.len() < 1) { return usage(err); }
  string applet = argv[0];
  // **The filesystem an applet reads is a value now, not the host by assumption.** Standing alone, `box`
  // is a program on the real machine and hands its applets exactly that; a shell holding an image hands
  // them the image, and no applet knows the difference (wac-mono 0109).
  i32 code = await dispatch(argv, stdin, err, out, clock, rnd, env, fs, net, procs, interrupted, parseArgs(argv), applet);
  if (code != UNKNOWN) { return code; }

  err.line("box: unknown applet '\{applet}'");
  return usage(err);
}

/**
 * What `dispatch` answers for a name it does not have, distinct from any applet's own status.
 *
 * -1 because no applet returns it: statuses here are 0, 1, 2 and occasionally an exit code from
 * something else, all non-negative. A caller that cannot tell "no such applet" from "it ran and
 * failed" reports the wrong thing — which is the same distinction `packages/sh` needs `found` for.
 */
export static i32 UNKNOWN = -1;

/**
 * The table, and the only copy of it.
 *
 * Split out of `main` when `packages/sh` began running applets in-process: the shell has argv and
 * standard input of its own, so it cannot go through `main`, and a second table would have been
 * two lists of sixty names drifting apart. `main` is now the argv-reading half and this is the
 * choosing half.
 */
export async i32 dispatch(string[] argv, Input stdin, Output err, Output out, Clock clock, Random rnd, Env env, Files fs, Net net, Procs procs, fn<bool()> interrupted, Args a, string applet) {
  // **`--help` is answered here, once, for every applet.** It is the one long option they all share,
  // it needs no per-applet table, and box's own diagnostics promise it — every operand error ends
  // "Try 'x --help' for more information." Answered before dispatch so an applet cannot forget it,
  // and only for a name that exists, so `box nope --help` is still an unknown applet rather than help
  // for something there is none of.
  if (a.longOpt == "--help") {
    string[] all = appletNames();
    for (i32 i = 0; i < all.len(); i++) {
      if (all[i] == applet) { return appletHelp(out, applet); }
    }
  }
  if (applet == "base32")    { return await base32(stdin, err, out, fs, a); }
  if (applet == "base64")    { return await base64(stdin, err, out, fs, a); }
  if (applet == "basename")  { return basename(err, out, fs, a); }
  if (applet == "whoami")    { return whoami(err, out, fs, a); }
  if (applet == "id")        { return await id(err, out, fs, a); }
  if (applet == "cat")       { return await cat(stdin, err, out, fs, a); }
  if (applet == "chmod")     { return await chmod(err, fs, a); }
  if (applet == "cp")        { return await cp(stdin, err, rnd, fs, a); }
  if (applet == "crc32")     { return await crc32(stdin, err, out, fs, a); }
  if (applet == "fsdump")    { return await fsdump(stdin, err, out, fs, a); }
  if (applet == "cut")       { return await cut(stdin, err, out, fs, a); }
  if (applet == "date")      { return date(err, out, clock, fs, a); }
  if (applet == "diff")      { return await diff(stdin, err, out, fs, a); }
  if (applet == "dirname")   { return dirname(err, out, fs, a); }
  if (applet == "du")        { return await du(err, out, fs, a); }
  if (applet == "echo")      { return echo(out, fs, a); }
  if (applet == "find")      { return await find(err, out, fs, a); }
  if (applet == "fold")      { return await fold(stdin, err, out, fs, a); }
  if (applet == "get")       { return get(err, out, net, fs, a); }
  if (applet == "gets")      { return await gets(err, out, clock, rnd, net, fs, a); }
  if (applet == "grep")      { return await grep(stdin, err, out, fs, a); }
  if (applet == "gunzip")    { return await gunzip(stdin, err, out, fs, a); }
  if (applet == "gzip")      { return await gzip(stdin, err, out, fs, a); }
  if (applet == "head")      { return await head(stdin, err, out, fs, a); }
  // **Asked for is not got wrong.** `usage` answers 2 because reaching it means the command line was
  // not understood; `box help`, `box --help` and `box -h` are a person asking, and a person who asked
  // gets 0. Every tool this package imitates does the same, and a script testing `box --help` for
  // success is a reasonable thing to write.
  if (applet == "help" || applet == "--help" || applet == "-h") { usage(err); return 0; }
  if (applet == "hex")       { return await hex(stdin, err, out, fs, a); }
  if (applet == "init")      { return await init(err, out, procs, fs, a); }
  if (applet == "httpd")     { return await httpd(err, net, fs, a); }
  if (applet == "json")      { return await json(stdin, err, out, fs, a); }
  if (applet == "ls")        { return await ls(err, out, fs, a); }
  if (applet == "mkdir")     { return await mkdir(err, fs, a); }
  if (applet == "mv")        { return await mv(err, fs, a); }
  if (applet == "nc")        { return await nc(stdin, err, out, net, a); }
  if (applet == "nl")        { return await nl(stdin, err, out, fs, a); }
  if (applet == "paste")     { return await paste(stdin, err, out, fs, a); }
  if (applet == "ps")        { return await ps(err, out, fs, a); }
  if (applet == "rev")       { return await rev(stdin, err, out, fs, a); }
  if (applet == "rm")        { return await rm(err, fs, a); }
  if (applet == "rmdir")     { return await rmdir(err, fs, a); }
  if (applet == "seq")       { return seq(argv, err, out, a); }
  if (applet == "serve")     { return serve(err, clock, net, a); }
  if (applet == "sha256sum") { return await sha256sum(stdin, err, out, fs, a); }
  if (applet == "sha512sum") { return await sha512sum(stdin, err, out, fs, a); }
  if (applet == "shuf")      { return await shuf(stdin, err, out, rnd, fs, a); }
  if (applet == "sort")      { return await sort(stdin, err, out, fs, a); }
  if (applet == "split")     { return await split(stdin, err, fs, a); }
  if (applet == "sponge")    { return await sponge(stdin, err, rnd, fs, a); }
  if (applet == "stat")      { return await stat(err, out, fs, a); }
  if (applet == "strings")   { return await strings(stdin, err, out, fs, a); }
  if (applet == "tac")       { return await tac(stdin, err, out, fs, a); }
  if (applet == "tail")      { return await tail(stdin, err, out, fs, a); }
  if (applet == "tar")       { return await tar(err, out, fs, a); }
  if (applet == "tee")       { return await tee(stdin, err, out, fs, a); }
  if (applet == "touch")     { return await touch(err, fs, a); }
  if (applet == "tr")        { return await tr(stdin, err, out, fs, a); }
  if (applet == "uniq")      { return await uniq(stdin, err, out, fs, a); }
  if (applet == "unzstd")    { return await unzstd(stdin, err, out, fs, a); }
  if (applet == "urldecode") { return await urldecode(stdin, err, out, fs, a); }
  if (applet == "urlencode") { return await urlencode(stdin, err, out, fs, a); }
  if (applet == "uuid")      { return uuid(err, out, rnd, fs, a); }
  if (applet == "wc")        { return await wc(stdin, err, out, env, fs, a); }
  if (applet == "wget")      { return await wget(err, fs, net, a); }
  if (applet == "yes")       { return yes(err, out, interrupted, a); }
  if (applet == "zstd")      { return await zstd(stdin, err, out, fs, a); }

  // `true` and `false` have no body: the dispatcher returning a constant *is* the whole
  // applet, and a file containing one `return` would be ceremony rather than clarity.
  if (applet == "true")      { return 0; }
  if (applet == "false")     { return 1; }

  return UNKNOWN;
}

/**
 * Every name `dispatch` answers to, in one place.
 *
 * `usage` wraps this rather than spelling the names out again, and `packages/sh`'s `help` shows it
 * when the applets have been wired into a shell — so a new applet cannot be missing from either.
 * It was five hand-typed lines of `core.warn` before, which is exactly the shape that goes stale:
 * the browser terminal advertised sixty programs and `help` listed twelve.
 */
export string[] appletNames() {
  return [
    "base32", "base64", "basename", "cat", "chmod", "cp", "crc32", "cut", "date", "diff", "dirname",
    "du", "echo", "false", "find", "fold", "fsdump", "get", "gets", "grep", "gunzip", "gzip", "head",
    "id",
    "help", "hex", "httpd", "init", "json", "ls", "mkdir", "mv", "nc", "nl", "paste", "ps", "rev", "rm", "rmdir",
    "seq", "serve", "sha256sum", "sha512sum", "shuf", "sort", "split", "sponge", "stat",
    "strings", "tac", "tail", "tar", "tee", "touch", "tr", "true", "uniq", "unzstd", "whoami",
    "urldecode", "urlencode", "uuid", "wc", "wget", "yes", "zstd"
  ];
}

i32 usage(Output err) {
  err.line("usage: box <applet> [-flags] [args]");
  err.line(wrapped(appletNames(), "  ", 74));
  err.line("flags: grep -ivnc   sort -run   uniq -c   wc -lwc   mkdir -p   rm -rf   json -c");
  err.line("       a value attaches or not: head -n2 / -2, fold -w40 / -40, cut -f2 -d, / -f 2 -d ,");
  err.line("       signs and units: head -n -2, tail -n +2, head -c 3, tail -c +3");
  err.line("net:   get <host> [path] [-<port>] [-i]   wget <host> <path> <out>\n"
            + "       serve [-<port>] [-o]   httpd [-<port>] [dir] [-o] [-x]\n"
            + "       gets <host> <path> <root.der> [-<port>]   (TLS 1.3)\n"
            + "       nc <host> <port>   nc -<port> -l");
  return 2;
}

/**
 * The names the usage message prints, which must be the ones the dispatcher answers to.
 *
 * Hand-maintained, because wac has no reflection — so `test/box.test.ts` compares this list against the
 * `if (applet == "…")` branches in this file and fails on any difference. It found the first one: `help`
 * was dispatched and not listed, so `box help` worked and nothing said so, and the three counts a reader
 * could arrive at — 57 source files, 59 names here, 60 branches — were all different and all defensible.
 */
/** Names in lines no wider than `width`, each indented with `lead`. */
export string wrapped(string[] ns, string lead, i32 width) {
  string out = "";
  string line = lead;
  for (i32 i = 0; i < ns.len(); i++) {
    // The first name on a line always goes on it, however long: wrapping to nothing would loop.
    if (line.len() > lead.len() && line.len() + 1 + ns[i].len() > width) {
      out = out + "\{line}\n";
      line = lead;
    }
    line = line == lead ? line + ns[i] : "\{line} \{ns[i]}";
  }
  return line == lead ? out : out + line;
}
