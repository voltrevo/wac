// A sealed shell **with the applets**: an in-memory world, and sixty commands over it.
//
//   wac task app:build packages/box/src/bin/sealedsh.wac -o sealedsh
//   ./sealedsh -c 'seq 1 20 > n; sort -nr n | head -3; ls'
//
// `packages/sh`'s `sealed.wac` is this shell on `Fs.inMemory()` with only its own builtins; this is the
// same idea one package up, where the commands live. Built with **no capabilities at all** — no read, no
// write, no net — so every path a program here can name is inside the process.
//
// ## Why this could not exist until now
//
// An applet took a `Cli` and read the *host* through it, while the shell held its filesystem as a value.
// Wiring them together would have given one session two filesystems: `ls /` listing the image and
// `cat /etc/passwd` reading the real machine, with nothing in the output to say which (wac-mono 0109).
// Applets take an `Fs` now, and `lib/input.wac` chooses how to read by mount — a host path still streams
// through `openInput`, and anything else is served from the bytes the filesystem hands over.
//
// So this program is the proof of that change rather than a demonstration of the shell: if an applet
// still reached the host, `cat /etc/passwd` here would print the real one, and the test says it does not.
//
// It is also the shape the browser terminal wants — an image, and commands over it — and the shape
// design/0001 step 7 needs, where something boots an image and serves sessions from it.
//
// **`head -c 8 /dev/urandom` works here**, which it did not until `openStream` grew a byte cap. A
// synthesised device is endless, so `Fs.readFile` refuses it by name rather than inventing a length —
// and the reader had only a whole-file route for a non-host mount, so the refusal reached an applet
// that wanted eight bytes. The bound is the applet's to declare and the file is the filesystem's to
// know; `Fs.readSome` was already the route and nothing was passing the number down it.

import { Sys, Files, MemoryStore } from "std";
import { Vec } from "core";
import { shellMain } from "../../../sh/src/entry.wac";
import { boxApplet, systemShell } from "../shrun.wac";
import { UNKNOWN } from "../box.wac";

export async i32 main(Sys sys) {
  i32 asApplet = await boxApplet(sys);
  if (asApplet != UNKNOWN) { return asApplet; }

  // Nothing of the machine's: a store in memory, with a `/tmp`, and the system mounted over it.
  Files root = MemoryStore.create(sys.clock()).asUser("root");
  await root.mkdir("/tmp", true);
  string[] args = sys.args();
  Vec<string> cmdline = Vec.create();
  cmdline.push("sealedsh");
  for (i32 i = 0; i < args.len(); i++) { cmdline.push(args[i]); }
  return await shellMain(args, systemShell(sys, root, cmdline), 0);
}
