// A `tr` set: the bytes a string like `a-z`, `\n`, `[:digit:]` or `[x*4]` actually names.
//
// `tr` reads its two operands in a small language, and this applet took them **literally** — so
// `tr '\n' ' '` looked for a backslash and an `n`, found neither, and copied its input through unchanged
// (wac-mono 0098, found by typing into the browser terminal rather than by any test). A no-op translation
// looks like working software until you check the bytes, and the escapes are most of what anyone types
// `tr` for.
//
// The language, from GNU's documentation rather than from anyone's memory:
//
//   - **escapes** `\\ \a \b \f \n \r \t \v`, and `\NNN` for one to three octal digits;
//   - **ranges** `a-z`, after the endpoints have been unescaped, so `\1-\7` is a range too;
//   - **classes** `[:alpha:]` and the eleven others, in the order the C locale puts them;
//   - **equivalence** `[=c=]`, which in the C locale is just `c`;
//   - **repeats** `[x*n]` for n copies, and `[x*]` for "as many as set1 has" — which is why parsing set2
//     needs to know set1's length and parsing set1 does not.
//
// A `-` first or last is a literal hyphen, not a range, which is the rule every implementation shares and
// nobody writes down.

import { Buf } from "../../../bytes/src/buf.wac";

/** A parsed set: the bytes it names, or why it could not be read. */
export struct TrSet {
  bool ok;
  u8[] bytes;
  /** The reason, with the program's name already on it. Empty when `ok`. */
  string error;
}

/**
 * Read a set. `targetLen` is set1's length when parsing set2, or -1 when parsing set1.
 *
 * `[x*]` pads to `targetLen`, which is the only thing the two parses do differently — and the reason it
 * is a parameter rather than a second function.
 */
export TrSet parseSet(string who, u8[] raw, i32 targetLen) {
  Buf out = Buf.create();
  // Which output positions were written as plain single bytes, so a `-` after one can form a range. A
  // range cannot start from a class or a repeat, which is GNU's rule and the reason this is tracked.
  Buf plain = Buf.create();
  i32 padAt = -1;
  i32 padByte = 0;

  i32 i = 0;
  while (i < raw.len()) {
    if (raw[i] == '[' && i + 1 < raw.len() && raw[i + 1] == ':') {
      i32 end = closerAt(raw, i + 2, ':');
      if (end < 0) { return TrSet(false, u8[0](), who + ": missing ']'\n"); }
      string name = string.fromBytes(sliceOf(raw, i + 2, end));
      u8[] members = classBytes(name);
      if (members.len() == 0) {
        return TrSet(false, u8[0](), who + ": invalid character class '" + name + "'\n");
      }
      for (i32 k = 0; k < members.len(); k++) { out.push(members[k]); plain.push(0); }
      i = end + 2;
      continue;
    }
    if (raw[i] == '[' && i + 1 < raw.len() && raw[i + 1] == '=') {
      i32 end = closerAt(raw, i + 2, '=');
      if (end < 0) { return TrSet(false, u8[0](), who + ": missing ']'\n"); }
      // An equivalence class names *one* character — in the C locale, the only one equivalent to it.
      // `[=ab=]` is a mistake rather than a two-member set, and GNU says which characters it was given.
      if (end != i + 3) {
        return TrSet(false, u8[0](), who + ": " + string.fromBytes(sliceOf(raw, i + 2, end)) +
          ": equivalence class operand must be a single character\n");
      }
      out.push(raw[i + 2]);
      plain.push(1);
      i = end + 2;
      continue;
    }
    if (raw[i] == '[' && repeatAt(raw, i) >= 0) {
      i32 star = repeatAt(raw, i);
      i32 close = i;
      while (close < raw.len() && raw[close] != ']') { close++; }
      Read what = readByte(raw, i + 1);
      // `[x*]` and `[x*0]` both pad to set1's length; any other count is that many copies, decimal
      // unless it begins with a zero, which GNU reads as octal.
      //
      // The count is checked **before** the string1 rule below, because that is the order GNU reports
      // them in: `tr 'a[b*c]d' x` says "invalid repeat count 'c'" and not "may not appear in string1",
      // and a caller reading the second would go and fix the wrong thing.
      i32 n = 0;
      bool pad = star + 1 == close;
      if (!pad) {
        Count got = countOf(raw, star + 1, close);
        if (!got.ok) {
          return TrSet(false, u8[0](), who + ": invalid repeat count '" +
            string.fromBytes(sliceOf(raw, star + 1, close)) + "' in [c*n] construct\n");
        }
        n = got.value;
        pad = n == 0;
      }
      // **Only the *padding* form belongs to set2 alone.** `[x*]` and `[x*0]` mean "as many as set1
      // has", which is a question set1 cannot ask of itself; `[x*2]` is just two x's and GNU takes it in
      // either set. Refusing both was one rule too many, and it turned two working commands into errors.
      if (pad && targetLen < 0) {
        return TrSet(false, u8[0](), who + ": the [c*] repeat construct may not appear in string1\n");
      }
      if (pad) {
        if (padAt >= 0) { return TrSet(false, u8[0](), who + ": only one [c*] is allowed\n"); }
        padAt = out.len;
        padByte = what.value;
      } else {
        for (i32 k = 0; k < n; k++) { out.push(what.value); plain.push(0); }
      }
      i = close + 1;
      continue;
    }

    Read one = readByte(raw, i);
    i32 after = one.at;
    // `a-z`, where the `-` is neither first nor last. Both endpoints are read as bytes first, so `\1-\7`
    // is a range and `-a` is a hyphen followed by an a.
    if (after < raw.len() && raw[after] == '-' && after + 1 < raw.len()) {
      Read hi = readByte(raw, after + 1);
      if (hi.value < one.value) {
        return TrSet(false, u8[0](), who + ": range-endpoints of '" + charOf(one.value) + "-" +
          charOf(hi.value) + "' are in reverse collating sequence order\n");
      }
      for (i32 c = one.value; c <= hi.value; c++) { out.push(c); plain.push(1); }
      i = hi.at;
      continue;
    }
    out.push(one.value);
    plain.push(1);
    i = after;
  }

  if (padAt < 0) { return TrSet(true, out.take(), ""); }
  // The pad stands for however many bytes set1 has that this set does not yet cover.
  u8[] head = out.take();
  i32 want = targetLen < 0 ? head.len() : targetLen;
  i32 fill = want - head.len();
  if (fill < 0) { fill = 0; }
  Buf padded = Buf.create();
  padded.pushBytes(head, 0, padAt);
  for (i32 k = 0; k < fill; k++) { padded.push(padByte); }
  padded.pushBytes(head, padAt, head.len() - padAt);
  return TrSet(true, padded.take(), "");
}

/** Every byte not in `set`, in order — `-c`. */
export u8[] complementOf(u8[] set) {
  u8[] seen = u8[256](fill: 0);
  for (i32 i = 0; i < set.len(); i++) { seen[set[i]] = 1; }
  Buf out = Buf.create();
  for (i32 c = 0; c < 256; c++) {
    if (seen[c] == 0) { out.push(c); }
  }
  return out.take();
}

/** One byte and where reading it ended: an escape is one byte spelled several ways. */
struct Read { i32 value; i32 at; }

Read readByte(u8[] raw, i32 at) {
  if (at >= raw.len()) { return Read(0, at); }
  if (raw[at] != '\\' || at + 1 >= raw.len()) { return Read(raw[at], at + 1); }
  i32 c = raw[at + 1];
  if (c == '\\') { return Read('\\', at + 2); }
  if (c == 'a') { return Read(7, at + 2); }
  if (c == 'b') { return Read(8, at + 2); }
  if (c == 'f') { return Read(12, at + 2); }
  if (c == 'n') { return Read(10, at + 2); }
  if (c == 'r') { return Read(13, at + 2); }
  if (c == 't') { return Read(9, at + 2); }
  if (c == 'v') { return Read(11, at + 2); }
  if (c >= '0' && c <= '7') {
    // One to three octal digits, and no more: `\1234` is byte 0o123 then a `4`.
    i32 v = 0;
    i32 i = at + 1;
    i32 digits = 0;
    while (i < raw.len() && digits < 3 && raw[i] >= '0' && raw[i] <= '7') {
      v = v * 8 + (raw[i] - '0');
      i++;
      digits++;
    }
    return Read(v & 255, i);
  }
  // A backslash before anything else is that character: GNU warns and takes it, and taking it is the
  // part a caller can see.
  return Read(c, at + 2);
}

/** Where a `[:name:]` or `[=c=]` ends, or -1. `mark` is the `:` or `=`. */
i32 closerAt(u8[] raw, i32 from, i32 mark) {
  for (i32 i = from; i + 1 < raw.len(); i++) {
    if (raw[i] == mark && raw[i + 1] == ']') { return i; }
  }
  return -1;
}

/**
 * The `*` of a `[x*n]` at `at`, or -1 if this bracket is not one.
 *
 * A repeat that is never closed is not a repeat: `tr 'a[x*' y` translates the five characters as
 * themselves, which is what GNU does, and refusing it read a mistake into a command that has none.
 */
i32 repeatAt(u8[] raw, i32 at) {
  i32 i = at + 1;
  if (i < raw.len() && raw[i] == '\\') { i = i + 2; } else { i++; }
  if (i >= raw.len() || raw[i] != '*') { return -1; }
  i32 star = i;
  while (i < raw.len() && raw[i] != ']') { i++; }
  return i < raw.len() ? star : -1;
}

/** A repeat count, and whether it was one at all. */
struct Count { bool ok; i32 value; }

/**
 * The count in `[x*n]`: decimal, or octal when it begins with a zero, as GNU reads it.
 *
 * `ok` is false for anything that is not a number — `[b*c]` is a mistake, and answering zero for it made
 * it silently mean "pad", which is a different construct.
 */
Count countOf(u8[] raw, i32 from, i32 to) {
  if (from >= to) { return Count(false, 0); }
  bool octal = raw[from] == '0';
  i32 base = octal ? 8 : 10;
  i32 v = 0;
  for (i32 i = from; i < to; i++) {
    if (raw[i] < '0' || raw[i] > '9') { return Count(false, 0); }
    if (octal && raw[i] > '7') { return Count(false, 0); }
    v = v * base + (raw[i] - '0');
  }
  return Count(true, v);
}

u8[] sliceOf(u8[] raw, i32 from, i32 to) {
  u8[] out = u8[to - from]();
  out.copyFrom(raw, from, 0, to - from);
  return out;
}

string charOf(i32 c) { return string.fromBytes(u8[1](fill: c)); }

/**
 * The twelve POSIX classes, in the C locale.
 *
 * Written out rather than derived from `isalpha`-style predicates, because the set is the specification:
 * a reader can check `[:punct:]` against the table here, and cannot check it against a chain of range
 * comparisons without rebuilding the table in their head.
 */
u8[] classBytes(string name) {
  Buf out = Buf.create();
  for (i32 c = 0; c < 128; c++) {
    bool upper = c >= 'A' && c <= 'Z';
    bool lower = c >= 'a' && c <= 'z';
    bool digit = c >= '0' && c <= '9';
    bool space = c == 32 || (c >= 9 && c <= 13);
    bool cntrl = c < 32 || c == 127;
    bool print = c >= 32 && c < 127;
    bool graph = c > 32 && c < 127;
    bool alpha = upper || lower;
    bool alnum = alpha || digit;
    bool punct = graph && !alnum;
    bool xdigit = digit || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
    bool blank = c == 32 || c == 9;
    bool want = false;
    if (name == "alpha") { want = alpha; }
    else if (name == "alnum") { want = alnum; }
    else if (name == "digit") { want = digit; }
    else if (name == "upper") { want = upper; }
    else if (name == "lower") { want = lower; }
    else if (name == "space") { want = space; }
    else if (name == "blank") { want = blank; }
    else if (name == "cntrl") { want = cntrl; }
    else if (name == "print") { want = print; }
    else if (name == "graph") { want = graph; }
    else if (name == "punct") { want = punct; }
    else if (name == "xdigit") { want = xdigit; }
    if (want) { out.push(c); }
  }
  return out.take();
}
