// A terminal session with no terminal in it: the shell, the scrollback and the history.
//
// Everything `packages/box/example/term.wac` did between one keystroke and the next, with the page
// taken out. It exists because there are two presentations of the same thing now — the full-frame
// terminal the website embeds, and a **window** on the desktop of `example/desk.wac` (design/0001
// step 8) — and a second copy of "what Enter does" is a second thing to be wrong.
//
// The split is along the line the two presentations disagree about. What they share is *state*: which
// shell, what it has printed, what has been typed before. What they do not share is markup, ids,
// where the caret is, and whether there is one of these or four. So none of that is here, and this
// file imports no `Page`.
//
// ## What a session is
//
// One `Shell`, capturing, over `mountSystem`'s world — `/dev`, `/proc`, `/bin` and the applets — and
// a screen that only grows. `feedLine` is the whole of the contract: hand it what the user typed and
// the screen afterwards is `screen`.

import { Files, Output, OutputFault, Sys } from "std";
import { Shell, runScript } from "../../../sh/src/exec.wac";
import { Buf, Result, Vec } from "core";
import { ProcTable } from "../../../fs/src/proc.wac";
import { systemShell, wireBox } from "../shrun.wac";

/** How many commands the ring remembers. */
export i32 HISTORY() { return 64; }

/**
 * How much of the screen is kept, in bytes, and how much a caller is handed to draw while a command runs.
 *
 * **A terminal has a scrollback, not a transcript.** `yes` held output up to the shell's cap and the page
 * drew all of it ten times a second until the tab crashed; the screen grew by every command's output
 * for the life of the session as well.
 */
export i32 SCROLLBACK() { return 262144; }
export i32 SHOWN() { return 65536; }

/** The last `max` bytes of `b` as text, starting on a character rather than inside one. */
string tailText(const u8[] b, i32 max) {
  if (b.len() <= max) { return string.fromBytes(b); }
  i32 from = b.len() - max;
  while (from < b.len() && (b[from] & 0xC0) == 0x80) { from++; }
  u8[] out = u8[].filled(b.len() - from, 0);
  out.copyFrom(b, from, 0, out.len());
  return string.fromBytes(out);
}

export struct Session {
  Shell sh;
  /** Everything printed so far, which is what a caller draws. */
  string screen;
  /**
   * The ring, and how far Up has walked into it. `cursor` 0 means "at the prompt".
   *
   * A **ring** rather than a list that grows: the original bounded it at `HISTORY` and only the last
   * that many are reachable anyway, so a growing list would keep every line a long session ever ran
   * for nobody to read. Kept deliberately, because moving code is where a bound quietly becomes
   * unbounded.
   */
  Vec<string> history;
  i32 count;
  i32 cursor;
  /**
   * A `^C` a page has seen while a command runs and the shell has not yet asked about — the answer to
   * `Shell.askInterrupt`, which `startOn` points at `arrived`.
   */
  bool stopping;
  /**
   * What the running command has written to either stream, in the order it wrote it — one buffer, so a
   * complaint lands between the lines around it rather than after all of them.
   */
  Buf shown;

  /**
   * A shell over this program's own system, with its applets.
   *
   * `name` is what `/proc` calls the session — `ps` shows it as the first process, so it is the
   * program's own name rather than a label: a table that said "term" in a desktop would be
   * describing something that is not running.
   */
  Session start(Sys sys, string name) {
    Vec<string> argv = Vec.create();
    argv.push(name);
    return Session.around(systemShell(sys, sys.files(), argv), name);
  }


  /**
   * A second session over a filesystem that already exists — **one system, two shells.**
   *
   * What `example/desk.wac`'s launcher opens. Two terminals each building their own files would be two
   * machines that happen to look alike: `echo hi > /x` in one and `cat /x` in the other would fail,
   * and a desktop where the windows do not share a disk is a set of pictures rather than a system.
   *
   * Everything else a session is — the applets, spawning, capture, the directory it is in — belongs to the
   * *shell* and is set up per session. The files and the process table are shared, which is exactly the line
   * design/0001 draws: a system is a filesystem, a process table and a set of programs, and two sessions on
   * one machine differ in none of them. `cd /home/wac` in one terminal leaves the other at `/`: a directory
   * is the shell's, and an applet is handed the shell's files relative to it for one call.
   */
  Session startOn(Sys sys, Files fs, ProcTable table, string name) {
    Shell sh = Shell.onFs(sys, fs, table);
    wireBox(sh, sys.random());
    sh.externalSpawnable = true;
    return Session.around(sh, name);
  }

  /** `sh` as a terminal's session: its streams on the screen, its own row in the process table, `^C` answered. */
  Session around(Shell sh, string name) {
    // **Both streams into one buffer the screen is read from**, because "written" in a page means the host's log
    // rather than anything a reader sees. Not the shell's own capture, which keeps the two apart for whoever asked
    // for them separately — `$(…)`, a function's output placed by its redirections — and so showed every
    // complaint after all of a command's output (`test/wac/screenorder_test.wac`).
    Buf shown = Buf.create();
    sh.capture = false;
    sh.stdout = Output((u8[] b) => onScreen(shown, b), stillShowing);
    sh.stderr = Output((u8[] b) => onScreen(shown, b), stillShowing);
    // Its own row in the shared process table, so `ps` in either window shows both shells.
    sh.enterSelf(name);
    Session s = Session(sh, "", Vec.fromArray(string[].filled(HISTORY(), "")), 0, 0, false, shown);
    sh.askInterrupt = s.arrived;
    return s;
  }


  string prompt(const this) { return "\{this.sh.cwd} $"; }

  /** Add to the screen without running anything — a banner, or an opening line. */
  void say(this, string text) { this.screen = this.screen + text; }

  /**
   * Run one line, as pressing Enter does.
   *
   * The screen gets the prompt and the line, then whatever the command wrote, then `[exit N]` for a
   * non-zero status — without which a command that failed silently and one that printed nothing look
   * identical, since there is no `$?` in the prompt.
   *
   * `clear` is the *terminal's* and not the shell's: `sh` has no notion of a screen, and this is the
   * first thing everybody types.
   */
  async void feedLine(this, string line) {
    this.cursor = 0;
    this.stopping = false;
    if (line == "") { return; }
    this.history.set(this.count % HISTORY(), line);
    this.count = this.count + 1;
    if (line == "clear") { this.screen = ""; return; }

    this.screen = this.screen + "\{this.prompt()} \{line}\n";
    i32 status = await runScript(this.sh, line);
    this.screen = this.screen + string.fromBytes(this.shown.take());
    if (status != 0) { this.screen = this.screen + "[exit \{status}]\n"; }
    if (this.screen.len() > SCROLLBACK()) { this.screen = tailText(this.screen.toBytes(), SCROLLBACK()); }
  }

  /**
   * `^C` while a command runs: the shell stops it the next time it asks, through its own interrupt, so
   * `$?` is 130 and the rest of the line does not run.
   */
  void stop(this) { this.stopping = true; }

  /** The shell's question: whether a `^C` arrived, clearing it. */
  bool arrived(this) {
    bool was = this.stopping;
    this.stopping = false;
    return was;
  }

  /** The screen with whatever a running command has printed so far — what a caller draws while it runs. */
  string showing(const this) {
    // Each part's tail first, so a command that has printed megabytes is not turned into text whole.
    string live = tailText(this.shown.bytes(), SHOWN());
    return tailText((tailText(this.screen.toBytes(), SHOWN()) + live).toBytes(), SHOWN());
  }

  /** `^C` at the prompt: the line is echoed, thrown away, and a fresh one begins. */
  void interrupt(this, string typed) {
    this.screen = this.screen + "\{this.prompt()} \{typed}^C\n";
    this.cursor = 0;
  }

  /**
   * Walk the history one step and answer what the input should now hold.
   *
   * Held here rather than in the page because the history *is* program state: it is what this shell
   * has been asked to do. Empty at depth 0, which is the prompt itself.
   */
  string recall(this, bool up) {
    i32 depth = up ? this.cursor + 1 : this.cursor - 1;
    i32 have = this.count < HISTORY() ? this.count : HISTORY();
    if (depth > have) { depth = have; }
    if (depth < 0) { depth = 0; }
    this.cursor = depth;
    if (depth == 0) { return ""; }
    return this.history.get((this.count - depth) % HISTORY());
  }

  /** Whether the shell has exited, and with what — a caller decides what to do about it. */
  bool over(const this) { return this.sh.exiting; }
  i32 code(const this) { return this.sh.exitCode; }
}

/** Written to the screen: a terminal's streams are never full and never closed. */
async Result<void, OutputFault> onScreen(Buf shown, u8[] b) {
  shown.pushAll(b);
  return Result.Ok();
}

async Result<void, OutputFault> stillShowing() { return Result.Ok(); }
