// One HTTP GET for `get` and `wget`, which differ by three lines: `wget` points the current output at a
// file first, and the fetch itself does not know the difference.
//
// **The socket loop moved.** It is `packages/http/src/client.wac` now — the same request, read-to-EOF and
// parse that a JSON-RPC client needs, and there is no version of "write the loop again with POST in it"
// that ends well. What is left here is what was actually specific to these two applets: the header dump
// and the exit code.

import { Net, Output } from "std";
import { flatten } from "core";
import { get } from "../../../http/src/client.wac";
import { Incoming } from "../../../http/src/incoming.wac";

/** The exit code the applet should return. */
export i32 fetch(Output err, Output out, Net net, string name, string host, string path, i32 port, bool headers) {
  Incoming response = match (get(net, host, port, path)) {
    Ok(r): r,
    Err(e): return failed(err, "\{name}: \{e}"),
  };

  if (headers) {
    flatten(out.line("HTTP \{response.status}").wait());
    for (i32 i = 0; i < response.headers.count; i++) {
      flatten(out.line(string.fromBytes(response.headers.nameAt(i)) + ": "
                       + string.fromBytes(response.headers.valueAt(i))).wait());
    }
    flatten(out.line("").wait());
  }
  // Waited for, so a caller that closes `out` next closes it after the body, not before.
  flatten(out.write(response.body).wait());
  // A 4xx or 5xx is a fetch that worked and a request that did not, which is what `wget` reports too.
  return response.status >= 400 ? 1 : 0;
}

i32 failed(Output err, string why) {
  err.line(why);
  return 1;
}
