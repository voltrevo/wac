// Writing a file without a window where it is half-written.
//
// `writeFile` truncates and then fills, so a reader arriving in between sees a partial
// file and a crash leaves one. Writing beside the target and renaming avoids both: on
// every filesystem this runs on, a rename within a directory is atomic — the old contents
// or the new, never a mixture.
//
// This is why the mutation tier exists at all, and `cp` uses it.

import { Files, Other, Output, Random } from "std";
import { Feed } from "../../../platform/src/stream.wac";
import { FilesFault } from "../../../fs/src/words.wac";
import { Result, flatten } from "core";

// There was a `writeAtomic(core, cli, path, bytes)` here — the whole-buffer form of the same
// dance — and nothing ever called it. `cp` and `sponge` both stream, which is the point of the
// mutation tier: a copy that has to fit in memory first is the thing `openWrite` exists to avoid.
// Deleted rather than kept for a caller that has not appeared in the life of the package (issue 0009).
// The temporary name is random for the reason `streamAtomic` gives below: two copies of this program
// running at once must not pick the same one.

/**
 * Everything left of `fed`, to `path`, atomically and a chunk at a time.
 *
 * The streaming form, for a copy that must not be bounded by memory: the bytes go straight to a temporary
 * file opened beside the target, and the rename happens only once all of them are there and it is closed.
 * Every backing streams the same way, so a memory image gets the same write-beside-and-rename as a disk.
 */
export async Result<void, FilesFault> streamAtomic(Random rnd, Files fs, Feed fed, string path) {
  string tmp = tempName(rnd, path);
  // The fault is returned as it came, so a caller can tell "no such directory" from "not permitted".
  Output to;
  match (await fs.openWrite(tmp)) {
    Ok(o): { to = o; }
    Err(e): { return Result.Err(e); }
  }
  while (true) {
    u8[] bytes = await fed.next();
    if (bytes.len() == 0) { break; }
    auto wrote = await to.write(bytes);
    if (wrote.isErr()) { return await abandon(fs, to, tmp, wrote.err()!); }
  }
  // Half a file renamed over the original is the worst outcome available here, so a failed read
  // abandons the temporary and leaves the target alone.
  if (fed.why != "") { return await abandon(fs, to, tmp, Other(fed.why)); }
  // Closed before the rename, which is what puts the last bytes in the file: a rename of a file still
  // open could move it half-written.
  auto closed = await to.close();
  if (closed.isErr()) { return await abandon(fs, to, tmp, closed.err()!); }
  return await finish(fs, tmp, path);
}

/** The temporary closed and removed, and `why` answered: the target is left as it was. */
async Result<void, FilesFault> abandon(Files fs, Output to, string tmp, FilesFault why) {
  await to.close();
  await fs.remove(tmp, false);
  return Result.Err(why);
}

/** The rename, and the cleanup if it fails. */
async Result<void, FilesFault> finish(Files fs, string tmp, string path) {
  auto moved = await fs.rename(tmp, path);
  if (moved.isOk()) { return Result.Ok(); }
  // The rename is the only step that can leave litter, so clean up after it and not
  // before: until it succeeds, the temporary file is the only copy of the new contents.
  await fs.remove(tmp, false);
  return Result.Err(moved.err()!);
}

/** A sibling of `path` that no concurrent copy of this program will also pick. */
string tempName(Random rnd, string path) {
  u8[] r = flatten(rnd.bytes(6).wait()).unwrap();
  u8[] out = u8[].filled(12, '0');
  u8[] digits = "0123456789abcdef".toBytes();
  for (i32 i = 0; i < 6; i++) {
    out[i * 2] = digits[(r[i] as i32 >> 4) & 15];
    out[i * 2 + 1] = digits[r[i] as i32 & 15];
  }
  return "\{path}.tmp\{string.fromBytes(out)}";
}
