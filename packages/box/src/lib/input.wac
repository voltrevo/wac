// One input, from a file or from standard input.
//
// That an applet works in a pipe at all is this file: without `readStdin` every one of
// them would be a file-to-file tool.

import { Files, Input, Output } from "std";
import { Args } from "./args.wac";
import { Feed, Line, Lines, Sink, nextLine } from "../../../platform/src/stream.wac";
import { reason } from "../../../fs/src/words.wac";

/**
 * An opened input: the bytes when the caller wanted them all, and a `Feed` when it wanted a stream.
 *
 * Every file streams: `Files.openRead` gives an `Input` per file on every backing, so a memory image and the
 * host's disk are read the same way and the feed is the applet's whole view of either. Standard input is the
 * operand `""` (or `-`), fed from the program's own `stdin`.
 */
export struct Opened { bool ok; u8[] bytes; string label; Feed fed; }

/**
 * How many files this invocation names, from operand `n` on.
 *
 * Zero means standard input. **Every applet here read operand 0 and ignored the rest**, silently: `cat a b`
 * printed `a`, `sort *.txt` sorted the first one, `wc -l a b` counted `a` and said nothing about `b`. That
 * is the shape this repo keeps calling out in other people's parsers — an input that cannot be seen is
 * reported as absent — and it was in the one program a person actually types.
 */
export i32 operandCount(Args a, i32 n) { return a.rest.len() <= n ? 0 : a.rest.len() - n; }

/**
 * The `n`th operand as a path, where a **lone `-` is standard input** and so is no operand at all.
 *
 * `-` is not a filename in any of these tools and never has been: `cat -`, `sort -` and `uniq -` all read
 * standard input, and `cat a - b` reads the file, then stdin, then the other file. Every applet here read
 * it as a *name* instead, so `cat -` said "cat: -: No such file or directory" and exited 1 — which is a
 * refusal, and the wrong one, since the caller wrote something every real tool accepts.
 *
 * One function because it is one convention. It is the same empty string the absent case already uses,
 * which is what `openInput("")` and `readStdin` already mean, so nothing downstream had to learn a third
 * spelling of "standard input".
 *
 * **The label is not the path.** `wc -c -` prints `4 -`: the operand is still `-` in the output even
 * though the bytes came from standard input, which is why `Input.label` keeps what was written and only
 * the path is resolved.
 */
export string operandAt(Args a, i32 n) {
  if (a.rest.len() <= n) { return ""; }
  return a.rest[n] == "-" && dashIsStdin(a.name) ? "" : a.rest[n];
}

/** What the `n`th operand is *called* in a message — what was written, or `""` when there was none. */
export string labelAt(Args a, i32 n) { return a.rest.len() <= n ? "" : a.rest[n]; }

/**
 * Whether a lone `-` names standard input for this tool. **Not universal**, and measured rather than
 * assumed.
 *
 * Every coreutils program here takes it — `cat`, `sort`, `uniq`, `wc`, `head`, `tail`, `nl`, `tac`,
 * `cut`, `fold`, `paste`, `shuf`, `grep`, the checksums, `base64`, `base32`. Two of these applets imitate
 * something that is not coreutils and does not: util-linux's `rev` says "rev: cannot open -: No such file
 * or directory", and binutils' `strings` prints its usage. Applying the convention everywhere would have
 * traded one wrong answer for another, which is the mistake wac-mono 0096 records for the *last* time an
 * operand rule was assumed to be universal.
 */
bool dashIsStdin(string name) { return name != "rev" && name != "strings"; }

/**
 * How this tool says it could not open something.
 *
 * Coreutils mostly says `cat: nosuchfile: No such file or directory`, but not always: `head` and `tail`
 * say `cannot open 'nosuchfile' for reading` and `sort` says `cannot read: nosuchfile`, while
 * util-linux's `rev` says `cannot open nosuchfile` with no quotes at all. Four tools, four sentences,
 * each measured on the tool itself — the same lesson `dashIsStdin` records one function up, and the
 * reason this is a table rather than a format string.
 */
string cannotOpen(string name, string path, string why) {
  // **A directory is not an open failure.** It opens; the *read* is what refuses, and the tools that
  // word the two differently say so: `sort somedir` is "read failed: somedir: Is a directory", not
  // "cannot read". Ours reaches this through one call that does both, so the reason is what tells them
  // apart — which is only possible now that "Is a directory" is a category rather than the host's
  // sentence.
  if (why == "Is a directory") { return readFailed(name, path, why); }
  // Five wordings, each measured on the tool it belongs to rather than derived from the majority.
  // `head`, `tail` and `split` quote the name and say what they were going to do with it; `tac` says the
  // same thing and calls it a *failure* to do it; util-linux's `rev` says "cannot open" without quotes;
  // `sort` says "cannot read"; coreutils' rest — `cat`, `wc`, `cut`, `nl`, `fold`, `uniq`, `paste`,
  // `shuf`, `base64`, `od` — say the name and the reason. Getting this from the majority would have been
  // wrong for six of the sixteen tools here, and each line below was read off the tool itself.
  if (name == "rev") { return "\{name}: cannot open \{path}: \{why}"; }
  if (name == "head" || name == "tail" || name == "split") {
    return "\{name}: cannot open '\{path}' for reading: \{why}";
  }
  if (name == "tac") { return "\{name}: failed to open '\{path}' for reading: \{why}"; }
  if (name == "sort") { return "\{name}: cannot read: \{path}: \{why}"; }
  return "\{name}: \{path}: \{why}";
}

/**
 * Operand `n`, opened to read a chunk at a time — so memory is bounded by the chunk rather than by the input,
 * and an endless file such as `/dev/zero` is as readable as any other, up to what the applet pulls.
 *
 * The returned `bytes` is always empty: there is nothing to hand over yet, and an applet that wanted them
 * would have called `readInput`.
 */
export async Opened openStream(Input stdin, Output err, Files fs, Args a, i32 n) {
  string path = operandAt(a, n);
  string label = a.rest.len() <= n ? "" : a.rest[n];
  if (path == "") { return Opened(true, u8[](), label, Feed.from(stdin)); }
  match (await fs.openRead(path)) {
    Ok(in): { return Opened(true, u8[](), label, Feed.from(in)); }
    Err(e): {
      err.line(cannotOpen(a.name, path, reason(e)));
      return Opened(false, u8[](), label, Feed.of(u8[]()));
    }
  }
}

/**
 * Every file from operand `n` on, concatenated — or standard input when there are none.
 *
 * The whole-input half of `nextSpan`, for the applets that need the bytes all at once: `sort` has to see
 * every line before it can order them, `json` has to see a whole document. Those read operand `n` and
 * ignored the rest (wac-mono 0096), so `sort a b` sorted `a` and said nothing about `b`.
 *
 * A file that will not open stops it, with the reason already reported — same rule as `Reader`, and the
 * same difference from GNU, which carries on and exits 1 at the end.
 */
export async Opened readAll(Input stdin, Output err, Files fs, Args a, i32 n) {
  i32 files = operandCount(a, n);
  if (files <= 1) { return await readInput(stdin, err, fs, a, n); }
  u8[][] parts = u8[][].filled(files, u8[]());
  i32 total = 0;
  for (i32 i = 0; i < files; i++) {
    Opened one = await readInput(stdin, err, fs, a, n + i);
    if (!one.ok) { return one; }
    parts[i] = one.bytes;
    total = total + one.bytes.len();
  }
  u8[] all = u8[].filled(total, 0);
  i32 at = 0;
  for (i32 i = 0; i < files; i++) {
    all.copyFrom(parts[i], 0, at, parts[i].len());
    at = at + parts[i].len();
  }
  return Opened(true, all, operandAt(a, n), Feed.of(all));
}

/** Positional argument `n` names a file; without one, standard input. */
export async Opened readInput(Input stdin, Output err, Files fs, Args a, i32 n) {
  string path = operandAt(a, n);
  // The label is what was written, so `-` stays `-` in the output; the path is what was resolved.
  string label = a.rest.len() <= n ? "" : a.rest[n];
  if (path == "") {
    match (await stdin.readAll()) {
      Ok(all): { return Opened(true, all, label, Feed.of(all)); }
      Err(e): {
        err.line(readFailed(a.name, label, "\{e}"));
        return Opened(false, u8[](), label, Feed.of(u8[]()));
      }
    }
  }
  match (await fs.readFile(path)) {
    Ok(bytes): { return Opened(true, bytes, label, Feed.of(bytes)); }
    Err(e): {
      // GNU's words where the category has them, and the host's sentence where it does not — `reason` says
      // which, and why the host's own spelling of the four words is not used.
      err.line(cannotOpen(a.name, path, reason(e)));
      return Opened(false, u8[](), label, Feed.of(u8[]()));
    }
  }
}

/**
 * One chunk, for the applets whose loop is "read, work, repeat".
 *
 * `Read` has three states and every caller has to handle all three, which is the point — the old
 * `u8[]` answer let "finished" and "broken" look identical, and the first fix for that was a
 * companion `inputError()` to ask afterwards, which any forgetful caller simply did not ask.
 *
 * This keeps that exhaustiveness while giving the eight filters here one shape: `ok` false with a
 * message already reported means stop and exit 1; `ok` true with no bytes means the input finished.
 */
export struct Chunk { bool ok; bool more; u8[] bytes; }

/**
 * The next chunk, reporting a failure to standard error as it goes.
 *
 * `label` is the operand being read, or `""` for standard input — it is in the sentence because it is in
 * the real tool's: `cat somedir` says `cat: somedir: Is a directory`, and this said `cat: Is a directory`
 * with nothing to say *which* file, which is the same fault as printing the host's errno and was hidden by
 * the same thing, since a read only fails on inputs nobody had tried.
 */
export async Chunk nextChunk(Output err, Feed fed, Args a, string label) {
  u8[] bytes = await fed.next();
  if (bytes.len() > 0) { return Chunk(true, true, bytes); }
  // `Feed` answers an empty array for both "finished" and "failed" and keeps the reason, which is the
  // one place the three states collapse to two. Asking afterwards is how they come apart again.
  if (fed.why != "") {
    err.line(readFailed(a.name, label, fed.why));
    return Chunk(false, false, u8[]());
  }
  return Chunk(true, false, u8[]());
}

/**
 * How this tool says a read of something it had already opened went wrong.
 *
 * Two wordings, each measured: `head` says `head: error reading 'x': …` and `sort` says
 * `sort: read failed: x: …`, where the rest say the name and the reason — the same shape as
 * `cannotOpen` above and, for most tools, the same sentence, because to them a directory that opens and
 * then refuses to be read is just a file they could not read.
 */
export string readFailed(string name, string label, string why) {
  if (label == "") { return "\{name}: \{why}"; }
  if (name == "head" || name == "tail") { return "\{name}: error reading '\{label}': \{why}"; }
  if (name == "sort") { return "\{name}: read failed: \{label}: \{why}"; }
  return "\{name}: \{label}: \{why}";
}

/**
 * The next chunk, rolling on to the next file when one ends.
 *
 * This is what `cat a b` needs and what every streaming applet here wanted: the operands are one stream
 * with joins in it. `at` is the operand the caller is on and comes back advanced, so the loop is
 *
 *     i32 at = 0;
 *     while (true) {
 *       Span got = nextSpan(core, cli, a, at, first);
 *       …
 *       at = got.at;
 *     }
 *
 * A file that cannot be opened is reported, **skipped**, and remembered in `failed` — which is what GNU
 * does, and what `Reader` next to this has always done. It used to stop the run instead, so
 * `cat a missing b` printed `a` and nothing else, and the comment here said so rather than fixing it. The
 * cost of the old behaviour is not the exit status: it is `b`, silently absent.
 */
/**
 * One chunk of a run of operands, and the feed to take the next one from.
 *
 * The feed comes back because it changes at a file boundary: `cat a b` is one stream to the caller and
 * two sources underneath, and the state of the second cannot live in the capability when the second is
 * a memory image.
 */
export struct Span {
  bool ok;
  bool more;
  u8[] bytes;
  i32 at;
  Feed fed;
  /**
   * Whether any operand so far could not be opened, which is the caller's exit status and nothing else.
   *
   * Sticky, and separate from `ok`: `ok` false ends the stream, and this says the run was imperfect even
   * though it continued. A caller that read only `ok` would exit 0 over a file it had complained about.
   */
  bool failed;
}

export async Span nextSpan(Input stdin, Output err, Files fs, Args a, i32 at, bool opened, Feed fed) {
  i32 files = operandCount(a, 0);
  Feed here = fed;
  bool failed = false;
  if (!opened) {
    // Forward past every operand that will not open, reporting each — the same walk `Reader.create`
    // does, and the reason this is a loop rather than one attempt: `cat a bad worse b` complains twice
    // and still prints `b`.
    while (true) {
      Opened in = await openStream(stdin, err, fs, a, at);
      if (in.ok) { here = in.fed; break; }
      failed = true;
      if (files <= at + 1) { return Span(false, false, u8[](), at, fed, true); }
      at = at + 1;
    }
  }
  Chunk got = await nextChunk(err, here, a, labelAt(a, at));
  // A read that fails is the same skip as an open that fails, once there is another operand: GNU's
  // `cat a somedir b` prints `a`, complains, and prints `b`. It used to end the run here, which lost `b`
  // for the same reason and with the same invisibility as the open case.
  if (!got.ok) {
    if (files <= at + 1) { return Span(false, false, u8[](), at, here, true); }
    Span next = await nextSpan(stdin, err, fs, a, at + 1, false, here);
    return Span(next.ok, next.more, next.bytes, next.at, next.fed, true);
  }
  if (got.more) { return Span(true, true, got.bytes, at, here, failed); }
  // This file is done. If another was named, roll on; the caller sees one stream.
  if (files > at + 1) {
    Span next = await nextSpan(stdin, err, fs, a, at + 1, false, here);
    return Span(next.ok, next.more, next.bytes, next.at, next.fed, next.failed || failed);
  }
  return Span(true, false, u8[](), at, here, failed);
}

/**
 * Lines across every file an invocation names, as one sequence.
 *
 * The line-oriented applets pull through `packages/platform`'s `Lines`/`Feed`, which know about *a*
 * source and rightly nothing about operands — a platform abstraction should not know what `Args` is. This
 * is the box-level wrapper that does: when one file runs out and another was named, it opens the next and
 * makes a fresh pair, so `nl a b` numbers straight through the join exactly as `nl` does.
 *
 * `create` opens the first file, so a caller that gets `ok` false has already had the reason reported.
 */
export struct Reader {
  bool ok;
  /**
   * True when the sequence ended because something failed rather than because the input ran out.
   *
   * `Line.ok` false means "no more lines" and cannot tell those apart, so a caller that only looks at it
   * reports success over a file it could not open — which is what the first version of this did, and it
   * printed the earlier files' contents on the way out. Every converted applet checks this before
   * returning 0. `Lines.broken` exists in `packages/platform` for the same reason and says so.
   */
  bool broken;
  /**
   * Whether any operand could not be opened.
   *
   * Separate from `broken` because the two have different answers: a file that cannot be opened is
   * skipped and the status is 1 at the end, while a read that fails half way through one ends the
   * sequence there. An applet that treated them the same would either stop early or claim success.
   */
  bool failed;
  i32 at;
  Lines s;
  Feed fed;
  /**
   * The caller's output, so that a complaint about the *next* operand cannot overtake the lines of this
   * one.
   *
   * Output here is block-buffered — a write per line costs a park and a wake per line, which is why
   * `Sink` exists — while `core.warn` goes straight out. So `cut -c1 a missing b`, with both streams
   * merged as they are at a prompt, printed the complaint before `a`. GNU has exactly the same
   * arrangement and settles it the same way: its `error()` flushes standard output first.
   *
   * The reader holds it because the reader is what opens the next operand, one layer under the applet
   * that has both objects in scope. wac-mono 0112.
   */
  Sink out;

  /**
   * A reader over the operands from `first`, or over standard input when there are none.
   *
   * A first operand that will not open is the same skip as any other — `nl missing f` prints `f` — so
   * this walks forward until one opens. **Not falling through to standard input** is the part that
   * needs saying: `rev -` names an operand util-linux's `rev` will not open, and a reader that gave up
   * on it and then read stdin answered with the piped input reversed, which is a wrong answer where
   * there had been a refusal. When every operand fails the reader is empty and `failed` is set.
   */
  async Reader create(Input stdin, Output err, Files fs, Args a, i32 first, Sink out) {
    if (operandCount(a, 0) <= first) {
      return Reader(true, false, false, first, Lines.create(), Feed.from(stdin), out);
    }
    bool failed = false;
    for (i32 at = first; at < operandCount(a, 0); at++) {
      Opened in = await openStream(stdin, err, fs, a, at);
      // The feed the opener chose, not the process's: on anything but a host mount it is serving bytes
      // this filesystem handed over.
      if (in.ok) { return Reader(true, false, failed, at, Lines.create(), in.fed, out); }
      failed = true;
    }
    // Every one of them was refused, and each has already said so. An empty feed rather than standard
    // input: there is nothing left to read, and reading anything would be inventing an operand.
    return Reader(true, false, true, operandCount(a, 0), Lines.create(), Feed.of(u8[]()), out);
  }

  /**
   * The next line, rolling on to the next file at the end of one.
   *
   * **A file that cannot be opened is reported and skipped**, and the ones after it are still read. That
   * is what GNU does — `nl a missing b` prints `a` and `b`, complains about `missing`, and exits 1 — and
   * this used to stop at the first failure instead, which was named in wac-mono 0096 and left. It cost
   * exactly what naming it was meant to avoid: `packages/sh`'s own `nl` and `rev` carried on, so
   * deleting them in favour of these (wac-mono 0103) would have quietly lost the behaviour, and the
   * comparison that found it was the one written to make that deletion safe.
   *
   * `broken` is a different thing and stays: a read that fails *part way through* a file it had already
   * opened ends the sequence, because carrying on would silently drop the rest of that file.
   */
  async Line next(this, Input stdin, Output err, Files fs, Args a) {
    Line l = await nextLine(this.s, this.fed);
    if (l.ok) { return l; }
    // A read that failed part way is not an end of input, and `Line.ok` cannot say which happened.
    //
    // **And it is said out loud.** `broken` was set and nothing printed, so `nl somedir` — a path that
    // opens and then refuses to be read — exited 1 having written nothing at all, which is a status with
    // no sentence attached. Every real tool names the file and the reason.
    if (this.s.broken != "") {
      this.out.flush();
      err.line(readFailed(a.name, labelAt(a, this.at), this.s.broken));
      this.broken = true;
      // …and on to the next operand, which is what GNU does: `cut -c1 a somedir b` prints `a`,
      // complains, and prints `b`. Ending the whole sequence here lost `b` — the same mistake as
      // stopping at an operand that will not *open*, one layer along, and it survived the fix for that
      // one because a read only fails on inputs nobody had tried.
      if (operandCount(a, 0) <= this.at + 1) { return l; }
      this.at = this.at + 1;
      Opened more = await openStream(stdin, err, fs, a, this.at);
      if (!more.ok) { this.failed = true; return await this.next(stdin, err, fs, a); }
      this.s = Lines.create();
      this.fed = more.fed;
      return await this.next(stdin, err, fs, a);
    }
    if (operandCount(a, 0) <= this.at + 1) { return l; }
    this.at = this.at + 1;
    // Everything written from the file just finished, before anything is said about the next one.
    this.out.flush();
    Opened in = await openStream(stdin, err, fs, a, this.at);
    // Reported already, by `openStream`. Remember that it happened, and read the next operand.
    if (!in.ok) { this.failed = true; return await this.next(stdin, err, fs, a); }
    this.s = Lines.create();
    this.fed = in.fed;
    return await this.next(stdin, err, fs, a);
  }
}
