// Byte-array helpers shared by every applet.

import { slice } from "../../../bytes/src/slice.wac";

export u8[] concat(u8[] a, u8[] b) {
  u8[] out = u8[].filled(a.len() + b.len(), 0);
  out.copyFrom(a, 0, 0, a.len());
  out.copyFrom(b, 0, a.len(), b.len());
  return out;
}


export u8[] withNewline(u8[] a) {
  u8[] out = u8[].filled(a.len() + 1, '\n');
  out.copyFrom(a, 0, 0, a.len());
  return out;
}
