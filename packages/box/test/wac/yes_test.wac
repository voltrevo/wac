// `yes`: the only applet that never ends on its own.
//
//     wac test --allow-read --allow-write packages/box/test/wac/yes_test.wac
//
// From `box.test.ts`, where it was the last thing said to need a process — "it stops because `write`
// reports the closed pipe, and closing a pipe is a process lifecycle a frame does not have".
//
// The test hands it an `Output` that takes a megabyte and then answers `OutputClosed`, which is what a
// reader leaving looks like from the writer's side. The pipe and the cap are not the same mechanism, and that
// is worth saying rather than glossing: a closed pipe is the reader leaving, a full buffer is the writer
// running out of room. What `yes` depends on is neither — it is that `write` can be refused at all.

import { Sys, Output, OutputClosed, OutputFault } from "std";
import { T } from "../../../wactest/src/assert.wac";
import { yes } from "../../src/applets/yes.wac";
import { parseList } from "../../src/lib/args.wac";
import { Kept } from "../../../platform/src/stream.wac";
import { Buf, Result } from "core";

static i32 CAP = 1 << 20;

/** `b` kept, until the buffer holds `CAP`; then refused, as a reader that has gone refuses it. */
async Result<void, OutputFault> upTo(Buf held, bool[] refused, u8[] b) {
  if (held.len + b.len() > CAP) {
    refused[0] = true;
    return Result.Err(OutputClosed("the reader has gone"));
  }
  held.pushAll(b);
  return Result.Ok();
}

async Result<void, OutputFault> stillOpen() { return Result.Ok(); }

bool never() { return false; }

export async string test_yes_stops_when_the_sink_stops_taking(Sys sys) {
  T t = T.create();
  Buf held = Buf.create();
  bool[] refused = bool[].filled(1, false);
  Output out = Output((u8[] b) => upTo(held, refused, b), stillOpen);
  // **This returns.** That is the assertion, and nothing after it would run if it were wrong — a `yes`
  // that ignored `write`'s answer would spin here until the run was killed, which is the failure this
  // test is for and the one a timeout reports as an unhelpful nothing.
  i32 code = yes(Kept.create().out, out, never, parseList(["yes", "wac"], 1, "yes"));
  string said = string.fromBytes(held.bytes());
  t.isTrue(said.len() > 0, "yes wrote something");
  t.eqStr(said.slice(0, 8), "wac\nwac\n", "it wrote its operand, repeatedly");
  // It stopped because the sink refused, not because it decided to.
  t.isTrue(refused[0], "yes stopped because the output refused, not for some other reason");
  t.isTrue(said.len() > CAP / 2, "and it filled it: \{said.len()} bytes");
  // Every byte is the operand repeated — a `yes` that stopped early for a *different* reason could
  // still have written a plausible prefix, so the length above and the shape here are two claims.
  t.eqI32(said.len() % 4, 0, "whole repetitions of 'wac\\n'");
  t.eqI32(code, 0, "and it ended cleanly");
  return t.report();
}
