// The flags these applets implement, replayed against what the real tools answered when it was captured.
//
// **This used to spawn 213 processes.** `behaviour.test.ts` built a shell, then ran bash and that shell
// once each for all 104 cases, every suite run, to establish what `cut -f1,3` prints. The answer does not
// change between runs, so `tools/wac/appletvectors.wac` asks once and this replays in process — through
// `Shell` with `sh.external = boxRun`, which is the route `example/boxsh.wac` wires up and
// `routes.test.ts` holds to the spawned one.
//
// The cases and the fixtures are `cases.wac`, shared with the capture tool: one list, two readers.
//
// Ten cases stay live at the bottom. A frozen expectation cannot see coreutils move under it, and the
// answer to that is a canary rather than 104 of them.

import { Cli, Core, Exec, FileResult } from "../../../platform/src/platform.wac";
import { Frame, childCli, childCore } from "../../../platform/src/frame.wac";
import { Shell } from "../../../sh/src/exec.wac";
import { shellMain } from "../../../sh/src/entry.wac";
import { boxNames, boxRun } from "../../src/shrun.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { T } from "../../../wactest/src/assert.wac";
import { Fixture, cases, fixtures } from "./cases.wac";

struct Ran {
  string out;
  string err;
  i32 status;
}

struct Vector {
  string script;
  i32 status;
  string out;
}

struct Loaded {
  Vector[] items;
  i32 n;
  string oracle;
  string error;
}

string vectorsPath() { return "packages/box/test/behaviour-vectors.txt"; }

/** Absolute, because a relative frame `cwd` does not resolve — `issues/system/0194`. */
string caseDir(Cli cli) { return cli.cwd().wait() + "/.cache/wac-behaviour"; }

/**
 * Every fixture written fresh, because several cases mutate.
 *
 * `split -l 10 long.txt part` writes files and `rm -f part*` takes them away; a case measured against a
 * world the previous one changed is a difference that reproduces for a reason that is not the applet's.
 */
bool layFixtures(Cli cli, string dir) {
  cli.remove(dir, true).wait();
  if (!cli.mkdir(dir, true).wait().ok()) { return false; }
  Fixture[] fs = fixtures();
  for (i32 i = 0; i < fs.len(); i++) {
    if (!cli.writeFile(dir + "/" + fs[i].name, fs[i].bytes).wait().ok()) { return false; }
  }
  return true;
}

/**
 * Cases the in-process route cannot answer, by name and with the reason.
 *
 * **`issues/system/0166`**, which `frame.wac` names in as many words: "`openOutput` does not escape the
 * capture". An applet that redirects its own standard output to a file — `split` is the only one — has
 * those bytes kept by the frame instead, so its pieces land on stdout as well as in the files. Spawned,
 * the same applet is correct, which is how this survived: every sweep that covered `split` spawned.
 *
 * Listed here rather than dropped from `cases.wac`, because the case is a real expectation and the
 * capture holds the right answer for it. When 0166 is fixed this list empties and the count below rises
 * by one, which is the loudest way to notice.
 */
bool blockedByFrame(string script) {
  return script.indexOf("split ") >= 0;
}

/** One case through a shell that has box's applets, inside this process. */
Ran runCase(Core core, Cli cli, string dir, string script) {
  Frame f = Frame.of(string[]("sh", "-c", script), u8[0](), dir, false);
  Core c = childCore(f, core);
  Cli l = childCli(f, cli);
  Shell sh = Shell.create(c, l);
  sh.external = boxRun;
  sh.externalNames = boxNames;
  i32 status = shellMain(c, l, sh, 1);
  return Ran(string.fromBytes(f.out.bytes()), string.fromBytes(f.err.bytes()), status);
}

export string test_every_implemented_flag_still_answers_what_the_real_tool_answered(Core core, Cli cli) {
  T t = T.create();
  Loaded v = load(cli);
  t.isTrue(v.error == "", v.error);
  if (v.error != "") { return t.report(); }

  string[] list = cases();
  string dir = caseDir(cli);
  i32 ran = 0;
  i32 wrong = 0;
  i32 unknown = 0;
  string detail = "";
  for (i32 i = 0; i < list.len() && i < v.n; i++) {
    // **Checked against the recorded script, not just the recorded answer.** An edit to `cases.wac`
    // that adds or reorders a case would otherwise compare every later case against its neighbour's
    // expectation and report a hundred applet bugs.
    if (v.items[i].script != list[i]) {
      unknown = unknown + 1;
      continue;
    }
    if (blockedByFrame(list[i])) { continue; }
    if (!layFixtures(cli, dir)) {
      t.isTrue(false, "cannot lay the fixtures in " + dir);
      return t.report();
    }
    Ran r = runCase(core, cli, dir, list[i]);
    ran = ran + 1;
    if (r.out != v.items[i].out || r.status != v.items[i].status) {
      wrong = wrong + 1;
      if (wrong <= 5) {
        detail = detail + "\n  $ " + list[i] +
                 "\n    want " + show(v.items[i].out) + " exit " + itoa(v.items[i].status) +
                 "\n    ours " + show(r.out) + " exit " + itoa(r.status) +
                 (r.err == "" ? "" : "\n    err  " + show(r.err));
      }
    }
  }
  cli.remove(dir, true).wait();

  // One short of the list, and the one is named: `split` cannot be replayed in process until
  // `issues/system/0166` is fixed. A bare `ran == list.len()` would have to be relaxed silently.
  t.eqI32(ran, list.len() - 1, "not every case replayed — " + itoa(list.len()) + " cases, " +
                               itoa(v.n) + " vectors, and one skipped for issues/system/0166");
  t.eqI32(unknown, 0, itoa(unknown) + " cases do not match the recorded script — `cases.wac` changed, so " +
                      "`wac run --allow-read --allow-write --allow-run tools/wac/appletvectors.wac` is " +
                      "what makes this file mean anything again");
  t.eqI32(wrong, 0, itoa(wrong) + " of " + itoa(ran) + " invocations differ from the captured tools (" +
                    v.oracle + ")" + detail);
  return t.report();
}

/**
 * The canary: ten cases asked of the *live* tools.
 *
 * Frozen expectations cannot see the environment move. These can, and they are the cases themselves
 * rather than a hand-written stand-in, so what is checked is the thing the vectors are about.
 */
export string test_the_live_tools_still_agree_on_a_handful(Core core, Cli cli) {
  T t = T.create();
  string[] list = cases();
  string dir = caseDir(cli);
  i32 checked = 0;
  // Spread across the list rather than the first ten, which are all `sort`.
  for (i32 k = 0; k < 10; k++) {
    i32 i = (k * list.len()) / 10;
    if (!layFixtures(cli, dir)) {
      t.isTrue(false, "cannot lay the fixtures in " + dir);
      return t.report();
    }
    Exec want = cli.exec("env",
                         string[]("-i",
                                  "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                                  "LC_ALL=C", "HOME=" + dir,
                                  "bash", "-c", "cd \"$1\" || exit 1; exec bash -c \"$2\"",
                                  "bash", dir, list[i]),
                         u8[0]()).wait();
    if (!want.ran()) {
      // No bash here is not a failure of the applets: say so and stop, rather than passing quietly.
      t.isTrue(checked > 0, "bash would not start: " + want.error);
      return t.report();
    }
    if (!layFixtures(cli, dir)) {
      t.isTrue(false, "cannot lay the fixtures in " + dir);
      return t.report();
    }
    Ran ours = runCase(core, cli, dir, list[i]);
    checked = checked + 1;
    t.eqStr(ours.out, string.fromBytes(want.stdout), "the live tools disagree: $ " + list[i]);
    t.eqI32(ours.status, want.status, "the live tools' status disagrees: $ " + list[i]);
  }
  cli.remove(dir, true).wait();
  t.eqI32(checked, 10, "not every canary ran");
  return t.report();
}

struct Line {
  string text;
  i32 next;
}

Line lineAt(u8[] b, i32 at) {
  i32 end = at;
  while (end < b.len() && b[end] != '\n') { end = end + 1; }
  return Line(string.fromBytes(sliceOf(b, at, end)), end + 1);
}

u8[] sliceOf(u8[] b, i32 from, i32 to) {
  i32 n = to - from;
  if (n <= 0) { return u8[0](); }
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = b[from + i]; }
  return out;
}

/** The number after a tag: `S 21` gives 21, and -1 when the line is not that shape. */
i32 numberIn(string line, string tag) {
  if (line.len() < tag.len() + 1) { return 0 - 1; }
  if (line.slice(0, tag.len()) != tag) { return 0 - 1; }
  string rest = line.slice(tag.len() + 1, line.len());
  if (rest.len() == 0) { return 0 - 1; }
  i32 v = 0;
  for (i32 i = 0; i < rest.len(); i++) {
    u8[] c = rest.slice(i, i + 1).toBytes();
    if (c.len() == 0) { return 0 - 1; }
    i32 d = c[0];
    if (d < '0' || d > '9') { return 0 - 1; }
    v = v * 10 + (d - '0');
  }
  return v;
}

/**
 * Every vector in the file, or an `error` saying why not.
 *
 * A missing file is an error rather than an empty list: a replay over zero vectors passes, which is the
 * shape this repository keeps finding — a check that stopped checking and said nothing.
 */
Loaded load(Cli cli) {
  FileResult r = cli.readFile(vectorsPath()).wait();
  if (!r.ok) {
    return Loaded(Vector[0](), 0, "",
                  "cannot read " + vectorsPath() + " — run `wac run --allow-read --allow-write " +
                  "--allow-run tools/wac/appletvectors.wac` to write it");
  }
  u8[] b = r.bytes;
  Line l = lineAt(b, 0);
  if (l.text != "wac-applet-vectors 1") {
    return Loaded(Vector[0](), 0, "", "not an applet vectors file: " + l.text);
  }
  string oracle = "";
  i32 at = l.next;
  i32 count = 0 - 1;
  for (i32 guard = 0; guard < 8 && count < 0; guard++) {
    Line h = lineAt(b, at);
    at = h.next;
    if (h.text.len() > 11 && h.text.slice(0, 11) == "coreutils: ") {
      oracle = h.text.slice(11, h.text.len());
    }
    count = numberIn(h.text, "count:");
  }
  if (count < 0) { return Loaded(Vector[0](), 0, oracle, "no count in the header"); }

  Vector[] items = Vector[count](fill: Vector("", 0, ""));
  i32 n = 0;
  for (i32 i = 0; i < count; i++) {
    Line sl = lineAt(b, at);
    i32 slen = numberIn(sl.text, "S");
    if (slen < 0) { return Loaded(items, n, oracle, "record " + itoa(i) + " has no script"); }
    string script = string.fromBytes(sliceOf(b, sl.next, sl.next + slen));
    at = sl.next + slen + 1;

    Line xl = lineAt(b, at);
    i32 status = numberIn(xl.text, "X");
    at = xl.next;

    Line ol = lineAt(b, at);
    i32 olen = numberIn(ol.text, "O");
    if (olen < 0) { return Loaded(items, n, oracle, "record " + itoa(i) + " has no output"); }
    string out = string.fromBytes(sliceOf(b, ol.next, ol.next + olen));
    at = ol.next + olen + 1;

    items[n] = Vector(script, status, out);
    n = n + 1;
  }
  return Loaded(items, n, oracle, "");
}

/** A string with its newlines visible, so a difference reads on one line. */
string show(string s) {
  string out = "";
  i32 cap = s.len() > 200 ? 200 : s.len();
  for (i32 i = 0; i < cap; i++) {
    string ch = s.slice(i, i + 1);
    out = out + (ch == "\n" ? "\\n" : ch == "\t" ? "\\t" : ch);
  }
  return "\"" + out + (s.len() > cap ? "…\"" : "\"");
}
