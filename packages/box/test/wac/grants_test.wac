// What an applet says when it was not granted what it needs.
//
//     wac test --allow-read --allow-write packages/box/test/wac/grants_test.wac
//
// From `box.test.ts`, where five tests each built and spawned a real executable for one reason: an
// in-process frame could not be given *fewer* grants than the test process holds. `childCli` hands the
// parent's capabilities through untouched — right for the shell, where a child is as trusted as the
// shell that spawned it (`issues/system/0028`) — so there was no argument that would say less.
//
// `childCliGranted` is that argument. `Cli` is a struct of function fields, so it replaces the few that
// matter rather than restating all forty-two, and each withheld one answers exactly what a host answers
// an ungranted program: `FAULT_NOT_GRANTED` and *"Not granted to this application"*.
//
// **The sentence is the claim, not the status.** A test that withheld a capability and got some other
// message would prove that the *helper* refuses, not that the applet behaves as it does when a real
// host refuses it — and every refusal in `box` is checked by its words.

import { Cli, Core } from "std/platform.wac";
import { T } from "../../../wactest/src/assert.wac";
import { Frame, Grants, childCliGranted, childCore } from "../../../platform/src/frame.wac";
import { UNKNOWN, dispatch } from "../../src/box.wac";
import { parseList } from "../../src/lib/args.wac";
import { Fs } from "../../../fs/src/fs.wac";
import { Ran } from "./replay.wac";

/** Absolute, because a relative frame `cwd` does not resolve — `issues/system/0194`. */
string caseDir(Cli cli) { return cli.cwd().wait() + "/.cache/wac-grants"; }

/** One applet, in a frame holding exactly `g` and nothing more. */
Ran runGranted(Core core, Cli cli, string dir, string[] argv, Grants g) {
  Frame f = Frame.of(argv, u8[0](), dir, false);
  Core c = childCore(f, core);
  Cli l = childCliGranted(f, cli, g);
  i32 status = dispatch(c, l, Fs.onHost(l, 0), parseList(argv, 1, argv[0]), argv[0]);
  return Ran(string.fromBytes(f.out.bytes()), string.fromBytes(f.err.bytes()), status, f.out.bytes());
}

/**
 * A read the program was never granted says why, and fails.
 *
 * The message shape is the point rather than the status: a denied read must say *why*, which a
 * bool-returning `openInput` could not, and that is why `FileResult` carries a fault and a sentence.
 */
export string test_a_denied_read_says_why(Core core, Cli cli) {
  T t = T.create();
  string dir = caseDir(cli);
  t.isTrue(cli.mkdir(dir, true).wait().ok(), "cannot make " + dir);
  string path = dir + "/readable";
  t.isTrue(cli.writeFile(path, "alpha beta\n".toBytes()).wait().ok(), "wrote a readable file");

  // **The control comes first**, and it is not decoration: it says the file is there and `cat` works,
  // so the refusal below is about the grant and not about the fixture or the applet.
  Ran granted = runGranted(core, cli, dir, string[]("cat", path), Grants.everything());
  t.eqI32(granted.status, 0, "cat with the grant: " + granted.err);
  t.eqStr(granted.out, "alpha beta\n", "and it reads the file");

  Ran denied = runGranted(core, cli, dir, string[]("cat", path), Grants.nothing());
  t.eqI32(denied.status, 1, "cat without the read grant fails");
  t.isTrue(denied.err.indexOf("Not granted to this application") >= 0, denied.err);
  t.eqI32(denied.outBytes.len(), 0, "and writes nothing: " + denied.out);

  cli.remove(dir, true).wait();
  return t.report();
}

/**
 * `rm -f` forgives a file that is already gone, not a filesystem it may not touch.
 *
 * The three cases needing a *mode* are `unreadable_test.wac`. This is the grant: a program built to
 * read and not to write is refused, and `-f` does not swallow it — which is the whole distinction
 * GitHub wac-mono#17 was about, where `remove` answered a bool and "no such file" and "not permitted"
 * arrived identically.
 */
export string test_rm_f_without_the_write_grant_is_a_denial(Core core, Cli cli) {
  T t = T.create();
  string dir = caseDir(cli);
  t.isTrue(cli.mkdir(dir, true).wait().ok(), "cannot make " + dir);
  string doomed = dir + "/doomed";
  t.isTrue(cli.writeFile(doomed, "x".toBytes()).wait().ok(), "wrote the file");

  Grants readOnly = Grants(true, false, true);
  Ran denied = runGranted(core, cli, dir, string[]("rm", "-f", doomed), readOnly);
  t.eqI32(denied.status, 1, "no write grant is denial, not silence: " + denied.err);
  t.isTrue(cli.stat(doomed).wait().exists, "and the file is still there");

  // With the grant it goes, so the refusal above is the grant talking and not `rm` being broken.
  t.eqI32(runGranted(core, cli, dir, string[]("rm", "-f", doomed), Grants.everything()).status, 0,
          "and with the grant it is removed");
  t.isFalse(cli.stat(doomed).wait().exists, "the file is gone");

  cli.remove(dir, true).wait();
  return t.report();
}
