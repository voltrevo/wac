// What an applet says when it was not granted what it needs.
//
//     wac test --allow-read --allow-write packages/box/test/wac/grants_test.wac
//
// From `box.test.ts`, where five tests each built and spawned a real executable for one reason: an
// in-process run could not be given *fewer* grants than the test process holds.
//
// It can now, because an applet is handed a `Files` rather than reaching for the host's: `readOnly`
// refuses every change, `writeOnly` every look, and the two together leave nothing. Each refusal is a
// `NotGranted`, which is the fault a host answers an ungranted program with — so an applet takes the
// same branch here as it does when a real host refuses it.
//
// **The sentence is the claim, not the status.** `packages/fs`'s `reason` words every `NotGranted` as a
// host words one — "Not granted to this application" — whatever the narrowing's own message said, so
// an applet refused here prints what it prints when a real host refuses it. Every refusal in `box` is
// checked by its words.
//
// **Which is why one spawned test stays in `box.test.ts` and must not be tidied away.** Everything here
// compares an applet against a sentence `reason` hard-codes. "a file still needs the grant, and says
// so" compares it against the sentence a real host produces. Without it this file is an oracle
// agreeing with itself: `reason` could drift from all four hosts and every assertion below would stay
// green.

import { Env, Files, Sys } from "std";
import { T } from "../../../wactest/src/assert.wac";
import { Kept } from "../../../platform/src/stream.wac";
import { bytesInput } from "../../../fs/src/trees.wac";
import { dispatch } from "../../src/box.wac";
import { parseList } from "../../src/lib/args.wac";
import { Ran } from "./replay.wac";
import { flatten } from "core";

string caseDir(Env env) { return "\{flatten(env.cwd().wait()).unwrap()}/.cache/wac-grants"; }

/** One applet, standing in `dir`, handed exactly `fs` and nothing more. */
async Ran runGranted(Sys sys, Files fs, string dir, string[] argv) {
  Kept out = Kept.create();
  Kept err = Kept.create();
  i32 status = await dispatch(argv, bytesInput(u8[]()), err.out, out.out, sys.clock(), sys.random(), sys.env(),
                              fs.relativeTo(dir), sys.net(), sys.procs(), () => false,
                              parseList(argv, 1, argv[0]), argv[0]);
  return Ran(string.fromBytes(out.bytes()), string.fromBytes(err.bytes()), status, out.bytes());
}

/**
 * A read the program was never granted says why, and fails.
 *
 * The message shape is the point rather than the status: a denied read must say *why*, which a
 * bool-returning `openInput` could not, and that is why a refusal is a fault carrying a sentence.
 */
export async string test_a_denied_read_says_why(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  T t = T.create();
  string dir = caseDir(env);
  t.isTrue(flatten(fs.mkdir(dir, true).wait()).isOk(), "cannot make \{dir}");
  string path = "\{dir}/readable";
  t.isTrue(flatten(fs.writeFile(path, "alpha beta\n".toBytes()).wait()).isOk(), "wrote a readable file");

  // **The control comes first**, and it is not decoration: it says the file is there and `cat` works,
  // so the refusal below is about the grant and not about the fixture or the applet.
  Ran granted = await runGranted(sys, fs, dir, ["cat", path]);
  t.eqI32(granted.status, 0, "cat with the grant: \{granted.err}");
  t.eqStr(granted.out, "alpha beta\n", "and it reads the file");

  Ran denied = await runGranted(sys, fs.readOnly().writeOnly(), dir, ["cat", path]);
  t.eqI32(denied.status, 1, "cat without the read grant fails");
  t.isTrue(denied.err.indexOf("Not granted to this application") >= 0, denied.err);
  t.eqI32(denied.outBytes.len(), 0, "and writes nothing: \{denied.out}");

  fs.remove(dir, true).wait();
  return t.report();
}

/**
 * `rm -f` forgives a file that is already gone, not a filesystem it may not touch.
 *
 * The three cases needing a *mode* are `unreadable_test.wac`. This is the grant: a program built to
 * read and not to write is refused, and `-f` does not swallow it — which is the whole distinction
 * GitHub wac-mono#17 was about, where `remove` answered a bool and "no such file" and "not permitted"
 * arrived identically.
 */
export async string test_rm_f_without_the_write_grant_is_a_denial(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  T t = T.create();
  string dir = caseDir(env);
  t.isTrue(flatten(fs.mkdir(dir, true).wait()).isOk(), "cannot make \{dir}");
  string doomed = "\{dir}/doomed";
  t.isTrue(flatten(fs.writeFile(doomed, "x".toBytes()).wait()).isOk(), "wrote the file");

  Ran denied = await runGranted(sys, fs.readOnly(), dir, ["rm", "-f", doomed]);
  t.eqI32(denied.status, 1, "no write grant is denial, not silence: \{denied.err}");
  t.isTrue(flatten(fs.stat(doomed).wait()).isOk(), "and the file is still there");

  // With the grant it goes, so the refusal above is the grant talking and not `rm` being broken.
  t.eqI32((await runGranted(sys, fs, dir, ["rm", "-f", doomed])).status, 0,
          "and with the grant it is removed");
  t.isFalse(flatten(fs.stat(doomed).wait()).isOk(), "the file is gone");

  fs.remove(dir, true).wait();
  return t.report();
}

/**
 * Without the write grant, none of the tier happens — whatever the arguments say.
 *
 * `mkdir` rather than `cp` on purpose: it is the shortest path to the claim. `cp` writing beside its
 * target and renaming is three operations, and a test that used it would be asking whether the *first*
 * one is refused while looking like it asks about all three.
 *
 * The second assertion is the one worth having. A refusal that returned 1 and made the directory
 * anyway would pass on the status alone, and that is the failure mode a capability check has: the
 * answer is right and the effect happened.
 */
export async string test_without_the_write_grant_nothing_is_made(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  T t = T.create();
  string dir = caseDir(env);
  t.isTrue(flatten(fs.mkdir(dir, true).wait()).isOk(), "cannot make \{dir}");
  string wanted = "\{dir}/denied";

  Ran denied = await runGranted(sys, fs.readOnly(), dir, ["mkdir", wanted]);
  t.eqI32(denied.status, 1, "mkdir without the grant should fail: \{denied.err}");
  t.isFalse(flatten(fs.stat(wanted).wait()).isOk(), "and should make nothing");

  // The control: the same command with the grant does make it, so the refusal is the grant talking.
  t.eqI32((await runGranted(sys, fs, dir, ["mkdir", wanted])).status, 0,
          "and with the grant it is made");
  t.isTrue(flatten(fs.stat(wanted).wait()).isOk(), "the directory is there");

  fs.remove(dir, true).wait();
  return t.report();
}
