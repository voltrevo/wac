// The one thing about the three backings that needs three processes: that an image outlives one.
//
// `backings_test.wac` beside this one is the differential: all 946 scripts through three `Fs` values
// inside one process, with the same three levellings `tools/wac/corpusbackings.wac` applies, so the gate
// covers the whole of design/0001 D7 rather than the 4% the spawning version reached. This file is
// the part of `backings.test.ts` that could not join it.
//
// **What stays here is the canary, because it is the one claim that is about *processes*.** If
// `imaged` were quietly in-memory too, every comparison in the wac differential would still pass —
// three identical things agree perfectly — so something has to establish that the image is a
// different kind of thing from the memory it agrees with. That is: a second process finds what the
// first wrote, and a sealed session does not.
//
// ## Host-side until 2026-08-18, `issues/system/0161`
//
// `buildApp` becomes `wac build … -o stem`, which writes `stem.wasm` and `stem.json`, and a run is
// `wac stem.wasm args…`. Three builds at about six seconds each is most of this file's time.
//
// **`Cli.exec` has no working directory**, which the TypeScript used for the host-mount case. The
// script says `cd` instead — it is a shell, and the directory is the only thing that case needs from
// the parent. The two sealed cases never look at one.
//
// test-lane: heavy — 1s, three builds and four processes, measured 2026-08-29

import { T } from "../../../wactest/src/assert.wac";
import { contains } from "../../../wactest/src/strings.wac";
import { Exec, execReason, ChildEnv, Env, Files, Launch, Procs, Sys } from "std";
import { madeDir } from "../../../wactest/src/host.wac";
import { flatten } from "core";

/** `wac`, beside the working directory rather than on a `PATH` `Cli.exec` does not pass. */
string binary(Env env) { return "\{flatten(env.cwd().wait()).unwrap()}/native/v8/target/release/wac"; }

/** Build one box binary, and say why not if it did not build. */
bool build(T t, Env env, Procs procs, string entry, string stem, string[] grants) {
  string[] argv = string[].filled(grants.len() + 4, "");
  argv[0] = "build";
  argv[1] = entry;
  argv[2] = "-o";
  argv[3] = stem;
  for (i32 i = 0; i < grants.len(); i++) { argv[i + 4] = grants[i]; }
  auto rRan = flatten(procs.exec(binary(env), argv, u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  t.isTrue((r is not null) && r!.status == 0,
           "built \{entry} — \{(r is null ? "\{rRan.err()!}" : execReason(r!))}");
  return (r is not null) && r!.status == 0;
}

/** Run a built box shell over a script, and hand back what it said. */
Exec run(Env env, Procs procs, string stem, string[] extra, string script) {
  string[] argv = string[].filled(extra.len() + 3, "");
  argv[0] = "\{stem}.wasm";
  for (i32 i = 0; i < extra.len(); i++) { argv[i + 1] = extra[i]; }
  argv[extra.len() + 1] = "-c";
  argv[extra.len() + 2] = "mkdir -p /tmp; \{script}";
  return flatten(procs.exec(binary(env), argv, u8[](), ChildEnv.inherited(), Launch.plain()).wait()).unwrap();
}

string show(Exec r) {
  return "\"\{string.fromBytes(r.stdout)}\{string.fromBytes(r.stderr)}\" (" +
         "\{r.status})";
}

export string test_the_image_is_a_different_thing_from_the_memory_it_agrees_with(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = "\{flatten(env.cwd().wait()).unwrap()}/.cache/backings";
  string whyDir1 = madeDir(fs, dir);
  t.isTrue(whyDir1 == "", whyDir1);

  string sealed = "\{dir}/sealedsh";
  string imaged = "\{dir}/imaged";
  string host = "\{dir}/hostsh";
  if (!build(t, env, procs, "packages/box/src/bin/sealedsh.wac", sealed, string[].filled(0, ""))) {
    return t.report();
  }
  if (!build(t, env, procs, "packages/box/src/bin/imaged.wac", imaged, ["--allow-read", "--allow-write"])) { return t.report(); }
  if (!build(t, env, procs, "packages/box/src/bin/sh.wac", host, ["--allow-read", "--allow-write", "--allow-env"])) { return t.report(); }

  // **What makes an image an image** is that a second process finds what the first wrote.
  string image = "\{dir}/persist.img";
  fs.remove(image, false).wait();   // a leftover from an earlier run would make this pass for free
  Exec first = run(env, procs, imaged, [image], "echo kept > /keep; ls /");
  t.isTrue(contains(string.fromBytes(first.stdout), "keep"), show(first));
  Exec second = run(env, procs, imaged, [image], "cat /keep");
  t.eqStr(string.fromBytes(second.stdout), "kept\n",
          "an image did not survive its own process: \{show(second)}");

  // **And what makes a memory session memory** is that it does not.
  Exec forgot = run(env, procs, sealed, string[].filled(0, ""), "cat /keep; echo status=$?");
  t.eqStr(string.fromBytes(forgot.stdout), "status=1\n",
          "a sealed session remembered something: \{show(forgot)}");

  // The host mount is a third thing again: what it wrote is on the real disk, where the other two
  // cannot see it and this test can.
  string work = "\{dir}/persist";
  string whyDir2 = madeDir(fs, work);
  t.isTrue(whyDir2 == "", whyDir2);
  fs.remove("\{work}/here", false).wait();
  run(env, procs, host, string[].filled(0, ""), "cd \{work}; echo ondisk > here");
  auto wroteRead = flatten(fs.readFile("\{work}/here").wait());
  u8[]? wrote = wroteRead.ok();
  t.isTrue((wrote is not null), "the host mount wrote nothing to the real disk — \{wroteRead.isErr() ? "\{wroteRead.err()!}" : ""}");
  if (wrote is null) { return t.report(); }
  t.eqStr(string.fromBytes(wrote!), "ondisk\n", "the host mount wrote the wrong thing");
  return t.report();
}
