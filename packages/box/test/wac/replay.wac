// Reading a captured sweep, and running one case in this process.
//
// Shared by the replays — `behaviour_test.wac`, `operands_test.wac` — because the machinery is the same
// for all of them and only the case list and the assertions differ. It is not a test file: it exports no
// `test*`, and `wac test` finds tests by the `_test.wac` suffix, so it is never run as one.
//
// The format is length-prefixed on purpose. A case contains spaces, quotes and newlines, so any delimiter
// would need escaping and any escaping would need a second implementation to undo it.
//
//     wac-applet-vectors 1
//     bash: GNU bash, version 5.2.21(1)-release (aarch64-unknown-linux-gnu)
//     coreutils: cp (GNU coreutils) 9.4
//     locale: LC_ALL=C
//     count: 104
//     S <n>\n<n bytes>\n     the case, as a shell script
//     X <status>\n           the status the real tool left
//     O <n>\n<n bytes>\n     what it wrote to standard output
//     E <n>\n<n bytes>\n     and to standard error
//
// The header is not decoration: an expectation is only as portable as the environment it was taken in,
// and when a replay disagrees the first question is whether *we* changed or the tools did.

import { Cli, Core, Exec, FileResult } from "std/platform.wac";
import { Frame, childCli, childCore } from "../../../platform/src/frame.wac";
import { Shell } from "../../../sh/src/exec.wac";
import { shellMain } from "../../../sh/src/entry.wac";
import { boxNames, boxRun } from "../../src/shrun.wac";
import { UNKNOWN, dispatch } from "../../src/box.wac";
import { parseList } from "../../src/lib/args.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { Fs, mountSystem } from "../../../fs/src/fs.wac";
import { Booted, boot, save } from "../../../fs/src/image.wac";
import { Vec } from "core/vec.wac";
import { Fixture } from "./cases.wac";

/** What one shell said. */
export struct Ran {
  string out;
  string err;
  i32 status;
  /**
   * The same standard output, unconverted.
   *
   * `/dev/zero` and `/dev/urandom` are read as bytes and a string is the wrong shape for them: a NUL is
   * not a terminator here but it is easy to treat as one, and random bytes are not text at all.
   */
  u8[] outBytes;
}

/** One captured case: what it was, and what the real tools answered. */
export struct Vector {
  string script;
  i32 status;
  string out;
  string err;
}

export struct Loaded {
  Vector[] items;
  i32 n;
  /** The tools' own identity, as recorded when these were captured. */
  string oracle;
  /** Empty when the file parsed; otherwise why it did not. */
  string error;
}

/**
 * One case through a shell that has box's applets, inside this process.
 *
 * `shellMain`'s `first` is an index into the arguments and a frame's `argv` starts with the child's own
 * name, so the shell's own arguments start at 1 — passing 0 makes it read `sh` as a script to open.
 */
export Ran runCase(Core core, Cli cli, string dir, string script) {
  Frame f = Frame.of(string[]("sh", "-c", script), u8[0](), dir, false);
  Core c = childCore(f, core);
  Cli l = childCli(f, cli);
  Shell sh = Shell.create(c, l);
  sh.external = boxRun;
  sh.externalNames = boxNames;
  i32 status = shellMain(c, l, sh, 1);
  return Ran(string.fromBytes(f.out.bytes()), string.fromBytes(f.err.bytes()), status, f.out.bytes());
}

// ── Helpers the differential tests share ──────────────────────────────────────────────────────────
//
// These lived in four files with two copies each until 2026-08-31. They are here rather than there
// because a second copy of a comparison is a comparison that drifts, and the two copies of `splitOn`
// had already stopped being the same function: one advanced its cursor by **one** after a match, the
// other by the separator's length. They agree on every separator that cannot overlap itself and differ
// only on one that can, which no caller passes — so this is settling the semantics rather than fixing
// a live bug. `helpers_test.wac` pins both halves of that.

/** The string without its trailing newlines. */
export string trimEnd(string s) {
  string out = s;
  while (out.len() > 0 && out.slice(out.len() - 1, out.len()) == "\n") {
    out = out.slice(0, out.len() - 1);
  }
  return out;
}

/** `text` cut at every occurrence of `sep`. An empty input is no fields rather than one empty one. */
export string[] splitOn(string text, string sep) {
  if (text == "") { return string[0](); }
  i32 n = 1;
  i32 i = 0;
  while (i + sep.len() <= text.len()) {
    if (text.slice(i, i + sep.len()) == sep) { n++; i = i + sep.len(); } else { i++; }
  }
  string[] out = string[n](fill: "");
  i32 at = 0;
  i32 from = 0;
  i32 k = 0;
  while (k + sep.len() <= text.len()) {
    if (text.slice(k, k + sep.len()) == sep) {
      out[at] = text.slice(from, k);
      at++;
      k = k + sep.len();
      from = k;
    } else {
      k++;
    }
  }
  out[at] = text.slice(from, text.len());
  return out;
}

/**
 * Whether two byte arrays differ, and where — the empty string when they do not.
 *
 * A length and a first difference rather than a bool, because "the round trip failed" is not a message
 * anybody can act on and these compare hundreds of kilobytes.
 */
export string differs(u8[] got, u8[] want) {
  if (got.len() != want.len()) {
    return "length " + itoa(got.len()) + " want " + itoa(want.len());
  }
  for (i32 i = 0; i < got.len(); i++) {
    if (got[i] != want[i]) {
      return "byte " + itoa(i) + " is " + itoa(got[i]) + " want " + itoa(want[i]);
    }
  }
  return "";
}

/**
 * A real system tool's standard output, with **this process's environment**.
 *
 * Inherited rather than pinned on purpose: `LC_ALL=C` on an oracle removes the question along with the
 * variable, which is how `issues/system/0143` survived for as long as it did.
 */
export string realOut(Cli cli, string prog, string[] args) {
  Exec r = cli.exec(prog, args, u8[0]()).wait();
  return string.fromBytes(r.stdout);
}

/**
 * One applet, driven straight at `dispatch` with no shell in between.
 *
 * **This is how a wac test reaches an applet that a script cannot.** `runCase` runs a `Shell`, and
 * five of the names are shadowed — `echo ls mkdir rm chmod` are builtins as well as applets, the
 * builtin wins, and `packages/sh` has no `command` to bypass one with. So a script asking `ls -a` asks
 * the builtin, which accepts it, where box's applet refuses it. Everything about flags, refusals and
 * usage for those five is invisible from the vector route and visible from here.
 *
 * `argv` is the whole command line, applet name first, exactly as `box` receives it: `parseList` is
 * handed `first = 1` for the same reason `parseArgs` hands `parseFrom` a 1.
 *
 * **The status is `dispatch`'s, not the program's.** An unknown name answers `UNKNOWN` (-1) here,
 * where `box` answers 2 — `main` is the half that turns "no such applet" into a usage error, and it
 * reads argv from the process, so it is not reachable in-process. Compare against `UNKNOWN` rather
 * than against a number.
 */
export Ran runApplet(Core core, Cli cli, string dir, string[] argv) {
  return runAppletIn(core, cli, dir, argv, u8[0]());
}

/**
 * The same, with something on standard input.
 *
 * `tr` is the applet that needs it and the reason is not incidental: it takes no file operand, and
 * GNU's does not either — ours stopped pretending to in wac-mono 0098. So the only way to hand it
 * input is the way a user would.
 */
export Ran runAppletIn(Core core, Cli cli, string dir, string[] argv, u8[] stdin) {
  Frame f = Frame.of(argv, stdin, dir, false);
  Core c = childCore(f, core);
  Cli l = childCli(f, cli);
  i32 status = dispatch(c, l, Fs.onHost(l, 0), parseList(argv, 1, argv[0]), argv[0]);
  return Ran(string.fromBytes(f.out.bytes()), string.fromBytes(f.err.bytes()), status, f.out.bytes());
}

/**
 * A sealed session: an in-memory filesystem with `/tmp`, `/dev` and `/proc` mounted over it.
 *
 * Wired the way `bin/sealedsh.wac` wires one, including `/bin` from the applet names, so what differs
 * from a host run is the backing and nothing else. `mountSystem` takes `core.randomBytes` — a host
 * function rather than a permission, which is why a session with no filesystem grants still has a
 * working `/dev/urandom`, and why a wac test can build one of these at all.
 */
export Ran runSealed(Core core, Cli cli, string script) {
  Fs fs = Fs.inMemory(0);
  fs.mkdir("/tmp", true);
  // **The whole command line, as `bin/sealedsh.wac` builds it**: its own name and then its arguments.
  // `/proc/self/cmdline` and `ps`'s CMD column both read this, so a session that recorded only its name
  // would answer `sealedsh` where the built program answers `sealedsh -c ps`.
  Vec<string> argv = Vec.create();
  argv.push("sealedsh");
  argv.push("-c");
  argv.push(script);
  mountSystem(fs, core.randomBytes, argv, Vec.fromArray(boxNames()));

  // **Named as the built program names itself.** `ps` prints the session's own argv, so a frame calling
  // itself `sh` would make this session answer `sh -c ps` where `bin/sealedsh.wac` answers
  // `sealedsh -c ps` — a difference with no cause but the harness.
  Frame f = Frame.of(string[]("sealedsh", "-c", script), u8[0](), "/", false);
  Core c = childCore(f, core);
  Cli l = childCli(f, cli);
  Shell sh = Shell.onFs(c, l, fs);
  sh.cwd = "/";
  sh.external = boxRun;
  sh.externalNames = boxNames;
  // **Not spawnable**, unlike `bin/sealedsh.wac`. A spawned stage re-enters the program's own `main`, and
  // a test file's `main` is not a shell that will stop — `yes | /bin/head -2` never returns. The claims
  // that are about that route keep a built program and a real process; `issues/system/0193` lists them.
  i32 status = shellMain(c, l, sh, 1);
  return Ran(string.fromBytes(f.out.bytes()), string.fromBytes(f.err.bytes()), status, f.out.bytes());
}

/**
 * One script through a session whose filesystem is a **file**, as `bin/imaged.wac` runs one.
 *
 * Boot, run, save — in that order and unconditionally, including when the script fails, because a shell
 * that only saved on success would lose the work of the session whose work is most worth keeping. A path
 * that does not exist yet is an empty world rather than an error, so the first run of a new image needs no
 * separate step.
 *
 * The medium is the file, not the process: what "the next session reads" means is that these bytes went to
 * disk and came back. The claim that needs a second *process* — that an image outlives one — stays in
 * `backingsprocess_test.wac`, which spawns.
 */
export Ran runImaged(Core core, Cli cli, string path, string script) {
  Vec<string> argv = Vec.create();
  argv.push("imaged");
  argv.push(path);
  argv.push("-c");
  argv.push(script);
  Frame f = Frame.of(string[]("imaged", path, "-c", script), u8[0](), "/", false);
  Core c = childCore(f, core);
  Cli l = childCli(f, cli);
  Booted booted = boot(c, l, path, argv, Vec.fromArray(boxNames()));
  if (!booted.ok) {
    c.warn("imaged: " + path + ": " + booted.error);
    return Ran("", string.fromBytes(f.err.bytes()), 1, u8[0]());
  }
  Shell sh = Shell.onFs(c, l, booted.fs);
  sh.cwd = "/";
  sh.external = boxRun;
  sh.externalNames = boxNames;
  // **Two, not one.** `shellMain`'s `first` is an index into the arguments, and this program takes one of
  // its own before the shell's: argv is `imaged <image> -c <script>`, so the shell starts after the image
  // path. Passing 1 makes it read the image file as a script to open, and every session answers 127.
  i32 status = shellMain(c, l, sh, 2);
  if (!save(c, l, "imaged", path, sh.fs)) { status = 1; }
  return Ran(string.fromBytes(f.out.bytes()), string.fromBytes(f.err.bytes()), status, f.out.bytes());
}

/**
 * Every fixture written fresh into `dir`, which is emptied first.
 *
 * Fresh per case, because several cases mutate — `split` writes files, `rm -f part*` takes them away —
 * and a case measured against a world the previous one changed is a difference that reproduces for a
 * reason that has nothing to do with the applet.
 */
export bool layFixtures(Cli cli, string dir, Fixture[] fs) {
  cli.remove(dir, true).wait();
  if (!cli.mkdir(dir, true).wait().ok()) { return false; }
  for (i32 i = 0; i < fs.len(); i++) {
    if (fs[i].name == "") { continue; }
    // A directory is a fixture too: one sweep needs an operand whose *read* refuses rather than whose
    // open fails, which is a different code path and a different message in every tool.
    if (fs[i].isDir) {
      if (!cli.mkdir(dir + "/" + fs[i].name, true).wait().ok()) { return false; }
      continue;
    }
    if (!cli.writeFile(dir + "/" + fs[i].name, fs[i].bytes).wait().ok()) { return false; }
  }
  return true;
}

/**
 * Every vector in `path`, or an `error` saying why not.
 *
 * A missing file is an error rather than an empty list: a replay over zero vectors passes, which is the
 * shape this repository keeps finding — a check that stopped checking and said nothing.
 */
export Loaded load(Cli cli, string path) {
  FileResult r = cli.readFile(path).wait();
  if (!r.ok) {
    return Loaded(Vector[0](), 0, "",
                  "cannot read " + path + " — run `wac run --allow-read --allow-write --allow-run " +
                  "tools/wac/appletvectors.wac` to write it");
  }
  u8[] b = r.bytes;
  Line l = lineAt(b, 0);
  if (l.text != "wac-applet-vectors 1") {
    return Loaded(Vector[0](), 0, "", "not an applet vectors file: " + l.text);
  }
  string oracle = "";
  i32 at = l.next;
  i32 count = 0 - 1;
  for (i32 guard = 0; guard < 8 && count < 0; guard++) {
    Line h = lineAt(b, at);
    at = h.next;
    if (h.text.len() > 11 && h.text.slice(0, 11) == "coreutils: ") {
      oracle = h.text.slice(11, h.text.len());
    }
    count = numberIn(h.text, "count:");
  }
  if (count < 0) { return Loaded(Vector[0](), 0, oracle, "no count in the header"); }

  Vector[] items = Vector[count](fill: Vector("", 0, "", ""));
  i32 n = 0;
  for (i32 i = 0; i < count; i++) {
    Line sl = lineAt(b, at);
    i32 slen = numberIn(sl.text, "S");
    if (slen < 0) { return Loaded(items, n, oracle, "record " + itoa(i) + " has no case"); }
    string script = string.fromBytes(sliceOf(b, sl.next, sl.next + slen));
    at = sl.next + slen + 1;

    Line xl = lineAt(b, at);
    i32 status = numberIn(xl.text, "X");
    at = xl.next;

    Line ol = lineAt(b, at);
    i32 olen = numberIn(ol.text, "O");
    if (olen < 0) { return Loaded(items, n, oracle, "record " + itoa(i) + " has no output"); }
    string out = string.fromBytes(sliceOf(b, ol.next, ol.next + olen));
    at = ol.next + olen + 1;

    Line el = lineAt(b, at);
    i32 elen = numberIn(el.text, "E");
    string err = elen < 0 ? "" : string.fromBytes(sliceOf(b, el.next, el.next + elen));
    at = elen < 0 ? el.next : el.next + elen + 1;

    items[n] = Vector(script, status, out, err);
    n = n + 1;
  }
  return Loaded(items, n, oracle, "");
}

/** A string with its newlines and tabs visible, capped, so a difference reads on one line. */
export string show(string s) {
  string out = "";
  i32 cap = s.len() > 200 ? 200 : s.len();
  for (i32 i = 0; i < cap; i++) {
    string ch = s.slice(i, i + 1);
    out = out + (ch == "\n" ? "\\n" : ch == "\t" ? "\\t" : ch);
  }
  return "\"" + out + (s.len() > cap ? "…\"" : "\"");
}

/**
 * The shell's own name off the front of a diagnostic, so two shells' messages can be compared.
 *
 * bash prefixes a builtin's failure with `bash: line 1: ` and ours has no line number to give — there is
 * none in a `-c` string that has been through a parser. Applied to both sides, and harmless for the
 * applet messages either way: none of them contains `sh: ` or a `: line N: `.
 */
export string unprefixed(string text) {
  string out = text;
  for (i32 guard = 0; guard < 64; guard++) {
    i32 at = out.indexOf(": line ");
    if (at < 0) { break; }
    i32 end = at + 7;
    while (end < out.len() && isDigit(out.slice(end, end + 1))) { end = end + 1; }
    if (end + 2 > out.len() || out.slice(end, end + 2) != ": ") { break; }
    i32 from = at;
    while (from > 0 && !isSpace(out.slice(from - 1, from))) { from = from - 1; }
    out = out.slice(0, from) + out.slice(end + 2, out.len());
  }
  for (i32 guard = 0; guard < 64; guard++) {
    i32 at = out.indexOf("sh: ");
    if (at < 0) { break; }
    out = out.slice(0, at) + out.slice(at + 4, out.len());
  }
  return out;
}

bool isDigit(string ch) {
  u8[] b = ch.toBytes();
  if (b.len() != 1) { return false; }
  i32 c = b[0];
  return c >= '0' && c <= '9';
}

/** Trailing whitespace off both ends, for the comparisons that are about a sentence. */
export string trimmed(string s) {
  i32 from = 0;
  i32 to = s.len();
  while (from < to && isSpace(s.slice(from, from + 1))) { from = from + 1; }
  while (to > from && isSpace(s.slice(to - 1, to))) { to = to - 1; }
  return s.slice(from, to);
}

bool isSpace(string ch) { return ch == " " || ch == "\n" || ch == "\t" || ch == "\r"; }

struct Line {
  string text;
  i32 next;
}

Line lineAt(u8[] b, i32 at) {
  i32 end = at;
  while (end < b.len() && b[end] != '\n') { end = end + 1; }
  return Line(string.fromBytes(sliceOf(b, at, end)), end + 1);
}

u8[] sliceOf(u8[] b, i32 from, i32 to) {
  i32 n = to - from;
  if (n <= 0) { return u8[0](); }
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = b[from + i]; }
  return out;
}

/** The number after a tag: `S 21` gives 21, and -1 when the line is not that shape. */
i32 numberIn(string line, string tag) {
  if (line.len() < tag.len() + 1) { return 0 - 1; }
  if (line.slice(0, tag.len()) != tag) { return 0 - 1; }
  string rest = line.slice(tag.len() + 1, line.len());
  if (rest.len() == 0) { return 0 - 1; }
  i32 v = 0;
  for (i32 i = 0; i < rest.len(); i++) {
    u8[] c = rest.slice(i, i + 1).toBytes();
    if (c.len() == 0) { return 0 - 1; }
    i32 d = c[0];
    if (d < '0' || d > '9') { return 0 - 1; }
    v = v * 10 + (d - '0');
  }
  return v;
}
