// One filesystem, three backings, and the same answers — design/0001 D7's own differential, in one process.
//
// D7 says it in as many words: "the same scripts can run against a host mount *and* against an image, and
// any divergence between those two is a VFS bug with a reference answer." The three differ only underneath
// the boundary:
//
//   **memory** `MemoryStore`           — what `bin/sealedsh.wac` builds, with no grants at all
//   **image**  `bootStore`/`saveStore` — the same, read from a file and written back to it
//   **host**   `sys.files()`           — the real disk, which is what `bin/sh.wac` builds
//
// ## This used to spawn, and it used to run forty scripts
//
// `backingsprocess_test.wac` built three binaries and ran `CORPUS.slice(0, 40)` through each: 120 processes at
// 130 ms, 30 s of the box suite. `wac task corpus:backings` ran the other 906, outside the gate, and
// nothing in a gate run said the gate was covering 4% of the differential.
//
// In this process a script costs about a millisecond, so **the whole corpus runs here** — 946 scripts on
// three backings inside one wasm module, in less wall clock than building one of the three binaries took.
// The claim was always about what sits *under* one program, and three `Files` values in one process is that
// claim more directly: the code above the boundary is now literally the same code rather than three builds
// of it.
//
// What cannot move *into this file* is the canary — that an image survives its own *process* and a
// sealed session does not. That one is about processes, so it spawns; it is
// `test/wac/backingsprocess_test.wac` beside this one, which builds the three binaries with `wac
// build` and runs them with `Procs.exec`.
//
// ## Three differences are levelled
//
// `sealedsh` makes `/tmp` and `imaged` does not, so every script runs after `mkdir -p /tmp`; the host shell
// gets an empty directory of its own, or it would see the repository while the other two see nothing; and
// a script naming an absolute path that **exists on this machine** is compared on memory against image
// only, because the host arm would be answering about Linux rather than about a backing. All three
// levellings are shared with `tools/wac/corpusbackings.wac`, which runs the same comparison across three
// real binaries outside the gate; the third is counted and reported rather than quietly applied, and the
// predicate behind it is `packages/sh/test/wac/machinepaths.wac`, which both of them import.

import { Clock, Env, Files, MemoryStore, Sys } from "std";
import { flatten } from "core";
import { Kept } from "../../../platform/src/stream.wac";
import { bytesInput } from "../../../fs/src/trees.wac";
import { ProcTable } from "../../../fs/src/proc.wac";
import { bootStore, saveStore } from "../../../fs/src/image.wac";
import { Shell } from "../../../sh/src/exec.wac";
import { shellMain } from "../../../sh/src/entry.wac";
import { wireBox } from "../../src/shrun.wac";
// **The memory filesystem and the in-process shell are `memory.wac`**, shared with
// `sealedapplets_test.wac`: one definition of what `sealedsh` builds, two files measuring different
// things on it.
import { Ran, memoryFs, runOn } from "./memory.wac";
import { T } from "../../../wactest/src/assert.wac";
import { corpus } from "../../../sh/test/wac/corpus.wac";
import { reachesTheMachine } from "../../../sh/test/wac/machinepaths.wac";
import { madeDir } from "../../../wactest/src/host.wac";


/** The same, on the real disk, standing in `cwd`. */
async Ran runHost(Sys sys, string cwd, string script) {
  Kept out = Kept.create();
  Kept err = Kept.create();
  Shell sh = Shell.of(bytesInput(u8[]()), out.out, err.out, sys.clock(), sys.env(), sys.net(), sys.procs(),
                      sys.files(), ProcTable.create(), cwd, true);
  wireBox(sh, sys.random());
  i32 status = await shellMain(["sh", "-c", script], sh, 1);
  return Ran(string.fromBytes(out.bytes()), string.fromBytes(err.bytes()), status);
}


/**
 * An image backing, read from `path`.
 *
 * **`bootStore` on a path that does not exist is an empty world**, deliberately, so that a first run needs
 * no separate step. That makes booting a name nothing has written indistinguishable from a fresh store, and a
 * differential whose second arm is secretly its first arm agrees with itself perfectly. So the file is
 * seeded by `seedImage` first, and every boot here parses real image bytes.
 */
async MemoryStore? imageStore(Clock clock, Files fs, string path) {
  return (await bootStore(fs, clock, path)).ok();
}

/** Write an empty world to `path`, so the boots that follow are reads of a file rather than of nothing. */
async bool seedImage(Clock clock, Files fs, string path) {
  return (await saveStore(fs, MemoryStore.create(clock), path)).isOk();
}

string workRoot(Env env) { return "\{flatten(env.cwd().wait()).unwrap()}/.cache/wac-backings"; }

export async string test_the_corpus_answers_the_same_on_memory_an_image_and_a_host_mount(Sys sys) {
  Clock clock = sys.clock();
  Env env = sys.env();
  Files fs = sys.files();
  T t = T.create();
  string[] scripts = corpus();
  string root = workRoot(env);
  string whyDir1 = madeDir(fs, root);
  t.isTrue(whyDir1 == "", whyDir1);
  string seed = "\{root}/seed.wacimg";
  string scratch = "\{root}/saved.wacimg";
  t.isTrue(await seedImage(clock, fs, seed), "could not write the seed image");

  i32 agree = 0;
  i32 machineOnly = 0;
  i32 unsaved = 0;
  i32 differ = 0;
  string detail = "";
  for (i32 i = 0; i < scripts.len(); i++) {
    string script = "mkdir -p /tmp; \{scripts[i]}";
    // A directory of its own per script, because the corpus writes files and reads them back. Absolute,
    // because a relative `cwd` did not resolve — `issues/system/0194`.
    string work = "\{root}/host\{i}";
    string whyDir2 = madeDir(fs, work);
    t.isTrue(whyDir2 == "", whyDir2);

    Ran memory = await runOn(sys, await memoryFs(sys), script);
    MemoryStore? image = await imageStore(clock, fs, seed);
    if (image is null) {
      t.isTrue(false, "the seed image did not boot");
      return t.report();
    }
    Ran onImage = await runOn(sys, image!.asUser("root"), script);
    // And written back, because a session that ran and could not be saved is a session lost: the write
    // half of the image backing is as much of it as the read half.
    if ((await saveStore(fs, image!, scratch)).isErr()) { unsaved = unsaved + 1; }
    Ran onHost = await runHost(sys, work, script);

    fs.remove(work, true).wait();

    if (reachesTheMachine(fs, scripts[i])) {
      machineOnly = machineOnly + 1;
      if (same(memory, onImage)) { agree = agree + 1; continue; }
      differ = differ + 1;
      if (differ <= 5) {
        detail = detail + "\n  \{show(scripts[i])}  (host not compared: names an absolute path)" +
                 "\n    memory \{shape(memory)}\n    image  \{shape(onImage)}";
      }
      continue;
    }
    if (same(memory, onImage) && same(memory, onHost)) { agree = agree + 1; continue; }
    differ = differ + 1;
    if (differ <= 5) {
      detail = detail + "\n  \{show(scripts[i])}" +
               "\n    memory \{shape(memory)}" +
               "\n    image  \{shape(onImage)}" +
               "\n    host   \{shape(onHost)}";
    }
  }
  fs.remove(scratch, false).wait();
  fs.remove(seed, false).wait();

  t.isTrue(scripts.len() > 900, "only \{scripts.len()} scripts — did the corpus load?");
  t.eqI32(unsaved, 0, "\{unsaved} sessions could not be written back to an image");
  // **Said rather than applied.** A differential that silently narrows what it compares reports a better
  // number for checking less, so the two-arm cases are counted and the count is bounded: if levelling
  // starts eating the corpus, this is where it shows.
  t.isTrue(machineOnly < 40,
           "\{machineOnly} scripts were compared on memory and image only, because they name an " +
           "absolute path this machine has — the host arm would answer about Linux, not about a backing");
  t.eqI32(differ, 0, "\{differ} of \{scripts.len()}" +
                     " scripts answer differently by backing (\{agree} agree, " +
                     "\{machineOnly} on two arms)\{detail}");
  return t.report();
}

/**
 * Not "they agree" but "each of them did something".
 *
 * Three shells that refused everything would agree perfectly, so this asks each backing a question about
 * its own filesystem: make a file, read it back, count what is in the directory. The corpus is thin here —
 * it is a *shell language* corpus, and only 43 of its 946 scripts redirect anywhere — so this is what
 * stands behind the run above being about filesystems at all.
 */
export async string test_each_backing_is_alive_and_answers_about_its_own_filesystem(Sys sys) {
  Clock clock = sys.clock();
  Env env = sys.env();
  Files fs = sys.files();
  T t = T.create();
  string script = "mkdir -p /tmp/d; echo hello > /tmp/d/f; cat /tmp/d/f; ls /tmp/d | wc -l";
  string root = workRoot(env);
  string whyDir3 = madeDir(fs, root);
  t.isTrue(whyDir3 == "", whyDir3);

  Ran memory = await runOn(sys, await memoryFs(sys), script);
  t.eqStr(memory.out, "hello\n1\n", "memory: \{shape(memory)}");

  string image = "\{root}/alive.wacimg";
  t.isTrue(await seedImage(clock, fs, image), "could not write the seed image");
  MemoryStore? booted = await imageStore(clock, fs, image);
  t.isTrue(booted is not null, "the image did not boot");
  if (booted is null) { return t.report(); }
  Ran onImage = await runOn(sys, booted!.asUser("root"), script);
  fs.remove(image, false).wait();
  t.eqStr(onImage.out, "hello\n1\n", "image: \{shape(onImage)}");

  string work = "\{root}/alive";
  string whyDir4 = madeDir(fs, work);
  t.isTrue(whyDir4 == "", whyDir4);
  Ran onHost = await runHost(sys, work, script);
  fs.remove(work, true).wait();
  t.eqStr(onHost.out, "hello\n1\n", "host: \{shape(onHost)}");
  return t.report();
}


bool same(Ran a, Ran b) { return a.out == b.out && a.err == b.err && a.status == b.status; }

string shape(Ran r) { return "\{show(r.out + r.err)} (\{r.status})"; }

/** A string with its newlines visible, so a failure reads on one line. */
string show(string s) {
  string out = "";
  for (i32 i = 0; i < s.len(); i++) {
    string ch = s.slice(i, i + 1);
    out = out + (ch == "\n" ? "\\n" : ch);
  }
  return "\"\{out}\"";
}
