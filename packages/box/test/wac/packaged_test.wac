// The applets that are a few lines over a package written in this repo.
//
//     wac test --allow-read --allow-write --allow-run packages/box/test/wac/packaged_test.wac
//
// From `box.test.ts`. These are the point of `box`: each is a thin applet over a package built here
// for TypeScript bindings and reused unchanged as the inside of a program.
//
// **The compression pair is checked in both directions against the system `gzip`**, so neither side
// can be wrong in a way the other cancels out. A round trip through our own code alone would pass with
// a compressor and a decompressor that agree on something nobody else can read.

import { Exec, ChildEnv, Env, Files, Launch, Procs, Sys } from "std";
import { T } from "../../../wactest/src/assert.wac";
import { Buf, flatten } from "core";
import { Ran, differs, runApplet, runAppletIn, trimEnd } from "./replay.wac";

/** Absolute, because a relative frame `cwd` does not resolve — `issues/system/0194`. */
string caseDir(Env env) { return "\{flatten(env.cwd().wait()).unwrap()}/.cache/wac-packaged"; }

/**
 * `gzip` and `gunzip`, each against the system tool in the other direction.
 *
 * `README.md` is the input for the same reason `box.test.ts` used it: a real file with real redundancy
 * in it, rather than a fixture chosen to compress well.
 */
export async string test_gzip_and_the_system_gzip_read_each_others_output(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = caseDir(env);
  t.isTrue(flatten(fs.mkdir(dir, true).wait()).isOk(), "cannot make \{dir}");

  u8[] raw = flatten(fs.readFile("\{flatten(env.cwd().wait()).unwrap()}/README.md").wait()).orElse(u8[]());
  t.isTrue(raw.len() > 0, "README.md is readable and not empty");

  Ran squeezed = await runAppletIn(sys, dir, ["gzip"], raw);
  t.eqI32(squeezed.status, 0, "gzip ran: \{squeezed.err}");
  t.isTrue(squeezed.outBytes.len() < raw.len(), "gzip did not compress: \{squeezed.outBytes.len()}");

  // Ours reads its own.
  t.eqStr(differs((await runAppletIn(sys, dir, ["gunzip"], squeezed.outBytes)).outBytes, raw), "",
          "box could not read its own gzip");

  // **The system one reads ours.** This is the direction that catches a header we invented.
  auto theirsRan = flatten(procs.exec("gunzip", string[](), squeezed.outBytes, ChildEnv.inherited(), Launch.plain()).wait());
  Exec? theirs = theirsRan.ok();
  t.isTrue("\{theirsRan.isErr() ? "\{theirsRan.err()!}" : ""}" == "", "there is a real gunzip: \{theirsRan.isErr() ? "\{theirsRan.err()!}" : ""}");
  t.eqStr(differs(theirs!.stdout, raw), "", "the system gzip could not read box's");

  // **And ours reads the system one's**, which catches a decompressor that only understands what our
  // compressor happens to emit.
  auto sysGzRan = flatten(procs.exec("gzip", ["-c"], raw, ChildEnv.inherited(), Launch.plain()).wait());
  Exec? sysGz = sysGzRan.ok();
  t.isTrue("\{sysGzRan.isErr() ? "\{sysGzRan.err()!}" : ""}" == "", "there is a real gzip: \{sysGzRan.isErr() ? "\{sysGzRan.err()!}" : ""}");
  t.eqStr(differs((await runAppletIn(sys, dir, ["gunzip"], sysGz!.stdout)).outBytes, raw), "",
          "box could not read the system gzip's");

  fs.remove(dir, true).wait();
  return t.report();
}

/**
 * `crc32` against the checksum `gzip` itself carries, computed here.
 *
 * The table is written out rather than imported for the reason `streaming_test.wac` gives: importing
 * the implementation under test would assert that a function equals itself.
 */
export async string test_crc32_matches_an_independently_computed_checksum(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  T t = T.create();
  string dir = caseDir(env);
  t.isTrue(flatten(fs.mkdir(dir, true).wait()).isOk(), "cannot make \{dir}");

  u8[] raw = flatten(fs.readFile("\{flatten(env.cwd().wait()).unwrap()}/README.md").wait()).orElse(u8[]());
  t.isTrue(raw.len() > 0, "README.md is readable and not empty");

  u32[] table = u32[].filled(256, 0);
  for (i32 n = 0; n < 256; n++) {
    u32 c = n as@ u32;
    for (i32 k = 0; k < 8; k++) {
      if ((c & 1) != 0) { c = 0xEDB88320 ^ (c >> 1); } else { c = c >> 1; }
    }
    table[n] = c;
  }
  u32 crc = 0xFFFFFFFF;
  for (i32 i = 0; i < raw.len(); i++) {
    crc = table[((crc ^ (raw[i] as u32)) & 0xFF) as@ i32] ^ (crc >> 8);
  }
  crc = crc ^ 0xFFFFFFFF;
  string want = "";
  for (i32 d = 7; d >= 0; d--) {
    i32 nib = ((crc >> ((d * 4) as@ u32)) & 0xF) as@ i32;
    want = want + "0123456789abcdef".slice(nib, nib + 1);
  }

  // `-` is the name for standard input, which is where this arrived from, and the two spaces are the
  // spelling the applet shares with `sha256sum`.
  Ran got = await runAppletIn(sys, dir, ["crc32"], raw);
  t.eqStr(trimEnd(got.out), "\{want}  -", "crc32 of README.md");

  fs.remove(dir, true).wait();
  return t.report();
}

/**
 * `date` is the clock capability with a package on top: it must be RFC 3339, and it must be *now*.
 *
 * **The oracle is the system `date`, not our own parser.** Reading the answer back with
 * `packages/datetime`'s `parse` would be checking `format` against its own inverse, which agrees with
 * itself whatever the clock said. GNU `date` is asked for the same instant in the same spelling.
 *
 * Taken *around* our call and accepted against either, so a run that straddles a minute boundary is
 * not a flake. That is the whole reason two readings are taken rather than one.
 */
export async string test_date_is_rfc3339_and_is_now(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string dir = caseDir(env);
  t.isTrue(flatten(fs.mkdir(dir, true).wait()).isOk(), "cannot make \{dir}");

  string[] fmt = ["-u", "+%Y-%m-%dT%H:%M"];
  string before = trimEnd(string.fromBytes(flatten(procs.exec("date", fmt, u8[](), ChildEnv.inherited(), Launch.plain()).wait()).unwrap().stdout));
  Ran got = await runApplet(sys, dir, ["date"]);
  string after = trimEnd(string.fromBytes(flatten(procs.exec("date", fmt, u8[](), ChildEnv.inherited(), Launch.plain()).wait()).unwrap().stdout));

  t.eqI32(got.status, 0, "date ran: \{got.err}");
  string mine = trimEnd(got.out);
  t.isTrue(before.len() == 16, "the oracle answered: \{before}");
  t.isTrue(mine.len() >= 20, "RFC 3339 is at least 20 characters: \{mine}");
  t.isTrue(mine.slice(mine.len() - 1, mine.len()) == "Z", "and ends in Z: \{mine}");

  string toTheMinute = mine.slice(0, 16);
  t.isTrue(toTheMinute == before || toTheMinute == after,
           "date is not now: \{mine} between \{before} and \{after}");

  fs.remove(dir, true).wait();
  return t.report();
}

/**
 * Percent-encoding round-trips, including bytes that are not ASCII at all.
 *
 * `%already%20encoded` is on the list because it is the case where encoding is not idempotent: the `%`
 * must itself be encoded, or decoding the result gives back something shorter than what went in.
 */
export async string test_urlencode_round_trips(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  T t = T.create();
  string dir = caseDir(env);
  t.isTrue(flatten(fs.mkdir(dir, true).wait()).isOk(), "cannot make \{dir}");

  Buf uni = Buf.create();
  uni.pushCodepoint(0x00FC); uni.pushAll("n".toBytes()); uni.pushCodepoint(0x00EF);
  uni.pushAll("code ".toBytes()); uni.pushCodepoint(0x2713);          // ✓

  string[] cases = ["a b/c?d=e&f#g", uni.toStr(), "plain", "%already%20encoded"];
  for (i32 i = 0; i < cases.len(); i++) {
    u8[] input = "\{cases[i]}\n".toBytes();
    Ran encoded = await runAppletIn(sys, dir, ["urlencode"], input);
    t.eqI32(encoded.status, 0, "urlencode ran: \{encoded.err}");
    t.isTrue(encoded.out.indexOf(" ") < 0, "a space survived encoding: \{encoded.out}");

    Ran back = await runAppletIn(sys, dir, ["urldecode"], encoded.outBytes);
    t.eqStr(back.out, "\{cases[i]}\n", "\{cases[i]} did not round-trip");
  }

  fs.remove(dir, true).wait();
  return t.report();
}
