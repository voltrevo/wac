// A shell over a filesystem that is not the host's, in this process.
//
// Two files need it and neither should import the other: `backings_test.wac`, where a memory filesystem
// is one of three backings being compared, and `sealedapplets_test.wac`, where it is the world the
// applets are measured on. The same argument as `packages/ssh/test/wac/fixture.wac`. `replay.wac` builds
// its sealed and imaged sessions with `sealedShell` too.
//
// This is what `bin/sealedsh.wac` builds — a `MemoryStore` with the system mounted over it and no grants
// at all — so a script run through it can reach nothing but what it made.

import { Files, MemoryStore, Sys } from "std";
import { Vec, flatten } from "core";
import { Kept } from "../../../platform/src/stream.wac";
import { bytesInput, systemFiles } from "../../../fs/src/trees.wac";
import { ProcTable } from "../../../fs/src/proc.wac";
import { Shell } from "../../../sh/src/exec.wac";
import { shellMain } from "../../../sh/src/entry.wac";
import { boxNames, wireBox } from "../../src/shrun.wac";

/** What a script answered: the two streams and the status. */
export struct Ran {
  string out;
  string err;
  i32 status;
}

/** The store `sealedsh` starts from: memory, acting as root, with a `/tmp`. */
export async Files memoryFs(Sys sys) {
  Files fs = MemoryStore.create(sys.clock()).asUser("root");
  await fs.mkdir("/tmp", true);
  return fs;
}

/**
 * A shell over `root` with the system mounted on it, as `systemShell` builds one for `sealedsh` and
 * `imaged` — but writing to `out` and `err`, and **not spawnable**. A spawned stage re-enters the
 * program's own `main`, and a test file's `main` is not a shell that will stop — `yes | /bin/head -2`
 * never returns. The claims that are about that route keep a built program and a real process;
 * `issues/system/0193` lists them.
 *
 * `cmdline` is the session's first process, which `/proc/self/cmdline` and `ps`'s CMD column read, so
 * it is the program's own name rather than a test's.
 */
export Shell sealedShell(Sys sys, Files root, Vec<string> cmdline, Kept out, Kept err) {
  ProcTable table = ProcTable.create();
  table.current = table.start(0, cmdline, flatten(sys.clock().nowMillis().wait()).orElse(0 as i64));
  Shell sh = Shell.of(bytesInput(u8[]()), out.out, err.out, sys.clock(), sys.env(), sys.net(), sys.procs(),
                      systemFiles(root, sys.random(), table, boxNames()), table, "/", false);
  wireBox(sh, sys.random());
  return sh;
}

/** One script through a sealed session over `root`, inside this process. */
export async Ran runOn(Sys sys, Files root, string script) {
  Kept out = Kept.create();
  Kept err = Kept.create();
  i32 status = await shellMain(["-c", script], sealedShell(sys, root, Vec.fromArray(["sealedsh"]), out, err), 0);
  return Ran(string.fromBytes(out.bytes()), string.fromBytes(err.bytes()), status);
}
