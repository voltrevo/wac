// The BLS12-381 base field and the tower above it, against Python's arbitrary-precision integers.
//
// The oracle is deliberately *not* this implementation. `test/vectors.json` is generated by
// `test/vectors.py` using Python's own big integers and nothing else, so every expected value
// comes from a second implementation of modular arithmetic that shares no code, no
// representation and no author's misreading with the one under test. Montgomery form is the
// exact kind of thing that passes every self-consistency check while being wrong — `a·1 == a`
// and `a + 0 == a` hold for a completely broken reduction — so a self-relation would prove
// almost nothing here.
//
// Regenerate with:  python3 packages/bls/test/vectors.py > packages/bls/test/vectors.json
//
// ## What the move changed
//
// One thing, and it is an improvement. The square-root test has to accept either root, and the
// host-side version computed the other one as `(p − h) mod p` with JavaScript `BigInt` — a third
// arithmetic in a file whose whole argument is about which arithmetic is which. Here it asks
// `fpNeg`, which the `unary` vectors have already checked against Python two tests earlier. Nothing
// is trusted that was not already compared.
//
// Host-side until 2026-08-17. `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { hex } from "../../../wactest/src/oracle.wac";
import { Core, Cli, FileResult } from "../../../platform/src/platform.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { JsonValue, JsonArray, JsonObject } from "../../../json/src/value.wac";
import { parse } from "../../../json/src/json.wac";
import { decoded } from "../../../codec/src/hex.wac";
import { blsModulusConstantsAgree, blsFpStatus, blsFpAdd, blsFpSub, blsFpMul, blsFpNeg,
         blsFpSquare, blsFpOneBytes, blsFpRoundTrip, blsFpMulByOneIsIdentity, blsFpIsZeroBytes,
         blsFpInvert, blsFpSqrt, blsFp2Op, blsFp2Norm, blsFp2OneIsIdempotent, blsFp6Op,
         blsFp12Op, blsFp12InverseIsInverse } from "./probe.wac";

// ── Reading `vectors.json` ────────────────────────────────────────────────────

JsonValue? member(JsonValue v, string key) {
  match (v) {
    case Object(members): { return members.getStr(key); }
    else: { return null; }
  }
}

string text(JsonValue v) {
  match (v) {
    case Str(bytes): { return string.fromBytes(bytes); }
    else: { return ""; }
  }
}

string memberText(JsonValue v, string key) {
  JsonValue? found = member(v, key);
  return found is null ? "" : text(found!);
}

/** Whether the named member is JSON `null` — how "this value has no square root" is written. */
bool memberIsNull(JsonValue v, string key) {
  JsonValue? found = member(v, key);
  if (found is null) { return true; }
  match (found!) {
    case Null: { return true; }
    else: { return false; }
  }
}

JsonArray? memberArray(JsonValue v, string key) {
  JsonValue? found = member(v, key);
  if (found is null) { return null; }
  match (found!) {
    case Array(items): { return items; }
    else: { return null; }
  }
}

/** A member that is an array of hex strings, concatenated — one flat value for the probe. */
u8[] flat(JsonValue v, string key) {
  JsonArray? items = memberArray(v, key);
  if (items is null) { return u8[0](); }
  string out = "";
  for (i32 i = 0; i < items!.len(); i++) { out = out + text(items!.get(i)); }
  return decoded(out);
}

/** An Fp2 member's `c0` and `c1`, concatenated — the form `blsFp2Op` answers in. */
string fp2Text(JsonValue v, string key) {
  JsonValue? found = member(v, key);
  if (found is null) { return ""; }
  return memberText(found!, "c0") + memberText(found!, "c1");
}

/** The whole vectors file, or `null`. */
JsonValue? vectors(T t, Cli cli) {
  FileResult f = cli.readFile("packages/bls/test/vectors.json").wait();
  t.isTrue(f.ok, "vectors.json could not be read: " + f.error);
  if (!f.ok) { return null; }
  JsonValue? doc = parse(f.bytes);
  t.isTrue(!(doc is null), "vectors.json did not parse");
  return doc;
}

// ── Fp ────────────────────────────────────────────────────────────────────────

export string test_addition_subtraction_and_multiplication_agree_with_python(Core core, Cli cli) {
  T t = T.create();
  JsonValue? v = vectors(t, cli);
  if (v is null) { return t.report(); }
  JsonArray? cases = memberArray(v!, "cases");
  t.isTrue(!(cases is null), "no `cases` in vectors.json");
  if (cases is null) { return t.report(); }
  t.isTrue(cases!.len() > 0, "no cases to compare");
  for (i32 i = 0; i < cases!.len(); i++) {
    JsonValue c = cases!.get(i);
    u8[] a = decoded(memberText(c, "a"));
    u8[] b = decoded(memberText(c, "b"));
    string label = memberText(c, "a").slice(0, 12) + "…, " + memberText(c, "b").slice(0, 12) + "…";
    t.eqStr(hex(blsFpAdd(a, b)), memberText(c, "add"), "add(" + label + ")");
    t.eqStr(hex(blsFpSub(a, b)), memberText(c, "sub"), "sub(" + label + ")");
    t.eqStr(hex(blsFpMul(a, b)), memberText(c, "mul"), "mul(" + label + ")");
  }
  return t.report();
}

export string test_negation_and_squaring_agree_with_python(Core core, Cli cli) {
  T t = T.create();
  JsonValue? v = vectors(t, cli);
  if (v is null) { return t.report(); }
  JsonArray? unary = memberArray(v!, "unary");
  if (unary is null) { return t.report(); }
  for (i32 i = 0; i < unary!.len(); i++) {
    JsonValue u = unary!.get(i);
    u8[] a = decoded(memberText(u, "a"));
    string label = memberText(u, "a").slice(0, 12) + "…";
    t.eqStr(hex(blsFpNeg(a)), memberText(u, "neg"), "neg(" + label + ")");
    t.eqStr(hex(blsFpSquare(a)), memberText(u, "sq"), "sq(" + label + ")");
  }
  return t.report();
}

export string test_montgomery_form_does_not_leak_one_is_one_and_every_value_round_trips(
    Core core, Cli cli) {
  T t = T.create();
  // If `fromBytes` and `toBytes` were not exact inverses, most arithmetic would still look
  // self-consistent — this is the check that the form stays inside the field code.
  JsonValue? v = vectors(t, cli);
  if (v is null) { return t.report(); }
  t.eqStr(hex(blsFpOneBytes()), memberText(v!, "one"), "one's encoding");
  JsonArray? unary = memberArray(v!, "unary");
  if (unary is null) { return t.report(); }
  for (i32 i = 0; i < unary!.len(); i++) {
    string a = memberText(unary!.get(i), "a");
    t.eqStr(hex(blsFpRoundTrip(decoded(a))), a, "the round trip changed a value");
    t.isTrue(blsFpMulByOneIsIdentity(decoded(a)), "a·1 != a for " + a);
  }
  t.isTrue(blsFpIsZeroBytes(decoded(memberText(unary!.get(0), "a"))),
           "zero did not read as zero");
  return t.report();
}

export string test_a_value_at_or_above_p_is_refused_not_reduced(Core core, Cli cli) {
  T t = T.create();
  // Accepting a non-canonical encoding means two byte strings for one field element, which is
  // where signature malleability comes from. Every one of these is a valid 48-byte string and
  // an invalid field element.
  JsonValue? v = vectors(t, cli);
  if (v is null) { return t.report(); }
  JsonArray? bad = memberArray(v!, "bad");
  if (bad is null) { return t.report(); }
  u8[] one = decoded(memberText(v!, "one"));
  t.isTrue(bad!.len() > 0, "no bad encodings in the corpus");
  for (i32 i = 0; i < bad!.len(); i++) {
    string b = text(bad!.get(i));
    t.eqI32(blsFpStatus(decoded(b), one), 1, b + " was accepted");
  }
  // And a short or long input is refused rather than padded.
  t.eqI32(blsFpStatus(u8[47](), u8[48]()), 1, "a 47-byte value was accepted");
  return t.report();
}

// ── Inversion, roots, and Fp2 ─────────────────────────────────────────────────

export string test_inversion_agrees_with_python_and_zero_has_none(Core core, Cli cli) {
  T t = T.create();
  JsonValue? v = vectors(t, cli);
  if (v is null) { return t.report(); }
  JsonArray? inv = memberArray(v!, "inv");
  if (inv is null) { return t.report(); }
  for (i32 i = 0; i < inv!.len(); i++) {
    JsonValue c = inv!.get(i);
    t.eqStr(hex(blsFpInvert(decoded(memberText(c, "a")))), memberText(c, "inv"),
            "inv(" + memberText(c, "a").slice(0, 12) + "…)");
  }
  JsonArray? unary = memberArray(v!, "unary");
  if (unary is null) { return t.report(); }
  t.eqI32(blsFpInvert(decoded(memberText(unary!.get(0), "a"))).len(), 0, "zero was inverted");
  return t.report();
}

export string test_square_roots_are_found_where_they_exist_and_refused_where_they_do_not(
    Core core, Cli cli) {
  T t = T.create();
  // Sixteen of thirty-three of these are squares. A routine that returned its exponentiation
  // without checking would pass on those sixteen and hand a non-root back for the rest — and
  // point decompression is fed attacker-controlled bytes, so that is a point off the curve
  // going into a pairing.
  JsonValue? v = vectors(t, cli);
  if (v is null) { return t.report(); }
  JsonArray? roots = memberArray(v!, "roots");
  if (roots is null) { return t.report(); }
  i32 squares = 0;
  for (i32 i = 0; i < roots!.len(); i++) {
    JsonValue r = roots!.get(i);
    string a = memberText(r, "a");
    u8[] got = blsFpSqrt(decoded(a));
    if (memberIsNull(r, "sqrt")) {
      t.eqI32(got.len(), 0, "sqrt(" + a.slice(0, 12) + "…) returned a non-root");
      continue;
    }
    squares = squares + 1;
    // Either root is correct; the vector holds a^((p+1)/4), and the other is its negation — asked
    // of `fpNeg`, which the `unary` vectors already pinned against Python.
    string want = memberText(r, "sqrt");
    t.isTrue(hex(got) == want || hex(blsFpNeg(got)) == want,
             "sqrt(" + a.slice(0, 12) + "…): got " + hex(got) + ", want " + want +
             " (or its negation)");
  }
  t.isTrue(squares > 0, "no squares in the corpus — the vectors are wrong");
  return t.report();
}

export string test_fp2_arithmetic_agrees_with_python(Core core, Cli cli) {
  T t = T.create();
  JsonValue? v = vectors(t, cli);
  if (v is null) { return t.report(); }
  JsonArray? cases = memberArray(v!, "fp2");
  if (cases is null) { return t.report(); }
  string[] names = string[]("add", "sub", "mul", "sq", "conj", "mulByU", "mulByXi");
  for (i32 i = 0; i < cases!.len(); i++) {
    JsonValue c = cases!.get(i);
    JsonValue? a = member(c, "a");
    JsonValue? b = member(c, "b");
    if ((a is null) || (b is null)) { continue; }
    u8[] ac0 = decoded(memberText(a!, "c0"));
    u8[] ac1 = decoded(memberText(a!, "c1"));
    u8[] bc0 = decoded(memberText(b!, "c0"));
    u8[] bc1 = decoded(memberText(b!, "c1"));
    for (i32 op = 0; op < names.len(); op++) {
      t.eqStr(hex(blsFp2Op(ac0, ac1, bc0, bc1, op)), fp2Text(c, names[op]), "fp2 " + names[op]);
    }
    t.eqStr(hex(blsFp2Norm(ac0, ac1)), memberText(c, "norm"), "fp2 norm");
  }
  t.isTrue(blsFp2OneIsIdempotent(), "1·1 != 1 in Fp2");
  return t.report();
}

// ── The tower ─────────────────────────────────────────────────────────────────

export string test_fp6_arithmetic_and_frobenius_agree_with_the_python_tower(Core core, Cli cli) {
  T t = T.create();
  JsonValue? v = vectors(t, cli);
  if (v is null) { return t.report(); }
  JsonArray? cases = memberArray(v!, "fp6");
  if (cases is null) { return t.report(); }
  string[] names = string[]("mul", "sq", "mulByV", "inv", "frob1", "frob2", "frob3");
  for (i32 i = 0; i < cases!.len(); i++) {
    JsonValue c = cases!.get(i);
    u8[] a = flat(c, "a");
    u8[] b = flat(c, "b");
    for (i32 op = 0; op < names.len(); op++) {
      t.eqStr(hex(blsFp6Op(a, b, op)), hex(flat(c, names[op])), "fp6 " + names[op]);
    }
  }
  return t.report();
}

export string test_fp12_arithmetic_and_frobenius_agree_with_the_python_tower(Core core, Cli cli) {
  T t = T.create();
  // Frobenius is the one worth naming: `tower.py` validates its constants by comparing
  // Frobenius-by-constant against actually raising to the pⁿ-th power in the tower, so a wrong
  // digit in any of the nine twelve-word tables fails there before reaching here.
  JsonValue? v = vectors(t, cli);
  if (v is null) { return t.report(); }
  JsonArray? cases = memberArray(v!, "fp12");
  if (cases is null) { return t.report(); }
  string[] names = string[]("mul", "sq", "conj", "inv", "frob1", "frob2", "frob3");
  for (i32 i = 0; i < cases!.len(); i++) {
    JsonValue c = cases!.get(i);
    u8[] a = flat(c, "a");
    u8[] b = flat(c, "b");
    for (i32 op = 0; op < names.len(); op++) {
      t.eqStr(hex(blsFp12Op(a, b, op)), hex(flat(c, names[op])), "fp12 " + names[op]);
    }
    t.isTrue(blsFp12InverseIsInverse(a), "a · a⁻¹ != 1 in Fp12");
  }
  return t.report();
}

export string test_the_modulus_constants_and_the_modulus_array_are_the_same_p() {
  T t = T.create();
  // p is spelled twice in `src/fp.wac` — as an array for `fpMul`, and as `P0..P11` constants for
  // the reduction that every add and subtract goes through. Nothing else in the suite would notice
  // them drifting apart, because both spellings are used together in almost every operation and a
  // consistent pair of wrong values is still self-consistent. This ties them to each other.
  t.isTrue(blsModulusConstantsAgree(),
           "P0..P11 disagree with modulus() — the reduction is against the wrong p");
  return t.report();
}
