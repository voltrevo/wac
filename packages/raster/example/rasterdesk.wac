// The raster desktop on a canvas, which is the first thing that puts every piece on a screen.
//
//   wac run --allow-read --allow-write --allow-run packages/web/tools/build.wac \
//       packages/raster/example/rasterdesk.wac .cache/rasterdesk --page ./packages/web
//
// `design/system/0004` steps 1 to 4, wired: `Desk` holds the windows and their terminals, `Surface`
// is the pixels, a canvas handle's `pixels` establishes the canvas and `pixelsIn` updates part of it.
//
// **This is the coordinate test.** Everything under it was checked without a screen — a surface read
// back as numbers, a hit answered as an index — and all of that can be self-consistently wrong about
// where the origin is or which way `y` runs. A canvas cannot: `packages/raster/test/live.test.ts`
// loads this in a real browser and reads the pixels back out, so the first disagreement between the
// model's idea of a rectangle and the page's shows up as a colour in the wrong place.
//

import { Element, ElementEvent, Listen, Node, Page, Ref, Ui, html.canvas, html.div, html.style } from "../../web";
import { Scalar, count, decode } from "../../unicode/src/utf8.wac";
import { Desk, barHeight } from "../src/desk.wac";
import { Surface, cellHeight, cellWidth } from "../src/surface.wac";

/** Wide enough for two windows side by side with room to drag them. */
i32 W() { return 320; }
i32 H() { return 200; }

/** The desktop, a window frame, a title bar, text, and the terminal's background. */
i32 DESKTOP() { return 0x101416FF; }
i32 FRAME() { return 0x46D9C0FF; }
i32 BAR() { return 0x2A3438FF; }
i32 FG() { return 0xDCE8E7FF; }
i32 BG() { return 0x1E2528FF; }

/** A patch colour nothing else uses, so a test can find it and know which call put it there. */
i32 PATCH() { return 0xFF00FFFF; }

/**
 * Code points from a string, through the real decoder.
 *
 * A grid is indexed by code point and a string is UTF-8 bytes, so something has to decode — and
 * `s[i]` answers a one-character *string* rather than a number, which is the wrong shape here.
 * `packages/unicode` is the decoder this repository already trusts, so the label on a window is
 * correct for anything anyone types rather than for ASCII.
 */
i32[] cps(string s) {
  u8[] bytes = s.toBytes();
  i32[] out = i32[].filled(count(bytes), 0);
  i32 at = 0;
  i32 n = 0;
  while (at < bytes.len() && n < out.len()) {
    Scalar sc = decode(bytes, at);
    if (sc.code < 0) { break; }
    out[n] = sc.code;
    n = n + 1;
    at = at + sc.size;
  }
  return out;
}

/** The page, laid out once: one canvas, which the loop in `main` owns. */
Node Layout(Ui ui, Ref screen) {
  return <div>
    <style>{"body { margin: 0; background: #0b0e0f; } canvas { display: block; image-rendering: pixelated; }"}</style>
    <canvas ref={screen} id="screen"></canvas>
  </div>;
}

export async i32 main(Page page) {
  Desk d = Desk.create();
  d.open(20, 20, 12, 4, cps("one"));
  d.open(120, 70, 12, 4, cps("two"));
  d.toFocused(cps("hello"));

  // **The markup is made at run time**, not exported. A page program owns its document, and a
  // `<canvas>` that nothing made is a canvas that does not exist — which is exactly how this failed the
  // first time, with the live test waiting thirty seconds for an element nobody had made.
  Ref at = Ref {};
  page.mount((Ui ui) => Layout(ui, at));
  Element screen = at.element()!;

  Surface s = Surface.create(W(), H());
  d.draw(s, DESKTOP(), FRAME(), BAR(), FG(), BG());

  // **The whole canvas first**, because `pixels` is what sizes it — the markup above has a `<canvas>`
  // with no dimensions, so until this runs the backing store is the browser's default.
  screen.pixels(W(), H(), s.pixels);

  // **Then a partial blit**, which is the thing with an origin that can be wrong. A 16x16 square at
  // (200, 24): if `pixelsIn` put it at the wrong place, or the surface's rows ran the other way,
  // the test that reads this pixel finds the desktop colour.
  Surface patch = Surface.create(16, 16);
  patch.fill(0, 0, 16, 16, PATCH());
  screen.pixelsIn(200, 24, 16, 16, patch.pixels);

  page.log("rasterdesk: \{W()}x\{H()}, \{d.wins.len()} windows");

  // **The event loop, which is the half a headless test cannot reach.** `desk.wac`'s own tests press
  // and drag with synthetic numbers; what they cannot check is that a browser's pointer coordinates
  // mean the same thing this model's do. They arrive relative to the element the listener is on —
  // the canvas — which is exactly what a `Surface` is indexed by, so no conversion should be needed
  // and this is where that claim gets tested.
  screen.listen("pointerdown", Listen.none());
  screen.listen("pointermove", Listen.none());
  screen.listen("pointerup", Listen.none());

  while (true) {
    ElementEvent e = await screen.next();
    if (e.kind == "pointerdown") { d.pointerDown(e.x, e.y); }
    else if (e.kind == "pointermove") { d.pointerMove(e.x, e.y); }
    else if (e.kind == "pointerup") { d.pointerUp(); }
    else { continue; }

    // Redraw and send only what changed, which is what the damage rectangle is for. A drag moves one
    // window, so this is a few thousand pixels rather than the 256 KB the whole screen would be.
    s.undamage();
    d.draw(s, DESKTOP(), FRAME(), BAR(), FG(), BG());
    if (s.damaged()) {
      screen.pixelsIn(s.dx0, s.dy0, s.dx1 - s.dx0 + 1, s.dy1 - s.dy0 + 1, s.damagedPixels());
    }
  }
}
