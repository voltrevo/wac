// What a host asks the rasteriser, so the test can compare bytes rather than describe them.
//
// The interesting assertions are about *pixels*, and a pixel is a number — so the probe answers
// numbers and arrays and the test does the comparing. Nothing here draws to a screen: a surface is a
// buffer, and whether it reaches one is `Page.drawPixels`'s business (`design/system/0004` step 1).

import { Surface, cellHeight, cellWidth, stride } from "../../src/surface.wac";
import { glyphCount, glyphIndex, glyphRow, glyphWidth } from "../../src/font16.wac";
import { Desk } from "../../src/desk.wac";
import { EMPTY, Grid, WIDE_TAIL } from "../../src/grid.wac";
import { PART_BAR, PART_BODY, PART_CLOSE, PART_NONE, Rect, partAt, raiseTo, topmost } from "../../src/hit.wac";

/** The font's own numbers, so a test can notice the table changing under it. */
export i32 glyphs() { return glyphCount(); }
export i32 cellW() { return cellWidth(); }
export i32 cellH() { return cellHeight(); }

/** One row of one code point's glyph, as a bit pattern. -1 where the font has no such glyph. */
export i32 rowOf(i32 cp, i32 row) {
  i32 idx = glyphIndex(cp);
  if (idx < 0) { return -1; }
  return glyphRow(idx, row);
}

/** How wide the glyph for `cp` is: 8, 16, or 0 where there is none. */
export i32 widthOf(i32 cp) {
  i32 idx = glyphIndex(cp);
  if (idx < 0) { return 0; }
  return glyphWidth(idx);
}

/**
 * A window: a frame, a title bar, and a line of text in it — 0004 step 2's own criterion.
 *
 * Answers the whole buffer so the test can compare it byte for byte and, more usefully, count what
 * it holds. Drawn in a fixed order with fixed colours, so two runs of the same build produce the
 * same bytes: a rasteriser whose output depends on iteration order is one nobody can test.
 */
export u8[] window(i32 w, i32 h) {
  Surface s = Surface.create(w, h);
  s.fill(0, 0, w, h, 0x101416FF);              // the desktop behind it
  s.fill(4, 4, w - 8, h - 8, 0x1E2528FF);      // the window
  s.rect(4, 4, w - 8, h - 8, 0x46D9C0FF);      // its frame
  s.fill(5, 5, w - 10, cellHeight() + 2, 0x2A3438FF);   // the title bar
  s.text(i32[](0x77, 0x61, 0x63), 8, 6, 0xDCE8E7FF);    // "wac"
  return s.pixels;
}

/** The damage rectangle after that window is drawn: left, top, right, bottom. */
export i32[] windowDamage(i32 w, i32 h) {
  Surface s = Surface.create(w, h);
  s.fill(0, 0, w, h, 0x101416FF);
  s.fill(4, 4, w - 8, h - 8, 0x1E2528FF);
  s.rect(4, 4, w - 8, h - 8, 0x46D9C0FF);
  s.fill(5, 5, w - 10, cellHeight() + 2, 0x2A3438FF);
  s.text(i32[](0x77, 0x61, 0x63), 8, 6, 0xDCE8E7FF);
  return i32[](s.dx0, s.dy0, s.dx1, s.dy1);
}

/** Damage after drawing one small rectangle, so a test can see it is not the whole surface. */
export i32[] damageOfFill(i32 w, i32 h, i32 x, i32 y, i32 fw, i32 fh) {
  Surface s = Surface.create(w, h);
  s.fill(x, y, fw, fh, 0xFFFFFFFF);
  return i32[](s.dx0, s.dy0, s.dx1, s.dy1);
}

/** Whether a freshly made surface reports nothing damaged. */
export bool freshIsClean(i32 w, i32 h) { return !Surface.create(w, h).damaged(); }

/** The colour at a pixel after filling a rectangle that hangs off every edge. */
export i32 clippedAt(i32 w, i32 h, i32 x, i32 y) {
  Surface s = Surface.create(w, h);
  s.fill(-5, -5, w + 20, h + 20, 0x11223344);
  return s.at(x, y);
}

/** How many pixels a `text` call set, and where it ended — for a caller checking advance. */
export i32 textEnd(i32[] cps, i32 x) {
  Surface s = Surface.create(200, 32);
  return s.text(cps, x, 4, 0xFFFFFFFF);
}

/** The number of non-transparent pixels in a surface with one glyph drawn on it. */
export i32 inkOf(i32 cp) {
  Surface s = Surface.create(32, 16);
  s.glyph(cp, 0, 0, 0xFFFFFFFF);
  i32 n = 0;
  for (i32 y = 0; y < 16; y++) {
    for (i32 x = 0; x < 32; x++) { if (s.at(x, y) != 0) { n = n + 1; } }
  }
  return n;
}

/** Bytes per pixel, which a host needs to size a buffer it hands us. */
export i32 strideOf() { return stride(); }

/** Damage after two fills, so the widening branches run rather than only the first assignment. */
export i32[] damageOfTwo(i32 ax, i32 ay, i32 bx, i32 by) {
  Surface s = Surface.create(64, 32);
  s.fill(ax, ay, 4, 4, 0xFFFFFFFF);
  s.fill(bx, by, 4, 4, 0xFFFFFFFF);
  return i32[](s.dx0, s.dy0, s.dx1, s.dy1);
}

/** Whether `undamage` clears what a draw set. */
export bool undamageClears() {
  Surface s = Surface.create(32, 32);
  s.fill(1, 1, 4, 4, 0xFFFFFFFF);
  if (!s.damaged()) { return false; }
  s.undamage();
  return !s.damaged();
}

/** A surface asked for with negative dimensions, which a collapsed window reaches. */
export i32 negativeIsEmpty() {
  Surface s = Surface.create(-4, -9);
  return s.width * 1000 + s.height * 10 + s.pixels.len();
}

/** `at` outside the surface, which must answer 0 rather than trap. */
export i32 atOutside(i32 x, i32 y) { return Surface.create(8, 8).at(x, y); }

/** A frame with no area, which is what a zero-sized window asks for. */
export bool rectDegenerate() {
  Surface s = Surface.create(16, 16);
  s.rect(2, 2, 0, 8, 0xFFFFFFFF);
  s.rect(2, 2, 8, 0, 0xFFFFFFFF);
  return !s.damaged();
}

/** A glyph drawn above and below the surface: every row clipped, nothing written. */
export i32 glyphOffscreen() {
  Surface s = Surface.create(16, 16);
  s.glyph(0x41, 0, -40, 0xFFFFFFFF);
  s.glyph(0x41, 0, 100, 0xFFFFFFFF);
  i32 n = 0;
  for (i32 y = 0; y < 16; y++) { for (i32 x = 0; x < 16; x++) { if (s.at(x, y) != 0) { n = n + 1; } } }
  return n;
}

/** The damaged pixels after one fill, and their length — `drawPixelsIn`'s payload. */
export i32[] damagedShape(i32 x, i32 y, i32 w, i32 h) {
  Surface s = Surface.create(64, 32);
  s.fill(x, y, w, h, 0x11223344);
  u8[] px = s.damagedPixels();
  return i32[](s.dx0, s.dy0, s.dx1 - s.dx0 + 1, s.dy1 - s.dy0 + 1, px.len());
}

/** The first pixel of a region, so a test can see it was copied from the right place. */
export i32 regionFirst(i32 rx, i32 ry) {
  Surface s = Surface.create(16, 16);
  s.fill(4, 4, 4, 4, 0x11223344);
  u8[] px = s.region(rx, ry, 2, 2);
  if (px.len() < 4) { return -1; }
  return (px[0] << 24) | (px[1] << 16) | (px[2] << 8) | px[3];
}

/** An empty surface has no damaged pixels to send. */
export i32 cleanHasNoPixels() { return Surface.create(8, 8).damagedPixels().len(); }

// ── Hit-testing (design/system/0004 step 3) ──────────────────────────────────

/** A stack of windows from flat numbers, so a test can build one without a struct array. */
Rect[] stackOf(i32[] flat) {
  Rect[] out = Rect[flat.len() / 4](fill: Rect(0, 0, 0, 0));
  for (i32 i = 0; i < flat.len() / 4; i++) {
    out[i] = Rect(flat[i * 4], flat[i * 4 + 1], flat[i * 4 + 2], flat[i * 4 + 3]);
  }
  return out;
}

/** Which window is under a point: the index, or -1 for the desktop. */
export i32 hitAt(i32[] flat, i32 px, i32 py) { return topmost(stackOf(flat), px, py); }

/** Which part of a single window a point is in. */
export i32 partOf(i32 x, i32 y, i32 w, i32 h, i32 barH, i32 closeW, i32 px, i32 py) {
  return partAt(Rect(x, y, w, h), barH, closeW, px, py);
}

/** The part names, so a test does not hardcode the numbers this module chose. */
export i32 partNone() { return PART_NONE(); }
export i32 partBody() { return PART_BODY(); }
export i32 partBar() { return PART_BAR(); }
export i32 partClose() { return PART_CLOSE(); }

/**
 * Raise a window, then say what is under a point — the two things that must stay in step.
 *
 * Answers the new index and the hit, so a test can see that raising changed which window answers
 * for a point both of them cover.
 */
export i32[] raiseThenHit(i32[] flat, i32 i, i32 px, i32 py) {
  Rect[] s = stackOf(flat);
  i32 at = raiseTo(s, i);
  return i32[](at, topmost(s, px, py));
}

// ── The terminal grid (design/system/0004 step 4) ────────────────────────────

/** Write code points into a grid and answer a row as code points. */
export i32[] gridRow(i32 cols, i32 rows, i32[] cps, i32 row) {
  Grid g = Grid.create(cols, rows, 8);
  g.write(cps);
  i32[] out = i32[cols]();
  for (i32 c = 0; c < cols; c++) { out[c] = g.at(c, row); }
  return out;
}

/** Where the cursor ends up after writing. */
export i32[] gridCursor(i32 cols, i32 rows, i32[] cps) {
  Grid g = Grid.create(cols, rows, 8);
  g.write(cps);
  return i32[](g.curCol, g.curRow);
}

/** A scrolled-off line, and how many are kept. */
export i32[] gridScrolled(i32 cols, i32 rows, i32 maxBack, i32[] cps, i32 line) {
  Grid g = Grid.create(cols, rows, maxBack);
  g.write(cps);
  i32[] out = i32[cols + 1]();
  out[0] = g.scrollbackRows;
  for (i32 c = 0; c < cols; c++) { out[c + 1] = g.scrolledAt(c, line); }
  return out;
}

/** The marker values, so a test does not hardcode what this module chose. */
export i32 gridEmpty() { return EMPTY(); }
export i32 gridWideTail() { return WIDE_TAIL(); }

/** Ink in a drawn grid, so a test can see `WIDE_TAIL` drew nothing twice. */
export i32 gridInk(i32 cols, i32 rows, i32[] cps) {
  Grid g = Grid.create(cols, rows, 0);
  g.write(cps);
  Surface s = Surface.create(cols * 8, rows * 16);
  g.draw(s, 0, 0, 0xFFFFFFFF, 0x000000FF);
  i32 n = 0;
  for (i32 y = 0; y < rows * 16; y++) {
    for (i32 x = 0; x < cols * 8; x++) { if (s.at(x, y) == 0xFFFFFFFF) { n = n + 1; } }
  }
  return n;
}

/** The caret's pixels: how many cells' worth are the foreground after drawing it. */
export i32 caretInk(i32 cols, i32 rows, i32[] cps) {
  Grid g = Grid.create(cols, rows, 0);
  g.write(cps);
  Surface s = Surface.create(cols * 8, rows * 16);
  g.draw(s, 0, 0, 0xFFFFFFFF, 0x000000FF);
  i32 before = 0;
  for (i32 y = 0; y < rows * 16; y++) {
    for (i32 x = 0; x < cols * 8; x++) { if (s.at(x, y) == 0xFFFFFFFF) { before = before + 1; } }
  }
  g.drawCaret(s, 0, 0, 0xFFFFFFFF, 0x000000FF);
  i32 after = 0;
  for (i32 y = 0; y < rows * 16; y++) {
    for (i32 x = 0; x < cols * 8; x++) { if (s.at(x, y) == 0xFFFFFFFF) { after = after + 1; } }
  }
  return after - before;
}

// ── The desktop (design/system/0004 steps 3 and 4 joined) ────────────────────

/** A desk with two windows, the second on top, for the event tests. */
Desk twoWindows() {
  Desk d = Desk.create();
  d.open(10, 10, 8, 3, i32[](0x61));        // "a", back
  d.open(40, 30, 8, 3, i32[](0x62));        // "b", front
  return d;
}

/** Press somewhere and answer which window is on top afterwards, and how many remain. */
export i32[] deskPress(i32 px, i32 py) {
  Desk d = twoWindows();
  i32 top = d.pointerDown(px, py);
  return i32[](top, d.wins.len(), d.dragging);
}

/** Press on a bar, drag, release — answer where the window ended up. */
export i32[] deskDrag(i32 downX, i32 downY, i32 moveX, i32 moveY) {
  Desk d = twoWindows();
  d.pointerDown(downX, downY);
  d.pointerMove(moveX, moveY);
  i32 n = d.wins.len();
  Rect f = d.wins[n - 1].frame;
  i32[] before = i32[](f.x, f.y);
  d.pointerUp();
  d.pointerMove(moveX + 100, moveY + 100);   // ignored: nothing is held
  Rect g = d.wins[n - 1].frame;
  return i32[](before[0], before[1], g.x, g.y);
}

/** Close the front window while the back one is being dragged — the drag must not transfer. */
export i32 deskCloseDuringDrag() {
  Desk d = twoWindows();
  d.pointerDown(45, 35);          // take hold of the front window's bar
  d.close(0);                     // and close the *other* one
  d.pointerMove(200, 200);
  return d.wins[d.wins.len() - 1].frame.x;
}

/** Type into the focused window and read a cell back. */
export i32 deskTyped(i32[] cps, i32 col, i32 row) {
  Desk d = twoWindows();
  d.toFocused(cps);
  return d.wins[d.wins.len() - 1].term.at(col, row);
}

/** Draw a desk and answer the damage rectangle plus how many pixels are the frame colour. */
export i32[] deskDrawn(i32 w, i32 h) {
  Desk d = twoWindows();
  Surface s = Surface.create(w, h);
  d.draw(s, 0x101416FF, 0x46D9C0FF, 0x2A3438FF, 0xDCE8E7FF, 0x000000FF);
  i32 frames = 0;
  for (i32 y = 0; y < h; y++) {
    for (i32 x = 0; x < w; x++) { if (s.at(x, y) == 0x46D9C0FF) { frames = frames + 1; } }
  }
  return i32[](s.dx0, s.dy0, s.dx1, s.dy1, frames, s.damagedPixels().len());
}

/**
 * The ink in one drawn row, with the viewport pushed back `up` lines.
 *
 * Counting foreground pixels per row rather than reading cells back: `drawFrom` is what a screen
 * actually shows, and asking the *grid* what it holds would test the model against itself. A row of
 * the surface is the only place the scrollback and the live screen have been joined.
 */
export i32[] gridDrawnInk(i32 cols, i32 rows, i32 maxBack, i32[] cps, i32 up) {
  Grid g = Grid.create(cols, rows, maxBack);
  g.write(cps);
  Surface s = Surface.create(cols * cellWidth(), rows * cellHeight());
  g.drawFrom(s, 0, 0, 0xFFFFFFFF, 0x000000FF, up);
  i32[] out = i32[rows]();
  for (i32 r = 0; r < rows; r++) {
    i32 n = 0;
    for (i32 py = r * cellHeight(); py < (r + 1) * cellHeight(); py++) {
      for (i32 px = 0; px < cols * cellWidth(); px++) {
        if (s.pixels[(py * s.width + px) * 4] == 255) { n = n + 1; }
      }
    }
    out[r] = n;
  }
  return out;
}

/** The selected text over a grid built from `cps`, as code points. */
export i32[] gridSelected(i32 cols, i32 rows, i32[] cps, i32 c0, i32 r0, i32 c1, i32 r1) {
  Grid g = Grid.create(cols, rows, 0);
  g.write(cps);
  g.selectFrom(c0, r0);
  g.selectTo(c1, r1);
  return g.selectedText(0);
}

/** Whether each cell of a row is drawn inverted, with the selection set to one linear range. */
export i32[] gridSelectionInk(i32 cols, i32 rows, i32[] cps, i32 c0, i32 r0, i32 c1, i32 r1, i32 row) {
  Grid g = Grid.create(cols, rows, 0);
  g.write(cps);
  g.selectFrom(c0, r0);
  g.selectTo(c1, r1);
  Surface s = Surface.create(cols * cellWidth(), rows * cellHeight());
  g.draw(s, 0, 0, 0xFFFFFFFF, 0x000000FF);
  // The top-left pixel of each cell: white where the cell was filled for selection, black otherwise.
  i32[] out = i32[cols]();
  for (i32 c = 0; c < cols; c++) {
    out[c] = s.pixels[((row * cellHeight()) * s.width + c * cellWidth()) * 4];
  }
  return out;
}
