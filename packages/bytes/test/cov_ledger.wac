// bytes' coverage, and the one point that needs two gigabytes to reach.
//
//   wac task coverage:bytes
//   wac task coverage:bytes --verbose
//
// **79 of 80.** Two-way ratchet over `tools/wac/covledger.wac`: anything not listed must be covered,
// and anything listed that *is* covered fails too. `issues/system/0205`.
//
// ## What the driver was not reaching, and it was not a capability
//
// This read 73 of 80, and six of the seven uncovered points were one function: `slice.wac`'s `equal`,
// whose **entry** was uncovered. Not a branch nobody took — a function nobody called, in a file
// `packages/ssz`, `packages/ens` and `packages/tls` all import from. It had no test at all; one is in
// `test/wac/bounds_test.wac` now, pinning among other things the "empty equals empty" its doc comment
// argues for.
//
// **None of this package's 39 tests takes a capability**, so `cov_exercise.wac` could have called them
// from the day it was written. `issues/system/0221` removed the blocker for packages whose tests need
// one; this was never in that set. It was simply never wired — as sixteen of nineteen exercises still
// were when this was written.
//
// ## The pin moved, and the ratchet is why anyone noticed
//
// It said line 83 and the line is 88. Nothing about `buf.wac`'s behaviour changed — a correction to its
// *header comment* on 2026-08-21 added five lines above everything, and a pin keyed by line number
// drifted. I had reasoned at the time that the pin sat above the edit; it sat below it, and I did not
// check.
//
// **That is the failure mode the snippet is for.** The ratchet does not say "83 is uncovered", it says
// *`buf.wac:83` no longer holds "if (cap > 2147483647) …"* and prints what the line holds instead — so
// the fix is one number rather than a re-derivation. A ledger keyed on line numbers alone would have
// gone quietly green about the wrong line.
//
// ## The mistake that made the first attempt look like a no-op
//
// Wiring all 39 into `main` changed the number **not at all** — 73 of 80 before and after, with no
// failure printed. Twelve of `bounds_test.wac`'s seventeen tests *expect a trap*, and a trap in `main`
// ends the run: the third call killed the process after the probes had already covered their 73. The
// evidence was a report identical to the one before the change, which reads as "the wiring did
// nothing" and meant "the wiring stopped the run".
//
// So they are split. The 27 that return are called from `main`; the twelve that trap go through
// `trapCase` and `cases()` below, which `covdump` calls one at a time with the trap caught. Every
// package left in `issues/system/0205` will need the same split, and the tell is `test_traps_` in the
// name.

import { Core, Cli, Sys } from "std";
import { Pin, Rule, Measured, measure, report, ratchet, LedgerFlags, reportPoints } from "../../../tools/wac/covledger.wac";

static string EXERCISE = "packages/bytes/test/cov_exercise.wac";
static string PREFIX = "packages/bytes/";

/**
 * The trap sweep: twelve bounds checks, each expecting to trap.
 *
 * `covdump` calls `trapCase(0)`…`trapCase(11)` with a TryCatch per call
 * (spec/cli/wac.md, `[§wac-cli-covdump-sweep-4tn8mr6]`), so a case past the end returns rather than
 * trapping and the width is an upper bound rather than an assertion.
 */
string[] cases() { return ["trapCase:12"]; }

Pin[] pins() {
  // The one pin here was `Buf`'s capacity clamp, which moved to `core/buf.wac` with `Buf` itself
  // (spec ch42) and is core's coverage to account for now.
  return Pin[]();
}

export i32 main(Sys sys) {
  Core core = sys.core;
  Cli cli = sys.cli;
  LedgerFlags flags = LedgerFlags.read(cli);

  // No grants: not one of this package's tests or probes reads a file or spawns anything.
  Measured m = measure(core, cli, EXERCISE, string[].filled(0, ""), cases());
  if (m.nPoints == 0) { return 1; }

  // `--points` dumps the per-point table instead of the report, unfiltered, so a caller can
  // union this driver's reach with another's — `issues/system/0241b`.
  if (flags.points) { reportPoints(core, m.points, m.nPoints, m.counts); return 0; }
  report(core, m.points, m.nPoints, m.counts, PREFIX, flags.verbose);
  return ratchet(core, cli, m.points, m.nPoints, m.counts, PREFIX, pins(),
                 Rule[].filled(0, Rule("", "", "line", true, ""))) ? 1 : 0;
}
