// Fixture for the bounds traps, which cannot be tested from wac: a trap aborts the
// whole module, so each case needs its own call from the host.
import { Buf } from "../src/buf.wac";
import { slice, clamped } from "../src/slice.wac";

export i32 getPastEnd() { Buf b = Buf.create(); b.push(1); return b.get(1); }
export i32 getNegative() { Buf b = Buf.create(); b.push(1); return b.get(0 - 1); }
export i32 getAtCapacityNotLength() {
  // Index inside the allocated array but past `len` — the case a naive bounds check
  // against data.len() rather than len would wrongly allow.
  Buf b = Buf.withCapacity(16);
  b.push(1);
  return b.get(5);
}
export i32 getOk() { Buf b = Buf.create(); b.push(42); return b.get(0); }

/** `pushRepeat` from before the buffer starts. */
export i32 pushRepeatBeforeStart() {
  Buf b = Buf.create();
  b.pushAll(u8[]('a', 'b'));
  b.pushRepeat(-1, 1);
  return b.len;
}

/**
 * `pushRepeat` whose source starts at the end.
 *
 * Not the same as a copy that *runs* past the end, which is legal and is how a run is spelled:
 * there the first byte read exists and the rest are written before they are read. Here the very
 * first byte read does not exist.
 */
export i32 pushRepeatPastEnd() {
  Buf b = Buf.create();
  b.pushAll(u8[]('a', 'b'));
  b.pushRepeat(2, 1);
  return b.len;
}

/** A negative count, which would otherwise just write nothing and hide a caller's arithmetic. */
export i32 pushRepeatNegativeCount() {
  Buf b = Buf.create();
  b.pushAll(u8[]('a', 'b'));
  b.pushRepeat(0, -1);
  return b.len;
}

// ── slice and clamped ────────────────────────────────────────────────────────
//
// The pair exists because nine packages had spelled these two meanings with one name and drifted
// (wac-mono 0093). Each of `slice`'s refusals gets its own entry point, since a trap ends the module.

u8[] five() { return u8[]('a', 'b', 'c', 'd', 'e'); }

export i32 slicePastEnd() { return slice(five(), 3, 9).len(); }
export i32 sliceNegativeFrom() { return slice(five(), -1, 2).len(); }
export i32 sliceBackwards() { return slice(five(), 4, 1).len(); }
/** The boundary case that must *not* trap: an empty slice at the very end is a valid range. */
export i32 sliceEmptyAtEnd() { return slice(five(), 5, 5).len(); }
export i32 sliceWhole() { return slice(five(), 0, 5).len(); }
export i32 sliceMiddle() { return slice(five(), 1, 3)[0]; }

/** Every one of these is a range `slice` would refuse, and none of them may trap. */
export i32 clampedPastEnd() { return clamped(five(), 3, 9).len(); }
export i32 clampedNegativeFrom() { return clamped(five(), -1, 2).len(); }
export i32 clampedBackwards() { return clamped(five(), 4, 1).len(); }
export i32 clampedBothOutside() { return clamped(five(), 9, 12).len(); }
export i32 clampedNegativeBoth() { return clamped(five(), -9, -2).len(); }
export i32 clampedFirstByte() { return clamped(five(), -3, 1)[0]; }
