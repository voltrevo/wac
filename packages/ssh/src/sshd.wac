// `sshd` — an SSH server, entire, in wac.
//
//   deno task app packages/ssh/src/sshd.wac --allow-read --allow-net --allow-env -- -p 2222 -h hostkey
//
// Usage:
//
//   sshd [-p port] [-h hostkey] [-a authorized_keys] [-1]
//
//     -p  port to listen on, default 2222
//     -h  host private key, default $HOME/.ssh/ssh_host_ed25519_key
//     -a  authorized keys file, default $HOME/.ssh/authorized_keys
//     -1  serve one connection and exit
//
// ## This is not an sshd
//
// **It cannot run a shell, or any other program**, because `packages/platform` has no capability
// that starts a process — see issue 0015. So it answers a small set of commands implemented here
// in wac and reports `command not found` for the rest, which is the honest version of the
// restriction rather than a shell that mostly does not work.
//
// That is the *only* reason it is not one. The transport, the key exchange, the cipher and the
// channel layer are the same code the client uses, and OpenSSH's own client connects to it,
// authenticates and runs commands without knowing the difference.
//
// **One connection at a time**, because the world has no `poll`: `accept` blocks, the connection
// is served to completion, then the next. Fine for what this is for and not a design to copy.
//
// **No rekeying, no port forwarding, no agent forwarding, no subsystems.** A client asking for any of
// them gets a refusal rather than silence. A **pty** it does get: `packages/tty` is the line
// discipline behind it, and the modes in the request are not read — canonical with echo is the one
// arrangement this serves.

import { Buf } from "../../bytes/src/buf.wac";
import { itoa } from "../../fmt/src/itoa.wac";
import { Cli, Core, FileResult, Socket } from "../../platform/src/platform.wac";
import { Conn, msgNewKeys } from "./conn.wac";
import { clientVersion, clientVersionLine, Found, scanVersion, speaksV2, Version } from "./version.wac";
import { keyLength } from "./cipher.wac";
import { Proposal, decode, encode, msgKexInit, negotiate } from "./kexinit.wac";
import { deriveKey } from "./kex.wac";
import { KeyError, PrivateKey, readEd25519 } from "./privatekey.wac";
import { Match, lookUp } from "./authorizedkeys.wac";
import { Incoming, msgChannelClose, msgChannelData, msgChannelEof, msgChannelOpen,
         msgChannelRequest, msgChannelWindowAdjust, parse } from "./channel.wac";
import { Shell, runScript } from "../../sh/src/exec.wac";
import { Line, Typed } from "../../tty/src/line.wac";
import { Fs } from "../../fs/src/fs.wac";
import { Booted, boot, save } from "../../fs/src/image.wac";
import { Vec } from "../../std/src/vec.wac";
import { AuthRequest, authFailure, authSuccess, channelClose, channelData, channelEof,
         pkOk,
         channelFailure, channelStderr, channelSuccess, ecdhReply, ephemeralPublic, exchangeHash, execCommand,
         exitStatus, hostKeyBlob, openConfirmation, openFailure, parseAuthRequest, parseEcdhInit,
         readOpenChannel, requestWantsReply,
         readPtyReq, readWindowChange, requestName, serverProposal, serviceAccept, sharedSecret,
         Terminal, verifyAuth,
         byApplication, disconnect } from "./server.wac";
import { equal } from "../../bytes/src/slice.wac";
import { User, authorizedKeysOf, parsePasswd, userNamed } from "../../fs/src/passwd.wac";
import { boxApplet, boxNames, boxRun } from "../../box/src/shrun.wac";
import { UNKNOWN } from "../../box/src/box.wac";

i32 defaultPort() { return 2222; }
i32 windowSize() { return 2 * 1024 * 1024; }
i32 maxPacketSize() { return 32768; }
i32 ourChannel() { return 0; }

/**
 * The server's version line.
 *
 * `SSH-2.0-` then anything. Announcing what we are matters more than usual here: a client
 * connecting to this will not get a shell, and the version string is the first place to say so.
 */
u8[] serverVersion() { return "SSH-2.0-wacsshd_0.1".toBytes(); }

u8[] serverVersionLine() {
  Buf b = Buf.create();
  b.pushAll(serverVersion());
  b.push(13);
  b.push(10);
  return b.take();
}

export i32 main(Core core, Cli cli) {
  // **This program is also `packages/box`'s applets**, so that a session can spawn its pipeline
  // stages: a stage re-enters `main` with the applet's name first. Without it a spawned `sort` would
  // start a second sshd and hand it a script called `sort`. See `sessionShell` for what the stage
  // then reads, which is the session's filesystem rather than this machine's.
  i32 asApplet = boxApplet(core, cli);
  if (asApplet != UNKNOWN) { return asApplet; }

  Options o = parseArgs(core, cli);
  if (o.exitCode >= 0) { return o.exitCode; }

  FileResult hostFile = cli.readFile(o.hostKey).wait();
  if (!hostFile.ok) {
    core.warn("sshd: " + o.hostKey + ": " + hostFile.error);
    return 1;
  }
  PrivateKey host = readEd25519(hostFile.bytes, u8[0]());
  match (host.error) {
    case Ok: {}
    case BadPassphrase: {
      core.warn("sshd: " + o.hostKey + ": host keys must not be encrypted");
      return 1;
    }
    else: {
      core.warn("sshd: " + o.hostKey + ": not an Ed25519 private key");
      return 1;
    }
  }

  // **The image, booted before the socket.** A server that cannot read its image is not a server, and
  // binding first meant it announced "listening on port 2245" and *then* refused — a moment in which it
  // looked like it was working. Every session gets this same `Fs`, so what one client leaves behind the
  // next one finds — which is the whole difference between a demo and a system. Connections are served
  // one at a time by the loop below, so "one writer" is true by construction rather than by a lock; the
  // concurrency question design/0001 leaves open is not open *here*, and stops being closed the day this
  // serves two at once.
  Fs fs = Fs.inMemory(core.nowMillis().wait());
  if (o.image != "") {
    Vec<string> argv = Vec.create();
    argv.push("sshd");
    // **The same list the session's shell is wired with**, four lines from the import that provides
    // it. The first version passed an empty one with a comment saying this server has no applets —
    // and `sessionShell` sets `sh.externalNames = boxNames` from `../../box/src/shrun.wac`. So a
    // session had sixty-three programs, `help` listed all of them, and the machine said it had no
    // `/bin`: the one place a person looks to find out what a system can run.
    Booted booted = boot(core, cli, o.image, argv, Vec.fromArray(boxNames()));
    if (!booted.ok) {
      // Before the socket: a server that cannot read its image is not a server, and binding first meant
      // it announced "listening on port 2222" and *then* refused — a moment in which it looked like it
      // was working.
      core.warn("sshd: " + o.image + ": " + booted.error);
      return 1;
    }
    fs = booted.fs;
  }

  // Every interface, as a real sshd does: a daemon nobody can reach is not a daemon. Said rather than
  // assumed — `listen` took a port alone until issue 0025.
  Socket listener = cli.listen("", o.port).wait();
  if (listener.handle < 0) {
    core.warn("sshd: listen: " + listener.error);
    return 1;
  }
  core.warn("sshd: listening on port " + itoa(o.port));

  while (true) {
    Socket c = cli.accept(listener.handle).wait();
    if (c.handle < 0) {
      core.warn("sshd: accept: " + c.error);
      break;
    }
    serve(core, cli, c.handle, host, o, fs);
    cli.closeSocket(c.handle);
    // After the connection, not during it: a session that ends badly has still done work, and a client
    // that hangs up mid-command has still created what it created.
    if (o.image != "") { save(core, cli, "sshd", o.image, fs); }
    if (o.once) { break; }
  }
  cli.closeSocket(listener.handle);
  return 0;
}

/**
 * The shell one session gets: capturing either way, and on the image when there is one.
 *
 * One place rather than two, because the two session shapes — a command and a REPL — must not be able to
 * disagree about which filesystem a client is talking to. That is the kind of difference nobody notices
 * until a `ssh host 'ls'` and an interactive `ls` answer differently.
 */
Shell sessionShell(Core core, Cli cli, Options o, Fs fs, Terminal terminal) {
  Shell sh = o.image == "" ? Shell.capturing(core, cli) : Shell.onFs(core, cli, fs);
  // A session's shell is a process in the session's own table, which is what `$$` answers and what
  // `kill` reaches. `shellMain` does this for every other entry point; a session does not go through
  // it, so it says so here rather than inheriting pid 0.
  sh.enterSelf("sh");
  sh.capture = true;
  if (o.image != "") { sh.cwd = "/"; }
  // **The commands are `packages/box`'s applets, over this session's filesystem.** Sixty of them
  // rather than the handful `packages/sh` still carries, and they read the image because an applet
  // takes an `Fs` now (wac-mono 0109). The edge itself waited on wac 0076 — adding this import made an
  // untouched function fail to compile, because two packages declare a `Writer` and the emitter picked
  // whichever registered first.
  //
  sh.external = boxRun;
  sh.externalNames = boxNames;
  // **Spawnable when this session has a filesystem of its own** — wac-mono 0116, and design/0001
  // step 3's criterion, "`ps` shows the pipeline you are running".
  //
  // It was not, and the note here used to explain why at length. Making the server multi-call took
  // three lines and worked, and unsealed the session:
  //
  //     echo inimage > /f; cat /f        ->  cat: /f: No such file or directory
  //     cat /etc/hostname                ->  13f160bf57e5
  //
  // because a spawned stage was a fresh instance and a fresh instance built `Fs.onHost`. It asks its
  // parent now, so a stage of a session booted on an image sees that image and nothing else, and the
  // criterion is met over ssh: `seq 1 200000 | ps` lists the session, `seq` and `ps`.
  //
  // Only with an image. A session with none is `Shell.capturing` over the host's own filesystem,
  // where `serveFsFor` correctly declines to serve — a stage of one builds the same `Fs.onHost` its
  // parent has, which is the same disk with the same grants.
  if (o.image != "") { sh.externalSpawnable = true; }
  // **What terminal the client says it has** — design/0001 step 5's "a `TERM` worth setting".
  //
  // Set only when the client asked for a pty and said so: `ssh -T host` sends no `pty-req`, and a
  // session with no terminal should have no `$TERM` rather than a guessed one. A program that reads
  // it can then tell "no terminal" from "a terminal I have never heard of", which is the distinction
  // an invented default destroys.
  //
  // `COLUMNS` and `LINES` come from the same request and are kept current by `window-change`, because
  // a size read once is wrong for the rest of a session that was resized.
  if (terminal.term != "") { sh.setVar("TERM", terminal.term); }
  if (terminal.columns > 0) {
    sh.setVar("COLUMNS", itoa(terminal.columns));
    sh.setVar("LINES", itoa(terminal.rows));
  }

  // **A session starts in its own home, as its own user.** `fs.user` was set when the key was matched;
  // the rest — `$HOME`, `$USER`, and where `cd` with no argument goes — is read from the same
  // `/etc/passwd` the key was found through, so there is one table rather than a second idea of it.
  if (fs.user != "" && fs.user != "root") {
    sh.setVar("USER", fs.user);
    FileResult passwd = fs.readFile("/etc/passwd");
    if (passwd.ok) {
      User u = userNamed(parsePasswd(passwd.bytes), fs.user);
      if (u.home != "") {
        sh.setVar("HOME", u.home);
        sh.cwd = u.home;
      }
    }
  }
  return sh;
}

/** One connection, to completion. Errors are logged and end the connection, never the server. */
void serve(Core core, Cli cli, i32 sock, PrivateKey host, Options o, Fs fs) {
  Conn conn = Conn.create(core, cli, sock);
  u8[] sessionId = handshake(conn, host);
  if (conn.failed()) {
    core.warn("sshd: " + conn.error);
    // Only worth sending once the transport works; before that the client cannot read it.
    if (conn.encrypted) { conn.sendPacket(disconnect(byApplication(), conn.error.toBytes())); }
    return;
  }

  // **The system reads the policy, not the last user.** `Fs.user` is whatever the previous connection
  // was served as — this filesystem outlives the session — and `authenticate` has to read `/etc/passwd`
  // and every user's `~/.ssh/authorized_keys` before it knows who is asking. Left as the previous user,
  // a login worked or failed depending on *who happened to connect before*: grace with a 0700 `.ssh`
  // could not log in after ada, and could before her.
  fs.setUser("root");
  string who = authenticate(conn, cli, sessionId, o, fs);
  if (who == "") {
    if (conn.failed()) { core.warn("sshd: " + conn.error); }
    conn.sendPacket(disconnect(byApplication(), "no supported authentication methods".toBytes()));
    return;
  }
  // **The session acts as them from here.** Every file it touches is checked against this name, and
  // anything it creates is owned by it — design/0001 step 4, and the reason `mode` and `owner` stopped
  // being decoration.
  fs.setUser(who);

  session(conn, cli, core, o, fs);
  if (conn.failed()) { core.warn("sshd: " + conn.error); }
}

/** Version exchange, key exchange and NEWKEYS. Returns the session id, which is H. */
u8[] handshake(Conn conn, PrivateKey host) {
  if (!conn.cli.send(conn.sock, serverVersionLine()).wait()) {
    conn.fail("cannot send the version line");
    return u8[0]();
  }

  u8[] clientVersionLine = u8[0]();
  while (true) {
    Version v = scanVersion(conn.buf.data, 0, conn.buf.len);
    match (v.status) {
      case Ok: {
        clientVersionLine = v.line;
        conn.buf.dropFront(v.used);
      }
      case Incomplete: {
        if (!conn.fill()) {
          conn.fail("the connection closed during the version exchange");
          return u8[0]();
        }
        continue;
      }
      else: {
        conn.fail("the client did not send a usable version line");
        return u8[0]();
      }
    }
    break;
  }
  if (!speaksV2(clientVersionLine)) {
    conn.fail("the client does not speak SSH-2");
    return u8[0]();
  }

  u8[] ourKexInit = encode(serverProposal(), conn.core.randomBytes(16).wait());
  if (!conn.sendPacket(ourKexInit)) { conn.fail("cannot send KEXINIT"); return u8[0](); }

  u8[] theirKexInit = conn.readPacket();
  if (conn.failed()) { return u8[0](); }
  if (theirKexInit[0] != msgKexInit()) { conn.fail("expected KEXINIT"); return u8[0](); }

  // The *client's* order decides. A server that picked its own favourite would use an algorithm
  // the client is not using, and every packet after NEWKEYS would fail its tag.
  Proposal? theirs = decode(theirKexInit);
  if (theirs is null) { conn.fail("the client's KEXINIT did not parse"); return u8[0](); }
  if (negotiate(theirs!.kex, serverProposal().kex).len() == 0) {
    conn.fail("no key exchange in common");
    return u8[0]();
  }
  if (negotiate(theirs!.hostKey, serverProposal().hostKey).len() == 0) {
    conn.fail("no host key algorithm in common — this server only has an Ed25519 key");
    return u8[0]();
  }
  if (negotiate(theirs!.cipherToServer, serverProposal().cipherToServer).len() == 0) {
    conn.fail("no cipher in common");
    return u8[0]();
  }

  u8[] initPayload = conn.readPacket();
  if (conn.failed()) { return u8[0](); }
  u8[] qc = parseEcdhInit(initPayload);
  if (qc.len() == 0) { conn.fail("expected the key exchange init"); return u8[0](); }

  u8[] secret = conn.core.randomBytes(32).wait();
  u8[] qs = ephemeralPublic(secret);
  u8[]? shared = sharedSecret(secret, qc);
  if (shared is null) {
    conn.fail("the client sent a low-order point");
    return u8[0]();
  }

  u8[] ks = hostKeyBlob(hostPublicPoint(host));
  u8[] h = exchangeHash(clientVersionLine, serverVersion(), theirKexInit, ourKexInit,
                        ks, qc, qs, shared!);
  if (!conn.sendPacket(ecdhReply(ks, qs, h, host.seed))) {
    conn.fail("cannot send the key exchange reply");
    return u8[0]();
  }
  if (!conn.sendPacket(u8[](msgNewKeys()))) { conn.fail("cannot send NEWKEYS"); return u8[0](); }

  u8[] theirNewKeys = conn.readPacket();
  if (conn.failed()) { return u8[0](); }
  if (theirNewKeys[0] != msgNewKeys()) { conn.fail("expected NEWKEYS"); return u8[0](); }

  // 'C' is client-to-server, so the server reads with C and writes with D — the opposite way
  // round from the client, and the one asymmetry that produces a connection where nothing
  // decrypts at all.
  conn.startEncryption(deriveKey(shared!, h, h, 0x43, keyLength()),
                       deriveKey(shared!, h, h, 0x44, keyLength()));
  return h;
}

/** The 32-byte point out of a host key's public blob. */
u8[] hostPublicPoint(PrivateKey host) {
  // The blob is `string "ssh-ed25519"` then `string` the point: 4 + 11 + 4 + 32 bytes.
  if (host.publicBlob.len() < 51) { trap; }
  u8[] point = u8[32]();
  point.copyFrom(host.publicBlob, host.publicBlob.len() - 32, 0, 32);
  return point;
}

/** Service request and publickey authentication. False when the client did not get in. */
/**
 * Who logged in: the user name, or "" when nobody did.
 *
 * A name rather than a boolean because a session belongs to somebody — design/0001 step 4 — and the
 * server cannot ask again later: the key that proved it is gone by then.
 */
string authenticate(Conn conn, Cli cli, u8[] sessionId, Options o, Fs fs) {
  u8[] request = conn.readPacket();
  if (conn.failed()) { return ""; }
  if (request[0] != 5) { conn.fail("expected a service request"); return ""; }
  if (!conn.sendPacket(serviceAccept("ssh-userauth".toBytes()))) {
    conn.fail("cannot accept the service");
    return "";
  }

  // **Two places a key can be named, and the image wins.** With `-i`, users are data in the image
  // (design/0001 D5): `/etc/passwd` lists them and each one's `~/.ssh/authorized_keys` names their keys,
  // so two keys land in two homes without the server being told anything on its command line. Without an
  // image there is no table, and the single `-a` file is the whole policy — as it was.
  Vec<User> users = Vec.create();
  FileResult passwd = fs.readFile("/etc/passwd");
  if (passwd.ok) { users = parsePasswd(passwd.bytes); }
  FileResult keys = cli.readFile(o.authorizedKeys).wait();
  u8[] allowed = keys.ok ? keys.bytes : u8[0]();

  // A client may try several keys, and the first attempt is usually a probe with no signature.
  for (i32 attempt = 0; attempt < 16; attempt++) {
    u8[] payload = conn.readPacket();
    if (conn.failed()) { return ""; }
    AuthRequest a = parseAuthRequest(payload);
    if (!a.ok) { conn.fail("the authentication request did not parse"); return ""; }

    // The image's users first, each against their own file, then the server-wide one. `who` stays empty
    // for the second: a key allowed by `-a` alone belongs to nobody in particular, which is exactly what
    // the filesystem's unset user means.
    string who = "";
    bool named = false;
    for (i32 u = 0; u < users.len() && !named; u++) {
      string path = authorizedKeysOf(users.get(u));
      if (path == "") { continue; }
      FileResult theirs = fs.readFile(path);
      if (!theirs.ok) { continue; }
      match (lookUp(theirs.bytes, "ssh-ed25519".toBytes(), a.publicBlob)) {
        case Ok: { named = true; who = users.get(u).name; }
        else: {}
      }
    }
    match (lookUp(allowed, "ssh-ed25519".toBytes(), a.publicBlob)) {
      case Ok: { named = true; }
      else: {}
    }
    // The signature is checked against bytes we rebuild, never against the client's account of
    // what it signed, and only after the key is one we would accept at all.
    if (named && !a.hasSignature) {
      // A probe. Saying yes is what makes the client sign; saying no makes it give up on a key
      // this server would have accepted.
      if (!conn.sendPacket(pkOk(a.keyType, a.publicBlob))) {
        conn.fail("cannot answer the key probe");
        return "";
      }
      continue;
    }
    if (named && a.hasSignature && verifyAuth(a, sessionId)) {
      if (!conn.sendPacket(authSuccess())) { conn.fail("cannot confirm authentication"); }
      // A name, or "root" for a key the image knows nothing about: somebody authenticated, and a
      // session with no user is one the filesystem exempts from every check.
      return conn.failed() ? "" : (who == "" ? "root" : who);
    }
    if (!conn.sendPacket(authFailure())) { conn.fail("cannot refuse authentication"); return ""; }
  }
  conn.fail("too many authentication attempts");
  return "";
}

/** One session channel, one command. */
void session(Conn conn, Cli cli, Core core, Options o, Fs fs) {
  u8[] payload = conn.readPacket();
  if (conn.failed()) { return; }
  Incoming m = parse(payload);
  if (!m.ok || m.kind != msgChannelOpen()) {
    conn.fail("expected a channel open");
    return;
  }
  // The client's number is in the open; ours is whatever we say. They need not agree, and the
  // confirmation is the one message carrying both.
  i32 clientChannel = readOpenChannel(payload);
  if (clientChannel < 0) {
    conn.sendPacket(openFailure(0, 3, "only session channels".toBytes()));
    return;
  }
  if (!conn.sendPacket(openConfirmation(clientChannel, ourChannel(), windowSize(), maxPacketSize()))) {
    conn.fail("cannot confirm the channel");
    return;
  }

  // Requests until one asks us to run something. A client sends several first, and **which of them
  // get a reply is decided by the request, not by whether we understood it.**
  //
  // Getting that wrong is not subtle in its effect and is invisible in a test. A client whose
  // `ssh_config` has `SendEnv LANG LC_*` — the Debian and Ubuntu default — sends two `env`
  // requests before `exec`, both with want_reply *false*. Answering them puts two extra replies in
  // the stream, the client matches replies to requests in order, and it attributes the first of
  // them to its `exec`. Every command then fails with `exec request failed on channel 0` while the
  // server logs that it ran nothing. This code did exactly that; the suite missed it because it
  // runs the client with `-F /dev/null`, which discards the config that sends the `env` in the
  // first place.
  //
  // **`pty-req` is accepted now**, and it used to be refused deliberately: accepting one makes the
  // client put its own terminal in raw mode and stop echoing, expecting the server to echo every
  // keystroke back — and with nothing here to do that, the user typed blind. `packages/tty` is that
  // something (design/0001 step 5), so the refusal has become an acceptance and the session below
  // does the editing.
  //
  // Both shapes still work and they are different sessions: `ssh -T host` sends no `pty-req`, the
  // client keeps its own line editing, and the server sees whole lines — which is what every test
  // here drives. `ssh -tt host` asks for one, and then every keystroke arrives on its own.
  u8[] command = u8[0]();
  bool interactive = false;
  bool pty = false;
  Terminal terminal = Terminal("", 0, 0);
  for (i32 i = 0; i < 32 && command.len() == 0 && !interactive; i++) {
    u8[] p = conn.readPacket();
    if (conn.failed()) { return; }
    Incoming r = parse(p);
    if (!r.ok) { conn.fail("a channel message did not parse"); return; }
    if (r.kind == msgChannelClose() || r.kind == msgChannelEof()) { return; }
    if (r.kind != msgChannelRequest()) { continue; }

    u8[] name = requestName(p);
    if (equal(name, "shell".toBytes())) { interactive = true; break; }
    if (equal(name, "pty-req".toBytes())) {
      // The modes in the request — speeds, `VERASE`, `ICANON` and the rest — are **not read**. What
      // this session does is one arrangement: canonical, echo on, which is what `packages/tty`
      // implements and what a client's default modes ask for anyway. A client that asks for raw mode
      // gets canonical, and that is a gap rather than a translation.
      pty = true;
      // **What the client said its terminal is.** design/0001 step 5 asks for "a `TERM` worth
      // setting", and every field of this request used to be dropped — so a session ran with no
      // `$TERM` and every program that asks what it is talking to got the empty string.
      terminal = readPtyReq(p);
      if (requestWantsReply(p)) { conn.sendPacket(channelSuccess(clientChannel)); }
      continue;
    }
    if (equal(name, "exec".toBytes())) {
      command = execCommand(p);
      // An `exec` we cannot read the command out of is a refusal, and it did want an answer.
      if (command.len() == 0 && requestWantsReply(p)) {
        conn.sendPacket(channelFailure(clientChannel));
      }
      continue;
    }
    if (equal(name, "window-change".toBytes())) {
      // The size can change after the `pty-req`, and a program that read `$COLUMNS` once would then
      // be wrong for the rest of the session. Kept, and the terminal *type* is not in this request —
      // only the size — so the type already read is left alone.
      Terminal now = readWindowChange(p);
      if (now.columns > 0) { terminal.columns = now.columns; terminal.rows = now.rows; }
      // No reply: RFC 4254 §6.7 defines `window-change` as wanting none, which is why it has no
      // `want_reply` field to read either.
      continue;
    }
    // Anything else — `env`, `signal` — is not honoured, and is answered only if it asked to be.
    if (requestWantsReply(p)) { conn.sendPacket(channelFailure(clientChannel)); }
  }
  if (command.len() == 0 && !interactive) {
    conn.fail("the client never asked to run anything");
    return;
  }
  if (!conn.sendPacket(channelSuccess(clientChannel))) { conn.fail("cannot accept the command"); return; }

  Result result = interactive
    ? interactiveSession(conn, cli, core, clientChannel, o, fs, pty, terminal)
    : run(cli, core, command, o, fs, terminal);
  if (conn.failed()) { return; }
  if (result.out.len() > 0) { conn.sendPacket(channelData(clientChannel, result.out)); }
  if (result.err.len() > 0) { conn.sendPacket(channelStderr(clientChannel, result.err)); }
  conn.sendPacket(exitStatus(clientChannel, result.status));
  conn.sendPacket(channelEof(clientChannel));
  conn.sendPacket(channelClose(clientChannel));

  // Wait for the client's own CHANNEL_CLOSE before letting the socket go.
  //
  // Not politeness: closing first makes the client report the clean end of a session as
  // "Connection closed by remote host". Sending SSH_MSG_DISCONNECT instead is worse — the client
  // treats it as an abnormal end, discards the output it has not read and exits 255. A channel
  // closes when *both* ends have said so, and only then is there nothing left to deliver.
  for (i32 i = 0; i < 8; i++) {
    u8[] p = conn.readPacket();
    if (conn.failed()) {
      // The client hanging up first is the ordinary case, not a failure to report.
      conn.error = "";
      return;
    }
    Incoming r = parse(p);
    if (r.ok && r.kind == msgChannelClose()) { return; }
  }
}

/**
 * An interactive session: read lines from the channel, run each, send the output back.
 *
 * One shell for the whole session, which is what makes it a session rather than a run of
 * unrelated commands — a variable set on one line is there on the next.
 *
 * A REPL needs no concurrency: the client sends a line and waits, so the ordinary blocking read
 * is the right shape. What it does need is to send each line's output *as it is produced* rather
 * than at the end, which is why this sends inside the loop rather than accumulating.
 *
 * No prompt is written. Without a pty a real shell is not interactive and prints none, so this
 * matches `ssh -T host` against a real sshd, which is also the only thing that can be compared
 * against it.
 *
 * ## With a pty, this end does the editing
 *
 * `pty` says the client asked for a terminal and got one, which means it has stopped echoing and put
 * its own terminal in raw mode: every keystroke arrives here on its own, and nothing appears on the
 * user's screen unless this sends it back. `packages/tty` is what decides what to send back and what
 * counts as a line — the same module a browser's keydown loop wants, which is why it is a package.
 *
 * Two consequences that are easy to miss and very visible:
 *
 * - **The shell's output needs `\r\n`.** A terminal in raw mode does not return the cursor on a bare
 *   newline, so output written with `\n` stair-steps down the screen. That translation is `ONLCR`, and
 *   it belongs here rather than in the shell, which is writing bytes rather than talking to a terminal.
 * - **`^C` still cannot interrupt a running command, and the reason has moved.** It is no longer that
 *   there is nothing to deliver: step 3's delivery half is in, and `kill -INT $$` ends a script here
 *   with 130. It is this loop's shape. `runScript` below is a blocking call, so while a line runs
 *   nothing reads the channel, and the `^C` the client sends sits in the socket until the command it
 *   was meant to end has finished. `^C` at a prompt throws away what has been typed and starts a fresh
 *   line, which is right and is all this can do.
 *
 *   What it wants is a way for a shell that is already busy to ask whether a keystroke has arrived.
 *   The machinery exists — `Core.waitAny(ids, 0)` is "which is ready right now", and standard input
 *   has a handle precisely so `waitAny` can watch it — but the channel is *this* function's socket
 *   rather than the shell's input, and wac has no closures, so handing the shell a way to ask means a
 *   funcref plus a token rather than a bound method. That is a design decision and it is not made
 *   here. Not approximated: `^C` does nothing to a running command, and says nothing either.
 */
Result interactiveSession(Conn conn, Cli cli, Core core, i32 channel, Options o, Fs fs, bool pty,
                          Terminal terminal) {
  Shell sh = sessionShell(core, cli, o, fs, terminal);
  Buf pending = Buf.create();
  Line tty = Line.create();

  while (true) {
    u8[] p = conn.readPacket();
    if (conn.failed()) {
      // The client hanging up ends the session; it is not an error to report.
      conn.error = "";
      return Result(u8[0](), u8[0](), sh.status);
    }
    Incoming m = parse(p);
    if (!m.ok) { conn.fail("a channel message did not parse"); return Result(u8[0](), u8[0](), 1); }

    if (m.kind == msgChannelEof() || m.kind == msgChannelClose()) { break; }
    if (m.kind != msgChannelData()) { continue; }

    if (pty) {
      // Keystroke by keystroke, through the discipline. Everything it says to echo goes straight back
      // — before the line is run, so what is typed appears as it is typed.
      for (i32 i = 0; i < m.data.len(); i++) {
        Typed t = tty.feed(m.data[i]);
        if (t.echo.len() > 0) { conn.sendPacket(channelData(channel, t.echo)); }
        if (t.interrupted()) { conn.sendPacket(channelData(channel, crlf())); continue; }
        if (t.eof) { return Result(u8[0](), u8[0](), sh.exiting ? sh.exitCode : sh.status); }
        if (!t.hasLine) { continue; }
        // The newline the discipline put on the end is for a program reading a stream; a command is a
        // string, so it comes off again.
        i32 end = t.line.len() > 0 && t.line[t.line.len() - 1] == 10 ? t.line.len() - 1 : t.line.len();
        u8[] cmd = u8[end]();
        cmd.copyFrom(t.line, 0, 0, end);
        runScript(sh, string.fromBytes(cmd));
        u8[] out = sh.outBuf.take();
        u8[] err = sh.errOut.take();
        if (out.len() > 0) { conn.sendPacket(channelData(channel, forTerminal(out))); }
        if (err.len() > 0) { conn.sendPacket(channelStderr(channel, forTerminal(err))); }
        if (sh.exiting) { return Result(u8[0](), u8[0](), sh.exitCode); }
      }
      continue;
    }

    pending.pushAll(m.data);
    // Run whole lines only. A client sends what it has, which may be half a line or three.
    while (true) {
      i32 nl = -1;
      for (i32 i = 0; i < pending.len; i++) {
        if (pending.get(i) == 10) { nl = i; break; }
      }
      if (nl < 0) { break; }
      // A line ends CRLF over SSH whenever the client has a terminal, and there is no terminal
      // driver here to fold it — so the carriage return would end up *in* the command, and
      // `exit\r` is not `exit`. Only the one at the line boundary goes; a `\r` anywhere else is
      // data the shell should see.
      i32 end = (nl > 0 && pending.get(nl - 1) == 13) ? nl - 1 : nl;
      u8[] line = u8[end]();
      line.copyFrom(pending.data, 0, 0, end);
      pending.dropFront(nl + 1);

      runScript(sh, string.fromBytes(line));
      u8[] out = sh.outBuf.take();
      u8[] err = sh.errOut.take();
      if (out.len() > 0) { conn.sendPacket(channelData(channel, out)); }
      if (err.len() > 0) { conn.sendPacket(channelStderr(channel, err)); }
      if (sh.exiting) { return Result(u8[0](), u8[0](), sh.exitCode); }
    }
  }

  // Anything typed without a final newline still runs, as a shell does at end of input.
  if (pending.len > 0) {
    runScript(sh, pending.toStr());
    u8[] out = sh.outBuf.take();
    u8[] err = sh.errOut.take();
    if (out.len() > 0) { conn.sendPacket(channelData(channel, out)); }
    if (err.len() > 0) { conn.sendPacket(channelStderr(channel, err)); }
  }
  return Result(u8[0](), u8[0](), sh.exiting ? sh.exitCode : sh.status);
}

/** A newline as a terminal in raw mode needs it: return, then feed. */
u8[] crlf() {
  u8[] out = u8[2](fill: 13);
  out[1] = 10;
  return out;
}

/**
 * A program's output, as a terminal in raw mode needs it: every `\n` becomes `\r\n`.
 *
 * `ONLCR`, which the kernel does for a program writing to a tty. Without it every line after the first
 * starts where the last one ended and the output walks off the right of the screen — the classic
 * stair-step, and the first thing anybody notices about a shell served over a raw channel.
 */
u8[] forTerminal(u8[] bytes) {
  Buf out = Buf.create();
  for (i32 i = 0; i < bytes.len(); i++) {
    if (bytes[i] == 10) { out.push(13); }
    out.push(bytes[i]);
  }
  return out.take();
}

/** The client's channel number out of a CHANNEL_OPEN for a session, or -1. */
struct Result {
  u8[] out;
  u8[] err;
  i32 status;
}

/**
 * Run the command with `packages/sh`.
 *
 * The server used to answer a handful of names it knew. It now hands the command string to a
 * shell, so `seq 1 100 | grep 7 | wc -l` works and so does `&&`, `$(…)`, quoting and redirection
 * — none of which the server itself knows anything about.
 *
 * The shell runs in *capturing* mode, which is the whole reason this is a two-line function: its
 * standard output collects into a buffer instead of going to the server's own terminal, and that
 * buffer is what goes down the channel.
 *
 * **It still cannot start a process** (issue 0015). The shell's external commands are its own,
 * written in wac — `help` lists them. What changed is that there is now a shell between the
 * client and them, not that there is a system underneath.
 *
 * The reach is bounded by what the server was granted: with `--allow-read` alone a client can read
 * what the server can read and write nothing. That is a real exposure and the operator chooses its
 * size, which is the capability world working as intended rather than a gap.
 */
Result run(Cli cli, Core core, u8[] command, Options o, Fs fs, Terminal terminal) {
  Shell sh = sessionShell(core, cli, o, fs, terminal);
  i32 status = runScript(sh, string.fromBytes(command));
  return Result(sh.outBuf.take(), sh.errOut.take(), status);
}

struct Options {
  i32 port;
  string hostKey;
  string authorizedKeys;
  /**
   * An image to serve sessions from, or empty for the host's filesystem.
   *
   * design/0001 step 7's criterion is "the ssh demo is one program that boots an image and serves
   * sessions from it", and this is that half of it: `sshd -i home.wacimg` hands every session the same
   * `Fs`, loaded once at startup and written back after each connection. What one client leaves behind,
   * the next one finds.
   *
   * Empty keeps what this program did before — `Shell.capturing` on `Fs.onHost`, reaching whatever the
   * server was granted. Which of the two a client gets is the operator's decision and not the client's,
   * which is the same shape as every other capability here.
   */
  string image;
  bool once;
  i32 exitCode;
}

Options parseArgs(Core core, Cli cli) {
  u8[]? homeRaw = cli.env("HOME").wait();
  string? home = homeRaw is null ? null : string.fromBytes(homeRaw!);
  string homeDir = (home is null) ? "" : home!;

  i32 port = defaultPort();
  string hostKey = "";
  string authorizedKeys = "";
  string image = "";
  bool once = false;

  i32 i = 0;
  i32 n = cli.argCount().wait();
  while (i < n) {
    string a = string.fromBytes(cli.arg(i).wait());
    if (a == "-p" && i + 1 < n) {
      i++;
      port = atoi(string.fromBytes(cli.arg(i).wait()));
      if (port <= 0 || port > 65535) {
        core.warn("sshd: bad port: " + string.fromBytes(cli.arg(i).wait()));
        return Options(0, "", "", "", false, 2);
      }
    } else if (a == "-h" && i + 1 < n) {
      i++;
      hostKey = string.fromBytes(cli.arg(i).wait());
    } else if (a == "-a" && i + 1 < n) {
      i++;
      authorizedKeys = string.fromBytes(cli.arg(i).wait());
    } else if (a == "-i" && i + 1 < n) {
      i++;
      image = string.fromBytes(cli.arg(i).wait());
    } else if (a == "-1") {
      once = true;
    } else {
      core.warn("usage: sshd [-p port] [-h hostkey] [-a authorized_keys] [-i image] [-1]");
      return Options(0, "", "", "", false, 2);
    }
    i++;
  }

  if (hostKey == "") {
    if (homeDir == "") {
      core.warn("sshd: HOME is unset, so there is no default host key — use -h");
      return Options(0, "", "", "", false, 2);
    }
    hostKey = homeDir + "/.ssh/ssh_host_ed25519_key";
  }
  if (authorizedKeys == "") {
    if (homeDir == "") {
      core.warn("sshd: HOME is unset, so there is no default authorized_keys — use -a");
      return Options(0, "", "", "", false, 2);
    }
    authorizedKeys = homeDir + "/.ssh/authorized_keys";
  }
  return Options(port, hostKey, authorizedKeys, image, once, -1);
}

i32 atoi(string s) {
  i32 v = 0;
  for (i32 i = 0; i < s.len(); i++) {
    string ch = s[i];
    if (ch < "0" || ch > "9") { return -1; }
    v = v * 10 + (ch.toBytes()[0] - 0x30);
    if (v > 65535) { return -1; }
  }
  return s.len() == 0 ? -1 : v;
}

