// The two files a client and a server read: `known_hosts` and `authorized_keys`.
//
// Both are parsed by hand from a text format with no grammar anywhere except OpenSSH's own source,
// and both have the same failure mode: a line the parser cannot read must be *skipped*, not fatal
// and not silently treated as a match. A file may legitimately contain entries for algorithms we do
// not implement.
//
// The cases here are the ones where being wrong looks like being right. A `command="…"` option
// contains spaces and commas; splitting the options field on the first space finds a key type where
// there is none, which reads as "this line is not for you" — so a **restricted** key slips through
// as *unknown*, which a server then treats as an ordinary refusal rather than a misconfiguration.
// And a `@cert-authority` line names a CA rather than this host's key, so comparing it as one turns
// every CA-signed host into a mismatch.
//
// The hashed `known_hosts` form has no oracle that can live here — `HashKnownHosts` is on by default
// and a real entry is `|1|<salt>|<HMAC-SHA-1(salt, name)>`, so the only way to know it is right is a
// file OpenSSH wrote. That is `live_test.wac`'s.
//
// Host-side until 2026-08-18, `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { ALPHABET_STANDARD, encode as b64Encode } from "../../../codec/src/base64.wac";
import { Verdict, lookUp as knownHost } from "../../src/knownhosts.wac";
import { Match, lookUp as authorized } from "../../src/authorizedkeys.wac";
import { ramp } from "./build.wac";

/** A `Verdict` as its own name, so a failure says which of the four it was. */
string verdictName(Verdict v) {
  match (v) {
    case Unknown: return "unknown";
    case Match: return "match";
    case Mismatch: return "mismatch";
    else: return "revoked";
  }
}

string matchName(Match m) {
  match (m) {
    case Unknown: return "unknown";
    case Ok: return "ok";
    else: return "restricted";
  }
}

string base64(u8[] b) { return string.fromBytes(b64Encode(b, ALPHABET_STANDARD(), true)); }

export string test_known_hosts_plain_entries_patterns_negation_markers_and_comments() {
  T t = T.create();
  u8[] type = ("ssh-ed25519").toBytes();
  u8[] blob = ramp(51, 3, 0);
  u8[] other = ramp(51, 5, 0);
  string b64 = base64(blob);
  string otherB64 = base64(other);

  // Exact, comments and blank lines.
  t.eqStr(look("# a comment\n\nexample.com ssh-ed25519 " + b64 + " me@here\n", "example.com", 22,
               blob, type),
          "match", "a plain entry with a trailing comment");
  // Several names on one line.
  t.eqStr(look("a.example,b.example,c.example ssh-ed25519 " + b64 + "\n", "b.example", 22, blob,
               type),
          "match", "a middle name in a list");
  // Patterns.
  t.eqStr(look("*.example ssh-ed25519 " + b64 + "\n", "host.example", 22, blob, type),
          "match", "* did not match");
  t.eqStr(look("*.example ssh-ed25519 " + b64 + "\n", "example", 22, blob, type),
          "unknown", "* matched too much");
  t.eqStr(look("h??t.example ssh-ed25519 " + b64 + "\n", "host.example", 22, blob, type),
          "match", "? did not match");
  t.eqStr(look("h??t.example ssh-ed25519 " + b64 + "\n", "hoost.example", 22, blob, type),
          "unknown", "? matched two characters");
  // A negation vetoes the whole entry even though the wildcard matches.
  t.eqStr(look("*.example,!bad.example ssh-ed25519 " + b64 + "\n", "bad.example", 22, blob, type),
          "unknown", "a negation did not veto the entry");
  t.eqStr(look("*.example,!bad.example ssh-ed25519 " + b64 + "\n", "good.example", 22, blob, type),
          "match", "a negation vetoed an unrelated host");
  // Known host, different key.
  t.eqStr(look("example.com ssh-ed25519 " + otherB64 + "\n", "example.com", 22, blob, type),
          "mismatch", "a different key was not a mismatch");
  // A second line with the right key still matches, even after a wrong one.
  t.eqStr(look("example.com ssh-ed25519 " + otherB64 + "\nexample.com ssh-ed25519 " + b64 + "\n",
               "example.com", 22, blob, type),
          "match", "a matching line after a non-matching one did not win");
  // @revoked outranks everything, wherever it appears.
  t.eqStr(look("example.com ssh-ed25519 " + b64 + "\n@revoked example.com ssh-ed25519 " + b64 +
               "\n", "example.com", 22, blob, type),
          "revoked", "a revocation did not outrank a match");
  // @cert-authority describes a CA, not this host key: it must not be compared as one.
  t.eqStr(look("@cert-authority *.example ssh-ed25519 " + otherB64 + "\n", "host.example", 22,
               blob, type),
          "unknown", "a cert-authority line was treated as a host key");
  // A non-default port uses the bracketed form.
  t.eqStr(look("[example.com]:2222 ssh-ed25519 " + b64 + "\n", "example.com", 2222, blob, type),
          "match", "the bracketed port form");
  t.eqStr(look("example.com ssh-ed25519 " + b64 + "\n", "example.com", 2222, blob, type),
          "unknown", "a bare name matched a non-default port");
  // Junk lines are ignored rather than fatal — a file may have entries we cannot read.
  t.eqStr(look("garbage\nexample.com ssh-ed25519 !!!not base64!!!\nexample.com ssh-ed25519 " +
               b64 + "\n", "example.com", 22, blob, type),
          "match", "an unreadable line stopped a later valid one from matching");
  t.eqStr(look("", "example.com", 22, blob, type), "unknown", "an empty file was not unknown");
  return t.report();
}

string look(string file, string host, i32 port, u8[] key, u8[] type) {
  return verdictName(knownHost(file.toBytes(), host.toBytes(), port, type, key));
}

export string test_authorized_keys_a_key_is_found_and_options_are_refused_rather_than_ignored() {
  T t = T.create();
  u8[] blob = ramp(51, 3, 0);
  u8[] other = ramp(51, 5, 0);
  string b64 = base64(blob);
  u8[] type = ("ssh-ed25519").toBytes();

  t.eqStr(auth("ssh-ed25519 " + b64 + " me@here\n", blob, type), "ok", "a plain line");
  t.eqStr(auth("# comment\n\nssh-ed25519 " + b64 + "\n", blob, type), "ok", "comments broke the scan");
  t.eqStr(auth("ssh-ed25519 " + b64 + "\n", other, type), "unknown", "a different key matched");
  t.eqStr(auth("", blob, type), "unknown", "an empty file matched");
  t.eqStr(auth("ssh-rsa " + b64 + "\n", blob, type), "unknown", "another algorithm matched");

  // Options are parsed and the line is refused, because a server that reads a restriction and
  // ignores it is worse than one that refuses: the operator wrote it expecting it to hold.
  t.eqStr(auth("no-pty ssh-ed25519 " + b64 + "\n", blob, type), "restricted", "an option was ignored");
  t.eqStr(auth("restrict,pty ssh-ed25519 " + b64 + "\n", blob, type), "restricted",
          "options were ignored");

  // `command="…"` contains spaces and commas. Splitting the options field on the first space
  // finds a key type where there is none, which reads as "this line is not for you" — so a
  // restricted key would slip through as *unknown* rather than as restricted.
  t.eqStr(auth("command=\"echo hello world\" ssh-ed25519 " + b64 + "\n", blob, type), "restricted",
          "a quoted option with spaces was mis-parsed");
  t.eqStr(auth("command=\"a,b c\",no-pty ssh-ed25519 " + b64 + "\n", blob, type), "restricted",
          "a quoted option with a comma was mis-parsed");
  t.eqStr(auth("command=\"say \\\"hi\\\" now\" ssh-ed25519 " + b64 + "\n", blob, type), "restricted",
          "an escaped quote inside an option was mis-parsed");

  // An unrestricted line elsewhere in the file wins: the key is allowed outright.
  t.eqStr(auth("no-pty ssh-ed25519 " + b64 + "\nssh-ed25519 " + b64 + "\n", blob, type), "ok",
          "a plain line after a restricted one did not win");
  // Junk is skipped rather than fatal.
  t.eqStr(auth("garbage\nssh-ed25519 !!!\nssh-ed25519 " + b64 + "\n", blob, type), "ok",
          "an unreadable line stopped a later valid one");
  return t.report();
}

string auth(string file, u8[] key, u8[] type) {
  return matchName(authorized(file.toBytes(), type, key));
}
