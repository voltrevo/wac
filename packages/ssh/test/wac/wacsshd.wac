// Our own `sshd`, built and running, for the tests that point the other way.
//
// Every other test in this package runs our code against OpenSSH's. These run OpenSSH's against
// ours, which is worth having for exactly that reason: the server offers algorithm lists a real
// client negotiates against, *signs* an exchange hash rather than verifying one, answers the key
// probe, and picks the channel number the client then has to use. None of that is reachable from
// the client side, and a second implementation of my own misconceptions would agree with itself.
//
// ## Built once, and run as a program
//
// `wac build packages/ssh/src/sshd.wac -o <stem>` writes `<stem>.wasm` and `<stem>.json` — the
// manifest carrying the grants, which is what a non-JavaScript host reads. `wac <stem>.wasm args…`
// then runs it. About eight seconds, so the result is cached under `.cache` and reused: three of
// these tests in one file would otherwise pay for three builds.
//
// **Two binaries, differing in one grant, and the difference is the point.** The ordinary one cannot
// write. Every test here except the image ones is about what a *read-only* server does, and widening
// its grants to suit one test would quietly widen what all of them prove — the first thing the image
// tests found was this server warning that it could not save and carrying on, which is the right
// behaviour and an invisible one.
//
// ## Typing at it
//
// `Cli.spawn` takes a wac worker bundle, so it cannot drive OpenSSH's `ssh` — and several of these
// tests have to type into an interactive session over time. So the producer is a shell line piped
// into `ssh`, which `Cli.exec` runs to completion — `typedInto` below.
//
// **Some of them do decide when to type from what came back**, which the fixed-pause version could
// not express: the pauses were `sleep`s long enough to be safe on a loaded machine, and three of them
// were 9.7s of every run. `typedIntoWatching` tees the session's output to a file and gives the
// producer a `seen <pattern> [count]` function, so a pause ends when its evidence arrives. What a
// producer still cannot do is decide *what* to type from what came back — the text is fixed, only its
// timing is not.

import { T } from "../../../wactest/src/assert.wac";
import { Cli, Core, Exec, FileResult, Stat } from "std/platform.wac";
import { Daemon, Held, logOf, start, stop } from "../../../wactest/src/daemon.wac";
import { onlyEnv, onlyEnvLine, quoted } from "../../../wactest/src/childenv.wac";
import { contains, splitLines, trimmed } from "../../../wactest/src/strings.wac";
import { atoi, itoa } from "../../../fmt/src/itoa.wac";
import { scratch } from "./fixture.wac";
import { copyPreserving, keygen, restrict } from "../../../wactest/src/keys.wac";

/** Our server, running, with a host key and one authorized client key. */
export struct Wacsshd {
  bool ok;
  string error;
  string dir;
  i32 port;
  Daemon daemon;

  /** Whatever the server wrote about itself — the startup line, and any complaint. */
  string said(const this, Cli cli) { return logOf(cli, this.daemon); }
}

/** The wac binary, which is both the compiler and the host that runs a built module. */
string wacBinary(Cli cli) { return cli.cwd().wait() + "/native/v8/target/release/wac"; }

/**
 * `packages/ssh/src/sshd.wac`, built once and cached.
 *
 * `writable` adds `--allow-write`, which is a different binary and deliberately so — see the header.
 * Empty on failure, with `t` already told why.
 */
export string buildServer(T t, Cli cli, bool writable) {
  string dir = cli.cwd().wait() + "/.cache/wacsshd";
  cli.mkdir(dir, true).wait();
  string stem = dir + (writable ? "/sshd-writable" : "/sshd");

  // Reused when it is already there and no older than its own source. `wac build` rewrites it, so a
  // stale one cannot survive a rebuild — but it can survive *not* rebuilding, which is what the
  // mtime comparison is for.
  Stat built = cli.stat(stem + ".wasm").wait();
  Stat source = cli.stat("packages/ssh/src/sshd.wac").wait();
  if (built.isFile && source.isFile && built.modifiedMillis > source.modifiedMillis) {
    return stem + ".wasm";
  }

  string[] args = writable
    ? string[]("build", "packages/ssh/src/sshd.wac", "-o", stem, "--allow-read", "--allow-write",
               "--allow-net", "--allow-env", "--quiet")
    : string[]("build", "packages/ssh/src/sshd.wac", "-o", stem, "--allow-read", "--allow-net",
               "--allow-env", "--quiet");
  Exec r = cli.exec(wacBinary(cli), args, u8[0]()).wait();
  t.isTrue(r.ran(), "the wac binary ran — " + r.error);
  t.eqI32(r.status, 0, "building sshd.wac: " + string.fromBytes(r.stderr));
  return r.ran() && r.status == 0 ? stem + ".wasm" : "";
}

/**
 * The abandoned servers of runs that were killed, cleared before starting another.
 *
 * The same argument as `fixture.wac`'s reaper and the same shape of pattern: `wacsshd` is this
 * fixture's own cache path, so nothing else on the machine can match, and `ppid == 1` means a live
 * test's server — or another agent's — is never touched. wac-mono 0073.
 */
void reapAbandoned(Cli cli) {
  cli.exec("/bin/sh", string[]("-c", WACSSHD_REAP + "kill \"$pid\" 2>/dev/null; done; true"),
           u8[0]()).wait();
}

const string WACSSHD_REAP =
  "ps -eo pid=,ppid=,args= 2>/dev/null | while read pid ppid rest; do " +
  "  case \"$ppid\" in 1) ;; *) continue;; esac; " +
  "  case \"$rest\" in *'/.cache/wacsshd/sshd'*'.wasm'*) ;; *) continue;; esac; ";

/** Which pids `reapAbandoned` would kill — for the test that the pattern selects anything. */
export string reapSelectsServers(Cli cli) {
  Exec r = cli.exec("/bin/sh", string[]("-c", WACSSHD_REAP + "echo \"$pid\"; done"),
                    u8[0]()).wait();
  return string.fromBytes(r.stdout);
}

/**
 * Start one, retrying a port somebody else took between the probe and the bind.
 *
 * A bind failure is the *only* thing retried — anything else is a real failure and is reported on
 * the first attempt, because retrying those turns one clear error into three slow ones. `Held` makes
 * the window as small as it can be; it cannot close it, because the server binds in another process.
 */
export Wacsshd startWacsshd(T t, Core core, Cli cli, string name, string[] extra, string binary) {
  reapAbandoned(cli);
  for (i32 attempt = 1; attempt <= 3; attempt++) {
    Wacsshd s = startOnce(t, core, cli, name, extra, binary);
    if (s.ok) { return s; }
    if (!contains(s.error, "Address already in use") && !contains(s.error, "already in use")) {
      return s;
    }
    stopWacsshd(cli, s);
  }
  return Wacsshd(false, "the port was taken on all three attempts", "", -1, Daemon(-1, "", ""));
}

Wacsshd startOnce(T t, Core core, Cli cli, string name, string[] extra, string binary) {
  string dir = scratch(cli, name);
  cli.mkdir(dir + "/.ssh", true).wait();
  if (!keygen(t, cli, dir + "/.ssh/ssh_host_ed25519_key")) {
    return Wacsshd(false, "ssh-keygen failed for the host key", dir, -1, Daemon(-1, "", ""));
  }
  if (!keygen(t, cli, dir + "/clientkey")) {
    return Wacsshd(false, "ssh-keygen failed for the client key", dir, -1, Daemon(-1, "", ""));
  }
  restrict(cli, dir + "/.ssh/ssh_host_ed25519_key");
  restrict(cli, dir + "/clientkey");
  copyPreserving(cli, dir + "/clientkey.pub", dir + "/.ssh/authorized_keys");

  Held held = Held.take(cli);
  if (held.port < 0) { return Wacsshd(false, "no port could be bound", dir, -1, Daemon(-1, "", "")); }
  i32 port = held.port;

  // `env HOME=…` rather than a bare assignment: `start` puts `exec` at the front of the line, and
  // `exec HOME=x prog` is not a command — the assignment has to be a program's argument, not a
  // prefix `exec` will try to run.
  string line = "env HOME=" + quoted(dir) + " " + quoted(wacBinary(cli)) + " " + quoted(binary) +
                " -p " + itoa(port);
  for (i32 i = 0; i < extra.len(); i++) { line = line + " " + quoted(extra[i]); }

  held.release(cli);   // the next statement binds it
  Daemon d = start(cli, line, dir + "/sshd.log");
  if (!d.ok()) { return Wacsshd(false, "the server did not start — " + d.error, dir, port, d); }

  // **Wait for the announcement rather than for the socket.** A successful connect only proves the
  // listener is bound; the startup line is written around the same moment, and a test that read
  // stderr could otherwise kill the server before it had been flushed — about one parallel run in
  // ten, always in the one test that reads it. `issues/system/0026`.
  //
  // **A deadline, and it used to be 2000 iterations.** Neither half of that loop cost what it looked
  // like: reading the log is a syscall, so the "bound" was a few hundred milliseconds of patience that
  // shrank as the box got busier, and the liveness check spawned `/bin/sh -c 'kill -0'` *per
  // iteration* — a readiness check that was itself one of the heaviest things in this file. Now it
  // sleeps between looks, so five seconds is five seconds, and asks whether the server is still there
  // every fifth look rather than every one.
  Wacsshd s = Wacsshd(true, "", dir, port, d);
  i64 deadline = core.nowMillis().wait() + 5000;
  for (i32 i = 0; i < 100000; i++) {
    string said = s.said(cli);
    if (contains(said, "listening on port")) { return s; }
    // And it stops the moment the process dies: a server that refused its host key or could not bind
    // says exactly why and exits in milliseconds, and waiting the full bound for something that has
    // stopped happening reports the wrong failure twice over — the second time by hiding the message
    // that explains the first.
    if (i % 5 == 0 && !alive(cli, d)) {
      return Wacsshd(false, "the server exited before it announced anything. It said: " +
                            (said == "" ? "nothing" : said), dir, port, d);
    }
    if (core.nowMillis().wait() >= deadline) { break; }
    core.sleepMillis(5).wait();
  }
  return Wacsshd(false, "the server never announced a port. It said: " +
                        (s.said(cli) == "" ? "nothing" : s.said(cli)), dir, port, d);
}

bool alive(Cli cli, Daemon d) {
  Exec r = cli.exec("/bin/sh", string[]("-c", "kill -0 " + itoa(d.pid) + " 2>/dev/null"),
                    u8[0]()).wait();
  return r.ran() && r.status == 0;
}

/** Stop it and remove its directory, whether or not it ever came up. */
export void stopWacsshd(Cli cli, Wacsshd s) {
  stop(cli, s.daemon);
  if (s.dir != "") { cli.remove(s.dir, true).wait(); }
}

/**
 * What OpenSSH's client says to our server, and what comes back.
 *
 * **`-F /dev/null` is why a real bug lived here as long as it did.** Discarding the system config
 * makes the test reproducible, and it also removes `SendEnv LANG LC_*` — the Debian and Ubuntu
 * default — so the client never sent the `env` requests that broke the server. `extra` exists to
 * put them back; there is a test named for it.
 *
 * The environment is cleared rather than added to, for the same reason: the client reads `LANG` and
 * `LC_*` itself, so inheriting the host's would make what the server receives depend on the machine.
 */
export string[] sshArgs(Wacsshd s, string key, string[] extra) {
  string[] head = string[]("-F", "/dev/null", "-i", key, "-p", itoa(s.port),
                           "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
                           "-o", "BatchMode=yes");
  string[] out = string[head.len() + extra.len()](fill: "");
  for (i32 i = 0; i < head.len(); i++) { out[i] = head[i]; }
  for (i32 i = 0; i < extra.len(); i++) { out[head.len() + i] = extra[i]; }
  return out;
}

/** The client's stdout, stderr and status, with the host-key notice taken out of stderr. */
export struct Said {
  i32 status;
  string stdout;
  string stderr;
}

/** `ssh … <command>`, run to completion. */
export Said realSsh(Cli cli, Wacsshd s, string command, string key, string[] extra) {
  return realSshEnv(cli, s, command, key, extra, string[0](fill: ""), string[0](fill: ""));
}

/**
 * The same, with extra environment for the *client*.
 *
 * One test needs it: `TERM` is what the client puts in its `pty-req`, so a test of what the session
 * learns about its terminal has to set it here rather than send it as a command.
 */
export Said realSshEnv(Cli cli, Wacsshd s, string command, string key, string[] extra,
                       string[] names, string[] values) {
  string[] args = withTail(sshArgs(s, key, extra), string[]("claude@127.0.0.1", command));
  string[] allNames = withTail(string[]("LANG", "LC_ALL", "HOME", "PATH"), names);
  string[] allValues = withTail(
    string[]("C.UTF-8", "C.UTF-8", s.dir, "/usr/bin:/bin:/usr/local/bin"), values);
  return said(onlyEnv(cli, allNames, allValues, "ssh", args));
}

/** `ssh` with the argument list given outright, for the cases the shape above cannot express. */
export Said rawSsh(Cli cli, Wacsshd s, string[] args) {
  return said(onlyEnv(cli, string[]("LANG", "LC_ALL", "HOME", "PATH"),
                      string[]("C.UTF-8", "C.UTF-8", s.dir, "/usr/bin:/bin:/usr/local/bin"),
                      "ssh", args));
}

/**
 * `packages/ssh/src/ssh.wac`, built once and cached — our own client.
 *
 * The built program rather than a launcher that spawns it: a launcher forwards no signals, so each
 * call left an orphan behind. wac-mono 0017.
 */
export string buildClient(T t, Cli cli, bool writable) {
  string dir = cli.cwd().wait() + "/.cache/wacsshd";
  cli.mkdir(dir, true).wait();
  string stem = dir + (writable ? "/ssh-writable" : "/ssh");
  Stat built = cli.stat(stem + ".wasm").wait();
  Stat source = cli.stat("packages/ssh/src/ssh.wac").wait();
  if (built.isFile && source.isFile && built.modifiedMillis > source.modifiedMillis) {
    return stem + ".wasm";
  }
  // **Two binaries, because the grants are the point of one of the tests.** They are baked in at
  // build time, so a single permissive binary would quietly pass the case that checks `-k` is
  // refused *without* `--allow-write` — the test would still be green and would no longer be
  // testing anything. My first version of this took the argument and ignored it.
  string[] args = writable
    ? string[]("build", "packages/ssh/src/ssh.wac", "-o", stem, "--allow-read", "--allow-net",
               "--allow-env", "--allow-write", "--quiet")
    : string[]("build", "packages/ssh/src/ssh.wac", "-o", stem, "--allow-read", "--allow-net",
               "--allow-env", "--quiet");
  Exec r = cli.exec(wacBinary(cli), args, u8[0]()).wait();
  t.isTrue(r.ran(), "the wac binary ran — " + r.error);
  t.eqI32(r.status, 0, "building ssh.wac: " + string.fromBytes(r.stderr));
  return r.ran() && r.status == 0 ? stem + ".wasm" : "";
}

/** Our own client with extra environment — `SSH_PASSPHRASE` is what needs it. */
export Said ourSshEnv(Cli cli, string client, string home, string[] args, string[] names,
                      string[] values) {
  string[] argv = withTail(string[](client), args);
  string[] allNames = withTail(string[]("HOME", "USER", "PATH"), names);
  string[] allValues = withTail(string[](home, "claude", "/usr/bin:/bin:/usr/local/bin"), values);
  return said(onlyEnv(cli, allNames, allValues, wacBinary(cli), argv));
}

/** Our own client, with `home` as its `HOME`. */
export Said ourSsh(Cli cli, string client, string home, string[] args) {
  string[] argv = withTail(string[](client), args);
  return said(onlyEnv(cli, string[]("HOME", "USER", "PATH"),
                      string[](home, "claude", "/usr/bin:/bin:/usr/local/bin"),
                      wacBinaryPath(cli), argv));
}

string wacBinaryPath(Cli cli) { return wacBinary(cli); }

/**
 * A fixed byte sequence typed into an interactive `ssh`, with pauses.
 *
 * `producer` is a shell line whose standard output becomes the client's standard input — a sequence
 * of `printf` and `sleep`. Written as shell rather than driven from here because `Cli.spawn` takes a
 * wac worker bundle and OpenSSH's client is not one, so there is no way to hold its stdin open from
 * this side.
 *
 * **Prefer `typedIntoWatching` when a pause is waiting for something.** A `sleep` long enough to be
 * safe on a loaded machine is a cost paid on every run — three of them here came to 9.7s — and it is
 * the wrong shape besides: it asserts a duration where the case is about an event.
 */
export Said typedInto(Cli cli, Wacsshd s, string[] extra, string producer) {
  string[] args = withTail(sshArgs(s, s.dir + "/clientkey", extra), string[]("claude@127.0.0.1"));
  string line = onlyEnvLine(string[]("LANG", "LC_ALL", "HOME", "PATH"),
                            string[]("C.UTF-8", "C.UTF-8", s.dir, "/usr/bin:/bin:/usr/local/bin"),
                            "ssh", args);
  Exec r = cli.exec("/bin/sh", string[]("-c", "{ " + producer + " ; } | " + line), u8[0]()).wait();
  return said(r);
}

/**
 * The same, and the producer can **watch what the session has said so far**.
 *
 * The session's output is `tee`d to a file, and the producer gets one shell function:
 *
 *     seen <pattern> [count]     wait until the output matches at least `count` times, or give up
 *
 * So `sleep 6` — long enough for a command to finish on a loaded machine — becomes `seen done=200000`,
 * which is that command's own answer arriving. The wait is bounded at 10s and returns non-zero when
 * it expires rather than hanging: a case whose evidence never appears then fails on its own
 * assertion, with the output in the message, instead of on a timeout with none.
 *
 * The count matters where a marker can arrive early for another reason. A line typed at a terminal in
 * raw mode is echoed as it is typed, so `typed-ahead` appears once while the command is still running
 * and again when it runs — and `seen typed-ahead` alone would fire on the echo, which is the pause
 * ending exactly where the case needs it not to.
 */
export Said typedIntoWatching(Cli cli, Wacsshd s, string[] extra, string producer) {
  string[] args = withTail(sshArgs(s, s.dir + "/clientkey", extra), string[]("claude@127.0.0.1"));
  string line = onlyEnvLine(string[]("LANG", "LC_ALL", "HOME", "PATH"),
                            string[]("C.UTF-8", "C.UTF-8", s.dir, "/usr/bin:/bin:/usr/local/bin"),
                            "ssh", args);
  // `grep -c` prints 0 and exits 1 when nothing matches, so the count is read and defaulted rather
  // than taken from the exit status.
  string prelude =
    "O=" + s.dir + "/watched.out; : > \"$O\"; " +
    "seen() { p=\"$1\"; c=\"${2:-1}\"; n=0; " +
    "while [ $n -lt 200 ]; do " +
    "got=$(grep -c -e \"$p\" \"$O\" 2>/dev/null); [ -z \"$got\" ] && got=0; " +
    "if [ \"$got\" -ge \"$c\" ]; then return 0; fi; " +
    "sleep 0.05; n=$((n+1)); done; " +
    // **An expired wait says so.** It is the failure mode of this whole helper: the producer carries
    // on regardless, the case's own assertion may still pass, and all that is visible is a test that
    // took ten seconds. Two of these were expiring when they were first written and the only symptom
    // was the file getting slower.
    "echo \"seen: gave up waiting for [$p] x$c after 10s\" >&2; return 1; }; ";
  // **Redirected rather than `tee`d, because `tee` buffers.** The first version piped the client
  // through `tee` so the bytes went to the file *and* to this process's stdout — and every wait for a
  // short output expired, because `tee` holds a partial block back. Nothing said so: the producer
  // carried on, the assertions passed on the session's final transcript, and the only symptom was the
  // file getting slower than the `sleep`s it replaced. `ssh` writes to fd 1 itself, with no stdio
  // layer in the way, so the redirection is visible to `grep` as it happens.
  //
  // The status comes from a file for the same reason it would have with `tee`: a pipeline reports its
  // last command, and `sh` here is `dash`, which has no `pipefail`.
  Exec r = cli.exec("/bin/sh",
                    string[]("-c", prelude + "{ " + producer + " ; } | { " + line +
                                   " > \"$O\" ; echo $? > \"$O.rc\" ; }"),
                    u8[0]()).wait();
  Said out = said(r);
  FileResult got = cli.readFile(s.dir + "/watched.out").wait();
  string text = got.ok ? string.fromBytes(got.bytes) : out.stdout;
  FileResult rc = cli.readFile(s.dir + "/watched.out.rc").wait();
  i32 status = rc.ok ? atoi(trimmed(string.fromBytes(rc.bytes))) : out.status;
  return Said(status, text, out.stderr);
}

Said said(Exec r) {
  // The client writes its host key notice to stderr; it is not the command's output.
  string[] lines = splitLines(string.fromBytes(r.stderr));
  string kept = "";
  for (i32 i = 0; i < lines.len(); i++) {
    if (lines[i].len() >= 27 && lines[i].slice(0, 27) == "Warning: Permanently added ") { continue; }
    kept = kept + (kept == "" ? "" : "\n") + lines[i];
  }
  return Said(r.status, string.fromBytes(r.stdout), kept);
}

string[] withTail(string[] head, string[] tail) {
  string[] out = string[head.len() + tail.len()](fill: "");
  for (i32 i = 0; i < head.len(); i++) { out[i] = head[i]; }
  for (i32 i = 0; i < tail.len(); i++) { out[head.len() + i] = tail[i]; }
  return out;
}
