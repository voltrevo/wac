// The `ssh` program, run as a program.
//
// Everything else in this package tests the protocol as a library, with the test playing the client.
// This runs the thing a user would run: the whole application, against a real sshd — argument
// parsing, the private key read off disk, known_hosts consulted, output on the right stream, and the
// command's exit status as the process's own.
//
// It is worth having separately because every one of those is outside the protocol and none of them
// is exercised by the transport tests.
//
// test-lane: exclusive — drives a real `ssh` binary against a real server.
//
// Host-side until 2026-08-18, `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli, Exec } from "../../../platform/src/platform.wac";
import { ALPHABET_STANDARD, encode as b64Encode } from "../../../codec/src/base64.wac";
import { contains, trimmed } from "../../../wactest/src/strings.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { Said, buildClient, ourSsh, ourSshEnv } from "./wacsshd.wac";
import { Sshd, copyPreserving, haveSshd, publicBlobText, restrict, startSshd, stopSshd }
  from "./fixture.wac";
import { ramp } from "./build.wac";

/** A HOME with an `.ssh` the program will find by its own defaults. */
string makeHome(T t, Cli cli, Sshd s, bool knownHost) {
  string home = s.dir + "/home";
  cli.mkdir(home + "/.ssh", true).wait();
  copyPreserving(cli, s.dir + "/clientkey", home + "/.ssh/id_ed25519");
  restrict(cli, home + "/.ssh/id_ed25519");
  if (knownHost) {
    string blob = publicBlobText(cli, s.dir + "/hostkey.pub");
    t.isTrue(blob != "", "the server's host key could not be read");
    cli.writeFile(home + "/.ssh/known_hosts",
                  ("[127.0.0.1]:" + itoa(s.port) + " ssh-ed25519 " + blob + "\n").toBytes()).wait();
  }
  return home;
}

/** `-p <port> 127.0.0.1`, which every case here needs. */
string[] target(Sshd s) { return string[]("-p", itoa(s.port), "127.0.0.1"); }

string[] plus(string[] head, string[] tail) {
  string[] out = string[head.len() + tail.len()](fill: "");
  for (i32 i = 0; i < head.len(); i++) { out[i] = head[i]; }
  for (i32 i = 0; i < tail.len(); i++) { out[head.len() + i] = tail[i]; }
  return out;
}

export string test_the_ssh_program_runs_a_command_on_a_real_server_end_to_end(Core core, Cli cli) {
  T t = T.create();
  if (!haveSshd(cli)) { return t.report(); }
  string client = buildClient(t, cli, false);
  if (client == "") { return t.report(); }
  Sshd s = startSshd(t, cli, "ssh-cli-run");
  if (!s.ok) { t.fail("sshd did not come up — " + s.error); stopSshd(cli, s); return t.report(); }
  string home = makeHome(t, cli, s, true);
  string[] p = target(s);

  // Standard output, byte for byte, with nothing of the client's mixed in.
  Said echo = ourSsh(cli, client, home, plus(p, string[]("echo", "hello", "from", "wac")));
  t.eqI32(echo.status, 0, "exit " + itoa(echo.status) + ": " + echo.stderr);
  t.eqStr(echo.stdout, "hello from wac\n", "stdout");

  // The command's exit status becomes the program's. Quoting survives because the whole command is
  // one argument — the same as OpenSSH, which also joins argv with spaces.
  Said failed = ourSsh(cli, client, home,
                       plus(p, string[]("sh -c 'echo OUT; echo ERR >&2; exit 7'")));
  t.eqI32(failed.status, 7, "the command's exit status did not become the program's");
  t.eqStr(failed.stdout, "OUT\n", "stdout");
  t.isTrue(contains(failed.stderr, "ERR"), "stderr was \"" + failed.stderr + "\"");
  // The client's own diagnostics must not land in the command's output.
  t.isFalse(contains(failed.stderr, "ssh:"), "unexpected client error: " + failed.stderr);

  // Binary, larger than one window, byte-exact — which needs flow control to be right and nothing
  // on the path to assume text.
  i32 size = 300000;
  Said binary = ourSsh(cli, client, home,
                       plus(p, string[]("head -c " + itoa(size) + " /dev/urandom | base64 -w0")));
  t.eqI32(binary.status, 0, "exit " + itoa(binary.status) + ": " + binary.stderr);
  string encoded = trimmed(binary.stdout);
  t.isTrue(encoded.len() >= size,
           "got " + itoa(encoded.len()) + " base64 characters for " + itoa(size) + " bytes");
  t.isTrue(isBase64(encoded), "the output is not intact base64");

  stopSshd(cli, s);
  return t.report();
}

export string test_the_ssh_program_refuses_an_unknown_host_and_reports_a_changed_one(
    Core core, Cli cli) {
  T t = T.create();
  if (!haveSshd(cli)) { return t.report(); }
  string plain = buildClient(t, cli, false);
  string writable = buildClient(t, cli, true);
  if (plain == "" || writable == "") { return t.report(); }
  Sshd s = startSshd(t, cli, "ssh-cli-hosts");
  if (!s.ok) { t.fail("sshd did not come up — " + s.error); stopSshd(cli, s); return t.report(); }
  string home = makeHome(t, cli, s, false);          // no known_hosts at all
  string[] p = target(s);
  string blob = publicBlobText(cli, s.dir + "/hostkey.pub");
  t.isTrue(blob != "", "the server's host key could not be read");

  // Unknown is refused rather than accepted with a warning, and the refusal is actionable: it
  // prints the exact line to add.
  Said unknown = ourSsh(cli, plain, home, plus(p, string[]("echo", "should", "not", "run")));
  t.neI32(unknown.status, 0, "an unknown host was accepted");
  t.eqStr(unknown.stdout, "", "the command ran against an unknown host");
  t.isTrue(contains(unknown.stderr, "is not in"), "unhelpful refusal: " + unknown.stderr);
  t.isTrue(contains(unknown.stderr, blob), "the refusal did not print the host key line to add");

  // `-k` records it, needs the write grant, and then the command runs.
  Said added = ourSsh(cli, writable, home, plus(string[]("-k"), plus(p, string[]("echo", "added"))));
  t.eqI32(added.status, 0, "-k failed: " + added.stderr);
  t.eqStr(added.stdout, "added\n", "stdout after -k");
  t.isTrue(contains(string.fromBytes(cli.readFile(home + "/.ssh/known_hosts").wait().bytes), blob),
           "known_hosts was not written");

  // Now it is known, so no grant to write is needed and no prompt appears.
  Said known = ourSsh(cli, plain, home, plus(p, string[]("echo", "again")));
  t.eqI32(known.status, 0, "the second run failed: " + known.stderr);
  t.eqStr(known.stdout, "again\n", "the recorded host was not recognised");

  // A different key for a known host is the case the file exists to catch, and must be loud and
  // refused — never quietly treated as a first connection.
  string other = string.fromBytes(b64Encode(ramp(51, 1, 0), ALPHABET_STANDARD(), true));
  cli.writeFile(home + "/.ssh/known_hosts",
                ("[127.0.0.1]:" + itoa(s.port) + " ssh-ed25519 " + other + "\n").toBytes()).wait();
  Said changed = ourSsh(cli, plain, home, plus(p, string[]("echo", "nope")));
  t.neI32(changed.status, 0, "a changed host key was accepted");
  t.eqStr(changed.stdout, "", "the command ran against a changed host key");
  t.isTrue(contains(changed.stderr, "REMOTE HOST IDENTIFICATION HAS CHANGED"),
           "the change was not reported loudly: " + changed.stderr);
  // `-k` must not paper over it: adding is for unknown hosts, not for changed ones.
  t.neI32(ourSsh(cli, writable, home, plus(string[]("-k"), plus(p, string[]("echo", "nope")))).status,
          0, "-k accepted a changed host key");

  stopSshd(cli, s);
  return t.report();
}

export string test_the_ssh_program_reports_bad_arguments_and_unreadable_keys(Core core, Cli cli) {
  T t = T.create();
  if (!haveSshd(cli)) { return t.report(); }
  string client = buildClient(t, cli, false);
  if (client == "") { return t.report(); }
  Sshd s = startSshd(t, cli, "ssh-cli-args");
  if (!s.ok) { t.fail("sshd did not come up — " + s.error); stopSshd(cli, s); return t.report(); }
  string home = makeHome(t, cli, s, true);
  string[] p = target(s);

  Said usage = ourSsh(cli, client, home, string[0](fill: ""));
  t.eqI32(usage.status, 2, "no arguments");
  t.isTrue(contains(usage.stderr, "usage:"), "no usage line");

  t.eqI32(ourSsh(cli, client, home, p).status, 2, "a host with no command was accepted");
  t.eqI32(ourSsh(cli, client, home, string[]("-p", "notaport", "127.0.0.1", "true")).status, 2,
          "a non-numeric port was accepted");

  Said missingKey = ourSsh(cli, client, home,
                           plus(string[]("-i", s.dir + "/nosuchkey"), plus(p, string[]("true"))));
  t.eqI32(missingKey.status, 1, "a missing identity did not fail");
  t.isFalse(contains(missingKey.stderr, "REMOTE HOST"), "it got as far as the host key");

  // A file that exists but is not a key.
  cli.writeFile(s.dir + "/notakey", ("hello\n").toBytes()).wait();
  Said notKey = ourSsh(cli, client, home,
                       plus(string[]("-i", s.dir + "/notakey"), plus(p, string[]("true"))));
  t.eqI32(notKey.status, 1, "a non-key file was accepted");
  t.isTrue(contains(notKey.stderr, "not an OpenSSH private key"),
           "unhelpful message: " + notKey.stderr);

  stopSshd(cli, s);
  return t.report();
}

export string test_the_ssh_program_reads_an_encrypted_key_with_ssh_passphrase(Core core, Cli cli) {
  T t = T.create();
  if (!haveSshd(cli)) { return t.report(); }
  string client = buildClient(t, cli, false);
  if (client == "") { return t.report(); }
  Sshd s = startSshd(t, cli, "ssh-cli-passphrase");
  if (!s.ok) { t.fail("sshd did not come up — " + s.error); stopSshd(cli, s); return t.report(); }
  string home = makeHome(t, cli, s, true);

  string pass = "a passphrase";
  string enc = s.dir + "/encrypted";
  t.isTrue(copyPreserving(cli, s.dir + "/clientkey", enc), "the key could not be copied");
  Exec rekey = cli.exec("ssh-keygen",
                        string[]("-p", "-f", enc, "-P", "", "-N", pass, "-q", "-a", "4"),
                        u8[0]()).wait();
  t.eqI32(rekey.status, 0, "ssh-keygen -p: " + string.fromBytes(rekey.stderr));
  if (rekey.status != 0) { stopSshd(cli, s); return t.report(); }

  string[] p = plus(string[]("-i", enc), target(s));
  string[] none = string[0](fill: "");

  // Without the passphrase it fails before connecting, and says which of the two it needs.
  Said noPass = ourSsh(cli, client, home, plus(p, string[]("echo", "no")));
  t.eqI32(noPass.status, 1, "an encrypted key was read without a passphrase");
  t.isTrue(contains(noPass.stderr, "SSH_PASSPHRASE"),
           "the message does not say how to supply one: " + noPass.stderr);

  Said withPass = ourSshEnv(cli, client, home, plus(p, string[]("echo", "decrypted")),
                            string[]("SSH_PASSPHRASE"), string[](pass));
  t.eqI32(withPass.status, 0, "with the passphrase: " + withPass.stderr);
  t.eqStr(withPass.stdout, "decrypted\n", "stdout");

  // A wrong one is a wrong passphrase, not a corrupt file.
  Said wrong = ourSshEnv(cli, client, home, plus(p, string[]("echo", "no")),
                         string[]("SSH_PASSPHRASE"), string[]("wrong"));
  t.eqI32(wrong.status, 1, "a wrong passphrase was accepted");
  t.isTrue(contains(wrong.stderr, "wrong or missing passphrase"),
           "unhelpful message: " + wrong.stderr);

  stopSshd(cli, s);
  return t.report();
}

/** Whether every character is one base64 uses — the intactness check on the large transfer. */
bool isBase64(string s) {
  if (s.len() == 0) { return false; }
  for (i32 i = 0; i < s.len(); i++) {
    string c = s.slice(i, i + 1);
    bool ok = (c >= "A" && c <= "Z") || (c >= "a" && c <= "z") || (c >= "0" && c <= "9") ||
              c == "+" || c == "/" || c == "=";
    if (!ok) { return false; }
  }
  return true;
}
