// ssh's coverage, and the argument for the points nothing reaches.
//
//   wac task coverage:ssh
//   wac task coverage:ssh --verbose
//
// **This package had no ledger at all.** Its driver measured 561 of 672 points and printed the 111 it
// missed, and nothing failed — so an uncovered branch arriving was indistinguishable from the hundred
// and eleven that were always there, which is the state `issues/system/0222` was filed about. Of the
// five drivers it names this was the one most likely to go red on being given a ratchet.
//
// It does not. It measured **605 of 672** then, and the 67 left were two claims rather than
// sixty-seven: `conn.wac`'s `struct Conn` as the whole client session, and one line in
// `privatekey.wac`. The session has since moved to `client.wac`, which this driver does not
// compile, so today it reads **605 of 606** and the one point left is the `privatekey.wac` line,
// for a key file that disagrees with itself. The other twelve measured files are at 100%.
//
// ## Where the 44 points came from
//
// `cov.ts` instrumented `test/wac/probe.wac` and called it; those exercises are carried over unchanged.
// What is new is two things it could not do:
//
//   - **the tests.** harness/wacCoverage.ts's `runTestExports` skips any test whose `fn.length > 0`,
//     because `instrument` cannot supply a capability — and 29 of the 32 non-exclusive tests take one.
//     `wac covdump` runs the ordinary program path (`issues/system/0221`), so `main` has a real `Core`
//     and `Cli` and calls them;
//   - **five parsers the probe does not wrap.** `requestName`, `requestWantsReply`, `readOpenChannel`,
//     `readPtyReq` and `readWindowChange` need no capability and no port — they are pure functions over
//     a payload — so 24 of `server.wac`'s 26 uncovered points were reachable by calling them. Pinning
//     those would have been a ledger entry for something a call reaches, which is the failure this
//     whole exercise exists to avoid.
//
// ## `proven` is two claims
//
//   - `true` — no input reaches it;
//   - `false` — reachable, and nobody has built the input *here*. Both entries below are the second
//     kind, and for the rule that means something specific: **driven by a test this driver must not
//     run.** That is where the measurement stops, not where the testing does.

import { Core, Cli, Sys, Env, Files, Modules, Output, Procs } from "std";
import { Pin, Rule, Measured, measure, report, ratchet, LedgerFlags, reportPoints } from "../../../tools/wac/covledger.wac";

static string EXERCISE = "packages/ssh/test/cov_exercise.wac";
static string PREFIX = "packages/ssh/";

/**
 * The exercise's grants.
 *
 * Its 32 tests drive `ssh-keygen` and `openssl` through `Cli.exec` and read key files off disk.
 * `--allow-net` because two of them open a local socket to a server they start themselves — which is
 * not the same as the exclusive lane's real OpenSSH on a real port, and is why they are safe to run
 * here.
 */
string[] grants() {
  return ["--allow-read", "--allow-write", "--allow-run", "--allow-env", "--allow-net"];
}

/**
 * `trapProbe` — the guards that trap by contract, as one sweep.
 *
 * Thirteen cases, each a caller that got a length wrong: a cookie that is not sixteen bytes, a cipher
 * key that is not sixty-four, an X25519 scalar that is not thirty-two, padding that runs out. Every one
 * of those lengths is fixed by the protocol, so a guard is the only thing between a short buffer and a
 * read past its end. `covdump` calls `trapProbe(0)`…`trapProbe(12)` with each trap caught
 * (spec/cli/wac.md, `[§wac-cli-covdump-sweep-4tn8mr6]`).
 */
string[] cases() { return ["trapProbe:13"]; }

Pin[] pins() {
  return [
        Pin("packages/ssh/src/privatekey.wac", 179,
        "if (blobPoint[i] != pub[i]) { return fail(KeyError.Malformed); }", false,
        "A key file whose header public key disagrees with the one inside the private section. An " +
        "`openssh-key-v1` file carries the point twice — once in the clear and once inside the part " +
        "that may be encrypted — and this is the check that they are the same key. Every malformed " +
        "file built in `cov_exercise.wac` is wrong in one *structural* way: a bad magic, a key count " +
        "of two, a section cut short, check words that disagree. This one needs a file that parses " +
        "completely and is internally inconsistent, which is a different kind of wrong and takes " +
        "building the two blobs apart. Reachable, and not built — and worth building, because a file " +
        "that passed this check while carrying two different keys would authenticate as one identity " +
        "and sign as another.")
  ];
}

Rule[] rules() {
  // There was one rule here, for `conn.wac`'s `struct Conn` as the whole client session. The
  // handshake moved to `client.wac`, which nothing this driver compiles imports, and what stayed
  // in `conn.wac` is the shared transport, whose points the exercise reaches.
  return Rule[]();
}

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  Modules mods = sys.modules();
  LedgerFlags flags = LedgerFlags.read(argv);

  Measured m = measure(err, env, fs, procs, EXERCISE, grants(), cases());
  if (m.nPoints == 0) { return 1; }

  // `--points` dumps the per-point table instead of the report, unfiltered, so a caller can
  // union this driver's reach with another's — `issues/system/0241b`.
  if (flags.points) { reportPoints(out, m.points, m.nPoints, m.counts); return 0; }
  report(out, m.points, m.nPoints, m.counts, PREFIX, flags.verbose);
  return ratchet(err, out, fs, procs, m.points, m.nPoints, m.counts, PREFIX, pins(), rules()) ? 1 : 0;
}
