// A local `openssl s_server` speaking DTLS 1.2, for the tests that check us against it.
//
// Its own module rather than a helper inside one test file, because three of them need it and none
// should import another — the same reason `packages/ssh/test/wac/fixture.wac` exists.
//
// ## The thing that will waste an hour if it is not written down
//
// **`openssl s_server` reads stdin and exits on EOF.** Backgrounded with nothing holding stdin open
// it prints `ACCEPT`, then `DONE`, and is gone before any client arrives — which looks exactly like
// a server that refused the connection, and sends you to look at the certificate type first.
//
// ## …except that `-quiet` already fixes it
//
// `openssl s_server -help` says `-ign_eof   Ignore input EOF (default when -quiet)`, and `-quiet` is
// passed here anyway to keep the connection banner off stdout. So `< /dev/null` is enough: measured,
// the server is still listening seconds after its stdin ended.
//
// That matters because of what the host-side version had to do instead. It held the pipe open from
// Deno, having previously used `sh -c "sleep 30 | openssl s_server …"` — where the child is **`sh`**,
// so killing it left `openssl` reparented to init, blocked in accept, never reaching the read that
// would see the EOF. **294 of them were running when that was found**, the oldest nine days old,
// holding 294 UDP ports on a machine three agents share. Both the `sleep` and the held pipe were
// working around something `-quiet` had already dealt with.
//
// So the line here is `exec openssl s_server … < /dev/null`, the daemon's pid *is* `openssl`, and
// there is no wrapper to leak. The reaper below is still not redundant: `stop` runs on the way out
// of a test and nothing runs when the process is *killed* — a suite that outruns `tools/push.sh`'s
// timeout, a stopped container, a machine that reboots. That case leaks whatever the code does,
// which is the whole argument of wac-mono 0073.

import { T } from "../../../wactest/src/assert.wac";
import { Datagram, Exec, ChildEnv, Clock, Env, Files, Launch, Net, Output, Procs } from "std";
import { Daemon, Held, logOf, start, stop } from "../../../wactest/src/daemon.wac";
import { quoted } from "../../../wactest/src/childenv.wac";
import { madeDir } from "../../../wactest/src/host.wac";
import { flatten } from "core";

/** A running `s_server`, or `ok` false with the reason. */
export struct Dtls {
  bool ok;
  string error;
  i32 port;
  Daemon daemon;

  /** Whatever it wrote, for a failure to quote. */
  string said(const this, Files fs) { return logOf(fs, this.daemon); }
}

/**
 * What makes a `ps` line an abandoned DTLS server of ours.
 *
 * `s_server` **together with** `-dtls1_2`, so this cannot touch `packages/tls`'s TLS 1.3 `s_server`
 * — a different test, spawned correctly, and not this module's to kill. Only processes whose parent
 * is init, so a server a live test is using is never a candidate.
 *
 * One definition used twice: the reaper walks `ps` with it and `wouldReap` applies it to a line the
 * caller supplies, so the test of the pattern cannot drift from the pattern.
 */
static string ARMS =
  "ours() { " +
  "  case \"$1\" in *s_server*) ;; *) return 1;; esac; " +
  "  case \"$1\" in *-dtls1_2*) ;; *) return 1;; esac; " +
  "  return 0; }; ";

static string REAP =
  ARMS +
  "ps -eo pid=,ppid=,args= 2>/dev/null | while read pid ppid rest; do " +
  "  case \"$ppid\" in 1) ;; *) continue;; esac; " +
  "  ours \"$rest\" || continue; ";

/** Whether the reaper's pattern would match one `ps` line — the discrimination half. */
export bool wouldReap(Procs procs, string line) {
  auto rRan = flatten(procs.exec("/bin/sh", ["-c", "\{ARMS}ours \"$1\"", "sh", line], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  return (r is not null) && r!.status == 0;
}

/** Which pids the reaper would kill — for the test that the pattern is not inert. */
export string reapSelects(Procs procs) {
  auto rRan = flatten(procs.exec("/bin/sh", ["-c", "\{REAP}echo \"$pid\"; done"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  return string.fromBytes(r!.stdout);
}

void reapAbandoned(Procs procs) {
  procs.exec("/bin/sh", ["-c", "\{REAP}kill \"$pid\" 2>/dev/null; done; true"], u8[](), ChildEnv.inherited(), Launch.plain()).wait();
}

/**
 * Start one, on a port the kernel gave us.
 *
 * `Held` binds it and gives it up one statement before `openssl` takes it, which is as small as the
 * window gets when the bind happens in another process. The host-side version picked a number at
 * random, and a collision there reads as a client that never gets an answer.
 */
export Dtls startServer(T t, Output err, Clock clock, Env env, Files fs, Net net, Procs procs, string name) {
  reapAbandoned(procs);
  string dir = "\{flatten(env.cwd().wait()).unwrap()}/.cache/dtls";
  string whyDir1 = madeDir(fs, dir);
  t.isTrue(whyDir1 == "", whyDir1);
  Held held = Held.take(net);
  if (held.port < 0) { return Dtls(false, "no port could be bound", -1, Daemon(-1, "", "")); }
  i32 port = held.port;
  string log = "\{dir}/\{name}-\{port}.log";

  held.release();
  Daemon d = start(procs, "openssl s_server -dtls1_2 -quiet -accept 127.0.0.1:\{port}" +
    " -cert packages/tls/test/data/ec_leaf.pem -key packages/tls/test/data/ec_leaf.key" +
    " < /dev/null", log);
  if (!d.ok()) { return Dtls(false, "openssl did not start — \{d.error}", port, d); }
  return Dtls(true, "", port, d);
}

/**
 * Wait until the port is bound, **without speaking DTLS to it**.
 *
 * The obvious readiness check — send a ClientHello and see if a HelloVerifyRequest comes back —
 * cannot be used here, and finding that out cost an hour. `openssl s_server` serves **one** DTLS
 * peer: once it has answered a hello from the probe's socket it is committed to that peer, and the
 * test's own socket is then ignored. The probe succeeds and the test it was protecting fails.
 *
 * So this asks the kernel instead. `ss -lun` lists bound UDP sockets, which is the fact wanted —
 * that the bind has happened — and it disturbs nothing. It sleeps between looks rather than
 * spinning, because a `ss` per iteration is a process and the thing being waited for takes
 * milliseconds.
 */
export bool waitForBind(Procs procs, Dtls s, i32 tries) {
  for (i32 i = 0; i < tries; i++) {
    auto rRan = flatten(procs.exec("/bin/sh", [
      "-c",
      "ss -lun 2>/dev/null | grep -q ':\{s.port} ' && exit 0; sleep 0.05; exit 1"
    ], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
    Exec? r = rRan.ok();
    if ((r is not null) && r!.status == 0) { return true; }
  }
  return false;
}

export void stopServer(Procs procs, Dtls s) { stop(procs, s.daemon); }

// ── The other direction: their client against our server role ─────────────────

/** A running `openssl s_client`. Its output is the daemon's log. */
export struct SClient {
  bool ok;
  string error;
  Daemon daemon;

  /** Everything it has said, stdout and stderr together. */
  string said(const this, Files fs) { return logOf(fs, this.daemon); }
}

/**
 * Start one against `port` on loopback, with a test certificate.
 *
 * **`-ign_eof`, and it is what the host-side version paid for.** `s_client` exits when its standard
 * input ends, so that version held a pipe open from Deno — and before that used
 * `sh -c "sleep 30 | openssl s_client …"`, then read the client's output with `output()`, which
 * reads to EOF. EOF was when the `sleep` ended. So a test that had finished its work in a second
 * waited out the remaining twenty-nine, and two of them were 55s of the suite: the second- and
 * third-largest tests in it. Nothing was slow; the test was waiting for a timer it had started
 * itself.
 *
 * `-ign_eof` says the same thing to `openssl` directly, so stdin can be `/dev/null` and the daemon's
 * pid is `openssl` rather than a wrapper that would leak it. `saidUntil` then ends on the marker
 * rather than on a duration.
 *
 * Both streams go to the one log because `s_client` writes its alerts and its reasons to stderr, and
 * a diagnostic without them is the failure mode this package has hit three times.
 */
export SClient startClient(Env env, Files fs, Procs procs, string name, i32 port) {
  string dir = "\{flatten(env.cwd().wait()).unwrap()}/.cache/dtls";
  fs.mkdir(dir, true).wait();
  Daemon d = start(procs, "openssl s_client -dtls1_2 -ign_eof -cert packages/tls/test/data/ec_leaf.pem" +
    " -key packages/tls/test/data/ec_leaf.key -connect 127.0.0.1:\{port} < /dev/null", "\{dir}/\{name}-client-\{port}.log");
  if (!d.ok()) { return SClient(false, "s_client did not start — \{d.error}", d); }
  return SClient(true, "", d);
}

/**
 * Read until `marker` appears, or `tries` looks pass. Answers everything read either way.
 *
 * The deadline is the failure path, not the success path: a handshake that completes says so in a
 * millisecond or two, and one that never completes is a test that fails on the transcript this
 * returns. It is *not* a wait for the client to exit — with `-ign_eof` it will not.
 */
export string saidUntil(Files fs, Procs procs, SClient c, string marker, i32 tries) {
  string said = "";
  for (i32 i = 0; i < tries; i++) {
    said = c.said(fs);
    if (said.indexOf(marker) >= 0) { return said; }
    procs.exec("/bin/sh", ["-c", "sleep 0.02"], u8[](), ChildEnv.inherited(), Launch.plain()).wait();
  }
  return said;
}

export void stopClient(Procs procs, SClient c) { stop(procs, c.daemon); }
