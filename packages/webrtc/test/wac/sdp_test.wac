// SDP, against aiortc's parser and against the SDP a real `RTCPeerConnection` produces.
//
// `design/system/0008` step 6. Two directions, and both matter for different reasons:
//
//   - **aiortc parses our offer** and gets the ICE credentials, the fingerprint and the SCTP
//     capability out of it. An offer a peer cannot parse is where a data channel fails before any
//     packet is sent, and it fails as "invalid SDP" with no hint about which line.
//   - **we parse aiortc's**, which is generated by a full `RTCPeerConnection` with a real data
//     channel on it — so it has the lines a browser sends rather than the lines we thought of.
//
// The second is the one that finds omissions. Our own offer only contains what we knew to write.
//
// Host-side until 2026-08-18, `issues/system/0161`. `test/wac/sdp_probe.wac` stays, because
// `browser.test.ts` imports it.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli } from "../../../platform/src/platform.wac";
import { Lines, Answers, ask, check, word } from "../../../wactest/src/oracle.wac";
import { contains } from "../../../wactest/src/strings.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { decoded, encode as hexEncode } from "../../../codec/src/hex.wac";
import { attr, candidateLine, colons, hasChannel, offer, printOf } from "./sdp_probe.wac";

const string ORACLE = "packages/webrtc/test/sdp_oracle.py";

const string FINGERPRINT =
  "96:E0:AA:F2:B4:46:16:EC:63:75:AB:2E:7F:0E:D5:CD:EF:25:B4:99:91:20:9D:94:D7:AA:93:C0:DC:6B:3B:83";

string hexOf(string s) { return string.fromBytes(hexEncode(s.toBytes())); }

export string test_aiortc_parses_our_offer_and_gets_everything_it_needs(Core core, Cli cli) {
  T t = T.create();
  string candidates = candidateLine("wac1 1 udp 2130706431 127.0.0.1 45678 typ host");
  string sdp = offer(1234567890, "wacUF", "wac-password-0123456789", FINGERPRINT, "actpass",
                     candidates);

  // `application` is what a data channel's media section is; `UDP/DTLS/SCTP` is the transport stack
  // in one token; `auto` is how aiortc reports `actpass`, meaning either end may start DTLS. The
  // fingerprint is the whole identity of a WebRTC peer — there is no PKI.
  Lines lines = Lines.create();
  lines.add("parse " + hexOf(sdp) + " application UDP/DTLS/SCTP wacUF wac-password-0123456789 " +
            "sha-256 " + FINGERPRINT + " auto 65536 5000 1");
  check(t, cli, "python3", string[](ORACLE), lines, "aiortc parsing our offer");
  return t.report();
}

export string test_and_we_parse_the_sdp_a_real_rtcpeerconnection_generates(Core core, Cli cli) {
  // **Generated by aiortc rather than written here.** A description we composed contains what we
  // knew to include; this one contains what a browser sends, which is how a missing line is found.
  T t = T.create();
  Lines lines = Lines.create();
  lines.add("generate");
  Answers a = ask(t, cli, "python3", string[](ORACLE), lines, "aiortc generating an offer");
  if (!a.ok || a.lines.len() < 1) { return t.report(); }
  string sdp = string.fromBytes(decoded(word(a.lines[0], 1)));
  t.isTrue(sdp.len() > 0, "aiortc produced no SDP");
  if (sdp.len() == 0) { return t.report(); }

  t.isTrue(hasChannel(sdp), "aiortc's offer has a data channel section");
  string ufrag = attr(sdp, "ice-ufrag");
  t.isTrue(ufrag.len() > 0, "no ice-ufrag found in:\n" + sdp);
  t.isTrue(attr(sdp, "ice-pwd").len() > 0, "and no ice-pwd");
  t.isFalse(contains(ufrag, " "), "a value stops at the end of its line");

  string fp = printOf(sdp);
  t.eqI32(fp.len(), 95,
          "a SHA-256 fingerprint is 32 bytes as colon-separated hex — 95 characters — and we read " +
          itoa(fp.len()) + ": " + fp);
  t.isTrue(contains(fp, ":"), "colon separated");
  t.eqStr(upper(fp), fp, "and upper case, as every implementation writes it");
  t.eqStr(attr(sdp, "setup"), "actpass", "an offer leaves the DTLS role open");
  t.eqStr(attr(sdp, "sctp-port"), "5000", "the SCTP port");

  // The line-oriented reader must not find an attribute inside another line's value — `a=mid:0`
  // occurring after `a=group:BUNDLE 0` is the case that catches a substring search.
  t.eqStr(attr(sdp, "mid"), "0", "the media id");
  t.eqStr(attr(sdp, "nonesuch"), "", "and an attribute that is not there is empty");
  return t.report();
}

export string test_a_fingerprint_is_written_the_way_an_sdp_wants_it() {
  // Colon-separated upper-case hex, which is the one place this package formats a value for a human
  // rather than for a parser — and getting it wrong produces an SDP rejected as malformed.
  T t = T.create();
  t.eqStr(colons(decoded("96e0aaf2000f")), "96:E0:AA:F2:00:0F", "six bytes");
  t.eqStr(colons(u8[0]()), "", "nothing to separate");
  t.eqStr(colons(u8[1]()), "00", "one byte has no separator");
  return t.report();
}

export string test_bare_lf_is_read_as_well_as_crlf() {
  T t = T.create();
  string sdp = offer(1, "uf", "pw", FINGERPRINT, "active", "");
  t.isTrue(contains(sdp, "\r\n"), "we write CRLF, as the specification says");
  // A signalling server that normalised the line endings, or a hand-written fixture, gives LF —
  // and refusing that would be strict about the wrong thing.
  string lf = withoutCr(sdp);
  t.isFalse(contains(lf, "\r"), "the LF copy really has no CR, or this tests nothing");
  t.eqStr(attr(lf, "ice-ufrag"), "uf", "the ufrag, read from LF-only input");
  t.eqStr(attr(lf, "setup"), "active", "the setup role");
  t.eqStr(printOf(lf), FINGERPRINT, "the fingerprint");
  t.isTrue(hasChannel(lf), "and the data channel section");
  return t.report();
}

/** Every `\r` dropped — `string` has no `replaceAll`. */
string withoutCr(string s) {
  string out = "";
  for (i32 i = 0; i < s.len(); i++) {
    string c = s.slice(i, i + 1);
    if (c != "\r") { out = out + c; }
  }
  return out;
}

/** ASCII upper case, for the claim that a fingerprint is written in it. */
string upper(string s) {
  string out = "";
  for (i32 i = 0; i < s.len(); i++) {
    string c = s.slice(i, i + 1);
    out = out + (c >= "a" && c <= "z"
      ? string.fromBytes(u8[](c.toBytes()[0] - 32))
      : c);
  }
  return out;
}
