// The probe for `Session` — the layer that joins ICE, DTLS and SCTP into a data channel.

import { Association } from "../../src/sctp.wac";
import { Consent } from "../../src/ice.wac";
import { Peer } from "../../src/peer.wac";
import { Session, chunkBytes, dcepAck, dcepOpen, ppidDcep, ppidString } from "../../src/session.wac";
import { hexColons } from "../../src/sdp.wac";
import { sha256 } from "../../../crypto/src/sha256.wac";

/** A session over a fresh peer and association, so a test can build one in a line. */
export Session sessionFor(u8[] certDer, u8[] signingKey, u8[] nonce, u8[] scalar, u8[] random,
                          u8[] cookie, string ourUfrag, string ourPwd, string theirUfrag,
                          string theirPwd) {
  return Session.of(Peer.of(certDer, signingKey, nonce, scalar, random, cookie),
                    Association.of(0x11111111, 1, 65536),
                    Consent.of(5000 as i64, 30000 as i64, 0 as i64),
                    ourUfrag, ourPwd, theirUfrag, theirPwd, cookie);
}

/**
 * A session built from bytes rather than from struct handles.
 *
 * **Structs do not cross module instances.** Each `wacBind` is its own wasm instance, so a `Peer`
 * built by the peer probe is a different type from this file's `Peer` and cannot be handed in — the
 * error is `type incompatibility when transforming from/to JS`, which says nothing about why. So a
 * caller that wants a session gives it the material and lets it construct its own.
 */
export Session sessionOver(u8[] certDer, u8[] signingKey, u8[] nonce, u8[] scalar, u8[] random,
                           u8[] dtlsCookie, i32 ourTag, i32 initialTsn, u8[] sctpCookie,
                           i64 consentInterval, i64 now, string ourUfrag, string ourPwd,
                           string theirUfrag, string theirPwd) {
  return Session.of(Peer.of(certDer, signingKey, nonce, scalar, random, dtlsCookie),
                    Association.of(ourTag, initialTsn, 65536),
                    Consent.of(consentInterval, 30000 as i64, now),
                    ourUfrag, ourPwd, theirUfrag, theirPwd, sctpCookie);
}

// Observation, so the browser test can keep measuring the protocol and not only the composition.
export u8[] sessionApplication(Session s, u8[] datagram, i32 at) {
  return s.peer.application(datagram, at);
}
export bool sessionPeerEstablished(Session s) { return s.peer.established; }
export bool sessionAssocEstablished(Session s) { return s.assoc.established; }
export i32 sessionWaiting(Session s) { return s.assoc.waiting(); }
export i32 sessionWindow(Session s) { return s.assoc.congestionWindow(); }
export bool sessionAborted(Session s) { return s.assoc.abortedByPeer(); }
export u8[] sessionPeerCertificate(Session s) { return s.peer.peerCertificate(); }
export bool sessionPeerAuthenticated(Session s) { return s.peer.peerAuthenticated(); }
/** The peer's certificate fingerprint, spelled the way an SDP's `a=fingerprint` line spells it. */
export string sessionPeerFingerprint(Session s) {
  u8[] der = s.peer.peerCertificate();
  return der.len() == 0 ? "" : hexColons(sha256(der));
}
export bool sessionConsentLive(Session s, i64 now) { return s.consent.live(now); }
export bool sessionConsentDue(Session s, i64 now) { return s.consent.due(now); }
export void sessionConsentSent(Session s, u8[] tid, i64 now) { s.consent.sent(tid, now); }
export bool sessionConsentAnswered(Session s, u8[] msg, u8[] password, i64 now) {
  return s.consent.answered(msg, password, now);
}

export Session newSession(Peer peer, Association assoc, Consent consent, string ourUfrag,
                          string ourPwd, string theirUfrag, string theirPwd, u8[] cookie) {
  return Session.of(peer, assoc, consent, ourUfrag, ourPwd, theirUfrag, theirPwd, cookie);
}
export u8[][] sessionReceive(Session s, u8[] datagram, u8[] fromIp, i32 fromPort, i64 now) {
  return s.receive(datagram, fromIp, fromPort, now);
}
export u8[][] sessionSend(Session s, i32 stream, u8[] payload, i64 now) {
  return s.send(stream, payload, now);
}
export u8[][] sessionTick(Session s, i64 now) { return s.tick(now); }
export i32 sessionPending(Session s) { return s.pending(); }
export u8[][] sessionResend(Session s, i64 now) { return s.resend(now); }
export u8[] sessionTake(Session s) { return s.take(); }
export u8[] sessionMessage(Session s, i32 i) { return s.message(i); }
export u8[] sessionLabel(Session s) { return s.channelLabel(); }
export bool sessionOpen(Session s) { return s.open(); }
export i32 sessionChecks(Session s) { return s.checks(); }
export i32 kChunkBytes() { return chunkBytes(); }
export i32 kPpidDcep() { return ppidDcep(); }
export i32 kPpidString() { return ppidString(); }
export i32 kDcepOpen() { return dcepOpen(); }
export i32 kDcepAck() { return dcepAck(); }
