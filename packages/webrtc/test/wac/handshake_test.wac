// A complete DTLS 1.2 handshake with OpenSSL, from ClientHello to both Finisheds.
//
// `design/system/0008` step 3's done-when, in the form OpenSSL can adjudicate: it accepts our
// Finished — which it can only do if our master secret, our key block, our transcript and our record
// protection are all right — and sends one of its own that we verify.
//
// ## Why this is the test the others were building toward
//
// Every piece has an oracle already: the PRF against `openssl kdf`, the record layer against a real
// server's answers, AES-GCM against Python. What none of them can check is the **transcript** —
// which messages are hashed, in what order, with which headers — because a transcript is not a value
// anything else will tell you. The Finished is the only place a wrong one shows up, and it shows up
// as a `decrypt_error` alert with nothing else to go on. So this test is also the reason the earlier
// ones exist: when it fails, they are what says the cause is not the keys.
//
// ## What is deliberately still missing
//
// The server's certificate chain is **not verified to a root**. That is the next increment and it is
// the one that makes the handshake mean anything — a DTLS handshake that completes with whoever
// answered is exactly the hole `packages/quic` had. What *is* checked here is the pair that WebRTC
// actually relies on: the certificate's fingerprint, which is what an SDP carries instead of a PKI,
// and the ServerKeyExchange signature over the ephemeral point.
//
// Host-side until 2026-08-18, `issues/system/0161`. The server is `./openssl.wac`, which is where
// the notes about its standard input and about readiness live.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli, Datagram, Exec, Pending, Socket } from "../../../platform/src/platform.wac";
import { Buf } from "../../../bytes/src/buf.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { encode as hexEncode } from "../../../codec/src/hex.wac";
import { alertAt, blockFrom, ckeMessage, cookieAt, curveOfBody, finishedMessage, fingerprintOf,
         fragBodyAt, fragInfoAt, hello, keyExchangeSigned, kindAt, leafOf, masterFrom, openedAt,
         ourPublic, preMaster, publicOfBody, reheaded, schemeOf, sealedRecord, signatureOver,
         signedBytes, sizeAt } from "./dtls_probe.wac";
import { Dtls, startServer, stopServer, waitForBind } from "./openssl.wac";

/** Fixed inputs, so a failing run and the one before it print the same bytes. */
u8[] ramp(i32 n, i32 mul, i32 add) {
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = (i * mul + add) & 255; }
  return out;
}

string hexOf(u8[] b) { return string.fromBytes(hexEncode(b)); }

u8[] cat(u8[][] parts) {
  Buf out = Buf.create();
  for (i32 i = 0; i < parts.len(); i++) { out.pushAll(parts[i]); }
  return out.take();
}

u8[] slice(u8[] b, i32 at, i32 end) {
  i32 from = at < 0 ? 0 : at;
  i32 to = end > b.len() ? b.len() : end;
  u8[] out = u8[to - from]();
  out.copyFrom(b, from, 0, to - from);
  return out;
}

/** A plaintext record header around a fragment — the epoch-0 case, with nothing to seal. */
u8[] recordOf(i32 kind, i32 epoch, i64 seq, u8[] fragment) {
  u8[] out = u8[13 + fragment.len()]();
  out[0] = kind;
  out[1] = 0xFE;
  out[2] = 0xFD;
  out[3] = (epoch >> 8) & 255;
  out[4] = epoch & 255;
  for (i32 i = 0; i < 6; i++) { out[5 + i] = ((seq >> ((5 - i) * 8)) & 255) as i32; }
  out[11] = (fragment.len() >> 8) & 255;
  out[12] = fragment.len() & 255;
  out.copyFrom(fragment, 0, 13, fragment.len());
  return out;
}

/** The next datagram, or empty. The deadline is on the wait — `issues/system/0206`. */
u8[] receiveWithin(Core core, Cli cli, Socket sock, i32 ms) {
  Pending<Datagram> p = cli.receiveFrom(sock.handle);
  if (core.waitAny(i32[](p.id), ms) < 0) {
    p.drop(p.id);
    return u8[0]();
  }
  Datagram d = p.wait();
  return d.error == "" ? d.bytes : u8[0]();
}

/** OpenSSL's own fingerprint of the file it is serving — the oracle for ours. */
string opensslFingerprint(Cli cli) {
  Exec r = cli.exec("openssl",
                    string[]("x509", "-in", "packages/tls/test/data/ec_leaf.pem", "-noout",
                             "-fingerprint", "-sha256"), u8[0]()).wait();
  if (!r.ran() || r.status != 0) { return ""; }
  string said = string.fromBytes(r.stdout);
  i32 eq = said.indexOf("=");
  if (eq < 0) { return ""; }
  string out = "";
  for (i32 i = eq + 1; i < said.len(); i++) {
    string c = said.slice(i, i + 1);
    if (c == ":" || c == "\n" || c == "\r" || c == " ") { continue; }
    out = out + (c >= "A" && c <= "F" ? string.fromBytes(u8[](c.toBytes()[0] + 32)) : c);
  }
  return out;
}

export string test_openssl_completes_a_dtls_handshake_with_us(Core core, Cli cli) {
  T t = T.create();
  u8[] RANDOM = ramp(32, 7, 3);
  u8[] SCALAR = ramp(32, 11, 5);

  Dtls srv = startServer(t, cli, "handshake");
  if (!srv.ok) { t.fail("the DTLS server did not start — " + srv.error); return t.report(); }
  Socket sock = cli.bindDatagram("127.0.0.1", 0).wait();
  if (sock.handle < 0) {
    t.fail("our socket did not bind — " + sock.error);
    stopServer(cli, srv);
    return t.report();
  }
  // Readiness asks the kernel: a DTLS probe would win the server, which serves one peer. See
  // `openssl.wac`.
  if (!waitForBind(cli, srv, 200)) {
    t.fail("openssl never bound " + itoa(srv.port) + " — " + srv.said(cli));
    cli.closeSocket(sock.handle);
    stopServer(cli, srv);
    return t.report();
  }

  // ── Flight 1: the cookie exchange ────────────────────────────────────────────
  cli.sendTo(sock.handle, "127.0.0.1", srv.port, hello(RANDOM, u8[0](), 0, 0)).wait();
  u8[] verify = receiveWithin(core, cli, sock, 5000);
  t.isTrue(verify.len() > 0, "no HelloVerifyRequest — " + srv.said(cli));
  if (verify.len() == 0) { done(cli, sock, srv); return t.report(); }
  u8[] cookie = cookieAt(verify, 0);

  // **The transcript starts here.** RFC 6347 §4.2.6 excludes the first ClientHello and the
  // HelloVerifyRequest, because at the time it sent them the client could not know whether they
  // would be part of a session at all. The cookied hello is message zero of the hash.
  u8[] second = hello(RANDOM, cookie, 1, 1);
  u8[] clientHelloMsg = slice(second, 13, second.len());   // the handshake message, header included
  cli.sendTo(sock.handle, "127.0.0.1", srv.port, second).wait();

  // ── Flight 2: the server's, across as many datagrams as it takes ─────────────
  //
  // **Reassembled by message_seq**, because a handshake message is fragmented whenever it does not
  // fit in a datagram, and OpenSSL fragments the ServerKeyExchange of an ECDHE handshake as a matter
  // of course — seventeen bytes in one datagram and ninety-four in the next. A reader that took each
  // fragment for a message saw a ServerKeyExchange whose curve parsed and whose public key was
  // empty, which is what the `whole` flag exists to prevent.
  //
  // The transcript hashes the message **as if it had never been fragmented** — one header with
  // offset zero and the full length — so the pieces are gathered and re-headed rather than
  // concatenated as they arrived.
  i32 SLOTS = 16;
  i32[] kindOfSeq = i32[SLOTS](fill: -1);
  i32[] haveOfSeq = i32[SLOTS](fill: 0);
  u8[][] bodyOfSeq = u8[][SLOTS](fill: u8[0]());
  i32[] order = i32[SLOTS](fill: -1);
  i32 seen = 0;
  bool sawDone = false;

  for (i32 datagram = 0; datagram < 8 && !sawDone; datagram++) {
    u8[] got = receiveWithin(core, cli, sock, 5000);
    if (got.len() == 0) {
      t.fail("the flight stopped after " + itoa(datagram) + " datagram(s)");
      done(cli, sock, srv);
      return t.report();
    }
    i32 alert = alertAt(got, 0);
    if (alert >= 0) {
      t.fail("the server sent alert " + itoa(alert) + " during its flight");
      done(cli, sock, srv);
      return t.report();
    }
    i32 at = 0;
    for (i32 guard = 0; guard < 64; guard++) {
      i32 size = sizeAt(got, at);
      if (size < 0) { break; }
      i32[] info = fragInfoAt(got, at);
      i32 kind = info[0];
      i32 seq = info[1];
      i32 offset = info[2];
      i32 fragLen = info[3];
      i32 total = info[4];
      if (kind >= 0 && seq >= 0 && seq < SLOTS) {
        if (kindOfSeq[seq] < 0) {
          kindOfSeq[seq] = kind;
          bodyOfSeq[seq] = u8[total]();
          order[seen] = seq;
          seen = seen + 1;
        }
        u8[] body = fragBodyAt(got, at);
        bodyOfSeq[seq].copyFrom(body, 0, offset, body.len());
        haveOfSeq[seq] = haveOfSeq[seq] + fragLen;
        if (haveOfSeq[seq] >= total && kind == 14) { sawDone = true; }
      }
      at = at + size;
    }
  }
  t.isTrue(sawDone, "the flight ended with a complete ServerHelloDone");
  for (i32 i = 0; i < seen; i++) {
    i32 seq = order[i];
    t.eqI32(haveOfSeq[seq], bodyOfSeq[seq].len(),
            "message_seq " + itoa(seq) + " (type " + itoa(kindOfSeq[seq]) + ") was incomplete");
  }

  u8[][] serverMessages = u8[][seen](fill: u8[0]());
  for (i32 i = 0; i < seen; i++) {
    i32 seq = order[i];
    serverMessages[i] = reheaded(kindOfSeq[seq], seq, bodyOfSeq[seq]);
  }

  u8[] serverRandom = u8[0]();
  u8[] serverKey = u8[0]();
  u8[] certBody = u8[0]();
  u8[] skeBody = u8[0]();
  i32 curve = -1;
  for (i32 i = 0; i < seen; i++) {
    i32 seq = order[i];
    if (kindOfSeq[seq] == 2) { serverRandom = slice(bodyOfSeq[seq], 2, 34); }
    if (kindOfSeq[seq] == 11) { certBody = bodyOfSeq[seq]; }
    if (kindOfSeq[seq] == 12) {
      curve = curveOfBody(bodyOfSeq[seq]);
      serverKey = publicOfBody(bodyOfSeq[seq]);
      skeBody = bodyOfSeq[seq];
    }
  }
  t.isTrue(serverRandom.len() > 0 && serverKey.len() > 0,
           "no ServerHello random or ServerKeyExchange key in the flight");
  if (serverRandom.len() == 0 || serverKey.len() == 0) { done(cli, sock, srv); return t.report(); }
  t.eqI32(curve, 0x001D, "x25519 is what our list puts first");
  t.eqI32(serverKey.len(), 32, "an x25519 point is thirty-two bytes");

  // ── The certificate, before anything is derived from the key it vouches for ──
  //
  // **Two checks, and neither is optional.** The fingerprint says *this is the certificate the
  // signalling channel named*; the ServerKeyExchange signature says *the ephemeral key came from
  // whoever holds it*. Skipping the second is the subtler hole: the certificate can be genuine while
  // the point beside it is an attacker's, and a handshake built on that completes perfectly and is
  // read by them.
  t.isTrue(certBody.len() > 0 && skeBody.len() > 0,
           "the flight had no Certificate or no ServerKeyExchange");
  if (certBody.len() == 0 || skeBody.len() == 0) { done(cli, sock, srv); return t.report(); }

  u8[] leaf = leafOf(certBody);
  t.isTrue(leaf.len() > 0, "a leaf certificate came out of the Certificate message");
  if (leaf.len() > 0) { t.eqI32(leaf[0], 0x30, "and it starts with a DER SEQUENCE"); }

  string expected = opensslFingerprint(cli);
  t.isTrue(expected != "", "openssl printed no fingerprint for the certificate file");
  t.eqStr(hexOf(fingerprintOf(leaf)), expected,
          "the SHA-256 of the certificate on the wire is the one openssl prints for the file — " +
          "which is what an SDP's a=fingerprint line carries and all WebRTC has instead of a PKI");

  t.isTrue(keyExchangeSigned(certBody, skeBody, RANDOM, serverRandom),
           "the ServerKeyExchange signature did not verify (scheme " + itoa(schemeOf(skeBody)) + ")");

  // **The canary**, and it is the one that matters: substitute the ephemeral point and the signature
  // must fail. A verifier that checked the certificate and not this would pass the line above and be
  // defeated by exactly this.
  u8[] tampered = signedBytes(RANDOM, serverRandom, skeBody);
  tampered[tampered.len() - 1] = tampered[tampered.len() - 1] ^ 1;
  t.isFalse(signatureOver(certBody, skeBody, tampered),
            "one bit of the server's ephemeral point changed and the signature still verified");
  t.isFalse(keyExchangeSigned(certBody, skeBody, RANDOM, RANDOM),
            "and it is bound to both randoms, so a replay into another session does not verify");

  // ── Flight 3: ClientKeyExchange, ChangeCipherSpec, Finished ──────────────────
  u8[] ourKey = ourPublic(curve, SCALAR);
  u8[] pms = preMaster(curve, SCALAR, serverKey);
  t.eqI32(pms.len(), 32, "the pre-master secret is thirty-two bytes");
  t.neI32(hexOf(pms) == hexOf(u8[32]()) ? 1 : 0, 1,
          "an all-zero shared secret means the peer's point was rejected, not that it agreed");

  u8[] master = masterFrom(pms, RANDOM, serverRandom);
  u8[] block = blockFrom(master, serverRandom, RANDOM);
  // Forty bytes: client key, server key, client IV, server IV — no MAC keys, because AEAD.
  u8[] clientKey = slice(block, 0, 16);
  u8[] serverWriteKey = slice(block, 16, 32);
  u8[] clientIv = slice(block, 32, 36);
  u8[] serverIv = slice(block, 36, 40);

  u8[] cke = ckeMessage(ourKey, 2);
  u8[][] transcriptParts = u8[][seen + 2](fill: u8[0]());
  transcriptParts[0] = clientHelloMsg;
  for (i32 i = 0; i < seen; i++) { transcriptParts[1 + i] = serverMessages[i]; }
  transcriptParts[seen + 1] = cke;
  u8[] transcript = cat(transcriptParts);

  u8[] finished = finishedMessage(master, transcript, 3, true);
  t.eqI32(finished.len(), 24, "a Finished is a header and twelve bytes of verify_data");

  // Three records, and they may go in one datagram — which is what OpenSSL does and what a peer
  // expects. Epoch 0 for the first two; the Finished is the first thing under the new keys.
  u8[] one = u8[1]();
  one[0] = 1;
  cli.sendTo(sock.handle, "127.0.0.1", srv.port,
             cat(u8[][](recordOf(22, 0, 2, cke), recordOf(20, 0, 3, one),
                        sealedRecord(clientKey, clientIv, 1, 0, 22, finished)))).wait();

  // ── Flight 4: the server's ChangeCipherSpec and Finished ─────────────────────
  u8[] answer = receiveWithin(core, cli, sock, 6000);
  t.isTrue(answer.len() > 0,
           "the server said nothing after our Finished — it neither accepted nor rejected it, " +
           "which usually means the record never parsed");
  if (answer.len() == 0) { done(cli, sock, srv); return t.report(); }

  t.eqI32(alertAt(answer, 0), -1,
          "the server rejected our Finished. 2/20 is bad_record_mac — the keys or the nonce; " +
          "2/51 is decrypt_error — the verify_data, which means the transcript");

  // Walk its flight: a ChangeCipherSpec in the clear, then a Finished under its own keys.
  u8[] serverFinished = u8[0]();
  bool sawCcs = false;
  i32 at = 0;
  for (i32 guard = 0; guard < 64; guard++) {
    i32 size = sizeAt(answer, at);
    if (size < 0) { break; }
    i32 kind = kindAt(answer, at);
    if (kind == 20) { sawCcs = true; }
    if (kind == 22) {
      u8[] plain = openedAt(answer, at, serverWriteKey, serverIv);
      if (plain.len() > 0) { serverFinished = plain; }
    }
    at = at + size;
  }
  t.isTrue(sawCcs, "the server changed cipher spec, which it only does on acceptance");
  t.isTrue(serverFinished.len() > 0,
           "the server's Finished did not authenticate under the keys we derived");

  // **And its verify_data over our transcript plus our Finished**, which is the other direction: the
  // first half proves it believed us, this proves we believe it.
  if (serverFinished.len() > 0) {
    t.eqI32(serverFinished[0], 20, "a Finished message");
    u8[] want = finishedMessage(master, cat(u8[][](transcript, finished)), 0, false);
    t.eqStr(hexOf(slice(serverFinished, 12, serverFinished.len())),
            hexOf(slice(want, 12, want.len())),
            "the server's verify_data is what our own schedule computes for it");
  }

  done(cli, sock, srv);
  return t.report();
}

void done(Cli cli, Socket sock, Dtls srv) {
  if (sock.handle >= 0) { cli.closeSocket(sock.handle); }
  stopServer(cli, srv);
}
