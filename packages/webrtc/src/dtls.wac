// DTLS 1.2 — RFC 6347, the record layer and the handshake framing that TLS's does not have.
//
// Step 3 of `design/system/0008`, and the first part of WebRTC that is not STUN. This file is the
// *framing*: records, handshake headers, the ClientHello and the cookie exchange. The key schedule
// and the record protection are the next increment.
//
// ## What DTLS adds to TLS, and why each piece is there
//
// The transport loses, reorders and duplicates, so three things change and all three are visible in
// the bytes:
//
//   - **A record carries its own epoch and sequence number**, six bytes of it, because a receiver
//     cannot infer them from arrival order. TLS's implicit counter would desynchronise on the first
//     lost record.
//   - **A handshake message carries a `message_seq` and a fragment offset and length**, so a flight
//     can be split across datagrams and reassembled, and so a retransmission is recognisable as one
//     rather than as a second message.
//   - **A ClientHello carries a cookie**, and a server that has not seen one answers with a
//     HelloVerifyRequest instead of a ServerHello. That is the whole of DTLS's amplification
//     defence: until the client echoes a cookie the server allocates nothing, so a forged source
//     address gets one small datagram back rather than a certificate chain.
//
// ## The version numbers are backwards, deliberately
//
// DTLS 1.2 is `{254, 253}` and DTLS 1.0 is `{254, 255}` — the version *decreases* as it advances,
// because it is the ones' complement of the TLS version it corresponds to. A HelloVerifyRequest is
// conventionally sent as DTLS 1.0 whatever the negotiated version, which RFC 6347 §4.2.1 admits is
// an oddity and requires anyway.

import { itoa } from "../../fmt/src/itoa.wac";

/** The record's content types. */
export i32 typeChangeCipherSpec() { return 20; }
export i32 typeAlert() { return 21; }
export i32 typeHandshake() { return 22; }
export i32 typeApplicationData() { return 23; }

/** `{254, 253}` — DTLS 1.2, which is the ones' complement of TLS 1.2's `{3, 3}`. */
export i32 versionDtls12() { return 0xFEFD; }
/** `{254, 255}` — DTLS 1.0, which a HelloVerifyRequest is conventionally sent as. */
export i32 versionDtls10() { return 0xFEFF; }

/** Handshake message types, the same numbers TLS uses. */
export i32 hsClientHello() { return 1; }
export i32 hsServerHello() { return 2; }
export i32 hsHelloVerifyRequest() { return 3; }
export i32 hsCertificate() { return 11; }
export i32 hsServerKeyExchange() { return 12; }
export i32 hsCertificateRequest() { return 13; }
export i32 hsServerHelloDone() { return 14; }
export i32 hsCertificateVerify() { return 15; }
export i32 hsClientKeyExchange() { return 16; }
export i32 hsFinished() { return 20; }

/** One record, with its fragment already separated from the thirteen-byte header. */
export struct Record {
  bool ok;
  i32 kind;
  i32 version;
  i32 epoch;
  /** Forty-eight bits on the wire; an `i64` holds it without the top of a `u64` to worry about. */
  i64 sequence;
  u8[] fragment;
}

/** One handshake message, reassembled or not — `whole` is false for a fragment of a larger one. */
export struct Handshake {
  bool ok;
  i32 kind;
  i32 messageSeq;
  bool whole;
  u8[] body;
}

/** How many bytes of record are at `at`, header included, or -1 if there is not a whole one. */
export i32 recordSize(u8[] b, i32 at) {
  if (at < 0 || at + 13 > b.len()) { return -1; }
  i32 len = (b[at + 11] << 8) | b[at + 12];
  if (at + 13 + len > b.len()) { return -1; }
  return 13 + len;
}

/**
 * Parse the record at `at`.
 *
 * **A datagram may hold several**, which is not an optimisation but the ordinary case: a server's
 * flight arrives as one datagram containing ServerHello, Certificate, ServerKeyExchange and
 * ServerHelloDone, and a reader that looks only at the first sees a handshake that stops halfway.
 * `recordSize` is how a caller walks the rest.
 */
export Record parseRecord(u8[] b, i32 at) {
  i32 size = recordSize(b, at);
  if (size < 0) { return Record(false, 0, 0, 0, 0 as i64, u8[0]()); }
  i64 seq = 0 as i64;
  for (i32 i = 0; i < 6; i++) { seq = (seq * (256 as i64)) + (b[at + 5 + i] as i64); }
  u8[] frag = u8[size - 13]();
  for (i32 i = 0; i < frag.len(); i++) { frag[i] = b[at + 13 + i]; }
  return Record(true, b[at], (b[at + 1] << 8) | b[at + 2],
                (b[at + 3] << 8) | b[at + 4], seq, frag);
}

/** Wrap a fragment in a record header. */
export u8[] record(i32 kind, i32 version, i32 epoch, i64 sequence, u8[] fragment) {
  u8[] out = u8[13 + fragment.len()]();
  out[0] = kind;
  out[1] = (version >> 8) & 0xFF;
  out[2] = version & 0xFF;
  out[3] = (epoch >> 8) & 0xFF;
  out[4] = epoch & 0xFF;
  for (i32 i = 0; i < 6; i++) {
    out[5 + i] = ((sequence >> (((5 - i) * 8) as i64)) & (255 as i64)) as~ i32;
  }
  out[11] = (fragment.len() >> 8) & 0xFF;
  out[12] = fragment.len() & 0xFF;
  for (i32 i = 0; i < fragment.len(); i++) { out[13 + i] = fragment[i]; }
  return out;
}

/**
 * Parse a handshake message out of a record's fragment.
 *
 * `whole` is false when the message is fragmented — `fragment_offset` non-zero or
 * `fragment_length` short of `length`. Reassembly is a caller's job and this says whether it is
 * needed rather than guessing: a reader that ignored the two and treated every fragment as a
 * message would accept a truncated ServerHello as a complete one.
 */
export Handshake parseHandshake(u8[] f) {
  if (f.len() < 12) { return Handshake(false, 0, 0, false, u8[0]()); }
  i32 len = (f[1] << 16) | (f[2] << 8) | f[3];
  i32 seq = (f[4] << 8) | f[5];
  i32 off = (f[6] << 16) | (f[7] << 8) | f[8];
  i32 flen = (f[9] << 16) | (f[10] << 8) | f[11];
  if (12 + flen > f.len()) { return Handshake(false, 0, 0, false, u8[0]()); }
  u8[] body = u8[flen]();
  for (i32 i = 0; i < flen; i++) { body[i] = f[12 + i]; }
  return Handshake(true, f[0], seq, off == 0 && flen == len, body);
}

/** Wrap a body in a handshake header, unfragmented. */
export u8[] handshake(i32 kind, i32 messageSeq, u8[] body) {
  u8[] out = u8[12 + body.len()]();
  out[0] = kind;
  out[1] = (body.len() >> 16) & 0xFF;
  out[2] = (body.len() >> 8) & 0xFF;
  out[3] = body.len() & 0xFF;
  out[4] = (messageSeq >> 8) & 0xFF;
  out[5] = messageSeq & 0xFF;
  // Offset zero, and the fragment is the whole message — the only shape this builds.
  out[6] = 0; out[7] = 0; out[8] = 0;
  out[9] = (body.len() >> 16) & 0xFF;
  out[10] = (body.len() >> 8) & 0xFF;
  out[11] = body.len() & 0xFF;
  for (i32 i = 0; i < body.len(); i++) { out[12 + i] = body[i]; }
  return out;
}

// The suites offered. Two, so the same ClientHello works against a server holding an ECDSA
// certificate and one holding RSA — which is not hypothetical: the repository's own test data has
// both, and picking one made the first handshake attempt fail for a reason that had nothing to do
// with this file.
i32 suiteEcdheEcdsaAes128Gcm() { return 0xC02B; }
i32 suiteEcdheRsaAes128Gcm() { return 0xC02F; }

/**
 * A ClientHello, with a cookie if we have been given one.
 *
 * The **second** ClientHello — the one carrying the cookie — must otherwise be byte-identical to the
 * first, because some servers hash it into the handshake transcript and all of them compare the
 * cookie against what they issued for that address. So `random` is passed in rather than generated
 * here: a caller sends the same one twice, and a function that made its own would produce two
 * different hellos and a handshake that fails at Finished for a reason nothing points at.
 */
export u8[] clientHello(u8[] random, u8[] cookie) {
  // extensions: supported_groups, ec_point_formats, signature_algorithms
  // 10 + 6 + 12, counted as (type 2 + length 2 + body) each: supported_groups carries a two-byte
  // list length and two groups, ec_point_formats a one-byte length and one format, and
  // signature_algorithms a two-byte length and three pairs.
  u8[] ext = u8[10 + 6 + 12]();
  i32 e = 0;
  // supported_groups: x25519 (0x001d) and secp256r1 (0x0017)
  ext[e] = 0x00; ext[e + 1] = 0x0A;
  ext[e + 2] = 0x00; ext[e + 3] = 0x06;
  ext[e + 4] = 0x00; ext[e + 5] = 0x04;
  ext[e + 6] = 0x00; ext[e + 7] = 0x1D;
  ext[e + 8] = 0x00; ext[e + 9] = 0x17;
  e = e + 10;
  // ec_point_formats: uncompressed
  ext[e] = 0x00; ext[e + 1] = 0x0B;
  ext[e + 2] = 0x00; ext[e + 3] = 0x02;
  ext[e + 4] = 0x01; ext[e + 5] = 0x00;
  e = e + 6;
  // signature_algorithms: ecdsa_secp256r1_sha256, rsa_pss_rsae_sha256, rsa_pkcs1_sha256
  ext[e] = 0x00; ext[e + 1] = 0x0D;
  ext[e + 2] = 0x00; ext[e + 3] = 0x08;
  ext[e + 4] = 0x00; ext[e + 5] = 0x06;
  ext[e + 6] = 0x04; ext[e + 7] = 0x03;
  ext[e + 8] = 0x08; ext[e + 9] = 0x04;
  ext[e + 10] = 0x04; ext[e + 11] = 0x01;
  e = e + 12;

  i32 n = 2 + 32 + 1 + 1 + cookie.len() + 2 + 4 + 2 + 2 + e;
  u8[] out = u8[n]();
  i32 at = 0;
  out[at] = 0xFE; out[at + 1] = 0xFD; at = at + 2;                 // client_version, DTLS 1.2
  for (i32 i = 0; i < 32; i++) { out[at + i] = i < random.len() ? random[i] : 0; }
  at = at + 32;
  out[at] = 0; at = at + 1;                                        // session_id, empty
  out[at] = cookie.len(); at = at + 1;
  for (i32 i = 0; i < cookie.len(); i++) { out[at + i] = cookie[i]; }
  at = at + cookie.len();
  out[at] = 0x00; out[at + 1] = 0x04; at = at + 2;                 // cipher_suites, four bytes
  out[at] = (suiteEcdheEcdsaAes128Gcm() >> 8) & 0xFF;
  out[at + 1] = suiteEcdheEcdsaAes128Gcm() & 0xFF;
  out[at + 2] = (suiteEcdheRsaAes128Gcm() >> 8) & 0xFF;
  out[at + 3] = suiteEcdheRsaAes128Gcm() & 0xFF;
  at = at + 4;
  out[at] = 0x01; out[at + 1] = 0x00; at = at + 2;                 // compression: null only
  out[at] = (e >> 8) & 0xFF; out[at + 1] = e & 0xFF; at = at + 2;
  for (i32 i = 0; i < e; i++) { out[at + i] = ext[i]; }
  return out;
}

/**
 * The cookie out of a HelloVerifyRequest, or empty.
 *
 * Empty is also a legal cookie — a server may issue a zero-length one — so a caller that needs to
 * tell "no cookie" from "an empty cookie" asks whether the message was a HelloVerifyRequest at all.
 * Nothing here needs to: echoing an empty cookie is what echoing an empty cookie should do.
 */
export u8[] verifyCookie(u8[] body) {
  if (body.len() < 3) { return u8[0](); }
  i32 len = body[2];
  if (3 + len > body.len()) { return u8[0](); }
  u8[] c = u8[len]();
  for (i32 i = 0; i < len; i++) { c[i] = body[3 + i]; }
  return c;
}

/** The cipher suite a ServerHello chose, or -1 if this is not one. */
export i32 chosenSuite(u8[] body) {
  // version(2) random(32) session_id(1+n) suite(2)
  if (body.len() < 35) { return -1; }
  i32 idLen = body[34];
  if (35 + idLen + 2 > body.len()) { return -1; }
  return (body[35 + idLen] << 8) | body[35 + idLen + 1];
}

/**
 * The named curve a ServerKeyExchange chose, or -1.
 *
 * The body is `curve_type(1) named_curve(2) public(1+n) signature…`, and `curve_type` is 3 —
 * `named_curve` — for everything anyone still negotiates. The other two forms are explicit prime and
 * explicit char2 curves, which exist in the specification and in no deployment, so a body that is
 * not `named_curve` is refused rather than parsed.
 */
export i32 serverCurve(u8[] body) {
  if (body.len() < 4 || body[0] != 3) { return -1; }
  return (body[1] << 8) | body[2];
}

/** The server's ephemeral public key out of a ServerKeyExchange, or empty. */
export u8[] serverPublic(u8[] body) {
  if (body.len() < 4 || body[0] != 3) { return u8[0](); }
  i32 n = body[3];
  if (4 + n > body.len()) { return u8[0](); }
  u8[] p = u8[n]();
  for (i32 i = 0; i < n; i++) { p[i] = body[4 + i]; }
  return p;
}

/** A ClientKeyExchange body: one length byte and the point. */
export u8[] clientKeyExchange(u8[] publicKey) {
  u8[] out = u8[1 + publicKey.len()]();
  out[0] = publicKey.len();
  for (i32 i = 0; i < publicKey.len(); i++) { out[1 + i] = publicKey[i]; }
  return out;
}

/**
 * The leaf certificate out of a Certificate message, or empty.
 *
 * The body is a three-byte list length then, per entry, three bytes of DER length and the DER —
 * TLS 1.2's shape, without the per-entry extensions TLS 1.3 added. Only the first is read: in WebRTC
 * there is only ever one, because the certificate is self-signed and its **fingerprint** is what the
 * peer checks rather than any path to a root.
 */
export u8[] leafCertificate(u8[] body) {
  if (body.len() < 6) { return u8[0](); }
  i32 listLen = (body[0] << 16) | (body[1] << 8) | body[2];
  if (3 + listLen > body.len()) { return u8[0](); }
  i32 n = (body[3] << 16) | (body[4] << 8) | body[5];
  if (n <= 0 || 6 + n > body.len()) { return u8[0](); }
  u8[] der = u8[n]();
  for (i32 i = 0; i < n; i++) { der[i] = body[6 + i]; }
  return der;
}

/**
 * The bytes a ServerKeyExchange's signature covers.
 *
 * `client_random + server_random + ServerECDHParams`, where the params are the curve type, the named
 * curve and the length-prefixed point — that is, the whole body up to the signature. **This is what
 * binds the ephemeral key to the certificate**: without checking it, anybody on the path substitutes
 * their own point, completes a handshake, and reads everything. It is the same hole in the same
 * shape as `packages/quic`'s missing CertificateVerify.
 */
export u8[] serverKeyExchangeSigned(u8[] clientRandom, u8[] serverRandom, u8[] body) {
  if (body.len() < 4 || body[0] != 3) { return u8[0](); }
  i32 pointLen = body[3];
  i32 paramsLen = 4 + pointLen;
  if (paramsLen > body.len()) { return u8[0](); }
  u8[] out = u8[clientRandom.len() + serverRandom.len() + paramsLen]();
  i32 at = 0;
  for (i32 i = 0; i < clientRandom.len(); i++) { out[at + i] = clientRandom[i]; }
  at = at + clientRandom.len();
  for (i32 i = 0; i < serverRandom.len(); i++) { out[at + i] = serverRandom[i]; }
  at = at + serverRandom.len();
  for (i32 i = 0; i < paramsLen; i++) { out[at + i] = body[i]; }
  return out;
}

/** The signature scheme a ServerKeyExchange used, or -1. */
export i32 serverKeyExchangeScheme(u8[] body) {
  if (body.len() < 4 || body[0] != 3) { return -1; }
  i32 at = 4 + body[3];
  if (at + 2 > body.len()) { return -1; }
  return (body[at] << 8) | body[at + 1];
}

/** The signature itself, or empty. */
export u8[] serverKeyExchangeSignature(u8[] body) {
  if (body.len() < 4 || body[0] != 3) { return u8[0](); }
  i32 at = 4 + body[3];
  if (at + 4 > body.len()) { return u8[0](); }
  i32 n = (body[at + 2] << 8) | body[at + 3];
  if (at + 4 + n > body.len()) { return u8[0](); }
  u8[] sig = u8[n]();
  for (i32 i = 0; i < n; i++) { sig[i] = body[at + 4 + i]; }
  return sig;
}

/** x25519, the curve OpenSSL picks from the list we offer. */
export i32 curveX25519() { return 0x001D; }
/** secp256r1, which WebRTC peers often prefer instead. */
export i32 curveSecp256r1() { return 0x0017; }

// ── The server side: the messages a DTLS server sends ────────────────────────────────────────────
//
// Written because **WebRTC needs both roles**. An SDP answer chooses `active` or `passive`, and a
// browser that offers `actpass` will happily be the client — but a peer that can only ever be the
// client cannot answer one that insists on being it, and a data channel opened *to* us needs us to
// be the server. It is also the half that has a certificate to present.

/**
 * A HelloVerifyRequest, which is a version and a cookie and nothing else.
 *
 * Sent as **DTLS 1.0** whatever version is being negotiated, which RFC 6347 §4.2.1 requires and
 * admits is an oddity: a client that has not yet agreed a version must be able to read it.
 */
export u8[] helloVerifyRequest(u8[] cookie) {
  u8[] out = u8[3 + cookie.len()]();
  out[0] = 0xFE;
  out[1] = 0xFF;
  out[2] = cookie.len();
  for (i32 i = 0; i < cookie.len(); i++) { out[3 + i] = cookie[i]; }
  return out;
}

/** The cookie a ClientHello carried, or empty — the first hello of a handshake has none. */
export u8[] helloCookie(u8[] body) {
  // version(2) random(32) session_id(1+n) cookie(1+n)
  if (body.len() < 35) { return u8[0](); }
  i32 at = 34 + body[34] + 1;
  if (at >= body.len()) { return u8[0](); }
  i32 n = body[at];
  if (at + 1 + n > body.len()) { return u8[0](); }
  u8[] c = u8[n]();
  for (i32 i = 0; i < n; i++) { c[i] = body[at + 1 + i]; }
  return c;
}

/** The client's random out of a ClientHello. */
export u8[] helloRandom(u8[] body) {
  if (body.len() < 34) { return u8[0](); }
  u8[] r = u8[32]();
  for (i32 i = 0; i < 32; i++) { r[i] = body[2 + i]; }
  return r;
}

/** Whether a ClientHello offers a suite, which decides whether we can answer it at all. */
export bool helloOffers(u8[] body, i32 suite) {
  if (body.len() < 35) { return false; }
  i32 at = 34 + body[34] + 1;              // past session_id
  if (at >= body.len()) { return false; }
  at = at + 1 + body[at];                  // past the cookie
  if (at + 2 > body.len()) { return false; }
  i32 n = (body[at] << 8) | body[at + 1];
  at = at + 2;
  if (at + n > body.len()) { return false; }
  for (i32 i = 0; i + 1 < n; i = i + 2) {
    if (((body[at + i] << 8) | body[at + i + 1]) == suite) { return true; }
  }
  return false;
}

/**
 * The named groups a ClientHello offers, from its `supported_groups` extension, or empty.
 *
 * **A server must choose from these**, and a server that answers with a curve the client did not
 * offer sends a ServerKeyExchange the client cannot parse. Reading them is the difference between
 * negotiating and guessing, and guessing happens to work against OpenSSL — whose defaults overlap
 * with ours — while telling you nothing about anyone else.
 */
export i32[] helloGroups(u8[] body) {
  if (body.len() < 35) { return i32[0](); }
  i32 at = 34 + body[34] + 1;                    // past session_id
  if (at >= body.len()) { return i32[0](); }
  at = at + 1 + body[at];                        // past the cookie
  if (at + 2 > body.len()) { return i32[0](); }
  at = at + 2 + ((body[at] << 8) | body[at + 1]); // past cipher_suites
  if (at >= body.len()) { return i32[0](); }
  at = at + 1 + body[at];                        // past compression_methods
  if (at + 2 > body.len()) { return i32[0](); }
  i32 extEnd = at + 2 + ((body[at] << 8) | body[at + 1]);
  at = at + 2;
  if (extEnd > body.len()) { extEnd = body.len(); }
  while (at + 4 <= extEnd) {
    i32 kind = (body[at] << 8) | body[at + 1];
    i32 len = (body[at + 2] << 8) | body[at + 3];
    if (at + 4 + len > extEnd) { return i32[0](); }
    if (kind == 0x000A) {
      if (len < 2) { return i32[0](); }
      i32 listLen = (body[at + 4] << 8) | body[at + 5];
      i32 n = listLen / 2;
      i32[] out = i32[n]();
      for (i32 i = 0; i < n; i++) {
        out[i] = (body[at + 6 + i * 2] << 8) | body[at + 7 + i * 2];
      }
      return out;
    }
    at = at + 4 + len;
  }
  return i32[0]();
}

/**
 * A ServerHello: version, random, no session to resume, the chosen suite, no compression, and one
 * extension.
 *
 * **`renegotiation_info`, empty, and it is not optional.** RFC 5746 replaced TLS's original
 * renegotiation after it was found to let an attacker prefix a stream, and the repair is that both
 * ends advertise support. OpenSSL refuses a ServerHello without it — `unsafe legacy renegotiation
 * disabled` — and a browser does the same. The first version of this sent no extensions at all,
 * which is what every description of a minimal ServerHello says and is rejected by everything.
 *
 * Nothing else is echoed. A peer offers `use_srtp`, `extended_master_secret` and more; none is
 * required for a data channel, and echoing an extension we do not implement is worse than omitting
 * it, because the peer would then rely on it.
 */
export u8[] serverHello(u8[] random, i32 suite) {
  u8[] out = u8[2 + 32 + 1 + 2 + 1 + 2 + 5]();
  out[0] = 0xFE; out[1] = 0xFD;
  for (i32 i = 0; i < 32; i++) { out[2 + i] = i < random.len() ? random[i] : 0; }
  out[34] = 0;                                   // no session id
  out[35] = (suite >> 8) & 0xFF;
  out[36] = suite & 0xFF;
  out[37] = 0;                                   // null compression
  out[38] = 0; out[39] = 5;                      // five bytes of extensions
  out[40] = 0xFF; out[41] = 0x01;                // renegotiation_info
  out[42] = 0x00; out[43] = 0x01;                // one byte of body
  out[44] = 0x00;                                // an empty renegotiated_connection
  return out;
}

/** A Certificate message: a three-byte list length, then three bytes of DER length and the DER. */
export u8[] certificateMessage(u8[] der) {
  u8[] out = u8[6 + der.len()]();
  i32 listLen = 3 + der.len();
  out[0] = (listLen >> 16) & 0xFF;
  out[1] = (listLen >> 8) & 0xFF;
  out[2] = listLen & 0xFF;
  out[3] = (der.len() >> 16) & 0xFF;
  out[4] = (der.len() >> 8) & 0xFF;
  out[5] = der.len() & 0xFF;
  for (i32 i = 0; i < der.len(); i++) { out[6 + i] = der[i]; }
  return out;
}

/**
 * The ECDH parameters half of a ServerKeyExchange — what the signature is computed over.
 *
 * Separated from the message so a caller can sign it without rebuilding it, which is the shape that
 * makes the signature demonstrably over the bytes that are sent rather than over an equal-looking
 * reconstruction.
 */
export u8[] serverEcdhParams(i32 namedCurve, u8[] publicKey) {
  u8[] out = u8[4 + publicKey.len()]();
  out[0] = 3;                                    // named_curve
  out[1] = (namedCurve >> 8) & 0xFF;
  out[2] = namedCurve & 0xFF;
  out[3] = publicKey.len();
  for (i32 i = 0; i < publicKey.len(); i++) { out[4 + i] = publicKey[i]; }
  return out;
}

/** A ServerKeyExchange: the parameters, the signature scheme, and the signature. */
export u8[] serverKeyExchange(u8[] params, i32 scheme, u8[] signature) {
  u8[] out = u8[params.len() + 4 + signature.len()]();
  for (i32 i = 0; i < params.len(); i++) { out[i] = params[i]; }
  i32 at = params.len();
  out[at] = (scheme >> 8) & 0xFF;
  out[at + 1] = scheme & 0xFF;
  out[at + 2] = (signature.len() >> 8) & 0xFF;
  out[at + 3] = signature.len() & 0xFF;
  for (i32 i = 0; i < signature.len(); i++) { out[at + 4 + i] = signature[i]; }
  return out;
}

/** A ServerHelloDone, which has no body at all — the message is its own content. */
export u8[] serverHelloDone() { return u8[0](); }

/** The client's ephemeral public key out of a ClientKeyExchange, or empty. */
export u8[] clientPublic(u8[] body) {
  if (body.len() < 1) { return u8[0](); }
  i32 n = body[0];
  if (1 + n > body.len()) { return u8[0](); }
  u8[] p = u8[n]();
  for (i32 i = 0; i < n; i++) { p[i] = body[1 + i]; }
  return p;
}

/** A short description of a record, for a test's failure message rather than for a program. */
export string describe(Record r) {
  if (!r.ok) { return "not a record"; }
  return "type " + itoa(r.kind) + " epoch " + itoa(r.epoch) + " len " + itoa(r.fragment.len());
}
