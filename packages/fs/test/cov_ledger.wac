// fs's coverage, and the argument for every point nothing reaches.
//
//   wac task coverage:fs
//   wac task coverage:fs --verbose
//
// **Named rather than tolerated as a percentage below 100.** A report that sits at 84.2% for ever
// teaches everyone to ignore the last line, and then a genuinely new gap arrives and looks like the one
// that was always there. So this is a two-way ratchet over `tools/wac/covledger.wac`: anything not
// listed here is expected to be covered and the run fails if it is not — and anything listed that *does*
// get covered fails too, since the reason has stopped holding. `issues/system/0222`.
//
// ## What is left to measure
//
// `packages/fs`'s own filesystem, `Fs`, folded into std's `Files` (design/system/0013 step 5), and with it the
// 127 points that needed a `Cli` only a built program had or a parent process only a real child could ask.
// What remains is ours rather than general — the trees, the image, the process table, the words for a fault —
// and none of it needs a capability, so its tests are the whole workload (`cov_exercise.wac`) and almost
// every point is reached. Two pins and one rule are the rest, each with its reason.
//
// `proven` is two claims: `true`, no input reaches it; `false`, reachable and nobody has built the input.
//
// **Its failure message is the shared ratchet's**, which `tools/wac/coverageall.wac` matches — this package's
// own wording once matched none of the known shapes, so its principal failure printed nothing
// (`issues/system/0161`).

import { Sys, Env, Files, Modules, Output, Procs } from "std";
import { Pin, Rule, Measured, measure, report, ratchet, LedgerFlags, reportPoints } from "../../../tools/wac/covledger.wac";

static string EXERCISE = "packages/fs/test/cov_exercise.wac";

/**
 * `src/` and **not** `packages/fs/`: the tests' own branches are a test's branches.
 *
 * Counting them would put the driver's coverage into the package's number — and, worse, into the
 * ratchet, where an unexercised line of a *test* would read as an unaccounted line of the package.
 */
static string PREFIX = "packages/fs/src/";

/** Points the tests do not reach, each named on its own line. */
Pin[] pins() {
  return [
    Pin("packages/fs/src/trees.wac", 41, "async Result<Read, HostFault> noMore() { return Result.Ok(Read.End); }", true,
        "The `more` every node that is not endless carries, because a function field needs a value; only an endless " +
        "node's `more` is ever called."),
    Pin("packages/fs/src/trees.wac", 166, "Err(e): { return Result.Err(Unsupported(\"\\{e}\")); }", false,
        "A host with no random source, which every host the tests run on has.")
  ];
}

/**
 * Classes of point, matched by a pattern rather than named one at a time — one sentence for a fact that
 * repeats, where a pin per point would carry it several times.
 */
Rule[] rules() {
  return [
    Rule("packages/fs/src/wire.wac", "this.why == \"\"", "line", true,
         "**The `else` of first-error-wins, which cannot happen here.** Every reader that " +
         "records a reason sets `bad` in the same breath, and `byte()` answers zero for a " +
         "reader with `bad` set — so a reader that already has a `why` reads a length of " +
         "zero, zero is not negative, and this refusal is never reached a second time. The " +
         "guard is right and is what makes the property hold for the readers that *do* reach " +
         "it twice through other fields; here it is a statement rather than a branch. " +
         "`storeimage_test.wac`'s damaged images drive the arm that does fire. issues/lang/0112.")
  ];
}

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  Modules mods = sys.modules();
  LedgerFlags flags = LedgerFlags.read(argv);

  // Read and nothing else: every store and tree the tests build needs no capability, and the one file read
  // is the committed image fixture, which pins the format.
  Measured m = measure(err, env, fs, procs, EXERCISE, ["--allow-read"], string[].filled(0, ""));
  if (m.nPoints == 0) { return 1; }

  // `--points` dumps the per-point table instead of the report, unfiltered, so a caller can
  // union this driver's reach with another's — `issues/system/0241b`.
  if (flags.points) { reportPoints(out, m.points, m.nPoints, m.counts); return 0; }
  report(out, m.points, m.nPoints, m.counts, PREFIX, flags.verbose);
  return ratchet(err, out, fs, procs, m.points, m.nPoints, m.counts, PREFIX, pins(), rules()) ? 1 : 0;
}
