// The filesystem, in wac, because none of these values has a JS shape worth defining.
//
// The *oracle* for this package is the host filesystem — the same operations against a real disk have to
// answer the same way, and that is `test/host.test.ts`, which runs both. What is here is the part a
// differential cannot reach: the fault categories, the mount table's longest-prefix rule, and what
// happens at the edges of a path.

import { T } from "../../../wactest/src/assert.wac";
import { Fs, ROOT } from "../../src/fs.wac";
import { Buf } from "../../../bytes/src/buf.wac";
import { ASK_CHMOD, ASK_CHOWN, ASK_CLOSE_OUT, ASK_IS_HOST_PATH, ASK_LINK_STAT, ASK_MKDIR,
         ASK_OPEN_OUT, ASK_READ_DIR, ASK_READ_FILE, ASK_READ_SOME, ASK_REMOVE, ASK_RENAME, ASK_STAT,
         ASK_SET_EXECUTABLE, ASK_USER, ASK_WRITE_FILE, ASK_WRITE_OUT, decodeChange, decodeFileResult, decodeNames,
         decodeStat, encodeChange, encodeFileResult, encodeNames, encodeStat }
         from "../../src/remote.wac";
import { Reader } from "../../src/wire.wac";

/**
 * A `Reader` over a whole buffer.
 *
 * **`end` is one past the *body*, and passing zero is not "the default".** Written out because the
 * first version of this test built `Reader(bytes, 0, 0, …)` and every decode below took its
 * out-of-bounds branch: the round trips "passed" as faults, the coverage probe's numbers went up,
 * and the assertions here caught it by dereferencing the null that a failed `decodeNames` answers.
 */
Reader readerOver(u8[] bytes) { return Reader(bytes, bytes.len(), 0, false, ""); }

import { FAULT_DENIED, FAULT_EXISTS, FAULT_IS_DIR, FAULT_NONE, FAULT_NOT_A_DIR, FAULT_NOT_EMPTY, FAULT_NOT_FOUND, FAULT_OTHER, FAULT_UNSUPPORTED, FileResult, Change, Stat }
  from "../../../platform/src/platform.wac";

export string test_a_file_written_reads_back() {
  T t = T.create();
  Fs fs = Fs.inMemory(1000);
  t.isTrue(fs.stat("/").exists, "the root exists");
  t.isTrue(fs.stat("/").isDir, "and is a directory");
  t.isTrue(!fs.stat("/nope").exists, "nothing else does");

  t.eqI32(fs.writeFile("/a.txt", "hello\n".toBytes()).fault, FAULT_NONE(), "a write into the root");
  t.isTrue(fs.stat("/a.txt").isFile, "makes a file");
  t.eqI32(fs.stat("/a.txt").size as~ i32, 6, "of the right size");
  t.isTrue(fs.readFile("/a.txt").ok, "which reads");
  t.eqStr(string.fromBytes(fs.readFile("/a.txt").bytes), "hello\n", "byte for byte");

  // A second write replaces rather than appends, which is what a truncating write means.
  fs.writeFile("/a.txt", "bye\n".toBytes());
  t.eqStr(string.fromBytes(fs.readFile("/a.txt").bytes), "bye\n", "and replaces");
  t.eqI32(fs.stat("/a.txt").size as~ i32, 4, "with the new size");
  return t.report();
}

export string test_directories_and_their_faults() {
  T t = T.create();
  Fs fs = Fs.inMemory(1000);

  t.eqI32(fs.mkdir("/d", false).fault, FAULT_NONE(), "a directory");
  t.eqI32(fs.mkdir("/d", false).fault, FAULT_EXISTS(), "and again is 'file exists'");
  t.eqI32(fs.mkdir("/x/y", false).fault, FAULT_NOT_FOUND(), "no parents are made: that is the caller's loop");
  t.eqI32(fs.writeFile("/x/y.txt", "".toBytes()).fault, FAULT_NOT_FOUND(), "nor for a write");

  fs.writeFile("/d/f.txt", "x\n".toBytes());
  t.eqI32(fs.remove("/d", false).fault, FAULT_NOT_EMPTY(), "a directory with something in it is not empty");
  t.eqI32(fs.remove("/d/f.txt", false).fault, FAULT_NONE(), "the file goes");
  t.eqI32(fs.remove("/d", false).fault, FAULT_NONE(), "and then the directory does");
  t.eqI32(fs.remove("/d", false).fault, FAULT_NOT_FOUND(), "removing it twice is 'not there'");

  // The three answers `rm -f` needs to tell apart, which is why they are categories and not messages.
  t.eqI32(fs.mkdir("/e", false).fault, FAULT_NONE(), "another directory");
  // `FAULT_IS_DIR`, which used to be `FAULT_OTHER` "as the hosts say it" — and the hosts said it that way
  // because `faults.ts` had no word for `EISDIR`, so the category was matching a gap rather than a fact.
  // Both sides know now, and this is the assertion that they agree.
  t.eqI32(fs.readFile("/e").fault, FAULT_IS_DIR(), "reading a directory is refused, and says which");
  t.eqI32(fs.writeFile("/e", "no\n".toBytes()).fault, FAULT_IS_DIR(), "and so is writing over one");

  // ── `FAULT_NOT_A_DIR`: a file where a directory was wanted ──
  //
  // The other half of `FAULT_IS_DIR`, and the one every operation can reach, since any path with a `/`
  // walks components. This backing had **three** answers for it and none was the operating system's:
  // `FAULT_OTHER` from `writeFile`, `FAULT_DENIED` from `mkdir` and from `rename` — a *denial* for a
  // path nothing refused — and `find` collapsed a file-in-the-middle into "not there" before any of the
  // three could see it. Asserted here rather than only through a shell, because the categories are what
  // a program branches on and the sentences are only what a person reads.
  t.eqI32(fs.writeFile("/nd", "x\n".toBytes()).fault, FAULT_NONE(), "a plain file to walk into");
  t.eqI32(fs.writeFile("/nd/x", "".toBytes()).fault, FAULT_NOT_A_DIR(), "writing under a file");
  t.eqI32(fs.mkdir("/nd/x", false).fault, FAULT_NOT_A_DIR(), "making a directory under a file");
  t.eqI32(fs.remove("/nd/x", false).fault, FAULT_NOT_A_DIR(), "removing from under a file");
  t.eqI32(fs.readFile("/nd/x").fault, FAULT_NOT_A_DIR(), "reading from under a file");
  t.eqI32(fs.rename("/nd/x", "/e").fault, FAULT_NOT_A_DIR(), "moving out from under a file");
  t.eqI32(fs.rename("/e", "/nd").fault, FAULT_NOT_A_DIR(), "and a directory onto a file, as rename(2) has it");
  // Deeper than one component, which is `find`'s own branch rather than a caller's guard.
  t.eqI32(fs.readFile("/nd/x/y/z").fault, FAULT_NOT_A_DIR(), "and however far down the file sits");
  // **`stat` is the exception, and this is the assertion that keeps `test -e f/g` false.** The facts
  // are sound — there is nothing there — so `exists` is false and `answered` stays true; the category
  // rides along only so `ls`, `cd` and `stat` can say which absence it was.
  t.isFalse(fs.stat("/nd/x").exists, "nothing is at a path through a file");
  t.eqI32(fs.stat("/nd/x").fault, FAULT_NOT_A_DIR(), "and the stat says which kind of nothing");
  t.isTrue(fs.stat("/nd/x").answered(), "without making the stat unanswerable");
  t.isTrue(fs.remove("/nd/x", false).absent(), "which is what lets `rm -f` stay quiet, as GNU's does");
  return t.report();
}

export string test_a_listing_is_sorted_and_shallow() {
  T t = T.create();
  Fs fs = Fs.inMemory(1000);
  fs.writeFile("/b", "".toBytes());
  fs.writeFile("/a", "".toBytes());
  fs.mkdir("/c", false);
  fs.writeFile("/c/inside", "".toBytes());

  string[] names = fs.readDir("/")!;
  t.eqI32(names.len(), 3, "three names at the root");
  t.eqStr(names[0], "a", "sorted by bytes");
  t.eqStr(names[1], "b", "…");
  t.eqStr(names[2], "c", "…and nothing from inside `c`");
  t.eqI32(fs.readDir("/c")!.len(), 1, "which has its own");
  t.isTrue(fs.readDir("/a") is null, "a file is not a directory, and says so");
  t.isTrue(fs.readDir("/nope") is null, "and neither is a path that is not there");
  return t.report();
}

export string test_rename_moves_a_name() {
  T t = T.create();
  Fs fs = Fs.inMemory(1000);
  fs.mkdir("/d", false);
  fs.writeFile("/a", "one\n".toBytes());

  t.eqI32(fs.rename("/a", "/d/b").fault, FAULT_NONE(), "a move into a directory");
  t.isTrue(!fs.stat("/a").exists, "the old name is gone");
  t.eqStr(string.fromBytes(fs.readFile("/d/b").bytes), "one\n", "and the bytes came with it");

  fs.writeFile("/c", "two\n".toBytes());
  t.eqI32(fs.rename("/d/b", "/c").fault, FAULT_NONE(), "a move over an existing name replaces it");
  t.eqStr(string.fromBytes(fs.readFile("/c").bytes), "one\n", "with the mover's bytes");
  t.eqI32(fs.rename("/gone", "/x").fault, FAULT_NOT_FOUND(), "moving what is not there");
  t.eqI32(fs.rename("/c", "/nodir/x").fault, FAULT_NOT_FOUND(), "moving into what is not there");
  return t.report();
}

export string test_a_mount_takes_the_longest_prefix() {
  T t = T.create();
  Fs fs = Fs.inMemory(1000);
  fs.mkdir("/home", false);
  fs.writeFile("/home/outside", "root fs\n".toBytes());
  fs.mountMemory("/home");

  // The mount shadows what was under it rather than merging: two filesystems, one path.
  t.isTrue(!fs.stat("/home/outside").exists, "the mount shadows the directory it covers");
  t.eqI32(fs.writeFile("/home/inside", "mounted\n".toBytes()).fault, FAULT_NONE(), "a write lands in it");
  t.eqStr(string.fromBytes(fs.readFile("/home/inside").bytes), "mounted\n", "and reads back from it");
  t.eqI32(fs.readDir("/home")!.len(), 1, "which is its own root");

  // …and a name that merely *starts* with the mount point is not under it.
  t.eqI32(fs.writeFile("/homework", "elsewhere\n".toBytes()).fault, FAULT_NONE(), "`/homework` is not `/home`");
  t.eqStr(string.fromBytes(fs.readFile("/homework").bytes), "elsewhere\n", "and stays where it was written");

  // A rename across mounts is not implemented, and says so rather than half-doing it — in the
  // category for exactly that, which is what this line was reaching for when it said `FAULT_DENIED`.
  // That word means the *file* refused, and nothing here did; wac-mono 0117 gave it its own.
  t.eqI32(fs.rename("/homework", "/home/hw").fault, FAULT_UNSUPPORTED(), "across mounts is refused: not implemented, and said so");
  return t.report();
}

export string test_names_are_bytes() {
  T t = T.create();
  Fs fs = Fs.inMemory(1000);
  // A name a UTF-8 decoder would replace. Inside the filesystem it is four bytes and stays four bytes:
  // this is the property a host cannot offer today — wac-mono 0065 — and the reason it is tested here.
  u8[] odd = u8[4](fill: 0);
  odd[0] = 'x';
  odd[1] = 0xff;
  odd[2] = 0xfe;
  odd[3] = 'y';
  string name = "/" + string.fromBytes(odd);
  t.eqI32(fs.writeFile(name, "held\n".toBytes()).fault, FAULT_NONE(), "a write under a name that is not text");
  t.eqStr(string.fromBytes(fs.readFile(name).bytes), "held\n", "reads back");
  string[] names = fs.readDir("/")!;
  t.eqI32(names.len(), 1, "and lists as one name");
  t.eqI32(names[0].toBytes().len(), 4, "of four bytes, unchanged");
  t.eqI32(names[0].toBytes()[1], 0xff, "including the one a decoder would have replaced");
  return t.report();
}

// ── Users, modes and who may do what ─────────────────────────────────────────
//
// design/0001 step 4. `mode` and `owner` were recorded on every node and enforced nowhere, which the
// struct's own comment said out loud — so a session could read anything, and the metadata was decoration.
// What is enforced is the permission on the thing being touched; **traversal is not**, and these cases
// say which is which rather than leaving a reader to infer it.

export string test_a_private_file_is_private() {
  T t = T.create();
  Fs fs = Fs.inMemory(1000);
  fs.mkdir("/home", true);
  fs.mkdir("/home/ada", true);
  fs.writeFile("/home/ada/secret", "engine\n".toBytes());
  fs.chmod("/home/ada/secret", 384);            // 0600
  fs.chown("/home/ada/secret", "ada");

  // Root is exempt, which is what every existing caller relies on: a filesystem with no user set behaves
  // as it did before there were users at all.
  t.eqStr(string.fromBytes(fs.readFile("/home/ada/secret").bytes), "engine\n", "root reads it");

  fs.setUser("grace");
  FileResult denied = fs.readFile("/home/ada/secret");
  t.isTrue(!denied.ok, "another user cannot read it");
  t.eqI32(denied.fault, FAULT_DENIED(), "and is told that, rather than that it is missing");

  fs.setUser("ada");
  t.eqStr(string.fromBytes(fs.readFile("/home/ada/secret").bytes), "engine\n", "its owner can");

  // **An unset user is nobody, not everybody.** `may`, `chmod` and `chown` each used to read
  // `user != "" && user != "root"`, so the empty name was exempt alongside root — three copies of one
  // condition, and the second meaning was invisible in each of them. Anybody writing `setUser("")` to
  // mean *nobody* got a session that could read every private file in the image.
  //
  // Nothing reaches it today, which is why this is a test rather than a bug report: `Fs` starts as
  // root and `packages/ssh` maps an unnameable key to root deliberately (issues/system/0126). A trap
  // nothing has sprung is still a trap, and this is what keeps it shut.
  fs.setUser("");
  FileResult nobody = fs.readFile("/home/ada/secret");
  t.isTrue(!nobody.ok, "an unset user cannot read a private file");
  t.eqI32(nobody.fault, FAULT_DENIED(), "and is denied rather than told it is missing");
  t.eqI32(fs.chmod("/home/ada/secret", 438).fault, FAULT_DENIED(), "nor widen it");
  t.eqI32(fs.chown("/home/ada/secret", "nobody").fault, FAULT_DENIED(), "nor take it");
  // ...and it can still read what is readable by anyone, which is what "nobody in particular" means.
  fs.setUser(ROOT());
  fs.writeFile("/home/ada/public", "open\n".toBytes());
  fs.chmod("/home/ada/public", 420);           // 0644
  fs.setUser("");
  t.eqStr(string.fromBytes(fs.readFile("/home/ada/public").bytes), "open\n", "but reads a 0644 file");
  return t.report();
}

export string test_the_other_bits_are_the_ones_that_apply() {
  T t = T.create();
  Fs fs = Fs.inMemory(1000);
  fs.writeFile("/shared", "for everyone\n".toBytes());
  fs.chmod("/shared", 420);                     // 0644
  fs.chown("/shared", "ada");
  fs.writeFile("/half", "readable\n".toBytes());
  fs.chmod("/half", 292);                       // 0444 — nobody may write, not even the owner
  fs.chown("/half", "ada");

  fs.setUser("grace");
  t.isTrue(fs.readFile("/shared").ok, "0644 is readable by another user");
  t.eqI32(fs.writeFile("/shared", "x".toBytes()).fault, FAULT_DENIED(), "and not writable by them");

  fs.setUser("ada");
  t.eqI32(fs.writeFile("/shared", "mine\n".toBytes()).fault, FAULT_NONE(), "its owner may write it");
  // The owner bits are the owner's, and they can say no: 0444 means no, to everyone.
  t.eqI32(fs.writeFile("/half", "x".toBytes()).fault, FAULT_DENIED(), "0444 refuses its own owner");
  return t.report();
}

export string test_a_directory_carries_its_own_permission() {
  T t = T.create();
  Fs fs = Fs.inMemory(1000);
  fs.mkdir("/private", false);
  fs.writeFile("/private/note", "hello\n".toBytes());
  fs.chmod("/private", 448);                    // 0700
  fs.chown("/private", "ada");
  fs.chown("/private/note", "ada");

  fs.setUser("grace");
  t.isTrue(fs.readDir("/private") is null, "another user cannot list it");
  t.eqI32(fs.writeFile("/private/new", "x".toBytes()).fault, FAULT_DENIED(), "or create in it");
  t.eqI32(fs.remove("/private/note", false).fault, FAULT_DENIED(), "or remove from it");
  // **Traversal is not enforced**, and this is the case that says so: the file's own mode is what
  // protects it, not the directory above. Said in a test rather than left for someone to discover.
  t.isTrue(fs.readFile("/private/note").ok, "but the file inside is protected by its own mode, not by the path");

  fs.setUser("ada");
  t.isTrue(!(fs.readDir("/private") is null), "its owner can list it");
  return t.report();
}

export string test_changing_the_metadata_is_not_a_way_in() {
  T t = T.create();
  Fs fs = Fs.inMemory(1000);
  fs.writeFile("/secret", "engine\n".toBytes());
  fs.chmod("/secret", 384);                     // 0600
  fs.chown("/secret", "ada");

  fs.setUser("grace");
  // Widening it and then reading is the obvious way around a permission check, so `chmod` is the
  // owner's and `chown` is root's.
  t.eqI32(fs.chmod("/secret", 511).fault, FAULT_DENIED(), "another user cannot widen the mode");
  t.eqI32(fs.chown("/secret", "grace").fault, FAULT_DENIED(), "or take the file");
  t.isTrue(!fs.readFile("/secret").ok, "so it stays unreadable");
  return t.report();
}

export string test_every_way_of_changing_a_directory_is_checked() {
  T t = T.create();
  Fs fs = Fs.inMemory(1000);
  fs.mkdir("/home", false);
  fs.mkdir("/home/ada", false);
  fs.writeFile("/home/ada/secret", "engine\n".toBytes());
  fs.chmod("/home/ada", 448);                   // 0700
  fs.chown("/home/ada", "ada");
  fs.chmod("/home/ada/secret", 384);            // 0600
  fs.chown("/home/ada/secret", "ada");
  fs.mkdir("/tmp", false);
  fs.chmod("/tmp", 511);                        // 0777, so the *other* end of a rename is allowed

  // Writing and removing were checked when the enforcement went in. These four are the ones that were
  // not, and every one of them changes what a directory holds — which is the property, rather than the
  // list of functions that happened to be remembered.
  fs.setUser("grace");
  t.eqI32(fs.mkdir("/home/ada/mine", false).fault, FAULT_DENIED(), "mkdir in another user's directory");
  t.eqI32(fs.mkdir("/home/ada/a/b", true).fault, FAULT_DENIED(), "and with -p, which creates several");
  // A rename is not a read and not a write of the file — it is two directory changes — so a file this
  // user could never open can still be *taken* unless the directories are checked.
  t.eqI32(fs.rename("/home/ada/secret", "/tmp/taken").fault, FAULT_DENIED(), "moving it out of the directory");
  // …and into it, which needs a file to move: `/tmp` is 0777, so this user may make one there. The
  // "not there" answer comes first for a source that does not exist, which is what a real system says
  // too — so the case has to be a rename that would otherwise work.
  t.eqI32(fs.writeFile("/tmp/x", "mine\n".toBytes()).fault, FAULT_NONE(), "a file of her own in /tmp");
  t.eqI32(fs.rename("/tmp/x", "/home/ada/planted").fault, FAULT_DENIED(), "cannot be moved into another user's directory");
  t.isTrue(fs.stat("/home/ada/secret").exists, "so the file is still where its owner left it");

  fs.setUser("ada");
  t.eqI32(fs.mkdir("/home/ada/mine", false).fault, FAULT_NONE(), "its owner may make one");
  t.eqI32(fs.rename("/home/ada/secret", "/home/ada/mine/secret").fault, FAULT_NONE(), "and move it about");
  return t.report();
}

/**
 * The child/parent wire, round-tripped — the half of `remote.wac` that needs no peer.
 *
 * **Why here and not only in the coverage probe.** `cov.ts` gained a `wireOps` that walks these same
 * functions, and executing them is not the same as checking them: a probe raises the number and
 * would keep passing if a `Stat`'s mode crossed and its fault did not. That failure is invisible at
 * the call site too — a child asks its parent about a file, gets an answer that decodes, and acts on
 * a permission that is not the one the parent computed.
 *
 * What cannot be checked here is the `Chan` half: a channel needs a peer that answers, and a wac fake
 * has no state to answer from. `packages/box/test/sealing.test.ts` drives that against real spawned
 * children, which is why wac-mono 0134 records those points rather than driving them.
 */
export string test_the_remote_wire_survives_a_round_trip() {
  T t = T.create();

  Buf a = Buf.create();
  encodeFileResult(a, FileResult.of(true, "hello\n".toBytes(), "", FAULT_NONE()));
  FileResult read = decodeFileResult(readerOver(a.take()));
  t.isTrue(read.ok, "a successful read stays successful");
  t.eqI32(read.bytes.len(), 6, "the bytes cross intact");
  t.eqI32(read.fault, FAULT_NONE(), "and carry no fault");

  Buf b = Buf.create();
  encodeFileResult(b, FileResult.of(false, u8[0](), "no such file or directory", FAULT_NOT_FOUND()));
  FileResult missing = decodeFileResult(readerOver(b.take()));
  t.isTrue(!missing.ok, "a failed read stays failed");
  t.eqI32(missing.fault, FAULT_NOT_FOUND(), "with its category");
  t.eqStr(missing.error, "no such file or directory", "and the host's own words");

  // Every field of a `Stat`, because each one is a permission or a listing somewhere and a partial
  // encoding is a wrong answer with no error attached.
  Buf c = Buf.create();
  encodeStat(c, Stat.of(true, true, false, 4096 as i64, 1786096061 as i64, false, true, FAULT_NONE()));
  Stat st = decodeStat(readerOver(c.take()));
  t.isTrue(st.exists && st.isFile && !st.isDir, "the three kinds cross");
  t.isTrue(st.isExecutable && !st.isSymlink, "and the two bits");
  t.eqI32(st.size as~ i32, 4096, "the size crosses");
  t.eqI32(st.fault, FAULT_NONE(), "and the fault");

  Buf d = Buf.create();
  encodeChange(d, Change.of(FAULT_EXISTS(), "File exists"));
  Change ch = decodeChange(readerOver(d.take()));
  t.eqI32(ch.fault, FAULT_EXISTS(), "a change's category crosses");
  t.eqStr(ch.message, "File exists", "and its message");

  // **A listing and a null are different answers.** `readDir` says null for "not a directory" and an
  // empty array for "a directory with nothing in it" — an encoding that lost the difference would
  // make `ls` of a file print nothing instead of complaining.
  Buf e = Buf.create();
  string[] names = string[2](fill: "");
  names[0] = "bin"; names[1] = "etc";
  encodeNames(e, names);
  string[]? listed = decodeNames(readerOver(e.take()));
  t.isTrue(!(listed is null), "a listing crosses as a listing");
  t.eqI32(listed!.len(), 2, "with its entries");
  t.eqStr(listed![1], "etc", "in order");

  Buf f = Buf.create();
  encodeNames(f, null);
  t.isTrue(decodeNames(readerOver(f.take())) is null, "and a null crosses as a null");

  Buf g = Buf.create();
  string[] none = string[0](fill: "");
  encodeNames(g, none);
  string[]? empty = decodeNames(readerOver(g.take()));
  t.isTrue(!(empty is null) && empty!.len() == 0, "an empty directory is not a null");

  // A reader that is already broken answers a fault rather than reading past the end — the state
  // every one of these lands in when the far end has gone. All four, because each has its own way of
  // saying nothing: a fault, an empty result, and a null that is not the null meaning "not a
  // directory".
  Reader dead = Reader(u8[0](), 0, 0, true, "the parent went away");
  t.eqI32(decodeChange(dead).fault, FAULT_OTHER(), "a broken channel is a fault, not a silence");
  t.eqI32(decodeStat(dead).fault, FAULT_OTHER(), "a stat from a dead channel is a fault");
  t.isTrue(!decodeFileResult(dead).ok, "and a read is not ok");
  t.isTrue(decodeNames(dead) is null, "and a listing is null");

  // **The opcodes are a contract between two processes.** A child sends a number and its parent
  // switches on it; renumbering one end turns every `stat` into a `readDir` and nothing says so,
  // because both sides still parse. Pinned as the numbers rather than as "they are distinct".
  t.eqI32(ASK_READ_FILE(), 1, "read file");
  t.eqI32(ASK_READ_SOME(), 2, "read some");
  t.eqI32(ASK_STAT(), 3, "stat");
  t.eqI32(ASK_READ_DIR(), 4, "read dir");
  t.eqI32(ASK_WRITE_FILE(), 5, "write file");
  t.eqI32(ASK_MKDIR(), 6, "mkdir");
  t.eqI32(ASK_REMOVE(), 7, "remove");
  t.eqI32(ASK_CHMOD(), 8, "chmod");
  t.eqI32(ASK_CHOWN(), 9, "chown");
  t.eqI32(ASK_RENAME(), 10, "rename");
  t.eqI32(ASK_OPEN_OUT(), 11, "open out");
  t.eqI32(ASK_WRITE_OUT(), 12, "write out");
  t.eqI32(ASK_CLOSE_OUT(), 13, "close out");
  t.eqI32(ASK_IS_HOST_PATH(), 14, "is host path");
  t.eqI32(ASK_LINK_STAT(), 15, "link stat");
  t.eqI32(ASK_USER(), 16, "user");
  // Seventeen, not sixteen. The coverage run found this one: it listed `ASK_SET_EXECUTABLE` as an
  // uncovered branch after the other sixteen were pinned, which is a list saying it is incomplete.
  t.eqI32(ASK_SET_EXECUTABLE(), 17, "set executable");
  return t.report();
}

/**
 * The **first** fault a reader records is the one it keeps.
 *
 * Every field reader marks `bad` and then writes `why` only when `why` is empty, so a message with
 * two things wrong reports the first rather than the last. That matters because the first is the one
 * that explains the rest: a truncated buffer makes every later field wrong too, and a reader that
 * overwrote would hand back a complaint about the *symptom* — "a length above two gigabytes" for a
 * message whose real problem was that it ended three bytes ago.
 *
 * The second half also shows *why* the guard cannot fire twice, which is what the coverage ledger
 * needed to record: a reader with a reason is a reader with `bad` set, and `byte()` answers zero for
 * one of those — so the length is never negative and the refusal is never reached again. The
 * property holds by construction rather than by the guard. `issues/lang/0112`.
 */
export string test_the_first_fault_is_the_one_that_is_kept() {
  T t = T.create();

  // Four bytes with the top bit set: read as a signed `i32` this is negative, which `i32()` refuses
  // as a length. A fresh reader records that refusal.
  u8[] huge = u8[4]();
  huge[0] = 0; huge[1] = 0; huge[2] = 0; huge[3] = 128;
  Reader fresh = Reader(huge, huge.len(), 0, false, "");
  t.eqI32(fresh.u32(), 0, "a negative length reads as zero");
  t.isTrue(fresh.bad, "and marks the reader");
  t.eqStr(fresh.why, "a length above two gigabytes, which cannot be one", "with its own reason");

  // The same read on a reader that already failed for another reason keeps the earlier reason.
  Reader carried = Reader(huge, huge.len(), 0, true, "the message ended early");
  t.eqI32(carried.u32(), 0, "the second fault still answers zero");
  t.isTrue(carried.bad, "and the reader is still bad");
  t.eqStr(carried.why, "the message ended early", "but the first reason is the one that survives");

  return t.report();
}
