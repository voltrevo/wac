// Everything `packages/fs` can be asked to do, in a shape a coverage driver can call.
//
// A probe rather than direct binding, for two reasons that are both about capabilities:
//
//   * a **synth** mount takes `fn<Pending<u8[]>(i32)>`, and building one of those from TypeScript means
//     building a `Pending` from TypeScript — three funcrefs and an id — where building it here is four
//     lines and deterministic, which is what a coverage run wants;
//   * a **host** mount takes a whole `Cli`, which only a built program has. Those branches are driven by
//     `test/host.test.ts` and `test/backingsprocess_test.wac` against the real filesystem, and are recorded as
//     unreached here with that as the reason.
//
// Each function builds its own filesystem and returns a transcript, because wac has no mutable
// module-level state: there is nowhere to keep an `Fs` between two calls from the driver.

import { Vec } from "core";
import { Buf } from "core";
import { Change, FAULT_EXISTS, FAULT_NONE, FAULT_NOT_FOUND, FileResult, Pending, Stat }
         from "std";
import { Fs, Mount, mountSystem } from "../../src/fs.wac";
import { Loaded, Written, dump, read, write } from "../../src/image.wac";
import { ASK_CHMOD, ASK_CHOWN, ASK_CLOSE_OUT, ASK_IS_HOST_PATH, ASK_LINK_STAT, ASK_MKDIR,
         ASK_OPEN_OUT, ASK_READ_DIR, ASK_READ_FILE, ASK_READ_SOME, ASK_REMOVE, ASK_RENAME, ASK_STAT,
         ASK_SET_EXECUTABLE, ASK_USER, ASK_WRITE_FILE, ASK_WRITE_OUT, decodeChange, decodeFileResult,
         decodeNames, decodeStat, encodeChange, encodeFileResult, encodeNames, encodeStat, request }
         from "../../src/remote.wac";
import { Reader } from "../../src/wire.wac";

/**
 * A `Reader` over a whole buffer.
 *
 * **`end` is one past the *body*, and passing zero is not "the default".** Written out because the
 * first version of this test built `Reader(bytes, 0, 0, …)` and every decode below took its
 * out-of-bounds branch: the round trips "passed" as faults, the coverage probe's numbers went up,
 * and the assertions here caught it by dereferencing the null that a failed `decodeNames` answers.
 */
Reader readerOver(u8[] bytes) { return Reader(bytes, bytes.len(), 0, false, ""); }

import { crc32 } from "../../../gzip/src/crc32.wac";
import { Proc, Procs, SIGINT, SIGNALS, SIGTERM, signalIgnored, signalName, signalNumber,
         signalStops } from "../../src/proc.wac";

// ── A deterministic stand-in for the host's CSPRNG ────────────────────────────
//
// The bytes are a counter, not random, and that is deliberate: a coverage run that changed its input
// every time would make a difference in the report impossible to attribute. `test/synth.test.ts` checks
// that the *real* one is random, through a built program, which is the only place that can.

u8[] fakeRandom(i32 n) {
  u8[] out = u8[].filled(n, 0);
  for (i32 i = 0; i < n; i++) { out[i] = ((i * 7 + 11) & 255) as@ u8; }
  return out;
}

bool alwaysSettled(i32 id) { return true; }
void noDrop(i32 id) {}

Pending<u8[]> pendingRandom(i32 n) {
  return Pending.of(n, fakeRandom, alwaysSettled, noDrop);
}

/** A filesystem with a memory root, `/mnt`, and the two synthesised mounts. */
Fs system() {
  Fs fs = Fs.inMemory(1754500000000);
  fs.mountMemory("/mnt");
  Vec<string> argv = Vec.create();
  argv.push("probe");
  argv.push("-x");
  mountSystem(fs, pendingRandom, argv, Vec.create());
  return fs;
}

// ── Transcripts ───────────────────────────────────────────────────────────────

void say(Buf out, string what) {
  out.pushAll(what.toBytes());
  out.push(10);
}

string faultOf(Change c) { return "\{c.fault}"; }

/** Every ordinary operation and every refusal a memory mount can produce. */
export async string memoryOps() {
  Buf out = Buf.create();
  Fs fs = system();

  say(out, "mkdir " + faultOf((await fs.mkdir("/d", false))));
  say(out, "mkdir again " + faultOf((await fs.mkdir("/d", false))));
  say(out, "mkdir -p " + faultOf((await fs.mkdir("/a/b/c", true))));
  say(out, "mkdir -p again " + faultOf((await fs.mkdir("/a/b/c", true))));
  say(out, "mkdir no parent " + faultOf((await fs.mkdir("/nope/x", false))));

  say(out, "write " + faultOf((await fs.writeFile("/d/f", "hello".toBytes()))));
  say(out, "rewrite " + faultOf((await fs.writeFile("/d/f", "bye".toBytes()))));
  say(out, "write no parent " + faultOf((await fs.writeFile("/nope/f", "x".toBytes()))));
  say(out, "write over dir " + faultOf((await fs.writeFile("/d", "x".toBytes()))));
  say(out, "write under file " + faultOf((await fs.writeFile("/d/f/g", "x".toBytes()))));
  // `mkdir` where a file already is, and a file where a directory already is.
  say(out, "mkdir over file " + faultOf((await fs.mkdir("/d/f", false))));
  say(out, "mkdir -p over file " + faultOf((await fs.mkdir("/d/f/deeper", true))));

  FileResult r = await fs.readFile("/d/f");
  say(out, "read " + (r.ok ? string.fromBytes(r.bytes) : "!\{r.error}"));
  say(out, "read missing " + (await fs.readFile("/d/nope")).error);
  say(out, "read dir " + (await fs.readFile("/d")).error);
  FileResult some = await fs.readSome("/d/f", 2);
  say(out, "readSome " + (some.ok ? string.fromBytes(some.bytes) : "!\{some.error}"));
  say(out, "readSome past end " + string.fromBytes((await fs.readSome("/d/f", 99)).bytes));
  say(out, "readSome negative " + (await fs.readSome("/d/f", -1)).error);

  Stat st = await fs.stat("/d/f");
  say(out, "stat " + (st.exists ? "file=" + (st.isFile ? "y" : "n") : "absent"));
  say(out, "stat dir " + ((await fs.stat("/d")).isDir ? "dir" : "not"));
  say(out, "stat missing " + ((await fs.stat("/nope")).exists ? "there" : "absent"));
  say(out, "linkStat " + ((await fs.linkStat("/d/f")).exists ? "there" : "absent"));

  string[]? names = await fs.readDir("/d");
  say(out, "readDir " + (names is null ? "null" : "\{names!.len()}"));
  say(out, "readDir file " + ((await fs.readDir("/d/f")) is null ? "null" : "listed"));
  say(out, "readDir missing " + ((await fs.readDir("/nope")) is null ? "null" : "listed"));
  say(out, "readDir root \{(await fs.readDir("/"))!.len()}");

  say(out, "chmod " + faultOf((await fs.chmod("/d/f", 384))));
  say(out, "chmod missing " + faultOf((await fs.chmod("/nope", 384))));
  say(out, "chown " + faultOf((await fs.chown("/d/f", "someone"))));
  say(out, "chown missing " + faultOf((await fs.chown("/nope", "someone"))));

  say(out, "rename " + faultOf((await fs.rename("/d/f", "/d/g"))));
  say(out, "rename missing " + faultOf((await fs.rename("/d/nope", "/d/h"))));
  say(out, "rename no parent " + faultOf((await fs.rename("/d/g", "/nope/h"))));
  say(out, "rename cross mount " + faultOf((await fs.rename("/d/g", "/mnt/g"))));
  say(out, "rename onto dir " + faultOf((await fs.rename("/d/g", "/a/b"))));

  say(out, "rm " + faultOf((await fs.remove("/d/g", false))));
  say(out, "rm missing " + faultOf((await fs.remove("/d/g", false))));
  say(out, "rm nonempty " + faultOf((await fs.remove("/a", false))));
  say(out, "rm -r " + faultOf((await fs.remove("/a", true))));
  say(out, "rm no parent " + faultOf((await fs.remove("/nope/x", false))));
  return string.fromBytes(out.take());
}

/** The synthesised mounts: every file, every refusal, and both read shapes. */
export async string synthOps() {
  Buf out = Buf.create();
  Fs fs = system();

  say(out, "dev " + joined((await fs.readDir("/dev"))));
  say(out, "proc " + joined((await fs.readDir("/proc"))));
  say(out, "proc/self " + joined((await fs.readDir("/proc/self"))));
  say(out, "dev file listing " + ((await fs.readDir("/dev/null")) is null ? "null" : "listed"));
  say(out, "dev missing listing " + ((await fs.readDir("/dev/sda")) is null ? "null" : "listed"));

  say(out, "null read \{(await fs.readFile("/dev/null")).bytes.len()}");
  say(out, "cmdline \{(await fs.readFile("/proc/self/cmdline")).bytes.len()}");
  // `/status` is the third synthetic file a pid directory serves, and the only one nothing read.
  say(out, "status \{(await fs.readFile("/proc/self/status")).bytes.len()}");
  say(out, "status stat \{(await fs.stat("/proc/self/status")).size}");
  say(out, "cmdline some \{(await fs.readSome("/proc/self/cmdline", 3)).bytes.len()}");
  // `status` is the third of the three files a `/proc/<pid>` directory holds, and the only one
  // nothing here had ever asked for.
  say(out, "status " + ((await fs.readFile("/proc/self/status")).bytes.len() > 0 ? "some" : "none"));
  // …and a fourth name, which there is no such file for. A `/proc/<pid>` directory holds exactly
  // three things, so asking for anything else must be absent rather than empty.
  say(out, "proc unknown " + ((await fs.stat("/proc/self/nosuch")).exists ? "there" : "absent"));

  // **A synth mount that is none of the three the system makes.** `mountSynth` is public, so a
  // caller may put one anywhere; `synthKind` knows `/dev`, `/bin` and `/proc` by name and has to
  // answer *nothing here* for the rest rather than fall through to whichever branch is last.
  fs.mountSynth("/elsewhere", pendingRandom);
  say(out, "unknown synth dir " + ((await fs.stat("/elsewhere")).isDir ? "dir" : "not"));
  say(out, "unknown synth file " + ((await fs.stat("/elsewhere/anything")).exists ? "there" : "absent"));
  say(out, "cmdline past end \{(await fs.readSome("/proc/self/cmdline", 99)).bytes.len()}");
  say(out, "zero some \{(await fs.readSome("/dev/zero", 8)).bytes.len()}");
  say(out, "random some \{(await fs.readSome("/dev/urandom", 8)).bytes.len()}");
  say(out, "random alias \{(await fs.readSome("/dev/random", 4)).bytes.len()}");
  say(out, "zero whole " + (await fs.readFile("/dev/zero")).error);
  say(out, "random whole " + (await fs.readFile("/dev/urandom")).error);
  say(out, "missing " + (await fs.readFile("/dev/sda")).error);
  say(out, "dir read " + (await fs.readFile("/dev")).error);
  say(out, "proc dir read " + (await fs.readFile("/proc/self")).error);

  say(out, "stat null " + ((await fs.stat("/dev/null")).isFile ? "file" : "not"));
  say(out, "stat dev " + ((await fs.stat("/dev")).isDir ? "dir" : "not"));
  say(out, "stat cmdline \{(await fs.stat("/proc/self/cmdline")).size}");
  say(out, "stat zero \{(await fs.stat("/dev/zero")).size}");
  say(out, "stat missing " + ((await fs.stat("/dev/sda")).exists ? "there" : "absent"));

  say(out, "write null " + faultOf((await fs.writeFile("/dev/null", "anything".toBytes()))));
  say(out, "write zero " + faultOf((await fs.writeFile("/dev/zero", "x".toBytes()))));
  say(out, "mkdir dev " + faultOf((await fs.mkdir("/dev/d", false))));
  say(out, "rm dev " + faultOf((await fs.remove("/dev/null", false))));
  say(out, "chmod dev " + faultOf((await fs.chmod("/dev/null", 384))));
  say(out, "chown dev " + faultOf((await fs.chown("/dev/null", "root"))));
  say(out, "rename out of dev " + faultOf((await fs.rename("/dev/null", "/null"))));
  say(out, "rename into dev " + faultOf((await fs.rename("/mnt", "/dev/mnt"))));
  return string.fromBytes(out.take());
}

/** Writing an image, reading it back, and every way one can be wrong. */
export async string imageOps() {
  Buf out = Buf.create();
  Fs fs = system();
  await fs.mkdir("/d", false);
  await fs.writeFile("/d/f", "hello".toBytes());
  await fs.writeFile("/empty", u8[]());
  await fs.mkdir("/emptydir", false);
  await fs.chmod("/d/f", 384);
  await fs.chown("/d/f", "claude");
  await fs.remove("/empty", false);            // a node the writer will not reach

  Written w = write(fs);
  say(out, "written \{w.bytes.len()} skipped \{w.skipped.len()}");

  Loaded back = read(w.bytes, 0);
  say(out, "read " + (back.ok ? "ok" : "!\{back.error}"));
  say(out, "reloaded " + (back.ok ? string.fromBytes((await back.fs.readFile("/d/f")).bytes) : ""));
  // Rewriting what was read gives the same bytes, which is the property the tests rest on.
  say(out, "rewrite \{write(back.fs).bytes.len()}");

  say(out, "dump \{dump(w.bytes).len()}");
  say(out, "short \{read(u8[].filled(3, 0), 0).error}");
  say(out, "magic " + read("not an image at all!!".toBytes(), 0).error);

  u8[] wrongVersion = copyOf(w.bytes);
  wrongVersion[7] = 99;
  say(out, "version \{read(wrongVersion, 0).error}");

  u8[] cut = u8[].filled(w.bytes.len() - 6, 0);
  cut.copyFrom(w.bytes, 0, 0, cut.len());
  say(out, "truncated \{read(cut, 0).error}");

  u8[] flipped = copyOf(w.bytes);
  flipped[flipped.len() / 2] = flipped[flipped.len() / 2] ^ 255;
  say(out, "flipped \{read(flipped, 0).error}");
  say(out, "dump of a bad one \{dump(flipped).len()}");
  return string.fromBytes(out.take());
}

/**
 * Images whose **checksum is right and whose body is wrong**.
 *
 * The reader checks the CRC before it believes anything, so every malformed image a test had shown it was
 * refused by the checksum and its own guards — a short read inside a mount name, a node kind that is
 * neither file nor directory, a length that runs past the end — had never executed. Those are its
 * defences against a *writer* with a bug rather than against a damaged file, and a damaged file is the
 * only thing anything had ever handed it.
 *
 * Each of these is a body assembled by hand with the correct CRC appended, which is the only way past the
 * first gate.
 */
export async string imageBadOps() {
  Buf out = Buf.create();
  say(out, "no mount name \{read(sealed(oneMount()), 0).error}");

  Buf named = oneMount();
  putStr(named, "/home");
  say(out, "no node \{read(sealed(named), 0).error}");

  Buf kind = oneMount();
  putStr(kind, "/home");
  node(kind, 7);                                  // a complete header whose kind is neither
  say(out, "bad kind \{read(sealed(kind), 0).error}");

  Buf shortNode = oneMount();
  putStr(shortNode, "/home");
  shortNode.push(0);
  shortNode.pushU32(420 as@ u32);                 // mode, then the owner string runs out
  say(out, "node cut short \{read(sealed(shortNode), 0).error}");

  Buf longFile = oneMount();
  putStr(longFile, "/home");
  node(longFile, 0);
  longFile.pushU32(9999 as@ u32);                 // a length nothing follows
  say(out, "length past the end \{read(sealed(longFile), 0).error}");

  Buf negative = oneMount();
  putStr(negative, "/home");
  node(negative, 0);
  negative.pushU32(0x80000000 as@ u32);           // a length that is negative as an i32
  say(out, "negative length \{read(sealed(negative), 0).error}");

  Buf badEntry = oneMount();
  putStr(badEntry, "/home");
  node(badEntry, 1);
  badEntry.pushU32(1 as@ u32);                    // one entry, and then nothing
  say(out, "entry cut short \{read(sealed(badEntry), 0).error}");

  // A directory header that is complete and stops before saying **how many entries** it has. The
  // count is the last field of a directory, so this is the shortest possible truncation that gets
  // as far as pushing the directory's own node into the pool — the reader has already grown the
  // filesystem by one node when it finds out there is nothing to put in it.
  Buf noCount = oneMount();
  putStr(noCount, "/home");
  node(noCount, 1);
  say(out, "no entry count \{read(sealed(noCount), 0).error}");

  // One entry whose *name* arrives and whose **child node** does not, which is the failure one
  // level down: the recursion answers -1 and this level has to stop rather than record the entry.
  Buf noChild = oneMount();
  putStr(noChild, "/home");
  node(noChild, 1);
  noChild.pushU32(1 as@ u32);
  putStr(noChild, "f");
  say(out, "child cut short \{read(sealed(noChild), 0).error}");

  // A length that is not a length, at the *mount name* — so the specific reason comes back from the
  // first failure rather than the second, which is a different line from the one above.
  Buf badName = Buf.create();
  badName.pushAll("wacimg\0".toBytes());
  badName.push(1);
  badName.pushU32(1 as@ u32);
  badName.pushU32(0x80000000 as@ u32);
  say(out, "mount name length \{read(sealed(badName), 0).error}");

  // An entry whose *name* runs out, as against one whose node does.
  Buf badEntryName = oneMount();
  putStr(badEntryName, "/home");
  node(badEntryName, 1);
  badEntryName.pushU32(1 as@ u32);
  badEntryName.pushU32(50 as@ u32);            // a name fifty bytes long, and nothing after it
  say(out, "entry name cut short \{read(sealed(badEntryName), 0).error}");

  Buf trailing = Buf.create();
  Fs fs = Fs.inMemory(1754500000000);
  await fs.writeFile("/f", "x".toBytes());
  u8[] good = write(fs).bytes;
  trailing.pushBytes(good, 0, good.len() - 4);
  trailing.push(0);                               // a byte nobody asked for, before the checksum
  say(out, "trailing \{read(sealed(trailing), 0).error}");
  return string.fromBytes(out.take());
}

/** The header of an image claiming one mount, with nothing after it yet. */
Buf oneMount() {
  Buf b = Buf.create();
  b.pushAll("wacimg\0".toBytes());
  b.push(1);
  b.pushU32(1 as@ u32);
  return b;
}

/** A node header: kind, mode, owner, mtime — everything before the kind-specific part. */
void node(Buf b, i32 kind) {
  b.push(kind as@ u8);
  b.pushU32(420 as@ u32);
  putStr(b, "root");
  for (i32 i = 0; i < 8; i++) { b.push(0); }
}

void putStr(Buf b, string s) {
  u8[] bytes = s.toBytes();
  b.pushU32(bytes.len() as@ u32);
  b.pushAll(bytes);
}

/** Append the checksum this body deserves, so the reader gets past its first gate. */
u8[] sealed(Buf body) {
  u8[] bytes = body.bytes();
  body.pushU32(crc32(bytes));
  return body.take();
}

/** The rename matrix: every pair of kinds, onto something that is already there. */
export async string renameOps() {
  Buf out = Buf.create();
  Fs fs = system();
  await fs.writeFile("/f1", "a".toBytes());
  await fs.writeFile("/f2", "b".toBytes());
  await fs.mkdir("/de", false);
  await fs.mkdir("/df", false);
  await fs.writeFile("/df/x", "c".toBytes());
  await fs.mkdir("/d1", false);

  say(out, "file onto file " + faultOf((await fs.rename("/f1", "/f2"))));
  say(out, "file onto empty dir " + faultOf((await fs.rename("/f2", "/de"))));
  say(out, "file onto full dir " + faultOf((await fs.rename("/f2", "/df"))));
  say(out, "dir onto file " + faultOf((await fs.rename("/d1", "/f2"))));
  say(out, "dir onto full dir " + faultOf((await fs.rename("/d1", "/df"))));
  say(out, "dir onto empty dir " + faultOf((await fs.rename("/d1", "/de"))));
  say(out, "onto itself " + faultOf((await fs.rename("/de", "/de"))));
  say(out, "under a file " + faultOf((await fs.rename("/f2", "/f2/deeper"))));
  say(out, "root as a target " + faultOf((await fs.rename("/f2", "/"))));
  return string.fromBytes(out.take());
}

/**
 * A filesystem with **no mount at the root** — an image of `/home` on its own.
 *
 * Nothing else can produce one, and every operation has a guard for it that had never run: `mountOf`
 * answers -1 and each caller has to turn that into "no such file or directory" rather than reaching into
 * whichever mount happens to be first.
 */
export async string rootlessOps() {
  Buf out = Buf.create();
  Fs fs = Fs.inMemory(1754500000000);
  fs.mountMemory("/home");
  await fs.writeFile("/home/f", "x".toBytes());
  // Drop the root mount, which is what loading an image of `/home` alone gives.
  Vec<Mount> only = Vec.create();
  only.push(fs.mounts.get(1));
  fs.mounts = only;

  say(out, "read " + (await fs.readFile("/elsewhere")).error);
  say(out, "readSome " + (await fs.readSome("/elsewhere", 4)).error);
  say(out, "stat " + ((await fs.stat("/elsewhere")).exists ? "there" : "absent"));
  say(out, "readDir " + ((await fs.readDir("/elsewhere")) is null ? "null" : "listed"));
  say(out, "write " + faultOf((await fs.writeFile("/elsewhere", "x".toBytes()))));
  say(out, "mkdir " + faultOf((await fs.mkdir("/elsewhere", false))));
  say(out, "rm " + faultOf((await fs.remove("/elsewhere", false))));
  say(out, "chmod " + faultOf((await fs.chmod("/elsewhere", 384))));
  say(out, "chown " + faultOf((await fs.chown("/elsewhere", "x"))));
  say(out, "rename from " + faultOf((await fs.rename("/elsewhere", "/home/g"))));
  say(out, "rename to " + faultOf((await fs.rename("/home/f", "/elsewhere"))));
  say(out, "linkStat " + ((await fs.linkStat("/elsewhere")).exists ? "there" : "absent"));
  say(out, "openOut " + faultOf((await fs.openOut("/elsewhere"))));
  say(out, "setExecutable " + faultOf((await fs.setExecutable("/elsewhere", true))));
  // Not on the machine, because it is not anywhere: the question a shell asks before deciding
  // whether a path is the host's is answered by the mount table, and there is no mount over it.
  say(out, "isHostPath " + (await fs.isHostPath("/elsewhere") ? "host" : "ours"));
  // **One mount, and not at the root**, which is the other half of `isPlainHost`: a filesystem can
  // have a single mount and still not be a view of the machine, because the mount is `/home`.
  say(out, "isPlainHost " + (fs.isPlainHost() ? "plain" : "not plain"));
  // The one that is there still works, so this is a filesystem and not a broken one.
  say(out, "the mount itself " + string.fromBytes((await fs.readFile("/home/f")).bytes));
  return string.fromBytes(out.take());
}

/** Mount points nested, and one whose name a real directory already has. */
export async string mountOps() {
  Buf out = Buf.create();
  Fs fs = Fs.inMemory(1754500000000);
  await fs.mkdir("/dev", false);              // a real directory where a mount will go
  fs.mountMemory("/dev");               // …so the listing must not show it twice
  fs.mountMemory("/a");
  fs.mountMemory("/a/b");               // nested: shows under /a, not under /
  say(out, "root " + joined((await fs.readDir("/"))));
  say(out, "a " + joined((await fs.readDir("/a"))));

  // **The longer mount registered first.** `mountOf` keeps the longest `at` that matches, and the
  // mounts above are in increasing length, so the comparison has only ever been true. Here `/p/q`
  // is seen before `/p` and a path under both must still land in `/p/q` — the case where a mount
  // matches and loses, which is the only one that distinguishes longest-match from last-match.
  fs.mountMemory("/p/q");
  fs.mountMemory("/p");
  await fs.writeFile("/p/q/deep", "in the longer mount".toBytes());
  say(out, "longest wins \{(await fs.readFile("/p/q/deep")).bytes.len()}");
  say(out, "p " + joined((await fs.readDir("/p"))));
  return string.fromBytes(out.take());
}

/** Paths that name nothing because the name is empty, and the one-byte singular in `dump`. */
export async string edgeOps() {
  Buf out = Buf.create();
  Fs fs = system();
  say(out, "write to root " + faultOf((await fs.writeFile("/", "x".toBytes()))));
  say(out, "mkdir root " + faultOf((await fs.mkdir("/", false))));
  say(out, "write to mount point " + faultOf((await fs.writeFile("/mnt", "x".toBytes()))));
  say(out, "mkdir over a mount " + faultOf((await fs.mkdir("/mnt", false))));
  await fs.writeFile("/one", "1".toBytes());
  Written w = write(fs);
  say(out, "dump singular " + (contains(dump(w.bytes), "1 byte)") ? "yes" : "no"));

  // A directory under a *file*, without `-p`: the parent is found and is not a directory.
  await fs.writeFile("/plain", "x".toBytes());
  say(out, "mkdir under a file " + faultOf((await fs.mkdir("/plain/x", false))));
  // A rename whose source parent does not exist at all, which is a different miss from a missing source.
  say(out, "rename from nowhere " + faultOf((await fs.rename("/nope/x", "/y"))));

  // A mount point written with a trailing slash is the same mount point.
  Fs slashed = Fs.inMemory(1754500000000);
  slashed.mountMemory("/x/");
  say(out, "trailing slash mount " + joined((await slashed.readDir("/"))));
  // The same path mounted twice: the listing must still name it once.
  slashed.mountMemory("/x");
  say(out, "mounted twice " + joined((await slashed.readDir("/"))));
  return string.fromBytes(out.take());
}

bool contains(string haystack, string needle) {
  i32 n = needle.len();
  for (i32 i = 0; i + n <= haystack.len(); i++) {
    if (haystack.slice(i, i + n) == needle) { return true; }
  }
  return false;
}

/** Paths that are the same place written differently, and paths outside every mount. */
export async string pathOps() {
  Buf out = Buf.create();
  Fs fs = system();
  await fs.mkdir("/d", false);
  await fs.writeFile("/d/f", "x".toBytes());

  say(out, "trailing slash " + ((await fs.stat("/d/")).isDir ? "dir" : "not"));
  say(out, "root " + ((await fs.stat("/")).isDir ? "dir" : "not"));
  say(out, "empty " + ((await fs.stat("")).exists ? "there" : "absent"));
  say(out, "mnt " + ((await fs.stat("/mnt")).isDir ? "dir" : "not"));
  say(out, "mnt trailing " + ((await fs.stat("/mnt/")).isDir ? "dir" : "not"));
  // `/mn` is not under `/mnt`, which is the whole-component rule `underMount` exists for.
  say(out, "prefix not component " + ((await fs.stat("/mn")).exists ? "there" : "absent"));
  say(out, "deep missing " + ((await fs.stat("/d/f/g")).exists ? "there" : "absent"));

  // The two components `normalise` drops rather than keeps: `.`, which names the directory it is
  // already in, and everything past the sixty-fourth, which is where the fixed-size parts array
  // stops. Both are the *other* arm of one condition, so a path that has neither never measures it.
  say(out, "dot component " + ((await fs.stat("/d/./f")).isFile ? "file" : "not"));
  say(out, "dot only " + ((await fs.stat("/./d")).isDir ? "dir" : "not"));
  string deep = "";
  for (i32 i = 0; i < 70; i++) { deep = deep + "/x"; }
  say(out, "seventy deep " + ((await fs.stat(deep)).exists ? "there" : "absent"));
  return string.fromBytes(out.take());
}

// ── Small things ──────────────────────────────────────────────────────────────

u8[] copyOf(u8[] src) {
  u8[] out = u8[].filled(src.len(), 0);
  out.copyFrom(src, 0, 0, src.len());
  return out;
}

string joined(string[]? names) {
  if (names is null) { return "null"; }
  string out = "";
  string[] got = names!;
  for (i32 i = 0; i < got.len(); i++) { out = out + (i == 0 ? "" : ",") + got[i]; }
  return out;
}

// ── The process table ───────────────────────────────────────────────────────
//
// `proc.wac` read 24.5% and it is the easiest quarter in this package to reach: signals are a name
// table and a number table, and `Procs` is a `Vec` with a lookup. None of it needs a capability, a
// mount or a host — it was uncovered because nothing had asked, which is what wac-mono 0134 is about.
//
// Driven the way `ps`, `kill` and the shell drive it: start a couple of processes, look them up, send
// a signal, collect it, exit, reap, and ask about the names on the way past.
export string procOps() {
  Buf out = Buf.create();
  Procs t = Procs.create();

  Vec<string> shArgv = Vec.create();
  shArgv.push("sh");
  shArgv.push("-c");
  shArgv.push("seq 1 3");
  i32 shell = t.start(0, shArgv, 1786096061);
  Vec<string> catArgv = Vec.create();
  catArgv.push("cat");
  i32 kid = t.start(shell, catArgv, 1786096062);
  say(out, "pids \{t.pids().len()}");
  say(out, "has " + (t.has(shell) ? "y" : "n") + (t.has(999) ? "y" : "n"));

  // `comm` is the program and `cmdline` is the whole line, which is what `/proc/<pid>/cmdline` serves.
  Proc? mine = t.find(shell);
  if (mine is null) {
    say(out, "the shell is not in the table");
  } else {
    say(out, "comm \{mine!.comm()}");
    say(out, "cmdline \{mine!.cmdline()}");
    say(out, "running " + (mine!.isRunning() ? "y" : "n"));
  }
  say(out, "absent " + (t.find(404) is null ? "y" : "n"));

  // Signals: the name/number tables both ways, the two that are answered specially, and delivery.
  say(out, "SIGINT \{signalNumber("INT")} \{signalName(SIGINT())}");
  say(out, "SIGTERM \{signalNumber("TERM")} \{signalName(SIGTERM())}");
  say(out, "unknown \{signalNumber("NOSUCH")} [\{signalName(99)}]");
  // Both tables, every arm: `signalIgnored` and `signalStops` are `||` chains, and an `||` chain is
  // only measured by the value that reaches its last term. A shell asks these about every signal it
  // is handed, so "which ones stop a job" is a real question with four right answers.
  say(out, "ignored " + (signalIgnored(17) ? "y" : "n") + (signalIgnored(18) ? "y" : "n") +
           (signalIgnored(23) ? "y" : "n") + (signalIgnored(28) ? "y" : "n") +
           (signalIgnored(SIGINT()) ? "y" : "n"));
  say(out, "stops " + (signalStops(19) ? "y" : "n") + (signalStops(20) ? "y" : "n") +
           (signalStops(21) ? "y" : "n") + (signalStops(22) ? "y" : "n") +
           (signalStops(SIGTERM()) ? "y" : "n"));
  // A name with and without the `SIG` prefix, which is the branch `kill -INT` and `kill -SIGINT` take.
  say(out, "prefixed \{signalNumber("SIGINT")} bare \{signalNumber("INT")}" +
           " short \{signalNumber("HU")}");
  say(out, "names \{SIGNALS().len()}");

  say(out, "signal " + (t.signal(kid, SIGINT()) ? "y" : "n") + (t.signal(999, SIGINT()) ? "y" : "n"));
  say(out, "taken \{t.takeSignal(kid)} then \{t.takeSignal(kid)}");

  // Ending: a status recorded, a reap that answers it, and a reap of something already reaped.
  // The third answer `exited` can give: a pid that is here and has **already finished**. A shell
  // that reaps a stage twice — a `wait` and then the loop that tidies up — must not overwrite the
  // status the first one recorded, so the second call keeps 3 rather than replacing it with 0.
  say(out, "exited " + (t.exited(kid, 3) ? "y" : "n") + (t.exited(999, 0) ? "y" : "n") +
           (t.exited(kid, 0) ? "y" : "n"));
  Proc? ended = t.find(kid);
  if (ended is null) {
    say(out, "the child vanished before it was reaped");
  } else {
    say(out, "state \{ended!.state} code \{ended!.exitCode}");
  }
  say(out, "reap \{t.reap(kid)} again \{t.reap(kid)}");
  say(out, "left \{t.pids().len()}");
  return out.toStr();
}

// ── The streaming write, a user, and a working directory ────────────────────
//
// Three surfaces the probe never touched, all of them ordinary calls on a memory mount: `openOut` /
// `writeOut` / `closeOut` — which exist because `writeFile` needs every byte at once and a
// redirection must not (`seq 1 2000000000 > out` is twenty gigabytes) — and the two pieces of session
// state, `setUser` and `setCwd`, that every permission check and relative path is answered against.
export async string streamOps() {
  Buf out = Buf.create();
  Fs fs = Fs.inMemory(1786096061);

  // A second open while one is in flight closes the first, which is the rule a redirection needs.
  say(out, "open " + faultOf((await fs.openOut("/log"))));
  say(out, "wrote " + (await fs.writeOut("one\n".toBytes()) ? "y" : "n"));
  say(out, "wrote " + (await fs.writeOut("two\n".toBytes()) ? "y" : "n"));
  say(out, "reopen " + faultOf((await fs.openOut("/other"))));
  say(out, "close \{faultOf((await fs.closeOut()))}");
  // …and closing when nothing is open is not a failure: every path that tidies up would otherwise
  // have to remember whether it had opened anything.
  say(out, "close again \{faultOf((await fs.closeOut()))}");
  say(out, "write with nothing open " + (await fs.writeOut("x".toBytes()) ? "y" : "n"));
  say(out, "log \{(await fs.readFile("/log")).bytes.len()}");
  say(out, "other \{(await fs.readFile("/other")).bytes.len()}");

  // A directory that is not there, and one that is: `openOut` answers a fault rather than trapping.
  say(out, "no dir " + faultOf((await fs.openOut("/nope/deep"))));

  // **The file the stream is open on, removed underneath it.** A redirection holds a mount and a
  // path rather than a node, so the node it writes to is looked up per write and can be gone by
  // then — `rm` on another line of the same script is all it takes. The write says no; nothing
  // traps, and nothing silently recreates the file, because a stream that resurrects what a
  // program just deleted is worse than one that fails.
  say(out, "open again " + faultOf((await fs.openOut("/vanishes"))));
  say(out, "removed " + faultOf((await fs.remove("/vanishes", false))));
  say(out, "write to a removed file " + (await fs.writeOut("gone\n".toBytes()) ? "y" : "n"));
  say(out, "close after \{faultOf((await fs.closeOut()))}");

  // The session's own state. `cwd` resolves a relative path at every entry point, and `user` is what
  // `may` compares against — a file written as root and read as somebody else is the whole of it.
  fs.setCwd("/sub");
  say(out, "cwd \{fs.cwd}");
  say(out, "mkdir " + faultOf((await fs.mkdir("/sub", false))));
  say(out, "relative write " + faultOf((await fs.writeFile("note", "hello\n".toBytes()))));
  say(out, "relative read \{(await fs.readFile("note")).bytes.len()}");
  say(out, "absolute read \{(await fs.readFile("/sub/note")).bytes.len()}");
  fs.setCwd("/");

  // **What kind of filesystem is this?** Three predicates every caller of `spawn` asks: `init` uses
  // `isPlainHost` to decide whether a service needs a channel at all, and `box` uses `isHostPath` to
  // decide whether a path is the machine's or the image's. Answered here for a memory filesystem and
  // for one with a mount over it, which are the two shapes that exist without a `Cli`.
  say(out, "plain host " + (fs.isPlainHost() ? "y" : "n"));
  say(out, "has host mount " + (fs.hasHostMount() ? "y" : "n"));
  say(out, "host path " + (await fs.isHostPath("/sub/note") ? "y" : "n"));
  Fs two = Fs.inMemory(1786096061);
  two.mountMemory("/mnt");
  say(out, "two mounts, plain host " + (two.isPlainHost() ? "y" : "n"));

  say(out, "chmod " + faultOf((await fs.chmod("/sub/note", 384))));
  fs.setUser("ada");
  say(out, "as ada " + ((await fs.readFile("/sub/note")).ok ? "read" : "refused"));
  fs.setUser("root");
  say(out, "as root " + ((await fs.readFile("/sub/note")).ok ? "read" : "refused"));
  return out.toStr();
}

// ── The wire between a child and its parent ─────────────────────────────────
//
// `remote.wac` read **0%** — every entry point takes a `Chan`, and a `Chan` needs a peer that
// answers. A wac fake cannot be that peer: a fake has no state to answer *from*, which is the same
// wall `packages/sh`'s probe records ("`fakeRecv` is stateless, so it can only answer
// end-of-input"). That is wac-mono 0134's third item, and the recommendation filed with the issue —
// let the probe be one end of the channel — does not work for that reason.
//
// What needs no peer is the **wire**: the four `encode*` are the parent's replies and the four
// `decode*` are the child's reading of them, all pure over bytes. A round trip through both is the
// agreement the two ends depend on, and it is where a silent bug would live — a `Stat` whose mode
// crossed but whose fault did not is a permission answered wrongly in a program that never sees the
// channel. The `Chan` half stays unmeasured here and is driven by `packages/box/test/sealing.test.ts`
// against real spawned children.
export string wireOps() {
  Buf out = Buf.create();

  // A file that was read, and one that was not.
  Buf a = Buf.create();
  encodeFileResult(a, FileResult.of(true, "hello\n".toBytes(), "", FAULT_NONE()));
  FileResult back = decodeFileResult(readerOver(a.take()));
  say(out, "file ok " + (back.ok ? "y" : "n") + " \{back.bytes.len()}");
  Buf b = Buf.create();
  encodeFileResult(b, FileResult.of(false, u8[](), "no such file or directory", FAULT_NOT_FOUND()));
  FileResult bad = decodeFileResult(readerOver(b.take()));
  say(out, "file bad " + (bad.ok ? "y" : "n") + " \{bad.fault} " + bad.error);

  // A `Stat` carries seven fields and a fault, and every one of them is a permission or a listing
  // somewhere: a mode that crossed and a fault that did not is a wrong answer with no error.
  Buf c = Buf.create();
  Stat s = Stat.of(true, true, false, 4096 as i64, 1786096061 as i64, false, true, FAULT_NONE(), 0);
  encodeStat(c, s);
  Stat st = decodeStat(readerOver(c.take()));
  say(out, "stat " + (st.exists ? "e" : "-") + (st.isFile ? "f" : "-") + (st.isDir ? "d" : "-") +
           (st.isExecutable ? "x" : "-") + " \{st.size as~ i32} \{st.fault}");

  // A change: the three shapes a caller branches on.
  Buf d = Buf.create();
  encodeChange(d, Change.of(FAULT_NONE(), ""));
  say(out, "change ok \{decodeChange(readerOver(d.take())).fault}");
  Buf e = Buf.create();
  encodeChange(e, Change.of(FAULT_EXISTS(), "File exists"));
  Change ch = decodeChange(readerOver(e.take()));
  say(out, "change fault \{ch.fault} \{ch.message}");

  // A listing, and the null that says "not a directory" rather than "an empty one" — the distinction
  // `readDir` answers with and the one a naive encoding loses.
  Buf f = Buf.create();
  string[] names = string[].filled(3, "");
  names[0] = "bin"; names[1] = "dev"; names[2] = "etc";
  encodeNames(f, names);
  string[]? got = decodeNames(readerOver(f.take()));
  say(out, "names " + (got is null ? "null" : "\{got!.len()} \{got![1]}"));
  Buf g = Buf.create();
  encodeNames(g, null);
  say(out, "no dir " + (decodeNames(readerOver(g.take())) is null ? "null" : "a list"));

  // **A length that is refused, and what a reader already carrying a fault does with one.** The
  // readers below are broken *and* empty, so they stop at the bounds check and never reach a field's
  // own refusal; these two have four readable bytes making a negative length. The first records the
  // refusal. The second shows why the guard that records it cannot be reached twice: a reader with a
  // reason is a reader with `bad` set, `byte()` answers zero for one of those, and zero is not
  // negative — so it never arrives at the refusal at all. `issues/lang/0112`.
  u8[] huge = u8[].filled(4, 0);
  huge[3] = 128;
  Reader first = Reader(huge, huge.len(), 0, false, "");
  say(out, "first fault \{first.u32()} \{first.why}");
  Reader carried = Reader(huge, huge.len(), 0, true, "the message ended early");
  say(out, "second fault \{carried.u32()} \{carried.why}");

  // A reader that is already broken answers a fault rather than reading past the end — all four ways,
  // since each says nothing differently.
  Reader dead = Reader(u8[](), 0, 0, true, "the parent went away");
  say(out, "broken change \{decodeChange(dead).fault}");
  say(out, "broken stat \{decodeStat(dead).fault}");
  say(out, "broken read " + (decodeFileResult(dead).ok ? "ok" : "not ok"));
  say(out, "broken names " + (decodeNames(dead) is null ? "null" : "a list"));

  // A `Stat` with every flag *false*, because `s.exists ? 1 : 0` has two sides and a probe that only
  // ever encodes a file that exists measures one of them.
  Buf h = Buf.create();
  encodeStat(h, Stat.of(false, false, false, 0 as i64, 0 as i64, false, false, FAULT_NOT_FOUND(), 0));
  Stat none = decodeStat(readerOver(h.take()));
  say(out, "absent stat " + (none.exists ? "e" : "-") + (none.isDir ? "d" : "-") + " \{none.fault}");

  Buf i = Buf.create();
  encodeStat(i, Stat.of(true, false, true, 4096 as i64, 1 as i64, true, false, FAULT_NONE(), 0));
  Stat dir = decodeStat(readerOver(i.take()));
  say(out, "dir stat " + (dir.isDir ? "d" : "-") + (dir.isSymlink ? "l" : "-"));

  // A short answer: the frame says more than it carries, which is what a peer that died mid-write
  // leaves behind. `decodeNames` answers null and the reason names the channel rather than the file.
  u8[] truncated = u8[].filled(3, 0);
  say(out, "short names " + (decodeNames(readerOver(truncated)) is null ? "null" : "a list"));
  say(out, "short change \{decodeChange(readerOver(truncated)).fault}");

  // The same answer cut at each of the three places a listing can stop, because "there is a
  // listing" and "there is no listing" are the two answers `readDir` is allowed to give and a
  // half-arrived one must become the second rather than a list of empty names. Above: the first
  // byte never arrived. Here: it said *yes* and the count did not follow, and then the count said
  // three and the names did not.
  u8[] noCount = u8[].filled(1, 1);
  say(out, "yes without a count " + (decodeNames(readerOver(noCount)) is null ? "null" : "a list"));
  Buf countOnly = Buf.create();
  countOnly.push(1);
  countOnly.pushU32(3 as@ u32);
  say(out, "a count without names " +
           (decodeNames(readerOver(countOnly.take())) is null ? "null" : "a list"));

  // **A reader told it is wrong twice.** The first reason is the one that names what actually went
  // wrong; every reason after it describes the wreckage of the first. `wrong` keeps the first and
  // drops the rest, and a decoder that fails on two fields in a row is how that arises — so this
  // drives it directly, since nothing round-tripped above fails twice.
  Reader twice = readerOver(u8[]());
  twice.wrong("the first thing that was wrong");
  twice.wrong("the second, which describes the first one's aftermath");
  say(out, "first reason kept \{twice.why}");

  // A request is its opcode and nothing else until an argument is pushed onto it — the one line
  // that decides a frame's first byte, which every `ASK_*` above depends on.
  say(out, "request \{request(ASK_STAT()).take().len()}" +
           " \{request(ASK_STAT()).take()[0] as i32}");

  // The opcodes, which are a contract between two processes: a child sends a number and its parent
  // switches on it. `fs_test.wac` pins the values; touching them here is what measures them.
  i32 opcodes = ASK_READ_FILE() + ASK_READ_SOME() + ASK_STAT() + ASK_READ_DIR() +
      ASK_WRITE_FILE() + ASK_MKDIR() + ASK_REMOVE() + ASK_CHMOD() + ASK_CHOWN() + ASK_RENAME() +
      ASK_OPEN_OUT() + ASK_WRITE_OUT() + ASK_CLOSE_OUT() + ASK_IS_HOST_PATH() + ASK_LINK_STAT() +
      ASK_USER() + ASK_SET_EXECUTABLE();
  say(out, "opcodes \{opcodes}");
  return out.toStr();
}

// ── Being refused ───────────────────────────────────────────────────────────
//
// The branches that *enforce* design/0001 step 4: `may(node, 2)` answering no, on every operation
// that changes what a directory holds. They were the largest unaccounted group in the ratchet, and
// they are the ones a wrong answer would matter most in — a write that should have been refused is
// not a missing feature, it is somebody else's file.
//
// One filesystem, two users, and every way in: write, mkdir, remove, rename, chmod, chown, the
// executable bit, and reading a directory whose contents are not yours to list.
export async string permissionOps() {
  Buf out = Buf.create();
  Fs fs = Fs.inMemory(1786096061);

  // Root builds a home nobody else may touch, and a file inside it.
  say(out, "mkdir " + faultOf((await fs.mkdir("/home", true))));
  say(out, "mkdir ada " + faultOf((await fs.mkdir("/home/ada", false))));
  say(out, "write " + faultOf((await fs.writeFile("/home/ada/secret", "the difference engine\n".toBytes()))));
  say(out, "chown " + faultOf((await fs.chown("/home/ada", "ada"))));
  say(out, "chown file " + faultOf((await fs.chown("/home/ada/secret", "ada"))));
  say(out, "chmod dir " + faultOf((await fs.chmod("/home/ada", 448))));       // 0700
  say(out, "chmod file " + faultOf((await fs.chmod("/home/ada/secret", 384)))); // 0600

  // …and grace, who is not ada, is refused everything about it.
  fs.setUser("grace");
  say(out, "read " + ((await fs.readFile("/home/ada/secret")).ok ? "y" : "n"));
  say(out, "list " + ((await fs.readDir("/home/ada")) is null ? "refused" : "listed"));
  say(out, "write " + faultOf((await fs.writeFile("/home/ada/secret", "overwritten\n".toBytes()))));
  say(out, "new file " + faultOf((await fs.writeFile("/home/ada/mine", "x".toBytes()))));
  say(out, "mkdir " + faultOf((await fs.mkdir("/home/ada/sub", false))));
  say(out, "remove " + faultOf((await fs.remove("/home/ada/secret", false))));
  say(out, "rename out " + faultOf((await fs.rename("/home/ada/secret", "/home/grace-took-it"))));
  say(out, "chmod " + faultOf((await fs.chmod("/home/ada/secret", 438))));
  say(out, "chown " + faultOf((await fs.chown("/home/ada/secret", "grace"))));
  say(out, "executable " + faultOf((await fs.setExecutable("/home/ada/secret", true))));
  say(out, "stat " + ((await fs.stat("/home/ada/secret")).exists ? "y" : "n"));

  // A rename *into* a directory that is not hers, **from one that is** — which needs her to have one.
  // The first version of this had grace make her own home under a root-owned `/home` and be refused,
  // so both lines below were testing the same denial as the ones above rather than the crossing. Found
  // by reading the transcript the probe returns, which is what it is for.
  fs.setUser("root");
  say(out, "her home " + faultOf((await fs.mkdir("/home/grace", false))));
  say(out, "hers " + faultOf((await fs.chown("/home/grace", "grace"))));
  fs.setUser("grace");
  say(out, "her file " + faultOf((await fs.writeFile("/home/grace/note", "hers\n".toBytes()))));
  say(out, "rename in " + faultOf((await fs.rename("/home/grace/note", "/home/ada/note"))));
  say(out, "rename within " + faultOf((await fs.rename("/home/grace/note", "/home/grace/renamed"))));

  // Root is exempt, which is the other half of the rule and the reason `ROOT()` is one constant.
  fs.setUser("root");
  say(out, "root reads " + ((await fs.readFile("/home/ada/secret")).ok ? "y" : "n"));
  say(out, "root writes " + faultOf((await fs.writeFile("/home/ada/secret", "root was here\n".toBytes()))));
  say(out, "root chowns " + faultOf((await fs.chown("/home/ada/secret", "grace"))));

  // A synthesised mount refuses what it cannot do, and says so rather than trapping: `/dev` has no
  // modes to change and no owner to become. `/proc` comes with it, because the process table is what
  // `/proc/<pid>` reads.
  fs.mountSynth("/dev", pendingRandom);
  fs.mountSynth("/proc", pendingRandom);
  Vec<string> shArgv2 = Vec.create();
  shArgv2.push("sh");
  shArgv2.push("-c");
  shArgv2.push("seq 1 3");
  fs.procs.current = fs.procs.start(0, shArgv2, 1786096061);
  say(out, "synth chmod " + faultOf((await fs.chmod("/dev/null", 384))));
  say(out, "synth chown " + faultOf((await fs.chown("/dev/null", "ada"))));
  say(out, "synth exec " + faultOf((await fs.setExecutable("/dev/null", true))));

  // **`> /dev/null` is a real destination**, and the only synthesised file a stream can be opened on:
  // everything else under `/dev` is read-only and says so, so `openOut`/`writeOut`/`closeOut` each
  // have one arm that exists for this file alone.
  say(out, "null open " + faultOf((await fs.openOut("/dev/null"))));
  say(out, "null write " + (await fs.writeOut("thrown away\n".toBytes()) ? "y" : "n"));
  say(out, "null close \{faultOf((await fs.closeOut()))}");
  say(out, "zero open " + faultOf((await fs.openOut("/dev/zero"))));

  // `/proc/<pid>` is a *name* that has to be read as a number, and three of its four answers are
  // refusals: `self` when there is a current process, a name that is not digits, and a pid nobody
  // has. `ps` walks this and a shell reads `/proc/self/cmdline`.
  say(out, "proc self \{(await fs.readFile("/proc/self/cmdline")).bytes.len()}");
  say(out, "proc absent " + ((await fs.readFile("/proc/9999/cmdline")).ok ? "y" : "n"));
  say(out, "proc name " + ((await fs.readFile("/proc/notanumber/cmdline")).ok ? "y" : "n"));
  say(out, "proc empty " + ((await fs.readFile("/proc//cmdline")).ok ? "y" : "n"));

  // `/bin` is synthesised from the program list, so a name in it is a program and a name not in it is
  // nothing — the two answers `$PATH` lookup and `ls /bin` are built on.
  Vec<string> programs = Vec.create();
  programs.push("wc");
  programs.push("grep");
  fs.mountBin(programs, pendingRandom);
  say(out, "bin wc \{(await fs.readFile("/bin/wc")).bytes.len()}");
  say(out, "bin nope " + ((await fs.readFile("/bin/nope")).ok ? "y" : "n"));
  say(out, "bin list \{(await fs.readDir("/bin")) is null ? -1 : (await fs.readDir("/bin"))!.len()}");

  // The three files a process has under `/proc/<pid>`, which `ps` reads one of and a shell the other.
  say(out, "comm \{(await fs.readFile("/proc/self/comm")).bytes.len()}");
  say(out, "status \{(await fs.readFile("/proc/self/status")).bytes.len()}");

  // A path *through* a file: `f/g` where `f` is a file is "Not a directory", which is a different
  // answer from "no such file" and the one GNU gives — every applet that reports an absence depends
  // on the distinction.
  say(out, "under a file " + faultOf((await fs.mkdir("/home/ada/secret/sub", false))));
  say(out, "read under \{(await fs.readFile("/home/ada/secret/sub")).fault}");
  say(out, "list under " + ((await fs.readDir("/home/ada/secret/sub")) is null ? "null" : "listed"));
  say(out, "rename under " + faultOf((await fs.rename("/home/ada/secret/sub", "/x"))));

  // The executable bit, both ways, which is the one mode change with arithmetic in it: it follows the
  // read bits rather than setting a fixed 0755.
  say(out, "exec on " + faultOf((await fs.setExecutable("/home/ada/secret", true))));
  say(out, "exec off " + faultOf((await fs.setExecutable("/home/ada/secret", false))));

  // A zombie: signalled, reaped, and asked about. `ps` shows the state and a shell waits on it, and
  // every one of these is a "no" branch — a process that is not running takes no signal, and a
  // process nobody started is not reaped twice.
  fs.setUser("root");
  Vec<string> zargv = Vec.create();
  zargv.push("false");
  i32 zombie = fs.procs.start(0, zargv, 1786096061);
  say(out, "ended " + (fs.procs.exited(zombie, 1) ? "y" : "n"));
  say(out, "signal a zombie " + (fs.procs.signal(zombie, SIGINT()) ? "y" : "n"));
  say(out, "take from a zombie \{fs.procs.takeSignal(zombie)}");
  say(out, "take from nobody \{fs.procs.takeSignal(4040)}");
  say(out, "status \{(await fs.readFile("/proc/\{zombie}/status")).bytes.len()}");
  say(out, "rows \{fs.procs.len()}");
  Vec<string> empty = Vec.create();
  i32 nameless = fs.procs.start(0, empty, 1786096061);
  say(out, "no argv " + ((await fs.readFile("/proc/\{nameless}/comm")).bytes.len() == 0 ? "empty" : "named"));

  // `..` above the root stays at the root, and a relative path is resolved against the cwd — the two
  // rules every path in a session goes through.
  say(out, "up " + fs.at("../../.."));
  fs.setCwd("/home/ada");
  say(out, "relative " + fs.at("secret"));
  say(out, "dotdot " + fs.at("../grace"));
  fs.setCwd("/");

  // `readSome` on a synthesised file, both ways round: fewer bytes than there are, and more. `head -c`
  // goes through this and `/bin/wc`'s sentence is short, so "more than there is" is the ordinary case.
  say(out, "some 4 \{(await fs.readSome("/bin/wc", 4)).bytes.len()}");
  say(out, "some 4000 \{(await fs.readSome("/bin/wc", 4000)).bytes.len()}");
  say(out, "stat bin " + ((await fs.stat("/bin/wc")).exists ? "y" : "n"));

  // `/proc/<pid>` for a pid that is *gone*: the name parses, the process does not exist, and the
  // answer is empty rather than a trap — which is what `ps` sees when a row it read has been reaped.
  say(out, "reaped \{fs.procs.reap(zombie)}");
  say(out, "gone cmdline \{(await fs.readFile("/proc/\{zombie}/cmdline")).bytes.len()}");

  // …and `/proc/self` when nothing is current, which is every program that has not entered the table.
  Fs bare = Fs.inMemory(1786096061);
  bare.mountSynth("/proc", pendingRandom);
  say(out, "no self " + ((await bare.readFile("/proc/self/cmdline")).ok ? "y" : "n"));
  say(out, "empty name " + ((await bare.readFile("/proc//cmdline")).ok ? "y" : "n"));
  // `/proc/` with nothing after it: the pid is the empty string, which is not "self" and not a
  // number. A path with a trailing slash arrives here as the mount itself, so this is a listing
  // rather than a read, and either way there is no process it could name.
  say(out, "trailing slash " + ((await bare.readFile("/proc/")).ok ? "y" : "n"));
  say(out, "trailing slash listing " + (bare.readDir("/proc/") is null ? "null" : "listed"));

  // **`mkdir -p` checks each component as it makes it**, not once at the top: the first few may exist
  // and be somebody else's, which is this branch and is why the check is inside the loop.
  fs.setUser("grace");
  say(out, "deep into ada's " + faultOf((await fs.mkdir("/home/ada/deep/deeper", true))));
  fs.setUser("root");

  // A path *through a file*, as root — so the answer is "Not a directory" rather than the permission
  // refusal grace met above. `absentChange` is what turns the lookup's -2 into GNU's sentence.
  say(out, "root mkdir under a file " + faultOf((await fs.mkdir("/home/ada/secret/sub", false))));
  say(out, "root writes under a file " + faultOf((await fs.writeFile("/home/ada/secret/sub", "x".toBytes()))));
  say(out, "root removes under a file " + faultOf((await fs.remove("/home/ada/secret/sub", false))));

  // The same path handed to the calls that change a *node* rather than a directory entry. These
  // reach `absentChange` with the lookup's "not a directory" rather than its "not found", and
  // that difference is the whole point of the two-valued answer: `chmod /home/ada/secret/sub`
  // and `chmod /nope` are different mistakes and GNU's `chmod` says so.
  say(out, "chmod under a file " + faultOf((await fs.chmod("/home/ada/secret/sub", 384))));
  say(out, "chown under a file " + faultOf((await fs.chown("/home/ada/secret/sub", "ada"))));
  say(out, "exec under a file " + faultOf((await fs.setExecutable("/home/ada/secret/sub", true))));
  say(out, "rename from under a file " + faultOf((await fs.rename("/home/ada/secret/sub", "/moved"))));
  say(out, "rename to under a file " + faultOf((await fs.rename("/home/ada/secret", "/home/ada/secret/sub"))));

  // And the paths that are not there at all, which answer a fault rather than a refusal.
  say(out, "absent chmod " + faultOf((await fs.chmod("/nope", 384))));
  say(out, "absent exec " + faultOf((await fs.setExecutable("/nope", true))));
  say(out, "absent chown " + faultOf((await fs.chown("/nope", "ada"))));
  return out.toStr();
}
