// A filesystem that belongs to the system rather than to the host.
//
// [design/0001](../../../design/0001-a-self-contained-system.md) step 1, filed as wac-mono 0067. Every
// filesystem capability a program has today is the *host's*, so `packages/ssh`'s demo hands each session
// the real disk of whatever ran the daemon and the browser terminal hands it the tab's Origin Private
// File System. There is nothing that belongs to the system: nothing to seal a session inside, nothing to
// persist as an image, and nothing hermetic for a test to run against.
//
// ## Why one type with a mount table, rather than an interface
//
// The obvious design is an abstract filesystem with a memory implementation and a host implementation.
// wac will not do it: `override` is a source-level check and **dispatch is static** — a `Circle` in a
// `Shape` variable answers `Shape.name()` — so a base-typed `Fs` would always run the base's bodies.
// The language's own idiom for varying behaviour is a funcref plus explicit state (`Shell.external` is
// one), and a funcref cannot capture a filesystem because there are no closures.
//
// So: one concrete `Fs`, holding a mount table, and the branch is written by hand. That is what the tour
// says to do, and it turns out to be the shape the design wanted anyway — a host mount is how "translate
// to real operations on the host" survives as a deliberate feature rather than as the default.
//
// ## What a path is here
//
// Absolute, `/`-separated, with no `.` or `..` left in it: `packages/sh`'s `resolve` already normalises
// every path before it crosses a capability boundary, and this relies on that rather than repeating it.
// A name is bytes — anything but `/` and NUL — because that is what a name is on the systems being
// imitated. The one wrinkle is that names arrive here as wac strings, which are byte arrays, so nothing
// is lost on the way in; what a *host* does with them is
// [0065](../../../issues/open/0065-a-spawned-programs-arguments-are-not-byte-exact.md).

import { Map } from "../../std/src/map.wac";
import { Vec } from "../../std/src/vec.wac";
import { hashString, stringEq } from "../../std/src/hash.wac";
import { Buf } from "../../bytes/src/buf.wac";
import { Change, Cli, FAULT_DENIED, FAULT_EXISTS, FAULT_NONE, FAULT_NOT_EMPTY, FAULT_NOT_FOUND,
  FAULT_OTHER, FileResult, Pending, Stat } from "../../platform/src/platform.wac";

/** Where a mount's bytes actually live. */
export enum Backing {
  /** In this program's own memory: the default, and what a test wants. */
  Memory,
  /**
   * The host, through the capabilities of whoever built this filesystem.
   *
   * Present so that reaching the real disk is something a caller *asks* for. A shell built with one of
   * these at `/` behaves exactly as it did before this package existed, which is what makes the change
   * to `packages/sh` a change of shape rather than of behaviour.
   */
  Host(Cli cli),
  /**
   * Files that do not exist until they are read — `/dev` and `/proc`.
   *
   * Step 6 of design/0001. Nothing is stored: `readDir` lists a fixed set of names and a read runs a
   * generator, so `/dev/zero` costs what you ask of it rather than what it could give.
   *
   * It carries `randomBytes` and nothing else, because that is the only capability the set below needs
   * and a mount that asked for a whole `Cli` could reach the disk. `Core.randomBytes` is a host function
   * rather than a grant, so a session built with no filesystem permissions at all still has one — which
   * is what lets `sealed` mount `/dev` without stopping being sealed.
   */
  Synth(fn[Pending<u8[]>(i32)] randomBytes),
}

/** One mounted filesystem, at a path. */
export struct Mount {
  /** Absolute, without a trailing slash. `/` is the empty string, so every path is a suffix of it. */
  string at;
  Backing backing;
  /** Index into `Fs.nodes` of this mount's root. Meaningless for a host mount. */
  i32 root;
}

/**
 * A file or a directory.
 *
 * Metadata is stored beside the bytes because users are data in the image (design/0001 D5): a host's
 * idea of who owns a file cannot survive an image that is one blob owned by whoever ran the process.
 * `mode` and `owner` are recorded now and enforced later — step 4 is where a session gets a user.
 */
export struct Inode {
  bool isDir;
  /** Directory entries, name to node index. Empty for a file. */
  Map<string, i32> entries;
  /** File bytes. Empty for a directory. */
  Buf data;
  i32 mode;
  string owner;
  i64 mtime;

  /** A copy of the bytes: a reader must not be able to write the file by holding its array. */
  u8[] bytes(const this) { return this.data.bytes(); }

  /** Record a new mode. A method because an assignment target in wac is a name, not a call's result. */
  void setMode(this, i32 mode) { this.mode = mode; }

  /** The same for the owner. */
  void setOwner(this, string owner) { this.owner = owner; }

  /** Replace the contents, as a truncating write does. */
  void replace(this, u8[] data, i64 now) {
    this.data = Buf.create();
    this.data.pushAll(data);
    this.mtime = now;
  }
}

/**
 * A filesystem: some mounts, and the nodes of every memory mount in one pool.
 *
 * One pool rather than one per mount so that a node index means the same thing everywhere, which is what
 * an image format will want to write out and what a handle table will want to point at.
 */
export struct Fs {
  Vec<Mount> mounts;
  Vec<Inode> nodes;
  /** What a newly created file is owned by until there are users. */
  string owner;
  /** Milliseconds, from whoever built this: wac has no clock of its own. */
  i64 now;
  /**
   * What `/proc/self/cmdline` answers, NUL-separated as Linux's is.
   *
   * Empty until somebody sets it. A filesystem cannot know its own program's arguments — argv belongs to
   * whoever built it — so this is handed in rather than discovered, the same way `now` is.
   */
  string cmdline;

  /** An empty filesystem with one memory mount at the root. */
  Fs inMemory(i64 now) {
    Vec<Mount> mounts = Vec.create();
    Vec<Inode> nodes = Vec.create();
    nodes.push(dirNode("root", now));
    mounts.push(Mount("", Backing.Memory, 0));
    return Fs(mounts, nodes, "root", now, "");
  }

  /**
   * The host's filesystem, mounted at the root.
   *
   * What `packages/sh` gets when nobody has said otherwise, so that today's behaviour is one mount
   * rather than a special case: the shell asks its filesystem, and its filesystem asks the host.
   */
  Fs onHost(Cli cli, i64 now) {
    Vec<Mount> mounts = Vec.create();
    Vec<Inode> nodes = Vec.create();
    mounts.push(Mount("", Backing.Host(cli), -1));
    return Fs(mounts, nodes, "root", now, "");
  }

  /**
   * Mount the synthesised files at `at` — `/dev` or `/proc`.
   *
   * Two mounts rather than one because mounts are longest-prefix and the two trees are unrelated; what
   * each holds is decided by `synthNames` from the mount point.
   */
  void mountSynth(this, string at, fn[Pending<u8[]>(i32)] randomBytes) {
    this.mounts.push(Mount(trimSlash(at), Backing.Synth(randomBytes), -1));
  }

  /** What `/proc/self/cmdline` will answer. NUL-separated, as Linux's is. */
  void setCmdline(this, string cmdline) { this.cmdline = cmdline; }

  /** Mount a fresh empty memory filesystem at `at`, which must be an absolute normalised path. */
  void mountMemory(this, string at) {
    this.nodes.push(dirNode(this.owner, this.now));
    this.mounts.push(Mount(trimSlash(at), Backing.Memory, this.nodes.len() - 1));
  }

  /**
   * Which mount owns this path: the longest `at` that prefixes it.
   *
   * Longest-prefix rather than first-match so that mounting `/home` under a host `/` does what a person
   * expects, and so the order mounts were added in does not decide the answer.
   *
   * **-1 when no mount holds it**, which used to be impossible: `inMemory` and `onHost` both start with a
   * mount at the root, and every path is under the root. An image can be loaded into a filesystem that
   * has no root mount — `/home` saved on its own — and this returned mount 0 for `/elsewhere` in that
   * case, which happened to fail in `find` for the wrong reason. Every caller checks it now.
   */
  i32 mountOf(const this, string path) {
    i32 best = -1;
    i32 bestLen = -1;
    for (i32 i = 0; i < this.mounts.len(); i++) {
      string at = this.mounts.get(i).at;
      if (!underMount(at, path)) { continue; }
      if (at.len() > bestLen) {
        best = i;
        bestLen = at.len();
      }
    }
    return best;
  }

  // ── Reading ─────────────────────────────────────────────────────────────────

  /** The whole file, or why not. */
  FileResult readFile(this, string path) {
    i32 mi = this.mountOf(path);
    if (mi < 0) { return FileResult.of(false, u8[0](), "no such file or directory", FAULT_NOT_FOUND()); }
    Mount m = this.mounts.get(mi);
    match (m.backing) {
      case Host(cli): { return cli.readFile(path).wait(); }
      // An endless device has no "whole" to read. GNU's `cat /dev/zero` runs until something stops it,
      // which a `readFile` returning one array cannot do — so it refuses and says which read to use
      // instead, rather than inventing a length or hanging.
      case Synth(rand): { return synthRead(this, m, path, rand, -1); }
      else: {}
    }
    i32 node = this.find(m, path);
    if (node < 0) { return FileResult.of(false, u8[0](), "no such file or directory", FAULT_NOT_FOUND()); }
    if (this.nodes.get(node).isDir) {
      // `FAULT_OTHER`, not `FAULT_DENIED`, because that is what the hosts answer: the category set has no
      // "is a directory", so `faults.ts` classifies Deno's `EISDIR` as other and the message carries it.
      // Chosen by comparing against a real filesystem — the first run of `test/host.test.ts` said 2 where
      // the host said 5, and the host is the oracle. Whether the taxonomy *should* grow a category is a
      // separate question, noted in 0067: a program does branch on it, since `cat` on a directory and
      // `cat` on a missing file are different mistakes.
      return FileResult.of(false, u8[0](), "is a directory", FAULT_OTHER());
    }
    return FileResult.of(true, this.nodes.get(node).bytes(), "", FAULT_NONE());
  }

  /**
   * At most `n` bytes from the start of a file.
   *
   * `head -c 16 /dev/urandom` is the reason: an endless device cannot answer `readFile`, and a `head`
   * that read the whole file and then took the front could not either. Every other backing answers it by
   * reading and truncating, which costs nothing extra for the sizes a `-c` is written with.
   */
  FileResult readSome(this, string path, i32 n) {
    if (n < 0) { return FileResult.of(false, u8[0](), "a negative length", FAULT_OTHER()); }
    i32 mi = this.mountOf(path);
    if (mi < 0) { return FileResult.of(false, u8[0](), "no such file or directory", FAULT_NOT_FOUND()); }
    Mount m = this.mounts.get(mi);
    match (m.backing) {
      case Synth(rand): { return synthRead(this, m, path, rand, n); }
      else: {}
    }
    FileResult whole = this.readFile(path);
    if (!whole.ok || whole.bytes.len() <= n) { return whole; }
    u8[] cut = u8[n]();
    cut.copyFrom(whole.bytes, 0, 0, n);
    return FileResult.of(true, cut, "", FAULT_NONE());
  }

  /** What a path is, if it is anything. */
  Stat stat(this, string path) {
    i32 mi = this.mountOf(path);
    // Absence rather than a fault, as below: a path under no mount is nothing, and that is an answer.
    if (mi < 0) { return Stat.of(false, false, false, 0, 0, false, FAULT_NONE()); }
    Mount m = this.mounts.get(mi);
    match (m.backing) {
      case Host(cli): { return cli.stat(path).wait(); }
      case Synth(rand): { return synthStat(this, m, path); }
      else: {}
    }
    i32 node = this.find(m, path);
    // Absence, not a fault: a memory tree can always answer, and "nothing here" is the answer.
      if (node < 0) { return Stat.of(false, false, false, 0, 0, false, FAULT_NONE()); }
    Inode n = this.nodes.get(node);
    return Stat.of(true, !n.isDir, n.isDir, n.data.len as i64, n.mtime, false, FAULT_NONE());
  }

  /** Nothing here is a symbolic link yet, so this is `stat` — said rather than implied. */
  Stat linkStat(this, string path) { return this.stat(path); }

  /**
   * The names in a directory, sorted, without `.` or `..` — and null for a path that is not one.
   *
   * Sorted because a filesystem's own order is not something a program should depend on and every caller
   * that cares sorts anyway. Null is the capability's answer for "not a directory", and keeping it means
   * `ls` can tell that from an empty one.
   */
  string[]? readDir(this, string path) {
    i32 mi = this.mountOf(path);
    if (mi < 0) { return null; }
    Mount m = this.mounts.get(mi);
    string[]? own = null;
    match (m.backing) {
      case Host(cli): { own = cli.readDir(path).wait(); }
      case Synth(rand): { own = synthDir(this, m, path); }
      else: {
        i32 node = this.find(m, path);
        // Null rather than empty for "not a directory" or "not there", which is what the capability
        // answers and what lets `ls` tell an empty directory from a missing one.
        if (node < 0 || !this.nodes.get(node).isDir) { own = null; }
        else { own = this.nodes.get(node).entries.keys(); }
      }
    }
    if (own is null) { return null; }
    return withMountsUnder(this, path, own!);
  }

  // ── Writing ─────────────────────────────────────────────────────────────────

  /** Create or replace a file, making no parents: the same contract `writeFile` has. */
  Change writeFile(this, string path, u8[] data) {
    i32 mi = this.mountOf(path);
    if (mi < 0) { return Change.of(FAULT_NOT_FOUND(), "no such file or directory"); }
    Mount m = this.mounts.get(mi);
    // **A mount point is a directory, and its parent lives in the mount above.** So the lookup below
    // searches the wrong tree for it and used to answer "no such file or directory" for `/mnt`, and the
    // synthesised backing answered "read-only file system" for `/dev` — three different wrong answers
    // for one question. What `/dev` is, is a directory. Host mounts are left alone: the host answers
    // this correctly already, and asking it twice would cost a round trip to be told what it just said.
    match (m.backing) {
      case Host(cli): {}
      else: {
        if (this.stat(path).isDir) { return Change.of(FAULT_OTHER(), "is a directory"); }
      }
    }
    match (m.backing) {
      case Host(cli): { return cli.writeFile(path, data).wait(); }
      case Synth(rand): {
        // `/dev/null` accepts anything and keeps none of it, which is the whole of what it is for.
        // Every other synthesised file is read-only, and says so rather than appearing to have taken
        // the bytes — a write that vanishes silently is the failure `> /dev/zero` would otherwise be.
        if (synthKind(m, path) == SYNTH_NULL()) { return Change.of(FAULT_NONE(), ""); }
        return Change.of(FAULT_DENIED(), "read-only file system");
      }
      else: {}
    }
    i32 parent = this.find(m, parentOf(path));
    if (parent < 0) { return Change.of(FAULT_NOT_FOUND(), "no such file or directory"); }
    if (!this.nodes.get(parent).isDir) { return Change.of(FAULT_OTHER(), "not a directory"); }
    string name = baseOf(path);
    if (name == "") { return Change.of(FAULT_OTHER(), "is a directory"); }
    i32 existing = this.child(parent, name);
    if (existing >= 0 && this.nodes.get(existing).isDir) {
      // As above: the hosts say "other" for this, and matching them is what the differential asks for.
      return Change.of(FAULT_OTHER(), "is a directory");
    }
    if (existing >= 0) {
      this.nodes.get(existing).replace(data, this.now);
      return Change.of(FAULT_NONE(), "");
    }
    this.nodes.push(fileNode(data, this.owner, this.now));
    this.nodes.get(parent).entries.set(name, this.nodes.len() - 1);
    return Change.of(FAULT_NONE(), "");
  }

  /**
   * A directory. `parents` is `-p`: make what is missing above it, and say nothing if it is already there.
   *
   * The flag is the capability's, so a caller does not have to loop — and a `mkdir -p` written as a loop
   * over `mkdir` cannot tell "already there" from "somebody else made it just now", which is the race the
   * flag exists to avoid.
   */
  Change mkdir(this, string path, bool parents) {
    i32 mi = this.mountOf(path);
    if (mi < 0) { return Change.of(FAULT_NOT_FOUND(), "no such file or directory"); }
    Mount m = this.mounts.get(mi);
    // The same for `mkdir`, where the answer is "file exists" rather than "is a directory" — except
    // under `-p`, which is the flag that means "and say nothing if it is already there".
    // **A mount point is a directory, and its parent lives in the mount above.** So the lookup below
    // searches the wrong tree for it and used to answer "no such file or directory" for `/mnt`, and the
    // synthesised backing answered "read-only file system" for `/dev` — three different wrong answers
    // for one question. What `/dev` is, is a directory. Host mounts are left alone: the host answers
    // this correctly already, and asking it twice would cost a round trip to be told what it just said.
    match (m.backing) {
      case Host(cli): {}
      else: {
        if (this.stat(path).isDir) {
          // `-p` is the flag that means "and say nothing if it is already there", so an existing
          // directory is success under it and "file exists" without it. This answered neither for a
          // mount point: the read-only refusal below fired first and `mkdir -p /dev` failed.
          return parents
            ? Change.of(FAULT_NONE(), "")
            : Change.of(FAULT_EXISTS(), "file exists");
        }
      }
    }
    match (m.backing) {
      case Host(cli): { return cli.mkdir(path, parents).wait(); }
      case Synth(rand): { return Change.of(FAULT_DENIED(), "read-only file system"); }
      else: {}
    }
    if (parents) { return this.mkdirAll(m, path); }
    i32 parent = this.find(m, parentOf(path));
    if (parent < 0) { return Change.of(FAULT_NOT_FOUND(), "no such file or directory"); }
    if (!this.nodes.get(parent).isDir) { return Change.of(FAULT_DENIED(), "not a directory"); }
    string name = baseOf(path);
    if (name == "") { return Change.of(FAULT_EXISTS(), "file exists"); }
    if (this.child(parent, name) >= 0) { return Change.of(FAULT_EXISTS(), "file exists"); }
    this.nodes.push(dirNode(this.owner, this.now));
    this.nodes.get(parent).entries.set(name, this.nodes.len() - 1);
    return Change.of(FAULT_NONE(), "");
  }

  /** Every missing component of a path, and no complaint about the ones that are there. */
  Change mkdirAll(this, Mount m, string path) {
    string rest = path.slice(m.at.len(), path.len());
    Vec<string> parts = splitPath(rest);
    i32 at = m.root;
    for (i32 i = 0; i < parts.len(); i++) {
      i32 next = this.child(at, parts.get(i));
      if (next < 0) {
        this.nodes.push(dirNode(this.owner, this.now));
        next = this.nodes.len() - 1;
        this.nodes.get(at).entries.set(parts.get(i), next);
      } else if (!this.nodes.get(next).isDir) {
        return Change.of(FAULT_EXISTS(), "file exists");
      }
      at = next;
    }
    return Change.of(FAULT_NONE(), "");
  }

  /**
   * Remove a file, or an *empty* directory.
   *
   * The three answers a caller needs are the three the hosts give: gone, not there, or a directory with
   * something in it — which is what makes `rm -f` able to ignore only the second.
   */
  Change remove(this, string path, bool recursive) {
    i32 mi = this.mountOf(path);
    if (mi < 0) { return Change.of(FAULT_NOT_FOUND(), "no such file or directory"); }
    Mount m = this.mounts.get(mi);
    match (m.backing) {
      case Host(cli): { return cli.remove(path, recursive).wait(); }
      case Synth(rand): { return Change.of(FAULT_DENIED(), "read-only file system"); }
      else: {}
    }
    i32 parent = this.find(m, parentOf(path));
    if (parent < 0) { return Change.of(FAULT_NOT_FOUND(), "no such file or directory"); }
    string name = baseOf(path);
    i32 node = this.child(parent, name);
    if (node < 0) { return Change.of(FAULT_NOT_FOUND(), "no such file or directory"); }
    if (this.nodes.get(node).isDir && this.nodes.get(node).entries.len() > 0 && !recursive) {
      return Change.of(FAULT_NOT_EMPTY(), "directory not empty");
    }
    // Nothing is freed: a node nobody points at is unreachable, and an image writer walks from the roots.
    // Reference counting would buy memory back in a program that deletes a great deal, and there is no
    // such program yet — said here rather than discovered later.
    this.nodes.get(parent).entries.remove(name);
    return Change.of(FAULT_NONE(), "");
  }

  /**
   * Set a node's mode.
   *
   * `mode` and `owner` are recorded on every node and enforced nowhere — step 4 of design/0001 is where a
   * session gets a user. They are recorded now so that an image written today is readable then, which is
   * only true if something can actually *set* them: a field nothing writes is a field nothing tests, and
   * "exact metadata" was the whole argument for a format of our own rather than tar.
   *
   * **Not implemented for a host mount.** There is no `chmod` capability — see `packages/platform` — so
   * this refuses rather than pretending, because a mode silently not applied is worse than an error.
   */
  Change chmod(this, string path, i32 mode) {
    i32 mi = this.mountOf(path);
    if (mi < 0) { return Change.of(FAULT_NOT_FOUND(), "no such file or directory"); }
    Mount m = this.mounts.get(mi);
    match (m.backing) {
      case Host(cli): { return Change.of(FAULT_DENIED(), "chmod on a host mount is not implemented"); }
      case Synth(rand): { return Change.of(FAULT_DENIED(), "read-only file system"); }
      else: {}
    }
    i32 node = this.find(m, path);
    if (node < 0) { return Change.of(FAULT_NOT_FOUND(), "no such file or directory"); }
    this.nodes.get(node).setMode(mode);
    return Change.of(FAULT_NONE(), "");
  }

  /** The same for the owner, and refused on a host mount for the same reason. */
  Change chown(this, string path, string owner) {
    i32 mi = this.mountOf(path);
    if (mi < 0) { return Change.of(FAULT_NOT_FOUND(), "no such file or directory"); }
    Mount m = this.mounts.get(mi);
    match (m.backing) {
      case Host(cli): { return Change.of(FAULT_DENIED(), "chown on a host mount is not implemented"); }
      case Synth(rand): { return Change.of(FAULT_DENIED(), "read-only file system"); }
      else: {}
    }
    i32 node = this.find(m, path);
    if (node < 0) { return Change.of(FAULT_NOT_FOUND(), "no such file or directory"); }
    this.nodes.get(node).setOwner(owner);
    return Change.of(FAULT_NONE(), "");
  }

  /** Move a name, replacing what is there — as the hosts do, and as `mv` expects. */
  Change rename(this, string from, string to) {
    i32 fromIndex = this.mountOf(from);
    i32 toIndex = this.mountOf(to);
    if (fromIndex < 0 || toIndex < 0) { return Change.of(FAULT_NOT_FOUND(), "no such file or directory"); }
    Mount fromMount = this.mounts.get(fromIndex);
    Mount toMount = this.mounts.get(toIndex);
    match (fromMount.backing) {
      case Host(cli): {
        // A rename across mounts is a copy and a delete, and no host does it for you. Not implemented
        // rather than half-done: it would need reading the whole file, which a `Change` cannot report.
        match (toMount.backing) {
          case Host(cli2): { return cli.rename(from, to).wait(); }
          else: { return Change.of(FAULT_DENIED(), "rename across mounts is not implemented"); }
        }
      }
      else: {}
    }
    match (toMount.backing) {
      case Host(cli): { return Change.of(FAULT_DENIED(), "rename across mounts is not implemented"); }
      else: {}
    }
    if (fromMount.at != toMount.at) {
      return Change.of(FAULT_DENIED(), "rename across mounts is not implemented");
    }
    i32 fromParent = this.find(fromMount, parentOf(from));
    if (fromParent < 0) { return Change.of(FAULT_NOT_FOUND(), "no such file or directory"); }
    i32 node = this.child(fromParent, baseOf(from));
    if (node < 0) { return Change.of(FAULT_NOT_FOUND(), "no such file or directory"); }
    i32 toParent = this.find(toMount, parentOf(to));
    if (toParent < 0) { return Change.of(FAULT_NOT_FOUND(), "no such file or directory"); }
    if (!this.nodes.get(toParent).isDir) { return Change.of(FAULT_DENIED(), "not a directory"); }

    // **Renaming onto something that is already there.** `rename(2)` has four rules here and this had
    // none of them: it replaced the entry whatever it was, so `mv f d` where `d` is a directory
    // succeeded and orphaned everything `d` held. Not a missing check — a wrong answer, and in an image
    // it is data loss. The categories are the host's, taken from `test/host.test.ts`'s transcript rather
    // than chosen: a file onto any directory and a directory onto a file are both `FAULT_OTHER`, a
    // directory onto a *non-empty* directory is `FAULT_NOT_EMPTY`, and a directory onto an empty one is
    // the single pair that is allowed.
    i32 existing = this.child(toParent, baseOf(to));
    if (existing >= 0 && existing != node) {
      bool fromDir = this.nodes.get(node).isDir;
      bool toDir = this.nodes.get(existing).isDir;
      if (!fromDir && toDir) { return Change.of(FAULT_OTHER(), "is a directory"); }
      if (fromDir && !toDir) { return Change.of(FAULT_OTHER(), "not a directory"); }
      if (fromDir && toDir && this.nodes.get(existing).entries.len() > 0) {
        return Change.of(FAULT_NOT_EMPTY(), "directory not empty");
      }
    }

    this.nodes.get(fromParent).entries.remove(baseOf(from));
    this.nodes.get(toParent).entries.set(baseOf(to), node);
    return Change.of(FAULT_NONE(), "");
  }

  // ── Walking ─────────────────────────────────────────────────────────────────

  /** The node a path names inside a mount, or -1. */
  i32 find(const this, Mount m, string path) {
    if (path.len() < m.at.len()) { return -1; }
    string rest = path.slice(m.at.len(), path.len());
    i32 at = m.root;
    Vec<string> parts = splitPath(rest);
    for (i32 i = 0; i < parts.len(); i++) {
      if (!this.nodes.get(at).isDir) { return -1; }
      i32 next = this.child(at, parts.get(i));
      if (next < 0) { return -1; }
      at = next;
    }
    return at;
  }

  /** A named child of a directory node, or -1. */
  i32 child(const this, i32 dir, string name) {
    if (name == "") { return dir; }
    return this.nodes.get(dir).entries.get(name).orElse(-1);
  }
}

/**
 * A directory's own names, plus any mount point sitting directly in it.
 *
 * Without this a mount is invisible from above: `ls /` on a session with `/dev` and `/proc` listed
 * neither, because the root's own tree has no entry for them — the mount table is the only thing that
 * knows. A listing that omits a directory you can `cd` into is worse than a wrong one, because nothing
 * about it looks wrong.
 *
 * A mount point that *also* exists as a real entry is listed once. Linux shows the mounted filesystem
 * in that case and hides what is underneath, which is what `mountOf`'s longest-prefix rule already does
 * for every other operation.
 */
string[] withMountsUnder(Fs fs, string path, string[] own) {
  string at = trimSlash(path);
  Vec<string> extra = Vec.create();
  for (i32 i = 0; i < fs.mounts.len(); i++) {
    string mp = fs.mounts.get(i).at;
    if (mp == "" || mp == at) { continue; }
    if (!underMount(at, mp)) { continue; }
    string rest = mp.slice(at.len() + 1, mp.len());
    // Directly in this directory, not further down: `/a/b` shows under `/a` and not under `/`.
    if (lastSlash(rest) >= 0) { continue; }
    bool already = false;
    for (i32 k = 0; k < own.len(); k++) { if (own[k] == rest) { already = true; } }
    for (i32 k = 0; k < extra.len(); k++) { if (extra.get(k) == rest) { already = true; } }
    if (!already) { extra.push(rest); }
  }
  if (extra.len() == 0) {
    sortNames(own);
    return own;
  }
  string[] all = string[own.len() + extra.len()](fill: "");
  for (i32 i = 0; i < own.len(); i++) { all[i] = own[i]; }
  for (i32 i = 0; i < extra.len(); i++) { all[own.len() + i] = extra.get(i); }
  sortNames(all);
  return all;
}

/**
 * Mount `/dev` and `/proc`, and record the command line, in one call.
 *
 * Three programs want exactly this and a fourth will; spelling it out in each is how the three drift.
 * `argv` is joined with NULs because that is what `/proc/self/cmdline` is — a caller that joins with
 * spaces has produced something that reads the same and parses differently.
 */
export void mountSystem(Fs fs, fn[Pending<u8[]>(i32)] randomBytes, Vec<string> argv) {
  fs.mountSynth("/dev", randomBytes);
  fs.mountSynth("/proc", randomBytes);
  Buf line = Buf.create();
  for (i32 i = 0; i < argv.len(); i++) {
    line.pushAll(argv.get(i).toBytes());
    line.push(0);
  }
  fs.setCmdline(string.fromBytes(line.take()));
}

// ── Synthesised files ─────────────────────────────────────────────────────────
//
// Step 6 of design/0001. Cheap, because the VFS already answers every question these need to answer, and
// disproportionately convincing: `/dev/null` is the difference between a shell that looks like one and a
// shell you can actually type into.
//
// Nothing is stored. A read runs a generator, so `/dev/zero` costs what is asked of it. Two of the five
// are **endless**, which is the one thing this model cannot express through `readFile`: GNU's
// `cat /dev/zero` runs until something stops it, and one `u8[]` cannot. Rather than invent a length or
// hang, `readFile` refuses those two by name and points at `readSome`, which is what a bounded read —
// `head -c 16 /dev/urandom` — goes through anyway.

i32 SYNTH_NONE() { return 0; }
i32 SYNTH_NULL() { return 1; }
i32 SYNTH_ZERO() { return 2; }
i32 SYNTH_RANDOM() { return 3; }
i32 SYNTH_CMDLINE() { return 4; }
/** A directory in a synthesised tree: the mount point itself, and `/proc/self`. */
i32 SYNTH_DIR() { return 5; }

/** Which synthesised file a path names, or `SYNTH_NONE`. */
i32 synthKind(Mount m, string path) {
  string rest = path.slice(m.at.len(), path.len());
  if (rest == "" || rest == "/") { return SYNTH_DIR(); }
  if (m.at == "/dev") {
    if (rest == "/null") { return SYNTH_NULL(); }
    if (rest == "/zero") { return SYNTH_ZERO(); }
    if (rest == "/urandom" || rest == "/random") { return SYNTH_RANDOM(); }
    return SYNTH_NONE();
  }
  if (m.at == "/proc") {
    if (rest == "/self") { return SYNTH_DIR(); }
    if (rest == "/self/cmdline") { return SYNTH_CMDLINE(); }
    return SYNTH_NONE();
  }
  return SYNTH_NONE();
}

/**
 * Read a synthesised file. `n` is -1 for "the whole of it", which the endless two refuse.
 *
 * The refusal names the file and the way to read it, because "is a directory"-style categories cannot
 * carry it: a caller that gets `FAULT_OTHER` with no sentence learns nothing it can act on.
 */
FileResult synthRead(Fs fs, Mount m, string path, fn[Pending<u8[]>(i32)] randomBytes, i32 n) {
  i32 kind = synthKind(m, path);
  if (kind == SYNTH_NONE()) {
    return FileResult.of(false, u8[0](), "no such file or directory", FAULT_NOT_FOUND());
  }
  if (kind == SYNTH_DIR()) { return FileResult.of(false, u8[0](), "is a directory", FAULT_OTHER()); }
  if (kind == SYNTH_NULL()) { return FileResult.of(true, u8[0](), "", FAULT_NONE()); }
  if (kind == SYNTH_CMDLINE()) {
    u8[] all = fs.cmdline.toBytes();
    if (n < 0 || n >= all.len()) { return FileResult.of(true, all, "", FAULT_NONE()); }
    u8[] cut = u8[n]();
    cut.copyFrom(all, 0, 0, n);
    return FileResult.of(true, cut, "", FAULT_NONE());
  }
  if (n < 0) {
    return FileResult.of(false, u8[0](),
      "this file has no end: read a fixed number of bytes from it instead", FAULT_OTHER());
  }
  if (kind == SYNTH_ZERO()) { return FileResult.of(true, u8[n](fill: 0), "", FAULT_NONE()); }
  return FileResult.of(true, randomBytes(n).wait(), "", FAULT_NONE());
}

Stat synthStat(Fs fs, Mount m, string path) {
  i32 kind = synthKind(m, path);
  if (kind == SYNTH_NONE()) { return Stat.of(false, false, false, 0, 0, false, FAULT_NONE()); }
  if (kind == SYNTH_DIR()) { return Stat.of(true, false, true, 0, fs.now, false, FAULT_NONE()); }
  // Size zero for the endless two, which is what Linux reports for them as well: a character device has
  // no length, and zero is how that is spelled. `/proc/self/cmdline` has a real one.
  i64 size = kind == SYNTH_CMDLINE() ? fs.cmdline.toBytes().len() as i64 : 0 as i64;
  return Stat.of(true, true, false, size, fs.now, false, FAULT_NONE());
}

string[]? synthDir(Fs fs, Mount m, string path) {
  i32 kind = synthKind(m, path);
  if (kind != SYNTH_DIR()) { return null; }
  string rest = path.slice(m.at.len(), path.len());
  if (m.at == "/dev") { return string[]("null", "random", "urandom", "zero"); }
  if (rest == "/self") { return string[]("cmdline"); }
  return string[]("self");
}

/**
 * Sort names by bytes, in place.
 *
 * Insertion sort: a directory listing is small, and a reader can check it. By *bytes*, because that is
 * what `LC_ALL=C` means and what every tool this is compared against does with it.
 *
 * Exported because `image.wac` needs the same order for the same reason — an image's entries are written
 * in listing order so that the same filesystem written twice gives the same bytes. Two copies of this
 * would drift, and the drift would be invisible: both images would load fine and only compare unequal.
 */
export void sortNames(string[] names) {
  for (i32 i = 1; i < names.len(); i++) {
    string v = names[i];
    i32 j = i - 1;
    while (j >= 0 && afterName(names[j], v)) {
      names[j + 1] = names[j];
      j--;
    }
    names[j + 1] = v;
  }
}

/** Whether `a` sorts after `b`, by bytes. wac compares strings for equality and not for order. */
bool afterName(string a, string b) {
  u8[] x = a.toBytes();
  u8[] y = b.toBytes();
  i32 n = x.len() < y.len() ? x.len() : y.len();
  for (i32 i = 0; i < n; i++) {
    if (x[i] != y[i]) { return x[i] > y[i]; }
  }
  return x.len() > y.len();
}

/** A fresh empty directory. */
Inode dirNode(string owner, i64 now) {
  return Inode(true, Map.create(hashString, stringEq), Buf.create(), 493, owner, now);   // 0755
}

/** A fresh file holding these bytes. */
Inode fileNode(u8[] data, string owner, i64 now) {
  Buf held = Buf.create();
  held.pushAll(data);
  return Inode(false, Map.create(hashString, stringEq), held, 420, owner, now);          // 0644
}

/** The path above this one: `/a/b` gives `/a`, and `/a` gives the root. */
string parentOf(string path) {
  i32 cut = lastSlash(path);
  if (cut <= 0) { return ""; }
  return path.slice(0, cut);
}

/** The last component: `/a/b` gives `b`. */
string baseOf(string path) {
  i32 cut = lastSlash(path);
  if (cut < 0) { return path; }
  return path.slice(cut + 1, path.len());
}

i32 lastSlash(string path) {
  i32 at = -1;
  for (i32 i = 0; i < path.len(); i++) {
    if (path.slice(i, i + 1) == "/") { at = i; }
  }
  return at;
}

/** A path without its trailing slash, and the root as the empty string. */
string trimSlash(string path) {
  if (path.len() > 1 && path.slice(path.len() - 1, path.len()) == "/") {
    return path.slice(0, path.len() - 1);
  }
  if (path == "/") { return ""; }
  return path;
}

/** Whether `path` is at or under `at`, treating `at` as a whole component. */
bool underMount(string at, string path) {
  if (at == "") { return true; }
  if (path.len() < at.len()) { return false; }
  if (path.slice(0, at.len()) != at) { return false; }
  if (path.len() == at.len()) { return true; }
  return path.slice(at.len(), at.len() + 1) == "/";
}

/** The non-empty components of a path. */
Vec<string> splitPath(string path) {
  Vec<string> out = Vec.create();
  i32 from = 0;
  for (i32 i = 0; i <= path.len(); i++) {
    bool end = i == path.len();
    if (!end && path.slice(i, i + 1) != "/") { continue; }
    if (i > from) { out.push(path.slice(from, i)); }
    from = i + 1;
  }
  return out;
}
