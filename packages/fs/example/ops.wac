// The same filesystem operations against memory or against the host, so the two can be compared.
//
//   ops mem                 # everything in this program's own memory
//   ops host /tmp/whatever  # the host's filesystem, under that directory
//
// One operation per line on standard input, one line of answer each. The point is the *comparison*: the
// host is the oracle for what a filesystem does, and running the same script both ways turns "I think
// `rm` on a non-empty directory reports not-empty" into something a test can check against Deno.
//
// `test/host.test.ts` drives it. Keeping the script a text protocol rather than a wac test means the two
// runs share nothing but the bytes, which is the same reason `packages/wacc`'s rungs project both sides
// onto a printed form.

import { Sys, Files, MemoryStore, Input, Output, NotFound, Denied, Exists, NotEmpty, IsDir, NotADir, ReadOnly,
         NameTooLong, Loop, NoSpace, NotRepresentable, NotGranted, Unsupported, OutputClosed, Other } from "std";
import { Sink } from "../../platform/src/stream.wac";
import { Vec, flatten } from "core";

export async i32 main(Sys sys) {
  string[] argv = sys.args();
  Input stdin = sys.stdin();
  Output err = sys.stderr();
  i32 n = argv.len();
  if (n < 1) {
    err.line("usage: ops mem | ops host <root>");
    return 2;
  }
  string kind = argv[0];
  string prefix = "";
  Files fs = MemoryStore.create(sys.clock()).asUser("root");
  if (kind == "host") {
    if (n < 2) {
      err.line("ops host needs a root directory");
      return 2;
    }
    prefix = argv[1];
    fs = sys.files();
  } else if (kind != "mem") {
    err.line("ops: unknown backing '\{kind}'");
    return 2;
  }

  Sink out = Sink.to(sys.stdout());
  u8[] script = flatten(stdin.readAll().wait()).orElse(u8[]());
  Vec<string> lines = splitLines(string.fromBytes(script));
  for (i32 i = 0; i < lines.len(); i++) {
    string line = lines.get(i);
    if (line == "") { continue; }
    out.line(await answer(fs, prefix, line));
  }
  out.flush();
  return 0;
}

/**
 * One operation, and what it answered.
 *
 * Faults are printed as their category rather than their message, because the message is the
 * host's own words and the category is the thing both sides must agree on — the same reason the
 * differential tests for `mkdir` and `rm` compare GNU's reason rather than a runtime's errno text.
 */
async string answer(Files fs, string prefix, string line) {
  Vec<string> words = splitSpaces(line);
  string op = words.get(0);
  string a = words.len() > 1 ? prefix + words.get(1) : "";
  string b = words.len() > 2 ? prefix + words.get(2) : "";

  if (op == "write") {
    // The rest of the line is the content, so a file can hold a space.
    string body = words.len() > 2 ? rest(line, words.get(0).len() + 1 + words.get(1).len() + 1) : "";
    auto wrote = await fs.writeFile(a, body.toBytes());
    return "write " + (wrote.isOk() ? "0" : kind(wrote.err()!));
  }
  if (op == "read") {
    match (await fs.readFile(a)) {
      Ok(bytes): { return "read [\{string.fromBytes(bytes)}]"; }
      Err(e): { return "read fault " + kind(e); }
    }
  }
  if (op == "mkdir") { auto r = await fs.mkdir(a, false); return "mkdir " + (r.isOk() ? "0" : kind(r.err()!)); }
  if (op == "mkdirp") { auto r = await fs.mkdir(a, true); return "mkdirp " + (r.isOk() ? "0" : kind(r.err()!)); }
  if (op == "rm") { auto r = await fs.remove(a, false); return "rm " + (r.isOk() ? "0" : kind(r.err()!)); }
  if (op == "rmr") { auto r = await fs.remove(a, true); return "rmr " + (r.isOk() ? "0" : kind(r.err()!)); }
  if (op == "mv") { auto r = await fs.rename(a, b); return "mv " + (r.isOk() ? "0" : kind(r.err()!)); }
  if (op == "stat") {
    // A *file's* size is a fact; a directory's is the host's block size — 4096 on the ext4 under this
    // container, and something else elsewhere. Imitating that number would be cargo-culting a detail no
    // program should read, so it is left out of the transcript rather than matched.
    match (await fs.stat(a)) {
      Ok(s): { return s.isDir ? "stat dir" : "stat file \{s.size as~ i32}"; }
      Err(e): { return "stat absent"; }
    }
  }
  if (op == "ls") {
    string[]? names = (await fs.readDir(a)).ok();
    if (names is null) { return "ls absent"; }
    string joined = "";
    for (i32 i = 0; i < names!.len(); i++) {
      joined = joined + (i == 0 ? "" : " ") + names![i];
    }
    return "ls [\{joined}]";
  }
  return "unknown \{op}";
}

/** Every fault a `Files` operation answers. */
type FilesFault = union<NotFound, Denied, Exists, NotEmpty, IsDir, NotADir, ReadOnly, NameTooLong, Loop, NoSpace,
                        NotRepresentable, NotGranted, Unsupported, OutputClosed, Other>;

/** A fault's category, which both backings must agree on; success prints `0`. */
string kind(FilesFault e) {
  if (e is NotFound) { return "NotFound"; }
  if (e is Denied) { return "Denied"; }
  if (e is Exists) { return "Exists"; }
  if (e is NotEmpty) { return "NotEmpty"; }
  if (e is IsDir) { return "IsDir"; }
  if (e is NotADir) { return "NotADir"; }
  if (e is ReadOnly) { return "ReadOnly"; }
  if (e is NameTooLong) { return "NameTooLong"; }
  if (e is Loop) { return "Loop"; }
  if (e is NoSpace) { return "NoSpace"; }
  if (e is NotRepresentable) { return "NotRepresentable"; }
  if (e is NotGranted) { return "NotGranted"; }
  if (e is Unsupported) { return "Unsupported"; }
  if (e is OutputClosed) { return "OutputClosed"; }
  return "Other";
}

/** The line from `at` on. */
string rest(string line, i32 at) {
  if (at >= line.len()) { return ""; }
  return line.slice(at, line.len());
}

Vec<string> splitLines(string text) {
  Vec<string> out = Vec.create();
  i32 from = 0;
  for (i32 i = 0; i <= text.len(); i++) {
    bool end = i == text.len();
    if (!end && text.slice(i, i + 1) != "\n") { continue; }
    out.push(text.slice(from, i));
    from = i + 1;
  }
  return out;
}

Vec<string> splitSpaces(string text) {
  Vec<string> out = Vec.create();
  i32 from = 0;
  for (i32 i = 0; i <= text.len(); i++) {
    bool end = i == text.len();
    if (!end && text.slice(i, i + 1) != " ") { continue; }
    if (i > from) { out.push(text.slice(from, i)); }
    from = i + 1;
  }
  if (out.len() == 0) { out.push(""); }
  return out;
}

