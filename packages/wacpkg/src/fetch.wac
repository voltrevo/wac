// `wacfetch <project>` — resolve what the lock does not cover, fetch it, and write the lock.
//
//     wac task app:build packages/wacpkg/src/fetch.wac \
//       --allow-read --allow-write --allow-net --allow-env -o wacfetch
//     ./wacfetch .
//
// This is `design/lang/0009` D11's network half, and it is composition rather than new protocol:
// `packages/wacpkg` decides *what* to fetch and where it goes, `packages/git` and `packages/tls` do
// the fetching. Nothing here parses a pack or speaks pkt-line — `packages/git/example/gitfetch.wac`
// is the same sequence for one repository given on a command line.
//
// What it does per mapping the plan says is not covered:
//
//   1. refuse a url this toolchain cannot fetch, before opening a socket
//   2. GET the advertisement, and resolve the mapping's `ref` against it
//   3. POST a want for that commit, and index the pack that comes back
//   4. **look the commit up in that index by name**, which is the check worth having
//   5. write the pack and its index under `$WAC_HOME/cache/git/<repo>/<commit>`
//
// Step 4 is why the answer is trustworthy rather than merely arrived. A pack is content-addressed:
// `indexPack` hashes what each object *resolves to*, deltas included, so a pack mis-parsed cannot
// produce an object whose SHA-1 is the name we asked for. Getting that commit back out is TLS,
// HTTP, pkt-line, the pack format, delta resolution and SHA-1 all agreeing at once — which is a
// stronger statement than any byte count, and the reason this does not simply trust a 200.
//
// **A mapping the lock already covers is not fetched and not consulted.** That is `plan`'s rule and
// the whole point of a lockfile; the loop below skips a `USE` step before it looks at the network.

import { Change, FileResult, Sys, Clock, Env, Files, Net, Output, Random, Stat } from "std";
// `decode` as well as `encode`: the first version of this had its own `hexBytes` and `nib`,
// which is a third implementation of a rule `packages/codec` already owns.
import { decode, encode } from "../../codec/src/hex.wac";
import { Vec, flatten } from "core";
import { Ad, AdRef, findPack, offers, parseAdvertisement, wantRequest, Reply }
  from "../../git/src/fetch.wac";
import { Got, Indexed, Pack, indexPack, objectNamed, openIndexed } from "../../git/src/pack.wac";
import { Entry, Tree, parseTree } from "../../git/src/tree.wac";
import { Parsed, parseCommit } from "../../git/src/commit.wac";
import { PackIndex } from "../../git/src/idx.wac";
import { Store } from "../../tls/src/roots.wac";
import { Answer, Remote, parseRemote, request, systemStore } from "../../git/src/transport.wac";
import { Manifest, Mapping, readManifest, unsupportedTransport } from "./manifest.wac";
import { Lock, LockEntry, Step, applyPlan, plan, readLock, writeLock, USE } from "./lock.wac";
import { MANIFEST_NAME } from "./root.wac";
import { cachePath } from "./cache.wac";
import { resolveRef, Resolved } from "./refs.wac";

/** How deep a fetch asks for. One commit is what a locked dependency needs. */
i32 depth() { return 1; }

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Clock clock = sys.clock();
  Random rnd = sys.random();
  Env env = sys.env();
  Files fs = sys.files();
  Net net = sys.net();
  i32 argc = argv.len();
  string dir = argc > 0 ? argv[0] : ".";
  string wacHome = argc > 1 ? argv[1] : ".wac";
  return fetchAll(err, out, clock, rnd, env, fs, net, dir, wacHome);
}

/**
 * The whole of `wac update`, with its two arguments passed rather than read.
 *
 * **Split from `main` so the command can call it.** `wac update` was a separate wasm payload the
 * native binary embedded and the JavaScript hosts had no copy of, which is why it looked like
 * something only a native `wac` could do. It is one program's subcommand now
 * (`issues/system/0257c`), and a subcommand takes parameters where a payload read argv.
 *
 * `dir` is the project and `wacHome` is the cache root — the same two the native handed the payload,
 * and the second has to be the real `$WAC_HOME` or a fetch fills a cache nothing later reads.
 */
export i32 fetchAll(Output err, Output out, Clock clock, Random rnd, Env env, Files fs, Net net, string dir, string wacHome) {
  u8[]? mf = flatten(fs.readFile(join(dir, MANIFEST_NAME())).wait()).ok();
  if (mf is null) {
    err.line("wacfetch: \{join(dir, MANIFEST_NAME())} could not be read, so \{dir}"
              + " is not a project");
    return 1;
  }
  Manifest m = readManifest(mf!);
  if (!m.ok) {
    err.line("wacfetch: " + MANIFEST_NAME() + " is not valid: code \{m.code}"
              + (m.detail == "" ? "" : " (\{m.detail})"));
    return 1;
  }
  u8[]? lf = flatten(fs.readFile(join(dir, "wac.lock")).wait()).ok();
  Lock l = (lf is not null) ? readLock(lf!) : Lock.empty();
  if (!l.ok) {
    err.line("wacfetch: wac.lock is not valid: code \{l.code}"
              + (l.detail == "" ? "" : " (\{l.detail})"));
    return 1;
  }

  // Every refusal we can make without a socket, made first and all at once — so a manifest with
  // three bad urls reports three, rather than one per run.
  i32 refused = 0;
  for (i32 i = 0; i < m.imports.len(); i++) {
    string why = unsupportedTransport(m.imports[i].git);
    if (why == "") { continue; }
    refused = refused + 1;
    err.line("wacfetch: \{m.imports[i].name}: \{why}");
  }
  if (refused > 0) { return 1; }

  Step[] steps = plan(m, l);
  string[] resolved = string[].filled(steps.len(), "");
  Store store = systemStore(fs);
  i32 fetched = 0;

  for (i32 i = 0; i < steps.len(); i++) {
    Mapping map = m.imports[i];
    if (steps[i].action == USE()) {
      // **Locked is not the same as present.** `plan` compares the manifest with the lock and never
      // looks at the cache, so a lock entry was read as proof there was nothing to fetch — and a
      // project whose cache had been removed sat in a loop: `wac update` said *nothing to fetch; 1
      // mapping(s) already locked* while `wac check` refused to build and told the user to run `wac
      // update`. The only way out was deleting the lock, which is the one file that was right.
      // GitHub wac#25.
      //
      // A committed lockfile is supposed to make a project portable to a clean machine, so the
      // absent-cache case is a *restore*: fetch the commit the lock already chose, without
      // consulting the ref, and leave the lock exactly as it was.
      string at = cachePath(wacHome, map.git, steps[i].commit);
      if (at != "" && flatten(fs.stat("\{at}/pack.pack").wait()).orElse(Stat.of(false, false, false, 0, 0, false, false, 0, 0)).isFile) {
        // Not consulted, not counted. The lock covers it and a branch that moved is not a reason.
        resolved[i] = steps[i].commit;
        continue;
      }
      string back = fetchOne(err, out, clock, rnd, env, fs, net, store, wacHome, map, "locked, and not in the cache", steps[i].commit);
      if (back == "") { return 1; }
      resolved[i] = back;
      fetched = fetched + 1;
      continue;
    }
    string got = fetchOne(err, out, clock, rnd, env, fs, net, store, wacHome, map, steps[i].why, "");
    if (got == "") { return 1; }
    resolved[i] = got;
    fetched = fetched + 1;
  }

  LockEntry[] next = applyPlan(m, l, steps, resolved);
  if (next.len() != m.imports.len()) {
    err.line("wacfetch: the lock could not be built from what was resolved");
    return 1;
  }
  if (fetched == 0) {
    out.line("wacfetch: nothing to fetch; \{steps.len()} mapping(s) already locked");
    return 0;
  }
  auto wrote = flatten(fs.writeFile(join(dir, "wac.lock"), writeLock(next)).wait());
  if (wrote.isErr()) {
    err.line("wacfetch: cannot write wac.lock: \{wrote.isErr() ? "\{wrote.err()!}" : ""}");
    return 1;
  }
  out.line("wacfetch: \{fetched} fetched, \{steps.len() - fetched}"
           + " already locked");
  return 0;
}

/**
 * One mapping: resolve, fetch, verify, cache. The commit, or "" having said why.
 *
 * `why` is the plan's reason, printed so that a fetch a person did not expect says what changed in
 * the manifest to cause it.
 */
/**
 * Fetch one mapping, or restore one the lock already pins.
 *
 * `pin` is "" for an ordinary resolve — ask the server what `map.ref` names now — and a full commit
 * when the lock already decided and only the *cache* is missing it. `issues` aside, that second case
 * is GitHub wac#25: a committed `wac.lock` is supposed to make a project portable to a clean machine,
 * and a lock entry was being read as proof there was nothing to fetch.
 *
 * The advertisement is still requested when pinned, because the capabilities come from it and a
 * `want` without `ofs-delta` asks for a bigger pack. What is skipped is `resolveRef`: the ref may
 * have moved since the lock was written, and following it would quietly relock the project to
 * something else — which is the one thing a lockfile exists to prevent.
 */
string fetchOne(Output err, Output out, Clock clock, Random rnd, Env env, Files fs, Net net, const Store store, string wacHome, Mapping map, string why, string pin) {
  string what = "\{map.name} (\{map.git} @ \{map.ref})";
  out.line("wacfetch: " + what + (why == "" ? "" : " — \{why}"));

  Remote r = parseRemote(map.git);
  if (!r.ok) { err.line("wacfetch: \{map.name}: \{map.git} is not an https url"); return ""; }

  Answer refs = request(clock, rnd, env, net, store, r.host, "\{r.path}/info/refs?service=git-upload-pack", u8[](), "");
  if (!refs.ok) { err.line("wacfetch: \{map.name}: \{refs.error}"); return ""; }
  if (refs.status != 200) {
    err.line("wacfetch: \{map.name}: \{r.host} answered \{refs.status}"
              + " for the advertisement");
    return "";
  }

  string[] names = string[].filled(0, "");
  string[] oids = string[].filled(0, "");
  string caps = "agent=wac/0";
  match (parseAdvertisement(refs.body)) {
    Garbled(why2): {
      err.line("wacfetch: \{map.name}: the advertisement did not parse: \{why2}");
      return "";
    }
    Said(ad) : {
      names = string[].filled(ad.refs.len(), "");
      oids = string[].filled(ad.refs.len(), "");
      for (i32 i = 0; i < ad.refs.len(); i++) {
        AdRef one = ad.refs.get(i);
        names[i] = one.name;
        oids[i] = string.fromBytes(encode(one.target));
      }
      caps = offers(ad, "ofs-delta") ? "ofs-delta agent=wac/0" : "agent=wac/0";
    }
  }

  Resolved hit = pin != "" ? Resolved(true, 0, pin, "the lock") : resolveRef(names, oids, map.ref);
  if (!hit.ok) {
    err.line("wacfetch: " + map.name + ": `" + map.ref + "` "
              + (hit.code == 2 ? "is both a branch and a tag there; name it in full"
                               : "names nothing the server advertised"));
    return "";
  }
  out.line("  " + map.ref + " -> " + hit.commit.slice(0, 12)
           + (hit.via == "" ? " (an object name)" : " via \{hit.via}"));

  // **Already here?** The pack below is 8.75 MB for this repository and the checkout it writes is a
  // pure function of the repository and the commit — so a second project mapping the same commit was
  // downloading, indexing and writing out a tree that was already on disk, 18 to 20 seconds each
  // time. Reported against a set of external projects on 2026-08-25 as "cross-project cache reuse
  // appears incomplete"; it was not incomplete, there was no check at all. The cache was consulted
  // when a *build* opened a mapped file and never when a fetch decided whether to do any work.
  //
  // **`pack.pack` is the marker and it was already there.** The order below is: make the directory,
  // index, write the tree out, and write the pack *last*. So a directory holding `pack.pack` is one
  // whose checkout finished, and one interrupted half way through leaves a tree without it and is
  // fetched again — which is the safe direction to be wrong in.
  //
  // The ref is still resolved first, because a lockfile that does not yet name a commit cannot say
  // which directory to look in. This saves the pack, not the round trip.
  string have = cachePath(wacHome, map.git, hit.commit);
  if (have != "" && flatten(fs.stat("\{have}/pack.pack").wait()).orElse(Stat.of(false, false, false, 0, 0, false, false, 0, 0)).isFile) {
    out.line("  \{hit.commit.slice(0, 12)} is already in the cache -> \{have}");
    return hit.commit;
  }

  // `resolveRef` guarantees forty lowercase hex, so this cannot fail — but `decode` says so with
  // a null rather than by trapping, and answering it is cheaper than explaining why it is safe.
  u8[]? raw = decode(hit.commit.toBytes());
  if (raw is null) {
    err.line("wacfetch: \{map.name}: \{hit.commit} is not an object name");
    return "";
  }
  u8[] want = raw!;

  Vec<u8[]> wants = Vec.create();
  wants.push(want);
  Vec<u8[]> haves = Vec.create();
  Answer packed = request(clock, rnd, env, net, store, r.host, "\{r.path}/git-upload-pack", wantRequest(wants, haves, caps, depth()), "application/x-git-upload-pack-request");
  if (!packed.ok) { err.line("wacfetch: \{map.name}: \{packed.error}"); return ""; }
  if (packed.status != 200) {
    err.line("wacfetch: \{map.name}: \{r.host} answered \{packed.status}"
              + " for the pack");
    return "";
  }
  u8[] pack = u8[]();
  match (findPack(packed.body)) {
    NoPack(why3): {
      err.line("wacfetch: \{map.name}: no pack in the reply: \{why3}");
      return "";
    }
    Packfile(bytes): { pack = bytes; }
  }

  // **The check that makes it trustworthy.** A pack is content-addressed, so one mis-parsed cannot
  // produce an object whose SHA-1 is the name we asked for.
  i32 objects = 0;
  // **Where it goes, decided before the pack is opened**, so the checkout can use the `Pack` the
  // verification below already has. Indexing a pack twice is half a million objects twice.
  string into = cachePath(wacHome, map.git, hit.commit);
  if (into == "") { err.line("wacfetch: \{map.name}: no cache path"); return ""; }
  auto made = flatten(fs.mkdir(into, true).wait());
  if (made.isErr()) { err.line("wacfetch: cannot make \{into}: \{made.isErr() ? "\{made.err()!}" : ""}"); return ""; }

  match (indexPack(pack)) {
    Unindexable(why4): {
      err.line("wacfetch: \{map.name}: the pack did not index: \{why4}");
      return "";
    }
    // Not reachable while every request sends no `have` — a server with nothing to delta against
    // sends a complete pack. Answered rather than left to fall through, because the day this asks
    // for an incremental fetch it will be, and a thin pack is not a damaged one.
    Thin(bases): {
      err.line("wacfetch: \{map.name}: a thin pack, wanting \{bases.len()}"
                + " object(s) we did not ask about");
      return "";
    }
    Built(idx): {
      objects = idx.count;
      Pack p = openIndexed(pack, idx);
      match (objectNamed(p, want)) {
        Absent(why5): {
          err.line("wacfetch: \{map.name}: the pack does not contain "
                    + "\{hit.commit.slice(0, 12)}: \{why5}");
          return "";
        }
        Found(kind, data): {
          if (kind != 1) {
            err.line("wacfetch: \{map.name}: \{hit.commit.slice(0, 12)}"
                      + " came back as kind \{kind} rather than a commit");
            return "";
          }
          // **And the files, because a pack is not something the compiler can read.** Fetching that
          // stopped at the pack left the cache holding what only git understands, while `wac build`
          // resolving a mapped specifier opens an ordinary path — so the two halves of D9-D11 each
          // worked and did not meet. This is the join, and it reuses the `Pack` the check above
          // opened rather than indexing the same objects a second time.
          Parsed c = parseCommit(data);
          match (c) {
            Malformed(why6): {
              err.line("wacfetch: \{map.name}: unreadable commit: \{why6}");
              return "";
            }
            Understood(commit): {
              if (!writeTreeOut(err, fs, p, commit.tree, into)) { return ""; }
              out.line("  checked out \{commit.treeHex().slice(0, 8)} -> \{into}");
            }
          }
        }
      }
    }
  }

  auto wrotePack = flatten(fs.writeFile("\{into}/pack.pack", pack).wait());
  if (wrotePack.isErr()) {
    err.line("wacfetch: cannot write \{into}/pack.pack: \{wrotePack.isErr() ? "\{wrotePack.err()!}" : ""}");
    return "";
  }
  out.line("  \{pack.len()} bytes, \{objects} objects -> "
           + "\{into}/pack.pack");

  return hit.commit;
}

/**
 * Write a commit's tree out of a pack, as files, under `into`.
 *
 * **The cache has to hold files, not a pack, because the compiler reads files.** `wac build` resolves
 * a mapped specifier to `cachePath(repo, commit)` plus the repository-relative path and opens it —
 * see `packages/wac/src/wac.wac`. A pack there would mean the compiler doing git, which is the
 * opposite of the split `design/lang/0009` D11 draws: fetching is wac, and what it leaves behind is
 * an ordinary directory anything can read.
 *
 * The whole tree, not just the `subdir`, and that is deliberate: the cache is keyed by repository and
 * commit alone, so two mappings with different `subdir`s share one checkout. Extracting per mapping
 * would make the cache a function of three things and quietly break the identity D8 rests on.
 *
 * Submodules — mode `160000` — are skipped rather than failed on: the pack does not contain them, so
 * there is nothing to write, and a dependency that happens to have one is not thereby unusable.
 * Symlinks (`120000`) are written as the ordinary files their content makes them, which is what a
 * reader wanting a `.wac` file needs and avoids handing a fetched repository the power to point
 * outside its own checkout.
 */
bool writeTreeOut(Output err, Files fs, Pack pk, u8[] treeHash, string into) {
  Got got = objectNamed(pk, treeHash);
  match (got) {
    Absent(why): {
      err.line("wacfetch: a tree is missing from the pack: \{why}");
      return false;
    }
    Found(kind, data): {
      Tree t = parseTree(data);
      match (t) {
        Bad(why): { err.line("wacfetch: unreadable tree: \{why}"); return false; }
        Ok(entries): {
          for (i32 i = 0; i < entries.len(); i++) {
            Entry e = entries.get(i);
            string at = "\{into}/\{e.name}";
            if (e.mode == "160000") { continue; }
            if (e.isTree()) {
              auto made = flatten(fs.mkdir(at, true).wait());
              if (made.isErr()) {
                err.line("wacfetch: cannot make \{at}: \{made.isErr() ? "\{made.err()!}" : ""}");
                return false;
              }
              if (!writeTreeOut(err, fs, pk, e.hash, at)) { return false; }
              continue;
            }
            Got blob = objectNamed(pk, e.hash);
            match (blob) {
              Absent(why2): {
                err.line("wacfetch: \{e.name} is missing from the pack: \{why2}");
                return false;
              }
              Found(k2, bytes): {
                auto wrote = flatten(fs.writeFile(at, bytes).wait());
                if (wrote.isErr()) {
                  err.line("wacfetch: cannot write \{at}: \{wrote.isErr() ? "\{wrote.err()!}" : ""}");
                  return false;
                }
              }
            }
          }
          return true;
        }
      }
    }
  }
}

string join(string dir, string name) {
  if (dir == "" || dir == ".") { return name; }
  return dir.slice(dir.len() - 1, dir.len()) == "/" ? dir + name : "\{dir}/\{name}";
}
