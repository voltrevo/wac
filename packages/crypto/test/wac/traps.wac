// The argument guards that `trap`, driven one call at a time.
//
// A trap aborts the module, so a wac test cannot assert one and keep running — this is the shape
// `packages/ens/test/wac/traps.wac`, `packages/rlp/test/wac/traps.wac` and `packages/std/test/traps.wac`
// use, with `packages/std/cov.ts` showing the other half: the file is a coverage unit as well, because
// the counter for the branch is incremented *before* the trap fires, so instrumenting it is what makes
// a guard a measured decision rather than an unaccounted one.
//
// **Why these are worth driving rather than excusing.** A guard against a caller error is exactly the
// code nothing exercises by accident, and "it traps, obviously" is a claim rather than a check —
// deleting one leaves every other test in this package passing. `issues/lang/0112`.

import { CtrStream } from "../../src/aesctr.wac";
import { fpFromBytes, fpMul } from "../../src/fieldp.wac";
import { p256Ecdh } from "../../src/p256.wac";

/** A field element is 4n bytes; anything else has no reading. */
export i32 fieldFromRaggedBytes() { fpFromBytes(u8[30]()); return 0; }

/** 4n bytes, but n is neither of the two widths this field has. */
export i32 fieldFromWrongWidth() { fpFromBytes(u8[40]()); return 0; }

/** Two field elements of different widths are not multiplicands. */
export i32 mulAcrossWidths() {
  fpMul(fpFromBytes(u8[32]()), fpFromBytes(u8[48]()));
  return 0;
}

/**
 * A private scalar of the wrong length for the curve.
 *
 * The other half of this guard — zero, or at or above the order — is the one an attacker supplies,
 * and both are refused the same way.
 */
export i32 ecdhShortScalar() {
  p256Ecdh(u8[31](), u8[65]());
  return 0;
}

/** Zero is not a private key, and a curve whose order it reaches is not one either. */
export i32 ecdhZeroScalar() {
  u8[] pub = u8[65]();
  pub[0] = 4;
  p256Ecdh(u8[32](), pub);
  return 0;
}

/** A resumed stream is positioned by a whole counter block and a whole keystream block. */
export i32 resumeWithShortCounter() {
  CtrStream.resume(u8[16](), u8[8](), u8[16](), 0);
  return 0;
}
