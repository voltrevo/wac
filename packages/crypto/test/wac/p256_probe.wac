// P-256 field and curve at the host boundary.
import { fpAdd, fpSub, fpMul, fpSquare, fpInvert, fpNeg, fpToBytes, fpFromBytes,
         fpInRange, fpIsZero, fpEquals } from "../../src/fieldp.wac";

export u8[] pAdd(u8[] a, u8[] b) { return fpToBytes(fpAdd(fpFromBytes(a), fpFromBytes(b))); }
export u8[] pSub(u8[] a, u8[] b) { return fpToBytes(fpSub(fpFromBytes(a), fpFromBytes(b))); }
export u8[] pMul(u8[] a, u8[] b) { return fpToBytes(fpMul(fpFromBytes(a), fpFromBytes(b))); }
export u8[] pSquare(u8[] a) { return fpToBytes(fpSquare(fpFromBytes(a))); }
export u8[] pInvert(u8[] a) { return fpToBytes(fpInvert(fpFromBytes(a))); }
export u8[] pNeg(u8[] a) { return fpToBytes(fpNeg(fpFromBytes(a))); }
export u8[] pRoundTrip(u8[] a) { return fpToBytes(fpFromBytes(a)); }
export bool pInRange(u8[] a) { return fpInRange(a); }

// The curve.
import { p256PublicKey, p256Ecdh, p256Verify, p256Sign, p256Order,
         p256ScalarBase, p256Reencode } from "../../src/p256.wac";
export u8[] pubKey(u8[] priv) { return p256PublicKey(priv); }
export u8[] ecdh(u8[] priv, u8[] peer) { return p256Ecdh(priv, peer); }
export bool verify(u8[] pub, u8[] msg, u8[] sig) { return p256Verify(pub, msg, sig); }
export u8[] sign(u8[] priv, u8[] msg, u8[] k) { return p256Sign(priv, msg, k); }
export u8[] order() { return p256Order(); }
export u8[] baseEncoded() { return p256Reencode(p256ScalarBase(oneScalar())); }
export u8[] scalarBase(u8[] k) { return p256ScalarBase(k); }
export u8[] reencode(u8[] pt) { return p256Reencode(pt); }

u8[] oneScalar() { u8[] k = u8[32](); k[31] = 1; return k; }

// P-384 verification.
import { p384Verify, p384VerifyDigest, p384Order } from "../../src/p384.wac";
export bool verify384(u8[] pub, u8[] msg, u8[] sig) { return p384Verify(pub, msg, sig); }
export bool verify384Digest(u8[] pub, u8[] d, u8[] sig) { return p384VerifyDigest(pub, d, sig); }
export u8[] order384() { return p384Order(); }
import { p256VerifyDigest } from "../../src/p256.wac";
export bool verifyDigest(u8[] pub, u8[] d, u8[] sig) { return p256VerifyDigest(pub, d, sig); }

// **A big-endian comparison looks past the first byte**, which is the half of `cmpBE` that random
// keys drive only by chance: two values differ in their leading byte almost always, so the loop's
// *continue* side was covered on some runs and not others and the coverage ledger flickered with it.
// Driven here on purpose — a scalar sharing a leading byte with the group order is exactly the case
// a bounds check against `n` has to get right, and getting it wrong accepts a key at or above the
// order. `issues/lang/0112`.
import { cmpBE } from "../../src/weierstrass.wac";

export i32 compareSharingAPrefix() {
  u8[] a = u8[4]();
  u8[] b = u8[4]();
  a[0] = 0xFF; b[0] = 0xFF;      // equal here: the loop must carry on
  a[1] = 0x01; b[1] = 0x02;      // and decide here
  return cmpBE(a, b);
}

export i32 compareGreater() {
  u8[] a = u8[4]();
  u8[] b = u8[4]();
  a[0] = 0xFF; b[0] = 0xFF;      // equal here too
  a[1] = 0x09; b[1] = 0x02;      // and the *other* side of the decision
  return cmpBE(a, b);
}

export i32 compareEqual() {
  u8[] a = u8[4]();
  u8[] b = u8[4]();
  a[0] = 0xAB; b[0] = 0xAB;
  a[3] = 0x07; b[3] = 0x07;
  return cmpBE(a, b);             // every byte equal: the loop runs to the end
}
