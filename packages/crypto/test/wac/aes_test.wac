// AES, and the two modes built on it, against the host and against FIPS.
//
// One file for the block cipher, CTR and GCM because the modes are the block cipher plus
// bookkeeping, and a fault in the core shows up in all three at once — testing them apart
// makes it harder to see which layer moved.
//
// `ref(mode, key, iv, aad, data)` is `node:crypto`, synchronously: ECB for a single block,
// then CTR and GCM. ECB is not a mode anyone should use and is exactly right here — it is
// the only way to ask a library for one bare block transform, which is the thing under
// test.
//
// ## What each layer can get wrong
//
//   the block     the key schedule at 192 and 256 bits, where the expansion gains an extra
//                 step that the 128-bit case does not exercise at all
//   CTR           the counter's width and where it carries. Incrementing the whole IV as
//                 one big number, rather than the last 32 or 128 bits, is right until the
//                 low word wraps
//   GCM           J0 for a nonce that is not 96 bits, which takes a different path
//                 entirely — GHASH over the nonce rather than nonce||1

import { T } from "../../../wactest/src/assert.wac";
import { Lines, check, hex } from "../../../wactest/src/oracle.wac";
import { Core, Cli } from "std/platform.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";
import { aesEncrypt, aesDecrypt } from "../../src/aes.wac";
import { aesCtr, CtrStream } from "../../src/aesctr.wac";
import { gcmEncrypt, gcmTag, gcmDecrypt, gcmInc32 } from "../../src/aesgcm.wac";
import { equal } from "../../../bytes/src/slice.wac";
import { decoded } from "../../../codec/src/hex.wac";

const i32 ECB = 0;
const i32 CTR = 1;
const i32 GCM = 2;
u8[] fill(i32 n, i32 a, i32 b) {
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = (i * a + b) & 0xFF; }
  return out;
}
u8[] cat(u8[] a, u8[] b) {
  u8[] o = u8[a.len() + b.len()]();
  for (i32 i = 0; i < a.len(); i++) { o[i] = a[i]; }
  for (i32 i = 0; i < b.len(); i++) { o[a.len() + i] = b[i]; }
  return o;
}

export string test_fips_197_worked_examples() {
  // Appendix B and C. Published values, so this is agreement with the standard rather
  // than with another implementation.
  T t = T.create();
  t.eqBytes(aesEncrypt(decoded("2b7e151628aed2a6abf7158809cf4f3c"),
                       decoded("3243f6a8885a308d313198a2e0370734")),
            decoded("3925841d02dc09fbdc118597196a0b32"), "FIPS 197 appendix B");
  t.eqBytes(aesEncrypt(decoded("000102030405060708090a0b0c0d0e0f"),
                       decoded("00112233445566778899aabbccddeeff")),
            decoded("69c4e0d86a7b0430d8cdb78070b4c55a"), "C.1, AES-128");
  t.eqBytes(aesEncrypt(decoded("000102030405060708090a0b0c0d0e0f1011121314151617"),
                       decoded("00112233445566778899aabbccddeeff")),
            decoded("dda97ca4864cdfe06eaf70a0ec0d7191"), "C.2, AES-192");
  t.eqBytes(aesEncrypt(decoded("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"),
                       decoded("00112233445566778899aabbccddeeff")),
            decoded("8ea2b7ca516745bfeafc49904b496089"), "C.3, AES-256");
  return t.report();
}

const string ORACLE = "packages/crypto/test/oracle.mjs";

/**
 * Ask node's ciphers.
 *
 * ECB is in the oracle deliberately. It is not a mode anyone should use, and it is the only way to
 * ask a library for one bare block transform — which is the thing the modes are built on and worth
 * checking independently.
 *
 * It arrived as a callback until 2026-08-17, because `harness/wacTestRun.ts` supplying a synchronous
 * host function was the only way into a wasm call. `issues/system/0161`.
 */
void checkAes(T t, Cli cli, Lines lines, string what) {
  check(t, cli, "node", string[](ORACLE), lines, what);
}

export string test_the_block_agrees_with_the_host(Core core, Cli cli) {
  // All three key sizes, because the expansion gains a step at 192 and another at 256
  // that the 128-bit path never runs.
  T t = T.create();
  Lines lines = Lines.create();
  i32[] keySizes = i32[](16, 24, 32);
  for (i32 k = 0; k < keySizes.len(); k++) {
    for (i32 i = 0; i < 8; i++) {
      u8[] key = fill(keySizes[k], 7 + i, 3);
      u8[] block = fill(16, 11 + i, 5);
      u8[] got = aesEncrypt(key, block);
      lines.add("ecb " + hex(key) + " " + hex(block) + " " + hex(got));
      t.eqBytes(aesDecrypt(key, got), block, "decryption inverts it");
    }
  }
  t.eqI32(lines.n, 24, "eight blocks at each of three key sizes");
  checkAes(t, cli, lines, "the bare block transform");
  return t.report();
}

export string test_ctr_agrees_and_the_counter_carries(Core core, Cli cli) {
  T t = T.create();
  Lines lines = Lines.create();
  i32[] keySizes = i32[](16, 24, 32);
  i32[] lens = i32[](0, 1, 15, 16, 17, 31, 32, 33, 200);
  for (i32 k = 0; k < keySizes.len(); k++) {
    u8[] key = fill(keySizes[k], 5, 1);
    u8[] iv = fill(16, 3, 9);
    for (i32 li = 0; li < lens.len(); li++) {
      u8[] data = fill(lens[li], 13, 2);
      lines.add("ctr " + hex(key) + " " + hex(iv) + " " + hex(data) + " " +
                hex(aesCtr(key, iv, data)));
    }
  }

  // The carry. An IV of all ones must wrap, and it must wrap the way the host does —
  // incrementing the counter as one 128-bit number rather than only its low word is right
  // until exactly here.
  u8[] key = fill(16, 2, 4);
  u8[] allOnes = u8[16]();
  for (i32 i = 0; i < 16; i++) { allOnes[i] = 0xFF; }
  u8[] data = fill(64, 17, 3);
  lines.add("ctr " + hex(key) + " " + hex(allOnes) + " " + hex(data) + " " +
            hex(aesCtr(key, allOnes, data)));      // wraps from an all-ones counter

  // And just below a 32-bit boundary, where a counter that carries only within the low
  // word diverges on the fifth block.
  u8[] nearWrap = u8[16]();
  for (i32 i = 12; i < 16; i++) { nearWrap[i] = 0xFF; }
  lines.add("ctr " + hex(key) + " " + hex(nearWrap) + " " + hex(data) + " " +
            hex(aesCtr(key, nearWrap, data)));     // carries out of the low word
  checkAes(t, cli, lines, "ctr and its carries");
  return t.report();
}

export string test_gcm_agrees_including_the_short_nonce_path(Core core, Cli cli) {
  // A 96-bit nonce is used directly as J0 || 1; anything else is GHASHed first, which is
  // a different code path that most callers never take and most tests never reach.
  T t = T.create();
  Lines lines = Lines.create();
  i32[] ivLens = i32[](12, 8, 16, 60);
  i32[] plainLens = i32[](0, 1, 16, 17, 64);
  i32[] aadLens = i32[](0, 1, 16, 20);
  u8[] key = fill(16, 9, 1);
  for (i32 v = 0; v < ivLens.len(); v++) {
    for (i32 p = 0; p < plainLens.len(); p++) {
      for (i32 a = 0; a < aadLens.len(); a++) {
        u8[] iv = fill(ivLens[v], 3, 7);
        u8[] plain = fill(plainLens[p], 5, 11);
        u8[] aad = fill(aadLens[a], 7, 13);
        u8[] ct = gcmEncrypt(key, iv, plain);
        u8[] tag = gcmTag(key, iv, aad, ct);
        lines.add("gcm " + hex(key) + " " + hex(iv) + " " + hex(aad) + " " + hex(plain) + " " +
                  hex(cat(ct, tag)));
      }
    }
  }
  t.eqI32(lines.n, 80, "four nonce lengths by five plaintexts by four aads");
  checkAes(t, cli, lines, "gcm including the short-nonce path");
  return t.report();
}

export string test_the_gcm_counter_wraps_at_32_bits() {
  // GCM increments only the last four bytes and never carries into the rest of J0 — a
  // deliberate difference from CTR, and one that only shows at the wrap.
  T t = T.create();
  u8[] ctr = u8[16]();
  for (i32 i = 0; i < 12; i++) { ctr[i] = 0xAA; }
  ctr[12] = 0xFF; ctr[13] = 0xFF; ctr[14] = 0xFF; ctr[15] = 0xFF;
  gcmInc32(ctr);
  bool topIntact = true;
  for (i32 i = 0; i < 12; i++) { if (ctr[i] != 0xAA) { topIntact = false; } }
  t.isTrue(topIntact, "the wrap does not touch the first twelve bytes");
  for (i32 i = 12; i < 16; i++) { t.eqI32(ctr[i], 0, "and the low word is zero"); }

  // An ordinary increment, so this is not merely testing that nothing happens.
  u8[] plain = u8[16]();
  plain[15] = 7;
  gcmInc32(plain);
  t.eqI32(plain[15], 8, "an ordinary increment advances the last byte");
  return t.report();
}

// ── CtrStream ────────────────────────────────────────────────────────────────
//
// The oracle is `aesCtr` above, which is checked against the host's AES-CTR. That matters:
// the obvious test for a resumable keystream is to encrypt with it and decrypt with it, and
// that test passes for a stream that never advances its counter at all. Two ends sharing
// one broken cipher agree with each other perfectly.
//
// So the property tested is the one that actually pins it down: a stream fed in pieces must
// produce the same bytes as the one-shot over the whole input, for every way of cutting it
// up. Nothing that mishandles the counter or the offset within a block can satisfy that.

export string test_a_ctr_stream_in_pieces_matches_the_one_shot() {
  T t = T.create();
  u8[] key = u8[16]();
  u8[] iv = u8[16]();
  for (i32 i = 0; i < 16; i++) { key[i] = (i * 13 + 1) & 0xFF; }
  for (i32 i = 0; i < 16; i++) { iv[i] = (i * 7) & 0xFF; }

  u8[] data = u8[1000]();
  for (i32 i = 0; i < 1000; i++) { data[i] = (i * 31 + 7) & 0xFF; }
  u8[] want = aesCtr(key, iv, data);

  // Chunk sizes that are not multiples of the 16-byte block, because that is the case a
  // stream keeping only a counter gets wrong. 509 is Tor's, and the reason this exists.
  i32[] sizes = i32[](1, 3, 15, 16, 17, 31, 33, 64, 100, 509);
  for (i32 s = 0; s < sizes.len(); s++) {
    i32 chunk = sizes[s];
    CtrStream cs = CtrStream.create(key, iv);
    u8[] got = u8[1000]();
    i32 pos = 0;
    while (pos < 1000) {
      i32 take = 1000 - pos < chunk ? 1000 - pos : chunk;
      u8[] piece = u8[take]();
      for (i32 i = 0; i < take; i++) { piece[i] = data[pos + i]; }
      u8[] out = cs.apply(piece);
      for (i32 i = 0; i < take; i++) { got[pos + i] = out[i]; }
      pos += take;
    }
    t.eqBytes(got, want, "fed in chunks of " + itoa64(chunk as i64));
  }
  return t.report();
}

export string test_a_ctr_stream_never_repeats_its_keystream() {
  // Directly: encrypt zeros twice and require the two outputs to differ. Encrypting zeros
  // makes the output *be* the keystream, so this is not an approximation of the property.
  T t = T.create();
  u8[] key = u8[16]();
  u8[] iv = u8[16]();
  for (i32 i = 0; i < 16; i++) { key[i] = (i * 5 + 3) & 0xFF; }

  CtrStream cs = CtrStream.create(key, iv);
  u8[] first = cs.apply(u8[509]());
  u8[] second = cs.apply(u8[509]());
  bool same = true;
  for (i32 i = 0; i < 509; i++) {
    if (first[i] != second[i]) { same = false; }
  }
  t.isTrue(!same, "the second 509 bytes of keystream differ from the first");

  // And the whole thing is the one-shot's keystream, in order — which pins down not just
  // that it moved but that it moved to the right place.
  u8[] whole = aesCtr(key, iv, u8[1018]());
  u8[] joined = u8[1018]();
  for (i32 i = 0; i < 509; i++) { joined[i] = first[i]; }
  for (i32 i = 0; i < 509; i++) { joined[509 + i] = second[i]; }
  t.eqBytes(joined, whole, "two 509-byte pulls are the first 1018 bytes of the keystream");
  return t.report();
}

// ── GCM's rejections ─────────────────────────────────────────────────────────
//
// **The half that matters.** A mode which encrypts correctly and authenticates nothing passes every
// round trip ever written, so each of these tampers with exactly one thing and requires a refusal.
//
// Host-side until 2026-08-16, on the grounds that a rejection is a `trap` and wac could not assert
// one. It unwinds this module and nothing else; `test_traps_*` is how a test says it wants one.
// `issues/system/0161`.

u8[] gcmKey() { return decoded("feffe9928665731c6d6a8f9467308308"); }
u8[] gcmIv() { return decoded("cafebabefacedbaddecaf888"); }
u8[] gcmAad() { return decoded("feedfacedeadbeeffeedfacedeadbeefabaddad2"); }

/** 97 bytes, so the last block is partial — the case a whole-block-only flaw would miss. */
u8[] gcmPlain() {
  u8[] p = u8[97]();
  for (i32 i = 0; i < 97; i++) { p[i] = (i * 29 + 11) & 0xFF; }
  return p;
}

u8[] gcmCipher() { return gcmEncrypt(gcmKey(), gcmIv(), gcmPlain()); }
u8[] gcmSeal() { return gcmTag(gcmKey(), gcmIv(), gcmAad(), gcmCipher()); }

/** A copy with one bit of byte `i` flipped. */
u8[] flipped(u8[] b, i32 i) {
  u8[] c = u8[b.len()]();
  c.copyFrom(b, 0, 0, b.len());
  c[i] = c[i] ^ 1;
  return c;
}

u8[] truncated(u8[] b, i32 n) {
  u8[] c = u8[n]();
  c.copyFrom(b, 0, 0, n);
  return c;
}

export string test_a_genuine_gcm_message_decrypts_to_the_plaintext() {
  T t = T.create();
  t.isTrue(equal(gcmDecrypt(gcmKey(), gcmIv(), gcmAad(), gcmCipher(), gcmSeal()), gcmPlain()),
           "the round trip");
  return t.report();
}

export string test_traps_on_a_flipped_ciphertext_bit() {
  gcmDecrypt(gcmKey(), gcmIv(), gcmAad(), flipped(gcmCipher(), 0), gcmSeal());
  return "";
}

/** Byte 96 is inside the final partial block, which the whole-block path never reaches. */
export string test_traps_on_a_flip_in_the_final_partial_block() {
  gcmDecrypt(gcmKey(), gcmIv(), gcmAad(), flipped(gcmCipher(), 96), gcmSeal());
  return "";
}

export string test_traps_on_modified_additional_data() {
  gcmDecrypt(gcmKey(), gcmIv(), flipped(gcmAad(), 0), gcmCipher(), gcmSeal());
  return "";
}

export string test_traps_on_a_flipped_tag_bit() {
  gcmDecrypt(gcmKey(), gcmIv(), gcmAad(), gcmCipher(), flipped(gcmSeal(), 15));
  return "";
}

export string test_traps_on_the_wrong_key() {
  gcmDecrypt(flipped(gcmKey(), 0), gcmIv(), gcmAad(), gcmCipher(), gcmSeal());
  return "";
}

export string test_traps_on_the_wrong_nonce() {
  gcmDecrypt(gcmKey(), flipped(gcmIv(), 0), gcmAad(), gcmCipher(), gcmSeal());
  return "";
}

export string test_traps_on_a_truncated_ciphertext() {
  gcmDecrypt(gcmKey(), gcmIv(), gcmAad(), truncated(gcmCipher(), 96), gcmSeal());
  return "";
}

export string test_traps_on_a_short_tag() {
  gcmDecrypt(gcmKey(), gcmIv(), gcmAad(), gcmCipher(), truncated(gcmSeal(), 15));
  return "";
}

/**
 * A tag whose **first sixteen bytes are valid** and which is longer than sixteen.
 *
 * A comparison that stopped at the tag's own length would accept this, and a peer could then append
 * anything it liked to a valid tag.
 */
export string test_traps_on_an_over_long_tag_with_a_valid_prefix() {
  u8[] padded = u8[18]();
  padded.copyFrom(gcmSeal(), 0, 0, 16);
  padded[16] = 0xAA;
  padded[17] = 0xAA;
  gcmDecrypt(gcmKey(), gcmIv(), gcmAad(), gcmCipher(), padded);
  return "";
}

export string test_traps_encrypting_with_an_empty_iv() {
  gcmEncrypt(gcmKey(), u8[0](), gcmPlain());
  return "";
}

/** And `gcmTag` refuses it too, not only `gcmEncrypt` — two entry points, two guards. */
export string test_traps_tagging_with_an_empty_iv() {
  gcmTag(gcmKey(), u8[0](), u8[0](), decoded("42831ec2217774244b7221b784d0d49c"));
  return "";
}

/**
 * The boundary between additional data and ciphertext is itself authenticated.
 *
 * Splitting the same eight bytes 3/5 and 5/3 must not give the same tag. GHASH feeds both through
 * one hash, so a length that was not bound in would let a peer move the boundary and keep the tag.
 */
export string test_the_aad_ciphertext_boundary_is_authenticated() {
  T t = T.create();
  u8[] all = u8[](1, 2, 3, 4, 5, 6, 7, 8);
  u8[] aadA = u8[3](); aadA.copyFrom(all, 0, 0, 3);
  u8[] ctA = u8[5](); ctA.copyFrom(all, 3, 0, 5);
  u8[] aadB = u8[5](); aadB.copyFrom(all, 0, 0, 5);
  u8[] ctB = u8[3](); ctB.copyFrom(all, 5, 0, 3);
  t.isFalse(equal(gcmTag(gcmKey(), gcmIv(), aadA, ctA), gcmTag(gcmKey(), gcmIv(), aadB, ctB)),
            "3/5 and 5/3 splits of the same bytes");
  return t.report();
}

// ── the key-length refusal ───────────────────────────────────────────────────
//
// **It matters more than it looks.** AES-128, 192 and 256 differ only in the key schedule, so a
// length the expansion does not recognise would otherwise run some number of rounds and produce
// ciphertext nobody can decrypt.
//
// Host-side until 2026-08-17, because a trap ends the call and a returning test cannot observe one.
// `test_traps_*` is what lets a test say it wants one — and one trap per test is why eight lengths
// are eight exports rather than a loop over a table. `issues/system/0164` records the wish for the
// shorter spelling; this is what it costs meanwhile.

export string test_traps_on_an_empty_key() {
  aesEncrypt(u8[0](), u8[16]());
  return "FAIL: a 0-byte key was accepted";
}

export string test_traps_on_a_one_byte_key() {
  aesEncrypt(u8[1](), u8[16]());
  return "FAIL: a 1-byte key was accepted";
}

export string test_traps_one_byte_below_aes128() {
  aesEncrypt(u8[15](), u8[16]());
  return "FAIL: a 15-byte key was accepted";
}

export string test_traps_one_byte_above_aes128() {
  aesEncrypt(u8[17](), u8[16]());
  return "FAIL: a 17-byte key was accepted";
}

/** Between 128 and 192, which is the gap a length check written as `>= 16` would let through. */
export string test_traps_between_aes128_and_aes192() {
  aesEncrypt(u8[20](), u8[16]());
  return "FAIL: a 20-byte key was accepted";
}

export string test_traps_one_byte_below_aes256() {
  aesEncrypt(u8[31](), u8[16]());
  return "FAIL: a 31-byte key was accepted";
}

export string test_traps_one_byte_above_aes256() {
  aesEncrypt(u8[33](), u8[16]());
  return "FAIL: a 33-byte key was accepted";
}

/** Well past every supported size, so a check that only guarded the neighbourhood is caught. */
export string test_traps_on_a_sixty_four_byte_key() {
  aesEncrypt(u8[64](), u8[16]());
  return "FAIL: a 64-byte key was accepted";
}
