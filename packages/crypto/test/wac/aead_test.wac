// Poly1305 and ChaCha20-Poly1305, against RFC 8439 and against the host's AEAD.
//
// One file, because Poly1305 exists here to be the AEAD's authenticator and its faults
// only matter through that. The oracle is `node:crypto`'s chacha20-poly1305 — a whole
// AEAD rather than a primitive this time, and deliberately: what the construction adds on
// top of its two parts is the framing, and the framing is precisely what an independent
// implementation of the *same* construction disagrees with you about if you get it wrong.
//
// ## The framing is the interesting part
//
// RFC 8439 §2.8 authenticates the AAD and the ciphertext, each padded to a multiple of
// sixteen, followed by their two lengths as 64-bit little-endian counts. Those trailing
// lengths are the whole reason a byte cannot be moved from the AAD into the ciphertext:
// without them, `aad="ab", ct="cd"` and `aad="a", ct="bcd"` authenticate identically.
// A round trip never notices, because both sides make the same mistake.

import { T } from "../../../wactest/src/assert.wac";
import { Lines, Answers, askDeno, ask, check, hex, word } from "../../../wactest/src/oracle.wac";
import { Core, Cli } from "std/platform.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";
import { poly1305 } from "../../src/poly1305.wac";
import { aeadDecrypt, aeadEncrypt, aeadTag } from "../../src/aead.wac";
import { equal } from "../../../bytes/src/slice.wac";
import { decoded } from "../../../codec/src/hex.wac";
u8[] fill(i32 n, i32 a, i32 b) {
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = (i * a + b) & 0xFF; }
  return out;
}
u8[] cat(u8[] a, u8[] b) {
  u8[] o = u8[a.len() + b.len()]();
  for (i32 i = 0; i < a.len(); i++) { o[i] = a[i]; }
  for (i32 i = 0; i < b.len(); i++) { o[a.len() + i] = b[i]; }
  return o;
}

u8[] aeadKey() {
  return decoded("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f");
}

export string test_rfc_8439_poly1305() {
  T t = T.create();
  t.eqBytes(poly1305(decoded("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b"),
                     "Cryptographic Forum Research Group".toBytes()),
            decoded("a8061dc1305136c6c22b8baf0c0127a9"),
            "RFC 8439 section 2.5.2");
  return t.report();
}

export string test_poly1305_forced_carries() {
  // The modulus is 2^130 - 5, so the accumulator sits just under a power of two and the
  // reduction is where this goes wrong. An all-ones key and an all-ones message push the
  // accumulator over the boundary on every block, which is the case a random test never
  // reaches. No expected value: the assertion is that it produces sixteen bytes without
  // trapping and that the result depends on the message, which a reduction that
  // overflowed would break loudly.
  T t = T.create();
  u8[] ones = u8[32]();
  for (i32 i = 0; i < 32; i++) { ones[i] = 0xFF; }
  u8[] msgA = u8[64]();
  for (i32 i = 0; i < 64; i++) { msgA[i] = 0xFF; }
  u8[] msgB = u8[64]();
  for (i32 i = 0; i < 64; i++) { msgB[i] = 0xFF; }
  msgB[63] = 0xFE;
  u8[] tagA = poly1305(ones, msgA);
  u8[] tagB = poly1305(ones, msgB);
  t.eqI32(tagA.len(), 16, "an all-ones key still produces a tag");
  t.isFalse(equal(tagA, tagB), "and one bit of the message changes it");

  // r is clamped, so a key differing only in the clamped-away bits must give the same
  // tag. That is a property of the spec rather than of our arithmetic, and it is the
  // one an implementation that forgot to clamp fails.
  u8[] k1 = fill(32, 7, 3);
  u8[] k2 = u8[32]();
  for (i32 i = 0; i < 32; i++) { k2[i] = k1[i]; }
  k2[3] = k2[3] | 0xF0;      // top four bits of r's second word: clamped away
  k2[7] = k2[7] | 0xF0;
  k2[11] = k2[11] | 0xF0;
  k2[15] = k2[15] | 0xF0;
  u8[] m = "clamping is part of the definition".toBytes();
  t.eqBytes(poly1305(k1, m), poly1305(k2, m), "the clamped bits of r do not matter");
  return t.report();
}

const string ORACLE = "packages/crypto/test/oracle.mjs";

/** Ask node's ChaCha20-Poly1305 — `chacha` judges a seal, `open` answers about bytes we did not. */
Answers askAead(T t, Cli cli, Lines lines, string what) {
  return ask(t, cli, "node", string[](ORACLE), lines, what);
}

/** A `chacha` claim: the sealed output we say these inputs produce. */
void claimSeal(Lines lines, u8[] key, u8[] nonce, u8[] aad, u8[] plain, u8[] sealed) {
  lines.add("chacha " + hex(key) + " " + hex(nonce) + " " + hex(aad) + " " + hex(plain) + " " +
            hex(sealed));
}

export string test_rfc_8439_aead(Core core, Cli cli) {
  // §2.8.2's worked example, then the same inputs through the host.
  T t = T.create();
  u8[] key = aeadKey();
  u8[] nonce = decoded("070000004041424344454647");
  u8[] aad = decoded("50515253c0c1c2c3c4c5c6c7");
  string plainText = "Ladies and Gentlemen of the class of '99: If I could offer you " +
                     "only one tip for the future, sunscreen would be it.";
  u8[] plain = plainText.toBytes();

  u8[] ct = aeadEncrypt(key, nonce, plain);
  t.eqBytes(ct,
            decoded("d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d6" +
                  "3dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b36" +
                  "92ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc" +
                  "3ff4def08e4b7a9de576d26586cec64b6116"),
            "RFC 8439 2.8.2 ciphertext");
  t.eqBytes(aeadTag(key, nonce, aad, ct), decoded("1ae10b594f09e26a7e902ecbd0600691"),
            "RFC 8439 2.8.2 tag");

  // And the host, which agrees only if the framing matches too.
  Lines lines = Lines.create();
  claimSeal(lines, key, nonce, aad, plain, cat(ct, aeadTag(key, nonce, aad, ct)));
  askAead(t, cli, lines, "the host seals the same bytes");
  return t.report();
}

export string test_the_length_fields_stop_a_block_moving(Core core, Cli cli) {
  // The property the two trailing counts exist for, and it takes a whole block to expose.
  //
  // Moving a *byte* between the fields changes the padded content, so padding alone
  // catches it — I wrote that test first and it passed with the length fields zeroed,
  // which means it was testing padding and not the lengths. Moving a whole sixteen-byte
  // block does not: `aad=A(16), ct=C(16)` and `aad=(), ct=A||C(32)` authenticate exactly
  // the same 32 bytes with exactly the same padding, so only the counts tell them apart.
  T t = T.create();
  u8[] key = aeadKey();
  u8[] nonce = decoded("070000004041424344454647");
  u8[] a = fill(16, 3, 1);
  u8[] c = fill(16, 5, 9);

  u8[] split = aeadTag(key, nonce, a, c);          // aad = 16, ct = 16
  u8[] joined = aeadTag(key, nonce, u8[0](), cat(a, c));   // aad = 0, ct = 32
  t.isFalse(equal(split, joined),
            "a 16-byte block moved from the aad into the ciphertext changes the tag");

  // The host agrees about which of the two is which, so this is not just our own opinion.
  // `c` is arbitrary bytes rather than a real ciphertext, so what comes back is its
  // decryption and not `c` itself — the assertion is that the tag verifies at all, which a
  // refusal would deny. This is the one place in this package that asks the oracle for an answer
  // rather than handing it one: the bytes were not sealed by us, so there is nothing to claim.
  Lines lines = Lines.create();
  lines.add("open " + hex(key) + " " + hex(nonce) + " " + hex(a) + " " + hex(cat(c, split)));
  lines.add("open " + hex(key) + " " + hex(nonce) + " " + hex(u8[0]()) + " " +
            hex(cat(cat(a, c), split)));
  Answers r = askAead(t, cli, lines, "the two framings");
  if (!r.ok) { return t.report(); }
  t.eqI32(word(r.lines[0], 1).len(), 32, "the host accepts the split framing");
  t.eqStr(word(r.lines[1], 1), "-", "and rejects the same bytes framed the other way");
  return t.report();
}

export string test_the_tag_covers_everything(Core core, Cli cli) {
  // Every input must move the tag, and the host must agree at every length — including
  // the empty cases, where a construction that skipped padding for a zero-length field
  // diverges from one that pads it to a full block of nothing.
  T t = T.create();
  Lines lines = Lines.create();
  u8[] key = aeadKey();
  u8[] nonce = decoded("070000004041424344454647");
  i32[] plainLens = i32[](0, 1, 15, 16, 17, 63, 64, 65);
  i32[] aadLens = i32[](0, 1, 15, 16, 17);
  for (i32 p = 0; p < plainLens.len(); p++) {
    for (i32 a = 0; a < aadLens.len(); a++) {
      u8[] plain = fill(plainLens[p], 5, 2);
      u8[] aad = fill(aadLens[a], 11, 7);
      u8[] ct = aeadEncrypt(key, nonce, plain);
      u8[] tag = aeadTag(key, nonce, aad, ct);
      claimSeal(lines, key, nonce, aad, plain, cat(ct, tag));
    }
  }
  t.eqI32(lines.n, 40, "eight plaintext lengths by five aad lengths");
  askAead(t, cli, lines, "the tag at every length");
  return t.report();
}

// ── every tampering is rejected ──────────────────────────────────────────────
//
// An AEAD that encrypts correctly and authenticates nothing passes every round-trip test ever
// written, so this is the half that matters. Host-side until 2026-08-17, because a failed tag traps
// and a returning test cannot observe one; `test_traps_*` is what lets a test say it wants one.
//
// **Eleven exports for eleven attacks**, not eleven values of one rule — each names a different way
// a forgery could get through, which is what makes the list readable as a threat model rather than
// as a table. `issues/system/0164` is about the other shape, where the name has to carry a number.

/** RFC 8439 §2.8.2's nonce, associated data and plaintext — the key is `aeadKey` above. */
u8[] aeadNonce() { return decoded("070000004041424344454647"); }
u8[] aeadAad() { return decoded("50515253c0c1c2c3c4c5c6c7"); }
u8[] aeadPlain() {
  return ("Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the " +
          "future, sunscreen would be it.").toBytes();
}

u8[] aeadCt() { return aeadEncrypt(aeadKey(), aeadNonce(), aeadPlain()); }
u8[] aeadGoodTag() { return aeadTag(aeadKey(), aeadNonce(), aeadAad(), aeadCt()); }

/** A copy with bit 0 of byte `i` flipped. */
u8[] flipped(u8[] b, i32 i) {
  u8[] out = u8[b.len()]();
  for (i32 k = 0; k < b.len(); k++) { out[k] = b[k]; }
  out[i] = out[i] ^ 1;
  return out;
}

u8[] head(u8[] b, i32 n) {
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = b[i]; }
  return out;
}

export string test_traps_on_a_flipped_first_ciphertext_bit() {
  aeadDecrypt(aeadKey(), aeadNonce(), aeadAad(), flipped(aeadCt(), 0), aeadGoodTag());
  return "FAIL: accepted a flipped first ciphertext bit";
}

export string test_traps_on_a_flipped_last_ciphertext_bit() {
  u8[] ct = aeadCt();
  aeadDecrypt(aeadKey(), aeadNonce(), aeadAad(), flipped(ct, ct.len() - 1), aeadGoodTag());
  return "FAIL: accepted a flipped last ciphertext bit";
}

export string test_traps_on_modified_associated_data() {
  aeadDecrypt(aeadKey(), aeadNonce(), flipped(aeadAad(), 0), aeadCt(), aeadGoodTag());
  return "FAIL: accepted modified associated data";
}

export string test_traps_on_a_flipped_tag_bit() {
  aeadDecrypt(aeadKey(), aeadNonce(), aeadAad(), aeadCt(), flipped(aeadGoodTag(), 15));
  return "FAIL: accepted a flipped tag bit";
}

export string test_traps_on_the_wrong_key() {
  aeadDecrypt(flipped(aeadKey(), 0), aeadNonce(), aeadAad(), aeadCt(), aeadGoodTag());
  return "FAIL: accepted the wrong key";
}

export string test_traps_on_the_wrong_nonce() {
  aeadDecrypt(aeadKey(), flipped(aeadNonce(), 0), aeadAad(), aeadCt(), aeadGoodTag());
  return "FAIL: accepted the wrong nonce";
}

export string test_traps_on_a_short_tag() {
  aeadDecrypt(aeadKey(), aeadNonce(), aeadAad(), aeadCt(), head(aeadGoodTag(), 15));
  return "FAIL: accepted a 15-byte tag";
}

/**
 * A tag that is too *long*, which is where the length check earns its keep — and nothing tested it.
 *
 * A short tag traps either way, because the comparison loop reads past the end, so the short case
 * exercised the check without testing it. A long tag does not: the loop compares the first sixteen
 * bytes, finds them correct, and returns the plaintext. **Anyone holding a valid tag could append
 * arbitrary bytes and still verify.** Mutation testing found this; deleting the check failed no test.
 */
u8[] paddedTag(i32 extra) {
  u8[] good = aeadGoodTag();
  u8[] out = u8[16 + extra]();
  for (i32 i = 0; i < 16; i++) { out[i] = good[i]; }
  for (i32 i = 16; i < out.len(); i++) { out[i] = 0xAA; }
  return out;
}

export string test_traps_on_a_seventeen_byte_tag() {
  aeadDecrypt(aeadKey(), aeadNonce(), aeadAad(), aeadCt(), paddedTag(1));
  return "FAIL: accepted a 17-byte tag whose first 16 bytes are valid";
}

export string test_traps_on_an_eighteen_byte_tag() {
  aeadDecrypt(aeadKey(), aeadNonce(), aeadAad(), aeadCt(), paddedTag(2));
  return "FAIL: accepted an 18-byte tag whose first 16 bytes are valid";
}

export string test_traps_on_a_double_length_tag() {
  aeadDecrypt(aeadKey(), aeadNonce(), aeadAad(), aeadCt(), paddedTag(16));
  return "FAIL: accepted a 32-byte tag whose first 16 bytes are valid";
}

/** Truncating the ciphertext changes the length field inside the MAC input. */
export string test_traps_on_a_truncated_ciphertext() {
  u8[] ct = aeadCt();
  aeadDecrypt(aeadKey(), aeadNonce(), aeadAad(), head(ct, ct.len() - 1), aeadGoodTag());
  return "FAIL: accepted a truncated ciphertext";
}

// ── Poly1305 on its own, against a BigInt reference ──────────────────────────
//
// Host-side until 2026-08-17, `issues/system/0161`. The reference has nowhere else to live:
// `node:crypto` exposes ChaCha20-Poly1305 but not the bare MAC, and WebCrypto has neither — so
// `test/oracle.mjs` carries a from-scratch BigInt implementation of RFC 8439 §2.5. Reimplementing
// 130-bit arithmetic in wac beside the thing under test is how a differential stops being one.
//
// Both sweeps compute every tag here and hand the whole batch over once; the oracle reports only
// what it disagrees with.

const string CRYPTO_ORACLE = "packages/crypto/test/oracle.mjs";

/** An LCG, so the fuzz corpus is the same on every run and a failure can be looked at again. */
struct Rng {
  i32 s;
  i32 next(this) {
    this.s = (this.s * 1103515245 + 12345) & 0x7FFFFFFF;
    return this.s;
  }
  u8[] bytes(this, i32 n) {
    u8[] o = u8[n]();
    for (i32 i = 0; i < n; i++) { o[i] = (this.next() >> 11) & 0xFF; }
    return o;
  }
}

void claim(Lines lines, u8[] key, u8[] msg) {
  lines.add("poly1305 " + hex(key) + " " + hex(msg) + " " + hex(poly1305(key, msg)));
}

export string test_poly1305_agrees_with_the_reference_at_every_length_to_three_blocks(
    Core core, Cli cli) {
  T t = T.create();
  u8[] key = decoded("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b");
  Lines lines = Lines.create();
  for (i32 n = 0; n <= 49; n++) {
    u8[] m = u8[n]();
    for (i32 i = 0; i < n; i++) { m[i] = (i * 53 + 17) & 0xFF; }
    claim(lines, key, m);
  }
  check(t, cli, "node", string[](CRYPTO_ORACLE), lines, "every length to three blocks");
  return t.report();
}

export string test_poly1305_agrees_with_the_reference_under_fuzzing(Core core, Cli cli) {
  T t = T.create();
  Rng rng = Rng(0x1E3779B9);   // the golden-ratio constant, with the top bit cleared for i32
  Lines lines = Lines.create();
  for (i32 k = 0; k < 400; k++) {
    u8[] key = rng.bytes(32);
    claim(lines, key, rng.bytes(rng.next() % 300));
  }

  // Saturated inputs, where carries propagate the whole way and the final subtract triggers — the
  // cases random bytes almost never reach.
  i32[] lens = i32[](16, 32, 48, 64, 100);
  for (i32 i = 0; i < lens.len(); i++) {
    u8[] key = u8[32]();
    for (i32 j = 0; j < 32; j++) { key[j] = 0xFF; }
    u8[] msg = u8[lens[i]]();
    for (i32 j = 0; j < lens[i]; j++) { msg[j] = 0xFF; }
    claim(lines, key, msg);
  }
  check(t, cli, "node", string[](CRYPTO_ORACLE), lines, "400 fuzz cases and five saturated ones");
  return t.report();
}
