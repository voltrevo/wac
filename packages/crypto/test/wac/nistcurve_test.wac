// NIST P-256 and P-384, against node:crypto.
//
// One file, because since the generalisation the two curves are one implementation: the
// same Jacobian formulas in weierstrass.wac over the same Solinas reduction in fieldp.wac,
// which reads its prime off the operand's limb count. Testing them together is testing
// that the generalisation holds, which is the thing most likely to be wrong.
//
// `test/oracle.mjs` is node's ECDSA, with the signature converted between DER and raw r||s at the
// boundary — X.509 and TLS both carry DER, the crypto layer wants raw, and the conversion is the
// oracle's job because it is where the two conventions meet.
//
// **Three of its ops answer rather than judge**, which is unusual here and unavoidable: ECDSA is
// randomised, so there is nothing to claim about a signature until the host has produced one, and
// node has no "scalar to point" call so it must pick the key too. `ecgensign` does both in one go,
// because a signature needs the key the host just chose. Host-side until 2026-08-17,
// `issues/system/0161`.
//
// ## What each direction is worth
//
// ECDSA is randomised, so unlike Ed25519 there is no byte-identity to compare. Verifying
// node's signature and having node verify ours are therefore *both* needed: the first
// checks the verifier, the second checks the signer, and an implementation can be right
// about one and wrong about the other without either noticing.

import { T } from "../../../wactest/src/assert.wac";
import { Lines, Answers, ask, hex, word } from "../../../wactest/src/oracle.wac";
import { Core, Cli } from "std/platform.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";
import { p256Verify, p256VerifyDigest, p256Sign, p256PublicKey, p256Ecdh, p256Order, p256ScalarBase,
         p256Reencode } from "../../src/p256.wac";
import { p384Verify, p384VerifyDigest, p384Order } from "../../src/p384.wac";
import { sha256 } from "../../src/sha256.wac";
import { equal } from "../../../bytes/src/slice.wac";
import { decoded as decodedHex } from "../../../codec/src/hex.wac";
import { check } from "../../../wactest/src/oracle.wac";
import { fpAdd, fpSub, fpMul, fpSquare, fpNeg, fpInvert, fpToBytes, fpFromBytes, fpOne,
         fpIsZero, fpEquals } from "../../src/fieldp.wac";

const i32 SIGN = 0;
const i32 VERIFY = 1;
const i32 PUBKEY = 2;
const i32 P256 = 256;
const i32 P384 = 384;

u8[] fill(i32 n, i32 seed) {
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = (i * 41 + seed * 7 + 13) & 0xFF; }
  // Keep it well inside the group order: the top byte cleared is enough for both curves.
  out[0] = out[0] & 0x7F;
  return out;
}
u8[] cat(u8[] a, u8[] b) {
  u8[] o = u8[a.len() + b.len()]();
  for (i32 i = 0; i < a.len(); i++) { o[i] = a[i]; }
  for (i32 i = 0; i < b.len(); i++) { o[a.len() + i] = b[i]; }
  return o;
}

export string test_the_group_orders() {
  // Not our own arithmetic — the published constants, so a transposed digit shows here
  // rather than as a signature that verifies almost always.
  T t = T.create();
  t.eqI32(p256Order().len(), 32, "P-256's order is 32 bytes");
  t.eqI32(p384Order().len(), 48, "P-384's order is 48 bytes");
  t.eqI32(p256Order()[0], 0xFF, "P-256's order starts 0xFF");
  t.eqI32(p256Order()[31], 0x51, "and ends 0x51");
  t.eqI32(p384Order()[47], 0x73, "P-384's order ends 0x73");
  return t.report();
}

const string ORACLE = "packages/crypto/test/oracle.mjs";

Answers askEc(T t, Cli cli, Lines lines, string what) {
  return ask(t, cli, "node", string[](ORACLE), lines, what);
}

/** The scalar and point of an `ecgen`/`ecgensign` answer. */
u8[] scalarOf(string line) { return decodedHex(word(line, 1)); }
u8[] pointOf(string line) { return decodedHex(word(line, 2)); }
u8[] sigOf(string line) { return decodedHex(word(line, 3)); }

export string test_public_keys_match_the_host(Core core, Cli cli) {
  // The host picks the key and returns scalar || point; we must reproduce the point. That
  // is the stronger direction — the scalar is not one we chose, so it exercises whatever
  // the generator happens to produce rather than whatever a test author would write.
  T t = T.create();
  Lines lines = Lines.create();
  for (i32 i = 0; i < 8; i++) { lines.add("ecgen 256"); }
  Answers a = askEc(t, cli, lines, "eight P-256 keypairs");
  if (!a.ok) { return t.report(); }
  for (i32 i = 0; i < 8; i++) {
    t.eqBytes(p256PublicKey(scalarOf(a.lines[i])), pointOf(a.lines[i]),
              "P-256 public key " + itoa64(i as i64));
  }
  return t.report();
}

export string test_we_verify_the_hosts_signatures(Core core, Cli cli) {
  // The verifier. node signs with a key it chose, and we must accept it — and must refuse
  // it once a bit moves, or "accepts everything" would pass the first half.
  T t = T.create();
  Lines lines = Lines.create();
  for (i32 i = 0; i < 6; i++) { lines.add("ecgensign 256 " + hex(fill(20 + i, i))); }
  Answers a = askEc(t, cli, lines, "six signed P-256 keypairs");
  if (!a.ok) { return t.report(); }
  for (i32 i = 0; i < 6; i++) {
    u8[] pub = pointOf(a.lines[i]);
    u8[] sig = sigOf(a.lines[i]);
    u8[] msg = fill(20 + i, i);
    t.isTrue(p256Verify(pub, msg, sig), "P-256 accepts the host's signature " + itoa64(i as i64));

    u8[] bad = u8[64]();
    for (i32 j = 0; j < 64; j++) { bad[j] = sig[j]; }
    bad[i % 64] = bad[i % 64] ^ 1;
    t.isFalse(p256Verify(pub, msg, bad), "and refuses it altered " + itoa64(i as i64));
  }
  return t.report();
}

export string test_the_host_verifies_ours(Core core, Cli cli) {
  // The signer, which is a different claim. ECDSA is randomised so there is no byte
  // identity to compare against — an implementation that produced a self-consistent but
  // non-standard signature would verify against itself forever.
  // Two rounds, because the key has to exist before we can sign with it: the host picks six, and
  // then judges the six signatures we made from them.
  T t = T.create();
  Lines gen = Lines.create();
  for (i32 i = 0; i < 6; i++) { gen.add("ecgen 256"); }
  Answers keys = askEc(t, cli, gen, "six P-256 keypairs");
  if (!keys.ok) { return t.report(); }

  Lines lines = Lines.create();
  for (i32 i = 0; i < 6; i++) {
    u8[] priv = scalarOf(keys.lines[i]);
    u8[] pub = p256PublicKey(priv);
    u8[] msg = fill(30 + i, i + 5);
    u8[] k = fill(32, i + 77);
    u8[] sig = p256Sign(priv, msg, k);
    t.eqI32(sig.len(), 64, "signing produced a signature at round " + itoa64(i as i64));
    lines.add("ecverify 256 " + hex(pub) + " " + hex(sig) + " " + hex(msg) + " 1");
  }
  askEc(t, cli, lines, "the host verifies ours");
  return t.report();
}

export string test_p384_verifies_the_hosts_signatures(Core core, Cli cli) {
  // The whole point of the generalisation: twelve limbs behaving as eight do. P-384 is
  // verification-only here, so this is the only direction available.
  T t = T.create();
  Lines gen = Lines.create();
  for (i32 i = 0; i < 5; i++) { gen.add("ecgensign 384 " + hex(fill(40 + i, i + 9))); }
  Answers a = askEc(t, cli, gen, "five signed P-384 keypairs");
  if (!a.ok) { return t.report(); }
  for (i32 i = 0; i < 5; i++) {
    u8[] pub = pointOf(a.lines[i]);
    t.eqI32(pub.len(), 97, "P-384 public key is an uncompressed point");
    u8[] msg = fill(40 + i, i + 9);
    u8[] sig = sigOf(a.lines[i]);
    t.eqI32(sig.len(), 96, "P-384 signature is 96 bytes");
    t.isTrue(p384Verify(pub, msg, sig), "P-384 accepts the host's signature " + itoa64(i as i64));

    u8[] bad = u8[96]();
    for (i32 j = 0; j < 96; j++) { bad[j] = sig[j]; }
    bad[(i * 7) % 96] = bad[(i * 7) % 96] ^ 1;
    t.isFalse(p384Verify(pub, msg, bad), "and refuses it altered " + itoa64(i as i64));
  }
  return t.report();
}

export string test_ecdh_agrees_from_both_ends() {
  // No oracle needed: the whole claim is that two parties reach the same value from
  // opposite directions, which is a relation between our own outputs.
  T t = T.create();
  for (i32 i = 0; i < 5; i++) {
    u8[] a = fill(32, i + 41);
    u8[] b = fill(32, i + 51);
    u8[] shared = p256Ecdh(a, p256PublicKey(b));
    t.eqBytes(shared, p256Ecdh(b, p256PublicKey(a)), "both ends agree " + itoa64(i as i64));
    t.eqI32(shared.len(), 32, "the secret is the x-coordinate alone");
    t.isFalse(equal(shared, p256Ecdh(a, p256PublicKey(fill(32, i + 61)))),
              "and a different peer gives a different secret");
  }
  return t.report();
}

export string test_signatures_outside_the_group_order_are_refused() {
  // r and s must each lie in [1, n). Zero and n itself are the boundaries, and accepting
  // either makes forgery arithmetic rather than work — this returns false rather than
  // trapping, so it belongs here rather than in the host file.
  T t = T.create();
  u8[] priv = fill(32, 91);
  u8[] pub = p256PublicKey(priv);
  u8[] msg = "range checks".toBytes();
  u8[] sig = p256Sign(priv, msg, fill(32, 92));
  t.isTrue(p256Verify(pub, msg, sig), "the genuine signature verifies");

  u8[] n = p256Order();
  u8[] zeroR = u8[64]();
  for (i32 i = 0; i < 64; i++) { zeroR[i] = sig[i]; }
  for (i32 i = 0; i < 32; i++) { zeroR[i] = 0; }
  t.isFalse(p256Verify(pub, msg, zeroR), "r = 0 is refused");

  u8[] zeroS = u8[64]();
  for (i32 i = 0; i < 64; i++) { zeroS[i] = sig[i]; }
  for (i32 i = 32; i < 64; i++) { zeroS[i] = 0; }
  t.isFalse(p256Verify(pub, msg, zeroS), "s = 0 is refused");

  u8[] rAtN = u8[64]();
  for (i32 i = 0; i < 64; i++) { rAtN[i] = sig[i]; }
  for (i32 i = 0; i < 32; i++) { rAtN[i] = n[i]; }
  t.isFalse(p256Verify(pub, msg, rAtN), "r = n is refused");

  u8[] sAtN = u8[64]();
  for (i32 i = 0; i < 64; i++) { sAtN[i] = sig[i]; }
  for (i32 i = 0; i < 32; i++) { sAtN[32 + i] = n[i]; }
  t.isFalse(p256Verify(pub, msg, sAtN), "s = n is refused");

  t.isFalse(p256Verify(pub, msg, u8[63]()), "a 63-byte signature is refused");
  return t.report();
}

// ── The fields, against BigInt ───────────────────────────────────────────────
//
// Host-side until 2026-08-17, `issues/system/0161`. The same lesson `field25519_test.wac` records:
// a non-canonical representative is congruent, so it satisfies every relation the field can state
// about itself, and only an outside reference sees that the representative is wrong while the value
// it stands for is right.
//
// Both curves in one sweep, because `fieldp.wac` reads its prime off the operand's limb count —
// which is exactly the generalisation most likely to be wrong, and a corpus that ran one width at a
// time could not see a table indexed from the wrong one.

const string CRYPTO_ORACLE = "packages/crypto/test/oracle.mjs";

/** A deterministic spread, so a failure reproduces exactly. */
struct FieldRng {
  i64 s;
  FieldRng create(i64 seed) { return FieldRng(seed); }
  u8[] bytes(this, i32 n) {
    u8[] o = u8[n]();
    for (i32 i = 0; i < n; i++) {
      this.s = (this.s * 6364136223846793005 + 1442695040888963407);
      o[i] = ((this.s >> 33) & 255) as! i32;
    }
    return o;
  }
}

/**
 * Boundary-weighted values at `width` bytes: the reduction's interesting cases are all at the edges.
 *
 * The powers of 2^32 are the ones the Solinas reduction is built from — if a word of that table is
 * in the wrong place, one of these lands on it. They are written as bit positions rather than hex
 * so the same list serves both widths.
 */
u8[][] fieldCorpus(i32 width, string[] edges) {
  i32[] bits = i32[](32, 64, 96, 128, 160, 192, 224, 255);
  u8[][] out = u8[][3 + edges.len() + bits.len() * 2 + 60]();
  i32 at = 0;

  // Zero, one, two, then p-1, p-2 and (p-1)/2 — the caller passes those, because they are the one
  // part of the corpus that is not the same shape at both widths.
  //
  // **Every value here is below p.** `fpFromBytes` reads a canonical encoding and does not reduce,
  // so a corpus entry at or above p is not a field element at all: it produces a representation the
  // reference has no way to agree with, and the first attempt at this file was six failures for
  // exactly that reason. `fpInRange` is the function that says whether bytes off the wire qualify,
  // and it is tested by the refusals rather than here.
  out[at] = u8[width](); at = at + 1;
  out[at] = oneAt(width, 0); at = at + 1;
  out[at] = oneAt(width, 1); at = at + 1;
  for (i32 i = 0; i < edges.len(); i++) { out[at] = decodedHex(edges[i]); at = at + 1; }

  for (i32 i = 0; i < bits.len(); i++) {
    out[at] = powerOfTwo(width, bits[i]); at = at + 1;
    out[at] = powerOfTwoLess(width, bits[i]); at = at + 1;
  }

  FieldRng rng = FieldRng.create(0x1E3779B9);
  for (i32 i = 0; i < 60; i++) {
    u8[] v = rng.bytes(width);
    v[0] = v[0] & 0x7F;      // below 2^(8w-1), and so below p for both curves
    out[at] = v;
    at = at + 1;
  }
  return out;
}

/** p-1, p-2 and (p-1)/2 for each curve, which have no short form. */
string[] edgesFor(string curve) {
  if (curve == "p256") {
    return string[](
      "ffffffff00000001000000000000000000000000fffffffffffffffffffffffe",
      "ffffffff00000001000000000000000000000000fffffffffffffffffffffffd",
      "7fffffff800000008000000000000000000000007fffffffffffffffffffffff");
  }
  return string[](
    "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe" +
      "ffffffff0000000000000000fffffffe",
    "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe" +
      "ffffffff0000000000000000fffffffd",
    "7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" +
      "7fffffff80000000000000007fffffff");
}

/** `1 << bit`, big-endian in `width` bytes. */
u8[] powerOfTwo(i32 width, i32 bit) {
  u8[] o = u8[width]();
  i32 idx = width - 1 - bit / 8;
  if (idx >= 0) { o[idx] = 1 << (bit % 8); }
  return o;
}

/** `(1 << bit) - 1`, which is where a reduction that is off by one word shows up. */
u8[] powerOfTwoLess(i32 width, i32 bit) {
  u8[] o = u8[width]();
  for (i32 b = 0; b < bit; b++) {
    i32 idx = width - 1 - b / 8;
    if (idx >= 0) { o[idx] = o[idx] | (1 << (b % 8)); }
  }
  return o;
}

u8[] oneAt(i32 width, i32 v) {
  u8[] o = u8[width]();
  o[width - 1] = v + 1;
  return o;
}

void claimFp(Lines lines, string curve, string what, u8[] a, u8[] b, u8[] got) {
  lines.add("fp " + curve + " " + what + " " + hex(a) + " " + hex(b) + " " + hex(got));
}

export string test_the_fields_agree_with_bigint(Core core, Cli cli) {
  T t = T.create();
  string[] curves = string[]("p256", "p384");
  i32[] widths = i32[](32, 48);
  Lines lines = Lines.create();
  for (i32 c = 0; c < curves.len(); c++) {
    u8[][] all = fieldCorpus(widths[c], edgesFor(curves[c]));
    for (i32 i = 0; i < all.len(); i++) {
      u8[] a = all[i];
      u8[] b = all[(i * 13 + 7) % all.len()];
      claimFp(lines, curves[c], "round", a, b, fpToBytes(fpFromBytes(a)));
      claimFp(lines, curves[c], "add", a, b, fpToBytes(fpAdd(fpFromBytes(a), fpFromBytes(b))));
      claimFp(lines, curves[c], "sub", a, b, fpToBytes(fpSub(fpFromBytes(a), fpFromBytes(b))));
      claimFp(lines, curves[c], "mul", a, b, fpToBytes(fpMul(fpFromBytes(a), fpFromBytes(b))));
      claimFp(lines, curves[c], "sqr", a, b, fpToBytes(fpSquare(fpFromBytes(a))));
      claimFp(lines, curves[c], "neg", a, b, fpToBytes(fpNeg(fpFromBytes(a))));
    }
  }
  check(t, cli, "node", string[](CRYPTO_ORACLE), lines, "both fields over the corpus");
  return t.report();
}

export string test_inversion_agrees_with_bigint_and_undoes_multiplication(Core core, Cli cli) {
  T t = T.create();
  string[] curves = string[]("p256", "p384");
  i32[] widths = i32[](32, 48);
  Lines lines = Lines.create();
  for (i32 c = 0; c < curves.len(); c++) {
    u8[][] all = fieldCorpus(widths[c], edgesFor(curves[c]));
    for (i32 i = 0; i < 25 && i < all.len(); i++) {
      i64[] a = fpFromBytes(all[i]);
      claimFp(lines, curves[c], "inv", all[i], u8[0](), fpToBytes(fpInvert(a)));

      // The defining property, checked here rather than through the exponent — this catches an
      // inversion that agreed with a wrong reference.
      if (!fpIsZero(a)) {
        t.isTrue(fpEquals(fpMul(a, fpInvert(a)), fpOne(a.len())),
                 curves[c] + ": a times its inverse is one, at corpus index " + itoa64(i as i64));
      }
    }
  }
  check(t, cli, "node", string[](CRYPTO_ORACLE), lines, "inversion in both fields");
  return t.report();
}

// ── The base point and the addition law ──────────────────────────────────────
//
// Host-side until 2026-08-17, `issues/system/0161`. Neither needs an oracle: the first is a
// published constant and the second is a property of the formula.

/** A 32-byte scalar from a hex literal, left-padded. */
u8[] nistScalar(string h) {
  string padded = h;
  while (padded.len() < 64) { padded = "0" + padded; }
  return decodedHex(padded);
}

export string test_the_p256_base_point_is_the_one_fips_186_4_publishes() {
  // Worth checking directly: everything else depends on G being right, and a wrong G produces a
  // self-consistent implementation that agrees with nobody.
  T t = T.create();
  t.eqStr(hex(p256Reencode(p256ScalarBase(nistScalar("1")))),
          "046b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296" +
          "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5",
          "G is FIPS 186-4's base point");
  t.eqStr(hex(p256ScalarBase(nistScalar("2"))).slice(2, 66),
          "7cf27b188d034f7e8a52380304b51ac3c08969e277f21b35a60b48fc47669978",
          "and 2G's x is the published value");
  return t.report();
}

/**
 * The exceptional cases in a short Weierstrass addition law.
 *
 * The formula divides by zero when the two points are equal, and yields the identity when they are
 * negations. `jacMul` runs into both on ordinary inputs, so these are checked through scalar
 * multiplication rather than by calling the formula directly — which is how they would actually be
 * hit. `n*G` is the identity and has no affine encoding, so it traps; that case is
 * `test_traps_p256_scalar_base_at_the_order` in `traps_test.wac`.
 */
export string test_the_exceptional_cases_in_the_p256_addition_law() {
  T t = T.create();
  u8[] three = p256ScalarBase(nistScalar("3"));
  u8[] four = p256ScalarBase(nistScalar("4"));
  t.isFalse(equal(three, four), "3G and 4G are different points");

  // (n-1)G is -G: the same x, and the two y coordinates summing to p.
  u8[] g = p256Reencode(p256ScalarBase(nistScalar("1")));
  u8[] nMinusOne = p256Order();
  nMinusOne[31] = nMinusOne[31] - 1;
  u8[] negG = p256ScalarBase(nMinusOne);
  t.eqStr(hex(negG).slice(2, 66), hex(g).slice(2, 66), "(n-1)G has G's x");

  u8[] gy = u8[32]();
  u8[] ny = u8[32]();
  for (i32 i = 0; i < 32; i++) { gy[i] = g[33 + i]; ny[i] = negG[33 + i]; }
  t.isTrue(fpIsZero(fpAdd(fpFromBytes(gy), fpFromBytes(ny))),
           "(n-1)G is -G: the y coordinates sum to p");
  return t.report();
}

export string test_a_p384_signature_is_rejected_under_the_wrong_key(Core core, Cli cli) {
  // The check that distinguishes verification from a self-consistent computation: a signature that
  // verifies must do so only under the key that made it. Two keys in one batch, because the host
  // picks both and a second batch would pick two others.
  T t = T.create();
  u8[] msg = "the same message under two keys".toBytes();
  Lines lines = Lines.create();
  lines.add("ecgensign 384 " + hex(msg));
  lines.add("ecgensign 384 " + hex(msg));
  Answers a = ask(t, cli, "node", string[](CRYPTO_ORACLE), lines, "two P-384 keys and signatures");
  if (!a.ok) { return t.report(); }

  u8[] pointA = decodedHex(word(a.lines[0], 2));
  u8[] sigA = decodedHex(word(a.lines[0], 3));
  u8[] pointB = decodedHex(word(a.lines[1], 2));
  t.isTrue(p384Verify(pointA, msg, sigA), "the signature verifies under its own key");
  t.isFalse(p384Verify(pointB, msg, sigA), "and not under the other one");
  return t.report();
}

export string test_a_sha256_digest_under_a_p384_key_is_right_aligned(Core core, Cli cli) {
  // Legal and it happens: `ecdsa-with-SHA256` on a P-384 key. The digest is shorter than the order,
  // so SEC 1 treats it as a small number rather than padding on the right. A left-aligned
  // implementation verifies nothing and would look like a broken curve.
  T t = T.create();
  u8[] msg = "a short digest under a long curve".toBytes();
  Lines lines = Lines.create();
  lines.add("ecgensign 384 " + hex(msg) + " sha256");
  Answers a = ask(t, cli, "node", string[](CRYPTO_ORACLE), lines, "a SHA-256 signature on P-384");
  if (!a.ok) { return t.report(); }
  t.isTrue(p384VerifyDigest(decodedHex(word(a.lines[0], 2)), sha256(msg),
                            decodedHex(word(a.lines[0], 3))),
           "a SHA-256 signature under a P-384 key verifies");
  return t.report();
}

/**
 * A malformed public key is `false` from a verifier, not a trap — GitHub issue 14.
 *
 * The reported reproduction: a 65-byte key of the right *length* with no `0x04` prefix, and a
 * signature whose r and s are both 1 so that the scalar-range checks pass and the key is actually
 * reached. `p256Verify` returns `bool`, and it took the process down.
 *
 * Four entry points share the path — `p256Verify`, `p256VerifyDigest`, `p384Verify`,
 * `p384VerifyDigest` — so all four are asked. The canonical-key call is the canary: a verifier that
 * refused everything would satisfy the four refusals on its own.
 */
export string test_a_malformed_public_key_is_false_not_a_trap(Core core, Cli cli) {
  T t = T.create();
  u8[] sig = u8[64]();
  sig[31] = 1;
  sig[63] = 1;
  u8[] noPrefix = u8[65]();          // right length, no 0x04
  u8[] digest = u8[32]();

  t.isFalse(p256Verify(noPrefix, u8[0](), sig), "p256Verify trapped on a prefixless key");
  t.isFalse(p256VerifyDigest(noPrefix, digest, sig), "p256VerifyDigest trapped on it");

  u8[] sig384 = u8[96]();
  sig384[47] = 1;
  sig384[95] = 1;
  u8[] noPrefix384 = u8[97]();
  t.isFalse(p384Verify(noPrefix384, u8[0](), sig384), "p384Verify trapped on a prefixless key");
  t.isFalse(p384VerifyDigest(noPrefix384, u8[48](), sig384), "p384VerifyDigest trapped on it");

  // And the shapes either side of the length, which took a different route in: too short and too
  // long were both refused by the length check before, and must still be.
  t.isFalse(p256Verify(u8[64](), u8[0](), sig), "a 64-byte key");
  t.isFalse(p256Verify(u8[66](), u8[0](), sig), "a 66-byte key");

  // The canary: a real key and a real signature over a real message still verify.
  u8[] priv = u8[32]();
  priv[31] = 9;
  u8[] pub = p256PublicKey(priv);
  u8[] msg = "malformed keys".toBytes();
  u8[] k = u8[32]();
  k[31] = 7;
  u8[] good = p256Sign(priv, msg, k);
  t.isTrue(good.len() == 64 && p256Verify(pub, msg, good),
           "a genuine signature still verifies, so the refusals above are about the key");
  return t.report();
}
