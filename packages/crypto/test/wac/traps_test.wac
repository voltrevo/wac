// ML-KEM-768. The share lengths are spelled out rather than read from the module, so a refusal test
// does not follow its own bound wherever it moves.

const i32 EK_LEN = 1184;
const i32 DK_LEN = 2400;
const i32 CT_LEN = 1088;

u8[] goodBoth() { return mlkemKeyGen(u8[64]()); }
u8[] goodEk() { return slice(goodBoth(), 0, EK_LEN); }
u8[] goodDk() { return slice(goodBoth(), EK_LEN, EK_LEN + DK_LEN); }

/** `b` with one byte appended, and `b` one byte shorter — the only shapes that ask about length. */
u8[] plusByte(u8[] b) {
  u8[] o = u8[b.len() + 1]();
  for (i32 i = 0; i < b.len(); i++) { o[i] = b[i]; }
  return o;
}
u8[] minusByte(u8[] b) { return slice(b, 0, b.len() - 1); }

/** The genuine expanded secret, truncated or extended to `n`. */
u8[] expandedTo(i32 n) {
  u8[] good = ed25519ExpandedSecret(goodSeed());
  u8[] out = u8[n]();
  for (i32 i = 0; i < n && i < good.len(); i++) { out[i] = good[i]; }
  return out;
}

export string test_traps_mlkem_refuses_a_0_byte_seed() {
  mlkemKeyGen(padded(0, 0));
  return "";
}

export string test_traps_mlkem_refuses_a_63_byte_seed() {
  mlkemKeyGen(padded(63, 0));
  return "";
}

export string test_traps_mlkem_refuses_a_65_byte_seed() {
  mlkemKeyGen(padded(65, 0));
  return "";
}

export string test_traps_mlkem_refuses_an_empty_encapsulation_key() {
  mlkemEncaps(u8[0](), u8[32]());
  return "";
}

export string test_traps_mlkem_refuses_an_encapsulation_key_one_byte_short() {
  mlkemEncaps(minusByte(goodEk()), u8[32]());
  return "";
}

export string test_traps_mlkem_refuses_an_encapsulation_key_one_byte_long() {
  mlkemEncaps(plusByte(goodEk()), u8[32]());
  return "";
}

export string test_traps_mlkem_refuses_a_0_byte_message() {
  mlkemEncaps(goodEk(), padded(0, 2));
  return "";
}

export string test_traps_mlkem_refuses_a_31_byte_message() {
  mlkemEncaps(goodEk(), padded(31, 2));
  return "";
}

export string test_traps_mlkem_refuses_a_33_byte_message() {
  mlkemEncaps(goodEk(), padded(33, 2));
  return "";
}

export string test_traps_mlkem_refuses_a_64_byte_message() {
  mlkemEncaps(goodEk(), padded(64, 2));
  return "";
}

export string test_traps_mlkem_refuses_an_empty_decapsulation_key() {
  mlkemDecaps(u8[0](), u8[CT_LEN]());
  return "";
}

export string test_traps_mlkem_refuses_a_decapsulation_key_one_byte_short() {
  mlkemDecaps(minusByte(goodDk()), u8[CT_LEN]());
  return "";
}

export string test_traps_mlkem_refuses_a_decapsulation_key_one_byte_long() {
  mlkemDecaps(plusByte(goodDk()), u8[CT_LEN]());
  return "";
}

export string test_traps_mlkem_refuses_an_empty_ciphertext() {
  mlkemDecaps(goodDk(), u8[0]());
  return "";
}

export string test_traps_mlkem_refuses_a_ciphertext_one_byte_short() {
  mlkemDecaps(goodDk(), u8[CT_LEN - 1]());
  return "";
}

export string test_traps_mlkem_refuses_a_ciphertext_one_byte_long() {
  mlkemDecaps(goodDk(), u8[CT_LEN + 1]());
  return "";
}

export string test_traps_mlkem_refuses_a_coefficient_at_or_above_q() {
  // FIPS 203 §7.2 requires the modulus check: every twelve-bit coefficient must be below q. The
  // test is that re-encoding what was decoded gives back the original bytes, which fails exactly
  // when some coefficient was 3329 or more. Skipping it lets a peer choose arithmetic outside the
  // ring. 0xFFF is 4095, comfortably above q, in the first coefficient's twelve bits.
  u8[] bad = slice(goodEk(), 0, EK_LEN);
  bad[0] = 0xFF;
  bad[1] = bad[1] | 0x0F;
  mlkemEncaps(bad, u8[32]());
  return "";
}

