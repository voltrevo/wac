// bcrypt_pbkdf, against OpenSSH itself.
//
// There is no WebCrypto oracle for this one and no vector I would trust myself to transcribe, so the
// oracle is the thing the KDF exists to serve: `ssh-keygen` writes an encrypted private key, and we
// decrypt it. That is stronger than a published vector, because it exercises the format's real
// parameters and fails if any part of the derivation is wrong.
//
// What makes it a proof rather than a plausible-looking pass: the private section of an
// `openssh-key-v1` file opens with the same random 32-bit value twice. The cipher is AES-CTR, so a
// derived key wrong in any bit produces an unrelated keystream and the two would agree only by a
// 2^-32 accident. The embedded public key is then compared against the `.pub` file, which checks
// bytes much further into the stream and so covers the IV as well as the key.
//
// ## Host-side until 2026-08-18, `issues/system/0161`
//
// The host half was `node:crypto`'s `createDecipheriv`, decrypting the private section. Here the
// decryption is `aesCtr` from this same package, so the batch also hands node the same key, IV and
// ciphertext through `oracle.mjs`'s existing `ctr` op and claims our plaintext. CTR is symmetric, so
// encrypting the ciphertext is decrypting it. No new oracle op was needed — `ctr` was already there
// and `aes_test.wac` already drives it.
//
// **The two assertions catch different things, and it is worth being exact about which.** Node is
// handed the key *we* derived, so it cannot see a wrong derivation at all: perturbing the round
// count fails all four check-int comparisons and leaves the `ctr` line silent, because node
// reproduced our wrong plaintext from our wrong key. Both were canaried that way round.
//
//   - the **check ints and the `.pub` comparison** are the oracle for the KDF. They are what makes
//     `ssh-keygen` the reference: only the right derived key turns that ciphertext into a structure
//     whose first two words match and whose embedded public key is the one in the `.pub` file.
//   - the **`ctr` line** is the oracle for the cipher, and is what stops the decryption being
//     self-certified. Claiming the ciphertext as the plaintext fails it on all four cases.

import { T } from "../../../wactest/src/assert.wac";
import { Lines, check, hex } from "../../../wactest/src/oracle.wac";
import { Core, Cli, Exec, Change, FileResult } from "std/platform.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { startsWith, trimmed } from "../../../wactest/src/strings.wac";
import { slice, equal } from "../../../bytes/src/slice.wac";
import { decode, encode, ALPHABET_STANDARD } from "../../../codec/src/base64.wac";
import { bcryptPbkdf } from "../../src/bcryptpbkdf.wac";
import { aesCtr } from "../../src/aesctr.wac";
import { madeDir } from "../../../wactest/src/host.wac";

const string ORACLE = "packages/crypto/test/oracle.mjs";

/** A cursor over SSH wire format: uint32 lengths, big-endian, everything length-prefixed. */
struct Rd {
  u8[] b;
  i32 p;
}

i32 rdU32(Rd r) {
  i32 v = (r.b[r.p] << 24) | (r.b[r.p + 1] << 16) | (r.b[r.p + 2] << 8) | r.b[r.p + 3];
  r.p = r.p + 4;
  return v;
}

u8[] rdStr(Rd r) {
  i32 n = rdU32(r);
  u8[] s = slice(r.b, r.p, r.p + n);
  r.p = r.p + n;
  return s;
}

/** One `ssh-keygen` invocation's worth of parameters. */
struct KeyCase {
  string type;
  string cipher;
  /** node's name for the same cipher, which is what `oracle.mjs` speaks. */
  string nodeName;
  i32 keyLen;
  i32 ivLen;
  i32 rounds;
  string pass;
}

/**
 * The cases.
 *
 * Key length and IV length per cipher, and the two differ in total, which matters: 48 bytes needs
 * the striped output path (stride 2) and 32 bytes does not (stride 1), so both are covered.
 */
KeyCase[] cases() {
  return KeyCase[](
    KeyCase("ed25519", "aes256-ctr", "aes-256-ctr", 32, 16, 16, "correct horse battery staple"),
    KeyCase("ed25519", "aes128-ctr", "aes-128-ctr", 16, 16, 1, "x"),
    KeyCase("ed25519", "aes256-ctr", "aes-256-ctr", 32, 16, 4,
            "a passphrase with spaces and ünicode"),
    KeyCase("rsa", "aes256-ctr", "aes-256-ctr", 32, 16, 4, "pw"));
}

/** The base64 body of a PEM file: every line that is not a `-----` delimiter, joined. */
u8[]? pemBody(string pem) {
  string joinedText = "";
  i32 from = 0;
  for (i32 i = 0; i <= pem.len(); i++) {
    if (i < pem.len() && pem.slice(i, i + 1) != "\n") { continue; }
    string line = pem.slice(from, i);
    from = i + 1;
    if (line.len() == 0 || startsWith(line, "-----")) { continue; }
    joinedText = joinedText + line;
  }
  return decode(joinedText.toBytes());
}

export string test_an_openssh_key_encrypted_by_ssh_keygen_decrypts_with_our_bcrypt_pbkdf(
    Core core, Cli cli) {
  T t = T.create();

  // `.cache` rather than a directory beside the tests: it is gitignored and the corpus walks do not
  // enter it, so a key left behind by an interrupted run is never mistaken for a source file.
  string dir = cli.cwd().wait() + "/.cache/bcryptpbkdf";
  string whyDir1 = madeDir(cli, dir);
  t.isTrue(whyDir1 == "", whyDir1);

  Lines lines = Lines.create();
  KeyCase[] all = cases();
  i32 checked = 0;
  for (i32 i = 0; i < all.len(); i++) {
    KeyCase c = all[i];
    string f = dir + "/" + c.type + "-" + c.cipher + "-" + itoa(c.rounds);
    // ssh-keygen refuses to overwrite, and a leftover from an earlier run would otherwise be read
    // instead of a fresh one — a stale key still decrypts, so this would pass without generating.
    cli.remove(f, false).wait();
    cli.remove(f + ".pub", false).wait();

    string[] argv = c.type == "rsa"
      ? string[]("-t", c.type, "-N", c.pass, "-f", f, "-q", "-a", itoa(c.rounds), "-Z", c.cipher,
                 "-b", "2048")
      : string[]("-t", c.type, "-N", c.pass, "-f", f, "-q", "-a", itoa(c.rounds), "-Z", c.cipher);
    Exec gen = cli.exec("ssh-keygen", argv, u8[0]()).wait();
    t.isTrue(gen.ran(), "ssh-keygen ran — " + gen.error);
    if (!gen.ran()) { return t.report(); }
    t.eqI32(gen.status, 0, "ssh-keygen made " + c.type + " — " + string.fromBytes(gen.stderr));
    if (gen.status != 0) { continue; }

    FileResult priv = cli.readFile(f).wait();
    t.isTrue(priv.ok, "read the private key — " + priv.error);
    if (!priv.ok) { continue; }

    u8[]? blobOpt = pemBody(string.fromBytes(priv.bytes));
    t.isTrue(blobOpt is not null, c.type + ": the PEM body is base64");
    if (blobOpt is null) { continue; }
    u8[] blob = blobOpt!;

    t.eqStr(string.fromBytes(slice(blob, 0, 15)), "openssh-key-v1\0",
            c.type + ": not an openssh-key-v1 file");

    Rd r = Rd(slice(blob, 15, blob.len()), 0);
    string ciphername = string.fromBytes(rdStr(r));
    string kdfname = string.fromBytes(rdStr(r));
    t.eqStr(kdfname, "bcrypt", c.type + ": expected the bcrypt kdf");
    t.eqStr(ciphername, c.cipher, c.type + ": expected the cipher we asked for");
    if (kdfname != "bcrypt" || ciphername != c.cipher) { continue; }

    Rd opts = Rd(rdStr(r), 0);
    u8[] salt = rdStr(opts);
    i32 rounds = rdU32(opts);
    t.eqI32(rounds, c.rounds, c.type + ": the file records the rounds we asked for");
    rdU32(r);                                  // key count, always 1 here
    u8[] pubblob = rdStr(r);
    u8[] ciphertext = rdStr(r);

    u8[] derived = bcryptPbkdf(c.pass.toBytes(), salt, c.keyLen + c.ivLen, rounds);
    t.eqI32(derived.len(), c.keyLen + c.ivLen, c.type + ": derived length");
    if (derived.len() != c.keyLen + c.ivLen) { continue; }
    u8[] key = slice(derived, 0, c.keyLen);
    u8[] iv = slice(derived, c.keyLen, derived.len());
    u8[] plain = aesCtr(key, iv, ciphertext);

    // The independence claim, batched: node derives the same keystream from the key we derived, and
    // is told what we made of it. CTR is symmetric, so encrypting the ciphertext is decrypting it.
    lines.add("ctr " + hex(key) + " " + hex(iv) + " " + hex(ciphertext) + " " + hex(plain));

    Rd pr = Rd(plain, 0);
    i32 check1 = rdU32(pr);
    i32 check2 = rdU32(pr);
    t.eqI32(check1, check2,
            c.type + "/" + ciphername + "/rounds=" + itoa(rounds) +
            ": the check ints differ — the derived key is wrong");

    // Reaches further into the keystream than the check ints do, so the IV is covered too.
    FileResult pub = cli.readFile(f + ".pub").wait();
    t.isTrue(pub.ok, "read the .pub file — " + pub.error);
    if (pub.ok) {
      // `<type> <base64> <comment>\n` — the middle field. Taken by slicing past the first space and
      // looking again, because `indexOf` searches from the start and takes no offset.
      string pubText = string.fromBytes(pub.bytes);
      i32 sp = pubText.indexOf(" ");
      string rest = sp < 0 ? "" : trimmed(pubText.slice(sp + 1, pubText.len()));
      i32 sp2 = rest.indexOf(" ");
      string want = sp2 < 0 ? rest : rest.slice(0, sp2);
      t.eqStr(string.fromBytes(encode(pubblob, ALPHABET_STANDARD(), true)), want,
              c.type + ": the embedded public key does not match the .pub file");
    }
    checked = checked + 1;
  }

  // A generation that silently failed for every case would leave nothing compared and everything
  // green.
  t.eqI32(checked, all.len(), "every case was generated and decrypted");
  check(t, cli, "node", string[](ORACLE), lines, "aes-ctr against node");
  return t.report();
}

export string test_bcrypt_pbkdf_is_pinned_to_a_fixed_answer() {
  // A fixed input, so the KDF stays pinned without needing ssh-keygen present.
  //
  // Honest about what this is: the expected bytes were produced by this implementation *after* the
  // interop test above established it agrees with OpenSSH. It is a regression anchor, not an
  // independent vector, and it proves nothing on its own — if the test above is skipped or removed,
  // this one is only checking that we still do whatever we did before.
  T t = T.create();
  u8[] got = bcryptPbkdf("password".toBytes(), "salt".toBytes(), 48, 4);
  t.eqStr(hex(got),
          "5ba4bfc60c7ac272931458407f4c1c4936ea356c55125c5a279b791d65bf9842" +
          "d49d7e1b572a9052715ebfa9421e7e94",
          "bcrypt_pbkdf changed");
  return t.report();
}

export string test_the_second_block_interleaves_with_the_first_rather_than_following_it() {
  // The striping is the part most likely to be got wrong in a way that still looks reasonable, so it
  // is checked directly rather than only through a key that happens to use it.
  //
  // A bcrypt block's output depends only on the password, the salt and the block counter — never on
  // how many bytes were asked for. So block 1 is the same 32 bytes in both derivations below, and
  // only *where they land* differs.
  //
  // At 32 bytes there is one block: stride 1, written straight through.
  // At 64 there are two: stride 2, so block 1 supplies the even positions and block 2 the odd.
  // That makes the relationship exact and worth asserting — the even bytes of the long derivation
  // must reproduce the short one entirely.
  T t = T.create();
  u8[] shortOut = bcryptPbkdf("pw".toBytes(), "s".toBytes(), 32, 2);
  u8[] longOut = bcryptPbkdf("pw".toBytes(), "s".toBytes(), 64, 2);
  for (i32 i = 0; i < 32; i++) {
    if (longOut[i * 2] == shortOut[i]) { continue; }
    t.fail("byte " + itoa(i) + " of block 1 landed at " + itoa(i * 2) + " as " +
           itoa(longOut[i * 2]) + ", expected " + itoa(shortOut[i]) + " — the output is not striped");
    break;
  }

  // And the odd positions are block 2, so they must not simply continue block 1.
  t.isTrue(!equal(slice(longOut, 0, 32), shortOut),
           "the 64-byte derivation starts with the whole 32-byte one; blocks are concatenated, " +
           "not striped");

  i32[] lens = i32[](1, 31, 32, 33, 48, 64, 100);
  for (i32 i = 0; i < lens.len(); i++) {
    u8[] out = bcryptPbkdf("pw".toBytes(), "s".toBytes(), lens[i], 1);
    t.eqI32(out.len(), lens[i], "asked for " + itoa(lens[i]) + " bytes");
    bool allZero = true;
    for (i32 j = 0; j < out.len(); j++) { if (out[j] != 0) { allZero = false; } }
    t.isTrue(!allZero, itoa(lens[i]) + " bytes came back all zero — a block was never placed");
  }
  return t.report();
}
