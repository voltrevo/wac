// HMAC-SHA-256, HMAC-SHA-1 and HKDF, against their RFCs and against the host's HMAC.
//
// One file for both because HKDF *is* HMAC used twice — extract then expand — so a fault
// in the primitive shows up in both, and testing them apart makes it harder to see which
// layer moved. The oracle is `node:crypto`'s HMAC, which is the primitive alone: checking
// HKDF against a host HKDF would compare two implementations of the same construction,
// where checking it against the primitive checks the construction itself.
//
// ## Where these functions actually go wrong
//
// **HMAC**: the key. Shorter than the block it is zero-padded, longer it is hashed first,
// and exactly 64 bytes is neither — RFC 4231 case 6 uses a 131-byte key for precisely
// that reason. An implementation that forgot the hash-first rule is right for every key a
// test author would type.
//
// **HKDF**: the counter. Expand runs a chain, T(n) = HMAC(prk, T(n-1) ++ info ++ n), and
// omitting T(n-1) gives an output correct in its first 32 bytes and wrong after — which
// every short vector misses.

import { T } from "../../../wactest/src/assert.wac";
import { Lines, check, hex } from "../../../wactest/src/oracle.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";
import { hmacSha1, hmacSha256 } from "../../src/hmac.wac";
import { hkdf, hkdfExtract } from "../../src/hkdf.wac";
import { equal, slice } from "../../../bytes/src/slice.wac";
import { decoded } from "../../../codec/src/hex.wac";
import { Core, Cli, FileResult } from "../../../platform/src/platform.wac";
import { parse } from "../../../json/src/json.wac";
import { JsonValue, JsonObject } from "../../../json/src/value.wac";
u8[] rep(i32 byte, i32 n) {
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = byte; }
  return out;
}
u8[] fill(i32 n, i32 a, i32 b) {
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = (i * a + b) & 0xFF; }
  return out;
}

/**
 * HMAC-SHA-1, RFC 2202. Here because `known_hosts` hashes its hostnames with it — see
 * `packages/ssh` — and for nothing else.
 *
 * Case 6 is the one that matters: an 80-byte key, longer than the 64-byte block, so it is hashed
 * first. RFC 2104 says the reduction uses *the HMAC's own hash*, and reducing with SHA-256
 * instead agrees for every key of 64 bytes or fewer — which is every other case here, and every
 * known_hosts salt. Without this vector that mistake is invisible.
 */
export string test_rfc_2202_hmac_sha1_vectors() {
  T t = T.create();
  t.eqBytes(hmacSha1(rep(0x0b, 20), "Hi There".toBytes()),
            decoded("b617318655057264e28bc0b6fb378c8ef146be00"), "RFC 2202 case 1");
  t.eqBytes(hmacSha1("Jefe".toBytes(), "what do ya want for nothing?".toBytes()),
            decoded("effcdf6ae5eb2fa2d27416d5f184df9c259a7c79"), "RFC 2202 case 2");
  t.eqBytes(hmacSha1(rep(0xaa, 20), rep(0xdd, 50)),
            decoded("125d7342b9ac11cd91a39af48aa17b4f63f175d3"), "RFC 2202 case 3");
  t.eqBytes(hmacSha1(rep(0xaa, 80),
                     "Test Using Larger Than Block-Size Key - Hash Key First".toBytes()),
            decoded("aa4ae5e15272d00e95705637ce8a3b55ed402112"), "RFC 2202 case 6");
  return t.report();
}

export string test_rfc_4231_hmac_vectors() {
  T t = T.create();
  t.eqBytes(hmacSha256(rep(0x0b, 20), "Hi There".toBytes()),
            decoded("b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"),
            "RFC 4231 case 1");
  t.eqBytes(hmacSha256("Jefe".toBytes(), "what do ya want for nothing?".toBytes()),
            decoded("5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"),
            "RFC 4231 case 2");
  t.eqBytes(hmacSha256(rep(0xaa, 20), rep(0xdd, 50)),
            decoded("773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe"),
            "RFC 4231 case 3");
  return t.report();
}

const string ORACLE = "packages/crypto/test/oracle.mjs";

/**
 * Ask node's HMAC-SHA256.
 *
 * The oracle is the primitive alone, deliberately: checking HKDF against a host HKDF would compare
 * two implementations of the same construction, where checking it against HMAC checks the
 * *construction* — the counter, the chained T(n-1), the info placement — against something that has
 * no opinion about any of it.
 *
 * The direction reversed when this stopped being a callback. It used to build the expected output
 * from host HMACs and compare; now it hands over the chain its own output implies and lets node
 * reject any step. Same property, and the claim for a truncated final block is a prefix — which
 * `test/oracle.mjs` says it accepts, and which is the one place in this batch that it does.
 * `issues/system/0161`.
 */
void checkHmac(T t, Cli cli, Lines lines, string what) {
  check(t, cli, "node", string[](ORACLE), lines, what);
}

void claimHmac(Lines lines, u8[] key, u8[] data, u8[] mac) {
  lines.add("hmac " + hex(key) + " " + hex(data) + " " + hex(mac));
}

export string test_the_key_length_boundaries(Core core, Cli cli) {
  // 63, 64 and 65 are the three rules — pad, neither, hash-first — and 131 is RFC 4231's
  // own long key. An implementation missing the hash-first rule passes everything below
  // 64 and fails silently above it.
  T t = T.create();
  Lines lines = Lines.create();
  u8[] msg = "the message does not matter here".toBytes();
  i32[] keyLens = i32[](0, 1, 32, 63, 64, 65, 100, 131, 200);
  for (i32 i = 0; i < keyLens.len(); i++) {
    u8[] key = fill(keyLens[i], 7, 3);
    claimHmac(lines, key, msg, hmacSha256(key, msg));
  }
  // And message lengths across the same boundary, since the message is hashed inside.
  u8[] key = fill(32, 11, 1);
  i32[] msgLens = i32[](0, 1, 55, 56, 63, 64, 65, 119, 120, 200);
  for (i32 i = 0; i < msgLens.len(); i++) {
    u8[] m = fill(msgLens[i], 13, 5);
    claimHmac(lines, key, m, hmacSha256(key, m));
  }
  t.eqI32(lines.n, keyLens.len() + msgLens.len(), "one claim per boundary");
  checkHmac(t, cli, lines, "the key and message length boundaries");
  return t.report();
}

export string test_rfc_5869_hkdf_vectors() {
  T t = T.create();
  // A.1, the basic case.
  u8[] salt1 = decoded("000102030405060708090a0b0c");
  u8[] ikm1 = rep(0x0b, 22);
  t.eqBytes(hkdfExtract(salt1, ikm1),
            decoded("077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5"),
            "A.1 extract");
  t.eqBytes(hkdf(salt1, ikm1, decoded("f0f1f2f3f4f5f6f7f8f9"), 42),
            decoded("3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf" +
                  "34007208d5b887185865"),
            "A.1 expand to 42 bytes");

  // A.3, an empty salt and empty info — the case where an implementation that treats an
  // absent salt as absent rather than as a block of zeros diverges.
  t.eqBytes(hkdf(u8[0](), rep(0x0b, 22), u8[0](), 42),
            decoded("8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d" +
                  "9d201395faa4b61a96c8"),
            "A.3, empty salt and info");
  return t.report();
}

export string test_expand_chains_across_blocks(Core core, Cli cli) {
  // The counter and the chained T(n-1), checked against the host's HMAC. Output lengths either
  // side of the 32-byte hash size, because an expansion that omits T(n-1) is correct for the first
  // block and wrong for every one after it.
  //
  // Read forwards rather than built forwards: our own expansion *is* the chain, so each block of
  // it is a claim about `HMAC(prk, T(n-1) ++ info ++ n)` that node can check. The last block is a
  // prefix when the length is not a multiple of 32, which is exactly why the lengths below are not.
  T t = T.create();
  Lines lines = Lines.create();
  u8[] salt = fill(16, 3, 9);
  u8[] ikm = fill(40, 5, 2);
  u8[] info = fill(11, 7, 1);
  u8[] prk = hkdfExtract(salt, ikm);
  claimHmac(lines, salt, ikm, prk);                 // extract is HMAC(salt, ikm)

  i32[] lens = i32[](1, 31, 32, 33, 63, 64, 65, 200);
  for (i32 li = 0; li < lens.len(); li++) {
    i32 len = lens[li];
    u8[] out = hkdf(salt, ikm, info, len);
    t.eqI32(out.len(), len, "expand to " + itoa64(len as i64) + " bytes");
    if (out.len() != len) { continue; }
    u8[] prev = u8[0]();
    i32 done = 0;
    i32 n = 1;
    while (done < len) {
      u8[] input = u8[prev.len() + info.len() + 1]();
      for (i32 i = 0; i < prev.len(); i++) { input[i] = prev[i]; }
      for (i32 i = 0; i < info.len(); i++) { input[prev.len() + i] = info[i]; }
      input[input.len() - 1] = n;
      i32 take = len - done < 32 ? len - done : 32;
      u8[] block = u8[take]();
      for (i32 i = 0; i < take; i++) { block[i] = out[done + i]; }
      claimHmac(lines, prk, input, block);
      prev = block;                                 // truncated only on the final block
      done = done + take;
      n = n + 1;
    }
  }
  checkHmac(t, cli, lines, "the expansion chain");
  return t.report();
}

export string test_every_input_changes_the_output() {
  // No oracle. A derivation that ignored its info, or its salt, would satisfy the RFC
  // vectors above — those fix all three inputs at once — and would silently give two
  // different contexts the same key.
  T t = T.create();
  u8[] salt = fill(16, 3, 1);
  u8[] ikm = fill(32, 5, 2);
  u8[] info = fill(8, 7, 3);
  u8[] base = hkdf(salt, ikm, info, 32);
  t.isFalse(equal(base, hkdf(fill(16, 3, 2), ikm, info, 32)), "the salt matters");
  t.isFalse(equal(base, hkdf(salt, fill(32, 5, 3), info, 32)), "the input keying material matters");
  t.isFalse(equal(base, hkdf(salt, ikm, fill(8, 7, 4), 32)), "the info matters");
  // A longer output must extend the shorter one, since the chain is a stream.
  u8[] long = hkdf(salt, ikm, info, 96);
  bool prefix = true;
  for (i32 i = 0; i < 32; i++) { if (long[i] != base[i]) { prefix = false; } }
  t.isTrue(prefix, "a longer expansion extends the shorter one");
  return t.report();
}

// ── the 255-block cap ────────────────────────────────────────────────────────

/**
 * HKDF at its cap, against WebCrypto's answer.
 *
 * The counter appended to each `T(i)` is one byte starting at 1, so 255 blocks is the limit and
 * 255*32 = 8160 the largest legal request. Both sides are worth pinning: a cap off by one block is
 * invisible at every length the RFC 5869 vectors use, and a cap enforced one block early silently
 * refuses output that is well defined.
 *
 * **The oracle is WebCrypto and it still is.** This was a TypeScript test calling
 * `crypto.subtle.deriveBits` because that was the only way to reach a second implementation. It is
 * asked once now, by `packages/crypto/tools/capture-hkdfcap.wac`, and its answer is committed — the
 * same shape `packages/tor/tools/capture-*` uses against C tor. Lossless because every input is
 * fixed. `issues/system/0161`.
 */
export string test_the_255_block_cap_matches_webcrypto(Core core, Cli cli) {
  T t = T.create();
  string path = "packages/crypto/test/data/hkdfcap_vectors.json";
  FileResult r = cli.readFile(path).wait();
  t.isTrue(r.ok, "the captured vector is readable: " + r.error);
  if (!r.ok) { return t.report(); }
  JsonValue? v = parse(r.bytes);
  if (v is null) { trap; }
  JsonObject o = objectOfJson(v!);

  u8[] salt = decoded(strOfJson(o, "salt"));
  u8[] ikm = decoded(strOfJson(o, "ikm"));
  u8[] info = strOfJson(o, "info").toBytes();
  u8[] want = decoded(strOfJson(o, "okm"));
  t.eqI32(want.len(), 255 * 32, "the vector is the whole cap, not a sample of it");

  u8[] got = hkdf(salt, ikm, info, want.len());
  t.eqI32(got.len(), want.len(), "asked for the cap and got the cap");
  t.isTrue(equal(got, want), "at the cap, wac and WebCrypto agree — including the final block");

  // The last block specifically, because that is the one under the counter that would wrap and the
  // only part of this a shorter request would not already cover.
  t.isTrue(equal(slice(got, want.len() - 32, want.len()), slice(want, want.len() - 32, want.len())),
           "and the final block in particular");
  return t.report();
}

/**
 * One byte past the cap traps.
 *
 * A 256th block cannot be numbered, so refusing is the only correct answer. Trapping rather than
 * returning short is the choice `hkdf.wac` made, and this is where it is pinned.
 */
export string test_traps_past_the_255_block_cap(Core core, Cli cli) {
  hkdf(u8[16](fill: 0x0C), u8[32](), "cap".toBytes(), 255 * 32 + 1);
  return "FAIL: 8161 bytes was accepted, but only 255 blocks can be derived";
}

JsonObject objectOfJson(JsonValue v) {
  match (v) {
    case Object(members): { return members; }
    else: { trap; }
  }
}

string strOfJson(JsonObject o, string key) {
  JsonValue? v = o.getStr(key);
  if (v is null) { trap; }
  match (v!) {
    case Str(bytes): { return string.fromBytes(bytes); }
    else: { trap; }
  }
}
