// RSA against node:crypto, in both directions.
//
// It began as verification only — the host signs, we agree — which is the direction a TLS client
// reading a certificate needs. `design/0002` needs the other one too: a Tor relay signs its identity
// crosscert and an authority signs a consensus, so we must *produce* signatures somebody else
// accepts.
//
// Both directions are here and they are not the same test. "Node verifies what we signed" and "we
// verify what node signed" can both pass while our signer and our verifier share a fault — the
// symmetric-oracle trap. What closes it is that PKCS#1 v1.5 is **deterministic**: for a given key,
// message and hash there is exactly one correct signature, so we can require ours to equal node's
// byte for byte. That assertion cannot be satisfied by two wrong halves agreeing.
//
// `test/oracle.mjs` answers with a fresh key on request and then signs with it. It is **stateful on
// purpose**: `rsakeygen` selects the key every later line in the same batch uses, exactly as the
// callback it replaces did, so each size is made once per batch.
//
// **Where this file's ~5s goes, measured 2026-08-19, because the sentence here used to guess.** It
// said generating a 3072-bit key was a second; five runs of node's keygen are 158-249ms, and a 2048
// one is 86ms. The oracle is not the cost. **We are**: one 2048-bit `rsaSignPkcs1` is **117ms** in
// wac against 0.6ms in OpenSSL, and verification with e=65537 is under a millisecond — the private
// exponent is 2048 bits of modular exponentiation and the public one is seventeen. Six signatures
// across two key sizes is most of the file.
//
// So this is the same family as `issues/system/0209`: the asymmetric primitives here are two to
// three orders of magnitude off an optimised implementation, and every test that signs pays it. The
// number moves when that does, not when this file is rearranged.
// Host-side until 2026-08-17, `issues/system/0161`.
//
// Two rounds per test, and the split is always the same: everything the host must *produce* goes in
// the first batch, and everything it must *judge* about what we produced goes in the second. Both
// PKCS#1 v1.5 and PSS, because they fail differently:
//
//   PKCS#1 v1.5   a fixed block — 0x00 0x01, 0xFF padding, 0x00, then a DER-wrapped
//                 digest. Every byte is specified, so a verifier that skips any of it
//                 accepts forgeries. Bleichenbacher's 2006 attack was exactly a verifier
//                 that stopped reading after the digest.
//   PSS           randomised, so two signatures over one message differ and there is
//                 nothing to compare byte for byte. The salt length is negotiable and
//                 wrong-length handling is where implementations diverge.

import { T } from "../../../wactest/src/assert.wac";
import { Lines, Answers, ask, hex, word } from "../../../wactest/src/oracle.wac";
import { Core, Cli } from "std/platform.wac";
import { decoded } from "../../../codec/src/hex.wac";
import { sha256 } from "../../src/sha256.wac";
import { Big } from "../../../bignum/src/big.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";
import { rsaVerifyPkcs1, rsaVerifyPss, rsaSignPkcs1, rsaSignRawPkcs1, rsaRecoverPkcs1, rsaSignPss,
         modPow, modPowSecret, fromBytes, toBytes } from "../../src/rsa.wac";
import { slice } from "../../../bytes/src/slice.wac";
import { check } from "../../../wactest/src/oracle.wac";

const string ORACLE = "packages/crypto/test/oracle.mjs";

Answers askRsa(T t, Cli cli, Lines lines, string what) {
  return ask(t, cli, "node", string[](ORACLE), lines, what);
}

/** The `n` and `e` of a `rsakey` answer, and the payload of the single-value answers. */
u8[] modulusOf(string line) { return decoded(word(line, 1)); }
u8[] exponentOf(string line) { return decoded(word(line, 2)); }
u8[] valueOf(string line) { return decoded(word(line, 1)); }

u8[] fill(i32 n, i32 seed) {
  u8[] o = u8[n]();
  for (i32 i = 0; i < n; i++) { o[i] = (i * 31 + seed * 7 + 5) & 0xFF; }
  return o;
}

/** The host's key. */
struct Key {
  u8[] n;
  u8[] e;
  Key of(string line) { return Key(modulusOf(line), exponentOf(line)); }
}

export string test_pkcs1_signatures_from_the_host(Core core, Cli cli) {
  T t = T.create();
  i32[] bits = i32[](2048, 3072);
  i32[] hashes = i32[](32, 48, 64);
  // One batch: the key, then the three signatures made with it, then the next key. The oracle is
  // stateful in line order, so the interleaving is the point rather than a compromise.
  Lines lines = Lines.create();
  for (i32 b = 0; b < bits.len(); b++) {
    lines.add("rsakeygen " + itoa64(bits[b] as i64));
    for (i32 h = 0; h < hashes.len(); h++) {
      lines.add("rsasign " + itoa64(hashes[h] as i64) + " " + hex(fill(50 + h, b * 3 + h)));
    }
  }
  Answers a = askRsa(t, cli, lines, "two keys and six signatures");
  if (!a.ok) { return t.report(); }

  for (i32 b = 0; b < bits.len(); b++) {
    Key k = Key.of(a.lines[b * 4]);
    t.eqI32(k.n.len(), bits[b] / 8, "modulus is " + itoa64(bits[b] as i64) + " bits");
    for (i32 h = 0; h < hashes.len(); h++) {
      u8[] msg = fill(50 + h, b * 3 + h);
      t.isTrue(rsaVerifyPkcs1(k.n, k.e, msg, valueOf(a.lines[b * 4 + 1 + h]), hashes[h]),
               "pkcs1 sha-" + itoa64((hashes[h] * 8) as i64) + " at " +
               itoa64(bits[b] as i64) + " bits");
    }
  }
  return t.report();
}

export string test_pkcs1_refuses_a_block_that_is_not_exact(Core core, Cli cli) {
  // Every byte of the block is specified, so every byte is worth moving.
  //
  // What this does *not* reach: the individual strictness checks guard each other here. Flipping a
  // bit in the signature makes the whole block garbage after exponentiation, so removing any one
  // check still leaves the others refusing.
  //
  // That gap is now closed by `test_a_forged_block_that_is_wrong_in_one_place_is_refused` below,
  // which is this file's older note — "reaching a single check needs a signature crafted to have the
  // right shape everywhere else, which needs the private key to construct" — acted on once signing
  // arrived. Each of the six checks was confirmed reachable by deleting it and watching exactly the
  // matching forgery be accepted.
  T t = T.create();
  u8[] msg = "a message to sign".toBytes();
  Lines lines = Lines.create();
  lines.add("rsakeygen 2048");
  lines.add("rsasign 32 " + hex(msg));
  Answers a = askRsa(t, cli, lines, "a key and one signature");
  if (!a.ok) { return t.report(); }
  Key k = Key.of(a.lines[0]);
  u8[] sig = valueOf(a.lines[1]);
  t.isTrue(rsaVerifyPkcs1(k.n, k.e, msg, sig, 32), "the genuine signature verifies");

  // A different message under the same signature.
  t.isFalse(rsaVerifyPkcs1(k.n, k.e, "a different message".toBytes(), sig, 32),
            "a different message is refused");
  // Every part of the signature: the top, the padding, the digest.
  i32[] spots = i32[](0, 1, 100, 200, 250, 255);
  for (i32 i = 0; i < spots.len(); i++) {
    u8[] bad = u8[sig.len()]();
    for (i32 j = 0; j < sig.len(); j++) { bad[j] = sig[j]; }
    bad[spots[i]] = bad[spots[i]] ^ 1;
    t.isFalse(rsaVerifyPkcs1(k.n, k.e, msg, bad, 32),
              "a signature altered at byte " + itoa64(spots[i] as i64) + " is refused");
  }
  // And the wrong hash length, which is a different DER prefix entirely.
  t.isFalse(rsaVerifyPkcs1(k.n, k.e, msg, sig, 48), "the wrong digest size is refused");
  return t.report();
}

export string test_pss_at_every_salt_length(Core core, Cli cli) {
  // PSS is randomised, so there is nothing to compare byte for byte — only acceptance.
  // The salt length is the parameter implementations disagree about, so each is checked
  // against a verifier told the same length.
  T t = T.create();
  u8[] msg = "PSS is randomised".toBytes();
  i32[] salts = i32[](0, 20, 32);
  Lines lines = Lines.create();
  lines.add("rsakeygen 2048");
  for (i32 s = 0; s < salts.len(); s++) {
    // Twice each, because two signatures over one message must differ or the salt is unused.
    lines.add("rsapss 32 " + itoa64(salts[s] as i64) + " " + hex(msg));
    lines.add("rsapss 32 " + itoa64(salts[s] as i64) + " " + hex(msg));
  }
  Answers a = askRsa(t, cli, lines, "a key and six PSS signatures");
  if (!a.ok) { return t.report(); }
  Key k = Key.of(a.lines[0]);
  for (i32 s = 0; s < salts.len(); s++) {
    u8[] sig = valueOf(a.lines[1 + s * 2]);
    t.isTrue(rsaVerifyPss(k.n, k.e, msg, sig, 32, salts[s]),
             "pss with a " + itoa64(salts[s] as i64) + "-byte salt");
    u8[] again = valueOf(a.lines[2 + s * 2]);
    if (salts[s] > 0) {
      // Branchless, for the reason the other comparison in this file is: the *equal* side of
      // `if (sig[i] != again[i])` is a coin flip per byte, so the coverage ledger flickered on it
      // between runs. Or-ing the differences has no branch to be uncovered. `issues/lang/0112`.
      i32 differ = 0;
      for (i32 i = 0; i < sig.len(); i++) { differ = differ | (sig[i] ^ again[i]); }
      t.isTrue(differ != 0, "a salted signature is not deterministic");
    }
    t.isTrue(rsaVerifyPss(k.n, k.e, msg, again, 32, salts[s]), "and the second verifies too");
  }
  return t.report();
}

export string test_pss_refuses_tampering(Core core, Cli cli) {
  T t = T.create();
  u8[] msg = "tamper with this".toBytes();
  Lines lines = Lines.create();
  lines.add("rsakeygen 2048");
  lines.add("rsapss 32 32 " + hex(msg));
  Answers a = askRsa(t, cli, lines, "a key and one PSS signature");
  if (!a.ok) { return t.report(); }
  Key k = Key.of(a.lines[0]);
  u8[] sig = valueOf(a.lines[1]);
  t.isTrue(rsaVerifyPss(k.n, k.e, msg, sig, 32, 32), "the genuine signature verifies");

  i32[] spots = i32[](0, 1, 128, 254, 255);
  for (i32 i = 0; i < spots.len(); i++) {
    u8[] bad = u8[sig.len()]();
    for (i32 j = 0; j < sig.len(); j++) { bad[j] = sig[j]; }
    bad[spots[i]] = bad[spots[i]] ^ 1;
    t.isFalse(rsaVerifyPss(k.n, k.e, msg, bad, 32, 32),
              "pss altered at byte " + itoa64(spots[i] as i64) + " is refused");
  }
  t.isFalse(rsaVerifyPss(k.n, k.e, "another message".toBytes(), sig, 32, 32),
            "a different message is refused");
  // A salt length the signature was not made with. PSS encodes the salt implicitly, so a
  // verifier told the wrong length reconstructs a different DB and must refuse.
  t.isFalse(rsaVerifyPss(k.n, k.e, msg, sig, 32, 20), "the wrong salt length is refused");
  return t.report();
}


// ── Signing ───────────────────────────────────────────────────────────────────

export string test_our_pkcs1_signature_is_byte_identical_to_the_hosts(Core core, Cli cli) {
  // The strongest form available, and the reason it is available: PKCS#1 v1.5 has no salt and no
  // randomness, so one key, one message and one hash admit exactly one signature. Equality with
  // node's therefore checks the padding construction, the digest, the DigestInfo prefix and the
  // modular exponentiation all at once — and unlike "each side accepts the other", it cannot be
  // satisfied by our signer and our verifier being wrong together.
  T t = T.create();
  i32[] bits = i32[](2048, 3072);
  i32[] hashes = i32[](32, 48, 64);
  Lines lines = Lines.create();
  for (i32 b = 0; b < bits.len(); b++) {
    lines.add("rsakeygen " + itoa64(bits[b] as i64));
    lines.add("rsaprivate");
    for (i32 h = 0; h < hashes.len(); h++) {
      lines.add("rsasign " + itoa64(hashes[h] as i64) + " " + hex(fill(64 + h, b * 5 + h)));
    }
  }
  Answers a = askRsa(t, cli, lines, "two keys, their exponents and six signatures");
  if (!a.ok) { return t.report(); }

  for (i32 b = 0; b < bits.len(); b++) {
    Key k = Key.of(a.lines[b * 5]);
    u8[] d = valueOf(a.lines[b * 5 + 1]);
    for (i32 h = 0; h < hashes.len(); h++) {
      u8[] msg = fill(64 + h, b * 5 + h);
      u8[] theirs = valueOf(a.lines[b * 5 + 2 + h]);
      u8[] ours = rsaSignPkcs1(k.n, d, msg, hashes[h]);
      t.eqI32(ours.len(), theirs.len(), "signature width at " + itoa64(bits[b] as i64) + " bits");
      i32 diff = 0;
      for (i32 i = 0; i < theirs.len() && i < ours.len(); i++) { diff = diff | (ours[i] ^ theirs[i]); }
      t.eqI32(diff, 0, "sha-" + itoa64((hashes[h] * 8) as i64) + " at " +
              itoa64(bits[b] as i64) + " bits is byte-identical to node's");
    }
  }
  return t.report();
}

export string test_the_host_accepts_what_we_signed(Core core, Cli cli) {
  // Byte-identity above already implies this, but only while node's signer stays deterministic —
  // and it is node that decides that, not us. This asks the question the caller actually cares
  // about, which is whether an independent verifier accepts our output.
  T t = T.create();
  Lines first = Lines.create();
  first.add("rsakeygen 2048");
  first.add("rsaprivate");
  Answers keys = askRsa(t, cli, first, "a key and its exponent");
  if (!keys.ok) { return t.report(); }
  Key k = Key.of(keys.lines[0]);
  u8[] d = valueOf(keys.lines[1]);

  u8[] msg = "a relay identity crosscert, more or less".toBytes();
  u8[] sig = rsaSignPkcs1(k.n, d, msg, 32);
  t.eqI32(sig.len(), 256, "a 2048-bit signature is 256 bytes");

  // The second round is what the host judges. Both claims travel together, so the batch says
  // "accept this one and refuse that one" and a verifier answering the same to both fails once.
  Lines judged = Lines.create();
  judged.add("rsapub " + hex(k.n) + " " + hex(k.e));
  judged.add("rsaverify 32 " + hex(sig) + " " + hex(msg) + " 1");
  // And it is a signature over *this* message, not merely a well-formed block. Without this the
  // test would pass for a signer that ignored its input.
  judged.add("rsaverify 32 " + hex(sig) + " " +
             hex("a different message entirely".toBytes()) + " 0");
  askRsa(t, cli, judged, "node's verdict on ours");

  // Our own verifier agrees, which is the weak direction and is labelled as such.
  t.isTrue(rsaVerifyPkcs1(k.n, k.e, msg, sig, 32), "and we verify it ourselves");
  return t.report();
}

export string test_a_raw_signature_carries_exactly_the_payload(Core core, Cli cli) {
  // `rsaSignRawPkcs1` is the one Tor needs: a bare digest in PKCS#1 padding with no DigestInfo.
  // node cannot verify that with `createVerify`, because there is nothing naming an algorithm — so
  // the check is `RSA_public_decrypt`, which is the verify primitive and returns the payload.
  T t = T.create();
  Lines first = Lines.create();
  first.add("rsakeygen 2048");
  first.add("rsaprivate");
  Answers keys = askRsa(t, cli, first, "a key and its exponent");
  if (!keys.ok) { return t.report(); }
  Key k = Key.of(keys.lines[0]);
  u8[] d = valueOf(keys.lines[1]);

  // Twenty bytes, because that is a SHA-1 digest and SHA-1 is what Tor's older signatures carry.
  u8[] payload = fill(20, 9);
  u8[] sig = rsaSignRawPkcs1(k.n, d, payload);
  t.eqI32(sig.len(), 256, "raw signature is a full modulus wide");
  // A 32-byte payload too, since Tor signs SHA-256 digests in newer places.
  u8[] p32 = fill(32, 4);

  Lines second = Lines.create();
  second.add("rsapub " + hex(k.n) + " " + hex(k.e));
  second.add("rsarecover " + hex(sig));
  second.add("rsarecover " + hex(rsaSignRawPkcs1(k.n, d, p32)));
  Answers r = askRsa(t, cli, second, "what node recovers");
  if (!r.ok) { return t.report(); }

  u8[] got = valueOf(r.lines[0]);   // `rsapub` answers nothing, so the recoveries are 0 and 1
  t.eqI32(got.len(), payload.len(), "node recovered a payload of the right length");
  i32 diff = 0;
  for (i32 i = 0; i < got.len() && i < payload.len(); i++) { diff = diff | (got[i] ^ payload[i]); }
  t.eqI32(diff, 0, "node recovers exactly the payload we signed");

  // Round trip through our own recover, which is what `packages/tor` will actually call.
  u8[] mine = rsaRecoverPkcs1(k.n, k.e, sig);
  t.eqI32(mine.len(), payload.len(), "our recover returns the payload");
  t.eqI32(valueOf(r.lines[1]).len(), 32, "a 32-byte payload recovers at its own length");
  return t.report();
}

export string test_a_forged_block_that_is_wrong_in_one_place_is_refused(Core core, Cli cli) {
  // The gap `test_pkcs1_refuses_a_block_that_is_not_exact` names above and could not close: its
  // perturbations turn the whole block to garbage after exponentiation, so every strictness check
  // refuses and none of them is reached individually. Closing it needs a block that is correct
  // everywhere *except* one place, which needs the private key to construct — and now there is one.
  //
  // This is Bleichenbacher's 2006 forgery in the form that matters here: each block below is what a
  // lax verifier would accept and a strict one must not.
  T t = T.create();
  Lines first = Lines.create();
  first.add("rsakeygen 2048");
  first.add("rsaprivate");
  Answers keys = askRsa(t, cli, first, "a key and its exponent");
  if (!keys.ok) { return t.report(); }
  Key k = Key.of(keys.lines[0]);
  u8[] d = valueOf(keys.lines[1]);
  i32 emLen = k.n.len();
  u8[] msg = "the message under all of these".toBytes();

  // The correct block, assembled here rather than taken from `rsaSignPkcs1`, so a bug shared with
  // the signer cannot make every case below vacuous.
  u8[] prefix = u8[](0x30, 0x31, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65,
                     0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20);
  u8[] h = sha256(msg);
  i32 tLen = prefix.len() + 32;

  u8[] good = u8[emLen]();
  good[1] = 0x01;
  i32 padEnd = emLen - tLen - 1;
  for (i32 i = 2; i < padEnd; i++) { good[i] = 0xFF; }
  for (i32 i = 0; i < prefix.len(); i++) { good[padEnd + 1 + i] = prefix[i]; }
  for (i32 i = 0; i < 32; i++) { good[padEnd + 1 + prefix.len() + i] = h[i]; }
  t.isTrue(rsaVerifyPkcs1(k.n, k.e, msg, signBlock(k.n, d, good), 32),
           "the hand-built correct block verifies, so the forgeries below mean something");
  // 1. The digest right, the padding short — the classic. A verifier that scans forward for 0x00
  //    instead of requiring 0xFF everywhere accepts this.
  u8[] shortPad = copyOf(good);
  shortPad[10] = 0x00;
  t.isFalse(rsaVerifyPkcs1(k.n, k.e, msg, signBlock(k.n, d, shortPad), 32),
            "a padding run broken early is refused");

  // 2. The block type wrong. 0x02 is the *encryption* block type; accepting it confuses two
  //    operations that must never be interchangeable.
  u8[] wrongType = copyOf(good);
  wrongType[1] = 0x02;
  t.isFalse(rsaVerifyPkcs1(k.n, k.e, msg, signBlock(k.n, d, wrongType), 32),
            "block type 0x02 is refused");

  // 3. The leading byte non-zero.
  u8[] leading = copyOf(good);
  leading[0] = 0x01;
  t.isFalse(rsaVerifyPkcs1(k.n, k.e, msg, signBlock(k.n, d, leading), 32),
            "a non-zero leading byte is refused");

  // 4. The DigestInfo naming a different algorithm, over the same SHA-256 digest. This is the
  //    substitution the prefix exists to prevent.
  u8[] wrongAlgo = copyOf(good);
  wrongAlgo[padEnd + 1 + 14] = 0x02;             // the OID's last byte: sha256 -> sha384
  t.isFalse(rsaVerifyPkcs1(k.n, k.e, msg, signBlock(k.n, d, wrongAlgo), 32),
            "a DigestInfo naming the wrong algorithm is refused");

  // 5. The separator missing — 0xFF where the single 0x00 that ends the padding belongs. The run and
  //    the DigestInfo are both still exactly right, at exactly their offsets, so this is the one
  //    forgery that no other check can catch: it exists because planting each check away in turn
  //    showed the separator's was the only one nothing reached.
  u8[] noSeparator = copyOf(good);
  noSeparator[padEnd] = 0xFF;
  t.isFalse(rsaVerifyPkcs1(k.n, k.e, msg, signBlock(k.n, d, noSeparator), 32),
            "a padding run with no terminator is refused");

  // 6. The digest itself wrong by one bit, everything else exact.
  u8[] wrongHash = copyOf(good);
  wrongHash[emLen - 1] = wrongHash[emLen - 1] ^ 1;
  t.isFalse(rsaVerifyPkcs1(k.n, k.e, msg, signBlock(k.n, d, wrongHash), 32),
            "a digest wrong in its last bit is refused");
  return t.report();
}

/** `em^d mod n`, with no padding of our own — the test builds the block. */
u8[] signBlock(u8[] n, u8[] d, u8[] em) {
  Big modulus = fromBytes(n);
  return toBytes(modPowSecret(fromBytes(em), fromBytes(d), modulus, 2048), n.len());
}

u8[] copyOf(u8[] src) {
  u8[] o = u8[src.len()]();
  for (i32 i = 0; i < src.len(); i++) { o[i] = src[i]; }
  return o;
}

/**
 * The direction PSS had never been checked in: **we** sign and node verifies.
 *
 * Every PSS case above has node signing and us verifying, which establishes that our verifier reads
 * their encoding and says nothing whatever about ours producing one. That gap is not hypothetical for
 * this algorithm — the encoding has a masked block, a salt recovered from the signature itself, and a
 * final step that clears bits the modulus has no room for. A signer can get any of those wrong and
 * still produce something *our own verifier* accepts, because the two would be wrong together.
 *
 * TLS 1.3 needs exactly this: `rsa_pss_rsae_sha256` in CertificateVerify, which is the only way a
 * server presenting an RSA certificate can complete a handshake.
 */
export string test_our_pss_signatures_verify_elsewhere(Core core, Cli cli) {
  T t = T.create();
  Lines first = Lines.create();
  first.add("rsakeygen 2048");
  first.add("rsaprivate");
  first.add("rsakeygen 512");
  first.add("rsaprivate");
  Answers keys = askRsa(t, cli, first, "two keys and their exponents");
  if (!keys.ok) { return t.report(); }
  Key k = Key.of(keys.lines[0]);
  u8[] d = valueOf(keys.lines[1]);
  Key tiny = Key.of(keys.lines[2]);
  u8[] tinyD = valueOf(keys.lines[3]);
  u8[] msg = "a signature nobody here produced the verifier for".toBytes();

  i32[] salts = i32[](0, 20, 32);
  Lines judged = Lines.create();
  judged.add("rsapub " + hex(k.n) + " " + hex(k.e));
  for (i32 s = 0; s < salts.len(); s++) {
    u8[] salt = u8[salts[s]]();
    for (i32 i = 0; i < salt.len(); i++) { salt[i] = (i * 47 + 13) & 0xFF; }
    u8[] sig = rsaSignPss(k.n, d, msg, 32, salt);
    t.eqI32(sig.len(), k.n.len(), "a signature the width of the modulus");
    judged.add("rsapssverify 32 " + itoa64(salts[s] as i64) + " " + hex(sig) + " " + hex(msg) +
               " 1");

    // And our own verifier agrees, which is the weaker claim and worth stating as such: it would hold
    // even if both halves were wrong in the same way.
    t.isTrue(rsaVerifyPss(k.n, k.e, msg, sig, 32, salts[s]), "and so does ours");
  }
  askRsa(t, cli, judged, "node's verdict on our PSS");

  // The salt reaches the signature: two different salts must give two different signatures, or the
  // parameter is being ignored and every signature over one message is the same bytes.
  u8[] saltA = u8[32](fill: 1);
  u8[] saltB = u8[32](fill: 2);
  u8[] sigA = rsaSignPss(k.n, d, msg, 32, saltA);
  u8[] sigB = rsaSignPss(k.n, d, msg, 32, saltB);
  // Branchless, and not for speed: `if (sigA[i] != sigB[i])` has an *equal* side whose coverage is a
  // coin flip per byte — two signatures over different salts differ almost everywhere, and whether any
  // byte happens to coincide is chance. A ratchet cannot demand a branch like that, and listing it as
  // unreached is wrong on the runs where it is reached. Or-ing the differences has no branch at all.
  i32 diff = 0;
  for (i32 i = 0; i < sigA.len(); i++) { diff = diff | (sigA[i] ^ sigB[i]); }
  t.isTrue(diff != 0, "the salt is actually used");

  // A key with no room for the encoding is an error rather than a short signature. 32-byte hash plus
  // a 32-byte salt plus two needs 66 bytes; a 512-bit modulus has 64. Its key was fetched in the
  // first batch above, because selecting it there would have changed which key the verdicts used.
  t.eqI32(rsaSignPss(tiny.n, tinyD, msg, 32, u8[32]()).len(), 0,
          "a 512-bit key cannot hold a 32-byte hash and a 32-byte salt");
  return t.report();
}

/**
 * The refusals on the *signing* side, and in `rsaRecoverPkcs1`, which nothing reached.
 *
 * Every check below returns an empty array rather than trapping or producing a short block, and
 * each was fourteen uncovered branch points until this test existed (issues/system 0101). They are
 * reachable only with a modulus nobody would use — the honest inputs all have 2048 bits and a top
 * bit set — so no differential against `node:crypto` can produce them: node will not hold a
 * three-byte key to compare against.
 *
 * The assertion is deliberately the weakest true one. "Returns empty" is what the caller can rely
 * on; asserting a particular block would be asserting this implementation's choice of how to fail.
 */
export string test_signing_refuses_moduli_it_cannot_use() {
  T t = T.create();

  // `padPkcs1`: a modulus too small to hold the payload plus eleven bytes of padding, which is
  // PKCS#1's minimum rather than a preference. The empty block then reaches `rawSign`'s first
  // guard, so one input covers both.
  u8[] tiny = u8[16]();
  tiny[0] = 0xC0;
  u8[] d = u8[16]();
  d[15] = 3;
  t.eqI32(rsaSignRawPkcs1(tiny, d, u8[10]()).len(), 0, "a payload that will not fit is refused");

  // `rawSign`: a zero modulus. The padding fits, so this reaches the exponentiation guard rather
  // than the length one — which is the distinction the two checks exist to make.
  u8[] zero = u8[32]();
  t.eqI32(rsaSignRawPkcs1(zero, d, u8[4]()).len(), 0, "a zero modulus is refused when signing");
  t.eqI32(rsaSignPkcs1(zero, d, "m".toBytes(), 32).len(), 0, "and through the hashing signer");
  t.eqI32(rsaSignPss(zero, d, "m".toBytes(), 32, u8[0]()).len(), 0, "and through PSS");

  // `rawSign`: a padded block that is numerically at or above the modulus. `em` begins 0x00 0x01
  // 0xFF…, so this needs a modulus that is tiny for its width — three, in thirty-two bytes.
  u8[] three = u8[32]();
  three[31] = 3;
  t.eqI32(rsaSignRawPkcs1(three, d, u8[4]()).len(), 0, "a block at or above the modulus is refused");

  // `rsaSignPss`: `emLen` is derived from the modulus's *bit* length, so a leading zero byte makes
  // the encoded message shorter than the modulus and the result has to be left-padded. Real keys
  // never take this path, because a generated modulus has its top bit set.
  u8[] shortTop = u8[64]();
  shortTop[1] = 0x7F;
  for (i32 i = 2; i < 64; i++) { shortTop[i] = 0xFF; }
  u8[] dd = u8[64]();
  dd[63] = 3;
  t.isTrue(rsaSignPss(shortTop, dd, "m".toBytes(), 32, u8[0]()).len() == 64,
           "a modulus with a zero top byte still signs to its full width");

  return t.report();
}

/**
 * `rsaRecoverPkcs1`'s refusals, which are the same shape: a malformed block is empty, not partial.
 *
 * It is the primitive behind reading a signature whose payload is not a DigestInfo — a Tor relay's
 * crosscert — so a caller that accepted a short answer would be reading attacker-chosen bytes.
 */
export string test_recovering_refuses_malformed_blocks() {
  T t = T.create();
  u8[] n = u8[32]();
  n[0] = 0xC0;
  u8[] e = u8[3]();
  e[0] = 1; e[2] = 1;                                    // 65537

  t.eqI32(rsaRecoverPkcs1(n, e, u8[31]()).len(), 0, "a signature of the wrong length is refused");
  t.eqI32(rsaRecoverPkcs1(u8[32](), e, u8[32]()).len(), 0, "a zero modulus is refused");
  // s = n exactly, which is the boundary of "below the modulus" rather than a value beyond it.
  t.eqI32(rsaRecoverPkcs1(n, e, n).len(), 0, "a signature at the modulus is refused");
  // A block that exponentiates to something that is not 0x00 0x01: e = 1 makes the recovery the
  // identity, so the signature *is* the block and every remaining check can be aimed at directly.
  u8[] one = u8[3]();
  one[2] = 1;
  u8[] em = u8[32]();
  em[1] = 0x02;
  t.eqI32(rsaRecoverPkcs1(n, one, em).len(), 0, "a block that is not type 1 is refused");
  // All 0xFF after the header: the run walks off the end without ever meeting its terminator.
  u8[] runs = u8[32]();
  runs[1] = 0x01;
  for (i32 i = 2; i < 32; i++) { runs[i] = 0xFF; }
  t.eqI32(rsaRecoverPkcs1(n, one, runs).len(), 0, "padding with no terminator is refused");
  // A byte that is neither 0xFF nor the 0x00 that ends the run.
  u8[] stray = u8[32]();
  stray[1] = 0x01;
  for (i32 i = 2; i < 20; i++) { stray[i] = 0xFF; }
  stray[20] = 0x7E;
  t.eqI32(rsaRecoverPkcs1(n, one, stray).len(), 0, "a stray byte in the padding is refused");
  // Fewer than eight 0xFF bytes before the terminator, which PKCS#1 forbids outright.
  u8[] shortPad = u8[32]();
  shortPad[1] = 0x01;
  for (i32 i = 2; i < 6; i++) { shortPad[i] = 0xFF; }
  t.eqI32(rsaRecoverPkcs1(n, one, shortPad).len(), 0, "fewer than eight padding bytes is refused");
  return t.report();
}

/**
 * **A signature with bits set above `emBits` is refused.**
 *
 * PSS encodes into `emBits` bits, one fewer than the modulus, so the top byte of the encoded message
 * has unused leading bits that must be zero. Nothing in the rest of verification reads them: the
 * masked block is decoded, the salt is recovered, and the hash comparison succeeds whatever those
 * bits hold. Without this check a signature is **malleable** — flip them and you have a second byte
 * string that verifies for the same message, which is what a protocol pinning "the signature" as an
 * identifier does not survive.
 *
 * Built by hand rather than from the host's signer, because a signer produces the *valid* form by
 * construction and this needs the invalid one. `e = 1` makes `m = s mod n`, so the encoded message is
 * the signature itself and every byte of it is chosen here — the same trick
 * `test_pkcs1_refuses_a_block_that_is_not_exact` uses for its forgeries. `issues/lang/0112`.
 */
export string test_pss_refuses_a_signature_with_bits_above_embits() {
  T t = T.create();

  // 40 bytes with the top bit set: 320 bits, so `emBits` is 319 and one bit of the first byte is
  // unused. A shorter modulus cannot hold a 32-byte hash plus two.
  u8[] n = u8[40]();
  for (i32 i = 0; i < 40; i++) { n[i] = 0xFF; }
  u8[] e = u8[1]();
  e[0] = 1;
  u8[] msg = "malleable".toBytes();

  // The encoded message, ending in the trailer PSS requires so the check before this one passes.
  u8[] em = u8[40]();
  em[39] = 0xBC;

  // With that one bit clear the signature is refused later, for the ordinary reason: the recovered
  // salt does not match. What matters is that it gets that far.
  t.isFalse(rsaVerifyPss(n, e, msg, em, 32, 0), "a well-formed but wrong signature is refused");

  // With it set, verification stops at the unused-bits check — a different refusal for a different
  // reason, and the one that keeps the signature from being malleable.
  em[0] = 0x80;
  t.isFalse(rsaVerifyPss(n, e, msg, em, 32, 0), "and so is one with a bit above emBits");

  return t.report();
}

// ── Modular exponentiation, against BigInt ───────────────────────────────────
//
// Everything above rests on this, and it is the one piece that can be checked without a key. Every
// signature test in this file would pass with a `modPow` that was wrong for inputs the key material
// never produces — a fault in the carries a hundred limbs up says nothing about `3^5 mod 7`, and a
// fault in the reduction of a base larger than the modulus never arises when the base is a padded
// block. So the cases here are the shapes a signature never has.
//
// Host-side until 2026-08-17, `issues/system/0161`.

/** A case as three 32-byte big-endian hex strings, which is the width `modPow` is driven at. */
struct ModCase {
  string base;
  string exp;
  string mod;
  string what;
}

export string test_modular_exponentiation_agrees_with_bigint(Core core, Cli cli) {
  T t = T.create();
  ModCase[] cases = ModCase[](
    ModCase("…3", "…5", "…7", "the textbook case"),
    ModCase("…2", "…10001", "…ca1", "a small RSA-shaped exponent"),
    ModCase("…0", "…10001", "…ca1", "a zero base"),
    ModCase("…1", "…10001", "…ca1", "a base of one"),
    ModCase("…75bcd15", "…10001", "…7fffffffffffffffffffffffffffffff", "a Mersenne-ish modulus"),
    // A base larger than the modulus, which must be reduced first.
    ModCase("…0100000000000000000000000000000000000000000000007", "…3",
            "…1fffffffffffffff", "a base larger than the modulus"),
    // An even modulus, which divmod must still handle.
    ModCase("…3039", "…11", "…10000000000000000", "an even modulus"),
    // **A non-palindromic exponent**, which none of the above is. 5 is 101, 3 is 11, 17 is 10001
    // and 65537 is 1 then fifteen zeros then 1 — every one reads the same backwards, so the whole
    // list survives a square-and-multiply loop that walks the exponent's bits the wrong way round.
    // Found by planting exactly that fault and watching nothing fail.
    ModCase("…7", "…6", "…d", "6 is 110, so the bit order is finally observable"),
    ModCase("…5", "…64", "…3b9aca07", "and 100 is 1100100"));

  Lines lines = Lines.create();
  for (i32 i = 0; i < cases.len(); i++) {
    u8[] b = wide(cases[i].base);
    u8[] e = wide(cases[i].exp);
    u8[] m = wide(cases[i].mod);
    u8[] got = toBytes(modPow(fromBytes(b), fromBytes(e), fromBytes(m)), 32);
    lines.add("modexp " + hex(b) + " " + hex(e) + " " + hex(m) + " " + hex(got));
  }
  check(t, cli, "node", string[](ORACLE), lines, "nine modular exponentiations");
  return t.report();
}

/** A `…`-prefixed hex literal, left-padded to 32 bytes. */
u8[] wide(string h) {
  string body = h.slice(3, h.len());        // the ellipsis is three bytes in UTF-8
  string padded = body;
  while (padded.len() < 64) { padded = "0" + padded; }
  return decoded(padded);
}

/**
 * A 1024-bit key, so this file can sign as well as verify.
 *
 * **Every test above verifies; none of them signed**, because signing needs a private exponent and the
 * openssl-driven tests generate their keys inside the oracle. So `rsaSignPss` — which is what
 * `packages/tls/src/server.wac` and `packages/quic/src/server.wac` sign handshakes with — and the
 * success path of `rsaRecoverPkcs1`, which `packages/tor/src/consensus.wac` reads router descriptors
 * with, were reached by no test in the package that owns them. The coverage ledger named six lines and
 * nothing else did.
 *
 * Generated once with `openssl genrsa 1024` and written here because a key is the one input these
 * paths cannot be given any other way. 1024 bits rather than 2048 because the cost is a private-key
 * `modPow` and this is a test of the encoding, not of the modulus.
 */
u8[] testModulus() {
  return decoded(
         "c8c1e3925ada6299cf3922834b00085ffcb65f6b0f0103750754f443ceaa" +
         "ee6d390605b2090444e0f60fdb2ebcfc1720a432232bc76f10fc7604431a" +
         "2b766b55ed758f2d13570a9fe989595207ff42753aa50fde2901e7721057" +
         "b55c8063d2b4a6ae86d9a837acce40937a5e97ed8f4800c9ec6dc76b6872" +
         "7009256e086b0223");
}

u8[] testPrivateExponent() {
  return decoded(
         "23c76a678b09a0c908c58601203cc1415a28a698cdf3c049fb2488e40cd1" +
         "29ed0d5ca56735742d526a8828e80b866218cf2aa05a0d111e55e032a242" +
         "e7bc1324cc08dc93939d47a9967c5708552fe79eb8f7b93d10fcc5fe3ebc" +
         "0f6f6ae7ce7b05bd18c92e5b3aa4b40617aad01e4f8ca388b52fee4103d9" +
         "2a192baf5316d101");
}

/** 65537, as every generator emits it. */
u8[] testPublicExponent() { return decoded("010001"); }

/**
 * A key too small to hold the PSS encoding is refused rather than made to fit.
 *
 * RFC 8017 calls it an encoding error, and it is the one PSS failure that is a property of the *key*
 * rather than of the signature: 32 bytes of hash, 32 of salt and two of framing need 66, so a 64-byte
 * modulus cannot carry it however the caller pads. No `modPow` runs, which is why this needs no key.
 */
export string test_pss_refuses_a_key_too_small_for_the_encoding() {
  T t = T.create();
  u8[] small = u8[64]();
  for (i32 i = 0; i < 64; i++) { small[i] = 0xFF; }
  u8[] salt = u8[32]();
  t.eqI32(rsaSignPss(small, small, "anything".toBytes(), 32, salt).len(), 0,
          "a 64-byte modulus cannot hold 32 + 32 + 2 and the sign must refuse");
  return t.report();
}

/**
 * A PSS signature this package made, verified by this package.
 *
 * A round trip through one implementation cannot catch a mistake both halves share — the KAT against
 * openssl above is what covers that — but it catches every *asymmetric* one, and it is the only thing
 * here that runs the signing path at all. The salt is fixed rather than random so the signature is a
 * function of its inputs.
 */
export string test_a_pss_signature_we_made_verifies_here() {
  T t = T.create();
  u8[] n = testModulus();
  u8[] e = testPublicExponent();
  u8[] d = testPrivateExponent();
  u8[] msg = "the message that was signed".toBytes();
  u8[] salt = u8[32]();
  for (i32 i = 0; i < 32; i++) { salt[i] = (i * 7 + 3) & 0xFF; }

  u8[] sig = rsaSignPss(n, d, msg, 32, salt);
  t.eqI32(sig.len(), n.len(), "the signature is one modulus wide");
  if (sig.len() != n.len()) { return t.report(); }
  t.isTrue(rsaVerifyPss(n, e, msg, sig, 32, 32), "our own PSS signature did not verify");

  // The canary: a signature that verifies for the wrong message would mean the hash never entered it.
  t.isFalse(rsaVerifyPss(n, e, "a different message".toBytes(), sig, 32, 32),
            "the signature verified against a message it was not made over");
  sig[sig.len() - 1] = sig[sig.len() - 1] ^ 0x01;
  t.isFalse(rsaVerifyPss(n, e, msg, sig, 32, 32), "a signature with one bit flipped still verified");
  return t.report();
}

/**
 * What `rsaRecoverPkcs1` recovers is what was signed — the path tor reads descriptors with.
 *
 * Every other test of this function hands it a malformed block and checks the refusal; this is the
 * first that gives it a well-formed one, which is the whole reason the copy at the end of it was
 * uncovered. The padding matters: a 128-byte modulus over a short payload leaves far more than the
 * eight bytes of `0xFF` the format requires, which is the check just above the copy.
 */
export string test_a_pkcs1_signature_recovers_the_payload_it_carried() {
  T t = T.create();
  u8[] n = testModulus();
  u8[] e = testPublicExponent();
  u8[] d = testPrivateExponent();
  u8[] payload = sha256("what tor puts in a descriptor".toBytes());

  u8[] sig = rsaSignRawPkcs1(n, d, payload);
  t.eqI32(sig.len(), n.len(), "the signature is one modulus wide");
  if (sig.len() != n.len()) { return t.report(); }

  u8[] back = rsaRecoverPkcs1(n, e, sig);
  t.eqI32(back.len(), payload.len(), "the recovered payload is the length that went in");
  if (back.len() != payload.len()) { return t.report(); }
  bool same = true;
  for (i32 i = 0; i < payload.len(); i++) { if (back[i] != payload[i]) { same = false; } }
  t.isTrue(same, "the recovered payload is not the one that was signed");

  // And a block that is not this key's answer recovers nothing rather than something.
  sig[0] = sig[0] ^ 0x01;
  t.eqI32(rsaRecoverPkcs1(n, e, sig).len(), 0, "a corrupted block recovered a payload");
  return t.report();
}
