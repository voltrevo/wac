// SHA-1 against node:crypto and the published vectors.
//
// The incremental interface is the part worth testing hardest, because it is the reason
// this exists. Tor's relay cell digest is a *running* hash over every cell sent on a
// circuit in one direction, and each cell carries the first four bytes of the hash so far
// — so the state survives between cells and has to be readable without ending the stream.
// A one-shot implementation cannot express that, and an incremental one that gets `peek`
// wrong produces a first cell that verifies and a second that does not.
//
// ## Where the oracle comes from
//
// It used to arrive as a callback: `sha1_wac.test.ts` bound `node:crypto`'s `createHash` and
// `harness/wacTestRun.ts` handed it in, because a wasm call cannot await and a *synchronous* host
// function was the only way in. That made this one of ten files `wac test` had to skip — it could
// compile them and not supply what they asked for.
//
// It is a subprocess now, in the direction everything else here uses: compute every digest, hand
// the batch over once, and let `test/oracle.mjs` report only what it disagrees with. One process
// per test rather than one call per case, and no host lane needed to run the file at all.

import { T } from "../../../wactest/src/assert.wac";
import { Lines, check, hex } from "../../../wactest/src/oracle.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";
import { Core, Cli } from "std/platform.wac";
import { sha1, Sha1 } from "../../src/sha1.wac";
import { slice } from "../../../bytes/src/slice.wac";
import { decoded } from "../../../codec/src/hex.wac";

const string ORACLE = "packages/crypto/test/oracle.mjs";

/** Ask node — a `sha1 <msg> <claimed>` line per digest this file computed. */
void checkSha1(T t, Cli cli, Lines lines, string what) {
  check(t, cli, "node", string[](ORACLE), lines, what);
}

/** A `sha1` line: the message, and what we say its digest is. */
void claim(Lines lines, u8[] msg, u8[] digest) {
  lines.add("sha1 " + hex(msg) + " " + hex(digest));
}
u8[] fill(i32 n, i32 seed) {
  u8[] o = u8[n]();
  for (i32 i = 0; i < n; i++) { o[i] = (i * 37 + seed) & 0xFF; }
  return o;
}

export string test_the_published_vectors() {
  // FIPS 180-4's worked examples, including the 56-byte case that forces a second block
  // for the length alone.
  T t = T.create();
  t.eqBytes(sha1("".toBytes()), decoded("da39a3ee5e6b4b0d3255bfef95601890afd80709"),
            "sha1 of the empty string");
  t.eqBytes(sha1("abc".toBytes()), decoded("a9993e364706816aba3e25717850c26c9cd0d89d"),
            "sha1 abc");
  t.eqBytes(sha1("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".toBytes()),
            decoded("84983e441c3bd26ebaae4aa1f95129e5e54670f1"),
            "the 56-byte vector, which needs an extra block for the length");
  return t.report();
}

export string test_every_length_through_two_blocks(Core core, Cli cli) {
  // Every length rather than the boundaries, since it is cheap and picking cleverly is a
  // chance to pick wrongly. 0 to 130 covers both block edges and the padding cases either
  // side of 56.
  T t = T.create();
  Lines lines = Lines.create();
  for (i32 n = 0; n <= 130; n++) {
    u8[] m = fill(n, n);
    claim(lines, m, sha1(m));
  }
  t.eqI32(lines.n, 131, "one claim per length");
  checkSha1(t, cli, lines, "every length through two blocks");
  return t.report();
}

export string test_the_incremental_form_matches_the_one_shot(Core core, Cli cli) {
  // Split at every offset, because a buffer that mishandles a partial block is right for
  // whole-block feeds and wrong for the rest — which is exactly how Tor will use it, one
  // 509-byte cell payload at a time into a 64-byte block.
  //
  // Every split claims the *same* message, so a batch of thirty identical `sha1` lines with
  // thirty different digests is what a broken buffer produces — and node rejects each of them by
  // name.
  T t = T.create();
  Lines lines = Lines.create();
  u8[] msg = fill(200, 5);
  for (i32 cut = 0; cut <= 200; cut = cut + 7) {
    Sha1 s = Sha1.create();
    s.update(slice(msg, 0, cut));
    s.update(slice(msg, cut, 200));
    claim(lines, msg, s.finish());
  }
  // And a byte at a time, which is every boundary at once.
  Sha1 one = Sha1.create();
  for (i32 i = 0; i < msg.len(); i++) { one.update(slice(msg, i, i + 1)); }
  claim(lines, msg, one.finish());
  checkSha1(t, cli, lines, "the incremental form");
  return t.report();
}

export string test_peek_does_not_end_the_stream(Core core, Cli cli) {
  // The property Tor depends on. After hashing a prefix, `peek` must give that prefix's
  // digest *and* leave the state able to continue — an implementation that finalised in
  // place would give a correct first answer and rubbish after it.
  T t = T.create();
  Lines lines = Lines.create();
  u8[] a = fill(100, 1);
  u8[] b = fill(37, 2);
  Sha1 s = Sha1.create();
  s.update(a);
  claim(lines, a, s.peek());                    // peek gives the digest so far
  claim(lines, a, s.peek());                    // and does not change anything when repeated
  s.update(b);

  u8[] both = u8[a.len() + b.len()]();
  for (i32 i = 0; i < a.len(); i++) { both[i] = a[i]; }
  for (i32 i = 0; i < b.len(); i++) { both[a.len() + i] = b[i]; }
  claim(lines, both, s.peek());                 // the stream continued correctly past it
  u8[] finished = s.finish();
  claim(lines, both, finished);                 // finish agrees with the last peek
  checkSha1(t, cli, lines, "peek");
  return t.report();
}

export string test_a_long_message_crosses_many_blocks(Core core, Cli cli) {
  T t = T.create();
  Lines lines = Lines.create();
  i32[] lens = i32[](511, 512, 513, 1000, 4096);
  for (i32 i = 0; i < lens.len(); i++) {
    u8[] m = fill(lens[i], i);
    claim(lines, m, sha1(m));
  }
  checkSha1(t, cli, lines, "long messages");
  return t.report();
}
