// Does any of this behave differently for different secrets?
//
// A traced build records an ordered journal of branches *and array indices*, and `wac ctcompare`
// says where two runs' journals first part. Two runs that differ only in a secret must not part. Read
// `spec/cli/wac.md`'s `ctcompare` clause for what a pass does and does not mean — in short, a pass is
// evidence for the inputs tested, a failure is definite.
//
// The package is not constant-time and does not claim to be. These tests exist so that claim is a
// *measurement* rather than a disclaimer: what is uniform is pinned so it stays uniform, and what
// leaks is named at the line it leaks on.
//
// ## Host-side until 2026-08-19, `issues/system/0161`
//
// `0161` had this file down as **the one shape a wac program cannot express at all**, because
// the harness that instantiated a module and walked its journal in process. The premise was about
// the language and not the toolchain: `wac build --trace` and `wac ctcompare` are two commands now,
// and the comparison happens where the modules are. `p256PublicKey` produces about three million
// events, so shipping both journals out as text to be compared here would be tens of megabytes for
// one number; `ctcompare` answers in a line, in about half a second.
//
// **A run is a program, not a call.** The TypeScript instantiated once and called an export with each
// secret. `ctcompare` runs `main`, so each secret is its own module — and the drivers must therefore
// differ *only in their data*. `main`'s own points are in the journal, so a pair written with
// different shapes parts at event 1, which is the driver rather than the routine. Every driver here
// comes from one template with one array literal substituted.
//
// ## What it costs, and why that is builds rather than crypto — 2026-08-19
//
// **14.8s to 6.8s by starting the builds together.** Every comparison needs two *modules*, because
// `ctcompare` runs `main` and a run is therefore a program; the four secrets of a uniform routine are
// four programs differing in one array literal, and each is a `wac build --trace` process that
// compiles the routine and its imports again. Twenty-eight builds for seven routines, and they were
// serial — so the file cost the sum of them rather than the slowest.
//
// Nothing here depends on another, so they are submitted and then collected. That is a thing wac could
// not do until `issues/system/0211`: both Rust hosts ran the child to completion inside `exec` and
// handed back a ticket that had already settled, so four tickets taken before any wait still took four
// times as long.
//
// Measured with `--filter`, which is per-file: the floor is **0.6s** — `wac test` compiling this file
// and running nothing — and each test is about **1s** on top of it. So this file is its builds. What
// would move it further is the compiler not re-compiling `sha256.wac` for each of four drivers, which
// is the same floor `packages/wacc/test/wac/corpuscheck_test.wac` reaches from the other side: an
// incremental front end. The tracing itself is not the cost — `p256PublicKey` is three million events
// and `ctcompare` answers about them in half a second.
//
// **`same` is checked to carry a count.** Two journals of nothing match perfectly, and a mistyped
// export name is a call that never happens.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli, Exec, Change, FileResult, Pending } from "std/platform.wac";
import { contains, startsWith, trimmed, splitLines } from "../../../wactest/src/strings.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { builtProgram, writeIfDifferent } from "../../../wactest/src/built.wac";

string root(Cli cli) { return cli.cwd().wait(); }
string binary(Cli cli) { return root(cli) + "/native/v8/target/release/wac"; }

/**
 * Structured secrets, not random ones: a leak shows at the extremes first.
 *
 * `keyOf(n)` is the `n`th of four — all zero, all 0xFF, a stride, and one bit set — at `len` bytes,
 * which for 32 is the 16-byte key written twice, as the TypeScript's `KEYS32` was.
 */
i32[] keyOf(i32 which, i32 len) {
  i32[] out = i32[len]();
  for (i32 i = 0; i < len; i++) {
    i32 j = i % 16;
    if (which == 0) { out[i] = 0; }
    else if (which == 1) { out[i] = 255; }
    else if (which == 2) { out[i] = (j * 37) & 255; }
    else { out[i] = j == 0 ? 128 : 0; }
  }
  return out;
}

/** `0, 1, 2, …` — the block the keyed routines are given, which is not a secret. */
i32[] block16() {
  i32[] out = i32[16]();
  for (i32 i = 0; i < 16; i++) { out[i] = i; }
  return out;
}

string literal(i32[] v) {
  string out = "u8[](";
  for (i32 i = 0; i < v.len(); i++) { out = out + (i > 0 ? ", " : "") + itoa(v[i]); }
  return out + ")";
}

/**
 * The per-case directory, **kept between runs** rather than wiped.
 *
 * It used to be removed on the way in and on the way out, which made every driver and every module new
 * on every run. The drivers are byte-identical between runs — one array literal apart from each other —
 * so keeping them is what lets `builtProgram` answer without compiling. Nothing here reads a stale file
 * by accident: each case's drivers are written by name, and `writeIfDifferent` rewrites one the moment
 * its bytes change.
 */
string scratchDir(Cli cli, string name) {
  string dir = root(cli) + "/.cache/ct-" + name;
  cli.mkdir(dir, true).wait();
  return dir;
}

/**
 * Build one traced driver: `main` builds the secret and calls the routine, and nothing else.
 *
 * `body` is the call, written once per routine with `$KEY` where the literal goes — so the two
 * programs of a comparison are the same source with different digits.
 */
string driver(T t, Cli cli, string dir, string name, string src, string body, i32[] key) {
  i32 at = -1;
  for (i32 i = 0; i + 4 <= body.len() && at < 0; i++) {
    if (body.slice(i, i + 4) == "$KEY") { at = i; }
  }
  string call = at < 0 ? body
                       : body.slice(0, at) + literal(key) + body.slice(at + 4, body.len());
  string program = "import { " + name + " } from \"../../" + src + "\";\n" +
                   "export i32 main() {\n" +
                   "  return " + call + ".len();\n" +
                   "}\n";
  return program;
}

/**
 * The driver written, built traced, and kept — the stem of what came out, or `""`.
 *
 * **Twenty-eight traced builds a run, for fourteen programs that are the same every time.** This file
 * was 12.4s of CPU with almost all of it here. What it asks is whether two runs of a routine part
 * company, so the modules are inputs to that question: `wactest/src/built.wac` keeps each one until the
 * driver or the routine it imports changes, and `writeIfDifferent` is what keeps the driver's mtime
 * still when its bytes have not moved. The `.trace` table lands beside the module, which is where
 * `siteAt` reads it.
 *
 * The builds were submitted together before this and are serial now, which costs a slower first pass —
 * `issues/system/0211` is why concurrency was available at all, and it is still what the *runs* use.
 *
 * **`slots` is the journal's size, and 0 means the compiler's default of 2^22 events.** A routine
 * that records more than the journal holds is not unmeasurable — a divergence inside the prefix both
 * runs kept is still a divergence — but `same` is, and `ctcompare` says `truncated` rather than
 * claiming agreement it cannot see. That is the failure this parameter exists for: `p256PublicKey`
 * is 8.19 million events, so the *proof it is uniform* needs a journal twice the default's size,
 * where the leak it used to have needed nothing.
 */
string builtDriver(T t, Cli cli, string dir, string label, string tag, string program, i32 slots) {
  string entry = dir + "/" + tag + ".wac";
  t.isTrue(writeIfDifferent(cli, entry, program.toBytes()), tag + ": writing the driver");
  string mod = builtProgram(cli, entry, "ct-" + label + "-" + tag,
                            slots > 0
                              ? string[]("--trace", "--trace-slots", itoa(slots), "--quiet")
                              : string[]("--trace", "--quiet"));
  if (!cli.stat(mod).wait().exists) {
    t.fail(tag + ": the traced build produced nothing — see " + mod);
    return "";
  }
  return mod.slice(0, mod.len() - 5);
}


/** `wac ctcompare`, started. Every comparison of one routine is against the same first module. */
Pending<Exec> submitCompare(Cli cli, string a, string b, bool all) {
  string[] argv = all ? string[]("ctcompare", "--all", a + ".wasm", b + ".wasm")
                      : string[]("ctcompare", a + ".wasm", b + ".wasm");
  return cli.exec(binary(cli), argv, u8[0]());
}

/** Its whole answer, trimmed. */
string collected(T t, Pending<Exec> p) {
  Exec r = p.wait();
  t.isTrue(r.ran() && r.status == 0, "ctcompare ran — " + r.error + string.fromBytes(r.stderr));
  return (r.ran() && r.status == 0) ? trimmed(string.fromBytes(r.stdout)) : "<did not run>";
}

/** `wac ctcompare`, whole answer trimmed — for the callers that want exactly one. */
string compared(T t, Cli cli, string a, string b, bool all) {
  return collected(t, submitCompare(cli, a, b, all));
}

/** Digits to an integer; -1 when it is not one. */
i32 numberOf(string s) {
  u8[] b = trimmed(s).toBytes();
  if (b.len() == 0) { return -1; }
  i32 v = 0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] < 48 || b[i] > 57) { return -1; }
    v = v * 10 + (b[i] - 48);
  }
  return v;
}

/** The `n`th space-separated word of a line. */
string word(string line, i32 n) {
  i32 at = 0;
  string cur = "";
  for (i32 i = 0; i <= line.len(); i++) {
    string c = i < line.len() ? line.slice(i, i + 1) : " ";
    if (c == " ") {
      if (cur.len() > 0) {
        if (at == n) { return cur; }
        at = at + 1;
      }
      cur = "";
    } else {
      cur = cur + c;
    }
  }
  return "";
}

/** `kind@file:line` for a site, out of the table the build wrote beside the module. */
string siteAt(Cli cli, string stem, i32 site) {
  FileResult f = cli.readFile(stem + ".trace").wait();
  if (!f.ok) { return "<no table: " + f.error + ">"; }
  string[] rows = splitLines(string.fromBytes(f.bytes));
  string want = itoa(site) + "\t";
  for (i32 i = 0; i < rows.len(); i++) {
    if (!startsWith(rows[i], want)) { continue; }
    string[] parts = string[5](fill: "");
    i32 n = 0;
    string cur = "";
    for (i32 k = 0; k <= rows[i].len(); k++) {
      string c = k < rows[i].len() ? rows[i].slice(k, k + 1) : "\t";
      if (c == "\t") { if (n < 5) { parts[n] = cur; n = n + 1; } cur = ""; }
      else { cur = cur + c; }
    }
    // **Relative to the repository**, because the table records the path the build was given and the
    // drivers are written to an absolute one. An assertion naming a line of `aes.wac` should not also
    // be naming whose checkout it is in.
    string file = parts[4];
    string here = root(cli) + "/";
    if (startsWith(file, here)) { file = file.slice(here.len(), file.len()); }
    return n >= 5 ? parts[3] + "@" + file + ":" + parts[1] : "<short row>";
  }
  return "<no such site>";
}

/**
 * The two modules of a leak test, built together.
 *
 * The same reason as `noSecretDependence`: two programs differing in one literal, two independent
 * `wac build` processes, and no order between them.
 */
string[] pair(T t, Cli cli, string dir, string label, string progA, string progB) {
  return string[](builtDriver(t, cli, dir, label, "a", progA, 0),
                  builtDriver(t, cli, dir, label, "b", progB, 0));
}

/**
 * Every secret in `keys` produces the journal the first one does.
 *
 * The empty-journal case is a failure rather than a pass, which is what `same` carrying its count is
 * for: a routine that never ran agrees with another routine that never ran.
 */
void noSecretDependence(T t, Cli cli, string label, string src, string name, string body,
                        i32[] which, i32 len, i32 slots) {
  string dir = scratchDir(cli, label);
  i32 n = which.len();

  // **Kept, not rebuilt.** Four drivers a routine, each the same bytes as last time unless the routine
  // or the secrets changed — so this is four cache hits in the ordinary case. The *comparisons* below
  // are what still run every time, and they are what this test is about.
  string[] stems = string[n](fill: "");
  for (i32 i = 0; i < n; i++) {
    stems[i] = builtDriver(t, cli, dir, label, "k" + itoa(i),
                           driver(t, cli, dir, name, src, body, keyOf(which[i], len)), slots);
  }
  if (stems[0] == "") { return; }

  // The comparisons are all against `stems[0]`, so they wait for the builds and then run together too.
  Pending<Exec>[] cmps = Pending<Exec>[n]();
  for (i32 i = 1; i < n; i++) {
    if (stems[i] == "") { continue; }
    cmps[i] = submitCompare(cli, stems[0], stems[i], false);
  }
  for (i32 i = 1; i < n; i++) {
    if (stems[i] == "") { continue; }
    string said = collected(t, cmps[i]);
    t.isTrue(startsWith(said, "same "),
             label + ": behaviour depends on the secret — #0 against #" + itoa(i) + ": " + said +
             (startsWith(said, "differs ") ? " at " + siteAt(cli, stems[0], numberOf(word(said, 2))) : ""));
    // **Only when it says `same`.** This used to be one assertion with the check above, so a
    // `differs` answer failed twice — once correctly, and once claiming the call never happened. The
    // empty-journal case it is really for is `same 0`: two routines that never ran agree perfectly.
    if (startsWith(said, "same ")) {
      t.isTrue(numberOf(word(said, 1)) > 0,
               label + ": recorded no events at all — did the call actually happen? " + said);
    }
  }
}

export string test_sha256_does_not_vary_with_its_inputs_content(Core core, Cli cli) {
  T t = T.create();
  noSecretDependence(t, cli, "sha256", "packages/crypto/src/sha256.wac", "sha256",
                     "sha256($KEY)", i32[](0, 1, 2, 3), 16, 0);
  return t.report();
}

export string test_chacha20s_block_function_does_not_vary_with_the_key(Core core, Cli cli) {
  T t = T.create();
  noSecretDependence(t, cli, "chacha", "packages/crypto/src/chacha20.wac", "chachaBlock",
                     "chachaBlock($KEY, 1, u8[12](fill: 1))", i32[](0, 1, 2, 3), 32, 0);
  return t.report();
}

export string test_poly1305_does_not_vary_with_the_key(Core core, Cli cli) {
  T t = T.create();
  noSecretDependence(t, cli, "poly1305", "packages/crypto/src/poly1305.wac", "poly1305",
                     "poly1305($KEY, " + literal(block16()) + ")", i32[](0, 1, 2, 3), 32, 0);
  return t.report();
}

export string test_x25519s_ladder_does_not_vary_with_the_scalar(Core core, Cli cli) {
  // The expensive one — about 1.6 million events per run, which is also the answer to "is the ladder
  // really uniform": it is, over every one of them. Two secrets rather than four, as the TypeScript
  // had it: each is a compile and a run of the ladder.
  T t = T.create();
  noSecretDependence(t, cli, "x25519", "packages/crypto/src/x25519.wac", "x25519Base",
                     "x25519Base($KEY)", i32[](0, 1), 32, 0);
  return t.report();
}

export string test_ed25519_signing_does_not_vary_with_the_secret_key(Core core, Cli cli) {
  // **The row `x25519Base` above was standing in for.** A uniform ladder is a fact about a ladder;
  // signing reduces `sha512(prefix ++ msg)` modulo L, where `prefix` is half the secret key
  // expansion — a different scalar, a different modulus and a different piece of arithmetic. It
  // parted at `ed25519.wac:334` until 2026-08-20: `scReduce`'s comparison left on the first
  // differing byte, so how many bytes it read was a function of the nonce, and a partial EdDSA nonce
  // leak recovers the key from a signature the attacker already holds. `issues/system/0225`.
  //
  // 7.4 million events, so it needs a journal of 2^24 slots. Written as fitting the compiler's
  // default first, which is 2^22 and about 4.19 million — and `ctcompare` said `truncated` rather
  // than agreeing, which is the whole reason that answer is not a pass.
  T t = T.create();
  noSecretDependence(t, cli, "ed25519", "packages/crypto/src/ed25519.wac", "ed25519Sign",
                     "ed25519Sign($KEY, " + literal(block16()) + ")", i32[](0, 1, 2, 3), 32,
                     16777216);
  return t.report();
}

export string test_p256_public_key_does_not_vary_with_the_private_key(Core core, Cli cli) {
  // **This was a known leak in two places, and is neither.** Both are worth stating, because the
  // second was invisible while the first was live.
  //
  // `issues/system/0210` was the ladder: `jacMul` was double-and-add with the add taken only when
  // the scalar bit was set, so the work — and the time — was a function of the scalar's Hamming
  // weight and of *which* bits were set. It adds on every bit now and keeps the answer with a
  // constant-time select.
  //
  // Fixing it moved the divergence rather than removing it, to `reduceWide` in `fieldp.wac`, which
  // skipped a word of the product when it happened to be zero and folded the leftover carry a number
  // of times that depended on its value. That was always there: `ctcompare` reports the *first*
  // divergence, and while the ladder parted at the first differing scalar bit nothing downstream of
  // it could be seen. `issues/system/0223` is that one, and the field reduction is now branchless —
  // the conditional subtractions compute both answers and select, and the carry fold runs a fixed
  // four passes.
  //
  // **Two secrets rather than four, and a journal twice the default.** Each secret is a build and a
  // run of the whole scalar multiplication, and this is the most expensive thing measured here:
  // 8.19 million events, up about a third from the 6.27 million the leaking version cost. Under the
  // compiler's default 2^22 slots `ctcompare` answers `truncated`, which is not a pass — a run that
  // recorded more than the journal held cannot be called uniform, only not-yet-caught.
  //
  // Not the all-zero key: `curvePublicKey` traps on a scalar of zero or one past the group order, so
  // the secrets here have to be valid keys as well as different.
  T t = T.create();
  noSecretDependence(t, cli, "p256", "packages/crypto/src/p256.wac", "p256PublicKey",
                     "p256PublicKey($KEY)", i32[](2, 3), 32, 16777216);
  return t.report();
}

export string test_the_scalar_multiply_mod_the_order_does_not_vary_with_its_operand(Core core,
                                                                                    Cli cli) {
  // **The routine, not the signature, and on purpose.** `scMul` — multiplication modulo the group
  // *order*, a different field from the coordinates — was double-and-add adding only when the bit was
  // set, which is `issues/system/0210`'s defect a second time. `ecdsaSign` puts the private key in
  // that operand at `scMul(c, r, priv)` and the nonce in it again inside `scInvert`.
  //
  // A whole `p256Sign` is 93 million traced events, so a journal that holds one is over a gigabyte and
  // two of them are not something a shared test suite should ask for. One `scMul` is about fifty
  // thousand and isolates exactly the loop that leaked, which is why `p256_probe.wac` exports it.
  //
  // The four structured secrets all work here: unlike a private key, an operand of `scMul` has no
  // range condition to satisfy, so zero is a legal input and is the extreme worth having.
  T t = T.create();
  noSecretDependence(t, cli, "scmul", "packages/crypto/test/wac/p256_probe.wac", "scalarMulOrder",
                     "scalarMulOrder($KEY)", i32[](0, 1, 2, 3), 32, 0);
  return t.report();
}

export string test_ml_kem_decapsulation_does_not_reveal_whether_the_ciphertext_was_valid(Core core,
                                                                                        Cli cli) {
  // **The one question the side-channel table cannot ask.** Its `Case` varies the secret and holds
  // the public input; a KEM's most important property is the other way round — an attacker submits
  // chosen ciphertexts to the *same* key and wants to learn which were valid, which is exactly the
  // decryption oracle the Fujisaki-Okamoto transform exists to deny them. So this is here rather than
  // in `ct.wac`, and it uses `pair` directly because `noSecretDependence`'s wording is about secrets.
  //
  // The two programs are the same key, the same message and one exclusive-or into the ciphertext's
  // first byte: zero in one, 0xFF in the other. They parted at `mlkem.wac:56` — `mod`'s ternary on a
  // polynomial coefficient, a million events inside `pkeDecrypt` and long before the rejection
  // itself. `issues/system/0226`.
  T t = T.create();
  string dir = scratchDir(cli, "mlkem");
  const string SRC = "packages/crypto/test/wac/mlkem_probe.wac";
  string[] ab = pair(t, cli, dir, "kemDecapsFlip",
                     driver(t, cli, dir, "kemDecapsFlip", SRC, "kemDecapsFlip($KEY)", i32[](0)),
                     driver(t, cli, dir, "kemDecapsFlip", SRC, "kemDecapsFlip($KEY)", i32[](255)));
  string a = ab[0];
  string b = ab[1];
  if (a == "" || b == "") { return t.report(); }

  string said = compared(t, cli, a, b, false);
  t.isTrue(startsWith(said, "same "),
           "a valid and an invalid ciphertext are distinguishable: " + said +
           (startsWith(said, "differs ") ? " at " + siteAt(cli, a, numberOf(word(said, 2))) : ""));
  // `truncated` is not a pass here any more than anywhere else, and the count is the evidence the
  // programs ran at all: two empty journals agree perfectly.
  if (startsWith(said, "same ")) {
    t.isTrue(numberOf(word(said, 1)) > 0, "no events recorded — did decapsulation happen? " + said);
  }
  return t.report();
}

// ── Known leaks ───────────────────────────────────────────────────────────────
// Asserted as leaks so that fixing one fails here and forces the README to change with it. A README
// that describes yesterday's side channels is worse than none.

export string test_ghash_branches_on_the_bits_of_h_known_leak(Core core, Cli cli) {
  T t = T.create();
  string dir = scratchDir(cli, "ghash");
  const string SRC = "packages/crypto/src/ghash.wac";
  string call = "ghash($KEY, " + literal(block16()) + ")";
  string[] ab = pair(t, cli, dir, "ghash",
                     driver(t, cli, dir, "ghash", SRC, call, keyOf(0, 16)),
                     driver(t, cli, dir, "ghash", SRC, call, keyOf(1, 16)));
  string a = ab[0];
  string b = ab[1];
  if (a == "" || b == "") { return t.report(); }

  string said = compared(t, cli, a, b, false);
  t.isTrue(startsWith(said, "differs "),
           "ghash no longer leaks — update the README and delete this test: " + said);
  // A *branch* leak, not an index one: the two runs part rather than standing at one point with
  // different values. `--all` says which, because that is the distinction it is built to draw.
  if (startsWith(said, "differs ")) {
    string all = compared(t, cli, a, b, true);
    t.isTrue(startsWith(all, "split "),
             "expected a branch leak, got: " + all + " — " +
             siteAt(cli, a, numberOf(word(said, 2))));
  }
  return t.report();
}

export string test_aes_indexes_its_s_box_with_key_dependent_values_known_leak(Core core, Cli cli) {
  T t = T.create();
  string dir = scratchDir(cli, "aes");
  const string SRC = "packages/crypto/src/aes.wac";
  string call = "aesEncrypt($KEY, " + literal(block16()) + ")";
  string[] ab = pair(t, cli, dir, "aesEncrypt",
                     driver(t, cli, dir, "aesEncrypt", SRC, call, keyOf(0, 16)),
                     driver(t, cli, dir, "aesEncrypt", SRC, call, keyOf(1, 16)));
  string a = ab[0];
  string b = ab[1];
  if (a == "" || b == "") { return t.report(); }

  string said = compared(t, cli, a, b, false);
  t.isTrue(startsWith(said, "differs "),
           "aes no longer leaks — update the README and delete this test: " + said);
  if (!startsWith(said, "differs ")) { cli.remove(dir, true).wait(); return t.report(); }

  // The point of the whole exercise: this one has no branch to find. Counting branches reports AES's
  // S-box lookup as perfectly uniform, so the two runs stand at *the same site* with different
  // indices — which `--all` reports as `site` and a branch leak reports as `split`.
  string all = compared(t, cli, a, b, true);
  t.isTrue(startsWith(all, "site "),
           "expected an index leak, got: " + all + " — " + siteAt(cli, a, numberOf(word(said, 2))));

  // The README names these lines. Asserting them here is what stops the table drifting away from the
  // code — a published measurement nothing checks is the failure this package already has an issue
  // open about elsewhere.
  string[] rows = splitLines(all);
  string found = "";
  for (i32 i = 0; i < rows.len(); i++) {
    if (!startsWith(rows[i], "site ")) { continue; }
    found = found + siteAt(cli, a, numberOf(word(rows[i], 2))) + " ";
  }
  i32[] lines = i32[](113, 114, 115, 116, 149);
  for (i32 i = 0; i < lines.len(); i++) {
    string want = "index@packages/crypto/src/aes.wac:" + itoa(lines[i]);
    t.isTrue(contains(found, want),
             "README says " + want + " leaks; the trace no longer agrees. found: " + found);
  }
  return t.report();
}
