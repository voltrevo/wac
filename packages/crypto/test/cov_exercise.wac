/** Deterministic filler; `seed` varies the contents so repeats are not identical. */
u8[] bytes(i32 n, i32 seed) {
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = (i * 31 + seed * 17 + 7) & 255; }
  return out;
}

/**
 * Lengths that straddle every block and padding boundary in the package.
 *
 * SHA-256 pads at 64 with a 9-byte tail and SHA-512 at 128 with a 17-byte tail, so the two need
 * different sets — 55/56 is the interesting pair for one and 111/112 for the other.
 */
i32[] sha256Lens() { return i32[](0, 1, 55, 56, 63, 64, 65, 119, 120, 200); }
i32[] sha512Lens() { return i32[](0, 1, 111, 112, 127, 128, 129, 239, 240, 400); }

