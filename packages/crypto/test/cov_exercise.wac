export void trapCase(i32 i) {
  if (i == 0) { aead__traps_on_a_flipped_first_ciphertext_bit(); return; }
  if (i == 1) { aead__traps_on_a_flipped_last_ciphertext_bit(); return; }
  if (i == 2) { aead__traps_on_modified_associated_data(); return; }
  if (i == 3) { aead__traps_on_a_flipped_tag_bit(); return; }
  if (i == 4) { aead__traps_on_the_wrong_key(); return; }
  if (i == 5) { aead__traps_on_the_wrong_nonce(); return; }
  if (i == 6) { aead__traps_on_a_short_tag(); return; }
  if (i == 7) { aead__traps_on_a_seventeen_byte_tag(); return; }
  if (i == 8) { aead__traps_on_an_eighteen_byte_tag(); return; }
  if (i == 9) { aead__traps_on_a_double_length_tag(); return; }
  if (i == 10) { aead__traps_on_a_truncated_ciphertext(); return; }
  if (i == 11) { aes__traps_on_a_flipped_ciphertext_bit(); return; }
  if (i == 12) { aes__traps_on_a_flip_in_the_final_partial_block(); return; }
  if (i == 13) { aes__traps_on_modified_additional_data(); return; }
  if (i == 14) { aes__traps_on_a_flipped_tag_bit(); return; }
  if (i == 15) { aes__traps_on_the_wrong_key(); return; }
  if (i == 16) { aes__traps_on_the_wrong_nonce(); return; }
  if (i == 17) { aes__traps_on_a_truncated_ciphertext(); return; }
  if (i == 18) { aes__traps_on_a_short_tag(); return; }
  if (i == 19) { aes__traps_on_an_over_long_tag_with_a_valid_prefix(); return; }
  if (i == 20) { aes__traps_encrypting_with_an_empty_iv(); return; }
  if (i == 21) { aes__traps_tagging_with_an_empty_iv(); return; }
  if (i == 22) { aes__traps_on_an_empty_key(); return; }
  if (i == 23) { aes__traps_on_a_one_byte_key(); return; }
  if (i == 24) { aes__traps_one_byte_below_aes128(); return; }
  if (i == 25) { aes__traps_one_byte_above_aes128(); return; }
  if (i == 26) { aes__traps_between_aes128_and_aes192(); return; }
  if (i == 27) { aes__traps_one_byte_below_aes256(); return; }
  if (i == 28) { aes__traps_one_byte_above_aes256(); return; }
  if (i == 29) { aes__traps_on_a_sixty_four_byte_key(); return; }
  if (i == 30) { ghash__traps_on_data_that_is_not_a_whole_number_of_blocks(); return; }
  if (i == 31) { ghash__traps_on_one_byte_of_data(); return; }
  if (i == 32) { ghash__traps_on_seventeen_bytes_of_data(); return; }
  if (i == 33) { ghash__traps_on_a_short_subkey(); return; }
