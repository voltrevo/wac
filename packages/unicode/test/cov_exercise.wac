// Branch coverage for unicode: the exercises, and nothing else.
//
//   wac task coverage:unicode
//   wac task coverage:unicode --verbose
//
// Every code point, which is also what the tests do — there is no smaller workload that reaches both
// ends of a binary search over 1,482 entries, and no reason to use one.
//
// ## What this file is, after 2026-08-20 — `issues/system/0161`
//
// It was the package's `cov.ts`, which was these exercises plus a copy of the reporting.
// `tools/wac/covreport.wac` is the reporting now, shared, so what is left here is the part that is
// actually about unicode. It is a program rather than a caller: `covreport` builds *this* with
// `--coverage` and runs its `main`, so the exercises are inside the instrumented module.
//
// **It lives under `test/` on purpose.** `covreport` skips any file with `/test/` in its path, which
// is the rule `harness/wacCoverage.ts` had and the reason `test/probe.wac` was never counted — so a
// driver's own branches cannot appear in unicode's number.
//
// Everything is accumulated into `seen` and returned, so that nothing here can be dropped as a call
// whose result is unused — an exercise that is optimised away measures nothing and says 100%.

import { mapLower, mapUpper, mapFold, printable, decodeCode, decodeSize, valid, scalarCount,
         encodeOne, lower, upper, casefold, equalFold } from "./probe.wac";
import { Rng } from "../../wactest/src/rng.wac";
import { Core, Cli } from "std/platform.wac";
import {
  test_simple_case_mapping_agrees_with_the_host as u__simple_case_mapping_agrees_with_the_host,
  test_sharp_s_under_simple_uppercase as u__sharp_s_under_simple_uppercase,
  test_fold_is_an_equivalence as u__fold_is_an_equivalence,
  test_the_fold_classes as u__the_fold_classes,
  test_fold_all_matches_fold_equal as u__fold_all_matches_fold_equal,
  test_mapping_whole_strings_agrees_with_the_host as u__mapping_whole_strings_agrees_with_the_host,
  test_fold_equal_on_named_pairs as u__fold_equal_on_named_pairs,
  test_fold_equal_over_random_strings as u__fold_equal_over_random_strings,
  test_utf8_encoding_matches_the_host_at_every_code_point as u__utf8_encoding_matches_the_host_at_every_code_point,
  test_invalid_utf8_is_rejected as u__invalid_utf8_is_rejected,
  test_scalar_counting_matches_the_host as u__scalar_counting_matches_the_host,
  test_random_byte_strings_never_crash_the_decoder as u__random_byte_strings_never_crash_the_decoder,
  test_is_printable_agrees_with_the_host as u__is_printable_agrees_with_the_host,
} from "./wac/unicode_test.wac";


/** Valid text of every encoded length, and the mapping paths over it. */
string[] good() {
  return string[](
    "", "a", "A", "abc", "ABC", "café", "CAFÉ", "日本語", "😀", "straße", "STRASSE",
    "ΣΊΣΥΦΟΣ", "σίσυφος", "ς", "σ", "K", "k", "ﬁ", "İ", "ı");
}

/** Every way a sequence can be malformed, which is most of the decoder. */
u8[][] malformed() {
  return u8[][](
    u8[](0x80), u8[](0xbf), u8[](0xc0, 0x80), u8[](0xc1, 0xbf), u8[](0xe0, 0x80, 0x80),
    u8[](0xe0, 0x9f, 0xbf), u8[](0xf0, 0x80, 0x80, 0x80), u8[](0xf0, 0x8f, 0xbf, 0xbf),
    u8[](0xed, 0xa0, 0x80), u8[](0xed, 0xbf, 0xbf), u8[](0xf4, 0x90, 0x80, 0x80),
    u8[](0xf5, 0x80, 0x80, 0x80), u8[](0xfe), u8[](0xff),
    u8[](0xc2), u8[](0xe0, 0xa0), u8[](0xf0, 0x9f, 0x98), u8[](0xc2, 0x41),
    u8[](0xe0, 0xa0, 0x41), u8[](0x61, 0x80, 0x62), u8[]());
}

export i32 main(Core core, Cli cli) {
  i32 seen = 0;

  // The whole space, thinned only where the branches cannot differ. The ends matter most: a binary
  // search is wrong at the first and last entry or nowhere.
  for (i32 cp = 0; cp <= 0x10ffff; cp = cp + 7) {
    if (cp >= 0xd800 && cp <= 0xdfff) { continue; }
    seen = seen + mapLower(cp) + mapUpper(cp) + mapFold(cp) + encodeOne(cp).len();
    // A different search from the other three — over ranges rather than pairs, so it has an `and-rhs`
    // the pair lookup does not, and a "before the first range" answer that only a negative reaches.
    if (printable(cp)) { seen = seen + 1; }
  }
  if (printable(-1)) { seen = seen + 1; }

  // `0xd800` and `0xdfff` are the surrogate ends, and they are here because the loop above *skips*
  // them — so `encodedLength`'s refusal of a surrogate had never been reached from this driver, while
  // `test/wac/unicode_test.wac` has tested the decoder's refusal of one since it was written.
  i32[] edges = i32[](0, 1, 0x41, 0x5a, 0x61, 0x7a, 0x7f, 0x80, 0xdf, 0x130, 0x131, 0x212a,
                      0x3c2, 0x3c3, 0x3a3, 0x7ff, 0x800, 0xffff, 0x10000, 0x10ffff, -1, 0x110000,
                      0xd800, 0xdfff);
  for (i32 i = 0; i < edges.len(); i++) {
    i32 cp = edges[i];
    seen = seen + mapLower(cp) + mapUpper(cp) + mapFold(cp) + encodeOne(cp).len();
  }

  string[] ok = good();
  u8[] zzz = "zzz".toBytes();
  for (i32 i = 0; i < ok.len(); i++) {
    u8[] b = ok[i].toBytes();
    seen = seen + lower(b).len() + upper(b).len() + casefold(b).len();
    if (valid(b)) { seen = seen + 1; }
    seen = seen + scalarCount(b) + decodeCode(b, 0) + decodeSize(b, 0);
    // Against this package's own uppercasing rather than the host's `toUpperCase`, which is where
    // the TypeScript got the second operand — the same shapes, and one fewer implementation to be
    // right about.
    if (equalFold(b, upper(b))) { seen = seen + 1; }
    if (equalFold(b, zzz)) { seen = seen + 1; }
  }

  u8[][] bad = malformed();
  u8[] a1 = "a".toBytes();
  for (i32 i = 0; i < bad.len(); i++) {
    u8[] b = bad[i];
    if (valid(b)) { seen = seen + 1; }
    seen = seen + scalarCount(b) + decodeCode(b, 0) + decodeSize(b, 0);
    seen = seen + lower(b).len() + upper(b).len() + casefold(b).len();
    if (equalFold(b, b)) { seen = seen + 1; }
    if (equalFold(b, a1)) { seen = seen + 1; }
    if (equalFold(a1, b)) { seen = seen + 1; }
  }

  // Random bytes, since that is what a decoder is actually given.
  Rng r = Rng(0x0badc0de);
  u8[] test = "test".toBytes();
  for (i32 t = 0; t < 4000; t++) {
    i32 n = r.upto(12);
    u8[] b = u8[n]();
    for (i32 i = 0; i < n; i++) { b[i] = (r.next() & (0xff as@ u32)) as@ i32; }
    if (valid(b)) { seen = seen + 1; }
    seen = seen + lower(b).len();
    if (equalFold(b, test)) { seen = seen + 1; }
  }


  // **The package's own tests, which is most of what this file now measures.**
  //
  // Nine of the thirteen take `(Core, Cli)`, and until `issues/system/0221` a coverage driver
  // could not call one: `harness/wacCoverage.ts` skipped any test whose `fn.length > 0` because
  // `instrument` cannot supply a capability. So this file was hand-built probes, and its number
  // answered "what do the probes reach" rather than "what do the tests reach".
  //
  // `wac covdump` runs the ordinary program path, so `main` here has a real `Core` and `Cli` and
  // simply calls them. What that recovered: the over-long ASCII rejection at `utf8.wac:45`, the
  // surrogate rejection in `encodedLength`, and the four-byte encode arm — all three tested
  // since `unicode_test.wac` was written, none of them reachable from here before.
  i32 bad = 0;
  if (u__simple_case_mapping_agrees_with_the_host(core, cli).len() > 0) {
    core.warn("error: FAILED unicode_test test_simple_case_mapping_agrees_with_the_host");
    bad = bad + 1;
  }
  if (u__sharp_s_under_simple_uppercase().len() > 0) {
    core.warn("error: FAILED unicode_test test_sharp_s_under_simple_uppercase");
    bad = bad + 1;
  }
  if (u__fold_is_an_equivalence(core, cli).len() > 0) {
    core.warn("error: FAILED unicode_test test_fold_is_an_equivalence");
    bad = bad + 1;
  }
  if (u__the_fold_classes().len() > 0) {
    core.warn("error: FAILED unicode_test test_the_fold_classes");
    bad = bad + 1;
  }
  if (u__fold_all_matches_fold_equal().len() > 0) {
    core.warn("error: FAILED unicode_test test_fold_all_matches_fold_equal");
    bad = bad + 1;
  }
  if (u__mapping_whole_strings_agrees_with_the_host(core, cli).len() > 0) {
    core.warn("error: FAILED unicode_test test_mapping_whole_strings_agrees_with_the_host");
    bad = bad + 1;
  }
  if (u__fold_equal_on_named_pairs().len() > 0) {
    core.warn("error: FAILED unicode_test test_fold_equal_on_named_pairs");
    bad = bad + 1;
  }
  if (u__fold_equal_over_random_strings(core, cli).len() > 0) {
    core.warn("error: FAILED unicode_test test_fold_equal_over_random_strings");
    bad = bad + 1;
  }
  if (u__utf8_encoding_matches_the_host_at_every_code_point(core, cli).len() > 0) {
    core.warn("error: FAILED unicode_test test_utf8_encoding_matches_the_host_at_every_code_point");
    bad = bad + 1;
  }
  if (u__invalid_utf8_is_rejected(core, cli).len() > 0) {
    core.warn("error: FAILED unicode_test test_invalid_utf8_is_rejected");
    bad = bad + 1;
  }
  if (u__scalar_counting_matches_the_host(core, cli).len() > 0) {
    core.warn("error: FAILED unicode_test test_scalar_counting_matches_the_host");
    bad = bad + 1;
  }
  if (u__random_byte_strings_never_crash_the_decoder(core, cli).len() > 0) {
    core.warn("error: FAILED unicode_test test_random_byte_strings_never_crash_the_decoder");
    bad = bad + 1;
  }
  if (u__is_printable_agrees_with_the_host(core, cli).len() > 0) {
    core.warn("error: FAILED unicode_test test_is_printable_agrees_with_the_host");
    bad = bad + 1;
  }
  seen = seen + bad;

  return seen;
}
