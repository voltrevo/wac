// `ssh-keygen`, and the file modes an OpenSSH client insists on.
//
// Three lines of shell that four test files needed and two packages now need. It lived in
// `packages/ssh/test/wac/fixture.wac` until `packages/platform`'s arrival test wanted it too, and a
// second copy of "make an ed25519 key and chmod it 600" is how two of them come to disagree about the
// mode — which `ssh(1)` refuses over, with a message about permissions and not about the key.
//
// Not a test file and not discovered as one: `wac test` walks `*_test.wac`.

import { T } from "./assert.wac";
import { Cli, Exec, FileResult } from "../../platform/src/platform.wac";
import { quoted } from "./childenv.wac";

/** `chmod 600` — what `ssh` requires of a private key before it will use one. */
export bool restrict(Cli cli, string path) {
  Exec r = cli.exec("/bin/sh", string[]("-c", "chmod 600 " + quoted(path)), u8[0]()).wait();
  return r.ran() && r.status == 0;
}

/** `cp -p`, preserving the mode — an `ssh-keygen` key copied any other way loses its 0600. */
export bool copyPreserving(Cli cli, string from, string to) {
  Exec r = cli.exec("/bin/sh", string[]("-c", "cp -p " + quoted(from) + " " + quoted(to)),
                    u8[0]()).wait();
  return r.ran() && r.status == 0;
}

/** Generate an Ed25519 key pair at `path`, failing `t` if `ssh-keygen` will not. */
export bool keygen(T t, Cli cli, string path) {
  Exec r = cli.exec("ssh-keygen", string[]("-t", "ed25519", "-f", path, "-N", "", "-q"),
                    u8[0]()).wait();
  t.isTrue(r.ran(), "ssh-keygen ran — " + r.error);
  t.eqI32(r.status, 0, "ssh-keygen for " + path + ": " + string.fromBytes(r.stderr));
  return r.ran() && r.status == 0;
}

/**
 * The base64 blob out of a `.pub` file — the second field, which is the key as it goes on the wire.
 *
 * Empty when the file cannot be read or has no second field, which every caller checks: an empty
 * expected blob would make a `known_hosts` comparison pass against anything.
 */
export string publicBlobText(Cli cli, string path) {
  FileResult f = cli.readFile(path).wait();
  if (!f.ok) { return ""; }
  string text = string.fromBytes(f.bytes);
  i32 first = text.indexOf(" ");
  if (first < 0) { return ""; }
  string rest = text.slice(first + 1, text.len());
  i32 second = rest.indexOf(" ");
  return second < 0 ? trimmedEnd(rest) : trimmedEnd(rest.slice(0, second));
}

/** The whole of a `.pub` file with its trailing newline off — an `authorized_keys` line. */
export string publicLine(Cli cli, string path) {
  FileResult f = cli.readFile(path).wait();
  return f.ok ? trimmedEnd(string.fromBytes(f.bytes)) : "";
}

string trimmedEnd(string s) {
  i32 to = s.len();
  while (to > 0 && (s.slice(to - 1, to) == "\n" || s.slice(to - 1, to) == " " ||
                    s.slice(to - 1, to) == "\r")) {
    to = to - 1;
  }
  return s.slice(0, to);
}
