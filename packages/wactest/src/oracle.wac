// Batch a sweep to an external oracle, in one process rather than one call per case.
//
// A test that checks a million answers against a reference implementation used to be a host-side
// test, because the reference was a host function and calling it was free. Through `Cli.exec` it is
// not free — a process is milliseconds — so the shape that works is the opposite one: compute
// everything, hand it over once, and let the oracle report only what it rejects.
//
// That is what `packages/gzip/test/fuzz/oracle.py` does for gzip and what
// `packages/datetime/test/oracle.ts` does for `Date`. This is the caller's half of it, here rather
// than copied into each package, because the two things that make it correct are easy to leave out:
//
//   - **the count.** An oracle that read half the batch and stopped reports no failures, which is
//     indistinguishable from agreement. `DONE <n>` is checked against what was sent.
//   - **the bytes.** A sweep is megabytes of lines and `s = s + line` in a loop is quadratic; the
//     one that made this necessary took minutes rather than seconds before it was a `Buf`.
//
// The protocol is deliberately thin: lines in, `FAIL <reason>` lines out, `DONE <count>` last.
// Anything else is a harness problem and is reported as one.

import { T } from "./assert.wac";
import { Cli, Exec, Stat, FileResult } from "std/platform.wac";
import { itoa } from "../../fmt/src/itoa.wac";
import { Buf } from "../../bytes/src/buf.wac";

/** Lines to hand an oracle, accumulated as bytes. */
export struct Lines {
  Buf buf;
  i32 n;

  void add(this, string line) {
    this.buf.pushAll(line.toBytes());
    this.buf.push('\n');
    this.n = this.n + 1;
  }

  Lines create() { return Lines(Buf.create(), 0); }
}

/**
 * Run `program args…` with `lines` on standard input and fail `t` with everything it rejected.
 *
 * `what` prefixes each message, because one test usually sends several batches and "got 3, want 4"
 * on its own does not say which.
 */
export void check(T t, Cli cli, string program, string[] args, Lines lines, string what) {
  Exec r = cli.exec(program, args, lines.buf.take()).wait();
  t.isTrue(r.ran(), what + ": the oracle ran — " + r.error);
  if (!r.ran()) { return; }
  t.eqI32(r.status, 0, what + ": the oracle exited zero — " + string.fromBytes(r.stderr));
  if (r.status != 0) { return; }

  string out = string.fromBytes(r.stdout);
  i32 from = 0;
  string last = "";
  for (i32 i = 0; i <= out.len(); i++) {
    if (i < out.len() && out.slice(i, i + 1) != "\n") { continue; }
    if (i > from) {
      last = out.slice(from, i);
      if (last.len() >= 4 && last.slice(0, 4) == "FAIL") {
        t.fail(what + ": " + last.slice(5, last.len()));
      }
    }
    from = i + 1;
  }
  // The canary. Two runs of nothing agree perfectly, and so does a batch the oracle never read.
  t.eqStr(last, "DONE " + itoa(lines.n), what + ": the oracle checked everything it was sent");
}

/** The common case: a Deno oracle script in this repository. */
export void checkDeno(T t, Cli cli, string script, Lines lines, string what) {
  check(t, cli, "deno", string[]("run", "--no-check", script), lines, what);
}

/**
 * What an oracle answered, for the oracles that **produce** rather than judge.
 *
 * `check` covers the usual direction: the test computed the answers and the oracle says which it rejects.
 * Some oracles are the other way round — `packages/mpt/test/oracle.ts` builds tries, because a proof has to
 * come from an implementation that is not the one verifying it — and there the output is the point.
 *
 * The two properties `check` enforces still hold and are enforced here: a `FAIL` line fails `t`, and the
 * `DONE <n>` count is checked against what was sent, so an oracle that answered half the batch cannot pass
 * for one that answered all of it. What differs is only that the answers come back.
 */
export struct Answers {
  bool ok;
  /** Every line the oracle wrote except the trailing `DONE`. */
  string[] lines;

  /**
   * The first line beginning with the words `word` and `rest`, or `""`.
   *
   * **Matched on whole words**, so `find("proof", "dogs 646f")` cannot return the line for `646f67`. A
   * plain prefix test does exactly that, and the failure it produces is a *valid* answer to the wrong
   * question — here, a proof that verified against a key it was not asked about.
   */
  string find(const this, string word, string rest) {
    string want = word + " " + rest;
    for (i32 i = 0; i < this.lines.len(); i++) {
      string line = this.lines[i];
      if (line.len() < want.len() || line.slice(0, want.len()) != want) { continue; }
      if (line.len() == want.len() || line.slice(want.len(), want.len() + 1) == " ") { return line; }
    }
    return "";
  }
}

export Answers ask(T t, Cli cli, string program, string[] args, Lines lines, string what) {
  return askBytes(t, cli, program, args, lines.buf.take(), lines.n, what);
}

/** `ask`, with the payload already taken — what `askCached` needs so it can hash before it sends. */
Answers askBytes(T t, Cli cli, string program, string[] args, u8[] payload, i32 n, string what) {
  Exec r = cli.exec(program, args, payload).wait();
  t.isTrue(r.ran(), what + ": the oracle ran — " + r.error);
  if (!r.ran()) { return Answers(false, string[0](fill: "")); }
  t.eqI32(r.status, 0, what + ": the oracle exited zero — " + string.fromBytes(r.stderr));
  if (r.status != 0) { return Answers(false, string[0](fill: "")); }

  string out = string.fromBytes(r.stdout);
  i32 count = 0;
  for (i32 i = 0; i < out.len(); i++) {
    if (out.slice(i, i + 1) == "\n") { count = count + 1; }
  }
  if (out.len() > 0 && out.slice(out.len() - 1, out.len()) != "\n") { count = count + 1; }

  string[] all = string[count](fill: "");
  i32 at = 0;
  i32 from = 0;
  for (i32 i = 0; i <= out.len(); i++) {
    if (i < out.len() && out.slice(i, i + 1) != "\n") { continue; }
    if (i > from) {
      all[at] = out.slice(from, i);
      at = at + 1;
    }
    from = i + 1;
  }
  string last = at == 0 ? "" : all[at - 1];
  for (i32 i = 0; i < at; i++) {
    if (all[i].len() >= 4 && all[i].slice(0, 4) == "FAIL") {
      t.fail(what + ": " + all[i].slice(5, all[i].len()));
    }
  }
  t.eqStr(last, "DONE " + itoa(n), what + ": the oracle answered everything it was sent");
  if (last != "DONE " + itoa(n)) { return Answers(false, string[0](fill: "")); }

  string[] answers = string[at - 1](fill: "");
  for (i32 i = 0; i < at - 1; i++) { answers[i] = all[i]; }
  return Answers(true, answers);
}

/**
 * `ask`, for an oracle whose answers are a **pure function** of the question and of some source
 * trees — the reference compiler, mostly.
 *
 * The suite asks the same oracle the same questions on every run: `typecheck_test.wac` alone called
 * the reference 48 times, and `emit_test.wac` asks it 222 questions in one go. Those answers move
 * only when the question moves or when `compiler/` does, so they are cached in `.cache/oracle` on a
 * checksum of the payload and the newest mtime under `trees`.
 *
 * **Opt-in, and it has to be.** `ask` itself must not do this: `packages/crypto`'s RSA oracle
 * *generates a fresh key* per run, and freezing that would turn a test over many keys into a test
 * over one. The caller names the trees precisely because only the caller knows what the answer
 * depends on.
 *
 * **One side only.** Whatever this remembers is the *other* implementation's answer; ours is computed
 * on every run. A differential with one remembered side is still a differential — one with two is
 * nothing.
 *
 * `name` distinguishes oracles in the cache directory, and a stale generation is swept on write: a
 * key ends with the trees' stamp, so an edit under `compiler/` would otherwise leave every file from
 * the previous stamp behind for good.
 */
export Answers askCached(T t, Cli cli, string program, string[] args, Lines lines, string what,
                         string name, string[] trees) {
  u8[] payload = lines.buf.take();
  i64 newest = 0 as i64;
  for (i32 i = 0; i < trees.len(); i++) {
    i64 deep = newestUnder(cli, trees[i]);
    if (deep > newest) { newest = deep; }
  }
  string stamp = itoa((newest / (1000 as i64)) as! i32);
  string key = name + "-" + itoa(sumOfBytes(payload)) + "-" + itoa(lines.n) + "-" + stamp;
  string path = ".cache/oracle/" + key + ".txt";

  FileResult held = cli.readFile(path).wait();
  if (held.ok) { return Answers(true, linesOf(string.fromBytes(held.bytes))); }

  Answers a = askBytes(t, cli, program, args, payload, lines.n, what);
  if (!a.ok) { return a; }
  cli.mkdir(".cache/oracle", true).wait();
  string body = "";
  for (i32 i = 0; i < a.lines.len(); i++) { body = body + a.lines[i] + "\n"; }
  cli.writeFile(path, body.toBytes()).wait();
  sweepOlder(cli, ".cache/oracle", name + "-", "-" + stamp + ".txt");
  return a;
}

/** The newest modification time anywhere under `dir`, or 0 for a directory that is not there. */
i64 newestUnder(Cli cli, string dir) {
  i64 newest = 0 as i64;
  string[]? names = cli.readDir(dir).wait();
  if (names is null) { return 0 as i64; }
  string[] here = names!;
  for (i32 i = 0; i < here.len(); i++) {
    string at = dir + "/" + here[i];
    Stat st = cli.stat(at).wait();
    if (!st.exists) { continue; }
    if (st.isDir) {
      i64 deep = newestUnder(cli, at);
      if (deep > newest) { newest = deep; }
      continue;
    }
    if (st.modifiedMillis > newest) { newest = st.modifiedMillis; }
  }
  return newest;
}

/** Everything in `dir` starting with `prefix` and not ending with `keep` — the older generations. */
void sweepOlder(Cli cli, string dir, string prefix, string keep) {
  string[]? names = cli.readDir(dir).wait();
  if (names is null) { return; }
  string[] here = names!;
  for (i32 i = 0; i < here.len(); i++) {
    string f = here[i];
    if (f.len() < prefix.len() || f.slice(0, prefix.len()) != prefix) { continue; }
    if (f.len() >= keep.len() && f.slice(f.len() - keep.len(), f.len()) == keep) { continue; }
    cli.remove(dir + "/" + f, false).wait();
  }
}

/** A checksum of the whole payload, so a different question is a different key. */
i32 sumOfBytes(u8[] b) {
  i32 h = 7;
  for (i32 i = 0; i < b.len(); i++) { h = (h * 31 + b[i]) & 2147483647; }
  return h;
}

/** The non-empty lines of a cached answer file. */
string[] linesOf(string body) {
  i32 n = 0;
  i32 from = 0;
  for (i32 i = 0; i <= body.len(); i++) {
    if (i < body.len() && body.slice(i, i + 1) != "\n") { continue; }
    if (i > from) { n = n + 1; }
    from = i + 1;
  }
  string[] out = string[n](fill: "");
  i32 at = 0;
  from = 0;
  for (i32 i = 0; i <= body.len(); i++) {
    if (i < body.len() && body.slice(i, i + 1) != "\n") { continue; }
    if (i > from) { out[at] = body.slice(from, i); at = at + 1; }
    from = i + 1;
  }
  return out;
}

export Answers askDeno(T t, Cli cli, string script, Lines lines, string what) {
  return ask(t, cli, "deno", string[]("run", "--no-check", script), lines, what);
}

/** The `n`th space-separated word of a line, or `""`. */
export string word(string line, i32 n) {
  i32 from = 0;
  i32 seen = 0;
  for (i32 i = 0; i <= line.len(); i++) {
    if (i < line.len() && line.slice(i, i + 1) != " ") { continue; }
    if (seen == n) { return line.slice(from, i); }
    seen = seen + 1;
    from = i + 1;
  }
  return "";
}

/**
 * Lowercase hex, which is how bytes travel through a line-oriented protocol.
 *
 * Through a `Buf` rather than by concatenation, for the same reason `Lines` is: `out = out + …` in a
 * loop is quadratic, and this is handed whole files. `packages/zstd`'s decoder corpus is two
 * megabytes a case and the concatenating version did not finish inside ten minutes.
 */
export string hex(u8[] b) {
  u8[] digits = "0123456789abcdef".toBytes();
  Buf out = Buf.withCapacity(b.len() * 2);
  for (i32 i = 0; i < b.len(); i++) {
    out.push(digits[b[i] / 16]);
    out.push(digits[b[i] % 16]);
  }
  return string.fromBytes(out.take());
}
