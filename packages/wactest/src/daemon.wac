// Starting a server, waiting for it, and stopping it — the shape `Cli.exec` deliberately does not have.
//
// `exec` runs a program **to completion** and hands back what it said. That is right for an oracle and
// wrong for a node: `anvil`, `openssl s_server`, a wac server under test — anything a test talks to
// over a socket has to still be running while the test runs. `platform.wac` says so in `exec`'s own
// documentation, and the count behind it: of the 107 host-side files that spawn a process, the fifteen
// that keep a child alive start a *server* and then talk to it, which is `connect`.
//
// So this is the other half of that sentence. Nothing here is a new capability — it is `exec`,
// `connect` and `listen` arranged so a test can hold a child open.
//
// ## Why a shell, and why the redirection is not optional
//
// `exec` returns when the child's pipes reach end of file. Background a process and the *shell* exits
// immediately, but the child inherits its standard output and error, so those pipes stay open and
// `exec` blocks until the server does — which is never. Sending both to a file is what lets the shell
// exit and the pipes close, and it is why `start` insists on a log path rather than offering to drop
// the output: a caller who cannot read what a failed server said has to guess.
//
// The pid comes back on standard output because the shell is the only thing that knows it. `$!` is the
// most recently backgrounded job, read immediately, before anything else can be started.
//
// ## Waiting is a poll, and the bound is a count rather than a clock
//
// There is no sleep here. `connect` to a port nothing is listening on fails immediately — a refused
// connection is not a timeout — so the loop is a busy retry, and the cost of a spin is one failed
// syscall. That is deliberate: a fixed sleep is either slower than the server or shorter than it, and
// the second is the one that produces a test that passes on a fast machine.
//
// **A caller must check `waitForPort`'s answer.** A server that never came up leaves every later
// assertion measuring a refused connection, which is a different failure wearing the same clothes.

import { Cli, Exec, ChildEnv, Clock, Files, Launch, Listener, Net, Procs, Socket } from "std";
import { quoted } from "./childenv.wac";
import { flatten } from "core";

/** A child that is still running. `pid` is negative when it did not start. */
export struct Daemon {
  i32 pid;
  string error;
  /** Where its output went, so a failure to start can be read rather than guessed at. */
  string log;

  bool ok(const this) { return this.pid > 0; }
}

/** A port, or why there is not one. */
export struct Port {
  i32 port;       // -1 when it could not be had
  string error;   // why, and empty when it could
}

/**
 * A port nothing is using, from the kernel rather than from a guess.
 *
 * Bind zero, read back what was bound, close it. There is a race between the close and whoever binds
 * it next, and it is the same race every test framework accepts for the same reason: the alternative
 * is a hardcoded number, which collides with the *other agent* running the same suite on this box.
 *
 * **The reason travels, because -1 meant two things and the wrong one was convincing.** `cli.listen`
 * needs `--allow-net`; without it the handle is negative and this answered -1, so five tests
 * reported *"no free port"* on a machine with twenty-eight thousand of them free. That message is
 * plausible enough to be believed: it reads as contention on a shared box, which is what I took it
 * for, and the tests had in fact never run in the suite at all — the wac lane granted read, write,
 * run and env, and not this. A capability that is missing and a kernel that is full are not the
 * same fact and must not be the same answer.
 */
export Port freePortOr(Net net) {
  match (flatten(net.listen("127.0.0.1", 0).wait())) {
    Ok(l): {
      i32 port = l.port;
      l.close();
      return Port(port, "");
    }
    Err(e): { return Port(-1, "\{e}"); }
  }
}

/** The port alone, for a caller that has nowhere to put the reason. */
export i32 freePort(Net net) { return freePortOr(net).port; }

/**
 * A port that is still *held* — bound by us until `release`, so nothing else can take it.
 *
 * `freePort` closes immediately and hands over a number, which is fine when the next statement is
 * the bind and wrong when it is not. A server that needs a config file naming its port cannot bind
 * first: something has to generate keys and write the file, and that is hundreds of milliseconds
 * during which the number `freePort` returned belongs to nobody. wac-mono 0069 is that race, and it
 * arrives as a server that failed to start for no visible reason.
 *
 * So: bind zero, keep the listener open while the caller prepares, and `release` immediately before
 * the spawn. The window shrinks from "however long setup takes" to the gap between two statements.
 * `port` is -1 when nothing could be bound.
 */
export struct Held {
  i32 port;
  Listener? held;

  Held take(Net net) {
    match (flatten(net.listen("127.0.0.1", 0).wait())) {
      Ok(l): { return Held(l.port, l); }
      Err(e): { return Held(-1, null); }
    }
  }

  /** Give the port up. Idempotent, so a caller may release on the failure path as well. */
  void release(this) {
    if (this.held is null) { return; }
    this.held!.close();
    this.held = null;
  }
}

/**
 * Run `line` in the background and answer with its pid.
 *
 * `line` is a shell line, not an argument vector — the whole point here is the backgrounding, which
 * only a shell can express. Build it with `quoted` around anything that came from outside.
 */
export Daemon start(Procs procs, string line, string logPath) {
  // **`exec` inside the braces, and it is not a tidiness.** Without it the shell forks a subshell,
  // backgrounds *that*, and `$!` names the subshell rather than the program — so `stop` kills a shell
  // and leaves the server running, which showed up as "still answering after stop". `exec` replaces
  // the subshell with the program, so the pid is the one that matters.
  string script = "{ exec \{line}; } >\{quoted(logPath)} 2>&1 & echo $!";
  auto rRan = flatten(procs.exec("/bin/sh", ["-c", script], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  if ((r is null)) { return Daemon(-1, "the shell did not run — \{rRan.isErr() ? "\{rRan.err()!}" : ""}", logPath); }
  if (r!.status != 0) {
    return Daemon(-1, "the shell exited \{r!.status} — " +
                      string.fromBytes(r!.stderr), logPath);
  }
  string said = string.fromBytes(r!.stdout);
  u8[] bytes = r!.stdout;
  i32 pid = 0;
  i32 digits = 0;
  for (i32 i = 0; i < bytes.len(); i++) {
    i32 b = bytes[i] as i32;
    if (b < '0' || b > '9') { continue; }
    pid = pid * 10 + (b - '0');
    digits = digits + 1;
  }
  if (digits == 0) { return Daemon(-1, "the shell printed no pid: \{said}", logPath); }
  return Daemon(pid, "", logPath);
}

/**
 * Poll until something accepts on `host:port`.
 *
 * `tries` bounds it **in attempts, which is not a bound in time** — a refused connection returns in
 * microseconds, so 400 tries is ten milliseconds of patience — measured — and a loaded machine walks
 * past it. `waitForPortWithin` takes a deadline and sleeps between attempts; reach for that unless the
 * point is specifically to dial a fixed number of times. False means nothing ever answered, and the
 * caller must say so rather than carry on.
 *
 * **Not for a server that accepts once.** This *connects*, which is a real client as far as the
 * server is concerned: a fixture written `accept()` and then serve it has already spent its one
 * connection by the time the test dials, and what the test sees is a reset rather than an answer.
 * That cost an afternoon in `packages/platform/test/wac/waitany_test.wac`, whose listeners answer
 * exactly one client each. Use `waitForLogWithin` for those and have the fixture say when it is
 * listening.
 */
export bool waitForPort(Net net, string host, i32 port, i32 tries) {
  for (i32 i = 0; i < tries; i++) {
    Socket? s = flatten(net.connect(host, port).wait()).ok();
    if (s is not null) {
      s!.close();
      return true;
    }
  }
  return false;
}

/**
 * Poll until something accepts on `host:port`, or `millis` have passed. **Prefer this to `waitForPort`.**
 *
 * A bound in attempts is not a bound in time, and the difference is the whole point: a refused
 * connection returns in microseconds, so `waitForPort(cli, host, port, 400)` reads as patience and is
 * ten milliseconds of it, measured. That is enough while the machine is idle and the server binds in one,
 * and it is why `packages/ssh`'s live tests fail under load — the server takes longer to start and the
 * wait does not take longer to wait. Four `wac test` workers on this box was enough to do it.
 *
 * So the bound is a deadline, and between attempts this *sleeps* rather than spinning — which also
 * stops a readiness check from being the thing loading the machine.
 */
export bool waitForPortWithin(Clock clock, Net net, string host, i32 port, i32 millis) {
  i64 deadline = flatten(clock.nowMillis().wait()).unwrap() + (millis as i64);
  for (i32 guard = 0; guard < 100000; guard++) {
    Socket? s = flatten(net.connect(host, port).wait()).ok();
    if (s is not null) {
      s!.close();
      return true;
    }
    if (flatten(clock.nowMillis().wait()).unwrap() >= deadline) { return false; }
    clock.sleepMillis(5).wait();
  }
  return false;
}

/**
 * Poll until the daemon's log contains `text`, or `millis` have passed.
 *
 * The readiness check for a server that cannot be dialled speculatively — see `waitForPortWithin`. The
 * fixture says when it is listening and this waits for it to say so, which costs the fixture one
 * `print` and costs the server nothing.
 *
 * A fixture that buffers its output will never appear ready, so whatever prints the marker has to
 * flush. That is not a detail this can paper over: the alternative is a readiness check that answers
 * yes before the socket exists.
 *
 * There was an attempt-bounded `waitForLog` beside this; it is gone, because reading a log is a syscall
 * and so its bound was a duration nobody chose and nobody could read off the call.
 */
export bool waitForLogWithin(Clock clock, Files fs, Daemon d, string text, i32 millis) {
  i64 deadline = flatten(clock.nowMillis().wait()).unwrap() + (millis as i64);
  for (i32 guard = 0; guard < 100000; guard++) {
    if (logOf(fs, d).indexOf(text) >= 0) { return true; }
    if (flatten(clock.nowMillis().wait()).unwrap() >= deadline) { return false; }
    clock.sleepMillis(5).wait();
  }
  return false;
}

/** Whatever the daemon wrote, for a message about why it did not come up. */
export string logOf(Files fs, const Daemon d) {
  return string.fromBytes(flatten(fs.readFile(d.log).wait()).orElse(u8[]()));
}


/**
 * Stop it, and do not care whether it was already gone.
 *
 * `kill` rather than a graceful word: these are test fixtures, they hold nothing worth flushing, and a
 * server that ignores TERM would otherwise wedge the suite.
 */
export void stop(Procs procs, Daemon d) {
  if (d.pid <= 0) { return; }
  procs.exec("/bin/sh", [
                               "-c", "kill \{d.pid} 2>/dev/null; wait \{d.pid}" +
                               " 2>/dev/null; true"
  ], u8[](), ChildEnv.inherited(), Launch.plain()).wait();
}
