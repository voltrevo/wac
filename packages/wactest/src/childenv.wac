// Giving a child an environment, and taking one away.
//
// **`Cli.execWith` now has the parameter this module was written around** — `issues/system/0182` —
// so `withEnv` and `onlyEnv` are one capability call each and no shell is involved in either. What
// survives of the original reason is `withoutEnv`: a caller who wants everything *except* a name has
// to say which names stay, and nothing in the capability list can enumerate an environment, since
// `Cli.env` answers one name at a time. A shell's `unset` can, so that one keeps its shell.
//
// The gain is not only the process. Through `/bin/sh -c` every value was a *shell word*, which is why
// this module carries `quoted`: to stop a path with a space becoming two arguments and a `~` being
// expanded before the program saw it — `core.excludesFile = ~/.gitignore_global` is a value git
// expands itself, and a shell that got there first was testing something else. A capability taking
// `NAME=value` strings has none of that, and the values arrive as they were written.
//
// **`withoutEnv` is still not symmetric with `withEnv`**, and that is worth keeping: since
// everything is inherited, a test that wants to prove a program complains about a *missing* variable
// has to remove one, and setting it empty is not the same thing — a program asking "is this set" and
// one asking "is this non-empty" answer differently, and the first is the common spelling. So it is
// `unset`.
//
// `issues/system/0198` is the half that is still open: inheritance is an authority nobody declared,
// and the day `Cli.exec` clears by default, the callers here that *want* the host's environment are
// the ones that will have to say so.

import { Cli, Exec } from "std/platform.wac";

/**
 * One shell word.
 *
 * Single quotes, so nothing inside is expanded or re-split; an embedded `'` ends the quoting, escapes
 * itself and reopens — `'\''`, the only form that works in `sh`, since single quotes do not nest.
 */
export string quoted(string s) {
  string out = "'";
  for (i32 i = 0; i < s.len(); i++) {
    string c = s.slice(i, i + 1);
    out = out + (c == "'" ? "'\\''" : c);
  }
  return out + "'";
}

/** `prog args…` as a shell line, every word quoted. */
export string commandLine(string prog, string[] args) {
  string line = "exec " + quoted(prog);
  for (i32 i = 0; i < args.len(); i++) { line = line + " " + quoted(args[i]); }
  return line;
}

/** `names[i]=values[i]` as the `NAME=value` strings `Cli.execWith` takes. */
string[] pairs(string[] names, string[] values) {
  i32 n = names.len() < values.len() ? names.len() : values.len();
  string[] out = string[n](fill: "");
  for (i32 i = 0; i < n; i++) { out[i] = names[i] + "=" + values[i]; }
  return out;
}

/**
 * `prog args…` with `names[i]=values[i]` set, and everything else as it was.
 *
 * One process and no quoting: the values are handed over as bytes rather than assembled into a shell
 * line, so a value containing a space, a quote or a `$` arrives as it was written.
 */
export Exec withEnv(Cli cli, string[] names, string[] values, string prog, string[] args) {
  return cli.execWith(prog, args, u8[0](), pairs(names, values), false, false).wait();
}

/** The common case: a fixture `HOME`, so `~` resolves somewhere the test built. */
export Exec withHome(Cli cli, string home, string prog, string[] args) {
  return withEnv(cli, string[]("HOME"), string[](home), prog, args);
}

/**
 * `prog args…` with **only** `names[i]=values[i]` — everything else cleared.
 *
 * The third case, and distinct from `withEnv` in what it proves rather than in what it sets. A test
 * that adds a variable is asking what the program does with it; a test that clears the rest is
 * asking what the program does *without* the ones it did not name — which is the only way to make a
 * child's behaviour reproducible when the parent's environment is 37 variables of whatever the host
 * had.
 *
 * `packages/ssh` needs it directly: OpenSSH's client reads `LANG` and `LC_*` and sends them to the
 * server, so a test of what the server does with environment requests is otherwise measuring the
 * machine's locale. `PATH` is the one thing a caller almost always has to name itself, because `env
 * -i` removes it and then nothing can be found by name.
 */
export Exec onlyEnv(Cli cli, string[] names, string[] values, string prog, string[] args) {
  return cli.execWith(prog, args, u8[0](), pairs(names, values), true, false).wait();
}

/**
 * The shell line `onlyEnv` runs, for a caller that has to put something around it.
 *
 * **`exec` goes at the front, not in front of the program** — which is where `commandLine` puts it,
 * and why this cannot simply call it. `env -i A=1 exec prog` asks `env` to run a program called
 * `exec`, and it says `env: ‘exec’: No such file or directory`, which reads like a missing binary
 * rather than a malformed line.
 *
 * **Still a line, now that `onlyEnv` is a capability call**, and not a duplicate of it. Its caller is
 * `packages/ssh`, which puts this *inside* something else — a command line run on the far side of a
 * connection — and a capability cannot be handed to a remote shell. One of them starts a program
 * here; this one is text that becomes a program somewhere else.
 */
export string onlyEnvLine(string[] names, string[] values, string prog, string[] args) {
  string line = "exec env -i";
  for (i32 i = 0; i < names.len() && i < values.len(); i++) {
    line = line + " " + names[i] + "=" + quoted(values[i]);
  }
  line = line + " " + quoted(prog);
  for (i32 i = 0; i < args.len(); i++) { line = line + " " + quoted(args[i]); }
  return line;
}

/**
 * `prog args…` with `names` removed from the environment it would otherwise have inherited.
 *
 * `unset` rather than an empty assignment — see the header. Names are not quoted because `unset`
 * takes identifiers, and a caller passing something that is not one has a bug this should not hide.
 */
export Exec withoutEnv(Cli cli, string[] names, string prog, string[] args) {
  string line = "unset";
  for (i32 i = 0; i < names.len(); i++) { line = line + " " + names[i]; }
  return cli.exec("/bin/sh", string[]("-c", line + "; " + commandLine(prog, args)),
                  u8[0]()).wait();
}
