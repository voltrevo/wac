// One built program per entry, for tests that run the same program more than once.
//
// **`wac run <entry>.wac` compiles the program from source before it runs.** Seven files in
// `packages/git` did that per operation — `commit_test.wac` seven times, at 10.2s — and building once
// took the directory from 36.5s to 12.7s. `packages/tor`'s capture tools and `packages/quic`'s
// program test do the same thing, which is why this lives in `wactest` rather than in one package's
// test directory.
//
// It is also closer to what a person does. `wac run` is the shape for a one-off; a test that runs the
// same program many times is the case `wac build` exists for, and the grants end up in the module's
// manifest rather than on each command line.
//
// ## Freshness
//
// mtimes, the rule `tools/wac/seedfresh_test.wac` uses for the seed: the built module is rebuilt when any
// file **the program is made of** — or the binary that builds it — is newer.
//
// It used to be the newest file under trees the caller named, and this comment defended that as
// "coarser than an import walk on purpose". The cost was measured on 2026-08-19 and it is not a
// rounding error: `arrival_users_test.wac` named `packages`, so *any* of the 902 `.wac` files in the
// tree sent it back to a 12s build of `sshd` — and the gate pulls before it runs, so that was most
// gates. `sshd` reaches 190 files, a fifth of the tree; `packages/fs/example/ops.wac` reaches **nine**
// against the hundreds its caller was naming, and `packages/platform/example/clocks.wac` reaches
// **one**.
//
// So the closure is derived rather than declared, by scanning for `from "…"` and following it. That is
// what `source_probe.wac` does for the corpus and what `closure_of` does in the Rust host, and the
// scan is deliberately a *superset*: prose in a comment that looks like an import adds a path that does
// not exist and is skipped, which costs a `stat`. What it must not do is *miss* one, so it takes the
// text rather than the parse — an import written across two lines still has `from "` in it — and a file
// it cannot read counts as newer than the artefact rather than older.
//
// `std/` and `core/` are not on disk: they are embedded in the compiler, so a change to them arrives as
// a new `wac` binary, whose mtime is checked here anyway.
//
// The cache is `.cache/`, which is per workspace and therefore per agent. Nothing here writes to
// `/tmp`, where three agents would share a name.

import { Cli, Exec, Stat, FileResult } from "std/platform.wac";

/** The newest modification time anywhere under `dir`, or 0 for a directory that is not there. */
export i64 newestUnder(Cli cli, string dir) {
  return newestUnderExcept(cli, dir, string[0](fill: ""));
}

/**
 * The same, ignoring any directory entry named in `skip`.
 *
 * **`target/` is why this exists.** A freshness check on a cargo binary compares it against its own
 * crate's sources, and cargo's output directory is *inside* that crate — so a walk that enters
 * `target/` finds the binary itself, answers "something is newer than the binary", and rebuilds every
 * single time. `packages/raster/test/wac/hosts_test.wac` had a private copy of `newestUnder` that
 * differed from this file's in exactly that line, which is the kind of divergence two copies of one
 * walk are for. `issues/system/0208`.
 */
export i64 newestUnderExcept(Cli cli, string dir, string[] skip) {
  i64 newest = 0 as i64;
  string[]? names = cli.readDir(dir).wait();
  if (names is null) { return 0 as i64; }
  string[] here = names!;
  for (i32 i = 0; i < here.len(); i++) {
    bool skipped = false;
    for (i32 k = 0; k < skip.len(); k++) { if (here[i] == skip[k]) { skipped = true; } }
    if (skipped) { continue; }
    string path = dir + "/" + here[i];
    Stat s = cli.stat(path).wait();
    if (!s.exists) { continue; }
    if (s.isDir) {
      i64 deep = newestUnderExcept(cli, path, skip);
      if (deep > newest) { newest = deep; }
      continue;
    }
    if (s.modifiedMillis > newest) { newest = s.modifiedMillis; }
  }
  return newest;
}

/** The `"…"` after each `from` in a source, which is every import spec plus any prose that looks like one. */
string[] importsOf(string src) {
  i32 found = 0;
  for (i32 i = 0; i + 6 <= src.len(); i++) {
    if (src.slice(i, i + 6) == "from \"") { found = found + 1; }
  }
  string[] out = string[found](fill: "");
  i32 n = 0;
  for (i32 i = 0; i + 6 <= src.len(); i++) {
    if (src.slice(i, i + 6) != "from \"") { continue; }
    i32 from = i + 6;
    i32 to = from;
    while (to < src.len() && src.slice(to, to + 1) != "\"") { to = to + 1; }
    if (to <= src.len() && n < out.len()) { out[n] = src.slice(from, to); n = n + 1; }
  }
  return out;
}

/** `a/b/c.wac` → `a/b`, and `c.wac` → `""`. */
string dirOfPath(string path) {
  for (i32 i = path.len() - 1; i >= 0; i--) {
    if (path.slice(i, i + 1) == "/") { return path.slice(0, i); }
  }
  return "";
}

/**
 * `spec` resolved against the file that wrote it, with `.` and `..` folded out.
 *
 * **A leading slash is kept if there was one.** The first version dropped it, on the reasoning that
 * these paths go to `cli.stat` and are repo-relative — true of every caller that names an entry in the
 * tree, and false of the one that generates its entry: `constanttime_test.wac` writes its drivers to an
 * *absolute* `.cache/ct-…` path, so every import resolved to `home/claude/…` with no root, missed the
 * `stat`, and left each driver as a closure of one. The cache then never noticed a change to the
 * routine under test — which the test's own canary caught by rebuilding nothing when
 * `packages/crypto/src/sha256.wac` was touched.
 */
string resolvedFrom(string fromPath, string spec) {
  string joinedPath = dirOfPath(fromPath) + "/" + spec;
  bool rooted = joinedPath.len() > 0 && joinedPath.slice(0, 1) == "/";
  string[] parts = string[64](fill: "");
  i32 n = 0;
  i32 from = 0;
  for (i32 i = 0; i <= joinedPath.len(); i++) {
    if (i < joinedPath.len() && joinedPath.slice(i, i + 1) != "/") { continue; }
    string part = joinedPath.slice(from, i);
    from = i + 1;
    if (part == "" || part == ".") { continue; }
    if (part == "..") { if (n > 0) { n = n - 1; } continue; }
    if (n >= parts.len()) { return ""; }
    parts[n] = part;
    n = n + 1;
  }
  string out = "";
  for (i32 i = 0; i < n; i++) { out = (i == 0 ? parts[i] : out + "/" + parts[i]); }
  return rooted ? "/" + out : out;
}

/** How many files one program's closure is allowed to reach. `sshd` is the largest here at 190. */
const i32 CLOSURE_CAP = 1024;

/**
 * What one walk of a program's import closure found.
 *
 * `complete` is false when a file in the closure could not be read, which is the case `newestInClosure`
 * turns into "newer than anything". It is separate from `newest` because a caller reporting to a human
 * has to tell "nothing has changed" from "I could not look".
 *
 * `count` is here because a walk that did not resolve returns a closure of one file and is
 * indistinguishable, from the time alone, from a walk that resolved and found nothing newer — so a
 * caller asserting freshness has no way to notice that it has stopped asserting anything.
 */
export struct Closure {
  i64 newest;
  string what;
  i32 count;
  bool complete;
}

/**
 * `entry` and every file it imports, transitively: how many, which was modified last, and when.
 *
 * The walk `newestInClosure` below is a view of. Split out because two callers want different parts of
 * one walk — the build cache wants the time, and a freshness check reporting to a human wants the file
 * name to put in the message and the count to prove the walk resolved.
 */
export Closure closureOf(Cli cli, string entry) {
  string[] seen = string[CLOSURE_CAP](fill: "");
  seen[0] = entry;
  i32 n = 1;
  i32 at = 0;
  i64 newest = 0 as i64;
  string what = "";
  i32 files = 0;
  while (at < n) {
    string path = seen[at];
    at = at + 1;
    Stat s = cli.stat(path).wait();
    // `std/…` and `core/…` resolve to nothing on disk: they live in the compiler, and the binary's own
    // mtime below is what covers them.
    if (!s.isFile) { continue; }
    files = files + 1;
    if (s.modifiedMillis > newest) { newest = s.modifiedMillis; what = path; }
    FileResult f = cli.readFile(path).wait();
    if (!f.ok) { return Closure(newest, what, files, false); }
    string[] specs = importsOf(string.fromBytes(f.bytes));
    for (i32 i = 0; i < specs.len(); i++) {
      string next = resolvedFrom(path, specs[i]);
      if (next == "") { continue; }
      bool have = false;
      for (i32 k = 0; k < n; k++) { if (seen[k] == next) { have = true; } }
      if (have || n >= seen.len()) { continue; }
      seen[n] = next;
      n = n + 1;
    }
  }
  return Closure(newest, what, files, true);
}

/**
 * Every file `entry` reaches, with what is in each — what a compiler API's `emitFiles` takes.
 *
 * The reading half of `wacFiles` in the TypeScript harness, and the thing `issues/system/0289b`
 * records as blocking `wac task size` and `bench:compile`: `packages/wacc/src/api.wac` exposes
 * `emitFiles(paths, sources, entry)`, and until this there was no way for a wac program to produce
 * its arguments.
 *
 * **Deliberately not merged into `closureOf` above**, though it walks the same graph by the same two
 * helpers. `newestInClosure` is asked on every cached build, and a build cache that carried the text
 * of all 190 files `sshd` reaches — to answer a question about mtimes — would be paying for the
 * larger answer every time it wanted the smaller one.
 *
 * **Not `gather`, which is the complete answer.** `packages/wac/src/wac.wac` resolves `@/` project
 * roots and import maps and is what the `wac` command itself uses; this resolves neither, so a
 * program that writes `@/` gets a closure with a hole in it. No caller needs that today — checked
 * across `packages/tor`, `packages/tls` and `packages/crypto`, which is what the blocked tools
 * compile — and `why` names the first file it could not read so a hole is reported rather than
 * compiled.
 */
export struct Sources {
  string[] paths;
  string[] texts;
  /** `""` when the whole closure was read, otherwise the first file that could not be. */
  string why;
}

export Sources sourcesOf(Cli cli, string entry) {
  string[] seen = string[CLOSURE_CAP](fill: "");
  string[] text = string[CLOSURE_CAP](fill: "");
  seen[0] = entry;
  i32 n = 1;
  i32 at = 0;
  i32 kept = 0;
  string[] paths = string[CLOSURE_CAP](fill: "");
  while (at < n) {
    string path = seen[at];
    at = at + 1;
    // `std/…` and `core/…` resolve to nothing on disk: they live in the compiler, and the compiler
    // is what will be handed these, so it already has them.
    if (!cli.stat(path).wait().isFile) { continue; }
    FileResult f = cli.readFile(path).wait();
    if (!f.ok) { return Sources(string[0](fill: ""), string[0](fill: ""), path); }
    string src = string.fromBytes(f.bytes);
    paths[kept] = path;
    text[kept] = src;
    kept = kept + 1;
    string[] specs = importsOf(src);
    for (i32 i = 0; i < specs.len(); i++) {
      string next = resolvedFrom(path, specs[i]);
      if (next == "") { continue; }
      bool have = false;
      for (i32 k = 0; k < n; k++) { if (seen[k] == next) { have = true; } }
      if (have || n >= seen.len()) { continue; }
      seen[n] = next;
      n = n + 1;
    }
  }
  string[] outPaths = string[kept](fill: "");
  string[] outTexts = string[kept](fill: "");
  for (i32 i = 0; i < kept; i++) { outPaths[i] = paths[i]; outTexts[i] = text[i]; }
  return Sources(outPaths, outTexts, "");
}

/**
 * The newest modification time among `entry` and every file it imports, transitively.
 *
 * A file that cannot be read answers `now`, so an artefact is rebuilt rather than trusted when the walk
 * cannot see what it is made of — the safe direction, since the alternative is asserting against
 * yesterday's build.
 */
export i64 newestInClosure(Cli cli, string entry) {
  Closure c = closureOf(cli, entry);
  return c.complete ? c.newest : nowMillis(cli);
}

/** A stand-in for "newer than anything", used when the closure cannot be read. */
i64 nowMillis(Cli cli) {
  Stat s = cli.stat(wacBinary(cli)).wait();
  return s.exists ? s.modifiedMillis + (1000000 as i64) : 1000000000000000;
}

/** The path of the `wac` binary these tests build and run with. */
export string wacBinary(Cli cli) { return cli.cwd().wait() + "/native/v8/target/release/wac"; }

/**
 * The newest mtime of `path`, whether it is a file or a directory.
 *
 * **`newestUnder` answers 0 for a file**, because it asks `readDir` and gets null — so a list of
 * freshness inputs that mixes directories with `Cargo.toml` silently ignores the files, and a
 * lockfile change goes unnoticed. Found while writing exactly that list.
 */
export i64 newestOf(Cli cli, string path) {
  Stat s = cli.stat(path).wait();
  if (!s.exists) { return 0 as i64; }
  if (!s.isDir) { return s.modifiedMillis; }
  return newestUnder(cli, path);
}

/**
 * The wasmtime-hosted `wac` — the same command as `native/v8`'s, on the engine with no JavaScript
 * in it. `./bootstrap.sh --host wasmtime` is what builds it.
 *
 * **It was `wacland` until 2026-08-28**, which put design/system/0001's name for the *system* on
 * the one component underneath it. Both crates produce a binary called `wac`, because the command
 * is `packages/wac/src/wac.wac` and each host carries it as its seed; the engine is the difference.
 */
export string nativeHost(Cli cli) { return cli.cwd().wait() + "/native/target/release/wac"; }

/**
 * `""` when the wasmtime host is built and not older than `native/`, otherwise why not.
 *
 * **A test asks; it does not build.** Five test files each ran their own `cd native && cargo build
 * --release`, in two languages, with five skip messages and two freshness checks that differed in
 * whether they walked `target/` — so the same 2.6s cargo no-op was paid per file, and one of the
 * checks rebuilt every run. `wac task seed`, and `wac task seed:native` for just this crate, own the
 * build now; `tools/wac/seedfresh_test.wac` fails when the binary is older than its sources.
 * `issues/system/0208`.
 *
 * The reason is returned rather than warned, so the caller can put it in its own skip line — the four
 * that skip say different things about what is lost, and that is worth keeping.
 */
export string nativeHostWhyNot(Cli cli) {
  string root = cli.cwd().wait();
  Stat host = cli.stat(nativeHost(cli)).wait();
  if (!host.exists) {
    return "native/target/release/wac is not built — `./bootstrap.sh --host wasmtime` builds it";
  }
  // **The crate's own inputs, named — not a walk of `native/`.** A blanket walk answered "stale"
  // forever: `native/v8/seed/*.wasm` is the *seed's output*, written by every `wac task seed`, and it
  // lives under `native/` without being inside a `target/`. So every seed made the wasmtime binary look older
  // than its sources, six callers skipped their native halves, and the two that *assert* the native
  // half ran failed in the gate. The list is `tools/wac/seedfresh_test.wac`'s, which had it right, and it
  // is `native/`'s crate — `native/v8` is the other one.
  string[] inputs = string[]("native/src", "native/manifest/src", "native/Cargo.toml",
                             "native/Cargo.lock", "native/build.rs");
  for (i32 i = 0; i < inputs.len(); i++) {
    if (host.modifiedMillis < newestOf(cli, root + "/" + inputs[i])) {
      return "native/target/release/wac is older than " + inputs[i]
          + " — `./bootstrap.sh --host wasmtime` rebuilds it";
    }
  }
  return "";
}

/**
 * `entry` built into `.cache/built-<name>/<name>.wasm` with `grants`, or the one already there.
 *
 * `name` is what the module is called on disk; two entries must not share one. `grants` are the
 * `--allow-…` flags the program needs, which go into its manifest at build time — a built module is
 * run as `wac <module.wasm> <args…>` with no flags at all.
 *
 * Answers the path either way. A build that fails leaves no module, and the caller's first run says
 * so: `wac` reports the missing file and the test's own assertion on the exit status carries it.
 *
 * ## The flags are part of the cache key, and were not until 2026-08-20
 *
 * The key was `name` plus the mtimes of the entry's closure and of the `wac` binary. `grants` was not
 * in it — so **two calls with the same `name` and different flags got the first one's module**, with
 * nothing said. `builtByDeno` below has the identical hazard and documents it ("`name` must
 * distinguish everything that changes the output"); this one had it and did not.
 *
 * It cost about ten minutes: `packages/crypto/test/wac/constanttime_test.wac` gained a journal-size
 * argument, passed `--trace-slots 16777216` for a routine whose 7.4 million events overflow the
 * default, and kept being told `truncated 7399082` with the *same* count each time. The flag was
 * never reaching a build.
 *
 * The flags are written beside the module and compared verbatim rather than hashed — an exact
 * comparison cannot collide, the file is two lines, and a missing sidecar forces a rebuild, which is
 * the right way to be wrong.
 */
export string builtProgram(Cli cli, string entry, string name, string[] grants) {
  string wac = wacBinary(cli);
  string dir = cli.cwd().wait() + "/.cache/built-" + name;
  cli.mkdir(dir, true).wait();
  string stem = dir + "/" + name;
  Stat have = cli.stat(stem + ".wasm").wait();

  string want = "";
  for (i32 i = 0; i < grants.len(); i++) { want = want + grants[i] + "\n"; }
  FileResult had = cli.readFile(stem + ".flags").wait();
  bool sameFlags = had.ok && string.fromBytes(had.bytes) == want;

  i64 newest = newestInClosure(cli, entry);
  Stat bin = cli.stat(wac).wait();
  if (bin.exists && bin.modifiedMillis > newest) { newest = bin.modifiedMillis; }
  if (have.exists && sameFlags && have.modifiedMillis > newest) { return stem + ".wasm"; }

  string[] args = string[4 + grants.len()](fill: "");
  args[0] = "build";
  args[1] = entry;
  args[2] = "-o";
  args[3] = stem;
  for (i32 i = 0; i < grants.len(); i++) { args[4 + i] = grants[i]; }
  // **A build that failed takes the old artefact with it.** The answer used to be dropped here, and a
  // stale `.wasm` is worse than none: the caller runs it, it runs — it is a real module, the one from
  // before the program broke — and the test passes against code that no longer compiles. That is
  // silence in the direction of green, and it cost a diagnosis: an edit to
  // `packages/platform/test/wac/exec_probe.wac` looked like it had no effect, when what had happened
  // was that the probe stopped compiling and yesterday's build kept answering for it.
  //
  // Deleted rather than reported, because 29 call sites take this path and every one of them then runs
  // what it was handed: a missing artefact fails all 29, where a status fails only the ones that
  // remembered to look. The compiler's own message went to this process's stderr on the way past, so
  // the reason is in the run's output even though the return value cannot carry it. `.flags` goes too,
  // or a later build with the same grants would find a sidecar agreeing with it and no module.
  Exec built = cli.exec(wac, args, u8[0]()).wait();
  if (!built.ran() || built.status != 0) {
    cli.remove(stem + ".wasm", false).wait();
    cli.remove(stem + ".flags", false).wait();
    return stem + ".wasm";
  }
  cli.writeFile(stem + ".flags", want.toBytes()).wait();
  return stem + ".wasm";
}

/**
 * The same, built with `wac app` — a file you run, rather than a module `wac` runs.
 *
 * `builtProgram` above answers a `.wasm` that the caller hands back to `wac`. This answers an
 * artefact that is executable itself, which is what a test needs when the thing under test is *being
 * a program*: what it does on a PATH, what its exit status is to a shell, whether a pipeline sees it.
 * `harness/buildApp.ts` is the TypeScript this replaces. Four wac tests spawn `wac app` inline today
 * and **none of them should call this**: `app_test.wac`, `commandparity_test.wac` and
 * `setexecutable_test.wac` are testing that command — its usage line, its refusals, whether its output
 * is executable — and a helper that caches the artefact and swallows the `Exec` is the wrong shape for
 * asserting on a build that is *supposed* to fail. `bootstrap_test.wac` builds a probe to test
 * something else and could move, which is one caller and not a reason.
 *
 * So this exists for the `corpus:*` tools, which is the same population `buildApp.ts` served: a
 * program built in order to measure something else about it.
 *
 * **The artefact needs `wac` on PATH to run.** `wac app` writes a shell preamble that runs
 * `command -v wac` and execs `wac app-run "$0"`, so the binary is not self-contained and a caller that
 * clears the child's environment has to put one there. This does not do it for them: the TypeScript
 * mutated its own process's PATH at import, which works when the test *is* the Deno process and does
 * not when the runner is a wac program spawning a shell. Pass it in the child's env, and prefer this
 * checkout's own — `wacBinary(cli)`'s directory — because an installed `wac` elsewhere on PATH is a
 * different compiler and a test about this tree should not be answered by it.
 *
 * **`WAC_PROFILE` instrumentation is not carried over, and that is a real loss.** `buildApp.ts`'s
 * comment called it "how every existing subprocess test becomes attributable without being edited";
 * `wac app` cannot, because the flag was accepted and wrote no table to read the counters with, and it
 * is refused rather than left looking like it works. `issues/system/0274c` holds the three decisions a
 * profiled app would need. So a mutation run over `packages/box/` loses subprocess attribution — which
 * is written down here rather than discovered later from a coverage number that quietly dropped, the
 * failure `issues/system/0160` already cost two days.
 *
 * **Not known yet: whether this needs an `ETXTBSY` retry.** `harness/spawnRetry.ts` exists because a
 * parallel suite failed three times in one day executing a binary it had just built, and every
 * TypeScript test that builds and runs imports it. Nothing here does that yet, because the caches
 * above mean most calls write nothing at all and the window only exists after a fresh build — so the
 * honest answer is that it has not been observed on this path, not that it cannot happen. If a test
 * that builds an app starts failing under load with *Text file busy*, this is the note that says the
 * retry belongs here and why it was not written in advance.
 */
export string builtApp(Cli cli, string entry, string name, string[] grants) {
  string wac = wacBinary(cli);
  string dir = cli.cwd().wait() + "/.cache/built-" + name;
  cli.mkdir(dir, true).wait();
  string out = dir + "/" + name;

  string want = "";
  for (i32 i = 0; i < grants.len(); i++) { want = want + grants[i] + "\n"; }
  FileResult had = cli.readFile(out + ".flags").wait();
  bool sameFlags = had.ok && string.fromBytes(had.bytes) == want;

  Stat have = cli.stat(out).wait();
  i64 newest = newestInClosure(cli, entry);
  Stat bin = cli.stat(wac).wait();
  if (bin.exists && bin.modifiedMillis > newest) { newest = bin.modifiedMillis; }
  if (have.exists && sameFlags && have.modifiedMillis > newest) { return out; }

  string[] args = string[4 + grants.len()](fill: "");
  args[0] = "app";
  args[1] = entry;
  args[2] = "-o";
  args[3] = out;
  for (i32 i = 0; i < grants.len(); i++) { args[4 + i] = grants[i]; }
  // The same rule as `builtProgram`: a failed build takes the artefact with it, because a stale one
  // still runs and the test then passes against code that no longer compiles.
  Exec built = cli.exec(wac, args, u8[0]()).wait();
  if (!built.ran() || built.status != 0) {
    cli.remove(out, false).wait();
    cli.remove(out + ".flags", false).wait();
    return out;
  }
  cli.writeFile(out + ".flags", want.toBytes()).wait();
  return out;
}

/**
 * The same idea for `packages/platform/build.ts`, which is the *Deno* builder: a program built for the
 * deno or node host, or the worker half a `spawn` takes.
 *
 * **`build.ts` already caches the work** — `appKey` keys a build on the content of every file it
 * reads — so what this saves is the process: a warm call is 180-410ms of Deno starting, and
 * `packages/platform/test/wac/spawn_test.wac` makes fourteen of them across seven tests, most for the
 * same three programs. The artefact lands in one place and the caller copies it where it wants, which
 * is what keeps the per-test directories that stop one case reading another's files.
 *
 * `name` must distinguish everything that changes the output — the entry, the grants, the target and
 * whether it is the worker half — because they all land under it. `WAC_PROFILE` is cleared for the
 * same reason `spawn_test` clears it: an instrumented build carries a scoped `--allow-write` for its
 * counter dump, and a test asserting on a shebang would see it.
 */
export string builtByDeno(Cli cli, string entry, string name, string[] grants, string target,
                          bool worker) {
  string dir = cli.cwd().wait() + "/.cache/built-" + name;
  cli.mkdir(dir, true).wait();
  string out = dir + "/" + name + (worker ? ".worker.js" : "");
  Stat have = cli.stat(out).wait();

  i64 newest = newestInClosure(cli, entry);
  // **And `compiler/`**, which is the other half of this path: `build.ts` binds `wacc` through the
  // *reference* compiler, so an edit there changes what comes out even when no `.wac` moved.
  i64 ref = newestUnder(cli, "compiler");
  if (ref > newest) { newest = ref; }
  Stat builder = cli.stat("packages/platform/build.ts").wait();
  if (builder.exists && builder.modifiedMillis > newest) { newest = builder.modifiedMillis; }
  // **And `host/`, which is the rest of what goes into the artefact.** `build.ts` bundles `entry.ts`,
  // `deno.ts`, `children.ts` and their imports into every program it writes, and this check watched
  // only the file that does the bundling — so a host change left every cached build in place. Found by
  // widening a refusal message in `children.ts` and having a test assert the *old* sentence, from a
  // binary built before the edit: the message was right, the build was three minutes old, and the
  // failure named neither. `build.ts` keys its own work on the content of every file it reads, so this
  // is the only stale link in the chain.
  i64 host = newestUnder(cli, "packages/platform/host");
  if (host > newest) { newest = host; }
  if (have.exists && have.modifiedMillis > newest) { return out; }

  string line = "exec env -u WAC_PROFILE deno run -A packages/platform/build.ts \"" + entry + "\"";
  for (i32 i = 0; i < grants.len(); i++) { line = line + " " + grants[i]; }
  line = line + " --target " + target;
  if (worker) { line = line + " --worker"; }
  line = line + " -o \"" + out + "\"";
  Exec r = cli.exec("/bin/sh", string[]("-c", line), u8[0]()).wait();
  if (!r.ran() || r.status != 0) { return ""; }
  return out;
}

/**
 * Write `bytes` to `path` only if they are not already there, and answer whether the file now holds them.
 *
 * **For a generated entry, this is what makes a cache possible at all.** A test that writes its driver
 * every run gives it a new mtime every run, so `builtProgram` below rebuilds every run however little
 * changed — `packages/crypto/test/wac/constanttime_test.wac` generates fourteen drivers that differ only
 * in an array literal and are byte-identical between runs. Comparing first costs one read.
 */
export bool writeIfDifferent(Cli cli, string path, u8[] bytes) {
  FileResult had = cli.readFile(path).wait();
  if (had.ok && had.bytes.len() == bytes.len()) {
    bool same = true;
    for (i32 i = 0; i < bytes.len() && same; i++) { if (had.bytes[i] != bytes[i]) { same = false; } }
    if (same) { return true; }
  }
  return cli.writeFile(path, bytes).wait().ok();
}

/** `from` to `to`, since `Cli` has no copy. Answers whether it landed. */
export bool copyBuilt(Cli cli, string from, string to, bool executable) {
  FileResult r = cli.readFile(from).wait();
  if (!r.ok) { return false; }
  if (!cli.writeFile(to, r.bytes).wait().ok()) { return false; }
  if (executable) { cli.setExecutable(to, true).wait(); }
  return true;
}
