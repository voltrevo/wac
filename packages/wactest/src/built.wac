// One built program per entry, for tests that run the same program more than once.
//
// **`wac run <entry>.wac` compiles the program from source before it runs.** Seven files in
// `packages/git` did that per operation — `commit_test.wac` seven times, at 10.2s — and building once
// took the directory from 36.5s to 12.7s. `packages/tor`'s capture tools and `packages/quic`'s
// program test do the same thing, which is why this lives in `wactest` rather than in one package's
// test directory.
//
// It is also closer to what a person does. `wac run` is the shape for a one-off; a test that runs the
// same program many times is the case `wac build` exists for, and the grants end up in the module's
// manifest rather than on each command line.
//
// ## Freshness
//
// mtimes, the rule `tools/seedFresh.test.ts` uses for the seed: the built module is rebuilt when
// anything under `trees` — or the binary that builds it — is newer. The caller names those trees
// because only the caller knows what its program is made of. Coarser than an import walk on purpose,
// because the failure mode that matters is "somebody edited the package and the test kept using
// yesterday's build", and a directory mtime scan catches that for the price of a few dozen stats.
//
// The cache is `.cache/`, which is per workspace and therefore per agent. Nothing here writes to
// `/tmp`, where three agents would share a name.

import { Cli, Exec, Stat, FileResult } from "std/platform.wac";

/** The newest modification time anywhere under `dir`, or 0 for a directory that is not there. */
export i64 newestUnder(Cli cli, string dir) {
  i64 newest = 0 as i64;
  string[]? names = cli.readDir(dir).wait();
  if (names is null) { return 0 as i64; }
  string[] here = names!;
  for (i32 i = 0; i < here.len(); i++) {
    string path = dir + "/" + here[i];
    Stat s = cli.stat(path).wait();
    if (!s.exists) { continue; }
    if (s.isDir) {
      i64 deep = newestUnder(cli, path);
      if (deep > newest) { newest = deep; }
      continue;
    }
    if (s.modifiedMillis > newest) { newest = s.modifiedMillis; }
  }
  return newest;
}

/** The path of the `wac` binary these tests build and run with. */
export string wacBinary(Cli cli) { return cli.cwd().wait() + "/native/v8/target/release/wac"; }

/**
 * `entry` built into `.cache/built-<name>/<name>.wasm` with `grants`, or the one already there.
 *
 * `name` is what the module is called on disk; two entries must not share one. `grants` are the
 * `--allow-…` flags the program needs, which go into its manifest at build time — a built module is
 * run as `wac <module.wasm> <args…>` with no flags at all.
 *
 * Answers the path either way. A build that fails leaves no module, and the caller's first run says
 * so: `wac` reports the missing file and the test's own assertion on the exit status carries it.
 */
export string builtProgram(Cli cli, string entry, string name, string[] grants, string[] trees) {
  string wac = wacBinary(cli);
  string dir = cli.cwd().wait() + "/.cache/built-" + name;
  cli.mkdir(dir, true).wait();
  string stem = dir + "/" + name;
  Stat have = cli.stat(stem + ".wasm").wait();

  i64 newest = 0 as i64;
  for (i32 i = 0; i < trees.len(); i++) {
    i64 deep = newestUnder(cli, trees[i]);
    if (deep > newest) { newest = deep; }
  }
  Stat bin = cli.stat(wac).wait();
  if (bin.exists && bin.modifiedMillis > newest) { newest = bin.modifiedMillis; }
  if (have.exists && have.modifiedMillis > newest) { return stem + ".wasm"; }

  string[] args = string[4 + grants.len()](fill: "");
  args[0] = "build";
  args[1] = entry;
  args[2] = "-o";
  args[3] = stem;
  for (i32 i = 0; i < grants.len(); i++) { args[4 + i] = grants[i]; }
  cli.exec(wac, args, u8[0]()).wait();
  return stem + ".wasm";
}

/**
 * The same idea for `packages/platform/build.ts`, which is the *Deno* builder: a program built for the
 * deno or node host, or the worker half a `spawn` takes.
 *
 * **`build.ts` already caches the work** — `appKey` keys a build on the content of every file it
 * reads — so what this saves is the process: a warm call is 180-410ms of Deno starting, and
 * `packages/platform/test/wac/spawn_test.wac` makes fourteen of them across seven tests, most for the
 * same three programs. The artefact lands in one place and the caller copies it where it wants, which
 * is what keeps the per-test directories that stop one case reading another's files.
 *
 * `name` must distinguish everything that changes the output — the entry, the grants, the target and
 * whether it is the worker half — because they all land under it. `WAC_PROFILE` is cleared for the
 * same reason `spawn_test` clears it: an instrumented build carries a scoped `--allow-write` for its
 * counter dump, and a test asserting on a shebang would see it.
 */
export string builtByDeno(Cli cli, string entry, string name, string[] grants, string target,
                          bool worker, string[] trees) {
  string dir = cli.cwd().wait() + "/.cache/built-" + name;
  cli.mkdir(dir, true).wait();
  string out = dir + "/" + name + (worker ? ".worker.js" : "");
  Stat have = cli.stat(out).wait();

  i64 newest = 0 as i64;
  for (i32 i = 0; i < trees.len(); i++) {
    i64 deep = newestUnder(cli, trees[i]);
    if (deep > newest) { newest = deep; }
  }
  Stat builder = cli.stat("packages/platform/build.ts").wait();
  if (builder.exists && builder.modifiedMillis > newest) { newest = builder.modifiedMillis; }
  if (have.exists && have.modifiedMillis > newest) { return out; }

  string line = "exec env -u WAC_PROFILE deno run -A packages/platform/build.ts \"" + entry + "\"";
  for (i32 i = 0; i < grants.len(); i++) { line = line + " " + grants[i]; }
  line = line + " --target " + target;
  if (worker) { line = line + " --worker"; }
  line = line + " -o \"" + out + "\"";
  Exec r = cli.exec("/bin/sh", string[]("-c", line), u8[0]()).wait();
  if (!r.ran() || r.status != 0) { return ""; }
  return out;
}

/** `from` to `to`, since `Cli` has no copy. Answers whether it landed. */
export bool copyBuilt(Cli cli, string from, string to, bool executable) {
  FileResult r = cli.readFile(from).wait();
  if (!r.ok) { return false; }
  if (!cli.writeFile(to, r.bytes).wait().ok()) { return false; }
  if (executable) { cli.setExecutable(to, true).wait(); }
  return true;
}
