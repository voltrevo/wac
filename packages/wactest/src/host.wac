// What a wac test needs to know about the machine it is running on.
//
// A test that spawns the `wac` binary, or writes a scratch file, has to answer the same three
// questions every time: where the binary is, who "we" are, and where it is safe to write. Ten test
// files had answered them with the same twenty lines copied verbatim — byte-identical, which is
// what makes it worth having once rather than a difference worth preserving.
//
// **Several agents share this filesystem**, which is the whole reason `scratch` takes a name and
// stirs the agent into it. Two agents running the same test at the same time against one fixed
// `/tmp` path do not fail: they interleave, and the one whose file was overwritten reports a
// mismatch in whatever it was actually testing. That is the worst kind of red — a true failure
// message about the wrong thing.

import { Change, Core, Cli, Exec } from "std/platform.wac";
import { nativeHost, nativeHostWhyNot } from "./built.wac";

/** Where `wac task seed` puts the binary, absolute, so `exec` does not depend on a PATH. */
export string binaryPath(Cli cli) {
  return cli.cwd().wait() + "/native/v8/target/release/wac";
}

/** The first `/agent-…/` segment of `cwd`, or "" — several agents share this filesystem. */
export string agentDir(Cli cli) {
  string cwd = cli.cwd().wait();
  u8[] b = cwd.toBytes();
  for (i32 i = 0; i + 7 < b.len(); i++) {
    if (b[i] != '/') { continue; }
    if (cwd.slice(i + 1, i + 7) != "agent-") { continue; }
    i32 end = i + 7;
    while (end < b.len() && b[end] != '/') { end = end + 1; }
    return cwd.slice(i + 1, end);
  }
  return "";
}

/**
 * A scratch directory under `/tmp`, named for the caller and for whoever is running it.
 *
 * `name` distinguishes one test's workspace from another's; the agent segment distinguishes this
 * checkout's from the one next door. Neither is created — the caller does that, because it is the
 * caller that has a `T` to report the failure to.
 */
export string scratch(Cli cli, string name) {
  string who = agentDir(cli);
  return "/tmp/wac-" + name + (who == "" ? "" : "-" + who);
}

/**
 * The **wasmtime** host binary — `wacland` — built when its sources are newer than it, or `""`.
 *
 * The second host is how a two-host differential has two hosts, so a test that cannot find it has to
 * say so: *silent skipping is how a differential test comes to compare nothing*. `who` names the
 * caller in that message, because the line is read in a run of ninety files.
 *
 * **The staleness test is `find -newer`, not a rebuild every time.** `cargo build --release` on a warm
 * target is a second or two and on a cold one is minutes, and three test files ask for this binary in a
 * suite pass.
 *
 * Two copies of this existed — `native_shell_test.wac` and `arrival_users_test.wac` — and they had
 * drifted in exactly one respect: one warned when the build failed and the other returned `""` in
 * silence. The warning is the version that is kept. `issues/system/0161`.
 */
export string nativeBinaryPath(Core core, Cli cli, string who) {
  // **Asks; does not build.** The build is `wac task seed`'s, and `wac task seed:native` does this
  // crate alone — `issues/system/0208`, where five files each ran their own cargo with five skip
  // messages and two freshness checks.
  //
  // **And the check this replaces did not work.** It was
  // `find native -name '*.rs' -o -name Cargo.toml -newer P -print -quit`, where `-o` binds looser than
  // the implicit `-a`: the expression is `(-name '*.rs')` or `(-name Cargo.toml -a -newer P -a -print
  // -a -quit)`. The first branch carries no action, and `-print` in the second suppresses find's
  // implicit one — so **a changed `.rs` file printed nothing and no rebuild was triggered.** Only
  // `Cargo.toml` was ever watched, in the helper that ten test files share.
  string why = nativeHostWhyNot(cli);
  if (why != "") {
    core.warn(who + ": SKIPPING the native half — " + why);
    return "";
  }
  return nativeHost(cli);
}

/**
 * Create `dir` if it is not there — `""` when that worked, and why not when it did not.
 *
 * **Nineteen test files had these four lines each and every one threw the answer away.**
 * `mkdir` and `remove` both answer a `Change` carrying a fault and the host's own words, and a `mkdir`
 * that failed leaves every script in the file running with a working directory that does not exist. What
 * reaches the screen then is the *consequence*, once per case: `native_shell_test.wac` failed a gate with
 * sixteen shells each saying `/bin/sh: 1: cd: can't cd to …/.cache/hostshell-seal`, and nothing in the
 * output named the fixture. The diagnosis starts from the wrong end. `issues/system/0229`.
 *
 * **The path stays the caller's and only this is shared.** `.cache/world-`, `.cache/tls/`, `/tmp/wac-` —
 * each test's directory is legitimately its own, and what was identical nineteen times is *make it
 * fresh, and say so if you cannot*.
 *
 * **The reason is returned rather than warned, because the caller is a test.** A `core.warn` needs a
 * `Core` these helpers do not take, and a `trap` takes the rest of the file's cases down with it and
 * loses the message — which is the thing being fixed. A returned reason becomes one `t.isTrue` in the
 * caller, which has a `T`, and the failure then names the directory and the host's words.
 */
/**
 * Write `text` at `path`, making the directory above it — `""` when that worked, and why not otherwise.
 *
 * **Five test files had these four lines each**, byte for byte, and every one threw the `mkdir`'s answer
 * away — `if (cut > 0) { cli.mkdir(path.slice(0, cut), true).wait(); }`. Not silently: `writeFile` failed
 * too and the `bool` carried that, so the cost was a *misattributed* failure — "could not write x" where
 * the directory above it was what could not be made. That is `issues/system/0229` again in a second
 * helper, and the `scratch` copies were the first.
 *
 * `cut > 0` rather than `>= 0`: a leading `/` means the parent is the root, which exists.
 */
export string putFile(Cli cli, string path, string text) {
  i32 cut = -1;
  for (i32 i = 0; i < path.len(); i++) { if (path.slice(i, i + 1) == "/") { cut = i; } }
  if (cut > 0) {
    string why = madeDir(cli, path.slice(0, cut));
    if (why != "") { return why; }
  }
  Change wrote = cli.writeFile(path, text.toBytes()).wait();
  if (!wrote.ok()) { return "could not write " + path + " — " + wrote.message; }
  return "";
}

export string madeDir(Cli cli, string dir) {
  Change made = cli.mkdir(dir, true).wait();
  if (!made.ok()) { return "could not create " + dir + " — " + made.message; }
  return "";
}

/**
 * `madeDir`, and **empty it first** — for a directory whose contents must not survive the last run.
 *
 * The two are separate because the difference is destructive in one direction. Two of the sites this
 * was written for create a directory and deliberately do *not* clear it: `echod_test`'s build output and
 * `network_test`'s `shared`, whose neighbouring comment says the first case builds and "the other twelve
 * reuse". Sweeping those onto this function would have emptied a build cache on every case and turned
 * twelve reuses into twelve rebuilds — silently, and looking like a slow test rather than a wrong one.
 *
 * **`remove` is allowed to fail for exactly one reason**, which is the directory not being there: that is
 * the ordinary first run, and `Change.absent` is the question `rm -f` asks. Anything else means the
 * directory is about to be reused with something in it, which is the case worth a message.
 */
export string freshDir(Cli cli, string dir) {
  Change gone = cli.remove(dir, true).wait();
  if (!gone.ok() && !gone.absent()) {
    return "could not empty " + dir + " — " + gone.message;
  }
  Change made = cli.mkdir(dir, true).wait();
  if (!made.ok()) { return "could not create " + dir + " — " + made.message; }
  return "";
}
