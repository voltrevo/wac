// What a test runner has to guarantee, asked of the runner that is now doing the running.
//
// These three were packages/wactest/test/assert.test.ts, and their subject was `wacTestRun` — the
// TypeScript harness that discovered `test*` exports, called them, and turned a returned string into
// a failure. `wac test` does that now, so translating a test of the old harness would have pinned
// something on its way out. What moved is the *guarantee*, asked of the thing that has to keep it.
//
// All three are the same failure in different disguises: **a runner that runs nothing looks exactly
// like a runner whose tests all pass.**
//
//   - discovery has to find every `test*` export, or a renamed one silently stops running;
//   - a file that exports none has to be an error, because a misnamed export is that file;
//   - a failing assertion's message has to come back, because a runner that ignored the returned
//     string would make every wac test in the repository pass.
//
// Host-side until 2026-08-18, `issues/system/0161`. `packages/wacc/test/wac/cli_test.wac` covers the
// command line's *surface* and says the behaviour behind each command belongs in the file named after
// its subject; this is that file for the runner.

import { T } from "../../src/assert.wac";
import { contains } from "../../src/strings.wac";
import { Cli, Exec, Change, ChildEnv, Env, Files, Launch, Procs, Sys } from "std";
import { madeDir } from "../../src/host.wac";
import { flatten } from "core";

/** `wac`, beside the working directory rather than on a `PATH` `Cli.exec` does not pass. */
string binary(Env env) { return "\{flatten(env.cwd().wait()).unwrap()}/native/v8/target/release/wac"; }

/** Everything the binary said, both streams — a runner's verdict is not all on one of them. */
string said(Exec r) { return string.fromBytes(r.stdout) + string.fromBytes(r.stderr); }

Exec runTest(Env env, Procs procs, string path) {
  return flatten(procs.exec(binary(env), ["test", path], u8[](), ChildEnv.inherited(), Launch.plain()).wait()).unwrap();
}

export string test_discovery_finds_every_test_export_and_runs_it(Sys sys) {
  Env env = sys.env();
  Procs procs = sys.procs();
  // End to end rather than by inspecting the module: what matters is not that the exports are
  // *there* but that the runner reaches them. `assert_test.wac` beside this one is the file whose
  // tests these are, and it has had at least seven for as long as the guarantee has existed.
  T t = T.create();
  Exec r = runTest(env, procs, "packages/wactest/test/wac/assert_test.wac");
  t.isTrue(r.ran(), "the binary ran — \{r.error}");
  if (!r.ran()) { return t.report(); }
  t.eqI32(r.status, 0, "assert_test.wac passes — \{said(r)}");

  // "7 passed" or more. Read as text because the count is what the claim is about: a runner that
  // found one test would exit 0 just as happily.
  bool enough = false;
  for (i32 n = 7; n <= 64; n++) { if (contains(said(r), "\{n} passed")) { enough = true; } }
  t.isTrue(enough, "fewer than seven tests were discovered — \{said(r)}");
  return t.report();
}

export string test_a_file_with_no_tests_is_an_error_not_a_silent_pass(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  // The failure mode worth guarding: a misnamed export means zero tests run and everything "passes".
  T t = T.create();
  string dir = "\{flatten(env.cwd().wait()).unwrap()}/.cache";
  string whyDir1 = madeDir(fs, dir);
  t.isTrue(whyDir1 == "", whyDir1);
  string path = "\{dir}/_runner_empty_test.wac";
  auto wrote = flatten(fs.writeFile(path, "export i32 notATest() { return 1; }\n".toBytes()).wait());
  t.isTrue(wrote.isOk(), "wrote the fixture");
  if (wrote.isErr()) { return t.report(); }

  Exec r = runTest(env, procs, path);
  t.isTrue(r.ran(), "the binary ran — \{r.error}");
  if (r.ran()) {
    t.isTrue(r.status != 0, "a file exporting no tests exited 0");
    t.isTrue(contains(said(r), "exports no tests"),
             "it did not say what was wrong — \{said(r)}");
  }
  fs.remove(path, false).wait();
  return t.report();
}

export string test_a_failing_assertion_surfaces_its_message(Sys sys) {
  Env env = sys.env();
  Procs procs = sys.procs();
  // A runner that ignored the returned string would make every wac test in the repository pass, so
  // this drives a fixture designed to fail and checks the exact sentence comes back.
  //
  // `fixture_failing.wac` is not named `*_test.wac`, so the directory walk does not pick it up and
  // the suite does not go red on a file whose whole purpose is to be red.
  T t = T.create();
  Exec r = runTest(env, procs, "packages/wactest/test/wac/fixture_failing.wac");
  t.isTrue(r.ran(), "the binary ran — \{r.error}");
  if (!r.ran()) { return t.report(); }
  t.eqI32(r.status, 3, "a file whose test fails exits 3 — \{said(r)}");
  t.isTrue(contains(said(r), "deliberate: got 1, want 2"),
           "the assertion's own message did not come back — \{said(r)}");
  t.isTrue(contains(said(r), "test_deliberately_fails"),
           "the failing test was not named — \{said(r)}");
  return t.report();
}
