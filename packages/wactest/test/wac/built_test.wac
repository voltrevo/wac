// A program that stopped compiling must not be replaced by the last one that did.
//
//     wac test --allow-read --allow-write --allow-run --allow-env packages/wactest/test/wac/built_test.wac
//
// `builtProgram` caches: it compares the artefact's mtime against the newest file in the entry's
// closure and against the binary, and rebuilds when either is newer. What it did not do is look at
// whether the rebuild **worked** — `cli.exec(wac, args, …)` with the answer dropped on the floor — so a
// build that failed left the previous `.wasm` exactly where it was and handed its path back.
//
// The caller then runs it, and it runs, because it is a real module: the one that was built before the
// program broke. **The test passes, against code that no longer compiles.** That is worth more than the
// usual "silent is bad" argument because it is silent in the direction of *green*, and it cost a
// diagnosis the day this was written: an edit to `exec_probe.wac` appeared to have no effect, and the
// reason was that the probe had stopped compiling and the harness was running yesterday's build of it.
//
// Deleting on failure rather than returning an error, because the signature has 29 callers and every
// one of them then runs what it was handed. A missing artefact fails all 29 loudly; a status they
// would each have to check fails the ones that remembered.

import { T } from "../../src/assert.wac";
import { Core, Cli, Exec, Stat } from "std/platform.wac";
import { Sources, builtApp, builtProgram, sourcesOf } from "../../src/built.wac";
import { freshDir, putFile } from "../../src/host.wac";
import { contains, startsWith } from "../../src/strings.wac";

const string GOOD = "import { Core, Cli } from \"std/platform.wac\";\n"
  + "export i32 main(Core core, Cli cli) { return 0; }\n";
/** Same shape, and it does not compile: nothing declares `nosuchthing`. */
const string BROKEN = "import { Core, Cli } from \"std/platform.wac\";\n"
  + "export i32 main(Core core, Cli cli) { return nosuchthing(); }\n";

export string test_a_program_that_stopped_compiling_is_not_served_from_before(Core core, Cli cli) {
  T t = T.create();
  string dir = cli.cwd().wait() + "/.cache/built-probe-src";
  t.isTrue(freshDir(cli, dir) == "", "the fixture directory could not be made");
  string entry = dir + "/p.wac";
  t.isTrue(putFile(cli, entry, GOOD) == "", "could not write the program");

  string built = builtProgram(cli, entry, "builtprobe", string[0](fill: ""));
  Stat first = cli.stat(built).wait();
  t.isTrue(first.exists && first.size > 8, "the first build wrote nothing to " + built);
  if (!first.exists) { return t.report(); }

  // Break it. The mtime moves, so the cache knows it must rebuild; the rebuild then fails.
  t.isTrue(putFile(cli, entry, BROKEN) == "", "could not break the program");
  string again = builtProgram(cli, entry, "builtprobe", string[0](fill: ""));
  Stat after = cli.stat(again).wait();
  t.isTrue(!after.exists,
      "a failed build left the artefact from before it broke, so every caller of `builtProgram` runs "
      + "the last version that compiled and passes against code that does not");

  // And it recovers: fixing the program builds again, so the deletion is not a latch.
  t.isTrue(putFile(cli, entry, GOOD) == "", "could not restore the program");
  Stat fixed = cli.stat(builtProgram(cli, entry, "builtprobe", string[0](fill: ""))).wait();
  t.isTrue(fixed.exists && fixed.size > 8, "a fixed program did not build again");

  cli.remove(dir, true).wait();
  cli.remove(cli.cwd().wait() + "/.cache/built-builtprobe", true).wait();
  return t.report();
}

/**
 * `builtApp` answers something you can *run*, which is the whole reason it is not `builtProgram`.
 *
 * Asserting on the exit status rather than on the file's bytes: `wac app` writes a shell preamble and
 * what matters about it is that a shell will execute it and the program's own status comes back. A
 * test that only stat'd the artefact would pass for a file that is executable and does nothing, which
 * is exactly the artefact a broken preamble produces.
 *
 * **The child gets a PATH with this checkout's `wac` first.** The preamble runs `command -v wac`, so
 * an artefact run with no PATH fails with *needs the wac command on PATH* and an inherited PATH might
 * find an installed `wac` that is a different compiler.
 */
export string test_a_built_app_runs_and_answers_its_own_exit_status(Core core, Cli cli) {
  T t = T.create();
  string dir = cli.cwd().wait() + "/.cache/built-appprobe-src";
  t.isTrue(freshDir(cli, dir) == "", "the fixture directory could not be made");
  string entry = dir + "/p.wac";
  // Exit 7, so the assertion cannot pass by accident on a 0 that means "did nothing".
  t.isTrue(putFile(cli, entry,
      "import { Core, Cli } from \"std/platform.wac\";\n"
      + "export i32 main(Core core, Cli cli) { core.log(\"from the app\"); return 7; }\n") == "",
      "could not write the program");

  string app = builtApp(cli, entry, "appprobe", string[0](fill: ""));
  Stat made = cli.stat(app).wait();
  t.isTrue(made.exists && made.size > 8, "builtApp wrote nothing to " + app);
  if (!made.exists) { return t.report(); }

  string binDir = cli.cwd().wait() + "/native/v8/target/release";
  Exec ran = cli.execWithIn(app, string[0](fill: ""), u8[0](),
                            string[]("PATH=" + binDir), true, false, dir).wait();
  t.isTrue(ran.ran(), "the artefact did not run at all — " + ran.error);
  t.eqI32(ran.status, 7, "the program's own status did not come back: "
                         + string.fromBytes(ran.stderr));
  t.isTrue(contains(string.fromBytes(ran.stdout), "from the app"),
           "the program's output did not come back: " + string.fromBytes(ran.stdout));

  // The same failure rule as `builtProgram`: a build that fails must not leave the one before it,
  // because an executable that runs is even easier to pass against than a module that loads.
  t.isTrue(putFile(cli, entry, BROKEN) == "", "could not break the program");
  Stat after = cli.stat(builtApp(cli, entry, "appprobe", string[0](fill: ""))).wait();
  t.isTrue(!after.exists, "a failed `wac app` left the artefact from before it broke");

  cli.remove(dir, true).wait();
  cli.remove(cli.cwd().wait() + "/.cache/built-appprobe", true).wait();
  return t.report();
}

/**
 * `sourcesOf` answers a program's whole closure, with the text, and says when it could not.
 *
 * The reading half of what `packages/wacc/src/api.wac`'s `emitFiles` takes, and the thing
 * `issues/system/0289b` records as blocking two tools. Tested here rather than through a caller
 * because the interesting cases are the closure being *right* and the failure being *reported* —
 * both of which a caller would turn into a compile error somewhere else.
 */
export string test_sourcesof_reads_a_whole_closure_and_reports_a_hole(Core core, Cli cli) {
  T t = T.create();

  // A file with no imports of its own is a closure of one, and its text is its text.
  Sources one = sourcesOf(cli, "packages/wactest/src/strings.wac");
  t.eqStr(one.why, "", "a file that reads is no hole");
  t.eqI32(one.paths.len(), 1, "no imports means one file");
  t.eqStr(one.paths[0], "packages/wactest/src/strings.wac", "and it is the entry");
  t.isTrue(contains(one.texts[0], "export string[] splitKeepingEmpty"), "with its text");

  // A file that imports reaches what it imports, and `std/` and `core/` are *not* in the answer:
  // they live in the compiler, which is what will be handed this.
  Sources many = sourcesOf(cli, "packages/wactest/src/built.wac");
  t.eqStr(many.why, "", "still no hole");
  t.isTrue(many.paths.len() >= 1, "the entry at least");
  for (i32 i = 0; i < many.paths.len(); i++) {
    t.isFalse(startsWith(many.paths[i], "std/") || startsWith(many.paths[i], "core/"),
              "on disk only, not " + many.paths[i]);
    t.isTrue(many.texts[i].len() > 0, many.paths[i] + " has text");
  }

  // **A hole is named, not skipped.** Compiling a program with a file missing from it reports
  // whatever the hole makes the checker say, which points at the wrong file.
  Sources gone = sourcesOf(cli, "packages/wactest/src/definitely-not-here.wac");
  t.eqI32(gone.paths.len(), 0, "nothing to hand a compiler");
  return t.report();
}
