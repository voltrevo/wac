// The daemon probe, against a server that really listens.
//
// `src/daemon.wac` is shared machinery — `packages/ethrpc` starts `anvil` with it, and every other
// package with a live server test will — so the failure worth guarding is the one that makes all of
// them lie: **a `start` that returns a pid for something that never came up**, after which every
// assertion in the caller is measuring a refused connection rather than the server's answer.
//
// So this drives the whole cycle against `python3 -m http.server`, which is here, listens on a port
// it is told, and needs no fixture. What is asserted is that each piece can *fail* as well as
// succeed: a free port is free, a started server answers, a stopped one stops answering, and a
// command that cannot start is reported rather than returning a pid that is already dead.

import { T } from "../../src/assert.wac";
import { Daemon, Port, freePortOr, freePort, logOf, start, stop, waitForPort,
         waitForPortWithin } from "../../src/daemon.wac";
import { quoted } from "../../src/childenv.wac";
import { Clock, Env, Files, Net, Procs, Sys } from "std";
import { madeDir } from "../../src/host.wac";
import { flatten } from "core";

export string test_a_started_server_answers_and_a_stopped_one_does_not(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Net net = sys.net();
  Procs procs = sys.procs();
  T t = T.create();
  Port got = freePortOr(net);
  i32 port = got.port;
  t.isTrue(port > 0, "the kernel gave a free port — \{got.error}");
  if (port <= 0) { return t.report(); }

  // Nothing is listening yet. This is the control: without it, a `waitForPort` that answered `true`
  // unconditionally would pass every assertion below.
  t.isTrue(!waitForPort(net, "127.0.0.1", port, 20),
           "something is already listening on the port we were told was free");

  string log = "\{flatten(env.cwd().wait()).unwrap()}/.cache/daemon_test.log";
  string whyDir1 = madeDir(fs, "\{flatten(env.cwd().wait()).unwrap()}/.cache");
  t.isTrue(whyDir1 == "", whyDir1);
  Daemon d = start(procs, "python3 -m http.server \{port} --bind 127.0.0.1", log);
  t.isTrue(d.ok(), "the server started — \{d.error}");
  if (!d.ok()) { return t.report(); }

  t.isTrue(waitForPort(net, "127.0.0.1", port, 20000),
           "the server never came up — it said: \{logOf(fs, d)}");

  // **Polled, because `kill` returns before the process is gone.** Twenty connects take microseconds
  // and all twenty landed while the server was still winding down, which read as "stop does not
  // work". What `stop` promises is that it *will* stop, not that it has by the time the call returns.
  stop(procs, d);
  bool gone = false;
  for (i32 i = 0; i < 20000 && !gone; i++) { gone = !waitForPort(net, "127.0.0.1", port, 1); }
  t.isTrue(gone, "the server is still answering long after stop");

  fs.remove(log, false).wait();
  return t.report();
}

export string test_a_command_that_cannot_start_is_reported(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Net net = sys.net();
  Procs procs = sys.procs();
  // The failure this whole file exists for: a pid for something that is not running. The shell
  // backgrounds successfully and *then* the command fails, so `start` can hand back a pid whatever
  // happens — which is why a caller has to check `waitForPort` and not just `ok()`.
  T t = T.create();
  string log = "\{flatten(env.cwd().wait()).unwrap()}/.cache/daemon_missing.log";
  string whyDir2 = madeDir(fs, "\{flatten(env.cwd().wait()).unwrap()}/.cache");
  t.isTrue(whyDir2 == "", whyDir2);
  i32 port = freePort(net);
  Daemon d = start(procs, "definitely-not-a-program-\{port}", log);

  // It "started" — the shell did. Nothing answers, and that is the answer a caller must read.
  t.isTrue(!waitForPort(net, "127.0.0.1", port, 20),
           "a command that does not exist appeared to serve a port");

  // Polled, because the shell writes the message from a background job and this got here first: a
  // single read caught an empty file and reported that nothing is ever logged, which is not true.
  string said = "";
  for (i32 i = 0; i < 2000 && said.len() == 0; i++) { said = logOf(fs, d); }
  t.isTrue(said.len() > 0,
           "nothing was logged, so a caller cannot say why the server did not come up");
  stop(procs, d);
  fs.remove(log, false).wait();
  return t.report();
}

export string test_quoting_keeps_a_value_whole() {
  T t = T.create();
  t.eqStr(quoted("plain"), "'plain'", "a plain word");
  t.eqStr(quoted("two words"), "'two words'", "a space does not split it");
  t.eqStr(quoted("it's"), "'it'\\''s'", "a quote closes, escapes and reopens");
  return t.report();
}

/**
 * A bound in attempts is not a bound in time, which is what `waitForPortWithin` exists for.
 *
 * This is the shape of a live-test flake rather than a hypothetical: `packages/ssh` waited for a real
 * `sshd` with `waitForPort(cli, host, port, 400)`, which reads as patience and is ten
 * milliseconds of it — a refused connection comes back in microseconds. It passed while the machine was
 * idle and failed the moment four `wac test` workers shared the box, reporting "sshd never accepted"
 * about a server that was starting normally.
 *
 * So what is asserted is the difference: the same nothing, waited for both ways. The attempt-bounded
 * call gives up in a small fraction of the deadline; the deadline-bounded one takes the deadline.
 */
export string test_a_deadline_wait_waits_for_the_deadline(Sys sys) {
  Clock clock = sys.clock();
  Net net = sys.net();
  T t = T.create();
  Port got = freePortOr(net);
  i32 port = got.port;
  t.isTrue(port > 0, "the kernel gave a free port — \{got.error}");
  if (port <= 0) { return t.report(); }

  // Nothing will ever listen here, so both calls must answer false — and the interesting part is how
  // long each takes to say it.
  i64 beforeSpin = flatten(clock.nowMillis().wait()).unwrap();
  bool spun = waitForPort(net, "127.0.0.1", port, 400);
  i64 spinMillis = flatten(clock.nowMillis().wait()).unwrap() - beforeSpin;

  i64 beforeWait = flatten(clock.nowMillis().wait()).unwrap();
  bool waited = waitForPortWithin(clock, net, "127.0.0.1", port, 300);
  i64 waitMillis = flatten(clock.nowMillis().wait()).unwrap() - beforeWait;

  t.isFalse(spun, "something answered on a port nothing is listening on");
  t.isFalse(waited, "something answered on a port nothing is listening on");
  t.isTrue(waitMillis >= 300,
           "the deadline wait gave up after \{waitMillis as~ i32}ms of a 300ms deadline");
  // Four hundred attempts against nothing, in well under the same 300ms — the assertion that the old
  // bound was not a bound in time. Generous, because a loaded machine is exactly when it is slowest:
  // the claim is only that attempts and milliseconds are different units.
  t.isTrue(spinMillis < 250,
           "400 attempts took \{spinMillis as~ i32}ms, so attempts and milliseconds are not " +
           "as different as this test claims — check the connect path before trusting either bound");
  return t.report();
}
