// The shared string helpers, including the two edges the hand-written versions disagreed about.
//
// The point of `src/strings.wac` is that thirty-odd test files stop each carrying their own copy,
// so the cases that matter here are the ones where those copies differed from each other: the empty
// needle, the empty haystack, a separator joined onto nothing, and a trailing newline.

import { T } from "../../src/assert.wac";
import { isSpace, trimmed, contains, has, joined, splitLines, splitKeepingEmpty, startsWith,
         endsWith } from "../../src/strings.wac";

export string test_contains_finds_a_substring_at_either_end_and_in_the_middle() {
  T t = T.create();
  t.isTrue(contains("hello world", "hello"), "at the start");
  t.isTrue(contains("hello world", "world"), "at the end");
  t.isTrue(contains("hello world", "lo wo"), "across the middle");
  t.isTrue(contains("hello", "hello"), "the whole string");
  t.isFalse(contains("hello", "hello world"), "a needle longer than the haystack");
  t.isFalse(contains("hello world", "World"), "and it is case sensitive");
  return t.report();
}

export string test_the_empty_needle_is_found_and_the_empty_haystack_holds_only_it() {
  // **This is the edge the copies disagreed on.** Several answered `false` for the empty needle;
  // `string.indexOf` answers 0, which is what every other language does, and this file is the
  // record of which behaviour the shared version has.
  T t = T.create();
  t.isTrue(contains("hello", ""), "the empty needle is found");
  t.isTrue(contains("", ""), "even in the empty haystack");
  t.isFalse(contains("", "a"), "which holds nothing else");
  return t.report();
}

export string test_startswith_and_endswith_refuse_a_needle_longer_than_the_string() {
  // The edge that a naive `slice` gets wrong: `s.slice(s.len() - n, s.len())` with `n > s.len()`
  // is a negative start, so the length test has to come first rather than after.
  T t = T.create();
  t.isTrue(startsWith("hello.wac", "hello"), "a prefix");
  t.isTrue(endsWith("hello.wac", ".wac"), "a suffix");
  t.isTrue(startsWith("abc", "abc") && endsWith("abc", "abc"), "the whole string is both");
  t.isTrue(startsWith("abc", "") && endsWith("abc", ""), "and the empty needle is both");
  t.isFalse(startsWith("abc", "abcd"), "a prefix longer than the string is not one");
  t.isFalse(endsWith("abc", "zabc"), "nor a longer suffix");
  t.isFalse(endsWith("hello.wacx", ".wac"), "and a suffix that is not at the end does not count");
  t.isFalse(startsWith("", "a") || endsWith("", "a"), "nothing starts or ends the empty string");
  return t.report();
}

export string test_has_compares_whole_elements_rather_than_prefixes() {
  // A prefix test here would be a real fault rather than a nicety: these lists hold names, and
  // `has(names, "run")` answering true because the list holds `runner` is a test agreeing with the
  // wrong thing.
  T t = T.create();
  string[] all = string[]("run", "runner", "");
  t.isTrue(has(all, "run"), "present");
  t.isTrue(has(all, "runner"), "and so is the longer one");
  t.isTrue(has(all, ""), "the empty element is an element");
  t.isFalse(has(all, "runn"), "a prefix of an element is not an element");
  t.isFalse(has(all, "RUN"), "nor a different case");
  t.isFalse(has(string[0](fill: ""), "run"), "and nothing is in an empty list");
  return t.report();
}

export string test_trimmed_takes_every_kind_of_space_from_both_ends_and_nothing_from_the_middle() {
  T t = T.create();
  t.eqStr(trimmed("  hello  "), "hello", "spaces");
  t.eqStr(trimmed("\t\r\n hello \n\r\t"), "hello", "tabs, returns and newlines");
  t.eqStr(trimmed("hello world"), "hello world", "the inner space stays");
  t.eqStr(trimmed("hello"), "hello", "nothing to take");
  t.eqStr(trimmed("   "), "", "all space is nothing left");
  t.eqStr(trimmed(""), "", "and nothing stays nothing");
  t.isTrue(isSpace(" ") && isSpace("\t") && isSpace("\r") && isSpace("\n"), "the four");
  t.isFalse(isSpace("x"), "and not a letter");
  return t.report();
}

export string test_joined_puts_the_separator_between_rather_than_after() {
  T t = T.create();
  t.eqStr(joined(string[]("a", "b", "c"), ","), "a,b,c", "between");
  t.eqStr(joined(string[]("a"), ","), "a", "one element carries no separator");
  t.eqStr(joined(string[0](fill: ""), ","), "", "and nor does none");
  t.eqStr(joined(string[]("a", "b"), ""), "ab", "an empty separator is allowed");
  t.eqStr(joined(string[]("", ""), "-"), "-", "two empty elements still get one separator");
  return t.report();
}

export string test_splitlines_drops_the_empty_line_a_trailing_newline_would_add() {
  T t = T.create();
  string[] three = splitLines("one\ntwo\nthree");
  t.eqI32(three.len(), 3, "three lines");
  t.eqStr(joined(three, "|"), "one|two|three", "in order");

  // The case this exists for: a program's output ends with a newline, and a splitter that kept the
  // empty tail makes every count one too many.
  t.eqI32(splitLines("one\ntwo\n").len(), 2, "a trailing newline adds no line");
  t.eqI32(splitLines("\n\none\n\n").len(), 1, "and nor do blank lines anywhere else");
  t.eqI32(splitLines("").len(), 0, "nothing is no lines");
  t.eqI32(splitLines("\n").len(), 0, "and a lone newline is no lines either");
  t.eqStr(joined(splitLines("only"), "|"), "only", "a string with no newline is one line");
  return t.report();
}

export string test_splitkeepingempty_keeps_every_line_the_other_one_drops() {
  T t = T.create();
  // The pair to the test above, written as the same inputs, because the two differ only in what
  // they do with a blank line and reading them side by side is how a caller picks one.
  t.eqI32(splitKeepingEmpty("one\ntwo\nthree").len(), 3, "three lines, as splitLines");
  t.eqI32(splitKeepingEmpty("one\ntwo\n").len(), 3, "a trailing newline is a third, empty line");
  t.eqI32(splitKeepingEmpty("\n\none\n\n").len(), 5, "and blank lines anywhere else are lines");
  t.eqStr(joined(splitKeepingEmpty("\n\none\n\n"), "|"), "||one||", "in their places");

  // The two callers both index by line number, so an off-by-one here is an off-by-one there.
  t.eqI32(splitKeepingEmpty("").len(), 1, "the empty string is one empty line, not none");
  t.eqI32(splitKeepingEmpty("\n").len(), 2, "and a lone newline is two");
  t.eqStr(joined(splitKeepingEmpty("only"), "|"), "only", "a string with no newline is one line");

  // Round-tripping is the property `tools/wac/gencore.wac` needs: it re-emits a source file line by
  // line, so anything this loses is a line the embedded copy of `core` would not have.
  string src = "a\n\nb\n";
  t.eqStr(joined(splitKeepingEmpty(src), "\n"), src, "joining the pieces back gives the original");
  return t.report();
}
