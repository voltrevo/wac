// Closures, checked by the runner that runs wac rather than by a host.
//
// `design/lang/0002` tier two is exercised from TypeScript (`packages/wacc/test/lambda.test.ts`) and
// by `spec/cases` — both of which compile a module and call it from *outside*. This file is the same
// feature seen from inside the language, run by `wac test`, which is a different path end to end:
// the native binary compiles it with its own seed and runs it on wasmtime rather than V8.
//
// That distinction is not academic. `issues/lang/0138` — a lambda in a module that also imports a
// real package emitting an invalid module — was found by building for the native host and by nothing
// else, after every Deno-side test had passed.

// only: wacc
//
// Lambdas are wacc-only syntax, so the reference cannot read this file and the whole-repository
// differentials must not try. `issues/lang/0140`.

import { T } from "../../src/assert.wac";

export string test_a_lambda_is_a_value() {
  T t = T.create();
  fn[i32()] answer = () => 42;
  fn[i32(i32)] inc = (i32 a) => a + 1;
  fn[i32(i32,i32)] mul = (i32 a, i32 b) => { return a * b; };
  t.eqI32(answer(), 42, "an expression body");
  t.eqI32(inc(41), 42, "one parameter");
  t.eqI32(mul(6, 7), 42, "a block body");
  return t.report();
}

export string test_a_lambda_captures_by_reference() {
  T t = T.create();
  // The lambda's write is seen out here, and the write out here is seen by the lambda. A copy would
  // answer 0 and then 20 — this is the distinction cells exist for.
  i32 n = 0;
  fn[void()] bump = () => { n = n + 20; };
  bump();
  t.eqI32(n, 20, "the lambda's write is visible outside");
  n = n + 1;
  bump();
  t.eqI32(n, 41, "and the outer write was visible to it");

  // Two closures over one local share it rather than each holding a copy.
  i32 shared = 0;
  fn[void()] add = () => { shared = shared + 21; };
  fn[i32()] read = () => shared;
  add();
  add();
  t.eqI32(read(), 42, "two closures, one cell");
  return t.report();
}

export string test_a_lambda_captures_a_parameter() {
  T t = T.create();
  t.eqI32(twice(2), 42, "a parameter is captured like a local");
  return t.report();
}

// A parameter has no declaration to make a cell at — its cell is built at function entry — so it is
// a different piece of the emitter from a captured local and is worth its own case.
i32 twice(i32 start) {
  i32 v = start;
  fn[void()] bump = () => { v = v + 20; };
  bump();
  bump();
  return v;
}
