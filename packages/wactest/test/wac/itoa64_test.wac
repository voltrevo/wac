// Interpolation of `u64` and `i64`, judged against `BigInt`.
//
// Worth its own differential rather than a table, because every failure message in every wac test in
// the repository goes through it: a wrong digit here is a wrong *diagnosis* everywhere, and the shape
// of that failure is a test that reports the wrong number and is believed.
//
// It used to judge `wactest`'s own `itoa64` and `utoa64`, when those were what every message went
// through. Messages interpolate now (`"\{n} rows"`, through core's `toString`), the copies are gone, and
// the file kept its name because the harness and the coverage driver name it.
//
// ## What the move changed
//
// The values no longer travel through bindgen's `bigint`. The bit pattern is what is really being
// asked about — "what decimal does this pattern name, read each way" — so it goes to the oracle as
// sixteen hex digits, and the two readings are two lines about one pattern rather than two
// separately-generated numbers.
//
// That also fixed something small. The host-side version drew its random cases with a 64-bit LCG in
// `BigInt`, so `u` and `i` were asked about the same value; here they are asked about the same
// *pattern*, which is the same thing said in the form that makes it obvious.
//
// Host-side until 2026-08-17. `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { Lines, checkDeno } from "../../../wactest/src/oracle.wac";
import { Procs, Sys } from "std";

static string ORACLE = "packages/wactest/test/oracle.ts";

/** Sixteen hex digits, big-endian — the form the oracle reads. */
string bits(u64 v) {
  string digits = "0123456789abcdef";
  string out = "";
  u64 x = v;
  for (i32 i = 0; i < 16; i++) {
    i32 nib = (x % 16) as~ i32;
    out = digits.slice(nib, nib + 1) + out;
    x = x / 16;
  }
  return out;
}

/** Both readings of one pattern. */
void both(Lines lines, u64 v) {
  i64 signed = v as@ i64;
  lines.add("u \{bits(v)} \{v}");
  lines.add("i \{bits(v)} \{signed}");
}

export string test_itoa64_and_utoa64_agree_with_bigint(Sys sys) {
  Procs procs = sys.procs();
  T t = T.create();
  Lines lines = Lines.create();

  // The boundaries: every digit-count change, the 32-bit edge, and both ends of each reading.
  u64[] named = [
    0, 1, 9, 10, 99, 100,
    0xFFFFFFFF, 0x100000000,
    0x7FFFFFFFFFFFFFFF,   // the largest signed, and 9223372036854775807 unsigned
    0x8000000000000000,   // the smallest signed, and 9223372036854775808 unsigned
    0xFFFFFFFFFFFFFFFF  // -1 signed, and the largest unsigned
  ];
  for (i32 i = 0; i < named.len(); i++) { both(lines, named[i]); }

  // Random 64-bit patterns, read both ways. The same LCG the host-side version used, so the corpus
  // is the same one.
  u64 s = 12345;
  for (i32 k = 0; k < 400; k++) {
    s = s * 6364136223846793005 + 1442695040888963407;
    both(lines, s);
  }
  t.isTrue(lines.n > 800, "the sweep is both readings of every pattern — \{lines.n} rows");
  checkDeno(t, procs, ORACLE, lines, "interpolating u64 and i64");
  return t.report();
}
