// The other direction: what a client says to `git receive-pack`, and what it says back.
//
// `design/system/0005` ruled push out because *authentication* was a non-goal, and that is true of pushing
// to GitHub. It is not true of pushing at all: `git receive-pack` over a pipe asks for no credentials, so
// the protocol is arrangeable and checkable here, and `writePack` — built for step 7 and until now with no
// caller — is what fills the pack.
//
// ## The conversation
//
//     <- 00b1<40 zeros> capabilities^{}\0report-status … agent=git/2.43.0    an empty repository
//     <- 003f<sha> refs/heads/main                                          or the refs it has
//     <- 0000
//     -> 0067<old> <new> refs/heads/main\0report-status\n                   capabilities on the first
//     -> 0000
//     -> PACK…                                                             the objects it needs
//     <- 000eunpack ok
//     <- 0017ok refs/heads/main                                             or `ng <ref> <why>`
//     <- 0000
//
// **An empty repository advertises one line and it is not a ref.** All zeros, the name
// `capabilities^{}`, and the capability list after the NUL. A client that treated it as a branch would
// try to fast-forward something called `capabilities^{}`; `noRefsYet` is how a caller asks.
//
// **`<old>` is not decoration.** It is what makes a push a compare-and-swap: forty zeros means "this ref
// must not exist yet", and any other value means "it must be exactly this". Sending the wrong one is how a
// client overwrites somebody else's commit, and the server refusing is the only thing that stops it — so
// this asks for the old value rather than defaulting it.
//
// **`report-status` is asked for.** Without it the server says nothing and a client cannot tell a rejected
// ref from an accepted one; with it, `unpack ok` covers the pack and one line per ref covers each update.

import { Buf } from "../../bytes/src/buf.wac";
import { Vec } from "../../std/src/vec.wac";
import { Pkt, flushPkt, readPkt, writePkt } from "./pktline.wac";
import { Ad, Advertised, parseAdvertisement } from "./fetch.wac";
import { encode } from "../../codec/src/hex.wac";

/** One ref to move: from `old` to `new`. Forty zeros in `old` means it must not exist yet. */
export struct Update {
  string name;
  /** Twenty raw bytes, or twenty zero bytes for "create it". */
  u8[] old;
  u8[] next;
}

/** Twenty zero bytes — the `old` of a ref being created. */
export u8[] absentName() { return u8[20](); }

/**
 * Whether this advertisement is the one an empty repository sends.
 *
 * The single line is all zeros named `capabilities^{}`, which is not a ref and must not be treated as one.
 */
export bool noRefsYet(const Advertised ad) {
  if (ad.refs.len() != 1) { return false; }
  if (ad.refs.get(0).name != "capabilities^{}") { return false; }
  u8[] t = ad.refs.get(0).target;
  for (i32 i = 0; i < t.len(); i++) {
    if (t[i] != 0) { return false; }
  }
  return true;
}

/**
 * The same question, asked with the bytes rather than a parsed advertisement.
 *
 * **Here because a struct could not cross between two bound modules**: each `wacBind` was its own wasm
 * instance with its own types, so an `Advertised` produced by `fetch.wac`'s was not the type
 * `receive.wac`'s accepted, and handing it over was `type incompatibility when transforming from/to JS`.
 * A host driving this has bytes anyway, so the shape stands on its own merits.
 *
 * That wall was hit three times in this package and two of the three are gone: `test/wac/idxprobe.wac`
 * and `test/wac/thinprobe.wac` were deleted on 2026-08-17 when their tests moved into wac, where the
 * boundary they worked around does not exist. `issues/system/0161`.
 */
export bool noRefsIn(u8[] advertisement) {
  match (parseAdvertisement(advertisement)) {
    case Garbled(why): { return false; }
    case Said(ad): { return noRefsYet(ad); }
  }
}

/**
 * The value a ref currently has according to `advertisement`, or twenty zeros if it has none.
 *
 * **This is the `old` half of the compare-and-swap, and taking it from the advertisement is the whole
 * point.** A client that sent zeros for a ref that exists is telling the server "nobody has this yet",
 * and a server that believed it would discard whatever was there. Reading it from what the server just
 * said is what makes a push safe against somebody else having moved the ref — and if they move it between
 * the advertisement and the push, the server refuses, which is the outcome that protects the commit.
 *
 * Bytes in and bytes out, for the reason `noRefsIn` gives: a parsed advertisement cannot cross between two
 * bound modules.
 */
export u8[] oldFor(u8[] advertisement, string ref) {
  match (parseAdvertisement(advertisement)) {
    case Garbled(why): { return absentName(); }
    case Said(ad) : {
      if (noRefsYet(ad)) { return absentName(); }
      for (i32 i = 0; i < ad.refs.len(); i++) {
        if (ad.refs.get(i).name == ref) { return ad.refs.get(i).target; }
      }
      return absentName();
    }
  }
}

/**
 * Every target the advertisement named, which is exactly what the far end already has.
 *
 * A push needs this to work out what to leave out of its pack: everything reachable from these is present
 * there by definition. The `capabilities^{}` line of an empty repository is not a ref and is left out.
 */
export Vec<u8[]> advertisedTargets(u8[] advertisement) {
  Vec<u8[]> out = Vec.create();
  match (parseAdvertisement(advertisement)) {
    case Garbled(why): { return out; }
    case Said(ad): {
      if (noRefsYet(ad)) { return out; }
      for (i32 i = 0; i < ad.refs.len(); i++) { out.push(ad.refs.get(i).target); }
      return out;
    }
  }
}

/**
 * The update commands, with the capabilities on the first line only.
 *
 * Same rule as a fetch's wants: a server reading capabilities on the second command is entitled to treat
 * the whole line as a malformed ref name.
 */
export u8[] updateRequest(Vec<Update> updates, string capabilities) {
  Buf out = Buf.create();
  for (i32 i = 0; i < updates.len(); i++) {
    Update u = updates.get(i);
    // Built as bytes because the separator before the capabilities is a **NUL**, which a string literal
    // is the wrong container for: the line is a byte string with a zero in the middle rather than text.
    Buf line = Buf.create();
    line.pushAll(encode(u.old));
    line.push(32);
    line.pushAll(encode(u.next));
    line.push(32);
    line.pushAll(u.name.toBytes());
    if (i == 0 && capabilities != "") {
      line.push(0);
      line.pushAll(capabilities.toBytes());
    }
    line.push(10);
    out.pushAll(writePkt(line.bytes()));
  }
  out.pushAll(flushPkt());
  return out.take();
}

/** What the server said about one ref. */
export struct RefReport {
  string name;
  bool ok;
  /** Empty when `ok`; the server's own words otherwise. */
  string why;
}

/** What the server said about the whole push. */
export struct Report {
  /** Whether it could read the pack at all. */
  bool unpacked;
  /** Why not, in the server's words. */
  string unpackWhy;
  Vec<RefReport> refs;
  /** Set when the reply was not a report at all. */
  string garbled;
}

string textOf(u8[] b, i32 from, i32 to) {
  Buf out = Buf.create();
  for (i32 i = from; i < to; i++) { out.push(b[i]); }
  return out.toStr();
}

/** Where the payload ends, ignoring one trailing newline. */
i32 endOf(u8[] p) {
  i32 to = p.len();
  if (to > 0 && p[to - 1] == 10) { to = to - 1; }
  return to;
}

bool starts(u8[] p, string what) {
  u8[] w = what.toBytes();
  if (p.len() < w.len()) { return false; }
  for (i32 i = 0; i < w.len(); i++) {
    if (p[i] != w[i]) { return false; }
  }
  return true;
}

/**
 * Read the report a server sends after a push.
 *
 * `unpack ok` or `unpack <why>` comes first and covers the pack; then one line per ref — `ok <name>` or
 * `ng <name> <why>`. **A refused ref is not an error in the transport**, which is why this returns a
 * report rather than a failure: the pack can unpack perfectly and every ref still be rejected, and a caller
 * that saw only "the push worked" would be wrong in the way that loses somebody's commit.
 */
export Report readReport(u8[] b) {
  Vec<RefReport> refs = Vec.create();
  bool unpacked = false;
  bool sawUnpack = false;
  string unpackWhy = "";
  i32[] pos = i32[1]();
  bool reading = true;
  while (reading) {
    match (readPkt(b, pos)) {
      case Broken(why): { return Report(false, "", refs, "the reply is not pkt-line: " + why); }
      case Done: { reading = false; }
      case Flush: { reading = false; }
      case Delim: { }
      case ResponseEnd: { reading = false; }
      case Line(payload): {
        i32 to = endOf(payload);
        if (starts(payload, "unpack ")) {
          sawUnpack = true;
          string what = textOf(payload, 7, to);
          unpacked = what == "ok";
          if (!unpacked) { unpackWhy = what; }
        } else if (starts(payload, "ok ")) {
          refs.push(RefReport(textOf(payload, 3, to), true, ""));
        } else if (starts(payload, "ng ")) {
          // `ng <name> <why>` — the name runs to the first space after it.
          i32 sp = to;
          for (i32 i = 3; i < to; i++) {
            if (payload[i] == 32) { sp = i; break; }
          }
          refs.push(RefReport(textOf(payload, 3, sp), false,
            sp < to ? textOf(payload, sp + 1, to) : ""));
        }
        // Anything else is a line this does not know; ignored rather than fatal, since a server may add
        // one and an unknown line is not a refusal.
      }
    }
  }
  if (!sawUnpack) {
    return Report(false, "", refs, "the reply carried no `unpack` line");
  }
  return Report(unpacked, unpackWhy, refs, "");
}
