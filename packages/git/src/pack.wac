// Reading a `.pack` — the format every real repository keeps its objects in.
//
// A pack is a twelve-byte header, then objects back to back, then a twenty-byte SHA-1 of everything
// before it. Each object is a variable-length header and a zlib stream, and an object may be a
// **delta** against another one in the same pack, chained.
//
// ## The object header
//
//     byte 0:  ttt ssss   with the high bit meaning "another byte follows"
//     bytes:   sssssss    seven more size bits each, least significant group first
//
// The type is three bits: 1 commit, 2 tree, 3 blob, 4 tag, 6 offset-delta, 7 reference-delta. 5 is
// unused and 0 is invalid.
//
// **The size in that header is the size of the data at this offset, which for a delta is the delta and
// not the object.** `git verify-pack -v` prints the same number, so the two can be compared directly —
// and it is a different number from `git cat-file -s`, which is the reconstructed object. Both are
// checked in `test/pack.test.ts`, because a reader that confused them would agree with one oracle and
// not the other.
//
// ## Two varints that are not the same varint
//
// The size above is little-endian groups: `size |= (b & 0x7f) << shift`. An **offset delta** encodes
// its distance differently — `ofs = ((ofs + 1) << 7) | (b & 0x7f)` — which is not the same function
// and has no zero-length representation, so reusing one decoder for both silently misreads any chain
// longer than 127 bytes. They are two functions here for that reason.
//
// ## Where a compressed stream ends
//
// Nothing in the object header says how long the compressed bytes are, and `packages/gzip`'s
// `inflate` does not report what it consumed. So an object's stream is bounded by **the next object's
// offset**, taken from the index — which is why `openPack` sorts the offsets and keeps them. The last
// object ends where the trailing checksum begins. Walking sequentially and inflating to find each
// boundary would work too and would mean inflating every object to read one.

import { Buf } from "../../bytes/src/buf.wac";
import { sha1 } from "../../crypto/src/sha1.wac";
import { framed } from "./object.wac";
import { Kind } from "./object.wac";
import { Index, PackIndex, find, parseIdx } from "./idx.wac";
import { Inflation, inflate, inflateAt } from "../../gzip/src/inflate.wac";
import { crc32 } from "../../gzip/src/crc32.wac";
import { zlibCompress } from "./zlib.wac";
import { itoa } from "../../fmt/src/itoa.wac";
import { Vec } from "../../std/src/vec.wac";

/** A pack and its index, ready to be read from. */
export struct Pack {
  u8[] bytes;
  PackIndex idx;
  /** Every object's offset, ascending — what bounds each compressed stream. */
  i64[] byOffset;
}

export enum Opened {
  Ready(Pack pack),
  Refused(string why)
}

/** What sits at an offset, before any delta is followed. */
export enum Raw {
  /** A complete object: kind 1..4 and its bytes. */
  Whole(i32 kind, u8[] data),
  /** A delta against the object at `base`, which is an absolute pack offset. */
  FromOffset(i64 base, u8[] delta),
  /** A delta against a named object, which may not be in this pack at all. */
  FromName(u8[] baseName, u8[] delta),
  Damaged(string why)
}

/** A resolved object: its kind and its reconstructed bytes. */
export enum Got {
  Found(i32 kind, u8[] data),
  Absent(string why)
}

/** Heapsort, because a pack can hold half a million objects and insertion sort cannot. */
void sortOffsets(i64[] a) {
  i32 n = a.len();
  for (i32 start = n / 2 - 1; start >= 0; start--) { siftDown(a, start, n); }
  for (i32 end = n - 1; end > 0; end--) {
    i64 t = a[0]; a[0] = a[end]; a[end] = t;
    siftDown(a, 0, end);
  }
}

void siftDown(i64[] a, i32 root0, i32 end) {
  i32 root = root0;
  while (root * 2 + 1 < end) {
    i32 child = root * 2 + 1;
    if (child + 1 < end && a[child] < a[child + 1]) { child = child + 1; }
    if (a[root] >= a[child]) { return; }
    i64 t = a[root]; a[root] = a[child]; a[child] = t;
    root = child;
  }
}

export Opened openPack(u8[] pack, u8[] idxBytes) {
  if (pack.len() < 32) { return Opened.Refused("shorter than a header and a checksum"); }
  if (pack[0] != 'P' || pack[1] != 'A' || pack[2] != 'C' || pack[3] != 'K') {
    return Opened.Refused("not a pack: the magic is missing");
  }
  i32 version = (pack[4] << 24) | (pack[5] << 16) | (pack[6] << 8) | pack[7];
  if (version != 2 && version != 3) {
    return Opened.Refused("pack version " + itoa(version) + " is not 2 or 3");
  }
  i32 count = (pack[8] << 24) | (pack[9] << 16) | (pack[10] << 8) | pack[11];

  match (parseIdx(idxBytes)) {
    case Rejected(why): return Opened.Refused("index: " + why);
    case Loaded(idx): {
      // **The two files must agree about how many objects there are.** They are written together and
      // a mismatch means one of them belongs to a different pack — which otherwise shows up as
      // offsets that land in the middle of an object.
      if (idx.count != count) {
        return Opened.Refused("the pack holds " + itoa(count) + " objects and the index describes " +
          itoa(idx.count));
      }
      i64[] sorted = i64[idx.count]();
      for (i32 i = 0; i < idx.count; i++) { sorted[i] = idx.offsets[i]; }
      sortOffsets(sorted);
      return Opened.Ready(Pack(pack, idx, sorted));
    }
  }
}

/**
 * A pack with an index that was built rather than read — what `indexPack` produces.
 *
 * `openPack` takes the bytes of a `.idx` file because that is what a repository has on disk. A pack that
 * arrived over the wire has no such file and never will unless one is written, so this is the way in for
 * a fetch: index it, then open it with what you got.
 */
export Pack openIndexed(u8[] pack, PackIndex idx) {
  i64[] sorted = i64[idx.count]();
  for (i32 i = 0; i < idx.count; i++) { sorted[i] = idx.offsets[i]; }
  sortOffsets(sorted);
  return Pack(pack, idx, sorted);
}

/** Where the object starting at `off` must end: the next object's offset, or the checksum. */
i64 endOf(const Pack p, i64 off) {
  i32 lo = 0;
  i32 hi = p.byOffset.len() - 1;
  i64 best = (p.bytes.len() - 20) as i64;
  while (lo <= hi) {
    i32 mid = lo + (hi - lo) / 2;
    if (p.byOffset[mid] > off) { best = p.byOffset[mid]; hi = mid - 1; } else { lo = mid + 1; }
  }
  return best;
}

export Raw rawAt(const Pack p, i64 off) {
  if (off < 12 || off >= (p.bytes.len() - 20) as i64) { return Raw.Damaged("offset is outside the pack"); }
  i32 at = off as~ i32;
  i32 b = p.bytes[at];
  i32 kind = (b >> 4) & 7;
  i32 size = b & 0x0f;
  i32 shift = 4;
  at = at + 1;
  while ((b & 0x80) != 0) {
    if (at >= p.bytes.len()) { return Raw.Damaged("size runs off the end"); }
    b = p.bytes[at];
    size = size | ((b & 0x7f) << shift);
    shift = shift + 7;
    at = at + 1;
  }
  if (kind == 0 || kind == 5) { return Raw.Damaged("object type " + itoa(kind) + " is not defined"); }

  i64 base = 0;
  u8[] baseName = u8[0]();
  if (kind == 6) {
    i32 c = p.bytes[at];
    at = at + 1;
    i64 ofs = (c & 0x7f) as i64;
    while ((c & 0x80) != 0) {
      if (at >= p.bytes.len()) { return Raw.Damaged("a delta offset runs off the end"); }
      c = p.bytes[at];
      at = at + 1;
      // Not the size varint's function: each further byte adds one before shifting, so there is no
      // encoding of zero and every length is used exactly once.
      ofs = ((ofs + 1) << 7) | ((c & 0x7f) as i64);
    }
    base = off - ofs;
    if (base < 12) { return Raw.Damaged("a delta points before the first object"); }
  } else if (kind == 7) {
    if (at + 20 > p.bytes.len()) { return Raw.Damaged("a base name runs off the end"); }
    baseName = u8[20]();
    for (i32 k = 0; k < 20; k++) { baseName[k] = p.bytes[at + k]; }
    at = at + 20;
  }

  i64 end = endOf(p, off);
  if ((at as i64) >= end) { return Raw.Damaged("no room for the compressed data"); }
  // The zlib header is two bytes and the four-byte Adler-32 sits at the end. `inflate` wants the raw
  // deflate between them, and the checksum is skipped rather than verified — the index carries a
  // CRC-32 of these same bytes, which is the check this format actually offers, and the object's own
  // name is a hash of what comes out.
  i32 from = at + 2;
  i32 upto = (end as~ i32) - 4;
  if (upto <= from) { return Raw.Damaged("compressed data is too short to be a zlib stream"); }
  u8[] slice = u8[upto - from]();
  for (i32 i = 0; i < slice.len(); i++) { slice[i] = p.bytes[from + i]; }
  u8[] data = inflate(slice);

  // **The header's size is checked against what came out**, which is the one place a misread varint
  // shows up immediately rather than as a wrong answer later.
  if (data.len() != size) {
    return Raw.Damaged("header says " + itoa(size) + " bytes and " + itoa(data.len()) + " inflated");
  }

  if (kind == 6) { return Raw.FromOffset(base, data); }
  if (kind == 7) { return Raw.FromName(baseName, data); }
  return Raw.Whole(kind, data);
}

/** A little-endian group varint, as a delta header uses. Returns the value; `at` advances via `pos`. */
i32 deltaSize(u8[] d, i32[] pos) {
  i32 v = 0;
  i32 shift = 0;
  i32 c = 0x80;
  while ((c & 0x80) != 0 && pos[0] < d.len()) {
    c = d[pos[0]];
    pos[0] = pos[0] + 1;
    v = v | ((c & 0x7f) << shift);
    shift = shift + 7;
  }
  return v;
}

/**
 * Apply a delta to a base, giving the object.
 *
 * The instruction stream is one byte of command and then its operands: with the high bit set it is a
 * **copy** from the base, whose offset and length are assembled from whichever of the next seven bytes
 * the low bits select; without it, the low seven bits are a **literal length** and that many bytes
 * follow. A command byte of zero is invalid rather than a no-op, which is worth refusing because it is
 * what a truncated stream of zeroes looks like.
 */
export u8[]? applyDelta(u8[] base, u8[] delta) {
  i32[] pos = i32[1]();
  i32 wantBase = deltaSize(delta, pos);
  i32 wantOut = deltaSize(delta, pos);
  if (wantBase != base.len()) { return null; }

  Buf out = Buf.create();
  while (pos[0] < delta.len()) {
    i32 cmd = delta[pos[0]];
    pos[0] = pos[0] + 1;
    if ((cmd & 0x80) != 0) {
      i32 cpOff = 0;
      i32 cpSize = 0;
      if ((cmd & 0x01) != 0) { if (pos[0] >= delta.len()) { return null; } cpOff = cpOff | delta[pos[0]]; pos[0] = pos[0] + 1; }
      if ((cmd & 0x02) != 0) { if (pos[0] >= delta.len()) { return null; } cpOff = cpOff | (delta[pos[0]] << 8); pos[0] = pos[0] + 1; }
      if ((cmd & 0x04) != 0) { if (pos[0] >= delta.len()) { return null; } cpOff = cpOff | (delta[pos[0]] << 16); pos[0] = pos[0] + 1; }
      if ((cmd & 0x08) != 0) { if (pos[0] >= delta.len()) { return null; } cpOff = cpOff | (delta[pos[0]] << 24); pos[0] = pos[0] + 1; }
      if ((cmd & 0x10) != 0) { if (pos[0] >= delta.len()) { return null; } cpSize = cpSize | delta[pos[0]]; pos[0] = pos[0] + 1; }
      if ((cmd & 0x20) != 0) { if (pos[0] >= delta.len()) { return null; } cpSize = cpSize | (delta[pos[0]] << 8); pos[0] = pos[0] + 1; }
      if ((cmd & 0x40) != 0) { if (pos[0] >= delta.len()) { return null; } cpSize = cpSize | (delta[pos[0]] << 16); pos[0] = pos[0] + 1; }
      // Zero means 65536, which is the one special case in the encoding: a three-byte length field
      // cannot say 0x10000 and a copy of nothing would be pointless, so the value is reused.
      if (cpSize == 0) { cpSize = 0x10000; }
      if (cpOff < 0 || cpOff + cpSize > base.len()) { return null; }
      for (i32 i = 0; i < cpSize; i++) { out.push(base[cpOff + i]); }
    } else {
      if (cmd == 0) { return null; }
      if (pos[0] + cmd > delta.len()) { return null; }
      for (i32 i = 0; i < cmd; i++) { out.push(delta[pos[0] + i]); }
      pos[0] = pos[0] + cmd;
    }
  }
  u8[] made = out.take();
  // The delta states its own result length, so a stream that produced anything else was misread.
  if (made.len() != wantOut) { return null; }
  return made;
}

/**
 * The object at `off`, with every delta in its chain followed.
 *
 * Recursive, and bounded by `depth` rather than by trust: git's own chains reach fifty, and a pack
 * whose deltas form a cycle would otherwise be an infinite loop rather than an error. A cycle cannot
 * happen in an offset chain, which always points backwards — but a reference delta can name anything.
 */
export Got objectAt(const Pack p, i64 off, i32 depth) {
  if (depth <= 0) { return Got.Absent("delta chain is longer than this reader will follow"); }
  match (rawAt(p, off)) {
    case Damaged(why): return Got.Absent(why);
    case Whole(kind, data): return Got.Found(kind, data);
    case FromOffset(base, delta): {
      match (objectAt(p, base, depth - 1)) {
        case Absent(why): return Got.Absent(why);
        case Found(kind, baseData): {
          u8[]? made = applyDelta(baseData, delta);
          if (made is null) { return Got.Absent("a delta did not apply to its base"); }
          return Got.Found(kind, made!);
        }
      }
    }
    case FromName(name, delta): {
      i32 at = find(p.idx, name);
      if (at < 0) {
        // A pack fetched with `--thin` refers to objects the receiver already has, and this reader has
        // only the one pack — so this is a real limitation rather than corruption, and says which.
        return Got.Absent("the base of a reference delta is not in this pack");
      }
      match (objectAt(p, p.idx.offsets[at], depth - 1)) {
        case Absent(why): return Got.Absent(why);
        case Found(kind, baseData): {
          u8[]? made = applyDelta(baseData, delta);
          if (made is null) { return Got.Absent("a delta did not apply to its base"); }
          return Got.Found(kind, made!);
        }
      }
    }
  }
}

/** The object called `name`, or why not. */
export Got objectNamed(const Pack p, u8[] name) {
  i32 at = find(p.idx, name);
  if (at < 0) { return Got.Absent("not in this pack"); }
  return objectAt(p, p.idx.offsets[at], 64);
}

// ── indexing a pack that arrived without one ─────────────────────────────────────────────────────────
//
// design/system/0005 step 6. A pack fetched over the wire has no `.idx`, and everything above needs one
// — so this is `git index-pack`: walk the pack from the front, and because nothing records where each
// object's compressed bytes end, ask the inflater. `packages/gzip`'s `inflateAt` reports that, which is
// the export this needed and the reason it exists.

/** A pack indexed from its own bytes. */
export enum Indexed {
  Built(PackIndex idx),
  /**
   * The pack is **thin**: one or more reference deltas name a base the pack does not contain, which is
   * what a server sends when it knows what you already have. The names are what it needs, deduplicated.
   *
   * A thin pack is not a damaged one, and telling them apart is the whole reason this variant exists —
   * `git index-pack` refuses both with `pack has N unresolved delta`, and only one of them can be
   * repaired. `completePack` is the repair: append the bases and index the result.
   */
  Thin(Vec<u8[]> bases),
  Unindexable(string why)
}

/**
 * Build an index for `pack` by walking it.
 *
 * Two passes, and the second is why: an object's **name is the hash of what it resolves to**, so a delta
 * cannot be named until its base is. The first pass records where every object starts and what it holds;
 * the second resolves and hashes. A single pass would work only for a pack whose bases always precede
 * their deltas, which is true of `ofs-delta` and not of `ref-delta`.
 */
export Indexed indexPack(u8[] pack) {
  if (pack.len() < 32) { return Indexed.Unindexable("shorter than a header and a checksum"); }
  if (pack[0] != 'P' || pack[1] != 'A' || pack[2] != 'C' || pack[3] != 'K') {
    return Indexed.Unindexable("not a pack: the magic is missing");
  }
  i32 count = (pack[8] << 24) | (pack[9] << 16) | (pack[10] << 8) | pack[11];
  if (count < 0 || count > 10000000) { return Indexed.Unindexable("implausible object count"); }

  i64[] offsets = i64[count]();
  i32[] kinds = i32[count]();
  i64[] bases = i64[count]();        // for kind 6: the base's offset
  Vec<u8[]> payloads = Vec.create(); // inflated bytes: the object, or the delta
  Vec<u8[]> baseNames = Vec.create();// for kind 7: the base's name, else empty

  i32 at = 12;
  i32 stop = pack.len() - 20;
  for (i32 i = 0; i < count; i++) {
    if (at >= stop) { return Indexed.Unindexable("the pack ended before its object count"); }
    i64 here = at as i64;
    i32 b = pack[at];
    i32 kind = (b >> 4) & 7;
    i32 size = b & 0x0f;
    i32 shift = 4;
    at = at + 1;
    while ((b & 0x80) != 0) {
      if (at >= stop) { return Indexed.Unindexable("a size runs off the end"); }
      b = pack[at];
      size = size | ((b & 0x7f) << shift);
      shift = shift + 7;
      at = at + 1;
    }
    if (kind == 0 || kind == 5) { return Indexed.Unindexable("object type " + itoa(kind) + " is not defined"); }

    i64 base = 0;
    u8[] refName = u8[0]();
    if (kind == 6) {
      i32 c = pack[at];
      at = at + 1;
      i64 ofs = (c & 0x7f) as i64;
      while ((c & 0x80) != 0) {
        if (at >= stop) { return Indexed.Unindexable("a delta offset runs off the end"); }
        c = pack[at];
        at = at + 1;
        ofs = ((ofs + 1) << 7) | ((c & 0x7f) as i64);
      }
      base = here - ofs;
    } else if (kind == 7) {
      if (at + 20 > stop) { return Indexed.Unindexable("a base name runs off the end"); }
      refName = u8[20]();
      for (i32 k = 0; k < 20; k++) { refName[k] = pack[at + k]; }
      at = at + 20;
    }

    // **Where the compressed bytes end is the whole reason this can be written.** The zlib header is two
    // bytes; `inflateAt` inflates the deflate stream after it and says where that stopped; the Adler-32
    // is the four bytes after that.
    Inflation got = inflateAt(pack, at + 2);
    if (got.bytes.len() != size) {
      return Indexed.Unindexable("an object's header says " + itoa(size) + " bytes and " +
        itoa(got.bytes.len()) + " inflated");
    }
    at = got.end + 4;

    offsets[i] = here;
    kinds[i] = kind;
    bases[i] = base;
    payloads.push(got.bytes);
    baseNames.push(refName);
  }

  // Pass two: resolve and name. A delta's base is found by its offset, which is why the offsets are kept
  // in pack order here rather than sorted — sorting happens at the end, once every name is known.
  Vec<u8[]> resolved = Vec.create();
  Vec<i32> resolvedKind = Vec.create();
  for (i32 i = 0; i < count; i++) { resolved.push(u8[0]()); resolvedKind.push(0); }
  Buf names = Buf.create();
  Vec<u8[]> need = Vec.create();
  for (i32 i = 0; i < count; i++) {
    if (resolveInto(i, count, offsets, kinds, bases, payloads, baseNames, resolved, resolvedKind, 64)) {
      continue;
    }
    // **A reference delta is the thin case; anything else is damage.** An `ofs-delta` names its base by
    // position inside this pack, so one that will not resolve has no base to ask anybody for. A
    // `ref-delta` names it by hash, which is precisely how a sender refers to something it believes the
    // receiver already has.
    if (kinds[i] != 7) { return Indexed.Unindexable("a delta chain could not be resolved"); }
    u8[] want = baseNames.get(i);
    bool already = false;
    for (i32 k = 0; k < need.len(); k++) {
      bool same = true;
      for (i32 q = 0; q < 20; q++) { if (need.get(k)[q] != want[q]) { same = false; break; } }
      if (same) { already = true; break; }
    }
    if (!already) { need.push(want); }
  }
  if (need.len() > 0) { return Indexed.Thin(need); }
  for (i32 i = 0; i < count; i++) {
    names.pushAll(sha1(framed(kindOf(resolvedKind.get(i)), resolved.get(i))));
  }

  // The CRC-32 of every object's bytes **as they sit in the pack** — its own header included, from its
  // offset to the next object's, the last ending where the pack's trailing checksum begins. Which range
  // that is was measured against git's own index rather than read off a description of the format, and
  // `test/pack.test.ts` now compares the whole index file byte for byte, which is what turned this field
  // from a zero into a number: it was left zero on the argument that nothing read it, and that stopped
  // being true the moment `writeIdx` put it in a file git verifies.
  //
  // Pack order is what makes the ends knowable, which is the same reason the offsets are unsorted here.
  u32[] crcByWalk = u32[count]();
  i64 lastEnd = (pack.len() - 20) as i64;
  for (i32 i = 0; i < count; i++) {
    i64 from = offsets[i];
    i64 to = i + 1 < count ? offsets[i + 1] : lastEnd;
    i32 span = (to - from) as~ i32;
    i32 at2 = from as~ i32;
    u8[] seg = u8[span]();
    for (i32 k = 0; k < span; k++) { seg[k] = pack[at2 + k]; }
    crcByWalk[i] = crc32(seg);
  }

  // The index wants names ascending, with each offset carried along.
  i32[] order = i32[count]();
  for (i32 i = 0; i < count; i++) { order[i] = i; }
  sortByName(order, names.bytes());

  u8[] sortedNames = u8[count * 20]();
  i64[] sortedOffsets = i64[count]();
  u32[] crcs = u32[count]();
  u8[] raw = names.bytes();
  for (i32 i = 0; i < count; i++) {
    i32 from = order[i];
    for (i32 k = 0; k < 20; k++) { sortedNames[i * 20 + k] = raw[from * 20 + k]; }
    sortedOffsets[i] = offsets[from];
    crcs[i] = crcByWalk[from];
  }
  return Indexed.Built(PackIndex(count, sortedNames, sortedOffsets, crcs));
}

/** The `Kind` for a pack type number. */
Kind kindOf(i32 n) {
  if (n == 1) { return Kind.Commit; }
  if (n == 2) { return Kind.Tree; }
  if (n == 4) { return Kind.Tag; }
  return Kind.Blob;
}

/** Resolve object `i` in place, following its base first. */
bool resolveInto(i32 i, i32 count, i64[] offsets, i32[] kinds, i64[] bases, Vec<u8[]> payloads,
                 Vec<u8[]> baseNames, Vec<u8[]> resolved, Vec<i32> resolvedKind, i32 depth) {
  if (depth <= 0) { return false; }
  if (resolvedKind.get(i) != 0) { return true; }
  i32 kind = kinds[i];
  if (kind >= 1 && kind <= 4) {
    resolved.set(i, payloads.get(i));
    resolvedKind.set(i, kind);
    return true;
  }
  i32 b = -1;
  if (kind == 6) {
    for (i32 k = 0; k < count; k++) { if (offsets[k] == bases[i]) { b = k; break; } }
  } else {
    // A reference delta names its base, and the name is only known once that base is resolved — so this
    // resolves everything else first and then looks. A thin pack's base is not here at all.
    for (i32 k = 0; k < count; k++) {
      if (k == i) { continue; }
      if (!resolveInto(k, count, offsets, kinds, bases, payloads, baseNames, resolved, resolvedKind, depth - 1)) {
        continue;
      }
      u8[] nm = sha1(framed(kindOf(resolvedKind.get(k)), resolved.get(k)));
      bool same = true;
      for (i32 q = 0; q < 20; q++) { if (nm[q] != baseNames.get(i)[q]) { same = false; break; } }
      if (same) { b = k; break; }
    }
  }
  if (b < 0) { return false; }
  if (!resolveInto(b, count, offsets, kinds, bases, payloads, baseNames, resolved, resolvedKind, depth - 1)) {
    return false;
  }
  u8[]? made = applyDelta(resolved.get(b), payloads.get(i));
  if (made is null) { return false; }
  resolved.set(i, made!);
  resolvedKind.set(i, resolvedKind.get(b));
  return true;
}

/**
 * Sort `order` so the twenty-byte names it indexes ascend.
 *
 * Heapsort rather than insertion sort, and the reason is a cliff rather than a preference: insertion
 * sort indexed this repository's own 18,209-object pack in 2.9 seconds, and a repository ten times the
 * size would have taken a hundred times as long. `n log n` makes that ten times, which is the
 * difference between slow and unusable.
 */
void sortByName(i32[] order, u8[] names) {
  i32 n = order.len();
  for (i32 start = n / 2 - 1; start >= 0; start--) { siftName(order, names, start, n); }
  for (i32 end = n - 1; end > 0; end--) {
    i32 t = order[0]; order[0] = order[end]; order[end] = t;
    siftName(order, names, 0, end);
  }
}

void siftName(i32[] order, u8[] names, i32 root0, i32 end) {
  i32 root = root0;
  while (root * 2 + 1 < end) {
    i32 child = root * 2 + 1;
    if (child + 1 < end && nameGreater(names, order[child + 1], order[child])) { child = child + 1; }
    if (!nameGreater(names, order[child], order[root])) { return; }
    i32 t = order[root]; order[root] = order[child]; order[child] = t;
    root = child;
  }
}

bool nameGreater(u8[] names, i32 a, i32 b) {
  for (i32 k = 0; k < 20; k++) {
    i32 x = names[a * 20 + k];
    i32 y = names[b * 20 + k];
    if (x != y) { return x > y; }
  }
  return false;
}

// ── writing ─────────────────────────────────────────────────────────────────────────────────────────
//
// `design/system/0005` step 7, and it says what to build: **a pack of whole objects, no deltas.** Deltas
// are optional in the format, so this is valid and larger. Getting git's ratios is a search problem —
// which base for which object, in which window, in which order — and nothing here needs it: the reader
// above handles both delta kinds when it is git doing the compressing, and a push of a few objects is
// bytes either way. Taking the small version, and saying so, is the plan's own instruction.

/** Four bytes, big-endian. */
void packU32(Buf out, i32 v) {
  out.push((v >> 24) & 255);
  out.push((v >> 16) & 255);
  out.push((v >> 8) & 255);
  out.push(v & 255);
}

/**
 * A packfile holding `contents`, each with its type from `kinds` — 1 commit, 2 tree, 3 blob, 4 tag.
 *
 * The inputs are parallel rather than a `Vec` of pairs because both a wac caller and a host driving this
 * from a test build them the same way, and `Vec<u8[]>` is the one container that crosses the boundary
 * without a struct going with it.
 *
 * **The header varint here is the inverse of `rawAt`'s, and is not the other varint in this format.** Four
 * bits of the size sit in the first byte beside the type, then seven at a time, least significant first.
 * An `ofs-delta`'s base offset is written the other way — most significant group first, with a bias per
 * continuation — and using one where the other belongs produces a pack that reads as a different object
 * rather than as a broken one, which is the failure that costs an afternoon.
 */
void pushObject(Buf out, i32 kind, u8[] body) {
  i32 first = ((kind & 7) << 4) | (body.len() & 0x0f);
  i32 rest = body.len() >> 4;
  if (rest != 0) { first = first | 0x80; }
  out.push(first);
  while (rest != 0) {
    i32 b = rest & 0x7f;
    rest = rest >> 7;
    if (rest != 0) { b = b | 0x80; }
    out.push(b);
  }
  // Each object is its own zlib stream, which is what lets a reader find the next one without a length
  // field: the inflater says where it ended.
  out.pushAll(zlibCompress(body));
}

export u8[] writePack(i32[] kinds, Vec<u8[]> contents) {
  Buf out = Buf.create();
  out.push('P');
  out.push('A');
  out.push('C');
  out.push('K');
  packU32(out, 2);
  packU32(out, contents.len());
  for (i32 i = 0; i < contents.len(); i++) { pushObject(out, kinds[i], contents.get(i)); }
  // Over everything above it, which is what `.idx` records as the pack's name and what `gitclone` uses
  // for the filename.
  out.pushAll(sha1(out.bytes()));
  return out.take();
}

/**
 * Complete a thin pack by appending the objects it was missing.
 *
 * This is what `git index-pack --fix-thin` does, and appending is the reason it works without anything
 * resembling a callback: a delta's base only has to be *somewhere in the pack*, not before it, so bases
 * added at the end resolve exactly as bases in the middle do. **wac has no closures**, so a resolver
 * handed in was never an option — and this is the better shape anyway, because the completed pack is a
 * file git accepts rather than a value only this library understands.
 *
 * The old trailer goes: it covered the old bytes. The count in the header grows by what was added.
 */
export u8[] completePack(u8[] pack, i32[] kinds, Vec<u8[]> contents) {
  if (pack.len() < 32) { return pack; }
  i32 was = (pack[8] << 24) | (pack[9] << 16) | (pack[10] << 8) | pack[11];
  Buf out = Buf.create();
  for (i32 i = 0; i < 8; i++) { out.push(pack[i]); }
  packU32(out, was + contents.len());
  // Everything between the header and the old trailing checksum, verbatim.
  for (i32 i = 12; i < pack.len() - 20; i++) { out.push(pack[i]); }
  for (i32 i = 0; i < contents.len(); i++) { pushObject(out, kinds[i], contents.get(i)); }
  out.pushAll(sha1(out.bytes()));
  return out.take();
}
