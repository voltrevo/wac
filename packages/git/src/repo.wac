// A repository: the layer that turns the parsers in this package into a client.
//
// Everything else here takes bytes. This takes an `Fs`, which is what lets the whole of git be written
// in wac rather than in whatever is driving it — the parsers were callable from a test harness and a
// *checkout* cannot be, because it has to read an unknown number of objects and write an unknown number
// of files.
//
// ## Two things this layer owns
//
// **Where an object comes from.** git looks in loose objects first and then in each pack, and until now
// every caller wanting both wrote that themselves — `packages/git`'s own tests each had a copy. It is
// one function here.
//
// **What a ref means.** `HEAD` is usually symbolic and may be direct, a loose ref shadows a packed one,
// and following one to another has to stop somewhere. Also one function.
//
// ## What it does not own
//
// Nothing writes yet. `checkout` writes files into the working tree and an index beside them, and that
// is the only thing here that changes anything — creating objects, moving refs and committing are
// step 5 of `design/system/0005`.

import { Buf } from "../../bytes/src/buf.wac";
import { Change, FAULT_EXISTS, FileResult, Stat } from "../../platform/src/platform.wac";
import { Fs } from "../../fs/src/fs.wac";
import { decode } from "../../codec/src/hex.wac";
// **`Opened` is deliberately not imported**, although the `match` below names its variants. This file
// declares `RepoAt.Opened`, and importing the enum too is a duplicate name the compiler refuses. It was
// imported for a while to quiet a wacc false alarm — `no variant of that name` — which is fixed on the
// checker side by `spec/cases/0095`, so the import became the only thing left that was wrong.
import { Got, Indexed, Pack, completePack, indexPack, openPack, objectNamed } from "./pack.wac";
import { Kind, Object, readLoose } from "./object.wac";
import { RefValue, PackedRef, packedTarget, parsePackedRefs, parseRef } from "./refs.wac";
import { Entry, Tree, parseTree, writeTree } from "./tree.wac";
import { Commit, Parsed, Who, formatCommit, parseCommit } from "./commit.wac";
import { framed, looseFile } from "./object.wac";
import { sha1 } from "../../crypto/src/sha1.wac";
import { GitIndex, IndexEntry, Staged, parseIndex, writeIndex } from "./index.wac";
import { Rule, ignored, parseIgnore } from "./ignore.wac";
import { encode } from "../../codec/src/hex.wac";
import { itoa } from "../../fmt/src/itoa.wac";
import { Vec } from "../../std/src/vec.wac";

/** An open repository. */
export struct Repo {
  Fs fs;
  /** The `.git` directory, without a trailing slash. */
  string gitDir;
  /** The directory the working tree lives in, without a trailing slash. */
  string workTree;
  /** Every pack found under `objects/pack`, loaded once. */
  Vec<Pack> packs;
}

export enum RepoAt {
  Opened(Repo repo),
  NoRepo(string why)
}

/** What a checkout did, or why it could not. */
export enum Written {
  /**
   * How many files were written, and how many of those wanted a mode this filesystem could not set.
   *
   * The second number is not decoration. `packages/fs` cannot `chmod` a host mount — the capability
   * does not exist on `Cli` — so an executable file checks out with the wrong mode and `git status`
   * reports it as modified. A caller that only saw the file count would find that out from git.
   * issues/system/0132.
   *
   * The third is the same shape for a **symlink**: mode `120000`, which `packages/fs` cannot create at
   * all, so it lands as an ordinary file holding the target path. That was documented on `checkout`
   * below and reported to nobody, which made it the one limitation here a caller could only discover
   * from `git status` — measured as ` T` against the worktree, a typechange. Counted now for the same
   * reason the mode is: a limitation that does not announce itself is indistinguishable from a bug.
   */
  Files(i32 count, i32 modesUnset, i32 linksAsFiles),
  Stopped(string why)
}

/**
 * Open `gitDir`, loading every pack under it.
 *
 * Packs are loaded eagerly and kept, because the alternative is re-reading and re-indexing an eight
 * megabyte file per object lookup. A repository with many packs pays for all of them at open time,
 * which is the trade `git` makes too.
 */
export RepoAt openRepo(Fs fs, string gitDir, string workTree) {
  Stat head = fs.stat(gitDir + "/HEAD");
  if (!head.exists) { return RepoAt.NoRepo("no HEAD in " + gitDir); }

  Vec<Pack> packs = Vec.create();
  string[]? names = fs.readDir(gitDir + "/objects/pack");
  if (!(names is null)) {
    string[] list = names!;
    for (i32 i = 0; i < list.len(); i++) {
      string n = list[i];
      // Pair them by stem rather than by listing order, which is not guaranteed to be sorted.
      if (n.len() > 4 && n.slice(n.len() - 4, n.len()) == ".idx") {
        string stem = n.slice(0, n.len() - 4);
        FileResult idxFile = fs.readFile(gitDir + "/objects/pack/" + stem + ".idx");
        FileResult packFile = fs.readFile(gitDir + "/objects/pack/" + stem + ".pack");
        if (idxFile.ok && packFile.ok) {
          match (openPack(packFile.bytes, idxFile.bytes)) {
            case Ready(p): { packs.push(p); }
            case Refused(why): {
              // A pack we cannot read is not a repository we cannot open: git carries on with the
              // others, and saying which one failed is more useful than refusing everything.
              return RepoAt.NoRepo("pack " + stem + ": " + why);
            }
          }
        }
      }
    }
  }
  return RepoAt.Opened(Repo(fs, gitDir, workTree, packs));
}

// These take `Repo` rather than `const Repo`: `Fs.readFile` is not a const method, because reading can
// update a mount's own state. So a reader of a repository is a mutator of its filesystem, which is
// worth saying out loud rather than working around with a cast.

/** Forty lowercase hex characters for twenty bytes. */
string hexOf(u8[] name) { return string.fromBytes(encode(name)); }

/**
 * The object called `name` — loose first, then each pack, which is the order git looks in.
 *
 * Loose wins because that is where a just-written object is: git writes loose and packs later, so a
 * pack found first would answer with a stale copy of anything rewritten. (Objects are immutable, so
 * "stale" cannot happen for a correct repository — but a corrupt pack should not shadow a good loose
 * object, and this order is the one that makes that true.)
 */
export Got readObject(Repo r, u8[] name) {
  string hex = hexOf(name);
  string loosePath = r.gitDir + "/objects/" + hex.slice(0, 2) + "/" + hex.slice(2, hex.len());
  FileResult f = r.fs.readFile(loosePath);
  if (f.ok) {
    match (readLoose(f.bytes)) {
      case Loaded(kind, data): return Got.Found(kindNumber(kind), data);
      case Unreadable(why): return Got.Absent("loose object " + hex + ": " + why);
    }
  }
  for (i32 i = 0; i < r.packs.len(); i++) {
    match (objectNamed(r.packs.get(i), name)) {
      case Found(kind, data): return Got.Found(kind, data);
      case Absent(why): { }
    }
  }
  return Got.Absent("object " + hex + " is not in this repository");
}

/** The number `pack.wac` uses for a kind: 1 commit, 2 tree, 3 blob, 4 tag. */
i32 kindNumber(Kind k) {
  return match (k) {
    case Commit: 1,
    case Tree: 2,
    case Blob: 3,
    case Tag: 4
  };
}

/**
 * Resolve a ref name to an object, following symbolic refs.
 *
 * A loose ref shadows a packed one, which is the order git uses and the state a repository is in
 * between a `git gc` and the next branch update. Bounded at eight hops: a symbolic ref may point at
 * another, and a repository can be edited into a cycle.
 */
export u8[]? resolveRef(Repo r, string refName) {
  string name = refName;
  for (i32 hop = 0; hop < 8; hop++) {
    FileResult loose = r.fs.readFile(r.gitDir + "/" + name);
    if (loose.ok) {
      match (parseRef(loose.bytes)) {
        case Direct(target): return target;
        case Symbolic(next): { name = next; continue; }
        case Unparsed(why): return null;
      }
    }
    FileResult packed = r.fs.readFile(r.gitDir + "/packed-refs");
    if (packed.ok) {
      u8[]? found = packedTarget(parsePackedRefs(packed.bytes), name);
      if (!(found is null)) { return found; }
    }
    return null;
  }
  return null;
}

/** What `HEAD` names, following it through whatever it points at. */
export u8[]? head(Repo r) { return resolveRef(r, "HEAD"); }

/** The tree a commit names. */
export u8[]? treeOfCommit(Repo r, u8[] commitName) {
  match (readObject(r, commitName)) {
    case Absent(why): return null;
    case Found(kind, data): {
      if (kind != 1) { return null; }
      // Only the `tree` header is needed here, and it is always the first line of a commit — so this
      // does not pull in the whole commit parser for one field.
      if (data.len() < 45) { return null; }
      if (data[0] != 't' || data[1] != 'r' || data[2] != 'e' || data[3] != 'e' || data[4] != 32) { return null; }
      Buf hex = Buf.create();
      for (i32 i = 5; i < 45; i++) { hex.push(data[i]); }
      u8[]? raw = decode(hex.bytes());
      if (raw is null) { return null; }
      if (raw!.len() != 20) { return null; }
      return raw!;
    }
  }
}

/**
 * Write a tree into the working tree, and an index describing what was written.
 *
 * Recursive over subtrees, depth-first in the tree's own order — which is git's sort order, so the
 * index comes out sorted without sorting it. That is the one reason the recursion is written this way:
 * an index has to be in git's order and building it in tree order gets that for free, where collecting
 * paths and sorting them afterwards would need the byte-comparison-with-`/` rule reimplemented.
 *
 * **Symlinks are written as ordinary files holding their target.** `packages/fs` has no way to create
 * one, and a checkout that silently wrote the target's *contents* would produce a working tree that
 * looked right and was not. This is the honest version and it makes `git status` report the file as
 * typechanged, which is the truth — measured rather than predicted since `test/checkout.test.ts` grew a
 * fixture containing one: exactly ` T <path>`, the typechange in the worktree column, because the index
 * written here records mode 40960 and agrees with `HEAD`. The count comes back in `Files` so the caller
 * can say it; for a while this was documented here and reported to nobody.
 */
export Written checkout(Repo r, u8[] treeName, string into) {
  Vec<IndexEntry> entries = Vec.create();
  // A one-element array rather than a return value, because this counts across a recursion and wac has
  // no out-parameters — the alternative is threading a pair back up every level.
  // Two slots rather than two arrays: [0] is modes this filesystem refused, [1] is symlinks written
  // as ordinary files. Both count across the recursion.
  i32[] unset = i32[2]();
  i32 n = walk(r, treeName, into, "", entries, 32, unset);
  if (n < 0) { return Written.Stopped("a tree could not be read, or nesting went past 32 deep"); }
  u8[] idx = writeIndex(GitIndex(entries, u8[0]()));
  Change wrote = r.fs.writeFile(r.gitDir + "/index", idx);
  if (!wrote.ok()) { return Written.Stopped("could not write the index: " + wrote.message); }
  return Written.Files(n, unset[0], unset[1]);
}

/** Files written, or -1. `prefix` is the path within the repository, for the index. */
i32 walk(Repo r, u8[] treeName, string dir, string prefix, Vec<IndexEntry> entries, i32 depth,
         i32[] unset) {
  if (depth <= 0) { return -1; }
  match (readObject(r, treeName)) {
    case Absent(why): return -1;
    case Found(kind, data): {
      if (kind != 2) { return -1; }
      match (parseTree(data)) {
        case Bad(why): return -1;
        case Ok(list): {
          i32 count = 0;
          for (i32 i = 0; i < list.len(); i++) {
            Entry e = list.get(i);
            string path = dir + "/" + e.name;
            string rel = prefix == "" ? e.name : prefix + "/" + e.name;
            if (e.isTree()) {
              Change made = r.fs.mkdir(path, true);
              if (!made.ok()) { return -1; }
              i32 sub = walk(r, e.hash, path, rel, entries, depth - 1, unset);
              if (sub < 0) { return -1; }
              count = count + sub;
            } else if (e.mode == "160000") {
              // **A gitlink, and the commit it names is not here** — it belongs to the submodule's own
              // repository, which is the whole point of the mode. Before this, `readObject` looked for it,
              // did not find it, and the checkout failed *entirely* with "a tree could not be read, or
              // nesting went past 32 deep" — a message about depth for a repository that merely has a
              // submodule.
              //
              // What git does for one it has not initialised is create the empty directory and record the
              // gitlink in the index, so this does that: `git status` is then clean, because both sides
              // agree the submodule is present and unpopulated. Nothing is fetched — cloning a submodule
              // needs its URL from `.gitmodules` and a second clone, and neither is here.
              Change made = r.fs.mkdir(path, true);
              if (!made.ok()) { return -1; }
              // Size zero: a gitlink has no content in this repository, and the stat cache is a cache —
              // `git status` re-reads on a miss, which the index tests measured.
              entries.push(IndexEntry(rel, e.hash, modeNumber(e.mode), 0, 0));
            } else {
              match (readObject(r, e.hash)) {
                case Absent(why): return -1;
                case Found(k, bytes): {
                  Change w = r.fs.writeFile(path, bytes);
                  if (!w.ok()) { return -1; }
                  // The mode git records is one of four, and only the executable bit is a real
                  // difference on disk. **A host mount cannot be `chmod`ed at all** — the capability
                  // does not exist on `Cli` — so this is counted rather than assumed: the file is
                  // written with whatever mode the backing gives it and the caller is told.
                  // issues/system/0132.
                  if (e.mode == "100755") {
                    Change mode = r.fs.setExecutable(path, true);
                    if (!mode.ok()) { unset[0] = unset[0] + 1; }
                  }
                  // Written above like any other blob, because its content *is* the target path. What
                  // is missing is the link itself, and there is no capability to make one.
                  if (e.mode == "120000") { unset[1] = unset[1] + 1; }
                  entries.push(IndexEntry(rel, e.hash, modeNumber(e.mode), bytes.len(), 0));
                  count = count + 1;
                }
              }
            }
          }
          return count;
        }
      }
    }
  }
}

/** The octal mode git writes, as the number the index stores. */
i32 modeNumber(string mode) {
  if (mode == "100755") { return 33261; }
  if (mode == "120000") { return 40960; }
  if (mode == "160000") { return 57344; }
  return 33188;
}

// ── writing ─────────────────────────────────────────────────────────────────────────────────────────
//
// design/system/0005 step 5. Everything above reads; from here on things are created.

/** A new object's name, or why it could not be written. */
export enum Stored {
  Named(u8[] name),
  NotStored(string why)
}

/**
 * Write `content` as a loose object and answer its name.
 *
 * **An object that is already there is left alone.** Objects are immutable and named by their content,
 * so rewriting one can only produce the same bytes — and git relies on that: it is what makes writing
 * an object idempotent and what lets two processes write the same blob without a lock.
 */
export Stored writeObject(Repo r, Kind kind, u8[] content) {
  u8[] name = sha1(framed(kind, content));
  string hex = hexOf(name);
  string dir = r.gitDir + "/objects/" + hex.slice(0, 2);
  string path = dir + "/" + hex.slice(2, hex.len());
  Stat there = r.fs.stat(path);
  if (there.exists) { return Stored.Named(name); }
  Change made = r.fs.mkdir(dir, true);
  if (!made.ok() && made.fault != FAULT_EXISTS()) {
    return Stored.NotStored("could not create " + dir + ": " + made.message);
  }
  Change wrote = r.fs.writeFile(path, looseFile(kind, content));
  if (!wrote.ok()) { return Stored.NotStored("could not write " + path + ": " + wrote.message); }
  return Stored.Named(name);
}

/**
 * Write every file under `dir` as a blob and every directory as a tree, and answer the root's name.
 *
 * `.git` is skipped, which is the one name that must not be walked.
 *
 * **A blob is `100755` when the file is executable and `100644` otherwise**, read from
 * `Stat.isExecutable` — the one bit that separates git's two regular-file modes. This used to record
 * `100644` for everything, because `Stat` carried no mode, so committing an executable wrote a mode
 * change nobody asked for; `git ls-tree` is what adjudicates it and `test/commit.test.ts` holds the case.
 * The *writing* half of issues/system/0132 — a checkout setting the bit — is separate.
 *
 * An empty directory produces no entry, because git has no way to represent one. That is git's
 * behaviour rather than a shortcut.
 *
 * `index` is filled with an entry per blob as the walk goes, in the tree's order — which is the order an
 * index has to be in, so writing one afterwards needs no sort. A commit that moved a ref without also
 * writing the index would leave `git status` reporting every file as deleted and untracked at once,
 * which is what the first version of `gitci` did.
 */
/**
 * How the working tree differs from the index — the second column of `git status --porcelain`.
 *
 * Step 4 wrote an index and a working tree; nothing here ever read a working tree back and compared, so
 * this package could construct a repository and not answer a question about one. A blob's name is the
 * SHA-1 of its framed content, so "has this file changed" is a hash and a comparison rather than a
 * heuristic — which is what makes a status checkable against git's instead of merely plausible.
 *
 * **Three things it does not report, each a real absence rather than a simplification:**
 *
 * - **Untracked files.** Finding them means walking the working tree; deciding which of them count means
 *   `.gitignore`, which is not here. A status listing every build artefact would be wrong in a more
 *   annoying way than one listing none.
 * - **A mode change.** `Stat` has no mode, so an executable that lost its bit is invisible from here —
 *   the same missing capability that makes our own checkout leave it unset. `issues/system/0132`.
 *   git reports that difference and this cannot, which is worth knowing before comparing the two.
 * - **Staged changes.** Porcelain's *first* column compares the index against `HEAD`; this is the second,
 *   the index against the working tree. Nothing here reads a commit's tree to fill the first in.
 *
 * Conflicted paths are skipped: a path at stage 1, 2 or 3 is three entries for one file, and reporting it
 * once per side would say three things about one path.
 */
export Vec<string> worktreeStatus(Repo r) {
  Vec<string> out = Vec.create();
  FileResult f = r.fs.readFile(r.gitDir + "/index");
  if (!f.ok) { return out; }
  match (parseIndex(f.bytes)) {
    case Unreadable(why): { return out; }
    case Present(idx): {
      for (i32 i = 0; i < idx.entries.len(); i++) {
        IndexEntry e = idx.entries.get(i);
        if (e.stage != 0) { continue; }
        FileResult got = r.fs.readFile(r.workTree + "/" + e.path);
        if (!got.ok) {
          out.push(" D " + e.path);
          continue;
        }
        // A gitlink has no content here — the commit lives in the submodule's repository — so hashing the
        // directory would report every submodule as modified. git compares the checked-out commit instead,
        // which needs the submodule cloned; skipped, and named in the README.
        if (e.mode == 57344) { continue; }
        u8[] name = sha1(framed(Kind.Blob, got.bytes));
        bool same = true;
        for (i32 k = 0; k < 20; k++) {
          if (name[k] != e.name[k]) { same = false; break; }
        }
        // **The mode counts as a difference even when every byte matches.** git reports a file that
        // gained or lost its executable bit as ` M` with no content change, and this could not see it
        // until `Stat` carried the bit — issues/system/0132. `33261` is `100755`; anything else recorded
        // for a regular file is `100644`, so one comparison covers both directions.
        if (same && (r.fs.stat(r.workTree + "/" + e.path).isExecutable != (e.mode == 33261))) {
          same = false;
        }
        if (!same) { out.push(" M " + e.path); }
      }
    }
  }
  return out;
}

/** One blob or gitlink from a commit's tree, with its path flattened out of the subtrees. */
struct TreeAt {
  string path;
  i32 mode;
  u8[] name;
}

/**
 * Every non-tree entry under `treeName`, with the path a `.git/index` would spell.
 *
 * Bounded like `checkout`'s walk: a tree can be edited into a cycle, and a depth is what turns that into a
 * refusal rather than a hang.
 */
bool flattenTree(Repo r, u8[] treeName, string prefix, Vec<TreeAt> out, i32 depth) {
  if (depth <= 0) { return false; }
  match (readObject(r, treeName)) {
    case Absent(why): { return false; }
    case Found(kind, data): {
      if (kind != 2) { return false; }
      match (parseTree(data)) {
        case Bad(why): { return false; }
        case Ok(list): {
          for (i32 i = 0; i < list.len(); i++) {
            Entry e = list.get(i);
            string rel = prefix == "" ? e.name : prefix + "/" + e.name;
            if (e.isTree()) {
              if (!flattenTree(r, e.hash, rel, out, depth - 1)) { return false; }
            } else {
              out.push(TreeAt(rel, modeNumber(e.mode), e.hash));
            }
          }
          return true;
        }
      }
    }
  }
}

bool sameName(u8[] a, u8[] b) {
  if (a.len() != b.len()) { return false; }
  for (i32 i = 0; i < a.len(); i++) { if (a[i] != b[i]) { return false; } }
  return true;
}

/** Whether any index entry lives under `dir` — which decides whether git collapses it. */
bool anyTrackedUnder(const Vec<IndexEntry> entries, string dir) {
  string with = dir + "/";
  for (i32 i = 0; i < entries.len(); i++) {
    IndexEntry e = entries.get(i);
    if (e.stage != 0) { continue; }
    if (e.path.len() > with.len() && e.path.slice(0, with.len()) == with) { return true; }
  }
  return false;
}

/** Whether `path` is one of the index's own entries. */
bool tracked(const Vec<IndexEntry> entries, string path) {
  for (i32 i = 0; i < entries.len(); i++) {
    if (entries.get(i).stage == 0 && entries.get(i).path == path) { return true; }
  }
  return false;
}

/**
 * Walk `dir` and push `?? ` lines for what is neither tracked nor ignored.
 *
 * **An entirely untracked directory collapses to one line ending in `/`**, which is what git prints and the
 * reason this cannot simply list files: a fresh `node_modules` is one line to git and thousands to a walker
 * that does not know the rule. If anything under it *is* tracked, git lists the untracked files inside
 * individually, so the walk descends in that case and not otherwise.
 *
 * `.git` is skipped without consulting any rule, as git does — no `.gitignore` mentions it and every
 * repository would be full of it otherwise.
 */
void untrackedUnder(Repo r, Vec<Rule> rules, const Vec<IndexEntry> entries, string dir,
                    string prefix, Vec<string> out, i32 depth) {
  if (depth <= 0) { return; }
  // **This directory's own `.gitignore`, appended for this subtree and everything under it.** git reads one
  // per directory and a deeper file overrides a shallower one, which falls out of last-match-wins as long as
  // the deeper rules come later in the list — so they are appended on the way down. `rules` is copied per
  // level rather than shared, because a sibling directory must not inherit its neighbour's rules.
  Vec<Rule> here = Vec.create();
  for (i32 i = 0; i < rules.len(); i++) { here.push(rules.get(i)); }
  FileResult own = r.fs.readFile(dir + "/.gitignore");
  if (own.ok) {
    Vec<Rule> mine = parseIgnore(own.bytes, prefix);
    for (i32 i = 0; i < mine.len(); i++) { here.push(mine.get(i)); }
  }
  string[]? names = r.fs.readDir(dir);
  if (names is null) { return; }
  string[] list = names!;
  // git orders its output by path, and the host's directory order is not promised to be anything.
  for (i32 a = 1; a < list.len(); a++) {
    string cur = list[a];
    i32 b = a - 1;
    while (b >= 0 && bytesAfter(list[b], cur)) {
      list[b + 1] = list[b];
      b = b - 1;
    }
    list[b + 1] = cur;
  }
  for (i32 i = 0; i < list.len(); i++) {
    string name = list[i];
    if (name == ".git") { continue; }
    string rel = prefix == "" ? name : prefix + "/" + name;
    Stat st = r.fs.stat(dir + "/" + name);
    if (ignored(here, rel, st.isDir)) { continue; }
    if (st.isDir) {
      if (anyTrackedUnder(entries, rel)) {
        untrackedUnder(r, here, entries, dir + "/" + name, rel, out, depth - 1);
      } else {
        out.push("?? " + rel + "/");
      }
      continue;
    }
    if (!tracked(entries, rel)) { out.push("?? " + rel); }
  }
}

/** Byte comparison of two names, for the same reason `pathAfter` exists. */
bool bytesAfter(string a, string b) {
  u8[] x = a.toBytes();
  u8[] y = b.toBytes();
  i32 n = x.len() < y.len() ? x.len() : y.len();
  for (i32 i = 0; i < n; i++) {
    if (x[i] != y[i]) { return x[i] > y[i]; }
  }
  return x.len() > y.len();
}

/**
 * Whether `a`'s path sorts after `b`'s, comparing the bytes after the two status columns.
 *
 * git orders its porcelain by path, and matching that is what lets a test diff the two outputs as text
 * instead of sorting both and comparing sets — which would hide an ordering mistake rather than catch one.
 * Byte comparison rather than any notion of collation, because that is what git does and what the index's
 * own ordering rule uses.
 */
bool pathAfter(string a, string b) {
  u8[] x = a.toBytes();
  u8[] y = b.toBytes();
  i32 n = x.len() < y.len() ? x.len() : y.len();
  for (i32 i = 3; i < n; i++) {
    if (x[i] != y[i]) { return x[i] > y[i]; }
  }
  return x.len() > y.len();
}

/**
 * Both of `git status --porcelain`'s columns: the index against `HEAD`, and the working tree against the
 * index.
 *
 * `worktreeStatus` above answers the second column alone, which is what a caller wants when there is no
 * commit to compare against — a repository mid-clone, or one whose `HEAD` is unborn. This answers both, and
 * the two columns are independent: a file staged and then edited again is `MM`, which is the case that
 * proves they are computed separately rather than one being derived from the other.
 *
 * **`excludes` is the content of `core.excludesFile`, and the caller reads it rather than this.** The value
 * is usually `~/.gitignore_global`, and expanding that `~` needs `HOME` — which needs a `Cli`, which a
 * `Repo` does not carry and should not start carrying to answer a question about ignore rules. So the
 * program that knows about environments resolves the path and hands over the bytes, and this parses them
 * as the lowest-precedence rules. Empty bytes mean the setting is unset, which is the common case.
 *
 * A mode change is still absent — `Stat` has no mode, `issues/system/0132` — so an executable that lost its
 * bit is invisible in the second column, though a *staged* mode change is visible in the first, because
 * both sides of that comparison are recorded.
 *
 * Linear searches over the index rather than a map: wac has no hash map, the fixtures are small, and a
 * repository where this matters wants a different data structure than a status is the place to introduce.
 */
export Vec<string> statusOf(Repo r, u8[] excludes) {
  Vec<string> out = Vec.create();
  // **Two lists, because git's porcelain is grouped rather than sorted.** Tracked changes come first and
  // untracked ones after, each sorted by path — so `?? .gitignore` follows `M  a.txt` even though `.`
  // sorts before `a`. One global sort put them the other way round, which is how this was found.
  Vec<string> untracked = Vec.create();
  FileResult f = r.fs.readFile(r.gitDir + "/index");
  if (!f.ok) { return out; }
  Vec<TreeAt> tree = Vec.create();
  u8[]? at = head(r);
  if (!(at is null)) {
    u8[]? t = treeOfCommit(r, at!);
    // An unresolvable HEAD leaves the tree empty, which reads every index entry as an addition — correct
    // for a repository whose first commit does not exist yet.
    if (!(t is null)) {
      if (!flattenTree(r, t!, "", tree, 64)) { return out; }
    }
  }

  match (parseIndex(f.bytes)) {
    case Unreadable(why): { return out; }
    case Present(idx): {
      for (i32 i = 0; i < idx.entries.len(); i++) {
        IndexEntry e = idx.entries.get(i);
        if (e.stage != 0) { continue; }

        // Column one: the index against HEAD.
        string x = " ";
        i32 found = -1;
        for (i32 k = 0; k < tree.len(); k++) {
          if (tree.get(k).path == e.path) { found = k; break; }
        }
        if (found < 0) {
          x = "A";
        } else if (!sameName(tree.get(found).name, e.name) || tree.get(found).mode != e.mode) {
          x = "M";
        }

        // Column two: the working tree against the index.
        string y = " ";
        FileResult got = r.fs.readFile(r.workTree + "/" + e.path);
        if (!got.ok) {
          y = "D";
        } else if (e.mode != 57344) {
          if (!sameName(sha1(framed(Kind.Blob, got.bytes)), e.name)) {
            y = "M";
          } else if (r.fs.stat(r.workTree + "/" + e.path).isExecutable != (e.mode == 33261)) {
            // **A mode change with no content change**, which git reports as ` M` and this could not see
            // until `Stat` carried the bit — issues/system/0132. `33261` is `100755`; a regular file
            // recorded as anything else is `100644`, so one comparison covers gaining and losing it.
            //
            // The same test lives in `worktreeStatus` above, which answers this column on its own for a
            // caller with no `HEAD` to compare against. Two copies rather than one because the loops
            // differ in what else they carry, and a helper taking six arguments to save four lines was
            // the worse trade — but they must agree, and `test/wac/status_test.wac` drives both.
            y = "M";
          }
        }

        if (x != " " || y != " ") { out.push(x + y + " " + e.path); }
      }

      // Untracked files, which need the ignore rules or they would be noise.
      //
      // **The four sources in the order git applies them, lowest first**, because the whole contract of the
      // rule list is that later rules win. `excludes` is `core.excludesFile`, handed in by the caller;
      // `.git/info/exclude` is read here; the work tree's own `.gitignore` and every nested one are
      // gathered by the walk itself on the way down, so a deeper file's rules land later and win.
      //
      // **That order was measured rather than taken from the documentation.** With `both.txt` in a
      // `core.excludesFile` and `!both.txt` in `.git/info/exclude`, `git check-ignore -v` names
      // `.git/info/exclude` as the deciding line and `git status` lists the file; with `!kept.txt` in the
      // excludes file and `kept.txt` in a `.gitignore`, the `.gitignore` decides. Getting these two the
      // wrong way round produces a matcher that agrees with git on every path where the sources agree and
      // differs on exactly the paths where they do not, which is the class of mistake a tidy fixture
      // passes straight through.
      Vec<Rule> rules = parseIgnore(excludes, "");
      FileResult exclude = r.fs.readFile(r.gitDir + "/info/exclude");
      if (exclude.ok) { rules.extend(parseIgnore(exclude.bytes, "")); }
      untrackedUnder(r, rules, idx.entries, r.workTree, "", untracked, 64);

      // In HEAD and not in the index: staged for deletion.
      for (i32 k = 0; k < tree.len(); k++) {
        bool present = false;
        for (i32 i = 0; i < idx.entries.len(); i++) {
          IndexEntry e = idx.entries.get(i);
          if (e.stage == 0 && e.path == tree.get(k).path) { present = true; break; }
        }
        if (!present) { out.push("D  " + tree.get(k).path); }
      }
    }
  }
  // Each group ordered by path, then the untracked group appended after the tracked one.
  sortLines(out);
  sortLines(untracked);
  for (i32 i = 0; i < untracked.len(); i++) { out.push(untracked.get(i)); }
  return out;
}

/** Insertion sort by the path after the two status columns. */
void sortLines(Vec<string> lines) {
  for (i32 i = 1; i < lines.len(); i++) {
    string cur = lines.get(i);
    i32 j = i - 1;
    while (j >= 0 && pathAfter(lines.get(j), cur)) {
      lines.set(j + 1, lines.get(j));
      j = j - 1;
    }
    lines.set(j + 1, cur);
  }
}

/** One object a push has to carry: the pack's own kind number, and the name. */
export struct Reachable {
  /** 1 commit, 2 tree, 3 blob — the numbers `writePack` takes. */
  i32 kind;
  u8[] name;
}

bool haveName(const Vec<Reachable> seen, u8[] name) {
  for (i32 i = 0; i < seen.len(); i++) {
    if (sameName(seen.get(i).name, name)) { return true; }
  }
  return false;
}

/** Add every tree and blob under `treeName`, depth-first. */
bool reachTree(Repo r, u8[] treeName, Vec<Reachable> out, i32 depth) {
  if (depth <= 0) { return false; }
  if (haveName(out, treeName)) { return true; }
  match (readObject(r, treeName)) {
    case Absent(why): { return false; }
    case Found(kind, data): {
      if (kind != 2) { return false; }
      out.push(Reachable(2, treeName));
      match (parseTree(data)) {
        case Bad(why): { return false; }
        case Ok(list): {
          for (i32 i = 0; i < list.len(); i++) {
            Entry e = list.get(i);
            if (e.isTree()) {
              if (!reachTree(r, e.hash, out, depth - 1)) { return false; }
            } else if (e.mode == "160000") {
              // A gitlink names a commit in the submodule's repository. It is not ours to send, and a
              // server does not expect it — this is the one entry a push steps over.
              continue;
            } else if (!haveName(out, e.hash)) {
              out.push(Reachable(3, e.hash));
            }
          }
          return true;
        }
      }
    }
  }
}

/**
 * Every object reachable from `commit` — itself, its ancestors, and all their trees and blobs.
 *
 * This is what a push of a new ref has to carry, and it is deliberately the *whole* history rather than a
 * difference: computing a difference needs to know what the far end already has, which is a negotiation
 * this does not do. A push into an empty repository is the case that needs no negotiation at all, and it is
 * the case `receive.wac`'s tests use.
 *
 * Empty means something was missing or malformed — a caller cannot push a history it cannot read.
 */
export Vec<Reachable> reachableFrom(Repo r, u8[] commit, i32 depth) {
  Vec<Reachable> out = Vec.create();
  Vec<u8[]> queue = Vec.create();
  queue.push(commit);
  i32 at = 0;
  while (at < queue.len()) {
    u8[] name = queue.get(at);
    at = at + 1;
    if (haveName(out, name)) { continue; }
    match (readObject(r, name)) {
      case Absent(why): { return Vec.create(); }
      case Found(kind, data): {
        if (kind != 1) { return Vec.create(); }
        out.push(Reachable(1, name));
        match (parseCommit(data)) {
          case Malformed(why): { return Vec.create(); }
          case Understood(c): {
            if (!reachTree(r, c.tree, out, depth)) { return Vec.create(); }
            for (i32 i = 0; i < c.parents.len(); i++) { queue.push(c.parents.get(i)); }
          }
        }
      }
    }
  }
  return out;
}

/**
 * Everything reachable from `tip` that is **not** reachable from any of `alreadyThere`.
 *
 * This is what a push should actually carry, and `git rev-list --objects <tip> --not <those>` computes the
 * same set — which is how `test/push.test.ts` checks it rather than trusting it.
 *
 * **There is no negotiation in the receive-pack protocol**, which is easy to misread as "a client cannot
 * know what to leave out". It can: the advertisement already said what every ref points at, and everything
 * reachable from those is by definition present at the far end. So the difference is a local computation
 * over two walks, and the only thing a naive push saves by skipping it is the effort — at the cost of
 * re-sending an entire history on every push.
 *
 * An `alreadyThere` entry this repository cannot read is **skipped rather than fatal**: somebody else may
 * have pushed a commit we have never seen, and the honest response is to send more than strictly necessary
 * rather than to refuse. Over-sending is wasteful and correct; under-sending is a broken repository at the
 * far end.
 */
export Vec<Reachable> reachableExcluding(Repo r, u8[] tip, Vec<u8[]> alreadyThere, i32 depth) {
  Vec<Reachable> have = Vec.create();
  for (i32 i = 0; i < alreadyThere.len(); i++) {
    Vec<Reachable> one = reachableFrom(r, alreadyThere.get(i), depth);
    for (i32 k = 0; k < one.len(); k++) {
      if (!haveName(have, one.get(k).name)) { have.push(one.get(k)); }
    }
  }
  if (have.len() == 0) { return reachableFrom(r, tip, depth); }

  Vec<Reachable> all = reachableFrom(r, tip, depth);
  if (all.len() == 0) { return all; }
  Vec<Reachable> out = Vec.create();
  for (i32 i = 0; i < all.len(); i++) {
    if (haveName(have, all.get(i).name)) { continue; }
    out.push(all.get(i));
  }
  return out;
}

/** A thin pack completed from what this repository holds, or why it could not be. */
export enum Completion {
  /** The pack with its missing bases appended, ready for `indexPack`. */
  Complete(u8[] pack),
  /** It needs an object this repository does not have. Named, so a caller can go and get it. */
  Missing(string why),
  /** The pack is not thin, it is damaged. */
  Unusable(string why)
}

/**
 * Complete a thin pack from this repository's own objects.
 *
 * **This is the caller `completePack` was missing.** A server answering a request with `have`s may send
 * deltas against objects it knows you hold, and until something read those objects out of a local store
 * the completion was machinery with no user. `indexPack` says which names it needs; this reads them from
 * here — loose or packed, since `readObject` looks in both — and hands them over.
 *
 * A pack that is already whole comes back unchanged rather than refused, so a caller that does not know
 * which kind it received can put every pack through this.
 *
 * The variants avoid the name `Absent`, which `Got` already uses in this file: two enums whose variants
 * collide have cost this package a day of somebody's time — see `issues/lang/0096` and `0097`.
 */
export Completion completeThin(Repo r, u8[] pack) {
  match (indexPack(pack)) {
    case Built(idx): { return Completion.Complete(pack); }
    case Unindexable(why): { return Completion.Unusable(why); }
    case Thin(bases): {
      i32[] kinds = i32[bases.len()]();
      Vec<u8[]> contents = Vec.create();
      for (i32 i = 0; i < bases.len(); i++) {
        match (readObject(r, bases.get(i))) {
          case Absent(why): {
            return Completion.Missing("the pack is deltified against " + hexOf(bases.get(i))
              + ", which this repository does not have: " + why);
          }
          case Found(kind, data): {
            kinds[i] = kind;
            contents.push(data);
          }
        }
      }
      return Completion.Complete(completePack(pack, kinds, contents));
    }
  }
}

export Stored writeWorkTree(Repo r, string dir, string prefix, Vec<IndexEntry> index) {
  string[]? listing = r.fs.readDir(dir);
  if (listing is null) { return Stored.NotStored("cannot read " + dir); }
  string[] names = listing!;

  // **Ordered before anything is written, not after.** The tree could be sorted at the end, but the
  // index cannot: its entries are collected as the walk descends, so walking in `readDir` order puts
  // `a/inner` before `a.b` and git answers `fatal: unordered stage entries in index`. Sorting the
  // *listing* first makes both come out in order by construction.
  Vec<string> kept = Vec.create();
  Vec<bool> dirs = Vec.create();
  for (i32 i = 0; i < names.len(); i++) {
    string n = names[i];
    if (n == ".git" || n == "." || n == "..") { continue; }
    Stat st = r.fs.stat(dir + "/" + n);
    if (!st.isDir && !st.isFile) { continue; }
    kept.push(n);
    dirs.push(st.isDir);
  }
  sortListing(kept, dirs);

  Vec<Entry> entries = Vec.create();
  for (i32 i = 0; i < kept.len(); i++) {
    string n = kept.get(i);
    string path = dir + "/" + n;
    string rel = prefix == "" ? n : prefix + "/" + n;
    if (dirs.get(i)) {
      match (writeWorkTree(r, path, rel, index)) {
        case NotStored(why): return Stored.NotStored(why);
        case Named(sub): {
          // A directory with nothing in it has no entry: git cannot represent one.
          if (!isEmptyTree(sub)) { entries.push(Entry("40000", n, sub)); }
        }
      }
    } else {
      FileResult f = r.fs.readFile(path);
      if (!f.ok) { return Stored.NotStored("cannot read " + path); }
      // **The mode is read, not assumed.** `Stat.isExecutable` is one bit and it is the only bit that
      // separates git's two regular-file modes, so a tree built from a working tree now records what is
      // on disk. Before this it recorded `100644` for everything and a commit of an executable carried a
      // mode change nobody asked for. issues/system/0132.
      bool exec = r.fs.stat(path).isExecutable;
      match (writeObject(r, Kind.Blob, f.bytes)) {
        case NotStored(why): return Stored.NotStored(why);
        case Named(blob): {
          entries.push(Entry(exec ? "100755" : "100644", n, blob));
          index.push(IndexEntry(rel, blob, exec ? 33261 : 33188, f.bytes.len(), 0));
        }
      }
    }
  }
  return writeObject(r, Kind.Tree, writeTree(entries));
}

/**
 * Sort a directory listing into git's tree order, carrying the is-a-directory flag with each name.
 *
 * Insertion sort, which is the wrong asymptotics for a directory of ten thousand names and the right
 * amount of code for one of ten. Said rather than hidden: a repository with a very wide directory will
 * notice.
 */
void sortListing(Vec<string> names, Vec<bool> dirs) {
  for (i32 i = 1; i < names.len(); i++) {
    string keyName = names.get(i);
    bool keyDir = dirs.get(i);
    i32 j = i - 1;
    while (j >= 0 && sortsBefore(keyName, keyDir, names.get(j), dirs.get(j))) {
      names.set(j + 1, names.get(j));
      dirs.set(j + 1, dirs.get(j));
      j = j - 1;
    }
    names.set(j + 1, keyName);
    dirs.set(j + 1, keyDir);
  }
}

/**
 * git's order: by name as raw bytes, with a directory compared as though its name ended in `/`.
 *
 * This is the rule that has to be implemented rather than approximated. `a.b` sorts *before* the
 * directory `a`, because `.` is 0x2E and `/` is 0x2F — so sorting plain names puts them the other way
 * round and produces a tree with a different hash that git will read and disagree with every other
 * client about.
 */
bool sortsBefore(string an, bool ad, string bn, bool bd) {
  u8[] x = (an + (ad ? "/" : "")).toBytes();
  u8[] y = (bn + (bd ? "/" : "")).toBytes();
  i32 n = x.len() < y.len() ? x.len() : y.len();
  for (i32 i = 0; i < n; i++) {
    if (x[i] != y[i]) { return x[i] < y[i]; }
  }
  return x.len() < y.len();
}

/** The name of the empty tree, which git spells `4b825dc642cb6eb9a060e54bf8d69288fbee4904`. */
bool isEmptyTree(u8[] name) {
  return hexOf(name) == "4b825dc642cb6eb9a060e54bf8d69288fbee4904";
}

/**
 * Commit a tree, and move a ref to it.
 *
 * The parent is whatever the ref names now, or no parent if it names nothing — which is how a first
 * commit happens, and why this does not require one.
 */
export Stored commitTree(Repo r, u8[] tree, string refName, Who author, string message,
                         Vec<IndexEntry> index) {
  Vec<u8[]> parents = Vec.create();
  u8[]? current = resolveRef(r, refName);
  if (!(current is null)) { parents.push(current!); }

  match (writeObject(r, Kind.Commit, formatCommit(tree, parents, author, author, message))) {
    case NotStored(why): return Stored.NotStored(why);
    case Named(commit): {
      // A ref file is forty hex characters and a newline. Written whole rather than appended: git
      // rewrites it too, and an interrupted append would leave a ref nothing can read.
      Change moved = r.fs.writeFile(r.gitDir + "/" + refName, (hexOf(commit) + "\n").toBytes());
      if (!moved.ok()) { return Stored.NotStored("could not update " + refName + ": " + moved.message); }
      // The index too, or `git status` compares the new commit against the old index and reports every
      // path as both deleted and untracked.
      Change staged = r.fs.writeFile(r.gitDir + "/index", writeIndex(GitIndex(index, u8[0]())));
      if (!staged.ok()) { return Stored.NotStored("could not write the index: " + staged.message); }
      return Stored.Named(commit);
    }
  }
}

/** What `HEAD` points at, as a ref name — or empty if it is detached. */
export string headRef(Repo r) {
  FileResult f = r.fs.readFile(r.gitDir + "/HEAD");
  if (!f.ok) { return ""; }
  match (parseRef(f.bytes)) {
    case Symbolic(target): return target;
    case Direct(name): return "";
    case Unparsed(why): return "";
  }
}
