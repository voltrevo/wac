// Running a child with a **declared** environment, which `Cli.exec` has no parameter for.
//
// `exec(program, args, stdin)` takes no environment, and the child gets the host's whole one —
// 37 variables here, including `HOME` and the proxy. That is `issues/system/0198`: the grant `run`
// silently carries the grant `env`, because a program refused `--allow-env` can spawn something that
// prints a variable. `issues/system/0182` is the parameter that would fix it.
//
// Neither is a reason a test cannot set a variable *today*. `Cli.exec`'s own documentation points at
// the answer — "a caller who wants a shell asks for one by name: `exec("/bin/sh", string[]("-c",
// line), …)`" — and an assignment on that line is a declaration at the call site rather than an
// inheritance. It overrides whatever arrived, which is what a test measuring *which file git reads*
// needs, and it is the spelling that still works on the day `exec` stops inheriting.
//
// The quoting is the part worth having in one place. Every value goes through `shQuoted`, so a path
// with a space arrives whole and a `~` is **not** expanded by the shell — the last one matters
// directly: `core.excludesFile = ~/.gitignore_global` is a value git expands, and a shell that got
// there first would be testing something else.

import { Cli, Exec } from "../../../platform/src/platform.wac";

/**
 * One shell word.
 *
 * Single quotes, so nothing inside is expanded or re-split; an embedded `'` ends the quoting, escapes
 * itself and reopens — `'\''`, the only form that works in `sh` since single quotes do not nest.
 */
export string shQuoted(string s) {
  string out = "'";
  for (i32 i = 0; i < s.len(); i++) {
    string c = s.slice(i, i + 1);
    out = out + (c == "'" ? "'\\''" : c);
  }
  return out + "'";
}

/**
 * `prog args…` with `names[i]=values[i]` set, and everything else as it was.
 *
 * `exec` at the front of the line so the shell replaces itself rather than waiting on a child — one
 * process instead of two, and the status that comes back is the program's own.
 */
export Exec withEnv(Cli cli, string[] names, string[] values, string prog, string[] args) {
  string line = "";
  for (i32 i = 0; i < names.len() && i < values.len(); i++) {
    line = line + names[i] + "=" + shQuoted(values[i]) + " ";
  }
  line = line + "exec " + shQuoted(prog);
  for (i32 i = 0; i < args.len(); i++) { line = line + " " + shQuoted(args[i]); }
  return cli.exec("/bin/sh", string[]("-c", line), u8[0]()).wait();
}

/** The common case: a fixture `HOME`, so `~` resolves somewhere the test built. */
export Exec withHome(Cli cli, string home, string prog, string[] args) {
  return withEnv(cli, string[]("HOME"), string[](home), prog, args);
}
