// Completing a thin pack against a repository, with the repository built in memory.
//
// `completeThin` takes a `Repo`, which takes an `Fs`, which a bound module cannot be handed from
// JavaScript — so the alternative to this file is a whole program and a temporary directory. `Fs.inMemory`
// makes neither necessary: the store is built here, in wac, out of the bytes the caller passes, and only
// the completed pack comes back.
//
// **The `.git` this makes is the smallest one `openRepo` accepts**: a `HEAD` and an `objects/` for
// `writeObject` to put things in. No refs, no index — nothing here resolves a ref or reads a working tree.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Fs } from "../../../fs/src/fs.wac";
import { Kind } from "../../src/object.wac";
import { Completion, RepoAt, Stored, completeThin, openRepo, writeObject } from "../../src/repo.wac";

/** The pack's own type numbers, as `readObject` and `completePack` use them. */
Kind kindOfNumber(i32 n) {
  if (n == 1) { return Kind.Commit; }
  if (n == 2) { return Kind.Tree; }
  if (n == 4) { return Kind.Tag; }
  return Kind.Blob;
}

/**
 * Put `baseKind`/`baseContent` in a fresh in-memory repository, then complete `pack` against it.
 *
 * Empty means it did not complete, and `whyIncomplete` says which of the two reasons — kept separate so a
 * caller distinguishes "needs an object we do not have" from "this pack is damaged", which is the whole
 * distinction `Completion` exists to draw.
 */
export u8[] completeAgainst(u8[] pack, i32 baseKind, u8[] baseContent) {
  Fs fs = Fs.inMemory(0);
  fs.mkdir("/git/objects", true);
  fs.writeFile("/git/HEAD", "ref: refs/heads/main\n".toBytes());
  match (openRepo(fs, "/git", "/work")) {
    case NoRepo(why): { return u8[0](); }
    case Opened(repo): {
      match (writeObject(repo, kindOfNumber(baseKind), baseContent)) {
        case NotStored(why): { return u8[0](); }
        case Named(name): { }
      }
      match (completeThin(repo, pack)) {
        case Complete(whole): { return whole; }
        case Missing(why): { return u8[0](); }
        case Unusable(why): { return u8[0](); }
      }
    }
  }
}

/** Why the completion above produced nothing: the wording, so a test can tell the two apart. */
export string whyIncomplete(u8[] pack, i32 baseKind, u8[] baseContent) {
  Fs fs = Fs.inMemory(0);
  fs.mkdir("/git/objects", true);
  fs.writeFile("/git/HEAD", "ref: refs/heads/main\n".toBytes());
  match (openRepo(fs, "/git", "/work")) {
    case NoRepo(why): { return "no repo: " + why; }
    case Opened(repo): {
      // The caller decides whether to plant the base — `baseKind` of zero means do not, which is how a
      // test reaches the `Missing` arm on purpose.
      if (baseKind != 0) {
        match (writeObject(repo, kindOfNumber(baseKind), baseContent)) {
          case NotStored(why): { return "not stored: " + why; }
          case Named(name): { }
        }
      }
      match (completeThin(repo, pack)) {
        case Complete(whole): { return "complete"; }
        case Missing(why): { return "missing: " + why; }
        case Unusable(why): { return "unusable: " + why; }
      }
    }
  }
}
