// Refs and commits, and the two together: walking a real history.
//
// The oracle is `git rev-list`, `git show-ref` and `git cat-file`. What makes this worth more than a
// parser test is the **walk**: resolving `HEAD` to a ref, that ref to a commit, and then following
// parents until a root — because every step feeds the next, and a mistake anywhere ends the walk
// early or takes it somewhere git does not go.
//
// The fixture has a root commit, a merge and a packed-refs file on purpose. All three are shapes a
// parser can be wrong about while working on an ordinary linear history:
//
//   - a **root** commit has no `parent` header at all,
//   - a **merge** has two, and a parser expecting one silently follows only the first,
//   - **`git gc`** deletes the loose ref files and writes `packed-refs`, so a reader that only looks
//     in `refs/` finds nothing afterwards.
//
// Host-side until 2026-08-17, `issues/system/0161`. The identity goes in with `-c` because
// `Cli.exec` passes no environment — and **the timestamp assertions got sharper for it**. They used
// to set `GIT_AUTHOR_DATE` and then compare the parsed zone against the literal `+0000`, which is a
// claim about the machine's timezone rather than about the parser. They read `git log --date=raw`
// now, so the commit can be made at any moment in any zone and the comparison is still git's own
// answer for the same object.

import { T } from "../../../wactest/src/assert.wac";
import { Exec, Env, Files, Sys, ChildEnv, Launch, Procs } from "std";
import { Vec, flatten } from "core";
import { RefValue, PackedRef, parseRef, parsePackedRefs, packedTarget } from "../../src/refs.wac";
import { Commit, Parsed, Who, parseCommit } from "../../src/commit.wac";
import { Object, readLoose } from "../../src/object.wac";
import { Pack, Opened, Got, openPack, objectNamed } from "../../src/pack.wac";
import { encode as hexOf, decoded } from "../../../codec/src/hex.wac";
import { agentDir } from "../../../wactest/src/host.wac";
import { joined } from "../../../wactest/src/strings.wac";

struct Git {
  Procs procs;
  string dir;

  Exec run(this, string[] args) {
    string[] full = string[].filled(args.len() + 6, "");
    full[0] = "-C";
    full[1] = this.dir;
    full[2] = "-c";
    full[3] = "user.name=Ada L";
    full[4] = "-c";
    full[5] = "user.email=ada@example.com";
    for (i32 i = 0; i < args.len(); i++) { full[6 + i] = args[i]; }
    return flatten(this.procs.exec("git", full, u8[](), ChildEnv.inherited(), Launch.plain()).wait()).unwrap();
  }

  string text(this, string[] args) {
    return trimmed(string.fromBytes(this.run(args).stdout));
  }
}

string trimmed(string s) {
  i32 end = s.len();
  while (end > 0 && (s.slice(end - 1, end) == "\n" || s.slice(end - 1, end) == " ")) {
    end = end - 1;
  }
  return s.slice(0, end);
}

string[] splitOn(string s, string sep) {
  if (s == "") { return string[].filled(0, ""); }
  i32 n = 1;
  for (i32 i = 0; i < s.len(); i++) { if (s.slice(i, i + 1) == sep) { n = n + 1; } }
  string[] out = string[].filled(n, "");
  i32 count = 0;
  i32 at = 0;
  for (i32 i = 0; i <= s.len(); i++) {
    if (i < s.len() && s.slice(i, i + 1) != sep) { continue; }
    out[count] = s.slice(at, i);
    count = count + 1;
    at = i + 1;
  }
  return out;
}

string hexStr(u8[] b) { return string.fromBytes(hexOf(b)); }

/** A repository with a root commit, a merge, and its refs packed. */
Git history(T t, Procs procs, Env env, Files fs, string name) {
  string who = agentDir(env);
  string dir = "/tmp/wac-git-" + name + (who == "" ? "" : "-\{who}");
  fs.remove(dir, true).wait();
  auto made = flatten(fs.mkdir(dir, true).wait());
  t.isTrue(made.isOk(), "a working directory: \{made.isErr() ? "\{made.err()!}" : ""}");
  Git g = Git(procs, dir);
  if (made.isErr()) { return g; }

  g.run(["init", "-q", "-b", "main"]);
  fs.writeFile("\{dir}/a.txt", "one\n".toBytes()).wait();
  g.run(["add", "-A"]);
  g.run(["commit", "-qm", "root commit"]);
  g.run(["checkout", "-qb", "side"]);
  fs.writeFile("\{dir}/b.txt", "side\n".toBytes()).wait();
  g.run(["add", "-A"]);
  g.run(["commit", "-qm", "on the side"]);
  g.run(["checkout", "-q", "main"]);
  fs.writeFile("\{dir}/c.txt", "main\n".toBytes()).wait();
  g.run(["add", "-A"]);
  g.run(["commit", "-qm", "on main"]);
  Exec m = g.run(["merge", "-q", "--no-ff", "-m", "the merge", "side"]);
  t.eqI32(m.status, 0, "git merge: \{string.fromBytes(m.stderr)}");
  g.run(["gc", "-q"]);
  return g;
}

/** Reads an object by name, loose first and then the pack — the order git looks in. */
struct Reader {
  Files fs;
  string dir;
  bool havePack;
  Pack pack;

  u8[] read(this, string name) {
    u8[]? f = flatten(this.fs.readFile("\{this.dir}/.git/objects/\{name.slice(0, 2)}/" +
                                       name.slice(2, name.len())).wait()).ok();
    if (f is not null) {
      match (readLoose(f!)) {
        Loaded(kind, content): { return content; }
        default: { }
      }
    }
    if (!this.havePack) { return u8[](); }
    match (objectNamed(this.pack, decoded(name))) {
      Found(kind, data): { return data; }
      Absent(why): { return u8[](); }
    }
  }
}

Reader reader(T t, Files fs, string dir) {
  string pd = "\{dir}/.git/objects/pack";
  string[]? listing = flatten(fs.readDir(pd).wait()).ok();
  string stem = "";
  if (!(listing is null)) {
    string[] names = listing!;
    for (string name in names) {
      i32 n = name.len();
      if (n > 4 && name.slice(n - 4, n) == ".idx") { stem = name.slice(0, n - 4); }
    }
  }
  t.isTrue(stem != "", "the fixture has a pack, so `git gc` ran");
  if (stem == "") { return Reader(fs, dir, false, openPackOrDie(t, u8[](), u8[]())); }

  u8[]? p = flatten(fs.readFile("\{pd}/\{stem}.pack").wait()).ok();
  u8[]? i = flatten(fs.readFile("\{pd}/\{stem}.idx").wait()).ok();
  t.isTrue((p is not null) && (i is not null), "the pack and its index could be read");
  if ((p is null) || (i is null)) { return Reader(fs, dir, false, openPackOrDie(t, u8[](), u8[]())); }

  match (openPack(p!, i!)) {
    Ready(pack): { return Reader(fs, dir, true, pack); }
    Refused(why): {
      t.isTrue(false, "the fixture's pack did not open: \{why}");
      return Reader(fs, dir, false, openPackOrDie(t, u8[](), u8[]()));
    }
  }
}

/** A placeholder `Pack` for the paths that already failed — never read. */
Pack openPackOrDie(T t, u8[] a, u8[] b) {
  match (openPack(a, b)) {
    Ready(pack): { return pack; }
    Refused(why): { trap; }
  }
}

export string test_head_resolves_through_a_symbolic_ref_to_the_commit_rev_parse_names(Sys sys) {
  Procs procs = sys.procs();
  Env env = sys.env();
  Files fs = sys.files();
  T t = T.create();
  Git g = history(t, procs, env, fs, "hist");

  u8[]? headFile = flatten(fs.readFile("\{g.dir}/.git/HEAD").wait()).ok();
  t.isTrue((headFile is not null), "HEAD could be read");
  if ((headFile is null)) { return t.report(); }
  string branch = "";
  match (parseRef(headFile!)) {
    Symbolic(target): { branch = target; }
    default: { t.isTrue(false, "HEAD did not read as symbolic"); }
  }
  t.eqStr(branch, "refs/heads/main", "HEAD points at main");

  // `git gc` packed the refs, so the loose file is gone and `packed-refs` is the only copy — which
  // is exactly the state a reader that only looks in `refs/` gets wrong.
  u8[]? pr = flatten(fs.readFile("\{g.dir}/.git/packed-refs").wait()).ok();
  t.isTrue((pr is not null), "packed-refs could be read");
  if ((pr is null)) { return t.report(); }
  Vec<PackedRef> packed = parsePackedRefs(pr!);
  t.isTrue(packed.len() >= 2,
           "packed-refs held \{packed.len() as i64} refs, expected main and side");

  u8[]? target = packedTarget(packed, "refs/heads/main");
  t.isTrue(!(target is null), "refs/heads/main is in packed-refs");
  if (target is null) { return t.report(); }
  t.eqStr(hexStr(target!), g.text(["rev-parse", "HEAD"]), "packed-refs names HEAD's commit");

  // Every ref we found must be one git agrees exists, with the same target.
  string[] shown = splitOn(g.text(["show-ref"]), "\n");
  for (i32 i = 0; i < packed.len(); i++) {
    PackedRef r = packed.get(i);
    string want = "\{hexStr(r.target)} \{r.name}";
    bool found = false;
    for (i32 k = 0; k < shown.len(); k++) { if (shown[k] == want) { found = true; } }
    t.isTrue(found, "git agrees about \{r.name} at \{hexStr(r.target)}");
  }

  // A detached HEAD is the other shape, and it is direct rather than symbolic.
  g.run(["checkout", "-q", "--detach"]);
  u8[]? detachedFile = flatten(fs.readFile("\{g.dir}/.git/HEAD").wait()).ok();
  match (parseRef(detachedFile!)) {
    Direct(name): {
      t.eqStr(hexStr(name), g.text(["rev-parse", "HEAD"]), "a detached HEAD names its commit");
    }
    default: { t.isTrue(false, "a detached HEAD did not read as direct"); }
  }

  fs.remove(g.dir, true).wait();
  return t.report();
}

export string test_walking_parents_from_head_gives_what_rev_list_first_parent_gives(Sys sys) {
  Procs procs = sys.procs();
  Env env = sys.env();
  Files fs = sys.files();
  T t = T.create();
  Git g = history(t, procs, env, fs, "hist2");
  Reader r = reader(t, fs, g.dir);

  u8[]? pr = flatten(fs.readFile("\{g.dir}/.git/packed-refs").wait()).ok();
  u8[]? headFile = flatten(fs.readFile("\{g.dir}/.git/HEAD").wait()).ok();
  if ((pr is null) || (headFile is null)) { return t.report(); }
  string branch = "";
  match (parseRef(headFile!)) {
    Symbolic(target): { branch = target; }
    default: { }
  }
  u8[]? start = packedTarget(parsePackedRefs(pr!), branch);
  t.isTrue(!(start is null), "HEAD resolves through packed-refs");
  if (start is null) { return t.report(); }

  string[] ours = string[].filled(64, "");
  i32 count = 0;
  i32 merges = 0;
  bool root = false;
  string cur = hexStr(start!);
  while (cur != "" && count < ours.len()) {
    u8[] bytes = r.read(cur);
    t.isTrue(bytes.len() > 0, "\{cur} is in neither loose objects nor the pack");
    if (bytes.len() == 0) { break; }
    match (parseCommit(bytes)) {
      Malformed(why): {
        t.isTrue(false, "\{cur} did not parse: \{why}");
        cur = "";
      }
      Understood(commit): {
        ours[count] = cur;
        count = count + 1;
        if (commit.parents.len() > 1) { merges = merges + 1; }
        if (commit.parents.len() == 0) { root = true; cur = ""; }
        else { cur = hexStr(commit.parents.get(0)); }
      }
    }
  }

  string[] walked = string[].filled(count, "");
  for (i32 i = 0; i < count; i++) { walked[i] = ours[i]; }
  t.eqStr(joined(walked, ","),
          joined(splitOn(g.text(["rev-list", "--first-parent", "HEAD"]), "\n"), ","),
          "our walk is git's");

  // The two shapes a linear-history parser gets wrong, both required to have been crossed.
  t.isTrue(merges >= 1, "the walk crossed a merge, so the several-parents case is exercised");
  t.isTrue(root, "the walk reached a commit with no parent");

  fs.remove(g.dir, true).wait();
  return t.report();
}

export string test_a_commits_fields_are_the_ones_git_prints(Sys sys) {
  Procs procs = sys.procs();
  Env env = sys.env();
  Files fs = sys.files();
  T t = T.create();
  Git g = history(t, procs, env, fs, "hist3");
  Reader r = reader(t, fs, g.dir);
  string head = g.text(["rev-parse", "HEAD"]);

  match (parseCommit(r.read(head))) {
    Malformed(why): { t.isTrue(false, "HEAD did not parse: \{why}"); }
    Understood(c): {
      t.eqStr(c.treeHex(), g.text(["rev-parse", "HEAD^{tree}"]), "the tree");
      t.eqStr(splitOn(c.message, "\n")[0], g.text(["log", "-1", "--format=%s"]),
              "the subject");
      t.eqStr(c.author.name, "Ada L <ada@example.com>", "the author");
      t.eqStr(c.committer.name, "Ada L <ada@example.com>", "the committer");

      // **`--date=raw` prints `<unix-seconds> <zone>`**, which is the author line's own tail. Read
      // that way the zone is git's answer rather than an assumption about the machine's timezone.
      string raw = g.text(["log", "-1", "--format=%ad", "--date=raw"]);
      t.eqStr("\{c.author.when} \{c.author.zone}", raw, "the author's timestamp and zone");

      // The merge's parents, in git's order — a set comparison would pass on a reader that reversed
      // them.
      string[] parents = splitOn(g.text(["log", "-1", "--format=%P"]), " ");
      t.eqI32(c.parents.len(), parents.len(), "the number of parents");
      for (i32 i = 0; i < parents.len() && i < c.parents.len(); i++) {
        t.eqStr(hexStr(c.parents.get(i)), parents[i], "parent \{i as i64}");
      }
    }
  }

  fs.remove(g.dir, true).wait();
  return t.report();
}

bool unparsed(RefValue v) {
  match (v) {
    Unparsed(why): { return true; }
    default: { return false; }
  }
}

bool malformed(Parsed p) {
  match (p) {
    Malformed(why): { return true; }
    default: { return false; }
  }
}

export string test_a_ref_file_or_commit_that_is_not_one_is_refused_rather_than_guessed_at() {
  T t = T.create();
  t.isTrue(unparsed(parseRef("".toBytes())), "an empty ref file is refused");
  t.isTrue(unparsed(parseRef("not a hash\n".toBytes())), "a ref that is not a hash is refused");
  t.isTrue(unparsed(parseRef((repeatStr("z", 40) + "\n").toBytes())), "forty non-hex characters are refused");

  // A trailing newline is optional, and CRLF happens on repositories touched by Windows.
  t.isFalse(unparsed(parseRef(repeatStr("a", 40).toBytes())), "a ref with no trailing newline is read");
  t.isFalse(unparsed(parseRef((repeatStr("a", 40) + "\r\n").toBytes())), "a CRLF ref is read");

  // `^<sha>` belongs to the ref above it. A parser treating it as a ref invents one with an empty
  // name.
  Vec<PackedRef> parsed = parsePackedRefs(
    ("# pack-refs with: peeled fully-peeled sorted \n" +
     repeatStr("b", 40) + " refs/tags/v1\n" +
     "^" + repeatStr("c", 40) + "\n").toBytes());
  t.eqI32(parsed.len(), 1, "one ref — the peel and the comment are not refs");
  if (parsed.len() == 1) {
    t.eqStr(parsed.get(0).name, "refs/tags/v1", "the ref name");
    t.eqI32(parsed.get(0).peeled.len(), 20, "the peel is attached to the ref above it");
  }

  t.isTrue(malformed(parseCommit("tree abc\n\nmsg".toBytes())), "a short tree is refused");
  t.isTrue(malformed(parseCommit("no headers at all".toBytes())),
           "headers with no blank line are refused");
  t.isTrue(malformed(parseCommit(("tree " + repeatStr("a", 40) + "\n\nmsg").toBytes())),
           "a commit with no author is refused");
  return t.report();
}

string repeatStr(string c, i32 n) {
  string out = "";
  for (i32 i = 0; i < n; i++) { out = out + c; }
  return out;
}

export string test_a_header_continued_onto_the_next_line_does_not_eat_the_message() {
  // `gpgsig` is indented on every line after the first, and its armour contains a blank line — which
  // is what makes this the case a naive parser loses the message on.
  T t = T.create();
  string commit = "tree " + repeatStr("a", 40) + "\n" +
    "parent " + repeatStr("b", 40) + "\n" +
    "author Ada L <ada@example.com> 1700000000 +0000\n" +
    "committer Ada L <ada@example.com> 1700000000 +0000\n" +
    "gpgsig -----BEGIN PGP SIGNATURE-----\n" +
    " \n" +
    " iQEzBAABCgAdFiEE\n" +
    " -----END PGP SIGNATURE-----\n" +
    "\n" +
    "the real message\n";
  match (parseCommit(commit.toBytes())) {
    Malformed(why): { t.isTrue(false, "a signed commit did not parse: \{why}"); }
    Understood(c): {
      t.eqStr(c.message, "the real message\n", "the message survived the armour's blank line");
      t.eqI32(c.parents.len(), 1, "the parent survived too");
    }
  }
  return t.report();
}
