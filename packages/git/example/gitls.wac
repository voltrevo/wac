// `gitls <url>` — the refs a remote advertises, over our own TLS, through whatever proxy is set.
//
// `design/system/0005` step 6's first half. The transport is `../src/transport.wac`; what is here is only
// the part that is about git: ask for `info/refs`, parse the advertisement, print it.
//
// The output format is `git ls-remote`'s — `<sha>\t<ref>` — which is not decoration. It makes the oracle a
// diff rather than an interpretation, and `test/wac/lsremote_test.wac` diffs it against the real thing.

import { Cli, Core } from "std/platform.wac";
import { itoa } from "../../fmt/src/itoa.wac";
import { encode } from "../../codec/src/hex.wac";
import { Ad, AdRef, Advertised, parseAdvertisement } from "../src/fetch.wac";
import { Store } from "../../tls/src/roots.wac";
import { Answer, Remote, parseRemote, request, systemStore } from "../src/transport.wac";

export i32 main(Core core, Cli cli) {
  i32 n = cli.argCount().wait();
  if (n < 1) {
    core.warn("usage: gitls <https-url>");
    return 2;
  }
  string url = string.fromBytes(cli.arg(0).wait());
  Remote r = parseRemote(url);
  if (!r.ok) {
    core.warn("gitls: " + url + " is not an https URL with a path");
    return 2;
  }

  Store store = systemStore(cli);
  if (store.offsets.len() == 0) {
    core.warn("gitls: cannot read a trust store, so nothing can be verified");
    return 1;
  }
  if (store.refused > 0) {
    // Said rather than swallowed: a root that did not parse cannot verify a chain, and the chain it
    // would have verified fails later blaming the server.
    core.warn("gitls: " + itoa(store.refused) + " certificate(s) in the bundle did not decode");
  }

  string target = r.path + "/info/refs?service=git-upload-pack";
  Answer a = request(core, cli, store, r.host, target, u8[0](), "");
  if (!a.ok) {
    core.warn("gitls: " + a.error);
    return 1;
  }
  if (a.status != 200) {
    // A 401 is a private repository and a 404 is often the same thing, so the number is worth saying
    // rather than calling it a protocol error.
    core.warn("gitls: " + r.host + " answered " + itoa(a.status) + " for " + target);
    return 1;
  }
  match (parseAdvertisement(a.body)) {
    case Garbled(why): {
      core.warn("gitls: the advertisement did not parse: " + why);
      return 1;
    }
    case Said(ad): {
      for (i32 i = 0; i < ad.refs.len(); i++) {
        AdRef one = ad.refs.get(i);
        core.log(string.fromBytes(encode(one.target)) + "\t" + one.name);
      }
      return 0;
    }
  }
}
