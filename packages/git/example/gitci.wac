// `git commit -a`, in wac.
//
//     gitci <repo-dir> <message>
//
// Writes every file under the repository as a blob, every directory as a tree, a commit whose parent is
// whatever `HEAD`'s branch names now, and moves that branch to it. Nothing here is TypeScript:
// `packages/git` over `packages/fs`, the same as `gitco`.
//
// **The oracle is `git fsck --strict` and `git log`**, which is design/system/0005 step 5's criterion —
// a commit that git audits without complaint and shows with its parent.
//
// One limitation, said here because it is visible in the result: every blob is recorded as `100644`,
// because `Stat` carries no mode and an executable cannot be told from a plain file
// (issues/system/0132). Committing a tree that contained an executable therefore records a mode change.

import { Cli, Core, FileResult } from "../../platform/src/platform.wac";
import { Fs } from "../../fs/src/fs.wac";
import { Setting, configOf } from "../src/config.wac";
import { configChain } from "../src/configfiles.wac";
import { Who } from "../src/commit.wac";
import { encode } from "../../codec/src/hex.wac";
import { commitTree, headRef, openRepo, writeWorkTree } from "../src/repo.wac";
import { IndexEntry } from "../src/index.wac";
import { Vec } from "../../std/src/vec.wac";

export i32 main(Core core, Cli cli) {
  i32 n = cli.argCount().wait();
  if (n < 2) {
    core.warn("usage: gitci <repo-dir> <message>");
    return 2;
  }
  string root = string.fromBytes(cli.arg(0).wait());
  string message = string.fromBytes(cli.arg(1).wait());
  Fs fs = Fs.onHost(cli, 0);

  match (openRepo(fs, root + "/.git", root)) {
    case NoRepo(why): {
      core.warn("gitci: " + why);
      return 1;
    }
    case Opened(repo): {
      string branch = headRef(repo);
      if (branch == "") {
        // A detached HEAD has no branch to move, and moving `HEAD` itself is a different operation.
        core.warn("gitci: HEAD is detached; nothing to move");
        return 1;
      }
      Vec<IndexEntry> index = Vec.create();
      match (writeWorkTree(repo, root, "", index)) {
        case NotStored(why): {
          core.warn("gitci: " + why);
          return 1;
        }
        case Named(tree): {
          // **Who, from the config files git reads, and when, from the clock — the way git decides both.**
          //
          // This used to be a fixed identity and a fixed timestamp, and the comment here said the program
          // had "neither a clock nor a configured user". Half of that was wrong: `Core.nowMillis` has
          // always been there. The real reason was determinism — a clock makes two runs of one tree produce
          // different commits — and git has an answer for that which is not "refuse to read a clock":
          // `GIT_AUTHOR_DATE`. So the clock is used unless that names a time, which is exactly the lever
          // this repository's own fixtures already pull on real git.
          //
          // An unset identity is a **refusal**, as it is in git, rather than a default nobody chose: a
          // commit is signed, and inventing a name to put on it is the one thing a tool must not do.
          // **Every file git would read, not just this repository's.** An identity is a property of the
          // person rather than the repository, so it is normally in `~/.gitconfig`; reading only
          // `.git/config` made this refuse to commit for very nearly everyone who has one configured.
          // `configChain` returns them lowest-precedence first and `configOf` takes the last, which is
          // git's answer per key — the local file over the dotfile over the XDG file over the system one.
          Vec<Setting> settings = configChain(cli, fs, root + "/.git");
          string who = configOf(settings, "user.name");
          string mail = configOf(settings, "user.email");
          if (who == "" || mail == "") {
            core.warn("gitci: user.name and user.email are set in no config file this reads — not"
              + " .git/config, ~/.gitconfig, the XDG file or /etc/gitconfig — and this does not invent"
              + " an author");
            return 1;
          }
          // `i64` all the way: `Who.when` is one, and a timestamp narrowed to `i32` stops working
          // in 2038 — which is exactly the kind of quiet cast this package has been bitten by once already.
          i64 when = core.nowMillis().wait() / 1000;
          string zone = "+0000";
          u8[]? fixed = cli.env("GIT_AUTHOR_DATE").wait();
          if (!(fixed is null)) {
            // `<seconds> <zone>`, which is the shape git accepts and the shape its own tests use.
            string text = string.fromBytes(fixed!);
            i32 sp = text.indexOf(" ");
            string secs = sp < 0 ? text : text.slice(0, sp);
            if (sp >= 0) { zone = text.slice(sp + 1, text.len()); }
            i64 parsed = 0;
            bool ok = secs.len() > 0;
            u8[] digits = secs.toBytes();
            for (i32 i = 0; i < digits.len(); i++) {
              if (digits[i] < '0' || digits[i] > '9') { ok = false; break; }
              parsed = parsed * 10 + ((digits[i] - '0') as i64);
            }
            if (ok) { when = parsed; }
          }
          Who me = Who(who + " <" + mail + ">", when, zone);
          match (commitTree(repo, tree, branch, me, message, index)) {
            case NotStored(why): {
              core.warn("gitci: " + why);
              return 1;
            }
            case Named(commit): {
              core.log(string.fromBytes(hexBytes(commit)));
              return 0;
            }
          }
        }
      }
    }
  }
}

/** The commit's name, to print. */
u8[] hexBytes(u8[] name) { return encode(name); }
