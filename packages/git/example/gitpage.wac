// A page that opens a real packfile — the object database, with no network anywhere near it.
//
//   wac run --allow-read --allow-write --allow-run packages/web/tools/build.wac \
//       packages/git/example/gitpage.wac .cache/gitpage --page ./packages/web
//
// Drop `.git/objects/pack/pack-*.pack` from any repository on your machine. Nothing is fetched and
// nothing is uploaded: the bytes go from the file input into wasm and the answers come back out.
//
// ## Why a packfile is the right thing for a page to be given
//
// **A page has no TCP.** `connect` and `listen` are refused by the browser host, which is a finding
// rather than a gap — see `packages/platform`'s README. So a clone cannot happen here, and a demo
// that pretended otherwise would be lying about the one thing this system is careful about.
//
// What is left is the half that needs no socket at all, and it happens to be the harder half. A
// packfile is a compressed object database with its index thrown away: object headers with a varint
// size, zlib streams, and deltas that refer to other objects either by offset or by name, up to 64
// deep. `indexPack` rebuilds the index the `.idx` file would have held — every name, offset and
// CRC — by walking the pack and resolving each delta against what it has already seen. Every byte
// of that is `packages/git`, compiled to wasm, unchanged from what runs on a command line.
//
// **The demonstration is that it is your pack.** A fixture we chose proves that we can read a file
// we shipped. `git verify-pack -v` on the same file, on your machine, prints the same object count
// and the same names — which is a check anyone can run and nobody has to trust us for.

import { ElementEvent, Node, Page, Picked, State, Ui, html.a, html.b, html.button, html.code, html.dd, html.div, html.dl, html.dt, html.footer, html.h1, html.input, html.p, html.pre, html.span, html.style } from "../../web";
import { Vec } from "core";
import { encode } from "../../codec/src/hex.wac";
import { PackIndex } from "../src/idx.wac";
import { Got, Indexed, Pack, indexPack, objectNamed, openIndexed } from "../src/pack.wac";
import { Commit, Parsed, parseCommit } from "../src/commit.wac";
import { Entry, Tree, parseTree } from "../src/tree.wac";

/** Where this page came from. A demonstration nobody can rebuild is a screenshot. */
static string SOURCE =
  "https://github.com/voltrevo/wac/blob/master/packages/git/example/gitpage.wac";

static string STYLE =
  ":root { --ink: #f7f9f9; --slab: #fff; --line: #dbe4e3; --text: #0b1a1d;" +
  "        --dim: #5b7073; --key: #0e8c78; }" +
  "@media (prefers-color-scheme: dark) {" +
  "  :root { --ink: #0b1416; --slab: #101f23; --line: #1e363c; --text: #dce8e7;" +
  "          --dim: #8ba3a4; --key: #46d9c0; } }" +
  "body { background: var(--ink); color: var(--text); }" +
  "#tool { max-width: 52rem; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }" +
  "h1 { font-size: 1.35rem; margin: 0 0 .3rem; letter-spacing: -0.02em; }" +
  "p.sub { margin: 0 0 1.4rem; color: var(--dim); font-size: .95rem; max-width: 40rem; }" +
  "code { font-family: ui-monospace, monospace; font-size: .9em; }" +
  ".row { display: flex; gap: .7rem; align-items: center; flex-wrap: wrap; margin: .9rem 0; }" +
  "input[type=file] { font: inherit; font-size: .85rem; color: var(--dim); }" +
  "dl { display: grid; grid-template-columns: max-content 1fr; gap: .55rem 1.1rem;" +
  "     margin: 1.4rem 0 0; align-items: baseline; }" +
  "dt { color: var(--dim); font-size: .78rem; letter-spacing: .09em; text-transform: uppercase; }" +
  "dd { margin: 0; font-family: ui-monospace, monospace; font-variant-numeric: tabular-nums;" +
  "     word-break: break-all; }" +
  ".dim { color: var(--dim); }" +
  "pre { background: var(--slab); border: 1px solid var(--line); border-radius: 6px;" +
  "      padding: .8rem; overflow-x: auto; font: 12.5px/1.6 ui-monospace, monospace;" +
  "      margin: .6rem 0 0; }" +
  "footer { margin-top: 2.2rem; font-size: .85rem; color: var(--dim); }" +
  "footer a { color: var(--key); }";

/**
 * The largest pack this page will take on, in bytes.
 *
 * **This bounds memory, not time, and the difference is measured rather than assumed.** Reading six
 * of this repository's own packs: 8.31 MB took 1.9 s, and 1.01 MB took 12.7 s — 224 ms/MB against
 * 12,660. Size is not what costs; delta depth is. A pack written by a clone is mostly whole objects,
 * and one written by `git gc` is chains up to 64 deep, each link inflated and applied in turn.
 *
 * So this number is honest about what it does: it stops the page holding a hundred megabytes, and it
 * promises nothing about the wait. The page says "reading…" before it starts for the same reason.
 */
static i32 LIMIT = 16777216;

/** How many commits to offer in the list. A repository's whole history would be a scrolling wall. */
static i32 SHOWN = 200;

/** Twenty raw bytes as forty hex characters. */
string hexOf(u8[] name) { return string.fromBytes(encode(name)); }

// **Nothing here escapes anything, because nothing has to.** Every string reaches the page as a text
// node (`packages/web`), so a commit message containing `<script>` lands as those characters.

/** A pack read and indexed: what the page shows about it, and the commits it offers. */
struct Opened {
  PackIndex idx;
  u8[] bytes;
  /** Newest-first as the pack happened to hold them, at most `SHOWN`. */
  Vec<string> commits;
  string name;
  string kinds;
  i32 ms;
}

/** What the page says while nothing has been read. */
Opened none() { return Opened(PackIndex(0, u8[](), i64[](), u32[]()), u8[](), Vec.create(), "", "", 0); }

/** Each pack dropped or picked, for as long as the page lives. */
async void packs(Page page, State<Opened> opened, State<i32> at, State<string> note, State<string?> blank) {
  while (true) {
    Picked f = await page.nextFile();
    if (!f.ok) {
      note.set("could not read it: \{f.error}");
      continue;
    }
    if (f.bytes.len() > LIMIT) {
      note.set("\{f.name} is \{f.bytes.len()} bytes; this page stops at \{LIMIT} so it never looks hung");
      continue;
    }
    // Said before the work, and shown: rebuilding an index means inflating every object and walking
    // every delta chain, which took twelve seconds for one megabyte of this repository's own history.
    // Built `--in-page`, the work runs on the page's own thread, so the note is only on screen if the
    // browser paints before it starts — which is what waiting for `painted` is.
    note.set("reading \{f.name}…");
    await page.painted();
    f64 began = page.now();
    match (indexPack(f.bytes)) {
      Unindexable(why): {
        // Said, not swallowed. A file that is not a pack is the commonest thing to drop here, and
        // "nothing happened" would leave the reader with no idea which of us was wrong.
        note.set("not a packfile this can read: \{why}");
        blank.set("");
      }
      Thin(bases): {
        // A thin pack is a real thing to be handed — it is what a server sends an incremental fetch —
        // and it cannot be read alone, because its deltas point at objects that are not in it.
        // Naming that is more useful than refusing.
        note.set("\{f.name} is a *thin* pack: \{bases.len()}"
          + " of its deltas name a base that is not inside it, so it needs the repository it came"
          + " from. `git index-pack --fix-thin` completes one.");
        blank.set("");
      }
      Built(built): {
        Opened o = Opened(built, f.bytes, Vec.create(), "\{f.name} — \{f.bytes.len()} bytes", "", 0);
        o.kinds = commitsIn(o);
        o.ms = (page.now() - began) as~ i32;
        note.set("");
        blank.set(null);
        at.set(0);
        opened.set(o);
      }
    }
  }
}

Node Packs(Ui ui, Page page) {
  auto opened = ui.state(none());
  auto at = ui.state(0);
  auto note = ui.state("or drop one anywhere on this page");
  // What the detail pane says instead of a commit: something until a pack is read, nothing after a
  // file that was not one, and null when it shows the commit at `at`.
  auto blank = ui.state<string?>("Drop a pack to begin.");
  ui.effect("", () => {
    packs(page, opened, at, note, blank);
    return () => { };
  });
  Opened o = opened.get();
  i32 n = o.commits.len();
  // Reading a commit means inflating it and walking its delta chain, so only when the pack or the
  // cursor moved.
  string shown = ui.memo<string>("\{opened.version} \{at.get()}", () => n == 0 ? "" : detail(o, o.commits.get(at.get())));
  string where = o.name == "" ? "no commits loaded"
    : n == 0 ? "no commits in this pack"
    : "commit \{at.get() + 1} of \{n}" + (n == SHOWN ? " shown" : "");
  // Legal, and worth saying rather than leaving blank: a pack is a bag of objects, and one sent for a
  // single blob has no commit in it at all.
  string none = "This pack holds no commits — which is legal: a pack is a bag of objects, and one sent "
    + "for a single blob has none.";
  string pane = blank.get() ?? (n == 0 ? none : shown);
  return <div id="tool">
    <style>{STYLE}</style>
    <h1>a packfile, opened in a tab</h1>
    <p class="sub">Drop <code>.git/objects/pack/pack-*.pack</code> from any repository on your machine.
      There is no network here — a page cannot open a socket, and this does not need one. The pack
      arrives with its index thrown away, and <code>packages/git</code> rebuilds it: every object
      header, every zlib stream, and every delta resolved against what came before it. Check the
      answer with <code>git verify-pack -v</code> on the same file.</p>
    <div class="row">
      <input type="file" id="f" accept=".pack"/>
      <span id="note" class="dim">{note.get()}</span>
    </div>
    <dl>
      <dt>pack</dt><dd><span id="packname" class="dim">{o.name == "" ? "nothing yet" : o.name}</span></dd>
      <dt>objects</dt><dd><b id="count">{o.idx.count}</b> <span id="kinds" class="dim">{o.kinds}</span></dd>
      <dt>took</dt><dd class="dim"><span id="ms">{o.ms}</span> ms to rebuild the index — delta depth
        costs far more than size does</dd>
    </dl>
    <div class="row">
      <button id="prev" onclick={(ElementEvent e) => {
        if (at.get() + 1 < n) { at.set(at.get() + 1); }
        blank.set(null);
      }}>‹ older</button>
      <button id="next" onclick={(ElementEvent e) => {
        if (at.get() > 0) { at.set(at.get() - 1); }
        blank.set(null);
      }}>newer ›</button>
      <span id="where" class="dim">{where}</span>
    </div>
    <pre id="detail">{pane}</pre>
    <footer>The object database, the delta resolver and this page are wac. <a href={SOURCE}>source</a>.</footer>
  </div>;
}

export async i32 main(Page page) {
  page.title("wac: a packfile, opened in a tab");
  page.mount((Ui ui) => Packs(ui, page));
  return 0;
}

/**
 * Walk every object once: collect the commits into `o`, and answer the count of each kind.
 *
 * One pass rather than two, because reading an object out of a pack means inflating it and possibly
 * walking a delta chain — the expensive part — and a second pass to count what the first already saw
 * would double the wait for nothing.
 */
string commitsIn(Opened o) {
  Pack p = openIndexed(o.bytes, o.idx);
  i32 commits = 0;
  i32 trees = 0;
  i32 blobs = 0;
  i32 tags = 0;
  for (i32 i = 0; i < o.idx.count; i++) {
    u8[] name = u8[].filled(20, 0);
    for (i32 k = 0; k < 20; k++) { name[k] = o.idx.names[i * 20 + k]; }
    match (objectNamed(p, name)) {
      Absent(why): { }
      Found(kind, data): {
        if (kind == 1) {
          commits = commits + 1;
          if (o.commits.len() < SHOWN) { o.commits.push(o.idx.hexAt(i)); }
        } else if (kind == 2) { trees = trees + 1; }
        else if (kind == 3) { blobs = blobs + 1; }
        else if (kind == 4) { tags = tags + 1; }
      }
    }
  }
  return "— \{commits} commits, \{trees} trees, \{blobs} blobs, \{tags} tags";
}

/** One commit, parsed, with the tree it names listed underneath it. */
string detail(Opened o, string hex) {
  Pack p = openIndexed(o.bytes, o.idx);
  i32 at = -1;
  for (i32 i = 0; i < o.idx.count; i++) {
    if (o.idx.hexAt(i) == hex) { at = i; break; }
  }
  if (at < 0) { return "no object named \{hex} in this pack"; }
  u8[] name = u8[].filled(20, 0);
  for (i32 k = 0; k < 20; k++) { name[k] = o.idx.names[at * 20 + k]; }
  match (objectNamed(p, name)) {
    Absent(why): { return "could not read it: \{why}"; }
    Found(kind, data): {
      match (parseCommit(data)) {
        Malformed(why): { return "not a commit: \{why}"; }
        Understood(c): {
          // Names are twenty raw bytes here, not text — `hexOf` is where they become readable, and
          // doing it at the edge rather than in the parser is why `objectNamed` can compare them
          // without allocating.
          string out = "commit  \{hex}\n";
          out = out + "tree    \{hexOf(c.tree)}\n";
          for (i32 i = 0; i < c.parents.len(); i++) {
            out = out + "parent  \{hexOf(c.parents.get(i))}\n";
          }
          out = out + "author  \{c.author.name}\n";
          out = out + "\n\{c.message}\n";
          out = out + "\n--- the tree it names ---\n\{treeListing(p, o.idx, hexOf(c.tree))}";
          return out;
        }
      }
    }
  }
}

/**
 * The entries of a tree, as `git ls-tree` prints them.
 *
 * A tree in this pack may name one that is not — a pack does not have to be complete — so an
 * absent tree is reported rather than shown as empty. The difference matters here: empty is a
 * legal tree and absent is a pack that needs its repository.
 */
string treeListing(Pack p, PackIndex idx, string hex) {
  i32 at = -1;
  for (i32 i = 0; i < idx.count; i++) {
    if (idx.hexAt(i) == hex) { at = i; break; }
  }
  if (at < 0) { return "  (not in this pack — a pack need not be complete)\n"; }
  u8[] name = u8[].filled(20, 0);
  for (i32 k = 0; k < 20; k++) { name[k] = idx.names[at * 20 + k]; }
  match (objectNamed(p, name)) {
    Absent(why): { return "  (unreadable: \{why})\n"; }
    Found(kind, data): {
      match (parseTree(data)) {
        Bad(why): { return "  (not a tree: \{why})\n"; }
        Ok(entries): {
          string out = "";
          for (i32 i = 0; i < entries.len(); i++) {
            Entry e = entries.get(i);
            out = out + "  \{e.mode} \{hexOf(e.hash)}  \{e.name}\n";
          }
          return out == "" ? "  (an empty tree)\n" : out;
        }
      }
    }
  }
}
