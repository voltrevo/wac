/** Division by zero traps, and the trap is the branch. */
export i32 trap_divide_by_zero() { opDiv("1".toBytes(), "0".toBytes()); return 0; }
export i32 trap_divide_zero_by_zero() { opDiv("0".toBytes(), "0".toBytes()); return 0; }
export i32 trap_remainder_by_zero_small() { opRemSmall("1".toBytes(), 0); return 0; }

/** The probe's own reject paths, which trap by design when handed text that is not a number. */
export i32 trap_add_malformed_empty() { opAdd("".toBytes(), "1".toBytes()); return 0; }
export i32 trap_add_malformed_decimal() { opAdd("1.5".toBytes(), "1".toBytes()); return 0; }
export i32 trap_add_malformed_sign() { opAdd("-".toBytes(), "1".toBytes()); return 0; }
export i32 trap_from_hex_malformed() { fromHex("zz".toBytes()); return 0; }

/** The nine tests that expect a trap, for `covdump` to call one at a time with the trap caught. */
export void trapCase(i32 i) {
  if (i == 0) { arith__traps_general_division_of_zero_by_zero(); return; }
  if (i == 1) { arith__traps_general_division_by_zero(); return; }
  if (i == 2) { arith__traps_general_division_of_a_negative_by_zero(); return; }
  if (i == 3) { arith__traps_general_division_of_a_large_value_by_zero(); return; }
  if (i == 4) { arith__traps_small_division_of_zero_by_zero(); return; }
  if (i == 5) { arith__traps_small_division_by_zero(); return; }
  if (i == 6) { arith__traps_small_remainder_of_zero_by_zero(); return; }
  if (i == 7) { arith__traps_small_remainder_by_zero(); return; }
  if (i == 8) { arith__traps_shifting_right_by_the_most_negative_count(); return; }
}
