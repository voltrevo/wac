// wac's u64 arithmetic, judged against `BigInt`.
//
// Every limb operation in this package leans on u64 behaving as an unsigned 64-bit integer: division
// and remainder above 2^63 must not be signed, `>> 32` must not sign-extend, and `as@ u32` must
// truncate. None of that is this package's code, so a bug there would show up as a wrong quotient
// somewhere deep in `divmod`.
//
// This file exists because that is exactly what happened: a division came out wrong, and ruling the
// compiler out first — in one run — is what made it clear the bug was in `divmod`'s own quotient
// estimate. Keeping the check means the next such question is already answered.
//
// ## What the move changed
//
// The values no longer travel through a signed `i64` and back, and `test/u64_probe.wac` is gone with
// that. It existed for one reason — a u64 could not cross bindgen as itself, so the host-side version
// sent `BigInt.asIntN(64, v)` and undid it on the way out, and the probe held the casts that made
// that work. Here the operators are written where they are used, which is what the file was standing
// in for. Its only caller was the test being replaced; `test/cov_exercise.wac` drives
// `test/probe.wac`, which is a different file and stays.
//
// Only the *transport to the oracle* is a bit pattern now: sixteen hex digits, because the whole
// question is about bit patterns and a decimal spelling of one is a second thing to get wrong.
//
// **`BIGINT` below is the whole oracle, and it only answers.** It was a TypeScript file shared with
// the other two tests, which took this file's answers and did the comparing; since 2026-10-27 the
// script says what `BigInt` makes of each question and `agree` compares in wac
// (`packages/wactest/src/inline.wac`).
//
// Host-side until 2026-08-17. `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { Asked, agree } from "../../../wactest/src/inline.wac";
import { Sys } from "std";

/**
 * What `BigInt` says, one line for each question `<op> <aHex16> <bHex16>`: the result reduced to 64
 * unsigned bits, as sixteen hex digits. `ge` is 1 or 0; `trunc` ignores `b`; `mulwide` multiplies the
 * low 32 bits of each.
 */
static string BIGINT =
  "const L = (await new Response(Deno.stdin.readable).text()).split(String.fromCharCode(10)).filter((l) => l.length > 0);\n" +
  "const W = 0xffffffffn;\n" +
  "const O = { div: (a, b) => a / b, rem: (a, b) => a % b, shr: (a, b) => a >> b, add: (a, b) => a + b,\n" +
  "  sub: (a, b) => a - b, mul: (a, b) => a * b, ge: (a, b) => a >= b ? 1n : 0n, trunc: (a) => a & W,\n" +
  "  mulwide: (a, b) => (a & W) * (b & W) };\n" +
  "const say = ([op, a, b]) => BigInt.asUintN(64, O[op](BigInt('0x' + a), BigInt('0x' + b))).toString(16).padStart(16, '0');\n" +
  "console.log(L.map((l) => say(l.split(' '))).concat(['DONE ' + L.length]).join(String.fromCharCode(10)));\n";

/** Sixteen hex digits, big-endian — the form the oracle reads. */
string hex16(u64 v) {
  string digits = "0123456789abcdef";
  string out = "";
  u64 x = v;
  for (i32 i = 0; i < 16; i++) {
    i32 nib = (x % 16) as~ i32;
    out = digits.slice(nib, nib + 1) + out;
    x = x / 16;
  }
  return out;
}

/**
 * The values, chosen for where a signed opcode would show.
 *
 * Either side of 2^63 is the whole point: `0x8000000000000000` is the smallest number a signed
 * division would get wrong, and `0xFFFFFFFFFFFFFFFF` is the one a sign-extending shift would.
 */
u64[] values() {
  return [
    0, 1, 2, 0xFFFFFFFF, 0x100000000,
    0x7FFFFFFFFFFFFFFF,   // (1 << 63) - 1
    0x8000000000000000,   // 1 << 63
    0x8000000000000001,
    0xFFFFFFFFFFFFFFFE,
    0xFFFFFFFFFFFFFFFF,
    0xFFFFFFFF00000000,
    0xFFFFFFFFFFFFFFFE
  ] as u64[];
}

void row(Asked asked, string op, u64 a, u64 b, u64 got) {
  asked.add("\{op} \{hex16(a)} \{hex16(b)}", hex16(got));
}

export async string test_u64_division_and_remainder_are_unsigned(Sys sys) {
  T t = T.create();
  u64[] vs = values();
  Asked asked = Asked.create();
  for (i32 i = 0; i < vs.len(); i++) {
    for (i32 k = 0; k < vs.len(); k++) {
      if (vs[k] == 0) { continue; }
      row(asked, "div", vs[i], vs[k], vs[i] / vs[k]);
      row(asked, "rem", vs[i], vs[k], vs[i] % vs[k]);
    }
  }
  t.isTrue(asked.count() > 200, "the sweep is every ordered pair — \{asked.count()} rows");
  await agree(t, sys.procs(), BIGINT, asked, "unsigned division");
  return t.report();
}

export async string test_u64_add_sub_and_mul_wrap_at_two_to_the_sixty_four(Sys sys) {
  T t = T.create();
  u64[] vs = values();
  Asked asked = Asked.create();
  for (i32 i = 0; i < vs.len(); i++) {
    for (i32 k = 0; k < vs.len(); k++) {
      row(asked, "add", vs[i], vs[k], vs[i] + vs[k]);
      row(asked, "sub", vs[i], vs[k], vs[i] - vs[k]);
      row(asked, "mul", vs[i], vs[k], vs[i] * vs[k]);
    }
  }
  await agree(t, sys.procs(), BIGINT, asked, "wrapping arithmetic");
  return t.report();
}

export async string test_u64_shift_right_does_not_sign_extend(Sys sys) {
  T t = T.create();
  u64[] vs = values();
  i32[] shifts = [0, 1, 31, 32, 33, 63];
  Asked asked = Asked.create();
  for (i32 i = 0; i < vs.len(); i++) {
    for (i32 shift in shifts) {
      row(asked, "shr", vs[i], (shift as i64) as@ u64, vs[i] >> ((shift as i64) as@ u64));
    }
  }
  await agree(t, sys.procs(), BIGINT, asked, "shift right");
  return t.report();
}

export async string test_u64_comparison_is_unsigned(Sys sys) {
  T t = T.create();
  u64[] vs = values();
  Asked asked = Asked.create();
  for (i32 i = 0; i < vs.len(); i++) {
    for (i32 k = 0; k < vs.len(); k++) {
      row(asked, "ge", vs[i], vs[k], vs[i] >= vs[k] ? 1 : 0);
    }
  }
  await agree(t, sys.procs(), BIGINT, asked, "unsigned comparison");
  return t.report();
}

export async string test_u64_truncation_keeps_the_low_thirty_two_bits(Sys sys) {
  T t = T.create();
  u64[] vs = values();
  Asked asked = Asked.create();
  for (i32 i = 0; i < vs.len(); i++) {
    u32 low = vs[i] as@ u32;
    row(asked, "trunc", vs[i], 0, low as u64);
  }
  await agree(t, sys.procs(), BIGINT, asked, "truncation to u32");
  return t.report();
}

/**
 * `u32 * u32` widens without overflow.
 *
 * The shape the multiply-subtract inner loop uses. If this narrowed, every product of two large limbs
 * would be wrong.
 */
export async string test_u64_a_u32_product_widens(Sys sys) {
  T t = T.create();
  u32[] xs = [0, 1, 0xFFFFFFFF, 0xFFFFFFFE, 0x7FFFFFFF, 0xFFFF, 0x10000];
  u32[] ys = [0, 1, 0xFFFFFFFF, 0xFFFFFFFE, 0x7FFFFFFF, 0xFFFF];
  Asked asked = Asked.create();
  for (i32 i = 0; i < xs.len(); i++) {
    for (i32 k = 0; k < ys.len(); k++) {
      row(asked, "mulwide", xs[i] as u64, ys[k] as u64, (xs[i] as u64) * (ys[k] as u64));
    }
  }
  await agree(t, sys.procs(), BIGINT, asked, "widening multiply");
  return t.report();
}
