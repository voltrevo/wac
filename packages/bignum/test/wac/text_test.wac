// Decimal and hex text for `Big`, judged against `BigInt`.
//
// This file comes first in the package because every other test in it exchanges decimal strings with
// wac. If `parseDecimal` or `formatDecimal` were wrong, the arithmetic tests would fail too and point
// at the arithmetic. So the conversions are pinned here, on their own, before anything is built on
// them.
//
// ## The corpus is generated as hex, and that needed an anchor
//
// A random 600-bit number cannot be written as a wac literal, so the generator builds one as **hex
// text** — which is pure string work — and `fromHex` turns it into the decimal everything else uses.
// That would make the corpus whatever `fromHex` produced, and every later check would agree with it.
//
// So each generated value is sent to the oracle as `text fromhex` first: the hex string and the
// decimal we read it as, checked against `BigInt`. One line, and it is what lets the rest of the
// corpus be trusted. The host-side version had no equivalent because `BigInt` built its corpus
// directly.
//
// Host-side until 2026-08-17. `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { Lines, checkDeno } from "../../../wactest/src/oracle.wac";
import { Core, Cli } from "../../../platform/src/platform.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { roundTrip, acceptsDecimal, acceptsHex, toHex, fromHex, fromI64, fromU64, opBitLen,
         opIsZero } from "../probe.wac";

const string ORACLE = "packages/bignum/test/oracle.ts";

string text(u8[] b) { return string.fromBytes(b); }
u8[] b(string s) { return s.toBytes(); }

/** A deterministic generator, so a failure is reproducible from the seed alone. */
struct Rng {
  i32 x;

  u32 next(this) {
    this.x = this.x ^ (this.x << 13);
    this.x = this.x ^ ((this.x >> 17) & 0x7FFF);
    this.x = this.x ^ (this.x << 5);
    return this.x as@ u32;
  }

  i32 bit(this) { return (this.next() & 1) as@ i32; }
}

/**
 * A random magnitude of exactly `bits` bits, as hex text — so the top bit is always set.
 *
 * Hex rather than decimal because this is string work either way and hex is the one a bit count maps
 * onto directly. The value becomes a decimal through `fromHex`, which the oracle checks.
 */
string randomHex(Rng rng, i32 bits) {
  if (bits == 0) { return "0"; }
  // Build the bits most-significant first, then pack four at a time.
  i32[] b = i32[bits]();
  b[0] = 1;
  for (i32 i = 1; i < bits; i++) { b[i] = rng.bit(); }
  string digits = "0123456789abcdef";
  string out = "";
  i32 pad = (4 - (bits % 4)) % 4;
  i32 acc = 0;
  i32 have = 0;
  for (i32 i = 0; i < pad + bits; i++) {
    acc = acc * 2 + (i < pad ? 0 : b[i - pad]);
    have = have + 1;
    if (have == 4) {
      out = out + digits.slice(acc, acc + 1);
      acc = 0;
      have = 0;
    }
  }
  return out;
}

/** The decimal a hex string names, with the oracle asked to confirm the two spell one number. */
string decimalOf(Lines lines, string hexText) {
  string d = text(fromHex(b(hexText)));
  lines.add("text fromhex " + hexText + " " + d);
  return d;
}

export string test_decimal_small_values_round_trip(Core core, Cli cli) {
  T t = T.create();
  Lines lines = Lines.create();
  for (i32 i = -1000; i <= 1000; i++) {
    string v = itoa(i);
    lines.add("text roundtrip " + v + " " + text(roundTrip(b(v))));
  }
  checkDeno(t, cli, ORACLE, lines, "small values");
  return t.report();
}

/**
 * Limb boundaries round-trip.
 *
 * Around every power of two that lands on or near a limb edge, and around the 10^9 chunk base the
 * conversions use, which is the other place a boundary can hide.
 */
export string test_decimal_limb_boundaries_round_trip(Core core, Cli cli) {
  T t = T.create();
  Lines lines = Lines.create();
  i32[] powers = i32[](31, 32, 33, 63, 64, 65, 95, 96, 97, 127, 128, 129, 191, 192, 255, 256);
  string[] anchors = string[powers.len() + 4](fill: "");
  for (i32 i = 0; i < powers.len(); i++) {
    // 2^p as hex is a 1 followed by p/4 zeros, adjusted for the remainder.
    anchors[i] = decimalOf(lines, powerOfTwoHex(powers[i]));
  }
  // 10^9, 10^18, 10^27, 10^36 — the chunk base and its powers.
  string ten9 = "1000000000";
  string acc = ten9;
  for (i32 p = 0; p < 4; p++) {
    anchors[powers.len() + p] = acc;
    acc = mulDecimalByTen9(acc);
  }
  for (i32 a = 0; a < anchors.len(); a++) {
    for (i32 d = -2; d <= 2; d++) {
      string v = addSmall(anchors[a], d);
      lines.add("text roundtrip " + v + " " + text(roundTrip(b(v))));
      lines.add("text roundtrip -" + v + " " + text(roundTrip(b("-" + v))));
    }
  }
  checkDeno(t, cli, ORACLE, lines, "limb boundaries");
  return t.report();
}

/** `2^p` as hex text, built without any arithmetic this package owns. */
string powerOfTwoHex(i32 p) {
  string top = "1";
  i32 rem = p % 4;
  if (rem == 1) { top = "2"; } else if (rem == 2) { top = "4"; } else if (rem == 3) { top = "8"; }
  string out = top;
  for (i32 i = 0; i < p / 4; i++) { out = out + "0"; }
  return out;
}

/** `d * 10^9`, as text — appending nine zeros, which needs no arithmetic. */
string mulDecimalByTen9(string d) { return d + "000000000"; }

/**
 * `d + n` for a small `n`, done on the decimal text.
 *
 * Written out rather than using `opAdd`, because this is building the *corpus* for the test of the
 * conversions, and a corpus built with the thing under test is a corpus that agrees with it.
 */
string addSmall(string d, i32 n) {
  if (n == 0) { return d; }
  u8[] digits = d.toBytes();
  i32[] value = i32[digits.len() + 1]();
  for (i32 i = 0; i < digits.len(); i++) { value[i + 1] = digits[i] - '0'; }
  i32 carry = n;
  for (i32 i = value.len() - 1; i >= 0 && carry != 0; i--) {
    i32 v = value[i] + carry;
    carry = 0;
    while (v < 0) { v = v + 10; carry = carry - 1; }
    while (v > 9) { v = v - 10; carry = carry + 1; }
    value[i] = v;
  }
  string out = "";
  bool started = false;
  for (i32 i = 0; i < value.len(); i++) {
    if (value[i] != 0) { started = true; }
    if (started) { out = out + itoa(value[i]); }
  }
  return out == "" ? "0" : out;
}

export string test_decimal_random_values_round_trip_across_sizes(Core core, Cli cli) {
  T t = T.create();
  Rng rng = Rng(0x1F2E3D4C);
  Lines lines = Lines.create();
  for (i32 bits = 1; bits <= 600; bits++) {
    for (i32 trial = 0; trial < 3; trial++) {
      string mag = decimalOf(lines, randomHex(rng, bits));
      string v = rng.bit() == 1 ? "-" + mag : mag;
      lines.add("text roundtrip " + v + " " + text(roundTrip(b(v))));
    }
  }
  checkDeno(t, cli, ORACLE, lines, "random values across sizes");
  return t.report();
}

/** Every input that denotes zero must come back as "0" — not "-0", not "00". */
export string test_decimal_zero_has_one_spelling() {
  T t = T.create();
  string[] zeros = string[]("0", "-0", "+0", "00", "-000", "0000000000000000000000");
  for (i32 i = 0; i < zeros.len(); i++) {
    t.eqStr(text(roundTrip(b(zeros[i]))), "0", zeros[i]);
    t.isTrue(opIsZero(b(zeros[i])), zeros[i] + ": not reported as zero");
  }
  return t.report();
}

export string test_decimal_leading_zeros_are_accepted_and_dropped() {
  T t = T.create();
  string many = "";
  for (i32 i = 0; i < 40; i++) { many = many + "0"; }
  t.eqStr(text(roundTrip(b("007"))), "7", "007");
  t.eqStr(text(roundTrip(b("-0000012345"))), "-12345", "-0000012345");
  t.eqStr(text(roundTrip(b(many + "1"))), "1", "forty zeros and a one");
  return t.report();
}

export string test_decimal_malformed_input_is_rejected() {
  T t = T.create();
  string[] bad = string[](
    "", "-", "+", "abc", "1.5", "1e5", " 1", "1 ", "1,000", "0x10", "--1", "1-", "+-1",
    "1 2", " ", "١٢٣", "1_000");
  for (i32 i = 0; i < bad.len(); i++) {
    t.isFalse(acceptsDecimal(b(bad[i])), "accepted \"" + bad[i] + "\"");
  }
  return t.report();
}

/**
 * A non-digit anywhere in a later chunk is rejected.
 *
 * The parser consumes nine digits at a time, so a bad byte in the *second* chunk takes a different
 * path from one in the first.
 */
export string test_decimal_a_non_digit_in_a_later_chunk_is_rejected() {
  T t = T.create();
  i32[] positions = i32[](0, 1, 8, 9, 10, 17, 18, 19, 27);
  for (i32 p = 0; p < positions.len(); p++) {
    string s = "";
    for (i32 i = 0; i < 30; i++) { s = s + (i == positions[p] ? "x" : "1"); }
    t.isFalse(acceptsDecimal(b(s)), "accepted a non-digit at index " + itoa(positions[p]));
  }
  return t.report();
}

export string test_hex_matches_bigints_to_string(Core core, Cli cli) {
  T t = T.create();
  Rng rng = Rng(0x77AA55CC);
  Lines lines = Lines.create();
  string[] fixed = string[]("0", "1", "f", "10", "ff", "100", "ffffffff", "100000000");
  for (i32 i = 0; i < fixed.len(); i++) {
    string mag = decimalOf(lines, fixed[i]);
    hexBothWays(t, lines, mag);
  }
  for (i32 bits = 1; bits <= 300; bits = bits + 7) {
    hexBothWays(t, lines, decimalOf(lines, randomHex(rng, bits)));
  }
  checkDeno(t, cli, ORACLE, lines, "hex against BigInt");
  return t.report();
}

void hexBothWays(T t, Lines lines, string mag) {
  string[] signs = string[]("", "-");
  for (i32 s = 0; s < signs.len(); s++) {
    string v = mag == "0" ? "0" : signs[s] + mag;
    string got = text(toHex(b(v)));
    lines.add("text tohex " + v + " " + got);
    // And back, which is the direction that must undo the first exactly. Checked here rather than by
    // the oracle because it is a statement about this package composing with itself.
    t.eqStr(text(fromHex(b(got))), v, "hex round trip of " + v);
  }
}

export string test_hex_prefix_case_and_malformed_input() {
  T t = T.create();
  string[] good = string[]("0xff", "0XFF", "ff", "FF", "-0xff");
  string[] want = string[]("255", "255", "255", "255", "-255");
  for (i32 i = 0; i < good.len(); i++) {
    t.eqStr(text(fromHex(b(good[i]))), want[i], good[i]);
  }
  string[] bad = string[]("", "-", "0x", "-0x", "g", "0xg", "ff.0", "0x 1");
  for (i32 i = 0; i < bad.len(); i++) {
    t.isFalse(acceptsHex(b(bad[i])), "accepted \"" + bad[i] + "\"");
  }
  return t.report();
}

/**
 * `fromI64` and `fromU64` cover the extremes.
 *
 * The most negative i64 is the case a `-v` implementation gets wrong: its magnitude has no positive
 * i64 counterpart. `fromU64` no longer travels through an i64 parameter — that was bindgen's
 * constraint, and the host-side version had to reinterpret the bit pattern on both sides.
 */
export string test_from_i64_and_from_u64_cover_the_extremes(Core core, Cli cli) {
  T t = T.create();
  Lines lines = Lines.create();
  i64[] signed = i64[](
    0, 1, -1, 2, -2, 1000, -1000,
    2147483647, 2147483648, -2147483648,
    4294967295, 4294967296, -4294967296,
    4611686018427387904,                    // 1 << 62
    9223372036854775807,                    // (1 << 63) - 1
    -9223372036854775808);                  // the most negative i64
  for (i32 i = 0; i < signed.len(); i++) {
    string got = text(fromI64(signed[i]));
    lines.add("text roundtrip " + got + " " + got);
    t.eqStr(got, itoa64Local(signed[i]), "fromI64 of a value this file can also spell");
  }
  u64[] unsigned = u64[](0, 1, 0xFFFFFFFF, 0x100000000, 0x8000000000000000, 0xFFFFFFFFFFFFFFFF);
  string[] wanted = string[]("0", "1", "4294967295", "4294967296", "9223372036854775808",
                             "18446744073709551615");
  for (i32 i = 0; i < unsigned.len(); i++) {
    t.eqStr(text(fromU64(unsigned[i])), wanted[i], "fromU64 of an extreme");
  }
  checkDeno(t, cli, ORACLE, lines, "the i64 constructor");
  return t.report();
}

/** Decimal for an i64, written here so the check above is not `fromI64` agreeing with itself. */
string itoa64Local(i64 v) {
  if (v == 0) { return "0"; }
  bool neg = v < 0;
  string out = "";
  i64 x = v;
  // The most negative value has no positive counterpart, so the digits come off the negative side.
  if (!neg) { x = -x; }
  while (x != 0) {
    i32 d = (-(x % 10)) as~ i32;
    out = itoa(d) + out;
    x = x / 10;
  }
  return neg ? "-" + out : out;
}

export string test_bit_len_matches_bigint(Core core, Cli cli) {
  T t = T.create();
  Rng rng = Rng(0x5150CAFE);
  Lines lines = Lines.create();
  string[] fixed = string[]("0", "1", "2", "3", "255", "256");
  for (i32 i = 0; i < fixed.len(); i++) { bitLenBothWays(lines, fixed[i]); }
  for (i32 bits = 1; bits <= 400; bits = bits + 3) {
    bitLenBothWays(lines, decimalOf(lines, randomHex(rng, bits)));
  }
  checkDeno(t, cli, ORACLE, lines, "bit length");
  return t.report();
}

void bitLenBothWays(Lines lines, string mag) {
  lines.add("text bitlen " + mag + " " + itoa(opBitLen(mag.toBytes())));
  if (mag != "0") {
    lines.add("text bitlen -" + mag + " " + itoa(opBitLen(("-" + mag).toBytes())));
  }
}
