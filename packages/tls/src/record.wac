// The TLS 1.3 record layer, RFC 8446 §5.
//
// A record is a five-byte header and an AEAD-sealed payload. Three details carry the
// security of the whole thing and all three are easy to get subtly wrong:
//
// **The content type moves inside.** TLS 1.3 encrypts it. Every record on the wire says
// `application_data` in its header whatever it really carries, and the true type is the
// last non-zero byte of the decrypted plaintext. An implementation that trusts the outer
// type is not doing TLS 1.3, it is doing TLS 1.2 with new key derivation.
//
// **The nonce is the IV xor the sequence number**, not a nonce sent alongside the
// record. Nothing on the wire says which record this is, so both ends count
// independently and a desynchronised counter is indistinguishable from forgery — which
// is the intent: a dropped or reordered record must not decrypt.
//
// **The header is the AAD.** Including it is what stops an attacker rewriting the length
// field, and the length covers the sealed payload including the tag, so it has to be
// computed before sealing rather than after.
//
// Both TLS 1.3 AEADs are here. They differ only in key length and which function to
// call; the framing is identical, which is the point of TLS 1.3 having exactly one
// record format.

import { gcmEncrypt, gcmTag, gcmDecrypt } from "../../crypto/src/aesgcm.wac";
import { aeadEncrypt, aeadTag, aeadDecrypt } from "../../crypto/src/aead.wac";
import { ctEqualN } from "../../crypto/src/ct.wac";

/** TLS_AES_128_GCM_SHA256. */
export i32 suiteAes128Gcm() { return 0x1301; }
/** TLS_CHACHA20_POLY1305_SHA256. */
export i32 suiteChaCha20() { return 0x1303; }

/** The AEAD key length for a suite, in bytes. */
export i32 suiteKeyLen(i32 suite) {
  if (suite == 0x1301) { return 16; }
  if (suite == 0x1303) { return 32; }
  trap;
}

// Record content types, RFC 8446 §5.1.
export i32 typeChangeCipherSpec() { return 20; }
export i32 typeAlert() { return 21; }
export i32 typeHandshake() { return 22; }
export i32 typeApplicationData() { return 23; }

/** The largest plaintext a single record may carry, RFC 8446 §5.1. */
export i32 maxPlaintext() { return 16384; }

/**
 * The per-record nonce: the static IV xored with the sequence number.
 *
 * The counter is right-aligned in the twelve-byte IV, so the first record's nonce is the
 * IV itself and only the low eight bytes ever change. Left-aligning it instead produces
 * a nonce that is wrong for every record after the first — including the first, which
 * still works, so the mistake survives any test that seals one record.
 */
u8[] recordNonce(u8[] iv, i64 seq) {
  u8[] nonce = u8[12]();
  for (i32 i = 0; i < 12; i++) { nonce[i] = iv[i]; }
  for (i32 i = 0; i < 8; i++) {
    i32 shift = (7 - i) * 8;
    nonce[4 + i] = nonce[4 + i] ^ (((seq >> (shift as i64)) & 255) as! i32);
  }
  return nonce;
}

/** The five-byte header, which is also the AEAD's additional data. */
u8[] header(i32 sealedLen) {
  u8[] h = u8[5]();
  h[0] = 23;          // always application_data on the wire
  h[1] = 3; h[2] = 3; // legacy_record_version, frozen at TLS 1.2 for middleboxes
  h[3] = (sealedLen >> 8) & 0xFF;
  h[4] = sealedLen & 0xFF;
  return h;
}

/**
 * Seal one record: header ++ AEAD(content ++ contentType ++ padding).
 *
 * `padLen` zero bytes are appended after the content type, which hides the true length
 * from an observer. Padding is optional in TLS 1.3 and this leaves the choice to the
 * caller, because how much to pad is a policy question about the traffic rather than
 * something the record layer can answer.
 */
export u8[] recordSeal(i32 suite, u8[] key, u8[] iv, i64 seq, i32 contentType,
                       u8[] content, i32 padLen) {
  if (content.len() > maxPlaintext()) { trap; }
  if (padLen < 0) { trap; }

  u8[] inner = u8[content.len() + 1 + padLen]();
  for (i32 i = 0; i < content.len(); i++) { inner[i] = content[i]; }
  inner[content.len()] = contentType;
  // The padding is already zero.

  // The length in the header covers the ciphertext and the sixteen-byte tag, so the
  // header has to be built before sealing — it is the AAD.
  u8[] hdr = header(inner.len() + 16);
  u8[] nonce = recordNonce(iv, seq);

  u8[] ct = u8[0]();
  u8[] tag = u8[0]();
  if (suite == 0x1301) {
    ct = gcmEncrypt(key, nonce, inner);
    tag = gcmTag(key, nonce, hdr, ct);
  } else if (suite == 0x1303) {
    ct = aeadEncrypt(key, nonce, inner);
    tag = aeadTag(key, nonce, hdr, ct);
  } else {
    trap;
  }

  u8[] out = u8[5 + ct.len() + 16]();
  for (i32 i = 0; i < 5; i++) { out[i] = hdr[i]; }
  for (i32 i = 0; i < ct.len(); i++) { out[5 + i] = ct[i]; }
  for (i32 i = 0; i < 16; i++) { out[5 + ct.len() + i] = tag[i]; }
  return out;
}

/**
 * The length a record claims, from its first five bytes, or -1 if there are not five.
 *
 * Separate from opening because a reader needs to know how many bytes to wait for before
 * it has a record to open at all.
 */
export i32 recordLength(u8[] buf) {
  if (buf.len() < 5) { return -1; }
  return (buf[3] << 8) | buf[4];
}

/**
 * How much of `buf` is a whole number of records — 0 if not even one has arrived yet.
 *
 * The counterpart to `recordLength` for a reader holding a socket buffer, and the answer is
 * a prefix length rather than a count because that is what the caller does with it: feed
 * this many bytes to `tlsClientFeed`, keep the rest for next time.
 *
 * This exists because the package asked every client-side caller to do it and gave them
 * nothing to do it with, while the server side has had `tlsRecordNeeded` all along. Both
 * callers hand-rolled the loop; one of them got it wrong and stayed wrong for a year,
 * because a fetch of a few small records never splits one and only bulk traffic does. An
 * asymmetric API is how you get one correct copy and one incorrect copy of the same six
 * lines.
 */
export i32 recordsReady(u8[] buf) {
  i32 ready = 0;
  while (buf.len() - ready >= 5) {
    i32 n = (buf[ready + 3] << 8) | buf[ready + 4];
    if (buf.len() - ready < 5 + n) { break; }
    ready = ready + 5 + n;
  }
  return ready;
}

/**
 * Open one record, or `null` if it is not one this key opens.
 *
 * **`null` is the ordinary case, not the exceptional one.** Every byte a peer sends arrives here, and
 * "the tag does not verify" is a thing that happens to a correct implementation talking to a hostile
 * one — RFC 8446 §5.2 says the receiver *"MUST terminate the connection with a `bad_record_mac`
 * alert"*, which is an alert on a socket, not a dead process.
 *
 * `recordOpen` below is the trapping wrapper, for a caller whose input is its own.
 *
 * ## Why this exists — 2026-08-24, `issues/system/0205`
 *
 * `recordOpen` was the only spelling, and both `tlsClientFeed` and `tlsServerFeed` called it on bytes
 * a stranger chose. So a peer who completed a ClientHello exchange and then sent one record that did
 * not authenticate aborted the server *process*, taking every other connection with it; and an
 * on-path attacker who flipped one byte of a server flight aborted a client, which `packages/tor` is.
 *
 * The trap was deliberate at the layer below and the argument there is still a good one — an AEAD
 * whose failure can be ignored is the classic misuse. What had gone stale is the reason given for the
 * shape: *"wac cannot express a result the caller is forced to inspect"*. It can. A `u8[]?` cannot be
 * used without `is null` or `!`, and `!` on a null still traps — so a careless caller fails exactly as
 * loudly as before, and a careful one gets to answer.
 *
 * ## The cost, stated because it is real
 *
 * The tag is computed here and again inside the AEAD's own decrypt, so an accepted record costs two
 * tag computations instead of one. That is the price of not changing `packages/crypto`'s contract in
 * the same change as fixing a remote abort. The right end state is a nullable AEAD and one
 * computation; this is correct now.
 */
export u8[]? recordTryOpen(i32 suite, u8[] key, u8[] iv, i64 seq, u8[] record) {
  if (suite != 0x1301 && suite != 0x1303) { return null; }
  if (record.len() < 5 + 16) { return null; }
  i32 sealedLen = (record[3] << 8) | record[4];
  if (5 + sealedLen != record.len()) { return null; }
  if (sealedLen < 16) { return null; }
  // A sealed payload longer than the plaintext limit plus its own overhead cannot be
  // legitimate, and admitting one is how a peer makes us allocate on demand.
  if (sealedLen > maxPlaintext() + 256) { return null; }

  u8[] hdr = u8[5]();
  for (i32 i = 0; i < 5; i++) { hdr[i] = record[i]; }
  i32 ctLen = sealedLen - 16;
  u8[] ct = u8[ctLen]();
  for (i32 i = 0; i < ctLen; i++) { ct[i] = record[5 + i]; }
  u8[] tag = u8[16]();
  for (i32 i = 0; i < 16; i++) { tag[i] = record[5 + ctLen + i]; }

  u8[] nonce = recordNonce(iv, seq);
  // Constant-time, because the value being compared against is one the peer chose. A byte-at-a-time
  // comparison that returned early would say how much of a forged tag was right.
  u8[] want = suite == 0x1301 ? gcmTag(key, nonce, hdr, ct) : aeadTag(key, nonce, hdr, ct);
  if (!ctEqualN(want, tag, 16)) { return null; }

  return suite == 0x1301
    ? gcmDecrypt(key, nonce, hdr, ct, tag)
    : aeadDecrypt(key, nonce, hdr, ct, tag);
}

/**
 * Open one record, returning the inner plaintext with the content type as its last byte.
 *
 * Traps if the tag does not verify, if the framing is wrong, or if the plaintext is all
 * zeros — that last one being a record with padding and no content type, which RFC 8446
 * §5.4 says to treat as `unexpected_message` rather than as an empty anything.
 *
 * The caller gets content type and content together because separating them would mean
 * either two return values or two passes; `recordType` and `recordContent` below split
 * the result.
 *
 * **For a caller whose input is its own.** Anything holding bytes a peer sent wants
 * `recordTryOpen` above, and the two TLS state machines in this package use it — see there for what
 * trapping on a peer's record cost.
 */
export u8[] recordOpen(i32 suite, u8[] key, u8[] iv, i64 seq, u8[] record) {
  u8[]? inner = recordTryOpen(suite, key, iv, seq, record);
  if (inner is null) { trap; }
  return inner!;
}

/**
 * Whether an opened record has a content type at all — a non-zero byte somewhere.
 *
 * All padding and no type is a record RFC 8446 §5.4 says to answer with `unexpected_message`, and
 * `recordType` and `recordContent` both trap on it. That is right for a caller opening records it
 * sealed itself and wrong for one holding a peer's, which is the same split `recordTryOpen` makes.
 */
export bool hasContentType(u8[] inner) {
  for (i32 i = inner.len() - 1; i >= 0; i--) {
    if (inner[i] != 0) { return true; }
  }
  return false;
}

/** The real content type: the last non-zero byte of an opened record. */
export i32 recordType(u8[] inner) {
  for (i32 i = inner.len() - 1; i >= 0; i--) {
    if (inner[i] != 0) { return inner[i]; }
  }
  trap;   // all padding and no type — RFC 8446 §5.4 calls this unexpected_message
}

/** The content of an opened record, with the type byte and padding removed. */
export u8[] recordContent(u8[] inner) {
  i32 end = -1;
  for (i32 i = inner.len() - 1; i >= 0; i--) {
    if (inner[i] != 0) { end = i; i = -1; }
  }
  if (end < 0) { trap; }
  u8[] out = u8[end]();
  for (i32 i = 0; i < end; i++) { out[i] = inner[i]; }
  return out;
}

// ── Alerts, RFC 8446 §6 ───────────────────────────────────────────────────────

export i32 alertCloseNotify() { return 0; }
export i32 alertUnexpectedMessage() { return 10; }
export i32 alertBadRecordMac() { return 20; }
export i32 alertHandshakeFailure() { return 40; }
export i32 alertIllegalParameter() { return 47; }
export i32 alertDecodeError() { return 50; }
export i32 alertDecryptError() { return 51; }
export i32 alertProtocolVersion() { return 70; }
export i32 alertMissingExtension() { return 109; }
export i32 alertNoApplicationProtocol() { return 120; }

/**
 * An alert body: a level and a description.
 *
 * TLS 1.3 treats every alert except `close_notify` and `user_canceled` as fatal
 * regardless of the level byte, so the level is very nearly decorative — but it is still
 * sent, and sending `warning` on a fatal condition would be a lie a peer might act on.
 */
export u8[] alertBody(i32 description) {
  u8[] a = u8[2]();
  a[0] = description == 0 ? 1 : 2;   // close_notify is a warning; everything else fatal
  a[1] = description;
  return a;
}

/**
 * An alert as a plaintext record, for failures before any key exists.
 *
 * Once handshake keys are established an alert is sealed like anything else; before
 * that there is nothing to seal it with, and a peer that cannot decrypt an alert learns
 * only that something went wrong — which is why an unencrypted one is still worth
 * sending.
 */
export u8[] plaintextAlert(i32 description) {
  u8[] body = alertBody(description);
  u8[] rec = u8[7]();
  rec[0] = 21;
  rec[1] = 3; rec[2] = 3;
  rec[3] = 0; rec[4] = 2;
  rec[5] = body[0];
  rec[6] = body[1];
  return rec;
}
export i32 alertBadCertificate() { return 42; }
export i32 alertUnsupportedCertificate() { return 43; }
export i32 alertCertificateExpired() { return 45; }
export i32 alertUnknownCa() { return 48; }
