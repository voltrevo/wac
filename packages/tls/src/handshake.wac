// TLS 1.3 handshake messages, RFC 8446 §4.
//
// Enough of them for a server: parse a ClientHello, emit everything from ServerHello to
// Finished, and check the client's Finished. A client would additionally need to verify
// certificates, which is a much larger job than producing one.
//
// ## The legacy fields are not optional
//
// A TLS 1.3 ClientHello still says version 1.2 in `legacy_version`, still carries a
// session id it will never resume, and a ServerHello still echoes that session id back.
// None of it means anything; all of it is required, because middleboxes that only
// understand TLS 1.2 drop anything that looks different. The real version lives in the
// `supported_versions` extension, and a server that reads `legacy_version` instead will
// interoperate with nothing.
//
// ## What is deliberately missing
//
// No PSK, no early data, no HelloRetryRequest, no client certificates, no session
// tickets. Each is a real part of TLS 1.3 and none is needed to complete a handshake, so
// each is a place where this says "not supported" rather than pretending.

import { Reader, Writer } from "./wire.wac";

// Handshake message types, RFC 8446 §4.
export i32 hsClientHello() { return 1; }
export i32 hsServerHello() { return 2; }
export i32 hsEncryptedExtensions() { return 8; }
export i32 hsCertificate() { return 11; }
export i32 hsCertificateVerify() { return 15; }
export i32 hsFinished() { return 20; }

// Extension types.
export i32 extServerName() { return 0; }
export i32 extSupportedGroups() { return 10; }
export i32 extSignatureAlgorithms() { return 13; }
export i32 extSupportedVersions() { return 43; }
export i32 extKeyShare() { return 51; }
/** application_layer_protocol_negotiation. A QUIC connection must negotiate one. */
export i32 extAlpn() { return 16; }

/** The x25519 named group. */
export i32 groupX25519() { return 0x001d; }
/** secp256r1, which RFC 8446 §9.1 makes mandatory to support. */
export i32 groupP256() { return 0x0017; }
/** X25519MLKEM768, the hybrid post-quantum group. */
export i32 groupHybrid() { return 0x11EC; }
/** ed25519 in the signature-algorithms registry. */
export i32 sigEd25519() { return 0x0807; }
/**
 * `rsa_pss_rsae_sha256`, the scheme a TLS 1.3 server with an RSA certificate must use.
 *
 * 1.3 removed PKCS#1 v1.5 from signing entirely, so an RSA certificate and this scheme go together —
 * there is no other pairing a 1.3 peer will accept. `rsae` is the key encoding: an ordinary
 * `rsaEncryption` SubjectPublicKeyInfo, as against `rsa_pss_pss_*`, which needs a key marked
 * RSASSA-PSS in the certificate itself. tor's relays use ordinary RSA keys, so `rsae` is the one.
 */
export i32 sigRsaPssSha256() { return 0x0804; }
/**
 * `ecdsa_secp256r1_sha256`, which a P-256 certificate signs with.
 *
 * Offered by `clientHello` alongside the two above because the set a client sends is the set of
 * certificates a server may answer with — omitting this makes an EC-certificate server fail to
 * find a scheme, which it reports as a handshake failure rather than as anything about signatures.
 */
export i32 sigEcdsaP256Sha256() { return 0x0403; }

/** What a server needs out of a ClientHello. */
export struct ClientHello {
  u8[] random;
  u8[] sessionId;
  /**
   * The client's key share, as group ++ key, or empty if it offered no group we have.
   * x25519 is preferred when both are offered: it is several times faster here and the
   * client sending both means it does not mind which.
   */
  u8[] keyShare;
  /** The negotiated suite, or 0 if none of ours was offered. */
  i32 suite;
  bool offersTls13;
  bool offersEd25519;
  /** Whether the client offered `rsa_pss_rsae_sha256`, which an RSA certificate needs. */
  bool offersRsaPss;
  /** The server_name extension's host name, or empty. */
  u8[] serverName;
}

/** What a client needs out of a ServerHello. */
export struct ServerHello {
  u8[] random;
  /** The server's key share, as the raw key — its group is in `group`, not prefixed here. */
  u8[] keyShare;
  i32 group;
  i32 suite;
  /** Whether `supported_versions` said 1.3, which is the only place the real version appears. */
  bool isTls13;
  /**
   * A HelloRetryRequest, which is a ServerHello whose random is a fixed sentinel from RFC 8446 §4.1.3.
   * It means "try again with a different group" and its `keyShare` is a *group*, not a key — so a
   * client that treats it as an ordinary hello derives a shared secret from two bytes.
   */
  bool isRetry;
}

/** The random RFC 8446 §4.1.3 gives a HelloRetryRequest, which is otherwise a ServerHello. */
u8[] helloRetryRandom() {
  u8[] r = u8[32]();
  r[0] = 0xCF; r[1] = 0x21; r[2] = 0xAD; r[3] = 0x74; r[4] = 0xE5; r[5] = 0x9A; r[6] = 0x61;
  r[7] = 0x11; r[8] = 0xBE; r[9] = 0x1D; r[10] = 0x8C; r[11] = 0x02; r[12] = 0x1E; r[13] = 0x65;
  r[14] = 0xB8; r[15] = 0x91; r[16] = 0xC2; r[17] = 0xA2; r[18] = 0x11; r[19] = 0x16; r[20] = 0x7A;
  r[21] = 0xBB; r[22] = 0x8C; r[23] = 0x5E; r[24] = 0x07; r[25] = 0x9E; r[26] = 0x09; r[27] = 0xE2;
  r[28] = 0xC8; r[29] = 0xA8; r[30] = 0x33; r[31] = 0x9C;
  return r;
}

/**
 * Parse a ServerHello body — the message contents, without the four-byte handshake header.
 *
 * The mirror of `parseClientHello`, and the shapes differ in one way worth knowing: where a client
 * sends *lists* — of versions, of groups, of shares — a server sends one of each, because it has
 * chosen. A parser that read a list here would find the first two bytes of a key and call them a
 * length.
 */
export ServerHello parseServerHello(u8[] body) {
  Reader r = Reader.create(body);
  r.u16();                        // legacy_version, ignored: the real one is an extension
  u8[] random = r.take(32);
  r.vec8();                       // legacy_session_id_echo, which QUIC leaves empty
  i32 suite = r.u16();
  r.u8();                         // legacy_compression_method

  u8[] keyShare = u8[0]();
  i32 group = 0;
  bool tls13 = false;

  if (!r.empty()) {
    Reader exts = r.sub16();
    while (!exts.empty()) {
      i32 kind = exts.u16();
      Reader ext = exts.sub16();
      if (kind == extSupportedVersions()) {
        // One value, not a list — the opposite of the ClientHello's spelling of this extension.
        if (ext.u16() == 0x0304) { tls13 = true; }
      } else if (kind == extKeyShare()) {
        group = ext.u16();
        if (!ext.empty()) { keyShare = ext.vec16(); }
      }
    }
  }

  bool retry = false;
  if (random.len() == 32) {
    u8[] hrr = helloRetryRandom();
    retry = true;
    for (i32 i = 0; i < 32; i++) {
      if (random[i] != hrr[i]) { retry = false; }
    }
  }
  return ServerHello(random, keyShare, group, suite, tls13, retry);
}

/**
 * Parse a ClientHello body — the message contents, without the four-byte handshake
 * header.
 *
 * Everything is bounds-checked by `Reader`, so a truncated or over-long field traps
 * rather than being read past. Unknown extensions are skipped rather than rejected:
 * TLS's extension space is meant to be extended, and a server that fails on anything it
 * does not recognise breaks every future client.
 */
export ClientHello parseClientHello(u8[] body, i32 preferredSuite) {
  Reader r = Reader.create(body);
  r.u16();                        // legacy_version, ignored: the real one is an extension
  u8[] random = r.take(32);
  u8[] sessionId = r.vec8();

  Reader suites = r.sub16();
  i32 chosen = 0;
  while (!suites.empty()) {
    i32 s = suites.u16();
    if (s == preferredSuite) { chosen = s; }
  }

  r.vec8();                       // legacy_compression_methods, must be [0] and unused

  u8[] keyShare = u8[0]();
  bool tls13 = false;
  bool ed = false;
  bool rsaPss = false;
  u8[] serverName = u8[0]();

  if (!r.empty()) {
    Reader exts = r.sub16();
    while (!exts.empty()) {
      i32 kind = exts.u16();
      Reader body2 = exts.sub16();
      if (kind == 43) {
        // supported_versions: a list of two-byte versions behind a one-byte length.
        Reader vs = body2.sub8();
        while (!vs.empty()) {
          if (vs.u16() == 0x0304) { tls13 = true; }
        }
      } else if (kind == 51) {
        // key_share: a list of (group, key) pairs. The hybrid is preferred when it is
        // offered — a client that sends it is asking for post-quantum protection and
        // costs nothing to give it — then x25519, then P-256.
        Reader shares = body2.sub16();
        u8[] hybridShare = u8[0]();
        u8[] x25519Share = u8[0]();
        u8[] p256Share = u8[0]();
        while (!shares.empty()) {
          i32 group = shares.u16();
          u8[] key = shares.vec16();
          if (group == groupHybrid() && key.len() == 1216) {
            hybridShare = u8[1218]();
            hybridShare[0] = 0x11; hybridShare[1] = 0xEC;
            for (i32 i = 0; i < 1216; i++) { hybridShare[2 + i] = key[i]; }
          } else if (group == groupX25519() && key.len() == 32) {
            x25519Share = u8[34]();
            x25519Share[0] = 0x00; x25519Share[1] = 0x1d;
            for (i32 i = 0; i < 32; i++) { x25519Share[2 + i] = key[i]; }
          } else if (group == groupP256() && key.len() == 65) {
            p256Share = u8[67]();
            p256Share[0] = 0x00; p256Share[1] = 0x17;
            for (i32 i = 0; i < 65; i++) { p256Share[2 + i] = key[i]; }
          }
        }
        keyShare = hybridShare;
        if (keyShare.len() == 0) { keyShare = x25519Share; }
        if (keyShare.len() == 0) { keyShare = p256Share; }
      } else if (kind == 13) {
        Reader algs = body2.sub16();
        while (!algs.empty()) {
          i32 alg = algs.u16();
          if (alg == sigEd25519()) { ed = true; }
          if (alg == sigRsaPssSha256()) { rsaPss = true; }
        }
      } else if (kind == 0) {
        // server_name: a list of names, each a type byte and a length-prefixed string.
        Reader names = body2.sub16();
        while (!names.empty()) {
          i32 nameType = names.u8();
          u8[] host = names.vec16();
          if (nameType == 0) { serverName = host; }
        }
      }
      // Anything else is skipped: body2 simply goes unread.
    }
  }

  return ClientHello(random, sessionId, keyShare, chosen, tls13, ed, rsaPss, serverName);
}

/** Wrap a message body in its four-byte handshake header. */
export u8[] handshakeMessage(i32 msgType, u8[] body) {
  Writer w = Writer.create();
  w.u8(msgType);
  w.vec24(body);
  return w.take();
}

/**
 * A ServerHello.
 *
 * `legacy_session_id_echo` must be the client's session id verbatim. It means nothing
 * and omitting it makes middleboxes drop the connection, which is the whole of TLS 1.3's
 * compatibility story in one field.
 */
export u8[] serverHello(u8[] random, u8[] sessionId, i32 suite, i32 group, u8[] keyShare) {
  Writer body = Writer.create();
  body.u16(0x0303);               // legacy_version: always TLS 1.2 on the wire
  body.bytes(random);
  body.vec8(sessionId);
  body.u16(suite);
  body.u8(0);                     // legacy_compression_method

  Writer exts = Writer.create();
  // supported_versions: the actual version, and the only place it appears.
  exts.u16(extSupportedVersions());
  Writer sv = Writer.create();
  sv.u16(0x0304);
  exts.vec16(sv.take());
  // key_share: the server's single share, not a list, and in the group the client's
  // share used — a ServerHello that answers in a different group is not a negotiation,
  // it is a HelloRetryRequest, which is a different message.
  exts.u16(extKeyShare());
  Writer ks = Writer.create();
  ks.u16(group);
  ks.vec16(keyShare);
  exts.vec16(ks.take());

  body.vec16(exts.take());
  return handshakeMessage(hsServerHello(), body.take());
}

/**
 * A ClientHello, TLS 1.3, offering one suite and one group.
 *
 * `extra` is appended to the extension block verbatim, which is how a protocol built *on* TLS adds
 * its own: QUIC's transport parameters are extension 57 and their contents mean nothing here. The
 * alternative — a parameter per extension anyone might want — would put every user of TLS into this
 * signature, and the extension block is a length-prefixed sequence precisely so it does not have to.
 *
 * `sessionId` is empty for QUIC, which forbids the compatibility session id that TLS-over-TCP sends
 * to get through middleboxes (RFC 9001 §8.4). Over TCP it is 32 bytes of noise and load-bearing.
 *
 * The three signature schemes offered are the ones `parseClientHello` reports on the other side, so
 * a hello built here and parsed there agrees with itself — which is the cheapest test of both.
 */
export u8[] clientHello(u8[] random, u8[] sessionId, i32 suite, i32 group, u8[] keyShare,
                        u8[] serverName, u8[] alpn, u8[] extra) {
  Writer body = Writer.create();
  body.u16(0x0303);               // legacy_version: always TLS 1.2 on the wire
  body.bytes(random);
  body.vec8(sessionId);
  Writer suites = Writer.create();
  suites.u16(suite);
  body.vec16(suites.take());
  Writer comp = Writer.create();
  comp.u8(0);                     // legacy_compression_methods: the null one, and only it
  body.vec8(comp.take());

  Writer exts = Writer.create();

  // supported_versions is a *list* in a ClientHello and a single value in a ServerHello. Getting
  // that the wrong way round is the mistake a server reports as "no supported version".
  exts.u16(extSupportedVersions());
  Writer sv = Writer.create();
  Writer svList = Writer.create();
  svList.u16(0x0304);
  sv.vec8(svList.take());
  exts.vec16(sv.take());

  exts.u16(extSupportedGroups());
  Writer sg = Writer.create();
  Writer sgList = Writer.create();
  sgList.u16(group);
  sg.vec16(sgList.take());
  exts.vec16(sg.take());

  exts.u16(extSignatureAlgorithms());
  Writer sa = Writer.create();
  Writer saList = Writer.create();
  saList.u16(sigEd25519());
  saList.u16(sigRsaPssSha256());
  saList.u16(sigEcdsaP256Sha256());
  sa.vec16(saList.take());
  exts.vec16(sa.take());

  // key_share carries a *list* of shares here, and the server answers with exactly one.
  exts.u16(extKeyShare());
  Writer ks = Writer.create();
  Writer share = Writer.create();
  share.u16(group);
  share.vec16(keyShare);
  ks.vec16(share.take());
  exts.vec16(ks.take());

  if (serverName.len() > 0) {
    exts.u16(extServerName());
    Writer sni = Writer.create();
    Writer name = Writer.create();
    name.u8(0);                   // name_type: host_name, the only one there has ever been
    name.vec16(serverName);
    sni.vec16(name.take());
    exts.vec16(sni.take());
  }

  if (alpn.len() > 0) {
    exts.u16(extAlpn());
    Writer a = Writer.create();
    Writer list = Writer.create();
    list.vec8(alpn);
    a.vec16(list.take());
    exts.vec16(a.take());
  }

  exts.bytes(extra);
  body.vec16(exts.take());
  return handshakeMessage(hsClientHello(), body.take());
}

/** EncryptedExtensions, with nothing in it. */
export u8[] encryptedExtensions() {
  Writer body = Writer.create();
  body.vec16(u8[0]());
  return handshakeMessage(hsEncryptedExtensions(), body.take());
}

/**
 * A Certificate message carrying one DER certificate and no extensions.
 *
 * `certificate_request_context` is empty for a server certificate; it is only non-empty
 * when the certificate answers a CertificateRequest.
 */
export u8[] certificate(u8[] der) {
  Writer body = Writer.create();
  body.vec8(u8[0]());             // certificate_request_context

  Writer entry = Writer.create();
  entry.vec24(der);
  entry.vec16(u8[0]());           // per-certificate extensions

  body.vec24(entry.take());
  return handshakeMessage(hsCertificate(), body.take());
}

/**
 * The bytes CertificateVerify signs, RFC 8446 §4.4.3.
 *
 * Sixty-four spaces, then a context string, then a zero byte, then the transcript hash.
 * The padding and the context are what stop a signature made for one purpose being
 * replayed as another — a TLS 1.2 signature, or a client's signature reused by a server.
 */
export u8[] certificateVerifyContent(u8[] transcriptHash, bool isServer) {
  Writer w = Writer.create();
  for (i32 i = 0; i < 64; i++) { w.u8(32); }
  if (isServer) {
    w.bytes("TLS 1.3, server CertificateVerify".toBytes());
  } else {
    w.bytes("TLS 1.3, client CertificateVerify".toBytes());
  }
  w.u8(0);
  w.bytes(transcriptHash);
  return w.take();
}

/**
 * A CertificateVerify carrying `signature`, made under `scheme`.
 *
 * The scheme was hardcoded to ed25519 for as long as this server had only an ed25519 certificate.
 * It is a parameter now because the scheme and the certificate's key type have to agree, and a
 * mismatch is not something the peer forgives: it verifies the signature *with the certificate's
 * key* under the algorithm this field names, so naming the wrong one fails the handshake rather than
 * producing a weaker one.
 */
export u8[] certificateVerify(i32 scheme, u8[] signature) {
  Writer body = Writer.create();
  body.u16(scheme);
  body.vec16(signature);
  return handshakeMessage(hsCertificateVerify(), body.take());
}

/** A Finished message. */
export u8[] finished(u8[] verifyData) {
  return handshakeMessage(hsFinished(), verifyData);
}

/** The type of a handshake message, from its header. */
export i32 messageType(u8[] msg) {
  if (msg.len() < 4) { trap; }
  return msg[0];
}

/** The body of a handshake message, with the header removed. */
export u8[] messageBody(u8[] msg) {
  if (msg.len() < 4) { trap; }
  i32 len = (msg[1] << 16) | (msg[2] << 8) | msg[3];
  if (4 + len != msg.len()) { trap; }
  u8[] out = u8[len]();
  for (i32 i = 0; i < len; i++) { out[i] = msg[4 + i]; }
  return out;
}

/**
 * How long the handshake message starting at `buf` is, including its header, or -1 if
 * `buf` does not yet hold all of it.
 *
 * Handshake messages are framed independently of records: one message may span several
 * records and one record may hold several messages, so a reader has to reassemble.
 */
export i32 messageLength(u8[] buf) {
  if (buf.len() < 4) { return -1; }
  i32 len = (buf[1] << 16) | (buf[2] << 8) | buf[3];
  if (buf.len() < 4 + len) { return -1; }
  return 4 + len;
}
