    core.warn("error: FAILED x509_path_test test_only_a_strict_dotted_quad_is_an_address");
    bad = bad + 1;
  }
  if (xp__the_system_trust_store_parses(core, cli).len() > 0) {
    core.warn("error: FAILED x509_path_test test_the_system_trust_store_parses");
    bad = bad + 1;
  }
  if (x__openssl_reads_and_verifies_an_ed25519_certificate(core, cli).len() > 0) {
    core.warn("error: FAILED x509gen_test test_openssl_reads_and_verifies_an_ed25519_certificate");
    bad = bad + 1;
  }
  if (x__openssl_reads_and_verifies_an_rsa_certificate(core, cli).len() > 0) {
    core.warn("error: FAILED x509gen_test test_openssl_reads_and_verifies_an_rsa_certificate");
    bad = bad + 1;
  }
  if (x__a_certificate_that_cannot_be_valid_is_not_produced(core, cli).len() > 0) {
    core.warn("error: FAILED x509gen_test test_a_certificate_that_cannot_be_valid_is_not_produced");
    bad = bad + 1;
  }
  if (x__der_lengths_and_integers_are_the_shortest_form(core, cli).len() > 0) {
    core.warn("error: FAILED x509gen_test test_der_lengths_and_integers_are_the_shortest_form");
    bad = bad + 1;
  }
  if (x__time_crosses_the_utc_boundary_correctly(core, cli).len() > 0) {
    core.warn("error: FAILED x509gen_test test_time_crosses_the_utc_boundary_correctly");
    bad = bad + 1;
  }
  if (bad > 0) { core.warn("tls: " + itoa(bad) + " test(s) failed under the coverage driver"); }
  return bad;
}

/**
 * The hundred tests that expect a trap, for `covdump` to call one at a time with the trap caught.
 *
 * A trap in `main` ends the run, and the report then looks exactly like one taken before these were
 * wired in — so the count in the ledger's `cases()` is what says they ran.
 */
export void trapCase(i32 i) {
  if (i == 0) { h__traps_offer_refuses_a_0_byte_kem_seed(); return; }   // hybrid_test traps_offer_refuses_a_0_byte_kem_seed
  if (i == 1) { h__traps_offer_refuses_a_63_byte_kem_seed(); return; }   // hybrid_test traps_offer_refuses_a_63_byte_kem_seed
  if (i == 2) { h__traps_offer_refuses_a_65_byte_kem_seed(); return; }   // hybrid_test traps_offer_refuses_a_65_byte_kem_seed
  if (i == 3) { h__traps_offer_refuses_a_128_byte_kem_seed(); return; }   // hybrid_test traps_offer_refuses_a_128_byte_kem_seed
  if (i == 4) { h__traps_offer_refuses_a_0_byte_x25519_scalar(); return; }   // hybrid_test traps_offer_refuses_a_0_byte_x25519_scalar
  if (i == 5) { h__traps_accept_refuses_a_0_byte_x25519_scalar(); return; }   // hybrid_test traps_accept_refuses_a_0_byte_x25519_scalar
  if (i == 6) { h__traps_accept_refuses_a_0_byte_message(); return; }   // hybrid_test traps_accept_refuses_a_0_byte_message
  if (i == 7) { h__traps_finish_refuses_a_0_byte_x25519_scalar(); return; }   // hybrid_test traps_finish_refuses_a_0_byte_x25519_scalar
  if (i == 8) { h__traps_offer_refuses_a_31_byte_x25519_scalar(); return; }   // hybrid_test traps_offer_refuses_a_31_byte_x25519_scalar
  if (i == 9) { h__traps_accept_refuses_a_31_byte_x25519_scalar(); return; }   // hybrid_test traps_accept_refuses_a_31_byte_x25519_scalar
  if (i == 10) { h__traps_accept_refuses_a_31_byte_message(); return; }   // hybrid_test traps_accept_refuses_a_31_byte_message
