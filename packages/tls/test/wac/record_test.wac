// The TLS 1.3 record layer, in wac, against an AEAD passed in from the host.
//
// The oracle is `node:crypto`'s AES-128-GCM and ChaCha20-Poly1305 — the primitives, not a
// TLS implementation. That is the right seam: what the record layer adds on top of an
// AEAD is where the mistakes live, and none of it is checkable by an implementation that
// makes the same assumptions we do.
//
// Three things sit on top, and all three are invisible if you only test a round trip:
//
//   the nonce      the twelve-byte IV xored with the sequence number, right-aligned. A
//                  nonce that ignored the counter would round-trip perfectly and let an
//                  attacker replay or reorder records at will.
//   the AAD        the five-byte record header, authenticated but not encrypted, so a
//                  rewritten length is detected rather than acted on.
//   the type       the real content type is the last non-zero byte *inside* the
//                  plaintext; the header always says application_data. A reader that
//                  trusted the header would be reading the cover story.
//
// Host-side until 2026-08-17: the AEAD now comes from `test/oracle.mjs`, one batch per test rather
// than a call per record. The refusals came over the same day, from `record.test.ts`, which had
// stayed behind because a trap unwinds the module rather than returning. It unwinds *this* module
// and nothing else. That half is most of what a record layer owes its caller — a peer controls
// every byte of a record it is handed. `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";
import {
  recordSeal, recordOpen, recordType, recordContent, recordLength, suiteAes128Gcm,
  suiteChaCha20, suiteKeyLen, typeHandshake, typeApplicationData, typeAlert,
  maxPlaintext, recordsReady,
} from "../../src/record.wac";
import {
  alertBody, alertCloseNotify, alertUnexpectedMessage, alertBadRecordMac,
  alertHandshakeFailure, alertBadCertificate, alertUnsupportedCertificate,
  alertCertificateExpired, alertIllegalParameter, alertUnknownCa, alertDecodeError,
  alertDecryptError, alertProtocolVersion, alertMissingExtension,
  alertNoApplicationProtocol,
} from "../../src/record.wac";
import { equal, slice } from "../../../bytes/src/slice.wac";
import { Lines, Answers, ask, hex, word } from "../../../wactest/src/oracle.wac";
import { Core, Cli } from "std/platform.wac";
import { decoded } from "../../../codec/src/hex.wac";

const string ORACLE = "packages/tls/test/oracle.mjs";

/**
 * The nonce RFC 8446 §5.3 specifies: the IV xored with the sequence number, right-aligned.
 *
 * Rebuilt here rather than borrowed from `record.wac`, because it is one of the three things the
 * host oracle exists to check — asking the record layer what nonce it used would make the whole
 * comparison agree with itself.
 */
u8[] sequenceNonce(u8[] iv, i64 seq) {
  u8[] nonce = u8[12]();
  for (i32 i = 0; i < 12; i++) { nonce[i] = iv[i]; }
  for (i32 i = 0; i < 8; i++) {
    nonce[11 - i] = nonce[11 - i] ^ (((seq >> ((i * 8) as i64)) & 255) as! i32);
  }
  return nonce;
}

u8[] fill(i32 n, i32 seed) {
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = (i * 31 + seed) & 0xFF; }
  return out;
}


export string test_round_trips_both_suites_at_every_shape() {
  // No oracle needed: sealing and opening are inverses or they are not.
  T t = T.create();
  i32[] suites = i32[](suiteAes128Gcm(), suiteChaCha20());
  i32[] types = i32[](typeHandshake(), typeApplicationData(), typeAlert(), 20);
  i32[] lens = i32[](0, 1, 100, 16384);
  for (i32 s = 0; s < suites.len(); s++) {
    i32 suite = suites[s];
    u8[] key = fill(suiteKeyLen(suite), 4);
    u8[] iv = fill(12, 5);
    for (i32 ti = 0; ti < types.len(); ti++) {
      for (i32 li = 0; li < lens.len(); li++) {
        u8[] content = fill(lens[li], 6);
        u8[] inner = recordOpen(suite, key, iv, 42, recordSeal(suite, key, iv, 42, types[ti], content, 3));
        t.eqI32(recordType(inner), types[ti], "content type at len " + itoa64(lens[li] as i64));
        t.eqBytes(recordContent(inner), content, "content at len " + itoa64(lens[li] as i64));
      }
    }
  }
  return t.report();
}

export string test_the_sequence_number_is_part_of_the_nonce() {
  // The most valuable property here. Nothing on the wire says which record this is, so
  // the counter is the only thing binding a ciphertext to its position — and a nonce that
  // ignored it would round-trip, would decrypt under any host AEAD, and would let an
  // attacker replay or reorder records freely.
  T t = T.create();
  u8[] key = fill(16, 7);
  u8[] iv = fill(12, 8);
  u8[] content = fill(50, 9);
  i32 aes = suiteAes128Gcm();
  u8[] first = recordSeal(aes, key, iv, 0, typeApplicationData(), content, 0);
  u8[] second = recordSeal(aes, key, iv, 1, typeApplicationData(), content, 0);
  t.isFalse(equal(first, second), "the same content seals differently at two sequence numbers");

  // The counter is right-aligned in the IV, so incrementing it must not disturb the first
  // four bytes. Left-aligning would still work at sequence number zero and nowhere else.
  u8[] big = recordSeal(aes, key, iv, 9223372036854775807, typeApplicationData(), content, 0);
  u8[] back = recordOpen(aes, key, iv, 9223372036854775807, big);
  t.eqBytes(recordContent(back), content, "a large sequence number round trips");
  t.isFalse(equal(big, first), "and seals differently from sequence number zero");
  return t.report();
}

export string test_the_content_type_comes_from_inside_not_the_header() {
  // TLS 1.3 puts application_data in every header and the real type in the last non-zero
  // byte of the plaintext. A reader that trusted the header would read the cover story.
  T t = T.create();
  u8[] key = fill(16, 11);
  u8[] iv = fill(12, 12);
  i32 aes = suiteAes128Gcm();
  i32[] types = i32[](typeHandshake(), typeAlert(), typeApplicationData());
  for (i32 i = 0; i < types.len(); i++) {
    u8[] rec = recordSeal(aes, key, iv, 3, types[i], fill(20, 13), 0);
    t.eqI32(rec[0], typeApplicationData(), "the header always says application_data");
    t.eqI32(recordType(recordOpen(aes, key, iv, 3, rec)), types[i], "the inner type survives");
  }
  return t.report();
}

export string test_padding_is_invisible_to_the_reader() {
  // Padding hides length, so it must change the wire size and nothing else. A reader that
  // returned the zeros would corrupt every padded message; one that stopped at the first
  // zero would truncate content that legitimately ends in one.
  T t = T.create();
  u8[] key = fill(16, 14);
  u8[] iv = fill(12, 15);
  i32 aes = suiteAes128Gcm();
  u8[] content = fill(30, 16);
  u8[] bare = recordSeal(aes, key, iv, 0, typeHandshake(), content, 0);
  u8[] padded = recordSeal(aes, key, iv, 0, typeHandshake(), content, 40);
  t.eqI32(padded.len(), bare.len() + 40, "padding lengthens the record");
  t.eqBytes(recordContent(recordOpen(aes, key, iv, 0, padded)), content,
            "and is stripped on the way out");

  // Content whose own last byte is zero, which is the case a naive strip gets wrong.
  u8[] endsInZero = u8[8]();
  for (i32 i = 0; i < 7; i++) { endsInZero[i] = i + 1; }
  u8[] rec = recordSeal(aes, key, iv, 0, typeHandshake(), endsInZero, 5);
  t.eqBytes(recordContent(recordOpen(aes, key, iv, 0, rec)), endsInZero,
            "content ending in a zero byte survives padding");
  return t.report();
}

export string test_sealing_agrees_with_the_host_aead(Core core, Cli cli) {
  // `aeadopen <suite> <key> <nonce> <aad> <ciphertext>` decrypts, and answers empty if the tag does
  // not verify. Everything the record layer builds — the nonce from the sequence number, the header
  // as additional data, the type byte appended to the plaintext — has to be right for anything to
  // come back at all. Every record is sealed first and the whole set handed over in one batch.
  T t = T.create();
  i32[] suites = i32[](suiteAes128Gcm(), suiteChaCha20());
  i32[] seqs = i32[](0, 1, 255, 256, 65535);
  Lines lines = Lines.create();
  for (i32 s = 0; s < suites.len(); s++) {
    i32 suite = suites[s];
    u8[] key = fill(suiteKeyLen(suite), 21);
    u8[] iv = fill(12, 22);
    for (i32 q = 0; q < seqs.len(); q++) {
      i64 seq = seqs[q] as i64;
      u8[] rec = recordSeal(suite, key, iv, seq, typeHandshake(), fill(64 + seqs[q] % 7, 23), 0);
      lines.add("aeadopen " + itoa64(suite as i64) + " " + hex(key) + " " +
                hex(sequenceNonce(iv, seq)) + " " + hex(slice(rec, 0, 5)) + " " +
                hex(slice(rec, 5, rec.len())));
    }
  }
  Answers a = ask(t, cli, "node", string[](ORACLE), lines, "ten sealed records");
  if (!a.ok) { return t.report(); }

  for (i32 s = 0; s < suites.len(); s++) {
    for (i32 q = 0; q < seqs.len(); q++) {
      i64 seq = seqs[q] as i64;
      u8[] content = fill(64 + seqs[q] % 7, 23);
      u8[] plain = decoded(word(a.lines[s * seqs.len() + q], 1));
      t.isTrue(plain.len() > 0, "the host decrypts what we sealed at seq " + itoa64(seq));
      if (plain.len() > 0) {
        // The plaintext is the content, then the true type, then any padding.
        t.eqI32(plain.len(), content.len() + 1, "plaintext is content plus a type byte");
        t.eqI32(plain[plain.len() - 1], typeHandshake(), "and the type byte is the real type");
        bool matches = true;
        for (i32 i = 0; i < content.len(); i++) { if (plain[i] != content[i]) { matches = false; } }
        t.isTrue(matches, "and the content is unchanged");
      }
    }
  }
  return t.report();
}

export string test_the_header_is_authenticated(Core core, Cli cli) {
  // The header is not encrypted, so nothing stops an attacker editing it — the AAD is
  // what makes the edit detectable. Rewriting the length must break the tag, which the
  // host oracle can confirm independently of our own opener.
  T t = T.create();
  i32 aes = suiteAes128Gcm();
  u8[] key = fill(16, 31);
  u8[] iv = fill(12, 32);
  u8[] rec = recordSeal(aes, key, iv, 0, typeHandshake(), fill(40, 33), 0);
  u8[] ct = slice(rec, 5, rec.len());
  u8[] goodAad = slice(rec, 0, 5);
  u8[] badAad = slice(rec, 0, 5);
  badAad[4] = badAad[4] ^ 1;                       // one bit of the length

  // Both in one batch, so a host that answered empty to everything fails the first assertion
  // rather than quietly satisfying the second.
  Lines lines = Lines.create();
  string prefix = "aeadopen " + itoa64(aes as i64) + " " + hex(key) + " " + hex(iv) + " ";
  lines.add(prefix + hex(goodAad) + " " + hex(ct));
  lines.add(prefix + hex(badAad) + " " + hex(ct));
  Answers a = ask(t, cli, "node", string[](ORACLE), lines, "a good header and a rewritten one");
  if (!a.ok) { return t.report(); }

  t.isTrue(decoded(word(a.lines[0], 1)).len() > 0, "the genuine header verifies");
  t.eqI32(decoded(word(a.lines[1], 1)).len(), 0, "a rewritten length breaks the tag");
  return t.report();
}

export string test_the_alert_codes_are_the_ones_rfc_8446_assigns() {
  // Each of these is used at some point of failure, and no test asserts which alert a
  // rejection produces — only that it was rejected — so the numbers were unconstrained.
  // An alert is all the other end learns about why you hung up.
  T t = T.create();
  t.eqI32(alertCloseNotify(), 0, "close_notify");
  t.eqI32(alertUnexpectedMessage(), 10, "unexpected_message");
  t.eqI32(alertBadRecordMac(), 20, "bad_record_mac");
  t.eqI32(alertHandshakeFailure(), 40, "handshake_failure");
  t.eqI32(alertBadCertificate(), 42, "bad_certificate");
  t.eqI32(alertUnsupportedCertificate(), 43, "unsupported_certificate");
  t.eqI32(alertCertificateExpired(), 45, "certificate_expired");
  t.eqI32(alertIllegalParameter(), 47, "illegal_parameter");
  t.eqI32(alertUnknownCa(), 48, "unknown_ca");
  t.eqI32(alertDecodeError(), 50, "decode_error");
  t.eqI32(alertDecryptError(), 51, "decrypt_error");
  t.eqI32(alertProtocolVersion(), 70, "protocol_version");
  t.eqI32(alertMissingExtension(), 109, "missing_extension");
  t.eqI32(alertNoApplicationProtocol(), 120, "no_application_protocol");

  // Only close_notify is a warning. TLS 1.3 treats everything else as fatal whatever the
  // level says, so this is nearly decorative — but claiming a fatal condition is a
  // warning is a lie a peer may act on by carrying on.
  t.eqI32(alertBody(alertCloseNotify())[0], 1, "close_notify is a warning");
  t.eqI32(alertBody(alertUnknownCa())[0], 2, "unknown_ca is fatal");
  t.eqI32(alertBody(alertUnknownCa())[1], 48, "and carries its own description");
  return t.report();
}


u8[] cut(u8[] b, i32 n) {
  u8[] o = u8[n]();
  for (i32 i = 0; i < n; i++) { o[i] = b[i]; }
  return o;
}
/**
 * TLS record framing.
 *
 * `tlsClientFeed` takes whole records only and traps otherwise, and for as long as this
 * package existed the Tor link handed it whatever `recv` returned. It survived because a
 * directory fetch is a few small records; the first real transfer through the proxy arrived
 * as 44KB in one chunk with the last record cut in half, and the client aborted.
 */
u8[] record(i32 bodyLen) {
  u8[] r = u8[5 + bodyLen]();
  r[0] = 23; r[1] = 3; r[2] = 3;
  r[3] = bodyLen >> 8; r[4] = bodyLen & 255;
  return r;
}

u8[] join(u8[] a, u8[] b) {
  u8[] o = u8[a.len() + b.len()]();
  for (i32 i = 0; i < a.len(); i++) { o[i] = a[i]; }
  for (i32 i = 0; i < b.len(); i++) { o[a.len() + i] = b[i]; }
  return o;
}

export string test_only_whole_records_are_offered() {
  T t = T.create();
  t.eqI32(recordsReady(u8[0]()), 0, "nothing yet");
  t.eqI32(recordsReady(u8[](23, 3, 3)), 0, "not even a header");
  t.eqI32(recordsReady(u8[](23, 3, 3, 0, 100)), 0, "a header promising a body that is absent");

  u8[] one = record(100);
  t.eqI32(recordsReady(one), 105, "exactly one record");
  for (i32 i = 0; i < 105; i++) {
    t.eqI32(recordsReady(cut(one, i)), 0, "one record cut at " + itoa64(i as i64));
  }

  u8[] three = join(join(record(10), record(20)), record(30));
  t.eqI32(recordsReady(three), 15 + 25 + 35, "three records back to back");
  t.eqI32(recordsReady(join(three, u8[](23, 3, 3, 0, 200))), 75,
       "three whole ones, and a fourth whose body has not arrived");
  t.eqI32(recordsReady(join(three, u8[](23))), 75, "a fourth that is one byte of header");
  return t.report();
}

/** The failing case as it actually arrived: many records and a split one, in one chunk. */
export string test_a_chunk_of_eighty_records_with_the_last_one_split() {
  T t = T.create();
  u8[] many = u8[0]();
  for (i32 i = 0; i < 80; i++) { many = join(many, record(542)); }
  t.eqI32(recordsReady(many), 80 * 547, "eighty whole records");

  // The 81st, arriving as its first nine bytes and no more. This is the shape that trapped:
  // a header that says 542 and a body that is nine bytes into arriving.
  t.eqI32(recordsReady(join(many, cut(record(542), 9))), 80 * 547,
       "the split record is held back, not fed");

  // And once the rest of it turns up, it is offered along with everything else.
  t.eqI32(recordsReady(join(many, record(542))), 81 * 547,
       "the completed record joins the batch");
  return t.report();
}

// ── The refusals ─────────────────────────────────────────────────────────────

const i32 APPLICATION = 23;

/** A sealed record and the key it was sealed under, so a refusal is about the input under test. */
u8[] sealedKey() { return fill(16, 13); }
u8[] sealedIv() { return fill(12, 14); }
u8[] sealedRecord() {
  return recordSeal(suiteAes128Gcm(), sealedKey(), sealedIv(), 5, APPLICATION, fill(64, 15), 2);
}

/** The record with one bit of byte `i` flipped. */
u8[] tampered(i32 i) {
  u8[] bad = slice(sealedRecord(), 0, sealedRecord().len());
  bad[i] = bad[i] ^ 0x80;
  return bad;
}

export string test_the_genuine_record_still_opens() {
  // The canary the refusals below need: a `recordOpen` that trapped on everything would satisfy
  // every one of them.
  T t = T.create();
  u8[] inner = recordOpen(suiteAes128Gcm(), sealedKey(), sealedIv(), 5, sealedRecord());
  t.eqI32(recordType(inner), APPLICATION, "the genuine record opens and carries its type");
  t.eqBytes(recordContent(inner), fill(64, 15), "and its content");
  return t.report();
}

// Tampering. The offsets are the header, the body, and the three bytes around the tag boundary —
// a tag checked over the wrong span is right in the middle and wrong at either edge.

export string test_traps_when_a_header_byte_is_flipped() {
  recordOpen(suiteAes128Gcm(), sealedKey(), sealedIv(), 5, tampered(5));
  return "";
}

export string test_traps_when_a_ciphertext_byte_is_flipped() {
  recordOpen(suiteAes128Gcm(), sealedKey(), sealedIv(), 5, tampered(20));
  return "";
}

export string test_traps_when_the_byte_before_the_tag_is_flipped() {
  recordOpen(suiteAes128Gcm(), sealedKey(), sealedIv(), 5, tampered(sealedRecord().len() - 17));
  return "";
}

export string test_traps_when_the_first_tag_byte_is_flipped() {
  recordOpen(suiteAes128Gcm(), sealedKey(), sealedIv(), 5, tampered(sealedRecord().len() - 16));
  return "";
}

export string test_traps_when_the_last_tag_byte_is_flipped() {
  recordOpen(suiteAes128Gcm(), sealedKey(), sealedIv(), 5, tampered(sealedRecord().len() - 1));
  return "";
}

export string test_traps_when_a_different_key_is_offered() {
  recordOpen(suiteAes128Gcm(), fill(16, 99), sealedIv(), 5, sealedRecord());
  return "";
}

// Malformed framing, refused before anything is decrypted. Too short to hold a header and a tag.

export string test_traps_on_an_empty_record() {
  recordOpen(suiteAes128Gcm(), sealedKey(), sealedIv(), 5, u8[0]());
  return "";
}

export string test_traps_on_a_four_byte_record() {
  recordOpen(suiteAes128Gcm(), sealedKey(), sealedIv(), 5, slice(sealedRecord(), 0, 4));
  return "";
}

export string test_traps_on_a_five_byte_record() {
  recordOpen(suiteAes128Gcm(), sealedKey(), sealedIv(), 5, slice(sealedRecord(), 0, 5));
  return "";
}

export string test_traps_on_a_record_with_a_header_and_no_tag() {
  recordOpen(suiteAes128Gcm(), sealedKey(), sealedIv(), 5, slice(sealedRecord(), 0, 20));
  return "";
}

/**
 * A record with a byte after the one its length announces.
 *
 * **This is the only one of the framing refusals that the framing guards alone can fail.** The
 * others — too short, a length one larger than the buffer, an oversized claim — are all refused by
 * the AEAD downstream whatever the guards say, so weakening `record.len() < 5 + 16`,
 * `5 + sealedLen != record.len()` or the `maxPlaintext() + 256` bound leaves every one of them
 * still trapping. Here the header is right, the body decrypts, and the trailing byte is simply
 * ignored by anything that checked `>=` rather than `==` — which would mean two byte strings are
 * the same record, and a transcript that no longer identifies what was sent.
 */
export string test_traps_on_a_byte_after_the_announced_length() {
  u8[] rec = sealedRecord();
  u8[] longer = u8[rec.len() + 1]();
  for (i32 i = 0; i < rec.len(); i++) { longer[i] = rec[i]; }
  recordOpen(suiteAes128Gcm(), sealedKey(), sealedIv(), 5, longer);
  return "";
}

export string test_traps_when_the_length_field_disagrees_with_the_buffer() {
  u8[] bad = slice(sealedRecord(), 0, sealedRecord().len());
  bad[4] = (bad[4] + 1) & 0xFF;
  recordOpen(suiteAes128Gcm(), sealedKey(), sealedIv(), 5, bad);
  return "";
}

/** An oversized claim, which is how a peer asks for an allocation. */
export string test_traps_on_an_oversized_length_claim() {
  u8[] bad = slice(sealedRecord(), 0, sealedRecord().len());
  bad[3] = 0xFF;
  bad[4] = 0xFF;
  recordOpen(suiteAes128Gcm(), sealedKey(), sealedIv(), 5, bad);
  return "";
}

export string test_record_length_reads_the_header_and_says_when_it_cannot() {
  T t = T.create();
  u8[] rec = sealedRecord();
  t.eqI32(recordLength(rec), rec.len() - 5, "recordLength is the body, not the whole record");
  t.eqI32(recordLength(u8[4]()), -1, "and -1 below five bytes, rather than a guess");
  return t.report();
}

export string test_the_plaintext_limit_is_sixteen_kilobytes() {
  T t = T.create();
  t.isTrue(recordSeal(suiteAes128Gcm(), sealedKey(), sealedIv(), 0, APPLICATION,
                      fill(maxPlaintext(), 27), 0).len() > 0,
           "exactly 16384 bytes seals");
  return t.report();
}

export string test_traps_on_plaintext_one_byte_over_the_limit() {
  recordSeal(suiteAes128Gcm(), sealedKey(), sealedIv(), 0, APPLICATION,
             fill(maxPlaintext() + 1, 27), 0);
  return "";
}

export string test_traps_on_an_unknown_cipher_suite() {
  recordSeal(999, sealedKey(), sealedIv(), 0, APPLICATION, fill(10, 27), 0);
  return "";
}
