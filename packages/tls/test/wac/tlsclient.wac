// Driving `src/client.wac` over a real socket: the part `host/connect.ts` used to be.
//
// The socket and the randomness live here; everything else is `src/`. That sentence was true of the
// TypeScript too — what changed is that the harness no longer needs a JavaScript host to say it.
//
// **Whole records only.** `tlsClientFeed` does no buffering, by design, so that one place decides
// where a record ends; `recordsReady` is that place and this calls it. Feeding it whatever `recv`
// happened to return works until a response arrives in more than one segment, which is how a reader
// that mostly works fails on a fast connection rather than a slow one — `packages/tor/src/link.wac`
// carries the same paragraph over the same call.
//
// Not a test file and not discovered as one: `wac test` walks `*_test.wac`.

import { Clock, Files, Net, Random, Socket, TimedOut } from "std";
import { Read, flatten } from "core";
import { tlsClientInit, tlsClientFeed, tlsClientSend, tlsClientClose,
         tlsClientPhase, tlsClientFailure, clientStep, ClientStep } from "../../src/client.wac";
import { recordsReady } from "../../src/record.wac";
import { pemBundle, Store } from "../../src/roots.wac";
import { Buf } from "core";
import { contains } from "../../../wactest/src/strings.wac";

/** How long a handshake and one reply may take before the peer is called dead. */
static i32 READ_TIMEOUT_MS = 20000;

/** What a request came to. */
export struct Reply {
  /**
   * The client's own failure code, and 0 when it completed. **Not a boolean**: which refusal happened
   * is the whole content of half these tests — a client that rejects everything passes every
   * "it refused" assertion, so the code is checked, not the fact.
   */
  i32 failure;
  string response;
  /** Why the fixture never got as far as a code, empty when it did. */
  string error;
}

/** The trust store from a PEM file: whatever roots it holds, and nothing else trusted. */
export Store rootsFrom(Files fs, string pemPath) {
  return pemBundle(flatten(fs.readFile(pemPath).wait()).orElse(u8[]()));
}

/** No roots at all — for a caller checking the shape of the first flight rather than a peer. */
export Store noRoots() { return Store(u8[](), i32[](), 0); }

/**
 * A P-256 private scalar: 32 random bytes, retried until they land in [1, n).
 *
 * Rejection sampling rather than reduction, because reducing a uniform 256-bit value mod n biases the
 * low end. The rejection probability is about 2^-32, so this virtually never loops — the loop is here
 * because "virtually never" is not "never" and a biased scalar is not a failure anything would report.
 */
export u8[] p256Scalar(Random rnd) {
  const u8[] N = [
                      0xFF, 0xFF, 0xFF, 0xFF, 0x00, 0x00, 0x00, 0x00,
                      0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
                      0xBC, 0xE6, 0xFA, 0xAD, 0xA7, 0x17, 0x9E, 0x84,
                      0xF3, 0xB9, 0xCA, 0xC2, 0xFC, 0x63, 0x25, 0x51
  ];
  for (i32 tries = 0; tries < 64; tries++) {
    u8[] k = flatten(rnd.bytes(32).wait()).unwrap();
    bool zero = true;
    for (i32 i = 0; i < 32; i++) { if (k[i] != 0) { zero = false; } }
    if (zero) { continue; }
    // Below n, compared big-endian: the first differing byte decides.
    for (i32 i = 0; i < 32; i++) {
      if (k[i] < N[i]) { return k; }
      if (k[i] > N[i]) { break; }
    }
  }
  trap;
}

/** The ClientHello and the state that goes with it, without a socket anywhere near it. */
export ClientStep firstFlight(Random rnd, string sni, Store roots, i64 now) {
  return clientStep(tlsClientInit(sni.toBytes(), roots.der, roots.offsets,
                                  flatten(rnd.bytes(32).wait()).unwrap(), p256Scalar(rnd),
                                  flatten(rnd.bytes(64).wait()).unwrap(), flatten(rnd.bytes(32).wait()).unwrap(), now));
}

/** The same, from fixed bytes, for a caller that wants the flight to be the same every run. */
export ClientStep fixedFirstFlight(string sni, Store roots, u8[] seed) {
  return clientStep(tlsClientInit(sni.toBytes(), roots.der, roots.offsets, seed, seed,
                                  u8[].filled(64, 0), u8[].filled(32, 0), 0 as i64));
}

/** One bounded read. Empty means end of stream, and `ok` says whether the wait itself held. */
struct Chunk {
  u8[] bytes;
  bool ok;
  string error;
}

Chunk readOnce(Clock clock, Socket s, i32 millis) {
  match (flatten(clock.within(s.recv(), millis).wait())) {
    Ok(r): {
      match (r) {
        Data(bytes): { return Chunk(bytes, true, ""); }
        default: { return Chunk(u8[](), true, ""); }
      }
    }
    Err(e): {
      // `within` cancelled the read; closing the socket is what makes the host's read underneath finish.
      if (e is TimedOut) {
        s.close();
        return Chunk(u8[](), false, "the peer said nothing for \{millis}ms");
      }
      return Chunk(u8[](), false, "recv: \{e}");
    }
  }
}

/**
 * Dial, handshake, send `req`, read until the peer stops, and answer.
 *
 * `now` is passed in rather than read from the clock, which is what lets a caller ask the client to
 * evaluate a handshake as though it were 1990 without any clock trickery.
 */
export Reply request(Clock clock, Random rnd, Net net, string host, i32 port, string sni, Store roots, string req, i64 now) {
  auto dial = flatten(clock.within(net.connect(host, port), READ_TIMEOUT_MS).wait());
  if (dial.isErr()) {
    if (dial.err()! is TimedOut) { return Reply(-1, "", "\{host}:\{port} did not answer the dial"); }
    return Reply(-1, "", "connect: \{dial.err()!}");
  }
  Socket s = dial.unwrap();

  ClientStep st = firstFlight(rnd, sni, roots, now);
  u8[] state = st.state;
  if (flatten(s.send(st.toSend).wait()).isErr()) {
    s.close();
    return Reply(-1, "", "the ClientHello did not go out");
  }

  Buf raw = Buf.create();
  Buf app = Buf.create();
  bool sent = false;
  string error = "";

  // One loop for both halves. The handshake finishing is not the end of the conversation, and a loop
  // that returned there and started a second one would have to hand over `raw` — the partial record
  // that a server which pipelines its Finished and its first application record leaves behind.
  for (i32 guard = 0; guard < 100000; guard++) {
    if (tlsClientFailure(state) != 0) { break; }
    if (tlsClientPhase(state) == 3 && !sent) {
      ClientStep out = clientStep(tlsClientSend(state, req.toBytes()));
      state = out.state;
      if (flatten(s.send(out.toSend).wait()).isErr()) { error = "the request did not go out"; break; }
      sent = true;
    }
    Chunk c = readOnce(clock, s, READ_TIMEOUT_MS);
    if (!c.ok) { error = c.error; break; }
    if (c.bytes.len() == 0) { break; }          // the peer closed, which is how `-www` ends
    raw.pushAll(c.bytes);

    i32 ready = recordsReady(raw.bytes());
    if (ready == 0) { continue; }
    u8[] all = raw.bytes();
    u8[] whole = u8[].filled(ready, 0);
    for (i32 i = 0; i < ready; i++) { whole[i] = all[i]; }
    raw.dropFront(ready);

    ClientStep step = clientStep(tlsClientFeed(state, whole));
    state = step.state;
    if (step.toSend.len() > 0) {
      if (flatten(s.send(step.toSend).wait()).isErr()) { error = "an answer did not go out"; break; }
    }
    if (step.appData.len() > 0) { app.pushAll(step.appData); }

    // Stop once the reply's headers are complete, rather than on end of stream. `s_server -quiet`
    // implies `-ign_eof`, so OpenSSL answers and then holds the connection open indefinitely — a loop
    // that waited for the close would time out against every interop case while passing against our
    // own server, which does close. That is a difference in the *fixture*, not in the client.
    if (app.len > 0 && contains(app.toStr(), "\r\n\r\n")) { break; }
  }

  if (tlsClientFailure(state) == 0 && sent) {
    // Best effort: the peer may already be gone, and a close_notify nobody reads is not a failure.
    ClientStep bye = clientStep(tlsClientClose(state));
    if (bye.toSend.len() > 0) { s.send(bye.toSend).wait(); }
  }
  s.close();
  return Reply(tlsClientFailure(state), string.fromBytes(app.take()), error);
}
