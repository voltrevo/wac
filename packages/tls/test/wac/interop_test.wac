// A real TLS 1.3 handshake, against real clients.
//
// Everything else in this package is checked against vectors and against WebCrypto, which establishes
// that the primitives and the key schedule are right. None of it establishes that the *protocol* is
// right — a handshake can have every secret correct and still fail on a length prefix, a missing
// legacy field, or a transcript that includes one message too many.
//
// So this runs the thing. A listener, a real client, and a check that the client got the bytes it
// asked for. Two clients rather than one, because they are separate implementations that disagree
// about different things:
//
//   OpenSSL 3.0   the reference everyone tests against
//   rustls        Deno's TLS client, and a from-scratch implementation in another language — it also
//                 verifies the certificate chain, which OpenSSL is told to skip
//
// The certificate is a CA-signed leaf rather than a self-signed one, because rustls rejects a CA
// certificate presented as an end-entity — correctly, and the first version of this test hit exactly
// that.
//
// Host-side until 2026-08-19, `issues/system/0161`. rustls stays TypeScript because it is only
// reachable through `Deno.connectTls`; it is the oracle, and `rustlsclient.ts` says so. `s_client` is
// reached with `Cli.exec`, whose stdin is exactly what the TypeScript's piped writer was for.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli, Exec, FileResult } from "../../../platform/src/platform.wac";
import { Daemon, start, stop, logOf, waitForLogWithin } from "../../../wactest/src/daemon.wac";
import { quoted } from "../../../wactest/src/childenv.wac";
import { contains } from "../../../wactest/src/strings.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { jsonFile, strOf } from "../../../wactest/src/jsonfile.wac";
import { openssl35, have } from "./openssl.wac";

const string DATA = "packages/tls/test/data";
const string REQ = "GET / HTTP/1.1\r\nHost: wac.test\r\n\r\n";
const string BODY = "hello from wac over TLS 1.3\n";

/** Our server, built and listening, or the reason it is not. */
struct Ours {
  Daemon d;
  i32 port;
  string dir;
  string error;
}

Ours serveOnce(Core core, Cli cli, string name) {
  string dir = cli.cwd().wait() + "/.cache/tls/" + name;
  cli.remove(dir, true).wait();
  cli.mkdir(dir, true).wait();
  string bin = dir + "/tlsserved";
  Exec built = cli.exec("deno",
    string[]("run", "-A", "packages/platform/build.ts", "packages/tls/test/wac/tlsserved.wac",
             "--allow-read", "--allow-net", "-o", bin), u8[0]()).wait();
  if (!built.ran() || built.status != 0) {
    return Ours(Daemon(-1, "", ""), -1, dir,
                "tlsserved did not build: " + string.fromBytes(built.stderr));
  }
  Daemon d = start(cli, quoted(bin) + " 0 --body " + quoted(BODY), dir + "/log");
  if (!d.ok()) { return Ours(d, -1, dir, "tlsserved did not start: " + d.error); }
  const string MARK = "listening on 127.0.0.1:";
  if (!waitForLogWithin(core, cli, d, MARK, 20000)) {
    stop(cli, d);
    return Ours(d, -1, dir, "tlsserved never listened. Its output was: " + logOf(cli, d));
  }
  string log = logOf(cli, d);
  u8[] b = log.toBytes();
  i32 port = 0;
  for (i32 i = log.indexOf(MARK) + MARK.len(); i < b.len() && b[i] >= '0' && b[i] <= '9'; i++) {
    port = port * 10 + (b[i] - '0');
  }
  return Ours(d, port, dir, "");
}

void done(Cli cli, Ours s) {
  stop(cli, s.d);
  cli.remove(s.dir, true).wait();
}

/** What `s_client` said, having been handed the request on its standard input. */
Exec sClient(Cli cli, string binary, i32 port, string[] extra, string stdin) {
  string[] head = string[]("s_client", "-connect", "127.0.0.1:" + itoa(port));
  string[] args = string[head.len() + extra.len()](fill: "");
  for (i32 i = 0; i < head.len(); i++) { args[i] = head[i]; }
  for (i32 i = 0; i < extra.len(); i++) { args[head.len() + i] = extra[i]; }
  return cli.exec(binary, args, stdin.toBytes()).wait();
}

export string test_openssl_completes_a_tls13_handshake_and_exchanges_data(Core core, Cli cli) {
  T t = T.create();
  t.isTrue(have(cli, "openssl"), "openssl is on the path");
  if (!have(cli, "openssl")) { return t.report(); }
  Ours s = serveOnce(core, cli, "ossl_interop");
  t.eqStr(s.error, "", "our server is up");
  if (s.port <= 0) { return t.report(); }

  Exec r = sClient(cli, "openssl", s.port,
                   string[]("-tls1_3", "-servername", "wac.test", "-quiet", "-verify_quiet"), REQ);
  string out = string.fromBytes(r.stdout);
  t.isTrue(contains(out, "HTTP/1.1 200 OK"),
           "openssl got the reply — stdout: " + out + " stderr: " + string.fromBytes(r.stderr));
  t.isTrue(contains(out, "hello from wac over TLS 1.3"), "and the body");
  // "the client got a reply" and "the server read the request" are different claims, and a server
  // answering a fixed page satisfies the first without the second.
  t.isTrue(contains(logOf(cli, s.d), "received GET /"),
           "the server received the request — its output was: " + logOf(cli, s.d));
  done(cli, s);
  return t.report();
}

/** Run `rustlsclient.ts` against `port` and answer with what it published. */
struct Said {
  bool ok;
  string text;
  string secondRead;
  string detail;
  string error;
}

Said rustls(Cli cli, Ours s) {
  Exec r = cli.exec("deno",
    string[]("run", "-A", "packages/tls/test/rustlsclient.ts", s.dir, itoa(s.port),
             DATA + "/ca.pem", REQ), u8[0]()).wait();
  if (!r.ran()) { return Said(false, "", "", "", "deno did not run — " + r.error); }
  FileResult f = cli.readFile(s.dir + "/said.json").wait();
  if (!f.ok) {
    FileResult e = cli.readFile(s.dir + "/error.json").wait();
    if (e.ok) {
      return Said(false, "", "", "",
                  strOf(jsonFile(cli, s.dir + "/error.json"), "error"));
    }
    return Said(false, "", "", "",
                "rustlsclient.ts published nothing — " + string.fromBytes(r.stderr));
  }
  return Said(true,
              strOf(jsonFile(cli, s.dir + "/said.json"), "text"),
              strOf(jsonFile(cli, s.dir + "/said.json"), "secondRead"),
              strOf(jsonFile(cli, s.dir + "/said.json"), "detail"),
              "");
}

export string test_rustls_completes_the_handshake_and_verifies_the_certificate_chain(
    Core core, Cli cli) {
  // Unlike the OpenSSL case it is given the CA and made to check the chain, so this covers the
  // certificate being well-formed and correctly framed in the Certificate message — not only that a
  // signature verified.
  T t = T.create();
  Ours s = serveOnce(core, cli, "rustls");
  t.eqStr(s.error, "", "our server is up");
  if (s.port <= 0) { return t.report(); }

  Said said = rustls(cli, s);
  t.eqStr(said.error, "", "rustls connected");
  t.isTrue(contains(said.text, "HTTP/1.1 200 OK"), "rustls got the reply: " + said.text);
  t.isTrue(contains(said.text, "hello from wac over TLS 1.3"), "and the body");
  done(cli, s);
  return t.report();
}

export string test_a_client_offering_no_tls13_support_is_rejected(Core core, Cli cli) {
  // The server must not fall back. A TLS 1.2 ClientHello has no supported_versions extension saying
  // 0x0304, and answering it with a TLS 1.3 ServerHello would be worse than refusing — the client
  // would fail confusingly, or worse, not fail.
  T t = T.create();
  t.isTrue(have(cli, "openssl"), "openssl is on the path");
  if (!have(cli, "openssl")) { return t.report(); }
  Ours s = serveOnce(core, cli, "tls12");
  t.eqStr(s.error, "", "our server is up");
  if (s.port <= 0) { return t.report(); }

  Exec r = sClient(cli, "openssl", s.port, string[]("-tls1_2", "-quiet"), "");
  t.isFalse(contains(string.fromBytes(r.stdout), "HTTP/1.1 200 OK"), "a TLS 1.2 client was served");
  done(cli, s);
  return t.report();
}

export string test_the_connection_closes_cleanly_not_as_a_truncation(Core core, Cli cli) {
  // A TLS peer cannot distinguish an orderly shutdown from an attacker cutting the connection unless
  // it sees close_notify — so a client that cares reports an error on a bare TCP close. rustls is such
  // a client: a clean shutdown makes `read` return null, and a truncated one makes it throw.
  T t = T.create();
  Ours s = serveOnce(core, cli, "shutdown");
  t.eqStr(s.error, "", "our server is up");
  if (s.port <= 0) { return t.report(); }

  Said said = rustls(cli, s);
  t.eqStr(said.error, "", "rustls connected");
  t.isTrue(contains(said.text, "HTTP/1.1 200 OK"), "it got the reply first: " + said.text);
  t.eqStr(said.secondRead, "end",
          "the second read reported end of stream, not a truncation — " + said.detail);
  done(cli, s);
  return t.report();
}

export string test_the_server_negotiates_x25519mlkem768_with_a_post_quantum_client(
    Core core, Cli cli) {
  // `-groups X25519MLKEM768` makes it the *only* group offered, so a server that quietly fell back to
  // X25519 would fail the handshake rather than silently downgrade — which is the outcome worth
  // testing for.
  T t = T.create();
  string binary = openssl35(cli);
  if (binary == "") {
    // Skipped rather than failed: it is a reference this repo does not ship, and a suite that goes red
    // over a missing optional tool gets ignored. Said out loud, because a skip that prints nothing
    // reads as coverage.
    core.warn("tls interop test: skipped — no OpenSSL 3.5, so the hybrid group was not negotiated. " +
              "`tools/openssl35.sh` builds one.");
    return t.report();
  }
  Ours s = serveOnce(core, cli, "mlkem_interop");
  t.eqStr(s.error, "", "our server is up");
  if (s.port <= 0) { return t.report(); }

  Exec r = sClient(cli, binary, s.port,
                   string[]("-tls1_3", "-groups", "X25519MLKEM768", "-quiet", "-verify_quiet"), REQ);
  string out = string.fromBytes(r.stdout);
  t.isTrue(contains(out, "HTTP/1.1 200 OK"),
           "a reply over the hybrid group — stdout: " + out +
           " stderr: " + string.fromBytes(r.stderr));
  t.isTrue(contains(out, "hello from wac over TLS 1.3"), "and the body");
  done(cli, s);
  return t.report();
}
