// Our TLS 1.3 server, on an ephemeral port, for the round trip.
//
// A separate program rather than a helper the test calls, because both ends have to be running at
// once and a wac test is one thread: `accept` blocks until somebody dials, and the somebody is the
// same test. The TypeScript this replaces got away with it by putting the server in a floating
// promise — `serveOnce` returned a `done` nobody awaited until the request had gone out — which is a
// concurrency the language deliberately does not have.
//
// So it is started by `daemon.start`, says its port on standard output, and serves connections until
// it is killed. The socket and the randomness live here; what a record means and what to answer is
// `src/server.wac`, which is a pure function from (state, bytes) to (state, bytes).
//
//   ./tlsserved                      an ephemeral port, printed
//   ./tlsserved 8443                 a port of your choosing
//
// Built by `client_test.wac`; kept beside it rather than in `src/` because the reply is a fixture's
// reply — a fixed body the test matches on, not something a server should answer.

import { Core, Cli, Socket } from "../../../platform/src/platform.wac";
import { Read } from core;
import { tlsServerInit, tlsServerFeed, tlsServerSend, tlsPhase, tlsRecordNeeded }
  from "../../src/server.wac";
import { clientStep, ClientStep } from "../../src/client.wac";
import { Buf } from "../../../bytes/src/buf.wac";
import { itoa } from "../../../fmt/src/itoa.wac";

/** What the round-trip test matches on. Fixed, so an assertion can name the bytes. */
const string BODY = "hello from the wac server\n";

string reply() {
  return "HTTP/1.1 200 OK\r\ncontent-type: text/plain\r\n" +
         "content-length: " + itoa(BODY.len()) + "\r\nconnection: close\r\n\r\n" + BODY;
}

/** Whole records only, the same discipline the client keeps, for the same reason. */
i32 readyIn(u8[] buf) {
  i32 consumed = 0;
  while (buf.len() - consumed >= 5) {
    u8[] rest = u8[buf.len() - consumed]();
    for (i32 i = consumed; i < buf.len(); i++) { rest[i - consumed] = buf[i]; }
    if (tlsRecordNeeded(rest) != 0) { break; }
    consumed = consumed + 5 + ((buf[consumed + 3] << 8) | buf[consumed + 4]);
  }
  return consumed;
}

void serve(Core core, Cli cli, i32 handle, u8[] cert, u8[] seed) {
  u8[] state = tlsServerInit(cert, seed, core.randomBytes(32).wait(),
                             core.randomBytes(32).wait());
  Buf raw = Buf.create();
  for (i32 guard = 0; guard < 100000; guard++) {
    bool more = false;
    match (cli.recv(handle).wait()) {
      case Data(bytes): { raw.pushAll(bytes); more = true; }
      case End: { }
      case Failed(why): { core.warn("tlsserved: recv: " + why); }
    }
    if (!more) { break; }

    i32 ready = readyIn(raw.bytes());
    if (ready == 0) { continue; }
    u8[] all = raw.bytes();
    u8[] whole = u8[ready]();
    for (i32 i = 0; i < ready; i++) { whole[i] = all[i]; }
    raw.dropFront(ready);

    ClientStep st = clientStep(tlsServerFeed(state, whole));
    state = st.state;
    if (st.toSend.len() > 0) { cli.send(handle, st.toSend).wait(); }
    if (st.appData.len() > 0) {
      ClientStep out = clientStep(tlsServerSend(state, reply().toBytes()));
      state = out.state;
      cli.send(handle, out.toSend).wait();
      break;
    }
    // A handshake that failed says so in the phase, and there is nothing further to read.
    if (tlsPhase(state) == 3) { break; }
  }
  cli.closeSocket(handle);
}

export i32 main(Core core, Cli cli) {
  i32 port = 0;
  if (cli.argCount().wait() > 1) {
    string given = string.fromBytes(cli.arg(1).wait());
    u8[] b = given.toBytes();
    port = 0;
    for (i32 i = 0; i < b.len() && b[i] >= '0' && b[i] <= '9'; i++) {
      port = port * 10 + (b[i] - '0');
    }
  }

  u8[] cert = cli.readFile("packages/tls/test/data/server.der").wait().bytes;
  u8[] seed = cli.readFile("packages/tls/test/data/server.seed").wait().bytes;
  if (cert.len() == 0 || seed.len() == 0) {
    core.warn("tlsserved: no certificate — run from the repository root");
    return 1;
  }

  Socket listener = cli.listen("127.0.0.1", port).wait();
  if (listener.handle < 0) {
    core.warn("tlsserved: listen: " + listener.error);
    return 1;
  }
  // The port goes to standard output because the caller asked for zero and cannot otherwise learn
  // which one it got — the same reason `dird` prints its own.
  core.log("tlsserved: listening on 127.0.0.1:" + itoa(listener.port));

  for (i32 served = 0; served < 1000; served++) {
    Socket conn = cli.accept(listener.handle).wait();
    if (conn.handle < 0) { core.warn("tlsserved: accept: " + conn.error); break; }
    serve(core, cli, conn.handle, cert, seed);
  }
  cli.closeSocket(listener.handle);
  return 0;
}
