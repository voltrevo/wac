// Our TLS server with an **RSA** certificate, against OpenSSL.
//
// TLS 1.3 removed PKCS#1 v1.5 from signing, so an RSA certificate means `rsa_pss_rsae_sha256` in
// CertificateVerify and nothing else. This server could only sign with ed25519 until 2026, and the
// reason that mattered is not TLS: **a Tor relay's link certificate is RSA**, ours was ed25519, and a
// relay is therefore distinguishable from every real one by the first thing it sends. See
// `packages/tor/README.md`, *What is not here*.
//
// **Both key sizes, and the second one is here because of what the first one hid.** 1024-bit is what
// tor uses for a link key. 2048 is what anyone outside tor would pick, and this file ran only 1024
// with a comment saying why: "a 2048-bit private-key operation is 2048 squarings and multiplications
// of 2048-bit numbers in `modPowSecret`, and the first version of this test sat in one for four
// minutes before being killed."
//
// That was wrong, and it was wrong in a way worth keeping written down. `modPowSecret` over a
// 2048-bit modulus takes **47 ms** — measured through `packages/crypto/test/wac/rsa_probe.wac`'s
// `modExpSecret`, at 256/512/1024/1536/2048 bits, where the curve is the 8x per doubling the
// arithmetic predicts. What actually happened is that `encodeConn` wrote the modulus behind a
// **one-byte length prefix**, and a 2048-bit modulus is 256 bytes, so `vec8` trapped before the
// handshake had read a byte. The trap surfaced as a hang because the loop caught it and went on
// waiting for a client that was itself waiting. wac-mono 0099.
//
// The certificate and the key are made by OpenSSL rather than by us, and the client is OpenSSL, so
// nothing in this test is ours on both ends — which for a signature scheme is the only arrangement
// worth having. Our PSS signer and our PSS verifier could be wrong together and agree; OpenSSL has no
// such courtesy.
//
// Host-side until 2026-08-19, `issues/system/0161`. **And the 1024-bit case had never run**: the
// TypeScript looped `for (const bits of [1024, 2048])` and its generator ignored the parameter,
// hardcoding `rsa:2048`, so the paragraph above described coverage the file did not have. Two runs of
// the same size, one of them labelled as the other. Fixed here by passing the size through, which is
// how it was found: the 1024 case behaves differently and had to be made to work.

import { binaryPath } from "../../../wactest/src/host.wac";
import { builtProgram } from "../../../wactest/src/built.wac";
import { T } from "../../../wactest/src/assert.wac";
import { Exec, ChildEnv, Clock, Env, Files, Launch, Procs, Sys } from "std";
import { Daemon, start, stop, logOf, waitForLogWithin } from "../../../wactest/src/daemon.wac";
import { quoted } from "../../../wactest/src/childenv.wac";
import { contains } from "../../../wactest/src/strings.wac";
import { have } from "./openssl.wac";
import { freshDir } from "../../../wactest/src/host.wac";
import { flatten } from "core";


static string BODY = "hello from wac over TLS 1.3 with an RSA certificate\n";

/**
 * The colon-separated hex OpenSSL prints for `modulus:` and `privateExponent:`, as bytes.
 *
 * `-noout -text` rather than re-deriving the DER offsets: the field names are stable and the DER
 * layout of a PKCS#8 RSA key is not something this test should know.
 */
u8[] field(string text, string name) {
  i32 at = text.indexOf("\{name}:");
  if (at < 0) { return u8[](); }
  u8[] b = text.toBytes();
  i32 i = at + name.len() + 1;
  i32[] nybbles = i32[].filled(b.len() * 2, 0);
  i32 count = 0;
  // Every continuation line is indented; the first line that is not ends the field.
  bool startOfLine = false;
  while (i < b.len()) {
    i32 c = b[i] as i32;
    if (c == '\n') {
      startOfLine = true;
      i = i + 1;
      continue;
    }
    if (startOfLine) {
      if (c != ' ' && c != '\t') { break; }
      startOfLine = false;
    }
    if (c >= '0' && c <= '9') { nybbles[count] = c - '0'; count = count + 1; }
    else if (c >= 'a' && c <= 'f') { nybbles[count] = c - 'a' + 10; count = count + 1; }
    else if (c >= 'A' && c <= 'F') { nybbles[count] = c - 'A' + 10; count = count + 1; }
    i = i + 1;
  }
  u8[] out = u8[].filled(count / 2, 0);
  for (i32 k = 0; k < out.len(); k++) {
    out[k] = ((nybbles[k * 2] << 4) | nybbles[k * 2 + 1]) as@ u8;
  }
  // OpenSSL prints a leading zero byte on positive integers whose top bit is set.
  if (out.len() > 0 && out[0] == 0) {
    u8[] trimmed = u8[].filled(out.len() - 1, 0);
    for (i32 k = 1; k < out.len(); k++) { trimmed[k - 1] = out[k]; }
    return trimmed;
  }
  return out;
}

/** An RSA key of `bits` and a self-signed certificate for it, both made by OpenSSL. */
string identity(T t, Files fs, Procs procs, string dir, i32 bits) {
  auto genRan = flatten(procs.exec("openssl", [
             "req", "-x509", "-newkey", "rsa:\{bits}", "-keyout", "\{dir}/key.pem",
             "-out", "\{dir}/cert.der", "-days", "1", "-nodes", "-subj", "/CN=wac.test",
             "-outform", "DER"
    ], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? gen = genRan.ok();
  if ((gen is null) || gen!.status != 0) { return "openssl req failed: \{string.fromBytes(gen!.stderr)}"; }

  auto dumpRan = flatten(procs.exec("openssl", ["rsa", "-in", "\{dir}/key.pem", "-noout", "-text"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? dump = dumpRan.ok();
  if ((dump is null) || dump!.status != 0) {
    return "openssl rsa -text failed: \{string.fromBytes(dump!.stderr)}";
  }
  string text = string.fromBytes(dump!.stdout);
  u8[] n = field(text, "modulus");
  u8[] d = field(text, "privateExponent");
  if (n.len() == 0) { return "no modulus in openssl's output"; }
  if (d.len() == 0) { return "no privateExponent in openssl's output"; }
  // The size is asserted rather than assumed, because a generator that quietly ignored the size it was
  // given is the defect this file was carrying. Eight bits of slack: a modulus's top byte is always
  // set, so the length is exact, but the *private exponent* can be a byte short.
  t.eqI32(n.len() * 8, bits, "the modulus is \{bits} bits, as asked");
  fs.writeFile("\{dir}/n.bin", n).wait();
  fs.writeFile("\{dir}/d.bin", d).wait();
  return "";
}

string oneSize(Clock clock, Env env, Files fs, Procs procs, i32 bits) {
  T t = T.create();
  t.isTrue(have(procs, "openssl"), "openssl is on the path");
  if (!have(procs, "openssl")) { return t.report(); }

  string dir = "\{flatten(env.cwd().wait()).unwrap()}/.cache/tls/rsa\{bits}";
  string whyDir = freshDir(fs, dir);
  t.isTrue(whyDir == "", whyDir);

  string why = identity(t, fs, procs, dir, bits);
  t.eqStr(why, "", "openssl made an identity");
  if (why != "") { return t.report(); }

  string bin = "\{dir}/tlsserved";
  // **`builtProgram` rather than `deno run packages/platform/build.ts`** — `design/system/0009` is
  // removing that builder's non-browser targets. It answers a cached `.wasm` at a stable path and
  // rebuilds only when the sources or the compiler move. A `wac app` executable to a fresh temporary
  // name cannot be cached: the output's base name is in the manifest, so two destinations are two
  // artefacts. Measured on `client_test.wac`: 2s cached against 8s not.
  string mod = builtProgram(env, fs, procs, "packages/tls/test/wac/tlsserved.wac", "tlsserved", ["--allow-read", "--allow-net"]);
  t.isTrue(mod != "", "the server built");
  if (mod == "") { return t.report(); }

  Daemon d = start(procs, "\{quoted(binaryPath(env))} \{quoted(mod)} 0 --rsa \{quoted(dir)} --body \{quoted(BODY)}", "\{dir}/log");
  t.isTrue(d.ok(), "tlsserved started — \{d.error}");
  if (!d.ok()) { return t.report(); }
  const string MARK = "listening on 127.0.0.1:";
  if (!waitForLogWithin(clock, fs, d, MARK, 20000)) {
    t.fail("tlsserved never listened. Its output was: \{logOf(fs, d)}");
    stop(procs, d);
    return t.report();
  }
  string log = logOf(fs, d);
  u8[] lb = log.toBytes();
  i32 port = 0;
  for (i32 i = log.indexOf(MARK) + MARK.len(); i < lb.len() && lb[i] >= '0' && lb[i] <= '9'; i++) {
    port = port * 10 + (lb[i] as i32 - '0');
  }

  auto cRan = flatten(procs.exec("openssl", [
             "s_client", "-connect", "127.0.0.1:\{port}", "-tls1_3",
             "-servername", "wac.test", "-quiet", "-verify_quiet"
    ], ("GET / HTTP/1.1\r\nHost: wac.test\r\n\r\n").toBytes(), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? c = cRan.ok();
  string out = string.fromBytes(c!.stdout);
  string err = string.fromBytes(c!.stderr);

  // The server saying it read a request is what separates "the handshake failed" from "the reply did
  // not arrive", and only the first is what a signature problem looks like.
  //
  // **Waited for rather than read once**, because the server's output reaches this log through a
  // relay: it runs as `wac <module.wasm>`, which spawns it and copies its streams, so the line is
  // written some moments after `openssl` has exited. Reading immediately passed on an idle machine
  // and failed under a loaded gate, which is the shape of a race rather than of a signature problem.
  // The `listening` line above is waited for the same way and for the same reason.
  //
  // **And for the same 20 seconds, since 2026-08-29.** It was 5,000 ms while the line above it was
  // 20,000, and that asymmetry is what failed: a gate run turned red here, and the same test passed
  // on its own in 2s immediately afterwards — `issues/system/0203`'s eleventh entry. The two waits
  // are one relay and one machine, so a deadline that is right for *listening* is right for the
  // request that follows it; the shorter one was not a measurement of anything, and 5s against a
  // sub-second normal is not the 3-5x a timeout wants when three agents share five cores.
  //
  // What this costs is that a server which genuinely never answers takes 20s to say so instead of 5.
  // That is the right trade for a check whose failure is otherwise indistinguishable from a real
  // signature bug — which is exactly how it read when it fired.
  t.isTrue(waitForLogWithin(clock, fs, d, "received GET /", 20000),
           "our server got a request — the handshake completed. openssl said: \{err}");
  t.isTrue(contains(out, BODY), "OpenSSL got the body. stdout: \{out} stderr: \{err}");
  // The signature scheme is the point: OpenSSL verified an RSA-PSS CertificateVerify made by us,
  // against a certificate it generated itself.
  t.isFalse(contains(err, "bad signature") || contains(err, "decrypt error"),
            "OpenSSL rejected our signature: \{err}");

  stop(procs, d);
  fs.remove(dir, true).wait();
  return t.report();
}

export string test_openssl_completes_a_handshake_with_our_servers_1024_bit_rsa_certificate(Sys sys) {
  Clock clock = sys.clock();
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  return oneSize(clock, env, fs, procs, 1024);
}

export string test_openssl_completes_a_handshake_with_our_servers_2048_bit_rsa_certificate(Sys sys) {
  Clock clock = sys.clock();
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  return oneSize(clock, env, fs, procs, 2048);
}
