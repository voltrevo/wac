// The TLS 1.3 client.
//
// A client is only as good as what it refuses. Connecting successfully proves the happy path; it says
// nothing about whether the certificate was checked, and a client that accepts every certificate
// connects successfully to everything — including to an attacker. So the interesting tests here are
// the rejections, and each one is paired with the connection that must still succeed, because a
// client that refuses everything passes every rejection test.
//
// Against OpenSSL's `s_server` for the interop direction, and against this repo's own server for the
// round trip, which exercises both halves of the implementation at once and would hide a shared
// misreading of the spec — hence the OpenSSL case.
//
// Host-side until 2026-08-19, `issues/system/0161`. The socket loop that was `host/connect.ts` is now
// `tlsclient.wac`; the floating promise that was `serveOnce` is now `tlsserved.wac`, a program, since
// a wac test is one thread and cannot both `accept` and dial.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli, Exec } from "../../../platform/src/platform.wac";
import { Daemon, start, stop, logOf, waitForLogWithin } from "../../../wactest/src/daemon.wac";
import { quoted } from "../../../wactest/src/childenv.wac";
import { contains } from "../../../wactest/src/strings.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { Store } from "../../src/roots.wac";
import { ClientStep } from "../../src/client.wac";
import { Reply, request, rootsFrom, noRoots, fixedFirstFlight } from "./tlsclient.wac";
import { Server, startServer, stopServer, have, openssl35 } from "./openssl.wac";

const string DATA = "packages/tls/test/data";
const string REQ = "GET / HTTP/1.1\r\nHost: wac.test\r\n\r\n";
const string BODY = "hello from the wac server";

string scratch(Cli cli, string name) {
  string dir = cli.cwd().wait() + "/.cache/tls/" + name;
  cli.remove(dir, true).wait();
  cli.mkdir(dir, true).wait();
  return dir;
}

/** Our own server, built and running, or an empty port and the reason. */
struct Ours {
  Daemon d;
  i32 port;
  string error;
}

Ours ourServer(T t, Cli cli, Core core, string dir) {
  string bin = dir + "/tlsserved";
  Exec built = cli.exec("deno",
    string[]("run", "-A", "packages/platform/build.ts", "packages/tls/test/wac/tlsserved.wac",
             "--allow-read", "--allow-net", "-o", bin), u8[0]()).wait();
  if (!built.ran() || built.status != 0) {
    return Ours(Daemon(-1, "", ""), -1, "tlsserved did not build: " + string.fromBytes(built.stderr));
  }
  // Port 0, and the program says which it got — two agents running the suite cannot collide on it.
  Daemon d = start(cli, quoted(bin) + " 0", dir + "/log");
  if (!d.ok()) { return Ours(d, -1, "tlsserved did not start: " + d.error); }
  const string MARK = "listening on 127.0.0.1:";
  if (!waitForLogWithin(core, cli, d, MARK, 20000)) {
    stop(cli, d);
    return Ours(d, -1, "tlsserved never listened. Its output was: " + logOf(cli, d));
  }
  string log = logOf(cli, d);
  u8[] b = log.toBytes();
  i32 at = log.indexOf(MARK) + MARK.len();
  i32 port = 0;
  for (i32 i = at; i < b.len() && b[i] >= '0' && b[i] <= '9'; i++) { port = port * 10 + (b[i] - '0'); }
  return Ours(d, port, "");
}

/** `now` for the cases that do not care: seconds since the epoch, from the clock. */
i64 nowSeconds(Core core) { return core.nowMillis().wait() / (1000 as i64); }

export string test_client_talks_to_the_wac_server_end_to_end(Core core, Cli cli) {
  T t = T.create();
  string dir = scratch(cli, "roundtrip");
  Ours s = ourServer(t, cli, core, dir);
  t.eqStr(s.error, "", "our server is up");
  if (s.port <= 0) { return t.report(); }

  Reply r = request(core, cli, "127.0.0.1", s.port, "wac.test",
                    rootsFrom(cli, DATA + "/ca.pem"), REQ, nowSeconds(core));
  t.eqStr(r.error, "", "the exchange completed");
  t.eqI32(r.failure, 0, "the handshake succeeded");
  t.isTrue(contains(r.response, "HTTP/1.1 200 OK"), "the server answered: " + r.response);
  t.isTrue(contains(r.response, BODY), "and with its body");
  stop(cli, s.d);
  cli.remove(dir, true).wait();
  return t.report();
}

export string test_client_talks_to_openssls_s_server(Core core, Cli cli) {
  // The round trip above would pass even if both halves misread the spec the same way. OpenSSL cannot
  // make that mistake with us.
  T t = T.create();
  t.isTrue(have(cli, "openssl"), "openssl is on the path");
  if (!have(cli, "openssl")) { return t.report(); }
  string dir = scratch(cli, "ossl");
  Server s = startServer(core, cli, "openssl", DATA + "/leaf.pem", DATA + "/leaf.key",
                         string[0](fill: ""), dir + "/log");
  t.eqStr(s.error, "", "s_server is up");
  if (!s.ok()) { return t.report(); }

  Reply r = request(core, cli, "127.0.0.1", s.port, "wac.test",
                    rootsFrom(cli, DATA + "/ca.pem"), REQ, nowSeconds(core));
  t.eqStr(r.error, "", "the exchange completed");
  t.eqI32(r.failure, 0, "the handshake with openssl succeeded");
  t.isTrue(contains(r.response, "200 ok") || contains(r.response, "200 OK"),
           "openssl answered: " + r.response.slice(0, 200));
  stopServer(cli, s);
  cli.remove(dir, true).wait();
  return t.report();
}

export string test_client_refuses_a_certificate_that_does_not_cover_the_host_asked_for(
    Core core, Cli cli) {
  // The classic failure. The certificate is genuine, in date, and signed by the CA we trust — it is
  // simply for a different name. A client that checks only the signature accepts it, and an attacker
  // who can get a certificate for any domain can then impersonate every domain.
  T t = T.create();
  string dir = scratch(cli, "wrongname");
  Ours s = ourServer(t, cli, core, dir);
  t.eqStr(s.error, "", "our server is up");
  if (s.port <= 0) { return t.report(); }

  Reply r = request(core, cli, "127.0.0.1", s.port, "not-our-name.test",
                    rootsFrom(cli, DATA + "/ca.pem"), "GET / HTTP/1.1\r\n\r\n", nowSeconds(core));
  t.neI32(r.failure, 0, "accepted a certificate for the wrong host");
  // 40 + 7: verifyChain's "no matching name".
  t.eqI32(r.failure, 47, "the name check is what failed");
  stop(cli, s.d);
  cli.remove(dir, true).wait();
  return t.report();
}

export string test_client_refuses_a_certificate_from_an_issuer_it_does_not_trust(Core core, Cli cli) {
  // The same server, and a root that did not sign its certificate. Nothing about the certificate has
  // changed; what changed is whether we have a reason to believe it.
  T t = T.create();
  string dir = scratch(cli, "wrongissuer");
  Ours s = ourServer(t, cli, core, dir);
  t.eqStr(s.error, "", "our server is up");
  if (s.port <= 0) { return t.report(); }

  Reply r = request(core, cli, "127.0.0.1", s.port, "wac.test",
                    rootsFrom(cli, DATA + "/other_ca.pem"), "GET / HTTP/1.1\r\n\r\n",
                    nowSeconds(core));
  t.neI32(r.failure, 0, "accepted a certificate from an untrusted issuer");
  // 45 is "issuer name does not match the root's subject", 46 is "signature does not verify". Either
  // is a correct refusal; which one depends on whether the names collide.
  t.isTrue(r.failure == 45 || r.failure == 46,
           "an issuer failure, got code " + itoa(r.failure));
  stop(cli, s.d);
  cli.remove(dir, true).wait();
  return t.report();
}

export string test_client_refuses_when_the_certificate_is_outside_its_validity_window(
    Core core, Cli cli) {
  // Time is passed in rather than read, so this needs no clock trickery: ask the client to evaluate
  // the same handshake as though it were 1990.
  T t = T.create();
  string dir = scratch(cli, "expired");
  Ours s = ourServer(t, cli, core, dir);
  t.eqStr(s.error, "", "our server is up");
  if (s.port <= 0) { return t.report(); }

  const i64 LONG_AGO = 631152000 as i64;    // 1990-01-01T00:00:00Z
  Reply r = request(core, cli, "127.0.0.1", s.port, "wac.test",
                    rootsFrom(cli, DATA + "/ca.pem"), "GET / HTTP/1.1\r\n\r\n", LONG_AGO);
  t.neI32(r.failure, 0, "accepted a certificate that was not yet valid");
  t.eqI32(r.failure, 41, "the notBefore check is what failed");
  stop(cli, s.d);
  cli.remove(dir, true).wait();
  return t.report();
}

export string test_client_sends_a_client_hello_a_real_server_understands(Core core, Cli cli) {
  // Narrower than the interop tests and much faster to diagnose when it breaks: does the very first
  // flight parse at all? A malformed extension list fails the handshake with no useful signal, and
  // this at least says the failure is later than the hello.
  T t = T.create();
  u8[] seed = u8[32](fill: 0);
  seed[31] = 7;
  ClientStep st = fixedFirstFlight("wac.test", noRoots(), seed);
  u8[] hello = st.toSend;

  t.eqI32(hello[0], 22, "the first record is a handshake record");
  i32 recLen = (hello[3] << 8) | hello[4];
  t.eqI32(5 + recLen, hello.len(), "the record length matches");
  t.eqI32(hello[5], 1, "the first message is a ClientHello");
  i32 msgLen = (hello[6] << 16) | (hello[7] << 8) | hello[8];
  t.eqI32(9 + msgLen, hello.len(), "the message length matches");
  // legacy_version must say 1.2 whatever we actually support.
  t.eqI32(hello[9], 3, "legacy_version's first byte is 3");
  t.eqI32(hello[10], 3, "and its second is 3 — 0x0303");
  return t.report();
}

/** One handshake against `s_server` with the named key pair. */
string againstOpenSsl(Core core, Cli cli, string kind, string[] extra, string name) {
  T t = T.create();
  t.isTrue(have(cli, "openssl"), "openssl is on the path");
  if (!have(cli, "openssl")) { return t.report(); }
  string dir = scratch(cli, name);
  Server s = startServer(core, cli, "openssl",
                         DATA + "/" + kind + "_leaf.pem", DATA + "/" + kind + "_leaf.key",
                         extra, dir + "/log");
  t.eqStr(s.error, "", "s_server is up");
  if (!s.ok()) { return t.report(); }

  Reply r = request(core, cli, "127.0.0.1", s.port, "wac.test",
                    rootsFrom(cli, DATA + "/" + kind + "_ca.pem"), REQ, nowSeconds(core));
  t.eqStr(r.error, "", "the exchange completed");
  t.eqI32(r.failure, 0, kind + ": the handshake succeeded");
  t.isTrue(contains(r.response, "200 ok") || contains(r.response, "200 OK"),
           kind + ": openssl answered — " + r.response.slice(0, 120));
  stopServer(cli, s);
  cli.remove(dir, true).wait();
  return t.report();
}

export string test_client_completes_a_handshake_against_an_ecdsa_p256_certificate(Core core, Cli cli) {
  // Ed25519 is what this repo issues itself; ECDSA-P256 is what the web mostly uses, and it exercises
  // a different key type in the certificate, a different signature in CertificateVerify, and a
  // different DER shape — ECDSA signatures arrive wrapped in a SEQUENCE of two INTEGERs, which have to
  // be unwrapped and zero-padded back to 32.
  return againstOpenSsl(core, cli, "ec", string[0](fill: ""), "ec");
}

export string test_client_completes_a_handshake_against_an_rsa_2048_certificate(Core core, Cli cli) {
  // The other half of the web. RSA brings a third encoding quirk: the modulus is a DER INTEGER, which
  // is signed, so almost every modulus carries a leading zero byte that is not part of the key — and
  // using that length as the key size fails every signature.
  return againstOpenSsl(core, cli, "rsa", string[0](fill: ""), "rsa");
}

export string test_client_completes_a_handshake_when_only_p256_key_exchange_is_offered(
    Core core, Cli cli) {
  // Pins `groupP256()` — 0x0017 — against a server that will accept nothing else. Our client offers
  // three groups and a server normally picks the hybrid or x25519, so the P-256 code point was never
  // exercised: mutation testing replaced `groupP256`'s body with a constant and every test stayed
  // green. A wrong code point here is not a parse error, it is a HelloRetryRequest loop or a handshake
  // failure against the one group RFC 8446 §9.1 makes mandatory.
  return againstOpenSsl(core, cli, "ec", string[]("-groups", "P-256"), "p256only");
}

export string test_client_negotiates_x25519mlkem768_against_a_post_quantum_only_server(
    Core core, Cli cli) {
  // The server accepts nothing else, so a client whose 1216-byte share were built the wrong way round
  // — ML-KEM and X25519 are concatenated in one order for this group and the other order for
  // SecP256r1MLKEM768 — would fail rather than fall back.
  T t = T.create();
  string binary = openssl35(cli);
  if (binary == "") {
    // A skip that prints nothing reads as coverage. Ubuntu 24.04 ships 3.0.13, which predates
    // X25519MLKEM768 entirely; `tools/openssl35.sh` builds one, and this says so rather than passing
    // quietly.
    core.warn("tls client test: skipped — no OpenSSL 3.5, so the ML-KEM interop did not run. " +
              "`tools/openssl35.sh` builds one.");
    return t.report();
  }
  string dir = scratch(cli, "mlkem");
  Server s = startServer(core, cli, binary, DATA + "/ec_leaf.pem", DATA + "/ec_leaf.key",
                         string[]("-groups", "X25519MLKEM768"), dir + "/log");
  t.eqStr(s.error, "", "s_server is up");
  if (!s.ok()) { return t.report(); }

  Reply r = request(core, cli, "127.0.0.1", s.port, "wac.test",
                    rootsFrom(cli, DATA + "/ec_ca.pem"), REQ, nowSeconds(core));
  t.eqStr(r.error, "", "the exchange completed");
  t.eqI32(r.failure, 0, "the hybrid handshake succeeded");
  t.isTrue(contains(r.response, "200 ok") || contains(r.response, "200 OK"),
           "openssl 3.5 answered — " + r.response.slice(0, 120));
  stopServer(cli, s);
  cli.remove(dir, true).wait();
  return t.report();
}
