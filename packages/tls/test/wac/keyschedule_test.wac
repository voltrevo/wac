// TLS 1.3's key schedule, in wac, against RFC 8448 and an HMAC passed in from the host.
//
// Two kinds of oracle here and they check different things. **RFC 8448** is the
// authoritative one: a published trace of a real handshake, so agreeing with it means
// agreeing with the protocol rather than with another implementation's reading of it.
// The **HMAC callback** covers everything the trace does not — the labels and lengths the
// schedule uses that no published vector exercises — by rebuilding HKDF-Expand-Label
// independently from a primitive.
//
// That second one is why this file reaches out to `test/oracle.mjs`. Rebuilding HKDF from a hash
// we also wrote would prove nothing: an error in the hash cancels out on both sides. `node:crypto`
// supplies HMAC-SHA256 and knows nothing about TLS, so the expansion around it is checked
// by something that cannot share its mistakes. Host-side until 2026-08-17, `issues/system/0161`.
//
// **The expansions run in lockstep rather than one at a time.** Through `Cli.exec` an HMAC costs a
// process, and HKDF-Expand chains T(1), T(2), … so the blocks of a single expansion cannot be asked
// for together. But the *expansions* are independent of each other, so round `k` asks for block `k`
// of every expansion that still wants one: the twelve labels below cost two rounds, not thirteen,
// and only the 255-byte output goes past that.
//
// **The encoding limits are here too, as of 2026-08-16.** They were the last thing left host-side,
// on the grounds that "a trap unwinds the module rather than returning, so wac cannot assert one" —
// which was never quite it. A trap unwinds *this* module and nothing
// else, and `test_traps_*` is how a test says it wants one. `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";
import {
  deriveSecret, earlySecret, emptyHash, expandLabel, finishedVerify, handshakeSecret,
  masterSecret, nextTrafficSecret, trafficKeyIv,
} from "../../src/keyschedule.wac";
import { equal } from "../../../bytes/src/slice.wac";
import { decoded } from "../../../codec/src/hex.wac";
import { Lines, Answers, ask, hex, word } from "../../../wactest/src/oracle.wac";
import { Core, Cli } from "std/platform.wac";

const string ORACLE = "packages/tls/test/oracle.mjs";


u8[] fill(i32 n, i32 a, i32 b) {
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = (i * a + b) & 0xFF; }
  return out;
}

/**
 * The `info` of HKDF-Expand-Label, per RFC 8446 §7.1.
 *
 * This is the part worth checking independently: a two-byte length, then "tls13 " prefixed to the
 * label with a one-byte count, then the context with its own. Getting the two counts the wrong way
 * round produces an expansion that is stable, self-consistent, and wrong against every other
 * implementation.
 */
u8[] refInfo(string label, u8[] ctx, i32 len) {
  u8[] full = ("tls13 " + label).toBytes();
  u8[] info = u8[2 + 1 + full.len() + 1 + ctx.len()]();
  info[0] = (len >> 8) & 0xFF;
  info[1] = len & 0xFF;
  info[2] = full.len();
  for (i32 i = 0; i < full.len(); i++) { info[3 + i] = full[i]; }
  info[3 + full.len()] = ctx.len();
  for (i32 i = 0; i < ctx.len(); i++) { info[4 + full.len() + i] = ctx[i]; }
  return info;
}

/** One expansion in flight: what it wants, and how far the lockstep has got with it. */
struct Expansion {
  u8[] secret;
  u8[] info;
  i32 want;
  u8[] out;
  u8[] prev;
  i32 done;
  i32 block;
}

Expansion expansion(u8[] secret, string label, u8[] ctx, i32 len) {
  return Expansion(secret, refInfo(label, ctx, len), len, u8[len](), u8[0](), 0, 1);
}

/**
 * HKDF-Expand-Label rebuilt on the host's HMAC, all of `e` at once.
 *
 * Every round asks for one more block of every expansion that is still short, so the cost is the
 * *longest* expansion rather than the total. Returns false if the oracle would not answer, in which
 * case `ask` has already recorded why.
 */
bool refExpand(T t, Cli cli, Expansion[] e) {
  bool more = true;
  while (more) {
    Lines lines = Lines.create();
    i32[] which = i32[e.len()]();
    i32 n = 0;
    for (i32 i = 0; i < e.len(); i++) {
      if (e[i].done >= e[i].want) { continue; }
      u8[] input = u8[e[i].prev.len() + e[i].info.len() + 1]();
      for (i32 j = 0; j < e[i].prev.len(); j++) { input[j] = e[i].prev[j]; }
      for (i32 j = 0; j < e[i].info.len(); j++) { input[e[i].prev.len() + j] = e[i].info[j]; }
      input[input.len() - 1] = e[i].block;
      lines.add("hmac256 " + hex(e[i].secret) + " " + hex(input));
      which[n] = i;
      n = n + 1;
    }
    if (n == 0) { return true; }
    Answers a = ask(t, cli, "node", string[](ORACLE), lines, "HMAC-SHA256");
    if (!a.ok) { return false; }
    for (i32 k = 0; k < n; k++) {
      Expansion x = e[which[k]];
      x.prev = decoded(word(a.lines[k], 1));
      for (i32 i = 0; i < x.prev.len() && x.done + i < x.want; i++) {
        x.out[x.done + i] = x.prev[i];
      }
      x.done = x.done + x.prev.len();
      x.block = x.block + 1;
    }
  }
  return true;
}

export string test_the_rfc_8448_chain(Core core, Cli cli) {
  // RFC 8448 §3, the simple 1-RTT handshake. Published values, so this is agreement with
  // the protocol rather than with ourselves. Values that did not match the trace were
  // removed when this was written rather than adjusted to what we produce.
  T t = T.create();
  u8[] shared = decoded("8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d");
  u8[] chsh = decoded("860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8");

  u8[] early = earlySecret(u8[32]());
  t.eqBytes(early, decoded("33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a"),
            "early secret");
  u8[] hs = handshakeSecret(early, shared);
  t.eqBytes(hs, decoded("1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac"),
            "handshake secret");
  t.eqBytes(deriveSecret(hs, "c hs traffic".toBytes(), chsh),
            decoded("b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21"),
            "client handshake traffic secret");
  t.eqBytes(deriveSecret(hs, "s hs traffic".toBytes(), chsh),
            decoded("b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38"),
            "server handshake traffic secret");
  return t.report();
}

export string test_expand_label_agrees_with_an_independent_build(Core core, Cli cli) {
  // Every label the schedule uses, plus the shapes around them: an empty context, a
  // hash-length context, a one-byte output and a multi-block one.
  T t = T.create();
  u8[] secret = fill(32, 7, 3);
  string[] labels = string[](
    "derived", "c hs traffic", "s hs traffic", "c ap traffic", "s ap traffic",
    "res master", "key", "iv", "finished", "traffic upd", "x", "mid",
    // One byte of output, which needs one HMAC block and most of it discarded.
    "x");
  i32[] ctxLens = i32[](32, 32, 32, 32, 32, 32, 0, 0, 0, 0, 0, 255, 0);
  i32[] outLens = i32[](32, 32, 32, 32, 32, 32, 16, 12, 32, 32, 255, 32, 1);

  Expansion[] want = Expansion[labels.len()](fill: expansion(secret, "x", u8[0](), 1));
  for (i32 i = 0; i < labels.len(); i++) {
    want[i] = expansion(secret, labels[i], fill(ctxLens[i], 13, 1), outLens[i]);
  }
  if (!refExpand(t, cli, want)) { return t.report(); }

  for (i32 i = 0; i < labels.len(); i++) {
    t.eqBytes(expandLabel(secret, labels[i].toBytes(), fill(ctxLens[i], 13, 1), outLens[i]),
              want[i].out,
              "expandLabel " + labels[i] + " len " + itoa64(outLens[i] as i64));
  }
  return t.report();
}

export string test_traffic_keys_come_from_the_pinned_secret(Core core, Cli cli) {
  // Derived from a secret RFC 8448 has already pinned above, so a failure here is in the
  // key derivation rather than anywhere upstream of it.
  T t = T.create();
  u8[] serverHs = decoded("b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38");
  i32[] keyLens = i32[](16, 32);
  Expansion[] want = Expansion[keyLens.len() * 2](fill: expansion(serverHs, "iv", u8[0](), 12));
  for (i32 k = 0; k < keyLens.len(); k++) {
    want[k * 2] = expansion(serverHs, "key", u8[0](), keyLens[k]);
    want[k * 2 + 1] = expansion(serverHs, "iv", u8[0](), 12);
  }
  if (!refExpand(t, cli, want)) { return t.report(); }

  for (i32 k = 0; k < keyLens.len(); k++) {
    i32 keyLen = keyLens[k];
    u8[] got = trafficKeyIv(serverHs, keyLen);
    u8[] wantKey = want[k * 2].out;
    u8[] wantIv = want[k * 2 + 1].out;
    t.eqI32(got.len(), keyLen + 12, "key and iv are concatenated");
    bool ok = true;
    for (i32 i = 0; i < keyLen; i++) { if (got[i] != wantKey[i]) { ok = false; } }
    for (i32 i = 0; i < 12; i++) { if (got[keyLen + i] != wantIv[i]) { ok = false; } }
    t.isTrue(ok, "traffic key and iv at keyLen " + itoa64(keyLen as i64));
  }
  return t.report();
}

export string test_every_derivation_depends_on_everything_it_should() {
  // No oracle: the claim is that changing any input changes the output. A schedule that
  // ignored its transcript, or its shared secret, would agree with itself forever and
  // interoperate with nobody — and would pass any test that only checks one fixed chain.
  T t = T.create();
  u8[] a = fill(32, 5, 1);
  u8[] b = fill(32, 5, 2);
  u8[] ctxA = fill(32, 9, 4);
  u8[] ctxB = fill(32, 9, 5);

  t.isFalse(equal(earlySecret(a), earlySecret(b)), "early secret follows its PSK");
  u8[] e = earlySecret(a);
  t.isFalse(equal(handshakeSecret(e, a), handshakeSecret(e, b)),
            "handshake secret follows the shared secret");
  t.isFalse(equal(handshakeSecret(earlySecret(a), a), handshakeSecret(earlySecret(b), a)),
            "handshake secret follows the early secret");
  u8[] hs = handshakeSecret(e, a);
  t.isFalse(equal(deriveSecret(hs, "c hs traffic".toBytes(), ctxA),
                 deriveSecret(hs, "c hs traffic".toBytes(), ctxB)),
            "derived secrets follow the transcript");
  t.isFalse(equal(deriveSecret(hs, "c hs traffic".toBytes(), ctxA),
                 deriveSecret(hs, "s hs traffic".toBytes(), ctxA)),
            "client and server secrets differ");
  t.isFalse(equal(trafficKeyIv(a, 16), trafficKeyIv(b, 16)), "traffic keys follow the secret");
  t.isFalse(equal(nextTrafficSecret(a), a), "a key update moves the secret");
  t.isFalse(equal(masterSecret(hs), hs), "the master secret is not the handshake secret");
  return t.report();
}

export string test_finished_binds_to_the_transcript_and_the_sender() {
  T t = T.create();
  u8[] cs = fill(32, 3, 1);
  u8[] ss = fill(32, 3, 9);
  u8[] thA = fill(32, 11, 2);
  u8[] thB = fill(32, 11, 3);
  t.isFalse(equal(finishedVerify(cs, thA), finishedVerify(cs, thB)),
            "Finished follows the transcript");
  t.isFalse(equal(finishedVerify(cs, thA), finishedVerify(ss, thA)),
            "Finished follows the sender's secret");
  return t.report();
}

export string test_the_empty_context_hash_is_sha256_of_nothing(Core core, Cli cli) {
  // Not checkable against the HMAC oracle directly, so it is pinned to the published
  // constant — the SHA-256 of the empty string, which appears in RFC 8446 §7.1 itself.
  T t = T.create();
  t.eqBytes(emptyHash(),
            decoded("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"),
            "SHA-256 of the empty string");
  return t.report();
}

/**
 * A label the one-byte length cannot express.
 *
 * `HKDF-Expand-Label` writes the label and the context each behind a one-byte length, and
 * `"tls13 "` plus 250 characters is 256. Truncated rather than refused, a 256-byte label silently
 * becomes a label of *zero*, and every peer derives a different key from the one we do.
 */
u8[] zeds(i32 n) {
  u8[] b = u8[n]();
  for (i32 i = 0; i < n; i++) { b[i] = 'z'; }
  return b;
}

export string test_traps_on_a_label_longer_than_the_encoding_allows() {
  expandLabel(u8[32](), zeds(250), u8[0](), 32);
  return "";
}

/** The same for the context, behind its own one-byte length. */
export string test_traps_on_a_context_longer_than_the_encoding_allows() {
  expandLabel(u8[32](), "key".toBytes(), u8[256](), 32);
  return "";
}

/** And the largest that does fit must still work, or the bound is off by one. */
export string test_the_largest_label_and_context_that_fit_are_accepted() {
  T t = T.create();
  t.eqI32(expandLabel(u8[32](), zeds(249), u8[255](), 32).len(), 32,
          "249-character label and 255-byte context");
  return t.report();
}
