// X25519MLKEM768, tested in wac with no oracle.
//
// The hybrid needs no independent implementation to be checked, which is worth saying
// because it is not obvious: the properties that matter are relations between its own
// outputs. Both sides reaching the same secret, each half moving only when its own input
// moves, ML-KEM's share coming first — none of those is a value someone else has to tell
// us. The one thing an outside implementation adds is interoperability, and that is
// `client.test.ts` negotiating against OpenSSL 3.5, which stays where it is.
//
// Everything here was TypeScript this morning, reaching in through a probe. **The length refusals
// joined it on 2026-08-17** — they had stayed behind on the grounds that a trap unwinds the module
// rather than returning, so wac could not assert one. It unwinds *this* module and nothing else,
// and `test_traps_*` is how a test says it wants one. `issues/system/0161`.
//
// Twenty-one of them, and none of the eight guards they cover was reached by anything until the
// refusals were written: the hybrid was only ever driven through whole handshakes, where the
// lengths are right by construction. Both sides of each guard are checked, because a short input
// would mostly trap anyway on a read past the end — a long one has its tail silently ignored, and
// that is the half nothing tested.

import { T } from "../../../wactest/src/assert.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";
import {
  hybridClientOffer, hybridServerAccept, hybridClientFinish,
  groupX25519MlKem768, hybridClientShareLen, hybridServerShareLen, hybridSecretLen,
} from "../../src/hybrid.wac";
import { equal, slice } from "../../../bytes/src/slice.wac";

const i32 DK_LEN = 2400;
const i32 EK_LEN = 1184;
const i32 CT_LEN = 1088;

u8[] pattern(i32 n, i32 seed) {
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = (i * 31 + seed) & 0xFF; }
  return out;
}



export string test_the_code_point_and_the_three_lengths() {
  // Against draft-ietf-tls-ecdhe-mlkem rather than against ourselves. A share length that
  // agrees with the implementation that produced it says nothing.
  T t = T.create();
  t.eqI32(groupX25519MlKem768(), 0x11EC, "the named group code point");
  t.eqI32(hybridClientShareLen(), EK_LEN + 32, "client share: ML-KEM key plus X25519");
  t.eqI32(hybridServerShareLen(), CT_LEN + 32, "server share: ciphertext plus X25519");
  t.eqI32(hybridSecretLen(), 64, "the shared secret is two 32-byte halves");
  return t.report();
}

export string test_both_sides_reach_the_same_secret() {
  T t = T.create();
  u8[] offer = hybridClientOffer(pattern(64, 1), pattern(32, 2));
  t.eqI32(offer.len(), hybridClientShareLen() + DK_LEN, "the offer carries its own decap key");

  u8[] share = slice(offer, 0, hybridClientShareLen());
  u8[] accepted = hybridServerAccept(share, pattern(32, 4), pattern(32, 3));
  t.eqI32(accepted.len(), hybridServerShareLen() + hybridSecretLen(), "accept returns share and secret");

  u8[] serverSecret = slice(accepted, hybridServerShareLen(), accepted.len());
  u8[] clientSecret = hybridClientFinish(offer, slice(accepted, 0, hybridServerShareLen()),
                                         pattern(32, 2));
  t.eqBytes(clientSecret, serverSecret, "the two sides agree");
  return t.report();
}

export string test_the_secret_depends_on_both_halves() {
  // The property the whole construction exists for, and the one a round trip cannot see.
  // An implementation that concatenated the ML-KEM secret with a constant, or dropped the
  // X25519 half entirely, would agree with itself perfectly and be exactly as strong as
  // the half it kept.
  T t = T.create();
  u8[] offer = hybridClientOffer(pattern(64, 5), pattern(32, 6));
  u8[] share = slice(offer, 0, hybridClientShareLen());

  u8[] base = slice(hybridServerAccept(share, pattern(32, 8), pattern(32, 7)),
                    hybridServerShareLen(), hybridServerShareLen() + hybridSecretLen());

  // Change only the ML-KEM randomness: the first half must move, the second must not,
  // because neither X25519 key changed.
  u8[] otherM = slice(hybridServerAccept(share, pattern(32, 9), pattern(32, 7)),
                      hybridServerShareLen(), hybridServerShareLen() + hybridSecretLen());
  t.isFalse(equal(slice(base, 0, 32), slice(otherM, 0, 32)),
            "a different ML-KEM message moves the ML-KEM half");
  t.isTrue(equal(slice(base, 32, 64), slice(otherM, 32, 64)),
           "and leaves the X25519 half alone");

  // Change only the server's X25519 key: the reverse.
  u8[] otherX = slice(hybridServerAccept(share, pattern(32, 8), pattern(32, 10)),
                      hybridServerShareLen(), hybridServerShareLen() + hybridSecretLen());
  t.isFalse(equal(slice(base, 32, 64), slice(otherX, 32, 64)),
            "a different X25519 key moves the X25519 half");
  t.isTrue(equal(slice(base, 0, 32), slice(otherX, 0, 32)),
           "and leaves the ML-KEM half alone");
  return t.report();
}

export string test_ml_kem_comes_first_in_both_directions() {
  // A fact about the registry rather than a principle: SecP256r1MLKEM768 puts its ECDHE
  // half first. So it is pinned positionally, not inferred from a round trip that agrees
  // with itself.
  T t = T.create();
  u8[] a = hybridClientOffer(pattern(64, 11), pattern(32, 12));
  u8[] b = hybridClientOffer(pattern(64, 11), pattern(32, 13));
  t.eqBytes(slice(a, 0, EK_LEN), slice(b, 0, EK_LEN),
            "changing the X25519 scalar leaves the ML-KEM key untouched");
  t.isFalse(equal(slice(a, EK_LEN, hybridClientShareLen()),
                      slice(b, EK_LEN, hybridClientShareLen())),
            "and does move the X25519 key that follows it");

  u8[] share = slice(a, 0, hybridClientShareLen());
  u8[] p = hybridServerAccept(share, pattern(32, 14), pattern(32, 15));
  u8[] q = hybridServerAccept(share, pattern(32, 14), pattern(32, 16));
  t.eqBytes(slice(p, 0, CT_LEN), slice(q, 0, CT_LEN),
            "changing the server's X25519 key leaves the ciphertext untouched");
  t.isFalse(equal(slice(p, CT_LEN, hybridServerShareLen()),
                      slice(q, CT_LEN, hybridServerShareLen())),
            "and does move its public key");
  return t.report();
}

export string test_a_tampered_share_gives_a_different_secret_not_an_error() {
  // ML-KEM's implicit rejection, carried up through the hybrid. Decapsulating a bad
  // ciphertext must return some other secret rather than reporting failure — reporting it
  // would hand an attacker a decryption oracle — so tampering surfaces later, as a
  // Finished that does not verify.
  //
  // This is the one place where "it does not trap" is the assertion, and wac can make it:
  // a trap here would fail the test by unwinding, which is the outcome we are forbidding.
  T t = T.create();
  u8[] offer = hybridClientOffer(pattern(64, 17), pattern(32, 18));
  u8[] share = slice(offer, 0, hybridClientShareLen());
  u8[] accepted = hybridServerAccept(share, pattern(32, 19), pattern(32, 20));
  u8[] serverShare = slice(accepted, 0, hybridServerShareLen());
  u8[] good = hybridClientFinish(offer, serverShare, pattern(32, 18));

  i32[] spots = i32[](0, CT_LEN - 1, CT_LEN, hybridServerShareLen() - 1);
  for (i32 k = 0; k < spots.len(); k++) {
    u8[] bad = u8[serverShare.len()]();
    for (i32 i = 0; i < bad.len(); i++) { bad[i] = serverShare[i]; }
    bad[spots[k]] = bad[spots[k]] ^ 1;
    u8[] got = hybridClientFinish(offer, bad, pattern(32, 18));
    t.isFalse(equal(got, good),
              "tampering at byte " + itoa64(spots[k] as i64) + " changes the secret");
  }
  return t.report();
}

// ── The length refusals ──────────────────────────────────────────────────────
//
// The lengths are spelled out rather than read from `hybridClientShareLen()` and its siblings: a
// refusal test that took its bound from the thing under test would follow the bound wherever it
// moved. A client share is ML-KEM's 1184-byte encapsulation key then a 32-byte X25519 point; a
// server share is the 1088-byte ciphertext then another point; the offer a client keeps is its
// share followed by the 2400-byte decapsulation key.

const i32 CLIENT_SHARE = EK_LEN + 32;
const i32 SERVER_SHARE = CT_LEN + 32;
const i32 OFFER = CLIENT_SHARE + DK_LEN;

/**
 * The genuine values, so a refusal test is not passing because everything traps.
 *
 * **The off-by-one cases are built from these rather than from `pattern`,** and that is not tidiness.
 * A 1217-byte share of arbitrary bytes traps at ML-KEM's coefficient validation whatever its length,
 * so a length guard weakened from `!=` to `<` still looked refused. Only a share that is genuine
 * except for its length asks about the length.
 */
u8[] goodSeed() { return pattern(64, 21); }
u8[] goodPriv() { return pattern(32, 22); }
u8[] goodOffer() { return hybridClientOffer(goodSeed(), goodPriv()); }
u8[] goodClientShare() { return slice(goodOffer(), 0, CLIENT_SHARE); }
u8[] goodServerShare() {
  return slice(hybridServerAccept(goodClientShare(), pattern(32, 23), pattern(32, 24)),
               0, SERVER_SHARE);
}

/** `b` with one byte appended, and `b` with its last byte removed. */
u8[] plusByte(u8[] b) {
  u8[] o = u8[b.len() + 1]();
  for (i32 i = 0; i < b.len(); i++) { o[i] = b[i]; }
  return o;
}
u8[] minusByte(u8[] b) { return slice(b, 0, b.len() - 1); }

export string test_the_genuine_lengths_still_work() {
  // The canary for everything below: the guards must be rejecting the odd ones out rather than
  // everything, and a file of twenty-one traps cannot say that on its own.
  T t = T.create();
  t.eqI32(hybridClientFinish(goodOffer(), goodServerShare(), goodPriv()).len(), hybridSecretLen(),
          "the genuine call still produces a secret");
  return t.report();
}

export string test_traps_offer_refuses_a_0_byte_kem_seed() {
  hybridClientOffer(pattern(0, 1), goodPriv());
  return "";
}

export string test_traps_offer_refuses_a_63_byte_kem_seed() {
  hybridClientOffer(pattern(63, 1), goodPriv());
  return "";
}

export string test_traps_offer_refuses_a_65_byte_kem_seed() {
  hybridClientOffer(pattern(65, 1), goodPriv());
  return "";
}

/**
 * The one guard here that has a second line of defence, so weakening it does not show up.
 *
 * A 64-byte seed is what `mlkemKeyGen` takes, and it checks the length itself — so `!=` relaxed to
 * `<` still refuses this. There is no "genuine except for its length" 128-byte seed to ask a
 * sharper question with. The case stays because the refusal is what a caller sees, whichever guard
 * produces it.
 */
export string test_traps_offer_refuses_a_128_byte_kem_seed() {
  hybridClientOffer(pattern(128, 1), goodPriv());
  return "";
}

export string test_traps_offer_refuses_a_0_byte_x25519_scalar() {
  hybridClientOffer(goodSeed(), pattern(0, 1));
  return "";
}

export string test_traps_accept_refuses_a_0_byte_x25519_scalar() {
  hybridServerAccept(goodClientShare(), pattern(32, 2), pattern(0, 1));
  return "";
}

export string test_traps_accept_refuses_a_0_byte_message() {
  hybridServerAccept(goodClientShare(), pattern(0, 1), goodPriv());
  return "";
}

export string test_traps_finish_refuses_a_0_byte_x25519_scalar() {
  hybridClientFinish(goodOffer(), goodServerShare(), pattern(0, 1));
  return "";
}

export string test_traps_offer_refuses_a_31_byte_x25519_scalar() {
  hybridClientOffer(goodSeed(), pattern(31, 1));
  return "";
}

export string test_traps_accept_refuses_a_31_byte_x25519_scalar() {
  hybridServerAccept(goodClientShare(), pattern(32, 2), pattern(31, 1));
  return "";
}

export string test_traps_accept_refuses_a_31_byte_message() {
  hybridServerAccept(goodClientShare(), pattern(31, 1), goodPriv());
  return "";
}

export string test_traps_finish_refuses_a_31_byte_x25519_scalar() {
  hybridClientFinish(goodOffer(), goodServerShare(), pattern(31, 1));
  return "";
}

export string test_traps_offer_refuses_a_33_byte_x25519_scalar() {
  hybridClientOffer(goodSeed(), pattern(33, 1));
  return "";
}

export string test_traps_accept_refuses_a_33_byte_x25519_scalar() {
  hybridServerAccept(goodClientShare(), pattern(32, 2), pattern(33, 1));
  return "";
}

export string test_traps_accept_refuses_a_33_byte_message() {
  hybridServerAccept(goodClientShare(), pattern(33, 1), goodPriv());
  return "";
}

export string test_traps_finish_refuses_a_33_byte_x25519_scalar() {
  hybridClientFinish(goodOffer(), goodServerShare(), pattern(33, 1));
  return "";
}

export string test_traps_accept_refuses_a_client_share_that_is_0() {
  hybridServerAccept(pattern(0, 1), pattern(32, 2), goodPriv());
  return "";
}

export string test_traps_accept_refuses_a_client_share_that_is_one_byte_short() {
  hybridServerAccept(minusByte(goodClientShare()), pattern(32, 2), goodPriv());
  return "";
}

export string test_traps_accept_refuses_a_client_share_that_is_one_byte_long() {
  hybridServerAccept(plusByte(goodClientShare()), pattern(32, 2), goodPriv());
  return "";
}

export string test_traps_finish_refuses_a_server_share_that_is_0() {
  hybridClientFinish(goodOffer(), pattern(0, 1), goodPriv());
  return "";
}

export string test_traps_finish_refuses_a_server_share_that_is_one_byte_short() {
  hybridClientFinish(goodOffer(), minusByte(goodServerShare()), goodPriv());
  return "";
}

export string test_traps_finish_refuses_a_server_share_that_is_one_byte_long() {
  hybridClientFinish(goodOffer(), plusByte(goodServerShare()), goodPriv());
  return "";
}

export string test_traps_finish_refuses_a_retained_offer_that_is_0() {
  hybridClientFinish(pattern(0, 1), goodServerShare(), goodPriv());
  return "";
}

export string test_traps_finish_refuses_a_retained_offer_that_is_one_byte_short() {
  hybridClientFinish(minusByte(goodOffer()), goodServerShare(), goodPriv());
  return "";
}

export string test_traps_finish_refuses_a_retained_offer_that_is_one_byte_long() {
  hybridClientFinish(plusByte(goodOffer()), goodServerShare(), goodPriv());
  return "";
}
