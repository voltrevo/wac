// Hand-crafted malformed deflate streams.
//
// These exist because mutation testing found a hole: removing inflate's "distance points before the
// start of the output" check entirely did not fail a single test. Random corruption never reaches
// that code — a flipped bit in a Huffman-coded stream almost always breaks the symbol decode first,
// so the stream dies well before a distance is ever validated. Reaching those checks takes a stream
// built on purpose.
//
// Streams are assembled bit by bit with the fixed Huffman code, which needs no transmitted tables and
// so can be written by hand. The builder lives in `streams.wac`, shared with
// `inflatedynamicadversarial_test.wac`.
//
// One export per refusal, because a trap ends the call. That is the right shape here and not a tax:
// every case below is a *different* malformation with a different reason, and the positive controls
// beside them are ordinary returning tests.
//
// **What these cannot see, measured on the move.** Deleting the distance bound outright —
// `if (d > out.base + out.len) { trap; }` in `inflateBlock` — fails none of them, and neither did the
// host-side versions. `pushMatch` is handed `out.base + out.len - d`, which is negative for every
// stream here, and wasm traps on the array index a moment later. So the refusal cases prove the
// stream is rejected and say nothing about *which* check rejected it; the explicit bound's
// contribution is where the trap happens, not whether it does.
//
// The positive controls are what actually pin it. Tightening the bound to `d >= out.base + out.len`
// fails `test_distance_exactly_equal_to_the_output_length_is_valid` and nothing else, which is why
// that test is here and why a refusal test in this file is only half a pair.
//
// Host-side until 2026-08-17. `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { inflate } from "../../src/inflate.wac";
import { Bits, fixedBlock, withBytes } from "./streams.wac";

/**
 * A distance pointing before the start of the output.
 *
 * One literal, so the output is 1 byte. Then a length-3 match at distance 5, which would read four
 * bytes before the output began.
 *
 *     symbol 257 = length 3 (no extra bits)
 *     distance symbol 4 = distances 5-6, 1 extra bit; extra 0 -> distance 5
 */
export string test_traps_a_distance_before_the_start_of_the_output() {
  Bits b = fixedBlock();
  b.literal(0x41);          // "A", output length is now 1
  b.litLenSymbol(257);      // length 3
  b.code(4, 5);
  b.bits(0, 1);             // distance 5 > 1
  inflate(b.done());
  return "distance 5 with 1 byte of output was accepted";
}

/**
 * Distance exactly equal to the output length is valid.
 *
 * The positive control for the case above: distance == output length reaches the very first byte,
 * which is legal and must NOT trap. Without this, the bound could be tightened to `d >= out.len` and
 * look fine.
 */
export string test_distance_exactly_equal_to_the_output_length_is_valid() {
  T t = T.create();
  Bits b = fixedBlock();
  b.literal(0x41);          // "A"
  b.litLenSymbol(257);      // length 3
  b.code(0, 5);             // distance symbol 0 = distance 1, no extra bits
  b.litLenSymbol(256);      // end of block
  t.eqStr(string.fromBytes(inflate(b.done())), "AAAA", "distance 1 with 1 byte of output");
  return t.report();
}

/**
 * A distance just past the output length.
 *
 * Two literals, then distance 3 — one past the 2 bytes available. This is the exact off-by-one the
 * bound protects, and the case a `d > out.len + 1` bound would wrongly accept.
 */
export string test_traps_a_distance_just_past_the_output_length() {
  Bits b = fixedBlock();
  b.literal(0x41);
  b.literal(0x42);          // output length is now 2
  b.litLenSymbol(257);      // length 3
  b.code(2, 5);             // distance symbol 2 = distance 3, no extra bits
  inflate(b.done());
  return "distance 3 with 2 bytes of output was accepted";
}

/** A match at the very start of a block — zero literals emitted, so any distance is out of range. */
export string test_traps_a_match_at_the_very_start_of_a_block() {
  Bits b = fixedBlock();
  b.litLenSymbol(257);      // length 3, with nothing to copy from
  b.code(0, 5);             // distance 1
  inflate(b.done());
  return "a match before any output exists was accepted";
}

// The fixed code assigns bit patterns to 286 and 287, but RFC 1951 says they "will never actually
// occur in the compressed data". A decoder must reject them rather than index past its length table.

u8[] reservedLitLen(i32 sym) {
  Bits b = fixedBlock();
  b.literal(0x41);
  b.litLenSymbol(sym);
  return b.done();
}

export string test_traps_reserved_literal_length_symbol_286() {
  inflate(reservedLitLen(286));
  return "literal/length symbol 286 was accepted";
}

export string test_traps_reserved_literal_length_symbol_287() {
  inflate(reservedLitLen(287));
  return "literal/length symbol 287 was accepted";
}

/**
 * Reserved distance symbols 30 and 31.
 *
 * Same for the distance alphabet: the fixed code is 5 bits wide, so 30 and 31 are expressible bit
 * patterns but not defined symbols.
 *
 * Worth being precise about where these are caught, because it is not where the matching
 * literal/length case is caught. The fixed distance decoder is built with exactly 30 symbols, so no
 * code is assigned to 30 or 31 and the stream dies inside `Decoder.decode` for want of a matching
 * code. The reserved *literal* symbols 286 and 287 do have codes — the fixed literal table has 288
 * entries — so those decode successfully and are caught by an explicit bound in `inflateBlock`. See
 * the comment on the `di >= 30` check, which is unreachable for this reason.
 */
u8[] reservedDistance(i32 sym) {
  Bits b = fixedBlock();
  b.literal(0x41);
  b.litLenSymbol(257);      // length 3
  b.code(sym, 5);
  return b.done();
}

export string test_traps_reserved_distance_symbol_30() {
  inflate(reservedDistance(30));
  return "distance symbol 30 was accepted";
}

export string test_traps_reserved_distance_symbol_31() {
  inflate(reservedDistance(31));
  return "distance symbol 31 was accepted";
}

/** A stored block with LEN claiming more bytes than the stream contains. */
export string test_traps_a_stored_length_that_runs_off_the_end() {
  Bits b = Bits.create();
  b.bits(1, 1);
  b.bits(0, 2);             // BFINAL=1, BTYPE=00
  // LEN=255, only 1 byte follows.
  inflate(withBytes(b, u8[](0xFF, 0x00, 0x00, 0xFF, 0x41)));
  return "a stored LEN past the end of input was accepted";
}

// Running out of bits partway through a Huffman code must trap, not return whatever has been decoded
// so far. The whole stream is four bytes — three bits of block header, two eight-bit literals and a
// seven-bit end-of-block — so every truncation of it is a distinct case and there are four of them.

u8[] truncatedTo(i32 keep) {
  Bits b = fixedBlock();
  b.literal(0x41);
  b.literal(0x42);
  b.litLenSymbol(256);
  u8[] full = b.done();
  if (keep >= full.len()) { trap; }   // the caller has miscounted, not the decoder
  u8[] out = u8[keep]();
  for (i32 i = 0; i < keep; i++) { out[i] = full[i]; }
  return out;
}

export string test_traps_truncated_to_no_bytes() {
  inflate(truncatedTo(0));
  return "an empty stream was accepted";
}

export string test_traps_truncated_to_one_byte() {
  inflate(truncatedTo(1));
  return "one byte of a four-byte stream was accepted";
}

export string test_traps_truncated_to_two_bytes() {
  inflate(truncatedTo(2));
  return "two bytes of a four-byte stream was accepted";
}

export string test_traps_truncated_to_three_bytes() {
  inflate(truncatedTo(3));
  return "three bytes of a four-byte stream was accepted";
}

/**
 * The truncation cases above are only exhaustive if the stream really is four bytes.
 *
 * A change to the fixed code, or to how the builder packs bits, would make it longer — and the four
 * `test_traps_truncated_to_*` exports would then be a sample rather than every position, silently.
 */
export string test_the_truncation_corpus_covers_every_position() {
  T t = T.create();
  Bits b = fixedBlock();
  b.literal(0x41);
  b.literal(0x42);
  b.litLenSymbol(256);
  t.eqI32(b.done().len(), 4,
          "the stream the truncation cases cut is four bytes, so 0..3 is all of them");
  return t.report();
}

/**
 * A block that never ends.
 *
 * Literals with no end-of-block symbol: the decoder must run out of input and trap rather than loop.
 */
export string test_traps_a_block_that_never_ends() {
  Bits b = fixedBlock();
  for (i32 i = 0; i < 100; i++) { b.literal(0x41); }
  inflate(b.done());
  return "a block with no end-of-block symbol was accepted";
}
