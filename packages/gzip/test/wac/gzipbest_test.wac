// `gzipBest` never returns more than a stored container.
//
// The interesting inputs are the ones where compression fails but only just, because that is where
// the choice is actually made. Below `smallInput()` all three encodings are priced and the smallest
// wins; above it `gzipBest` prices dynamic first and only reaches for stored when dynamic came out
// at least as large as the input. **Both sides of that comparison are live**: on 5,000 bytes over an
// alphabet of 246, dynamic is 5,002 and stored is 5,023 — compression failed to shrink anything and
// is still the better answer by twenty-one bytes. Nothing in the suite had ever produced an
// incompressible input above the threshold, so that arm had never run.
//
// Host-side until 2026-08-17, and needing no host: it compares two of our own encoders' sizes
// against each other, which is a property rather than an oracle. `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli } from "std/platform.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { gzipBest, gzipStored } from "../../src/gzip.wac";

/**
 * Deterministic bytes that do not compress, over an alphabet of `alpha` symbols.
 *
 * A linear congruential generator rather than real randomness, because a property that holds on
 * Tuesday and not on Wednesday is not a property — and because when this fails, the input has to be
 * the same one that failed.
 */
u8[] incompressible(i32 n, i32 alpha, i32 seed) {
  u8[] out = u8[n]();
  i32 s = seed;
  for (i32 i = 0; i < n; i++) {
    s = (s * 1103515245 + 12345) & 0x7FFFFFFF;
    out[i] = ((s >> 16) & 255) % alpha;
  }
  return out;
}

export string test_best_never_exceeds_stored_on_either_side_of_the_threshold() {
  T t = T.create();
  // 4096 is `smallInput()`; these straddle it, and the alphabets span "compresses well" to "does not
  // compress at all", so both the shrinking and the failing cases are priced.
  i32[] lengths = i32[](0, 1, 300, 1000, 4095, 4096, 4097, 5000, 8192, 20000);
  i32[] alphabets = i32[](2, 16, 200, 250, 256);
  i32 worse = 0;
  string first = "";
  for (i32 i = 0; i < lengths.len(); i++) {
    for (i32 k = 0; k < alphabets.len(); k++) {
      i32 n = lengths[i];
      i32 alpha = alphabets[k];
      u8[] data = incompressible(n, alpha, 20260812 ^ n ^ alpha);
      i32 best = gzipBest(data).len();
      i32 stored = gzipStored(data).len();
      if (best <= stored) { continue; }
      worse = worse + 1;
      if (first == "") {
        first = itoa(n) + " bytes over " + itoa(alpha) + " symbols: " + itoa(best) + " > " +
                itoa(stored);
      }
    }
  }
  t.eqI32(worse, 0, "gzipBest expanded past stored on " + itoa(worse) + " input(s); the first is " +
                    first);
  return t.report();
}

/**
 * The specific arm: dynamic did not shrink anything, and stored is *still* larger.
 *
 * A test that only checked "the answer is no worse than stored" passes whichever branch ran, so this
 * pins which one did — by requiring the answer to be smaller than the stored container while being
 * no smaller than the input.
 */
export string test_above_the_threshold_dynamic_wins_even_when_it_did_not_compress() {
  T t = T.create();
  u8[] data = incompressible(5000, 246, 3);
  i32 best = gzipBest(data).len();
  i32 stored = gzipStored(data).len();
  t.isTrue(best >= data.len(),
           "this input was meant not to compress, but " + itoa(data.len()) + " became " + itoa(best));
  t.isTrue(best < stored,
           "this input was meant to leave dynamic ahead of stored, got " + itoa(best) + " vs " +
           itoa(stored));
  return t.report();
}
