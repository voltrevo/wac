// The table-driven CRC-32 against the bitwise definition.
//
// Fixed vectors only prove the table entries those vectors happen to reach. A
// single wrong entry is reached only by inputs containing one particular byte
// value at one particular state, so the check that matters is agreement with the
// definition across every byte value and a spread of lengths.

import { T } from "../../../wactest/src/assert.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { crc32, crc32Bitwise } from "../../src/crc32.wac";

export string test_table_agrees_with_definition_on_every_byte() {
  T t = T.create();
  // Every single-byte input reaches a different table entry, so this covers all
  // 256 of them.
  for (i32 b = 0; b < 256; b++) {
    u8[] one = u8[1]();
    one[0] = b;
    t.eqU32(crc32(one), crc32Bitwise(one), "single byte " + itoa(b));
  }
  return t.report();
}

export string test_table_agrees_across_lengths() {
  T t = T.create();
  // Lengths chosen around the two seams: 512 is where the slice-by-8 path takes
  // over from the bitwise one, and the stride is 8, so the tail loop has to handle
  // every remainder from 0 to 7.
  i32[] lengths = i32[](0, 1, 2, 3, 4, 7, 8, 9, 15, 16, 17, 255, 256, 257,
                        511, 512, 513, 514, 515, 516, 517, 518, 519, 520,
                        1000, 1023, 1024, 4095, 4096, 8191);
  for (i32 j = 0; j < lengths.len(); j++) {
    i32 n = lengths[j];
    u8[] data = u8[n]();
    // A deterministic spread rather than a constant, so state varies across the
    // whole table as the loop advances.
    for (i32 i = 0; i < n; i++) {
      data[i] = (i * 37 + n * 11) & 0xFF;
    }
    t.eqU32(crc32(data), crc32Bitwise(data), "length " + itoa(n));
  }
  return t.report();
}

/**
 * Every expected value here came from Python's zlib:
 *
 *     python3 -c "import zlib; print(zlib.crc32(b'...'))"
 *
 * Nothing is eyeballed, and none of them are round numbers that could pass by coincidence.
 * Host-side until 2026-08-17 — the values were already literals there, so the port moved a table
 * rather than an oracle. `issues/system/0161`.
 */
export string test_known_vectors() {
  T t = T.create();
  // Empty input is 0 by definition, and is the one case with no table lookup.
  t.eqU32(crc32(u8[0]()), 0, "crc32 of empty");
  t.eqU32(crc32("a".toBytes()), 3904355907, "crc32(\"a\")");
  t.eqU32(crc32("abc".toBytes()), 891568578, "crc32(\"abc\")");
  t.eqU32(crc32("hello world".toBytes()), 222957957, "crc32(\"hello world\")");
  t.eqU32(crc32("The quick brown fox jumps over the lazy dog".toBytes()), 1095738169,
          "crc32 of the pangram");
  t.eqU32(crc32("123456789".toBytes()), 3421780262, "crc32(\"123456789\") — the check value");

  // **Every vector above is shorter than 512 bytes, and `crc32` uses the *bitwise* form below that
  // — so none of them touches the eight-table path the pipeline actually calls.** A canary found
  // this: corrupting the table's polynomial left all six passing. These three straddle the
  // threshold, from `python3 -c "import zlib; print(zlib.crc32(bytes(((i*31+7) & 0xFF) for i in
  // range(N))))"`.
  t.eqU32(crc32(ramp(511)), 136066014, "511 bytes — one below the threshold, still bitwise");
  t.eqU32(crc32(ramp(512)), 498099751, "512 bytes — the first length that takes the table path");
  t.eqU32(crc32(ramp(513)), 3916529443, "513 bytes — a length the eight-byte stride cannot divide");
  return t.report();
}

/** `n` bytes of the same ramp the long-input case uses, so one recipe covers every length here. */
u8[] ramp(i32 n) {
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = (i * 31 + 7) & 0xFF; }
  return out;
}

/**
 * All 256 byte values, one at a time.
 *
 * A single byte's CRC depends on the full table, so getting all 256 right means the polynomial and
 * the reflection are both correct. Summed so the vector stays readable, and the **sum** was checked
 * against Python rather than assumed:
 *
 *     python3 -c "import zlib; print(sum(zlib.crc32(bytes([b])) for b in range(256)))"
 */
export string test_every_single_byte() {
  T t = T.create();
  i64 sum = 0 as i64;
  for (i32 b = 0; b < 256; b++) {
    u8[] one = u8[1]();
    one[0] = b;
    sum = sum + (crc32(one) as i64);
  }
  t.eqI64(sum, 549755813760, "the sum of crc32 over every single byte");
  return t.report();
}

/**
 * A long input, so the incremental state is exercised rather than one block.
 *
 *     data = bytes(((i*31+7) & 0xFF) for i in range(10000))
 *     zlib.crc32(data)
 */
export string test_a_long_input() {
  T t = T.create();
  t.eqU32(crc32(ramp(10000)), 954632217, "crc32 of ten thousand bytes");
  return t.report();
}
