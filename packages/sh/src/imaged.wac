// A shell whose filesystem is a file: the session ends, the filesystem does not.
//
//   imaged home.wacimg -c 'mkdir /data; echo one > /data/notes'
//   imaged home.wacimg -c 'ls /data'          ->  notes
//
// design/0001 step 2 is done when "a session's writes survive a restart", and `image.wac` on its own only
// shows that a *filesystem value* survives a round trip. This is the restart. `sealed.wac` names it as
// what comes next — "the thing an image will be loaded into, once there is an image" — and this is that,
// as a separate program rather than a flag on `sealed`, for one reason:
//
// **`sealed` is built with no filesystem grants at all**, which is the whole of what "sealed" means. A
// session that loads and saves an image needs read and write on that path, so putting the option there
// would spend the property to save a file. Two programs, one line of difference, and the line is again the
// point — the same argument `wacsh` and `sealed` are already two programs for.
//
// The image is loaded before the script runs and written after it finishes, including when the script
// fails: a shell that only saved on success would lose the work of a session that ended badly, which is
// exactly the session whose work is worth keeping. A path that does not exist yet is an empty filesystem
// rather than an error, so the first run of a new image needs no separate step to create one.
//
// **What is not saved, and what turned out to be saved after all.** `sealed.wac` used to name a hole
// here — a redirection on a pipeline's last stage streaming through `openOutput`, which is a capability
// rather than a filesystem operation, and so reaching the host instead of the image. Building this and
// trying it showed otherwise: `echo hello | tr a-z A-Z > /data/up` lands in the image, and `/data/up`
// does not exist on the host afterwards. The streaming pipeline in `exec.wac` gives up as soon as
// `spawnStage` reports no spawn in this world, and the sequential path it falls back to writes through
// `Fs`. This program is built with read and write and **not** spawn, so it never reaches the streaming
// path at all.
//
// The risk is real but belongs to the grants: build this with `spawn` and a redirected pipeline would
// reach the host again, because `packages/fs` still has no output sink. `test/imaged.test.ts` pins the
// property as it stands rather than the sentence that described it wrongly.

import { Core, Cli } from "../../platform/src/platform.wac";
import { FileResult } from "../../platform/src/platform.wac";
import { Fs } from "../../fs/src/fs.wac";
import { Loaded, Written, read, write } from "../../fs/src/image.wac";
import { Shell } from "./exec.wac";
import { shellMain } from "./entry.wac";
import { programNames } from "./program.wac";

export i32 main(Core core, Cli cli) {
  if (cli.argCount().wait() < 1) {
    core.warn("usage: imaged <image.wacimg> [-c script | script]");
    return 2;
  }
  string path = string.fromBytes(cli.arg(0).wait());

  Fs fs = Fs.inMemory(0);
  FileResult existing = cli.readFile(path).wait();
  if (existing.ok) {
    Loaded got = read(existing.bytes, 0);
    if (!got.ok) {
      // Refusing beats starting empty: a session that silently began with nothing would then *save* over
      // the image it could not read, which turns one unreadable file into no file at all.
      core.warn("imaged: " + path + ": " + got.error);
      return 1;
    }
    fs = got.fs;
  }
  // Anything else — a missing file, a directory, no permission — is a filesystem with nothing in it. Only
  // the first is really expected, and the others show up on the way out, where the write says so.

  Shell sh = Shell.onFs(core, cli, fs);
  sh.cwd = "/";
  sh.externalNames = programNames;
  i32 code = shellMain(core, cli, sh, 1);

  // After the script, whatever happened to it.
  Written w = write(sh.fs);
  for (i32 i = 0; i < w.skipped.len(); i++) {
    // Cannot happen for a filesystem this program built — it has no host mount — but a shell that grew a
    // `mount` builtin would make it possible, and a silently smaller image is the failure worth naming.
    core.warn("imaged: not saved: " + w.skipped[i]);
  }
  if (cli.writeFile(path, w.bytes).wait().fault != 0) {
    core.warn("imaged: " + path + ": the session could not be saved");
    return 1;
  }
  return code;
}
