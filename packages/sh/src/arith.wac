// Arithmetic expansion — the inside of `$((…))`.
//
// A small recursive-descent evaluator over integers. Worth having its own file because it shares
// nothing with the rest of the shell: no words, no quoting, no expansion. Inside these
// parentheses the shell's own rules stop applying, which is the point of them.
//
// The differences from the surrounding language are the things to keep straight:
//
//   **A bare name is a variable.** `$((x+1))` reads `x` without a dollar, because there is no
//   word splitting in here for a dollar to protect against. `$x` also works and means the same.
//
//   **An unset or non-numeric variable is zero**, not an error. `$((undefined+1))` is 1. That is
//   what makes `$((count+1))` work on the first pass through a loop, and it is also why a typo
//   in a name is silent.
//
//   **Comparisons yield 1 and 0**, not a status. `$((a<b))` is a number to be used, and it is the
//   *opposite* polarity to `test a -lt b`, whose success is 0. Two conventions a few characters
//   apart, and the shell means both.
//
// Division by zero is an error rather than a value, because every answer would be a wrong one.

export struct Arith {
  u8[] src;
  i32 at;
  /** Set when something could not be evaluated; the result is then meaningless. */
  bool bad;
  string error;
  /**
   * Where the thing bash calls the **error token** starts, in `src`.
   *
   * bash names it in every arithmetic diagnostic and this did not, which is seven of the twenty-seven
   * rows `tools/corpusStderr.ts` pins:
   *
   *     $ echo $((1+*2))     1+*2: syntax error: operand expected (error token is "*2")
   *     $ echo $((a b c))    a b c: syntax error in expression (error token is "b c")
   *     $ echo $((1/(2-2)))  1/(2-2): division by 0 (error token is "(2-2)")
   *
   * The rule, measured on bash rather than guessed at: **the token is the rest of the input from
   * where the offending thing began**, with leading spaces dropped. For a syntax error that is the
   * position the parser was at; for a division it is where the *divisor* started, which is why this
   * is recorded at the failure rather than derived from `at` afterwards — by then the divisor has
   * been consumed.
   */
  i32 tokenAt;
  /**
   * Where the last operator this parser consumed began.
   *
   * bash's token for `1+` is the **operator**, not the end of the input the parser reached — an
   * operand was expected *after* it and none came. The binary operators are eaten in `parseSum` and
   * `parseProduct` and the failure happens two calls deeper in `parsePrimary`, so the position rides
   * on the state rather than being threaded through every level.
   */
  i32 lastOp;
}

/**
 * Evaluate `text`. Numbers and operators only — **the caller substitutes variables first.**
 *
 * That split is not squeamishness about coupling. Substituting in the caller is what reproduces
 * bash resolving a value that is itself an expression (`x=1+2` makes `$((x))` 3) and a value that
 * names another variable (`a=b; b=c; c=7`), both of which need the shell's own lookup and a
 * repeat pass. By the time anything gets here there are no names left, so an identifier is a
 * malformed expression rather than something to resolve.
 *
 * `bad` on the returned state says whether the answer means anything.
 */
/** A byte that may start a shell variable name. */
bool nameStart(i32 c) {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

/** A byte that may continue one. */
bool nameByte(i32 c) { return nameStart(c) || (c >= '0' && c <= '9'); }

/**
 * The unimplemented arithmetic form in `text`, or `""` — increment, decrement, or assignment.
 *
 * **Asked before the names are substituted, because afterwards there is nothing to recognise.** The
 * caller resolves variables first (see `evaluate`), so `$((++x))` arrives here as `++5` and parses as
 * two unary pluses: bash answers 6 and this answered **5**, silently, having modified nothing. `x++`
 * and `x=7` arrive as `5++` and `5=7` and produce *syntax errors*, which say the caller's expression is
 * malformed when it is this shell that is unfinished — the distinction `test/gaps.test.ts` is built on.
 *
 * Recognised by the name beside the operator rather than by the operator alone, because `5--3` is
 * `5 - (-3)` in bash and evaluates to 8 here already; only a name makes it a decrement. Assignment is
 * an `=` that is not part of `==`, `!=`, `<=` or `>=`, with a name to its left.
 */
export string arithNotImplemented(string text) {
  u8[] s = text.toBytes();
  for (i32 i = 0; i + 1 < s.len(); i++) {
    if ((s[i] == '+' && s[i + 1] == '+') || (s[i] == '-' && s[i + 1] == '-')) {
      // A *name* to the left, not merely a name byte: `5--3` is `5 - (-3)` in bash and answers 8, and a
      // digit is a name byte because `x1` is a name. So the run is walked back to its first character,
      // which a number cannot start with.
      i32 k = i - 1;
      while (k >= 0 && nameByte(s[k])) { k = k - 1; }
      bool before = k < i - 1 && nameStart(s[k + 1]);
      bool after = i + 2 < s.len() && nameStart(s[i + 2]);
      if (before || after) { return s[i] == '+' ? "++" : "--"; }
    }
  }
  for (i32 i = 0; i < s.len(); i++) {
    if (s[i] != '=') { continue; }
    if (i + 1 < s.len() && s[i + 1] == '=') { continue; }              // ==
    if (i > 0 && (s[i - 1] == '=' || s[i - 1] == '!' ||
                  s[i - 1] == '<' || s[i - 1] == '>')) { continue; }   // ==, !=, <=, >=
    // Skip one compound-assignment operator, then any spaces, and see whether a name ends there.
    i32 j = i - 1;
    if (j >= 0 && (s[j] == '+' || s[j] == '-' || s[j] == '*' || s[j] == '/' || s[j] == '%' ||
                   s[j] == '&' || s[j] == '|' || s[j] == '^')) { j = j - 1; }
    while (j >= 0 && s[j] == ' ') { j = j - 1; }
    if (j >= 0 && nameByte(s[j])) { return "="; }
  }
  return "";
}

export i64 evaluate(string text, Arith state) {
  state.src = text.toBytes();
  state.at = 0;
  state.bad = false;
  state.error = "";

  // `$(( ))` is zero, not an error. It falls out of `for ((;;))`-shaped code and bash says 0.
  skipSpace(state);
  if (state.at >= state.src.len()) { return 0; }

  i64 v = parseOr(state);
  skipSpace(state);
  if (!state.bad && state.at < state.src.len()) {
    // Something the parser could not attach to what came before: `a b`, `9 9`. bash's words, and the
    // token is the rest from here — `b c` rather than `b`.
    fail(state, "syntax error in expression");
  }
  return v;
}

void fail(Arith a, string why) { failAt(a, why, a.at); }

/** The same, naming where the token starts — see `Arith.tokenAt`. */
void failAt(Arith a, string why, i32 from) {
  if (!a.bad) {
    a.bad = true;
    a.error = why;
    a.tokenAt = from;
  }
}

/**
 * What bash calls the error token: the rest of the input from `tokenAt`, without leading spaces.
 *
 * Empty when the expression simply ran out — `$((1+))` fails *at* the end, and bash's token there is
 * the operator it could not find an operand for, which `parsePrimary` records rather than this.
 */
export string errorToken(Arith a) {
  i32 from = a.tokenAt;
  while (from < a.src.len() && (a.src[from] == 32 || a.src[from] == 9)) { from++; }
  if (from >= a.src.len()) { return ""; }
  u8[] rest = u8[a.src.len() - from]();
  rest.copyFrom(a.src, from, 0, a.src.len() - from);
  return string.fromBytes(rest);
}

void skipSpace(Arith a) {
  while (a.at < a.src.len() && (a.src[a.at] == 32 || a.src[a.at] == 9)) { a.at++; }
}

/** Whether the next characters are `text`, and consume them if so. */
bool eat(Arith a, string text) {
  skipSpace(a);
  u8[] want = text.toBytes();
  if (a.at + want.len() > a.src.len()) { return false; }
  for (i32 i = 0; i < want.len(); i++) {
    if (a.src[a.at + i] != want[i]) { return false; }
  }
  // Whatever was just consumed is what an operand would have followed — see `Arith.lastOp`.
  a.lastOp = a.at;
  // No guard against a one-character operator swallowing the first half of a two-character one:
  // the callers try the longer form first, which is what actually decides it. A guard here as
  // well was unreachable — `eat("<")` only runs after `eat("<=")` has failed, and `&` and `|`
  // are never tried alone at all.
  a.at += want.len();
  return true;
}

/**
 * `eat`, for an operator whose doubled form means something else: `|` against `||`, `&` against `&&`.
 *
 * The `<` and `>` pair need the same care and get it the other way round — `parseCompare` tries `<=`
 * and `>=` first and then refuses a `<` that is the start of `<<`, because the shift binds tighter and
 * is parsed further down.
 */
bool eatAlone(Arith a, string op) {
  skipSpace(a);
  if (a.at + 1 < a.src.len() && a.src[a.at + 1] == op.toBytes()[0]) { return false; }
  return eat(a, op);
}

i64 parseOr(Arith a) {
  i64 left = parseAnd(a);
  while (!a.bad && eat(a, "||")) {
    i64 right = parseAnd(a);
    left = (left != 0 || right != 0) ? 1 : 0;
  }
  return left;
}

i64 parseAnd(Arith a) {
  i64 left = parseBitOr(a);
  while (!a.bad && eat(a, "&&")) {
    i64 right = parseBitOr(a);
    left = (left != 0 && right != 0) ? 1 : 0;
  }
  return left;
}

/**
 * `|`, `^` and `&`, at C's precedence: looser than a comparison and tighter than `&&`.
 *
 * **Each single-character form has to refuse the doubled one.** `eat("|")` would take the first half of
 * `||` and leave a `|` that parses as an operand — the note on `eat` used to say `&` and `|` "are never
 * tried alone at all", which was true until these three existed. `eatAlone` is that condition with a
 * name.
 */
i64 parseBitOr(Arith a) {
  i64 left = parseBitXor(a);
  while (!a.bad && eatAlone(a, "|")) { left = left | parseBitXor(a); }
  return left;
}

i64 parseBitXor(Arith a) {
  i64 left = parseBitAnd(a);
  while (!a.bad && eat(a, "^")) { left = left ^ parseBitAnd(a); }
  return left;
}

i64 parseBitAnd(Arith a) {
  i64 left = parseEquality(a);
  while (!a.bad && eatAlone(a, "&")) { left = left & parseEquality(a); }
  return left;
}

/**
 * `<<` and `>>`, tighter than a comparison and looser than `+`.
 *
 * `$((1<<40))` was *"syntax error: operand expected (error token is \"<40\")"* — refused rather than
 * wrong, which is why this is a gap being filled rather than a bug being fixed. It needed the 64-bit
 * widening first: a shift is the operator that makes the width visible, and `1 << 40` in 32 bits is 0.
 */
i64 parseShift(Arith a) {
  i64 left = parseSum(a);
  while (!a.bad) {
    if (eat(a, "<<")) { left = left << parseSum(a); }
    else if (eat(a, ">>")) { left = left >> parseSum(a); }
    else { return left; }
  }
  return left;
}

i64 parseEquality(Arith a) {
  i64 left = parseCompare(a);
  while (!a.bad) {
    if (eat(a, "==")) { left = left == parseCompare(a) ? 1 as i64 : 0 as i64; }
    else if (eat(a, "!=")) { left = left != parseCompare(a) ? 1 as i64 : 0 as i64; }
    else { return left; }
  }
  return left;
}

i64 parseCompare(Arith a) {
  i64 left = parseShift(a);
  while (!a.bad) {
    // The two-character forms are tried first, or `<` would take the `<` of `<=`.
    if (eat(a, "<=")) { left = left <= parseShift(a) ? 1 as i64 : 0 as i64; }
    else if (eat(a, ">=")) { left = left >= parseShift(a) ? 1 as i64 : 0 as i64; }
    // A `<` that begins a `<<` belongs to the shift, which binds tighter and is parsed below.
    else if (eatAlone(a, "<")) { left = left < parseShift(a) ? 1 as i64 : 0 as i64; }
    else if (eatAlone(a, ">")) { left = left > parseShift(a) ? 1 as i64 : 0 as i64; }
    else { return left; }
  }
  return left;
}

i64 parseSum(Arith a) {
  i64 left = parseProduct(a);
  while (!a.bad) {
    if (eat(a, "+")) { left = left + parseProduct(a); }
    else if (eat(a, "-")) { left = left - parseProduct(a); }
    else { return left; }
  }
  return left;
}

i64 parseProduct(Arith a) {
  i64 left = parseUnary(a);
  while (!a.bad) {
    if (eat(a, "*")) { left = left * parseUnary(a); }
    else if (eat(a, "/")) {
      // Where the divisor started, before parsing consumes it: bash's token for `1/(2-2)` is the
      // whole `(2-2)`, which is unrecoverable once `at` has moved past it.
      i32 from = a.at;
      i64 d = parseUnary(a);
      if (d == 0 as i64) { failAt(a, "division by 0", from); return 0 as i64; }
      left = left / d;
    } else if (eat(a, "%")) {
      i32 from = a.at;
      i64 d = parseUnary(a);
      if (d == 0 as i64) { failAt(a, "division by 0", from); return 0 as i64; }
      left = left % d;
    } else { return left; }
  }
  return left;
}

i64 parseUnary(Arith a) {
  skipSpace(a);
  // The operator's own position, so that a missing operand names the operator: bash's token for
  // `1+` is `+` and for `2 & & 3` is `& 3`, both of which start at the operator rather than at the
  // end of the input the parser reached.
  i32 op = a.at;
  if (eat(a, "!")) { return parseUnary(a) == 0 as i64 ? 1 as i64 : 0 as i64; }
  if (eat(a, "-")) { return 0 as i64 - parseUnary(a); }
  if (eat(a, "+")) { return parseUnary(a); }
  // `~5` is -6, and it is the one unary this had no answer for at all.
  if (eat(a, "~")) { return ~parseUnary(a); }
  return parsePrimary(a, op);
}

i64 parsePrimary(Arith a, i32 op) {
  skipSpace(a);
  if (a.at >= a.src.len()) {
    // bash's words: an operand was expected here and the input ended. The token is what an operand
    // would have followed — a unary operator this call ate, or the binary one that got us here.
    failAt(a, "syntax error: operand expected", op < a.src.len() ? op : a.lastOp);
    return 0;
  }
  if (eat(a, "(")) {
    i64 v = parseOr(a);
    if (!eat(a, ")")) { fail(a, "missing )"); }
    return v;
  }

  i32 c = a.src[a.at];
  if (c >= 0x30 && c <= 0x39) {
    // **Accumulated in 64 bits**, which is what bash's arithmetic is: `9223372036854775807` used to
    // come back as `-1` because the digits were folded into an `i32`.
    i64 v = 0 as i64;
    while (a.at < a.src.len() && a.src[a.at] >= 0x30 && a.src[a.at] <= 0x39) {
      v = v * 10 as i64 + ((a.src[a.at] - 0x30) as i64);
      a.at++;
    }
    return v;
  }
  // Not a number, not a parenthesis, and not an operator we know: bash calls it a syntax error in
  // the expression and names the rest of the input from here.
  failAt(a, "syntax error: operand expected", op);
  return 0;
}
