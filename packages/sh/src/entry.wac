// Everything `sh` does once it has a shell, so that a caller which built one differently can reuse
// it.
//
// A separate file for a blunt reason: `bindgen` generates a host binding for every export of the
// module being built, and this function takes a `Shell` — which, since it gained a funcref field,
// is a struct `bindgen` cannot currently express. Exporting it from `sh.wac` made every build of
// `sh.wac` emit wasm that would not compile, and the shell failed all 539 differential scripts at
// once with `Unknown heap type -34`. Here it is exported for wac to import and `sh.wac` exports
// only `main`, which binds cleanly. wac issue 0062, filed by agent-b the day before this hit it.

import { Output } from "std";
import { Shell, runScript } from "./exec.wac";
import { flatten } from "core";
import { reason } from "../../fs/src/words.wac";

/**
 * The whole of `main`, over a shell somebody else built.
 *
 * `first` is where this program's own arguments begin: 0 when it *is* `sh`, and 1 under `box`,
 * whose first argument is the applet name. Split out so that a caller which has wired something
 * into `Shell.external` — `box`'s applets, say — gets argument handling, the file-or-`-c`-or-stdin
 * choice and the standard-error flush rather than reimplementing them and drifting.
 */
export async i32 shellMain(string[] argv, Shell sh, i32 first) {
  Output err = sh.stderr;
  // **A shell is a process too**, and it was the one this system did not know about: `mountSystem`
  // enters the *program*, which for `sealedsh` is this same thing and for `wacsh` — which builds no
  // system on purpose — is nothing at all. So `$$` had no number to answer with and a signal had
  // nowhere to be delivered. Adopted rather than entered twice where a program is already there.
  sh.enterSelf("sh");
  string src = "";

  i32 n = argv.len() - first;
  if (n >= 1 && argv[first] == "-c") {
    if (n < 2) {
      err.line("sh: -c needs a script");
      return 2;
    }
    // Everything after `-c` joined with spaces, as `sh -c` does: the shell re-splits it anyway.
    src = argv[first + 1];
    for (i32 i = first + 2; i < first + n; i++) { src = src + " \{argv[i]}"; }
  } else if (n >= 1) {
    // **The shell's own filesystem, not the host's.** This read through `cli`, so a shell mounted on an
    // image — `sshd -i`, `sealedsh` — went to the real disk for its script while every command inside
    // that script went to the image. Two filesystems in one session is the thing design/0001 D1 exists
    // to prevent, and once `Fs` grew users (step 4) it was a permission check skipped as well.
    string name = argv[first];
    match (await sh.fs.readFile(sh.resolve(name))) {
      Ok(bytes): { src = string.fromBytes(bytes); }
      Err(e): {
        err.line("sh: \{name}: \{reason(e)}");
        return 127;
      }
    }
  } else {
    // No script argument: the script *is* standard input, and reading it consumes it. So a command
    // inside it has nothing left to read, exactly as in bash — `echo cat | sh` runs `cat` with no
    // input rather than feeding it the rest of the script.
    src = string.fromBytes(flatten(sh.stdin.readAll().wait()).orElse(u8[]()));
    sh.triedStdin = true;
  }

  // **This shell owns the program's standard input.** Only an entry point invoked *as* a shell can say
  // that: `packages/ssh`'s server and the browser terminal build a `Shell` too, and theirs is not the
  // process's input to read. Set before the script runs, and lazily acted on — see `restOfStdin`.
  // Issue 0032.
  sh.ownsStdin = true;

  i32 status = await runScript(sh, src);

  // A non-capturing shell has already written its diagnostics, in the order it produced them —
  // `Shell.err` does that now, where the whole buffer used to be flushed here through `Core.warn`
  // with its trailing newline shaved off by hand. What remains is a *capturing* shell's buffer,
  // which only reaches a terminal if this is where it ends up. Issue 0014.
  if (sh.errOut.len > 0) { flatten(err.write(sh.errOut.bytes()).wait()).isOk(); }
  return status;
}
