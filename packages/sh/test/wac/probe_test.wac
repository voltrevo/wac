// The coverage probe still compiles — and the file saying so is now one of the probe's own callers.
//
// `cov.ts` is not part of `wac task test` — it is slow and it is a measurement, not a check — so nothing
// in the suite touches `test/wac/probe.wac`. That was fine until the probe started building a whole fake
// capability world, and now every change to `Cli` or `Core` in `packages/platform` breaks it silently. It
// has broken twice: once when capabilities began returning `Pending<T>`, and once when `waitAny` moved
// from `Cli` to `Core` and `spawn` gained an argument. Both times the suite stayed green and
// `wac task coverage:sh` was simply dead until someone happened to run it.
//
// **This was `test/probe.test.ts` — one `wacBind` and a process.** In wac the compile check is the
// `import` below: a probe that stopped compiling against `packages/platform` cannot be imported, and the
// file that imports it does not build. The run check is the same four calls it always was.
//
// It deliberately asserts nothing about coverage. This is a compile check wearing a test's clothes, and
// saying so here is cheaper than the next person wondering why it asserts so little.

import { T } from "../../../wactest/src/assert.wac";
import { Sys } from "std";
import { shBuiltinCount, shBuiltinsAgree, shOut, shStatus } from "./probe.wac";

export async string test_the_coverage_probe_compiles_against_the_current_platform(Sys sys) {
  T t = T.create();
  // And it runs, so a probe that compiles but cannot build its world is caught too.
  t.eqI32(await shStatus(sys, "exit 3"), 3, "the probe ran `exit 3` and reported something else");
  // Its world is the store: the files it was seeded with are there, and the one it may not write is refused.
  t.eqStr(string.fromBytes(await shOut(sys, "read a < in.txt; echo $a")), "first line\n", "the seeded file reads back");
  t.eqStr(string.fromBytes(await shOut(sys, "echo dir/*")), "dir/one dir/three dir/two\n", "a glob sorts and skips the dotfile");
  t.isTrue(await shStatus(sys, "echo x > readonly.txt") != 0, "a redirection onto a 0444 file fails");
  return t.report();
}

export string test_helps_builtin_list_and_the_dispatcher_agree() {
  T t = T.create();
  // Two lists of the same names is how they drift, and these had: the hand-written line in `help` had
  // lost `read`, `shift` and `set`, and would have lost `printf` the moment it became a builtin. `help`
  // reads `builtinNames` now, and this is what keeps that list honest against `isBuiltin`.
  i32 count = shBuiltinCount();
  t.isTrue(count >= 15,
           "`builtinNames` lists only \{count} names — did it empty itself?");
  t.eqI32(shBuiltinsAgree(), 0,
          "of \{count} builtin names, that many are not dispatched as builtins");
  return t.report();
}
