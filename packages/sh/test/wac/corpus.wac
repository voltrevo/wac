// The corpus: every script this repository holds a shell to, as wac data.
//
// It was a TypeScript array, which meant the *generator* of its expectations and the tests that
// replay them had to be TypeScript too. The scripts are data; this is where data belongs.
// `tools/wac/shvectors.wac` reads it to ask the oracle, and the replays read the vectors.

/** Every script, in the order they were written. */
export string[] corpus() {
  return string[](
    "x=abc; echo ${x:-def}",
    "x=; echo ${x:-def}",
    "unset x; echo ${x:-def}",
    "x=abc; echo ${x#a}",
    "x=abc; echo ${x%c}",
    "x=a/b/c; echo ${x##*/}",
    "x=a/b/c; echo ${x%%/*}",
    "x=hello; echo ${#x}",
