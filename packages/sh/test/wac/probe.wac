// The shell at the coverage boundary: scripts driven through the lexer, parser and executor with one call.
//
// The shell runs over the caller's own handles — clock, environment, network, programs — and a store in
// memory standing in for the disk, so nothing a script does reaches the machine. It acts as `probe`, in a
// directory of its own, beside files it may read and one it may not write:
//
//     /work/in.txt, /work/words.txt      readable
//     /work/readonly.txt                 0444, so a redirection onto it is refused
//     /work/dir                          `two one .hidden three`, out of order and with a dotfile, so a glob's
//                                        sort and its dot rule both have something to do
//
// This was a fake `Core` and `Cli` of three hundred lines until design/system/0013 step 5 deleted both: the
// fake answered every capability from a ticket id, because a capability could not hold state. A store can.
// What it cannot reproduce is a world whose `spawn` does not exist — `Procs` is the host's, so the shell's
// fall-through for a program it cannot start is measured where a real host refuses, not here.

import { Sys, Files, MemoryStore, Output } from "std";
import { Shell, builtinNames, isBuiltin, runScript } from "../../src/exec.wac";
import { Kept } from "../../../platform/src/stream.wac";
import { bytesInput } from "../../../fs/src/trees.wac";
import { ProcTable } from "../../../fs/src/proc.wac";

/** The store the scripts run in, built fresh for each so one script's writes are not the next one's input. */
async Files world(Sys sys) {
  MemoryStore store = MemoryStore.create(sys.clock());
  Files root = store.asUser("root");
  await root.mkdir("/work/dir", true);
  await root.chown("/work", "probe");
  await root.writeFile("/work/in.txt", "first line\nsecond line\n".toBytes());
  await root.writeFile("/work/words.txt", "b a\nc\n".toBytes());
  await root.writeFile("/work/readonly.txt", u8[]());
  await root.chmod("/work/readonly.txt", 292);
  for (string n in ["two", "one", ".hidden", "three"]) { await root.writeFile("/work/dir/" + n, u8[]()); }
  return store.asUser("probe");
}

/** A shell over `world`, standing in `/work`, writing to `out` and `err`. */
async Shell shellIn(Sys sys, Output out, Output err) {
  return Shell.of(bytesInput(u8[]()), out, err, sys.clock(), sys.env(), sys.net(), sys.procs(), await world(sys),
                  ProcTable.create(), "/work", false);
}

/**
 * Every builtin name, run through the dispatcher, so `help`'s list and `isBuiltin` cannot drift.
 *
 * Answers the count of names that the shell does *not* treat as builtins — which should be zero. A name
 * in `builtinNames` that `isBuiltin` refuses would be spawned and reported not found; a name in
 * `isBuiltin` that is not in the list is invisible in `help`, which is how `read`, `shift` and `set`
 * came to be missing from it for as long as they were.
 */
export i32 shBuiltinsAgree() {
  string[] names = builtinNames();
  i32 wrong = 0;
  for (string name in names) {
    if (!isBuiltin(name)) { wrong++; }
  }
  return wrong;
}

/** How many names `builtinNames` lists, so a list that emptied itself cannot pass the check above. */
export i32 shBuiltinCount() { return builtinNames().len(); }

/** Run a script and hand back what it wrote to standard output. */
export async u8[] shOut(Sys sys, string src) {
  Kept out = Kept.create();
  Shell sh = await shellIn(sys, out.out, Kept.create().out);
  sh.capture = true;
  await runScript(sh, src);
  return sh.outBuf.take();
}

/** Run a script and hand back its exit status. */
export async i32 shStatus(Sys sys, string src) {
  Shell sh = await shellIn(sys, Kept.create().out, Kept.create().out);
  sh.capture = true;
  return await runScript(sh, src);
}

/** Run a script and hand back what it wrote to standard error. */
export async u8[] shErr(Sys sys, string src) {
  Shell sh = await shellIn(sys, Kept.create().out, Kept.create().out);
  sh.capture = true;
  await runScript(sh, src);
  return sh.errOut.take();
}

/** The same, writing to the shell's outputs rather than collecting — the other branch. */
export async i32 shWritten(Sys sys, string src) {
  Shell sh = await shellIn(sys, Kept.create().out, Kept.create().out);
  return await runScript(sh, src);
}
