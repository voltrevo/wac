// Reading `vectors.txt`: what the oracle said about every corpus script, captured once.
//
// The file is written by `tools/wac/shvectors.wac` and its format is length-prefixed on purpose — a
// script contains newlines, quotes and backslashes, so any delimiter would need escaping and any
// escaping would need a second implementation to undo it.
//
//     wac-sh-vectors 1
//     bash: GNU bash, version 5.2.21(1)-release (aarch64-unknown-linux-gnu)
//     coreutils: cp (GNU coreutils) 9.4
//     locale: LC_ALL=C.UTF-8
//     count: 946
//     S <n>\n<n bytes>\n     the script
//     P 0|1\n                whether it names a program box carries, which decides who replays it
//     X <status>\n           the status bash left
//     O <n>\n<n bytes>\n     what it wrote to standard output
//     E <n>\n<n bytes>\n     and to standard error
//
// The header is not decoration: an expectation is only as portable as the environment it was taken in,
// and when a replay disagrees the first question is whether *we* changed or the oracle did.

import { Cli, FileResult } from "../../../platform/src/platform.wac";

export struct Vector {
  string script;
  /** True when the script names one of box's programs — box's half replays those. */
  bool needsProgram;
  i32 status;
  string out;
  string err;
}

export struct Vectors {
  Vector[] items;
  i32 n;
  /** The oracle's own identity, as recorded when these were captured. */
  string oracle;
  /** Empty when the file parsed; otherwise why it did not. */
  string error;
}

string vectorsPath() { return "packages/sh/test/vectors.txt"; }

/** One line starting at `at`, and where the next begins. */
struct Line {
  string text;
  i32 next;
}

Line lineAt(u8[] b, i32 at) {
  i32 end = at;
  while (end < b.len() && b[end] != '\n') { end = end + 1; }
  return Line(string.fromBytes(sliceOf(b, at, end)), end + 1);
}

u8[] sliceOf(u8[] b, i32 from, i32 to) {
  i32 n = to - from;
  if (n <= 0) { return u8[0](); }
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = b[from + i]; }
  return out;
}

/** The number after a tag: `S 21` gives 21, and -1 when the line is not that shape. */
i32 numberIn(string line, string tag) {
  if (line.len() < tag.len() + 1) { return 0 - 1; }
  if (line.slice(0, tag.len()) != tag) { return 0 - 1; }
  string rest = line.slice(tag.len() + 1, line.len());
  i32 v = 0;
  if (rest.len() == 0) { return 0 - 1; }
  for (i32 i = 0; i < rest.len(); i++) {
    u8[] c = rest.slice(i, i + 1).toBytes();
    if (c.len() == 0) { return 0 - 1; }
    i32 d = c[0];
    if (d < '0' || d > '9') { return 0 - 1; }
    v = v * 10 + (d - '0');
  }
  return v;
}

/**
 * Every vector in the file, or an `error` saying why not.
 *
 * A missing or unreadable file is an error rather than an empty list: a replay over zero vectors passes,
 * which is the shape this repository keeps finding — a check that stopped checking and said nothing.
 */
export Vectors load(Cli cli) {
  FileRead r = readAll(cli);
  if (!r.ok) {
    return Vectors(Vector[0](), 0, "",
                   "cannot read " + vectorsPath() + " — run `wac run --allow-read --allow-write " +
                   "--allow-run tools/wac/shvectors.wac` to write it");
  }
  u8[] b = r.bytes;
  Line l = lineAt(b, 0);
  if (l.text != "wac-sh-vectors 1") {
    return Vectors(Vector[0](), 0, "", "not a vectors file: " + l.text);
  }
  string oracle = "";
  i32 at = l.next;
  i32 count = 0 - 1;
  for (i32 guard = 0; guard < 8 && count < 0; guard++) {
    Line h = lineAt(b, at);
    at = h.next;
    if (h.text.len() > 6 && h.text.slice(0, 6) == "bash: ") { oracle = h.text.slice(6, h.text.len()); }
    count = numberIn(h.text, "count:");
  }
  if (count < 0) { return Vectors(Vector[0](), 0, oracle, "no count in the header"); }

  Vector[] items = Vector[count](fill: Vector("", false, 0, "", ""));
  i32 n = 0;
  for (i32 i = 0; i < count; i++) {
    Line sl = lineAt(b, at);
    i32 slen = numberIn(sl.text, "S");
    if (slen < 0) { return Vectors(items, n, oracle, "record " + " has no script"); }
    string script = string.fromBytes(sliceOf(b, sl.next, sl.next + slen));
    at = sl.next + slen + 1;

    Line pl = lineAt(b, at);
    i32 p = numberIn(pl.text, "P");
    at = pl.next;
    Line xl = lineAt(b, at);
    i32 status = numberIn(xl.text, "X");
    at = xl.next;

    Line ol = lineAt(b, at);
    i32 olen = numberIn(ol.text, "O");
    string out = olen < 0 ? "" : string.fromBytes(sliceOf(b, ol.next, ol.next + olen));
    at = olen < 0 ? ol.next : ol.next + olen + 1;

    Line el = lineAt(b, at);
    i32 elen = numberIn(el.text, "E");
    string err = elen < 0 ? "" : string.fromBytes(sliceOf(b, el.next, el.next + elen));
    at = elen < 0 ? el.next : el.next + elen + 1;

    items[n] = Vector(script, p == 1, status, out, err);
    n = n + 1;
  }
  return Vectors(items, n, oracle, "");
}

struct FileRead {
  bool ok;
  u8[] bytes;
}

FileRead readAll(Cli cli) {
  FileResult r = cli.readFile(vectorsPath()).wait();
  return FileRead(r.ok, r.ok ? r.bytes : u8[0]());
}
