// A QUIC client's handshake, as a thing that *remembers* rather than a set of functions that recompute.
//
// The logic here was `test/wac/hello_probe.wac`, where every export took `(dcid, scid, serverName)` and
// rebuilt the ClientHello from those three whenever it needed it. That works exactly as long as the
// ClientHello is a pure function of its arguments — which it is only while the private scalar and the
// client random are compile-time constants, as they are on a test bench.
//
// **A real client cannot be written that way**, and this is the gap that writing one found. Its scalar
// is fresh per connection (the whole security of the exchange is that nobody else knows it) and so is
// its random, so the ClientHello it sent is not recoverable from anything but itself. Every later step
// hashes that exact message: the transcript is the ordered bytes of what was actually said, and a
// client that recomputes it is a client that can only ever say the same thing twice.
//
// So `Client` holds the message it sent. `of` builds it once; everything after reads it.
//
// What is still missing, said here rather than discovered later:
//
//   - **The certificate is checked, in two halves, and neither is applied for you.**
//     `serverIdentityVerifies` binds the identity — the CertificateVerify signs the transcript
//     through the Certificate, so a peer that cannot sign with the certificate's key is refused, and
//     so is one holding a certificate for a different host. `serverChainVerdict` takes a trust store
//     and answers whether the chain reaches it. They are separate because a caller with no store
//     still wants the first, and neither is called from `throughServerFinished`: this file completes
//     a handshake and reports, and what a failed check should do to a connection is the caller's.
//   - **One flight, one packet number, no loss detection.** If the server's first datagram goes
//     missing, this waits forever rather than retransmitting — `design/system/0007` step 5.

import { certificateVerifyContent, clientHello, groupX25519, handshakeMessage, hsCertificate,
         hsCertificateVerify, hsFinished, messageBody, messageType, parseServerHello }
         from "../../tls/src/handshake.wac";
import { finishedVerify } from "../../tls/src/keyschedule.wac";
import { Cert, certMatchesHost, certVerifySignature, parseCert, verifyPath }
         from "../../tls/src/x509.wac";
import { suiteAes128Gcm } from "../../tls/src/record.wac";
import { x25519, x25519Base, x25519Shared } from "../../crypto/src/x25519.wac";
import { clientParameters, parametersExtension } from "./params.wac";
import { encodedLength } from "./varint.wac";
import { InitialKeys, openAt, openServerInitial, openShort, sealClientInitial, sealLong, sealShort,
         shortKeyPhase, shortPacketNumber } from "./initial.wac";
import { TYPE_HANDSHAKE, nextPacketAt, parseLong } from "./packet.wac";
import { StreamData, ackFrameLength, cryptoStream, streamFrameLength, streamFrames, writeAck,
         writeCrypto, writeStream } from "./frame.wac";
import { applicationKeys, handshakeKeys, handshakeTrafficSecret, joined, prefix, transcript2,
         transcriptOf } from "./keys.wac";

/**
 * RFC 7748's clamping, applied where the scalar is taken rather than where it is used.
 *
 * `x25519` clamps internally, so an unclamped scalar still produces a working shared secret — but
 * `x25519Base` of the *unclamped* one is a different public key from the one the peer will match, and
 * the failure is a shared secret that disagrees with no other symptom. Clamping once, here, means the
 * key we publish and the key we compute with are the same key.
 */
export u8[] clamped(u8[] raw) {
  u8[] s = u8[32]();
  for (i32 i = 0; i < 32 && i < raw.len(); i++) { s[i] = raw[i]; }
  s[0] = s[0] & 248;
  s[31] = s[31] & 127;
  s[31] = s[31] | 64;
  return s;
}

/**
 * One client-side handshake in progress.
 *
 * `hello` is the whole point: the ClientHello **as sent**, header and all, because that is what every
 * transcript hash in the exchange begins with.
 */
/**
 * A certificate chain in the shape `verifyPath` reads: every DER concatenated, with a `[start, end)`
 * pair per certificate.
 *
 * The two travel together because they have to agree. Returning the bytes from one walk and the
 * offsets from another is the shape that lines up until a chain has an entry the second walk counts
 * differently, and then an offset indexes the middle of a certificate.
 */
export struct Chain {
  u8[] der;
  /** Two entries per certificate: `offsets[2i]` starts it, `offsets[2i+1]` ends it. */
  i32[] offsets;
}

export struct Client {
  /** Our x25519 private scalar, already clamped. Fresh per connection in anything but a test. */
  u8[] scalar;
  /** The ClientHello handshake message we sent, kept because the transcript is bytes, not intent. */
  u8[] hello;
  /**
   * The id we invented to address a server that had not yet chosen one.
   *
   * It is also the Initial keys' salt input in both directions, which is why it stays after the server
   * names itself: the server's Initial is still sealed under keys derived from *this* id.
   */
  u8[] dcid;
  /** Our own id, which the server addresses and which `initial_source_connection_id` must repeat. */
  u8[] scid;
  /**
   * The name we asked for, kept so the certificate can be checked against it.
   *
   * It is already inside `hello`'s SNI extension, but a check that dug it back out would compare the
   * certificate against whatever the message says rather than against what the caller meant.
   */
  string serverName;

  /**
   * Build the ClientHello and remember it.
   *
   * `random` and `scalar` are handed in rather than generated here so that a test can be reproducible
   * and a program can be secure, and neither has to argue with the other about it. A program passes
   * `core.randomBytes(32)` twice; `test/wac/hello_probe.wac` passes two fixed patterns.
   */
  Client of(u8[] scalar, u8[] random, u8[] dcid, u8[] scid, string serverName) {
    u8[] s = clamped(scalar);
    // The four transport parameters a handshake needs to be accepted: initial max data, initial max
    // stream data, max streams, and the idle timeout in milliseconds. Nothing here opens a stream, so
    // the flow-control numbers are a promise this client does not yet exercise — step 5's business.
    u8[] params = clientParameters(scid, 1048576 as i64, 65536 as i64, 8 as i64, 30000 as i64);
    u8[] msg = clientHello(random, u8[0](), suiteAes128Gcm(), groupX25519(), x25519Base(s),
                           serverName.toBytes(), "h3".toBytes(), parametersExtension(params));
    return Client(s, msg, dcid, scid, serverName);
  }

  /** The public half of our scalar — what went in the key share. */
  u8[] publicKey(const this) { return x25519Base(this.scalar); }

  /** Our first datagram: the ClientHello, framed and sealed into an Initial, padded to 1200. */
  u8[] initial(const this) {
    return sealClientInitial(this.dcid, this.scid, this.hello, 0 as i64);
  }

  /** The server's Initial payload, opened with the id we invented. */
  u8[] serverInitialPayload(const this, u8[] datagram) {
    return openServerInitial(datagram, this.dcid, true);
  }

  /** The ServerHello message — header and all, which is what the transcript hashes. */
  u8[] serverHelloMessage(const this, u8[] datagram) {
    return cryptoStream(this.serverInitialPayload(datagram)).data;
  }

  /**
   * Whether that message is one `messageBody` may be handed.
   *
   * **`messageBody` traps on a message that is not whole**, which is the right contract for a TLS
   * parser: over TCP a malformed handshake message is a fatal alert and the connection ends. Over
   * QUIC it is not — a datagram that does not open, or opens to nothing, is one anybody who can
   * reach the four-tuple can send, and RFC 9001 §9 requires discarding it and carrying on.
   *
   * So the guard is here rather than a change to `packages/tls`, exactly as `unprotect` checks the
   * AEAD tag itself rather than making `gcmDecrypt` stop trapping. Both are the same rule: the
   * primitive keeps its refusal for callers that have validated, and the QUIC reader validates.
   *
   * This was found by handing a `Connection` an empty handshake reply, which is what a test does and
   * what a peer that says nothing useful also does. It only became reachable *because* the AEAD trap
   * was fixed this morning — before that, a packet that would not open trapped one layer earlier.
   */
  bool readableMessage(const this, u8[] m) {
    if (m.len() < 4) { return false; }
    i32 len = (m[1] << 16) | (m[2] << 8) | m[3];
    return 4 + len == m.len();
  }

  /** The group the server chose, or 0. x25519 is 0x001d. */
  i32 serverGroup(const this, u8[] datagram) {
    u8[] m = this.serverHelloMessage(datagram);
    if (!this.readableMessage(m)) { return 0; }
    return parseServerHello(messageBody(m)).group;
  }

  /** Whether the server said TLS 1.3 in `supported_versions`, the only place the version is real. */
  bool serverIsTls13(const this, u8[] datagram) {
    u8[] m = this.serverHelloMessage(datagram);
    if (!this.readableMessage(m)) { return false; }
    return parseServerHello(messageBody(m)).isTls13;
  }

  /** Whether the server asked us to try again with another group, which is a different message. */
  bool serverAskedRetry(const this, u8[] datagram) {
    u8[] m = this.serverHelloMessage(datagram);
    if (!this.readableMessage(m)) { return false; }
    return parseServerHello(messageBody(m)).isRetry;
  }

  /** The Diffie-Hellman shared secret: our scalar against the share the server sent. */
  u8[] shared(const this, u8[] datagram) {
    u8[] m = this.serverHelloMessage(datagram);
    if (!this.readableMessage(m)) { return u8[0](); }
    u8[] theirs = parseServerHello(messageBody(m)).keyShare;
    if (theirs.len() != 32) { return u8[0](); }
    // **A small-order point makes this all zeros for every scalar**, so a server sending one would
    // hand the session's keys to anyone watching. Empty is already this function's failure answer.
    // RFC 7748 §6; `packages/tor` and `packages/ssh` have carried the rule and this did not.
    u8[]? dh = x25519Shared(this.scalar, theirs);
    return dh is null ? u8[0]() : dh!;
  }

  /** The transcript through the ServerHello, which is where the handshake keys are taken. */
  u8[] throughServerHello(const this, u8[] datagram) {
    return transcript2(this.hello, this.serverHelloMessage(datagram));
  }

  /** The server's Handshake payload, opened with keys derived through TLS. */
  u8[] handshakePayload(const this, u8[] datagram) {
    i32 at = nextPacketAt(datagram, 0, true);
    if (at == 0) { return u8[0](); }
    u8[] dhe = this.shared(datagram);
    if (dhe.len() == 0) { return u8[0](); }
    return openAt(datagram, at, handshakeKeys(dhe, this.throughServerHello(datagram), true), true, false);
  }

  /** The reassembled CRYPTO stream of the server's Handshake packet. */
  u8[] handshakeCrypto(const this, u8[] datagram) {
    return cryptoStream(this.handshakePayload(datagram)).data;
  }

  /** The first handshake message inside it. 8 is EncryptedExtensions, which follows a ServerHello. */
  i32 handshakeMessageType(const this, u8[] datagram) {
    u8[] c = this.handshakeCrypto(datagram);
    if (c.len() < 4) { return -1; }
    return messageType(c);
  }

  /** The message types the server's flight held, as `1 << (kind & 31)` flags. */
  i32 serverFlightKinds(const this, u8[] datagram) {
    u8[] c = this.handshakeCrypto(datagram);
    i32 seen = 0;
    i32 at = 0;
    while (at + 4 <= c.len()) {
      i32 kind = c[at];
      i32 len = (c[at + 1] << 16) | (c[at + 2] << 8) | c[at + 3];
      if (at + 4 + len > c.len()) { return seen; }
      seen = seen | (1 << (kind & 31));
      at = at + 4 + len;
    }
    return seen;
  }

  /**
   * Whether the server's Finished verifies.
   *
   * The transcript runs from our ClientHello through the server's CertificateVerify — everything
   * *before* the Finished, because a Finished authenticates what came before it and cannot include
   * itself. Getting that boundary wrong by one message is the classic way to compute a verify_data
   * that is right about everything except when it was taken.
   *
   * A client must check this before it sends anything of its own.
   */
  bool serverFinishedVerifies(const this, u8[] datagram) {
    u8[] c = this.handshakeCrypto(datagram);
    i32 fin = finishedAt(c);
    if (fin < 0) { return false; }
    i32 len = (c[fin + 1] << 16) | (c[fin + 2] << 8) | c[fin + 3];
    if (fin + 4 + len > c.len()) { return false; }

    u8[] dhe = this.shared(datagram);
    if (dhe.len() == 0) { return false; }
    u8[] sh = this.serverHelloMessage(datagram);
    u8[] secret = handshakeTrafficSecret(dhe, transcript2(this.hello, sh), true);

    u8[] soFar = joined(joined(this.hello, sh), prefix(c, fin));
    u8[] want = finishedVerify(secret, transcriptOf(soFar));
    if (want.len() != len) { return false; }
    for (i32 i = 0; i < len; i++) {
      if (want[i] != c[fin + 4 + i]) { return false; }
    }
    return true;
  }

  /**
   * The whole chain the server presented, in the shape `verifyPath` reads.
   *
   * The Certificate message is a request context (one length byte), then the list (three), then per
   * entry: three bytes of DER length, the DER, two bytes of extensions. Counted once to size the
   * blob and filled once, so a certificate's bytes and its `[start, end)` pair are written by the
   * same loop and cannot disagree.
   */
  Chain serverChain(const this, u8[] datagram) {
    u8[] c = this.handshakeCrypto(datagram);
    i32 at = 0;
    while (at + 4 <= c.len()) {
      i32 len = (c[at + 1] << 16) | (c[at + 2] << 8) | c[at + 3];
      if (at + 4 + len > c.len()) { return Chain(u8[0](), i32[0]()); }
      if (c[at] == hsCertificate()) {
        i32 start = at + 4;
        i32 end = at + 4 + len;
        if (start >= end) { return Chain(u8[0](), i32[0]()); }
        i32 p = start + 1 + c[start];                        // past the request context
        if (p + 3 > end) { return Chain(u8[0](), i32[0]()); }
        p = p + 3;                                           // past the list's own length

        // Counted first, because the blob has to be one allocation and the offsets have to index it.
        i32 n = 0;
        i32 total = 0;
        i32 q = p;
        while (q + 3 <= end) {
          i32 dlen = (c[q] << 16) | (c[q + 1] << 8) | c[q + 2];
          if (dlen <= 0 || q + 3 + dlen + 2 > end) { break; }
          i32 elen = (c[q + 3 + dlen] << 8) | c[q + 4 + dlen];
          if (q + 5 + dlen + elen > end) { break; }
          n = n + 1;
          total = total + dlen;
          q = q + 5 + dlen + elen;
        }
        if (n == 0) { return Chain(u8[0](), i32[0]()); }

        u8[] der = u8[total]();
        i32[] offs = i32[n * 2]();
        i32 w = 0;
        i32 k = 0;
        q = p;
        while (k < n) {
          i32 dlen = (c[q] << 16) | (c[q + 1] << 8) | c[q + 2];
          i32 elen = (c[q + 3 + dlen] << 8) | c[q + 4 + dlen];
          offs[k * 2] = w;
          for (i32 i = 0; i < dlen; i++) { der[w + i] = c[q + 3 + i]; }
          w = w + dlen;
          offs[k * 2 + 1] = w;
          q = q + 5 + dlen + elen;
          k = k + 1;
        }
        return Chain(der, offs);
      }
      at = at + 4 + len;
    }
    return Chain(u8[0](), i32[0]());
  }

  /**
   * Whether the chain reaches one of `roots`, and `verifyPath`'s code for why it did not.
   *
   * Zero is success; every other value is one of `x509.wac`'s reasons — expired, no path, a name the
   * certificate does not carry. Separate from `serverIdentityVerifies` because it needs something
   * that file cannot invent: a caller with no trust store still wants the signature checked, and a
   * caller with one wants both. Reporting the code rather than a boolean is `verifyPath`'s own
   * decision, and repeating it here keeps a diagnostic that says which check failed.
   */
  i32 serverChainVerdict(const this, u8[] datagram, u8[] roots, i32[] rootOffsets, i64 now) {
    Chain ch = this.serverChain(datagram);
    if (ch.offsets.len() == 0) { return 8; }                 // nothing to verify, as verifyPath says
    return verifyPath(ch.der, ch.offsets, roots, rootOffsets, this.serverName.toBytes(), now, 8);
  }

  /**
   * The server's leaf certificate, out of its Certificate message, or empty.
   *
   * The message is a context (one length byte), then the chain (three), then per-entry: three bytes
   * of DER length, the DER, two bytes of extensions. Only the first entry is read — the leaf is what
   * an identity check starts from, and this package has no path building to do anything with the
   * rest yet.
   */
  u8[] serverCertificate(const this, u8[] datagram) {
    u8[] c = this.handshakeCrypto(datagram);
    i32 at = 0;
    while (at + 4 <= c.len()) {
      i32 kind = c[at];
      i32 len = (c[at + 1] << 16) | (c[at + 2] << 8) | c[at + 3];
      if (at + 4 + len > c.len()) { return u8[0](); }
      if (kind == hsCertificate()) {
        i32 p = at + 4;
        if (p >= c.len()) { return u8[0](); }
        p = p + 1 + c[p];                                    // the request context
        if (p + 3 > c.len()) { return u8[0](); }
        p = p + 3;                                           // the chain's own length
        if (p + 3 > c.len()) { return u8[0](); }
        i32 dlen = (c[p] << 16) | (c[p + 1] << 8) | c[p + 2];
        p = p + 3;
        if (dlen <= 0 || p + dlen > c.len()) { return u8[0](); }
        u8[] der = u8[dlen]();
        for (i32 i = 0; i < dlen; i++) { der[i] = c[p + i]; }
        return der;
      }
      at = at + 4 + len;
    }
    return u8[0]();
  }

  /**
   * Whether the server's CertificateVerify signs this handshake with the key in its certificate.
   *
   * **This is the check that binds an identity to a connection**, and the one this client did not
   * have. `serverFinishedVerifies` proves the peer did the same Diffie-Hellman and saw the same
   * transcript — which anybody in the middle also did, having done one exchange with each side. What
   * they cannot do is sign the transcript with the certificate's private key.
   *
   * The signature covers everything through the Certificate itself, so it binds the key exchange, the
   * identity and every byte either side has said. A verifier that hashed one message too few or too
   * many would produce a plausible failure with correct inputs, which is the classic way to get this
   * subtly wrong.
   */
  bool serverIdentityVerifies(const this, u8[] datagram) {
    return this.identityVerifiesUsing(datagram, this.serverSignature(datagram));
  }

  /**
   * The signature out of the server's CertificateVerify, or empty.
   *
   * Separate from the check so a test can substitute one. A verifier with no way to be handed a wrong
   * signature can only ever be observed saying yes, and "it agreed with a real server" is equally
   * what a function returning `true` would do.
   */
  u8[] serverSignature(const this, u8[] datagram) {
    u8[] c = this.handshakeCrypto(datagram);
    i32 cvAt = this.certificateVerifyAt(c);
    if (cvAt < 0) { return u8[0](); }
    i32 cvLen = (c[cvAt + 1] << 16) | (c[cvAt + 2] << 8) | c[cvAt + 3];
    i32 b = cvAt + 4;
    if (b + 4 > c.len()) { return u8[0](); }
    i32 slen = (c[b + 2] << 8) | c[b + 3];
    if (b + 4 + slen > c.len() || slen != cvLen - 4) { return u8[0](); }
    u8[] sig = u8[slen]();
    for (i32 i = 0; i < slen; i++) { sig[i] = c[b + 4 + i]; }
    return sig;
  }

  /** Where the CertificateVerify starts in a handshake CRYPTO stream, or -1. */
  i32 certificateVerifyAt(const this, u8[] c) {
    i32 at = 0;
    while (at + 4 <= c.len()) {
      i32 len = (c[at + 1] << 16) | (c[at + 2] << 8) | c[at + 3];
      if (at + 4 + len > c.len()) { return -1; }
      if (c[at] == hsCertificateVerify()) { return at; }
      at = at + 4 + len;
    }
    return -1;
  }

  /** The identity check, with the signature supplied — see `serverSignature`. */
  bool identityVerifiesUsing(const this, u8[] datagram, u8[] sig) {
    if (sig.len() == 0) { return false; }
    u8[] der = this.serverCertificate(datagram);
    if (der.len() == 0) { return false; }
    Cert leaf = parseCert(der);
    if (!leaf.wellFormed) { return false; }

    u8[] c = this.handshakeCrypto(datagram);
    i32 cvAt = this.certificateVerifyAt(c);
    if (cvAt < 0) { return false; }
    i32 scheme = (c[cvAt + 4] << 8) | c[cvAt + 5];

    // **The name, too.** A signature proves the peer holds the key in the certificate; it says
    // nothing about whether that certificate is for the host we meant to reach. A peer holding a
    // perfectly valid certificate for somewhere else passes the signature and fails here, and it is
    // one answer rather than two because a caller that could get `true` from one of them and act on
    // it is the whole failure being closed.
    if (!certMatchesHost(leaf, this.serverName.toBytes())) { return false; }

    // Through the Certificate and not past it: everything before the CertificateVerify itself.
    u8[] through = joined(joined(this.hello, this.serverHelloMessage(datagram)), prefix(c, cvAt));
    return certVerifySignature(leaf, scheme, certificateVerifyContent(transcriptOf(through), true), sig);
  }

  /** The id the server chose for itself, which is where our next packet has to be addressed. */
  u8[] serverChosenId(const this, u8[] datagram) {
    return parseLong(datagram, 0, true).scid;
  }

  /**
   * The transcript through the server's Finished, which is where the application secrets are taken.
   *
   * The same run of bytes our own Finished authenticates. Both are computed from it, one epoch apart,
   * and a client that took its application secret anywhere else gets keys the server does not have.
   */
  u8[] throughServerFinished(const this, u8[] datagram) {
    return joined(joined(this.hello, this.serverHelloMessage(datagram)), this.handshakeCrypto(datagram));
  }

  /**
   * Open a **short-header** packet the server sent after the handshake — the application epoch.
   *
   * `handshakeReply` is the datagram the handshake was completed from, because that is what the
   * transcript and the shared secret come out of; `packet` is whatever arrived afterwards. Empty if it
   * will not open, which for a first application packet means the handshake did not actually complete.
   *
   * The id length is ours: the server addresses the id *we* chose, and a short header does not say how
   * long it is. `scid.len()` is that knowledge, and it is the one number here that cannot be read off
   * the wire — see `openShort`.
   */
  u8[] openApplication(const this, u8[] handshakeReply, u8[] packet) {
    u8[] dhe = this.shared(handshakeReply);
    if (dhe.len() == 0) { return u8[0](); }
    u8[] tr = transcriptOf(this.throughServerFinished(handshakeReply));
    return openShort(packet, 0, applicationKeys(dhe, tr, true), this.scid.len(), true);
  }

  /**
   * The 1-RTT keys for one direction. `isServer` is the sender's side, as everywhere else here.
   *
   * Both directions come out of the same transcript point — through the server's Finished — so this
   * takes the handshake reply rather than any later state.
   */
  InitialKeys applicationKeysFor(const this, u8[] handshakeReply, bool isServer) {
    u8[] dhe = this.shared(handshakeReply);
    if (dhe.len() == 0) { return InitialKeys(u8[0](), u8[0](), u8[0]()); }
    return applicationKeys(dhe, transcriptOf(this.throughServerFinished(handshakeReply)), isServer);
  }

  /**
   * A 1-RTT packet carrying one STREAM frame — the first thing this client can *say*.
   *
   * Everything before this reads what a server sent or answers a handshake. This is application
   * data, which is the point of the connection.
   *
   * Addressed to the id the server chose, like the Finished before it. `number` is the packet number
   * in the **application** number space, which starts again at zero: each epoch numbers its own
   * packets, and reusing a handshake number here would reuse a nonce under a different key, which is
   * harmless, or under the same key, which is catastrophic. The caller holds the counter because this
   * struct does not yet hold connection state — `design/system/0007` step 5.
   *
   * Not padded. A client pads a datagram carrying an *Initial*; this carries neither.
   */
  u8[] streamPacket(const this, u8[] handshakeReply, i64 streamId, i64 offset, u8[] data, bool fin,
                    i64 number) {
    InitialKeys keys = this.applicationKeysFor(handshakeReply, false);
    if (keys.key.len() == 0) { return u8[0](); }
    u8[] frames = u8[streamFrameLength(streamId, offset, data.len())]();
    if (writeStream(frames, 0, streamId, offset, data, fin) == 0) { return u8[0](); }
    return sealShort(this.serverChosenId(handshakeReply), frames, number, keys, 0);
  }

  /**
   * The bytes the server sent on one stream, out of one 1-RTT packet.
   *
   * The other direction of `streamPacket`, and the half that makes a stream bidirectional. The
   * reassembly is `streamFrames` in `frame.wac`, which is where it can be driven with frames out of
   * order — an echo of fourteen bytes arrives in one frame and would never exercise it.
   *
   * Empty when the packet does not open, when it carries no data for that stream, or when what it
   * carries has a gap: a single packet has nowhere to keep a partial stream, and that is connection
   * state, which is what step 5 still lacks.
   */
  u8[] streamBytes(const this, u8[] handshakeReply, u8[] packet, i64 streamId) {
    u8[] payload = this.openApplication(handshakeReply, packet);
    if (payload.len() == 0) { return u8[0](); }
    StreamData s = streamFrames(payload, streamId);
    return s.whole ? s.data : u8[0]();
  }

  /** Whether that packet carried the end of the stream — the peer saying it will send no more. */
  bool streamFinished(const this, u8[] handshakeReply, u8[] packet, i64 streamId) {
    u8[] payload = this.openApplication(handshakeReply, packet);
    if (payload.len() == 0) { return false; }
    return streamFrames(payload, streamId).fin;
  }

  /**
   * Seal arbitrary frames into a 1-RTT packet with a given number.
   *
   * The general form of `streamPacket` and `ackPacket`, which are it with the frames written for you.
   * `connection.wac` needs it because a retransmission carries frames it was handed rather than
   * frames it builds — it does not know or care what is in them.
   */
  u8[] sealFrames(const this, u8[] handshakeReply, u8[] frames, i64 number) {
    InitialKeys keys = this.applicationKeysFor(handshakeReply, false);
    if (keys.key.len() == 0) { return u8[0](); }
    return sealShort(this.serverChosenId(handshakeReply), frames, number, keys, 0);
  }

  /**
   * The packet number a server's 1-RTT packet carried, or -1.
   *
   * What an acknowledgement is *about*. Truncated rather than decoded — `shortPacketNumber` says why,
   * and it is the same missing state this whole step is about.
   */
  i64 applicationPacketNumber(const this, u8[] handshakeReply, u8[] packet) {
    InitialKeys keys = this.applicationKeysFor(handshakeReply, true);
    if (keys.key.len() == 0) { return -1 as i64; }
    return shortPacketNumber(packet, 0, keys, this.scid.len());
  }

  /**
   * A 1-RTT packet acknowledging `largest` and the `firstRange` packets immediately below it.
   *
   * **Not politeness.** A peer that is never acknowledged retransmits, and then declares the
   * connection lost: without this a client can complete a handshake and hold a conversation for as
   * long as the peer's idle timeout and no longer, which looks like working right up until it does
   * not. It is also what a peer's round-trip estimate is built from.
   *
   * One range: a *gap* would need a receiver that remembers which packets arrived, which is the
   * state this struct still does not keep. But the range's width is the caller's to state, because
   * only the caller knows how much it saw. `firstRange` of 0 acknowledges `largest` alone, which is
   * always honest for a packet you have in your hand; `firstRange` equal to `largest` acknowledges
   * everything from 0 and is only honest if you received all of it.
   *
   * **This used to be `largest` unconditionally, and that was `issues/system/0156`.** Claiming a
   * contiguous range we did not receive is worse than saying nothing — a peer that believes a lost
   * packet arrived will never resend it, and QUIC calls acknowledging an unsent packet a
   * PROTOCOL_VIOLATION and closes. The caller that got this wrong had seen exactly one 1-RTT packet
   * and acknowledged every number below it, which is honest only when that packet is number 0. On a
   * quiet machine it always was.
   */
  u8[] ackPacket(const this, u8[] handshakeReply, i64 largest, i64 firstRange, i64 number) {
    InitialKeys keys = this.applicationKeysFor(handshakeReply, false);
    if (keys.key.len() == 0) { return u8[0](); }
    u8[] frames = u8[ackFrameLength(largest, 0 as i64, firstRange)]();
    if (writeAck(frames, 0, largest, 0 as i64, firstRange) == 0) { return u8[0](); }
    return sealShort(this.serverChosenId(handshakeReply), frames, number, keys, 0);
  }

  /** The key phase of such a packet, or -1. 1 means the server has already updated its keys. */
  i32 applicationKeyPhase(const this, u8[] handshakeReply, u8[] packet) {
    u8[] dhe = this.shared(handshakeReply);
    if (dhe.len() == 0) { return -1; }
    u8[] tr = transcriptOf(this.throughServerFinished(handshakeReply));
    return shortKeyPhase(packet, 0, applicationKeys(dhe, tr, true), this.scid.len());
  }

  /**
   * Our second datagram: a Handshake packet carrying our Finished.
   *
   * Addressed to the id the *server* chose — a connection is identified by the id its receiver picked,
   * so the destination changes the moment the server tells us one. Sending it back to the id we
   * invented would be addressing a connection nobody has.
   *
   * No padding: RFC 9000 §14.1 makes a client pad any datagram carrying an **Initial**, and this
   * carries a Handshake. Padding it anyway would work and would waste a kilobyte per handshake.
   */
  u8[] finished(const this, u8[] datagram) {
    u8[] dhe = this.shared(datagram);
    if (dhe.len() == 0) { return u8[0](); }
    u8[] upToServerHello = this.throughServerHello(datagram);

    u8[] through = this.throughServerFinished(datagram);
    u8[] secret = handshakeTrafficSecret(dhe, upToServerHello, false);
    u8[] verify = finishedVerify(secret, transcriptOf(through));
    u8[] msg = handshakeMessage(hsFinished(), verify);

    i32 framed = 1 + 1 + encodedLength(msg.len() as i64) + msg.len();
    u8[] frames = u8[framed]();
    if (writeCrypto(frames, 0, 0 as i64, msg) == 0) { return u8[0](); }

    InitialKeys keys = handshakeKeys(dhe, upToServerHello, false);
    return sealLong(TYPE_HANDSHAKE(), this.serverChosenId(datagram), this.scid, frames, 0 as i64, keys, 0);
  }
}

/** Where the Finished message begins in a run of handshake messages, or -1 if there is none. */
i32 finishedAt(u8[] c) {
  i32 at = 0;
  while (at + 4 <= c.len()) {
    i32 kind = c[at];
    i32 len = (c[at + 1] << 16) | (c[at + 2] << 8) | c[at + 3];
    if (kind == hsFinished()) { return at; }
    at = at + 4 + len;
  }
  return -1;
}

/** Where the Handshake packet begins in a datagram, or 0 if the server coalesced nothing. */
export i32 handshakeAt(u8[] datagram) { return nextPacketAt(datagram, 0, true); }
