// A QUIC packet's header, as far as it can be read before the keys exist.
//
// RFC 9000 §17. Everything here is readable by anybody on the path — that is the design, because a
// router has to route and a load balancer has to find the connection id. What is *not* readable
// without keys is the packet number and the payload, and this file stops exactly where they begin.
//
// ## Two shapes, and the second is the one that surprises
//
// A **long header** carries its own version and both connection ids with their lengths, so it can be
// parsed by a stranger with no context at all. That is what an Initial is, and it is why a server
// can answer a client it has never heard of.
//
// A **short header** does not. It has one connection id and *no length for it* — the receiver is
// expected to know how long its own ids are, because it chose them. So a short header cannot be
// parsed in isolation, and a parser that pretends otherwise reads the packet number as part of the
// id and every field after that is wrong. `parseShort` therefore takes the length as an argument;
// there is no signature that could work without it, and that is the point rather than an awkwardness.
//
// ## Why connection ids are carried from the first parse
//
// design/system 0007 D5: a connection is identified by its id and not by its address, so a peer may
// legitimately move mid-connection. A first pass that keyed connections by address would work on
// loopback, pass every test written on loopback, and be unpickable later. Carrying the id costs
// nothing now.

import { Varint, decode as varint } from "./varint.wac";

/** How the first byte reads. */
export i32 FORM_LONG() { return 0x80; }
export i32 FIXED_BIT() { return 0x40; }

/** Long-header packet types, in the two bits below the fixed bit. */
export i32 TYPE_INITIAL() { return 0; }
export i32 TYPE_0RTT() { return 1; }
export i32 TYPE_HANDSHAKE() { return 2; }
export i32 TYPE_RETRY() { return 3; }

/** Version 1, and the only one this refuses to treat as unknown. */
export i32 VERSION_1() { return 1; }

/**
 * What a long header says, and where the rest of the packet starts.
 *
 * `ok` is false for anything that is not a whole, well-formed long header — a truncated datagram, a
 * connection id longer than the 20 bytes RFC 9000 §17.2 allows, a token or length field that runs
 * off the end. There is no partial answer: a header that cannot be read completely tells you nothing
 * you may act on, and returning the fields that happened to fit is how a parser is talked into
 * reading a length from somebody else's payload.
 */
export struct LongHeader {
  bool ok;
  i32 version;
  i32 packetType;
  u8[] dcid;
  u8[] scid;
  /** Initial only: the token a Retry gave the client, empty otherwise. */
  u8[] token;
  /** The length field: packet number plus payload, in bytes. 0 for Retry, which has none. */
  i64 length;
  /** Where the packet number begins — the first byte this file cannot read. */
  i32 numberAt;
}

/** The largest a connection id may be. RFC 9000 §17.2: "an endpoint MUST NOT use a CID longer". */
export i32 MAX_CID() { return 20; }

/** Whether the byte at `at` begins a long header. Cheap, and the only question answerable in one byte. */
export bool isLong(u8[] b, i32 at) {
  return at >= 0 && at < b.len() && (b[at] & FORM_LONG()) != 0;
}

/** Copy `n` bytes from `at`, or an empty array if they are not all there. */
u8[] slice(u8[] b, i32 at, i32 n) {
  if (n < 0 || at < 0 || at + n > b.len()) { return u8[0](); }
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = b[at + i]; }
  return out;
}

/** A LongHeader that says nothing, for every way a parse can fail. */
LongHeader no() {
  return LongHeader(false, 0, 0, u8[0](), u8[0](), u8[0](), 0 as i64, 0);
}

/**
 * Parse a long header from `at`.
 *
 * ## `greased` is the caller's answer, because the parser cannot have it
 *
 * RFC 9000 §17.2 calls bit 0x40 the *fixed bit* and a packet without it is not a valid version-1
 * packet. RFC 9287 then makes it negotiable: an endpoint that advertises `grease_quic_bit` is
 * telling its peer it may send zero there, precisely so that middleboxes cannot use the bit to
 * recognise QUIC. **A real Deno QUIC server greases about two replies in three** — see
 * `test/wac/greased_test.wac`, which is why this parameter exists rather than a comment claiming no
 * version-1 peer sends a zero. One does.
 *
 * Whether a zero is acceptable is therefore connection state — did *we* advertise the parameter? —
 * and a parser handed one packet cannot know it. So the caller says, exactly as `parseShortDcid`
 * takes a connection id length only the receiver knows. Passing `true` when the parameter was not
 * advertised accepts packets a conforming peer would not send; passing `false` when it was drops
 * two thirds of a real server's replies. Neither is a default this file may pick.
 */
export LongHeader parseLong(u8[] b, i32 at, bool greased) {
  if (at < 0 || at + 7 > b.len()) { return no(); }
  i32 first = b[at];
  if ((first & FORM_LONG()) == 0) { return no(); }
  if (!greased && (first & FIXED_BIT()) == 0) { return no(); }
  i32 packetType = (first >> 4) & 3;

  i32 version = 0;
  for (i32 i = 1; i <= 4; i++) { version = (version << 8) | b[at + i]; }

  i32 p = at + 5;
  i32 dlen = b[p];
  if (dlen > MAX_CID()) { return no(); }
  p++;
  u8[] dcid = slice(b, p, dlen);
  if (dlen > 0 && dcid.len() == 0) { return no(); }
  p = p + dlen;
  if (p >= b.len()) { return no(); }

  i32 slen = b[p];
  if (slen > MAX_CID()) { return no(); }
  p++;
  u8[] scid = slice(b, p, slen);
  if (slen > 0 && scid.len() == 0) { return no(); }
  p = p + slen;

  // **A Retry has no length and no packet number**, so it stops here: what follows is a token and an
  // integrity tag, and pretending to find a length in them would read the tag as one.
  if (packetType == TYPE_RETRY()) {
    return LongHeader(true, version, packetType, dcid, scid, u8[0](), 0 as i64, p);
  }

  u8[] token = u8[0]();
  if (packetType == TYPE_INITIAL()) {
    Varint tl = varint(b, p);
    if (tl.size == 0) { return no(); }
    p = p + tl.size;
    i32 tlen = tl.value as~ i32;
    if (tlen < 0 || p + tlen > b.len()) { return no(); }
    token = slice(b, p, tlen);
    p = p + tlen;
  }

  Varint len = varint(b, p);
  if (len.size == 0) { return no(); }
  p = p + len.size;
  // The length counts the packet number and payload, and both must be inside this datagram — a
  // length longer than what arrived is the shape a parser gets talked into trusting.
  if (len.value < (0 as i64) || (p as i64) + len.value > (b.len() as i64)) { return no(); }

  return LongHeader(true, version, packetType, dcid, scid, token, len.value, p);
}

/**
 * Where the packet **after** the one at `at` begins, or 0 when there is not another.
 *
 * RFC 9000 §12.2: a sender may coalesce several packets into one datagram, and a server's first
 * flight normally does — an Initial carrying the ServerHello and a Handshake carrying everything
 * after it, in 1200 bytes. Each long header's `length` is what makes that walkable; a short header
 * has none, so it is always last and this answers 0 for one.
 *
 * 0 also means "not another one here" for a Retry, a version-negotiation packet, or anything that
 * will not parse. A caller loops while this is positive and treats the remainder as the last packet.
 */
export i32 nextPacketAt(u8[] b, i32 at, bool greased) {
  LongHeader h = parseLong(b, at, greased);
  if (!h.ok) { return 0; }
  if (h.packetType == TYPE_RETRY()) { return 0; }
  i64 end = (h.numberAt as i64) + h.length;
  i64 room = b.len() as i64;
  if (end >= room) { return 0; }
  return end as~ i32;
}

/**
 * The destination connection id of a short header, whose length only the receiver knows.
 *
 * Empty when the packet is too short for `cidLen` bytes after the first, or when it is not a short
 * header at all. `greased` means the same thing it does in `parseLong`. There is no other field this file can read: after the id comes the packet number,
 * which is protected.
 */
export u8[] parseShortDcid(u8[] b, i32 at, i32 cidLen, bool greased) {
  if (at < 0 || at >= b.len()) { return u8[0](); }
  if ((b[at] & FORM_LONG()) != 0) { return u8[0](); }
  if (!greased && (b[at] & FIXED_BIT()) == 0) { return u8[0](); }
  if (cidLen < 0 || cidLen > MAX_CID()) { return u8[0](); }
  return slice(b, at + 1, cidLen);
}

/**
 * Whether this is a **version-negotiation** packet: a long header whose version is zero.
 *
 * RFC 9000 §17.2.1. It is the one long header with no type — the four type bits are unused and a
 * sender is told to set them at random, so a reader that switched on the type would branch on noise.
 * `parseLong` reads version and type from the same first bytes and does not know the difference,
 * which is why this is a question a caller asks before it trusts a type.
 */
export bool isVersionNegotiation(u8[] b, i32 at) {
  if (at < 0 || at + 5 > b.len()) { return false; }
  if ((b[at] & FORM_LONG()) == 0) { return false; }
  return b[at + 1] == 0 && b[at + 2] == 0 && b[at + 3] == 0 && b[at + 4] == 0;
}

/**
 * The versions a version-negotiation packet offers, as a flat array of four-byte big-endian numbers.
 *
 * Empty when the packet is not one, or when what follows the ids is not a whole number of versions —
 * a trailing byte or three is a malformed packet rather than a version to be guessed at.
 *
 * **A server may include a reserved version it does not support**, deliberately, to check that
 * clients ignore unknown ones rather than picking the first. So a caller must look for a version it
 * knows rather than take `versions[0]`.
 */
export i32[] negotiationVersions(u8[] b, i32 at) {
  if (!isVersionNegotiation(b, at)) { return i32[0](); }
  i32 p = at + 5;
  if (p >= b.len()) { return i32[0](); }
  i32 dlen = b[p];
  if (dlen > MAX_CID()) { return i32[0](); }
  p = p + 1 + dlen;
  if (p >= b.len()) { return i32[0](); }
  i32 slen = b[p];
  if (slen > MAX_CID()) { return i32[0](); }
  p = p + 1 + slen;
  if (p > b.len()) { return i32[0](); }

  i32 room = b.len() - p;
  if (room == 0 || room % 4 != 0) { return i32[0](); }
  i32 n = room / 4;
  i32[] out = i32[n]();
  for (i32 i = 0; i < n; i++) {
    i32 v = 0;
    for (i32 k = 0; k < 4; k++) { v = (v << 8) | b[p + i * 4 + k]; }
    out[i] = v;
  }
  return out;
}

/** Whether a version-negotiation packet offers the version this package speaks. */
export bool negotiationOffersV1(u8[] b, i32 at) {
  i32[] vs = negotiationVersions(b, at);
  for (i32 i = 0; i < vs.len(); i++) {
    if (vs[i] == VERSION_1()) { return true; }
  }
  return false;
}

/**
 * A truncated packet number restored to the full one — RFC 9000 §A.3.
 *
 * Only the low bits travel: a packet number is up to 62 bits and its header carries one to four
 * bytes of it, so a receiver reconstructs the rest from the largest it has already seen. The rule is
 * "the candidate nearest to the one expected next", which is what makes a one-byte number sufficient
 * for a connection that is keeping up and insufficient the moment it is not.
 *
 * `largest` is the largest number successfully **processed**, not received — a packet that failed
 * authentication tells you nothing and must not move the window, or a peer could shift it by sending
 * noise. -1 when none has been.
 *
 * The two corrections are the whole of it: a candidate more than half a window below what is expected
 * is one that has wrapped and belongs a window higher, and one more than half a window above has not
 * wrapped yet and belongs a window lower. The extra bound on each is the RFC's, and stops the answer
 * leaving the 62-bit space.
 */
export i64 decodePacketNumber(i64 largest, i64 truncated, i32 bits) {
  if (bits <= 0 || bits > 32) { return truncated; }
  i64 expected = largest + (1 as i64);
  i64 win = (1 as i64) << (bits as i64);
  i64 hwin = win / (2 as i64);
  i64 mask = win - (1 as i64);
  i64 candidate = (expected & ~mask) | truncated;
  // 2^62, the largest a packet number may be — the RFC's `(1 << 62) - pn_win` bound written out,
  // since wac has no unsigned shift by a variable amount to spare here.
  i64 limit = (1 as i64) << (62 as i64);
  if (candidate + hwin <= expected && candidate + win < limit) { return candidate + win; }
  if (candidate > expected + hwin && candidate >= win) { return candidate - win; }
  return candidate;
}
