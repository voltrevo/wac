// The state that turns a packet into a connection: what was sent, what was acknowledged, what to
// send again.
//
// Everything in `client.wac` is a pure function of the bytes it is handed — build this packet, open
// that one — and the caller supplies the packet number, because there was nowhere to keep a counter.
// That is the whole difference between the two files, and it is why a client that could complete a
// handshake and carry a stream still could not survive one lost datagram.
//
// ## Frames are retransmitted; packets are not
//
// RFC 9000 §13.3, and it is the rule everything here is shaped by. A QUIC packet number is used once
// and never again — reusing one reuses an AEAD nonce, which is the failure that loses the key rather
// than the packet — so "resending" means putting the same *frames* in a **new** packet with the next
// number. A reader that has already seen those frames sees them twice and discards the duplicates,
// which is exactly what stream offsets and packet numbers are for.
//
// So this keeps the frames of every packet in flight, not the packets.
//
// ## What is deliberately not here
//
// **No timer.** RFC 9002's loss detection is a probe timeout computed from a smoothed round-trip and
// a variance estimate, and this has neither: a caller decides when to give up on a packet and calls
// `resend`. That is honest about where the decision lives and it is the piece a real client needs
// next — a wrong timeout is a connection that either stalls or floods.
//
// **No congestion control.** Nothing here counts bytes in flight or slows down. On a loopback test
// that is invisible; on a real path it is the difference between a connection and a problem.
//
// **Acknowledgement is by largest alone.** `onAck` takes the largest acknowledged and treats
// everything below it as delivered, which is what a peer's contiguous ACK means and is wrong for one
// with gaps. Reading the ranges is a change to this file and not to `frame.wac`, which already parses
// them — the reader is ahead of the state, as it has been all along.

import { Client } from "./client.wac";
import { decodePacketNumber } from "./packet.wac";

/** One packet in flight: what it carried, and what it was numbered. */
export struct InFlight {
  i64 number;
  u8[] frames;
  /** False once an acknowledgement covers it. Kept rather than removed, so numbering stays honest. */
  bool live;
}

/**
 * What `Connection.checked` answers: a connection, or why there is not one.
 *
 * Two fields rather than a nullable connection alone, because *why* is what a caller reports and a
 * program that can only say "it did not work" sends its user looking in the wrong place — an expired
 * certificate and a certificate for the wrong host are the same silence otherwise.
 */
export struct Opened {
  /**
   * Zero when the connection is authenticated.
   *
   * Otherwise `-1` when the CertificateVerify signature or the name failed, and one of
   * `verifyPath`'s own codes — 1 through 12 — when the chain did not reach a root. The negative
   * value is deliberately outside that range: one number carrying two kinds of failure has to make
   * them tellable apart, or a caller mapping codes to sentences names the wrong rule.
   */
  i32 verdict;
  /** Null unless `verdict` is zero. */
  Connection? connection;
}

export struct Connection {
  Client client;
  /**
   * The datagram the handshake was completed from.
   *
   * Every key in the application epoch derives from it — the shared secret and the transcript both —
   * so it is held rather than the keys, which would be four arrays instead of one and would have to
   * be kept in step with each other.
   */
  u8[] handshakeReply;
  /** The next packet number to use. Never reused, which is the nonce rule. */
  i64 next;
  InFlight[] sent;
  i32 count;
  /** The largest packet number the peer has acknowledged, or -1. */
  i64 acked;
  /**
   * The largest packet number this end has **processed**, or -1 — what RFC 9000 §A.3 decodes against.
   *
   * *Processed*, not received, and the distinction is the whole reason this is a field rather than a
   * parameter. A packet that fails authentication tells you nothing: anybody who can reach the
   * four-tuple can send one, so letting it move the window lets a stranger move it with noise, and a
   * window moved far enough makes the peer's real packets decode to the wrong numbers.
   */
  i64 largestProcessed;

  Connection of(Client client, u8[] handshakeReply) {
    return Connection(client, handshakeReply, 0 as i64, InFlight[0](), 0, -1 as i64, -1 as i64);
  }

  /**
   * A connection to a server whose certificate checked out, or the reason it did not.
   *
   * **`of` above asks nothing**, which is right for a test and wrong for a program: a handshake
   * completes against whoever answers, so a caller that simply forgets to verify gets a connection
   * that behaves exactly like an authenticated one. This is the constructor that cannot be used that
   * way — there is no connection to hold unless both checks passed.
   *
   * Both, because they answer different questions and either alone is defeatable. The
   * CertificateVerify signature says the peer holds the key in the certificate it sent, and someone
   * in the middle who generated their own certificate can produce that. The chain says an authority
   * vouched for it, and a certificate for another host chains perfectly well. `serverIdentityVerifies`
   * covers the first and the name; `serverChainVerdict` covers the second.
   */
  Opened checked(Client client, u8[] handshakeReply, u8[] roots, i32[] rootOffsets, i64 now) {
    if (!client.serverIdentityVerifies(handshakeReply)) { return Opened(-1, null); }
    i32 verdict = client.serverChainVerdict(handshakeReply, roots, rootOffsets, now);
    if (verdict != 0) { return Opened(verdict, null); }
    return Opened(0, Connection.of(client, handshakeReply));
  }

  /** Room for one more record, doubling as `Headers.push` does. */
  void reserve(this) {
    if (this.count == this.sent.len()) {
      i32 n = this.sent.len() == 0 ? 8 : this.sent.len() * 2;
      InFlight[] grown = InFlight[n]();
      for (i32 i = 0; i < this.count; i++) { grown[i] = this.sent[i]; }
      this.sent = grown;
    }
  }

  /**
   * Take the next packet number and remember what will go in it.
   *
   * **The bookkeeping, with no cryptography in it**, which is the whole reason it is a method of its
   * own: `send` below cannot run without a real handshake behind it, and none of the accounting —
   * numbering, liveness, what a retransmission carries — depends on a key. Splitting them is what
   * lets `test/wac/connection_test.wac` drive the part that a real server cannot observe anyway.
   *
   * The frames are kept because they are what a retransmission carries. The packet is not: it is
   * sealed under a nonce derived from its number, so it can never legitimately go on the wire twice.
   */
  i64 track(this, u8[] frames) {
    i64 number = this.next;
    this.next = number + (1 as i64);
    this.reserve();
    this.sent[this.count] = InFlight(number, frames, true);
    this.count++;
    return number;
  }

  /**
   * Seal `frames` into a 1-RTT packet, remember them, and take the next number.
   *
   * A number is consumed even if the sealing fails, which keeps "a number is used once" true without
   * anything having to reason about partial failure. Numbers are 62 bits and a wasted one costs
   * nothing; a reused one costs the key.
   */
  u8[] send(this, u8[] frames) {
    return this.client.sealFrames(this.handshakeReply, frames, this.track(frames));
  }

  /**
   * A peer's acknowledgement, by its largest.
   *
   * Everything at or below it is taken as delivered — which is what a contiguous ACK means, and is
   * optimistic for one with gaps. The optimistic direction is the dangerous one: a packet believed
   * delivered is never resent. `frame.wac` reads the ranges already, so closing this is state rather
   * than parsing.
   */
  void onAck(this, i64 largest) {
    if (largest > this.acked) { this.acked = largest; }
    for (i32 i = 0; i < this.count; i++) {
      if (this.sent[i].number <= largest) { this.sent[i].live = false; }
    }
  }

  /** How many packets are still unacknowledged. */
  i32 outstanding(const this) {
    i32 n = 0;
    for (i32 i = 0; i < this.count; i++) {
      if (this.sent[i].live) { n = n + 1; }
    }
    return n;
  }

  /** The number of the oldest unacknowledged packet, or -1 when everything has been acknowledged. */
  i64 oldestUnacked(const this) {
    for (i32 i = 0; i < this.count; i++) {
      if (this.sent[i].live) { return this.sent[i].number; }
    }
    return -1 as i64;
  }

  /**
   * The bookkeeping half of `resend`: retire the oldest live record and track its frames anew.
   *
   * Answers the new number, or -1 when there was nothing outstanding.
   */
  i64 trackResend(this) {
    for (i32 i = 0; i < this.count; i++) {
      if (this.sent[i].live) {
        u8[] frames = this.sent[i].frames;
        this.sent[i].live = false;
        return this.track(frames);
      }
    }
    return -1 as i64;
  }

  /**
   * Send the oldest unacknowledged packet's frames again, in a **new** packet with a new number.
   *
   * Empty when there is nothing outstanding. The old record stops being live — the frames are now
   * carried by the new packet, and leaving both live would resend them twice on the next call and
   * grow the outstanding count without bound.
   */
  u8[] resend(this) {
    i64 number = this.trackResend();
    if (number < (0 as i64)) { return u8[0](); }
    return this.client.sealFrames(this.handshakeReply, this.sent[this.count - 1].frames, number);
  }

  /**
   * Read a 1-RTT packet the peer sent: its full packet number, and its payload.
   *
   * Answers the payload, and moves the window **only if it opened**. `number()` below reports what
   * this last processed, which is the honest pair — a caller that wants both gets them from one call
   * rather than opening the packet twice.
   *
   * The number is decoded against `largestProcessed` rather than taken truncated, which is what makes
   * a connection able to outlive its first 256 packets with a one-byte number on the wire.
   */
  u8[] receive(this, u8[] packet) {
    u8[] payload = this.client.openApplication(this.handshakeReply, packet);
    if (payload.len() == 0) { return u8[0](); }
    i64 truncated = this.client.applicationPacketNumber(this.handshakeReply, packet);
    if (truncated < (0 as i64)) { return payload; }
    // The width the header carried, which `applicationPacketNumber` has already unmasked for us:
    // one to four bytes, and the decoder needs it in bits.
    i64 full = decodePacketNumber(this.largestProcessed, truncated, 32);
    if (full > this.largestProcessed) { this.largestProcessed = full; }
    return payload;
  }

  /** The largest packet number processed so far, or -1 — what an acknowledgement is about. */
  i64 number(const this) { return this.largestProcessed; }
}
