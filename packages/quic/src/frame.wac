// The frames inside a packet's payload, once it has been decrypted.
//
// RFC 9000 §12.4 and §19. A QUIC packet's payload is a sequence of frames with no count and no
// separators — each one's type says how long it is — so reading them is a walk that can only go
// forwards and can only be done correctly. There is no resynchronising: a frame whose length is
// read wrong makes every frame after it garbage, and the garbage is attacker-chosen.
//
// **Which frames are legal depends on the packet carrying them**, and that is table 3's right-hand
// column rather than a simplification. An Initial may contain five: PADDING, PING, ACK, CRYPTO and
// CONNECTION_CLOSE. A 1-RTT packet may contain all of them. A reader that accepted a STREAM frame in
// an Initial would be accepting something no conforming peer sends, and RFC 9000 §12.4 makes it
// PROTOCOL_VIOLATION.
//
// So `nextIn` takes the epoch and `next` is the Initial-epoch spelling of it, which is what every
// caller written before the application epoch existed wanted. `NotPermitted` is the answer for a
// frame that is real but not allowed here — separate from `Unknown`, because "you may not say that
// yet" and "I do not know what that is" are different accusations and only one of them is about a
// gap in this file.
//
// ## Two ways to stop, and they are different answers
//
// **Incomplete** is the datagram ending mid-frame. It is not an error: a sender pads to the path
// limit and a receiver may hold a datagram trimmed by the path, so "this is where the frames stop"
// is an ordinary thing to say.
//
// **Unknown** is a type byte this file does not recognise. That *is* an error — RFC 9000 §12.4 makes
// it PROTOCOL_VIOLATION — and the reason it must stop the walk rather than skip is that a frame's
// length lives in its own encoding. There is nothing to skip *over*. A parser that guessed would be
// reading a length out of somebody else's payload, which is the whole shape of the bug this file
// exists to not have.
//
// Both answer a size of 0, so a caller looping while the size is positive stops on either without
// having to know the difference; the variant is there for the caller that does.

import { Varint, decode as varint, encode, encodedLength } from "./varint.wac";
import { MAX_CID } from "./packet.wac";

/** A frame, as far as an Initial packet is allowed to carry one. */
export enum Frame {
  /** The datagram ended mid-frame. Ordinary, not an error. */
  Incomplete,
  /** A type this file does not know. The walk stops: an unknown frame has no known length. */
  Unknown(i64 kind),
  /** Zero bytes, run-length encoded — an Initial is padded to 1200 and is mostly this. */
  Padding(i32 count),
  Ping,
  /**
   * What the peer has received. The ranges are walked to find the frame's length but only the
   * largest and the delay are surfaced, because nothing here retransmits yet — and a field carried
   * but never read is a field nothing can prove right (see the note in `README.md`).
   */
  Ack(i64 largest, i64 delay),
  Crypto(i64 offset, u8[] data),
  /** `code` is the transport error; the reason is UTF-8 the peer chose and may be empty. */
  ConnectionClose(i64 code, u8[] reason),

  // ── The rest of table 3, which only a 0-RTT or 1-RTT packet may carry ────────

  /** The sender is giving up on a stream. `finalSize` is how much it had sent, for flow control. */
  ResetStream(i64 id, i64 code, i64 finalSize),
  /** The receiver wants no more of a stream. It does not end the stream; the sender decides that. */
  StopSending(i64 id, i64 code),
  /** A token for a future connection's Initial, to save it a round trip. Server to client only. */
  NewToken(u8[] token),
  /**
   * Stream data. `fin` is the last byte of the stream arriving, which is not the same as `data`
   * being empty — a zero-length frame with `fin` set is how a stream ends on a byte boundary.
   *
   * The offset is 0 when the frame carried none, which is the encoding's own default rather than an
   * absence: a frame without the OFF bit is at offset zero by definition.
   */
  Stream(i64 id, i64 offset, u8[] data, bool fin),
  /** The connection-wide receive limit, in bytes, counted across every stream. */
  MaxData(i64 max),
  /** One stream's receive limit. */
  MaxStreamData(i64 id, i64 max),
  /** How many streams of one kind may be opened. `uni` picks which kind. */
  MaxStreams(bool uni, i64 max),
  /** The sender wants to write and the connection limit stops it — a complaint, not a request. */
  DataBlocked(i64 at),
  StreamDataBlocked(i64 id, i64 at),
  StreamsBlocked(bool uni, i64 at),
  /**
   * Another id this peer will answer to, and the sequence number that names it.
   *
   * `retirePriorTo` is the sender asking for older ids to be dropped, and the token is a 16-byte
   * stateless-reset secret. Both are carried because a connection that migrates needs them, and both
   * are surfaced because the frame cannot be walked without reading them anyway.
   */
  NewConnectionId(i64 seq, i64 retirePriorTo, u8[] cid, u8[] token),
  RetireConnectionId(i64 seq),
  /** Eight bytes to be echoed, which is how a peer proves a path still reaches it. */
  PathChallenge(u8[] data),
  PathResponse(u8[] data),
  /** The server saying the handshake is confirmed. There is nothing else in it. */
  HandshakeDone,
  /**
   * A frame this file knows, in a packet type that may not carry it — RFC 9000 §12.4's
   * PROTOCOL_VIOLATION, and not the same fault as `Unknown`.
   */
  NotPermitted(i64 kind),
}

/** A frame and how many bytes it took. `size` is 0 for `Incomplete` and `Unknown`. */
export struct Next {
  Frame frame;
  i32 size;
}

/** Frame types, from RFC 9000's table 3. */
export i32 TYPE_PADDING() { return 0x00; }
export i32 TYPE_PING() { return 0x01; }
export i32 TYPE_ACK() { return 0x02; }
export i32 TYPE_ACK_ECN() { return 0x03; }
export i32 TYPE_CRYPTO() { return 0x06; }
export i32 TYPE_RESET_STREAM() { return 0x04; }
export i32 TYPE_STOP_SENDING() { return 0x05; }
export i32 TYPE_NEW_TOKEN() { return 0x07; }
/** 0x08 through 0x0f: the low three bits are OFF, LEN and FIN. */
export i32 TYPE_STREAM() { return 0x08; }
export i32 STREAM_OFF() { return 0x04; }
export i32 STREAM_LEN() { return 0x02; }
export i32 STREAM_FIN() { return 0x01; }
export i32 TYPE_MAX_DATA() { return 0x10; }
export i32 TYPE_MAX_STREAM_DATA() { return 0x11; }
export i32 TYPE_MAX_STREAMS() { return 0x12; }
export i32 TYPE_MAX_STREAMS_UNI() { return 0x13; }
export i32 TYPE_DATA_BLOCKED() { return 0x14; }
export i32 TYPE_STREAM_DATA_BLOCKED() { return 0x15; }
export i32 TYPE_STREAMS_BLOCKED() { return 0x16; }
export i32 TYPE_STREAMS_BLOCKED_UNI() { return 0x17; }
export i32 TYPE_NEW_CONNECTION_ID() { return 0x18; }
export i32 TYPE_RETIRE_CONNECTION_ID() { return 0x19; }
export i32 TYPE_PATH_CHALLENGE() { return 0x1a; }
export i32 TYPE_PATH_RESPONSE() { return 0x1b; }
export i32 TYPE_CLOSE_TRANSPORT() { return 0x1c; }
export i32 TYPE_CLOSE_APPLICATION() { return 0x1d; }
export i32 TYPE_HANDSHAKE_DONE() { return 0x1e; }

/**
 * Which packet a payload came out of, because table 3's right-hand column is per packet type.
 *
 * Not an enum: these index nothing and are compared, and `frame.wac` is walked by callers that hold
 * the number the packet header gave them.
 */
export i32 EPOCH_INITIAL() { return 0; }
export i32 EPOCH_HANDSHAKE() { return 1; }
export i32 EPOCH_0RTT() { return 2; }
export i32 EPOCH_1RTT() { return 3; }

Next stop(Frame f) { return Next(f, 0); }

/** Copy `n` bytes from `at`, or empty when they are not all there. */
u8[] slice(u8[] b, i32 at, i32 n) {
  if (n < 0 || at < 0 || at + n > b.len()) { return u8[0](); }
  u8[] out = u8[n]();
  out.copyFrom(b, at, 0, n);
  return out;
}

/**
 * Read one frame at `at`.
 *
 * The frame type is itself a varint, not a byte. That matters at exactly one place today —
 * CONNECTION_CLOSE is 0x1c, which is one byte — but it is what makes the type space extensible, and
 * reading it as a byte would work on every frame this file knows and then be wrong on the first one
 * it does not.
 */
export Next next(u8[] b, i32 at) { return nextIn(b, at, EPOCH_INITIAL()); }

/**
 * Whether `kind` may appear in a packet of this epoch — RFC 9000 table 3's right-hand column.
 *
 * Written as a lookup rather than folded into each branch below so that the table can be read as a
 * table. Getting a row wrong here is not a parse failure: it is accepting a frame a peer is not
 * allowed to send, which is precisely the thing this file's header argues against.
 */
bool permitted(i64 kind, i32 epoch) {
  i32 k = kind as~ i32;
  // PADDING and PING: every packet type.
  if (k == TYPE_PADDING() || k == TYPE_PING()) { return true; }
  // ACK and CRYPTO and the transport-level close: everywhere except 0-RTT, where a client has not
  // yet received anything to acknowledge and the handshake is not its to talk about.
  if (k == TYPE_ACK() || k == TYPE_ACK_ECN() || k == TYPE_CRYPTO() || k == TYPE_CLOSE_TRANSPORT()) {
    return epoch != EPOCH_0RTT();
  }
  // NEW_TOKEN and PATH_RESPONSE and HANDSHAKE_DONE: 1-RTT alone.
  if (k == TYPE_NEW_TOKEN() || k == TYPE_PATH_RESPONSE() || k == TYPE_HANDSHAKE_DONE()) {
    return epoch == EPOCH_1RTT();
  }
  // Everything else in the table is application data: 0-RTT and 1-RTT, never Initial or Handshake.
  return epoch == EPOCH_0RTT() || epoch == EPOCH_1RTT();
}

/** Read one frame at `at`, in a packet of the given epoch. */
export Next nextIn(u8[] b, i32 at, i32 epoch) {
  Varint t = varint(b, at);
  if (t.size == 0) { return stop(Frame.Incomplete); }
  i32 p = at + t.size;
  i64 kind = t.value;

  // Checked before anything is parsed: a frame that may not be here is a protocol violation whatever
  // its contents, and reading its fields first would be reading a length out of a frame the peer was
  // not allowed to send.
  if (!permitted(kind, epoch)) { return stop(Frame.NotPermitted(kind)); }

  if (kind == (TYPE_PADDING() as i64)) {
    // Run-length: padding arrives in hundreds of bytes and one frame per zero would make the walk
    // as long as the packet. The count is how many zeros follow, this one included.
    i32 n = 0;
    while (p + n < b.len() && b[p + n] == 0) { n = n + 1; }
    return Next(Frame.Padding(t.size + n), t.size + n);
  }

  if (kind == (TYPE_PING() as i64)) { return Next(Frame.Ping, t.size); }

  if (kind == (TYPE_ACK() as i64) || kind == (TYPE_ACK_ECN() as i64)) {
    Varint largest = varint(b, p);
    if (largest.size == 0) { return stop(Frame.Incomplete); }
    p = p + largest.size;
    Varint delay = varint(b, p);
    if (delay.size == 0) { return stop(Frame.Incomplete); }
    p = p + delay.size;
    Varint count = varint(b, p);
    if (count.size == 0) { return stop(Frame.Incomplete); }
    p = p + count.size;
    Varint first = varint(b, p);
    if (first.size == 0) { return stop(Frame.Incomplete); }
    p = p + first.size;

    // Every range is a gap and a length, and both have to be walked even though neither is kept:
    // they are what stands between here and the next frame.
    i64 ranges = count.value;
    // Split rather than `ranges < X || ranges > Y`: that spelling reads as `ranges<X>(...)`, a
    // generic call, and wacc declines it. issues/lang 0113.
    if (ranges < (0 as i64)) { return stop(Frame.Incomplete); }
    i64 room = b.len() as i64;
    if (ranges > room) { return stop(Frame.Incomplete); }
    i32 rangeCount = ranges as~ i32;
    for (i32 i = 0; i < rangeCount; i++) {
      Varint gap = varint(b, p);
      if (gap.size == 0) { return stop(Frame.Incomplete); }
      p = p + gap.size;
      Varint len = varint(b, p);
      if (len.size == 0) { return stop(Frame.Incomplete); }
      p = p + len.size;
    }
    // ECN adds three counts and nothing else.
    if (kind == (TYPE_ACK_ECN() as i64)) {
      for (i32 i = 0; i < 3; i++) {
        Varint ecn = varint(b, p);
        if (ecn.size == 0) { return stop(Frame.Incomplete); }
        p = p + ecn.size;
      }
    }
    return Next(Frame.Ack(largest.value, delay.value), p - at);
  }

  if (kind == (TYPE_CRYPTO() as i64)) {
    Varint off = varint(b, p);
    if (off.size == 0) { return stop(Frame.Incomplete); }
    p = p + off.size;
    Varint len = varint(b, p);
    if (len.size == 0) { return stop(Frame.Incomplete); }
    p = p + len.size;
    i64 n = len.value;
    i64 room = b.len() as i64;
    if (n < (0 as i64) || (p as i64) + n > room) { return stop(Frame.Incomplete); }
    u8[] data = slice(b, p, n as~ i32);
    return Next(Frame.Crypto(off.value, data), (p - at) + (n as~ i32));
  }

  if (kind == (TYPE_CLOSE_TRANSPORT() as i64) || kind == (TYPE_CLOSE_APPLICATION() as i64)) {
    Varint code = varint(b, p);
    if (code.size == 0) { return stop(Frame.Incomplete); }
    p = p + code.size;
    // The transport form names the frame type that caused the close; the application form does not.
    if (kind == (TYPE_CLOSE_TRANSPORT() as i64)) {
      Varint which = varint(b, p);
      if (which.size == 0) { return stop(Frame.Incomplete); }
      p = p + which.size;
    }
    Varint rl = varint(b, p);
    if (rl.size == 0) { return stop(Frame.Incomplete); }
    p = p + rl.size;
    i64 n = rl.value;
    i64 room = b.len() as i64;
    if (n < (0 as i64) || (p as i64) + n > room) { return stop(Frame.Incomplete); }
    u8[] reason = slice(b, p, n as~ i32);
    return Next(Frame.ConnectionClose(code.value, reason), (p - at) + (n as~ i32));
  }

  i32 k = kind as~ i32;

  if (k == TYPE_HANDSHAKE_DONE()) { return Next(Frame.HandshakeDone, t.size); }

  if (k == TYPE_MAX_DATA() || k == TYPE_DATA_BLOCKED() || k == TYPE_RETIRE_CONNECTION_ID()) {
    Varint v = varint(b, p);
    if (v.size == 0) { return stop(Frame.Incomplete); }
    p = p + v.size;
    if (k == TYPE_MAX_DATA()) { return Next(Frame.MaxData(v.value), p - at); }
    if (k == TYPE_DATA_BLOCKED()) { return Next(Frame.DataBlocked(v.value), p - at); }
    return Next(Frame.RetireConnectionId(v.value), p - at);
  }

  if (k == TYPE_MAX_STREAMS() || k == TYPE_MAX_STREAMS_UNI() ||
      k == TYPE_STREAMS_BLOCKED() || k == TYPE_STREAMS_BLOCKED_UNI()) {
    // The low bit of the type is the stream kind: even is bidirectional, odd is unidirectional.
    bool uni = (k & 1) == 1;
    Varint v = varint(b, p);
    if (v.size == 0) { return stop(Frame.Incomplete); }
    p = p + v.size;
    if (k == TYPE_MAX_STREAMS() || k == TYPE_MAX_STREAMS_UNI()) {
      return Next(Frame.MaxStreams(uni, v.value), p - at);
    }
    return Next(Frame.StreamsBlocked(uni, v.value), p - at);
  }

  if (k == TYPE_MAX_STREAM_DATA() || k == TYPE_STREAM_DATA_BLOCKED() || k == TYPE_STOP_SENDING()) {
    Varint id = varint(b, p);
    if (id.size == 0) { return stop(Frame.Incomplete); }
    p = p + id.size;
    Varint v = varint(b, p);
    if (v.size == 0) { return stop(Frame.Incomplete); }
    p = p + v.size;
    if (k == TYPE_MAX_STREAM_DATA()) { return Next(Frame.MaxStreamData(id.value, v.value), p - at); }
    if (k == TYPE_STREAM_DATA_BLOCKED()) {
      return Next(Frame.StreamDataBlocked(id.value, v.value), p - at);
    }
    return Next(Frame.StopSending(id.value, v.value), p - at);
  }

  if (k == TYPE_RESET_STREAM()) {
    Varint id = varint(b, p);
    if (id.size == 0) { return stop(Frame.Incomplete); }
    p = p + id.size;
    Varint code = varint(b, p);
    if (code.size == 0) { return stop(Frame.Incomplete); }
    p = p + code.size;
    Varint fin = varint(b, p);
    if (fin.size == 0) { return stop(Frame.Incomplete); }
    p = p + fin.size;
    return Next(Frame.ResetStream(id.value, code.value, fin.value), p - at);
  }

  if (k == TYPE_NEW_TOKEN()) {
    Varint len = varint(b, p);
    if (len.size == 0) { return stop(Frame.Incomplete); }
    p = p + len.size;
    i64 n = len.value;
    i64 room = b.len() as i64;
    if (n < (0 as i64)) { return stop(Frame.Incomplete); }
    if ((p as i64) + n > room) { return stop(Frame.Incomplete); }
    return Next(Frame.NewToken(slice(b, p, n as~ i32)), (p - at) + (n as~ i32));
  }

  if (k == TYPE_PATH_CHALLENGE() || k == TYPE_PATH_RESPONSE()) {
    // Exactly eight bytes, with no length: the frame is the type and the data.
    if (p + 8 > b.len()) { return stop(Frame.Incomplete); }
    u8[] data = slice(b, p, 8);
    if (k == TYPE_PATH_CHALLENGE()) { return Next(Frame.PathChallenge(data), (p - at) + 8); }
    return Next(Frame.PathResponse(data), (p - at) + 8);
  }

  if (k == TYPE_NEW_CONNECTION_ID()) {
    Varint seq = varint(b, p);
    if (seq.size == 0) { return stop(Frame.Incomplete); }
    p = p + seq.size;
    Varint retire = varint(b, p);
    if (retire.size == 0) { return stop(Frame.Incomplete); }
    p = p + retire.size;
    // A one-byte length here, not a varint: an id is at most 20 bytes and the field is fixed width.
    if (p >= b.len()) { return stop(Frame.Incomplete); }
    i32 cidLen = b[p];
    p = p + 1;
    // RFC 9000 §19.15: 1 to 20. Zero is a protocol violation rather than an empty id, because a peer
    // that used zero-length ids cannot be given a new one.
    if (cidLen < 1 || cidLen > MAX_CID()) { return stop(Frame.NotPermitted(kind)); }
    if (p + cidLen + 16 > b.len()) { return stop(Frame.Incomplete); }
    u8[] cid = slice(b, p, cidLen);
    p = p + cidLen;
    u8[] token = slice(b, p, 16);
    p = p + 16;
    return Next(Frame.NewConnectionId(seq.value, retire.value, cid, token), p - at);
  }

  if (k >= TYPE_STREAM() && k <= TYPE_STREAM() + 7) {
    Varint id = varint(b, p);
    if (id.size == 0) { return stop(Frame.Incomplete); }
    p = p + id.size;

    i64 offset = 0 as i64;
    if ((k & STREAM_OFF()) != 0) {
      Varint off = varint(b, p);
      if (off.size == 0) { return stop(Frame.Incomplete); }
      p = p + off.size;
      offset = off.value;
    }

    // **Without the LEN bit the frame runs to the end of the packet**, which is what makes a stream
    // frame free to be last. A reader that assumed a length would stop one frame early on every
    // packet a sender packed efficiently.
    i64 room = b.len() as i64;
    i64 n = room - (p as i64);
    if ((k & STREAM_LEN()) != 0) {
      Varint len = varint(b, p);
      if (len.size == 0) { return stop(Frame.Incomplete); }
      p = p + len.size;
      n = len.value;
      if (n < (0 as i64)) { return stop(Frame.Incomplete); }
      if ((p as i64) + n > room) { return stop(Frame.Incomplete); }
    }
    bool fin = (k & STREAM_FIN()) != 0;
    return Next(Frame.Stream(id.value, offset, slice(b, p, n as~ i32), fin), (p - at) + (n as~ i32));
  }

  return stop(Frame.Unknown(kind));
}

/** What the CRYPTO frames in one payload add up to. */
export struct Reassembly {
  /**
   * The bytes from offset 0 that arrived with no hole in front of them — which is all a handshake
   * parser may consume, since TLS is a stream and a message is not there until its bytes are.
   */
  u8[] data;
  /** Whether every CRYPTO frame landed inside that prefix. False means something arrived early. */
  bool whole;
  /** Whether the walk reached the end of the payload rather than stopping on a frame it could not read. */
  bool complete;
}

/**
 * Walk a decrypted payload and reassemble its CRYPTO stream.
 *
 * Offsets exist because a ClientHello can be larger than a datagram, so the handshake stream is cut
 * across packets and may arrive out of order. Reassembling by offset rather than by arrival is
 * therefore the only correct reading even when — as with one Initial from a peer that has nothing
 * to say yet — every packet seen so far happens to be in order.
 */
export Reassembly cryptoStream(u8[] payload) {
  // Two passes: the first finds how far the stream reaches, the second places the bytes. A single
  // pass would need a buffer sized before it knows what is coming.
  i64 end = 0 as i64;
  i32 at = 0;
  bool complete = false;
  while (at < payload.len()) {
    Next n = next(payload, at);
    if (n.size == 0) { break; }
    match (n.frame) {
      case Crypto(off, data): {
        i64 last = off + (data.len() as i64);
        if (last > end) { end = last; }
      }
      else: {}
    }
    at = at + n.size;
  }
  if (at >= payload.len()) { complete = true; }

  i64 room = payload.len() as i64;
  if (end <= (0 as i64) || end > room) {
    return Reassembly(u8[0](), end == (0 as i64), complete);
  }
  i32 size = end as~ i32;
  u8[] out = u8[size]();
  bool[] have = bool[size]();

  at = 0;
  while (at < payload.len()) {
    Next n = next(payload, at);
    if (n.size == 0) { break; }
    match (n.frame) {
      case Crypto(off, data): {
        i32 base = off as~ i32;
        for (i32 i = 0; i < data.len(); i++) {
          out[base + i] = data[i];
          have[base + i] = true;
        }
      }
      else: {}
    }
    at = at + n.size;
  }

  // The contiguous prefix, which is the part a caller may act on.
  i32 got = 0;
  while (got < size && have[got]) { got = got + 1; }
  return Reassembly(slice(out, 0, got), got == size, complete);
}

// ── Writing ───────────────────────────────────────────────────────────────────

/**
 * Write a CRYPTO frame carrying `data` at `offset`, into `out` at `at`.
 *
 * Answers the number of bytes written, or 0 if they would not fit — the same shape `next` uses for
 * "this could not be done whole", and for the same reason: a frame written partially is worse than
 * one not written, because the bytes after it are then read as a frame.
 */
export i32 writeCrypto(u8[] out, i32 at, i64 offset, u8[] data) {
  i32 need = 1 + encodedLength(offset) + encodedLength(data.len() as i64) + data.len();
  i32 room = out.len();
  if (at < 0) { return 0; }
  if (at + need > room) { return 0; }
  i32 p = at;
  out[p] = TYPE_CRYPTO();
  p = p + 1;
  p = p + encode(out, p, offset);
  p = p + encode(out, p, data.len() as i64);
  for (i32 i = 0; i < data.len(); i++) { out[p + i] = data[i]; }
  return (p + data.len()) - at;
}
