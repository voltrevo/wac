// The Handshake keys, where QUIC stops deriving its own secrets and starts using TLS's.
//
// RFC 9001 §5.1. Initial keys come from a connection id anybody on the path can read, so they
// authenticate a version and nothing else. **Handshake keys are the first real ones**: they come out
// of the TLS key schedule, so they depend on a Diffie-Hellman exchange and on every handshake byte
// both sides have seen.
//
// The join between the two specifications is one sentence: QUIC takes TLS's traffic secret and runs
// `HKDF-Expand-Label` on it with `quic key`, `quic iv` and `quic hp` instead of TLS's own `key` and
// `iv`. Everything above that line is `packages/tls`'s and everything below it is packet protection
// that `initial.wac` already does. This file is the sentence.
//
// ## The transcript is the part that is easy to get subtly wrong
//
// `deriveSecret` takes a hash of **every handshake message so far, concatenated with their four-byte
// headers, and nothing else** — not the records or packets that carried them, not the CRYPTO frames,
// not lengths added by QUIC. A transcript that included the framing would produce keys that are
// perfectly well-formed and that no peer shares, which decrypts as noise and looks exactly like a
// wrong Diffie-Hellman.

import { sha256 } from "../../crypto/src/sha256.wac";
import { deriveSecret, earlySecret, expandLabel, handshakeSecret, zeroKey }
         from "../../tls/src/keyschedule.wac";
import { InitialKeys } from "./initial.wac";

/**
 * The Handshake keys for one direction.
 *
 * `dhe` is the raw shared secret — for x25519, the 32 bytes `x25519(ours, theirs)` answers.
 * `transcript` is the hash described above. `isServer` picks which side's traffic secret, and it is
 * the *sender's* side: to open what a server sent, pass true.
 */
export InitialKeys handshakeKeys(u8[] dhe, u8[] transcript, bool isServer) {
  u8[] hs = handshakeSecret(earlySecret(zeroKey()), dhe);
  u8[] label = isServer ? "s hs traffic".toBytes() : "c hs traffic".toBytes();
  u8[] secret = deriveSecret(hs, label, transcript);
  return packetKeys(secret);
}

/**
 * Packet-protection keys from any TLS traffic secret.
 *
 * Separate from the above because the same three labels turn the *application* traffic secret into
 * 1-RTT keys, and the only difference is which secret goes in — so a caller that has reached the
 * next epoch needs this and not the derivation above it.
 */
export InitialKeys packetKeys(u8[] secret) {
  return InitialKeys(
    expandLabel(secret, "quic key".toBytes(), u8[0](), 16),
    expandLabel(secret, "quic iv".toBytes(), u8[0](), 12),
    expandLabel(secret, "quic hp".toBytes(), u8[0](), 16),
  );
}

/**
 * The transcript hash over two handshake messages, which is what a client has after a ServerHello.
 *
 * Takes whole messages — header and all — because that is what TLS hashes. Anything that slices a
 * body off before hashing produces a transcript neither peer agrees with.
 */
export u8[] transcript2(u8[] first, u8[] second) {
  u8[] both = u8[first.len() + second.len()]();
  for (i32 i = 0; i < first.len(); i++) { both[i] = first[i]; }
  for (i32 i = 0; i < second.len(); i++) { both[first.len() + i] = second[i]; }
  return sha256(both);
}
