// The keys that protect an Initial packet, which both endpoints can derive from the connection id.
//
// RFC 9001 §5.2. An Initial is "encrypted" with keys anybody on the path can compute: the client's
// destination connection id is public, the salt is a constant in the RFC, and everything follows.
// So this is not confidentiality — it is a version check and a tamper check, and the specification
// says so outright. Confidentiality starts at the Handshake keys, which come from TLS.
//
// That is what makes this step testable at all: **we can decrypt somebody else's Initial**, and a
// wrong derivation produces bytes indistinguishable from noise. The oracle is that quinn's first
// flight decrypts to a CRYPTO frame containing a TLS ClientHello. Nothing else about this file is
// checkable by inspection — a key that is wrong in one bit looks exactly like a key that is right.
//
// ## The salt is asserted by the oracle, not by me
//
// `INITIAL_SALT` is the version-1 constant from RFC 9001 §5.2. It is written here from the RFC and
// **the test is what establishes it**: if a byte of it were wrong, quinn's Initial would not
// decrypt, and no amount of reading this file would say which byte. That is the honest relationship
// between a transcribed constant and a differential — the constant is a hypothesis and the peer is
// the judge.

import { expandLabel } from "../../tls/src/keyschedule.wac";
// From `crypto` directly: `keyschedule.wac` imports this name but does not export it, and wac has no
// re-export (issues/lang 0073). The reference compiler accepted the wrong import and the suite did
// not — see issues/lang 0110.
import { hkdfExtract } from "../../crypto/src/hkdf.wac";
import { aesEncryptBlock, aesExpandKey, aesRounds } from "../../crypto/src/aes.wac";
import { ctEqualN } from "../../crypto/src/ct.wac";
import { FIXED_BIT, FORM_LONG, LongHeader, MAX_CID, TYPE_INITIAL, VERSION_1, parseLong }
         from "./packet.wac";
import { encodedLength } from "./varint.wac";
import { writeCrypto } from "./frame.wac";
import { gcmEncrypt, gcmTag } from "../../crypto/src/aesgcm.wac";

/** RFC 9000 §14.1: a client pads any datagram carrying an Initial to at least this. */
export i32 MIN_DATAGRAM() { return 1200; }

/** RFC 9001 §5.2's `initial_salt` for QUIC version 1. */
export u8[] initialSalt() {
  u8[] s = u8[20]();
  s[0] = 0x38; s[1] = 0x76; s[2] = 0x2c; s[3] = 0xf7; s[4] = 0xf5;
  s[5] = 0x59; s[6] = 0x34; s[7] = 0xb3; s[8] = 0x4d; s[9] = 0x17;
  s[10] = 0x9a; s[11] = 0xe6; s[12] = 0xa4; s[13] = 0xc8; s[14] = 0x0c;
  s[15] = 0xad; s[16] = 0xcc; s[17] = 0xbb; s[18] = 0x7f; s[19] = 0x0a;
  return s;
}

/** One direction's Initial keys. All three come from the same secret. */
export struct InitialKeys {
  /** AES-128-GCM key, 16 bytes. */
  u8[] key;
  /** The nonce base, 12 bytes; the packet number is XORed into its tail. */
  u8[] iv;
  /** The header-protection key, 16 bytes, used as AES-ECB over a ciphertext sample. */
  u8[] hp;
}

/**
 * The secret for one side, from the **client's original destination connection id**.
 *
 * Both sides derive from the client's first DCID — the random one it invented before it knew
 * anything about the server — which is why a server can answer a client it has never seen and why a
 * Retry changes the keys.
 */
export u8[] initialSecret(u8[] clientDcid, bool isServer) {
  u8[] common = hkdfExtract(initialSalt(), clientDcid);
  u8[] label = isServer ? "server in".toBytes() : "client in".toBytes();
  return expandLabel(common, label, u8[0](), 32);
}

/** The three keys for one side. */
export InitialKeys initialKeys(u8[] clientDcid, bool isServer) {
  u8[] secret = initialSecret(clientDcid, isServer);
  return InitialKeys(
    expandLabel(secret, "quic key".toBytes(), u8[0](), 16),
    expandLabel(secret, "quic iv".toBytes(), u8[0](), 12),
    expandLabel(secret, "quic hp".toBytes(), u8[0](), 16),
  );
}

/**
 * The header-protection mask: AES-ECB of a 16-byte sample of the ciphertext.
 *
 * The sample starts four bytes after the packet number does — four being the largest a packet
 * number can be, so the sample is at a fixed offset whether the number is one byte or four. That is
 * the trick that lets a receiver unmask a length it does not yet know.
 */
export u8[] headerMask(u8[] hp, u8[] packet, i32 sampleAt) {
  if (sampleAt < 0 || sampleAt + 16 > packet.len()) { return u8[0](); }
  u8[] sample = u8[16]();
  for (i32 i = 0; i < 16; i++) { sample[i] = packet[sampleAt + i]; }
  u8[] w = aesExpandKey(hp);
  return aesEncryptBlock(w, sample, aesRounds(hp.len()));
}

/** The 12-byte nonce: the iv with the packet number XORed into its last eight bytes. */
export u8[] nonce(u8[] iv, i64 packetNumber) {
  u8[] out = u8[12]();
  for (i32 i = 0; i < 12; i++) { out[i] = iv[i]; }
  for (i32 i = 0; i < 8; i++) {
    i32 shift = 8 * (7 - i);
    i32 byte = ((packetNumber >> (shift as i64)) & (0xFF as i64)) as~ i32;
    out[4 + i] = out[4 + i] ^ byte;
  }
  return out;
}

/**
 * Unprotect a packet's payload, given the header it is protected under.
 *
 * `aad` is the packet header **with its protection removed** — first byte and packet number in the
 * clear — because that is what the sender authenticated. Passing the still-masked header produces a
 * tag mismatch that looks exactly like a wrong key, which is the single easiest mistake to make here
 * and the reason this takes the header as an argument rather than slicing it itself.
 *
 * Empty when the tag does not verify, which is the only answer a caller may act on: a payload that
 * failed authentication is attacker-chosen bytes.
 */
export u8[] unprotect(InitialKeys keys, u8[] aad, u8[] ciphertext, i64 packetNumber) {
  if (ciphertext.len() < 16) { return u8[0](); }
  i32 bodyLen = ciphertext.len() - 16;
  u8[] body = u8[bodyLen]();
  for (i32 i = 0; i < bodyLen; i++) { body[i] = ciphertext[i]; }
  u8[] tag = u8[16]();
  for (i32 i = 0; i < 16; i++) { tag[i] = ciphertext[bodyLen + i]; }

  // **The tag is checked here rather than by `gcmDecrypt`, and that is the whole of this function.**
  //
  // `gcmDecrypt` traps on a tag that does not verify, deliberately: its comment says wac cannot
  // express a result a caller is forced to inspect, and an AEAD whose failure can be ignored is the
  // classic misuse. That is right for a primitive and wrong for QUIC. RFC 9001 §9 requires an endpoint
  // that cannot authenticate a packet to **discard it and carry on** — it has to, because anybody who
  // can reach the four-tuple can send one, so a packet that fails is not evidence of anything and a
  // connection that died on one could be killed by any passer-by.
  //
  // Every reader above documents "empty on any failure — ... a tag that does not verify", and until
  // this line they all trapped instead. Nothing noticed for as long as this package only ever read
  // packets that were right.
  //
  // The comparison is `ctEqualN` rather than a loop with an early exit: the tag is a secret the peer
  // is trying to guess, and a comparison that stops at the first wrong byte tells them how far they
  // got.
  u8[] n = nonce(keys.iv, packetNumber);
  u8[] want = gcmTag(keys.key, n, aad, body);
  if (!ctEqualN(want, tag, 16)) { return u8[0](); }
  // GCM is counter mode, so the same call decrypts as encrypts — which is what `gcmDecrypt` does
  // after its own check.
  return gcmEncrypt(keys.key, n, body);
}

/**
 * Open a client Initial packet: parse it, remove header protection, and authenticate the payload.
 *
 * `greased` is passed straight to `parseLong` and means what it means there: whether a cleared
 * fixed bit is acceptable, which is connection state this file does not hold.
 *
 * Empty on any failure — a header that will not parse, a sample that runs off the end, a tag that
 * does not verify. There is deliberately no way to ask *which*: the answers are "these are the
 * frames the peer sent" and "these bytes are not a packet from this connection", and a caller that
 * could tell a bad tag from a short packet would be tempted to act on the second.
 *
 * ## The order is forced and it is easy to get wrong
 *
 * Header protection is removed *before* the AEAD, because the packet number is under it and the
 * nonce needs the number. But the sample the mask comes from is at a fixed offset — four bytes past
 * where the number starts — precisely so it can be taken before the number's length is known. Doing
 * these in the other order is the mistake that produces a tag failure with correct keys.
 */
export u8[] openClientInitial(u8[] packet, bool greased) {
  LongHeader h = parseLong(packet, 0, greased);
  if (!h.ok) { return u8[0](); }
  return openInitial(packet, h.dcid, false, greased);
}

/**
 * Open a **server's** Initial, which needs the client's original destination connection id.
 *
 * Both directions derive from that one id (RFC 9001 §5.2) — the random one the client invented
 * before it knew anything about the server. A server's packet does *not* carry it: its destination
 * id is whatever source id the client offered. So it has to be supplied, and there is no signature
 * that could work without it. That asymmetry is the reason this is a separate function rather than
 * a flag on the one above: the argument list is different because the situation is.
 */
export u8[] openServerInitial(u8[] packet, u8[] clientDcid, bool greased) {
  return openInitial(packet, clientDcid, true, greased);
}

/** The shared body: `keyDcid` is what the keys come from, which is not always the packet's own. */
u8[] openInitial(u8[] packet, u8[] keyDcid, bool isServer, bool greased) {
  return openAt(packet, 0, initialKeys(keyDcid, isServer), greased, true);
}

/**
 * Open any long-header packet at `at` under keys the caller already has.
 *
 * This is the whole of packet protection with the key derivation lifted out, which is what lets a
 * Handshake packet — whose keys come from TLS rather than from a connection id — use the same code.
 * `initialOnly` is what an Initial reader wants: everything else is a packet it must not try to open
 * with Initial keys, and answering empty is safer than answering a payload from the wrong epoch.
 */
export u8[] openAt(u8[] packet, i32 at, InitialKeys keys, bool greased, bool initialOnly) {
  LongHeader h = parseLong(packet, at, greased);
  if (!h.ok) { return u8[0](); }
  if (initialOnly && h.packetType != TYPE_INITIAL()) { return u8[0](); }

  // The sample sits four bytes after the packet number begins: four is the largest a number can be,
  // so this offset does not depend on the length that is still hidden.
  u8[] mask = headerMask(keys.hp, packet, h.numberAt + 4);
  if (mask.len() == 0) { return u8[0](); }

  // A long header's low four bits are protected; the top four are not.
  i32 first = packet[at] ^ (mask[0] & 0x0F);
  i32 pnLen = (first & 3) + 1;
  i32 room = packet.len();
  if (h.numberAt + pnLen > room) { return u8[0](); }

  i64 number = 0 as i64;
  i32 headerLen = (h.numberAt - at) + pnLen;
  u8[] aad = u8[headerLen]();
  for (i32 i = at; i < h.numberAt; i++) { aad[i - at] = packet[i]; }
  aad[0] = first;
  for (i32 i = 0; i < pnLen; i++) {
    i32 b = packet[h.numberAt + i] ^ mask[1 + i];
    aad[(h.numberAt - at) + i] = b;
    number = (number << (8 as i64)) | (b as i64);
  }

  // `length` counts the packet number and the payload together, so the ciphertext is what is left.
  i32 bodyLen = (h.length as~ i32) - pnLen;
  if (bodyLen < 0) { return u8[0](); }
  if (h.numberAt + pnLen + bodyLen > room) { return u8[0](); }
  u8[] body = u8[bodyLen]();
  for (i32 i = 0; i < bodyLen; i++) { body[i] = packet[h.numberAt + pnLen + i]; }

  return unprotect(keys, aad, body, number);
}

/**
 * Build a **client Initial** carrying `cryptoData` as a CRYPTO frame at offset 0, padded to the
 * anti-amplification minimum, protected with the keys `dcid` implies.
 *
 * Empty if the pieces do not fit — a connection id over 20 bytes, or handshake data too large for
 * one datagram. Fragmenting across packets is a caller's decision (it needs a packet number per
 * datagram) and this refuses rather than deciding it silently.
 *
 * ## The order is the same trap as opening, run backwards
 *
 * The AEAD authenticates the header **in the clear**, so the tag has to be computed before header
 * protection is applied. Apply protection first and the receiver authenticates a header the sender
 * never signed, which fails as a tag mismatch — indistinguishable from a wrong key, which is the
 * single most expensive way to get this wrong. So: build the header, seal the payload with that
 * header as AAD, and only then mask the first byte and the packet number.
 *
 * ## Why the packet number is always four bytes here
 *
 * RFC 9000 allows one to four and a receiver reads the length from the protected bits. Fixing it at
 * four costs three bytes of a 1200-byte datagram and buys two things: the `length` field's varint
 * stays two bytes whatever the payload, so the header's size does not depend on its own contents,
 * and the header-protection sample at `numberAt + 4` is always inside the ciphertext.
 */
export u8[] sealClientInitial(u8[] dcid, u8[] scid, u8[] cryptoData, i64 packetNumber) {
  i32 framed = 1 + 1 + encodedLength(cryptoData.len() as i64) + cryptoData.len();
  u8[] payload = u8[framed]();
  if (writeCrypto(payload, 0, 0 as i64, cryptoData) == 0) { return u8[0](); }
  return sealLong(TYPE_INITIAL(), dcid, scid, payload, packetNumber,
                  initialKeys(dcid, false), MIN_DATAGRAM());
}

/**
 * Seal any long-header packet: a header, the frames, AEAD, then header protection.
 *
 * `padTo` is a whole-datagram minimum, padded with PADDING frames *inside* the protected payload —
 * which is where RFC 9000 §14.1 puts a client's anti-amplification padding, because padding after
 * the packet would not be authenticated. Pass 0 for a packet that needs none: only a datagram
 * carrying an Initial has to be 1200, and a Handshake packet on its own does not.
 *
 * ## The order is the trap, and it is the same one running backwards
 *
 * The AEAD authenticates the header **in the clear**, so the tag is computed before header
 * protection is applied. The other order produces a receiver authenticating a header the sender
 * never signed, which fails as a tag mismatch — indistinguishable from a wrong key.
 *
 * ## Why the packet number is always four bytes
 *
 * RFC 9000 allows one to four. Fixing it at four costs three bytes and buys two things: the `length`
 * varint stays two bytes whatever the payload, so the header's size does not depend on its own
 * contents, and the header-protection sample at `numberAt + 4` is always inside the ciphertext.
 */
export u8[] sealLong(i32 packetType, u8[] dcid, u8[] scid, u8[] frames, i64 packetNumber,
                     InitialKeys keys, i32 padTo) {
  i32 maxCid = MAX_CID();
  if (dcid.len() > maxCid || scid.len() > maxCid) { return u8[0](); }

  i32 pnLen = 4;
  // An Initial carries a token length; no other long-header packet does.
  i32 tokenBytes = packetType == TYPE_INITIAL() ? 1 : 0;
  i32 headerLen = 1 + 4 + 1 + dcid.len() + 1 + scid.len() + tokenBytes + 2 + pnLen;

  i32 payloadLen = frames.len();
  i32 least = padTo - headerLen - 16;
  if (payloadLen < least) { payloadLen = least; }
  if (payloadLen < frames.len()) { return u8[0](); }

  // PADDING is zeros, so an array longer than the frames already is the padding.
  u8[] payload = u8[payloadLen]();
  for (i32 i = 0; i < frames.len(); i++) { payload[i] = frames[i]; }

  u8[] header = u8[headerLen]();
  i32 p = 0;
  // Long header, fixed bit set, the type, and the packet number length in the low two bits. The
  // fixed bit is set because a client has negotiated nothing — there is no `grease_quic_bit` from a
  // peer it has not heard from. See `parseLong`'s `greased`.
  header[p] = FORM_LONG() | FIXED_BIT() | (packetType << 4) | (pnLen - 1);
  p = p + 1;
  header[p] = 0; header[p + 1] = 0; header[p + 2] = 0; header[p + 3] = VERSION_1();
  p = p + 4;
  header[p] = dcid.len();
  p = p + 1;
  for (i32 i = 0; i < dcid.len(); i++) { header[p + i] = dcid[i]; }
  p = p + dcid.len();
  header[p] = scid.len();
  p = p + 1;
  for (i32 i = 0; i < scid.len(); i++) { header[p + i] = scid[i]; }
  p = p + scid.len();
  if (tokenBytes == 1) {
    header[p] = 0;                     // token length: a one-byte varint of zero
    p = p + 1;
  }
  // The length counts the packet number, the payload and the tag, as a two-byte varint whatever the
  // value — which is what let `headerLen` be computed before any of this.
  i64 lengthField = (pnLen + payloadLen + 16) as i64;
  header[p] = 0x40 | ((lengthField >> (8 as i64)) as~ i32);
  header[p + 1] = (lengthField & (0xFF as i64)) as~ i32;
  p = p + 2;
  i32 numberAt = p;
  for (i32 i = 0; i < pnLen; i++) {
    i32 shift = 8 * (pnLen - 1 - i);
    header[p + i] = ((packetNumber >> (shift as i64)) & (0xFF as i64)) as~ i32;
  }

  u8[] iv = nonce(keys.iv, packetNumber);
  u8[] ct = gcmEncrypt(keys.key, iv, payload);
  u8[] tag = gcmTag(keys.key, iv, header, ct);

  u8[] out = u8[headerLen + ct.len() + 16]();
  for (i32 i = 0; i < headerLen; i++) { out[i] = header[i]; }
  for (i32 i = 0; i < ct.len(); i++) { out[headerLen + i] = ct[i]; }
  for (i32 i = 0; i < 16; i++) { out[headerLen + ct.len() + i] = tag[i]; }

  u8[] mask = headerMask(keys.hp, out, numberAt + 4);
  if (mask.len() == 0) { return u8[0](); }
  out[0] = out[0] ^ (mask[0] & 0x0F);
  for (i32 i = 0; i < pnLen; i++) { out[numberAt + i] = out[numberAt + i] ^ mask[1 + i]; }
  return out;
}

/**
 * A **short-header** packet, opened with 1-RTT keys.
 *
 * This is the shape every packet after the handshake has, and it differs from a long header in three
 * ways that all matter to a reader:
 *
 *   1. **No length field.** A long header says how many bytes its payload is, which is what lets
 *      several packets be coalesced into one datagram. A short header does not, so it runs to the end
 *      of the datagram and can only ever be the last packet in one.
 *   2. **No connection-id length.** The id is there and its length is not: the receiver chose that id
 *      and is expected to know how long its own ids are. `cidLen` is that knowledge, and passing the
 *      wrong one does not fail cleanly — it shifts the packet number and the sample, and the packet
 *      opens as noise. There is no way for the packet to tell you.
 *   3. **Five protected bits, not four.** A short header's first byte carries the spin bit, two
 *      reserved bits, the key phase and the two packet-number-length bits, and header protection
 *      covers the low five. Masking four leaves the key phase visible and the reserved bits wrong.
 *
 * Empty on any failure, as the rest of this file: a packet too short for its own fields, a sample
 * that runs off the end, or a tag that does not verify.
 */
export u8[] openShort(u8[] packet, i32 at, InitialKeys keys, i32 cidLen, bool greased) {
  if (at < 0 || at >= packet.len()) { return u8[0](); }
  if (cidLen < 0 || cidLen > MAX_CID()) { return u8[0](); }
  // The header form bit must be clear, and the fixed bit set unless the caller allows greasing —
  // the same rule `parseLong` applies, and the reason `greased` is threaded this far.
  if ((packet[at] & FORM_LONG()) != 0) { return u8[0](); }
  if (!greased && (packet[at] & FIXED_BIT()) == 0) { return u8[0](); }

  i32 numberAt = at + 1 + cidLen;
  if (numberAt > packet.len()) { return u8[0](); }
  u8[] mask = headerMask(keys.hp, packet, numberAt + 4);
  if (mask.len() == 0) { return u8[0](); }

  i32 first = packet[at] ^ (mask[0] & 0x1F);
  i32 pnLen = (first & 3) + 1;
  if (numberAt + pnLen > packet.len()) { return u8[0](); }

  // The AAD is the header exactly as it went on the wire *unprotected* — the first byte with its
  // five bits recovered, the id, and the packet number. Everything after it is ciphertext.
  i64 number = 0 as i64;
  i32 headerLen = (numberAt - at) + pnLen;
  u8[] aad = u8[headerLen]();
  for (i32 i = at; i < numberAt; i++) { aad[i - at] = packet[i]; }
  aad[0] = first;
  for (i32 i = 0; i < pnLen; i++) {
    i32 b = packet[numberAt + i] ^ mask[1 + i];
    aad[(numberAt - at) + i] = b;
    number = (number << (8 as i64)) | (b as i64);
  }

  // **To the end of the datagram**, which is what having no length means.
  i32 bodyLen = packet.len() - (numberAt + pnLen);
  if (bodyLen <= 0) { return u8[0](); }
  u8[] body = u8[bodyLen]();
  for (i32 i = 0; i < bodyLen; i++) { body[i] = packet[numberAt + pnLen + i]; }

  return unprotect(keys, aad, body, number);
}

/**
 * The key phase of a short-header packet, once the header is unprotected — 0 or 1.
 *
 * A peer flips this when it updates its keys, and a packet under the other phase will not open under
 * the keys held here. Reported rather than acted on: this package does not do key update yet, and a
 * caller that cannot open a packet deserves to know whether the reason is that the keys moved.
 */
export i32 shortKeyPhase(u8[] packet, i32 at, InitialKeys keys, i32 cidLen) {
  i32 numberAt = at + 1 + cidLen;
  u8[] mask = headerMask(keys.hp, packet, numberAt + 4);
  if (mask.len() == 0) { return -1; }
  return ((packet[at] ^ (mask[0] & 0x1F)) >> 2) & 1;
}

/**
 * Seal a **short-header** packet: the shape everything after the handshake takes.
 *
 * The counterpart of `openShort`, and the three differences from `sealLong` are the same three, seen
 * from the writing side:
 *
 *   1. **No length field**, so the packet is however long it is and must be the last — or only —
 *      packet in its datagram. There is nothing to write and nothing for a reader to skip by.
 *   2. **No source id and no version.** A short header carries the destination alone, with no length
 *      byte, because the peer that chose that id knows how long it is. Which means the id written
 *      here has to be one the *server* gave us, not one we invented.
 *   3. **Five protected bits.** The first byte carries the spin bit, two reserved bits, the key phase
 *      and the packet-number length, and header protection covers the low five rather than the low
 *      four. Masking four leaves the key phase in the clear, which is an observable a passer-by can
 *      use to count key updates.
 *
 * The spin bit is left at zero. RFC 9000 §17.4 makes it optional and explicitly allows an endpoint to
 * disable it — it exists so a network can measure round-trip time by watching, which is a thing to
 * offer deliberately rather than by default.
 */
export u8[] sealShort(u8[] dcid, u8[] frames, i64 packetNumber, InitialKeys keys, i32 padTo) {
  if (dcid.len() > MAX_CID()) { return u8[0](); }

  i32 pnLen = 4;
  i32 headerLen = 1 + dcid.len() + pnLen;

  i32 payloadLen = frames.len();
  i32 least = padTo - headerLen - 16;
  if (payloadLen < least) { payloadLen = least; }
  if (payloadLen < frames.len()) { return u8[0](); }
  // A payload must not be empty: the AEAD would be authenticating a header and nothing else, and
  // RFC 9000 §12.4 requires at least one frame in every packet.
  if (payloadLen == 0) { return u8[0](); }

  u8[] payload = u8[payloadLen]();
  for (i32 i = 0; i < frames.len(); i++) { payload[i] = frames[i]; }

  u8[] header = u8[headerLen]();
  // Form bit clear, fixed bit set, spin 0, reserved 0, key phase 0, and the number length.
  header[0] = FIXED_BIT() | (pnLen - 1);
  for (i32 i = 0; i < dcid.len(); i++) { header[1 + i] = dcid[i]; }
  i32 numberAt = 1 + dcid.len();
  for (i32 i = 0; i < pnLen; i++) {
    i32 shift = 8 * (pnLen - 1 - i);
    header[numberAt + i] = ((packetNumber >> (shift as i64)) & (0xFF as i64)) as~ i32;
  }

  u8[] iv = nonce(keys.iv, packetNumber);
  u8[] ct = gcmEncrypt(keys.key, iv, payload);
  u8[] tag = gcmTag(keys.key, iv, header, ct);

  u8[] out = u8[headerLen + ct.len() + 16]();
  for (i32 i = 0; i < headerLen; i++) { out[i] = header[i]; }
  for (i32 i = 0; i < ct.len(); i++) { out[headerLen + i] = ct[i]; }
  for (i32 i = 0; i < 16; i++) { out[headerLen + ct.len() + i] = tag[i]; }

  u8[] mask = headerMask(keys.hp, out, numberAt + 4);
  if (mask.len() == 0) { return u8[0](); }
  out[0] = out[0] ^ (mask[0] & 0x1F);
  for (i32 i = 0; i < pnLen; i++) { out[numberAt + i] = out[numberAt + i] ^ mask[1 + i]; }
  return out;
}
