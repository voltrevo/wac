// Host-facing entry point for the packet header, so `packet.test.ts` can hand it a packet a real
// implementation sent. The fixture has to come from a process, which wac cannot reach.

import { LongHeader, parseLong, parseShortDcid } from "../../src/packet.wac";

export bool parseOk(u8[] b) { return parseLong(b, 0).ok; }
export i32 version(u8[] b) { return parseLong(b, 0).version; }
export i32 packetType(u8[] b) { return parseLong(b, 0).packetType; }
export i32 dcidLen(u8[] b) { return parseLong(b, 0).dcid.len(); }
export i32 scidLen(u8[] b) { return parseLong(b, 0).scid.len(); }
export i32 numberAt(u8[] b) { return parseLong(b, 0).numberAt; }
export i32 bodyLength(u8[] b) { return parseLong(b, 0).length as~ i32; }
export i32 shortDcidLen(u8[] b, i32 cidLen) { return parseShortDcid(b, 0, cidLen).len(); }
