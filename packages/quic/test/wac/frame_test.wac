// The frames inside a real Initial, and the ClientHello they add up to.
//
// `design/system/0007` step 4, first slice. Step 3 established that quinn's first flight *decrypts*;
// the payload it decrypts to was never read. This reads it: walk the frames, reassemble the CRYPTO
// stream, and hand what comes out to `packages/tls`'s own ClientHello parser.
//
// The packet is minted rather than transcribed — `./minted.wac` says why. The frames a real Initial
// does *not* contain are built by hand below, because the walk has to get their lengths right too
// and there is no peer that will send one on demand.
//
// Host-side until 2026-08-19, `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli } from "std/platform.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { ackLargest, closeReason, closeReasonAtIn, cryptoLen, cryptoWhole, frameCount,
         handshakeType, helloKeyShareLen, helloOffersTls13, helloRandomLen, helloSuite, kindAt,
         kindAtIn, opens, paddingBytes, sizeAt, sizeAtIn, streamByte, streamLen, streamWhole,
         walkWhole } from "./frame_probe.wac";
import { anInitial } from "./minted.wac";

const i32 EPOCH_INITIAL = 0;
const i32 EPOCH_1RTT = 3;

/** Bytes from a list of small integers, which is how the hand-built frames below read. */
u8[] bytesOf(i32[] vs) {
  u8[] out = u8[vs.len()]();
  for (i32 i = 0; i < vs.len(); i++) { out[i] = vs[i] & 255; }
  return out;
}

u8[] prefix(u8[] b, i32 n) {
  u8[] out = u8[n]();
  out.copyFrom(b, 0, 0, n);
  return out;
}

export string test_a_real_initials_payload_walks_to_frames_with_nothing_left_over(
    Core core, Cli cli) {
  T t = T.create();
  u8[] packet = anInitial(t, core, cli, "frame-walk");
  if (packet.len() == 0) { return t.report(); }

  t.isTrue(opens(packet), "step 3's claim, restated: the packet decrypts");
  // Every byte accounted for. This is the assertion that catches a length read one byte off: the
  // walk would stop early on a frame it could not read, and `walkWhole` would be false.
  t.isTrue(walkWhole(packet), "the walk consumed the payload exactly");
  t.isTrue(frameCount(packet) > 0, "at least one frame");

  // An Initial is padded to 1200 bytes because of anti-amplification, and the padding is inside the
  // encrypted payload rather than after it — so most of what decrypts is zeros.
  t.isTrue(paddingBytes(packet) > 500,
           "an Initial is mostly padding, got " + itoa(paddingBytes(packet)) + " bytes");
  return t.report();
}

export string test_the_crypto_frames_reassemble_into_a_clienthello(Core core, Cli cli) {
  T t = T.create();
  u8[] packet = anInitial(t, core, cli, "frame-hello");
  if (packet.len() == 0) { return t.report(); }

  t.isTrue(cryptoWhole(packet), "no hole in the CRYPTO stream");
  t.isTrue(cryptoLen(packet) > 100,
           "a ClientHello is hundreds of bytes, got " + itoa(cryptoLen(packet)));

  // 1 is `client_hello`. A wrong reassembly lands on a byte that is some other message type, or on
  // padding, so this single number is most of the check.
  t.eqI32(handshakeType(packet), 1, "the first handshake message is a ClientHello");

  // …and the parse has to make sense of it. Each of these is a different way the bytes could be
  // right by accident: a 32-byte random is a fixed-width field at a fixed offset, the key share is
  // length-prefixed deep inside an extension, and the version comes from a different extension
  // again. All three landing means the whole message is where the walk said it was.
  t.eqI32(helloRandomLen(packet), 32, "a ClientHello random is 32 bytes");
  t.isTrue(helloOffersTls13(packet), "a QUIC client must offer TLS 1.3");
  t.isTrue(helloKeyShareLen(packet) > 32,
           "the client offered a key share we know: " + itoa(helloKeyShareLen(packet)) +
           " bytes of group ++ key");
  t.eqI32(helloSuite(packet), 0x1301, "quinn offers TLS_AES_128_GCM_SHA256");
  return t.report();
}

export string test_ack_ping_and_connection_close_are_read_at_their_real_lengths() {
  T t = T.create();
  // PING is one byte and nothing else.
  u8[] ping = bytesOf(i32[](0x01));
  t.eqI32(kindAt(ping, 0), 0x01, "PING");
  t.eqI32(sizeAt(ping, 0), 1, "PING is one byte");

  // ACK: type, largest=9, delay=3, range count=1, first range=0, then one (gap, length) pair. The
  // pair is the part a naive reader skips, and skipping it puts the next frame two bytes early.
  u8[] ack = bytesOf(i32[](0x02, 9, 3, 1, 0, 2, 1, 0x01));
  t.eqI32(kindAt(ack, 0), 0x02, "ACK");
  t.eqI32(ackLargest(ack, 0), 9, "largest acknowledged");
  t.eqI32(sizeAt(ack, 0), 7, "type, four varints and one range pair");
  t.eqI32(kindAt(ack, sizeAt(ack, 0)), 0x01, "and the frame after it is the PING");

  // The ECN form adds three counts and nothing else, so it is three bytes longer here.
  u8[] ecn = bytesOf(i32[](0x03, 9, 3, 1, 0, 2, 1, 0, 0, 0, 0x01));
  t.eqI32(sizeAt(ecn, 0), 10, "the ECN form carries three more counts");
  t.eqI32(kindAt(ecn, sizeAt(ecn, 0)), 0x01, "and the PING is still found");

  // CONNECTION_CLOSE, transport form: code, the frame type that caused it, then a reason.
  u8[] close = bytesOf(i32[](0x1c, 0x0a, 0x06, 2, 'n', 'o'));
  t.eqI32(kindAt(close, 0), 0x1c, "CONNECTION_CLOSE");
  t.eqStr(closeReason(close, 0), "no", "the reason comes back");
  t.eqI32(sizeAt(close, 0), 6, "type, code, frame type, length, two bytes");

  // The application form has no frame type field, so the same bytes minus one mean the same thing —
  // **in a packet that may carry it.** Table 3 gives 0x1c as `ih01` and 0x1d as `__01`: an
  // application-level close names an error the application layer chose, and there is no application
  // layer yet during the handshake.
  u8[] appClose = bytesOf(i32[](0x1d, 0x0a, 2, 'n', 'o'));
  t.eqStr(closeReasonAtIn(appClose, 0, EPOCH_1RTT), "no",
          "the application form has no frame type field");
  t.eqI32(sizeAtIn(appClose, 0, EPOCH_1RTT), 5, "one field shorter");
  // In an Initial it is refused, and refused *as a frame that exists* rather than as an unknown one.
  // This used to be accepted, which was the file's own header being wrong about its own reader.
  t.eqI32(kindAtIn(appClose, 0, EPOCH_INITIAL), -4, "not permitted in an Initial");
  t.eqI32(sizeAtIn(appClose, 0, EPOCH_INITIAL), 0, "and the walk stops");
  return t.report();
}

export string test_a_frame_that_will_not_fit_stops_the_walk() {
  T t = T.create();
  // Every truncation of a CRYPTO frame: type, offset, length, then the data it promised.
  u8[] crypto = bytesOf(i32[](0x06, 0, 4, 0xDE, 0xAD, 0xBE, 0xEF));
  t.eqI32(sizeAt(crypto, 0), 7, "whole, it is seven bytes");
  for (i32 n = 1; n <= 6; n++) {
    t.eqI32(sizeAt(prefix(crypto, n), 0), 0, "a " + itoa(n) + "-byte prefix cannot be read whole");
    t.eqI32(kindAt(prefix(crypto, n), 0), -1, "and says so as Incomplete, not as a frame");
  }

  // **A frame that may not be here is not skipped.** 0x08 is STREAM: a real frame, and not one an
  // Initial may carry. The walk stops either way, and the two reasons are distinguishable —
  // `NotPermitted` rather than `Unknown`, which is the difference between "you may not say that yet"
  // and "I do not know what that is". Only the second is a gap in this file.
  u8[] stream = bytesOf(i32[](0x08, 1, 2, 3, 4));
  t.eqI32(kindAt(stream, 0), -4, "NotPermitted in an Initial");
  t.eqI32(sizeAt(stream, 0), 0, "and the walk stops rather than guessing a length");
  // The same bytes in a 1-RTT packet are a stream frame, read to the end of the buffer because the
  // LEN bit is clear.
  t.eqI32(kindAtIn(stream, 0, EPOCH_1RTT), 0x08, "and it is a real frame where it is legal");

  // **A type nobody knows is still Unknown.** 0x3f is unassigned in table 3, so there is genuinely
  // nothing to skip over, and this is the case that keeps `Unknown` meaning something now that most
  // of the table is implemented.
  u8[] unknown = bytesOf(i32[](0x3f, 1, 2, 3, 4));
  t.eqI32(kindAtIn(unknown, 0, EPOCH_1RTT), -2, "Unknown, distinct from NotPermitted");
  t.eqI32(sizeAtIn(unknown, 0, EPOCH_1RTT), 0, "and the walk stops");
  return t.report();
}

export string test_the_crypto_stream_is_reassembled_by_offset_not_by_arrival() {
  T t = T.create();
  // Two frames, the second one first: offsets 2 and 0. A reader that concatenated in arrival order
  // would answer "CDAB" and be wrong in a way nothing downstream could detect.
  u8[] outOfOrder = bytesOf(i32[](0x06, 2, 2, 0x43, 0x44,
                                  0x06, 0, 2, 0x41, 0x42));
  t.eqI32(streamLen(outOfOrder), 4, "four bytes in total");
  t.isTrue(streamWhole(outOfOrder), "and no hole between them");
  t.eqI32(streamByte(outOfOrder, 0), 0x41, "A first");
  t.eqI32(streamByte(outOfOrder, 2), 0x43, "then C at offset 2");

  // A hole: offset 0 never arrives, so nothing may be handed to a parser. TLS is a stream and a
  // message is not there until its bytes are — answering with the later fragment would be handing a
  // parser the middle of a message and calling it the start.
  u8[] hole = bytesOf(i32[](0x06, 4, 2, 0x45, 0x46));
  t.eqI32(streamLen(hole), 0, "nothing contiguous from zero");
  t.isFalse(streamWhole(hole), "and it says something arrived early");

  // Padding around CRYPTO is ordinary and must not end the walk or enter the stream.
  u8[] padded = bytesOf(i32[](0x00, 0x00, 0x00, 0x06, 0, 1, 0x5A, 0x00, 0x00));
  t.eqI32(streamLen(padded), 1, "one byte of handshake between the zeros");
  t.eqI32(streamByte(padded, 0), 0x5A, "and it is the one that was sent");
  return t.report();
}
