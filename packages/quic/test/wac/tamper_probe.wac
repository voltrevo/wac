// One packet, sealed here and then damaged, so the reader's refusal is the thing under test.
//
// Everything else in this package feeds the reader packets that are *right* — from quinn, or from our
// own sealer — so the failure path has never been driven at all. It is also the only path an attacker
// controls: anybody who can send a UDP datagram to a connection's four-tuple can make the tag fail,
// and RFC 9001 §9 requires an endpoint to discard such a packet and carry on.
//
// No network and no fixture: sealed and damaged in the same call, so it is the same bytes every run.

import { openClientInitial, sealClientInitial } from "../../src/initial.wac";

/** A ClientHello-shaped payload. Its contents do not matter; only that it seals and opens. */
u8[] body() {
  u8[] m = u8[64]();
  for (i32 i = 0; i < 64; i++) { m[i] = (i * 7 + 1) & 255; }
  return m;
}

u8[] dcid() {
  u8[] d = u8[8]();
  for (i32 i = 0; i < 8; i++) { d[i] = (i * 3 + 2) & 255; }
  return d;
}

u8[] scid() {
  u8[] s = u8[4]();
  for (i32 i = 0; i < 4; i++) { s[i] = (i * 5 + 9) & 255; }
  return s;
}

/** A sealed Initial that is intact — the control, so a refusal below means damage and not the setup. */
export i32 intactOpens() {
  return openClientInitial(sealClientInitial(dcid(), scid(), body(), 0 as i64), false).len();
}

/**
 * The same packet with one ciphertext byte flipped — a tag that cannot verify.
 *
 * Expected: 0, the empty answer `openClientInitial` documents for "a tag that does not verify".
 * The byte is taken from well inside the payload so it is ciphertext rather than header: an Initial
 * is padded to 1200 and its header is a few dozen bytes.
 */
export i32 damagedOpens() {
  u8[] p = sealClientInitial(dcid(), scid(), body(), 0 as i64);
  p[600] = p[600] ^ 1;
  return openClientInitial(p, false).len();
}

/** Damage in the **tag itself**, which is the other half of the same question. */
export i32 tagDamagedOpens() {
  u8[] p = sealClientInitial(dcid(), scid(), body(), 0 as i64);
  p[p.len() - 1] = p[p.len() - 1] ^ 0x80;
  return openClientInitial(p, false).len();
}

/**
 * A packet whose *header* is damaged in a way that survives parsing.
 *
 * The connection id is part of the associated data, so changing it does not make the packet
 * unparseable — it makes it a packet for a different connection, which authenticates as a bad tag
 * rather than as a malformed header. This is the case that reaches the AEAD by a different door.
 */
export i32 wrongConnectionOpens() {
  u8[] p = sealClientInitial(dcid(), scid(), body(), 0 as i64);
  // Byte 6 is the first byte of the destination id: 1 flags, 4 version, 1 id length.
  p[6] = p[6] ^ 0xff;
  return openClientInitial(p, false).len();
}
