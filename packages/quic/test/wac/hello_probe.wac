// The client of `src/client.wac`, pinned to fixed randomness so a run is comparable with the last one.
//
// **The logic moved and this did not change what it answers.** Every export below is the same function
// it was, with the same signature, delegating to a `Client` built from the two constants at the top —
// which is what makes `hello.test.ts`, `handshake.test.ts` and `complete.test.ts` an argument that the
// extraction preserved behaviour rather than a fresh set of expectations agreeing with fresh code.
//
// The private scalar and the client random are constants. A real client must use fresh random ones —
// the whole security of the exchange is that nobody else knows the scalar — and a test wants the
// opposite, because a handshake that differs run to run cannot be compared with the one before it.
// `example/handshake.wac` is the same client with `core.randomBytes` in these two places, and it is
// the reason `Client` takes them as arguments rather than making them itself.

import { Store, pemBundle } from "../../../tls/src/roots.wac";
import { Client, handshakeAt as clientHandshakeAt } from "../../src/client.wac";
import { sealClientInitial } from "../../src/initial.wac";
import { Connection, Opened } from "../../src/connection.wac";
import { streamFrameLength, writeStream } from "../../src/frame.wac";
import { EPOCH_1RTT, Frame, Next, nextIn } from "../../src/frame.wac";

/** A fixed scalar, so a run is comparable with the one before it. Never do this off a test bench. */
u8[] scalar() {
  u8[] s = u8[32]();
  for (i32 i = 0; i < 32; i++) { s[i] = (i * 13 + 7) & 255; }
  return s;
}

/** A fixed client random, for the same reason. */
u8[] clientRandom() {
  u8[] r = u8[32]();
  for (i32 i = 0; i < 32; i++) { r[i] = (i * 31 + 3) & 255; }
  return r;
}

/** The client these all speak through. Deterministic, so building it per call is building one client. */
Client ours(u8[] dcid, u8[] scid, string serverName) {
  return Client.of(scalar(), clientRandom(), dcid, scid, serverName);
}

/**
 * The public half of that scalar, which is what goes in the key share.
 *
 * The dcid is irrelevant to it and is passed as empty: the key share is settled before either side
 * has said anything, which is exactly why a client can offer one in its first flight.
 */
export u8[] publicKey() { return ours(u8[0](), u8[0](), "").publicKey(); }

/** The ClientHello alone, so the test can put it through this repository's own parser. */
export u8[] helloOnly(u8[] scid, string serverName) { return ours(u8[0](), scid, serverName).hello; }

/** That ClientHello, framed and sealed into an Initial ready to put on a socket. */
export u8[] flight(u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).initial();
}

/**
 * The same flight with the two source ids **deliberately disagreeing** — one in the header, another
 * in `initial_source_connection_id`.
 *
 * A server must refuse this. It exists so the test can show the parameter is read rather than
 * merely carried: a flight that works and a flight that differs only here and fails are together an
 * argument that nothing else explains the first one.
 *
 * Sealed here rather than through `Client`, because `Client` cannot express it: it puts one scid in
 * both places, which is the whole of what a client is supposed to do. Disagreeing with yourself is not
 * a configuration, so the mismatch is assembled from a hello carrying `paramScid` and an Initial whose
 * header says `headerScid`.
 */
export u8[] flightMismatched(u8[] dcid, u8[] headerScid, u8[] paramScid, string serverName) {
  return sealClientInitial(dcid, headerScid, ours(dcid, paramScid, serverName).hello, 0 as i64);
}

/** The ServerHello message — header and all, which is what the transcript hashes. */
export u8[] serverHelloMessage(u8[] datagram, u8[] dcid) {
  return ours(dcid, u8[0](), "").serverHelloMessage(datagram);
}

/** The group the server chose, or 0. x25519 is 0x001d. */
export i32 serverGroup(u8[] datagram, u8[] dcid) {
  return ours(dcid, u8[0](), "").serverGroup(datagram);
}

/** Whether the server said TLS 1.3 in `supported_versions`, the only place the version is real. */
export bool serverIsTls13(u8[] datagram, u8[] dcid) {
  return ours(dcid, u8[0](), "").serverIsTls13(datagram);
}

/** Whether the server asked us to try again with another group, which is a different message. */
export bool serverAskedRetry(u8[] datagram, u8[] dcid) {
  return ours(dcid, u8[0](), "").serverAskedRetry(datagram);
}

/** The Diffie-Hellman shared secret: our scalar against the share the server sent. */
export u8[] shared(u8[] datagram, u8[] dcid) {
  return ours(dcid, u8[0](), "").shared(datagram);
}

/** Where the Handshake packet begins in that datagram, or 0 if the server coalesced nothing. */
export i32 handshakeAt(u8[] datagram) { return clientHandshakeAt(datagram); }

/** The server's Handshake payload, opened with keys derived through TLS. */
export u8[] handshakePayload(u8[] datagram, u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).handshakePayload(datagram);
}

/** The reassembled CRYPTO stream of the server's Handshake packet. */
export u8[] handshakeCrypto(u8[] datagram, u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).handshakeCrypto(datagram);
}

/** The first handshake message inside it. 8 is EncryptedExtensions, which follows a ServerHello. */
export i32 handshakeMessageType(u8[] datagram, u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).handshakeMessageType(datagram);
}

/** The four message types the server's flight should hold, as `1 << (kind & 31)` flags. */
export i32 serverFlightKinds(u8[] datagram, u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).serverFlightKinds(datagram);
}

/** Whether the server's Finished verifies — the transcript checking itself. */
export bool serverFinishedVerifies(u8[] datagram, u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).serverFinishedVerifies(datagram);
}

/** The id the server chose for itself, which is where our next packet has to be addressed. */
export u8[] serverChosenId(u8[] datagram) {
  return ours(u8[0](), u8[0](), "").serverChosenId(datagram);
}

/** A Handshake packet carrying our Finished. */
export u8[] clientFinishedPacket(u8[] datagram, u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).finished(datagram);
}

// ── The application epoch ─────────────────────────────────────────────────────

/** The server's first short-header packet, opened with 1-RTT keys. Empty if it will not open. */
export u8[] openApplication(u8[] handshakeReply, u8[] packet, u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).openApplication(handshakeReply, packet);
}

/** Its key phase, or -1. Nonzero would mean the server updated its keys before we read one. */
export i32 applicationKeyPhase(u8[] handshakeReply, u8[] packet, u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).applicationKeyPhase(handshakeReply, packet);
}

/**
 * The frame types in an opened payload, as `1 << (kind & 31)` flags, plus how many frames were walked.
 *
 * Flags rather than an array because the order quinn packs its first flight in is its business and not
 * something to pin. What matters is which frames are there and that the walk reached the end rather
 * than stopping at something it could not size.
 */
export i32 frameKinds(u8[] payload) {
  i32 seen = 0;
  i32 at = 0;
  while (at < payload.len()) {
    Next n = nextIn(payload, at, EPOCH_1RTT());
    if (n.size == 0) {
      // `Unknown` and `Incomplete` both stop the walk, and only one of them is a surprise. The kind
      // is folded in so a test can say which frame this package cannot yet size.
      match (n.frame) {
        case Unknown(kind): { return seen | (1 << 31); }
        case NotPermitted(kind): { return seen | (1 << 27); }
        else: { return seen | (1 << 30); }
      }
    }
    match (n.frame) {
      case Padding(count): { seen = seen | (1 << 0); }
      case Ping: { seen = seen | (1 << 1); }
      case Ack(largest, delay): { seen = seen | (1 << 2); }
      case Crypto(offset, data): { seen = seen | (1 << 6); }
      case Stream(id, offset, data, fin): { seen = seen | (1 << 8); }
      case NewConnectionId(seq, retire, cid, token): { seen = seen | (1 << 24); }
      case HandshakeDone: { seen = seen | (1 << 29); }
      case ConnectionClose(code, reason): { seen = seen | (1 << 28); }
      else: {}
    }
    at = at + n.size;
  }
  return seen;
}

/**
 * The first NEW_CONNECTION_ID in a payload, as `(cid length) * 100 + (token length)`, or -1.
 *
 * Packed into one number because this probe answers scalars and the two lengths are only meaningful
 * together: a frame walked to the right *size* with the id and the token misplaced inside it would
 * pass every length check separately. RFC 9000 §19.15 fixes the token at 16 bytes and the id at 1 to
 * 20, so the pair is a shape the frame either has or does not.
 */
export i32 firstNewCidShape(u8[] payload) {
  i32 at = 0;
  while (at < payload.len()) {
    Next n = nextIn(payload, at, EPOCH_1RTT());
    if (n.size == 0) { return -1; }
    match (n.frame) {
      case NewConnectionId(seq, retire, cid, token): { return cid.len() * 100 + token.len(); }
      else: {}
    }
    at = at + n.size;
  }
  return -1;
}

/** How many frames the walk read before it ran out of payload. -1 if it stopped early. */
export i32 frameCountIn(u8[] payload) {
  i32 at = 0;
  i32 n = 0;
  while (at < payload.len()) {
    Next f = nextIn(payload, at, EPOCH_1RTT());
    if (f.size == 0) { return -1; }
    at = at + f.size;
    n = n + 1;
  }
  return n;
}

/** A 1-RTT packet carrying a STREAM frame — the first thing this client can say. */
export u8[] streamPacket(u8[] handshakeReply, u8[] dcid, u8[] scid, string serverName,
                         i32 streamId, u8[] data, bool fin, i32 number) {
  return ours(dcid, scid, serverName)
    .streamPacket(handshakeReply, streamId as i64, 0 as i64, data, fin, number as i64);
}

/** The bytes the server sent on a stream, out of one 1-RTT packet. */
export u8[] streamBytes(u8[] handshakeReply, u8[] packet, u8[] dcid, u8[] scid, string serverName,
                        i32 streamId) {
  return ours(dcid, scid, serverName).streamBytes(handshakeReply, packet, streamId as i64);
}

/** Whether that packet carried the end of that stream. */
export bool streamFinished(u8[] handshakeReply, u8[] packet, u8[] dcid, u8[] scid, string serverName,
                           i32 streamId) {
  return ours(dcid, scid, serverName).streamFinished(handshakeReply, packet, streamId as i64);
}

/** The packet number a server's 1-RTT packet carried, truncated, or -1. */
export i32 applicationPacketNumber(u8[] handshakeReply, u8[] packet, u8[] dcid, u8[] scid,
                                   string serverName) {
  return ours(dcid, scid, serverName).applicationPacketNumber(handshakeReply, packet) as~ i32;
}

/** A 1-RTT packet acknowledging 0 through `largest`. */
export u8[] ackPacket(u8[] handshakeReply, u8[] dcid, u8[] scid, string serverName, i32 largest,
                      i32 number) {
  return ours(dcid, scid, serverName).ackPacket(handshakeReply, largest as i64, number as i64);
}

// ── A connection, for the retransmission test ────────────────────────────────

/**
 * One packet dropped and its frames sent again, as the two packets in order.
 *
 * A `Connection` cannot live between calls: wac has no mutable file-scope state — `spec/spec/variables.md`
 * allows `const` there and nothing else — so a probe cannot hold one across exported functions. That
 * is a property worth keeping rather than working around, so the exchange happens inside one call and
 * hands back what it would have sent.
 *
 * `[0]` is the packet the caller is meant to **throw away**, standing in for one the path lost.
 * `[1]` is `resend`: the same frames, a new number, a new nonce. A test that sends only the second
 * shows the frames surviving the packet that carried them.
 */
export u8[][] lostThenResent(u8[] handshakeReply, u8[] dcid, u8[] scid, string serverName,
                             i32 streamId, u8[] data) {
  Connection c = Connection.of(ours(dcid, scid, serverName), handshakeReply);
  u8[] frames = u8[streamFrameLength(streamId as i64, 0 as i64, data.len())]();
  u8[][] out = u8[][2]();
  if (writeStream(frames, 0, streamId as i64, 0 as i64, data, true) == 0) { return out; }
  out[0] = c.send(frames);
  // Nothing acknowledged it, so this is the packet a client gives up waiting for.
  out[1] = c.resend();
  return out;
}

/** The same, but acknowledging the first packet before asking — which must produce nothing. */
export i32 resendAfterAckIsEmpty(u8[] handshakeReply, u8[] dcid, u8[] scid, string serverName,
                                 u8[] data) {
  Connection c = Connection.of(ours(dcid, scid, serverName), handshakeReply);
  u8[] frames = u8[streamFrameLength(0 as i64, 0 as i64, data.len())]();
  if (writeStream(frames, 0, 0 as i64, 0 as i64, data, true) == 0) { return -1; }
  c.send(frames);
  c.onAck(0 as i64);
  return c.resend().len();
}

/**
 * A packet fed to a `Connection`, and where the window ends up.
 *
 * Answers `(processed + 1) * 10 + (payload was read ? 1 : 0)`, packed because this probe answers
 * scalars and the two are only meaningful together: "nothing arrived" and "the window did not move"
 * are different failures and a caller has to be able to tell them apart.
 */
export i32 receiveInto(u8[] handshakeReply, u8[] packet, u8[] dcid, u8[] scid, string serverName) {
  Connection c = Connection.of(ours(dcid, scid, serverName), handshakeReply);
  u8[] got = c.receive(packet);
  return ((c.number() as~ i32) + 1) * 10 + (got.len() > 0 ? 1 : 0);
}

/** Whether the server's CertificateVerify signs this handshake with its certificate's key. */
export bool identityVerifies(u8[] datagram, u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).serverIdentityVerifies(datagram);
}

/** The identity check with a substituted signature — the canary for `identityVerifies`. */
export bool identityVerifiesUsing(u8[] datagram, u8[] dcid, u8[] scid, string serverName, u8[] sig) {
  return ours(dcid, scid, serverName).identityVerifiesUsing(datagram, sig);
}

/** The signature out of the server's CertificateVerify. */
export u8[] serverSig(u8[] datagram, u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).serverSignature(datagram);
}

/**
 * `Connection.checked`'s verdict, and whether it handed back a connection.
 *
 * `[0]` is the verdict; `[1]` is 1 when there is a connection and 0 when there is not. The pair is
 * what says the two agree — a verdict of zero with no connection, or a connection alongside a
 * refusal, would each be a hole rather than a slip.
 */
export i32[] openedAgainst(u8[] datagram, u8[] dcid, u8[] scid, string serverName, u8[] caPem,
                           i64 now) {
  Store store = pemBundle(caPem);
  Opened o = Connection.checked(ours(dcid, scid, serverName), datagram, store.der, store.offsets, now);
  i32[] out = i32[2]();
  out[0] = o.verdict;
  out[1] = o.connection is null ? 0 : 1;
  return out;
}

/**
 * `verifyPath`'s verdict on the server's chain against a PEM bundle: 0 is success.
 *
 * The bundle is handed in as PEM and turned into a store here, which is what a program would do with
 * the system's `ca-certificates.crt` — the test then only has to read a file.
 */
export i32 chainVerdict(u8[] datagram, u8[] dcid, u8[] scid, string serverName, u8[] caPem, i64 now) {
  Store store = pemBundle(caPem);
  return ours(dcid, scid, serverName).serverChainVerdict(datagram, store.der, store.offsets, now);
}

/** How many certificates the server's chain held — one, for a leaf signed directly by a root. */
export i32 chainLength(u8[] datagram, u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).serverChain(datagram).offsets.len() / 2;
}

/** The leaf certificate the server presented, or empty. */
export u8[] serverCert(u8[] datagram, u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).serverCertificate(datagram);
}
