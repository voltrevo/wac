// A complete client first flight, authored here rather than borrowed.
//
// `seal.test.ts` proved the packet layer by putting quinn's own ClientHello inside a packet of our
// construction. This builds the handshake message too, so every byte on the wire is ours — which is
// what the borrowed version could not do, because its key share belonged to a client that had gone.
//
// The private scalar is a constant. A real client must use a fresh random one — the whole security
// of the exchange is that nobody else knows it — and a test wants the opposite, because a handshake
// that differs run to run cannot be compared with the last one. `test/hello.test.ts` says so where a
// reader will see it.

import { clientHello, groupX25519, messageBody, messageType, parseServerHello }
         from "../../../tls/src/handshake.wac";
import { suiteAes128Gcm } from "../../../tls/src/record.wac";
import { x25519, x25519Base } from "../../../crypto/src/x25519.wac";
import { clientParameters, parametersExtension } from "../../src/params.wac";
import { openAt, openServerInitial, sealClientInitial } from "../../src/initial.wac";
import { nextPacketAt } from "../../src/packet.wac";
import { cryptoStream } from "../../src/frame.wac";
import { handshakeKeys, transcript2 } from "../../src/keys.wac";

/** A fixed scalar, so a run is comparable with the one before it. Never do this off a test bench. */
u8[] scalar() {
  u8[] s = u8[32]();
  for (i32 i = 0; i < 32; i++) { s[i] = (i * 13 + 7) & 255; }
  // RFC 7748's clamping. x25519 does it internally too; doing it here as well means the public key
  // this returns is the one a peer will compute from the shared secret rather than a near miss.
  s[0] = s[0] & 248;
  s[31] = s[31] & 127;
  s[31] = s[31] | 64;
  return s;
}

/** The public half of that scalar, which is what goes in the key share. */
export u8[] publicKey() { return x25519Base(scalar()); }

/** A ClientHello of our own: one suite, one group, ALPN `h3`, and QUIC's transport parameters. */
export u8[] hello(u8[] scid, string serverName) {
  u8[] random = u8[32]();
  for (i32 i = 0; i < 32; i++) { random[i] = (i * 31 + 3) & 255; }
  u8[] params = clientParameters(scid, 1048576 as i64, 65536 as i64, 8 as i64, 30000 as i64);
  return clientHello(random, u8[0](), suiteAes128Gcm(), groupX25519(), publicKey(),
                     serverName.toBytes(), "h3".toBytes(), parametersExtension(params));
}

/** That ClientHello, framed and sealed into an Initial ready to put on a socket. */
export u8[] flight(u8[] dcid, u8[] scid, string serverName) {
  return sealClientInitial(dcid, scid, hello(scid, serverName), 0 as i64);
}

/**
 * The same flight with the two source ids **deliberately disagreeing** — one in the header, another
 * in `initial_source_connection_id`.
 *
 * A server must refuse this. It exists so the test can show the parameter is read rather than
 * merely carried: a flight that works and a flight that differs only here and fails are together an
 * argument that nothing else explains the first one.
 */
export u8[] flightMismatched(u8[] dcid, u8[] headerScid, u8[] paramScid, string serverName) {
  return sealClientInitial(dcid, headerScid, hello(paramScid, serverName), 0 as i64);
}

/** The ClientHello alone, so the test can put it through this repository's own parser. */
export u8[] helloOnly(u8[] scid, string serverName) { return hello(scid, serverName); }

// ── Reaching the Handshake keys ───────────────────────────────────────────────
//
// Everything below takes the server's datagram and does the whole derivation again from our own
// deterministic scalar. Each step is exported separately so that a failure names itself: a shared
// secret of the wrong length, a ServerHello that did not parse and a transcript that produced keys
// nobody shares all look identical at the end, where the answer is "it decrypted to noise".

/** The server's Initial payload, opened with the id we invented. */
u8[] serverInitialPayload(u8[] datagram, u8[] dcid) {
  return openServerInitial(datagram, dcid, true);
}

/** The ServerHello message — header and all, which is what the transcript hashes. */
export u8[] serverHelloMessage(u8[] datagram, u8[] dcid) {
  return cryptoStream(serverInitialPayload(datagram, dcid)).data;
}

/** The group the server chose, or 0. x25519 is 0x001d. */
export i32 serverGroup(u8[] datagram, u8[] dcid) {
  return parseServerHello(messageBody(serverHelloMessage(datagram, dcid))).group;
}

/** Whether the server said TLS 1.3 in `supported_versions`, the only place the version is real. */
export bool serverIsTls13(u8[] datagram, u8[] dcid) {
  return parseServerHello(messageBody(serverHelloMessage(datagram, dcid))).isTls13;
}

/** Whether the server asked us to try again with another group, which is a different message. */
export bool serverAskedRetry(u8[] datagram, u8[] dcid) {
  return parseServerHello(messageBody(serverHelloMessage(datagram, dcid))).isRetry;
}

/** The Diffie-Hellman shared secret: our scalar against the share the server sent. */
export u8[] shared(u8[] datagram, u8[] dcid) {
  u8[] theirs = parseServerHello(messageBody(serverHelloMessage(datagram, dcid))).keyShare;
  if (theirs.len() != 32) { return u8[0](); }
  return x25519(scalar(), theirs);
}

/** Where the Handshake packet begins in that datagram, or 0 if the server coalesced nothing. */
export i32 handshakeAt(u8[] datagram) { return nextPacketAt(datagram, 0, true); }

/** The server's Handshake payload, opened with keys derived through TLS. */
export u8[] handshakePayload(u8[] datagram, u8[] dcid, u8[] scid, string serverName) {
  i32 at = nextPacketAt(datagram, 0, true);
  if (at == 0) { return u8[0](); }
  u8[] dhe = shared(datagram, dcid);
  if (dhe.len() == 0) { return u8[0](); }
  u8[] tr = transcript2(hello(scid, serverName), serverHelloMessage(datagram, dcid));
  return openAt(datagram, at, handshakeKeys(dhe, tr, true), true, false);
}

/** The first handshake message inside it. 8 is EncryptedExtensions, which follows a ServerHello. */
export i32 handshakeMessageType(u8[] datagram, u8[] dcid, u8[] scid, string serverName) {
  u8[] c = cryptoStream(handshakePayload(datagram, dcid, scid, serverName)).data;
  if (c.len() < 4) { return -1; }
  return messageType(c);
}
