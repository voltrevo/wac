// The client of `src/client.wac`, pinned to fixed randomness so a run is comparable with the last one.
//
// **The logic moved and this did not change what it answers.** Every export below is the same function
// it was, with the same signature, delegating to a `Client` built from the two constants at the top —
// which is what makes `hello.test.ts`, `handshake.test.ts` and `complete.test.ts` an argument that the
// extraction preserved behaviour rather than a fresh set of expectations agreeing with fresh code.
//
// The private scalar and the client random are constants. A real client must use fresh random ones —
// the whole security of the exchange is that nobody else knows the scalar — and a test wants the
// opposite, because a handshake that differs run to run cannot be compared with the one before it.
// `example/handshake.wac` is the same client with `core.randomBytes` in these two places, and it is
// the reason `Client` takes them as arguments rather than making them itself.

import { Client, handshakeAt as clientHandshakeAt } from "../../src/client.wac";
import { sealClientInitial } from "../../src/initial.wac";

/** A fixed scalar, so a run is comparable with the one before it. Never do this off a test bench. */
u8[] scalar() {
  u8[] s = u8[32]();
  for (i32 i = 0; i < 32; i++) { s[i] = (i * 13 + 7) & 255; }
  return s;
}

/** A fixed client random, for the same reason. */
u8[] clientRandom() {
  u8[] r = u8[32]();
  for (i32 i = 0; i < 32; i++) { r[i] = (i * 31 + 3) & 255; }
  return r;
}

/** The client these all speak through. Deterministic, so building it per call is building one client. */
Client ours(u8[] dcid, u8[] scid, string serverName) {
  return Client.of(scalar(), clientRandom(), dcid, scid, serverName);
}

/**
 * The public half of that scalar, which is what goes in the key share.
 *
 * The dcid is irrelevant to it and is passed as empty: the key share is settled before either side
 * has said anything, which is exactly why a client can offer one in its first flight.
 */
export u8[] publicKey() { return ours(u8[0](), u8[0](), "").publicKey(); }

/** The ClientHello alone, so the test can put it through this repository's own parser. */
export u8[] helloOnly(u8[] scid, string serverName) { return ours(u8[0](), scid, serverName).hello; }

/** That ClientHello, framed and sealed into an Initial ready to put on a socket. */
export u8[] flight(u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).initial();
}

/**
 * The same flight with the two source ids **deliberately disagreeing** — one in the header, another
 * in `initial_source_connection_id`.
 *
 * A server must refuse this. It exists so the test can show the parameter is read rather than
 * merely carried: a flight that works and a flight that differs only here and fails are together an
 * argument that nothing else explains the first one.
 *
 * Sealed here rather than through `Client`, because `Client` cannot express it: it puts one scid in
 * both places, which is the whole of what a client is supposed to do. Disagreeing with yourself is not
 * a configuration, so the mismatch is assembled from a hello carrying `paramScid` and an Initial whose
 * header says `headerScid`.
 */
export u8[] flightMismatched(u8[] dcid, u8[] headerScid, u8[] paramScid, string serverName) {
  return sealClientInitial(dcid, headerScid, ours(dcid, paramScid, serverName).hello, 0 as i64);
}

/** The ServerHello message — header and all, which is what the transcript hashes. */
export u8[] serverHelloMessage(u8[] datagram, u8[] dcid) {
  return ours(dcid, u8[0](), "").serverHelloMessage(datagram);
}

/** The group the server chose, or 0. x25519 is 0x001d. */
export i32 serverGroup(u8[] datagram, u8[] dcid) {
  return ours(dcid, u8[0](), "").serverGroup(datagram);
}

/** Whether the server said TLS 1.3 in `supported_versions`, the only place the version is real. */
export bool serverIsTls13(u8[] datagram, u8[] dcid) {
  return ours(dcid, u8[0](), "").serverIsTls13(datagram);
}

/** Whether the server asked us to try again with another group, which is a different message. */
export bool serverAskedRetry(u8[] datagram, u8[] dcid) {
  return ours(dcid, u8[0](), "").serverAskedRetry(datagram);
}

/** The Diffie-Hellman shared secret: our scalar against the share the server sent. */
export u8[] shared(u8[] datagram, u8[] dcid) {
  return ours(dcid, u8[0](), "").shared(datagram);
}

/** Where the Handshake packet begins in that datagram, or 0 if the server coalesced nothing. */
export i32 handshakeAt(u8[] datagram) { return clientHandshakeAt(datagram); }

/** The server's Handshake payload, opened with keys derived through TLS. */
export u8[] handshakePayload(u8[] datagram, u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).handshakePayload(datagram);
}

/** The reassembled CRYPTO stream of the server's Handshake packet. */
export u8[] handshakeCrypto(u8[] datagram, u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).handshakeCrypto(datagram);
}

/** The first handshake message inside it. 8 is EncryptedExtensions, which follows a ServerHello. */
export i32 handshakeMessageType(u8[] datagram, u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).handshakeMessageType(datagram);
}

/** The four message types the server's flight should hold, as `1 << (kind & 31)` flags. */
export i32 serverFlightKinds(u8[] datagram, u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).serverFlightKinds(datagram);
}

/** Whether the server's Finished verifies — the transcript checking itself. */
export bool serverFinishedVerifies(u8[] datagram, u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).serverFinishedVerifies(datagram);
}

/** The id the server chose for itself, which is where our next packet has to be addressed. */
export u8[] serverChosenId(u8[] datagram) {
  return ours(u8[0](), u8[0](), "").serverChosenId(datagram);
}

/** A Handshake packet carrying our Finished. */
export u8[] clientFinishedPacket(u8[] datagram, u8[] dcid, u8[] scid, string serverName) {
  return ours(dcid, scid, serverName).finished(datagram);
}
