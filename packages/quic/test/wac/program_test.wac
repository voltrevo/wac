// **A wac program completes a QUIC handshake with a real server.**
//
// `complete_test.wac` already completes this handshake, and this is not a duplicate of it. There the
// socket belongs to the test: the library answers "what bytes do I send" and the test puts them on
// the wire, keeps the server's reply, and hands it back. That is the right way to check a packet
// layer and it leaves one question unasked — whether the thing is a program.
//
// Two things were missing when that question was finally asked, and neither was visible from the
// library side:
//
//   1. **The client could not have a fresh key.** Every step recomputed the ClientHello from
//      `(dcid, scid, serverName)`, which is a function only while the scalar and the client random
//      are compile-time constants. A real client's transcript is the bytes it actually sent.
//      `Client` in `src/client.wac` now holds them; `test/wac/hello_probe.wac` is the same client
//      with the two constants, which is why every other test in this package still passes unchanged.
//   2. **No wac program could open a datagram socket**, which is `design/system/0007` step 1.
//
// So what this asserts that nothing else can: the whole stack — x25519, the TLS key schedule, the
// packet layer, the capability boundary and the host's UDP — works in one process, with randomness
// it did not choose, against an implementation nobody here wrote.
//
// ## The oracle is `accept()`, and the program's own exit code is the second one
//
// quinn's `accept()` yields a connection when the handshake completes and never otherwise; it cannot
// half-happen. The program exits 0 only if it *also* verified the server's Finished and saw a short
// header come back. Both are asserted, because either alone can be wrong in a way the other catches:
// a server that accepts a handshake our client then misreads, or a client that declares success
// against a server that quietly rejected it.
//
// Host-side until 2026-08-19, `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli, Datagram, Exec, Pending, Socket } from "../../../platform/src/platform.wac";
import { Daemon, start, stop } from "../../../wactest/src/daemon.wac";
import { quoted } from "../../../wactest/src/childenv.wac";
import { contains } from "../../../wactest/src/strings.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { encode as hexEncode } from "../../../codec/src/hex.wac";
import { Server, pause, receiveWithin, startServer, stopServer } from "./peer.wac";

const string ENTRY = "packages/quic/example/handshake.wac";

string wacBinary(Cli cli) { return cli.cwd().wait() + "/native/v8/target/release/wac"; }

/** What the program and the server each said. */
struct Ran {
  bool accepted;
  i32 status;
  string said;
}

/**
 * Stand up a real QUIC server, run the program against it, and report what both of them said.
 *
 * The server is Deno's — quinn and rustls underneath, an independent implementation by people who
 * have never seen this one, and already installed. `design/system/0007` chose QUIC partly for that:
 * the oracle runs here, offline, on demand.
 */
Ran against(T t, Cli cli, string name, string program, string[] argsBefore) {
  Server s = startServer(cli, name, false);
  if (!s.ok) {
    t.fail(s.error);
    stopServer(cli, s);
    return Ran(false, -1, "");
  }
  // `localhost` rather than `127.0.0.1` as the last argument: SNI is what a client claims to be
  // dialling rather than what it dialled, and the program takes them separately.
  //
  // **This file cannot tell whether the name is used**, and the host-side version's comment implied
  // it could. `example/handshake.wac` says in its own words that it does not check a certificate,
  // and quinn serves its one certificate whatever SNI arrives — so passing `example.com` here still
  // completes the handshake. Measured, by doing it. `handshake_test.wac` is where the name is
  // actually adjudicated, against `identityVerifies`.
  string[] args = string[argsBefore.len() + 3](fill: "");
  for (i32 i = 0; i < argsBefore.len(); i++) { args[i] = argsBefore[i]; }
  args[argsBefore.len()] = "127.0.0.1";
  args[argsBefore.len() + 1] = itoa(s.port);
  args[argsBefore.len() + 2] = "localhost";

  Exec r = cli.exec(program, args, u8[0]()).wait();
  string said = string.fromBytes(r.stdout) + string.fromBytes(r.stderr);

  // `accept()` resolves on a task of its own, so give the server a turn before reading the flag.
  bool accepted = false;
  for (i32 i = 0; i < 40 && !accepted; i++) {
    accepted = s.file(cli, "accepted.json") != "";
    if (!accepted) { pause(cli); }
  }
  stopServer(cli, s);
  return Ran(accepted, r.ran() ? r.status : -1, said);
}

/**
 * Each line asserted, not only the exit code.
 *
 * A program that exited 0 without verifying anything would pass on the code alone, and the middle
 * line is the one that cannot be faked by a client talking to itself.
 */
void assertHandshook(T t, Ran r, string label) {
  t.isTrue(r.accepted,
           label + ": the server did not complete the handshake. Our Finished is an HMAC over the " +
           "transcript through the server's own Finished, keyed by the client's handshake secret — " +
           "so this is that transcript, that secret, the packet's destination id, or the Handshake " +
           "keys it is sealed under. The program said:\n" + r.said);
  t.eqI32(r.status, 0, label + ": the program did not report success:\n" + r.said);
  t.isTrue(contains(r.said, "the server's Finished verifies"),
           label + ": the client never verified the server's Finished:\n" + r.said);
  t.isTrue(contains(r.said, "the handshake is complete"),
           label + ": the client never saw the application epoch:\n" + r.said);
}

export string test_a_wac_program_completes_a_quic_handshake_on_its_own_socket(Core core, Cli cli) {
  // The Deno host, which is what `packages/platform/app.ts` runs: the program's capabilities are
  // JavaScript's, and its socket is `Deno.listenDatagram`.
  T t = T.create();
  assertHandshook(t, against(t, cli, "prog-deno", "deno",
                             string[]("run", "-A", "--unstable-net", "packages/platform/app.ts",
                                      ENTRY, "--allow-net", "--")),
                  "deno");
  return t.report();
}

export string test_and_on_the_host_with_no_javascript_in_it(Core core, Cli cli) {
  // The strongest form of the claim: x25519, HKDF, AES-GCM, the packet layer and the capability
  // boundary, in a process with no JavaScript runtime under them, against quinn.
  T t = T.create();
  assertHandshook(t, against(t, cli, "prog-v8", wacBinary(cli),
                             string[]("run", "--allow-net", ENTRY, "--")),
                  "wacv8");
  return t.report();
}

export string test_a_fresh_key_every_run(Core core, Cli cli) {
  // **The one thing a test bench cannot check for itself.** `hello_probe.wac` pins its scalar so
  // runs are comparable, and every other test in this package depends on that. The cost is that
  // nothing there can notice a client whose "random" is a constant — the single most serious thing
  // that can be wrong with a key exchange, and one that would pass every byte-for-byte comparison in
  // the package by construction.
  //
  // Two handshakes, and the two Initials must differ. They share a program, a server and a
  // destination, so the only thing left to differ is what the host's entropy gave them.
  T t = T.create();
  Socket sock = cli.bindDatagram("127.0.0.1", 0).wait();
  t.isTrue(sock.handle >= 0, "our socket did not bind — " + sock.error);
  if (sock.handle < 0) { return t.report(); }

  string[] seen = string[2](fill: "");
  for (i32 i = 0; i < 2; i++) {
    // Nothing answers, so the program will never finish — that is fine and expected. What is wanted
    // is the first datagram, which it sends before anyone has said anything back. It is a daemon
    // rather than an `exec` for exactly that reason: `exec` would wait for a program that is parked
    // in `receiveFrom`.
    Daemon d = start(cli,
      quoted(wacBinary(cli)) + " run --allow-net " + quoted(ENTRY) + " -- 127.0.0.1 " +
      itoa(sock.port) + " localhost",
      cli.cwd().wait() + "/.cache/quic-fresh-" + itoa(i) + ".log");
    if (!d.ok()) {
      t.fail("the program did not start — " + d.error);
      break;
    }
    u8[] got = receiveWithin(core, cli, sock, 15000);
    seen[i] = string.fromBytes(hexEncode(got));
    stop(cli, d);
    cli.remove(cli.cwd().wait() + "/.cache/quic-fresh-" + itoa(i) + ".log", false).wait();
  }
  cli.closeSocket(sock.handle);

  t.isTrue(seen[0].len() > 0, "the first flight was empty");
  t.isTrue(seen[1].len() > 0, "the second flight was empty");
  t.neI32(seen[0] == seen[1] ? 1 : 0, 1,
          "two runs sent byte-identical Initials, so the client's key is not fresh. Every other " +
          "test in this package pins the scalar deliberately and so cannot see this.");
  return t.report();
}
