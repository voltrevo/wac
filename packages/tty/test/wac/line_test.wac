// The line discipline, against the kernel's own.
//
// `script -qec cat /dev/null` puts a **pty** between the bytes we write and `cat`, which is exactly
// the arrangement `packages/tty` imitates: the terminal edits what is typed, echoes it, and hands
// finished lines to a program whose output comes back through the same terminal. So the oracle here
// is not a table somebody wrote — it is Linux's `n_tty`, answering the same input.
//
// `example/ttycat.wac` is our side of that: our `Line`, and a `cat` that adds nothing.
//
// **This found things a hand-written expectation would not have.** Three of them, on the first runs:
//
// - erasing a control character takes **two** backspaces, because it is shown as `^A` and occupies
//   two columns. Rubbing out one leaves a stray caret on the screen — invisible to any test that
//   compares the lines a program receives, and the first thing a person would see.
// - `^H` is **not** erase. Only DEL is. `^H` is echoed `^H` and delivered as a byte.
// - `^W`'s idea of a word is letters and digits, not "not a space": `ls /usr/bin^W` leaves `ls /usr/`,
//   and `a b.c^W` leaves `a b.`. A rule written as "back to the previous space" gets both wrong, and
//   it is the rule anyone would write.
//
// ## What the move changed
//
// **The kernel is asked once, not every suite run.** This used to build `ttycat` and spawn three
// processes a case — `script`, its `cat`, and the built program — for 44 cases, which was 13.5s. The
// answers are `tools/wac/ttyvectors.wac`'s doing now, and our side is `ttycatBytes`, called here: the
// same code the program runs, since nothing in a line discipline needs a capability.
//
// What that gives up is noticing `n_tty` change on the day it happens, and the last test is the answer
// — three cases asked of the live pty, which is what a wholesale change of environment would trip.
//
// Host-side until 2026-08-17. `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli } from "std/platform.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { ttycatBytes } from "../../example/ttycat.wac";
import { Line, Typed } from "../../src/line.wac";
import { DEL, EOF, INTR, QUIT, j3, join, k, sameBytes, show, t, typed,
         typedNames } from "./cases.wac";
import { Loaded, Vector, find, load, pty, vectorsPath } from "./replay.wac";

/**
 * The settings the oracle was running with, which decide what "correct" means.
 *
 * A line discipline is *configurable* — `stty erase ^H` moves erase to `^H`, `stty -echo` stops the
 * echo, `stty raw` turns the whole thing off — so the pty this compares against is not "the" line
 * discipline, it is one configuration of it. Every rule in `packages/tty` was measured through this
 * pty, and none of the tests below record which pty they measured. On a machine whose defaults
 * differ, they would fail with a byte mismatch and no clue why.
 *
 * So this asks the pty what it is set to, and fails with the setting rather than with the bytes. It
 * is also the honest answer to "is your oracle independent?" — it is independent of our code and
 * *not* independent of the machine's `termios` defaults, which is worth stating where somebody will
 * read it.
 *
 * It is the one test here that still spawns, because it is the one whose subject is the pty.
 */
export string test_the_oracle_is_the_configuration_this_module_implements(Core core, Cli cli) {
  T t = T.create();
  string said = string.fromBytes(pty(core, cli, "stty -a", u8[0]()));
  // As *tokens*, not as substrings. `stty -a` prints `-echoprt` and `-echonl`, so asking whether the
  // output "includes echo" is a check that cannot fail — which is the shape this repo keeps finding
  // in its own measurements and would be a poor thing to add while writing about it.
  string[] flags = tokens(said);
  t.isTrue(hasSetting(said, "erase", "^?"), "erase is DEL in this pty: " + said);
  t.isTrue(hasSetting(said, "kill", "^U"), "kill is ^U in this pty: " + said);
  t.isTrue(hasSetting(said, "werase", "^W"), "werase is ^W in this pty: " + said);
  string[] on = string[]("icanon", "echo", "echoe", "isig");
  for (i32 i = 0; i < on.len(); i++) {
    t.isTrue(hasToken(flags, on[i]),
             "this pty has `" + on[i] + "`, so it is what packages/tty implements: " + said);
    t.isFalse(hasToken(flags, "-" + on[i]),
              "this pty has `-" + on[i] + "`, which makes the comparison below meaningless");
  }
  return t.report();
}

export string test_every_editing_rule_answers_what_the_kernel_answers(Core core, Cli cli) {
  T t = T.create();
  Loaded v = load(cli, vectorsPath());
  t.isTrue(v.error == "", v.error);
  if (v.error != "") { return t.report(); }

  u8[][] cases = typed();
  string[] names = typedNames();
  i32 differed = 0;
  i32 missing = 0;
  for (i32 i = 0; i < cases.len(); i++) {
    // **Looked up by the bytes, not by position.** A case added to `cases.wac` without re-running the
    // capture is a missing vector, said as one; keyed by index it would be compared against its
    // neighbour's answer and reported as a discipline bug.
    Vector? want = find(v, "canonical", cases[i]);
    if (want is null) {
      missing = missing + 1;
      continue;
    }
    u8[] ours = ttycatBytes(cases[i], "canonical");
    if (!sameBytes(want!.out, ours)) {
      differed = differed + 1;
      t.fail(names[i] + ": typed " + show(cases[i]) + "\n    kernel " + show(want!.out) +
             "\n    ours   " + show(ours));
    }
  }
  t.eqI32(missing, 0, itoa(missing) + " cases have no recorded answer — `cases.wac` has moved ahead of " +
                      "the capture, so run `wac run --allow-read --allow-write --allow-run " +
                      "tools/wac/ttyvectors.wac`");
  t.eqI32(differed, 0, itoa(differed) + " of " + itoa(cases.len()) + " differ from " + v.oracle);

  // **The canary.** Every assertion above is "these two agree", which a harness comparing nothing
  // would also satisfy. Two inputs that must not produce the same bytes prove both sides are live —
  // and it is asserted of each side separately, because a vectors file of 77 identical records and a
  // `Line` that returned its input would each pass a comparison of the two together.
  // Both are cases in the list above, so the canary cannot be the one thing with no vector.
  u8[] plain = t("ab\n");
  u8[] erased = j3(t("ab"), k(DEL), t("c\n"));
  Vector? one = find(v, "canonical", plain);
  Vector? two = find(v, "canonical", erased);
  if (one is null) {
    t.isTrue(false, "the vectors have nothing for the canary's first input");
    return t.report();
  }
  if (two is null) {
    t.isTrue(false, "the vectors have nothing for the canary's second input");
    return t.report();
  }
  t.isFalse(sameBytes(one!.out, two!.out), "the recorded answers to two different inputs agree");
  t.isFalse(sameBytes(ttycatBytes(plain, "canonical"), ttycatBytes(erased, "canonical")),
            "our own answers to two different inputs agree");
  return t.report();
}

/**
 * `^C` and `^D`, which the comparison above cannot ask.
 *
 * Both act on the *timing* of a program that is reading, and the pty harness writes everything at
 * once: `^C` kills `cat` while bytes are still in the pty's buffer, so which of them get echoed
 * before it dies is a race between two processes, and `^D` delivers a partial line to a `cat` that
 * has not been scheduled yet. Comparing those byte for byte would be pinning the scheduler — which is
 * why these have no vectors either, and are asserted directly.
 *
 * What they do is not in doubt — it is in POSIX and it is what every terminal does. The rules:
 *
 * - `^C` echoes `^C` **and no newline**: the newline you see at a prompt belongs to the shell.
 * - `^D` on an empty line ends the input; on a line with something on it, it delivers what is there
 *   *without* a newline and the line goes on. That is why `cat` needs two after an unterminated line.
 */
export string test_interrupt_and_end_of_input(Core core, Cli cli) {
  T t = T.create();

  // `ttycatBytes` stops at either, so what comes back is everything up to and including the event.
  t.eqStr(show(ours(j3(t("abc"), k(INTR), t("def\n")))), show(t("abc^C")),
          "^C echoes ^C, keeps no line, and ends the run");

  // **`^\` is the other one, and it was an ordinary control character.** The kernel throws the line
  // away and signals, exactly as for `^C`; this delivered `ab\x1cz` — measured through the pty,
  // which is the oracle this module claims and which nothing had asked about `^\`. It is here beside
  // `^C` rather than in the comparison above for the same reason `^C` is: the oracle's `cat` is
  // killed mid-buffer, so which bytes get echoed first is a race.
  t.eqStr(show(ours(j3(t("ab"), k(QUIT), t("z\n")))), show(t("ab^\\")),
          "^\\ echoes ^\\, keeps no line, and ends the run");

  t.eqStr(show(ours(k(EOF))), show(t("")), "^D on an empty line says nothing and ends the input");

  // The line is delivered with no newline on it — `cat` writes `abc` and no `\r\n` follows, which is
  // exactly what a terminal shows when you press `^D` half way through a line.
  t.eqStr(show(ours(join(t("abc"), k(EOF)))), show(t("abcabc")),
          "^D on a line delivers it without a newline");

  // …and then the input carries on, because that ^D was an end of *line*.
  t.eqStr(show(ours(j3(t("ab"), k(EOF), t("cd\n")))), show(t("abab" + "cd\r\ncd\r\n")),
          "the line goes on after a ^D");
  return t.report();
}

/**
 * The recorded answers are still the answers this machine gives.
 *
 * A frozen expectation cannot see the environment move, and the whole value of this module's oracle is
 * that it is not frozen — it is `n_tty`. So three of the cases are asked of the live pty, spread across
 * the list rather than taken from the front, and compared with what was written down. A kernel or a
 * `script` that started answering differently fails here, naming the capture as the thing to re-run.
 */
export string test_the_live_pty_still_answers_what_was_recorded(Core core, Cli cli) {
  T t = T.create();
  Loaded v = load(cli, vectorsPath());
  t.isTrue(v.error == "", v.error);
  if (v.error != "") { return t.report(); }

  u8[][] cases = typed();
  string[] names = typedNames();
  i32 asked = 0;
  for (i32 n = 0; n < 3; n++) {
    i32 i = (n * cases.len()) / 3;
    Vector? want = find(v, "canonical", cases[i]);
    if (want is null) { continue; }
    asked = asked + 1;
    t.eqStr(show(pty(core, cli, "cat", cases[i])), show(want!.out),
            "the live pty no longer answers what " + v.oracle + " answered for " + names[i] +
            " — re-run `wac run --allow-read --allow-write --allow-run tools/wac/ttyvectors.wac`");
  }
  t.eqI32(asked, 3, "the canary asked the live pty " + itoa(asked) + " times");
  return t.report();
}

/** Our side of every comparison here: the program's own function, in this process. */
u8[] ours(u8[] typed) { return ttycatBytes(typed, "canonical"); }

/** `stty -a`'s output split on whitespace and semicolons. */
string[] tokens(string s) {
  string[] out = string[512](fill: "");
  i32 n = 0;
  i32 from = 0;
  u8[] b = s.toBytes();
  for (i32 i = 0; i <= b.len() && n < out.len(); i++) {
    bool sep = i == b.len() || b[i] == ' ' || b[i] == '\n' || b[i] == '\r' || b[i] == '\t' ||
               b[i] == ';';
    if (!sep) { continue; }
    if (i > from) { out[n] = s.slice(from, i); n = n + 1; }
    from = i + 1;
  }
  string[] exact = string[n](fill: "");
  for (i32 i = 0; i < n; i++) { exact[i] = out[i]; }
  return exact;
}

bool hasToken(string[] all, string want) {
  for (i32 i = 0; i < all.len(); i++) {
    if (all[i] == want) { return true; }
  }
  return false;
}

/** Whether `stty -a` says `<name> = <key>`, allowing the spaces it puts either side of the `=`. */
bool hasSetting(string said, string name, string key) {
  i32 at = said.indexOf(name);
  while (at >= 0) {
    i32 i = at + name.len();
    while (i < said.len() && said.slice(i, i + 1) == " ") { i = i + 1; }
    if (i < said.len() && said.slice(i, i + 1) == "=") {
      i = i + 1;
      while (i < said.len() && said.slice(i, i + 1) == " ") { i = i + 1; }
      if (said.slice(i, i + key.len()) == key) { return true; }
    }
    i32 next = said.slice(at + 1, said.len()).indexOf(name);
    if (next < 0) { return false; }
    at = at + 1 + next;
  }
  return false;
}

/**
 * `cbreak`'s signal keys, and the two methods on `Line` that nothing calls.
 *
 * The coverage driver added on 2026-08-24 (`issues/system/0205`) found these, and they are a different
 * kind of gap from the ones `packages/ssz` and `packages/mpt` turned up. Those two are judged against
 * vendored corpora of real Ethereum data, and what a real-data corpus cannot contain is the
 * implementation's own *refusals*. This package is judged against the kernel through a real pty, with
 * the inputs chosen by whoever wrote the test — so what it misses instead is **API nobody called and a
 * mode nobody entered**.
 *
 * `^C` and `^\` in cbreak are the mode's most consequential rule and the one the file's own header
 * argues about at length: `stty raw` clears `ISIG` and would make `^C` an ordinary byte, and this is
 * deliberately *not* that. Nothing had ever pressed either key in this mode.
 */
export string test_cbreak_still_answers_a_signal_and_the_unused_accessors_work() {
  T t = T.create();

  // `^C` and `^\` are signals in cbreak, not data. This is the claim `cbreak`'s doc comment makes.
  Line c = Line.cbreak();
  Typed intr = c.feedByte(INTR);
  t.eqI32(intr.signal, 2, "^C in cbreak did not answer SIGINT");
  t.isFalse(intr.hasLine, "^C delivered a line as well as a signal");
  t.eqI32(intr.line.len(), 0, "^C answered a line");

  Line q = Line.cbreak();
  Typed quit = q.feedByte(QUIT);
  t.eqI32(quit.signal, 3, "^\\ in cbreak did not answer SIGQUIT");
  t.isFalse(quit.hasLine, "^\\ delivered a line as well as a signal");

  // An ordinary byte in the same mode is data, arriving one at a time — so the two above are about
  // those keys rather than about cbreak delivering nothing.
  Line d = Line.cbreak();
  Typed one = d.feedByte('x');
  t.isTrue(one.hasLine, "an ordinary byte in cbreak did not arrive");
  t.eqI32(one.line.len(), 1, "cbreak delivered other than one byte");
  t.eqI32(one.signal, 0, "an ordinary byte answered a signal");

  // **`pending` and `feedAll` had no caller anywhere in the repository.** They are the accessor a
  // caller uses to ask whether a partial line is held, and the loop it would otherwise write itself.
  Line l = Line.create();
  t.isFalse(l.pending(), "a fresh line is holding something");
  l.feed('a');
  t.isTrue(l.pending(), "a line with a character typed is not pending");
  l.feed('\n');
  t.isFalse(l.pending(), "a line delivered is still pending");

  // **A tab is one column, not the two a control character takes.** `columns` is what the erase rules
  // count backwards over, so a tab measured as two would rub out one character too many — and the
  // recorded vectors have no tab in them.
  Line tab = Line.create();
  Typed drew = tab.feed(9);
  t.eqI32(drew.echo.len(), 1, "a tab echoed as something other than one byte");
  Typed rub = tab.feed(DEL);
  t.eqI32(rub.echo.len(), 3, "erasing a tab did not rub out exactly one column");

  Typed[] all = Line.create().feedAll("hi\n".toBytes());
  t.eqI32(all.len(), 3, "feedAll answered one Typed per byte");
  t.isTrue(all[2].hasLine, "the newline did not finish the line");
  t.eqStr(string.fromBytes(all[2].line), "hi\n", "feedAll's last answer is not the line");
  return t.report();
}
