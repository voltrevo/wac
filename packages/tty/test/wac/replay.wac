// Reading what the kernel answered, and asking it again live.
//
// The vectors are `packages/tty/test/kernel-vectors.txt`, written by `tools/wac/ttyvectors.wac`. Each
// record is a mode, the bytes typed, and the bytes that came back — length-prefixed, because both
// payloads contain newlines and control characters and one of them is a NUL.
//
// `pty` and `discipline` are the live oracles, still here and still spawning. They are what the canaries
// use: a frozen expectation cannot see `n_tty` change under it, and the answer to that is one live case
// per mode rather than fifty-five of them.

import { Cli, Core, Exec, FileResult } from "std/platform.wac";
import { itoa } from "../../../fmt/src/itoa.wac";

/** One measurement: what came back when `input` was typed at a terminal in `mode`. */
export struct Vector {
  string mode;
  u8[] input;
  u8[] out;
}

export struct Loaded {
  Vector[] items;
  i32 n;
  /** What the header says produced these — kernel, `script` and `python3` versions. */
  string oracle;
  string error;
}

/** The oracle whose answers the vectors hold, spawned per call. */
export u8[] pty(Core core, Cli cli, string command, u8[] input) {
  return through(core, cli, "script", string[]("-qec", command, "/dev/null"), input);
}

/** The pty that can hold a mode — `script` cannot, which is what `discipline.py` exists for. */
export u8[] discipline(Core core, Cli cli, string mode, u8[] input) {
  return through(core, cli, "python3", string[]("packages/tty/tools/discipline.py", mode), input);
}

/** One program, fed `input`, run to completion; its standard output, or a trap with the reason. */
export u8[] through(Core core, Cli cli, string program, string[] args, u8[] input) {
  Exec r = cli.exec(program, args, input).wait();
  if (!r.ran()) {
    core.warn("tty: " + program + " would not start — " + r.error);
    trap;
  }
  return r.stdout;
}

/** The vector for one mode and one input, or a null when nothing recorded it. */
export Vector? find(Loaded v, string mode, u8[] input) {
  for (i32 i = 0; i < v.n; i++) {
    if (v.items[i].mode != mode) { continue; }
    if (!same(v.items[i].input, input)) { continue; }
    return v.items[i];
  }
  return null;
}

bool same(u8[] a, u8[] b) {
  if (a.len() != b.len()) { return false; }
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] != b[i]) { return false; }
  }
  return true;
}

export string vectorsPath() { return "packages/tty/test/kernel-vectors.txt"; }

/**
 * The recorded answers.
 *
 * **Keyed by mode and input rather than by position.** The applet vectors check the recorded script
 * against the case list and count the mismatches; here the lookup does it, so a case added to
 * `cases.wac` is a missing vector rather than a comparison against its neighbour's answer.
 */
export Loaded load(Cli cli, string path) {
  FileResult r = cli.readFile(path).wait();
  if (!r.ok) {
    return Loaded(Vector[0](), 0, "",
                  "cannot read " + path + " — run `wac run --allow-read --allow-write --allow-run " +
                  "tools/wac/ttyvectors.wac` to write it");
  }
  u8[] b = r.bytes;
  Line l = lineAt(b, 0);
  if (l.text != "wac-tty-vectors 1") {
    return Loaded(Vector[0](), 0, "", "not a tty vectors file: " + l.text);
  }
  string oracle = "";
  i32 at = l.next;
  i32 count = 0 - 1;
  for (i32 guard = 0; guard < 8 && count < 0; guard++) {
    Line h = lineAt(b, at);
    at = h.next;
    if (h.text.len() > 8 && h.text.slice(0, 8) == "kernel: ") {
      oracle = h.text.slice(8, h.text.len());
    }
    count = numberIn(h.text, "count:");
  }
  if (count < 0) { return Loaded(Vector[0](), 0, oracle, "no count in the header"); }

  Vector[] items = Vector[count](fill: Vector("", u8[0](), u8[0]()));
  i32 n = 0;
  for (i32 i = 0; i < count; i++) {
    Line ml = lineAt(b, at);
    i32 mlen = numberIn(ml.text, "M");
    if (mlen < 0) { return Loaded(items, n, oracle, "record " + itoa(i) + " has no mode"); }
    string mode = string.fromBytes(sliceOf(b, ml.next, ml.next + mlen));
    at = ml.next + mlen + 1;

    Line il = lineAt(b, at);
    i32 ilen = numberIn(il.text, "I");
    if (ilen < 0) { return Loaded(items, n, oracle, "record " + itoa(i) + " has no input"); }
    u8[] input = sliceOf(b, il.next, il.next + ilen);
    at = il.next + ilen + 1;

    Line ol = lineAt(b, at);
    i32 olen = numberIn(ol.text, "O");
    if (olen < 0) { return Loaded(items, n, oracle, "record " + itoa(i) + " has no output"); }
    u8[] out = sliceOf(b, ol.next, ol.next + olen);
    at = ol.next + olen + 1;

    items[n] = Vector(mode, input, out);
    n = n + 1;
  }
  return Loaded(items, n, oracle, "");
}

struct Line {
  string text;
  i32 next;
}

Line lineAt(u8[] b, i32 at) {
  i32 end = at;
  while (end < b.len() && b[end] != '\n') { end = end + 1; }
  return Line(string.fromBytes(sliceOf(b, at, end)), end + 1);
}

u8[] sliceOf(u8[] b, i32 from, i32 to) {
  i32 n = to - from;
  if (n <= 0) { return u8[0](); }
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = b[from + i]; }
  return out;
}

i32 numberIn(string line, string tag) {
  if (line.len() < tag.len() + 1) { return 0 - 1; }
  if (line.slice(0, tag.len()) != tag) { return 0 - 1; }
  string rest = line.slice(tag.len() + 1, line.len());
  if (rest.len() == 0) { return 0 - 1; }
  i32 v = 0;
  for (i32 i = 0; i < rest.len(); i++) {
    u8[] c = rest.slice(i, i + 1).toBytes();
    if (c.len() == 0) { return 0 - 1; }
    i32 d = c[0];
    if (d < '0' || d > '9') { return 0 - 1; }
    v = v * 10 + (d - '0');
  }
  return v;
}
