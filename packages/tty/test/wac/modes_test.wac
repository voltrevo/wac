// The oracle for terminal modes, and what the kernel does in each of them.
//
// `packages/tty` implements one arrangement — canonical with echo — and says so. Modes are its own
// named next step, and they were recorded in `design/system/0001`'s open questions as **blocked on
// the oracle rather than on the code**: the module's comparison runs `script -qec cat`, and `script`
// will not hold an `stty`. `stty -echo; cat` echoes anyway, and `-icanon` leaves the oracle waiting
// for an end-of-input that a non-canonical mode does not deliver.
//
// That conclusion was wrong, and the correction is worth more than the tool. **This repository
// already drives reference implementations from Python to capture their behaviour** — every
// `packages/tor/tools/capture-*.py` does it against C tor. A pty is three lines of `termios` away in
// a language that has one, and Deno's inability to allocate one is a fact about Deno rather than
// about the problem. `packages/tty/tools/discipline.py` is that pty.
//
// ## What this file asserts
//
// `packages/tty` has the modes now, and the third test below is the differential that matters: the
// same `Line`, in each mode, against the same pty in that mode. The first two are about the *oracle*,
// because a differential is worth what its reference is worth:
//
//   1. **It is a drop-in for the one already trusted.** In canonical mode it must reproduce
//      `script -qec cat` byte for byte, on the cases `line_test.wac` already compares. Without that,
//      any mode measured through it is measured through an unknown.
//   2. **The modes are actually different.** The first working version of the harness applied the
//      mode in the child after forking and wrote from the parent immediately — a race the parent won
//      every time, so all three modes produced byte-identical output. Three modes agreeing perfectly
//      is not a result; it is an instrument reading zero, and nothing but an assertion like this
//      notices.
//
// The rules it records, measured rather than remembered, are what an implementation gets written
// against — and two of them are not what the names suggest:
//
//   - **`noecho` still edits.** `ab<DEL>c` delivers `ac`; the editing happens and is simply not
//     drawn. It is `ECHO` that is off, not `ICANON`.
//   - **`^R` stops reprinting and becomes a byte in the line.** Reprint is an echo feature: with
//     nothing being drawn there is nothing to draw again, so the kernel delivers `\x12` instead.
//
// ## What the move changed
//
// **The pty is asked once.** This used to spawn `discipline.py` for every case in every mode and a
// built `ttycat` beside it — 100 processes, 9.6s a suite run. `tools/wac/ttyvectors.wac` records those
// answers, our side is `ttycatBytes` called in this process, and the drop-in check of assertion 1 moved
// into the capture, which refuses to write a file whose two oracles disagree.
//
// The 9 shared cases are recorded **twice**, once from each oracle, so that check is still readable in
// the file rather than only in the tool's exit status — which is what the first test below reads. One
// live case per mode keeps it from being a claim about the past only.
//
// Host-side until 2026-08-17. `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli } from "../../../platform/src/platform.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { ttycatBytes } from "../../example/ttycat.wac";
import { DEL, KILL, REPRINT, SHARED, j3, j4, k, modeCases, modeCaseNames, modes, sameBytes, show,
         t } from "./cases.wac";
import { Loaded, Vector, discipline, find, load, pty, vectorsPath } from "./replay.wac";

/**
 * The two oracles agree, as recorded.
 *
 * `script` cannot hold a mode, so the mode cases go through `discipline.py` — a second oracle, worth
 * exactly what its agreement with the first is worth. The capture writes the shared cases from both, so
 * each of them has two canonical records and this compares them.
 *
 * The count is the canary: a capture that stopped recording both would leave this comparing nothing and
 * passing, which is the shape of a green instrument reading zero.
 */
export string test_the_pty_harness_reproduces_the_oracle_line_test_trusts(Core core, Cli cli) {
  T t = T.create();
  Loaded v = load(cli, vectorsPath());
  t.isTrue(v.error == "", v.error);
  if (v.error != "") { return t.report(); }

  u8[][] all = modeCases();
  string[] names = modeCaseNames();
  i32 pairs = 0;
  for (i32 i = 0; i < SHARED; i++) {
    u8[] first = u8[0]();
    bool have = false;
    i32 seen = 0;
    for (i32 j = 0; j < v.n; j++) {
      if (v.items[j].mode != "canonical") { continue; }
      if (!sameBytes(v.items[j].input, all[i])) { continue; }
      seen = seen + 1;
      if (!have) {
        first = v.items[j].out;
        have = true;
        continue;
      }
      t.eqStr(show(v.items[j].out), show(first),
              "the two oracles disagree about " + names[i] + " — the capture should have refused");
    }
    if (seen >= 2) { pairs = pairs + 1; }
  }
  t.eqI32(pairs, SHARED, itoa(pairs) + " of " + itoa(SHARED) + " shared cases were recorded from both " +
                         "oracles — with one record each there is nothing here to compare");

  // And one asked live, so this is not only a claim about the day of the capture: `discipline.py` in
  // canonical mode is still what `script -qec cat` answers.
  u8[] erase = j3(t("ab"), k(DEL), t("c\n"));
  t.eqStr(show(discipline(core, cli, "canonical", erase)), show(pty(core, cli, "cat", erase)),
          "discipline.py is no longer a drop-in for script");
  return t.report();
}

export string test_the_three_modes_differ_in_the_ways_that_were_measured(Core core, Cli cli) {
  T t = T.create();
  Loaded v = load(cli, vectorsPath());
  t.isTrue(v.error == "", v.error);
  if (v.error != "") { return t.report(); }

  u8[] erase = j3(t("ab"), k(DEL), t("c\n"));
  u8[] kill = j3(t("abc"), k(KILL), t("xy\n"));
  u8[] reprint = j3(t("abc"), k(REPRINT), t("\n"));

  // Canonical: edited and drawn. `\x08 \x08` is the terminal rubbing a column out.
  t.eqStr(recorded(t, v, "canonical", erase),
          show(j4(t("ab"), k(8), t(" "), j3(k(8), t("c\r\n"), t("ac\r\n")))), "canonical erase");
  // **noecho still edits.** Nothing is drawn, and `ac` is still what the program reads — which is the
  // rule an implementation is most likely to get wrong, because the name suggests otherwise.
  t.eqStr(recorded(t, v, "noecho", erase), show(t("ac\r\n")), "noecho erase");
  // cbreak edits nothing: the DEL arrives as a byte.
  t.eqStr(recorded(t, v, "cbreak", erase), show(j3(t("ab"), k(DEL), t("c\r\n"))), "cbreak erase");

  // `^U` likewise: killed and undrawn, and delivered.
  t.eqStr(recorded(t, v, "noecho", kill), show(t("xy\r\n")), "noecho kill");
  t.eqStr(recorded(t, v, "cbreak", kill), show(j3(t("abc"), k(KILL), t("xy\r\n"))), "cbreak kill");

  // **`^R` stops reprinting when there is no echo**, and becomes a byte in the line. Reprint is an
  // echo feature: with nothing drawn there is nothing to draw again.
  t.eqStr(recorded(t, v, "canonical", reprint), show(t("abc^R\r\nabc\r\nabc\r\n")),
          "canonical reprint");
  t.eqStr(recorded(t, v, "noecho", reprint), show(j3(t("abc"), k(REPRINT), t("\r\n"))),
          "noecho reprint");

  // And the assertion that the harness had not silently lost its mode, which is exactly what it did
  // when the mode was applied after the fork: three modes, three different answers to one input.
  string a = recorded(t, v, "canonical", erase);
  string b = recorded(t, v, "noecho", erase);
  string c = recorded(t, v, "cbreak", erase);
  t.isTrue(a != b && b != c && a != c,
           "the modes are not distinct — the harness was reading zero");
  return t.report();
}

/**
 * `Line` answers what the kernel answers, in every mode it has.
 *
 * The point of the whole exercise: one implementation, three settings, compared against the same
 * discipline in the same three settings. A mode that needed its own loop would be a second
 * implementation of the rules rather than a switch on one, and this is what says it is not.
 */
export string test_line_answers_what_the_kernel_answers_in_every_mode(Core core, Cli cli) {
  T t = T.create();
  Loaded v = load(cli, vectorsPath());
  t.isTrue(v.error == "", v.error);
  if (v.error != "") { return t.report(); }

  string[] ms = modes();
  u8[][] all = modeCases();
  string[] names = modeCaseNames();
  i32 compared = 0;
  i32 missing = 0;
  for (i32 m = 0; m < ms.len(); m++) {
    for (i32 i = 0; i < all.len(); i++) {
      Vector? want = find(v, ms[m], all[i]);
      if (want is null) {
        missing = missing + 1;
        continue;
      }
      compared = compared + 1;
      t.eqStr(show(ttycatBytes(all[i], ms[m])), show(want!.out), ms[m] + ": " + names[i]);
    }
  }
  t.eqI32(missing, 0, itoa(missing) + " cases have no recorded answer — run `wac run --allow-read " +
                      "--allow-write --allow-run tools/wac/ttyvectors.wac`");
  t.eqI32(compared, ms.len() * all.len(),
          itoa(compared) + " of " + itoa(ms.len() * all.len()) + " comparisons happened");
  return t.report();
}

/**
 * The recorded answers are still the answers this machine gives — one case per mode.
 *
 * Three processes rather than a hundred, and they are the point of the differential rather than a
 * stand-in for it: `^U` is a kill in two modes and a byte in the third, so one input in three modes is
 * the case that catches a pty whose settings have moved.
 */
export string test_the_live_pty_still_answers_what_was_recorded_in_each_mode(Core core, Cli cli) {
  T t = T.create();
  Loaded v = load(cli, vectorsPath());
  t.isTrue(v.error == "", v.error);
  if (v.error != "") { return t.report(); }

  u8[] kill = j3(t("abc"), k(KILL), t("xy\n"));
  string[] ms = modes();
  i32 asked = 0;
  for (i32 m = 0; m < ms.len(); m++) {
    Vector? want = find(v, ms[m], kill);
    if (want is null) { continue; }
    asked = asked + 1;
    t.eqStr(show(discipline(core, cli, ms[m], kill)), show(want!.out),
            "the live pty in " + ms[m] + " no longer answers what " + v.oracle + " answered — re-run " +
            "`wac run --allow-read --allow-write --allow-run tools/wac/ttyvectors.wac`");
  }
  t.eqI32(asked, ms.len(), "the canary asked the live pty " + itoa(asked) + " times");
  return t.report();
}

/** What was recorded for one mode and input, shown; a named failure and `""` when nothing was. */
string recorded(T t, Loaded v, string mode, u8[] input) {
  Vector? got = find(v, mode, input);
  if (got is null) {
    t.isTrue(false, "no recorded " + mode + " answer for " + show(input));
    return "";
  }
  return show(got!.out);
}
