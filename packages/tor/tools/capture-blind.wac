// Capture key-blinding vectors from tor's own `ed25519_keypair_blind`. The wac half of
// `capture-blind.py`.
//
// The blinded secret is the service half of key blinding. A wrong one yields a descriptor that
// decodes for anyone who does *not* know the identity key and fails only for clients who do, so no
// descriptor-level check finds it — which is why the values here come from tor rather than from a
// round trip through our own blinding.
//
//     wac run --allow-read --allow-write --allow-env --allow-run \
//         packages/tor/tools/capture-blind.wac [tor-source-root] > out.json
//
// It compiles `blind-probe.c` against tor's `libtor.a` with gcc and runs it, so this one needed
// `Cli.exec` twice over — once for the compiler and once for what it built. `issues/system/0165`.
//
// **The oracle is the file**: this and `capture-blind.py` must produce byte-identical output, and
// both must reproduce the committed `test/data/blind_vectors.json`.
// `packages/tor/test/wac/capturetools_test.wac` is the `cmp`.
//
// Note the indent: these vectors were written with `json.dump(indent=1)`, one space per level, where
// the hs-ntor and relaycert ones use two. A capture tool reproduces the file it is the recipe for.

import { Cli, Exec, Change, Stat, Sys, ChildEnv, Env, Files, Launch, Output, Procs } from "std";
import { sha256 } from "../../crypto/src/sha256.wac";
import { sha3_256 } from "../../crypto/src/keccak.wac";
import { field, hex, pad } from "./capturejson.wac";
import { agentDir } from "../../wactest/src/host.wac";
import { flatten } from "core";

string homeDir(Env env) {
  u8[]? home = flatten(env.get("HOME").wait()).orElse(null);
  return home is null ? "/root" : string.fromBytes(home!);
}

/** tor's source tree, where `tools/tor.sh` leaves it. */
string defaultTorRoot(Env env) {
  return "\{homeDir(env)}/tor-build/torproject-tor-c8d2b17";
}

/**
 * Somewhere to put the compiled probe, named for this agent.
 *
 * A fixed path would collide when two agents run this at once, and the failure would be one of them
 * silently measuring the other's binary — which is the same class of mistake as the hardcoded
 * `~/agent-b/...` this file's siblings used to carry.
 */
string probePath(Env env) {
  string who = agentDir(env);
  return "/tmp/wac-blind-probe" + (who == "" ? "" : "-\{who}");
}

/**
 * The three masks tor's `ed25519_donna_gettweak` applies, which `blindingFactor` also applies.
 *
 * Not curve25519's clamping, which is a different set: this clears the low three bits and forces bit
 * 254 as that does, but it also clears bit 255 rather than leaving it, and the two differ in exactly
 * the byte that would make a blinded key wrong once in two.
 */
u8[] clampFactor(u8[] b) {
  u8[] out = u8[].filled(32, 0);
  for (i32 i = 0; i < 32; i++) { out[i] = b[i]; }
  out[0] = out[0] & 248;
  out[31] = out[31] & 63;
  out[31] = out[31] | 64;
  return out;
}

/** `"key: value"` lines from the probe, as a lookup — the probe prints one field per line. */
string valueOf(Output err, string text, string key) {
  u8[] b = text.toBytes();
  i32 start = 0;
  for (i32 i = 0; i <= b.len(); i++) {
    if (i < b.len() && b[i] != '\n') { continue; }
    string line = text.slice(start, i);
    start = i + 1;
    i32 sep = line.indexOf(": ");
    if (sep < 0) { continue; }
    if (line.slice(0, sep) == key) { return line.slice(sep + 2, line.len()); }
  }
  err.line("capture-blind: the probe printed no '\{key}' line");
  trap;
}

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Output stdout = sys.stdout();
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  string root = argv.len() > 0
    ? argv[0]
    : defaultTorRoot(env);
  string probe = probePath(env);
  string probeSrc = "packages/tor/tools/blind-probe.c";

  Stat? lib = flatten(fs.stat("\{root}/libtor.a").wait()).ok();
  if ((lib is null)) {
    err.line("capture-blind: no libtor.a under \{root} — build tor with `tools/tor.sh`, or " +
              "pass its source root as the first argument");
    return 1;
  }

  auto builtRan = flatten(procs.exec("gcc", [
             "-O1", "-o", probe, probeSrc,
             "-I\{root}", "-I\{root}/src", "-I\{root}/src/ext",
             "-I\{root}/src/ext/trunnel",
             "\{root}/libtor.a",
             "-lssl", "-lcrypto", "-lz", "-lm", "-levent", "-lpthread"
    ], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? built = builtRan.ok();
  if ((built is null) || built!.status != 0) {
    err.line("capture-blind: compiling the probe failed:\n" +
              ((built is not null) ? string.fromBytes(built!.stderr) : "\{builtRan.isErr() ? "\{builtRan.err()!}" : ""}"));
    return 1;
  }

  string cases = "";
  for (i32 i = 0; i < 4; i++) {
    // Deterministic, so re-running reproduces this file and a diff means tor changed.
    u8[] seed = sha256("wac-mono blind vector \{i} seed".toBytes());
    u8[] factor = clampFactor(sha3_256("wac-mono blind vector \{i} factor".toBytes()));

    auto rRan = flatten(procs.exec(probe, [hex(seed), hex(factor)], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
    Exec? r = rRan.ok();
    string said = (r is not null) ? string.fromBytes(r!.stdout) : "";
    if ((r is null) || r!.status != 0 || said.indexOf("OK") < 0) {
      err.line("capture-blind: tor would not blind the key:\n" + said + "\n" +
                ((r is not null) ? string.fromBytes(r!.stderr) : "\{rRan.isErr() ? "\{rRan.err()!}" : ""}"));
      return 1;
    }

    if (i > 0) { cases = cases + ",\n"; }
    cases = cases + "\{pad(2, 1)}{\n";
    cases = cases + field(3, 1, "seed", hex(seed), false);
    cases = cases + field(3, 1, "factor", hex(factor), false);
    cases = cases + field(3, 1, "identitySecret", valueOf(err, said, "identity_secret"), false);
    cases = cases + field(3, 1, "identityPublic", valueOf(err, said, "identity_public"), false);
    cases = cases + field(3, 1, "blindedSecret", valueOf(err, said, "blinded_secret"), false);
    cases = cases + field(3, 1, "blindedPublic", valueOf(err, said, "blinded_public"), false);
    cases = cases + field(3, 1, "signature", valueOf(err, said, "signature"), false);
    cases = cases + field(3, 1, "message", valueOf(err, said, "message"), true);
    cases = cases + "\{pad(2, 1)}}";
  }

  // Removed, as the Python's temporary directory removed it. A failure to remove is not a failure
  // of the capture — the vectors are already computed — but it is worth saying, because the next
  // run would then be compiling over a file it does not own.
  auto gone = flatten(fs.remove(probe, false).wait());
  if (gone.isErr()) { err.line("capture-blind: could not remove \{probe} — \{gone.isErr() ? "\{gone.err()!}" : ""}"); }

  string out = "{\n";
  out = out + field(1, 1, "source", "tor's own ed25519_keypair_blind and ed25519_sign, tor 0.4.7.13",
                    false);
  // Still the Python file's name: the two produce identical bytes, and the vector records which
  // recipe made it rather than which of the two runs was the one that did.
  out = out + field(1, 1, "produced_by", "packages/tor/tools/capture-blind.py", false);
  out = out + field(1, 1, "note",
                    "The blinded secret is the service half of key blinding. A wrong one yields a " +
                    "descriptor that decodes for anyone who does not know the identity key and " +
                    "fails only for clients who do, so no descriptor-level check finds it — which " +
                    "is why the values here come from tor rather than from a round trip through " +
                    "our own blinding.", false);
  out = out + "\{pad(1, 1)}\"cases\": [\n\{cases}\n\{pad(1, 1)}]\n}\n";
  stdout.write(out.toBytes());
  return 0;
}
