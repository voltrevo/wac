// Host a v3 onion service.
//
//   wac run --allow-net --allow-read packages/tor/src/hsserviced.wac -- \
//     <seed-file> <authorities-file> <identity-seed-file> [--testnet]
//
// The other half of `hsconnect.wac`. That program is a client: it fetches a descriptor, introduces
// itself, and meets a service at a rendezvous point. This is what it meets.
//
// Everything it decides is decided elsewhere and pinned against C tor — which introduction points to
// keep (`hsintropoint.wac`), what the descriptor says (`hsdescbuild.wac`), which directories to send
// it to (`hsdir.wac`'s `servicePlan`), what an upload's answer means (`hsupload.wac`), and what to do
// about an INTRODUCE2 (`hsintroduce.wac`). What is left here is the part that can only be done with
// sockets attached: build the circuits, and keep several of them alive at once.
//
// ## Why the loop is the hard part
//
// A client does one thing at a time and `awaitCommand` suits it. A service cannot: it holds three
// introduction circuits, any of which may deliver an INTRODUCE2 at any moment, and it must answer
// each by building a *fourth* circuit to a rendezvous point while the other three stay up. Blocking
// on any one of them is what `relayd` did until the multiplexer landed, and it produced exactly the
// symptom recorded there — whether things worked depended on the order they arrived in.
//
// So the loop is a `waitAny` over every open link, and the state per introduction point is a struct
// rather than a stack frame.
//
// ## What it does not do yet
//
// One introduction point rather than three, and one page rather than a stream in both directions. The
// pieces for three are here — `introPointsWanted`, the rotation rules — and the reason for stopping
// at one is that a second adds no *new* seam: the loop already multiplexes, and proving it does is
// what matters before scaling the count.

import { Sys, Clock, Files, Net, Output, Random } from "std";
import {
  Awaited, Network, Session, awaitCommand, bootstrap, buildCircuit, buildCircuitTo, relayByEd25519,
} from "./bootstrap.wac";
import { Link, chunkRequest, nextCellFor, publishOverCircuit, sendCells, closeLink } from "./link.wac";
import { Circuit, Received, gotBroken, gotDestroyed } from "./circuit.wac";
import {
  relayBegin, relayConnected, relayEnd, relayEstablishIntro, relayIntroEstablished,
  relayIntroduce2, relayRendezvous1,
} from "./relay.wac";
import { establishIntroCell } from "./hsservice.wac";
import { INTRO2_OK, Introduction, handleIntroduce2 } from "./hsintroduce.wac";
import { rendezvousCircuitKeys } from "./hsntor.wac";
import { UPLOAD_OK, UPLOAD_REJECTED } from "./hsupload.wac";
import { cookieReplayCache, introReplayCache, ReplayCache } from "./hsreplay.wac";
import { IntroPointSecrets, BUILD_OK, Built, buildDescriptor } from "./hsdescbuild.wac";
import { Publication, servicePlan, consensusTimePeriod } from "./hsdir.wac";
import { timeOf } from "./dirclient.wac";
import { blindedPublicKey, subcredential } from "./hsblind.wac";
import { ed25519PublicKey } from "../../crypto/src/ed25519.wac";
import { x25519Base } from "../../crypto/src/x25519.wac";
import { onionAddress } from "./onionaddr.wac";
import { flatten } from "core";

/** Two hours, which is what a real service asks for. */
static i32 LIFETIME_MINUTES = 180;

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Clock clock = sys.clock();
  Random rnd = sys.random();
  Files fs = sys.files();
  Net net = sys.net();
  if (argv.len() < 3) {
    err.line("usage: hsserviced <seed-file> <authorities-file> <identity-seed-file> [--testnet]");
    return 1;
  }
  auto seedFileRead = flatten(fs.readFile(argv[0]).wait());
  auto authFileRead = flatten(fs.readFile(argv[1]).wait());
  auto idFileRead = flatten(fs.readFile(argv[2]).wait());
  if (seedFileRead.isErr() || authFileRead.isErr() || idFileRead.isErr()) {
    err.line("hsserviced: could not read the seed, the authorities or the identity");
    return 1;
  }
  if (idFileRead.unwrap().len() < 32) {
    err.line("hsserviced: the identity seed must be at least 32 bytes");
    return 1;
  }
  bool testnet = false;
  i32 argc = argv.len();
  for (i32 i = 3; i < argc; i++) {
    if (argv[i] == "--testnet") { testnet = true; }
  }

  // The identity is what the onion address *is*. Printing it first means a caller can start a client
  // against this service before it has finished publishing, which is how the two are run in one shell.
  u8[] identitySeed = firstBytes(idFileRead.unwrap(), 32);
  u8[] identityPublic = ed25519PublicKey(identitySeed);
  out.line("hsserviced: " + string.fromBytes(onionAddress(identityPublic)));

  Network network = bootstrap(err, clock, rnd, net, seedFileRead.unwrap(), authFileRead.unwrap(), testnet);
  if (network.relays.len() == 0) {
    err.line("hsserviced: bootstrap found no relays");
    return 1;
  }
  out.line("hsserviced: bootstrapped, \{network.relays.len()} relays");

  // ── 1. An introduction point, and the cell that claims it ───────────────────
  //
  // The auth key is this circuit's name at that relay: the relay files the circuit under it, and a
  // client's INTRODUCE1 names the same key so the relay knows which circuit to forward down. It is
  // ours, generated here, and it is what `handleIntroduce2` must be given rather than reading from
  // the cell — see `parseIntroduce2`, where taking it from the cell was a real bug.
  u8[] authSeed = flatten(rnd.bytes(32).wait()).unwrap();
  u8[] authPublic = ed25519PublicKey(authSeed);
  u8[] encSecret = clamp(flatten(rnd.bytes(32).wait()).unwrap());
  u8[] encPublic = x25519Base(encSecret);

  // Chosen rather than read back off the circuit: a service picks its own introduction points, and
  // asking the description which relay it ended at would be parsing a string to recover something we
  // decided. `buildCircuitTo` takes the index.
  i32 introRelay = firstHsdirCapable(network);
  if (introRelay < 0) {
    err.line("hsserviced: no relay to use as an introduction point");
    return 1;
  }
  Session intro = buildCircuitTo(err, clock, rnd, net, network, introRelay, 0x80000031);
  if (!intro.ok) {
    err.line("hsserviced: could not build an introduction circuit");
    return 1;
  }
  out.line("hsserviced: introduction circuit \{intro.description}");

  // ESTABLISH_INTRO is signed over the circuit's own KH, which is why it cannot be built before the
  // circuit exists and cannot be replayed onto another one.
  sendCells(intro.link, intro.circ.onionCell(relayEstablishIntro(),
                                             establishIntroCell(authPublic, authSeed, intro.circ.kh)));
  Awaited established = awaitCommand(intro.link, intro.circ, relayIntroEstablished());
  if (!established.ok) {
    err.line("hsserviced: the introduction point did not confirm");
    return 1;
  }
  out.line("hsserviced: introduction point established at \{network.relays[introRelay].nickname}");

  // ── 2. The descriptor, and the directories that hold it ─────────────────────
  i64[] period = consensusTimePeriod(network.consensus, testnet, 0);
  if (period[0] < 0) {
    err.line("hsserviced: the consensus carries no usable timings");
    return 1;
  }

  IntroPointSecrets[] points = IntroPointSecrets[].filled(1, IntroPointSecrets(
    linkSpecifiersFor(network, introRelay), network.relays[introRelay].ntorOnionKey, authSeed, encSecret));

  Publication[] plan = servicePlan(network.consensus, network.relays, blindedKeysFor(identityPublic, period),
                                   testnet, 0);
  if (plan.len() != 2) {
    err.line("hsserviced: no publication plan — the consensus has no timings to plan from");
    return 1;
  }

  i32 uploaded = 0;
  i64 nowSeconds = flatten(clock.nowMillis().wait()).unwrap() / 1000;
  for (i32 p = 0; p < plan.len(); p++) {
    // **Not a constant.** An HSDir replaces a descriptor only when the revision counter is strictly
    // greater, so a service that always published `1` could never update — and after a restart could
    // not republish at all, because the directories still hold the previous run's descriptor with the
    // same number. That is exactly what happened the first time this program was restarted against a
    // network it had already published to: *wacrelay2 refused the descriptor; it is the document that
    // is wrong, not the directory*, which is the rule working and the caller being wrong.
    //
    // Seconds into the time period, which is what tor counts. **tor then encrypts it** with an
    // order-preserving cipher so the ordering survives and the value does not — publishing it in the
    // clear, as this does, tells anyone who fetches the descriptor when the service last published.
    // A real disclosure, recorded in `INTEROP.md` rather than left for someone to notice.
    i64 revision = nowSeconds - plan[p].periodNum * plan[p].periodLength * 60;
    if (revision < 1) { revision = 1; }
    Built built = buildDescriptor(identitySeed, flatten(rnd.bytes(32).wait()).unwrap(), points,
                                  plan[p].periodNum, plan[p].periodLength, revision,
                                  LIFETIME_MINUTES,
                                  expiryHours(network), flatten(rnd.bytes(32).wait()).unwrap(),
                                  flatten(rnd.bytes(16).wait()).unwrap(), flatten(rnd.bytes(16).wait()).unwrap(),
                                  decoyClients(rnd));
    if (built.error != BUILD_OK) {
      err.line("hsserviced: could not build the descriptor for period \{p}" +
                ", error \{built.error}");
      continue;
    }
    uploaded = uploaded + uploadTo(err, out, clock, rnd, net, network, plan[p], built);
  }
  if (uploaded == 0) {
    err.line("hsserviced: no directory took the descriptor");
    return 1;
  }
  out.line("hsserviced: published to \{uploaded} directories");

  // ── 3. Wait for a client, and go and meet it ────────────────────────────────
  u8[] subcred = subcredential(identityPublic, blindedPublicKey(identityPublic, period[0],
                                                                period[1]));
  ReplayCache cells = introReplayCache(64);
  ReplayCache cookies = cookieReplayCache(64);

  out.line("hsserviced: waiting for a client");
  while (!intro.link.dead) {
    // No deadline. Silence on an introduction circuit is the normal state — it lasts until somebody
    // decides to visit — and a thirty-second read timeout would make this service reachable only by a
    // client who arrived in the first half minute. What bounds the circuit is the introduction
    // point's own eighteen-to-twenty-four hour expiry.
    u8[] cell = nextCellFor(intro.link, -1);
    if (cell.len() == 0) { break; }
    Received got = intro.circ.receive(cell);
    if (got.toSend.len() > 0) { sendCells(intro.link, got.toSend); }
    if (got.kind == gotDestroyed() || got.kind == gotBroken()) { break; }
    if (got.command != relayIntroduce2()) { continue; }

    // A fresh ephemeral secret per introduction. Reusing one would give two clients a shared view of
    // the handshake, which is the sort of reuse that is invisible until it is not.
    Introduction answer = handleIntroduce2(got.data, authPublic, encSecret, subcred,
                                           clamp(flatten(rnd.bytes(32).wait()).unwrap()), cells, cookies,
                                           flatten(clock.nowMillis().wait()).unwrap() / 1000, testnet);
    if (answer.error != INTRO2_OK) {
      err.line("hsserviced: an introduction was refused, reason \{answer.error}");
      continue;
    }
    out.line("hsserviced: an introduction, meeting at " +
             "\{answer.rendezvous.address[0]}.\{answer.rendezvous.address[1]}." +
             "\{answer.rendezvous.address[2]}.\{answer.rendezvous.address[3]}:" +
             "\{answer.rendezvous.port}");

    if (!serveOne(err, out, clock, rnd, net, network, answer)) {
      err.line("hsserviced: could not reach the rendezvous point");
    }
  }
  err.line("hsserviced: the introduction circuit closed");
  return 0;
}

/**
 * Build a circuit to the rendezvous point the client named and send RENDEZVOUS1.
 *
 * A separate circuit, built now rather than kept ready: a service that held one waiting would be
 * holding it for a rendezvous point it cannot know in advance.
 */
bool serveOne(Output err, Output out, Clock clock, Random rnd, Net net, Network network, Introduction answer) {
  i32 target = relayByEd25519(network, answer.rendezvous.ed25519Id);
  if (target < 0) {
    err.line("hsserviced: the client named a rendezvous point that is not in the consensus");
    return false;
  }
  Session rend = buildCircuitTo(err, clock, rnd, net, network, target, 0x80000032);
  if (!rend.ok) { return false; }
  sendCells(rend.link, rend.circ.onionCell(relayRendezvous1(), answer.rendezvous1));

  // The client is beyond the rendezvous point, reachable only because that relay splices the two
  // circuits. Adding the hop is what makes it the far end of *this* one, and it is the same key
  // expansion the client added — read the other way round, because we are the other end of it.
  rend.circ.addRendezvousHopAsService(rendezvousCircuitKeys(answer.keySeed));
  out.line("hsserviced: rendezvous joined, the client is hop \{rend.circ.length()}");

  // Then serve whatever it asks for. **One client at a time**, which is the honest limit of this
  // program rather than of the protocol: while this loop runs, an INTRODUCE2 arriving on the
  // introduction circuit waits. The pieces for doing better are here — `bootstrap` exports the
  // incremental `startCircuit`/`advanceCircuit`, and `waitAny` takes a list — and a second client is
  // the thing to build next.
  bool connected = false;
  while (!rend.link.dead) {
    u8[] cell = nextCellFor(rend.link, 60000);
    if (cell.len() == 0) { break; }
    Received got = rend.circ.receive(cell);
    if (got.toSend.len() > 0) { sendCells(rend.link, got.toSend); }
    if (got.kind == gotDestroyed() || got.kind == gotBroken()) { break; }

    if (got.command == relayBegin() && !connected) {
      connected = true;
      // A BEGIN on a rendezvous circuit names `:port` and no host — the service *is* the far end, so
      // there is nowhere else to connect to and nothing to look up. CONNECTED carries no address for
      // the same reason.
      sendCells(rend.link, rend.circ.sendToEnd(relayConnected(), got.streamId, u8[]()));
      u8[] page = greeting();
      u8[][] parts = chunkRequest(page);
      for (i32 i = 0; i < parts.len(); i++) {
        sendCells(rend.link, rend.circ.dataCell(got.streamId, parts[i]));
      }
      sendCells(rend.link, rend.circ.sendToEnd(relayEnd(), got.streamId, endDone()));
      out.line("hsserviced: served \{page.len()} bytes to a client");
      break;
    }
  }
  closeLink(rend.link);
  return true;
}

/** What this service says. A fixed page, because the point is the path rather than the content. */
u8[] greeting() {
  string body = "hello from behind an onion\n";
  return ("HTTP/1.0 200 OK\r\nContent-Type: text/plain\r\nContent-Length: " +
          "\{body.toBytes().len()}\r\n\r\n\{body}").toBytes();
}

/** REASON_DONE, the one-byte body of a RELAY_END that is not an error. */
u8[] endDone() {
  u8[] out = u8[].filled(1, 0);
  out[0] = 6;
  return out;
}

/** Upload one descriptor to every directory the plan names, and count what took it. */
i32 uploadTo(Output err, Output out, Clock clock, Random rnd, Net net, Network network, Publication where, Built built) {
  i32 took = 0;
  for (i32 i = 0; i < where.hsdirs.len(); i++) {
    i32 r = where.hsdirs[i];
    Session s = buildCircuitTo(err, clock, rnd, net, network, r, 0x80000040 + i);
    if (!s.ok) {
      err.line("hsserviced: no circuit to \{network.relays[r].nickname}");
      continue;
    }
    i32 outcome = publishOverCircuit(s.link, s.circ, built.document,
                                     "\{network.relays[r].address}:\{network.relays[r].orPort}");
    if (outcome == UPLOAD_OK) {
      took = took + 1;
      out.line("hsserviced: \{network.relays[r].nickname} took the descriptor");
    } else if (outcome == UPLOAD_REJECTED) {
      // Every other directory will read the same bytes and refuse them too — see `hsupload.wac`.
      err.line("hsserviced: \{network.relays[r].nickname} refused the descriptor; it is the "
                + "document that is wrong, not the directory");
      return took;
    } else {
      err.line("hsserviced: \{network.relays[r].nickname} answered oddly, outcome " +
                "\{outcome}");
    }
  }
  return took;
}

/** The blinded key for each of the two periods a service publishes for. */
u8[][] blindedKeysFor(u8[] identityPublic, i64[] period) {
  u8[][] out = u8[][].defaulted(2);
  out[0] = blindedPublicKey(identityPublic, period[0], period[1]);
  out[1] = blindedPublicKey(identityPublic, period[0] + 1, period[1]);
  return out;
}

/** Sixteen decoy client-auth entries, so using client authorisation is not visible from outside. */
u8[][] decoyClients(Random rnd) {
  u8[][] out = u8[][].defaulted(16);
  for (i32 i = 0; i < 16; i++) { out[i] = flatten(rnd.bytes(40).wait()).unwrap(); }
  return out;
}

/** Hours since the epoch, a year out — the unit a proposal 220 certificate states its expiry in. */
i64 expiryHours(Network network) {
  i64 validAfter = timeOf(network.consensus, "valid-after");
  if (validAfter <= 0) { return 0; }
  return (validAfter / 3600) + 8760;
}

/** An IPv4 link specifier list for a relay: where it is, and both of its identities. */
u8[] linkSpecifiersFor(Network network, i32 i) {
  u8[] v4 = ipv4Bytes(network.relays[i].address);
  u8[] id = network.relays[i].identity;
  u8[] ed = network.relays[i].ed25519Identity;
  if (v4.len() != 4 || id.len() != 20 || ed.len() != 32) { return u8[](); }
  u8[] out = u8[].filled(1 + 8 + 22 + 34, 0);
  out[0] = 3;
  out[1] = 0; out[2] = 6;
  out.copyFrom(v4, 0, 3, 4);
  out[7] = ((network.relays[i].orPort >> 8) & 0xFF) as! u8;
  out[8] = (network.relays[i].orPort & 0xFF) as! u8;
  out[9] = 2; out[10] = 20;
  out.copyFrom(id, 0, 11, 20);
  out[31] = 3; out[32] = 32;
  out.copyFrom(ed, 0, 33, 32);
  return out;
}

u8[] ipv4Bytes(string address) {
  u8[] out = u8[].filled(4, 0);
  i32 part = 0;
  i32 value = 0;
  u8[] a = address.toBytes();
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] == '.') {
      if (part >= 3) { return u8[](); }
      out[part] = value as@ u8;
      part = part + 1;
      value = 0;
    } else if (a[i] >= '0' && a[i] <= '9') {
      value = value * 10 + (a[i] as i32 - '0');
      if (value > 255) { return u8[](); }
    } else {
      return u8[]();
    }
  }
  if (part != 3) { return u8[](); }
  out[3] = value as@ u8;
  return out;
}

u8[] firstBytes(u8[] b, i32 n) {
  u8[] out = u8[].filled(n, 0);
  out.copyFrom(b, 0, 0, n);
  return out;
}

u8[] clamp(u8[] s) {
  u8[] out = u8[].filled(32, 0);
  out.copyFrom(s, 0, 0, 32);
  out[0] = out[0] & 248;
  out[31] = (out[31] & 127) | 64;
  return out;
}

/**
 * A relay to use as an introduction point.
 *
 * The first with both identities and an ntor key, which is what a circuit and a descriptor entry both
 * need. Deliberately not weighted or random: a service running three of these would choose them the
 * way a client chooses a path, and choosing well is `pathsel.wac`'s job rather than something to
 * approximate here — with one introduction point the honest thing is to say it is the first usable
 * one rather than imply a selection that is not happening.
 */
i32 firstHsdirCapable(Network network) {
  for (i32 i = 0; i < network.relays.len(); i++) {
    if (network.relays[i].ed25519Identity.len() == 32 && network.relays[i].identity.len() == 20 &&
        network.relays[i].ntorOnionKey.len() == 32) {
      return i;
    }
  }
  return -1;
}
