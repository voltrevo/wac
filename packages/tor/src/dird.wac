// A directory authority's HTTP port: serve the consensus, the certificate and the descriptor.
//
//   wac run --allow-net --allow-read packages/tor/src/dird.wac -- \
//       <consensus-file> <certificate-file> <descriptor-file> [port]
//
// The documents are read from disk rather than generated here, because generating them means an
// RSA-1024 prime search and a server should start in less than a minute. `src/gendesc.wac` writes them.
//
// The routing lives in `dirserve.wac` and is tested without a socket in sight. What is left here is the
// part that can only be checked by connecting to it: accept, read a request, write a reply, close.
//
// ## Why it closes after each reply
//
// One request per connection, `Connection: close`, no keep-alive. A directory client makes a handful of
// requests over a bootstrap and tor's own cache is happy to close; supporting keep-alive would mean
// tracking a read buffer per connection and deciding when a pipelined request is complete, which is
// work with no reader on the other side of it yet. `dirserve.wac`'s `write` is told `keepAlive = false`
// so the header and the behaviour cannot drift apart.
//
// ## No TLS
//
// A DirPort is plain HTTP. That is not a shortcut: a directory document carries its own signatures, so
// transport confidentiality buys nothing a client relies on, which is exactly why tor's own DirPort is
// unencrypted. `consensus.wac` is the reason — a client checks the documents, not the connection.

import { Sys, Files, Net, Output, Listener, HostFault, Socket, SocketFault } from "std";
import { Read, flatten, Result } from "core";
import { Buf } from "core";
import { Parsed, parseRequest } from "../../http/src/request.wac";
import { DirDocuments, dirSourceFingerprint } from "./dirserve.wac";
import { DirAction, MAX_BODY, dirStep, filed } from "./dirstep.wac";
import { PUB_OK } from "./hsstore.wac";
import { rsaDescriptorDigest } from "./routerdesc.wac";
import { microdescDigests } from "./microdesc.wac";

static i32 DEFAULT_PORT = 7000;

/**
 * The cap on a request's *headers*, which is the part a client can make arbitrarily long for free.
 *
 * A body is capped separately, by `Content-Length` against `MAX_BODY`, and the parser refuses a
 * declared length past that without buffering it. Keeping the two caps apart is the point: a
 * descriptor is fourteen kilobytes, so one shared cap large enough to accept an upload would also let
 * anyone hold this loop open with fourteen kilobytes of header they never finish.
 */
static i32 MAX_REQUEST = 8192;

/** How many descriptors this directory will hold. */
static i32 MAX_STORED = 32;

export i32 main(Sys sys) {
  string[] argv = sys.args();
  Output err = sys.stderr();
  Output out = sys.stdout();
  Files fs = sys.files();
  Net net = sys.net();
  if (argv.len() < 3) {
    err.line("usage: dird <consensus-file> <certificate-file> <descriptor-file>... [port]");
    return 1;
  }

  u8[] consensus = readOr(err, fs, argv[0]);
  u8[] certificate = readOr(err, fs, argv[1]);
  // Every argument from the third on is a descriptor, so a network of several relays is served by
  // listing them. They go out concatenated, which is how a directory response carries more than one.
  // A trailing port and a descriptor path are both just arguments, so the port is recognised by being
  // all digits and last. Counting descriptors as "everything that is not a flag" would have swallowed
  // the port and then failed trying to open `17999` as a file.
  i32 argc = argv.len();
  i32 descCount = argc - 2;
  if (descCount > 1 && atoiSafe(argv[argc - 1].toBytes()) >= 0) { descCount = descCount - 1; }
  u8[] descriptors = u8[]();
  u8[][] digests = u8[][].defaulted(descCount);
  for (i32 i = 0; i < descCount; i++) {
    u8[] one = readOr(err, fs, argv[2 + i]);
    if (one.len() == 0) { return 1; }
    descriptors = joinBytes(descriptors, one);
    digests[i] = rsaDescriptorDigest(one);
  }
  if (consensus.len() == 0 || certificate.len() == 0 || descriptors.len() == 0) { return 1; }

  // The port follows the descriptors, so it is found by position rather than by guessing at index 3.
  i32 port = DEFAULT_PORT;
  if (argc > 2 + descCount) {
    // Port 0 is "ask the operating system", not a mistake: the chosen port is logged, and it is what
    // lets two agents run the suite at once without agreeing in advance about who gets which number.
    i32 given = atoiSafe(argv[2 + descCount].toBytes());
    if (given < 0 || given > 65535) {
      err.line("dird: " + argv[2 + descCount] + " is not a port");
      return 1;
    }
    port = given;
  }

  // The fingerprint a client names in `/tor/keys/fp/<fp>` is the authority's identity digest, and the
  // consensus states it on its own dir-source line — so it is read out of the document rather than
  // passed in, where the two could disagree.
  u8[] fingerprint = dirSourceFingerprint(consensus);
  if (fingerprint.len() != 20) {
    err.line("dird: the consensus has no dir-source fingerprint to answer /tor/keys/fp for");
    return 1;
  }

  // The microdesc flavour, when it is sitting next to the consensus file. Named by convention rather
  // than by a flag so the caller has one fewer thing to keep in step: `<consensus>.micro` and
  // `<consensus>.mds` are what `gendesc` writes, and an authority that has them serves them.
  u8[] microCons = u8[]();
  u8[] micros = u8[]();
  u8[][] microDigests = u8[][]();
  {
    string base = argv[0];
    u8[]? mc = flatten(fs.readFile("\{base}.micro").wait()).ok();
    u8[]? md = flatten(fs.readFile("\{base}.mds").wait()).ok();
    if ((mc is not null) && (md is not null)) {
      microCons = mc!;
      micros = md!;
      microDigests = microdescDigests(micros);
      out.line("dird: serving the microdesc flavour and \{microDigests.len()}" +
               " microdescriptor(s)");
    }
  }

  DirDocuments docs = DirDocuments(consensus, microCons, certificate, descriptors, digests,
                                   fingerprint, micros, microDigests, u8[][](), u8[][]());

  auto listenerBind = flatten(net.listen("127.0.0.1", port).wait());
  Listener? listener = listenerBind.ok();
  if (listener is null) {
    err.line("dird: listen: \{listenerBind.isErr() ? "\{listenerBind.err()!}" : ""}");
    return 1;
  }
  out.line("dird: serving the directory on 127.0.0.1:\{listener!.port}");

  accepting(err, out, listener!, Held(docs));
  // Nothing has suspended yet: `accepting` ran as far as its first `await` and handed back a ticket.
  // `drain` is what dispatches every continuation from here on, and it is the whole event loop.
  sys.drain().wait();
  return 0;
}

/**
 * Accept for ever, and serve each client **without waiting for it**.
 *
 * `design/lang/0014` A1's program. `answer` is called and deliberately not awaited: it runs as far as
 * its first suspension now and the rest of it is dispatched by `drain`, so a client that never
 * finishes a request line no longer holds the door. That head-of-line block is what
 * `issues/system/0294c` records as the reason to want this here — a directory port is reachable by
 * anyone who can route to it.
 */
async void accepting(Output err, Output out, Listener listener, Held held) {
  while (true) {
    Result<Socket, HostFault> conn = await listener.accept();
    if (conn.isErr()) {
      err.line("dird: accept: \{conn.err()!}");
      return;
    }
    answer(err, out, conn.unwrap(), held);
  }
}

/**
 * Read one request and write one reply.
 *
 * A request can arrive in pieces, so bytes accumulate until the parser says it has a whole one. The
 * cap matters: without it a client that never finishes a request line holds this loop forever, and a
 * directory port is reachable by anyone who can route to it.
 */
async void answer(Output err, Output out, Socket conn, Held held) {
  Buf pending = Buf.create();
  while (true) {
    // **Read and write with no suspension between them**, which is the whole of what concurrency
    // costs here — `issues/system/0294c`. This used to take `docs` as a parameter and hand a new one
    // back, so each call held a private copy across its `recv` and the last writer won: a descriptor
    // filed by one client was lost when another that started earlier returned its stale copy.
    // Nothing would have failed. `held` is read where it is used and written immediately, and wac's
    // concurrency is cooperative, so between those two lines no other client can run.
    DirAction act = dirStep(pending.bytes(), held.docs);
    if (act.ready) {
      if (act.descriptor.len() > 0) {
        held.docs = filed(held.docs, act.descriptor, act.blindedKey, MAX_STORED);
        out.line("dird: stored a descriptor, \{held.docs.hsDescriptors.len()} held");
      } else if (act.refusedFor != PUB_OK) {
        err.line("dird: refused a descriptor, reason \{act.refusedFor}");
      }
      Result<void, SocketFault> sent = await conn.send(act.response);
      if (sent.isErr()) { err.line("dird: the reply could not be sent: \{sent.err()!}"); }
      conn.close();
      return;
    }
    if (pending.bytes().len() > MAX_REQUEST + MAX_BODY) {
      err.line("dird: a request larger than \{MAX_REQUEST + MAX_BODY} bytes, dropped");
      conn.close();
      return;
    }
    bool more = false;
    Result<Read, SocketFault> got = await conn.recv();
    match (got) {
      Ok(r): {
        match (r) {
          Data(bytes): {
            pending.pushAll(bytes);
            more = true;
          }
          default: { }
        }
      }
      Err(e): { err.line("dird: the connection failed: \{e}"); }
    }
    if (!more) { conn.close(); return; }
  }
}

/**
 * The one cell the documents live in.
 *
 * Not a parameter and a return value, which is what made the old shape lose updates: a value passed
 * in is a *copy* for as long as the callee holds it, and `answer` holds it across a `recv`.
 */
struct Held {
  DirDocuments docs;
}

u8[] readOr(Output err, Files fs, string path) {
  auto fRead = flatten(fs.readFile(path).wait());
  u8[]? f = fRead.ok();
  if ((f is null)) {
    err.line("dird: \{path}: \{fRead.isErr() ? "\{fRead.err()!}" : ""}");
    return u8[]();
  }
  return f!;
}

/** A port, or -1 rather than a partial number — `atoi` would read "80x" as 80. Zero is a port here. */
i32 atoiSafe(u8[] text) {
  if (text.len() == 0) { return -1; }
  i32 v = 0;
  for (i32 i = 0; i < text.len(); i++) {
    if (text[i] < 48 || text[i] > 57) { return -1; }
    v = v * 10 + (text[i] as i32 - 48);
    if (v > 65535) { return -1; }
  }
  return v;
}

u8[] joinBytes(u8[] a, u8[] b) {
  u8[] out = u8[].filled(a.len() + b.len(), 0);
  out.copyFrom(a, 0, 0, a.len());
  for (i32 i = 0; i < b.len(); i++) { out[a.len() + i] = b[i]; }
  return out;
}
