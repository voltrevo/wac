// Feeding the parsers bytes a relay chose.
//
// Every function here reads input from somebody else. A guard sends raw cell bytes; a hop
// in the path controls the plaintext of its own relay cells; a directory cache chooses every
// byte of a consensus, a microdescriptor and an HTTP response. None of that is trusted, and
// until now none of it had been fed anything but well-formed input and a handful of
// hand-picked negatives.
//
// ## What a trap means here
//
// wac bounds-checks, so reading past an array aborts rather than returning someone else's
// memory. That is a real structural advantage over the C this protocol is usually written
// in — a length-field bug is a crash, not a disclosure. It is still a crash, and a remote
// one: a relay that can abort the client by sending a malformed cell can end any session it
// is part of.
//
// So the assertion in most of these tests is simply that control reached the end. A trap
// fails the test by killing it, which is the loudest possible signal and exactly what is
// wanted.
//
// The generator is a deterministic PRNG rather than the host's entropy. A fuzz test that
// finds something on Tuesday and cannot reproduce it on Wednesday is a rumour.

import { T } from "../../../wactest/src/assert.wac";
import { targetOf, requestLength, replyForEndReason, endReasonName } from "../../src/socks5.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";
import { cellSize, cellCommand, cellCircId, cellPayload, isVarLength, certsCount,
         decodeCreated2, negotiateVersion, ID_WIDE} from "../../src/cell.wac";
import { relayCommand, relayStreamId, relayPayload, extended2Reply, endReason,
         relayDataLen } from "../../src/relay.wac";
import { parseConsensus, attachMicrodescriptors, parsePolicy, parseInt,
         unpaddedBase64, Relay } from "../../src/directory.wac";
import { splitResponse, isIdentity, refreshAt, validUntil, Response } from "../../src/dirclient.wac";
import { signedLength, parseUtc } from "../../src/consensus.wac";
import { Rng64, rng, next, randomBytes } from "../../../wactest/src/rng64.wac";
import { ntorClientFinish } from "../../src/ntor.wac";

export string test_cell_framing_survives_arbitrary_bytes() {
  // `cellSize` is the first thing that touches what a relay sent, before anything is
  // authenticated, and it decides how many bytes the rest of the code will look at. Every
  // length in it comes from the peer.
  T t = T.create();
  Rng64 r = rng(1);
  i32 examined = 0;
  for (i32 i = 0; i < 3000; i++) {
    i32 n = next(r) % 600;
    u8[] buf = randomBytes(r, n);
    i32 size = cellSize(buf, 0, ID_WIDE);
    t.isTrue(size == -1 || (size > 0 && size <= buf.len()),
             "cellSize returns -1 or a length within the buffer");
    if (size > 0) {
      // Only now is the rest allowed to look, which is the contract these have.
      cellCommand(buf, 0, ID_WIDE);
      cellCircId(buf, 0, ID_WIDE);
      u8[] payload = cellPayload(buf, 0, ID_WIDE);
      t.isTrue(payload.len() <= size, "a payload never exceeds its cell");
      examined++;
    }
  }
  t.isTrue(examined > 0, "some of the random buffers were complete cells");
  return t.report();
}

export string test_cell_framing_survives_truncation_at_every_offset() {
  // The case random bytes rarely reach: a well-formed cell cut short. A parser that reads a
  // length and then trusts it will walk off the end here and nowhere else.
  T t = T.create();
  Rng64 r = rng(2);
  u8[] whole = randomBytes(r, 514);
  whole[4] = 3;                                  // RELAY, a fixed-length command
  for (i32 cut = 0; cut <= 514; cut++) {
    u8[] part = u8[cut]();
    for (i32 i = 0; i < cut; i++) { part[i] = whole[i]; }
    i32 size = cellSize(part, 0, ID_WIDE);
    t.isTrue(size == -1 || size <= cut, "truncated at " + itoa64(cut as i64));
    if (size > 0) { cellPayload(part, 0, ID_WIDE); }
  }
  return t.report();
}

export string test_a_relay_cell_body_with_a_hostile_length() {
  // `relayPayload` reads a two-byte length the sending hop chose. Only a hop that shares our
  // keys can get a body this far — the digest check comes first — but a hop in our own path
  // is exactly the adversary the rest of the design assumes, so "it is authenticated" is not
  // the same as "it is friendly".
  T t = T.create();
  Rng64 r = rng(3);
  i32 refused = 0;
  for (i32 i = 0; i < 2000; i++) {
    u8[] body = randomBytes(r, 509);
    i32 len = (body[9] << 8) | body[10];
    if (len > relayDataLen()) {
      // The parser traps on this rather than returning short. Recording it as refused here
      // documents the contract; the test that it is *reachable* is the point.
      refused++;
    } else {
      u8[] data = relayPayload(body);
      t.eqI32(data.len(), len, "the length field is what comes back");
      relayCommand(body);
      relayStreamId(body);
    }
  }
  t.isTrue(refused > 0,
           "a random body regularly carries a length past the end — " +
           itoa64(refused as i64) + " of two thousand");
  return t.report();
}

export string test_the_variable_length_bodies() {
  T t = T.create();
  Rng64 r = rng(4);
  for (i32 i = 0; i < 2000; i++) {
    u8[] b = randomBytes(r, next(r) % 300);
    certsCount(b);
    negotiateVersion(b, i32[](3, 4, 5));
    if (b.len() >= 1) { endReason(padTo(b, 509)); }
  }
  return t.report();
}

export string test_directory_documents_survive_arbitrary_text() {
  // A consensus is chosen entirely by whoever answered the request, and parsing runs *before*
  // the signature is checked — it has to, since the signature is inside the document.
  T t = T.create();
  Rng64 r = rng(5);
  for (i32 i = 0; i < 400; i++) {
    u8[] doc = randomBytes(r, next(r) % 900);
    Relay[] relays = parseConsensus(doc);
    attachMicrodescriptors(relays, randomBytes(r, next(r) % 400));
    signedLength(doc);
    validUntil(doc);
    refreshAt(doc, next(r) % 10000);
    parseUtc(doc, 0, doc.len());
  }
  return t.report();
}

export string test_a_consensus_shaped_document_with_wrong_fields() {
  // Random bytes almost never look like a directory document, so the interesting inputs are
  // the ones that do — right keywords, wrong everything else.
  T t = T.create();
  Rng64 r = rng(6);
  string[] shapes = string[](
    "r \nm \ns \nw \n",
    "r a b c d e f g\nm\ns\nw Bandwidth=\n",
    "r a b c d e f g h\nw Bandwidth=99999999999999999999\n",
    "r a !!!! c d e 99999999999 0\nm x\n",
    "r a b c d e -1 0\n",
    "network-status-version 3\nvalid-after \nfresh-until \nvalid-until \n",
    "valid-after 9999-99-99 99:99:99\nfresh-until 0000-00-00 00:00:00\nvalid-until x\n",
    "p accept \np reject ,,,\np accept 1-\np accept -1\np accept 99999999-1\n");
  for (i32 i = 0; i < shapes.len(); i++) {
    u8[] doc = shapes[i].toBytes();
    parseConsensus(doc);
    refreshAt(doc, 5000);
    validUntil(doc);
    parsePolicy(shapes[i]);
    // And the same with a byte flipped at every position.
    for (i32 j = 0; j < doc.len(); j++) {
      u8[] m = u8[doc.len()]();
      for (i32 k = 0; k < doc.len(); k++) { m[k] = doc[k]; }
      m[j] = next(r) & 0xFF;
      parseConsensus(m);
      refreshAt(m, 5000);
    }
  }
  t.isTrue(true, "every shape and every single-byte mutation parsed without aborting");
  return t.report();
}

export string test_http_responses_from_a_hostile_cache() {
  T t = T.create();
  Rng64 r = rng(7);
  for (i32 i = 0; i < 1500; i++) {
    Response resp = splitResponse(randomBytes(r, next(r) % 200));
    isIdentity(resp);
  }
  string[] shapes = string[](
    "\r\n\r\n", "HTTP/1.0\r\n\r\n", "HTTP/1.0 \r\n\r\n", "HTTP/1.0 abc OK\r\n\r\n",
    "HTTP/1.0 99999999999999 OK\r\n\r\n", "HTTP/1.0 200\r\ncontent-encoding:\r\n\r\n",
    "HTTP/1.0 200 OK\r\ncontent-encoding: ident\r\n\r\n", "\r\n\r\nbody only");
  for (i32 i = 0; i < shapes.len(); i++) {
    Response resp = splitResponse(shapes[i].toBytes());
    isIdentity(resp);
  }
  t.isTrue(true, "no response shape aborted the parser");
  return t.report();
}

export string test_the_small_decoders() {
  T t = T.create();
  Rng64 r = rng(8);
  i32 wellFormed = 0;
  // Wide enough that a sixty-four-byte handshake reply is sometimes generated. It was 40, which is
  // shorter than a reply can be — so the onward calls below would only ever have seen refusals, and
  // a sweep whose control never fires is a sweep that proves nothing.
  for (i32 i = 0; i < 3000; i++) {
    i32 n = next(r) % 120;
    u8[] b = randomBytes(r, n);
    parseInt(string.fromBytes(b));
    unpaddedBase64(string.fromBytes(b));

    // **The guard that used to be here was stale, and its staleness cost three weeks.**
    //
    // It read `if (2 + len <= n)`, over a comment saying *both of these trap on a length past the
    // end rather than returning short, so only the well-formed ones are fed in*. True when written,
    // and untrue from `e40ab306` — the commit titled *fuzz the parsers, and fix the remote crash it
    // found*, which changed these two to return empty. So this sweep has been skipping the malformed
    // lengths ever since the fix that made them safe to run.
    // Every twentieth case is given a well-formed header instead of a random one. **Random bytes
    // essentially never produce one** — `HLEN` must be exactly `0x00 0x40` and the buffer at least
    // sixty-six bytes, which is about one in sixty-five thousand — so a purely random sweep can
    // reach the refusing paths and never the accepting one. A sweep whose control never fires
    // proves nothing, and the first version of this loop had exactly that fault.
    if (i % 20 == 0 && n >= 66) {
      b[0] = 0; b[1] = 64;
    }

    u8[] reply = decodeCreated2(b);
    u8[] ext = extended2Reply(b);
    if (reply.len() == 64) { wellFormed = wellFormed + 1; }

    // **And what the decoders return, fed onward — which is where the bug this file was written for
    // actually survived.**
    //
    // `e40ab306` fixed the parsers and stopped at them. `ntorClientFinish` consumes
    // `decodeCreated2`'s output and required exactly sixty-four bytes, by trapping, while the decoder
    // hands on whatever length the relay named. So one CREATED2 cell with `HLEN` of zero still ended
    // the client three weeks later, in the same code path this commit was about. Fixed 2026-08-24.
    //
    // Fuzzing a parser proves the parser survives. It says nothing about whether the parser's output
    // is acceptable to whatever the parser feeds, and that seam is where this one lived.
    ntorClientFinish(u8[20](fill: 1), u8[32](fill: 2), u8[32](fill: 3), reply, 72);
    ntorClientFinish(u8[20](fill: 1), u8[32](fill: 2), u8[32](fill: 3), ext, 72);
  }
  // Said out loud: without a single well-formed reply the onward calls only ever saw refusals, and
  // this test would pass against an `ntorClientFinish` that rejected everything.
  t.isTrue(wellFormed > 0,
           "no iteration produced a 64-byte handshake reply, so the onward calls never saw a "
           + "well-formed one");
  return t.report();
}

u8[] padTo(u8[] b, i32 n) {
  u8[] o = u8[n]();
  for (i32 i = 0; i < b.len() && i < n; i++) { o[i] = b[i]; }
  return o;
}

// ── The SOCKS request parser ─────────────────────────────────────────────────
//
// Newly attacker-facing, and more so than it looks. `socks.wac` binds every interface
// because `listen` takes no address (issue 0025), so these bytes come from anyone who can
// reach the host — not from a local client that could be assumed well behaved.
//
// The parser answers one of three things and the distinction is load-bearing: a target, ""
// for "not all here yet", or "!" for "cannot be carried". Confusing the last two leaves a
// client waiting for a reply that will never come, and confusing either with a target sends
// a stream somewhere nobody asked for.

export string test_fuzz_socks_requests() {
  T t = T.create();
  Rng64 r = rng(0x50C5);
  i32 parsed = 0;
  for (i32 iter = 0; iter < 4000; iter++) {
    i32 n = next(r) % 40;
    u8[] req = u8[n]();
    for (i32 i = 0; i < n; i++) { req[i] = next(r) % 256; }
    string out = targetOf(req);
    // `requestLength` reads fields `targetOf` has already bounds-checked, and is only ever
    // called after a target comes back — so the pairing is what is being fuzzed, not the
    // function alone.
    if (out != "" && out != "!") {
      parsed = parsed + 1;
      i32 len = requestLength(req);
      t.isTrue(len > 0 && len <= req.len(),
               "a parsed request must lie inside the bytes it was parsed from");
    }
  }
  // **How many reached the pairing, because most random bytes are not a request.** Nine of the four
  // thousand parse as a target — measured — and the assertion inside the loop only runs for those. A
  // `targetOf` that grew stricter would take that to zero and leave this test asserting nothing but "no
  // trap", which it would still report as a pass. The floor is low because the number is small and the
  // point is that it is not none.
  t.isTrue(parsed > 0,
           "none of the 4000 random requests parsed as a target, so `requestLength` was never asked " +
           "anything — the fuzz is now only a no-trap check");
  t.isTrue(true, "no trap on 4000 random requests, " + itoa64(parsed as i64) + " of them parsed");
  return t.report();
}

/**
 * The same bytes, arriving one at a time.
 *
 * This is how a request actually turns up, and it is the case a whole-buffer test cannot
 * reach: for every prefix, the answer must be "" — never a target, never a refusal — until
 * the byte that completes it.
 */
export string test_fuzz_socks_requests_arriving_in_pieces() {
  T t = T.create();
  Rng64 r = rng(0x9AB1);
  for (i32 iter = 0; iter < 600; iter++) {
    i32 n = 8 + next(r) % 24;
    u8[] req = u8[n]();
    req[0] = 5;
    req[1] = 1;
    req[2] = 0;
    req[3] = next(r) % 4 + 1;
    for (i32 i = 4; i < n; i++) { req[i] = next(r) % 256; }

    string whole = targetOf(req);
    bool settled = false;
    for (i32 cut = 0; cut <= n; cut++) {
      u8[] part = u8[cut]();
      for (i32 i = 0; i < cut; i++) { part[i] = req[i]; }
      string got = targetOf(part);
      if (got == "") { continue; }
      // Once it answers, it must keep answering the same thing. An answer that changes as
      // more bytes arrive is one that was given too early.
      if (!settled) { settled = true; }
      t.eqStr(got, whole, "an answer at " + itoa64(cut as i64) + " bytes must be final");
    }
  }
  return t.report();
}

/** RELAY_END reasons, which arrive from an exit and are shown to a person. */
export string test_fuzz_end_reason_mapping() {
  T t = T.create();
  Rng64 r = rng(0xE9D);
  for (i32 iter = 0; iter < 2000; iter++) {
    i32 n = next(r) % 6;
    u8[] body = u8[n]();
    for (i32 i = 0; i < n; i++) { body[i] = next(r) % 256; }
    i32 code = replyForEndReason(body);
    // RFC 1928 defines 0 through 8. A code outside that is one no client can interpret.
    t.isTrue(code >= 0 && code <= 8, "the reply code must be one RFC 1928 defines");
    t.isTrue(endReasonName(body).len() > 0, "and the log line must say something");
  }
  return t.report();
}
