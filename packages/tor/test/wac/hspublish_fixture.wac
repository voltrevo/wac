// The two files `capture-hspub.py` and `genhsdesc.wac` leave behind, read once and shared.
//
// `hsstore_test.wac` and `dirstep_test.wac` ask different questions of the *same* bytes — one about
// the verdict a directory reaches, the other about a request arriving a byte at a time — and both
// need the controls. Each control is the generated descriptor with one edit applied, and building
// that twice is how the two ends quietly stop agreeing about what was tested.
//
// This is not a test file and is not discovered as one: `wac test` walks `*_test.wac`.
//
// It was a TypeScript wrapper in each of those files until 2026-08-17, doing exactly this and
// handing the result over an `fn[u8[](i32, u8[], u8[])]` seam. `issues/system/0161` step 4.

import { JsonValue, JsonObject, JsonArray } from "../../../json/src/value.wac";
import { decoded } from "../../../codec/src/hex.wac";
import { Cli } from "../../../platform/src/platform.wac";
import { arrayOf, boolOf, jsonFile, numOf, objectOf, strOf } from "./jsonfile.wac";

/**
 * The publish verdicts, the generated descriptor, and the controls — built here rather than handed in.
 *
 * **This wrapper did more than load.** Each control is the descriptor with one edit applied — a byte
 * replaced, a truncation, or nothing at all — and the wrapper computed those bytes before handing
 * them over. That construction is here now, in `controlBytes`, along with the four things it refused
 * to start without. `issues/system/0161` step 4.
 */
export JsonObject publishTop(Cli cli) { return jsonFile(cli, "packages/tor/test/data/hspublish.json"); }
export JsonObject generatedTop(Cli cli) { return jsonFile(cli, "packages/tor/test/data/hsdesc_generated.json"); }

export JsonArray controls(Cli cli) {
  JsonValue? cs = publishTop(cli).getStr("controls");
  if (cs is null) { trap; }
  match (cs!) {
    case Array(items): { return items; }
    else: { trap; }
  }
}

export string descriptorText(Cli cli) { return strOf(generatedTop(cli), "descriptor"); }
export u8[] descriptorBytes(Cli cli) { return descriptorText(cli).toBytes(); }
export u8[] blindedKeyBytes(Cli cli) { return decoded(strOf(publishTop(cli), "blindedKey")); }
export i32 controlCount(Cli cli) { return controls(cli).len(); }

/**
 * The exact bytes tor was handed for control `i`.
 *
 * `replace` swaps one byte, `truncate` cuts the descriptor short, `none` hands it over whole under
 * a wrong name. The edit is applied to the *text*, as it was on the host side, because the offsets
 * in the file are into that string.
 */
export u8[] controlBytes(Cli cli, i32 i) {
  JsonObject c = objectOf(controls(cli).get(i));
  JsonValue? e = c.getStr("edit");
  if (e is null) { trap; }
  JsonObject edit = objectOf(e!);
  string kind = strOf(edit, "kind");
  string d = descriptorText(cli);
  if (kind == "none") { return d.toBytes(); }
  if (kind == "truncate") { return d.slice(0, numOf(edit, "length")).toBytes(); }
  if (kind == "replace") {
    i32 at = numOf(edit, "offset");
    return (d.slice(0, at) + strOf(edit, "byte") + d.slice(at + 1, d.len())).toBytes();
  }
  trap;
}

/** The same service's descriptor one revision later — revision 43 to the other's 42. */
export string nextText(Cli cli) { return strOf(generatedTop(cli), "descriptorNext"); }
export u8[] nextBytes(Cli cli) { return nextText(cli).toBytes(); }

export JsonArray sequences(Cli cli) {
  JsonValue? ss = publishTop(cli).getStr("sequences");
  if (ss is null) { trap; }
  match (ss!) {
    case Array(items): { return items; }
    else: { trap; }
  }
}

export i32 sequenceCount(Cli cli) { return sequences(cli).len(); }

/** One position of sequence `si`: the document tor was handed, `current` or `next`. */
export u8[] sequenceDocument(Cli cli, i32 si, i32 pos) {
  JsonObject s = objectOf(sequences(cli).get(si));
  match (arrayOf(s, "order").get(pos)) {
    case Str(bytes): {
      if (string.fromBytes(bytes) == "next") { return nextBytes(cli); }
      return descriptorBytes(cli);
    }
    else: { trap; }
  }
}

/** One byte per position of sequence `si`, 1 where tor kept the upload. */
export u8[] sequenceStored(Cli cli, i32 si) {
  JsonObject s = objectOf(sequences(cli).get(si));
  JsonValue? r = s.getStr("result");
  if (r is null) { trap; }
  JsonArray each = arrayOf(objectOf(r!), "storedEach");
  u8[] out = u8[each.len()]();
  for (i32 i = 0; i < each.len(); i++) {
    match (each.get(i)) {
      case Bool(value): { out[i] = value ? 1 : 0; }
      else: { trap; }
    }
  }
  return out;
}
