// Directory routing, against the request targets a bootstrapping tor builds.
//
// The documents are the ones this repo generates and C tor has judged — the consensus from
// `data/consensus_generated.json`, the certificate from `data/authcert_generated.json`, the
// descriptor from `data/routerdesc_generated.json` — so a route test is not only about paths: what
// it hands back is a document tor accepted.
//
// Host-side until 2026-08-17, `issues/system/0161`. The documents are read here now; only the
// descriptor digest still comes from `test/oracle.mjs`, and that is deliberate. It is a SHA-1 over
// the span the descriptor's signature covers, and asking wac where its own signature ended would
// make the comparison agree with itself.

import { T } from "../../../wactest/src/assert.wac";
import { DirDocuments, dirRoute, dirResponse, stripDotZ } from "../../src/dirserve.wac";
import { encodeUpper, decoded } from "../../../codec/src/hex.wac";
import { b64Unpadded } from "../../src/routerdesc.wac";
import { Lines, Answers, ask, word } from "../../../wactest/src/oracle.wac";
import { Core, Cli, FileResult } from "../../../platform/src/platform.wac";
import { memberText } from "../../../wactest/src/fixtures.wac";
import { JsonValue } from "../../../json/src/value.wac";
import { parse } from "../../../json/src/json.wac";

const string ORACLE = "packages/tor/test/oracle.mjs";

/** A named field of one of the generated-document JSON files, or `""` if anything went wrong. */
string field(T t, Cli cli, string file, string key) {
  FileResult f = cli.readFile("packages/tor/test/data/" + file).wait();
  t.isTrue(f.ok, file + " could not be read: " + f.error);
  if (!f.ok) { return ""; }
  JsonValue? doc = parse(f.bytes);
  t.isTrue(!(doc is null), file + " did not parse");
  if (doc is null) { return ""; }
  return memberText(doc!, key);
}

DirDocuments docsFrom(T t, Cli cli) {
  Lines lines = Lines.create();
  lines.add("descdigest");
  Answers a = ask(t, cli, "node", string[](ORACLE), lines, "the descriptor digest");
  u8[] digest = a.ok ? decoded(word(a.lines[0], 1)) : u8[0]();
  DirDocuments docs = DirDocuments(
    field(t, cli, "consensus_generated.json", "consensus").toBytes(), u8[0](),
    field(t, cli, "authcert_generated.json", "certificate").toBytes(),
    field(t, cli, "routerdesc_generated.json", "descriptor").toBytes(),
    oneDigest(digest),
    decoded(field(t, cli, "consensus_generated.json", "identityDigest")),
    u8[0](), u8[][0](), u8[][0](), u8[][0]());

  // Every routing assertion below compares a response body against one of these, and two empty
  // arrays agree — so a mistyped key would turn the whole file green rather than red.
  t.isTrue(docs.consensus.len() > 1000, "the consensus was loaded");
  t.isTrue(docs.certificate.len() > 500, "the authority certificate was loaded");
  t.isTrue(docs.descriptors.len() > 500, "the descriptor was loaded");
  t.eqI32(docs.fingerprint.len(), 20, "the identity digest is 20 bytes");
  t.eqI32(digest.len(), 20, "and so is the descriptor digest");
  return docs;
}

string hexOf(u8[] b) { return string.fromBytes(encodeUpper(b)); }

u8[][] oneDigest(u8[] d) {
  u8[][] out = u8[][1]();
  out[0] = d;
  return out;
}

export string test_the_targets_a_bootstrapping_tor_builds(Core core, Cli cli) {
  T t = T.create();
  DirDocuments docs = docsFrom(t, cli);
  string fp = hexOf(docs.fingerprint);

  // The real shape: flavourless consensus, the trusted authorities' fingerprints, and `.z`.
  t.eqI32(dirRoute(("/tor/status-vote/current/consensus/" + fp + ".z").toBytes(), docs).status, 200,
          "the consensus target with a fingerprint list and .z is served");
  t.eqBytes(dirRoute(("/tor/status-vote/current/consensus/" + fp + ".z").toBytes(), docs).body,
            docs.consensus, "and the body is the consensus");

  // Without either decoration, which is what a hand-written request looks like.
  t.eqI32(dirRoute("/tor/status-vote/current/consensus".toBytes(), docs).status, 200,
          "the bare consensus target is served too");

  // Mixed case, and a list of several authorities with ours among them.
  t.eqI32(dirRoute(("/tor/keys/fp/" + lower(fp)).toBytes(), docs).status, 200,
          "a lowercase fingerprint still names us");
  t.eqI32(dirRoute(("/tor/keys/fp/0000000000000000000000000000000000000000").toBytes(), docs).status,
          404, "another authority's fingerprint is not ours to answer");
  t.eqI32(dirRoute(("/tor/keys/fp/0000000000000000000000000000000000000000+" + fp).toBytes(),
                   docs).status, 200, "and a list containing ours is answered");

  t.eqI32(dirRoute("/tor/keys/all".toBytes(), docs).status, 200, "keys/all is the certificate");
  t.eqBytes(dirRoute("/tor/keys/authority".toBytes(), docs).body, docs.certificate,
            "keys/authority is the same certificate");

  // The descriptor, by the digest an r line carries.
  string dd = hexOf(docs.descriptorDigests[0]);
  t.eqI32(dirRoute(("/tor/server/d/" + dd + ".z").toBytes(), docs).status, 200,
          "the descriptor is served by its r-line digest");
  t.eqI32(dirRoute("/tor/server/d/0000000000000000000000000000000000000000".toBytes(), docs).status,
          404, "an unknown descriptor digest is a 404");
  t.eqI32(dirRoute("/tor/server/authority".toBytes(), docs).status, 200,
          "server/authority is our own descriptor");

  // A microdesc consensus we do not produce is a 404 and not the ns one under a wrong name, which
  // would be worse than useless: a client would verify it and then fail to find microdescriptors.
  t.eqI32(dirRoute("/tor/status-vote/current/consensus-microdesc".toBytes(), docs).status, 404,
          "a flavour we do not have is refused, not substituted");

  t.eqI32(dirRoute("/tor/robots.txt".toBytes(), docs).status, 404, "anything else is a 404");
  t.eqI32(dirRoute("/".toBytes(), docs).status, 404, "including the root");
  return t.report();
}

/**
 * Microdescriptors, whose path is batched with a hyphen rather than a `+`.
 *
 * The separator is the point. A microdescriptor digest is base64, in which `+` is a data character —
 * so splitting the list on `+` cuts digests in half, and a cache that did so would answer 404 for
 * every batch containing one. That is a failure a client reports only as having no usable relays.
 */
export string test_microdescriptors_are_batched_with_a_hyphen(Core core, Cli cli) {
  T t = T.create();

  // Two digests, one of them deliberately containing a `+` — which real ones do, roughly half the
  // time, and which a fixture chosen from a small sample can easily fail to include.
  u8[] withPlus = u8[32]();
  for (i32 i = 0; i < 32; i++) { withPlus[i] = (i * 7 + 251) & 0xFF; }
  u8[] other = u8[32]();
  for (i32 i = 0; i < 32; i++) { other[i] = (i * 13 + 5) & 0xFF; }
  string a = b64Unpadded(withPlus);
  string b = b64Unpadded(other);
  t.isTrue(hasPlus(a), "the fixture digest really does contain a + character");

  u8[] body = "onion-key\nfake\n".toBytes();
  u8[][] two = u8[][2]();
  two[0] = withPlus;
  two[1] = other;
  DirDocuments docs = DirDocuments(u8[0](), u8[0](), u8[0](), u8[0](), u8[][0](), u8[0](), body, two,
                                   u8[][0](), u8[][0]());

  t.eqI32(dirRoute(("/tor/micro/d/" + a).toBytes(), docs).status, 200,
          "a single digest containing a + is served");
  t.eqI32(dirRoute(("/tor/micro/d/" + a + "-" + b).toBytes(), docs).status, 200,
          "and a hyphen-separated batch of two");
  t.eqI32(dirRoute(("/tor/micro/d/" + b + "-" + a + ".z").toBytes(), docs).status, 200,
          "with the compression suffix, in either order");
  t.eqBytes(dirRoute(("/tor/micro/d/" + a).toBytes(), docs).body, body,
            "the body is the microdescriptors");

  // The failure this route is shaped to avoid: were the list split on `+`, the digest containing one
  // would be cut into two fragments and match nothing.
  t.eqI32(dirRoute(("/tor/micro/d/" + a + "+" + b).toBytes(), docs).status, 404,
          "a + is not a separator here, so the whole string names no digest we hold");

  t.eqI32(dirRoute("/tor/micro/d/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA".toBytes(),
                   docs).status, 404, "an unknown digest is a 404");

  // Case matters here and does not on the hex path, which is the kind of difference that gets copied
  // away by accident. `a` and `A` are different base64 digits, so folding case would make a request
  // for one digest match a different one — served confidently, and wrong.
  t.eqI32(dirRoute(("/tor/micro/d/" + swapCase(a)).toBytes(), docs).status, 404,
          "the same digest with its case swapped is a different digest");

  // And with nothing to serve, the route is a 404 rather than an empty 200 — a client reading an
  // empty body as a valid response would discard the relays it just verified.
  DirDocuments bare = DirDocuments(u8[0](), u8[0](), u8[0](), u8[0](), u8[][0](), u8[0](),
                                   u8[0](), u8[][0](), u8[][0](), u8[][0]());
  t.eqI32(dirRoute(("/tor/micro/d/" + a).toBytes(), bare).status, 404,
          "a cache holding no microdescriptors says so");
  return t.report();
}

string swapCase(string s) {
  u8[] b = s.toBytes();
  u8[] out = u8[b.len()]();
  for (i32 i = 0; i < b.len(); i++) {
    i32 c = b[i];
    if (c >= 65 && c <= 90) { c = c + 32; } else if (c >= 97 && c <= 122) { c = c - 32; }
    out[i] = c;
  }
  return string.fromBytes(out);
}

bool hasPlus(string s) {
  u8[] b = s.toBytes();
  for (i32 i = 0; i < b.len(); i++) { if (b[i] == 43) { return true; } }
  return false;
}

export string test_the_compression_suffix_is_a_request_not_a_name(Core core, Cli cli) {
  T t = T.create();
  DirDocuments docs = docsFrom(t, cli);

  // `.z` asks for zlib. Strip it before matching or every real request 404s — which is the whole
  // failure mode: a server that works when tested by hand and never when tested by tor.
  t.eqBytes(stripDotZ("/tor/keys/all.z".toBytes()), "/tor/keys/all".toBytes(),
            "the suffix comes off");
  t.eqBytes(stripDotZ("/tor/keys/all".toBytes()), "/tor/keys/all".toBytes(),
            "and an absent one changes nothing");
  t.eqBytes(stripDotZ("z".toBytes()), "z".toBytes(), "a bare z is not a suffix");
  t.eqBytes(stripDotZ(".z".toBytes()), u8[0](), "the suffix alone leaves nothing");

  // Only the trailing one: a path with `.z` inside it keeps it.
  t.eqBytes(stripDotZ("/tor/keys/fp/A.zB".toBytes()), "/tor/keys/fp/A.zB".toBytes(),
            "a .z that is not the suffix stays");
  return t.report();
}

export string test_the_response_is_framed_for_a_client(Core core, Cli cli) {
  T t = T.create();
  DirDocuments docs = docsFrom(t, cli);
  u8[] res = dirResponse("/tor/keys/all.z".toBytes(), docs);

  t.isTrue(startsWith(res, "HTTP/1.1 200"), "a status line a client can read");
  t.isTrue(contains(res, "Content-Type: text/plain"), "the content type tor's own cache sends");
  t.isTrue(contains(res, "Content-Length: "), "a length, so the body's end is not the socket's");
  t.isTrue(contains(res, "dir-key-certificate-version 3"), "the certificate is in the body");

  // A 404 is framed too, rather than a bare close that a client reads as a network fault.
  u8[] missing = dirResponse("/nope".toBytes(), docs);
  t.isTrue(startsWith(missing, "HTTP/1.1 404"), "a 404 is a reply, not a hangup");
  return t.report();
}

string lower(string s) {
  u8[] b = s.toBytes();
  u8[] out = u8[b.len()]();
  for (i32 i = 0; i < b.len(); i++) {
    i32 c = b[i];
    out[i] = (c >= 65 && c <= 90) ? c + 32 : c;
  }
  return string.fromBytes(out);
}

bool startsWith(u8[] s, string prefix) {
  u8[] p = prefix.toBytes();
  if (s.len() < p.len()) { return false; }
  for (i32 i = 0; i < p.len(); i++) { if (s[i] != p[i]) { return false; } }
  return true;
}

bool contains(u8[] s, string text) {
  u8[] t = text.toBytes();
  for (i32 i = 0; i + t.len() <= s.len(); i++) {
    bool hit = true;
    for (i32 j = 0; j < t.len(); j++) { if (s[i + j] != t[j]) { hit = false; break; } }
    if (hit) { return true; }
  }
  return false;
}
