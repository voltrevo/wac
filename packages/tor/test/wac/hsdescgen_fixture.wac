// `hsdesc_generated.json` — the descriptor `src/genhsdesc.wac` built and tor's own decoder accepted.
//
// Every field here is an input to, or an output of, one generation run: the keys, the blinding
// chain, the three layers, and the lengths tor reported at each stage. `hsdescgen_test.wac` rebuilds
// the document from them and requires the same bytes.
//
// **The decoy clients are built rather than read.** They are not in the file: the generator writes
// sixteen forty-byte entries from a fixed arithmetic progression, and reproducing the middle layer
// means reproducing them exactly. The TypeScript wrapper this replaces held that progression as a
// second copy of the same rule, so the two could have drifted and the only symptom would have been
// a layer that no longer matched. `issues/system/0161` step 4.
//
// Not a test file and not discovered as one: `wac test` walks `*_test.wac`.

import { JsonObject } from "../../../json/src/value.wac";
import { decoded } from "../../../codec/src/hex.wac";
import { Files } from "std";
import { jsonFile, numOf, strOf } from "../../../wactest/src/jsonfile.wac";

JsonObject top(Files fs) { return jsonFile(fs, "packages/tor/test/data/hsdesc_generated.json"); }

/** A hex field, decoded. */
u8[] hexField(Files fs, string key) { return decoded(strOf(top(fs), key)); }

/** The document tor decoded, byte for byte. */
export u8[] descriptor(Files fs) { return strOf(top(fs), "descriptor").toBytes(); }

export u8[] cert(Files fs) { return hexField(fs, "cert"); }
export u8[] superencrypted(Files fs) { return hexField(fs, "superencrypted"); }
export u8[] signSeed(Files fs) { return hexField(fs, "signSeed"); }
export u8[] signPublic(Files fs) { return hexField(fs, "signPublic"); }
export u8[] identitySeed(Files fs) { return hexField(fs, "identitySeed"); }
export u8[] identityPublic(Files fs) { return hexField(fs, "identityPublic"); }
export u8[] factor(Files fs) { return hexField(fs, "factor"); }
export u8[] blindExpanded(Files fs) { return hexField(fs, "blindExpanded"); }
export u8[] blindPublic(Files fs) { return hexField(fs, "blindPublic"); }
export u8[] subcred(Files fs) { return hexField(fs, "subcredential"); }
export u8[] ephemeral(Files fs) { return hexField(fs, "ephemeral"); }
export u8[] salt(Files fs) { return hexField(fs, "salt"); }
export u8[] inner(Files fs) { return hexField(fs, "inner"); }
export u8[] innerSalt(Files fs) { return hexField(fs, "innerSalt"); }
export u8[] linkSpecs(Files fs) { return hexField(fs, "linkSpecifiers"); }
export u8[] ipNtor(Files fs) { return hexField(fs, "ipNtor"); }
export u8[] ipEnc(Files fs) { return hexField(fs, "ipEnc"); }
export u8[] authCert(Files fs) { return hexField(fs, "authCert"); }
export u8[] encCert(Files fs) { return hexField(fs, "encCert"); }

export i32 lifetimeMinutes(Files fs) { return numOf(top(fs), "lifetimeMinutes"); }
export i32 revision(Files fs) { return numOf(top(fs), "revision"); }
/** How much of the document tor's signature covers — the length it recorded when it accepted it. */
export i32 signedSpanLen(Files fs) { return numOf(top(fs), "signedSpanLen"); }
/** The padded length of the middle layer's plaintext, as tor decrypted it. */
export i32 middleLen(Files fs) { return numOf(top(fs), "middleLen"); }
export i32 innerPlainLen(Files fs) { return numOf(top(fs), "innerPlainLen"); }
export i32 periodNum(Files fs) { return numOf(top(fs), "periodNum"); }
export i32 periodLength(Files fs) { return numOf(top(fs), "periodLength"); }

export static i32 DECOY_CLIENTS = 16;

/** The `i`-th decoy client the generator writes: forty bytes of `(i * 97 + j * 11 + 3) & 0xff`. */
export u8[] decoyClient(i32 i) {
  u8[] c = u8[].filled(40, 0);
  for (i32 j = 0; j < 40; j++) { c[j] = ((i * 97 + j * 11 + 3) & 255) as@ u8; }
  return c;
}
