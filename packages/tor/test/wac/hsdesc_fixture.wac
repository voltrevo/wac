// `hsdesc_vectors.json` — one onion service descriptor tor produced, and everything it decrypts to.
//
// It was a TypeScript wrapper until 2026-08-17, and that wrapper packed the fields into flat byte
// arrays — the four keys and a revision counter concatenated into 136 bytes, a layer's salt, keys,
// IV, MAC key, digest and length into 136 more — because it handed them over one
// `fn<[i32, u8[], u8[]]>` seam. The seam is gone, so the packing is too. `issues/system/0161`.
//
// Not a test file and not discovered as one: `wac test` walks `*_test.wac`.

import { JsonObject, JsonArray } from "../../../json/src/value.wac";
import { decoded } from "../../../codec/src/hex.wac";
import { decode as base64Decode } from "../../../codec/src/base64.wac";
import { Files } from "std";
import { arrayOf, jsonFile, num64Of, numOf, strOf } from "../../../wactest/src/jsonfile.wac";

JsonObject top(Files fs) { return jsonFile(fs, "packages/tor/test/data/hsdesc_vectors.json"); }

/**
 * The descriptor as bytes.
 *
 * The wrapper read this as **latin-1** rather than UTF-8, and said why: the descriptor is base64 and
 * keywords so the two agree, but the decrypted plaintexts are compared by a hash over raw bytes, and
 * one multi-byte encoding here would shift every offset in a way that is tedious to find later.
 *
 * A wac `string` holds UTF-8, so the agreement is now load-bearing rather than incidental —
 * `test_the_vector_is_the_shape_the_tests_assume` asserts the descriptor is pure ASCII, which is
 * exactly the condition under which the two encodings are the same bytes.
 */
export u8[] descriptor(Files fs) { return strOf(top(fs), "descriptor").toBytes(); }

export u8[] identityKey(Files fs) { return decoded(strOf(top(fs), "identityKey")); }
export u8[] blindedKey(Files fs) { return decoded(strOf(top(fs), "blindedKey")); }
export u8[] signingKey(Files fs) { return decoded(strOf(top(fs), "descriptorSigningKey")); }
export u8[] subcredential(Files fs) { return decoded(strOf(top(fs), "subcredential")); }
export i64 revisionCounter(Files fs) { return num64Of(top(fs), "revisionCounter"); }

// ── the two encrypted layers ─────────────────────────────────────────────────

JsonArray layers(Files fs) { return arrayOf(top(fs), "layers"); }
JsonObject layerAt(Files fs, i32 i) { return layers(fs).get(i).object()!; }

export i32 layerCount(Files fs) { return layers(fs).len(); }
export u8[] layerSalt(Files fs, i32 i) { return decoded(strOf(layerAt(fs, i), "salt")); }
export u8[] layerSecretKey(Files fs, i32 i) { return decoded(strOf(layerAt(fs, i), "secretKey")); }
export u8[] layerSecretIv(Files fs, i32 i) { return decoded(strOf(layerAt(fs, i), "secretIv")); }
export u8[] layerMacKey(Files fs, i32 i) { return decoded(strOf(layerAt(fs, i), "macKey")); }
/** The SHA3-256 of the layer's plaintext — the value that says the decryption was right. */
export u8[] layerPlaintextSha3(Files fs, i32 i) {
  return decoded(strOf(layerAt(fs, i), "plaintextSha3"));
}
export i32 layerPlaintextLength(Files fs, i32 i) { return numOf(layerAt(fs, i), "plaintextLength"); }

// ── the introduction points ──────────────────────────────────────────────────

JsonArray intros(Files fs) { return arrayOf(top(fs), "introductionPoints"); }
JsonObject introAt(Files fs, i32 i) { return intros(fs).get(i).object()!; }

/**
 * Base64, as tor writes it in a descriptor.
 *
 * **No padding tolerance**, deliberately. The first version added `=` until the length was a
 * multiple of four, and a canary showed the loop never ran: every value in this fixture is already
 * padded. An untested branch that quietly accepts a shape the fixture does not have is worth less
 * than a decode that refuses and says so, since the only way to reach it would be a regenerated
 * vector — which is exactly when you want to be told.
 */
u8[] b64(string text) {
  u8[]? bytes = base64Decode(text.toBytes());
  if (bytes is null) { trap; }
  return bytes!;
}

export i32 introCount(Files fs) { return intros(fs).len(); }
export u8[] introLinkSpecifiers(Files fs, i32 i) {
  return b64(strOf(introAt(fs, i), "linkSpecifiers"));
}
export u8[] introOnionKey(Files fs, i32 i) { return b64(strOf(introAt(fs, i), "onionKeyNtor")); }
export u8[] introEncKey(Files fs, i32 i) { return b64(strOf(introAt(fs, i), "encKeyNtor")); }
export u8[] introAuthKey(Files fs, i32 i) { return decoded(strOf(introAt(fs, i), "authKey")); }
