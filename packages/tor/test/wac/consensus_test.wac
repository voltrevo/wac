// Consensus verification.
//
// The oracle for the signatures is node's RSA, reached through a callback: the host makes a
// keypair and signs a bare digest under PKCS#1 v1.5 padding, which is the unusual shape Tor
// uses — no DER DigestInfo, just the hash. `crypto.privateEncrypt` produces exactly that,
// so this is a differential against an implementation that has never seen our code.
//
// It matters that it is a real oracle here more than almost anywhere else in the repo. A
// signature check that always returns true passes every positive test ever written; the
// tests below therefore spend most of their assertions on what must be *refused*.

import { T } from "../../../wactest/src/assert.wac";
import { Lines, Answers, ask, hex, word } from "../../../wactest/src/oracle.wac";
import { Core, Cli } from "std/platform.wac";
import { decoded } from "../../../codec/src/hex.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";
import {
  signedLength, signedDigest, keyFingerprint, rsaModulus, rsaExponent, signatureMatches,
  parseCertificates, verifyConsensus, parseUtc, AuthorityCert, Verdict,
} from "../../src/consensus.wac";
import { sha1 } from "../../../crypto/src/sha1.wac";
import { sha256 } from "../../../crypto/src/sha256.wac";

u8[] cat(u8[] a, u8[] b) {
  u8[] o = u8[a.len() + b.len()]();
  for (i32 i = 0; i < a.len(); i++) { o[i] = a[i]; }
  for (i32 i = 0; i < b.len(); i++) { o[a.len() + i] = b[i]; }
  return o;
}

u8[] copyOf(u8[] s) {
  u8[] o = u8[s.len()]();
  for (i32 i = 0; i < s.len(); i++) { o[i] = s[i]; }
  return o;
}

const string ORACLE = "packages/tor/test/oracle.mjs";

/**
 * Everything the host makes for these tests, in one round trip.
 *
 * The oracle is stateful in line order — `consfixtures` picks the keys every later `conssign` in
 * the same batch signs with — so the digests a test wants signed have to be known before the batch
 * goes out. That is why they arrive as an argument rather than being asked for one at a time: a
 * second batch would pick different keys, and the signatures would verify under nobody.
 */
struct Fixtures {
  bool ok;
  u8[] keyDer;
  u8[] keyN;
  u8[] keyE;
  u8[] otherDer;
  u8[] otherN;
  u8[] otherE;
  u8[][] docs;
  u8[][] names;
  u8[][] signatures;
}

Fixtures fixtures(T t, Cli cli, u8[][] digests) {
  Fixtures none = Fixtures(false, u8[0](), u8[0](), u8[0](), u8[0](), u8[0](), u8[0](),
                           u8[][0](), u8[][0](), u8[][0]());
  Lines lines = Lines.create();
  lines.add("consfixtures");
  for (i32 i = 0; i < digests.len(); i++) { lines.add("conssign " + hex(digests[i])); }
  Answers a = ask(t, cli, "node", string[](ORACLE), lines, "the consensus fixtures");
  if (!a.ok) { return none; }
  // `consfixtures` answers ten lines: two keys, six documents and two fingerprint sets.
  t.eqI32(a.lines.len(), 10 + digests.len(), "the host answered every line");
  if (a.lines.len() != 10 + digests.len()) { return none; }

  u8[][] docs = u8[][6]();
  for (i32 i = 0; i < 6; i++) { docs[i] = decoded(word(a.lines[2 + i], 2)); }
  u8[][] names = u8[][2]();
  for (i32 i = 0; i < 2; i++) { names[i] = decoded(word(a.lines[8 + i], 2)); }
  u8[][] sigs = u8[][digests.len()]();
  for (i32 i = 0; i < digests.len(); i++) { sigs[i] = decoded(word(a.lines[10 + i], 1)); }

  return Fixtures(true,
                  decoded(word(a.lines[0], 1)), decoded(word(a.lines[0], 2)),
                  decoded(word(a.lines[0], 3)),
                  decoded(word(a.lines[1], 1)), decoded(word(a.lines[1], 2)),
                  decoded(word(a.lines[1], 3)),
                  docs, names, sigs);
}

/** No signatures wanted — the documents and keys alone. */
Fixtures documents(T t, Cli cli) { return fixtures(t, cli, u8[][0]()); }

export string test_the_signed_portion_ends_at_the_token() {
  // The boundary is "up to and including the string directory-signature ", trailing space
  // and all. One byte either side and every signature on every consensus fails.
  T t = T.create();
  u8[] doc = "network-status-version 3\nvalid-after x\ndirectory-signature sha256 AAAA\nsig\n".toBytes();
  i32 n = signedLength(doc);
  t.eqI32(n, 59, "the offset just past the token");
  // Spelled out: the last byte of the signed portion is the space, and the next is 's'.
  t.eqI32(doc[n - 1], ' ', "the signed portion ends with the token's trailing space");
  t.eqI32(doc[n - 21], '\n', "and begins its match at the preceding newline");

  t.eqI32(signedLength("no signatures here at all\n".toBytes()), -1,
          "a document with no signature block");

  // The leading newline is required, so the token appearing mid-line is not a boundary.
  u8[] tricky = "network-status-version 3\nr xdirectory-signature notreally\ndirectory-signature sha256 A\n".toBytes();
  i32 m = signedLength(tricky);
  t.eqI32(tricky[m - 1], ' ', "matched a real line start, not the text inside one");
  t.isTrue(m > 60, "and it is the second occurrence, not the embedded first");
  return t.report();
}

export string test_the_digest_covers_the_signed_portion_only() {
  T t = T.create();
  u8[] head = "network-status-version 3\nbody\ndirectory-signature ".toBytes();
  u8[] docA = cat(head, "sha256 AAAA\n-----BEGIN SIGNATURE-----\nxx\n".toBytes());
  u8[] docB = cat(head, "sha256 BBBB\n-----BEGIN SIGNATURE-----\nyy\n".toBytes());
  // Different signature blocks, identical signed portion: the digests must agree, or a
  // consensus could not carry more than one signature.
  t.eqBytes(signedDigest(docA, false), signedDigest(docB, false),
            "what follows the token does not change the digest");
  t.eqBytes(signedDigest(docA, false), sha1(head), "and it is the sha1 of exactly the head");
  t.eqBytes(signedDigest(docA, true), sha256(head), "sha256 when the flavour says so");

  // But a change inside the signed portion must change it.
  u8[] altered = cat("network-status-version 3\nBODY\ndirectory-signature ".toBytes(),
                     "sha256 AAAA\n".toBytes());
  u8[] d1 = signedDigest(docA, false);
  u8[] d2 = signedDigest(altered, false);
  bool equal = true;
  for (i32 i = 0; i < 20; i++) {
    if (d1[i] != d2[i]) { equal = false; }
  }
  t.isTrue(!equal, "a change in the body changes the digest");
  return t.report();
}

export string test_a_public_key_is_read_out_of_its_der(Core core, Cli cli) {
  // The host hands over a DER RSAPublicKey and, separately, its modulus and exponent taken apart
  // with node's own parser — so agreement is not this code checking itself.
  T t = T.create();
  Fixtures f = documents(t, cli);
  if (!f.ok) { return t.report(); }
  u8[] der = f.keyDer;
  t.eqBytes(rsaModulus(der), f.keyN, "the modulus");
  t.eqBytes(rsaExponent(der), f.keyE, "the exponent");
  t.eqI32(rsaModulus(der).len(), 256, "a 2048-bit modulus, with DER's sign byte dropped");
  return t.report();
}

export string test_a_genuine_signature_verifies(Core core, Cli cli) {
  // Each signature is node's `privateEncrypt` with PKCS#1 v1.5 padding over the bare bytes —
  // Tor's shape exactly, with no DigestInfo.
  T t = T.create();
  u8[][] digests = u8[][7]();
  for (i32 i = 0; i < 6; i++) {
    u8[] msg = u8[40 + i]();
    for (i32 j = 0; j < msg.len(); j++) { msg[j] = (j * 17 + i) & 0xFF; }
    digests[i] = sha1(msg);
  }
  // And a sha256 digest, since the consensus uses those.
  digests[6] = sha256("network-status-version 3\n".toBytes());

  Fixtures f = fixtures(t, cli, digests);
  if (!f.ok) { return t.report(); }
  u8[] n = rsaModulus(f.keyDer);
  u8[] e = rsaExponent(f.keyDer);
  for (i32 i = 0; i < 6; i++) {
    t.isTrue(signatureMatches(n, e, digests[i], f.signatures[i]),
             "signature " + itoa64(i as i64) + " verifies");
  }
  t.isTrue(signatureMatches(n, e, digests[6], f.signatures[6]), "a sha256 digest verifies too");
  return t.report();
}

export string test_everything_that_must_be_refused(Core core, Cli cli) {
  // The half that matters. A verifier that returns true unconditionally passes every test
  // above this one.
  T t = T.create();
  u8[] digest = sha1("the message that was signed".toBytes());
  Fixtures f = fixtures(t, cli, u8[][](digest));
  if (!f.ok) { return t.report(); }
  u8[] n = rsaModulus(f.keyDer);
  u8[] e = rsaExponent(f.keyDer);
  u8[] sig = f.signatures[0];
  t.isTrue(signatureMatches(n, e, digest, sig), "the control verifies");

  // A different digest under the same signature.
  u8[] other = sha1("a message that was not signed".toBytes());
  t.isTrue(!signatureMatches(n, e, other, sig), "a different digest is refused");

  // Every single-bit change to the digest.
  for (i32 i = 0; i < 20; i++) {
    u8[] d = copyOf(digest);
    d[i] = d[i] ^ 1;
    t.isTrue(!signatureMatches(n, e, d, sig),
             "digest byte " + itoa64(i as i64) + " flipped is refused");
  }
  // Every single-byte change to the signature.
  for (i32 i = 0; i < 256; i += 17) {
    u8[] s = copyOf(sig);
    s[i] = s[i] ^ 0x80;
    t.isTrue(!signatureMatches(n, e, digest, s),
             "signature byte " + itoa64(i as i64) + " flipped is refused");
  }

  // A truncated or over-long signature, which must not be padded or cut to fit.
  u8[] short_ = u8[255]();
  for (i32 i = 0; i < 255; i++) { short_[i] = sig[i]; }
  t.isTrue(!signatureMatches(n, e, digest, short_), "a short signature is refused");
  u8[] long_ = cat(sig, u8[1]());
  t.isTrue(!signatureMatches(n, e, digest, long_), "an over-long signature is refused");

  // A prefix of the digest must not satisfy it: the comparison is on the whole payload.
  u8[] prefix = u8[10]();
  for (i32 i = 0; i < 10; i++) { prefix[i] = digest[i]; }
  t.isTrue(!signatureMatches(n, e, prefix, sig), "a prefix of the digest is refused");

  // An all-zero signature, which is the value an attacker reaches for first.
  t.isTrue(!signatureMatches(n, e, digest, u8[256]()), "an all-zero signature is refused");
  return t.report();
}

export string test_a_signature_from_the_wrong_key_is_refused(Core core, Cli cli) {
  // The check that makes the whole chain mean anything: a signature is only evidence about
  // the key it was made with. A verifier that ignored the key would accept this.
  T t = T.create();
  u8[] digest = sha1("a consensus".toBytes());
  Fixtures f = fixtures(t, cli, u8[][](digest));
  if (!f.ok) { return t.report(); }
  u8[] sig = f.signatures[0];
  t.isTrue(signatureMatches(rsaModulus(f.keyDer), rsaExponent(f.keyDer), digest, sig),
           "the control verifies under its own key");
  t.isTrue(!signatureMatches(rsaModulus(f.otherDer), rsaExponent(f.otherDer), digest, sig),
           "and is refused under a different key of the same size");
  return t.report();
}

export string test_a_fingerprint_is_the_sha1_of_the_key(Core core, Cli cli) {
  // The value a client hardcodes. It is the SHA-1 of the DER, not of the PEM and not of the
  // modulus alone — hashing the wrong thing gives an authority set that matches nobody.
  T t = T.create();
  Fixtures f = documents(t, cli);
  if (!f.ok) { return t.report(); }
  u8[] der = f.keyDer;
  t.eqBytes(keyFingerprint(der), sha1(der), "the fingerprint is sha1 over the whole DER");
  t.eqI32(keyFingerprint(der).len(), 20, "twenty bytes");
  return t.report();
}

// ── The chain, ported from TypeScript ────────────────────────────────────────

export string test_the_chain_accepts_a_genuine_consensus(Core core, Cli cli) {
  // f.docs[0] consensus, f.docs[1] certs; lines(f.names[0]) the trusted fingerprints. The documents are
  // built by the registrar with real RSA keys, so this is the whole chain: identity key
  // hashes to a trusted fingerprint, certifies a signing key, signing key signs the
  // consensus, majority, freshness.
  T t = T.create();
  Fixtures f = documents(t, cli);
  if (!f.ok) { return t.report(); }
  AuthorityCert[] certs = parseCertificates(f.docs[1], lines(f.names[0]));
  t.eqI32(certs.len(), 3, "three certificates check out");
  Verdict v = verifyConsensus(f.docs[0], certs, lines(f.names[0]), 1785715200);
  t.isTrue(v.ok, "and the consensus is accepted");
  t.eqI32(v.goodSignatures, 3, "three good signatures");
  t.eqI32(v.needed, 2, "of the two needed from three authorities");
  t.eqStr(v.stale, "", "and it is current");
  return t.report();
}

export string test_everything_the_chain_must_refuse(Core core, Cli cli) {
  // A verifier that accepts everything also accepts a genuine consensus, so this is where
  // the value is. Each case is a thing an attacker would actually try.
  T t = T.create();
  Fixtures f = documents(t, cli);
  if (!f.ok) { return t.report(); }
  string[] trusted = lines(f.names[0]);
  AuthorityCert[] certs = parseCertificates(f.docs[1], trusted);

  t.isTrue(!verifyConsensus(f.docs[2], certs, trusted, 1785715200).ok,
           "a consensus with one relay's flags changed");
  t.isTrue(!verifyConsensus(f.docs[3], certs, trusted, 1785715200).ok,
           "a consensus with a microdescriptor digest swapped");
  t.isTrue(!verifyConsensus(f.docs[0], certs, string[0](), 1785715200).ok,
           "an empty trust set, where a majority of nobody is not a test");
  t.eqI32(parseCertificates(f.docs[1], lines(f.names[1])).len(), 0,
          "certificates from authorities we do not name");
  t.isTrue(!verifyConsensus(f.docs[0], AuthorityCert[0](), trusted, 1785715200).ok,
           "no certificates, so no signature can be attributed");

  // Freshness: correctly signed and outside its window is still refused, and says so
  // differently from a forgery.
  Verdict old = verifyConsensus(f.docs[0], certs, trusted, 1); 
  t.isTrue(!old.ok, "a consensus from before it was valid");
  t.eqStr(old.stale, "not valid yet", "reported as staleness, not as a bad signature");
  t.eqI32(old.goodSignatures, 3, "with its signatures still good");
  Verdict future = verifyConsensus(f.docs[0], certs, trusted, 4000000000);
  t.eqStr(future.stale, "expired", "and an expired one says expired");
  return t.report();
}

export string test_a_signing_key_its_identity_never_certified(Core core, Cli cli) {
  // The check it is tempting to skip. f.docs[4] is the certificate file with one authority's
  // signing key replaced by another's — the consensus signature would still verify against
  // it, so only the certification check catches this.
  T t = T.create();
  Fixtures f = documents(t, cli);
  if (!f.ok) { return t.report(); }
  AuthorityCert[] swapped = parseCertificates(f.docs[4], lines(f.names[0]));
  t.eqI32(swapped.len(), 2, "the tampered certificate is dropped, the others stand");
  Verdict v = verifyConsensus(f.docs[0], swapped, lines(f.names[0]), 1785715200);
  t.eqI32(v.goodSignatures, 2, "so that authority's signature cannot be attributed");
  return t.report();
}

export string test_a_signature_names_which_signing_key_made_it(Core core, Cli cli) {
  // f.docs[5] holds two certificates for one authority — its rotated signing key last. The
  // consensus names the first key's digest. A chain that matched on the identity alone
  // would land on the rotated certificate and lose a good signature, so this is what makes
  // the digest half of the match load-bearing rather than decoration.
  T t = T.create();
  Fixtures f = documents(t, cli);
  if (!f.ok) { return t.report(); }
  string[] trusted = lines(f.names[0]);
  AuthorityCert[] certs = parseCertificates(f.docs[5], trusted);
  t.eqI32(certs.len(), 4, "four certificates, two of them the same authority");
  Verdict v = verifyConsensus(f.docs[0], certs, trusted, 1785715200);
  t.eqI32(v.goodSignatures, 3, "all three signatures still attributed");
  t.isTrue(v.ok, "and the consensus is accepted");
  return t.report();
}

export string test_a_utc_timestamp_is_not_read_as_local() {
  // Directory timestamps carry no zone. Reading them as local time shifts every validity
  // window by the host's offset, silently and differently per machine.
  T t = T.create();
  u8[] s = "2026-08-03 10:00:00".toBytes();
  t.eqI64(parseUtc(s, 0, s.len()), 1785751200, "the epoch second, in UTC");
  u8[] epoch = "1970-01-01 00:00:00".toBytes();
  t.eqI64(parseUtc(epoch, 0, epoch.len()), 0, "the epoch itself");
  u8[] bad = "2026-08-03T10:00:00".toBytes();
  t.eqI64(parseUtc(bad, 0, bad.len()), -1, "a T separator is not this format");
  u8[] short_ = "2026-08-03".toBytes();
  t.eqI64(parseUtc(short_, 0, short_.len()), -1, "and neither is a date alone");
  return t.report();
}

/** Newline-joined fingerprints, as the registrar sends them. */
string[] lines(u8[] b) {
  i32 n = 0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] == '\n') { n++; }
  }
  string[] out = string[n](fill: "");
  i32 at = 0;
  i32 line = 0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] == '\n') {
      u8[] s = u8[i - at]();
      for (i32 j = 0; j < s.len(); j++) { s[j] = b[at + j]; }
      out[line] = string.fromBytes(s);
      line++;
      at = i + 1;
    }
  }
  return out;
}

// ── Malformed rather than forged ─────────────────────────────────────────────
//
// Added on 2026-08-24 from this package's coverage driver — `issues/system/0205`. `verifyConsensus`
// had nine uncovered branch points and the tests above explain why none of them was reached: every
// case there is *a thing an attacker would actually try* — a flag changed, a digest swapped, a
// signature from the wrong key — and all of those are **forgeries**, documents that are well-formed
// and untrue.
//
// The nine that were left are the other half: documents that are **malformed**. A signature line
// naming an algorithm nobody has heard of, one with the wrong number of fields, a signature block
// with no PEM body after it, a document with no validity window at all.
//
// That matters because of who serves these. A consensus does not come from an authority — it comes
// from whichever directory *cache* the client asked, and any relay can be one. A forgery needs a
// signing key; a malformed document needs a text editor.
//
// None of these should trap and none of them does; they are all `continue` or an early return. What
// was missing was any input that took them.

/** Where `needle` first appears in `hay`, or -1. */
i32 findBytes(u8[] hay, u8[] needle) {
  if (needle.len() == 0 || needle.len() > hay.len()) { return -1; }
  for (i32 i = 0; i + needle.len() <= hay.len(); i++) {
    bool hit = true;
    for (i32 k = 0; k < needle.len() && hit; k++) {
      if (hay[i + k] != needle[k]) { hit = false; }
    }
    if (hit) { return i; }
  }
  return -1;
}

/** `doc` with the first occurrence of `from` replaced by `to`. */
u8[] editOnce(u8[] doc, string from, string to) {
  i32 at = findBytes(doc, from.toBytes());
  if (at < 0) { return doc; }
  u8[] f2 = from.toBytes();
  u8[] t2 = to.toBytes();
  u8[] out = u8[doc.len() - f2.len() + t2.len()]();
  for (i32 i = 0; i < at; i++) { out[i] = doc[i]; }
  for (i32 i = 0; i < t2.len(); i++) { out[at + i] = t2[i]; }
  i32 rest = at + f2.len();
  for (i32 i = 0; rest + i < doc.len(); i++) { out[at + t2.len() + i] = doc[rest + i]; }
  return out;
}

/**
 * Documents that are malformed rather than untrue, each refused without trapping.
 *
 * The control is first: the unedited document is accepted with three good signatures, so every
 * refusal below is caused by the edit. Each case also asserts *how many signatures still counted*,
 * because that is what separates "this line was skipped" from "the whole document was thrown away" —
 * and a verifier that discarded everything on the first oddity would satisfy a bare `!ok`.
 */
export string test_a_malformed_consensus_is_refused_without_trapping(Core core, Cli cli) {
  T t = T.create();
  Fixtures f = documents(t, cli);
  if (!f.ok) { return t.report(); }
  string[] trusted = lines(f.names[0]);
  AuthorityCert[] certs = parseCertificates(f.docs[1], trusted);
  u8[] doc = f.docs[0];

  Verdict control = verifyConsensus(doc, certs, trusted, 1785715200);
  t.isTrue(control.ok, "the unedited consensus is not accepted, so nothing below means anything");
  t.eqI32(control.goodSignatures, 3, "the control does not have three good signatures");

  // An algorithm nobody has heard of. The line is skipped, so two signatures remain — still a
  // majority of three, so this one is *accepted*, and that is the point: a document may be odd
  // without being untrustworthy, and the verifier counts rather than panics.
  Verdict alg = verifyConsensus(editOnce(doc, "directory-signature sha256 ",
                                         "directory-signature sha999 "), certs, trusted, 1785715200);
  t.eqI32(alg.goodSignatures, 2, "an unknown signature algorithm did not skip exactly one line");
  t.isTrue(alg.ok, "two of three signatures is still a majority and should still be accepted");

  // A signature line with one field where there should be two or three.
  Verdict fields = verifyConsensus(editOnce(doc, "directory-signature sha256 ",
                                            "directory-signature "), certs, trusted, 1785715200);
  t.isTrue(fields.goodSignatures < 3, "a malformed signature line still counted");

  // A signature line with no PEM block after it: the BEGIN marker removed, so the walk finds the
  // *next* signature's block and attributes it to the wrong key.
  Verdict noBegin = verifyConsensus(editOnce(doc, "-----BEGIN SIGNATURE-----", "-----BEGIN NOTHING-----"),
                                    certs, trusted, 1785715200);
  t.isTrue(noBegin.goodSignatures < 3, "a signature with no PEM block still verified");

  // **The END marker removed changes nothing, and finding that out is why this case is here.**
  // `sigEnd` then points at the *next* signature's closing marker, so the span handed to `pemBody`
  // covers this signature's body, a stray line, and the following block's header — and it still
  // verifies, because `pemBody` stops at the first line that is not base64. So a missing closing
  // marker is survivable where a missing opening one is not.
  //
  // Asserted as it is rather than as I expected it: the first version of this line said
  // `goodSignatures < 3` and was wrong.
  Verdict noEnd = verifyConsensus(editOnce(doc, "-----END SIGNATURE-----", "-----END NOTHING-----"),
                                  certs, trusted, 1785715200);
  t.eqI32(noEnd.goodSignatures, 3,
          "a missing closing marker changed the verdict, so pemBody no longer stops at the first "
          + "line that is not base64");

  // No validity window at all.
  //
  // **This edit necessarily breaks every signature, and that is the format rather than the test.**
  // `valid-after` is inside the *signed* portion — the part that ends at the first
  // `directory-signature` — so a document without it is a document nobody signed. The edits above
  // are all in the signature region and leave the signed bytes alone, which is why they can skip one
  // line and keep the rest.
  //
  // So the arm is still reached and still reported, and what it proves is narrower than I first
  // wrote: staleness is computed and named even when there is nothing to be stale *about*, which is
  // what lets a caller tell "this document is not current" from "this document is not signed".
  Verdict noWindow = verifyConsensus(editOnce(doc, "valid-after ", "valid-later "),
                                     certs, trusted, 1785715200);
  t.isFalse(noWindow.ok, "a consensus with no valid-after was accepted");
  t.eqStr(noWindow.stale, "no valid-after/valid-until",
          "a missing validity window was not reported as such: " + noWindow.stale);
  t.eqI32(noWindow.goodSignatures, 0,
          "editing the signed portion left signatures intact, which cannot be right");

  // No signatures at all: the token the signed portion ends at is gone, so there is nothing to
  // verify and nothing to verify it against.
  Verdict none = verifyConsensus(editOnce(doc, "directory-signature ", "directory-nothing "),
                                 certs, trusted, 1785715200);
  t.isFalse(none.ok, "a consensus with no signature token was accepted");
  return t.report();
}
