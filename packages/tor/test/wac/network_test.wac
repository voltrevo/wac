// The launcher: does it bring nodes up, notice when one does not, and report the work honestly?
//
// Deliberately **not** a Tor network. `src/network.wac` knows about processes and ready markers, not
// about relays, and testing it against three relays would mean this test fails whenever anything in
// the tor stack does. `packages/platform/example/waiter.wac` exists to be started and killed and
// `example/wc.wac` exits 0 or 1 on demand, which is the whole vocabulary the launcher has.
//
// What is checked is the part that made every shell script this replaces untrustworthy:
//
//   - a node is waited *for*, not slept on
//   - a node that never announces itself fails the run, by name, rather than being assumed up
//   - the exit code of the work is the exit code of the run — a network that came up and a fetch
//     that failed must not read as success
//
// The tor network itself is stood up by `packages/tor/README.md`'s recipe rather than by the suite.
// That is a stated limitation, not an oversight.
//
// Host-side until 2026-08-19, `issues/system/0161`.
//
// **23s to 12s, and what is left is two deliberate waits.** Each case needs a launcher and three
// child bundles, and building them per case was **52 `deno run build.ts` subprocesses** — the largest
// single item in the `wac test` lane. They are the same four artefacts every time, so they are built
// once into `.cache/network/_built` and copied into each case's directory, which keeps the reason
// that directory exists (the launcher resolves bundle names from its own `cwd`) and pays for it in
// file copies rather than process starts.
//
// Of the 12s that remain, **8s is the two cases that are supposed to reach their timeout** — the node
// that never announces itself and the wait for something never said, at `timeout 4000` each. Those
// are the tests, not overhead: the rest of the file is thirteen launcher runs and their children.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli, Exec, Stat, FileResult } from "../../../platform/src/platform.wac";
import { contains } from "../../../wactest/src/strings.wac";
import { itoa } from "../../../fmt/src/itoa.wac";

/** One built launcher and its child bundles, built once and reused. */
struct Fixture {
  bool ok;
  string error;
  string dir;
  string launcher;
}

string scratch(Cli cli) { return cli.cwd().wait() + "/.cache/network"; }

bool build(T t, Cli cli, string entry, string out, string[] grants, bool worker) {
  string[] head = string[]("run", "-A", "packages/platform/build.ts", entry);
  string[] tail = worker ? string[]("--worker", "-o", out) : string[]("-o", out);
  string[] args = string[head.len() + grants.len() + tail.len()](fill: "");
  i32 at = 0;
  for (i32 i = 0; i < head.len(); i++) { args[at] = head[i]; at = at + 1; }
  for (i32 i = 0; i < grants.len(); i++) { args[at] = grants[i]; at = at + 1; }
  for (i32 i = 0; i < tail.len(); i++) { args[at] = tail[i]; at = at + 1; }
  Exec r = cli.exec("deno", args, u8[0]()).wait();
  t.isTrue(r.ran(), "deno ran — " + r.error);
  t.eqI32(r.status, 0, "building " + entry + ": " + string.fromBytes(r.stderr));
  return r.ran() && r.status == 0;
}

/** The newest modification time anywhere under `dir`, or 0 for a directory that is not there. */
i64 newestUnder(Cli cli, string dir) {
  i64 newest = 0 as i64;
  string[]? names = cli.readDir(dir).wait();
  if (names is null) { return 0 as i64; }
  string[] here = names!;
  for (i32 i = 0; i < here.len(); i++) {
    string path = dir + "/" + here[i];
    Stat s = cli.stat(path).wait();
    if (!s.exists) { continue; }
    if (s.isDir) {
      i64 deep = newestUnder(cli, path);
      if (deep > newest) { newest = deep; }
      continue;
    }
    if (s.modifiedMillis > newest) { newest = s.modifiedMillis; }
  }
  return newest;
}

/** `from` to `to`, since `Cli` has no copy — these are build outputs of a few hundred kilobytes. */
bool copyOver(Cli cli, string from, string to) {
  FileResult r = cli.readFile(from).wait();
  if (!r.ok) { return false; }
  return cli.writeFile(to, r.bytes).wait().ok();
}

/**
 * The four artefacts every case needs, built **once** and kept.
 *
 * They are the same four bytes for every case in this file, and building them per case was 52 `deno
 * run build.ts` subprocesses: **22.9s, the largest single item in the `wac test` lane.** They are
 * built into a directory of their own and copied into each case's, which keeps the property the
 * per-case directory exists for — the launcher resolves bundle names from its own `cwd`, so two
 * cases writing `net.txt` in one place would race — and pays for it in file copies rather than
 * process starts.
 *
 * Freshness is mtimes, the rule `tools/seedFresh.test.ts` uses for the seed: anything newer than the
 * built launcher under the sources these are made from, or under the builder itself, and all four are
 * built again. It is coarser than an import walk on purpose — after any edit in those trees the first
 * case rebuilds and the other twelve reuse, which is the shape that matters here.
 */
bool built(T t, Cli cli, string shared) {
  cli.mkdir(shared, true).wait();
  Stat have = cli.stat(shared + "/network").wait();
  i64 newest = newestUnder(cli, "packages/tor/src");
  i64 platform = newestUnder(cli, "packages/platform/src");
  if (platform > newest) { newest = platform; }
  i64 examples = newestUnder(cli, "packages/platform/example");
  if (examples > newest) { newest = examples; }
  Stat builder = cli.stat("packages/platform/build.ts").wait();
  if (builder.exists && builder.modifiedMillis > newest) { newest = builder.modifiedMillis; }
  if (have.exists && have.modifiedMillis > newest) { return true; }

  if (!build(t, cli, "packages/tor/src/network.wac", shared + "/network",
             string[]("--allow-read", "--allow-write", "--allow-net"), false)) {
    return false;
  }
  if (!build(t, cli, "packages/platform/example/waiter.wac", shared + "/waiter.worker.js",
             string[0](fill: ""), true)) {
    return false;
  }
  if (!build(t, cli, "packages/platform/example/wc.wac", shared + "/wc.worker.js",
             string[0](fill: ""), true)) {
    return false;
  }
  // Two-stage: prints `stages: listening`, waits, then `stages: serving`. The second line cannot
  // already have arrived when the ready marker resolves, which is what makes the `wait` cases below
  // test the waiting rather than the luck.
  return build(t, cli, "packages/platform/example/stages.wac", shared + "/stages.worker.js",
               string[0](fill: ""), true);
}

/**
 * The launcher, three child bundles and the two files the work counts.
 *
 * One directory per case, because the launcher's `cwd` is where it resolves a description's bundle
 * names from, and two cases writing `net.txt` into the same place would race. The four artefacts are
 * built once by `built` above and copied in.
 */
Fixture fixture(T t, Cli cli, string name) {
  string shared = scratch(cli) + "/_built";
  if (!built(t, cli, shared)) {
    return Fixture(false, "the shared build failed", scratch(cli) + "/" + name, "");
  }
  string dir = scratch(cli) + "/" + name;
  cli.remove(dir, true).wait();
  cli.mkdir(dir, true).wait();
  string launcher = dir + "/network";

  string[] parts = string[]("network", "waiter.worker.js", "wc.worker.js", "stages.worker.js");
  for (i32 i = 0; i < parts.len(); i++) {
    if (!copyOver(cli, shared + "/" + parts[i], dir + "/" + parts[i])) {
      return Fixture(false, "could not copy " + parts[i] + " into the case's directory", dir, "");
    }
  }
  // The launcher is run as `./network`, so it has to be executable — a copy is not.
  cli.setExecutable(launcher, true).wait();

  cli.writeFile(dir + "/counted.txt", ("one two three\n").toBytes()).wait();
  // Named for what `waiter: running` leaves after the marker `waiter: runn`, which is how the
  // substitution case below gets a value that only exists once the node has spoken.
  cli.writeFile(dir + "/ing.txt", ("captured from a ready line\n").toBytes()).wait();
  return Fixture(true, "", dir, launcher);
}

/** What the launcher said, and how it ended. */
struct Ran {
  i32 status;
  string out;
  string err;
}

/**
 * Run the launcher over a description, from the fixture's directory.
 *
 * `cd` on the shell line rather than a `cwd` parameter: `Cli.exec` has none, and the launcher
 * resolves a description's bundle names relative to where it is running. `issues/system/0199` is why
 * a pushed child's `cwd` is not an option either.
 */
Ran run(Cli cli, Fixture f, string description) {
  Exec r = cli.exec("/bin/sh",
                    string[]("-c", "cd " + f.dir + " && exec ./network " + description),
                    u8[0]()).wait();
  return Ran(r.ran() ? r.status : -1, string.fromBytes(r.stdout), string.fromBytes(r.stderr));
}

void describe(Cli cli, Fixture f, string name, string[] lines) {
  string text = "";
  for (i32 i = 0; i < lines.len(); i++) { text = text + lines[i] + "\n"; }
  cli.writeFile(f.dir + "/" + name, text.toBytes()).wait();
}

void done(Cli cli, Fixture f) { cli.remove(f.dir, true).wait(); }

export string test_a_network_comes_up_work_runs_and_everything_stops(Core core, Cli cli) {
  T t = T.create();
  Fixture f = fixture(t, cli, "up");
  if (!f.ok) { t.fail(f.error); return t.report(); }
  describe(cli, f, "net.txt", string[](
    "# two nodes and one piece of work",
    "node alpha | waiter: running | waiter.worker.js",
    "node beta  | waiter: running | waiter.worker.js",
    "run  count |               | wc.worker.js counted.txt"));
  Ran r = run(cli, f, "net.txt");

  t.eqI32(r.status, 0, r.err);
  // Both nodes were seen to announce themselves, by name. "started" is not "up": the first is this
  // program spawning something and the second is that something saying it is ready, and conflating
  // them is precisely the bug the ready marker exists to prevent.
  t.isTrue(contains(r.err, "alpha is up"), "the first node announced itself");
  t.isTrue(contains(r.err, "beta is up"), "the second node announced itself");
  t.isTrue(contains(r.err, "all 2 nodes are up"), "and the launcher counted them");
  // The work ran and its output came back through the handle rather than to the terminal.
  t.isTrue(contains(r.out, "1 3 14"), "wc counted the file the description named");
  t.isTrue(contains(r.err, "network: ok"), "and the run reported success");
  done(cli, f);
  return t.report();
}

export string test_a_node_that_never_announces_itself_fails_the_run(Core core, Cli cli) {
  T t = T.create();
  Fixture f = fixture(t, cli, "ghost");
  if (!f.ok) { t.fail(f.error); return t.report(); }
  // `alpha` will print "waiter: running" and never this. The timeout is seconds rather than the
  // two-minute default because this case is *expected* to reach it.
  describe(cli, f, "net.txt", string[](
    "timeout 4000",
    "node alpha | waiter: running    | waiter.worker.js",
    "node ghost | never printed this | waiter.worker.js",
    "run  count |                    | wc.worker.js counted.txt"));
  Ran r = run(cli, f, "net.txt");

  t.eqI32(r.status, 1, "a network that did not come up is a failed run");
  t.isTrue(contains(r.err, "ghost never said"), "the node that did not come up is named");
  // And the work must not have run. A launcher that pressed on would produce a result from a network
  // that was never up — which is the exact shape of the four scripted runs this replaces.
  t.isFalse(contains(r.out, "1 3 14"), "no work runs across a network that is not up");
  // The one that did come up is not blamed.
  t.isFalse(contains(r.err, "alpha never said"), "a node that is up is not reported down");
  done(cli, f);
  return t.report();
}

export string test_the_exit_code_of_the_work_is_the_exit_code_of_the_run(Core core, Cli cli) {
  T t = T.create();
  Fixture f = fixture(t, cli, "exitcode");
  if (!f.ok) { t.fail(f.error); return t.report(); }
  // `wc` on a file that is not there exits 1. Every node comes up, so this separates "the network
  // failed" from "the network was fine and the thing we asked it to do did not work".
  describe(cli, f, "net.txt", string[](
    "node alpha | waiter: running | waiter.worker.js",
    "run  count |               | wc.worker.js nosuch.txt"));
  Ran r = run(cli, f, "net.txt");

  t.eqI32(r.status, 1, "the failing work fails the run");
  t.isTrue(contains(r.err, "all 1 nodes are up"), "the network itself was fine");
  t.isTrue(contains(r.err, "count exited 1"), "and the work's status is named");
  t.isTrue(contains(r.err, "network: failed with 1"), "and carried to the run");

  // The child's two streams stay two. This forwarded both to stdout at first, which put the client's
  // progress in the middle of the document it had just fetched — so redirecting stdout gave a file
  // that had to be cleaned up before anything could read it.
  t.isTrue(contains(r.err, "wc: nosuch.txt"), "the child's diagnosis reaches the error channel");
  t.isFalse(contains(r.out, "wc: nosuch.txt"),
            "and not stdout, which belongs to whatever the work produced");
  done(cli, f);
  return t.report();
}

export string test_a_description_with_nothing_to_run_is_a_failure(Core core, Cli cli) {
  T t = T.create();
  Fixture f = fixture(t, cli, "nothing");
  if (!f.ok) { t.fail(f.error); return t.report(); }
  // The failure mode this guards: a description whose `run` line was commented out stands the
  // network up, tears it down, and exits 0 — reporting success for having done nothing.
  describe(cli, f, "net.txt", string[]("node alpha | waiter: running | waiter.worker.js"));
  Ran r = run(cli, f, "net.txt");
  t.eqI32(r.status, 1, "standing a network up is not the same as using it");
  t.isTrue(contains(r.err, "asks for nothing to be run"), "and it says so");

  // And a description with no nodes at all.
  describe(cli, f, "empty.txt", string[]("run count | | wc.worker.js counted.txt"));
  Ran e = run(cli, f, "empty.txt");
  t.eqI32(e.status, 1, "there is no network to run across");
  t.isTrue(contains(e.err, "no nodes"), "and it says so");
  done(cli, f);
  return t.report();
}

export string test_a_bundle_that_is_not_there_is_reported_against_the_node(Core core, Cli cli) {
  T t = T.create();
  Fixture f = fixture(t, cli, "nobundle");
  if (!f.ok) { t.fail(f.error); return t.report(); }
  describe(cli, f, "net.txt", string[](
    "node alpha | waiter: running | waiter.worker.js",
    "node gone  | waiter: running | nosuch.worker.js",
    "run  count |               | wc.worker.js counted.txt"));
  Ran r = run(cli, f, "net.txt");
  t.eqI32(r.status, 1, "a missing bundle is a failed run");
  t.isTrue(contains(r.err, "gone"), "the node is named, not just the file");
  t.isFalse(contains(r.out, "1 3 14"), "no work runs");
  done(cli, f);
  return t.report();
}

export string test_a_nodes_ready_line_supplies_an_argument_to_the_work(Core core, Cli cli) {
  // The point of this, in one sentence: a relay told to bind port 0 is given a port by the operating
  // system, so no description file can name it, but the relay *says* it on the line that makes it
  // ready. Ending the marker before the part that varies makes the rest of that line the node's
  // capture, and `{name}` reaches it. Without this a network can only be stood up on ports agreed in
  // advance, and two agents running the suite collide on them.
  //
  // `waiter` prints `waiter: running`, so a marker of `waiter: runn` captures `ing` — a value that
  // does not appear anywhere in the description and could not have been written into it.
  T t = T.create();
  Fixture f = fixture(t, cli, "capture");
  if (!f.ok) { t.fail(f.error); return t.report(); }
  describe(cli, f, "net.txt", string[](
    "node alpha | waiter: runn | waiter.worker.js",
    "run  count |              | wc.worker.js {alpha}.txt"));
  Ran r = run(cli, f, "net.txt");

  t.eqI32(r.status, 0, r.err);
  // `wc` echoes the name it was given, so this is the substituted argument coming back from the
  // child — not just a file that happened to be countable.
  t.isTrue(contains(r.out, "1 5 27 ing.txt"),
           "wc counted ing.txt, which only {alpha} could have named");
  t.isTrue(contains(r.err, "network: ok"), "and the run succeeded");
  done(cli, f);
  return t.report();
}

export string test_a_reference_to_a_node_not_in_the_description_fails(Core core, Cli cli) {
  // Passing `{relya1}` through as a literal is the failure this program exists to prevent: the
  // client would dial a host called `{relya1}`, fail, and the failure would look like the network
  // rather than like the typo it is.
  T t = T.create();
  Fixture f = fixture(t, cli, "typo");
  if (!f.ok) { t.fail(f.error); return t.report(); }
  describe(cli, f, "net.txt", string[](
    "node alpha | waiter: running | waiter.worker.js",
    "run  count |                 | wc.worker.js {alpah}.txt"));
  Ran r = run(cli, f, "net.txt");

  t.eqI32(r.status, 1, "an unresolved reference is a failed run");
  t.isTrue(contains(r.err, "{alpah} is not a node"),
           "the reference that could not be resolved is named");
  t.isFalse(contains(r.err, "running count"), "and nothing was run with it unresolved");
  done(cli, f);
  return t.report();
}

export string test_braces_that_are_not_references_are_left_alone(Core core, Cli cli) {
  // A launcher that rewrote every brace could not run a program whose argument is JSON. `{}` is not
  // a name, and `{` with no `}` is not a reference — both reach the child as written.
  T t = T.create();
  Fixture f = fixture(t, cli, "braces");
  if (!f.ok) { t.fail(f.error); return t.report(); }
  cli.writeFile(f.dir + "/{}.txt", ("literal braces\n").toBytes()).wait();
  describe(cli, f, "net.txt", string[](
    "node alpha | waiter: running | waiter.worker.js",
    "run  count |                 | wc.worker.js {}.txt"));
  Ran r = run(cli, f, "net.txt");

  t.eqI32(r.status, 0, r.err);
  t.isTrue(contains(r.out, "1 2 15"), "the file literally called {}.txt was counted");
  done(cli, f);
  return t.report();
}

export string test_wait_holds_the_next_step_until_a_node_reaches_a_later_state(Core core, Cli cli) {
  // Being up is not one event. A relay listens, and only later finds the documents an authority
  // built from descriptors it could not write until it had bound. `stages` prints
  // `stages: listening` and then `stages: serving` a moment afterwards, which is the same two-stage
  // shape: the second line is not available at ready time.
  T t = T.create();
  Fixture f = fixture(t, cli, "wait");
  if (!f.ok) { t.fail(f.error); return t.report(); }
  describe(cli, f, "net.txt", string[](
    "node alpha | stages: listening | stages.worker.js",
    "wait alpha | stages: serving   |",
    "run  count |                    | wc.worker.js counted.txt"));
  Ran r = run(cli, f, "net.txt");

  t.eqI32(r.status, 0, r.err);
  t.isTrue(contains(r.err, "alpha says stages: serving"), "the later state was seen, not assumed");
  t.isTrue(contains(r.out, "1 3 14"), "and the work ran after it");
  // Order matters and is the whole point: the wait has to resolve before the run starts.
  i32 waitedAt = r.err.indexOf("alpha says stages: serving");
  i32 ranAt = r.err.indexOf("running count");
  t.isTrue(waitedAt >= 0 && ranAt > waitedAt, "the wait resolved before the work started");
  done(cli, f);
  return t.report();
}

export string test_a_wait_for_something_a_node_never_says_fails(Core core, Cli cli) {
  T t = T.create();
  Fixture f = fixture(t, cli, "waitnever");
  if (!f.ok) { t.fail(f.error); return t.report(); }
  describe(cli, f, "net.txt", string[](
    "timeout 4000",
    "node alpha | waiter: running | waiter.worker.js",
    "wait alpha | never says this |",
    "run  count |                 | wc.worker.js counted.txt"));
  Ran r = run(cli, f, "net.txt");

  t.eqI32(r.status, 1, "a state never reached is a failed run");
  t.isTrue(contains(r.err, "alpha never said \"never says this\""), "the state is quoted back");
  t.isTrue(contains(r.err, "what alpha did say"), "and what it did say is shown");
  t.isFalse(contains(r.err, "running count"), "the step behind the wait did not run");
  done(cli, f);
  return t.report();
}

export string test_a_wait_naming_a_node_that_does_not_exist_fails(Core core, Cli cli) {
  T t = T.create();
  Fixture f = fixture(t, cli, "waitnonode");
  if (!f.ok) { t.fail(f.error); return t.report(); }
  describe(cli, f, "net.txt", string[](
    "node alpha | waiter: running | waiter.worker.js",
    "wait beta  | waiter: running |",
    "run  count |                 | wc.worker.js counted.txt"));
  Ran r = run(cli, f, "net.txt");
  t.eqI32(r.status, 1, "a wait for a node that is not there is a failed run");
  t.isTrue(contains(r.err, "wait names beta, which is not a node"), "and it says which");
  done(cli, f);
  return t.report();
}

export string test_a_wait_captures_even_when_the_node_had_already_said_it(Core core, Cli cli) {
  // The capture has to move with the marker on *both* paths, or the same description means different
  // things depending on how fast the node was — a value on a slow machine, an empty string on a
  // quick one. `stages` prints `listening` and then, 300ms later, `serving`; making the second line
  // the ready marker guarantees the first is already in the buffer by the time the wait runs.
  //
  // The two markers capture different things, which is what makes this discriminate: `stages:
  // serving` has nothing after it, so a wait that failed to re-capture would leave the empty string
  // behind and the work would be asked for `.txt`.
  T t = T.create();
  Fixture f = fixture(t, cli, "waitalready");
  if (!f.ok) { t.fail(f.error); return t.report(); }
  describe(cli, f, "net.txt", string[](
    "node alpha | stages: serving | stages.worker.js",
    "wait alpha | stages: listen  |",
    "run  count |                 | wc.worker.js {alpha}.txt"));
  Ran r = run(cli, f, "net.txt");

  t.eqI32(r.status, 0, r.err);
  t.isTrue(contains(r.err, "alpha had already said \"stages: listen\""), "it did not have to wait");
  t.isTrue(contains(r.out, "1 5 27 ing.txt"),
           "and the capture moved to the marker it had already seen");
  done(cli, f);
  return t.report();
}

export string test_a_node_after_a_run_starts_after_it(Core core, Cli cli) {
  // Stages. A server that cannot begin until something has happened on the network — an onion
  // service needs a consensus to bootstrap through — has to start late, and the plan says so by
  // position.
  //
  // `wc` writes nothing the launcher watches, so the ordering is read off the launcher's own log:
  // "started late" must appear after "running first", and "started early" before it.
  T t = T.create();
  Fixture f = fixture(t, cli, "ordering");
  if (!f.ok) { t.fail(f.error); return t.report(); }
  describe(cli, f, "net.txt", string[](
    "node early | waiter: running | waiter.worker.js",
    "run  first |                 | wc.worker.js counted.txt",
    "node late  | waiter: running | waiter.worker.js",
    "run  second|                 | wc.worker.js counted.txt"));
  Ran r = run(cli, f, "net.txt");

  t.eqI32(r.status, 0, r.err);
  i32 startedEarly = r.err.indexOf("started early");
  i32 ranFirst = r.err.indexOf("running first");
  i32 startedLate = r.err.indexOf("started late");
  t.isTrue(startedEarly >= 0 && startedEarly < ranFirst, "early started before the run");
  t.isTrue(startedLate > ranFirst, "late started after it — this is the whole feature");
  done(cli, f);
  return t.report();
}
