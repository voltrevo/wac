// A directory authority's key certificate, against one tor accepted.
//
// The vector in `data/authcert_generated.json` is a certificate this repo generated and tor's own
// `authority_cert_parse_from_string` accepted. The verdict has teeth: tor rejects the same document
// if either signature is disturbed, if the fingerprint line is altered, or — the case the source
// file warns about — if the two signatures are exchanged.
//
// The suite reproduces the bytes rather than running tor, for the reason `ntor_test.wac` records: a
// differential that needs a built tor tree present reddens the shared suite for whoever has not got
// one. Regenerate with `src/gendesc.wac` and re-check with `tools/parsedesc-probe.c cert`.
//
// **The host says which key signed what.** Byte-for-byte reproduction alone would not notice the
// two signatures being exchanged, because the vector would have been generated with them exchanged
// too. So `test/oracle.mjs` recovers each signature's payload with the key that is supposed to have
// made it — the signing key for the crosscert, the identity key for the certification — and this
// side checks the payloads are the identity fingerprint and the document digest respectively. Those
// are 20-byte values that would not survive being produced by the wrong key.
//
// Host-side until 2026-08-17, `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import {
  AuthorityKeys, authorityCertificate, certificationDigest, plainFingerprint,
} from "../../src/authcert.wac";
import { rsaFingerprint } from "../../src/routerdesc.wac";
import { decode as b64decode } from "../../../codec/src/base64.wac";
import { equal } from "../../../bytes/src/slice.wac";
import { jsonFile, strOf, num64Of } from "./jsonfile.wac";
import { JsonObject } from "../../../json/src/value.wac";
import { Lines, Answers, ask, hex, word } from "../../../wactest/src/oracle.wac";
import { Core, Cli } from "../../../platform/src/platform.wac";
import { decoded } from "../../../codec/src/hex.wac";

const string ORACLE = "packages/tor/test/oracle.mjs";
const string VECTOR = "packages/tor/test/data/authcert_generated.json";

AuthorityKeys keysFrom(JsonObject v) {
  return AuthorityKeys(
    decoded(strOf(v, "identityN")), decoded(strOf(v, "identityE")), decoded(strOf(v, "identityD")),
    decoded(strOf(v, "signingN")), decoded(strOf(v, "signingE")), decoded(strOf(v, "signingD")));
}

/** The PEM body between `label`'s BEGIN and END lines, decoded — or empty. */
u8[] blockAfter(u8[] doc, string keyword, string label) {
  i32 at = indexOfLine(doc, keyword + "\n");
  if (at < 0) { return u8[0](); }
  i32 begin = indexOfFrom(doc, "-----BEGIN " + label + "-----\n", at);
  if (begin < 0) { return u8[0](); }
  i32 bodyAt = begin + ("-----BEGIN " + label + "-----\n").toBytes().len();
  i32 end = indexOfFrom(doc, "-----END " + label + "-----\n", bodyAt);
  if (end < 0) { return u8[0](); }
  return base64Of(doc, bodyAt, end);
}

i32 indexOfLine(u8[] doc, string s) {
  u8[] n = s.toBytes();
  for (i32 i = 0; i + n.len() <= doc.len(); i++) {
    if (i != 0 && doc[i - 1] != 10) { continue; }
    bool hit = true;
    for (i32 j = 0; j < n.len(); j++) { if (doc[i + j] != n[j]) { hit = false; break; } }
    if (hit) { return i; }
  }
  return -1;
}

i32 indexOfFrom(u8[] doc, string s, i32 from) {
  u8[] n = s.toBytes();
  for (i32 i = from; i + n.len() <= doc.len(); i++) {
    bool hit = true;
    for (i32 j = 0; j < n.len(); j++) { if (doc[i + j] != n[j]) { hit = false; break; } }
    if (hit) { return i; }
  }
  return -1;
}

/** The base64 between two offsets, newlines dropped, decoded. */
u8[] base64Of(u8[] doc, i32 from, i32 to) {
  u8[] packed = u8[to - from]();
  i32 n = 0;
  for (i32 i = from; i < to; i++) {
    if (doc[i] != 10) { packed[n] = doc[i]; n = n + 1; }
  }
  u8[] text = u8[n]();
  for (i32 i = 0; i < n; i++) { text[i] = packed[i]; }
  u8[]? decoded = b64decode(text);
  return decoded is null ? u8[0]() : decoded!;
}

export string test_the_certificate_tor_accepted_is_reproduced(Core core, Cli cli) {
  T t = T.create();
  JsonObject v = jsonFile(cli, VECTOR);
  AuthorityKeys k = keysFrom(v);
  u8[] want = strOf(v, "certificate").toBytes();

  t.isTrue(want.len() > 800, "the committed certificate is a whole document");
  t.eqBytes(authorityCertificate(k, num64Of(v, "published"), num64Of(v, "expires")), want,
            "the certificate tor accepted is what we build");
  return t.report();
}

export string test_each_signature_was_made_by_the_key_that_should_have_made_it(Core core, Cli cli) {
  T t = T.create();
  JsonObject v = jsonFile(cli, VECTOR);
  u8[] cert = strOf(v, "certificate").toBytes();
  u8[] fingerprint = rsaFingerprint(decoded(strOf(v, "identityN")), decoded(strOf(v, "identityE")));
  t.eqI32(fingerprint.len(), 20, "the identity fingerprint is 20 bytes");

  // The `fingerprint` line has to be that digest, unbroken and uppercase — tor recomputes it from the
  // identity key it just read and refuses the document if they differ.
  t.isTrue(indexOfLine(cert, "fingerprint " + plainFingerprint(fingerprint) + "\n") >= 0,
           "the fingerprint line is the identity digest in unbroken hex");

  // The crosscert: recovered with the *signing* key, and the payload is the fingerprint. Nothing about
  // this document's own bytes.
  u8[] crosscert = blockAfter(cert, "dir-key-crosscert", "ID SIGNATURE");
  t.isTrue(crosscert.len() > 0, "the crosscert block decodes");

  // The certification: recovered with the *identity* key, and the payload is the document digest.
  u8[] certification = blockAfter(cert, "dir-key-certification", "SIGNATURE");
  t.isTrue(certification.len() > 0, "the certification block decodes");

  // Both recoveries in one batch, each with the key that is supposed to have made that signature.
  Lines lines = Lines.create();
  lines.add("rsarecover " + strOf(v, "signingN") + " " + strOf(v, "signingE") + " " +
            hex(crosscert));
  lines.add("rsarecover " + strOf(v, "identityN") + " " + strOf(v, "identityE") + " " +
            hex(certification));
  Answers a = ask(t, cli, "node", string[](ORACLE), lines, "the two recovered payloads");
  if (!a.ok) { return t.report(); }

  t.eqBytes(decoded(word(a.lines[0], 1)), fingerprint,
            "the signing key signed the identity fingerprint");
  t.eqBytes(decoded(word(a.lines[1], 1)), certificationDigest(cert),
            "the identity key signed the document digest");

  // And the two payloads differ, so the assertions above are not both true of the same 20 bytes — the
  // failure the source file warns about is exchanging the signatures, and that is only detectable
  // because these are different values signed by different keys.
  t.isFalse(equal(fingerprint, certificationDigest(cert)),
            "the fingerprint and the document digest are not the same 20 bytes");
  return t.report();
}

