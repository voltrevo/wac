// test-lane: exclusive — a real C tor bootstrapping from our authority, on real ports
//
// The half of design 0002 step 7 that nothing watched. `INTEROP.md` marks eight components **live**,
// meaning a C tor was on the other side of a socket and the thing worked — and every one of those was
// witnessed by a run somebody did by hand, on a date. Since the suite started standing the wac network
// up on every run, our own side is exercised continuously, which narrows the rot to exactly one
// direction and makes it *less* visible: a row can now only go stale by **tor no longer agreeing with
// us**, and that is the direction nothing was looking.
//
// ## Host-side until 2026-08-20, and the reason it stayed was about something else
//
// `issues/system/0161`. The file this replaces argued that it had to be TypeScript, and the argument
// was sound about the thing it was actually about:
//
//   > `network.wac` cannot start a C tor, and that is deliberate rather than a gap: `Cli.spawn` takes a
//   > worker bundle so that what a child may do is the *parent's* choice, and `--allow-run` cannot
//   > express that at any granularity because the child inherits the operating system's authority
//   > instead.
//
// All of that is still true, and none of it is about a *test*. `spawn` is the launcher's confinement
// and a C tor was never going to live inside it; what this needs is a peer on a socket, and a peer on a
// socket is `packages/wactest/src/daemon.wac` — "starting a server, waiting for it, and stopping it, the
// shape `Cli.exec` deliberately does not have". Ten wac tests already hold a child open that way,
// including `packages/tls/test/wac/interop_test.wac` against a real `openssl s_server` and
// `test/wac/dird_test.wac` one directory over. So the platform never had to change for this to be wac;
// it has to change for `network.wac` to own it, which is the weaker claim the old header was really
// making.
//
// **What the move deletes rather than translates** is the same paragraph `dird_test.wac` deleted: the
// TypeScript held four children's stdout on pipes and pumped both streams of each into a string, with
// a comment explaining why a reader that stopped early would eventually block the process under test.
// `daemon.start` redirects to a file, so a log is a `readFile` away and nothing can fill.
//
// ## Ignored unless tor has been built, and loud about it
//
// `test/wac/ntor_test.wac` records what happens otherwise: it shelled out to a binary in `/tmp`, the
// container was recreated, and this package turned the shared suite red for three agents who had not
// touched it. So the guard skips — and **says why on standard error**, because a silent skip reads as
// coverage that was never there. Build it with `tools/tor.sh`.

import { T } from "../../../wactest/src/assert.wac";
import { Core, Cli, Exec, Stat, FileResult } from "std/platform.wac";
import { Daemon, start, stop, logOf, waitForLogWithin, freePort }
  from "../../../wactest/src/daemon.wac";
import { builtProgram } from "../../../wactest/src/built.wac";
import { quoted, withoutEnv } from "../../../wactest/src/childenv.wac";
import { contains, trimmed } from "../../../wactest/src/strings.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { freshDir } from "../../../wactest/src/host.wac";

/**
 * Where the C tor lives if it has been built.
 *
 * Under `$HOME` rather than `/tmp`, for the reason `ntor_test.wac` gives: three agents share this
 * filesystem and `/tmp` does not survive the container being recreated.
 */
string torBinary(Cli cli) {
  u8[]? set = cli.env("TOR_C").wait();
  if (!(set is null)) { return string.fromBytes(set!); }
  u8[]? home = cli.env("HOME").wait();
  string root = home is null ? "" : string.fromBytes(home!);
  return root + "/tor-build/torproject-tor-c8d2b17/src/app/tor";
}

/**
 * `line`, run with `dir` as its working directory, as something `daemon.start` will accept.
 *
 * **`start` wraps its argument in `exec`**, so a line beginning `cd …` becomes `exec cd` and the shell
 * answers `exec: cd: not found` — which is what the first run of this file did, three times, and then
 * waited the full 120 seconds for a descriptor no relay was ever going to write. Every other caller of
 * `start` in the repository begins its line with a program, so the convention was there to follow.
 *
 * A nested shell rather than absolute paths everywhere: the inner `exec` means the pid `start` reads
 * from `$!` is still the program's, and `relayd` writes several files by relative name, so a cwd is
 * what it is actually asking for.
 */
string inDir(string dir, string line) {
  return "/bin/sh -c " + quoted("cd " + quoted(dir) + " && exec " + line);
}

/** A fresh directory per case, under `.cache` so nothing walking this repository's own files sees it. */
string freshScratch(T t, Cli cli, string name) {
  string dir = cli.cwd().wait() + "/.cache/ctor-" + name;
  string why = freshDir(cli, dir);
  t.isTrue(why == "", why);
  return dir;
}

/** The last `n` lines — enough to say where something stopped, short enough to read in a log. */
string tail(string text, i32 n) {
  u8[] b = trimmed(text).toBytes();
  i32 seen = 0;
  for (i32 i = b.len() - 1; i >= 0; i--) {
    if (b[i] != '\n') { continue; }
    seen = seen + 1;
    if (seen == n) { return text.slice(i + 1, text.len()); }
  }
  return text;
}

/** The three relays and the two facts a tor has to be told about them. */
struct Net {
  bool ok;
  string why;
  string orPort;
  string relayFingerprint;
  string v3ident;
  Daemon[] relays;
}

Net failed(string why) { return Net(false, why, "", "", "", Daemon[0](fill: Daemon(-1, "", ""))); }

const string DOCS = "-C v.consensus -K cert.cert -D r1.desc -D r2.desc -D r3.desc" +
                    " -M v.consensus.micro -m v.consensus.mds";

/** What every relay wrote when it had done so, so a wait that fails can say how far each got. */
string relaysSaid(Cli cli, Daemon[] relays) {
  string out = "";
  for (i32 i = 0; i < relays.len(); i++) {
    out = out + "--- relay" + itoa(i + 1) + " ---\n" + tail(logOf(cli, relays[i]), 12) + "\n";
  }
  return out;
}

/**
 * Three relays and an authority, held open.
 *
 * Port 0 throughout, so this cannot collide with another agent's suite — the same property that let the
 * wac-only network into the suite in the first place.
 *
 * **The ready marker is the descriptor line, not the bind.** A relay logs `listening on` before it
 * writes its descriptor, so waiting on the bind would run the authority against descriptors that do not
 * exist yet — which is the ordering `network_tor_test.wac`'s header sets out at length and the reason
 * this is two waits rather than one.
 */
Net standUpNetwork(Core core, Cli cli, string dir) {
  string relayd = builtProgram(cli, "packages/tor/src/relayd.wac", "ctorrelayd",
                               string[]("--allow-read", "--allow-write", "--allow-net"));
  string gendesc = builtProgram(cli, "packages/tor/src/gendesc.wac", "ctorgendesc",
                                string[]("--allow-read", "--allow-write"));
  string wac = cli.cwd().wait() + "/native/v8/target/release/wac";

  // Distinct random seeds, so no two relays derive the same identity — and random rather than fixed,
  // because a fixed one would make two concurrent runs of this suite share keys.
  for (i32 n = 1; n <= 3; n++) {
    cli.writeFile(dir + "/s" + itoa(n), core.randomBytes(32).wait()).wait();
  }

  Daemon[] relays = Daemon[3](fill: Daemon(-1, "", ""));
  for (i32 n = 1; n <= 3; n++) {
    string extra = n == 1 ? "--seedline seed.txt " : "";
    string line = quoted(wac) + " " + quoted(relayd) +
                  " s" + itoa(n) + " -p 0 -n wacc" + itoa(n) +
                  " --descriptor r" + itoa(n) + ".desc " + extra + DOCS;
    relays[n - 1] = start(cli, inDir(dir, line), dir + "/relay" + itoa(n) + ".log");
    if (relays[n - 1].pid < 0) {
      return failed("relay " + itoa(n) + " did not start — " + relays[n - 1].error);
    }
  }
  for (i32 n = 0; n < 3; n++) {
    if (!waitForLogWithin(core, cli, relays[n], "-byte descriptor for port", 120000)) {
      return failed("relay " + itoa(n + 1) + " never wrote a descriptor within 120s\n" +
                    relaysSaid(cli, relays));
    }
  }

  Exec vote = cli.exec("/bin/sh",
    string[]("-c", "cd " + quoted(dir) + " && exec " + quoted(wac) + " " + quoted(gendesc) +
                   " keys.json cert vote v - r1.desc r2.desc r3.desc"), u8[0]()).wait();
  if (!vote.ran() || vote.status != 0) {
    return failed("gendesc failed: " + string.fromBytes(vote.stderr) +
                  string.fromBytes(vote.stdout));
  }
  for (i32 n = 0; n < 3; n++) {
    if (!waitForLogWithin(core, cli, relays[n], "serving the consensus", 30000)) {
      return failed("relay " + itoa(n + 1) + " never found the documents within 30s\n" +
                    relaysSaid(cli, relays));
    }
  }

  // What tor has to be told, and both halves come out of the network rather than out of this file.
  // `v3ident` is whose signature to trust on the consensus; the trailing fingerprint is whose TLS
  // identity to expect on the wire. They are different keys answering different questions, which is the
  // whole shape of the DirAuthority line — and tor dials the **ORPort** named here rather than the
  // DirPort, because it prefers a tunnelled directory connection even for a direct fetch. A `dird`
  // serving only a DirPort is unreachable to it; a relay answering BEGIN_DIR is not.
  FileResult seedFile = cli.readFile(dir + "/seed.txt").wait();
  FileResult identFile = cli.readFile(dir + "/cert.fingerprint").wait();
  if (!seedFile.ok || !identFile.ok) {
    return failed("the network did not write seed.txt and cert.fingerprint\n" +
                  relaysSaid(cli, relays));
  }
  string[] seed = words(string.fromBytes(seedFile.bytes));
  if (seed.len() < 3) {
    return failed("seed.txt has " + itoa(seed.len()) + " fields, not three: " +
                  string.fromBytes(seedFile.bytes));
  }
  return Net(true, "", seed[1], seed[2], trimmed(string.fromBytes(identFile.bytes)), relays);
}

/** Whitespace-separated fields, which is what `seed.txt` is. */
string[] words(string text) {
  string[] out = string[8](fill: "");
  i32 n = 0;
  string cur = "";
  for (i32 i = 0; i <= text.len(); i++) {
    string c = i < text.len() ? text.slice(i, i + 1) : " ";
    if (c == " " || c == "\t" || c == "\n" || c == "\r") {
      if (cur.len() > 0 && n < out.len()) { out[n] = cur; n = n + 1; }
      cur = "";
    } else {
      cur = cur + c;
    }
  }
  string[] exact = string[n](fill: "");
  for (i32 i = 0; i < n; i++) { exact[i] = out[i]; }
  return exact;
}

/**
 * Start a tor against a network already standing, and wait for a line in **its own** log.
 *
 * tor is told `Log notice file`, so its log is a file it writes rather than a pipe this has to drain —
 * which is the same arrangement `daemon.start` makes for everything else here, arrived at from the
 * other end. The daemon's own log catches whatever tor says before it opens that file, which is where
 * a configuration error appears.
 */
Daemon startTor(Core core, Cli cli, string dir, Net net, string[] extra, string awaitLine,
                string[] failure) {
  cli.mkdir(dir + "/tordata", true).wait();
  string torrc = "DataDirectory " + dir + "/tordata\n" +
                 "ControlPort 0\n" +
                 "TestingTorNetwork 1\n" +
                 "DirAuthority wacauth orport=" + net.orPort + " no-v2 v3ident=" + net.v3ident +
                 " 127.0.0.1:17999 " + net.relayFingerprint + "\n" +
                 "Log notice file " + dir + "/tor.log\n";
  for (i32 i = 0; i < extra.len(); i++) { torrc = torrc + extra[i] + "\n"; }
  cli.writeFile(dir + "/torrc", torrc.toBytes()).wait();

  // No cwd for tor: everything in the torrc is an absolute path, so it needs none.
  Daemon tor = start(cli, quoted(torBinary(cli)) + " -f " + quoted(dir + "/torrc"),
                     dir + "/tor.stdout.log");
  if (tor.pid < 0) {
    failure[0] = "tor did not start — " + tor.error;
    return tor;
  }
  i64 deadline = core.nowMillis().wait() + (120000 as i64);
  for (i32 guard = 0; guard < 1000000; guard++) {
    if (contains(torLog(cli, dir), awaitLine)) { return tor; }
    if (core.nowMillis().wait() >= deadline) {
      failure[0] = "tor never reached \"" + awaitLine + "\" within 120s\n--- tor.log ---\n" +
                   tail(torLog(cli, dir), 25) + "\n--- tor's stdout ---\n" +
                   tail(logOf(cli, tor), 12);
      return tor;
    }
    core.sleepMillis(100).wait();
  }
  failure[0] = "tor never reached \"" + awaitLine + "\"";
  return tor;
}

string torLog(Cli cli, string dir) {
  return string.fromBytes(cli.readFile(dir + "/tor.log").wait().bytes);
}

void stopAll(Cli cli, Daemon[] ds) { for (i32 i = 0; i < ds.len(); i++) { stop(cli, ds[i]); } }

/** Said once per case, because a silent skip reads as coverage that was never there. */
bool announceMissing(Core core, Cli cli) {
  string path = torBinary(cli);
  Stat have = cli.stat(path).wait();
  if (have.exists) { return false; }
  core.warn("");
  core.warn("  ctor_live_test.wac is skipped: no tor binary at " + path + ".");
  core.warn("  Build one with tools/tor.sh to check that C tor still agrees with us.");
  return true;
}

export string test_a_c_tor_bootstraps_from_our_authority_and_through_our_relays(Core core, Cli cli) {
  T t = T.create();
  if (announceMissing(core, cli)) { return t.report(); }
  string dir = freshScratch(t, cli, "bootstrap");

  Net net = standUpNetwork(core, cli, dir);
  t.isTrue(net.ok, net.why);
  if (!net.ok) { stopAll(cli, net.relays); return t.report(); }

  string[] failure = string[1](fill: "");
  Daemon tor = startTor(core, cli, dir, net, string[]("SocksPort 0"), "Bootstrapped 100%", failure);
  t.eqStr(failure[0], "", "tor bootstrapped");
  string log = torLog(cli, dir);

  if (failure[0] == "") {
    // **Bootstrapping is not one event**, and which stages it passed is the interesting part. A tor
    // that reached 100% from a *cached* consensus would prove nothing, which is why the DataDirectory
    // is fresh per run — every one of these had to come off our wire.
    string[] stages = string[](
      "Bootstrapped 30% (loading_status): Loading networkstatus consensus",
      "Bootstrapped 40% (loading_keys): Loading authority key certs",
      "Bootstrapped 50% (loading_descriptors): Loading relay descriptors",
      "Bootstrapped 75% (enough_dirinfo)",
      "Bootstrapped 100% (done)");
    for (i32 i = 0; i < stages.len(); i++) {
      t.isTrue(contains(log, stages[i]),
               "tor logged \"" + stages[i] + "\"\n" + tail(log, 25));
    }

    // And the thing this test was written to catch: **tor complaining about us**. The first run of it
    // found the responder's NETINFO carrying a timestamp of zero, so tor read the epoch and warned that
    // one of us was twenty thousand days out — then bootstrapped anyway, because the recommendation for
    // that check is `warn`. A wrong value that still works is exactly what a suite with no C tor in it
    // cannot see, and it is what these three assertions are for.
    t.isTrue(!contains(log, "skewed time"),
             "tor does not think our clock is wrong — check the NETINFO timestamp\n" + tail(log, 25));
    // Our link certificate was Ed25519 where every real relay's is RSA, so tor asked it for an RSA key,
    // got none, and left `expecting an rsa key` on OpenSSL's error queue three times per handshake. The
    // message was noise; what it pointed at was a relay identifiable as ours from the first flight, by a
    // field anyone on the path can read.
    t.isTrue(!contains(log, "expecting an rsa key"),
             "tor can read our link certificate's key as RSA\n" + tail(log, 25));
    t.isTrue(!contains(log, "Unhandled OpenSSL errors"),
             "we leave no OpenSSL errors on tor's queue\n" + tail(log, 25));
  }

  stop(cli, tor);
  stopAll(cli, net.relays);
  cli.remove(dir, true).wait();
  return t.report();
}

export string test_a_c_tor_carries_a_stream_through_our_relays_both_directions(Core core, Cli cli) {
  T t = T.create();
  if (announceMissing(core, cli)) { return t.report(); }
  string dir = freshScratch(t, cli, "stream");

  // `INTEROP.md` marks streams **live** in both directions on a run somebody did by hand. This is that
  // run, in the suite — and it exercises more than the stream: a SOCKS request makes tor build a real
  // three-hop circuit through our relays, CREATE2 at the guard and EXTEND2 twice, then RELAY_BEGIN at
  // the exit, which is one of ours opening a TCP connection and carrying bytes back.
  //
  // ## The assertion that has to come first, and why
  //
  // The first attempt at this test asserted the body and passed while measuring nothing. `NO_PROXY` is
  // set to `localhost,127.0.0.1` in this container, curl honours it, and it therefore **ignored
  // `--socks5-hostname` entirely** and connected straight to the target. Byte-identical body, exit code
  // zero, and not one Tor cell involved — which is exactly the failure `src/network.wac`'s header
  // describes: a confident number measured against a proxy setting.
  //
  // So the load-bearing assertion is that **a relay of ours says it opened the stream**. The body being
  // right is necessary and proves nothing on its own; that line is what distinguishes "our exit carried
  // it" from "the bytes arrived some other way". `--noproxy ""` and `withoutEnv` are what make the
  // request actually go where it says.
  //
  // ## The target is not our code, deliberately
  //
  // It stands in for a service on the internet, so it is `python3 -m http.server` over a file — the same
  // choice the TypeScript made with `Deno.serve`, for the same reason. A target of ours would make a
  // failure ambiguous between the circuit and the server.
  i32 targetPort = freePort(cli);
  i32 socksPort = freePort(cli);
  t.isTrue(targetPort > 0 && socksPort > 0, "two free ports");
  if (targetPort <= 0 || socksPort <= 0) { return t.report(); }

  // Long enough to span several relay cells, so the exit has to carry a sequence rather than get lucky
  // with a body that fits in one.
  string body = "";
  for (i32 i = 0; i < 300; i++) { body = body + "wac relay carried this\n"; }
  cli.mkdir(dir + "/www", true).wait();
  cli.writeFile(dir + "/www/body.txt", body.toBytes()).wait();
  Daemon target = start(cli, inDir(dir + "/www", "python3 -m http.server " + itoa(targetPort) +
                                            " --bind 127.0.0.1"), dir + "/target.log");
  t.isTrue(target.pid > 0, "the target server started — " + target.error);
  if (target.pid <= 0) { return t.report(); }

  Net net = standUpNetwork(core, cli, dir);
  t.isTrue(net.ok, net.why);
  if (!net.ok) { stop(cli, target); stopAll(cli, net.relays); return t.report(); }

  // `TestingTorNetwork` sets `ClientRejectInternalAddresses 0`, which is what makes a loopback target
  // reachable through a circuit at all — on a real network a client refuses one, correctly.
  string[] failure = string[1](fill: "");
  Daemon tor = startTor(core, cli, dir, net, string[]("SocksPort " + itoa(socksPort)),
                        "Bootstrapped 100%", failure);
  t.eqStr(failure[0], "", "tor bootstrapped");

  if (failure[0] == "") {
    Exec got = withoutEnv(cli, string[]("no_proxy", "NO_PROXY", "http_proxy", "HTTP_PROXY"),
      "curl", string[]("--silent", "--show-error", "--max-time", "60", "--noproxy", "",
                       "--socks5-hostname", "127.0.0.1:" + itoa(socksPort),
                       "http://127.0.0.1:" + itoa(targetPort) + "/body.txt"));
    t.eqI32(got.status, 0, "curl through tor: " + string.fromBytes(got.stderr) +
                           "\n--- tor.log ---\n" + tail(torLog(cli, dir), 25));

    if (got.status == 0) {
      // **First: did it go through us at all?** Asking tor whether the bytes went through our relays is
      // asking the wrong process, so this reads the relays' own logs.
      bool opened = false;
      string want = "open to 127.0.0.1:" + itoa(targetPort);
      for (i32 i = 0; i < net.relays.len(); i++) {
        if (waitForLogWithin(core, cli, net.relays[i], want, i == 0 ? 15000 : 1)) { opened = true; }
      }
      t.isTrue(opened,
               "a relay of ours opened the stream to 127.0.0.1:" + itoa(targetPort) +
               ", so what curl fetched came through them\n" + relaysSaid(cli, net.relays));

      // **Then: byte-identical, not merely non-empty.** A stream that dropped or reordered a cell in
      // the middle would still pass a length check.
      t.eqStr(string.fromBytes(got.stdout), body,
              "the body came back byte for byte\n--- tor.log ---\n" + tail(torLog(cli, dir), 25));
    }
  }

  stop(cli, tor);
  stop(cli, target);
  stopAll(cli, net.relays);
  cli.remove(dir, true).wait();
  return t.report();
}
