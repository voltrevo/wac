// The `r` line an authority writes, against the lines a chutney network's authorities wrote.

import { T } from "../../../wactest/src/assert.wac";
import { parse } from "../../../json/src/json.wac";
import { JsonValue, JsonObject, JsonArray } from "../../../json/src/value.wac";
import { Files, Sys } from "std";
import {
  routerStatusLine, descriptorIdentityDigest, lineValue, b64Unpadded,
} from "../../src/routerdesc.wac";
import { flatten } from "core";



/**
 * The vote-status vectors, read here rather than handed in — `issues/system/0161` step 4.
 *
 * Every field is text: the descriptor, the `r` line tor's authority wrote, and the pieces of that
 * line the tests rebuild it from. The two ports are numbers in the file and **text** here, because
 * that is what appears in an `r` line and what the comparison is about.
 */
JsonArray voteCases(Files fs) {
  u8[]? r = flatten(fs.readFile("packages/tor/test/data/votestatus_vectors.json").wait()).ok();
  if ((r is null)) { trap; }
  JsonValue? v = parse(r!).ok();
  if (v is null) { trap; }
  match (v!) {
    Object(members): {
      JsonValue? cs = members.getStr("cases");
      if (cs is null) { trap; }
      match (cs!) {
        Array(items): { return items; }
        default: { trap; }
      }
    }
    default: { trap; }
  }
}

i32 caseCount(Files fs) { return voteCases(fs).len(); }

JsonObject caseAt(Files fs, i32 i) {
  match (voteCases(fs).get(i)) {
    Object(members): { return members; }
    default: { trap; }
  }
}

u8[] strOf(Files fs, i32 i, string key) {
  JsonValue? v = caseAt(fs, i).getStr(key);
  if (v is null) { trap; }
  match (v!) {
    Str(bytes): { return bytes; }
    default: { trap; }
  }
}

/** A numeric field as the text an `r` line carries. */
u8[] numOf(Files fs, i32 i, string key) {
  JsonValue? v = caseAt(fs, i).getStr(key);
  if (v is null) { trap; }
  match (v!) {
    Number(value, raw): { return "\{value as~ i32}".toBytes(); }
    default: { trap; }
  }
}

export string test_the_r_line_is_the_one_tors_authority_wrote(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  i32 n = caseCount(fs);
  t.isTrue(n >= 3, "several relays, not one");

  for (i32 i = 0; i < n; i++) {
    u8[] desc = strOf(fs, i, "descriptor");
    string which = "relay \{i as i64}";

    // The whole line, from the descriptor alone.
    t.eqBytes(routerStatusLine(desc), strOf(fs, i, "rLine"),
              "\{which}: our r line is the one tor's authority wrote");

    // And the digest field on its own, so a failure says which part moved rather than only that the
    // line differs. This is the field the whole pairing rests on.
    t.eqBytes(b64Unpadded(descriptorIdentityDigest(desc)).toBytes(),
              strOf(fs, i, "digest"),
              "\{which}: the descriptor digest is the one tor recorded");

    // The publication time on the r line is the descriptor's own `published` line, copied rather than
    // recomputed — an authority does not restate the time in its own words.
    t.eqBytes(lineValue(desc, "published "), strOf(fs, i, "publication"),
              "\{which}: the publication time is the descriptor's own");
  }
  return t.report();
}

export string test_the_r_line_skips_the_descriptors_dead_field(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  u8[] desc = strOf(fs, 0, "descriptor");

  // A descriptor's router line is `router <nickname> <address> <ORPort> <SOCKSPort> <DirPort>`, and the
  // SOCKSPort is long dead and always 0. The r line has no such field, so the ports cannot be copied
  // across in order — the last field of the r line is the descriptor's *fifth*, not its fourth.
  u8[] router = lineValue(desc, "router ");
  t.isTrue(router.len() > 0, "the descriptor has a router line");

  // The r line's trailing fields are address, ORPort, DirPort — indices 6, 7 and 8, because the
  // publication time occupies two of them.
  u8[] line = routerStatusLine(desc);
  t.eqBytes(fieldOf(line, 6), strOf(fs, 0, "address"), "field 6 is the address");
  t.eqBytes(fieldOf(line, 7), numOf(fs, 0, "orPort"),
            "field 7 is the ORPort, the descriptor's third");
  t.eqBytes(fieldOf(line, 8), numOf(fs, 0, "dirPort"),
            "field 8 is the DirPort, the descriptor's fifth and not its fourth");

  // A descriptor missing a line the r line needs gives nothing rather than a line with a hole in it.
  t.eqI32(routerStatusLine("router x 127.0.0.1 1 0 2\n".toBytes()).len(), 0,
          "a descriptor with no fingerprint or published line produces no r line");
  return t.report();
}

/** The nth space-separated field of a line. */
u8[] fieldOf(u8[] line, i32 which) {
  i32 at = 0;
  i32 seen = 0;
  while (at < line.len() && seen < which) {
    if (line[at] == 32) { seen = seen + 1; }
    at = at + 1;
  }
  i32 end = at;
  while (end < line.len() && line[end] != 32) { end = end + 1; }
  u8[] out = u8[].filled(end - at, 0);
  for (i32 i = 0; i < end - at; i++) { out[i] = line[at + i]; }
  return out;
}
