// Proposal 228: moving a key between Curve25519 and the Edwards curve, which is what lets a relay's
// ntor onion key sign its `ntor-onion-key-crosscert`.
//
// The vectors are eight router descriptors tor produced (`src/test/test_descriptors.inc`), so the
// curve25519 key, the sign bit, the certificate and the identity it certifies are all C tor's. The
// host verifies signatures with node's Ed25519 rather than ours, and that is the point: using
// `ed25519Verify` here would mean our conversion feeding our own verifier, and the pair can agree on
// a wrong answer — a formula that consistently produced the negation of the right key would pass,
// because the verifier would be handed the same wrong key both times. `test/oracle.mjs` did not
// produce these certificates and shares no code with us, so it can only agree if the key is actually
// right. This file additionally asks our own verifier for the same answer, which is worth something
// once the host has established what the answer is.
//
// Both sign-bit values appear across the eight descriptors, so a conversion that ignored the bit
// fails on half of them rather than passing by luck — `test_the_fixture_covers_both_sign_bits`
// asserts that rather than trusting it.
//
// Host-side until 2026-08-17, `issues/system/0161`.
//
// ## Two oracles, because the descriptors cannot reach the secret side
//
// The derivation string `"Derive high part of ed25519 key from curve25519 key"` and its trailing NUL
// are invisible to every descriptor-based check here, and the reason is worth stating because the
// opposite is the natural assumption: the string contributes only the nonce prefix — the second half
// of the expanded secret — and a *public* key does not depend on the prefix. Get the string wrong,
// including dropping the NUL, and every public-key comparison still passes. A planted fault confirms
// it: removing the NUL leaves all eight of tor's descriptors verifying. It is caught by the second
// vector file, and — since 2026-08-17, when the generated descriptor moved into this file — also by
// `test_the_descriptor_tor_accepted_is_reproduced`, which signs with the derived key rather than
// only comparing public ones.
//
// Tor's own committed vectors do not cover it either. `test_crypto_ed25519_testvectors` overwrites the
// derived secret with an ordinary ed25519 key before it signs, so nothing in tor exercises a signature
// made with a proposal-228 prefix.
//
// So the second vector file comes from calling tor: `packages/tor/tools/capture-prop228.py` links against tor's
// static library and records the expanded secret it derives together with a signature tor makes with
// it. ed25519 is deterministic, so reproducing that signature byte for byte pins all 64 bytes of the
// secret — which is what the last test does.

import { T } from "../../../wactest/src/assert.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";
import {
  curve25519ToEd25519Secret, ed25519FromCurve25519Public, ed25519PublicKeyExpanded,
  ed25519SignBit, ed25519SignExpanded,
} from "../../../crypto/src/ed25519.wac";
import { x25519Base } from "../../../crypto/src/x25519.wac";
import {
  ed25519CertBody, ed25519CertExpanded, verifyEd25519Cert,
  CERT_TYPE_ONION_ID, KEY_TYPE_ED25519,
} from "../../src/relaycert.wac";
import { certCertifiedKey, certType } from "../../src/hsdesc.wac";
import {
  edDescriptorDigest, rsaDescriptorDigest, pastLineStarting, pemBlock, publishedTime,
  spacedFingerprint, b64Unpadded, rsaFingerprint, rsaPublicKeyDer,
  RelayInfo, RelayKeys, routerDescriptor,
} from "../../src/routerdesc.wac";
import { ed25519Verify } from "../../../crypto/src/ed25519.wac";
import { jsonFile, strOf, numOf, num64Of, arrayOf, objectOf } from "./jsonfile.wac";
import { JsonObject, JsonArray } from "../../../json/src/value.wac";
import { Lines, Answers, ask, hex, word } from "../../../wactest/src/oracle.wac";
import { Core, Cli } from "../../../platform/src/platform.wac";
import { decoded } from "../../../codec/src/hex.wac";
import { decode as b64decode } from "../../../codec/src/base64.wac";

const string ORACLE = "packages/tor/test/oracle.mjs";

JsonArray descriptors(Cli cli) {
  return arrayOf(jsonFile(cli, "packages/tor/test/data/routerdesc_vectors.json"), "descriptors");
}
JsonObject prop228(Cli cli) { return jsonFile(cli, "packages/tor/test/data/prop228_vectors.json"); }

/** tor writes `router-sig-ed25519` base64 without padding. */
u8[] b64Padded(string t) {
  string padded = t;
  while (padded.len() % 4 != 0) { padded = padded + "="; }
  u8[]? b = b64decode(padded.toBytes());
  return b is null ? u8[0]() : b!;
}

/**
 * What the host read out of one descriptor: the ten fields of a `desc` answer.
 *
 * All of it is parsed on the far side rather than here, because re-deriving these is exactly what
 * is being tested — the PEM wrapping, the fingerprint spacing, the epoch behind `published`, and
 * the modulus and exponent behind `signing-key`.
 */
struct Desc {
  u8[] onionDer;
  u8[] onionPem;
  string fingerprintLine;
  string publishedLine;
  i64 publishedEpoch;
  string ntorLine;
  u8[] signingDer;
  u8[] signingN;
  u8[] signingE;
  u8[] recovered;
}

Desc descOf(string line) {
  u8[] epoch = decoded(word(line, 5));
  i64 secs = 0;
  for (i32 i = 0; i < epoch.len(); i++) { secs = secs * 256 + (epoch[i] as i64); }
  return Desc(decoded(word(line, 1)), decoded(word(line, 2)),
              string.fromBytes(decoded(word(line, 3))),
              string.fromBytes(decoded(word(line, 4))), secs,
              string.fromBytes(decoded(word(line, 6))),
              decoded(word(line, 7)), decoded(word(line, 8)), decoded(word(line, 9)),
              decoded(word(line, 10)));
}

/** The 4-byte big-endian field at `off`, which is how a certificate writes its expiry. */
i64 be32At(u8[] c, i32 off) {
  i64 v = 0;
  for (i32 i = 0; i < 4; i++) { v = v * 256 + (c[off + i] as i64); }
  return v;
}

/** The conversion, or an empty array — the tests assert on the length rather than trapping. */
u8[] convert(u8[] u, i32 signbit) {
  u8[]? k = ed25519FromCurve25519Public(u, signbit);
  return k is null ? u8[0]() : k!;
}

export string test_the_fixture_covers_both_sign_bits(Core core, Cli cli) {
  // A load-time throw in the registrar this file replaced. If every descriptor carried the same
  // sign bit, a conversion that ignored the bit would pass the whole file.
  T t = T.create();
  JsonArray all = descriptors(cli);
  t.isTrue(all.len() >= 4, "several descriptors, not one");
  i32 zeros = 0;
  i32 ones = 0;
  for (i32 i = 0; i < all.len(); i++) {
    if (numOf(objectOf(all.get(i)), "signbit") == 0) { zeros = zeros + 1; } else { ones = ones + 1; }
  }
  t.isTrue(zeros > 0 && ones > 0, "both sign bits occur, so the bit is genuinely exercised");
  t.isTrue(arrayOf(prop228(cli), "cases").len() >= 1, "tor's own derivation was captured");
  return t.report();
}

export string test_the_conversion_matches_the_certificates_tor_signed(Core core, Cli cli) {
  T t = T.create();
  JsonArray all = descriptors(cli);
  i32 n = all.len();
  t.isTrue(n >= 4, "several descriptors, not one");

  // Both keys per descriptor are computed first and judged in one batch: the right one must verify
  // and the sign-bit-flipped one must not, so a host answering the same to everything fails here
  // rather than agreeing with half of it.
  Lines lines = Lines.create();
  for (i32 i = 0; i < n; i++) {
    JsonObject d = objectOf(all.get(i));
    u8[] ntor = decoded(strOf(d, "ntor_onion_key"));
    i32 bit = numOf(d, "signbit");
    string cert = strOf(d, "ntor_crosscert");
    lines.add("edverify " + hex(convert(ntor, bit)) + " " + cert);
    lines.add("edverify " + hex(convert(ntor, 1 - bit)) + " " + cert);
  }
  Answers a = ask(t, cli, "node", string[](ORACLE), lines, "node's verdicts on both sign bits");
  if (!a.ok) { return t.report(); }

  for (i32 i = 0; i < n; i++) {
    JsonObject d = objectOf(all.get(i));
    u8[] ntor = decoded(strOf(d, "ntor_onion_key"));
    i32 bit = numOf(d, "signbit");
    u8[] cert = decoded(strOf(d, "ntor_crosscert"));
    u8[] master = decoded(strOf(d, "master_key_ed25519"));
    string which = "descriptor " + itoa64(i as i64);

    t.eqI32(certType(cert), CERT_TYPE_ONION_ID, which + ": is a type-10 certificate");
    t.eqI32(cert.len(), 104, which + ": 40 bytes of body and a 64-byte signature");
    t.eqBytes(certCertifiedKey(cert), master, which + ": certifies the master identity");

    // The assertion the file exists for: the converted key is the one that signed tor's certificate,
    // as judged by node rather than by us.
    u8[] key = convert(ntor, bit);
    t.eqI32(key.len(), 32, which + ": the onion key converts");
    t.eqStr(word(a.lines[i * 2], 1), "1",
            which + ": node verifies tor's crosscert under the converted key");

    // And our own verifier agrees, now that the host has settled what the answer is.
    t.isTrue(verifyEd25519Cert(cert, key), which + ": our verifier agrees");

    // The sign bit is not decoration. Flipping it must produce a key that fails, or the conversion
    // could be ignoring it and passing on the half of the vectors where it happens to be zero.
    u8[] flipped = convert(ntor, 1 - bit);
    t.eqStr(word(a.lines[i * 2 + 1], 1), "0", which + ": the other sign bit does not verify");
    t.isFalse(verifyEd25519Cert(cert, flipped), which + ": our verifier rejects it too");
  }
  return t.report();
}

export string test_the_crosscert_body_is_reproduced_byte_for_byte(Core core, Cli cli) {
  T t = T.create();
  JsonArray all = descriptors(cli);
  i32 n = all.len();

  for (i32 i = 0; i < n; i++) {
    JsonObject d = objectOf(all.get(i));
    u8[] cert = decoded(strOf(d, "ntor_crosscert"));
    u8[] master = decoded(strOf(d, "master_key_ed25519"));
    string which = "descriptor " + itoa64(i as i64);

    u8[] want = u8[40]();
    for (i32 j = 0; j < 40; j++) { want[j] = cert[j]; }

    u8[] got = ed25519CertBody(CERT_TYPE_ONION_ID, be32At(cert, 2), KEY_TYPE_ED25519,
                               master, u8[0](), false);
    t.eqBytes(got, want, which + ": the body we build is the body tor wrote");

    // The zero-extension byte is the difference between this certificate and every other one the
    // relay publishes, and it is one byte at the end of the body — so it is worth naming rather than
    // leaving to the comparison above.
    t.eqI32(cert[39], 0, which + ": tor's crosscert carries no extension");
    u8[] withExt = ed25519CertBody(CERT_TYPE_ONION_ID, be32At(cert, 2), KEY_TYPE_ED25519,
                                   master, master, true);
    t.eqI32(withExt.len(), 76, which + ": including the signing key makes it 76 bytes");
  }
  return t.report();
}

export string test_the_secret_derivation_is_tors(Core core, Cli cli) {
  T t = T.create();
  JsonObject top = prop228(cli);
  JsonArray cases = arrayOf(top, "cases");
  i32 n = cases.len();
  t.isTrue(n >= 1, "tor's derivation was captured");
  u8[] message = strOf(top, "message").toBytes();

  // The certificates we sign with each derived key, judged in one batch at the end.
  Lines lines = Lines.create();
  u8[] identity = u8[32]();
  for (i32 j = 0; j < 32; j++) { identity[j] = (200 - j * 3) & 0xFF; }
  for (i32 k = 0; k < n; k++) {
    u8[] expanded = curve25519ToEd25519Secret(decoded(strOf(objectOf(cases.get(k)),
                                                            "curve_secret")));
    lines.add("edverify " + strOf(objectOf(cases.get(k)), "ed_public") + " " +
              hex(ed25519CertExpanded(CERT_TYPE_ONION_ID, 123456, KEY_TYPE_ED25519,
                                      identity, expanded)));
  }
  Answers a = ask(t, cli, "node", string[](ORACLE), lines, "node's verdicts on our certificates");
  if (!a.ok) { return t.report(); }

  for (i32 k = 0; k < n; k++) {
    JsonObject c = objectOf(cases.get(k));
    u8[] secret = decoded(strOf(c, "curve_secret"));
    string which = "case " + itoa64(k as i64);

    // The whole expanded secret, against the bytes tor produced. This is what pins the derivation
    // string and its trailing NUL: the second half is a hash of both.
    u8[] expanded = curve25519ToEd25519Secret(secret);
    t.eqBytes(expanded, decoded(strOf(c, "expanded")),
              which + ": the expanded secret is the one tor derived");

    u8[] edPublic = decoded(strOf(c, "ed_public"));
    t.eqBytes(ed25519PublicKeyExpanded(expanded), edPublic,
              which + ": the public key matches tor's");
    t.eqI32(ed25519SignBit(edPublic), numOf(c, "signbit"),
            which + ": the sign bit is the one tor reported");
    t.eqBytes(x25519Base(secret), decoded(strOf(c, "curve_public")),
              which + ": the curve25519 public key matches tor's");
    t.eqBytes(convert(decoded(strOf(c, "curve_public")), ed25519SignBit(edPublic)), edPublic,
              which + ": converting tor's public key gives tor's ed25519 key");

    // And the signature, byte for byte. A public key cannot see the nonce prefix; a signature is a
    // fingerprint of the whole secret, so this is the assertion the second vector file exists for.
    t.eqBytes(ed25519SignExpanded(expanded, message), decoded(strOf(c, "signature")),
              which + ": the signature is identical to tor's");

    // Finally the builder path a relay actually uses, judged from outside: a certificate signed with
    // the derived key must verify under the converted public key, according to node.
    u8[] cert = ed25519CertExpanded(CERT_TYPE_ONION_ID, 123456, KEY_TYPE_ED25519,
                                   identity, expanded);
    t.eqI32(cert.len(), 104, which + ": the certificate we build is 104 bytes");
    t.eqStr(word(a.lines[k], 1), "1",
            which + ": node verifies the certificate we signed with the derived key");
  }
  return t.report();
}

export string test_the_document_digests_are_tors(Core core, Cli cli) {
  T t = T.create();
  JsonArray all = descriptors(cli);
  i32 n = all.len();

  // One `desc` line per descriptor: the host parses each one and hands back what it found.
  Lines lines = Lines.create();
  for (i32 i = 0; i < n; i++) {
    lines.add("desc " + hex(strOf(objectOf(all.get(i)), "descriptor").toBytes()));
  }
  Answers a = ask(t, cli, "node", string[](ORACLE), lines, "what the host read out of each");
  if (!a.ok) { return t.report(); }

  for (i32 i = 0; i < n; i++) {
    JsonObject d = objectOf(all.get(i));
    u8[] text = strOf(d, "descriptor").toBytes();
    u8[] sig = b64Padded(strOf(d, "router_sig_ed25519"));
    string which = "descriptor " + itoa64(i as i64);

    t.eqI32(sig.len(), 64, which + ": router-sig-ed25519 decodes to 64 bytes");

    // `identity-ed25519` is a type-4 certificate whose *certified* key is the signing key. The master
    // identity is in its extension, and does not sign the descriptor — using it here would be the
    // natural mistake and would fail for every relay.
    u8[] signingKey = certCertifiedKey(decoded(strOf(d, "identity_ed25519_cert")));
    t.eqI32(signingKey.len(), 32, which + ": the identity certificate names a signing key");

    // The assertion: tor's signature over tor's document, under our digest rule. If the span or the
    // prefix or the hash is wrong, this fails — and nothing else here would notice.
    u8[] digest = edDescriptorDigest(text);
    t.eqI32(digest.len(), 32, which + ": the ed25519 digest is 32 bytes");
    t.isTrue(ed25519Verify(signingKey, digest, sig),
             which + ": tor's router-sig-ed25519 verifies over our digest");

    // Not under the master identity, so the choice of key is pinned too.
    t.isFalse(ed25519Verify(decoded(strOf(d, "master_key_ed25519")), digest, sig),
              which + ": the master identity did not sign the descriptor");

    // The RSA digest, against the payload node recovers from tor's own `router-signature` using the
    // `signing-key` the descriptor publishes. Length alone would not do: stopping one byte short of
    // the newline gives a perfectly good 20-byte digest, and that fault survived until this compared
    // the bytes.
    u8[] recovered = descOf(a.lines[i]).recovered;
    t.eqI32(recovered.len(), 20, which + ": node recovered a SHA-1 digest from router-signature");
    t.eqBytes(rsaDescriptorDigest(text), recovered,
              which + ": our RSA digest is the one tor signed");
  }
  return t.report();
}

export string test_a_digest_span_stops_where_tor_stops(Core core, Cli cli) {
  T t = T.create();
  u8[] text = strOf(objectOf(descriptors(cli).get(0)), "descriptor").toBytes();

  // The ed25519 span ends immediately after the keyword and its single space, with no newline. The
  // easiest wrong answer is to include the signature that follows, and the second easiest is to stop
  // before the keyword; both are excluded by checking the exact offset.
  i32 end = pastLineStarting(text, "router-sig-ed25519 ".toBytes());
  t.isTrue(end > 0, "the keyword is present");
  t.eqI32(text[end - 1], 32, "the span ends on the space after the keyword");
  t.neI32(text[end], 10, "the span does not reach the newline");

  i32 rsaEnd = pastLineStarting(text, "router-signature\n".toBytes());
  t.isTrue(rsaEnd > end, "router-signature comes after router-sig-ed25519");
  t.eqI32(text[rsaEnd - 1], 10, "the RSA span includes the newline");

  // A keyword that is not at a line start must not match, or a nickname or contact line could move
  // the span. `pastLineStarting` is given a needle that occurs only mid-line here.
  t.eqI32(pastLineStarting("aaa\nxrouter-signature\n".toBytes(), "router-signature\n".toBytes()), -1,
          "a keyword mid-line is not the document's own");
  t.eqI32(pastLineStarting("router-signature\n".toBytes(), "router-signature\n".toBytes()), 17,
          "a keyword at the very start matches");
  t.eqI32(pastLineStarting("nope\n".toBytes(), "router-signature\n".toBytes()), -1,
          "an absent keyword is -1");

  // An absent keyword must give an empty digest rather than a digest of the whole document.
  t.eqI32(edDescriptorDigest("router nickname\n".toBytes()).len(), 0,
          "no keyword, no digest");
  t.eqI32(rsaDescriptorDigest("router nickname\n".toBytes()).len(), 0,
          "no keyword, no RSA digest");
  return t.report();
}

export string test_a_pem_block_is_wrapped_the_way_tor_wraps_one(Core core, Cli cli) {
  T t = T.create();
  JsonArray all = descriptors(cli);
  i32 n = all.len();
  Lines lines = Lines.create();
  for (i32 i = 0; i < n; i++) {
    lines.add("desc " + hex(strOf(objectOf(all.get(i)), "descriptor").toBytes()));
  }
  Answers a = ask(t, cli, "node", string[](ORACLE), lines, "the onion keys the host unwrapped");
  if (!a.ok) { return t.report(); }

  for (i32 i = 0; i < n; i++) {
    Desc d = descOf(a.lines[i]);
    u8[] der = d.onionDer;
    u8[] want = d.onionPem;
    string which = "descriptor " + itoa64(i as i64);

    t.isTrue(der.len() > 100, which + ": the onion key decoded");
    // Byte for byte against tor's own block: header, 64-character lines, the trailing newline on the
    // last one, and the footer. Wrapping at 76 — RFC 2045's width, and most tools' default — would
    // still be valid base64 and would change every byte after the first line.
    t.eqBytes(pemBlock("RSA PUBLIC KEY", der), want,
              which + ": our PEM block is the block tor wrote");
  }

  // Every line is at most 64 characters, checked directly rather than inferred from the comparison
  // above, so a change in wrapping says which rule it broke.
  u8[] block = pemBlock("RSA PUBLIC KEY", descOf(a.lines[0]).onionDer);
  i32 run = 0;
  i32 longest = 0;
  for (i32 i = 0; i < block.len(); i++) {
    if (block[i] == 10) {
      if (run > longest) { longest = run; }
      run = 0;
    } else {
      run = run + 1;
    }
  }
  t.eqI32(run, 0, "the block ends with a newline");
  t.isTrue(longest <= 64, "no line exceeds 64 characters");
  return t.report();
}

export string test_the_field_formats_are_tors(Core core, Cli cli) {
  T t = T.create();
  JsonArray all = descriptors(cli);
  i32 n = all.len();
  Lines lines = Lines.create();
  for (i32 i = 0; i < n; i++) {
    lines.add("desc " + hex(strOf(objectOf(all.get(i)), "descriptor").toBytes()));
  }
  Answers a = ask(t, cli, "node", string[](ORACLE), lines, "each descriptor's own field values");
  if (!a.ok) { return t.report(); }

  for (i32 i = 0; i < n; i++) {
    Desc d = descOf(a.lines[i]);
    string which = "descriptor " + itoa64(i as i64);

    // `published` — the descriptor writes UTC with no zone marker at all, so a generator using local
    // time produces a document that verifies and describes the wrong moment.
    t.eqStr(publishedTime(d.publishedEpoch), d.publishedLine,
            which + ": our published line is tor's");

    // `fingerprint` — SHA-1 of the DER RSAPublicKey, uppercase, in groups of four. The key comes from
    // the descriptor's own `signing-key`, so this checks the digest and the formatting together.
    u8[] nn = d.signingN;
    u8[] ee = d.signingE;
    t.eqI32(nn.len(), 128, which + ": the signing key is RSA-1024");
    t.eqStr(spacedFingerprint(rsaFingerprint(nn, ee)), d.fingerprintLine,
            which + ": our fingerprint line is tor's");

    // And the DER we re-encode is the DER tor published, so the fingerprint above is not agreeing by
    // way of two compensating mistakes.
    t.eqBytes(rsaPublicKeyDer(nn, ee), d.signingDer,
              which + ": our RSAPublicKey encoding is tor's");

    // `ntor-onion-key` — base64 with the padding stripped.
    t.eqStr(b64Unpadded(decoded(strOf(objectOf(all.get(i)), "ntor_onion_key"))), d.ntorLine,
            which + ": our ntor-onion-key line is tor's");
  }
  return t.report();
}

/**
 * A router descriptor this repo generated, and the key material that produced it.
 *
 * `router_parse_entry_from_string` accepted it, and rejects it if any signature, the certificate
 * chain or a single body byte is disturbed — so the bytes committed here are a document a real tor
 * verified. The suite compares against them rather than running tor: a test that needs a built tor
 * tree present reddens the shared suite for whoever has not got one, which is the mistake
 * `ntor_test.wac` records having already made once.
 *
 * Regenerate with `packages/tor/src/gendesc.wac`, then re-check with `tools/parsedesc-probe.c`.
 */
export string test_the_descriptor_tor_accepted_is_reproduced(Core core, Cli cli) {
  T t = T.create();
  JsonObject g = jsonFile(cli, "packages/tor/test/data/routerdesc_generated.json");

  RelayKeys k = RelayKeys(
    decoded(strOf(g, "rsaIdentityN")), decoded(strOf(g, "rsaIdentityE")),
    decoded(strOf(g, "rsaIdentityD")),
    decoded(strOf(g, "rsaOnionN")), decoded(strOf(g, "rsaOnionE")), decoded(strOf(g, "rsaOnionD")),
    decoded(strOf(g, "edIdentitySeed")), decoded(strOf(g, "edSigningSeed")),
    decoded(strOf(g, "ntorSecret")));

  RelayInfo info = RelayInfo(
    strOf(g, "nickname"), strOf(g, "address"),
    numOf(g, "orPort"), numOf(g, "dirPort"), num64Of(g, "published"),
    num64Of(g, "bandwidthRate"), num64Of(g, "bandwidthBurst"), num64Of(g, "bandwidthObserved"),
    num64Of(g, "certExpiryHours"),
    // The committed vector predates the policy being a field, so it keeps the value that was
    // hardcoded when those bytes were signed. Reproducing them is the point of the test.
    "reject *:*");

  u8[] want = strOf(g, "descriptor").toBytes();
  t.isTrue(want.len() > 1500, "the committed descriptor is a whole document");

  // The assertion: tor's own `router_parse_entry_from_string` accepted these exact bytes, and rejects
  // them if a signature, the certificate chain or one body byte is disturbed. Reproducing them means
  // reproducing a document a real tor verified — both signatures, all three certificates, and the
  // proposal 228 crosscert included.
  t.eqBytes(routerDescriptor(k, info), want, "the descriptor tor accepted is what we build");

  // The document is self-consistent under our own reading of it too, which is worth asserting
  // separately: it is the part that would still hold if the vector were ever regenerated wrongly.
  u8[] built = routerDescriptor(k, info);
  t.eqI32(edDescriptorDigest(built).len(), 32, "the built document has an ed25519 digest");
  t.eqI32(rsaDescriptorDigest(built).len(), 20, "the built document has an RSA digest");
  t.isTrue(pastLineStarting(built, "router-signature\n".toBytes()) > 0,
           "the built document is signed with RSA last");
  return t.report();
}

/** An 8-byte big-endian number from the vector. */
