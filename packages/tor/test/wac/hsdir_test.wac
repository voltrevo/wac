// The HSDir hash ring, against the directories tor actually chose.
//
// `test/data/hsdir_vectors.json` is captured from a running chutney network by
// `packages/tor/tools/capture-hsdir.py`. Every relay index in it is a value **tor logged**, from
// `upload_descriptor_to_hsdir()`, alongside the blinded key and the directory's ed25519 identity. So
// the central assertion here is not "our formula is self-consistent" but "our formula produces the
// number tor produced, for thirteen relays across two time periods".
//
// That matters because the ring has no local oracle. A client whose index is wrong asks a directory
// that does not have the descriptor, gets a 404, and cannot tell that apart from a service that never
// published. Nothing short of an external value catches it.
//
// The network was widened for this. chutney's stock `hs-v3` has eight nodes, and 2 replicas x a
// spread of 4 is eight directories — so every node is chosen and "did we pick the right ones" has no
// wrong answer. `networks/hs-v3-wide` has thirteen candidates for those eight slots.
//
// Committed rather than produced at test time, which is what every captured corpus here does — see
// `packages/bls/test/vendor/README.md`: "an unpinned refresh that quietly gains cases is a suite
// whose meaning changed without a diff". The same holds the other way for a live one: a differential
// that needs a running testnet stops running the moment the testnet is not there, and a suite that
// quietly stops checking reports a better number for checking less.
//
// (The wrapper cited packages/tor/test/vendor/README.md for this and there is no such file — no
// vendor/ under packages/tor at all. The reference was stale and came over with the header. Left
// unbackticked deliberately: `tools/wac/links_test.wac` checks that every backticked repository path
// names a file that exists, and cannot tell a citation from one being disavowed.)
//
// Host-side until 2026-08-17. The wrapper packed each case into eighty bytes and the directories
// into a count followed by pairs, because it handed everything over one `u8[]` seam; with the seam
// gone `hsdir_fixture.wac` names the fields. `issues/system/0161` step 4.

import { T } from "../../../wactest/src/assert.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";
import {
  hsServiceIndex, hsRelayIndex, disasterSrv, compareIndex, responsibleHsdirs,
  HSDIR_N_REPLICAS_DEFAULT, HSDIR_SPREAD_STORE_DEFAULT, HSDIR_SPREAD_FETCH_DEFAULT,
  hsdirsForDescriptor, hsdirCandidates, descriptorPath, StorePeriod, betweenTimePeriodAndSrv,
  serviceStorePeriods, consensusTimePeriod, Publication, servicePlan,
} from "../../src/hsdir.wac";
import { Relay, parseConsensus, attachMicrodescriptors, base64NoPad } from "../../src/directory.wac";
import { equal, slice } from "../../../bytes/src/slice.wac";
import { Core, Cli } from "std/platform.wac";
import {
  candidateCount, candidateEd, caseBlinded, caseCount, caseHsdirCount, caseHsdirEd, caseHsdirIndex,
  casePeriodLength, caseSrv, caseTimePeriod, caseUsedCurrentSrv, consensusDocument, microdescriptors,
} from "./hsdir_fixture.wac";

/** `1 << k` as an i32 — `1 << (k as@ u32)` is a u32 and will not meet an i32 accumulator. */
i32 bit(i32 k) {
  i32 m = 1;
  for (i32 i = 0; i < k; i++) { m = m * 2; }
  return m;
}
/**
 * What the capture has to contain for any of this to discriminate.
 *
 * A service publishes **two** descriptors, and one case is consistent with almost any pair of
 * periods — so the store rule cannot be checked at all from one. The two uploads must also have used
 * *different* shared random values, or the assignment they are supposed to distinguish never varies.
 * And the candidate set has to be bigger than the slots: with eight candidates for 2 replicas x a
 * spread of 4, every relay is chosen and there is no wrong answer to give.
 */
export string test_the_capture_can_discriminate(Core core, Cli cli) {
  T t = T.create();
  i32 n = caseCount(cli);
  t.isTrue(n >= 2, "the vector records fewer than two service uploads");

  bool current = false;
  bool previous = false;
  for (i32 c = 0; c < n; c++) {
    if (caseUsedCurrentSrv(cli, c)) { current = true; } else { previous = true; }
  }
  t.isTrue(current && previous,
           "both uploads used the same shared random value, so the assignment is untested");

  i32 slots = HSDIR_N_REPLICAS_DEFAULT * HSDIR_SPREAD_STORE_DEFAULT;
  t.isTrue(candidateCount(cli) > slots,
           "only " + itoa64(candidateCount(cli) as i64) + " HSDir candidates for " +
           itoa64(slots as i64) + " slots — the selection test cannot discriminate. Recapture from " +
           "a wider network (chutney networks/hs-v3-wide).");

  // Distinct candidates, because the ring is a set of positions and two entries at one identity
  // would make a spread of four cover fewer than four relays. It is also the only thing here that
  // would notice `candidateEd` walking the list wrongly.
  i32 duplicates = 0;
  for (i32 i = 0; i < candidateCount(cli); i++) {
    for (i32 j = i + 1; j < candidateCount(cli); j++) {
      if (equal(candidateEd(cli, i), candidateEd(cli, j))) { duplicates = duplicates + 1; }
    }
  }
  t.eqI32(duplicates, 0, "the candidates are distinct relays");
  return t.report();
}

export string test_every_relay_index_is_the_one_tor_computed(Core core, Cli cli) {
  T t = T.create();
  i32 cases = caseCount(cli);
  t.isTrue(cases >= 1, "the vector has at least one case");
  i32 checked = 0;
  for (i32 c = 0; c < cases; c++) {
    u8[] srv = caseSrv(cli, c);
    i64 tp = caseTimePeriod(cli, c);
    i64 plen = casePeriodLength(cli, c);

    i32 n = caseHsdirCount(cli, c);
    t.isTrue(n > 0, "case " + itoa64(c as i64) + " names some directories");
    for (i32 i = 0; i < n; i++) {
      t.isTrue(equal(hsRelayIndex(caseHsdirEd(cli, c, i), srv, tp, plen), caseHsdirIndex(cli, c, i)),
               "case " + itoa64(c as i64) + " relay " + itoa64(i as i64) +
               ": hs_relay_index agrees with tor's");
      checked = checked + 1;
    }
  }
  t.isTrue(checked >= 8, "at least eight indices were checked, not one");
  return t.report();
}

export string test_we_choose_the_directories_tor_chose(Core core, Cli cli) {
  // The whole ring, end to end: from a blinded key and the consensus's HSDir set, pick the
  // responsible directories and require exactly tor's set. This is what `hsServiceIndex` is tested
  // by — tor does not log a service index, so the only evidence it is right is that the relays it
  // selects are the relays tor uploaded to.
  T t = T.create();
  i32 cases = caseCount(cli);
  i32 nr = candidateCount(cli);
  t.isTrue(nr > HSDIR_N_REPLICAS_DEFAULT * HSDIR_SPREAD_STORE_DEFAULT,
           "there are more candidates than slots, so the choice discriminates");

  for (i32 c = 0; c < cases; c++) {
    u8[] blinded = caseBlinded(cli, c);
    u8[] srv = caseSrv(cli, c);
    i64 tp = caseTimePeriod(cli, c);
    i64 plen = casePeriodLength(cli, c);

    u8[][] indices = u8[][nr]();
    for (i32 i = 0; i < nr; i++) {
      indices[i] = hsRelayIndex(candidateEd(cli, i), srv, tp, plen);
    }
    i32[] chosen = responsibleHsdirs(blinded, indices, HSDIR_N_REPLICAS_DEFAULT,
                                     HSDIR_SPREAD_STORE_DEFAULT, plen, tp);

    i32 want = caseHsdirCount(cli, c);
    t.eqI32(chosen.len(), want,
            "case " + itoa64(c as i64) + ": we chose as many directories as tor did");

    // Membership both ways. Ours must all be tor's, and tor's must all be ours — one direction alone
    // would pass for a subset.
    i32 missing = 0;
    for (i32 i = 0; i < want; i++) {
      u8[] theirs = caseHsdirEd(cli, c, i);
      bool found = false;
      for (i32 j = 0; j < chosen.len(); j++) {
        if (equal(candidateEd(cli, chosen[j]), theirs)) { found = true; }
      }
      if (!found) { missing = missing + 1; }
    }
    t.eqI32(missing, 0, "case " + itoa64(c as i64) + ": every directory tor used is one we chose");

    // No relay chosen twice. With few candidates the two replicas' spreads overlap, and the spec
    // says a relay already taken by a lower-numbered replica is skipped — without that a service
    // uploads twice to one directory and reaches fewer than it believes.
    i32 dupes = 0;
    for (i32 i = 0; i < chosen.len(); i++) {
      for (i32 j = i + 1; j < chosen.len(); j++) {
        if (chosen[i] == chosen[j]) { dupes = dupes + 1; }
      }
    }
    t.eqI32(dupes, 0, "case " + itoa64(c as i64) + ": no directory is chosen twice");
  }
  return t.report();
}

export string test_the_trailing_field_order_differs_between_the_two_indices(Core core, Cli cli) {
  // `store-at-idx` ends with period **length then number**; `node-idx` ends with **number then
  // length**. It reads like a transcription slip in the specification and it is not. Anyone tidying
  // this code would normalise them, so the asymmetry is asserted rather than left as a comment: swap
  // the arguments and the index must change.
  T t = T.create();
  u8[] blinded = caseBlinded(cli, 0);
  u8[] srv = caseSrv(cli, 0);
  i64 tp = caseTimePeriod(cli, 0);
  i64 plen = casePeriodLength(cli, 0);
  t.isFalse(tp == plen, "the two values differ, or this test proves nothing");

  u8[] service = hsServiceIndex(blinded, 1, plen, tp);
  t.isFalse(equal(service, hsServiceIndex(blinded, 1, tp, plen)),
            "swapping length and number changes the service index");
  u8[] ed = candidateEd(cli, 0);
  u8[] relay = hsRelayIndex(ed, srv, tp, plen);
  t.isFalse(equal(relay, hsRelayIndex(ed, srv, plen, tp)),
            "swapping number and length changes the relay index");

  // Every other input must move the index too.
  t.isFalse(equal(service, hsServiceIndex(blinded, 2, plen, tp)), "the replica number matters");
  t.isFalse(equal(relay, hsRelayIndex(ed, disasterSrv(plen, tp), tp, plen)), "the SRV matters");
  t.eqI32(hsServiceIndex(u8[31](), 1, plen, tp).len(), 0, "a short blinded key is refused");
  t.eqI32(hsRelayIndex(u8[31](), srv, tp, plen).len(), 0, "a short identity is refused");
  return t.report();
}

export string test_the_ring_wraps(Core core, Cli cli) {
  // A service index above every relay's index must come back round to the lowest, not fall off the
  // end. Constructed rather than found: with a handful of relays the natural case may not occur, and
  // an off-by-one at the wrap is exactly the bug that leaves a client asking nobody.
  T t = T.create();
  u8[][] indices = u8[][4]();
  for (i32 i = 0; i < 4; i++) {
    u8[] idx = u8[32]();
    idx[0] = (0x10 + i * 0x10);
    indices[i] = idx;
  }
  // A blinded key is only a hash input here, so any 32 bytes do; what is being tested is the walk.
  u8[] blinded = u8[32]();
  for (i32 i = 0; i < 32; i++) { blinded[i] = (i * 7 + 3) & 0xFF; }

  i32[] one = responsibleHsdirs(blinded, indices, 1, 4, 8, 100);
  t.eqI32(one.len(), 4, "one replica with a spread of four takes every relay");
  i32 seen = 0;
  for (i32 i = 0; i < one.len(); i++) { seen = seen | bit(one[i]); }
  t.eqI32(seen, 15, "all four relays appear exactly once");

  // **Which relay comes first** is the part that discriminates. Taking all four is a permutation
  // whatever the starting point, so the assertion above passes for a walk that ignores the target
  // entirely — planting `start = 0` in place of the wrap sentinel survived it. So: compute the
  // target the walk should use, work out which relay ought to be first, and require exactly that.
  u8[] target = hsServiceIndex(blinded, 1, 8, 100);
  t.eqI32(target.len(), 32, "the service index is 32 bytes");
  i32 wantFirst = -1;
  for (i32 i = 3; i >= 0; i--) {
    if (compareIndex(indices[i], target) >= 0) { wantFirst = i; }
  }
  // Nothing at or after the target means the walk wraps to the lowest, which here is relay 0.
  bool wrapped = wantFirst < 0;
  if (wrapped) { wantFirst = 0; }
  t.eqI32(one[0], wantFirst,
          wrapped ? "the target is above every relay, so the walk wraps to the lowest"
                  : "the walk starts at the first relay at or after the target");

  // And both situations are reachable, so this test is not silently only ever checking one of them.
  // Relay indices at 0x10..0x40 leave three quarters of the ring above them, so a handful of
  // different keys covers both sides; assert that rather than assume it.
  i32 sawWrap = 0;
  i32 sawInside = 0;
  for (i32 k = 0; k < 24; k++) {
    u8[] key = u8[32]();
    for (i32 i = 0; i < 32; i++) { key[i] = (i * 11 + k * 37 + 1) & 0xFF; }
    u8[] tgt = hsServiceIndex(key, 1, 8, 100);
    bool above = compareIndex(tgt, indices[3]) > 0;
    if (above) { sawWrap = sawWrap + 1; } else { sawInside = sawInside + 1; }
    i32[] pick = responsibleHsdirs(key, indices, 1, 1, 8, 100);
    t.eqI32(pick.len(), 1, "one replica, spread one, gives one relay");
    i32 expect = -1;
    for (i32 i = 3; i >= 0; i--) {
      if (compareIndex(indices[i], tgt) >= 0) { expect = i; }
    }
    if (expect < 0) { expect = 0; }
    t.eqI32(pick[0], expect, "the single choice is the relay the ring says");
  }
  t.isTrue(sawWrap > 0, "some keys land above every relay, exercising the wrap");
  t.isTrue(sawInside > 0, "and some land inside, exercising the ordinary case");

  // A spread larger than the candidate set returns the set, not a padded list with repeats.
  i32[] over = responsibleHsdirs(blinded, indices, 1, 9, 8, 100);
  t.eqI32(over.len(), 4, "a spread beyond the candidates returns only the candidates");

  // Two replicas of two, over four relays: four distinct choices.
  i32[] two = responsibleHsdirs(blinded, indices, 2, 2, 8, 100);
  t.eqI32(two.len(), 4, "two replicas of two give four");
  i32 seen2 = 0;
  for (i32 i = 0; i < two.len(); i++) { seen2 = seen2 | bit(two[i]); }
  t.eqI32(seen2, 15, "and they are four different relays");

  t.eqI32(responsibleHsdirs(blinded, u8[][0](), 2, 4, 8, 100).len(), 0, "no candidates, no choice");
  t.eqI32(responsibleHsdirs(blinded, indices, 0, 4, 8, 100).len(), 0, "zero replicas is refused");
  t.eqI32(responsibleHsdirs(blinded, indices, 2, 0, 8, 100).len(), 0, "zero spread is refused");
  return t.report();
}

export string test_index_comparison_is_unsigned(Core core, Cli cli) {
  // The indices are 256-bit unsigned numbers held in `u8[]`. If a byte were ever compared as signed,
  // every index with the high bit set would sort below every index without one — half the ring
  // inverted, which still produces a plausible-looking set of directories.
  T t = T.create();
  u8[] low = u8[32]();
  u8[] high = u8[32]();
  high[0] = 0x80;
  t.eqI32(compareIndex(low, high), -1, "0x00... is below 0x80...");
  t.eqI32(compareIndex(high, low), 1, "and 0x80... is above it");
  t.eqI32(compareIndex(high, high), 0, "equal indices compare equal");

  u8[] ff = u8[32]();
  for (i32 i = 0; i < 32; i++) { ff[i] = 0xFF; }
  t.eqI32(compareIndex(ff, high), 1, "0xFF... is the top of the ring");
  t.eqI32(compareIndex(low, ff), -1, "and 0x00... the bottom");

  // The difference must be found at the first differing byte, not the last.
  u8[] a = u8[32]();
  u8[] b = u8[32]();
  a[0] = 1;
  b[31] = 1;
  t.eqI32(compareIndex(a, b), 1, "the most significant byte decides");
  return t.report();
}

export string test_the_disaster_srv_is_deterministic(Core core, Cli cli) {
  // When the consensus carries no shared random value, everyone falls back to a value derived from
  // the period alone. Entirely predictable, and that is the point: an unpredictable fallback would
  // put clients and services on different rings, which is worse than a predictable one.
  T t = T.create();
  u8[] a = disasterSrv(1440, 16903);
  t.eqI32(a.len(), 32, "the disaster SRV is 32 bytes");
  t.isTrue(equal(a, disasterSrv(1440, 16903)), "and is the same every time");
  t.isFalse(equal(a, disasterSrv(1440, 16904)), "the period number changes it");
  t.isFalse(equal(a, disasterSrv(8, 16903)), "the period length changes it");
  return t.report();
}

// ── From a consensus, which is what a client actually has ─────────────────────

export string test_the_directories_are_chosen_from_a_parsed_consensus(Core core, Cli cli) {
  // Everything above works from ed25519 keys handed over directly. A client has a consensus and a
  // pile of microdescriptors, and has to get from those to the same answer — which means parsing the
  // `HSDir` flag out of the consensus and the `id ed25519` line out of a microdescriptor, neither of
  // which is in the other document.
  //
  // This is the same assertion as `we_choose_the_directories_tor_chose`, one layer lower down: the
  // relays tor uploaded to, reached from the bytes a client downloads.
  T t = T.create();
  u8[] consensus = consensusDocument(cli);
  u8[] microdescs = microdescriptors(cli);
  t.isTrue(consensus.len() > 1000, "the vector carries a real consensus");
  t.isTrue(microdescs.len() > 1000, "and the microdescriptors that go with it");

  Relay[] relays = parseConsensus(consensus);
  t.isTrue(relays.len() >= 8, "the consensus parses into relays");
  // Before microdescriptors are attached nothing can be placed on the ring — a client in that state
  // must fetch them rather than compute a ring from the relays it happens to have.
  t.eqI32(hsdirCandidates(relays).len(), 0,
          "with no microdescriptors attached there are no ring candidates");

  attachMicrodescriptors(relays, microdescs);
  i32[] candidates = hsdirCandidates(relays);
  t.isTrue(candidates.len() > HSDIR_N_REPLICAS_DEFAULT * HSDIR_SPREAD_STORE_DEFAULT,
           "after attaching them there are more candidates than slots");

  i32 cases = caseCount(cli);
  for (i32 c = 0; c < cases; c++) {
    u8[] blinded = caseBlinded(cli, c);
    u8[] srv = caseSrv(cli, c);
    i64 tp = caseTimePeriod(cli, c);
    i64 plen = casePeriodLength(cli, c);

    i32[] chosen = hsdirsForDescriptor(relays, blinded, srv, tp, plen,
                                       HSDIR_N_REPLICAS_DEFAULT, HSDIR_SPREAD_STORE_DEFAULT);
    i32 want = caseHsdirCount(cli, c);
    t.eqI32(chosen.len(), want, "case " + itoa64(c as i64) + ": as many directories as tor used");

    i32 missing = 0;
    for (i32 i = 0; i < want; i++) {
      u8[] theirs = caseHsdirEd(cli, c, i);
      bool found = false;
      for (i32 j = 0; j < chosen.len(); j++) {
        if (equal(relays[chosen[j]].ed25519Identity, theirs)) { found = true; }
      }
      if (!found) { missing = missing + 1; }
    }
    t.eqI32(missing, 0,
            "case " + itoa64(c as i64) + ": every directory tor used was chosen from the consensus");
  }
  return t.report();
}

export string test_the_descriptor_path_is_the_one_an_hsdir_answers(Core core, Cli cli) {
  T t = T.create();
  u8[] blinded = caseBlinded(cli, 0);
  string path = descriptorPath(blinded);
  // `/tor/hs/3/<z>`, z being the blinded key in unpadded base64: 32 bytes is 43 characters.
  t.eqI32(path.len(), 10 + 43, "the path is the prefix plus an unpadded base64 key");
  t.isTrue(equal(path.toBytes(), ("/tor/hs/3/" + base64NoPad(blinded)).toBytes()),
           "and it is exactly /tor/hs/3/<z>");
  i32 pad = 0;
  u8[] pb = path.toBytes();
  for (i32 i = 0; i < pb.len(); i++) {
    if (pb[i] == 61) { pad = pad + 1; }
  }
  t.eqI32(pad, 0, "the base64 is unpadded — tor's cache is keyed on the unpadded form");
  t.eqI32(descriptorPath(u8[31]()).len(), 0, "a short key has no path");
  return t.report();
}

export string test_only_flagged_relays_with_an_identity_are_candidates(Core core, Cli cli) {
  // The vector cannot show this: chutney gives every relay the HSDir flag, so on that data the
  // filter is a no-op and removing it changes nothing. Planting `if (true)` in place of the flag
  // check survived every test above, which is how the gap was found.
  //
  // On the real network most relays are not HSDirs, and including one shifts every ring position
  // after it — so the client would ask a set of directories that overlaps tor's by chance and
  // usually fails.
  T t = T.create();
  u8[] ed = u8[32]();
  for (i32 i = 0; i < 32; i++) { ed[i] = (i * 3 + 1) & 0xFF; }

  string[] withFlag = string[]("Fast", "HSDir", "Running");
  string[] without = string[]("Fast", "Running");
  Relay[] relays = Relay[4]();
  relays[0] = Relay("a", u8[20](), "127.0.0.1", 9001, withFlag, "", 0, u8[0](), ed, null, string[0]());
  relays[1] = Relay("b", u8[20](), "127.0.0.1", 9002, without, "", 0, u8[0](), ed, null, string[0]());
  // Flagged, but no microdescriptor attached yet, so it has no ed25519 identity and cannot be placed.
  relays[2] = Relay("c", u8[20](), "127.0.0.1", 9003, withFlag, "", 0, u8[0](), u8[0](), null,
                    string[0]());
  relays[3] = Relay("d", u8[20](), "127.0.0.1", 9004, withFlag, "", 0, u8[0](), ed, null, string[0]());

  i32[] candidates = hsdirCandidates(relays);
  t.eqI32(candidates.len(), 2, "only the flagged relays that can be placed are candidates");
  t.eqI32(candidates[0], 0, "the first is relay a");
  t.eqI32(candidates[1], 3, "and the second is relay d, skipping b and c");

  // A relay with a short identity — a truncated `id ed25519` line — is not a candidate either.
  relays[2].ed25519Identity = u8[31]();
  t.eqI32(hsdirCandidates(relays).len(), 2, "a 31-byte identity is still not placeable");
  return t.report();
}

/**
 * The two descriptors a service publishes, against the two a service actually published.
 *
 * The vector is not a set of parameters: it is two uploads a real tor service made against this
 * consensus, each recorded with the time period and the shared random value tor chose for it. So this
 * asks the only question that matters — given the same consensus, do we choose the same two?
 *
 * A client fetches one descriptor and a service publishes two, under consecutive periods with
 * *different* shared random values. Publishing both under one SRV, or under the wrong pair of
 * periods, produces documents filed under names no client computes: the same silent failure as a
 * wrong blinded key, and invisible to everyone involved.
 */
export string test_a_service_publishes_for_the_two_periods_tor_did(Core core, Cli cli) {
  T t = T.create();
  u8[] consensus = consensusDocument(cli);
  i32 n = caseCount(cli);
  t.isTrue(n >= 2, "the vector records both of a service's uploads");

  StorePeriod[] store = serviceStorePeriods(consensus, true, 0);
  t.eqI32(store.len(), 2, "a service publishes two descriptors, not one");

  for (i32 i = 0; i < 2; i++) {
    t.eqI64(store[i].periodNum, caseTimePeriod(cli, i), "the period tor published under");
    t.eqI64(store[i].periodLength, casePeriodLength(cli, i), "and its length");
    bool wantedCurrent = caseUsedCurrentSrv(cli, i);
    t.isTrue(store[i].useCurrentSrv == wantedCurrent,
             "and the shared random value tor used for it");
  }

  // The two are consecutive, and they differ in their SRV — the older descriptor always takes the
  // previous value and the newer one the current value, whichever pair of periods is in play.
  t.eqI64(store[1].periodNum, store[0].periodNum + 1, "the two periods are consecutive");
  t.isTrue(!store[0].useCurrentSrv, "the first takes the previous shared random value");
  t.isTrue(store[1].useCurrentSrv, "and the second the current one");

  // A consensus with no timings is refused rather than answered from an invented period.
  t.eqI32(serviceStorePeriods("network-status-version 3\n".toBytes(), true, 0).len(), 0,
          "a consensus with no timings yields no periods to publish for");
  return t.report();
}

/**
 * The predicate that decides which pair, on the consensus it was captured from.
 *
 * This consensus falls in the marked stretch, which is why the first period is the one *before* the
 * current one — and why a service that ignored the predicate would have published the current and
 * next periods, missing the period half its clients are still asking under.
 */
export string test_the_stretch_between_a_period_and_an_srv(Core core, Cli cli) {
  T t = T.create();
  u8[] consensus = consensusDocument(cli);
  t.isTrue(betweenTimePeriodAndSrv(consensus, true, 0),
           "this consensus is between a new time period and a new shared random value");

  i64[] now = consensusTimePeriod(consensus, true, 0);
  StorePeriod[] store = serviceStorePeriods(consensus, true, 0);
  t.eqI64(store[0].periodNum, now[0] - 1, "so the first descriptor is for the period that is ending");
  t.eqI64(store[1].periodNum, now[0], "and the second for the one that has begun");

  t.isTrue(!betweenTimePeriodAndSrv("network-status-version 3\n".toBytes(), true, 0),
           "a consensus with no timings is not in the stretch — it is not anywhere");

  // The other side of the boundary, which the captured consensus never reaches. Two faults planted
  // in the start-of-next-period arithmetic — dropping the phase offset, and taking the current period
  // instead of the next — survived every assertion above, because lowering that boundary keeps the
  // answer `true` for a consensus already past it. Only a consensus *before* it tells them apart.
  //
  // 04:00:00 with a twenty-second voting interval is the start of a shared-random protocol run, so it
  // is in the `$====|` stretch rather than the `----` one.
  t.isTrue(!betweenTimePeriodAndSrv(timings("04:00:00", "04:00:20"), true, 0),
           "a consensus at the start of a protocol run is not between a period and an SRV");
  t.isTrue(betweenTimePeriodAndSrv(timings("04:07:00", "04:07:20"), true, 0),
           "and one seven minutes in is");

  // Which pair a service publishes for follows from that, and differs across the boundary in *which*
  // period is first even where the numbers happen to coincide — so the periods are asserted against
  // the current period rather than against constants.
  StorePeriod[] early = serviceStorePeriods(timings("04:00:00", "04:00:20"), true, 0);
  i64 earlyNow = consensusTimePeriod(timings("04:00:00", "04:00:20"), true, 0)[0];
  t.eqI64(early[0].periodNum, earlyNow, "before the boundary a service starts at the current period");
  t.eqI64(early[1].periodNum, earlyNow + 1, "and publishes for the next one too");
  return t.report();
}

/**
 * The whole publication plan, from a consensus and nothing else.
 *
 * Every other test here is handed the shared random value and the time period as inputs. A service
 * has neither: it has a consensus. So this composes the pieces the way a service must — the two store
 * periods, the shared random value that goes with each, and the directories that follow — and
 * requires the result to be the directories tor actually uploaded to, for both descriptors.
 *
 * The pieces were each pinned against tor already and never against each other, which is the seam
 * this package keeps being caught by. Pick the wrong SRV for a period and every ingredient is still
 * correct; the plan is not.
 */
export string test_the_plan_reaches_the_directories_tor_used(Core core, Cli cli) {
  T t = T.create();
  u8[] consensus = consensusDocument(cli);
  Relay[] relays = parseConsensus(consensus);
  attachMicrodescriptors(relays, microdescriptors(cli));

  // The blinded keys are the service's, one per store period, and they are index-matched to the
  // vector's two cases — case 0 is the earlier period, case 1 the later.
  u8[][] blinded = u8[][2]();
  for (i32 i = 0; i < 2; i++) { blinded[i] = caseBlinded(cli, i); }

  Publication[] plan = servicePlan(consensus, relays, blinded, true, 0);
  t.eqI32(plan.len(), 2, "a service plans two uploads");

  for (i32 i = 0; i < 2; i++) {
    t.eqI64(plan[i].periodNum, caseTimePeriod(cli, i), "the period tor used");
    // The shared random value, taken from the consensus rather than handed in. Asserting it directly
    // matters because nothing downstream reveals it: two plans that used different values produce
    // different directories, and a directory list does not say which value produced it.
    t.eqBytes(plan[i].srv, caseSrv(cli, i), "and the shared random value tor used with it");

    i32 want = caseHsdirCount(cli, i);
    t.eqI32(plan[i].hsdirs.len(), want, "as many directories as tor uploaded to");
    i32 missing = 0;
    for (i32 k = 0; k < want; k++) {
      u8[] theirs = caseHsdirEd(cli, i, k);
      bool found = false;
      for (i32 j = 0; j < plan[i].hsdirs.len(); j++) {
        if (equal(relays[plan[i].hsdirs[j]].ed25519Identity, theirs)) { found = true; }
      }
      if (!found) { missing = missing + 1; }
    }
    t.eqI32(missing, 0, "and every one of them is one tor used");
  }

  // The two uploads go to different places. If they did not, publishing twice would be publishing
  // once, and the rotation the second descriptor exists for would protect nothing.
  i32 shared = 0;
  for (i32 a = 0; a < plan[0].hsdirs.len(); a++) {
    for (i32 b = 0; b < plan[1].hsdirs.len(); b++) {
      if (plan[0].hsdirs[a] == plan[1].hsdirs[b]) { shared = shared + 1; }
    }
  }
  t.isTrue(shared < plan[0].hsdirs.len(), "the two descriptors do not go to the same set");
  return t.report();
}

/**
 * With no shared random value in the consensus, the documented fallback — not an empty ring.
 *
 * rend-spec-v3 makes the disaster SRV a fallback rather than an error: a network whose authorities
 * have not agreed still has to be usable, and every party computes the same substitute from the
 * period alone, so they still agree about the ring. A plan that refused here would take a service
 * offline for a condition the protocol expects.
 */
export string test_a_consensus_with_no_srv_falls_back(Core core, Cli cli) {
  T t = T.create();
  u8[] consensus = consensusDocument(cli);
  Relay[] relays = parseConsensus(consensus);
  attachMicrodescriptors(relays, microdescriptors(cli));
  u8[][] blinded = u8[][2]();
  for (i32 i = 0; i < 2; i++) { blinded[i] = caseBlinded(cli, i); }

  // The same timings, with both shared-rand lines gone.
  u8[] bare = timings("04:07:00", "04:07:20");
  Publication[] plan = servicePlan(bare, relays, blinded, true, 0);
  t.eqI32(plan.len(), 2, "a plan is still made");
  for (i32 i = 0; i < 2; i++) {
    t.eqBytes(plan[i].srv, disasterSrv(plan[i].periodLength, plan[i].periodNum),
              "the disaster value for that period is used");
    t.isTrue(plan[i].hsdirs.len() > 0, "and it still names directories");
  }
  t.isTrue(!equal(plan[0].srv, plan[1].srv),
           "the fallback differs per period, so the two uploads still diverge");

  // And it is a fallback, not the default: with a real consensus the real value wins.
  Publication[] real = servicePlan(consensus, relays, blinded, true, 0);
  t.isTrue(!equal(real[0].srv, plan[0].srv), "a consensus that carries a value is not overridden");

  t.eqI32(servicePlan("network-status-version 3\n".toBytes(), relays, blinded, true, 0).len(), 0,
          "but a consensus with no timings yields no plan at all");
  return t.report();
}

/** A consensus with nothing in it but the two timings the ring arithmetic reads. */
u8[] timings(string validAfter, string freshUntil) {
  return ("valid-after 2026-08-05 " + validAfter + "\nfresh-until 2026-08-05 " + freshUntil +
          "\n").toBytes();
}

