// Key blinding's service half, against the keys tor's own `ed25519_keypair_blind` produced.

import { T } from "../../../wactest/src/assert.wac";
import { parse } from "../../../json/src/json.wac";
import { JsonValue, JsonObject, JsonArray } from "../../../json/src/value.wac";
import { decoded } from "../../../codec/src/hex.wac";
import { Files, Sys } from "std";
import { BLIND_PREFIX_STRING, blindedSecretKey } from "../../src/hsblind.wac";
import {
  ed25519ExpandedSecret, ed25519PublicKeyExpanded, ed25519SignExpanded, ed25519Verify,
} from "../../../crypto/src/ed25519.wac";
import { equal } from "../../../bytes/src/slice.wac";
import { flatten } from "core";




/** The blinded secret tor derived, reproduced from the identity secret and the blinding factor. */
/**
 * The blinding vectors, read here rather than handed in — `issues/system/0161` step 4.
 *
 * Everything is hex except `message`, which is the text that was signed. The wrapper also refused
 * to start unless the values came from tor's own blinding and no two cases shared a blinded secret;
 * both are `test_the_vectors_are_what_the_tests_assume` below. The second is the one worth having:
 * two cases sharing a blinded secret would mean the inputs are not reaching the computation, and
 * every case here would still pass.
 */
JsonObject blindTop(Files fs) {
  u8[]? r = flatten(fs.readFile("packages/tor/test/data/blind_vectors.json").wait()).ok();
  if ((r is null)) { trap; }
  JsonValue? v = parse(r!).ok();
  if (v is null) { trap; }
  match (v!) {
    Object(members): { return members; }
    default: { trap; }
  }
}

JsonArray blindCases(Files fs) {
  JsonValue? cs = blindTop(fs).getStr("cases");
  if (cs is null) { trap; }
  match (cs!) {
    Array(items): { return items; }
    default: { trap; }
  }
}

i32 caseCount(Files fs) { return blindCases(fs).len(); }

string textOfObject(JsonObject o, string key) {
  JsonValue? v = o.getStr(key);
  if (v is null) { trap; }
  match (v!) {
    Str(bytes): { return string.fromBytes(bytes); }
    default: { trap; }
  }
}

string fieldOf(Files fs, i32 i, string key) {
  match (blindCases(fs).get(i)) {
    Object(members): { return textOfObject(members, key); }
    default: { trap; }
  }
}

u8[] hexOf(Files fs, i32 i, string key) { return decoded(fieldOf(fs, i, key)); }
u8[] textOf(Files fs, i32 i, string key) { return fieldOf(fs, i, key).toBytes(); }

export string test_the_vectors_are_what_the_tests_assume(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  string source = textOfObject(blindTop(fs), "source");
  t.isTrue(source.indexOf("ed25519_keypair_blind") >= 0,
           "the values must come from tor's blinding, not ours — source is \{source}");
  i32 n = caseCount(fs);
  t.isTrue(n >= 3, "expected several cases, found \{n}");
  for (i32 i = 0; i < n; i++) {
    for (i32 j = i + 1; j < n; j++) {
      t.isFalse(fieldOf(fs, i, "blindedSecret") == fieldOf(fs, j, "blindedSecret"),
                "cases \{i} and \{j}" +
                " share a blinded secret, so the inputs are not being used");
    }
  }
  return t.report();
}

export string test_the_blinded_secret_is_tors(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  i32 n = caseCount(fs);
  t.isTrue(n >= 3, "there are several cases, not one");

  for (i32 i = 0; i < n; i++) {
    u8[] got = blindedSecretKey(hexOf(fs, i, "identitySecret"), hexOf(fs, i, "factor"));
    t.eqI32(got.len(), 64, "the blinded secret is scalar and prefix");
    t.eqBytes(got, hexOf(fs, i, "blindedSecret"), "and it is the one tor derived");
  }
  return t.report();
}

/**
 * The public half follows from the secret, and it is the one a client computes independently.
 *
 * This is the join that makes blinding work at all: a service derives the keypair from its identity
 * secret, a client derives only the public half from the identity *public* key, and the two must
 * agree or the descriptor a service signs is one no client will accept.
 */
export string test_the_public_half_agrees_with_tors(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  i32 n = caseCount(fs);

  for (i32 i = 0; i < n; i++) {
    u8[] blinded = blindedSecretKey(hexOf(fs, i, "identitySecret"),
                                    hexOf(fs, i, "factor"));
    t.eqBytes(ed25519PublicKeyExpanded(blinded), hexOf(fs, i, "blindedPublic"),
              "the public half of our blinded secret is tor's blinded public key");
  }
  return t.report();
}

/**
 * It signs, and tor's own signature verifies against it.
 *
 * A scalar wrong by a factor of the cofactor is still a scalar and still produces sixty-four
 * plausible bytes; comparing keys alone would not tell the two apart. Two directions are checked:
 * tor's signature verifies under the key we derived, and ours verifies under tor's.
 */
export string test_the_blinded_key_signs(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  i32 n = caseCount(fs);

  for (i32 i = 0; i < n; i++) {
    u8[] blinded = blindedSecretKey(hexOf(fs, i, "identitySecret"),
                                    hexOf(fs, i, "factor"));
    u8[] msg = textOf(fs, i, "message");

    // tor signed this message with the key it derived; it must verify under ours.
    t.isTrue(ed25519Verify(ed25519PublicKeyExpanded(blinded), msg, hexOf(fs, i, "signature")),
             "tor's signature verifies under the key we derived");

    // And ours must be tor's exactly — ed25519 is deterministic, so the bytes are comparable.
    t.eqBytes(ed25519SignExpanded(blinded, msg), hexOf(fs, i, "signature"),
              "and our signature with that key is byte-identical to tor's");
  }
  return t.report();
}

/**
 * The identity keypair the vector was built from is the one we would have built.
 *
 * Without this the tests above could pass while agreeing about the wrong starting point — the whole
 * chain would be self-consistent and rooted in a key nobody else has.
 */
export string test_the_identity_key_is_the_seeds(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  i32 n = caseCount(fs);

  for (i32 i = 0; i < n; i++) {
    u8[] expanded = ed25519ExpandedSecret(hexOf(fs, i, "seed"));
    t.eqBytes(expanded, hexOf(fs, i, "identitySecret"),
              "the expanded secret is the seed's own");
    t.eqBytes(ed25519PublicKeyExpanded(expanded), hexOf(fs, i, "identityPublic"),
              "and the identity public key follows from it");
  }
  return t.report();
}

/** Every input matters, and the wrong sizes are refused rather than padded with zeros. */
export string test_blinding_refuses_what_it_should(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  u8[] secret = hexOf(fs, 0, "identitySecret");
  u8[] factor = hexOf(fs, 0, "factor");
  u8[] good = blindedSecretKey(secret, factor);

  t.isTrue(!equal(good, blindedSecretKey(secret, flipScalar(factor))),
           "a different factor gives a different key");
  t.isTrue(!equal(good, blindedSecretKey(flipPrefix(secret), factor)),
           "a different prefix half gives a different key, because the prefix is rehashed");
  t.isTrue(!equal(good, blindedSecretKey(hexOf(fs, 1, "identitySecret"), factor)),
           "another identity gives another key");

  t.eqI32(blindedSecretKey(u8[].filled(32, 0), factor).len(), 0, "a 32-byte secret is not an expanded one");
  t.eqI32(blindedSecretKey(secret, u8[].filled(31, 0)).len(), 0, "a 31-byte factor is not a factor");
  t.eqI32(blindedSecretKey(u8[](), factor).len(), 0, "and nothing is not a secret");

  t.eqStr(BLIND_PREFIX_STRING, "Derive temporary signing key hash input", "tor's own string");
  return t.report();
}

/** Flip a bit that keeps the scalar clamped, so the change is about blinding and not about clamping. */
u8[] flipScalar(u8[] b) {
  u8[] out = u8[].filled(b.len(), 0);
  for (i32 i = 0; i < b.len(); i++) { out[i] = b[i]; }
  out[1] = out[1] ^ 1;
  return out;
}

/** Flip a byte of the prefix half, which only the rehash depends on. */
u8[] flipPrefix(u8[] b) {
  u8[] out = u8[].filled(b.len(), 0);
  for (i32 i = 0; i < b.len(); i++) { out[i] = b[i]; }
  out[40] = out[40] ^ 1;
  return out;
}

