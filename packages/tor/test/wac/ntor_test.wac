// The ntor handshake, checked by the properties a round trip cannot see.
//
// A handshake tested only end to end agrees with itself. That is worth very little here,
// because the two things ntor adds over a bare Diffie-Hellman — authentication of the
// relay, and forward secrecy — are both invisible to "did both sides get the same key".
// So each contribution is removed in turn and the result must change.
//
// The last test is the only one that could notice all of them being consistently wrong, and its
// oracle is tor's own `test-ntor-cl server1` — the relay half of the handshake as the C
// implementation computes it.
//
// ## Why the answers are committed
//
// This used to shell out to the binary and *fail* when it was missing, on the reasoning that a
// differential which silently stops running is worse than one never written. The reasoning was
// right and the implementation was wrong: the binary lived in `/tmp`, so when the container was
// recreated the fixture vanished and this package turned the shared suite red for three agents who
// had not touched it.
//
// "Fail forever" is not the fix for "might silently stop running" — *durable* is. tor's answers are
// recorded in `data/ntor_vectors.json` and committed, so the differential runs on every machine
// with no binary and no network. When the binary *is* present its live answer is used instead, so
// the check also sees changes in tor.
//
// A recorded answer is not weaker than a live one here, which is worth spelling out. Each vector is
// a complete (reply, keys) pair that tor produced, and the assertion is that our client derives
// *those keys* from *that reply*. That is the same assertion either way; the vector is not an
// expected output of our code, it is an input from tor's.
//
// Note the relay's ephemeral key is random, so tor answers differently every run. There is
// deliberately no recorded-versus-live comparison: it would fail every time and mean nothing.
//
// Regenerate with `packages/tor/tools/capture-ntor.wac` after building the binary with
// `tools/tor.sh`.
//
// Host-side until 2026-08-17, `issues/system/0161`.

import { T } from "../../../wactest/src/assert.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { decodeCreated2 } from "../../src/cell.wac";
import { ntorClientRequest, ntorClientFinish, ntorServerRespond } from "../../src/ntor.wac";
import { x25519Base } from "../../../crypto/src/x25519.wac";
import { equal, slice } from "../../../bytes/src/slice.wac";
import { Core, Cli, Exec, Stat, FileResult } from "std/platform.wac";
import { parse } from "../../../json/src/json.wac";
import { JsonValue, JsonArray, JsonObject } from "../../../json/src/value.wac";
import { objectOf, strOf, numOf } from "../../../wactest/src/jsonfile.wac";
import { hex } from "../../../wactest/src/oracle.wac";
import { decoded } from "../../../codec/src/hex.wac";

/**
 * Where the binary lives if it has been built.
 *
 * Under `$HOME` rather than `/tmp`: three agents share this filesystem and `/tmp` does not survive
 * the container being recreated, which is exactly how the old default failed.
 */
string torNtor(Cli cli) {
  u8[]? set = cli.env("TOR_NTOR_CL").wait();
  if (!(set is null)) { return string.fromBytes(set!); }
  u8[]? home = cli.env("HOME").wait();
  string root = home is null ? "" : string.fromBytes(home!);
  return root + "/tor-build/torproject-tor-c8d2b17/src/test/test-ntor-cl";
}

/** The committed answers, as a JSON array — the file's top level is a list, not an object. */
JsonArray recorded(Cli cli) {
  FileResult r = cli.readFile("packages/tor/test/data/ntor_vectors.json").wait();
  if (!r.ok) { return JsonArray.create(); }
  JsonValue? v = parse(r.bytes);
  if (v is null) { return JsonArray.create(); }
  match (v!) {
    case Array(items): { return items; }
    else: { return JsonArray.create(); }
  }
}

/** tor's relay half: `server1 b nodeID msg N` prints the reply then the keys, in hex. */
u8[] runBinary(Cli cli, string path, string b, string id, string msg, i32 keyLen) {
  Exec r = cli.exec(path, string[]("server1", b, id, msg, itoa64(keyLen as i64)), u8[0]()).wait();
  if (r.error != "" || r.status != 0) { return u8[0](); }
  string text = string.fromBytes(r.stdout);
  string joined = "";
  i32 at = 0;
  for (i32 i = 0; i <= text.len(); i++) {
    if (i < text.len() && text.slice(i, i + 1) != "\n") { continue; }
    if (i > at) { joined = joined + text.slice(at, i); }
    at = i + 1;
  }
  return decoded(joined);
}

/**
 * tor's live answer when the binary is here, the recorded one otherwise — never both.
 *
 * The two are not compared. tor picks a fresh ephemeral key for every handshake, so its reply
 * differs on every run and a recorded-versus-live check would fail constantly while detecting
 * nothing. What checks our code is the assertion downstream: derive keys from whichever reply
 * arrived, and require them to equal the keys tor derived alongside it.
 */
u8[] server1(T t, Cli cli, JsonArray vectors, u8[] b, u8[] id, u8[] msg, i32 keyLen) {
  string path = torNtor(cli);
  if (cli.stat(path).wait().exists) {
    return runBinary(cli, path, hex(b), hex(id), hex(msg), keyLen);
  }
  for (i32 i = 0; i < vectors.len(); i++) {
    JsonObject v = objectOf(vectors.get(i));
    if (strOf(v, "b") == hex(b) && strOf(v, "id") == hex(id) && strOf(v, "msg") == hex(msg) &&
        numOf(v, "keyLen") == keyLen) {
      return decoded(strOf(v, "out"));
    }
  }
  t.isTrue(false,
           "no recorded answer for this case and no tor binary at " + path +
           " — build with tools/tor.sh, then re-record with " +
           "packages/tor/tools/capture-ntor.wac");
  return u8[0]();
}

u8[] fill(i32 n, i32 seed) {
  u8[] o = u8[n]();
  for (i32 i = 0; i < n; i++) { o[i] = (i * 41 + seed * 7 + 11) & 0xFF; }
  return o;
}

export string test_both_sides_derive_the_same_keys() {
  T t = T.create();
  u8[] id = fill(20, 1);
  u8[] onionPriv = fill(32, 2);
  u8[] onionKey = x25519Base(onionPriv);
  u8[] clientPriv = fill(32, 3);
  u8[] serverPriv = fill(32, 4);

  u8[] req = ntorClientRequest(id, onionKey, clientPriv);
  t.eqI32(req.len(), 84, "the request is ID || B || X");
  u8[] out = ntorServerRespond(id, onionPriv, req, serverPriv, 72);
  t.eqI32(out.len(), 64 + 72, "the relay returns a reply and its key material");

  u8[] keys = ntorClientFinish(id, onionKey, clientPriv, slice(out, 0, 64), 72);
  t.eqI32(keys.len(), 72, "the client derived key material");
  t.eqBytes(keys, slice(out, 64, out.len()), "and both sides agree");
  return t.report();
}

export string test_the_relay_must_prove_it_holds_the_onion_key() {
  // The authentication half. A relay that cannot compute EXP(B,x) — anyone in the path
  // who is not the relay — produces an AUTH that does not match, and the client must
  // return nothing rather than keys.
  T t = T.create();
  u8[] id = fill(20, 5);
  u8[] onionPriv = fill(32, 6);
  u8[] onionKey = x25519Base(onionPriv);
  u8[] clientPriv = fill(32, 7);
  u8[] req = ntorClientRequest(id, onionKey, clientPriv);
  u8[] good = ntorServerRespond(id, onionPriv, req, fill(32, 8), 72);
  t.eqI32(ntorClientFinish(id, onionKey, clientPriv, slice(good, 0, 64), 72).len(), 72,
          "the genuine reply is accepted");

  // An impostor with its own onion key: the ephemeral exchange still works, so a client
  // that skipped the AUTH check would agree a key with it quite happily.
  u8[] impostorPriv = fill(32, 9);
  u8[] impostor = ntorServerRespond(id, impostorPriv, req, fill(32, 8), 72);
  t.eqI32(ntorClientFinish(id, onionKey, clientPriv, slice(impostor, 0, 64), 72).len(), 0,
          "a relay without the onion key is refused");

  // Every byte of AUTH is checked, not just its shape.
  i32[] spots = i32[](32, 47, 63);
  for (i32 i = 0; i < spots.len(); i++) {
    u8[] bad = u8[64]();
    for (i32 j = 0; j < 64; j++) { bad[j] = good[j]; }
    bad[spots[i]] = bad[spots[i]] ^ 1;
    t.eqI32(ntorClientFinish(id, onionKey, clientPriv, bad, 72).len(), 0,
            "AUTH altered at byte " + itoa64(spots[i] as i64) + " is refused");
  }
  return t.report();
}

export string test_the_identity_is_bound_into_the_keys() {
  // ID goes into secret_input, so a relay answering under a different fingerprint derives
  // different keys even holding the right onion key. That is what stops a relay being
  // used under somebody else's name in the consensus.
  T t = T.create();
  u8[] onionPriv = fill(32, 11);
  u8[] onionKey = x25519Base(onionPriv);
  u8[] clientPriv = fill(32, 12);
  u8[] serverPriv = fill(32, 13);
  u8[] idA = fill(20, 14);
  u8[] idB = fill(20, 15);

  u8[] outA = ntorServerRespond(idA, onionPriv, ntorClientRequest(idA, onionKey, clientPriv),
                                serverPriv, 72);
  u8[] outB = ntorServerRespond(idB, onionPriv, ntorClientRequest(idB, onionKey, clientPriv),
                                serverPriv, 72);
  t.isFalse(equal(slice(outA, 64, outA.len()), slice(outB, 64, outB.len())),
            "a different identity gives different keys");
  // And the client will not accept a reply computed under the other identity.
  t.eqI32(ntorClientFinish(idA, onionKey, clientPriv, slice(outB, 0, 64), 72).len(), 0,
          "a reply bound to another identity is refused");
  return t.report();
}

export string test_every_input_moves_the_key_material() {
  // Forward secrecy lives in the ephemeral pair, so both ephemerals must contribute. An
  // implementation that dropped EXP(Y,x) would still authenticate the relay and still
  // agree a key — one derived only from long-term material, which is exactly the property
  // ntor exists to avoid.
  T t = T.create();
  u8[] id = fill(20, 21);
  u8[] onionPriv = fill(32, 22);
  u8[] onionKey = x25519Base(onionPriv);

  u8[] base = ntorServerRespond(id, onionPriv, ntorClientRequest(id, onionKey, fill(32, 23)),
                                fill(32, 24), 72);
  u8[] otherClient = ntorServerRespond(id, onionPriv,
                                       ntorClientRequest(id, onionKey, fill(32, 25)),
                                       fill(32, 24), 72);
  u8[] otherServer = ntorServerRespond(id, onionPriv,
                                       ntorClientRequest(id, onionKey, fill(32, 23)),
                                       fill(32, 26), 72);
  t.isFalse(equal(slice(base, 64, base.len()), slice(otherClient, 64, otherClient.len())),
            "the client's ephemeral contributes");
  t.isFalse(equal(slice(base, 64, base.len()), slice(otherServer, 64, otherServer.len())),
            "the relay's ephemeral contributes");

  // And key material is a stream: asking for more must extend, not replace.
  u8[] shortKeys = ntorClientFinish(id, onionKey, fill(32, 23), slice(base, 0, 64), 32);
  u8[] longKeys = ntorClientFinish(id, onionKey, fill(32, 23), slice(base, 0, 64), 200);
  t.eqBytes(shortKeys, slice(longKeys, 0, 32), "a longer expansion extends the shorter");
  return t.report();
}

export string test_a_small_order_reply_is_refused() {
  // Curve25519's small-order points make EXP(Y,x) all zero for every x, so an attacker
  // who sends one derives the same keys the client does without holding any private key.
  // tor-spec says abort.
  T t = T.create();
  u8[] id = fill(20, 31);
  u8[] onionPriv = fill(32, 32);
  u8[] onionKey = x25519Base(onionPriv);
  u8[] clientPriv = fill(32, 33);

  u8[] reply = u8[64]();          // Y = all zeros, a small-order point
  t.eqI32(ntorClientFinish(id, onionKey, clientPriv, reply, 72).len(), 0,
          "an all-zero Y is refused");

  u8[] one = u8[64]();
  one[0] = 1;                     // Y = 1, also small order
  t.eqI32(ntorClientFinish(id, onionKey, clientPriv, one, 72).len(), 0,
          "Y = 1 is refused");
  return t.report();
}

/**
 * The whole handshake against tor's own implementation.
 *
 * `ref(b, id, msg, keyLen)` shells out to tor's `test-ntor-cl server1`, which is the
 * relay half of the handshake as the C implementation computes it. It returns the 64-byte
 * reply followed by the key material, so this checks two things at once: that our client
 * accepts a reply produced by tor, and that it derives byte-identical keys.
 *
 * Everything above this point is a relation between our own outputs. This is the only
 * test in the file that could notice all of them being consistently wrong.
 */
export string test_agrees_with_tors_own_implementation(Core core, Cli cli) {
  T t = T.create();
  JsonArray vectors = recorded(cli);
  // The check the old hard-fail was reaching for, kept but made durable. It fails when there is
  // neither a vector nor a binary, and not merely when the binary is absent.
  t.isTrue(vectors.len() > 0 || cli.stat(torNtor(cli)).wait().exists,
           "no ntor vectors are committed and no tor binary is present, so the only " +
           "differential in this file checked nothing");
  for (i32 i = 0; i < 4; i++) {
    u8[] id = fill(20, i + 41);
    u8[] onionPriv = fill(32, i + 42);
    u8[] onionKey = x25519Base(onionPriv);
    u8[] clientPriv = fill(32, i + 43);
    u8[] req = ntorClientRequest(id, onionKey, clientPriv);

    // **92, not 72.** The first 72 bytes are the two digests and the two keys a circuit hop needs;
    // the twenty after them are the nonce tor calls `rend_circ_nonce` and the specification calls KH,
    // which is what ESTABLISH_INTRO's MAC is keyed with. `onion_crypto.c` asks its handshake for
    // `keys_out_len + DIGEST_LEN` and takes the nonce from `keys_tmp + keys_out_len`, so requesting
    // the longer stream from tor's own tool pins both halves at once — and pins that they come from
    // *one* expansion rather than two, which is the thing a service that derived KH separately would
    // get subtly wrong.
    u8[] out = server1(t, cli, vectors, onionPriv, id, req, 92);
    t.isTrue(out.len() == 64 + 92, "tor answered round " + itoa64(i as i64));
    if (out.len() == 64 + 92) {
      u8[] keys = ntorClientFinish(id, onionKey, clientPriv, slice(out, 0, 64), 92);
      t.eqI32(keys.len(), 92, "we accepted tor's reply " + itoa64(i as i64));
      t.eqBytes(keys, slice(out, 64, out.len()),
                "and derived tor's keys and nonce byte for byte " + itoa64(i as i64));
      // Named, so a reader knows where the boundary is and a change to it is visible here.
      t.eqI32(slice(keys, 0, 72).len(), 72, "the first seventy-two are the hop's");
      t.eqI32(slice(keys, 72, 92).len(), 20, "and the last twenty are KH");
    }
  }
  return t.report();
}

/**
 * **A relay choosing the length of its own handshake reply aborted the client.**
 *
 * `ntorClientFinish` refused a reply that is not sixty-four bytes by trapping, and the reply comes
 * straight off the wire: `bootstrap.wac` calls it with `decodeCreated2(cellPayload(cell))` for the
 * guard's CREATED2 and with `extendedReply(got.data)` for the middle and exit relays' EXTENDED2. Both
 * of those return a length **the relay wrote into the cell**.
 *
 * So any relay could end the process of any client that built a circuit through it, and a guard is
 * picked out of a public directory. One cell. No keys, no timing, nothing to guess.
 *
 * **`decodeCreated2`'s own comment had the case exactly inverted**, which is what makes this worth a
 * long note:
 *
 *   > Empty rather than a trap: the relay chose this length, and an empty handshake reply fails
 *   > ntor's AUTH check, which is the right outcome and does not abort the process.
 *
 * Right about the danger, wrong about which value carries it. `HLEN` of zero returns an empty array,
 * and an empty array is not sixty-four bytes, so the graceful case named there was the one that
 * aborted — while `HLEN` of 64 with the wrong bytes was the one that failed gracefully.
 *
 * The fix keeps the other three checks as traps. `identity`, `onionKey` and `ephemeralPriv` are the
 * *caller's* own values, and a caller passing a 31-byte private key has a bug that should stop it.
 * Only `reply` comes from a stranger, and for it the function already had a documented answer: *an
 * empty array if the relay did not prove it holds the onion key*. A reply of the wrong width is a
 * relay that did not prove it.
 */
export string test_a_relay_cannot_choose_the_length_of_its_own_reply() {
  T t = T.create();
  u8[] identity = u8[20](fill: 1);
  u8[] onionKey = u8[32](fill: 2);
  u8[] ephemeral = u8[32](fill: 3);

  // The control: a reply of the right width and the wrong contents fails the AUTH check, which is
  // the graceful refusal this function documents. Without it every assertion below would be
  // satisfied by a function that returned empty for everything.
  t.eqI32(ntorClientFinish(identity, onionKey, ephemeral, u8[64](fill: 0xAB), 72).len(), 0,
          "a 64-byte reply with wrong contents did not fail the AUTH check");

  // Every width a relay could name, including the two the wire makes easiest.
  i32[] widths = i32[](0, 1, 2, 31, 32, 33, 63, 65, 96, 128, 507);
  for (i32 i = 0; i < widths.len(); i++) {
    t.eqI32(ntorClientFinish(identity, onionKey, ephemeral, u8[widths[i]](fill: 0xAB), 72).len(), 0,
            "a reply of " + itoa(widths[i]) + " bytes was not refused");
  }

  // And through the framing a relay actually controls: `decodeCreated2` hands on whatever length the
  // cell's HLEN names, so this is the path rather than a hand-made array.
  i32[] hlens = i32[](0, 10, 63, 64, 65, 400);
  for (i32 i = 0; i < hlens.len(); i++) {
    u8[] payload = u8[509]();
    payload[0] = (hlens[i] >> 8) & 0xFF;
    payload[1] = hlens[i] & 0xFF;
    for (i32 k = 0; k < hlens[i] && 2 + k < 509; k++) { payload[2 + k] = 0xAB; }
    u8[] reply = decodeCreated2(payload);
    t.eqI32(ntorClientFinish(identity, onionKey, ephemeral, reply, 72).len(), 0,
            "a CREATED2 with HLEN " + itoa(hlens[i]) + " was not refused");
  }
  return t.report();
}
