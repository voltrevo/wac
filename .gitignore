node_modules
node_modules/
dist
*.log
*.tsbuildinfo
.cache/

# The demos are build output — `site/tools/syncDemos.ts` writes them from `packages/box` and
# `packages/platform`, and CI runs it on every deploy. Committing them meant a megabyte of
# generated HTML in git that was stale by the next day. The rest of `site/public/` is
# hand-written and stays.
site/public/*.html
site/public/demos.json
# The compiler as a browser asset, written by `site/tools/syncWacc.ts` on every deploy: 389K of
# base64 that is exactly reproducible from `packages/wacc/src`, and stale the moment that changes.
site/public/wacc-api.js
# The bootstrap demo's copy of the compiler, written by `tools/syncBootstrap.ts` on every deploy.
# Same rule, and it was committed anyway: 1.3 MB of `packages/wacc/src` and glue to drive it. It went
# stale for six days — eleven of fifteen sources — because the deploy called `tsc -b` and
# `vite build` directly rather than `npm run build`, which is the only place the regeneration lived.
# A guard would have caught that; not having a copy makes it impossible. If the deploy step fails the
# page reports a failed run, which is the visible half of `issues/system/0146`'s lesson.
site/public/wacc-sources.json
site/public/wacc-glue.js

# cargo's build directory for the native host — 567 MB of it, and every byte reproducible from
# `Cargo.toml` and `Cargo.lock`.
native/target/

# Compiled-module artifacts the wasmtime host caches beside a `.wasm` — see `compiled()` in
# `native/src/main.rs`. Named by a hash of the wasm, so they are per-build and never worth keeping.
*.cwasm-*

# A probe is a throwaway script that has to sit inside the repo to import through the same import
# map the tests do — `probe.ts` and `probe2.ts` were committed by a `git add -A`, and deleting them
# next slot broke `tools/wac/links_test.wac`, which walks every tracked file. Scratch belongs outside git.
probe*.ts
native/seed/
native/spike-v8/target/
