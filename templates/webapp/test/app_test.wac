// The application, driven with no browser: a `Dom` made of lambdas that record what it did, and the
// two calls the browser's side makes — `deliver` for an event — made by hand.

import { Ticket } from "core";
import { Dom, Page, deliver, valueArrived } from "web";
import { main } from "../src/app.wac";

struct Seen {
  string log;
  string typed;
  /** The `getValue` request waiting for an answer, or -1. */
  i32 asked;
}

/** A document that records what the application did to it, and answers what was typed. */
Dom recording(Seen seen) {
  Dom d = Dom.inert();
  d.renderInto = (string id, string html) => { seen.log = seen.log + "into " + id + "=" + html + "\n"; };
  d.setText = (string id, string text) => { seen.log = seen.log + "text " + id + "=" + text + "\n"; };
  d.setValue = (string id, string value) => { seen.typed = value; };
  d.getValue = (i32 req, string id) => { seen.asked = req; };
  return d;
}

/** Answer what the application asked for, as the browser would. */
void answer(Page page, Seen seen) {
  i32 req = seen.asked;
  if (req < 0) { return; }
  seen.asked = -1;
  valueArrived(page, req, seen.typed);
}

/** What the build's wrapper does: the program run with its page as the schedule target. */
Ticket<i32> start(Page page) {
  schedule page.take;
  return main(page);
}

export string test_adding_an_item_lists_it_and_clears_the_input() {
  Seen seen = Seen("", "", -1);
  Page page = Page.create(recording(seen));
  start(page);
  seen.log = "";
  seen.typed = "milk";
  deliver(page, "click", "add", "", 0, 0);
  answer(page, seen);
  string want = "into list=<ul id=\"items\"><li>milk</li></ul>\ntext count=1 to do\n";
  if (seen.log != want) { return "after one add: \{seen.log}"; }
  if (seen.typed != "") { return "the input was not cleared"; }
  seen.typed = "eggs";
  deliver(page, "keydown", "what", "Enter", 0, 0);
  answer(page, seen);
  if (seen.log.indexOf("<li>milk</li><li>eggs</li>") < 0) { return "Enter did not add: \{seen.log}"; }
  return "";
}

export string test_an_empty_input_adds_nothing() {
  Seen seen = Seen("", "", -1);
  Page page = Page.create(recording(seen));
  start(page);
  seen.log = "";
  deliver(page, "click", "add", "", 0, 0);
  answer(page, seen);
  deliver(page, "keydown", "what", "a", 0, 0);
  return seen.log == "" ? "" : "something happened: \{seen.log}";
}
