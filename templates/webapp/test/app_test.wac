// The application, driven with no browser: a `TestDoc` — the document a page draws into, as records — and
// events fired at what the view drew, as a browser fires them.

import { Ticket } from "core";
import { Page, TestDoc } from "web";
import { main } from "../src/app.wac";

/** What the build's wrapper does: the program run with its page as the schedule target, then rendered. */
TestDoc started() {
  TestDoc doc = TestDoc.create();
  Page page = Page.create(doc.dom());
  doc.attach(page);
  schedule page.take;
  Ticket<i32> t = main(page);
  page.drain();
  page.turn();
  return doc;
}

export string test_adding_an_item_lists_it_and_clears_the_input() {
  TestDoc doc = started();
  i32 what = doc.find("id", "what");
  doc.fire(what, "input", "milk");
  doc.fire(doc.find("id", "add"), "click", "");
  string items = doc.shown(doc.find("id", "items"));
  if (items != "milk") { return "after one add: \{items}"; }
  if ((doc.attr(what, ".value") ?? "?") != "") { return "the input was not cleared"; }
  if (doc.shown(doc.find("id", "count")) != "1 to do") { return "count: \{doc.shown(doc.find("id", "count"))}"; }
  doc.fire(what, "input", "eggs");
  doc.fire(what, "keydown", "Enter");
  items = doc.shown(doc.find("id", "items"));
  if (items != "milkeggs") { return "Enter did not add: \{items}"; }
  return "";
}

export string test_an_empty_input_adds_nothing() {
  TestDoc doc = started();
  doc.fire(doc.find("id", "add"), "click", "");
  if (doc.shown(doc.find("id", "items")) != "") { return "something was added"; }
  if (doc.shown(doc.find("id", "count")) != "nothing yet") { return "count: \{doc.shown(doc.find("id", "count"))}"; }
  return "";
}
