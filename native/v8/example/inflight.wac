// Two reads in flight at once — the shape a host cannot serve with a table that answers everything
// before it hands the ticket over.
//
// Both requests are asked before either is waited for, so each is on a thread when the program next
// stops: a synchronous host would have read the first file before the second was even asked for.
// What is checked is that both answers are right, whichever arrives first.

import { flatten } from "core";
import { Files, Sys } from "std";

export i32 main(Sys sys) {
  string[] argv = sys.args();
  if (argv.len() < 2) {
    sys.warn("usage: inflight <a> <b>");
    return 2;
  }
  Files files = sys.files();
  auto first = files.readFile(argv[0]);
  auto second = files.readFile(argv[1]);
  auto ra = flatten(first.wait());
  auto rb = flatten(second.wait());
  sys.log(argv[0] + ": " + (ra.isOk() ? itoa(ra.unwrap().len()) + " bytes" : "failed"));
  sys.log(argv[1] + ": " + (rb.isOk() ? itoa(rb.unwrap().len()) + " bytes" : "failed"));
  return ra.isOk() && rb.isOk() ? 0 : 1;
}

string itoa(i32 v) {
  if (v == 0) { return "0"; }
  if (v < 0) { return "-" + itoa(0 - v); }
  string out = "";
  i32 x = v;
  while (x > 0) { out = string.fromCodepoint('0' + (x % 10)) + out; x = x / 10; }
  return out;
}
