// Take one connection and send back what it says, until the client stops talking.
//
// The smallest thing that needs `recv`: a socket is not a file, so what comes back is a `Read` —
// bytes, or the end, or why it stopped — and the three cases are different answers rather than an
// empty buffer standing in for all of them.

import { Read, flatten } from "core";
import { Listener, Net, Output, Socket, Sys } from "std";

export i32 main(Sys sys) {
  Output err = sys.stderr();
  Output out = sys.stdout();
  string[] argv = sys.args();
  if (argv.len() < 2) {
    err.line("usage: echo <address> <port>");
    return 2;
  }
  Net net = sys.net();
  auto listening = flatten(net.listen(argv[0], atoi(argv[1])).wait());
  if (listening.isErr()) {
    err.line("echo: cannot listen: \{listening.err()!}");
    return 1;
  }
  Listener listener = listening.unwrap();
  out.line("echo: listening on " + itoa(listener.port));

  auto accepted = flatten(listener.accept().wait());
  if (accepted.isErr()) {
    err.line("echo: cannot accept: \{accepted.err()!}");
    return 1;
  }
  Socket peer = accepted.unwrap();
  while (true) {
    auto got = flatten(peer.recv().wait());
    if (got.isErr()) {
      err.line("echo: \{got.err()!}");
      return 1;
    }
    match (got.unwrap()) {
      Data(bytes): {
        out.line("echo: " + itoa(bytes.len()) + " bytes back");
        peer.send(bytes).wait();
      }
      End: {
        out.line("echo: the client hung up");
        peer.close();
        listener.close();
        return 0;
      }
      Failed(why): {
        err.line("echo: " + why);
        return 1;
      }
    }
  }
  return 0;
}

string itoa(i32 v) { if (v == 0) { return "0"; } string o = ""; i32 x = v; while (x > 0) { o = string.fromCodepoint('0' + (x % 10)) + o; x = x / 10; } return o; }
i32 atoi(string s) { u8[] b = s.toBytes(); i32 o = 0; for (i32 i = 0; i < b.len(); i++) { if (b[i] < '0' || b[i] > '9') { return 0; } o = o * 10 + (b[i] as i32 - '0'); } return o; }
