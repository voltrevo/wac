// Take one connection and send back what it says, until the client stops talking.
//
// The smallest thing that needs `recv`: a socket is not a file, so what comes back is a `Read` —
// bytes, or the end, or why it stopped — and the three cases are different answers rather than an
// empty buffer standing in for all of them.

import { Cli, Core, Read, Socket } from "../../../packages/platform/src/platform.wac";

export i32 main(Core core, Cli cli) {
  if (cli.argCount().wait() < 2) {
    core.warn("usage: echo <address> <port>");
    return 2;
  }
  string address = string.fromBytes(cli.arg(0).wait());
  i32 port = atoi(string.fromBytes(cli.arg(1).wait()));

  Socket listener = cli.listen(address, port).wait();
  if (listener.handle < 0) {
    core.warn("echo: cannot listen: " + listener.error);
    return 1;
  }
  core.log("echo: listening on " + itoa(listener.port));

  Socket peer = cli.accept(listener.handle).wait();
  if (peer.handle < 0) {
    core.warn("echo: cannot accept: " + peer.error);
    return 1;
  }
  while (true) {
    Read got = cli.recv(peer.handle).wait();
    match (got) {
      case Data(bytes): {
        core.log("echo: " + itoa(bytes.len()) + " bytes back");
        cli.send(peer.handle, bytes).wait();
      }
      case End: {
        core.log("echo: the client hung up");
        cli.closeSocket(peer.handle);
        cli.closeSocket(listener.handle);
        return 0;
      }
      case Failed(why): {
        core.warn("echo: " + why);
        return 1;
      }
    }
  }
  return 0;
}

string itoa(i32 v) { if (v == 0) { return "0"; } string o = ""; i32 x = v; while (x > 0) { o = string.fromCodepoint('0' + (x % 10)) + o; x = x / 10; } return o; }
i32 atoi(string s) { u8[] b = s.toBytes(); i32 o = 0; for (i32 i = 0; i < b.len(); i++) { if (b[i] < '0' || b[i] > '9') { return 0; } o = o * 10 + (b[i] - '0'); } return o; }
