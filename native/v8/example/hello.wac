// The smallest program that needs a capability: it says something.
//
// `main(Core)` rather than the usual `main(Core, Cli)` because `Cli` is the next slice of the host —
// this one proves the path a capability takes, which is the same for all of them: a funcref made by
// the module's own `$bind$fnref_<j>`, a struct built by its `of`, a call back into Rust through
// `wac.cb<j>`, and a wac string read out of the module's memory.

import { Core } from "std/platform.wac";

export i32 main(Core core) {
  core.log("hello from a Rust host on V8");
  core.warn("and this goes to stderr");
  return 0;
}
