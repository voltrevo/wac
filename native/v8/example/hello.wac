// The smallest program that needs a host: it says something, on each of its two streams.
//
// What it proves is the path every capability takes under the flat ABI (design/system/0013 step 6):
// the host binds four funcrefs through the module's own `$bind$fnref_<j>`, hands them to `__wacHost`,
// and a write comes back to Rust as `request(OP_WRITE_STDOUT, …)` with its answer delivered through
// `__wacAnswered` before the call returns.

import { Sys } from "std";

export i32 main(Sys sys) {
  sys.log("hello from a Rust host on V8");
  sys.warn("and this goes to stderr");
  return 0;
}
