// What a program does with the arguments it was given.
//
// `sys.args()` asks the host for the count and then each argument — requests answered at once, from
// inside `request`, so nothing here waits.

import { Sys } from "std";

export i32 main(Sys sys) {
  string[] argv = sys.args();
  sys.log("argc " + itoa(argv.len()));
  for (i32 i = 0; i < argv.len(); i++) {
    sys.log("arg " + itoa(i) + ": " + argv[i]);
  }
  sys.stdout().write("and this went to stdout directly\n".toBytes());
  return 0;
}

string itoa(i32 v) {
  if (v == 0) { return "0"; }
  string out = "";
  i32 x = v;
  while (x > 0) { out = string.fromCodepoint('0' + (x % 10)) + out; x = x / 10; }
  return out;
}
