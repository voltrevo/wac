// A directory's names, sorted.
//
// A directory with nothing in it and no directory at all are different answers — an empty list, and
// a `LookFault` saying which failure — and both are printed rather than collapsed, because a host that
// cannot tell them apart makes every program that asks take the wrong branch.

import { flatten } from "core";
import { Sys } from "std";

export i32 main(Sys sys) {
  string[] argv = sys.args();
  string where = argv.len() > 0 ? argv[0] : ".";
  auto names = flatten(sys.files().readDir(where).wait());
  if (names.isErr()) {
    sys.warn("list: cannot read " + where + ": \{names.err()!}");
    return 1;
  }
  string[] found = names.unwrap();
  for (i32 i = 0; i < found.len(); i++) { sys.log(found[i]); }
  return 0;
}
