// The site, written in wac: `export async i32 main(Page page)`, built by `packages/web/tools/build.wac`.
//
// **Routing is the location hash**, as it was on the React site, so every link written to that one still
// lands: `#/<page>/<heading>`, except the spec, which has a chapter between the two —
// `#/spec/<chapter>/<heading>`. The page follows `page.location()`; a link is an ordinary `<a href="#/…">`,
// and the browser's back and forward work because they move the hash and nothing else.
//
// **A page not ported yet says so and links to the React site's**, which is where it still lives:
// a route that silently fell back to the front page is the failure the moved-routes table below exists
// to prevent, one layer up.

import { Vec } from "core";
import { Node, Page, Ui } from "../../packages/web";
import { NotYet } from "./ui.wac";
import { Bootstrap } from "./bootstrap.wac";
import { Checked } from "./checked.wac";
import { Home } from "./home.wac";
import { Language } from "./language.wac";
import { Roadmap } from "./roadmap.wac";
import { Run } from "./run.wac";
import { Stack } from "./stack.wac";
import { Start } from "./start.wac";

/** A location, taken apart: the page, the spec's chapter when it is the spec, and the heading. */
export struct Where {
  string route;
  string chapter;
  string anchor;
}

/** Whether `r` is one of `routes()`. */
bool known(string r) {
  string[] all = routes();
  for (string one in all) { if (one == r) { return true; } }
  return false;
}

/**
 * Where the site before this one sent people, for links written before it did: `#/built` was the package
 * inventory and `#/showcase` the case studies, and both are `#/stack` now. Without this an old link
 * resolves to nothing and lands on the front page — silently, because an unknown route falls back
 * rather than failing.
 */
string moved(string r) {
  if (r == "built" || r == "showcase") { return "stack"; }
  return r;
}

/** `"/spec/strings/indexing"` taken apart. An unknown page is the front page. */
export Where parse(string location) {
  string[] parts = splitOn(location, "/");
  // The hash is `#/stack/…`, so the first part is the empty one before the slash.
  i32 at = parts.len() > 0 && parts[0] == "" ? 1 : 0;
  string first = at < parts.len() ? moved(parts[at]) : "";
  string second = at + 1 < parts.len() ? parts[at + 1] : "";
  string third = at + 2 < parts.len() ? parts[at + 2] : "";
  if (!known(first)) { return Where("", "", ""); }
  if (first == "spec") { return Where(first, second, third); }
  return Where(first, "", second);
}

/** `s` cut at every `sep`: `"/a/b"` is `["", "a", "b"]`. */
string[] splitOn(string s, string sep) {
  Vec<string> out = Vec.create();
  string rest = s;
  i32 at = rest.indexOf(sep);
  while (at >= 0) {
    out.push(rest.slice(0, at));
    rest = rest.slice(at + sep.len(), rest.len());
    at = rest.indexOf(sep);
  }
  out.push(rest);
  string[] all = string[].filled(out.len(), "");
  for (i32 i = 0; i < out.len(); i++) { all[i] = out.get(i); }
  return all;
}

/** The site: the page the location names, scrolled to the heading it names. */
export Node App(Ui ui, Page page) {
  auto at = ui.state(page.location());
  ui.effect("", () => page.onLocation((string where) => { at.set(where); }));
  Where w = parse(at.get());
  // After the render the location changed: the heading it names, or the top of the new page. The spec
  // scrolls itself, once its chapter has arrived.
  ui.effect(at.get(), () => {
    if (w.route != "spec") {
      if (w.anchor == "") { page.root().scrollIntoView(); } else { page.root().scrollToId(w.anchor); }
    }
    return () => { };
  });
  return pageOf(w);
}

/** The routes this site answers, the front page's being empty — for a test that visits every one. */
export string[] routes() {
  return ["", "start", "language", "run", "bootstrap", "stack", "checked", "roadmap", "spec", "playground"];
}

/** What the location `w` shows. */
export Node pageOf(Where w) {
  string r = w.route;
  if (r == "") { return <Home/>; }
  if (r == "start") { return <Start/>; }
  if (r == "language") { return <Language/>; }
  if (r == "run") { return <Run/>; }
  if (r == "stack") { return <Stack/>; }
  if (r == "bootstrap") { return <Bootstrap/>; }
  if (r == "checked") { return <Checked/>; }
  if (r == "roadmap") { return <Roadmap/>; }
  return <NotYet route={r}/>;
}

export async i32 main(Page page) {
  page.title("wac — a language, and the stack being rebuilt in it");
  page.mount((Ui ui) => <App page={page}/>);
  return 0;
}
