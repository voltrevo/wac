// The site, as `build.wac` writes it: every page renders from the tree's own figures, every link from one
// page to another names a file the build writes — or a demo or the playground written beside them — and
// every heading a link names is one that page draws.
//
// **A link to a heading that is not there is the failure this exists for.** The browser follows it
// without complaint — the page opens at its top — and nothing about the page that wrote it looks wrong.

import { Change, Exec, Stat, ChildEnv, Env, Files, Launch, Procs, Sys } from "std";
import { Vec, flatten } from "core";
import { T } from "../../../packages/wactest/src/assert.wac";
import { Attr, Node } from "../../../packages/web";
import { Doc } from "../ui.wac";
import { Figures, readFigures } from "../figures.wac";
import { readSpec } from "../spec.wac";
import { demos } from "../run.wac";
import { redirectScript, site } from "../build.wac";
import { EX_L2, EX_L3, EX_L4, EX_L5 } from "../bootstrap.wac";
import { EX_GREET, SEED_KB } from "../home.wac";
import { EX_START_HELLO } from "../start.wac";
import { EX_ARRAYS, EX_CONST, EX_CORE_LIB, EX_CORE_MAIN, EX_ENUM, EX_GENERIC, EX_HELLO, EX_MATH, EX_NULLABLE, EX_STRUCT,
         EX_UNION } from "../snippets.wac";
import { filesUnder, newlines, readText } from "../figures.wac";
import { wacBinary } from "../../../packages/wactest/src/built.wac";

/** Every `href` under `n`. */
void linksIn(Node n, Vec<string> into) {
  match (n) {
    Element(tag, attrs, on, kids, ref): {
      for (Attr a in attrs) { if (a.name == "href") { into.push(a.value); } }
      for (Node k in kids) { linksIn(k, into); }
    }
    Fragment(kids): { for (Node k in kids) { linksIn(k, into); } }
    Text(s): { }
    Component(name, key, draw, snaps, same): { }
  }
}

/** Every `id` under `n`. */
void idsIn(Node n, Vec<string> into) {
  match (n) {
    Element(tag, attrs, on, kids, ref): {
      for (Attr a in attrs) { if (a.name == "id") { into.push(a.value); } }
      for (Node k in kids) { idsIn(k, into); }
    }
    Fragment(kids): { for (Node k in kids) { idsIn(k, into); } }
    Text(s): { }
    Component(name, key, draw, snaps, same): { }
  }
}

bool has(Vec<string> v, string s) {
  for (i32 i = 0; i < v.len(); i++) { if (v.get(i) == s) { return true; } }
  return false;
}

Doc[] built(Files fs) { return site(readFigures(fs, "."), readSpec(fs, ".")); }

export string test_the_figures_are_the_trees(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  Figures F = readFigures(fs, ".");
  t.isTrue(F.totals.packages > 30 && F.built.len() == F.totals.packages,
           "MAP.md's package count is its rows: \{F.totals.packages} and \{F.built.len()}");
  t.isTrue(F.totals.lines > 100000 && F.totals.tests > 1000, "and its totals parsed: \{F.totals.lines} lines, \{F.totals.tests} tests");
  t.isTrue(F.totals.testsAll > F.totals.tests, "the whole repository has more tests than its packages");
  t.isTrue(F.totals.corpus > 900 && F.totals.applets > 60 && F.totals.wacTests > 600,
           "the corpus, the applets and the wac test files are counted: \{F.totals.corpus}, \{F.totals.applets}, \{F.totals.wacTests}");
  t.isTrue(F.spec.examples > 400 && F.spec.met <= F.spec.examples, "the spec's status is summed: \{F.spec.met} of \{F.spec.examples}");
  return t.report();
}

export string test_every_link_between_pages_lands_on_a_file_and_a_heading_it_draws(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  Doc[] docs = built(fs);
  Vec<string> beside = Vec.create();
  for (string f in demos()) { beside.push(f); }
  i32 named = 0;
  for (Doc d in docs) {
    Vec<string> links = Vec.create();
    linksIn(d.body, links);
    for (i32 i = 0; i < links.len(); i++) {
      string link = links.get(i);
      if (link.indexOf("https://") == 0 || link.indexOf("http://") == 0 || link.indexOf("playground/") == 0) { continue; }
      i32 hash = link.indexOf("#");
      string file = hash < 0 ? link : link.slice(0, hash);
      string anchor = hash < 0 ? "" : link.slice(hash + 1, link.len());
      if (file == "") { file = d.file; }
      if (has(beside, file)) { continue; }
      Doc? target = null;
      for (Doc o in docs) { if (o.file == file) { target = o; } }
      if (target is null) {
        t.isTrue(false, d.file + " links to " + link + ", and the site has no " + file);
        continue;
      }
      if (anchor == "") { continue; }
      Vec<string> ids = Vec.create();
      idsIn(target!.body, ids);
      t.isTrue(has(ids, anchor), d.file + " links to " + link + ", and " + file + " draws no heading " + anchor);
      named++;
    }
  }
  t.isTrue(named > 10, "links name headings, or this checked nothing: \{named}");
  return t.report();
}

export string test_no_page_draws_one_id_twice(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  for (Doc d in built(fs)) {
    Vec<string> ids = Vec.create();
    idsIn(d.body, ids);
    for (i32 i = 0; i < ids.len(); i++) {
      for (i32 j = 0; j < i; j++) {
        t.isTrue(ids.get(i) != ids.get(j), d.file + " draws the id " + ids.get(i) + " twice");
      }
    }
  }
  return t.report();
}

export string test_the_redirect_knows_every_page_but_the_spec_by_name() {
  T t = T.create();
  string js = redirectScript();
  for (string r in ["start", "language", "run", "stack", "bootstrap", "checked", "roadmap"]) {
    t.isTrue(js.indexOf("\"" + r + "\": \"" + r + ".html\"") >= 0, "an old #/" + r + " link goes to " + r + ".html");
  }
  t.isTrue(js.indexOf("\"built\": \"stack.html\"") >= 0, "and #/built, which moved, to the stack");
  t.isTrue(js.indexOf("spec-${second}.html") >= 0, "a chapter of the spec to its file");
  return t.report();
}

/** `wac check` of `files` (names and texts) written under `dir`, entry first: what it said, or "" when clean. */
string checks(Env env, Files fs, Procs procs, string dir, string[] names, string[] texts) {
  fs.mkdir(dir, true).wait();
  for (i32 i = 0; i < names.len(); i++) { fs.writeFile(dir + "/" + names[i], texts[i].toBytes()).wait(); }
  auto rRan = flatten(procs.exec(wacBinary(env), ["check", dir + "/" + names[0]], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? r = rRan.ok();
  if ((r is null)) { return "could not run wac: " + "\{rRan.isErr() ? "\{rRan.err()!}" : ""}"; }
  return r!.status == 0 ? "" : string.fromBytes(r!.stdout) + string.fromBytes(r!.stderr);
}

/**
 * **The programs the pages invite a reader to run compile.** Each is a claim about the compiler, and the
 * front page's is the most embarrassing one on the site to have broken. The core pair is a claim too:
 * neither file declares `Read` and they still meet through it, which only a compile can check.
 */
export string test_the_pages_runnable_snippets_compile(Sys sys) {
  Env env = sys.env();
  Files fs = sys.files();
  Procs procs = sys.procs();
  T t = T.create();
  string[] names = ["EX_GREET", "EX_HELLO", "EX_L5", "EX_START_HELLO", "EX_MATH", "EX_STRUCT", "EX_CONST", "EX_NULLABLE",
                    "EX_ENUM", "EX_UNION", "EX_GENERIC", "EX_ARRAYS"];
  string[] texts = [EX_GREET, EX_HELLO, EX_L5, EX_START_HELLO, EX_MATH, EX_STRUCT, EX_CONST, EX_NULLABLE, EX_ENUM,
                    EX_UNION, EX_GENERIC, EX_ARRAYS];
  for (i32 i = 0; i < names.len(); i++) {
    string said = checks(env, fs, procs, ".cache/site-snippets/" + names[i], ["a.wac"], [texts[i]]);
    t.eqStr(said, "", names[i] + " compiles");
  }
  t.eqStr(checks(env, fs, procs, ".cache/site-snippets/core", ["main.wac", "report.wac"], [EX_CORE_MAIN, EX_CORE_LIB]), "",
          "the core snippets are one program");
  return t.report();
}

/**
 * **The rung excerpts are quotations**, and each names the file it came from: somebody tidies a rung and
 * the page goes on showing what it used to say. Compiling them is not the check — L2 to L4 are not wac,
 * and a compiler that accepted them would be the thing going wrong.
 */
export string test_the_ladder_pages_rung_excerpts_are_verbatim(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  string[] excerpts = [EX_L2, EX_L3, EX_L4];
  string[] files = ["l3.l2", "l4.l3", "l5.l4"];
  for (i32 i = 0; i < 3; i++) {
    t.isTrue(readText(fs, "bootstrap/boot/" + files[i]).indexOf(excerpts[i]) >= 0,
             "EX_L\{i + 2} is verbatim in bootstrap/boot/" + files[i]);
  }
  return t.report();
}

/** Every `wac <word>` the pages print as code: in `<m>…</m>`, between backticks, or in a code block. */
void commandWords(string src, Vec<string> into) {
  for (string open in ["<m>wac ", "`wac ", "\n  $ wac ", "\n    $ wac "]) {
    i32 at = src.indexOf(open);
    while (at >= 0) {
      i32 from = at + open.len();
      i32 end = from;
      u8[] b = src.toBytes();
      while (end < b.len() && b[end] >= 'a' && b[end] <= 'z') { end++; }
      // A file is not a subcommand: `wac hello.wasm` runs a module.
      bool file = end < b.len() && (b[end] == '.' || b[end] == '_' || (b[end] >= '0' && b[end] <= '9'));
      if (end > from && !file) {
        string w = src.slice(from, end);
        if (!has(into, w)) { into.push(w); }
      }
      i32 next = src.slice(from, src.len()).indexOf(open);
      at = next < 0 ? 0 - 1 : from + next;
    }
  }
}

/**
 * **Every command spelling the site prints is one the CLI chapter names.** `wac uninstall` became
 * `wac self uninstall` and the site printed the old spelling in two places; a reader who typed it got
 * `unknown command`. Only what is marked as code — the pages say "wac is" in prose all over.
 */
export string test_the_command_spellings_the_site_prints_are_the_cli_pages(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  string chapter = readText(fs, "spec/8-tooling/45-cli.md");
  Vec<string> words = Vec.create();
  for (string f in filesUnder(fs, "site/wac")) {
    if (f.indexOf("/test/") < 0 && f.indexOf(".wac") == f.len() - 4) { commandWords(readText(fs, f), words); }
  }
  t.isTrue(words.len() >= 3, "the pages print commands, or this read nothing: \{words.len()}");
  for (i32 i = 0; i < words.len(); i++) {
    t.isTrue(chapter.indexOf("wac " + words.get(i)) >= 0,
             "the site prints `wac " + words.get(i) + "`, which spec/8-tooling/45-cli.md does not name");
  }
  return t.report();
}

/**
 * **Every repository path the site links to is in the tree** — `BLOB + "/path"` and `TREE + "/path"`,
 * written as literals. The links are public and a dead one is a 404 for anyone who follows it.
 */
export string test_every_repository_path_the_site_links_to_is_in_the_tree(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  i32 seen = 0;
  for (string f in filesUnder(fs, "site/wac")) {
    if (f.indexOf("/test/") >= 0) { continue; }
    string src = readText(fs, f);
    for (string open in ["BLOB + \"/", "TREE + \"/"]) {
      i32 at = src.indexOf(open);
      while (at >= 0) {
        i32 from = at + open.len();
        i32 end = from + src.slice(from, src.len()).indexOf("\"");
        string path = src.slice(from, end);
        i32 hash = path.indexOf("#");
        if (hash >= 0) { path = path.slice(0, hash); }
        if (path != "") {
          Stat? st = flatten(fs.stat(path).wait()).ok();
          t.isTrue((st is not null), f + " links to " + path + ", which is not in the tree");
          seen++;
        }
        i32 next = src.slice(end, src.len()).indexOf(open);
        at = next < 0 ? 0 - 1 : end + next;
      }
    }
  }
  t.isTrue(seen > 5, "the site links into the tree, or this read nothing: \{seen}");
  return t.report();
}

/**
 * **The seed's size the front page types is the seed's, within a tenth.** It moves with every change to
 * the compiler, so it is rounded and checked rather than exact. The seed is one per checkout and
 * gitignored, so a checkout without one cannot answer — which is not a failure.
 */
export string test_the_seed_size_the_front_page_states_is_the_seeds(Sys sys) {
  Files fs = sys.files();
  T t = T.create();
  Stat? st = flatten(fs.stat("native/v8/seed/wacc.wasm").wait()).ok();
  if ((st is null)) { return t.report(); }
  i32 kb = (st!.size / (1000 as i64)) as! i32;
  i32 said = 0;
  for (u8 c in SEED_KB.toBytes()) { if (c >= '0' && c <= '9') { said = said * 10 + (c - '0') as i32; } }
  t.isTrue(kb * 10 >= said * 9 && kb * 10 <= said * 11,
           "the front page says the seed is " + SEED_KB + "; native/v8/seed/wacc.wasm is \{kb} KB");
  return t.report();
}
