// The front page.
//
// The sequence, settled over several mockups with the operator: the wordmark, one sentence, then
// *the shell* — a real one — then the honesty about what it is not yet, then one program, then Tor,
// Ethereum, and every package.
//
// The shell comes before the code on purpose. A reader who has seen a hundred language sites is not
// moved by a tour; they are moved by typing into something that could not exist unless the claims
// were true. And it is introduced as *wacland* rather than as a demo, because the point is not that
// a terminal is on the page — it is that the shell, the applets and the filesystem are all wac.
//
// **The shell opens on a page of its own here**, where the React site embedded it: a page in wac
// cannot make an `<iframe>` (`packages/web` refuses it, and so does the policy), so the session is
// printed and the link opens the real one.
//
// Written for somebody who assumes there is nothing behind a language site: no superlatives, every
// number checkable, and the unflattering parts kept.

import { Node, html.a, html.div, html.em, html.h1, html.p, html.pre, html.span } from "../../packages/web";
import { A, Caveat, Code, Fact, Facts, Frame, Lead, P, Runnable, Section, TREE, Table, m, t } from "./ui.wac";
import { BuiltPackage, SpecStatus, Totals, built, specStatus, totals } from "./built.wac";

/**
 * The bootstrap, as the suite reports it — `packages/wacc/test/wac/selfhostemit_test.wac`.
 *
 * **The two figures are typed here and go stale.** The size is rounded on purpose, because it moves
 * with every change to the compiler; `wac task seed` prints it to the byte on every rebuild, and it
 * is a fixed point, checked rather than asserted. What the block is really claiming is the word at
 * the end of the line.
 */
static string BOOTSTRAP = """
  wac-L0 .. L5   five rungs, the lowest hand-written wasm assembly text
  stage A        wacc, built by wac-L5
  stage B        wacc, built by stage A
  stage C        wacc, as stage B compiles it

  B == C         30 sources, 3,333 KB, identical""";

/** A command the terminal shows, and what it prints. */
struct Said {
  string cmd;
  string out;
}

/**
 * The commands the terminal shows, and what they print — the same three as the React site's
 * `TRANSCRIPT`, which `packages/box/test/wac/frontpage_test.wac` runs through the shell.
 */
Said[] transcript() {
  return [
    Said("seq 1 20 | grep 7 | wc -l", "2"),
    Said("echo 'a whole new stack' | gzip -c | wc -c", "41"),
    Said("echo hello | sha256sum", "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03  -"),
  ];
}

/**
 * One program, compiled and run before it was put here. A name that may be absent, and what to say
 * when it is: `string?` and `??`. The commented line is the invitation.
 */
static string EX_HELLO = """
  export string greet() {
    string? name = null;
    // string? name = "Alice and Bob";

    return "Hello, \\{name ?? "world"}!";
  }""";

/**
 * The install line. `--host deno` rather than the default on purpose: it is the line that works for
 * the most people — no Rust, no C++ toolchain, no npm — and the default is one sentence away.
 */
static string GET_IT = """
  $ curl -fsSL https://raw.githubusercontent.com/voltrevo/wac/master/bootstrap.sh \\
      | sh -s -- --host deno""";

/** `n` with a comma every three digits, as the React site's `toLocaleString` wrote it. */
string commas(i32 n) {
  string s = "\{n}";
  string out = "";
  i32 len = s.len();
  for (i32 i = 0; i < len; i++) {
    if (i > 0 && (len - i) % 3 == 0) { out = out + ","; }
    out = out + s.slice(i, i + 1);
  }
  return out;
}

/** The session the shell opens on, printed. */
Node Terminal() {
  Said[] said = transcript();
  Node[] lines = Node[].filled(said.len(), <></>);
  for (i32 i = 0; i < said.len(); i++) {
    lines[i] = <span><span class="prompt">$</span> {said[i].cmd}{"\n"}{said[i].out}{"\n"}</span>;
  }
  return <div class="term">
    <div class="bar">
      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
      <span class="name">wacland · in your browser</span>
    </div>
    <div class="screen">
      <pre>{lines}</pre>
      <div class="opens">
        The shell opens on its own page, a wac program in a worker of its own:{" "}
        <A href="./shell.html">open it and type →</A>
      </div>
    </div>
  </div>;
}

/** Every package, in dependency order, and the total. */
Node[][] packageRows(Totals T) {
  BuiltPackage[] ps = built();
  Node[][] rows = Node[][].filled(ps.len() + 1, Node[]());
  for (i32 i = 0; i < ps.len(); i++) {
    BuiltPackage p = ps[i];
    rows[i] = [
      <a class="pkg" href={TREE + "/packages/" + p.name} target="_blank" rel="noopener">{p.name}</a>,
      <span class="dim">{p.what}</span>,
      <span class="num">{commas(p.lines)}</span>,
      <span class="num">{p.tests}</span>,
    ];
  }
  rows[ps.len()] = [
    <span class="num total">total</span>,
    t(""),
    <span class="num total">{commas(T.lines)}</span>,
    <span class="num total">{commas(T.tests)}</span>,
  ];
  return rows;
}

export Node Home() {
  Totals T = totals();
  SpecStatus SPEC = specStatus();
  return <Frame current="" contents={false} css={CSS}>
    <div class="hero">
      <div class="rule"></div>
      <div>
        <h1><span class="dollar">$</span> <span class="grad">wac</span><span class="cur">_</span></h1>
        <p class="tagline">A C-family language for WebAssembly GC — and a whole new stack written in it.</p>
      </div>
    </div>

    <Section id="wacland" kicker="start here" title="Meet wacland: userland written in wac">
      <P>
        A shell, {T.applets} applets and a filesystem, running on a worker in a browser tab — and{" "}
        <Lead>all of it is wac</Lead>. Not busybox compiled to wasm, not a libc port, not wac glue
        around somebody else’s binaries: it is <m>packages/sh</m> itself, the
        same program that runs on a command line, and the only thing underneath it is the compiler.
      </P>
      <Terminal/>
      <Caveat title="what is missing">
        No supervision: <m>init</m> starts services and never stops one, with no
        restart policy, no dependency order and no readiness. Sealing a session off from the
        machine is tested rather than finished — turning spawning on still turns up leaks. There
        is no package manager, and no way to install anything into a session that is not built
        into it.
      </Caveat>
      <P>
        <span class="aside">
          <m>sort</m>, <m>sha256sum</m>, <m>gzip</m>,{" "}
          <m>diff</m>, <m>tar</m>, <m>nc</m> — with
          pipelines, loops, variables and redirection into a filesystem that survives a reload.
          The shell agrees with GNU bash on <Lead>{T.corpus} differential scripts</Lead>, on
          standard output and exit status. <A href="#/run">Two more running here →</A>
        </span>
      </P>
    </Section>

    <Section id="get" kicker="and you can have it" title="One line, no clone, no Rust">
      <Code label="puts `wac` on your PATH" lang="text" code={GET_IT}/>
      <P>
        It builds the compiler from source through the ladder, so there is no seed to fetch and
        nothing from npm. Drop the <m>-s -- --host deno</m> for the default, a native
        binary on V8, which is faster and needs cargo and a C++ toolchain — every host carries the
        same command. <A href="#/start">Using it in a project of your own →</A>
      </P>
    </Section>

    <Section id="language" kicker="and this is the language it is written in" title="Edit it, and press run">
      <P>
        Curly braces, <m>if</m> and <m>for</m>, structs and enums —
        and a type checker that will not let a <m>match</m> miss a case or a null go
        unchecked. Generics cost nothing at runtime. The collector is the platform’s own, so
        there is no allocator to write and no linear memory to manage.
      </P>
      <Runnable code={EX_HELLO}/>
      <P>
        <span class="aside">
          No headers, no build system, no package manager: a file imports another file, and{" "}
          <m>core</m> is the only thing the compiler ships. Nothing to install.{" "}
          <A href="#/language">The rest of the language →</A>
        </span>
      </P>
    </Section>

    <Section id="wacc" kicker="one of them, in full" title="The compiler, written in wac">
      <P>
        <Lead>wac is self-hosted, and there is no seed.</Lead>{" "}
        <m>packages/wacc</m> is the compiler, written in wac —{" "}
        <Lead>~61,000 lines</Lead> — and it is what builds everything here: the packages, the
        programs, the demos on this page. It grew out of a compiler written in TypeScript, which
        was the seed until 2026-08-28 and is deleted. What builds wacc now is a ladder of five
        rungs whose lowest is hand-written wasm assembly text, so nothing here starts from a
        binary somebody compiled once and checked in.
      </P>
      <Code label="wacc compiling itself" lang="text" code={BOOTSTRAP}/>
      <P>
        Those two figures are read from the suite and typed here, so they are a snapshot; the same
        chain <A href="./#/run/bootstrap">runs in your browser</A> on the Run page, where the byte
        count is whatever your machine just produced rather than whatever was true when this
        sentence was written.
      </P>
      <P>
        It is measured against the specification rather than against the other compiler. The
        spec is written as <Lead>{SPEC.examples} example programs</Lead>, each with its outcome
        above it, and the suite compiles every one: it meets <Lead>{SPEC.met}</Lead>, and{" "}
        <A href="#/spec">the spec pages</A> mark each verdict beside its program. Beside them is a
        corpus of cases in <m>spec/cases</m> — programs the language must refuse,
        answers it must give, places it must trap — and it passes all of them, with no list of
        known misses to hide one in.
      </P>
      <P>
        <Lead>A false alarm is the number that matters.</Lead> A checker reporting less than the
        spec can be finished; one that reports what the spec does not cannot be trusted at all.
        The worst of these was a flag that answered both <em>may I write through this</em> and{" "}
        <em>may I rebind this name</em>, which made every linked-list walk in the specification
        illegal. The answer was to put <m>const</m> in the type, where a cursor is
        written <m>(const Node)? cur</m>.
      </P>
      <Caveat title="not finished">
        Every file in the corpus compiles whole now — it was 27 short of 729 five days ago — and
        none of that sweep produced an invalid module. What is not finished is the
        reach: when the emitter does stop, it says which feature stopped it rather than emitting
        something that fails later. And the way back is closing:{" "}
        <m>box</m> no longer builds with the seed at all, because the shell’s
        compression library uses instructions only wacc has.
      </Caveat>
      <P>
        <span class="aside"><A href="#/stack/wacc">How the compiler is checked →</A></span>
      </P>
    </Section>

    <Section id="tor" kicker="and another" title="Tor">
      <P>
        A client that verifies a consensus and builds circuits; a SOCKS5 proxy; a relay; a
        directory authority; onion services. On this repository’s own TLS 1.3, on its own
        crypto, with nothing borrowed from the C implementation but the specification.
      </P>
      <P>
        The strongest evidence is somebody else’s client. An unmodified{" "}
        <m>curl</m>, through our SOCKS proxy, fetching a page from an onion service{" "}
        <em>we host</em>:
      </P>
      <Code label="curl, our proxy, our relays, our onion service" lang="text"
            code={"$ curl --socks5-hostname 127.0.0.1:9250 http://kybekhk…qqd.onion/\nhello from behind an onion"}/>
      <P>
        <Lead>And it works the other way round.</Lead> A real C tor bootstraps from our directory
        authority, builds a three-hop circuit through our relays and carries a stream over it,
        reaching <em>Bootstrapped 100%</em> through its own parsers.
      </P>
      <Caveat title="not ready to be relied on">
        Try it; that is what it is for. Just do not depend on it: <Lead>wac is unstable by
        choice</Lead> and still breaks its own language when that makes the language better. None
        of this has been reviewed by anyone, and anonymity is a separate question from correctness
        that it does not answer.
      </Caveat>
      <P>
        <span class="aside"><A href="#/stack/tor">What is in it, and what checked each piece →</A></span>
      </P>
    </Section>

    <Section id="ethereum" kicker="and a third" title="Ethereum">
      <P>
        Ask a node who owns a name and you are trusting whoever runs it. A wrong answer looks
        exactly like a right one.
      </P>
      <P>
        <Lead>This checks.</Lead> It follows the chain’s headers itself and verifies the
        committee signatures on them, then makes the node prove every answer against a header it
        has accepted — the value, <em>and</em> the path through the trie that leads to it. Alter
        the value and the path stops hashing to the root. <m>vitalik.eth</m>{" "}
        resolves that way end to end, registry to storage to owner, with nothing taken on the
        endpoint’s word.
      </P>
      <P>
        <span class="aside wider">
          Checked against the published vectors: SSZ’s 2,233 including all 1,131{" "}
          <em>invalid</em> ones, BLS12-381’s 29 fixtures, and the consensus spec’s own
          sync cases.
        </span>
      </P>
      <Caveat title="to do">
        No EVM, so no contract calls, and no simulating a transaction before approving it. No
        signing: it reads the chain and does not write to it. No receipts or logs. The light
        client is Altair on a minimal config and has never followed mainnet.
      </Caveat>
      <P>
        <span class="aside"><A href="#/stack/ethereum">The packages under that, and their vectors →</A></span>
      </P>
    </Section>

    <Section id="packages" kicker="all of it"
             title={"\{T.packages} packages, \{(T.lines + 500) / 1000}k lines, no dependencies"}>
      <P>
        In dependency order — nothing imports anything above it. No C, no libc, no runtime library,
        and no third-party code in any package’s <m>src/</m>.
      </P>
      <Table head={["package", "what it is", "lines", "tests"]} align="llrr" rows={packageRows(T)}/>
      <Facts rows={[
        Fact("dependencies", "0"),
        Fact("TypeScript in them", "0"),
        Fact("tests, both suites", "~\{(T.testsAll + 50) / 100 * 100}"),
      ]}/>
      <P>
        <A href="#/checked">How each of those is checked →</A>{" "}
        <span class="dim">
          — eight kinds of evidence, starting with a foreign implementation on the other end.
        </span>
      </P>
    </Section>
  </Frame>;
}

// The gradient is spent on the wordmark and nowhere else on the page; the rule beside it is solid, so
// the two do not compete. `clamp` reaches its cap by about 620px, because keying the middle term to the
// viewport made the heading *smaller* than the fixed size it replaced at every width below a wide
// desktop.
static string CSS = """
  .hero { display: flex; gap: 22px; align-items: stretch; margin-bottom: 66px; margin-top: 4px; }
  .hero .rule { width: 2px; border-radius: 2px; flex: none; background: var(--text); opacity: 0.85; }
  .hero h1 { margin: 0; font-family: var(--mono); font-weight: 700; letter-spacing: -0.04em; line-height: 0.95;
             font-size: clamp(56px, 18vw, 112px); }
  .hero .dollar { color: var(--faint); font-weight: 400; }
  .hero .grad { background: linear-gradient(104deg, #5eead4 2%, #67e8f9 26%, #818cf8 58%, #c084fc 86%);
                -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero .cur { color: var(--accent); }
  .hero .tagline { margin: 16px 0 0; max-width: 62ch; color: var(--body); font-size: clamp(16px, 3.4vw, 20px);
                   line-height: 1.5; text-wrap: balance; }
  .term { border: 1px solid var(--line-bright); border-radius: 7px; overflow: hidden; background: #06070a; margin-bottom: 16px; }
  .term .bar { display: flex; align-items: center; gap: 8px; padding: 9px 13px; background: var(--panel-hi);
               border-bottom: 1px solid var(--line); font-family: var(--mono); font-size: 11.5px; color: var(--faint); }
  .term .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--line-bright); }
  .term .name { margin-left: 6px; }
  .term .screen { padding: 18px 16px; font-family: var(--mono); font-size: 13px; line-height: 1.65; color: #d7dde6; }
  .term pre { margin: 0; overflow-x: auto; font-family: var(--mono); }
  .term .prompt { color: var(--accent); }
  .term .opens { color: var(--faint); margin-top: 12px; font-size: 12px; }
  .aside { font-size: 14.5px; color: var(--dim); }
  .aside.wider { font-size: 15px; }
  .dim { color: var(--dim); }
  .pkg { font-family: var(--mono); color: var(--accent); text-decoration: none; white-space: nowrap; }
  .num { font-family: var(--mono); font-variant-numeric: tabular-nums; }
  .num.total { color: var(--text); }
""";
